          (count : ℝ) * (shellMass * z) * Real.log z / 2 := by ring
      _ = (count : ℝ) * weight * Real.log z / 2 := by rw [hmass_z]
  have hcoefficient_nonneg : 0 ≤ (count : ℝ) * weight / 2 := by
