      (2 * Real.sqrt 2 * Real.sqrt
        ((16 * ((2 ^ 2 : ℕ) : ℝ) +
          8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / (count : ℝ)) *
        (4 * Real.sqrt tailConstant)))

/-- The leading `N^(-1/d)` coefficient in the supercritical selected-shell
head schedule.  Naming it separately exposes the polynomial count gate needed
to convert the qualitative head selector into a dimension-aware rate. -/
noncomputable def selectedShellGeometricSupercriticalRateCoefficient
    (dimension : ℕ) : ℝ :=
  (2 * Real.sqrt dimension +
      Real.sqrt dimension * Real.sqrt 2 /
        (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
    (16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹)

/-- The supercritical selected-shell leading coefficient is strictly positive
in every source-relevant dimension. -/
theorem selectedShellGeometricSupercriticalRateCoefficient_pos
    (dimension : ℕ) (hdimension : 2 < dimension) :
    0 < selectedShellGeometricSupercriticalRateCoefficient dimension := by
  unfold selectedShellGeometricSupercriticalRateCoefficient
  have hratio : 1 < Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 := by
    apply (lt_div_iff₀ (by norm_num : (0 : ℝ) < 2)).mpr
    simp only [one_mul]
    apply (Real.lt_sqrt (by norm_num : (0 : ℝ) ≤ 2)).mpr
    have hpow : 2 ^ 2 < 2 ^ dimension :=
      Nat.pow_lt_pow_right (by norm_num) hdimension
    norm_num at hpow ⊢
    exact_mod_cast hpow
  have hden_pos : 0 < Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1 :=
    sub_pos.mpr hratio
  positivity

/-- The supercritical-dimensional finite-head schedule, parameterized by an
upper bound on the radial fifth-order tail constant. -/
def selectedShellGeometricHeadSchedule_dimensionGreaterTwo
    (dimension cutoff count : ℕ) (confidence tailConstant : ℝ) : ℝ≥0∞ :=
  (ENNReal.ofReal
      ((2 * Real.sqrt dimension +
          Real.sqrt dimension * Real.sqrt 2 /
            (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
        ((16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹) /
          (count : ℝ) ^ ((dimension : ℝ)⁻¹)) +
        (2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)) /
          Real.sqrt count)) +
    ENNReal.ofReal
      (2 * Real.sqrt dimension *
        ((16 * ((2 ^ dimension : ℕ) : ℝ) +
          8 * (confidence + Real.log 2)) / (count : ℝ))) +
  (ENNReal.ofReal
      (((2 * Real.sqrt dimension +
          Real.sqrt dimension * Real.sqrt 2 /
            (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
        (16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹) /
        (count : ℝ) ^ ((dimension : ℝ)⁻¹) +
        (2 * Real.sqrt dimension *
          Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) /
          Real.sqrt count) * (4 * Real.sqrt tailConstant)) +
    ENNReal.ofReal
      (2 * Real.sqrt dimension * Real.sqrt
        ((16 * ((2 ^ dimension : ℕ) : ℝ) +
          8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / (count : ℝ)) *
        (4 * Real.sqrt tailConstant)))

/-- The leading `N^(-1/d)` real component of the supercritical selected-shell
compact-head schedule. -/
noncomputable def selectedShellGeometricSupercriticalLeadingTerm
    (dimension : ℕ) (count : ℝ) : ℝ :=
  (2 * Real.sqrt dimension +
      Real.sqrt dimension * Real.sqrt 2 /
        (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
    ((16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹) /
      count ^ ((dimension : ℝ)⁻¹))

/-- The central inverse-square-root real component of the supercritical
selected-shell compact-head schedule. -/
noncomputable def selectedShellGeometricCentralRootTerm
    (dimension : ℕ) (count confidence : ℝ) : ℝ :=
  (2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)) /
    Real.sqrt count

/-- The central inverse-count real component of the supercritical selected-
shell compact-head schedule. -/
noncomputable def selectedShellGeometricCentralCountTerm
    (dimension : ℕ) (count confidence : ℝ) : ℝ :=
  2 * Real.sqrt dimension *
    ((16 * ((2 ^ dimension : ℕ) : ℝ) + 8 * (confidence + Real.log 2)) / count)

/-- The successor inverse-square-root real component of the supercritical
selected-shell compact-head schedule, before radial-tail multiplication. -/
noncomputable def selectedShellGeometricSuccessorRootTerm
    (dimension cutoff : ℕ) (count confidence : ℝ) : ℝ :=
  (2 * Real.sqrt dimension *
    Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / Real.sqrt count

/-- The successor inverse-count real component of the supercritical
selected-shell compact-head schedule, before radial-tail multiplication. -/
noncomputable def selectedShellGeometricSuccessorCountTerm
    (dimension cutoff : ℕ) (count confidence : ℝ) : ℝ :=
  2 * Real.sqrt dimension * Real.sqrt
    ((16 * ((2 ^ dimension : ℕ) : ℝ) +
      8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / count)

/-- The radial fifth-order tail multiplier used by the selected-shell
compact-head schedule. -/
noncomputable def selectedShellGeometricTailMultiplier (tailConstant : ℝ) : ℝ :=
  4 * Real.sqrt tailConstant

/-!
## Explicit one-dimensional compact-head count

The one-dimensional selected-shell head contains three inverse-count and
three inverse-square-root components.  Naming their coefficients makes the
finite sample-size inversion visible and reusable; no eventual or existential
count selector is hidden in the definitions below.
-/

/-- Coefficient of the central inverse-square-root term in dimension one. -/
noncomputable def selectedShellGeometricDimensionOneCentralRootCoefficient
    (confidence : ℝ) : ℝ :=
  2 * (1 / (1 - 1 / Real.sqrt 2)) +
    2 * Real.sqrt (confidence + Real.log 2)

/-- Coefficient of the central inverse-count term in dimension one. -/
noncomputable def selectedShellGeometricDimensionOneCentralCountCoefficient
    (confidence : ℝ) : ℝ :=
  2 * Real.sqrt 1 *
    (16 * ((2 ^ 1 : ℕ) : ℝ) + 8 * (confidence + Real.log 2))

/-- Coefficient of the successor-shell inverse-count term in dimension one. -/
noncomputable def selectedShellGeometricDimensionOneSuccessorCountCoefficient
    (cutoff : ℕ) : ℝ :=
  128 * (2 * ((2 : ℝ) ^ cutoff - 1))

/-- Coefficient of the successor-shell inverse-square-root term in dimension one. -/
noncomputable def selectedShellGeometricDimensionOneSuccessorRootCoefficient
    (cutoff : ℕ) (confidence tailConstant : ℝ) : ℝ :=
  (2 * (1 / (1 - 1 / Real.sqrt 2)) +
      2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
    selectedShellGeometricTailMultiplier tailConstant

/-- Coefficient of the successor selected-count square-root term in dimension one. -/
noncomputable def selectedShellGeometricDimensionOneSuccessorSqrtCoefficient
    (cutoff : ℕ) (confidence tailConstant : ℝ) : ℝ :=
  2 * Real.sqrt
      (16 * ((2 ^ 1 : ℕ) : ℝ) +
        8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
    selectedShellGeometricTailMultiplier tailConstant

/-- The dimension-one central root coefficient is nonnegative for every
confidence input. -/
theorem selectedShellGeometricDimensionOneCentralRootCoefficient_nonneg
    (confidence : ℝ) :
    0 ≤ selectedShellGeometricDimensionOneCentralRootCoefficient confidence := by
  have hsqrtTwo : 1 < Real.sqrt 2 := Real.one_lt_sqrt_two
  have hinvSqrtTwo : 1 / Real.sqrt 2 < 1 := by
    rw [div_lt_one (Real.sqrt_pos.2 (by norm_num : (0 : ℝ) < 2))]
    exact hsqrtTwo
  have hden : 0 ≤ 1 - 1 / Real.sqrt 2 := (sub_pos.mpr hinvSqrtTwo).le
  unfold selectedShellGeometricDimensionOneCentralRootCoefficient
  exact add_nonneg
    (mul_nonneg (by norm_num) (one_div_nonneg.mpr hden))
    (mul_nonneg (by norm_num) (Real.sqrt_nonneg _))

/-- The dimension-one successor root coefficient is nonnegative. -/
theorem selectedShellGeometricDimensionOneSuccessorRootCoefficient_nonneg
    (cutoff : ℕ) (confidence tailConstant : ℝ) :
    0 ≤ selectedShellGeometricDimensionOneSuccessorRootCoefficient cutoff confidence
      tailConstant := by
  have hsqrtTwo : 1 < Real.sqrt 2 := Real.one_lt_sqrt_two
  have hinvSqrtTwo : 1 / Real.sqrt 2 < 1 := by
    rw [div_lt_one (Real.sqrt_pos.2 (by norm_num : (0 : ℝ) < 2))]
    exact hsqrtTwo
  have hden : 0 ≤ 1 - 1 / Real.sqrt 2 := (sub_pos.mpr hinvSqrtTwo).le
  unfold selectedShellGeometricDimensionOneSuccessorRootCoefficient
    selectedShellGeometricTailMultiplier
  exact mul_nonneg
    (add_nonneg
      (mul_nonneg (by norm_num) (one_div_nonneg.mpr hden))
      (mul_nonneg (by norm_num) (Real.sqrt_nonneg _)))
    (mul_nonneg (by norm_num) (Real.sqrt_nonneg _))

/-- The dimension-one selected-count square-root coefficient is nonnegative. -/
theorem selectedShellGeometricDimensionOneSuccessorSqrtCoefficient_nonneg
    (cutoff : ℕ) (confidence tailConstant : ℝ) :
    0 ≤ selectedShellGeometricDimensionOneSuccessorSqrtCoefficient cutoff confidence
      tailConstant := by
  unfold selectedShellGeometricDimensionOneSuccessorSqrtCoefficient
    selectedShellGeometricTailMultiplier
  positivity

/-- Six real component bounds control the full one-dimensional selected-shell
head schedule.  This is the low-dimensional analogue of the visible
supercritical six-component boundary below. -/
theorem selectedShellGeometricHeadSchedule_dimensionOne_le_of_sixth_component_bounds
    (cutoff count : ℕ) (confidence tailConstant radius : ℝ)
    (hradius : 0 ≤ radius)
    (hcentralCount : 128 / (count : ℝ) ≤ radius / 6)
    (hcentralRoot :
      selectedShellGeometricDimensionOneCentralRootCoefficient confidence /
          Real.sqrt count ≤ radius / 6)
    (hcentralInactive :
      selectedShellGeometricDimensionOneCentralCountCoefficient confidence /
          (count : ℝ) ≤ radius / 6)
    (hsuccessorCount :
      selectedShellGeometricDimensionOneSuccessorCountCoefficient cutoff /
          (count : ℝ) ≤ radius / 6)
    (hsuccessorRoot :
      selectedShellGeometricDimensionOneSuccessorRootCoefficient cutoff confidence tailConstant /
          Real.sqrt count ≤ radius / 6)
    (hsuccessorSqrt :
      selectedShellGeometricDimensionOneSuccessorSqrtCoefficient cutoff confidence tailConstant /
          Real.sqrt count ≤ radius / 6) :
    selectedShellGeometricHeadSchedule_dimensionOne cutoff count confidence tailConstant ≤
      ENNReal.ofReal radius := by
  have hbudget := AppliedModelingLib.Math.ennreal_ofReal_paired_sum_three_le_ofReal_of_each_le_sixth
    (a := 128 / (count : ℝ))
    (b := selectedShellGeometricDimensionOneCentralRootCoefficient confidence /
      Real.sqrt count)
    (c := selectedShellGeometricDimensionOneCentralCountCoefficient confidence / (count : ℝ))
    (d := selectedShellGeometricDimensionOneSuccessorCountCoefficient cutoff / (count : ℝ))
    (e := selectedShellGeometricDimensionOneSuccessorRootCoefficient cutoff confidence
      tailConstant / Real.sqrt count)
    (f := selectedShellGeometricDimensionOneSuccessorSqrtCoefficient cutoff confidence
      tailConstant / Real.sqrt count)
    hradius hcentralCount hcentralRoot hcentralInactive hsuccessorCount hsuccessorRoot
      hsuccessorSqrt
  unfold selectedShellGeometricHeadSchedule_dimensionOne
    selectedShellGeometricCentralSchedule_dimensionOne
  rw [Real.sqrt_div' _ (Nat.cast_nonneg count)]
  convert hbudget using 1 <;>
    simp only [selectedShellGeometricDimensionOneCentralRootCoefficient,
      selectedShellGeometricDimensionOneCentralCountCoefficient,
      selectedShellGeometricDimensionOneSuccessorCountCoefficient,
      selectedShellGeometricDimensionOneSuccessorRootCoefficient,
      selectedShellGeometricDimensionOneSuccessorSqrtCoefficient,
      selectedShellGeometricTailMultiplier] <;>
    ring

/-- Explicit linear and quadratic count gates bound the one-dimensional
selected-shell head by a prescribed positive radius. -/
theorem selectedShellGeometricHeadSchedule_dimensionOne_le_of_effectiveCountGates
    (cutoff count : ℕ) (confidence tailConstant radius : ℝ)
    (hcount : 0 < count) (hradius : 0 < radius)
    (hcentralCountGate : 6 * 128 ≤ (count : ℝ) * radius)
    (hcentralRootGate :
      6 ^ 2 * selectedShellGeometricDimensionOneCentralRootCoefficient confidence ^ 2 ≤
        (count : ℝ) * radius ^ 2)
    (hcentralInactiveGate :
      6 * selectedShellGeometricDimensionOneCentralCountCoefficient confidence ≤
        (count : ℝ) * radius)
    (hsuccessorCountGate :
      6 * selectedShellGeometricDimensionOneSuccessorCountCoefficient cutoff ≤
        (count : ℝ) * radius)
    (hsuccessorRootGate :
      6 ^ 2 * selectedShellGeometricDimensionOneSuccessorRootCoefficient cutoff confidence
          tailConstant ^ 2 ≤ (count : ℝ) * radius ^ 2)
    (hsuccessorSqrtGate :
      6 ^ 2 * selectedShellGeometricDimensionOneSuccessorSqrtCoefficient cutoff confidence
          tailConstant ^ 2 ≤ (count : ℝ) * radius ^ 2) :
    selectedShellGeometricHeadSchedule_dimensionOne cutoff count confidence tailConstant ≤
      ENNReal.ofReal radius := by
  apply selectedShellGeometricHeadSchedule_dimensionOne_le_of_sixth_component_bounds
    cutoff count confidence tailConstant radius hradius.le
  · exact AppliedModelingLib.Math.div_nat_le_div_of_mul_le count hcount (by norm_num)
      hcentralCountGate
  · exact AppliedModelingLib.Math.div_sqrt_nat_le_div_of_sq_mul_le count hcount
      (selectedShellGeometricDimensionOneCentralRootCoefficient_nonneg confidence)
      hradius.le (by norm_num) hcentralRootGate
  · exact AppliedModelingLib.Math.div_nat_le_div_of_mul_le count hcount (by norm_num)
      hcentralInactiveGate
  · exact AppliedModelingLib.Math.div_nat_le_div_of_mul_le count hcount (by norm_num)
      hsuccessorCountGate
  · exact AppliedModelingLib.Math.div_sqrt_nat_le_div_of_sq_mul_le count hcount
      (selectedShellGeometricDimensionOneSuccessorRootCoefficient_nonneg cutoff confidence
        tailConstant)
      hradius.le (by norm_num) hsuccessorRootGate
  · exact AppliedModelingLib.Math.div_sqrt_nat_le_div_of_sq_mul_le count hcount
      (selectedShellGeometricDimensionOneSuccessorSqrtCoefficient_nonneg cutoff confidence
        tailConstant)
      hradius.le (by norm_num) hsuccessorSqrtGate

/-- The maximum of the six explicit one-dimensional effective-count
thresholds.  Its inverse-square-root terms have the expected quadratic
dependence on the target radius. -/
noncomputable def selectedShellGeometricDimensionOneEffectiveCountRequirement
    (cutoff : ℕ) (confidence tailConstant radius : ℝ) : ℝ :=
  max
    (6 * 128 / radius)
    (max
      (6 ^ 2 * selectedShellGeometricDimensionOneCentralRootCoefficient confidence ^ 2 /
        radius ^ 2)
      (max
        (6 * selectedShellGeometricDimensionOneCentralCountCoefficient confidence / radius)
        (max
          (6 * selectedShellGeometricDimensionOneSuccessorCountCoefficient cutoff / radius)
          (max
            (6 ^ 2 * selectedShellGeometricDimensionOneSuccessorRootCoefficient cutoff confidence
                tailConstant ^ 2 / radius ^ 2)
            (6 ^ 2 * selectedShellGeometricDimensionOneSuccessorSqrtCoefficient cutoff confidence
                tailConstant ^ 2 / radius ^ 2)))))

/-- A concrete positive one-dimensional batch count for the complete compact
head schedule. -/
noncomputable def selectedShellGeometricDimensionOneEffectiveCount
    (cutoff : ℕ) (confidence tailConstant radius : ℝ) : ℕ :=
  Math.positiveNatCeil
    (selectedShellGeometricDimensionOneEffectiveCountRequirement cutoff confidence tailConstant
      radius)

/-- The concrete one-dimensional count is positive. -/
theorem one_le_selectedShellGeometricDimensionOneEffectiveCount
    (cutoff : ℕ) (confidence tailConstant radius : ℝ) :
    1 ≤ selectedShellGeometricDimensionOneEffectiveCount cutoff confidence tailConstant radius := by
  unfold selectedShellGeometricDimensionOneEffectiveCount
  exact Math.one_le_positiveNatCeil _

/-- The concrete one-dimensional count dominates its six-way requirement. -/
theorem selectedShellGeometricDimensionOneEffectiveCountRequirement_le_count
    (cutoff : ℕ) (confidence tailConstant radius : ℝ) :
    selectedShellGeometricDimensionOneEffectiveCountRequirement cutoff confidence tailConstant
        radius ≤
      selectedShellGeometricDimensionOneEffectiveCount cutoff confidence tailConstant radius := by
  unfold selectedShellGeometricDimensionOneEffectiveCount
  exact Math.le_positiveNatCeil _

/-- The concrete one-dimensional ceiling selector bounds the compact-head
schedule at the requested positive radius. -/
theorem selectedShellGeometricHeadSchedule_dimensionOne_le_of_concreteEffectiveCount
    (cutoff : ℕ) (confidence tailConstant radius : ℝ) (hradius : 0 < radius) :
    selectedShellGeometricHeadSchedule_dimensionOne cutoff
        (selectedShellGeometricDimensionOneEffectiveCount cutoff confidence tailConstant radius)
        confidence tailConstant ≤ ENNReal.ofReal radius := by
  let count := selectedShellGeometricDimensionOneEffectiveCount cutoff confidence tailConstant
    radius
  let requirement := selectedShellGeometricDimensionOneEffectiveCountRequirement cutoff confidence
    tailConstant radius
  have hcount : 0 < count := lt_of_lt_of_le zero_lt_one
    (one_le_selectedShellGeometricDimensionOneEffectiveCount cutoff confidence tailConstant radius)
  have hrequirement : requirement ≤ (count : ℝ) := by
    dsimp [count, requirement]
    exact selectedShellGeometricDimensionOneEffectiveCountRequirement_le_count cutoff confidence
      tailConstant radius
  have hthresholdOne : 6 * 128 / radius ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact le_max_left _ _
  have hthresholdTwo :
      6 ^ 2 * selectedShellGeometricDimensionOneCentralRootCoefficient confidence ^ 2 /
          radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact (le_max_left _ _).trans (le_max_right _ _)
  have hthresholdThree :
      6 * selectedShellGeometricDimensionOneCentralCountCoefficient confidence / radius ≤
        requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact ((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdFour :
      6 * selectedShellGeometricDimensionOneSuccessorCountCoefficient cutoff / radius ≤
        requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact (((le_max_left _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdFive :
      6 ^ 2 * selectedShellGeometricDimensionOneSuccessorRootCoefficient cutoff confidence
          tailConstant ^ 2 / radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact ((((le_max_left _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdSix :
      6 ^ 2 * selectedShellGeometricDimensionOneSuccessorSqrtCoefficient cutoff confidence
          tailConstant ^ 2 / radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact ((((le_max_right _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)).trans (le_max_right _ _)
  apply selectedShellGeometricHeadSchedule_dimensionOne_le_of_effectiveCountGates
    cutoff count confidence tailConstant radius hcount hradius
  · apply (div_le_iff₀ hradius).mp
    exact hthresholdOne.trans hrequirement
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdTwo.trans hrequirement
  · apply (div_le_iff₀ hradius).mp
    exact hthresholdThree.trans hrequirement
  · apply (div_le_iff₀ hradius).mp
    exact hthresholdFour.trans hrequirement
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdFive.trans hrequirement
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdSix.trans hrequirement

/-- Any positive count dominating the six one-dimensional requirements
controls the finite compact-head schedule.  This monotone-gate form allows the
head selector to be joined with independent all-shell mass and source-rate
requirements. -/
theorem selectedShellGeometricHeadSchedule_dimensionOne_le_of_effectiveCountRequirement_le
    (cutoff count : ℕ) (confidence tailConstant radius : ℝ)
    (hcount : 0 < count) (hradius : 0 < radius)
    (hrequirement :
      selectedShellGeometricDimensionOneEffectiveCountRequirement cutoff confidence tailConstant
        radius ≤ (count : ℝ)) :
    selectedShellGeometricHeadSchedule_dimensionOne cutoff count confidence tailConstant ≤
      ENNReal.ofReal radius := by
  let requirement := selectedShellGeometricDimensionOneEffectiveCountRequirement cutoff confidence
    tailConstant radius
  have hthresholdOne : 6 * 128 / radius ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact le_max_left _ _
  have hthresholdTwo :
      6 ^ 2 * selectedShellGeometricDimensionOneCentralRootCoefficient confidence ^ 2 /
          radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact (le_max_left _ _).trans (le_max_right _ _)
  have hthresholdThree :
      6 * selectedShellGeometricDimensionOneCentralCountCoefficient confidence / radius ≤
        requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact ((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdFour :
      6 * selectedShellGeometricDimensionOneSuccessorCountCoefficient cutoff / radius ≤
        requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact (((le_max_left _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdFive :
      6 ^ 2 * selectedShellGeometricDimensionOneSuccessorRootCoefficient cutoff confidence
          tailConstant ^ 2 / radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact ((((le_max_left _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdSix :
      6 ^ 2 * selectedShellGeometricDimensionOneSuccessorSqrtCoefficient cutoff confidence
          tailConstant ^ 2 / radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionOneEffectiveCountRequirement]
    exact ((((le_max_right _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)).trans (le_max_right _ _)
  apply selectedShellGeometricHeadSchedule_dimensionOne_le_of_effectiveCountGates
    cutoff count confidence tailConstant radius hcount hradius
  · apply (div_le_iff₀ hradius).mp
    exact hthresholdOne.trans hrequirement
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdTwo.trans hrequirement
  · apply (div_le_iff₀ hradius).mp
    exact hthresholdThree.trans hrequirement
  · apply (div_le_iff₀ hradius).mp
    exact hthresholdFour.trans hrequirement
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdFive.trans hrequirement
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdSix.trans hrequirement

/-!
## Explicit critical-dimensional compact-head count

The dimension-two head has four inverse-square-root or inverse-count terms
and two logarithmic-depth terms.  The latter are conservatively bounded at
quarter-power rate, producing a completely explicit fourth-power count gate.
This is a finite valid selector, not a claim of the sharp critical logarithmic
rate in Fournier--Guillin.
-/

/-- In the critical dimension, the logarithmic dyadic depth is bounded by a
conservative quarter-power rate once `count ≥ 64`.  This explicit estimate is
what permits a visible fourth-power count gate for the dimension-two head.

Library provenance: the logarithm-to-power step directly uses Mathlib's
`Real.log_natCast_le_rpow_div` from
[`Analysis/SpecialFunctions/Pow/Real.lean`](https://github.com/leanprover-community/mathlib4/blob/5450b53e5ddc75d46418fabb605edbf36bd0beb6/Mathlib/Analysis/SpecialFunctions/Pow/Real.lean#L896),
at the pinned Apache-2.0 Mathlib commit.  The remaining dyadic-depth and
real-power algebra is proved locally; no external source is copied or ported.
-/
theorem dyadicEffectiveCountDepth_two_div_sqrt_nat_le_quarterRate
    (count : ℕ) (hcount : 64 ≤ count) :
    (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
        Real.sqrt (count : ℝ) ≤
      (4 / Real.log 4) / (count : ℝ) ^ ((4 : ℝ)⁻¹) := by
  have hlogFour_pos : 0 < Real.log 4 := Real.log_pos (by norm_num)
  have hcount_real : (64 : ℝ) ≤ count := by exact_mod_cast hcount
  have hcount_pos : 0 < (count : ℝ) := lt_of_lt_of_le (by norm_num) hcount_real
  have hratio_one : 1 ≤ (count : ℝ) / 64 := by
    apply (one_le_div (by norm_num : (0 : ℝ) < 64)).mpr
    simpa using hcount_real
  have hratio_pos : 0 < (count : ℝ) / 64 := lt_of_lt_of_le zero_lt_one hratio_one
  have hlog_nonneg : 0 ≤ Real.logb 4 ((count : ℝ) / 64) := by
    unfold Real.logb
    exact div_nonneg (Real.log_nonneg hratio_one) hlogFour_pos.le
  have hratio_le : (count : ℝ) / 64 ≤ count := by
    apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 64)).mpr
    nlinarith
  have hdepth_le_log : (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) ≤
      Real.log (count : ℝ) / Real.log 4 := by
    have hfloor : (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) ≤
        Real.logb 4 ((count : ℝ) / 64) := by
      change (Nat.floor (Real.logb 4 (((count : ℝ) / 16) / 4)) : ℝ) ≤ _
      convert Nat.floor_le hlog_nonneg using 1 <;> ring
    calc
      (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) ≤
          Real.logb 4 ((count : ℝ) / 64) := hfloor
      _ ≤ Real.logb 4 (count : ℝ) :=
        Real.logb_le_logb_of_le (by norm_num) hratio_pos hratio_le
      _ = Real.log (count : ℝ) / Real.log 4 := by rw [Real.logb]
  have hlog_le : Real.log (count : ℝ) ≤
      (count : ℝ) ^ ((4 : ℝ)⁻¹) / ((4 : ℝ)⁻¹) := by
    simpa using
      Real.log_natCast_le_rpow_div count (show (0 : ℝ) < (4 : ℝ)⁻¹ by norm_num)
  have hsqrt_pos : 0 < Real.sqrt (count : ℝ) := Real.sqrt_pos.2 hcount_pos
  have hroot_pos : 0 < (count : ℝ) ^ ((4 : ℝ)⁻¹) :=
    Real.rpow_pos_of_pos hcount_pos _
  have hsqrt_eq : Real.sqrt (count : ℝ) =
      (count : ℝ) ^ ((4 : ℝ)⁻¹) * (count : ℝ) ^ ((4 : ℝ)⁻¹) := by
    rw [Real.sqrt_eq_rpow]
    convert Real.rpow_add' hcount_pos.le
      (by norm_num : (4 : ℝ)⁻¹ + (4 : ℝ)⁻¹ ≠ 0) using 1 <;> norm_num
  calc
    (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
        Real.sqrt (count : ℝ) ≤
        (Real.log (count : ℝ) / Real.log 4) / Real.sqrt (count : ℝ) :=
      div_le_div_of_nonneg_right hdepth_le_log hsqrt_pos.le
    _ ≤ (((count : ℝ) ^ ((4 : ℝ)⁻¹) / ((4 : ℝ)⁻¹)) / Real.log 4) /
        Real.sqrt (count : ℝ) := by
      gcongr
    _ = (4 / Real.log 4) / (count : ℝ) ^ ((4 : ℝ)⁻¹) := by
      rw [hsqrt_eq]
      field_simp [hlogFour_pos.ne', hroot_pos.ne']

/-- Fixed inverse-square-root coefficient in the central dimension-two head. -/
noncomputable def selectedShellGeometricDimensionTwoCentralRootCoefficient
    (confidence : ℝ) : ℝ :=
  32 * Real.sqrt 2 + 2 * Real.sqrt 2 * Real.sqrt (confidence + Real.log 2)

/-- Quarter-power coefficient controlling the central logarithmic-depth term. -/
noncomputable def selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient : ℝ :=
  16 / Real.log 4

/-- Inverse-count coefficient in the central dimension-two head. -/
noncomputable def selectedShellGeometricDimensionTwoCentralCountCoefficient
    (confidence : ℝ) : ℝ :=
  2 * Real.sqrt 2 * (16 * ((2 ^ 2 : ℕ) : ℝ) + 8 * (confidence + Real.log 2))

/-- Fixed inverse-square-root coefficient in the successor dimension-two head. -/
noncomputable def selectedShellGeometricDimensionTwoSuccessorRootCoefficient
    (cutoff : ℕ) (confidence tailConstant : ℝ) : ℝ :=
  (32 * Real.sqrt 2 +
      2 * Real.sqrt 2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
    selectedShellGeometricTailMultiplier tailConstant

/-- Quarter-power coefficient controlling the successor logarithmic-depth term. -/
noncomputable def selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient
    (tailConstant : ℝ) : ℝ :=
  (16 / Real.log 4) * selectedShellGeometricTailMultiplier tailConstant

/-- Inverse-square-root coefficient of the successor selected-count term. -/
noncomputable def selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient
    (cutoff : ℕ) (confidence tailConstant : ℝ) : ℝ :=
  2 * Real.sqrt 2 * Real.sqrt
      (16 * ((2 ^ 2 : ℕ) : ℝ) +
        8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
    selectedShellGeometricTailMultiplier tailConstant

theorem selectedShellGeometricDimensionTwoCentralRootCoefficient_nonneg
    (confidence : ℝ) :
    0 ≤ selectedShellGeometricDimensionTwoCentralRootCoefficient confidence := by
  unfold selectedShellGeometricDimensionTwoCentralRootCoefficient
  positivity

theorem selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient_nonneg :
    0 ≤ selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient := by
  unfold selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient
  exact div_nonneg (by norm_num) (Real.log_nonneg (by norm_num))

theorem selectedShellGeometricDimensionTwoSuccessorRootCoefficient_nonneg
    (cutoff : ℕ) (confidence tailConstant : ℝ) :
    0 ≤ selectedShellGeometricDimensionTwoSuccessorRootCoefficient cutoff confidence
      tailConstant := by
  unfold selectedShellGeometricDimensionTwoSuccessorRootCoefficient
    selectedShellGeometricTailMultiplier
  positivity

theorem selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient_nonneg
    (tailConstant : ℝ) :
    0 ≤ selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient tailConstant := by
  unfold selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient
    selectedShellGeometricTailMultiplier
  exact mul_nonneg (div_nonneg (by norm_num) (Real.log_nonneg (by norm_num))) (by positivity)

theorem selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient_nonneg
    (cutoff : ℕ) (confidence tailConstant : ℝ) :
    0 ≤ selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient cutoff confidence
      tailConstant := by
  unfold selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient
    selectedShellGeometricTailMultiplier
  positivity

/-- Six componentwise real bounds control the complete critical-dimensional
selected-shell head. -/
theorem selectedShellGeometricHeadSchedule_dimensionTwo_le_of_sixth_component_bounds
    (cutoff count : ℕ) (confidence tailConstant radius : ℝ)
    (hradius : 0 ≤ radius)
    (hcentralRoot :
      selectedShellGeometricDimensionTwoCentralRootCoefficient confidence /
          Real.sqrt count ≤ radius / 6)
    (hcentralDepth :
      4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
          Real.sqrt count ≤ radius / 6)
    (hcentralCount :
      selectedShellGeometricDimensionTwoCentralCountCoefficient confidence /
          (count : ℝ) ≤ radius / 6)
    (hsuccessorRoot :
      selectedShellGeometricDimensionTwoSuccessorRootCoefficient cutoff confidence tailConstant /
          Real.sqrt count ≤ radius / 6)
    (hsuccessorDepth :
      (4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
          Real.sqrt count) * selectedShellGeometricTailMultiplier tailConstant ≤ radius / 6)
    (hsuccessorSqrt :
      selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient cutoff confidence tailConstant /
          Real.sqrt count ≤ radius / 6) :
    selectedShellGeometricHeadSchedule_dimensionTwo cutoff count confidence tailConstant ≤
      ENNReal.ofReal radius := by
  have hbudget := AppliedModelingLib.Math.ennreal_ofReal_paired_sum_three_le_ofReal_of_each_le_sixth
    (a := selectedShellGeometricDimensionTwoCentralRootCoefficient confidence /
      Real.sqrt count)
    (b := 4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
      Real.sqrt count)
    (c := selectedShellGeometricDimensionTwoCentralCountCoefficient confidence / (count : ℝ))
    (d := selectedShellGeometricDimensionTwoSuccessorRootCoefficient cutoff confidence
      tailConstant / Real.sqrt count)
    (e := (4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
      Real.sqrt count) * selectedShellGeometricTailMultiplier tailConstant)
    (f := selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient cutoff confidence
      tailConstant / Real.sqrt count)
    hradius hcentralRoot hcentralDepth hcentralCount hsuccessorRoot hsuccessorDepth hsuccessorSqrt
  unfold selectedShellGeometricHeadSchedule_dimensionTwo
    selectedShellGeometricCentralSchedule_dimensionTwo
  rw [Real.sqrt_div' _ (Nat.cast_nonneg count)]
  convert hbudget using 1 <;>
    simp only [selectedShellGeometricDimensionTwoCentralRootCoefficient,
      selectedShellGeometricDimensionTwoCentralCountCoefficient,
      selectedShellGeometricDimensionTwoSuccessorRootCoefficient,
      selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient,
      selectedShellGeometricTailMultiplier] <;>
    ring

/-- Linear, quadratic, and fourth-power gates bound the complete critical
selected-shell head.  The fourth-power gates are conservative inversions of
the logarithmic depth contribution. -/
theorem selectedShellGeometricHeadSchedule_dimensionTwo_le_of_effectiveCountGates
    (cutoff count : ℕ) (confidence tailConstant radius : ℝ)
    (hcount : 0 < count) (hcount64 : 64 ≤ count) (hradius : 0 < radius)
    (hcentralRootGate :
      6 ^ 2 * selectedShellGeometricDimensionTwoCentralRootCoefficient confidence ^ 2 ≤
        (count : ℝ) * radius ^ 2)
    (hcentralDepthGate :
      6 ^ 4 * selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient ^ 4 ≤
        (count : ℝ) * radius ^ 4)
    (hcentralCountGate :
      6 * selectedShellGeometricDimensionTwoCentralCountCoefficient confidence ≤
        (count : ℝ) * radius)
    (hsuccessorRootGate :
      6 ^ 2 * selectedShellGeometricDimensionTwoSuccessorRootCoefficient cutoff confidence
          tailConstant ^ 2 ≤ (count : ℝ) * radius ^ 2)
    (hsuccessorDepthGate :
      6 ^ 4 * selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient tailConstant ^ 4 ≤
        (count : ℝ) * radius ^ 4)
    (hsuccessorSqrtGate :
      6 ^ 2 * selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient cutoff confidence
          tailConstant ^ 2 ≤ (count : ℝ) * radius ^ 2) :
    selectedShellGeometricHeadSchedule_dimensionTwo cutoff count confidence tailConstant ≤
      ENNReal.ofReal radius := by
  have hcountReal : 0 < (count : ℝ) := by exact_mod_cast hcount
  have hcentralDepthQuarter :
      selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient /
          (count : ℝ) ^ ((4 : ℝ)⁻¹) ≤ radius / 6 := by
    apply Math.div_rpow_nat_inv_le_of_pow_le 4 (by norm_num)
      selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient_nonneg hcountReal
      (div_pos hradius (by norm_num))
    calc
      selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient ^ 4 =
          (6 ^ 4 * selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient ^ 4) /
            6 ^ 4 := by norm_num
      _ ≤ ((count : ℝ) * radius ^ 4) / 6 ^ 4 :=
        div_le_div_of_nonneg_right hcentralDepthGate (by norm_num)
      _ = (count : ℝ) * (radius / 6) ^ 4 := by norm_num; ring
  have hsuccessorDepthQuarter :
      selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient tailConstant /
          (count : ℝ) ^ ((4 : ℝ)⁻¹) ≤ radius / 6 := by
    apply Math.div_rpow_nat_inv_le_of_pow_le 4 (by norm_num)
      (selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient_nonneg tailConstant)
      hcountReal (div_pos hradius (by norm_num))
    calc
      selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient tailConstant ^ 4 =
          (6 ^ 4 *
            selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient tailConstant ^ 4) /
              6 ^ 4 := by norm_num
      _ ≤ ((count : ℝ) * radius ^ 4) / 6 ^ 4 :=
        div_le_div_of_nonneg_right hsuccessorDepthGate (by norm_num)
      _ = (count : ℝ) * (radius / 6) ^ 4 := by norm_num; ring
  apply selectedShellGeometricHeadSchedule_dimensionTwo_le_of_sixth_component_bounds
    cutoff count confidence tailConstant radius hradius.le
  · exact AppliedModelingLib.Math.div_sqrt_nat_le_div_of_sq_mul_le count hcount
      (selectedShellGeometricDimensionTwoCentralRootCoefficient_nonneg confidence)
      hradius.le (by norm_num) hcentralRootGate
  · calc
      4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
          Real.sqrt count = 4 *
            ((Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
              Real.sqrt count) := by ring
      _ ≤ 4 * ((4 / Real.log 4) / (count : ℝ) ^ ((4 : ℝ)⁻¹)) :=
        mul_le_mul_of_nonneg_left
          (dyadicEffectiveCountDepth_two_div_sqrt_nat_le_quarterRate count hcount64)
          (by norm_num)
      _ = selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient /
          (count : ℝ) ^ ((4 : ℝ)⁻¹) := by
        unfold selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient
        ring
      _ ≤ radius / 6 := hcentralDepthQuarter
  · exact AppliedModelingLib.Math.div_nat_le_div_of_mul_le count hcount (by norm_num)
      hcentralCountGate
  · exact AppliedModelingLib.Math.div_sqrt_nat_le_div_of_sq_mul_le count hcount
      (selectedShellGeometricDimensionTwoSuccessorRootCoefficient_nonneg cutoff confidence
        tailConstant)
      hradius.le (by norm_num) hsuccessorRootGate
  · calc
      (4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
          Real.sqrt count) * selectedShellGeometricTailMultiplier tailConstant =
          4 * ((Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
            Real.sqrt count) * selectedShellGeometricTailMultiplier tailConstant := by ring
      _ ≤ 4 * ((4 / Real.log 4) / (count : ℝ) ^ ((4 : ℝ)⁻¹)) *
          selectedShellGeometricTailMultiplier tailConstant := by
        apply mul_le_mul_of_nonneg_right
        · exact mul_le_mul_of_nonneg_left
            (dyadicEffectiveCountDepth_two_div_sqrt_nat_le_quarterRate count hcount64)
            (by norm_num)
        · unfold selectedShellGeometricTailMultiplier
          positivity
      _ = selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient tailConstant /
          (count : ℝ) ^ ((4 : ℝ)⁻¹) := by
        unfold selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient
        ring
      _ ≤ radius / 6 := hsuccessorDepthQuarter
  · exact AppliedModelingLib.Math.div_sqrt_nat_le_div_of_sq_mul_le count hcount
      (selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient_nonneg cutoff confidence
        tailConstant)
      hradius.le (by norm_num) hsuccessorSqrtGate

/-- The maximum of the base count and six explicit critical-dimensional
thresholds.  The two logarithmic-depth thresholds scale conservatively as
`radius⁻⁴`; the other terms retain their quadratic or linear dependence. -/
noncomputable def selectedShellGeometricDimensionTwoEffectiveCountRequirement
    (cutoff : ℕ) (confidence tailConstant radius : ℝ) : ℝ :=
  max 64
    (max
      (6 ^ 2 * selectedShellGeometricDimensionTwoCentralRootCoefficient confidence ^ 2 /
        radius ^ 2)
      (max
        (6 ^ 4 * selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient ^ 4 /
          radius ^ 4)
        (max
          (6 * selectedShellGeometricDimensionTwoCentralCountCoefficient confidence / radius)
          (max
            (6 ^ 2 * selectedShellGeometricDimensionTwoSuccessorRootCoefficient cutoff confidence
                tailConstant ^ 2 / radius ^ 2)
            (max
              (6 ^ 4 *
                selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient tailConstant ^ 4 /
                  radius ^ 4)
              (6 ^ 2 * selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient cutoff confidence
                tailConstant ^ 2 / radius ^ 2))))))

/-- A positive natural ceiling of the complete critical-dimensional head
requirement. -/
noncomputable def selectedShellGeometricDimensionTwoEffectiveCount
    (cutoff : ℕ) (confidence tailConstant radius : ℝ) : ℕ :=
  Math.positiveNatCeil
    (selectedShellGeometricDimensionTwoEffectiveCountRequirement cutoff confidence tailConstant
      radius)

theorem one_le_selectedShellGeometricDimensionTwoEffectiveCount
    (cutoff : ℕ) (confidence tailConstant radius : ℝ) :
    1 ≤ selectedShellGeometricDimensionTwoEffectiveCount cutoff confidence tailConstant
      radius := by
  unfold selectedShellGeometricDimensionTwoEffectiveCount
  exact Math.one_le_positiveNatCeil _

theorem selectedShellGeometricDimensionTwoEffectiveCountRequirement_le_count
    (cutoff : ℕ) (confidence tailConstant radius : ℝ) :
    selectedShellGeometricDimensionTwoEffectiveCountRequirement cutoff confidence tailConstant
        radius ≤
      selectedShellGeometricDimensionTwoEffectiveCount cutoff confidence tailConstant radius := by
  unfold selectedShellGeometricDimensionTwoEffectiveCount
  exact Math.le_positiveNatCeil _

/-- The concrete critical-dimensional ceiling selector bounds the complete
head at a requested positive radius. -/
theorem selectedShellGeometricHeadSchedule_dimensionTwo_le_of_concreteEffectiveCount
    (cutoff : ℕ) (confidence tailConstant radius : ℝ) (hradius : 0 < radius) :
    selectedShellGeometricHeadSchedule_dimensionTwo cutoff
        (selectedShellGeometricDimensionTwoEffectiveCount cutoff confidence tailConstant radius)
        confidence tailConstant ≤ ENNReal.ofReal radius := by
  let count := selectedShellGeometricDimensionTwoEffectiveCount cutoff confidence tailConstant
    radius
  let requirement := selectedShellGeometricDimensionTwoEffectiveCountRequirement cutoff confidence
    tailConstant radius
  have hcount : 0 < count := lt_of_lt_of_le zero_lt_one
    (one_le_selectedShellGeometricDimensionTwoEffectiveCount cutoff confidence tailConstant radius)
  have hrequirement : requirement ≤ (count : ℝ) := by
    dsimp [count, requirement]
    exact selectedShellGeometricDimensionTwoEffectiveCountRequirement_le_count cutoff confidence
      tailConstant radius
  have hthresholdZero : (64 : ℝ) ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionTwoEffectiveCountRequirement]
    exact le_max_left _ _
  have hcount64 : 64 ≤ count := by
    have hreal : (64 : ℝ) ≤ count := hthresholdZero.trans hrequirement
    exact_mod_cast hreal
  have hthresholdOne :
      6 ^ 2 * selectedShellGeometricDimensionTwoCentralRootCoefficient confidence ^ 2 /
          radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionTwoEffectiveCountRequirement]
    exact (le_max_left _ _).trans (le_max_right _ _)
  have hthresholdTwo :
      6 ^ 4 * selectedShellGeometricDimensionTwoCentralDepthQuarterCoefficient ^ 4 /
          radius ^ 4 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionTwoEffectiveCountRequirement]
    exact ((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdThree :
      6 * selectedShellGeometricDimensionTwoCentralCountCoefficient confidence / radius ≤
        requirement := by
    dsimp [requirement, selectedShellGeometricDimensionTwoEffectiveCountRequirement]
    exact (((le_max_left _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdFour :
      6 ^ 2 * selectedShellGeometricDimensionTwoSuccessorRootCoefficient cutoff confidence
          tailConstant ^ 2 / radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionTwoEffectiveCountRequirement]
    exact ((((le_max_left _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdFive :
      6 ^ 4 * selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient tailConstant ^ 4 /
          radius ^ 4 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionTwoEffectiveCountRequirement]
    exact (((((le_max_left _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdSix :
      6 ^ 2 * selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient cutoff confidence
          tailConstant ^ 2 / radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionTwoEffectiveCountRequirement]
    exact (((((le_max_right _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)
  apply selectedShellGeometricHeadSchedule_dimensionTwo_le_of_effectiveCountGates
    cutoff count confidence tailConstant radius hcount hcount64 hradius
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdOne.trans hrequirement
  · apply (div_le_iff₀ (pow_pos hradius 4)).mp
    exact hthresholdTwo.trans hrequirement
  · apply (div_le_iff₀ hradius).mp
    exact hthresholdThree.trans hrequirement
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdFour.trans hrequirement
  · apply (div_le_iff₀ (pow_pos hradius 4)).mp
    exact hthresholdFive.trans hrequirement
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdSix.trans hrequirement

/-- Any positive count dominating the seven critical-dimensional requirements
controls the finite compact-head schedule.  The base requirement `64` enables
the conservative logarithmic-depth estimate used by the two fourth-power
gates. -/
theorem selectedShellGeometricHeadSchedule_dimensionTwo_le_of_effectiveCountRequirement_le
    (cutoff count : ℕ) (confidence tailConstant radius : ℝ)
    (hcount : 0 < count) (hradius : 0 < radius)
    (hrequirement :
      selectedShellGeometricDimensionTwoEffectiveCountRequirement cutoff confidence tailConstant
        radius ≤ (count : ℝ)) :
    selectedShellGeometricHeadSchedule_dimensionTwo cutoff count confidence tailConstant ≤
      ENNReal.ofReal radius := by
  let requirement := selectedShellGeometricDimensionTwoEffectiveCountRequirement cutoff confidence
    tailConstant radius
  have hthresholdZero : (64 : ℝ) ≤ requirement := by
