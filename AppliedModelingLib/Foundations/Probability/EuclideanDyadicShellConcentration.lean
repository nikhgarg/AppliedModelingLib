  let z := pOneFournierGuillinShellToleranceWithEta eta deviation shellMass scale
  have hshellMass_pos : 0 < shellMass :=
    euclideanDyadicCubeShellMassReal_pos_of_restrict_ne_zero dimension (scale + 1) law hnonzero
  have hmass_z : shellMass * z = weight := by
    simpa [z, shellMass, weight] using
      shellMass_mul_pOneFournierGuillinShellToleranceWithEta scale hshellMass_pos
  have hlog : Real.log 9 ≤ Real.log z := by
    apply Real.log_le_log (by norm_num : (0 : ℝ) < 9)
