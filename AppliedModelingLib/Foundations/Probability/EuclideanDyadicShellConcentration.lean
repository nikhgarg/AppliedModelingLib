          Real.log z)) := by rw [hrate_eq]
    _ ≤ Real.exp (-((count : ℝ) * deviation / (4 * (4 : ℝ) ^ scale) * logBudget)) := by
      apply Real.exp_le_exp.mpr
      nlinarith [mul_le_mul_of_nonneg_left hlog hcoefficient_nonneg]
    _ = Real.exp (-((count : ℝ) * deviation / (4 * (4 : ℝ) ^ scale) *
        (Real.log (deviation / (2 * (4 : ℝ) ^ scale)) +
          gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha -
            Real.log (∫ x : EuclideanSpace ℝ (Fin dimension),
              Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
                (law : Measure (EuclideanSpace ℝ (Fin dimension))))))) := by
      rfl

/--
