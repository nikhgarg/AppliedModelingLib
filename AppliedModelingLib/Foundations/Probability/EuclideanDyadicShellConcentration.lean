  have hthresholdFour :
      6 ^ 2 * selectedShellGeometricDimensionTwoSuccessorRootCoefficient cutoff confidence
          tailConstant ^ 2 / radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionTwoEffectiveCountRequirement]
    exact ((((le_max_left _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdFive :
      6 ^ 4 * selectedShellGeometricDimensionTwoSuccessorDepthQuarterCoefficient tailConstant ^ 4 /
          radius ^ 4 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionTwoEffectiveCountRequirement]
    exact (((((le_max_left _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)
  have hthresholdSix :
      6 ^ 2 * selectedShellGeometricDimensionTwoSuccessorSqrtCoefficient cutoff confidence
          tailConstant ^ 2 / radius ^ 2 ≤ requirement := by
    dsimp [requirement, selectedShellGeometricDimensionTwoEffectiveCountRequirement]
    exact (((((le_max_right _ _).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)).trans
      (le_max_right _ _)).trans (le_max_right _ _)
  apply selectedShellGeometricHeadSchedule_dimensionTwo_le_of_effectiveCountGates
    cutoff count confidence tailConstant radius hcount hcount64 hradius
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdOne.trans hrequirement
  · apply (div_le_iff₀ (pow_pos hradius 4)).mp
    exact hthresholdTwo.trans hrequirement
  · apply (div_le_iff₀ hradius).mp
    exact hthresholdThree.trans hrequirement
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdFour.trans hrequirement
  · apply (div_le_iff₀ (pow_pos hradius 4)).mp
    exact hthresholdFive.trans hrequirement
  · apply (div_le_iff₀ (sq_pos_of_pos hradius)).mp
    exact hthresholdSix.trans hrequirement

/-- The largest of the six explicit effective-count thresholds needed for the
supercritical selected-shell head at a positive target radius. -/
noncomputable def selectedShellGeometricSupercriticalEffectiveCountRequirement
    (dimension cutoff : ℕ) (confidence tailConstant radius : ℝ) : ℝ :=
  max
    (selectedShellGeometricSupercriticalRateCoefficient dimension ^ dimension /
      (radius / 6) ^ dimension)
    (max
      ((6 : ℝ) ^ 2 *
        (2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)) ^ 2 / radius ^ 2)
      (max
        (6 * (2 * Real.sqrt dimension *
          (16 * ((2 ^ dimension : ℕ) : ℝ) + 8 * (confidence + Real.log 2))) / radius)
        (max
          ((selectedShellGeometricSupercriticalRateCoefficient dimension *
            selectedShellGeometricTailMultiplier tailConstant) ^ dimension /
            (radius / 6) ^ dimension)
          (max
            ((6 : ℝ) ^ 2 *
              (2 * Real.sqrt dimension *
                Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2) *
                (4 * Real.sqrt tailConstant)) ^ 2 / radius ^ 2)
            ((6 : ℝ) ^ 2 *
              (2 * Real.sqrt dimension * Real.sqrt
                (16 * ((2 ^ dimension : ℕ) : ℝ) +
                  8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
                (4 * Real.sqrt tailConstant)) ^ 2 / radius ^ 2)))))

/-- A concrete positive batch count for the six supercritical selected-shell
effective-count gates. -/
noncomputable def selectedShellGeometricSupercriticalEffectiveCount
    (dimension cutoff : ℕ) (confidence tailConstant radius : ℝ) : ℕ :=
  Math.positiveNatCeil
    (selectedShellGeometricSupercriticalEffectiveCountRequirement dimension cutoff confidence
      tailConstant radius)

/-- The concrete supercritical effective count is positive. -/
theorem one_le_selectedShellGeometricSupercriticalEffectiveCount
    (dimension cutoff : ℕ) (confidence tailConstant radius : ℝ) :
    1 ≤ selectedShellGeometricSupercriticalEffectiveCount dimension cutoff confidence
      tailConstant radius := by
  unfold selectedShellGeometricSupercriticalEffectiveCount
  exact Math.one_le_positiveNatCeil _

/-- The concrete supercritical effective count dominates its six-way real
requirement. -/
theorem selectedShellGeometricSupercriticalEffectiveCountRequirement_le_count
    (dimension cutoff : ℕ) (confidence tailConstant radius : ℝ) :
    selectedShellGeometricSupercriticalEffectiveCountRequirement dimension cutoff confidence
      tailConstant radius ≤
        selectedShellGeometricSupercriticalEffectiveCount dimension cutoff confidence
          tailConstant radius := by
  unfold selectedShellGeometricSupercriticalEffectiveCount
  exact Math.le_positiveNatCeil _

/-- Six visible real component bounds control the supercritical selected-shell
compact-head schedule.  The components are retained separately so that a
source-rate proof can discharge each by its corresponding effective-count
gate, rather than hiding the rate in an existential schedule selector. -/
theorem selectedShellGeometricHeadSchedule_dimensionGreaterTwo_le_of_sixth_component_bounds
    (dimension cutoff count : ℕ) (confidence tailConstant radius : ℝ)
    (hradius : 0 ≤ radius)
    (hcentralLeading :
      selectedShellGeometricSupercriticalLeadingTerm dimension count ≤ radius / 6)
    (hcentralRoot :
      selectedShellGeometricCentralRootTerm dimension count confidence ≤ radius / 6)
    (hcentralCount :
      selectedShellGeometricCentralCountTerm dimension count confidence ≤ radius / 6)
    (hsuccessorLeading : selectedShellGeometricSupercriticalLeadingTerm dimension count *
      selectedShellGeometricTailMultiplier tailConstant ≤ radius / 6)
    (hsuccessorRoot : selectedShellGeometricSuccessorRootTerm dimension cutoff count confidence *
      selectedShellGeometricTailMultiplier tailConstant ≤ radius / 6)
    (hsuccessorCount : selectedShellGeometricSuccessorCountTerm dimension cutoff count confidence *
      selectedShellGeometricTailMultiplier tailConstant ≤ radius / 6) :
    selectedShellGeometricHeadSchedule_dimensionGreaterTwo dimension cutoff count confidence tailConstant ≤
      ENNReal.ofReal radius := by
  unfold selectedShellGeometricHeadSchedule_dimensionGreaterTwo
  have hbudget := AppliedModelingLib.Math.ennreal_ofReal_paired_sum_three_le_ofReal_of_each_le_sixth
    (a := selectedShellGeometricSupercriticalLeadingTerm dimension count)
    (b := selectedShellGeometricCentralRootTerm dimension count confidence)
    (c := selectedShellGeometricCentralCountTerm dimension count confidence)
    (d := selectedShellGeometricSupercriticalLeadingTerm dimension count *
      selectedShellGeometricTailMultiplier tailConstant)
    (e := selectedShellGeometricSuccessorRootTerm dimension cutoff count confidence *
      selectedShellGeometricTailMultiplier tailConstant)
    (f := selectedShellGeometricSuccessorCountTerm dimension cutoff count confidence *
      selectedShellGeometricTailMultiplier tailConstant)
    hradius hcentralLeading hcentralRoot hcentralCount hsuccessorLeading hsuccessorRoot
      hsuccessorCount
  convert hbudget using 1 <;>
    simp only [selectedShellGeometricSupercriticalLeadingTerm,
      selectedShellGeometricCentralRootTerm, selectedShellGeometricCentralCountTerm,
      selectedShellGeometricSuccessorRootTerm, selectedShellGeometricSuccessorCountTerm,
      selectedShellGeometricTailMultiplier] <;> ring

/-- The named leading component is the supercritical rate coefficient divided
by `N^(1/d)`. -/
theorem selectedShellGeometricSupercriticalLeadingTerm_eq_rateCoefficient_div_named
    (dimension : ℕ) (count : ℝ) :
    selectedShellGeometricSupercriticalLeadingTerm dimension count =
      selectedShellGeometricSupercriticalRateCoefficient dimension /
        count ^ ((dimension : ℝ)⁻¹) := by
  unfold selectedShellGeometricSupercriticalLeadingTerm
    selectedShellGeometricSupercriticalRateCoefficient
  ring

/-- Explicit polynomial, quadratic, and linear effective-count gates yield a
finite supercritical-dimensional selected-shell head bound.  The six gates
are left visible because the outer exponential-moment shell lift must choose
them jointly with its cutoff and confidence allocation. -/
theorem selectedShellGeometricHeadSchedule_dimensionGreaterTwo_le_of_effectiveCountGates
    (dimension cutoff count : ℕ) (confidence tailConstant radius : ℝ)
    (hdimension : 2 < dimension) (hcount : 0 < count) (hradius : 0 < radius)
    (hcentralLeadingGate : selectedShellGeometricSupercriticalRateCoefficient dimension ^ dimension ≤
      (count : ℝ) * (radius / 6) ^ dimension)
    (hcentralRootGate : 6 ^ 2 *
      (2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)) ^ 2 ≤
        (count : ℝ) * radius ^ 2)
    (hcentralCountGate : 6 *
      (2 * Real.sqrt dimension *
        (16 * ((2 ^ dimension : ℕ) : ℝ) + 8 * (confidence + Real.log 2))) ≤
        (count : ℝ) * radius)
    (hsuccessorLeadingGate : (selectedShellGeometricSupercriticalRateCoefficient dimension *
      selectedShellGeometricTailMultiplier tailConstant) ^ dimension ≤
        (count : ℝ) * (radius / 6) ^ dimension)
    (hsuccessorRootGate : 6 ^ 2 *
      (2 * Real.sqrt dimension *
        Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2) *
        (4 * Real.sqrt tailConstant)) ^ 2 ≤
        (count : ℝ) * radius ^ 2)
    (hsuccessorCountGate : 6 ^ 2 *
      (2 * Real.sqrt dimension * Real.sqrt
        (16 * ((2 ^ dimension : ℕ) : ℝ) +
          8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
        (4 * Real.sqrt tailConstant)) ^ 2 ≤
        (count : ℝ) * radius ^ 2) :
    selectedShellGeometricHeadSchedule_dimensionGreaterTwo dimension cutoff count confidence tailConstant ≤
      ENNReal.ofReal radius := by
  apply selectedShellGeometricHeadSchedule_dimensionGreaterTwo_le_of_sixth_component_bounds
    dimension cutoff count confidence tailConstant radius hradius.le
  · rw [selectedShellGeometricSupercriticalLeadingTerm_eq_rateCoefficient_div_named]
    exact AppliedModelingLib.Math.div_rpow_nat_inv_le_of_pow_le dimension (by omega)
      (selectedShellGeometricSupercriticalRateCoefficient_pos dimension hdimension).le
      (by exact_mod_cast hcount) (by positivity) hcentralLeadingGate
  · unfold selectedShellGeometricCentralRootTerm
    exact AppliedModelingLib.Math.div_sqrt_nat_le_div_of_sq_mul_le count hcount (by positivity)
      hradius.le (by norm_num) hcentralRootGate
  · unfold selectedShellGeometricCentralCountTerm
    convert AppliedModelingLib.Math.div_nat_le_div_of_mul_le count hcount (by norm_num)
      hcentralCountGate using 1 <;> ring
  · rw [selectedShellGeometricSupercriticalLeadingTerm_eq_rateCoefficient_div_named]
    have hcoefficient : 0 ≤ selectedShellGeometricSupercriticalRateCoefficient dimension *
        selectedShellGeometricTailMultiplier tailConstant := by
      apply mul_nonneg
      · exact (selectedShellGeometricSupercriticalRateCoefficient_pos dimension hdimension).le
      · unfold selectedShellGeometricTailMultiplier
        positivity
    have hbound := AppliedModelingLib.Math.div_rpow_nat_inv_le_of_pow_le dimension (by omega)
      hcoefficient (by exact_mod_cast hcount) (by positivity) hsuccessorLeadingGate
    convert hbound using 1 <;> ring
  · unfold selectedShellGeometricSuccessorRootTerm selectedShellGeometricTailMultiplier
    convert AppliedModelingLib.Math.div_sqrt_nat_le_div_of_sq_mul_le count hcount
      (by positivity : 0 ≤ 2 * Real.sqrt dimension *
        Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2) *
        (4 * Real.sqrt tailConstant)) hradius.le (by norm_num) hsuccessorRootGate using 1 <;> ring
  · unfold selectedShellGeometricSuccessorCountTerm selectedShellGeometricTailMultiplier
    rw [Real.sqrt_div' _ (Nat.cast_nonneg count)]
    convert AppliedModelingLib.Math.div_sqrt_nat_le_div_of_sq_mul_le count hcount
      (by positivity : 0 ≤ 2 * Real.sqrt dimension * Real.sqrt
        (16 * ((2 ^ dimension : ℕ) : ℝ) +
          8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
        (4 * Real.sqrt tailConstant)) hradius.le (by norm_num) hsuccessorCountGate using 1 <;> ring

/-- The concrete six-way ceiling selector satisfies every finite-head
effective-count gate in a supercritical dimension. -/
theorem selectedShellGeometricHeadSchedule_dimensionGreaterTwo_le_of_concreteEffectiveCount
    (dimension cutoff : ℕ) (confidence tailConstant radius : ℝ)
    (hdimension : 2 < dimension) (hradius : 0 < radius) :
    selectedShellGeometricHeadSchedule_dimensionGreaterTwo dimension cutoff
      (selectedShellGeometricSupercriticalEffectiveCount dimension cutoff confidence tailConstant radius)
      confidence tailConstant ≤ ENNReal.ofReal radius := by
  let count := selectedShellGeometricSupercriticalEffectiveCount dimension cutoff confidence
    tailConstant radius
  let requirement := selectedShellGeometricSupercriticalEffectiveCountRequirement
    dimension cutoff confidence tailConstant radius
  have hcount : 0 < count :=
    lt_of_lt_of_le zero_lt_one
      (one_le_selectedShellGeometricSupercriticalEffectiveCount dimension cutoff confidence
        tailConstant radius)
  have hrequirement : requirement ≤ (count : ℝ) := by
    dsimp [count, requirement]
    exact selectedShellGeometricSupercriticalEffectiveCountRequirement_le_count
      dimension cutoff confidence tailConstant radius
  apply selectedShellGeometricHeadSchedule_dimensionGreaterTwo_le_of_effectiveCountGates
    dimension cutoff count confidence tailConstant radius hdimension hcount hradius
  · have hquot : selectedShellGeometricSupercriticalRateCoefficient dimension ^ dimension /
        (radius / 6) ^ dimension ≤ (count : ℝ) := by
      calc
        selectedShellGeometricSupercriticalRateCoefficient dimension ^ dimension /
            (radius / 6) ^ dimension ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact le_max_left _ _
        _ ≤ count := hrequirement
    exact (div_le_iff₀ (pow_pos (by positivity) _)).mp hquot
  · have hquot : (6 : ℝ) ^ 2 *
        (2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)) ^ 2 /
          radius ^ 2 ≤ (count : ℝ) := by
      calc
        (6 : ℝ) ^ 2 *
            (2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)) ^ 2 /
            radius ^ 2 ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact (le_max_left _ _).trans (le_max_right _ _)
        _ ≤ count := hrequirement
    exact (div_le_iff₀ (pow_pos hradius _)).mp hquot
  · have hquot : 6 *
        (2 * Real.sqrt dimension *
          (16 * ((2 ^ dimension : ℕ) : ℝ) + 8 * (confidence + Real.log 2))) /
          radius ≤ (count : ℝ) := by
      calc
        6 *
            (2 * Real.sqrt dimension *
              (16 * ((2 ^ dimension : ℕ) : ℝ) + 8 * (confidence + Real.log 2))) /
            radius ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact ((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _)
        _ ≤ count := hrequirement
    exact (div_le_iff₀ hradius).mp hquot
  · have hquot : (selectedShellGeometricSupercriticalRateCoefficient dimension *
        selectedShellGeometricTailMultiplier tailConstant) ^ dimension /
          (radius / 6) ^ dimension ≤ (count : ℝ) := by
      calc
        (selectedShellGeometricSupercriticalRateCoefficient dimension *
            selectedShellGeometricTailMultiplier tailConstant) ^ dimension /
            (radius / 6) ^ dimension ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact (((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _)).trans
            (le_max_right _ _)
        _ ≤ count := hrequirement
    exact (div_le_iff₀ (pow_pos (by positivity) _)).mp hquot
  · have hquot : (6 : ℝ) ^ 2 *
        (2 * Real.sqrt dimension *
          Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2) *
          (4 * Real.sqrt tailConstant)) ^ 2 / radius ^ 2 ≤ (count : ℝ) := by
      calc
        (6 : ℝ) ^ 2 *
            (2 * Real.sqrt dimension *
              Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2) *
              (4 * Real.sqrt tailConstant)) ^ 2 / radius ^ 2 ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact ((((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _)).trans
            (le_max_right _ _)).trans (le_max_right _ _)
        _ ≤ count := hrequirement
    exact (div_le_iff₀ (pow_pos hradius _)).mp hquot
  · have hquot : (6 : ℝ) ^ 2 *
        (2 * Real.sqrt dimension * Real.sqrt
          (16 * ((2 ^ dimension : ℕ) : ℝ) +
            8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
          (4 * Real.sqrt tailConstant)) ^ 2 / radius ^ 2 ≤ (count : ℝ) := by
      calc
        (6 : ℝ) ^ 2 *
            (2 * Real.sqrt dimension * Real.sqrt
              (16 * ((2 ^ dimension : ℕ) : ℝ) +
                8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
              (4 * Real.sqrt tailConstant)) ^ 2 / radius ^ 2 ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact ((((le_max_right _ _).trans (le_max_right _ _)).trans (le_max_right _ _)).trans
            (le_max_right _ _)).trans (le_max_right _ _)
        _ ≤ count := hrequirement
    exact (div_le_iff₀ (pow_pos hradius _)).mp hquot

/-- Any positive count dominating the six-way effective-count requirement
controls the supercritical finite compact head.  This monotone-gate form is
what permits the compact selector to be joined with independent all-shell
mass and source-rate selectors by taking a maximum. -/
theorem selectedShellGeometricHeadSchedule_dimensionGreaterTwo_le_of_effectiveCountRequirement_le
    (dimension cutoff count : ℕ) (confidence tailConstant radius : ℝ)
    (hdimension : 2 < dimension) (hcount : 0 < count) (hradius : 0 < radius)
    (hrequirement :
      selectedShellGeometricSupercriticalEffectiveCountRequirement dimension cutoff confidence
        tailConstant radius ≤ (count : ℝ)) :
    selectedShellGeometricHeadSchedule_dimensionGreaterTwo dimension cutoff count confidence tailConstant ≤
      ENNReal.ofReal radius := by
  let requirement := selectedShellGeometricSupercriticalEffectiveCountRequirement
    dimension cutoff confidence tailConstant radius
  apply selectedShellGeometricHeadSchedule_dimensionGreaterTwo_le_of_effectiveCountGates
    dimension cutoff count confidence tailConstant radius hdimension hcount hradius
  · have hquot : selectedShellGeometricSupercriticalRateCoefficient dimension ^ dimension /
        (radius / 6) ^ dimension ≤ (count : ℝ) := by
      calc
        selectedShellGeometricSupercriticalRateCoefficient dimension ^ dimension /
            (radius / 6) ^ dimension ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact le_max_left _ _
        _ ≤ count := hrequirement
    exact (div_le_iff₀ (pow_pos (by positivity) _)).mp hquot
  · have hquot : (6 : ℝ) ^ 2 *
        (2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)) ^ 2 /
          radius ^ 2 ≤ (count : ℝ) := by
      calc
        (6 : ℝ) ^ 2 *
            (2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)) ^ 2 /
            radius ^ 2 ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact (le_max_left _ _).trans (le_max_right _ _)
        _ ≤ count := hrequirement
    exact (div_le_iff₀ (pow_pos hradius _)).mp hquot
  · have hquot : 6 *
        (2 * Real.sqrt dimension *
          (16 * ((2 ^ dimension : ℕ) : ℝ) + 8 * (confidence + Real.log 2))) /
          radius ≤ (count : ℝ) := by
      calc
        6 *
            (2 * Real.sqrt dimension *
              (16 * ((2 ^ dimension : ℕ) : ℝ) + 8 * (confidence + Real.log 2))) /
            radius ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact ((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _)
        _ ≤ count := hrequirement
    exact (div_le_iff₀ hradius).mp hquot
  · have hquot : (selectedShellGeometricSupercriticalRateCoefficient dimension *
        selectedShellGeometricTailMultiplier tailConstant) ^ dimension /
          (radius / 6) ^ dimension ≤ (count : ℝ) := by
      calc
        (selectedShellGeometricSupercriticalRateCoefficient dimension *
            selectedShellGeometricTailMultiplier tailConstant) ^ dimension /
            (radius / 6) ^ dimension ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact (((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _)).trans
            (le_max_right _ _)
        _ ≤ count := hrequirement
    exact (div_le_iff₀ (pow_pos (by positivity) _)).mp hquot
  · have hquot : (6 : ℝ) ^ 2 *
        (2 * Real.sqrt dimension *
          Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2) *
          (4 * Real.sqrt tailConstant)) ^ 2 / radius ^ 2 ≤ (count : ℝ) := by
      calc
        (6 : ℝ) ^ 2 *
            (2 * Real.sqrt dimension *
              Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2) *
              (4 * Real.sqrt tailConstant)) ^ 2 / radius ^ 2 ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact ((((le_max_left _ _).trans (le_max_right _ _)).trans (le_max_right _ _)).trans
            (le_max_right _ _)).trans (le_max_right _ _)
        _ ≤ count := hrequirement
    exact (div_le_iff₀ (pow_pos hradius _)).mp hquot
  · have hquot : (6 : ℝ) ^ 2 *
        (2 * Real.sqrt dimension * Real.sqrt
          (16 * ((2 ^ dimension : ℕ) : ℝ) +
            8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
          (4 * Real.sqrt tailConstant)) ^ 2 / radius ^ 2 ≤ (count : ℝ) := by
      calc
        (6 : ℝ) ^ 2 *
            (2 * Real.sqrt dimension * Real.sqrt
              (16 * ((2 ^ dimension : ℕ) : ℝ) +
                8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
              (4 * Real.sqrt tailConstant)) ^ 2 / radius ^ 2 ≤ requirement := by
          dsimp [requirement, selectedShellGeometricSupercriticalEffectiveCountRequirement]
          exact ((((le_max_right _ _).trans (le_max_right _ _)).trans (le_max_right _ _)).trans
            (le_max_right _ _)).trans (le_max_right _ _)
        _ ≤ count := hrequirement
