    apply div_le_div_of_nonneg_right
    · exact mul_le_mul_of_nonneg_right hcoefficient (Real.sqrt_nonneg _)
    · exact Real.sqrt_nonneg _
  refine hlocal.trans ?_
  apply mul_le_mul_left'
  apply ENNReal.ofReal_le_ofReal
