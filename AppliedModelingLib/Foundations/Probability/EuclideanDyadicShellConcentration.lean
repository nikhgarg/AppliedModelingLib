/--
After any cutoff, the sparse-occupancy branch of the source's `J_n` shell
allocation has an explicit exponential-moment tail.  Its geometric base is
`2^alpha`, so this is available for every positive radial-moment exponent.
-/
theorem measureReal_iUnion_cutoff_add_pOneFournierGuillinLargeShellMassTailWithEta_le_count_mul_exponentialRadialMoment
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count cutoff : ℕ) (hcount : 0 < count)
    {eta deviation alpha gamma : ℝ}
    (halpha_pos : 0 < alpha) (hgamma_pos : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (⋃ offset,
          pOneFournierGuillinLargeShellMassTailWithEta dimension law count eta deviation
            (cutoff + offset)) ≤
      (count : ℝ) *
        (∫ x : EuclideanSpace ℝ (Fin dimension),
          Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
            (law : Measure (EuclideanSpace ℝ (Fin dimension)))) *
          (Real.exp (-(gamma * Real.rpow 2 alpha ^ cutoff)) /
            (1 - Real.exp (-(gamma * Real.rpow 2 alpha ^ cutoff *
              (Real.rpow 2 alpha - 1))))) := by
  classical
  let sampleLaw := finiteIIDSampleLaw
    (law : Measure (EuclideanSpace ℝ (Fin dimension))) count
  let tail := fun offset =>
    pOneFournierGuillinLargeShellMassTailWithEta dimension law count eta deviation
      (cutoff + offset)
  let base : ℝ := Real.rpow 2 alpha
  let rate : ℝ := gamma * base ^ cutoff
  let moment : ℝ := ∫ x : EuclideanSpace ℝ (Fin dimension),
    Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
      (law : Measure (EuclideanSpace ℝ (Fin dimension)))
  let coefficient : ℝ := (count : ℝ) * moment
  let budget : ℕ → ℝ := fun offset => coefficient * Real.exp (-rate * base ^ offset)
  letI : IsProbabilityMeasure sampleLaw := by
    dsimp [sampleLaw, finiteIIDSampleLaw]
    infer_instance
  have hbase : 1 < base := by
    dsimp [base]
    simpa only [Real.rpow_eq_pow] using
      Real.one_lt_rpow (by norm_num : (1 : ℝ) < 2) halpha_pos
  have hmoment_nonneg : 0 ≤ moment := by
    dsimp [moment]
    apply integral_nonneg
    intro x
    exact (Real.exp_pos _).le
  have hcoefficient_nonneg : 0 ≤ coefficient := by
    dsimp [coefficient]
    positivity
  have hrate_pos : 0 < rate := by
    dsimp [rate]
    positivity
  have hbudget_nonneg : ∀ offset, 0 ≤ budget offset := by
    intro offset
    dsimp [budget]
    positivity
  have hsum : (∑' offset, ENNReal.ofReal (budget offset)) ≠ ⊤ := by
    exact (AppliedModelingLib.Math.summable_exp_neg_mul_pow hrate_pos hbase).mul_left coefficient |>.tsum_ofReal_ne_top
  have hiUnion := measureReal_iUnion_le_tsum_ofReal_bound sampleLaw tail budget
    hbudget_nonneg (fun offset => by
      dsimp [sampleLaw, tail]
      have htail :=
        measureReal_pOneFournierGuillinLargeShellMassTailWithEta_le_count_mul_exponentialRadialMoment
          dimension law count hcount (eta := eta) (deviation := deviation) (cutoff + offset)
          halpha_pos.le hgamma_pos.le hmoment
      calc
        (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
            (pOneFournierGuillinLargeShellMassTailWithEta dimension law count eta deviation
              (cutoff + offset)) ≤
            (count : ℝ) *
              (Real.exp (-(gamma * Real.rpow
                (euclideanDyadicCubeRadius (cutoff + offset)) alpha)) * moment) := by
          simpa [moment] using htail
        _ = budget offset := by
          dsimp [budget, coefficient, rate, base]
          rw [← Real.rpow_eq_pow, euclideanDyadicCubeRadius_rpow_eq_rpow_pow, pow_add,
            ← Real.rpow_eq_pow (2 : ℝ) alpha]
          ring) hsum
  have htsum_real :
      (∑' offset, ENNReal.ofReal (budget offset)).toReal = ∑' offset, budget offset := by
    rw [ENNReal.tsum_toReal_eq (fun _ => ENNReal.ofReal_ne_top)]
    apply tsum_congr
    intro offset
    exact ENNReal.toReal_ofReal (hbudget_nonneg offset)
  have hseries :=
    AppliedModelingLib.Math.tsum_exp_neg_mul_pow_le_exp_neg_div_one_sub_exp_neg
      hrate_pos le_rfl hbase
  calc
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (⋃ offset,
          pOneFournierGuillinLargeShellMassTailWithEta dimension law count eta deviation
            (cutoff + offset)) = sampleLaw.real (⋃ offset, tail offset) := by rfl
    _ ≤ (∑' offset, ENNReal.ofReal (budget offset)).toReal := hiUnion
    _ = ∑' offset, budget offset := htsum_real
    _ = coefficient * ∑' offset, Real.exp (-rate * base ^ offset) := by
      rw [tsum_mul_left]
    _ ≤ coefficient *
        (Real.exp (-rate) /
          (1 - Real.exp (-(rate * (base - 1))))) := by
      exact mul_le_mul_of_nonneg_left hseries hcoefficient_nonneg
    _ = (count : ℝ) *
        (∫ x : EuclideanSpace ℝ (Fin dimension),
          Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
            (law : Measure (EuclideanSpace ℝ (Fin dimension)))) *
          (Real.exp (-(gamma * Real.rpow 2 alpha ^ cutoff)) /
            (1 - Real.exp (-(gamma * Real.rpow 2 alpha ^ cutoff *
              (Real.rpow 2 alpha - 1))))) := by
      rfl

