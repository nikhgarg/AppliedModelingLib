/--
There is a moment-dependent shell scale such that, once the concrete
finite-head cutoff reaches it, all later positive-mass shells satisfy the
large-`z_n` and residual-log Bennett gates.  The proof explicitly absorbs the
deviation logarithm into the head index instead of assuming a cutoff
certificate.
-/
theorem exists_pOneFournierGuillin_headCutoffLargeShellGateScale
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {eta alpha gamma : ℝ}
    (heta_pos : 0 < eta) (halpha_pos : 0 < alpha) (hgamma_pos : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    ∃ gateScale : ℕ, ∀ {deviation : ℝ}, 0 < deviation →
      gateScale ≤ pOneFournierGuillinHeadCutoff eta deviation →
      ∀ offset, law.toFiniteMeasure.restrict
        (euclideanDyadicCubeShell dimension
          (pOneFournierGuillinHeadCutoff eta deviation + offset + 1)) ≠ 0 →
      9 ≤ pOneFournierGuillinShellToleranceWithEta eta deviation
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension
            (pOneFournierGuillinHeadCutoff eta deviation + offset + 1)))
        (pOneFournierGuillinHeadCutoff eta deviation + offset) ∧
      -(gamma * Real.rpow (euclideanDyadicCubeRadius
        (pOneFournierGuillinHeadCutoff eta deviation + offset)) alpha) / 2 ≤
        Real.log (pOneFournierGuillinShellWeight eta deviation
          (pOneFournierGuillinHeadCutoff eta deviation + offset)) -
          Real.log (∫ x : EuclideanSpace ℝ (Fin dimension),
            Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
              (law : Measure (EuclideanSpace ℝ (Fin dimension)))) := by
  let moment := ∫ x : EuclideanSpace ℝ (Fin dimension),
    Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂ (law : Measure (EuclideanSpace ℝ (Fin dimension)))
  let logCoefficient := Real.log (pOneFournierGuillinShellCoefficient eta)
  let intercept : ℝ := 2 / gamma * max (Real.log moment - logCoefficient) (Real.log 9)
  let slope : ℝ := 2 / gamma * (3 * (1 + eta) * Real.log 2)
  let halfBase : ℝ := Real.rpow 2 (alpha / 2)
  have hhalfBase : 1 < halfBase := by
    dsimp [halfBase]
    simpa only [Real.rpow_eq_pow] using
      Real.one_lt_rpow (by norm_num : (1 : ℝ) < 2) (by linarith : 0 < alpha / 2)
  have hhalfBase_sq : halfBase ^ 2 = Real.rpow 2 alpha := by
    dsimp [halfBase]
    calc
      (Real.rpow 2 (alpha / 2)) ^ 2 = Real.rpow 2 ((alpha / 2) * (2 : ℝ)) := by
        simpa only [Real.rpow_eq_pow] using
          (Real.rpow_mul_natCast (by norm_num : (0 : ℝ) ≤ 2) (alpha / 2) 2).symm
      _ = Real.rpow 2 alpha := by
        congr 1
        ring
  obtain ⟨gateScale, hgateScale⟩ :=
    AppliedModelingLib.Math.exists_cutoff_affine_cutoff_add_le_sq_pow
      (a := intercept) (b := slope) hhalfBase
  refine ⟨gateScale, fun {deviation} hdeviation_pos hgate_le offset hnonzero => ?_⟩
  obtain ⟨shift, hhead_eq⟩ := Nat.exists_eq_add_of_le hgate_le
  let scale : ℕ := pOneFournierGuillinHeadCutoff eta deviation + offset
  have hlinear : intercept + slope * (scale : ℝ) ≤
      Real.rpow 2 alpha ^ scale := by
    have hraw := hgateScale (shift + offset)
    rw [hhalfBase_sq] at hraw
    simpa [scale, hhead_eq, Nat.add_assoc] using hraw
  have hlinearScaled := mul_le_mul_of_nonneg_left hlinear
    (show 0 ≤ gamma / 2 by positivity)
  have hlinear_eq : gamma / 2 * (intercept + slope * (scale : ℝ)) =
      max (Real.log moment - logCoefficient) (Real.log 9) +
        3 * (1 + eta) * (scale : ℝ) * Real.log 2 := by
    dsimp [intercept, slope]
    field_simp [hgamma_pos.ne']
  have hpower_eq : gamma / 2 * Real.rpow 2 alpha ^ scale =
      gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha / 2 := by
    rw [euclideanDyadicCubeRadius_rpow_eq_rpow_pow]
    ring
  have hdominates : max (Real.log moment - logCoefficient) (Real.log 9) +
      3 * (1 + eta) * (scale : ℝ) * Real.log 2 ≤
      gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha / 2 := by
    calc
      max (Real.log moment - logCoefficient) (Real.log 9) +
          3 * (1 + eta) * (scale : ℝ) * Real.log 2 =
          gamma / 2 * (intercept + slope * (scale : ℝ)) := hlinear_eq.symm
      _ ≤ gamma / 2 * Real.rpow 2 alpha ^ scale := hlinearScaled
      _ = gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha / 2 := hpower_eq
  have hhead_le_scale : (pOneFournierGuillinHeadCutoff eta deviation : ℝ) ≤
      (scale : ℝ) := by
    exact_mod_cast Nat.le_add_right (pOneFournierGuillinHeadCutoff eta deviation) offset
  have hlogDeviation := neg_log_deviation_le_two_mul_headCutoff_mul_log_two
    heta_pos hdeviation_pos
  have hfactor_nonneg : 0 ≤ 2 * (1 + eta) * Real.log 2 := by positivity
  have hlogDeviation_scale : -Real.log deviation ≤
      2 * (1 + eta) * (scale : ℝ) * Real.log 2 := by
    calc
      -Real.log deviation ≤ 2 * (1 + eta) *
          (pOneFournierGuillinHeadCutoff eta deviation : ℝ) * Real.log 2 := hlogDeviation
      _ = (2 * (1 + eta) * Real.log 2) *
          (pOneFournierGuillinHeadCutoff eta deviation : ℝ) := by ring
      _ ≤ (2 * (1 + eta) * Real.log 2) * (scale : ℝ) :=
        mul_le_mul_of_nonneg_left hhead_le_scale hfactor_nonneg
      _ = 2 * (1 + eta) * (scale : ℝ) * Real.log 2 := by ring
  have hcore : Real.log moment - logCoefficient +
      3 * (1 + eta) * (scale : ℝ) * Real.log 2 ≤
      gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha / 2 := by
    calc
      Real.log moment - logCoefficient +
          3 * (1 + eta) * (scale : ℝ) * Real.log 2 ≤
          max (Real.log moment - logCoefficient) (Real.log 9) +
            3 * (1 + eta) * (scale : ℝ) * Real.log 2 := by
              gcongr
              exact le_max_left _ _
      _ ≤ gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha / 2 := hdominates
  have hcutCore : Real.log moment - logCoefficient - Real.log deviation +
      (1 + eta) * (scale : ℝ) * Real.log 2 ≤
      gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha / 2 := by
    linarith
  have hcoefficient_pos : 0 < pOneFournierGuillinShellCoefficient eta :=
    pOneFournierGuillinShellCoefficient_pos heta_pos
  have hcoefficientLog : Real.log
      (pOneFournierGuillinShellCoefficient eta * deviation) =
      logCoefficient + Real.log deviation := by
    dsimp [logCoefficient]
    exact Real.log_mul hcoefficient_pos.ne' hdeviation_pos.ne'
  have hweightLog := log_pOneFournierGuillinShellWeight scale heta_pos hdeviation_pos
  have hcut : -(gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha) / 2 ≤
      Real.log (pOneFournierGuillinShellWeight eta deviation scale) - Real.log moment := by
    rw [hweightLog, hcoefficientLog]
    linarith
  have hterm_nonneg : 0 ≤ 3 * (1 + eta) * (scale : ℝ) * Real.log 2 := by positivity
  have hlargeMoment : Real.log 9 ≤
      gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha / 2 := by
    calc
      Real.log 9 ≤ max (Real.log moment - logCoefficient) (Real.log 9) := le_max_right _ _
      _ ≤ max (Real.log moment - logCoefficient) (Real.log 9) +
          3 * (1 + eta) * (scale : ℝ) * Real.log 2 := by linarith
      _ ≤ gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha / 2 := hdominates
  have hweight_pos : 0 < pOneFournierGuillinShellWeight eta deviation scale :=
    pOneFournierGuillinShellWeight_pos scale heta_pos hdeviation_pos
  have hlogTolerance :=
    log_pOneFournierGuillinShellToleranceWithEta_lower_of_exponentialRadialMoment
      dimension law scale hweight_pos halpha_pos.le hgamma_pos.le hmoment hnonzero
  have hhalfBudget : gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha / 2 ≤
      Real.log (pOneFournierGuillinShellWeight eta deviation scale) +
        gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha - Real.log moment := by
    linarith
  have hlogLarge : Real.log 9 ≤
      Real.log (pOneFournierGuillinShellToleranceWithEta eta deviation
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1))) scale) := by
    calc
      Real.log 9 ≤ gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha / 2 := hlargeMoment
      _ ≤ Real.log (pOneFournierGuillinShellWeight eta deviation scale) +
          gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha - Real.log moment := hhalfBudget
      _ ≤ Real.log (pOneFournierGuillinShellToleranceWithEta eta deviation
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension (scale + 1))) scale) := by
        simpa [moment] using hlogTolerance
  have hshellMass_pos : 0 <
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1))) :=
    euclideanDyadicCubeShellMassReal_pos_of_restrict_ne_zero dimension
      (scale + 1) law hnonzero
  have htolerance_pos : 0 < pOneFournierGuillinShellToleranceWithEta eta deviation
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1))) scale := by
    dsimp [pOneFournierGuillinShellToleranceWithEta]
    exact div_pos hweight_pos hshellMass_pos
  have hlarge : 9 ≤ pOneFournierGuillinShellToleranceWithEta eta deviation
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1))) scale := by
    have hexp := Real.exp_le_exp.mpr hlogLarge
    rw [Real.exp_log (by norm_num : (0 : ℝ) < 9), Real.exp_log htolerance_pos] at hexp
    exact hexp
  simpa [scale] using ⟨hlarge, hcut⟩

