/--
The inactive part of a finite one-dimensional noncentral head uses only its
zero-depth terminal-radius budget.  The displayed rate is obtained from the
literal complement of the selected-shell effective-count gate, rather than
from an auxiliary small-mass subset.
-/
theorem sum_selectedShellGeometricInactiveOffsets_dimensionOne_le
    (cutoff count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin 1)))
    {alpha gamma confidence : ℝ} (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑ scale ∈ selectedShellGeometricInactiveOffsets 1 cutoff count law confidence,
      euclideanDyadicCubeShellMass 1 law (scale + 1) *
        selectedShellGeometricCompactBudget 1 count law
          (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence (scale + 1)) ≤
      ENNReal.ofReal
        (2 * Real.sqrt
          ((16 * ((2 ^ 1 : ℕ) : ℝ) +
            8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / (count : ℝ)) *
          (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma))) := by
  let offsets := selectedShellGeometricInactiveOffsets 1 cutoff count law confidence
  let threshold : ℝ :=
    (16 * ((2 ^ 1 : ℕ) : ℝ) +
      8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / (count : ℝ)
  let sourceTerm : ℕ → ℝ := fun scale =>
    euclideanDyadicCubeRadius (scale + 1) *
      (law : Measure (EuclideanSpace ℝ (Fin 1))).real
        (euclideanDyadicCubeShell 1 (scale + 1))
  have hoffsets : offsets ⊆ Finset.range cutoff := by
    intro scale hscale
    exact (mem_selectedShellGeometricInactiveOffsets_iff
      1 cutoff count scale law confidence).mp hscale |>.1
  have hmass : ∀ scale, scale ∈ offsets →
      (law : Measure (EuclideanSpace ℝ (Fin 1))).real
        (euclideanDyadicCubeShell 1 (scale + 1)) ≤ threshold := by
    intro scale hscale
    have hinactive := (mem_selectedShellGeometricInactiveOffsets_iff
      1 cutoff count scale law confidence).mp hscale |>.2
    exact (measureReal_euclideanDyadicCubeShell_succ_lt_inactiveHeadThreshold
      1 count cutoff scale law confidence hcount hconfidence
      (hoffsets hscale) hinactive).le
  have hsourceSum :=
    sum_subset_measureReal_euclideanDyadicCubeShell_succ_mul_radius_le_sqrt_threshold_mul_fifthOrderExponentialRadialTail
      1 cutoff law offsets hoffsets halpha hgamma hmoment hmass
  have hterm : ∀ scale, scale ∈ offsets →
      euclideanDyadicCubeShellMass 1 law (scale + 1) *
          selectedShellGeometricCompactBudget 1 count law
            (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence (scale + 1) =
        ENNReal.ofReal (2 * sourceTerm scale) := by
    intro scale hscale
    have hinactive := (mem_selectedShellGeometricInactiveOffsets_iff
      1 cutoff count scale law confidence).mp hscale |>.2
    have hdepth : selectedShellGeometricEffectiveDepth 1 count law confidence (scale + 1) = 0 :=
      selectedShellGeometricEffectiveDepth_eq_zero_of_inactive
        1 count (scale + 1) law confidence hinactive
    have hbudget :
        selectedShellGeometricCompactBudget 1 count law
            (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence (scale + 1) =
          selectedShellGeometricCompactBudget 1 count law (fun _ => 0) confidence (scale + 1) := by
      unfold selectedShellGeometricCompactBudget
      rw [hdepth]
    have hmassENN : euclideanDyadicCubeShellMass 1 law (scale + 1) =
        ENNReal.ofReal
          ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
            (euclideanDyadicCubeShell 1 (scale + 1))) := by
      unfold euclideanDyadicCubeShellMass
      symm
      exact MeasureTheory.ofReal_measureReal (by finiteness)
    have hsource_nonneg : 0 ≤ sourceTerm scale := by
      dsimp [sourceTerm]
      exact mul_nonneg (euclideanDyadicCubeRadius_pos _).le
        MeasureTheory.measureReal_nonneg
    rw [hbudget, selectedShellGeometricCompactBudget_zeroDepth, hmassENN]
    simp only [Nat.cast_one, Real.sqrt_one, mul_one]
    calc
      ENNReal.ofReal
