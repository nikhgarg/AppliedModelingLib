            (euclideanDyadicCubeShell 1 (scale + 1))) *
          (ENNReal.ofReal (euclideanDyadicCubeRadius (scale + 1)) * ENNReal.ofReal 2) =
        ENNReal.ofReal (euclideanDyadicCubeRadius (scale + 1)) *
          (ENNReal.ofReal 2 * ENNReal.ofReal
            ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 (scale + 1))) ) := by
            ac_rfl
      _ =
          (ENNReal.ofReal (euclideanDyadicCubeRadius (scale + 1)) * ENNReal.ofReal
            ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 (scale + 1)))) * ENNReal.ofReal 2 := by
            ac_rfl
      _ = ENNReal.ofReal
          (euclideanDyadicCubeRadius (scale + 1) *
            (law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 (scale + 1))) * ENNReal.ofReal 2 := by
            rw [← ENNReal.ofReal_mul (euclideanDyadicCubeRadius_pos _).le]
      _ = ENNReal.ofReal (sourceTerm scale) * ENNReal.ofReal 2 := by
            rfl
      _ = ENNReal.ofReal (sourceTerm scale * 2) := by
            rw [← ENNReal.ofReal_mul hsource_nonneg]
      _ = ENNReal.ofReal (2 * sourceTerm scale) := by
            congr 1
            ring
