        ∑ shell ∈ support.filter (fun shell => ¬ cutoff < shell), compactTerm shell := by
    exact (Finset.sum_filter_add_sum_filter_not support (fun shell => cutoff < shell)
      compactTerm).symm
  have htail_eq :
      (∑ shell ∈ support.filter (fun shell => cutoff < shell), compactTerm shell) =
        ∑ shell ∈ support.filter (fun shell => cutoff < shell), zeroDepthTerm shell := by
    apply Finset.sum_congr rfl
    intro shell hshell
    have hshell_lt : cutoff < shell := (Finset.mem_filter.mp hshell).2
    dsimp [compactTerm, zeroDepthTerm]
    unfold finiteIIDCompactShellDyadicWassersteinBudget
    rw [hzeroDepth shell hshell_lt]
  have htail : ∑ shell ∈ support.filter (fun shell => cutoff < shell),
      zeroDepthTerm shell ≤ tailBound := by
