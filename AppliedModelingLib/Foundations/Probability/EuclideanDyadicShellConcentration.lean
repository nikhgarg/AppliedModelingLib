  let coefficient : ℝ :=
    2 * (1 / (1 - 1 / Real.sqrt 2)) +
      2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)
  let rate : ℕ → ℝ := fun scale =>
    terminal + coefficient *
      Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
        (euclideanDyadicCubeShell 1 (scale + 1))) / Real.sqrt count
  have hlocal : ∀ scale, scale ∈ offsets →
      euclideanDyadicCubeShellMass 1 law (scale + 1) *
        selectedShellGeometricCompactBudget 1 count law
          (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence (scale + 1) ≤
        ENNReal.ofReal (euclideanDyadicCubeRadius (scale + 1)) * ENNReal.ofReal (rate scale) := by
    intro scale hscale
    have hscaleRange : scale ∈ Finset.range cutoff := hoffsets hscale
    dsimp [rate, terminal, coefficient]
    exact euclideanDyadicCubeShellMass_mul_selectedShellGeometricCompactBudget_dimensionOne_active_succ_le_headConfidence
      cutoff scale count law confidence hcount hconfidence hscaleRange
      (hshellMass scale hscale) (hactive scale hscale)
  have hsqrt_two_pos : 0 < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)
  have hinv_sqrt_two_lt_one : 1 / Real.sqrt 2 < 1 := by
    apply (div_lt_iff₀ hsqrt_two_pos).2
    simpa using Real.one_lt_sqrt_two
  have hden_pos : 0 < 1 - 1 / Real.sqrt 2 := by linarith
  have hcoefficient_nonneg : 0 ≤ coefficient := by
    dsimp [coefficient]
    exact add_nonneg
      (mul_nonneg (by norm_num) (one_div_nonneg.mpr hden_pos.le))
      (mul_nonneg (by norm_num) (Real.sqrt_nonneg _))
  have hterminal_nonneg : 0 ≤ terminal := by
    dsimp [terminal]
    positivity
  have hsqrt_count_nonneg : 0 ≤ Real.sqrt (count : ℝ) := Real.sqrt_nonneg _
  have hrate_nonneg : ∀ scale, 0 ≤ rate scale := by
    intro scale
    dsimp [rate]
    apply add_nonneg hterminal_nonneg
    exact div_nonneg
      (mul_nonneg hcoefficient_nonneg (Real.sqrt_nonneg _))
      hsqrt_count_nonneg
  have hterm_nonneg : ∀ scale, scale ∈ offsets →
      0 ≤ euclideanDyadicCubeRadius (scale + 1) * rate scale := by
    intro scale _
    exact mul_nonneg (euclideanDyadicCubeRadius_pos _).le (hrate_nonneg scale)
  have hrate_sum := sum_subset_dimensionOne_activeRate_le_fifthOrderExponentialRadialTail
    cutoff count law offsets hoffsets (confidence := confidence) hcount halpha hgamma hmoment
  change (∑ scale ∈ offsets,
      euclideanDyadicCubeShellMass 1 law (scale + 1) *
        selectedShellGeometricCompactBudget 1 count law
          (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence (scale + 1)) ≤
    ENNReal.ofReal
      (terminal * (2 * ((2 : ℝ) ^ cutoff - 1)) +
        (coefficient / Real.sqrt count) *
          (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)))
  calc
    (∑ scale ∈ offsets,
      euclideanDyadicCubeShellMass 1 law (scale + 1) *
        selectedShellGeometricCompactBudget 1 count law
          (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence (scale + 1)) ≤
        ∑ scale ∈ offsets,
          ENNReal.ofReal (euclideanDyadicCubeRadius (scale + 1)) * ENNReal.ofReal (rate scale) := by
      apply Finset.sum_le_sum
      intro scale hscale
      exact hlocal scale hscale
    _ = ∑ scale ∈ offsets,
        ENNReal.ofReal (euclideanDyadicCubeRadius (scale + 1) * rate scale) := by
      apply Finset.sum_congr rfl
      intro scale hscale
      symm
      exact ENNReal.ofReal_mul (euclideanDyadicCubeRadius_pos _).le
    _ = ENNReal.ofReal (∑ scale ∈ offsets,
        euclideanDyadicCubeRadius (scale + 1) * rate scale) := by
      symm
      exact ENNReal.ofReal_sum_of_nonneg hterm_nonneg
    _ ≤ ENNReal.ofReal
        (terminal * (2 * ((2 : ℝ) ^ cutoff - 1)) +
          (coefficient / Real.sqrt count) *
            (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma))) := by
      apply ENNReal.ofReal_le_ofReal
      simpa [rate, terminal, coefficient] using hrate_sum

/--
The noncentral offsets in a finite source head at which the selected-shell
effective-count gate is active.  Its complement is precisely the zero-depth
branch controlled by the common inactive mass threshold.
-/
def selectedShellGeometricActiveOffsets
    (dimension cutoff count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) : Finset ℕ :=
  (Finset.range cutoff).filter fun scale =>
    16 * ((2 ^ dimension : ℕ) : ℝ) ≤
        (count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension (scale + 1))) ∧
      8 * selectedShellGeometricConfidence confidence (scale + 1) ≤
        (count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension (scale + 1)))

/-- Membership in the active noncentral head is its literal count gate. -/
theorem mem_selectedShellGeometricActiveOffsets_iff
    (dimension cutoff count scale : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) :
    scale ∈ selectedShellGeometricActiveOffsets dimension cutoff count law confidence ↔
      scale ∈ Finset.range cutoff ∧
        16 * ((2 ^ dimension : ℕ) : ℝ) ≤
            (count : ℝ) *
              ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
                (euclideanDyadicCubeShell dimension (scale + 1))) ∧
          8 * selectedShellGeometricConfidence confidence (scale + 1) ≤
            (count : ℝ) *
              ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
                (euclideanDyadicCubeShell dimension (scale + 1))) := by
  exact Finset.mem_filter

/-- The finite noncentral head offsets at which the effective-count gate fails. -/
def selectedShellGeometricInactiveOffsets
    (dimension cutoff count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) : Finset ℕ :=
  (Finset.range cutoff).filter fun scale =>
    scale ∉ selectedShellGeometricActiveOffsets dimension cutoff count law confidence

/-- Membership in the inactive finite head is exactly failure of its displayed gate. -/
theorem mem_selectedShellGeometricInactiveOffsets_iff
    (dimension cutoff count scale : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) :
    scale ∈ selectedShellGeometricInactiveOffsets dimension cutoff count law confidence ↔
      scale ∈ Finset.range cutoff ∧
        ¬ (16 * ((2 ^ dimension : ℕ) : ℝ) ≤
              (count : ℝ) *
                ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
                  (euclideanDyadicCubeShell dimension (scale + 1))) ∧
            8 * selectedShellGeometricConfidence confidence (scale + 1) ≤
              (count : ℝ) *
                ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
                  (euclideanDyadicCubeShell dimension (scale + 1)))) := by
  constructor
  · intro hinactive
    have hfilter := Finset.mem_filter.mp hinactive
    refine ⟨hfilter.1, ?_⟩
    intro hgate
    apply hfilter.2
    exact (mem_selectedShellGeometricActiveOffsets_iff
      dimension cutoff count scale law confidence).mpr ⟨hfilter.1, hgate⟩
  · rintro ⟨hrange, hgate⟩
    apply Finset.mem_filter.mpr
    refine ⟨hrange, ?_⟩
    intro hactive
    apply hgate
    exact (mem_selectedShellGeometricActiveOffsets_iff
      dimension cutoff count scale law confidence).mp hactive |>.2

/-- The active and inactive filtered offsets partition the finite noncentral head. -/
theorem sum_range_eq_sum_selectedShellGeometricActiveOffsets_add_inactiveOffsets
    {β : Type*} [AddCommMonoid β]
    (dimension cutoff count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) (f : ℕ → β) :
    (∑ scale ∈ Finset.range cutoff, f scale) =
      (∑ scale ∈ selectedShellGeometricActiveOffsets dimension cutoff count law confidence,
        f scale) +
      ∑ scale ∈ selectedShellGeometricInactiveOffsets dimension cutoff count law confidence,
        f scale := by
  let active := selectedShellGeometricActiveOffsets dimension cutoff count law confidence
  have hactive_subset : active ⊆ Finset.range cutoff := by
    intro scale hscale
    exact (mem_selectedShellGeometricActiveOffsets_iff
      dimension cutoff count scale law confidence).mp hscale |>.1
  have hactive_filter : (Finset.range cutoff).filter (fun scale => scale ∈ active) = active := by
    apply Finset.Subset.antisymm
    · intro scale hscale
      exact (Finset.mem_filter.mp hscale).2
    · intro scale hscale
      exact Finset.mem_filter.mpr ⟨hactive_subset hscale, hscale⟩
  rw [← Finset.sum_filter_add_sum_filter_not (Finset.range cutoff)
    (fun scale => scale ∈ active)]
  simp only [hactive_filter, selectedShellGeometricInactiveOffsets, active]

/-- An active noncentral selected-shell gate forces strictly positive source mass. -/
theorem measureReal_euclideanDyadicCubeShell_succ_pos_of_mem_selectedShellGeometricActiveOffsets
    (dimension cutoff count scale : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) (hcount : 0 < count)
    (hactive : scale ∈ selectedShellGeometricActiveOffsets dimension cutoff count law confidence) :
    0 < (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
      (euclideanDyadicCubeShell dimension (scale + 1)) := by
  have hgate := (mem_selectedShellGeometricActiveOffsets_iff
    dimension cutoff count scale law confidence).mp hactive
  have hcountReal : 0 < (count : ℝ) := by exact_mod_cast hcount
  have hbase : 0 < 16 * ((2 ^ dimension : ℕ) : ℝ) := by positivity
  nlinarith [hgate.2.1]

/--
The actual active side of the one-dimensional finite head has the explicit
compact source bound.  This is the active component of the deterministic
head decomposition; the filtered complement remains the inactive zero-depth
component.
-/
theorem sum_selectedShellGeometricActiveOffsets_dimensionOne_le
    (cutoff count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin 1)))
    {alpha gamma confidence : ℝ} (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑ scale ∈ selectedShellGeometricActiveOffsets 1 cutoff count law confidence,
      euclideanDyadicCubeShellMass 1 law (scale + 1) *
        selectedShellGeometricCompactBudget 1 count law
          (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence (scale + 1)) ≤
      ENNReal.ofReal
        ((128 / (count : ℝ)) * (2 * ((2 : ℝ) ^ cutoff - 1)) +
