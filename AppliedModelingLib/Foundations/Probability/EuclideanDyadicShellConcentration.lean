noncomputable def selectedShellGeometricHeadSchedule_byDimension
    (dimension cutoff count : ℕ) (confidence tailConstant : ℝ) : ℝ≥0∞ :=
  if hdimensionOne : dimension = 1 then
    selectedShellGeometricHeadSchedule_dimensionOne cutoff count confidence tailConstant
  else if hdimensionTwo : dimension = 2 then
