      2 * Real.sqrt 2 * Real.sqrt (selectedShellGeometricConfidence confidence shell) /
        Real.sqrt ((count : ℝ) * mass)
  let rate : ℝ :=
    (32 * Real.sqrt 2 + 4 * (depth shell) +
        2 * Real.sqrt 2 * Real.sqrt (selectedShellGeometricConfidence confidence shell)) *
      Real.sqrt mass / Real.sqrt count
  have hlocal :
      selectedShellGeometricCompactBudget 2 count law depth confidence shell ≤
        ENNReal.ofReal (euclideanDyadicCubeRadius shell) * ENNReal.ofReal envelope := by
    dsimp [depth, envelope]
    exact selectedShellGeometricCompactBudget_dimensionTwo_le shell count law
      (selectedShellGeometricEffectiveDepth 2 count law confidence) confidence
      hcount hconfidence hshellMass
