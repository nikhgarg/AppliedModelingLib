/-- Any positive count dominating the regime-selected head requirement bounds
the corresponding deterministic compact-head schedule. -/
theorem selectedShellGeometricHeadSchedule_byDimension_le_of_effectiveCountRequirement_le
    (dimension cutoff count : ℕ) (hdimension : 0 < dimension)
    (confidence tailConstant radius : ℝ) (hcount : 0 < count) (hradius : 0 < radius)
    (hrequirement :
      selectedShellGeometricHeadEffectiveCountRequirement_byDimension dimension cutoff confidence
        tailConstant radius ≤ (count : ℝ)) :
    selectedShellGeometricHeadSchedule_byDimension dimension cutoff count confidence tailConstant ≤
      ENNReal.ofReal radius := by
