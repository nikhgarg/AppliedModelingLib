/--
The exact active one-dimensional compact budgets of any finite noncentral
subhead are summable at an explicit source-dependent rate.  The input subset
may later be instantiated by the active side of the effective-depth gate
split; no assertion about the central shell is folded into this result.
-/
theorem sum_subset_euclideanDyadicCubeShellMass_mul_selectedShellGeometricCompactBudget_dimensionOne_active_succ_le
    (cutoff count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin 1)))
    (offsets : Finset ℕ) (hoffsets : offsets ⊆ Finset.range cutoff)
    {alpha gamma confidence : ℝ} (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma)
    (hshellMass : ∀ scale, scale ∈ offsets →
      0 < (law : Measure (EuclideanSpace ℝ (Fin 1))).real
        (euclideanDyadicCubeShell 1 (scale + 1)))
    (hactive : ∀ scale, scale ∈ offsets →
      16 * ((2 ^ 1 : ℕ) : ℝ) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 (scale + 1))) ∧
        8 * selectedShellGeometricConfidence confidence (scale + 1) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 (scale + 1)))) :
    (∑ scale ∈ offsets,
      euclideanDyadicCubeShellMass 1 law (scale + 1) *
        selectedShellGeometricCompactBudget 1 count law
          (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence (scale + 1)) ≤
      ENNReal.ofReal
        ((128 / (count : ℝ)) * (2 * ((2 : ℝ) ^ cutoff - 1)) +
          ((2 * (1 / (1 - 1 / Real.sqrt 2)) +
            2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) /
            Real.sqrt count) *
            (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma))) := by
