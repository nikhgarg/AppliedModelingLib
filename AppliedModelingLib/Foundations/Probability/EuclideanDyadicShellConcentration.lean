      rw [← ENNReal.ofReal_mul hmass_nonneg]
    _ ≤ ENNReal.ofReal (euclideanDyadicCubeRadius shell) * ENNReal.ofReal rate :=
      mul_le_mul_left' (ENNReal.ofReal_le_ofReal hrate.le) _

