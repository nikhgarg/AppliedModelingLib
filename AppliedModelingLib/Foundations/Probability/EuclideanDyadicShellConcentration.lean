/--
For any finite collection of noncentral source-shell offsets, the coarse
zero-depth compact contribution is bounded by the fifth-order radial tail.
The second law is arbitrary: only its common shell mass with the source law
is used, so this lemma applies in particular to empirical laws.
-/
theorem sum_selectedCompactShellZeroDepthTail_le_fifthOrderExponentialRadialTail
    (dimension cutoff : ℕ)
    (law nu : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (offsets : Finset ℕ) (threshold : ℕ → ℕ → ℝ)
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑ offset ∈ offsets,
      min (euclideanDyadicCubeShellMass dimension law (cutoff + offset + 1))
        (euclideanDyadicCubeShellMass dimension nu (cutoff + offset + 1)) *
        finiteIIDCompactShellDyadicWassersteinBudget dimension (fun _ => 0)
          threshold (cutoff + offset + 1)) ≤
      ENNReal.ofReal
        ((2 * Real.sqrt dimension) *
          ((32 / 15 : ℝ) * fifthOrderExponentialRadialTailConstant law alpha gamma /
            (16 : ℝ) ^ cutoff)) := by
  let sourceTerm : ℕ → ℝ := fun offset =>
    (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
      (euclideanDyadicCubeShell dimension (cutoff + offset + 1)) *
      euclideanDyadicCubeRadius (cutoff + offset + 1)
  let sourceTermENN : ℕ → ℝ≥0∞ := fun offset => ENNReal.ofReal (sourceTerm offset)
  let terminalCost : ℝ≥0∞ := ENNReal.ofReal (2 * Real.sqrt dimension)
  have hterminal_nonneg : 0 ≤ 2 * Real.sqrt dimension := by positivity
  have hsourceMass : ∀ offset,
      euclideanDyadicCubeShellMass dimension law (cutoff + offset + 1) =
        ENNReal.ofReal
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension (cutoff + offset + 1))) := by
    intro offset
    unfold euclideanDyadicCubeShellMass
    rw [← ENNReal.ofReal_toReal (measure_ne_top _ _)]
    rfl
  have hterm_le : ∀ offset,
      min (euclideanDyadicCubeShellMass dimension law (cutoff + offset + 1))
        (euclideanDyadicCubeShellMass dimension nu (cutoff + offset + 1)) *
        finiteIIDCompactShellDyadicWassersteinBudget dimension (fun _ => 0)
          threshold (cutoff + offset + 1) ≤
        terminalCost * sourceTermENN offset := by
    intro offset
    let shell := cutoff + offset + 1
    have hmin : min (euclideanDyadicCubeShellMass dimension law shell)
        (euclideanDyadicCubeShellMass dimension nu shell) ≤
        euclideanDyadicCubeShellMass dimension law shell := min_le_left _ _
    calc
      min (euclideanDyadicCubeShellMass dimension law shell)
          (euclideanDyadicCubeShellMass dimension nu shell) *
          finiteIIDCompactShellDyadicWassersteinBudget dimension (fun _ => 0)
            threshold shell ≤
          euclideanDyadicCubeShellMass dimension law shell *
            finiteIIDCompactShellDyadicWassersteinBudget dimension (fun _ => 0)
              threshold shell :=
        mul_le_mul_right' hmin _
      _ = terminalCost * sourceTermENN offset := by
        rw [hsourceMass offset,
          finiteIIDCompactShellDyadicWassersteinBudget_zeroDepth]
        dsimp [sourceTermENN, sourceTerm, terminalCost, shell]
        rw [← mul_assoc, ← ENNReal.ofReal_mul MeasureTheory.measureReal_nonneg]
        ac_rfl
  have hfinite_le_tsum : (∑ offset ∈ offsets, sourceTermENN offset) ≤
      ∑' offset : ℕ, sourceTermENN offset :=
    ENNReal.sum_le_tsum offsets
  have htsum_le :=
    tsum_ofReal_measureReal_euclideanDyadicCubeShell_succ_mul_radius_le_fifthOrderExponentialRadialTail
      dimension cutoff law halpha hgamma hmoment
  calc
    (∑ offset ∈ offsets,
        min (euclideanDyadicCubeShellMass dimension law (cutoff + offset + 1))
          (euclideanDyadicCubeShellMass dimension nu (cutoff + offset + 1)) *
          finiteIIDCompactShellDyadicWassersteinBudget dimension (fun _ => 0)
            threshold (cutoff + offset + 1)) ≤
        ∑ offset ∈ offsets, terminalCost * sourceTermENN offset := by
      apply Finset.sum_le_sum
      intro offset _
      exact hterm_le offset
    _ = terminalCost * (∑ offset ∈ offsets, sourceTermENN offset) := by
      rw [Finset.mul_sum]
    _ ≤ terminalCost * (∑' offset : ℕ, sourceTermENN offset) :=
      mul_le_mul_left' hfinite_le_tsum _
    _ ≤ terminalCost * ENNReal.ofReal
        ((32 / 15 : ℝ) * fifthOrderExponentialRadialTailConstant law alpha gamma /
          (16 : ℝ) ^ cutoff) :=
      mul_le_mul_left' htsum_le _
    _ = ENNReal.ofReal
        ((2 * Real.sqrt dimension) *
          ((32 / 15 : ℝ) * fifthOrderExponentialRadialTailConstant law alpha gamma /
            (16 : ℝ) ^ cutoff)) := by
      dsimp [terminalCost]
      symm
      exact ENNReal.ofReal_mul hterminal_nonneg

/--
The occupied empirical source shells beyond `cutoff` admit the zero-depth
coarse transport bound directly.  The finite empirical support is reindexed
by its noncentral offsets, so no countable empirical-support assumption is
introduced.
-/
theorem sum_empiricalSelectedCompactShellZeroDepthTail_le_fifthOrderExponentialRadialTail
    {count : ℕ} [Nonempty (Fin count)]
    (dimension cutoff : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (sample : Fin count → EuclideanSpace ℝ (Fin dimension)) (threshold : ℕ → ℕ → ℝ)
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑ shell ∈ (empiricalEuclideanDyadicCubeShellSupport dimension sample).filter
        (fun shell => cutoff < shell),
      min (euclideanDyadicCubeShellMass dimension law shell)
        (euclideanDyadicCubeShellMass dimension
          (empiricalSampleProbabilityMeasure sample) shell) *
        finiteIIDCompactShellDyadicWassersteinBudget dimension (fun _ => 0)
          threshold shell) ≤
      ENNReal.ofReal
        ((2 * Real.sqrt dimension) *
          ((32 / 15 : ℝ) * fifthOrderExponentialRadialTailConstant law alpha gamma /
            (16 : ℝ) ^ cutoff)) := by
  let empirical := empiricalSampleProbabilityMeasure sample
  let tailShells : Finset ℕ :=
    (empiricalEuclideanDyadicCubeShellSupport dimension sample).filter
      (fun shell => cutoff < shell)
  let offsets : Finset ℕ := tailShells.image (fun shell => shell - cutoff - 1)
  let terminalTerm : ℕ → ℝ≥0∞ := fun shell =>
    min (euclideanDyadicCubeShellMass dimension law shell)
      (euclideanDyadicCubeShellMass dimension empirical shell) *
      finiteIIDCompactShellDyadicWassersteinBudget dimension (fun _ => 0)
        threshold shell
  have himage : offsets.image (fun offset => cutoff + offset + 1) = tailShells := by
    ext shell
    constructor
    · intro hshell
      rcases Finset.mem_image.mp hshell with ⟨offset, hoffset, heq⟩
      rcases Finset.mem_image.mp hoffset with ⟨source, hsource, hsourceOffset⟩
      have hsource_lt : cutoff < source := (Finset.mem_filter.mp hsource).2
      have hsame : shell = source := by omega
      simpa [hsame] using hsource
    · intro hshell
      have hshell_lt : cutoff < shell := (Finset.mem_filter.mp hshell).2
      apply Finset.mem_image.mpr
      refine ⟨shell - cutoff - 1, ?_, ?_⟩
      · apply Finset.mem_image.mpr
        exact ⟨shell, hshell, rfl⟩
      · omega
  have hinj : Set.InjOn (fun offset : ℕ => cutoff + offset + 1) (↑offsets : Set ℕ) := by
    intro first _ second _ heq
    exact Nat.add_left_cancel (Nat.add_right_cancel heq)
  have hsum_reindex : (∑ shell ∈ tailShells, terminalTerm shell) =
      ∑ offset ∈ offsets, terminalTerm (cutoff + offset + 1) := by
    calc
      (∑ shell ∈ tailShells, terminalTerm shell) =
          ∑ shell ∈ offsets.image (fun offset => cutoff + offset + 1), terminalTerm shell := by
        rw [himage]
      _ = ∑ offset ∈ offsets, terminalTerm (cutoff + offset + 1) :=
        Finset.sum_image hinj
  change (∑ shell ∈ tailShells, terminalTerm shell) ≤ _
  calc
    (∑ shell ∈ tailShells, terminalTerm shell) =
        ∑ offset ∈ offsets, terminalTerm (cutoff + offset + 1) := hsum_reindex
    _ ≤ ENNReal.ofReal
        ((2 * Real.sqrt dimension) *
          ((32 / 15 : ℝ) * fifthOrderExponentialRadialTailConstant law alpha gamma /
            (16 : ℝ) ^ cutoff)) := by
      simpa [terminalTerm] using
        (sum_selectedCompactShellZeroDepthTail_le_fifthOrderExponentialRadialTail
          dimension cutoff law empirical offsets threshold halpha hgamma hmoment)

theorem wassersteinOne_euclideanDyadicCubeShells_le_selectedCompactBudgets
    {count : ℕ} [Nonempty (Fin count)]
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (sample : Fin count → EuclideanSpace ℝ (Fin dimension))
    (depth : ℕ → ℕ) (threshold : ℕ → ℕ → ℝ)
    (hgood : ∀ shell,
      ¬ finiteIIDRealizedCompactShellDyadicWassersteinTail
        dimension shell law count (depth shell) (threshold shell) sample) :
    ProbabilityCoupling.wassersteinOne law (empiricalSampleProbabilityMeasure sample) ≤
      (∑' shell, euclideanDyadicCubeShellMassDiscrepancy dimension law
        (empiricalSampleProbabilityMeasure sample) shell *
        ENNReal.ofReal (Real.sqrt dimension * euclideanDyadicCubeRadius shell)) +
      ∑ shell ∈ empiricalEuclideanDyadicCubeShellSupport dimension sample,
        min (euclideanDyadicCubeShellMass dimension law shell)
