/-- Four explicit logarithmic quarter-budget gates control the complete
law-independent all-shell mass-failure bound.  The central shell, bounded-tail
shell, selected-head shell, and geometric remainder each receive one fourth of
the specified tolerance.

The numerical exponential inversion is the reusable
`Math.mul_exp_neg_le_of_log_div_le`; its Mathlib provenance and Apache-2.0
licensing attribution are recorded with that lemma.
-/
theorem pOneFournierGuillinUniformAllShellMassSquareRateBudget_le_of_quarterGates
    {eta deviation scaledDeviation gamma tailBound tolerance : ℝ} (count : ℕ)
    (hcount : 0 < count) (htolerance : 0 < tolerance)
    (hcentral : Real.log (8 / tolerance) ≤ (count : ℝ) *
      (2 * pOneFournierGuillinShellWeight eta deviation 0 ^ 2))
    (hbounded : Real.log (16 / tolerance) ≤ (count : ℝ) *
      (pOneFournierGuillinShellCoefficient eta ^ 2 * scaledDeviation ^ 2 /
        (18 * tailBound)))
    (hhead : Real.log (4 / tolerance) ≤ (count : ℝ) *
      (pOneFournierGuillinShellCoefficient eta * Real.rpow 2 (-(1 + eta)) *
        scaledDeviation ^ 2 * Real.log 9 / 4))
    (htail : Real.log (4 / (tolerance * (1 - Real.exp (-1)))) ≤ (count : ℝ) *
      (pOneFournierGuillinShellCoefficient eta * scaledDeviation ^ 2 * gamma / 4)) :
    pOneFournierGuillinUniformAllShellMassSquareRateBudget count eta deviation
      scaledDeviation gamma tailBound ≤ tolerance := by
  let weight : ℝ := pOneFournierGuillinShellWeight eta deviation 0
  let coefficient : ℝ := pOneFournierGuillinShellCoefficient eta
  let denominator : ℝ := 1 - Real.exp (-1)
  have hcount_real : 0 < (count : ℝ) := by exact_mod_cast hcount
  have hdenominator : 0 < denominator := by
    dsimp [denominator]
    apply sub_pos.mpr
    have hexp : Real.exp (-1) < Real.exp 0 := Real.exp_lt_exp.mpr (by norm_num)
    simpa using hexp
  have hcentral_exp :
      Real.exp (-((count : ℝ) * weight) ^ 2 /
        (2 * (count : ℝ) * (1 / 4 : ℝ))) =
      Real.exp (-((count : ℝ) * (2 * weight ^ 2))) := by
    congr 1
    field_simp [hcount_real.ne']
    ring
  have hcentralQuarter :
      2 * Real.exp (-((count : ℝ) * (2 * weight ^ 2))) ≤ tolerance / 4 := by
    apply AppliedModelingLib.Math.mul_exp_neg_le_of_log_div_le (by norm_num) (by positivity)
    convert hcentral using 1 <;> field_simp [htolerance.ne'] <;> ring
  have hboundedQuarter :
      4 * Real.exp (-((count : ℝ) * coefficient ^ 2 * scaledDeviation ^ 2 /
        (18 * tailBound))) ≤ tolerance / 4 := by
    apply AppliedModelingLib.Math.mul_exp_neg_le_of_log_div_le (by norm_num) (by positivity)
    convert hbounded using 1 <;> field_simp [htolerance.ne'] <;> ring
  have hheadQuarter :
      Real.exp (-((count : ℝ) * coefficient * Real.rpow 2 (-(1 + eta)) *
        scaledDeviation ^ 2 * Real.log 9 / 4)) ≤ tolerance / 4 := by
    have hraw := AppliedModelingLib.Math.mul_exp_neg_le_of_log_div_le
      (coefficient := (1 : ℝ)) (tolerance := tolerance / 4)
      (exponent := (count : ℝ) * (coefficient * Real.rpow 2 (-(1 + eta)) *
        scaledDeviation ^ 2 * Real.log 9 / 4))
      (by norm_num) (by positivity) (by
        convert hhead using 1 <;> field_simp [htolerance.ne'] <;> ring)
    convert hraw using 1 <;> ring
  have htailQuarter :
      Real.exp (-((count : ℝ) * coefficient * scaledDeviation ^ 2 * gamma / 4)) /
        denominator ≤ tolerance / 4 := by
    have hraw := AppliedModelingLib.Math.mul_exp_neg_le_of_log_div_le
      (coefficient := denominator⁻¹) (tolerance := tolerance / 4)
      (exponent := (count : ℝ) * (coefficient * scaledDeviation ^ 2 * gamma / 4))
      (inv_pos.mpr hdenominator) (by positivity) (by
        have hratio : denominator⁻¹ / (tolerance / 4) = 4 / (tolerance * denominator) := by
          field_simp [htolerance.ne', hdenominator.ne']
        rw [hratio]
        simpa [coefficient, denominator] using htail)
    convert hraw using 1 <;> simp [div_eq_mul_inv] <;> ring
  have hcentral_exp' :
      Real.exp (-((count : ℝ) * pOneFournierGuillinShellWeight eta deviation 0) ^ 2 /
        (2 * (count : ℝ) * (1 / 4 : ℝ))) =
      Real.exp (-((count : ℝ) * (2 * pOneFournierGuillinShellWeight eta deviation 0 ^ 2))) := by
    simpa [weight] using hcentral_exp
  have hcentralQuarter' :
      2 * Real.exp (-((count : ℝ) * (2 * pOneFournierGuillinShellWeight eta deviation 0 ^ 2))) ≤
        tolerance / 4 := by
    simpa [weight] using hcentralQuarter
  have hboundedQuarter' :
      4 * Real.exp (-((count : ℝ) * pOneFournierGuillinShellCoefficient eta ^ 2 *
        scaledDeviation ^ 2 / (18 * tailBound))) ≤ tolerance / 4 := by
    simpa [coefficient] using hboundedQuarter
  have hheadQuarter' :
      Real.exp (-((count : ℝ) * pOneFournierGuillinShellCoefficient eta *
        Real.rpow 2 (-(1 + eta)) * scaledDeviation ^ 2 * Real.log 9 / 4)) ≤ tolerance / 4 := by
    simpa [coefficient] using hheadQuarter
  have htailQuarter' :
      Real.exp (-((count : ℝ) * pOneFournierGuillinShellCoefficient eta *
        scaledDeviation ^ 2 * gamma / 4)) / (1 - Real.exp (-1)) ≤ tolerance / 4 := by
    simpa [coefficient, denominator] using htailQuarter
  unfold pOneFournierGuillinUniformAllShellMassSquareRateBudget
  rw [hcentral_exp']
  linarith

/-- The largest of the four explicit logarithmic count thresholds for the
law-independent all-shell mass budget.  Its four entries allocate a quarter of
the budget to the central, bounded-tail, selected-head, and geometric-tail
terms, respectively. -/
noncomputable def pOneFournierGuillinUniformAllShellMassEffectiveCountRequirement
    (eta deviation scaledDeviation gamma tailBound tolerance : ℝ) : ℝ :=
  max
    (Real.log (8 / tolerance) /
      (2 * pOneFournierGuillinShellWeight eta deviation 0 ^ 2))
    (max
      (Real.log (16 / tolerance) /
        (pOneFournierGuillinShellCoefficient eta ^ 2 * scaledDeviation ^ 2 /
          (18 * tailBound)))
      (max
        (Real.log (4 / tolerance) /
          (pOneFournierGuillinShellCoefficient eta * Real.rpow 2 (-(1 + eta)) *
            scaledDeviation ^ 2 * Real.log 9 / 4))
        (Real.log (4 / (tolerance * (1 - Real.exp (-1)))) /
          (pOneFournierGuillinShellCoefficient eta * scaledDeviation ^ 2 * gamma / 4))))

