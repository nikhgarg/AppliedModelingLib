theorem measureReal_biUnion_range_pOneFournierGuillinLargeShellMassTailWithEta_le
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count cutoff : ℕ) (hcount : 0 < count)
    {eta deviation : ℝ} (heta_pos : 0 < eta) (hdeviation_pos : 0 < deviation) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
      (⋃ scale ∈ Finset.range cutoff,
        pOneFournierGuillinLargeShellMassTailWithEta dimension law count eta deviation scale) ≤
      cutoff * Real.exp (-((count : ℝ) *
        pOneFournierGuillinShellWeight eta deviation cutoff * Real.log 9 / 2)) := by
  classical
  let sampleLaw := finiteIIDSampleLaw
    (law : Measure (EuclideanSpace ℝ (Fin dimension))) count
  let tail := fun scale =>
    pOneFournierGuillinLargeShellMassTailWithEta dimension law count eta deviation scale
  let budget : ℝ := Real.exp (-((count : ℝ) *
    pOneFournierGuillinShellWeight eta deviation cutoff * Real.log 9 / 2))
  letI : IsProbabilityMeasure sampleLaw := by
    dsimp [sampleLaw, finiteIIDSampleLaw]
    infer_instance
  have hbudget_nonneg : 0 ≤ budget := (Real.exp_pos _).le
  have hterm : ∀ scale ∈ Finset.range cutoff,
      sampleLaw.real (tail scale) ≤ budget := by
    intro scale hscale
    dsimp [tail, pOneFournierGuillinLargeShellMassTailWithEta]
    by_cases hlarge : 9 ≤ pOneFournierGuillinShellToleranceWithEta eta deviation
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1))) scale
    · rw [if_pos hlarge]
      by_cases hzero : law.toFiniteMeasure.restrict
          (euclideanDyadicCubeShell dimension (scale + 1)) = 0
      · rw [measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized_eq_zero
          dimension law count (scale + 1)
          (pOneFournierGuillinShellToleranceWithEta eta deviation
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension (scale + 1))) scale) hzero]
        exact hbudget_nonneg
      · have hsimple :=
          measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized_succ_le_pOneLargeSimpleBudgetWithEta
            dimension law count scale hcount
            (pOneFournierGuillinShellWeight_pos scale heta_pos hdeviation_pos)
            hzero hlarge
