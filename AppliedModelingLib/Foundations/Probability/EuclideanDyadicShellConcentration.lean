/-- The largest of the three explicit count thresholds for the source's
finite square-rate gates: the bounded-tail, selected-head, and geometric-tail
conditions. -/
noncomputable def pOneFournierGuillinUniformSquareRateEffectiveCountRequirement
    (eta alpha gamma tailBound scaledDeviation : ℝ) : ℝ :=
  max
    (1 / (pOneFournierGuillinShellCoefficient eta ^ 2 * scaledDeviation ^ 2 /
      (18 * tailBound)))
    (max
      (1 / (pOneFournierGuillinShellCoefficient eta * Real.rpow 2 (-(1 + eta)) *
        scaledDeviation ^ 2 * Real.log 9 / 8))
      (1 / ((pOneFournierGuillinShellCoefficient eta * scaledDeviation ^ 2 * gamma / 4) *
        (Real.rpow 2 (alpha - 1 - eta) - 1))))

/-- Any count dominating the explicit square-rate requirement meets all three
source finite-count gates. -/
theorem pOneFournierGuillinUniformSquareRateGates_of_requirement_le
    {eta alpha gamma tailBound scaledDeviation : ℝ} (count : ℕ)
    (heta : 0 < eta) (hgamma : 0 < gamma) (htailBound : 0 < tailBound)
    (hscaledDeviation : 0 < scaledDeviation) (halphaGap : 1 + eta < alpha)
    (hrequirement : pOneFournierGuillinUniformSquareRateEffectiveCountRequirement
      eta alpha gamma tailBound scaledDeviation ≤ (count : ℝ)) :
    1 ≤ (count : ℝ) * pOneFournierGuillinShellCoefficient eta ^ 2 *
        scaledDeviation ^ 2 / (18 * tailBound) ∧
      1 ≤ (count : ℝ) * pOneFournierGuillinShellCoefficient eta *
        Real.rpow 2 (-(1 + eta)) * scaledDeviation ^ 2 * Real.log 9 / 8 ∧
      1 ≤ ((count : ℝ) * pOneFournierGuillinShellCoefficient eta *
        scaledDeviation ^ 2 * gamma / 4) *
        (Real.rpow 2 (alpha - 1 - eta) - 1) := by
  let requirement := pOneFournierGuillinUniformSquareRateEffectiveCountRequirement
    eta alpha gamma tailBound scaledDeviation
  let coefficient : ℝ := pOneFournierGuillinShellCoefficient eta
  have hcoefficient : 0 < coefficient := by
    dsimp [coefficient]
    exact pOneFournierGuillinShellCoefficient_pos heta
  have hdecay : 0 < Real.rpow 2 (-(1 + eta)) := Real.rpow_pos_of_pos (by norm_num) _
  have hlogNine : 0 < Real.log 9 := Real.log_pos (by norm_num)
  have hbase : 1 < Real.rpow 2 (alpha - 1 - eta) := by
    simpa only [Real.rpow_eq_pow] using
      Real.one_lt_rpow (by norm_num : (1 : ℝ) < 2)
        (by linarith : 0 < alpha - 1 - eta)
  have hboundedRate : 0 < coefficient ^ 2 * scaledDeviation ^ 2 / (18 * tailBound) := by
    positivity
  have hheadRate : 0 < coefficient * Real.rpow 2 (-(1 + eta)) *
      scaledDeviation ^ 2 * Real.log 9 / 8 := by positivity
  have htailRate : 0 < (coefficient * scaledDeviation ^ 2 * gamma / 4) *
      (Real.rpow 2 (alpha - 1 - eta) - 1) := by
    apply mul_pos
    · positivity
    · linarith
  constructor
  · convert (div_le_iff₀ hboundedRate).mp (by
      calc
        1 / (coefficient ^ 2 * scaledDeviation ^ 2 / (18 * tailBound)) ≤ requirement := by
          dsimp [requirement, pOneFournierGuillinUniformSquareRateEffectiveCountRequirement,
            coefficient]
          exact le_max_left _ _
        _ ≤ count := hrequirement) using 1 <;> simp [coefficient] <;> ring
  constructor
  · convert (div_le_iff₀ hheadRate).mp (by
      calc
        1 / (coefficient * Real.rpow 2 (-(1 + eta)) * scaledDeviation ^ 2 * Real.log 9 / 8) ≤
            requirement := by
          dsimp [requirement, pOneFournierGuillinUniformSquareRateEffectiveCountRequirement,
            coefficient]
          exact (le_max_left _ _).trans (le_max_right _ _)
        _ ≤ count := hrequirement) using 1 <;> simp [coefficient] <;> ring
  · convert (div_le_iff₀ htailRate).mp (by
      calc
        1 / ((coefficient * scaledDeviation ^ 2 * gamma / 4) *
          (Real.rpow 2 (alpha - 1 - eta) - 1)) ≤ requirement := by
          dsimp [requirement, pOneFournierGuillinUniformSquareRateEffectiveCountRequirement,
            coefficient]
          exact (le_max_right _ _).trans (le_max_right _ _)
        _ ≤ count := hrequirement) using 1 <;> simp [coefficient] <;> ring

/-- The complete explicit count requirement in a supercritical dimension.
It joins the six compact-head gates, four all-shell mass gates, and three
source square-rate gates without an eventual or existential batch selector. -/
