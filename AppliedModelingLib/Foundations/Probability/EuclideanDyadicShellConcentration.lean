    gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha -
      Real.log (∫ x : EuclideanSpace ℝ (Fin dimension),
        Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
          (law : Measure (EuclideanSpace ℝ (Fin dimension))) )
