    _ ≤ ∑ scale ∈ Finset.range cutoff, sampleLaw.real (tail scale) :=
      measureReal_biUnion_finset_le (μ := sampleLaw) (Finset.range cutoff) tail
    _ ≤ ∑ _scale ∈ Finset.range cutoff, budget := by
      exact Finset.sum_le_sum fun scale hscale => hterm scale hscale
    _ = cutoff * budget := by simp [nsmul_eq_mul]
    _ = cutoff * Real.exp (-((count : ℝ) *
        pOneFournierGuillinShellWeight eta deviation cutoff * Real.log 9 / 2)) := by rfl

