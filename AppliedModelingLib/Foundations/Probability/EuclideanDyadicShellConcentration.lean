            finiteIIDCompactShellDyadicWassersteinBudget dimension depth threshold shell := by
  let support := empiricalEuclideanDyadicCubeShellSupport dimension sample
  let empirical := empiricalSampleProbabilityMeasure sample
  let compactTerm : ℕ → ℝ≥0∞ := fun shell =>
    min (euclideanDyadicCubeShellMass dimension law shell)
      (euclideanDyadicCubeShellMass dimension empirical shell) *
      finiteIIDCompactShellDyadicWassersteinBudget dimension depth threshold shell
  let zeroDepthTerm : ℕ → ℝ≥0∞ := fun shell =>
    min (euclideanDyadicCubeShellMass dimension law shell)
      (euclideanDyadicCubeShellMass dimension empirical shell) *
      finiteIIDCompactShellDyadicWassersteinBudget dimension (fun _ => 0) threshold shell
  let tailBound : ℝ≥0∞ := ENNReal.ofReal
    ((2 * Real.sqrt dimension) *
      ((32 / 15 : ℝ) * fifthOrderExponentialRadialTailConstant law alpha gamma /
        (16 : ℝ) ^ cutoff))
  have hbase := wassersteinOne_euclideanDyadicCubeShells_le_pOneRelativeMassAndSelectedCompactBudgets
    dimension law sample heta_pos hdeviation_nonneg depth threshold hmassGood hcompactGood
  have hsplit : (∑ shell ∈ support, compactTerm shell) =
