theorem measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized_succ_le_pOneLargeLogBudget_of_exponentialRadialMoment
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count scale : ℕ) (hcount : 0 < count)
    {deviation alpha gamma : ℝ} (hdeviation_pos : 0 < deviation)
    (halpha : 0 ≤ alpha) (hgamma : 0 ≤ gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension (scale + 1)) ≠ 0)
    (hlarge : 9 ≤ pOneFournierGuillinShellTolerance deviation
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1))) scale) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized dimension law count
          (scale + 1)
          (pOneFournierGuillinShellTolerance deviation
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension (scale + 1))) scale)) ≤
      Real.exp (-((count : ℝ) * deviation / (4 * (4 : ℝ) ^ scale) *
        (Real.log (deviation / (2 * (4 : ℝ) ^ scale)) +
          gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha -
            Real.log (∫ x : EuclideanSpace ℝ (Fin dimension),
