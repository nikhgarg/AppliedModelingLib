      ring

/--
For a positive source cube shell, the union of all realized selected-sample
compact partition tails is controlled by the one shell-count lower tail plus
one uniform compact tail. The membership-pattern probabilities are averaged,
not union-bounded, so no factor exponential in the ambient sample count is
introduced.
-/
theorem measureReal_iUnion_finiteIIDMembershipPattern_inter_compactShellDyadicPartitionTail_le
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count : ℕ) (hcount : 0 < count)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0)
    (level : ℕ) (error : ℝ) (herror : 0 ≤ error) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
      (⋃ inside : Finset (Fin count),
        finiteIIDMembershipPattern count inside
          (euclideanDyadicCubeShell dimension shell) ∩
        ((finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell) ∘
          finiteIIDSampleOnFinsetToFin inside) ⁻¹'
          {selectedSample |
            error ≤ dyadicPartitionL1Deviation dimension
              (euclideanDyadicCubeShellCompactLaw dimension shell law)
              inside.card level selectedSample})) ≤
      Real.exp (-((1 / 2 - Real.exp (-1)) * (count : ℝ) *
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell)))) +
      (2 ^ (2 ^ (dimension * level)) : ℕ) *
        Real.exp (-((count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell)) * error ^ 2) / 4) := by
  let sampleLaw := finiteIIDSampleLaw
    (law : Measure (EuclideanSpace ℝ (Fin dimension))) count
  let shellSet := euclideanDyadicCubeShell dimension shell
  let shellMass := (law : Measure (EuclideanSpace ℝ (Fin dimension))).real shellSet
  let tail : Finset (Fin count) → Set (Fin count → EuclideanSpace ℝ (Fin dimension)) :=
    fun inside =>
      ((finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell) ∘
        finiteIIDSampleOnFinsetToFin inside) ⁻¹'
        {selectedSample |
          error ≤ dyadicPartitionL1Deviation dimension
            (euclideanDyadicCubeShellCompactLaw dimension shell law)
            inside.card level selectedSample})
  let low : Set (Fin count → EuclideanSpace ℝ (Fin dimension)) :=
    {sample | ((empiricalSampleIndicesInSet sample shellSet).card : ℝ) / count ≤
      shellMass / 2}
  let good : Finset (Fin count) → Prop :=
    fun inside => shellMass / 2 < (inside.card : ℝ) / count
  let tailBound : ℝ := (2 ^ (2 ^ (dimension * level)) : ℕ) *
    Real.exp (-((count : ℝ) * shellMass * error ^ 2) / 4)
  have hcount_real_pos : 0 < (count : ℝ) := by
    exact_mod_cast hcount
  have hmass_ne_zero : (law : Measure (EuclideanSpace ℝ (Fin dimension))) shellSet ≠ 0 := by
    intro hzero
    apply hnonzero
    rw [FiniteMeasure.restrict_eq_zero_iff]
    apply ENNReal.coe_eq_zero.mp
    simpa using hzero
  have hmass_pos : 0 < shellMass := by
    dsimp [shellMass]
    exact ENNReal.toReal_pos hmass_ne_zero (measure_ne_top _ _)
  have htail_measurable : ∀ inside, MeasurableSet (tail inside) := by
    intro inside
    dsimp [tail]
    exact measurableSet_finiteIIDCompactShellDyadicPartitionTail
      dimension shell law count inside level error
  have htailBound_nonneg : 0 ≤ tailBound := by
    dsimp [tailBound]
    positivity
  have hbad : ∀ inside, ¬ good inside →
      finiteIIDMembershipPattern count inside shellSet ∩ tail inside ⊆ low := by
    intro inside hnot sample hsample
    have hpattern : sample ∈ finiteIIDMembershipPattern count inside shellSet := hsample.1
    have hindices : empiricalSampleIndicesInSet sample shellSet = inside :=
      (mem_finiteIIDMembershipPattern_iff_empiricalSampleIndicesInSet_eq
        sample inside shellSet).mp hpattern
    change ((empiricalSampleIndicesInSet sample shellSet).card : ℝ) / count ≤ shellMass / 2
    rw [hindices]
    exact le_of_not_gt hnot
  have hgood_tail : ∀ inside, good inside →
      sampleLaw.real (finiteIIDMembershipPattern count inside shellSet ∩ tail inside) ≤
        tailBound * sampleLaw.real (finiteIIDMembershipPattern count inside shellSet) := by
    intro inside hgood
    by_cases hpattern_zero : sampleLaw
        (finiteIIDMembershipPattern count inside shellSet) = 0
    · have hinter_zero : sampleLaw
        (finiteIIDMembershipPattern count inside shellSet ∩ tail inside) = 0 :=
        measure_mono_null Set.inter_subset_left hpattern_zero
      have hinter_real : sampleLaw.real
          (finiteIIDMembershipPattern count inside shellSet ∩ tail inside) = 0 := by
        simp [Measure.real, hinter_zero]
      have hpattern_real : sampleLaw.real
          (finiteIIDMembershipPattern count inside shellSet) = 0 := by
        simp [Measure.real, hpattern_zero]
      rw [hinter_real, hpattern_real, mul_zero]
    · have hcoordinate_pos : ∀ index : Fin count,
        (law : Measure (EuclideanSpace ℝ (Fin dimension)))
          (if index ∈ inside then shellSet else shellSetᶜ) ≠ 0 := by
        apply (finiteIIDMembershipPattern_measure_ne_zero_iff
          (law : Measure (EuclideanSpace ℝ (Fin dimension))) count inside shellSet).mp
        simpa [sampleLaw] using hpattern_zero
      have hhalf_pos : 0 < shellMass / 2 := by linarith
      have hratio_pos : 0 < (inside.card : ℝ) / count :=
        lt_trans hhalf_pos hgood
      have hcard_pos : 0 < (inside.card : ℝ) := by
        rcases (div_pos_iff.mp hratio_pos) with hpositive | hnegative
        · exact hpositive.1
        · linarith [hnegative.2, hcount_real_pos]
      have hinside : inside.Nonempty := Finset.card_pos.mp (by exact_mod_cast hcard_pos)
      have hfixed : sampleLaw.real
          (finiteIIDMembershipPattern count inside shellSet ∩ tail inside) ≤
          sampleLaw.real (finiteIIDMembershipPattern count inside shellSet) *
            ((2 ^ (2 ^ (dimension * level)) : ℕ) *
              Real.exp (-((inside.card : ℝ) * error ^ 2) / 2)) := by
        dsimp [sampleLaw, tail]
        exact measureReal_finiteIIDMembershipPattern_inter_compactShellDyadicPartitionTail_le
          dimension shell law count inside hinside hcoordinate_pos hnonzero level error herror
      have hselected_count : (count : ℝ) * shellMass / 2 ≤ (inside.card : ℝ) := by
        have hselected_count' := (lt_div_iff₀ hcount_real_pos).mp hgood
        nlinarith
      have hscaled := mul_le_mul_of_nonneg_right hselected_count (sq_nonneg error)
      have hexponent : -((inside.card : ℝ) * error ^ 2) / 2 ≤
          -((count : ℝ) * shellMass * error ^ 2) / 4 := by
        nlinarith
      have hlocal_tail :
          ((2 ^ (2 ^ (dimension * level)) : ℕ) *
            Real.exp (-((inside.card : ℝ) * error ^ 2) / 2)) ≤ tailBound := by
        dsimp [tailBound]
        apply mul_le_mul_of_nonneg_left
          (Real.exp_le_exp.mpr hexponent)
        positivity
      calc
        sampleLaw.real (finiteIIDMembershipPattern count inside shellSet ∩ tail inside) ≤
            sampleLaw.real (finiteIIDMembershipPattern count inside shellSet) *
              ((2 ^ (2 ^ (dimension * level)) : ℕ) *
                Real.exp (-((inside.card : ℝ) * error ^ 2) / 2)) := hfixed
        _ ≤ sampleLaw.real (finiteIIDMembershipPattern count inside shellSet) * tailBound :=
          mul_le_mul_of_nonneg_left hlocal_tail measureReal_nonneg
        _ = tailBound * sampleLaw.real
            (finiteIIDMembershipPattern count inside shellSet) := by ring
  have haggregate : sampleLaw.real
      (⋃ inside : Finset (Fin count),
        finiteIIDMembershipPattern count inside shellSet ∩ tail inside) ≤
      sampleLaw.real low + tailBound := by
    dsimp [sampleLaw]
    exact measureReal_iUnion_finiteIIDMembershipPattern_inter_le_add_of_uniform_tail
      (law : Measure (EuclideanSpace ℝ (Fin dimension))) count shellSet
      (measurableSet_euclideanDyadicCubeShell dimension shell) tail htail_measurable low good
      hbad tailBound htailBound_nonneg hgood_tail
  have hlow : sampleLaw.real low ≤
      Real.exp (-((1 / 2 - Real.exp (-1)) * (count : ℝ) * shellMass)) := by
    dsimp [sampleLaw, low]
    exact measure_finiteIIDSelectedIndexRatio_lowerTail_half_le_exp_linear law count hcount shellSet
      (measurableSet_euclideanDyadicCubeShell dimension shell)
  change sampleLaw.real
      (⋃ inside : Finset (Fin count),
        finiteIIDMembershipPattern count inside shellSet ∩ tail inside) ≤
      Real.exp (-((1 / 2 - Real.exp (-1)) * (count : ℝ) * shellMass)) + tailBound
  calc
    _ ≤ sampleLaw.real low + tailBound := haggregate
    _ ≤ Real.exp (-((1 / 2 - Real.exp (-1)) * (count : ℝ) * shellMass)) + tailBound :=
      by linarith

/--
The source-style alternative to a selected-count cutoff: average the compact
conditional tail over every nonempty membership pattern through the exact
binomial MGF.  This gives the exponential-moment form of Fournier--Guillin
Lemma 12(c) without a `2^count` pattern factor.
-/
theorem measureReal_iUnion_finiteIIDNonemptyMembershipPattern_inter_compactShellDyadicPartitionTail_le_mgf
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count : ℕ)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0)
    (level : ℕ) (error : ℝ) (herror : 0 ≤ error) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
      (⋃ inside : Finset (Fin count),
        finiteIIDMembershipPattern count inside
          (euclideanDyadicCubeShell dimension shell) ∩
        (if inside.Nonempty then
          ((finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell) ∘
            finiteIIDSampleOnFinsetToFin inside) ⁻¹'
            {selectedSample |
              error ≤ dyadicPartitionL1Deviation dimension
                (euclideanDyadicCubeShellCompactLaw dimension shell law)
                inside.card level selectedSample})
        else ∅)) ≤
      (2 ^ (2 ^ (dimension * level)) : ℕ) *
        Real.exp (-((count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell)) *
          (1 - Real.exp (-(error ^ 2 / 2))))) := by
  let sampleLaw := finiteIIDSampleLaw
    (law : Measure (EuclideanSpace ℝ (Fin dimension))) count
  let shellSet := euclideanDyadicCubeShell dimension shell
  let shellMass := (law : Measure (EuclideanSpace ℝ (Fin dimension))).real shellSet
  let rawTail : Finset (Fin count) → Set (Fin count → EuclideanSpace ℝ (Fin dimension)) :=
    fun inside =>
      ((finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell) ∘
        finiteIIDSampleOnFinsetToFin inside) ⁻¹'
        {selectedSample |
          error ≤ dyadicPartitionL1Deviation dimension
            (euclideanDyadicCubeShellCompactLaw dimension shell law)
            inside.card level selectedSample})
  let tail : Finset (Fin count) → Set (Fin count → EuclideanSpace ℝ (Fin dimension)) :=
    fun inside => if inside.Nonempty then rawTail inside else ∅
  let localRate : ℝ := error ^ 2 / 2
  let coefficient : ℝ := (2 ^ (2 ^ (dimension * level)) : ℕ)
  letI : IsProbabilityMeasure sampleLaw := by
    dsimp [sampleLaw, finiteIIDSampleLaw]
    infer_instance
  have htail_measurable : ∀ inside, MeasurableSet (tail inside) := by
    intro inside
    change MeasurableSet (if inside.Nonempty then rawTail inside else ∅)
    by_cases hinside : inside.Nonempty
    · rw [if_pos hinside]
      dsimp [rawTail]
      exact measurableSet_finiteIIDCompactShellDyadicPartitionTail
        dimension shell law count inside level error
    · rw [if_neg hinside]
      exact MeasurableSet.empty
  have hlocalRate_nonneg : 0 ≤ localRate := by
    dsimp [localRate]
    positivity
  have hbound : ∀ inside,
      sampleLaw.real (finiteIIDMembershipPattern count inside shellSet ∩ tail inside) ≤
        coefficient * Real.exp (-localRate * (inside.card : ℝ)) *
          sampleLaw.real (finiteIIDMembershipPattern count inside shellSet) := by
    intro inside
    change sampleLaw.real
        (finiteIIDMembershipPattern count inside shellSet ∩
          (if inside.Nonempty then rawTail inside else ∅)) ≤
        coefficient * Real.exp (-localRate * (inside.card : ℝ)) *
          sampleLaw.real (finiteIIDMembershipPattern count inside shellSet)
    by_cases hinside : inside.Nonempty
    · rw [if_pos hinside]
      by_cases hpattern_zero : sampleLaw
          (finiteIIDMembershipPattern count inside shellSet) = 0
      · have hinter_zero : sampleLaw
          (finiteIIDMembershipPattern count inside shellSet ∩ rawTail inside) = 0 :=
          measure_mono_null Set.inter_subset_left hpattern_zero
        have hinter_real : sampleLaw.real
            (finiteIIDMembershipPattern count inside shellSet ∩ rawTail inside) = 0 := by
          simp [Measure.real, hinter_zero]
        have hpattern_real : sampleLaw.real
            (finiteIIDMembershipPattern count inside shellSet) = 0 := by
          simp [Measure.real, hpattern_zero]
        rw [hinter_real, hpattern_real, mul_zero]
      · have hcoordinate_pos : ∀ index : Fin count,
          (law : Measure (EuclideanSpace ℝ (Fin dimension)))
            (if index ∈ inside then shellSet else shellSetᶜ) ≠ 0 := by
          apply (finiteIIDMembershipPattern_measure_ne_zero_iff
            (law : Measure (EuclideanSpace ℝ (Fin dimension))) count inside shellSet).mp
          simpa [sampleLaw] using hpattern_zero
        have hfixed : sampleLaw.real
            (finiteIIDMembershipPattern count inside shellSet ∩ rawTail inside) ≤
            sampleLaw.real (finiteIIDMembershipPattern count inside shellSet) *
              ((2 ^ (2 ^ (dimension * level)) : ℕ) *
                Real.exp (-((inside.card : ℝ) * error ^ 2) / 2)) := by
          dsimp [sampleLaw, rawTail]
          exact measureReal_finiteIIDMembershipPattern_inter_compactShellDyadicPartitionTail_le
            dimension shell law count inside hinside hcoordinate_pos hnonzero level error herror
        calc
          sampleLaw.real (finiteIIDMembershipPattern count inside shellSet ∩ rawTail inside) ≤
              sampleLaw.real (finiteIIDMembershipPattern count inside shellSet) *
                ((2 ^ (2 ^ (dimension * level)) : ℕ) *
                  Real.exp (-((inside.card : ℝ) * error ^ 2) / 2)) := hfixed
          _ = coefficient * Real.exp (-localRate * (inside.card : ℝ)) *
              sampleLaw.real (finiteIIDMembershipPattern count inside shellSet) := by
            dsimp [coefficient, localRate]
            ring
    · rw [if_neg hinside]
      simp
      positivity
  calc
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (⋃ inside : Finset (Fin count),
          finiteIIDMembershipPattern count inside
            (euclideanDyadicCubeShell dimension shell) ∩
          (if inside.Nonempty then
            ((finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell) ∘
              finiteIIDSampleOnFinsetToFin inside) ⁻¹'
              {selectedSample |
                error ≤ dyadicPartitionL1Deviation dimension
                  (euclideanDyadicCubeShellCompactLaw dimension shell law)
                  inside.card level selectedSample})
          else ∅)) =
        sampleLaw.real (⋃ inside : Finset (Fin count),
          finiteIIDMembershipPattern count inside shellSet ∩ tail inside) := by
      rfl
    _ ≤ coefficient * ProbabilityTheory.mgf
        (fun sample : Fin count → EuclideanSpace ℝ (Fin dimension) =>
          ∑ index, shellSet.indicator (fun _ => (1 : ℝ)) (sample index))
        sampleLaw (-localRate) := by
      exact measureReal_iUnion_finiteIIDMembershipPattern_inter_le_mul_mgf
        (law : Measure (EuclideanSpace ℝ (Fin dimension))) count shellSet
        (measurableSet_euclideanDyadicCubeShell dimension shell) tail htail_measurable
        coefficient localRate hlocalRate_nonneg hbound
    _ ≤ coefficient * Real.exp (-((count : ℝ) * shellMass *
        (1 - Real.exp (-localRate)))) := by
      exact mul_le_mul_of_nonneg_left
        (mgf_finiteIIDIndicatorSum_neg_le_exp_neg_mul
          (law : Measure (EuclideanSpace ℝ (Fin dimension))) count shellSet
          (measurableSet_euclideanDyadicCubeShell dimension shell)
          localRate hlocalRate_nonneg)
        (by dsimp [coefficient]; positivity)
    _ = (2 ^ (2 ^ (dimension * level)) : ℕ) *
        Real.exp (-((count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell)) *
          (1 - Real.exp (-(error ^ 2 / 2))))) := by
      dsimp [coefficient, localRate, shellMass]

/--
The compact dyadic-partition tail of the actually selected nonempty shell
sample. The selected index set and its `Fin k` enumeration are formed from the
realized ambient iid sample itself.
-/
def finiteIIDRealizedCompactShellDyadicPartitionTail
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count level : ℕ) (error : ℝ) :
    Set (Fin count → EuclideanSpace ℝ (Fin dimension)) :=
  {sample | ∃ _hselected : (empiricalSampleIndicesInSet sample
      (euclideanDyadicCubeShell dimension shell)).Nonempty,
    error ≤ dyadicPartitionL1Deviation dimension
      (euclideanDyadicCubeShellCompactLaw dimension shell law)
      (empiricalSampleIndicesInSet sample
        (euclideanDyadicCubeShell dimension shell)).card level
      (finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell)
        (finiteIIDSampleOnFinsetToFin
          (empiricalSampleIndicesInSet sample
            (euclideanDyadicCubeShell dimension shell)) sample))}

/--
The realized selected-shell partition tail is exactly the finite union over
fixed membership patterns.  This exposes a measurable certificate for the
otherwise data-dependent selected index set.
-/
theorem finiteIIDRealizedCompactShellDyadicPartitionTail_eq_iUnion_membershipPattern
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count level : ℕ) (error : ℝ) :
    finiteIIDRealizedCompactShellDyadicPartitionTail dimension shell law count level error =
      ⋃ inside : Finset (Fin count),
        finiteIIDMembershipPattern count inside (euclideanDyadicCubeShell dimension shell) ∩
          (if inside.Nonempty then
            ((finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell) ∘
              finiteIIDSampleOnFinsetToFin inside) ⁻¹'
              {selectedSample |
                error ≤ dyadicPartitionL1Deviation dimension
                  (euclideanDyadicCubeShellCompactLaw dimension shell law)
                  inside.card level selectedSample})
          else ∅) := by
  classical
  ext sample
  constructor
  · intro htail
    rcases htail with ⟨hselected, hlarge⟩
    let inside := empiricalSampleIndicesInSet sample
      (euclideanDyadicCubeShell dimension shell)
    have hinsidenonempty : inside.Nonempty := by
      simpa [inside] using hselected
    refine Set.mem_iUnion.mpr ⟨inside, ?_⟩
    constructor
    · exact (mem_finiteIIDMembershipPattern_iff_empiricalSampleIndicesInSet_eq
        sample inside (euclideanDyadicCubeShell dimension shell)).mpr rfl
    · rw [if_pos hinsidenonempty]
      simpa [inside] using hlarge
  · intro htail
    rcases Set.mem_iUnion.mp htail with ⟨inside, hpattern, htail⟩
    have hindices : empiricalSampleIndicesInSet sample
        (euclideanDyadicCubeShell dimension shell) = inside :=
      (mem_finiteIIDMembershipPattern_iff_empiricalSampleIndicesInSet_eq
        sample inside (euclideanDyadicCubeShell dimension shell)).mp hpattern
    have hinsidenonempty : inside.Nonempty := by
      by_contra hinsideempty
      rw [if_neg hinsideempty] at htail
      simpa using htail
    subst inside
    refine ⟨hinsidenonempty, ?_⟩
    rwa [if_pos hinsidenonempty] at htail

/-- A realized selected-shell compact partition-tail event is measurable. -/
theorem measurableSet_finiteIIDRealizedCompactShellDyadicPartitionTail
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count level : ℕ) (error : ℝ) :
    MeasurableSet (finiteIIDRealizedCompactShellDyadicPartitionTail
      dimension shell law count level error) := by
  classical
  rw [finiteIIDRealizedCompactShellDyadicPartitionTail_eq_iUnion_membershipPattern]
  apply MeasurableSet.iUnion
  intro inside
  apply (measurableSet_finiteIIDMembershipPattern count inside
    (euclideanDyadicCubeShell dimension shell)
    (measurableSet_euclideanDyadicCubeShell dimension shell)).inter
  by_cases hinsidenonempty : inside.Nonempty
  · rw [if_pos hinsidenonempty]
    exact (measurableSet_dyadicPartitionL1Deviation_le dimension
      (euclideanDyadicCubeShellCompactLaw dimension shell law)
      inside.card level error).preimage
        ((measurable_finiteIIDSampleMap
          (euclideanDyadicCubeShellScaleExtension dimension shell)
          (measurable_euclideanDyadicCubeShellScaleExtension dimension shell)).comp
            (measurable_finiteIIDSampleOnFinsetToFin inside))
  · rw [if_neg hinsidenonempty]
    exact MeasurableSet.empty

/--
The realized selected-shell compact event inherits the MGF-weighted conditional
bound.  Unlike the older half-mass version, this is the direct source form for
an eventual shell-dependent threshold schedule.
-/
theorem measureReal_finiteIIDRealizedCompactShellDyadicPartitionTail_le_mgf
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count : ℕ)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0)
    (level : ℕ) (error : ℝ) (herror : 0 ≤ error) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
      (finiteIIDRealizedCompactShellDyadicPartitionTail
        dimension shell law count level error) ≤
      (2 ^ (2 ^ (dimension * level)) : ℕ) *
        Real.exp (-((count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell)) *
          (1 - Real.exp (-(error ^ 2 / 2))))) := by
  letI : IsProbabilityMeasure
      (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count) := by
    dsimp [finiteIIDSampleLaw]
    infer_instance
  let shellSet := euclideanDyadicCubeShell dimension shell
  let tailUnion : Set (Fin count → EuclideanSpace ℝ (Fin dimension)) :=
    ⋃ inside : Finset (Fin count),
      finiteIIDMembershipPattern count inside shellSet ∩
        (if inside.Nonempty then
          ((finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell) ∘
            finiteIIDSampleOnFinsetToFin inside) ⁻¹'
            {selectedSample |
              error ≤ dyadicPartitionL1Deviation dimension
                (euclideanDyadicCubeShellCompactLaw dimension shell law)
                inside.card level selectedSample})
        else ∅)
  have hsubset : finiteIIDRealizedCompactShellDyadicPartitionTail
      dimension shell law count level error ⊆ tailUnion := by
    intro sample hsample
    rcases hsample with ⟨hselected, htail⟩
    let inside := empiricalSampleIndicesInSet sample shellSet
    have hinside : inside.Nonempty := by
      rcases hselected with ⟨index, hindex⟩
      exact ⟨index, hindex⟩
    refine Set.mem_iUnion.2 ⟨inside, ?_⟩
    constructor
    · exact (mem_finiteIIDMembershipPattern_iff_empiricalSampleIndicesInSet_eq
        sample inside shellSet).mpr rfl
    · rw [if_pos hinside]
      simpa [inside, shellSet] using htail
  calc
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (finiteIIDRealizedCompactShellDyadicPartitionTail
          dimension shell law count level error) ≤
        (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
          tailUnion := measureReal_mono hsubset (measure_ne_top _ _)
    _ ≤ _ := by
      dsimp [tailUnion, shellSet]
      exact measureReal_iUnion_finiteIIDNonemptyMembershipPattern_inter_compactShellDyadicPartitionTail_le_mgf
        dimension shell law count hnonzero level error herror

/--
Within the source gate `0 ≤ z ≤ 1`, the MGF exponent has the familiar
quadratic lower bound.  This is the explicit `z² / 4` form used in the
small-deviation part of Fournier--Guillin's shell schedule.
-/
theorem measureReal_finiteIIDRealizedCompactShellDyadicPartitionTail_le_mgf_quadratic
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count : ℕ)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0)
    (level : ℕ) (error : ℝ) (herror : 0 ≤ error) (herror_le_one : error ≤ 1) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
      (finiteIIDRealizedCompactShellDyadicPartitionTail
        dimension shell law count level error) ≤
      (2 ^ (2 ^ (dimension * level)) : ℕ) *
        Real.exp (-((count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell)) * error ^ 2) / 4) := by
  let shellMass := (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
    (euclideanDyadicCubeShell dimension shell)
  have hquadratic := sq_div_four_le_one_sub_exp_neg_sq_div_two
    error herror herror_le_one
  have hscale_nonneg : 0 ≤ (count : ℝ) * shellMass := by
    exact mul_nonneg (Nat.cast_nonneg _) measureReal_nonneg
  have hscaled := mul_le_mul_of_nonneg_left hquadratic hscale_nonneg
  have hexponent : -((count : ℝ) * shellMass *
      (1 - Real.exp (-(error ^ 2 / 2)))) ≤
      -((count : ℝ) * shellMass * error ^ 2) / 4 := by
    nlinarith
  have htail :
      (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
          (finiteIIDRealizedCompactShellDyadicPartitionTail
            dimension shell law count level error) ≤
        (2 ^ (2 ^ (dimension * level)) : ℕ) *
          Real.exp (-((count : ℝ) * shellMass * error ^ 2) / 4) := by
    calc
      (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
          (finiteIIDRealizedCompactShellDyadicPartitionTail
            dimension shell law count level error) ≤
          (2 ^ (2 ^ (dimension * level)) : ℕ) *
            Real.exp (-((count : ℝ) * shellMass *
              (1 - Real.exp (-(error ^ 2 / 2))))) := by
        dsimp [shellMass]
        exact measureReal_finiteIIDRealizedCompactShellDyadicPartitionTail_le_mgf
          dimension shell law count hnonzero level error herror
      _ ≤ (2 ^ (2 ^ (dimension * level)) : ℕ) *
            Real.exp (-((count : ℝ) * shellMass * error ^ 2) / 4) := by
        exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hexponent) (by positivity)
  exact htail

/-- A dyadic cell-count prefactor is dominated by its exponential envelope. -/
theorem two_pow_nat_cast_le_exp_nat (n : ℕ) :
    ((2 ^ n : ℕ) : ℝ) ≤ Real.exp (n : ℝ) := by
  rw [Nat.cast_pow]
  calc
    (2 : ℝ) ^ n ≤ (Real.exp 1) ^ n :=
      pow_le_pow_left₀ (by norm_num) (le_of_lt Real.exp_one_gt_two) n
    _ = Real.exp ((n : ℝ) * 1) := by rw [Real.exp_nat_mul]
    _ = Real.exp (n : ℝ) := by ring

/-- The geometric confidence allocation has enough dyadic cells at each level. -/
theorem level_succ_le_dyadic_cell_count
    (dimension level : ℕ) (hdimension : 0 < dimension) :
    level + 1 ≤ 2 ^ (dimension * level) := by
  have hbase : ∀ n : ℕ, n + 1 ≤ 2 ^ n := by
    intro n
    induction n with
    | zero => norm_num
    | succ n ih =>
        rw [Nat.pow_succ]
        calc
          n + 1 + 1 ≤ 2 * (n + 1) := by omega
          _ ≤ 2 * 2 ^ n := Nat.mul_le_mul_left 2 ih
          _ = 2 ^ n * 2 := by ring
  calc
    level + 1 ≤ 2 ^ level := hbase level
    _ ≤ 2 ^ (dimension * level) := by
      apply Nat.pow_le_pow_right (by omega : 0 < 2)
      exact Nat.le_mul_of_pos_left level hdimension

/-- An integer exponential tail is dominated by the matching half-power. -/
theorem exp_neg_nat_le_half_pow_nat (n : ℕ) :
    Real.exp (-(n : ℝ)) ≤ (1 / 2 : ℝ) ^ n := by
  rw [Real.exp_neg]
  rw [show (1 / 2 : ℝ) = (2 : ℝ)⁻¹ by norm_num]
  rw [inv_pow]
  apply (inv_le_inv₀ (a := Real.exp (n : ℝ)) (b := (2 : ℝ) ^ n)
    (Real.exp_pos _) (by positivity)).mpr
  simpa [Nat.cast_pow] using two_pow_nat_cast_le_exp_nat n

/--
The dyadic-cell prefactor is summable under the explicit conditional
quadratic scale allocation.  This is the levelwise confidence calculation
needed for the selected compact-shell law.
-/
theorem dyadic_cell_count_quadratic_tail_le_geometric
    (dimension level : ℕ) (hdimension : 0 < dimension) (confidence : ℝ) :
    (2 ^ (2 ^ (dimension * level)) : ℕ) *
        Real.exp (-(2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence)) ≤
      Real.exp (-confidence) * (1 / 2 : ℝ) ^ (level + 1) := by
  have hpow := two_pow_nat_cast_le_exp_nat (2 ^ (dimension * level))
  calc
    (2 ^ (2 ^ (dimension * level)) : ℕ) *
        Real.exp (-(2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence)) ≤
        Real.exp ((2 ^ (dimension * level) : ℕ) : ℝ) *
          Real.exp (-(2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence)) := by
      gcongr
    _ = Real.exp (-confidence - ((2 ^ (dimension * level) : ℕ) : ℝ)) := by
      rw [← Real.exp_add]
      congr 1
      ring
    _ = Real.exp (-confidence) *
        Real.exp (-((2 ^ (dimension * level) : ℕ) : ℝ)) := by
      rw [← Real.exp_add]
      congr 1
    _ ≤ Real.exp (-confidence) * (1 / 2 : ℝ) ^ (2 ^ (dimension * level)) := by
      gcongr
      exact exp_neg_nat_le_half_pow_nat (2 ^ (dimension * level))
    _ ≤ Real.exp (-confidence) * (1 / 2 : ℝ) ^ (level + 1) := by
      apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
      apply pow_le_pow_of_le_one (by norm_num) (by norm_num)
      exact level_succ_le_dyadic_cell_count dimension level hdimension

/--
For one positive source shell, any level error that realizes the explicit
conditional quadratic scale has geometric-confidence failure probability.
The small-error premise is the source gate needed to use the quadratic MGF
lower bound.
-/
theorem measureReal_finiteIIDRealizedCompactShellDyadicPartitionTail_le_geometricBudget
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count : ℕ)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0)
    (level : ℕ) (error confidence : ℝ)
    (hdimension : 0 < dimension) (herror : 0 ≤ error) (herror_le_one : error ≤ 1)
    (hscale : (count : ℝ) *
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension shell)) * error ^ 2 =
        4 * (2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence)) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
      (finiteIIDRealizedCompactShellDyadicPartitionTail
        dimension shell law count level error) ≤
      Real.exp (-confidence) * (1 / 2 : ℝ) ^ (level + 1) := by
  have htail := measureReal_finiteIIDRealizedCompactShellDyadicPartitionTail_le_mgf_quadratic
    dimension shell law count hnonzero level error herror herror_le_one
  calc
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (finiteIIDRealizedCompactShellDyadicPartitionTail
          dimension shell law count level error) ≤
        (2 ^ (2 ^ (dimension * level)) : ℕ) *
          Real.exp (-((count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) * error ^ 2) / 4) := htail
    _ = (2 ^ (2 ^ (dimension * level)) : ℕ) *
          Real.exp (-(2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence)) := by
      congr 1
      rw [hscale]
      ring
    _ ≤ Real.exp (-confidence) * (1 / 2 : ℝ) ^ (level + 1) :=
      dyadic_cell_count_quadratic_tail_le_geometric dimension level hdimension confidence

/--
The concrete selected-shell compact threshold at one dyadic level.  Its
effective sample size is the expected selected count `N * mu(B_n)`, as in the
conditional compact part of the source argument.
-/
def selectedShellDyadicGeometricConfidenceThreshold
    (dimension count level : ℕ) (shellMass confidence : ℝ) : ℝ :=
  Real.sqrt (4 * (2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence) /
    ((count : ℝ) * shellMass))

/--
The selected-shell threshold is exactly the real-effective-count compact
threshold at `N * μ(B)`.  This equality is the deterministic bridge between
the conditional MGF proof and the reusable compact multiscale estimates.
-/
theorem selectedShellDyadicGeometricConfidenceThreshold_eq_realEffectiveCount
    (dimension count level : ℕ) (shellMass confidence : ℝ) :
    selectedShellDyadicGeometricConfidenceThreshold dimension count level shellMass confidence =
      dyadicGeometricConfidenceThresholdReal dimension level
        ((count : ℝ) * shellMass) confidence := rfl

theorem selectedShellDyadicGeometricConfidenceThreshold_nonneg
    (dimension count level : ℕ) (shellMass confidence : ℝ) :
    0 ≤ selectedShellDyadicGeometricConfidenceThreshold
      dimension count level shellMass confidence :=
  Real.sqrt_nonneg _

/--
The selected-shell threshold inherits the compact cell-count/confidence
decomposition at its real expected selected count.
-/
theorem selectedShellDyadicGeometricConfidenceThreshold_le_twoTerm
    (dimension count level : ℕ) {shellMass confidence : ℝ}
    (hcount : 0 < count) (hshellMass : 0 < shellMass) (hconfidence : 0 ≤ confidence) :
    selectedShellDyadicGeometricConfidenceThreshold
      dimension count level shellMass confidence ≤
      2 * (Real.sqrt (2 * ((2 ^ (dimension * level) : ℕ) : ℝ)) +
        Real.sqrt confidence) / Real.sqrt ((count : ℝ) * shellMass) := by
  rw [selectedShellDyadicGeometricConfidenceThreshold_eq_realEffectiveCount]
  apply dyadicGeometricConfidenceThresholdReal_le_twoTerm
  · exact mul_pos (by exact_mod_cast hcount) hshellMass
  · exact hconfidence

/--
The finite-depth selected-shell compact budget has the same deterministic
multiscale bound at expected selected count `N μ(B)`.  Its probability bound
is supplied separately by the MGF averaging theorem and therefore remains
valid without conditioning on a fixed realized selected count.
-/
theorem dyadicMultiscaleSelectedShellGeometricConfidenceBound_le_twoTerm
    (dimension count depth : ℕ) {shellMass confidence : ℝ}
    (hcount : 0 < count) (hshellMass : 0 < shellMass) (hconfidence : 0 ≤ confidence) :
    dyadicMultiscaleThresholdBound dimension depth
      (fun level => selectedShellDyadicGeometricConfidenceThreshold
        dimension count level shellMass confidence) ≤
      2 * dyadicCubeRadius dimension depth +
        ∑ level ∈ Finset.range depth,
          dyadicCubeStepRadius dimension level *
            (2 * (Real.sqrt (2 * ((2 ^ (dimension * (level + 1)) : ℕ) : ℝ)) +
              Real.sqrt confidence) / Real.sqrt ((count : ℝ) * shellMass)) := by
  rw [show (fun level => selectedShellDyadicGeometricConfidenceThreshold
      dimension count level shellMass confidence) =
      (fun level => dyadicGeometricConfidenceThresholdReal dimension level
        ((count : ℝ) * shellMass) confidence) by
      funext level
      exact selectedShellDyadicGeometricConfidenceThreshold_eq_realEffectiveCount
        dimension count level shellMass confidence]
  apply dyadicMultiscaleGeometricConfidenceBoundReal_le_twoTerm
  · exact mul_pos (by exact_mod_cast hcount) hshellMass
  · exact hconfidence

/--
The selected-shell geometric threshold realizes its displayed conditional
quadratic scale whenever the shell has positive mass.
-/
theorem count_mul_shellMass_sq_selectedShellDyadicGeometricConfidenceThreshold
    (dimension count level : ℕ) {shellMass confidence : ℝ}
    (hcount : 0 < count) (hshellMass : 0 < shellMass) (hconfidence : 0 ≤ confidence) :
    (count : ℝ) * shellMass *
        selectedShellDyadicGeometricConfidenceThreshold
          dimension count level shellMass confidence ^ 2 =
      4 * (2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence) := by
  unfold selectedShellDyadicGeometricConfidenceThreshold
  have hden_pos : 0 < (count : ℝ) * shellMass := by
    exact mul_pos (by exact_mod_cast hcount) hshellMass
  have hinside_nonneg : 0 ≤
      4 * (2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence) /
        ((count : ℝ) * shellMass) := by
    positivity
  rw [Real.sq_sqrt hinside_nonneg]
  field_simp [hden_pos.ne']

/--
The source small-error gate for the concrete selected-shell threshold follows
from an explicit lower bound on its effective sample size.
-/
theorem selectedShellDyadicGeometricConfidenceThreshold_le_one
    (dimension count level : ℕ) {shellMass confidence : ℝ}
    (hcount : 0 < count) (hshellMass : 0 < shellMass) (hconfidence : 0 ≤ confidence)
    (hgate : 4 * (2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence) ≤
      (count : ℝ) * shellMass) :
    selectedShellDyadicGeometricConfidenceThreshold
      dimension count level shellMass confidence ≤ 1 := by
  unfold selectedShellDyadicGeometricConfidenceThreshold
  have hden_pos : 0 < (count : ℝ) * shellMass := by
    exact mul_pos (by exact_mod_cast hcount) hshellMass
  have hinside_nonneg : 0 ≤
      4 * (2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence) /
        ((count : ℝ) * shellMass) := by
    positivity
  apply (sq_le_sq₀ (Real.sqrt_nonneg _) (by norm_num)).mp
  rw [Real.sq_sqrt hinside_nonneg]
  apply (div_le_iff₀ hden_pos).2
  simpa using hgate

/--
The concrete selected-shell threshold gives the geometric level budget under
the displayed effective-count gate, without an auxiliary concentration
certificate.
-/
theorem measureReal_finiteIIDRealizedCompactShellDyadicPartitionTail_le_selectedShellDyadicGeometricBudget
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count level : ℕ) (confidence : ℝ)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0)
    (hdimension : 0 < dimension) (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (hshellMass : 0 < (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
      (euclideanDyadicCubeShell dimension shell))
    (hgate : 4 * (2 * ((2 ^ (dimension * level) : ℕ) : ℝ) + confidence) ≤
      (count : ℝ) *
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell))) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
      (finiteIIDRealizedCompactShellDyadicPartitionTail
        dimension shell law count level
          (selectedShellDyadicGeometricConfidenceThreshold dimension count level
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) confidence)) ≤
      Real.exp (-confidence) * (1 / 2 : ℝ) ^ (level + 1) := by
  apply measureReal_finiteIIDRealizedCompactShellDyadicPartitionTail_le_geometricBudget
    dimension shell law count hnonzero level
      (selectedShellDyadicGeometricConfidenceThreshold dimension count level
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell)) confidence)
      confidence hdimension
  · exact selectedShellDyadicGeometricConfidenceThreshold_nonneg _ _ _ _ _
  · exact selectedShellDyadicGeometricConfidenceThreshold_le_one
      dimension count level hcount hshellMass hconfidence hgate
  · exact count_mul_shellMass_sq_selectedShellDyadicGeometricConfidenceThreshold
      dimension count level hcount hshellMass hconfidence

/-- The finite geometric level allocation has total mass at most one. -/
theorem sum_range_half_pow_succ_le_one (depth : ℕ) :
    (∑ level ∈ Finset.range depth, (1 / 2 : ℝ) ^ (level + 1)) ≤ 1 := by
  have hformula : ∀ n : ℕ,
      (∑ level ∈ Finset.range n, (1 / 2 : ℝ) ^ (level + 1)) =
        1 - (1 / 2 : ℝ) ^ n := by
    intro n
    induction n with
    | zero => norm_num
    | succ n ih =>
        rw [Finset.sum_range_succ, ih, pow_succ]
        ring
  rw [hformula]
  nlinarith [pow_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2) depth]

/-- The outer shell confidence allocation is geometric in the source shell index. -/
def selectedShellGeometricConfidence (confidence : ℝ) (shell : ℕ) : ℝ :=
  confidence + (shell + 1 : ℝ) * Real.log 2

/--
On a finite noncentral shell head, the geometric confidence allocation is
bounded by its terminal allocation.  The source shells are indexed as
`scale + 1`, so a `range cutoff` head reaches source shell `cutoff`.
-/
theorem selectedShellGeometricConfidence_succ_le_headConfidence
    (confidence : ℝ) (cutoff scale : ℕ) (hscale : scale ∈ Finset.range cutoff) :
    selectedShellGeometricConfidence confidence (scale + 1) ≤
      confidence + (cutoff + 1 : ℝ) * Real.log 2 := by
  have hindex : scale + 1 ≤ cutoff := by
    rw [Finset.mem_range] at hscale
    omega
  have hlog : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  unfold selectedShellGeometricConfidence
  gcongr

/--
If the real-effective-count gate is inactive on a noncentral member of a
finite source-shell head, that shell has uniformly small source mass.  The
threshold uses the head's terminal geometric confidence allocation.
-/
theorem measureReal_euclideanDyadicCubeShell_succ_lt_inactiveHeadThreshold
    (dimension count cutoff scale : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (hscale : scale ∈ Finset.range cutoff)
    (hinactive : ¬
      (16 * ((2 ^ dimension : ℕ) : ℝ) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension (scale + 1))) ∧
        8 * selectedShellGeometricConfidence confidence (scale + 1) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension (scale + 1))))) :
    (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1)) <
      (16 * ((2 ^ dimension : ℕ) : ℝ) +
        8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / (count : ℝ) := by
  let shellMass : ℝ := (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
    (euclideanDyadicCubeShell dimension (scale + 1))
  have hconfidenceAt : 0 ≤ selectedShellGeometricConfidence confidence (scale + 1) := by
    unfold selectedShellGeometricConfidence
    exact add_nonneg hconfidence
      (mul_nonneg (by positivity) (Real.log_nonneg (by norm_num)))
  have hinactiveBound :=
    Math.effectiveCount_lt_cellBudget_add_confidenceBudget_of_not_geometricEffectiveDepth_gate
      dimension hconfidenceAt hinactive
  have hconfidenceHead :=
    selectedShellGeometricConfidence_succ_le_headConfidence confidence cutoff scale hscale
  have hcountReal : 0 < (count : ℝ) := by exact_mod_cast hcount
  change shellMass < _
  apply (lt_div_iff₀ hcountReal).2
  dsimp [shellMass] at hinactiveBound ⊢
  nlinarith

/--
The retained compact depth at a source shell.  It uses its real expected
selected count `N μ(B)` and becomes zero automatically when that count cannot
support the selected-shell small-error gate.
-/
def selectedShellGeometricEffectiveDepth
    (dimension count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) (shell : ℕ) : ℕ :=
  Math.dyadicGeometricEffectiveDepth dimension
    ((count : ℝ) *
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension shell)))
    (selectedShellGeometricConfidence confidence shell)

/--
Each shellwise selected depth is bounded by the depth available from the full
sample count.  This deliberately drops only the shell mass (which is at most
one), so it is valid uniformly over active and inactive shells and can supply
the single logarithmic coefficient in a finite head bound.
-/
theorem selectedShellGeometricEffectiveDepth_le_globalCountDepth
    (dimension count shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) (hdimension : 0 < dimension) :
    selectedShellGeometricEffectiveDepth dimension count law confidence shell ≤
      Math.dyadicEffectiveCountDepth dimension ((count : ℝ) / 16) := by
  unfold selectedShellGeometricEffectiveDepth Math.dyadicGeometricEffectiveDepth
  by_cases hactive : 16 * ((2 ^ dimension : ℕ) : ℝ) ≤
      (count : ℝ) *
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell)) ∧
        8 * selectedShellGeometricConfidence confidence shell ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell))
  · rw [if_pos hactive]
    apply Math.dyadicEffectiveCountDepth_mono dimension hdimension
    · have hpositive : 0 < (count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell)) := by
        have hbase : 0 < 16 * ((2 ^ dimension : ℕ) : ℝ) := by positivity
        exact lt_of_lt_of_le hbase hactive.1
      positivity
    · have hmass_le_one :
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell)) ≤ 1 := by
          exact measureReal_le_one
      calc
        (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) / 16 ≤
            (count : ℝ) * 1 / 16 :=
          div_le_div_of_nonneg_right
            (mul_le_mul_of_nonneg_left hmass_le_one (by positivity)) (by norm_num)
        _ = (count : ℝ) / 16 := by ring
  · rw [if_neg hactive]
    simp

/-- A failed effective-count gate selects the deterministic zero-depth branch. -/
theorem selectedShellGeometricEffectiveDepth_eq_zero_of_inactive
    (dimension count shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ)
    (hinactive : ¬
      (16 * ((2 ^ dimension : ℕ) : ℝ) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) ∧
        8 * selectedShellGeometricConfidence confidence shell ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)))) :
    selectedShellGeometricEffectiveDepth dimension count law confidence shell = 0 := by
  unfold selectedShellGeometricEffectiveDepth
  change (if 16 * ((2 ^ dimension : ℕ) : ℝ) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) ∧
        8 * selectedShellGeometricConfidence confidence shell ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) then
      Math.dyadicEffectiveCountDepth dimension
        (((count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell))) / 16)
    else 0) = 0
  rw [if_neg hinactive]

/--
Every level retained by `selectedShellGeometricEffectiveDepth` satisfies the
literal effective-count gate needed by the MGF selected-shell confidence
union.  This holds uniformly over source-null shells as well, although their
events are subsequently discharged as null.
-/
theorem selectedShellGeometricEffectiveDepth_gate
    (dimension count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) (hdimension : 0 < dimension) (hconfidence : 0 ≤ confidence) :
    ∀ shell, law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0 →
      ∀ level, level ∈ Finset.range
        (selectedShellGeometricEffectiveDepth dimension count law confidence shell) →
        4 * (2 * ((2 ^ (dimension * (level + 1)) : ℕ) : ℝ) +
          selectedShellGeometricConfidence confidence shell) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) := by
  intro shell _ level hlevel
  have hconfidenceAt : 0 ≤ selectedShellGeometricConfidence confidence shell := by
    unfold selectedShellGeometricConfidence
    exact add_nonneg hconfidence
      (mul_nonneg (by positivity) (Real.log_nonneg (by norm_num)))
  exact Math.dyadicGeometricEffectiveDepth_gate dimension hdimension
    hconfidenceAt hlevel

/--
The source-shell schedule retaining the effective-count depth only through a
chosen finite head; all later shells use the deterministic zero-depth tail.
-/
def selectedShellGeometricEffectiveHeadDepth
    (dimension cutoff count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) (shell : ℕ) : ℕ :=
  if shell ≤ cutoff then
    selectedShellGeometricEffectiveDepth dimension count law confidence shell
  else 0

/-- The noncentral `range cutoff` offsets lie in the retained finite head. -/
theorem selectedShellGeometricEffectiveHeadDepth_succ_eq
    (dimension cutoff count scale : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) (hscale : scale ∈ Finset.range cutoff) :
    selectedShellGeometricEffectiveHeadDepth dimension cutoff count law confidence (scale + 1) =
      selectedShellGeometricEffectiveDepth dimension count law confidence (scale + 1) := by
  have hshell : scale + 1 ≤ cutoff := by
    rw [Finset.mem_range] at hscale
    omega
  simp [selectedShellGeometricEffectiveHeadDepth, hshell]

/--
The finite-head effective-depth schedule has the selected-shell gate at every
retained level and is identically zero in the deterministic tail.
-/
theorem selectedShellGeometricEffectiveHeadDepth_gate
    (dimension cutoff count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (confidence : ℝ) (hdimension : 0 < dimension) (hconfidence : 0 ≤ confidence) :
    (∀ shell, cutoff < shell →
      selectedShellGeometricEffectiveHeadDepth
        dimension cutoff count law confidence shell = 0) ∧
    (∀ shell, law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0 →
      ∀ level, level ∈ Finset.range
        (selectedShellGeometricEffectiveHeadDepth
          dimension cutoff count law confidence shell) →
        4 * (2 * ((2 ^ (dimension * (level + 1)) : ℕ) : ℝ) +
          selectedShellGeometricConfidence confidence shell) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell))) := by
  constructor
  · intro shell hshell
    simp [selectedShellGeometricEffectiveHeadDepth, Nat.not_le.mpr hshell]
  · intro shell hnonzero level hlevel
    by_cases hhead : shell ≤ cutoff
    · simpa [selectedShellGeometricEffectiveHeadDepth, hhead] using
        (selectedShellGeometricEffectiveDepth_gate
          dimension count law confidence hdimension hconfidence shell hnonzero level
          (by simpa [selectedShellGeometricEffectiveHeadDepth, hhead] using hlevel))
    · simp [selectedShellGeometricEffectiveHeadDepth, hhead] at hlevel

theorem exp_neg_selectedShellGeometricConfidence
    (confidence : ℝ) (shell : ℕ) :
    Real.exp (-(selectedShellGeometricConfidence confidence shell)) =
      Real.exp (-confidence) * (1 / 2 : ℝ) ^ (shell + 1) := by
  have hhalf : Real.exp (-Real.log 2) = (1 / 2 : ℝ) := by
    rw [Real.exp_neg, Real.exp_log (by norm_num : (0 : ℝ) < 2)]
    norm_num
  unfold selectedShellGeometricConfidence
  calc
    Real.exp (-(confidence + (shell + 1 : ℝ) * Real.log 2)) =
        Real.exp (-confidence) * Real.exp (-((shell + 1 : ℝ) * Real.log 2)) := by
      rw [← Real.exp_add]
      congr 1
      ring
    _ = Real.exp (-confidence) * (Real.exp (-Real.log 2) ^ (shell + 1)) := by
      congr 1
      rw [show -((shell + 1 : ℝ) * Real.log 2) =
          ((shell + 1 : ℕ) : ℝ) * (-Real.log 2) by push_cast; ring]
      rw [Real.exp_nat_mul]
    _ = Real.exp (-confidence) * (1 / 2 : ℝ) ^ (shell + 1) := by rw [hhalf]

/--
The finite-depth compact empirical-W₁ bad event for the actual nonempty
selected source-shell sample.  Its threshold is the deterministic dyadic
multiscale budget, so its complement is witnessed by the corresponding finite
family of partition-discrepancy inequalities.
-/
def finiteIIDRealizedCompactShellDyadicWassersteinTail
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count depth : ℕ) (threshold : ℕ → ℝ) :
    Set (Fin count → EuclideanSpace ℝ (Fin dimension)) :=
  {sample | ∃ hselected : (empiricalSampleIndicesInSet sample
      (euclideanDyadicCubeShell dimension shell)).Nonempty,
    ENNReal.ofReal (dyadicMultiscaleThresholdBound dimension depth threshold) <
      empiricalWassersteinOne (euclideanDyadicCubeShellCompactLaw dimension shell law)
        (Finset.card_pos.mpr hselected)
        (finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell)
          (finiteIIDSampleOnFinsetToFin
            (empiricalSampleIndicesInSet sample
              (euclideanDyadicCubeShell dimension shell)) sample))}

/--
If the realized compact shell sample exceeds a finite-depth W₁ budget, one of
the finite dyadic partition discrepancies used in that budget exceeds its
level threshold.  This is the deterministic compact Proposition 10 bridge in
the source shell coordinates.
-/
theorem finiteIIDRealizedCompactShellDyadicWassersteinTail_subset_biUnion_partitionTail
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count depth : ℕ) (threshold : ℕ → ℝ) :
    finiteIIDRealizedCompactShellDyadicWassersteinTail
        dimension shell law count depth threshold ⊆
      ⋃ level ∈ Finset.range depth,
        finiteIIDRealizedCompactShellDyadicPartitionTail
          dimension shell law count (level + 1) (threshold (level + 1)) := by
  intro sample htail
  rcases htail with ⟨hselected, hbad⟩
  let inside := empiricalSampleIndicesInSet sample
    (euclideanDyadicCubeShell dimension shell)
  have hinside : inside.Nonempty := by simpa [inside] using hselected
  by_contra hno
  have hgood : ∀ level, level ∈ Finset.range depth →
      dyadicPartitionL1Deviation dimension
        (euclideanDyadicCubeShellCompactLaw dimension shell law)
        inside.card (level + 1)
        (finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell)
          (finiteIIDSampleOnFinsetToFin inside sample)) ≤ threshold (level + 1) := by
    intro level hlevel
    apply le_of_not_ge
    intro hlarge
    have htailLevel : finiteIIDRealizedCompactShellDyadicPartitionTail
        dimension shell law count (level + 1) (threshold (level + 1)) sample := by
      refine ⟨hinside, ?_⟩
      exact hlarge
    apply hno
    apply Set.mem_iUnion.2
    refine ⟨level, ?_⟩
    apply Set.mem_iUnion.2
    exact ⟨hlevel, htailLevel⟩
  have hbound := empiricalWassersteinOne_le_dyadicMultiscaleThresholdBound_of_forall
    dimension (euclideanDyadicCubeShellCompactLaw dimension shell law) inside.card
    (Finset.card_pos.mpr hinside)
    (finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell)
      (finiteIIDSampleOnFinsetToFin inside sample)) depth threshold hgood
  exact (not_lt_of_ge hbound) (by simpa [finiteIIDRealizedCompactShellDyadicWassersteinTail,
    inside] using hbad)

/--
With no retained dyadic levels, the compact multiscale terminal-radius bound
holds deterministically.  Thus the corresponding realized compact-shell tail
is empty, a fact used for source shells handled by a coarse tail transport
bound rather than by conditional concentration.
-/
theorem finiteIIDRealizedCompactShellDyadicWassersteinTail_eq_empty_zeroDepth
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count : ℕ) (threshold : ℕ → ℝ) :
    finiteIIDRealizedCompactShellDyadicWassersteinTail
      dimension shell law count 0 threshold = ∅ := by
  ext sample
  simp only [Set.mem_empty_iff_false, iff_false]
  intro htail
  rcases htail with ⟨hselected, hbad⟩
  let inside := empiricalSampleIndicesInSet sample
    (euclideanDyadicCubeShell dimension shell)
  have hinside : inside.Nonempty := by simpa [inside] using hselected
  have hgood : ∀ level, level ∈ Finset.range 0 →
      dyadicPartitionL1Deviation dimension
        (euclideanDyadicCubeShellCompactLaw dimension shell law) inside.card (level + 1)
        (finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell)
          (finiteIIDSampleOnFinsetToFin inside sample)) ≤ threshold (level + 1) := by
    intro level hlevel
    simp at hlevel
  have hbound := empiricalWassersteinOne_le_dyadicMultiscaleThresholdBound_of_forall
    dimension (euclideanDyadicCubeShellCompactLaw dimension shell law) inside.card
    (Finset.card_pos.mpr hinside)
    (finiteIIDSampleMap (euclideanDyadicCubeShellScaleExtension dimension shell)
      (finiteIIDSampleOnFinsetToFin inside sample)) 0 threshold hgood
  exact (not_lt_of_ge hbound) (by simpa [finiteIIDRealizedCompactShellDyadicWassersteinTail,
    inside] using hbad)

/--
The fifth-order consequence of the source radial exponential moment makes the
unresolved source-shell transport tail summable.  The index starts at
`cutoff + 1`, matching the noncentral shell indexing in the Fournier--Guillin
allocation; the factor `2 ^ shell` is the scale-back cost of that compact
shell.  This is deterministic source-mass bookkeeping, independent of the
conditional compact concentration schedule.
-/
theorem measureReal_euclideanDyadicCubeShell_succ_mul_radius_le_fifthOrderExponentialRadialTail
    (dimension cutoff offset : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (cutoff + offset + 1)) *
        euclideanDyadicCubeRadius (cutoff + offset + 1) ≤
      2 * fifthOrderExponentialRadialTailConstant law alpha gamma /
        (16 : ℝ) ^ (cutoff + offset) := by
  let tailConstant := fifthOrderExponentialRadialTailConstant law alpha gamma
  let scale := cutoff + offset
  have hmass :=
    measureReal_euclideanDyadicCubeShell_succ_le_fifthOrderExponentialRadialTailConstant
      dimension scale law halpha hgamma hmoment
  have hradius_nonneg : 0 ≤ euclideanDyadicCubeRadius (scale + 1) :=
    (euclideanDyadicCubeRadius_pos _).le
  have hscaleDenom : (2 : ℝ) ^ (5 * scale) =
      (16 : ℝ) ^ scale * (2 : ℝ) ^ scale := by
    rw [show (16 : ℝ) = 2 ^ 4 by norm_num, ← pow_mul, ← pow_add]
    congr 1
    omega
  have hscaleRadius : euclideanDyadicCubeRadius (scale + 1) =
      (2 : ℝ) ^ scale * 2 := by
    unfold euclideanDyadicCubeRadius
    rw [Nat.cast_pow, pow_succ]
    ring
  have hscaleBudget :
      (tailConstant / (2 : ℝ) ^ (5 * scale)) *
        euclideanDyadicCubeRadius (scale + 1) =
        2 * tailConstant / (16 : ℝ) ^ scale := by
    rw [hscaleDenom, hscaleRadius]
    field_simp
  change _ ≤ 2 * tailConstant / (16 : ℝ) ^ scale
  calc
    (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1)) *
        euclideanDyadicCubeRadius (scale + 1) ≤
        (tailConstant / (2 : ℝ) ^ (5 * scale)) *
          euclideanDyadicCubeRadius (scale + 1) :=
      mul_le_mul_of_nonneg_right hmass hradius_nonneg
    _ = 2 * tailConstant / (16 : ℝ) ^ scale := hscaleBudget

/--
The fifth-order radial shell envelope also controls the radius times square
root of the source-shell mass.  This is the summable factor that occurs after
the critical and subcritical compact terms cancel one square root of the real
selected count.
-/
theorem measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_sqrt_le_fifthOrderExponentialRadialTail
    (dimension scale : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    euclideanDyadicCubeRadius (scale + 1) *
        Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1))) ≤
      2 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) *
        (1 / 2 : ℝ) ^ scale := by
  let tailConstant := fifthOrderExponentialRadialTailConstant law alpha gamma
  let shellMass := (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
    (euclideanDyadicCubeShell dimension (scale + 1))
  have htailConstant_nonneg : 0 ≤ tailConstant :=
    (fifthOrderExponentialRadialTailConstant_pos law hgamma hmoment).le
  have hmass : shellMass ≤ tailConstant / (2 : ℝ) ^ (5 * scale) := by
    dsimp [shellMass, tailConstant]
    exact measureReal_euclideanDyadicCubeShell_succ_le_fifthOrderExponentialRadialTailConstant
      dimension scale law halpha hgamma hmoment
  have hdenom : (16 : ℝ) ^ scale ≤ (2 : ℝ) ^ (5 * scale) := by
    calc
      (16 : ℝ) ^ scale = (2 : ℝ) ^ (4 * scale) := by
        rw [show (16 : ℝ) = 2 ^ 4 by norm_num, ← pow_mul]
      _ ≤ (2 : ℝ) ^ (5 * scale) := by
        apply pow_le_pow_right₀ (by norm_num)
        omega
  have hmass16 : shellMass ≤ tailConstant / (16 : ℝ) ^ scale :=
    hmass.trans (div_le_div_of_nonneg_left htailConstant_nonneg (by positivity) hdenom)
  have hsqrtMass : Real.sqrt shellMass ≤ Real.sqrt tailConstant / (4 : ℝ) ^ scale := by
    calc
      Real.sqrt shellMass ≤ Real.sqrt (tailConstant / (16 : ℝ) ^ scale) :=
        Real.sqrt_le_sqrt hmass16
      _ = Real.sqrt tailConstant / (4 : ℝ) ^ scale := by
        rw [Real.sqrt_div htailConstant_nonneg]
        have hfourSq : (16 : ℝ) ^ scale = ((4 : ℝ) ^ scale) ^ 2 := by
          rw [show (16 : ℝ) = 4 ^ 2 by norm_num, ← pow_mul,
            Nat.mul_comm 2 scale, pow_mul]
        rw [hfourSq, Real.sqrt_sq_eq_abs, abs_of_nonneg (by positivity)]
  have hradius : euclideanDyadicCubeRadius (scale + 1) =
      2 * (2 : ℝ) ^ scale := by
    unfold euclideanDyadicCubeRadius
    rw [Nat.cast_pow, pow_succ]
    ring
  calc
    euclideanDyadicCubeRadius (scale + 1) * Real.sqrt shellMass ≤
        euclideanDyadicCubeRadius (scale + 1) *
          (Real.sqrt tailConstant / (4 : ℝ) ^ scale) :=
      mul_le_mul_of_nonneg_left hsqrtMass (euclideanDyadicCubeRadius_pos _).le
    _ = 2 * Real.sqrt tailConstant * (1 / 2 : ℝ) ^ scale := by
      rw [hradius]
      have hfour : (4 : ℝ) ^ scale = ((2 : ℝ) ^ scale) ^ 2 := by
        rw [show (4 : ℝ) = 2 ^ 2 by norm_num, ← pow_mul,
          Nat.mul_comm 2 scale, pow_mul]
      rw [hfour, one_div_pow]
      field_simp
    _ = 2 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) *
        (1 / 2 : ℝ) ^ scale := by rfl

/--
The fractional source-mass power in every dimension at least two is no larger
than the square-root mass factor.  Consequently the same fifth-order radial
envelope controls the supercritical source-shell scale.
-/
theorem measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_rpow_one_sub_inv_le_fifthOrderExponentialRadialTail
    (dimension scale : ℕ) (hdimension : 2 ≤ dimension)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    euclideanDyadicCubeRadius (scale + 1) *
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1))) ^
            (1 - (dimension : ℝ)⁻¹) ≤
      2 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) *
        (1 / 2 : ℝ) ^ scale := by
  let shellMass := (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
    (euclideanDyadicCubeShell dimension (scale + 1))
  have hshellMass_nonneg : 0 ≤ shellMass := MeasureTheory.measureReal_nonneg
  have hshellMass_le_one : shellMass ≤ 1 := by
    dsimp [shellMass]
    exact measureReal_le_one
  calc
    euclideanDyadicCubeRadius (scale + 1) *
        shellMass ^ (1 - (dimension : ℝ)⁻¹) ≤
        euclideanDyadicCubeRadius (scale + 1) * Real.sqrt shellMass :=
      mul_le_mul_of_nonneg_left
        (Math.rpow_one_sub_inv_nat_le_sqrt dimension hdimension
          hshellMass_nonneg hshellMass_le_one)
        (euclideanDyadicCubeRadius_pos _).le
    _ ≤ 2 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) *
        (1 / 2 : ℝ) ^ scale := by
      dsimp [shellMass]
      exact measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_sqrt_le_fifthOrderExponentialRadialTail
        dimension scale law halpha hgamma hmoment

/--
The radius--square-root-mass source-shell factors are summable with an
explicit radial-moment constant.  This is the finite-energy shell estimate
used by the `N^(-1/2)` compact contributions.
-/
theorem tsum_measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_sqrt_le_fifthOrderExponentialRadialTail
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑' scale : ℕ,
      euclideanDyadicCubeRadius (scale + 1) *
        Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1))) ) ≤
      4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) := by
  let tailConstant := fifthOrderExponentialRadialTailConstant law alpha gamma
  let sourceTerm : ℕ → ℝ := fun scale =>
    euclideanDyadicCubeRadius (scale + 1) *
      Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1)))
  let geometricTerm : ℕ → ℝ := fun scale =>
    2 * Real.sqrt tailConstant * (1 / 2 : ℝ) ^ scale
  have hsource_nonneg : ∀ scale, 0 ≤ sourceTerm scale := by
    intro scale
    dsimp [sourceTerm]
    exact mul_nonneg (euclideanDyadicCubeRadius_pos _).le (Real.sqrt_nonneg _)
  have hsource_le : ∀ scale, sourceTerm scale ≤ geometricTerm scale := by
    intro scale
    dsimp [sourceTerm, geometricTerm, tailConstant]
    exact measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_sqrt_le_fifthOrderExponentialRadialTail
      dimension scale law halpha hgamma hmoment
  have hgeometric_summable : Summable geometricTerm := by
    dsimp [geometricTerm]
    exact summable_geometric_two.mul_left _
  have hsource_summable : Summable sourceTerm :=
    Summable.of_nonneg_of_le hsource_nonneg hsource_le hgeometric_summable
  have hsum := Summable.tsum_le_tsum hsource_le hsource_summable hgeometric_summable
  have hgeometric_tsum : (∑' scale : ℕ, geometricTerm scale) =
      4 * Real.sqrt tailConstant := by
    dsimp [geometricTerm]
    rw [tsum_mul_left, tsum_geometric_two]
    ring
  change (∑' scale : ℕ, sourceTerm scale) ≤ 4 * Real.sqrt tailConstant
  exact hsum.trans_eq hgeometric_tsum

/--
Every finite noncentral head has the same square-root radial bound as the
full shell sequence.  This finite form is used directly by source-head
transport estimates without first extending the head to an `ENNReal` sum.
-/
theorem sum_range_measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_sqrt_le_fifthOrderExponentialRadialTail
    (dimension cutoff : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑ scale ∈ Finset.range cutoff,
      euclideanDyadicCubeRadius (scale + 1) *
        Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1))) ) ≤
      4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) := by
  let tailConstant := fifthOrderExponentialRadialTailConstant law alpha gamma
  calc
    (∑ scale ∈ Finset.range cutoff,
      euclideanDyadicCubeRadius (scale + 1) *
        Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1)))) ≤
        ∑ scale ∈ Finset.range cutoff,
          2 * Real.sqrt tailConstant * (1 / 2 : ℝ) ^ scale := by
          apply Finset.sum_le_sum
          intro scale hscale
          dsimp [tailConstant]
          exact measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_sqrt_le_fifthOrderExponentialRadialTail
            dimension scale law halpha hgamma hmoment
    _ = (2 * Real.sqrt tailConstant) *
        ∑ scale ∈ Finset.range cutoff, (1 / 2 : ℝ) ^ scale := by
          rw [Finset.mul_sum]
    _ ≤ (2 * Real.sqrt tailConstant) * 2 := by
          apply mul_le_mul_of_nonneg_left (sum_geometric_two_le cutoff)
          positivity
    _ = 4 * Real.sqrt tailConstant := by ring
    _ = 4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) := by rfl

/--
The finite noncentral dyadic radii have their exact geometric sum.  This
separately controls the inverse-count terminal contribution of an active
one-dimensional shell head.
-/
theorem sum_range_euclideanDyadicCubeRadius_succ
    (cutoff : ℕ) :
    (∑ scale ∈ Finset.range cutoff, euclideanDyadicCubeRadius (scale + 1)) =
      2 * ((2 : ℝ) ^ cutoff - 1) := by
  induction cutoff with
  | zero => norm_num
  | succ cutoff ih =>
      rw [Finset.sum_range_succ, ih]
      have hlast : euclideanDyadicCubeRadius (cutoff + 1) =
          2 * (2 : ℝ) ^ cutoff := by
        unfold euclideanDyadicCubeRadius
        rw [Nat.cast_pow, pow_succ]
        ring
      rw [hlast, pow_succ]
      ring

/--
The finite noncentral sum of the active one-dimensional local-rate envelope.
The terminal inverse-count part uses the exact dyadic-radius sum, while the
fluctuation part uses the radial square-root source-mass estimate.
-/
theorem sum_subset_dimensionOne_activeRate_le_fifthOrderExponentialRadialTail
    (cutoff count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin 1)))
    (offsets : Finset ℕ) (hoffsets : offsets ⊆ Finset.range cutoff)
    {alpha gamma confidence : ℝ} (hcount : 0 < count)
    (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑ scale ∈ offsets,
      euclideanDyadicCubeRadius (scale + 1) *
        (128 / (count : ℝ) +
          (2 * (1 / (1 - 1 / Real.sqrt 2)) +
            2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
            Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 (scale + 1))) / Real.sqrt count)) ≤
      (128 / (count : ℝ)) * (2 * ((2 : ℝ) ^ cutoff - 1)) +
        ((2 * (1 / (1 - 1 / Real.sqrt 2)) +
          2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) /
          Real.sqrt count) *
          (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) := by
  let terminal : ℝ := 128 / (count : ℝ)
  let coefficient : ℝ :=
    2 * (1 / (1 - 1 / Real.sqrt 2)) +
      2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)
  let radiusTerm : ℕ → ℝ := fun scale => euclideanDyadicCubeRadius (scale + 1)
  let rootTerm : ℕ → ℝ := fun scale =>
    euclideanDyadicCubeRadius (scale + 1) *
      Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
        (euclideanDyadicCubeShell 1 (scale + 1)))
  have hterminal_nonneg : 0 ≤ terminal := by
    dsimp [terminal]
    positivity
  have hsqrt_two_pos : 0 < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)
  have hinv_sqrt_two_lt_one : 1 / Real.sqrt 2 < 1 := by
    apply (div_lt_iff₀ hsqrt_two_pos).2
    simpa using Real.one_lt_sqrt_two
  have hden_pos : 0 < 1 - 1 / Real.sqrt 2 := by linarith
  have hcoefficient_nonneg : 0 ≤ coefficient := by
    dsimp [coefficient]
    exact add_nonneg
      (mul_nonneg (by norm_num) (one_div_nonneg.mpr hden_pos.le))
      (mul_nonneg (by norm_num) (Real.sqrt_nonneg _))
  have hsqrt_count_pos : 0 < Real.sqrt (count : ℝ) :=
    Real.sqrt_pos.mpr (by exact_mod_cast hcount)
  have hcoefficient_div_nonneg : 0 ≤ coefficient / Real.sqrt count :=
    div_nonneg hcoefficient_nonneg hsqrt_count_pos.le
  have hradius_nonneg : ∀ scale, 0 ≤ radiusTerm scale := by
    intro scale
    dsimp [radiusTerm]
    exact (euclideanDyadicCubeRadius_pos _).le
  have hroot_nonneg : ∀ scale, 0 ≤ rootTerm scale := by
    intro scale
    dsimp [rootTerm]
    exact mul_nonneg (euclideanDyadicCubeRadius_pos _).le (Real.sqrt_nonneg _)
  have hradius_subset : (∑ scale ∈ offsets, radiusTerm scale) ≤
      ∑ scale ∈ Finset.range cutoff, radiusTerm scale := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hoffsets
    intro scale _ _
    exact hradius_nonneg scale
  have hroot_subset : (∑ scale ∈ offsets, rootTerm scale) ≤
      ∑ scale ∈ Finset.range cutoff, rootTerm scale := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hoffsets
    intro scale _ _
    exact hroot_nonneg scale
  have hradius_sum : (∑ scale ∈ Finset.range cutoff, radiusTerm scale) =
      2 * ((2 : ℝ) ^ cutoff - 1) := by
    dsimp [radiusTerm]
    exact sum_range_euclideanDyadicCubeRadius_succ cutoff
  have hroot_sum : (∑ scale ∈ Finset.range cutoff, rootTerm scale) ≤
      4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) := by
    dsimp [rootTerm]
    exact sum_range_measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_sqrt_le_fifthOrderExponentialRadialTail
      1 cutoff law halpha hgamma hmoment
  change (∑ scale ∈ offsets,
      radiusTerm scale *
        (terminal + coefficient *
          Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
            (euclideanDyadicCubeShell 1 (scale + 1))) / Real.sqrt count)) ≤ _
  calc
    (∑ scale ∈ offsets,
      radiusTerm scale *
        (terminal + coefficient *
          Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
            (euclideanDyadicCubeShell 1 (scale + 1))) / Real.sqrt count)) =
        ∑ scale ∈ offsets,
          (terminal * radiusTerm scale +
            (coefficient / Real.sqrt count) * rootTerm scale) := by
      apply Finset.sum_congr rfl
      intro scale hscale
      dsimp [rootTerm]
      ring
    _ = (∑ scale ∈ offsets, terminal * radiusTerm scale) +
          ∑ scale ∈ offsets, (coefficient / Real.sqrt count) * rootTerm scale := by
      rw [Finset.sum_add_distrib]
    _ =
        terminal * (∑ scale ∈ offsets, radiusTerm scale) +
          (coefficient / Real.sqrt count) * (∑ scale ∈ offsets, rootTerm scale) := by
      rw [Finset.mul_sum, Finset.mul_sum]
    _ ≤ terminal * (2 * ((2 : ℝ) ^ cutoff - 1)) +
          (coefficient / Real.sqrt count) *
            (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) := by
      apply add_le_add
      · exact (mul_le_mul_of_nonneg_left hradius_subset hterminal_nonneg).trans_eq
          (by rw [hradius_sum])
      · exact (mul_le_mul_of_nonneg_left hroot_subset hcoefficient_div_nonneg).trans
          (mul_le_mul_of_nonneg_left hroot_sum hcoefficient_div_nonneg)
    _ = (128 / (count : ℝ)) * (2 * ((2 : ℝ) ^ cutoff - 1)) +
        ((2 * (1 / (1 - 1 / Real.sqrt 2)) +
          2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) /
          Real.sqrt count) *
          (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) := by rfl

/--
A finite noncentral head whose source-shell masses are all below one common
threshold has a small-mass transport cost proportional to the threshold's
square root.  This is the inactive-cell branch of the effective-depth
schedule.
-/
theorem sum_range_measureReal_euclideanDyadicCubeShell_succ_mul_radius_le_sqrt_threshold_mul_fifthOrderExponentialRadialTail
    (dimension cutoff : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {alpha gamma threshold : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma)
    (hmass : ∀ scale, scale ∈ Finset.range cutoff →
      (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1)) ≤ threshold) :
    (∑ scale ∈ Finset.range cutoff,
      euclideanDyadicCubeRadius (scale + 1) *
        (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1))) ≤
      Real.sqrt threshold *
        (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) := by
  let sourceTerm : ℕ → ℝ := fun scale =>
    euclideanDyadicCubeRadius (scale + 1) *
      (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1))
  let sqrtTerm : ℕ → ℝ := fun scale =>
    euclideanDyadicCubeRadius (scale + 1) *
      Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1)))
  have hterm : ∀ scale, scale ∈ Finset.range cutoff →
      sourceTerm scale ≤ Real.sqrt threshold * sqrtTerm scale := by
    intro scale hscale
    have hmass_nonneg : 0 ≤ (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1)) := MeasureTheory.measureReal_nonneg
    have hsmall := Math.le_sqrt_mul_sqrt_of_nonneg_of_le hmass_nonneg (hmass scale hscale)
    dsimp [sourceTerm, sqrtTerm]
    calc
      euclideanDyadicCubeRadius (scale + 1) *
          (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension (scale + 1)) ≤
          euclideanDyadicCubeRadius (scale + 1) *
            (Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension (scale + 1))) * Real.sqrt threshold) :=
        mul_le_mul_of_nonneg_left hsmall (euclideanDyadicCubeRadius_pos _).le
      _ = Real.sqrt threshold *
          (euclideanDyadicCubeRadius (scale + 1) *
            Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension (scale + 1)))) := by ring
  change (∑ scale ∈ Finset.range cutoff, sourceTerm scale) ≤ _
  calc
    (∑ scale ∈ Finset.range cutoff, sourceTerm scale) ≤
        ∑ scale ∈ Finset.range cutoff, Real.sqrt threshold * sqrtTerm scale := by
          apply Finset.sum_le_sum
          intro scale hscale
          exact hterm scale hscale
    _ = Real.sqrt threshold *
        ∑ scale ∈ Finset.range cutoff, sqrtTerm scale := by
          rw [Finset.mul_sum]
    _ ≤ Real.sqrt threshold *
        (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) := by
          apply mul_le_mul_of_nonneg_left
            (sum_range_measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_sqrt_le_fifthOrderExponentialRadialTail
              dimension cutoff law halpha hgamma hmoment)
          exact Real.sqrt_nonneg _

/--
A selected subset of a finite noncentral head obeys the same small-mass
radial estimate.  Unlike the full-head version, only the selected offsets
need satisfy the common mass threshold; this is the form used after splitting
the effective-depth schedule into active and inactive source shells.
-/
theorem sum_subset_measureReal_euclideanDyadicCubeShell_succ_mul_radius_le_sqrt_threshold_mul_fifthOrderExponentialRadialTail
    (dimension cutoff : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (offsets : Finset ℕ) (hoffsets : offsets ⊆ Finset.range cutoff)
    {alpha gamma threshold : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma)
    (hmass : ∀ scale, scale ∈ offsets →
      (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1)) ≤ threshold) :
    (∑ scale ∈ offsets,
      euclideanDyadicCubeRadius (scale + 1) *
        (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1))) ≤
      Real.sqrt threshold *
        (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) := by
  let sourceTerm : ℕ → ℝ := fun scale =>
    euclideanDyadicCubeRadius (scale + 1) *
      (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1))
  let sqrtTerm : ℕ → ℝ := fun scale =>
    euclideanDyadicCubeRadius (scale + 1) *
      Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1)))
  have hterm : ∀ scale, scale ∈ offsets →
      sourceTerm scale ≤ Real.sqrt threshold * sqrtTerm scale := by
    intro scale hscale
    have hmass_nonneg : 0 ≤ (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1)) := MeasureTheory.measureReal_nonneg
    have hsmall := Math.le_sqrt_mul_sqrt_of_nonneg_of_le hmass_nonneg (hmass scale hscale)
    dsimp [sourceTerm, sqrtTerm]
    calc
      euclideanDyadicCubeRadius (scale + 1) *
          (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension (scale + 1)) ≤
          euclideanDyadicCubeRadius (scale + 1) *
            (Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension (scale + 1))) * Real.sqrt threshold) :=
        mul_le_mul_of_nonneg_left hsmall (euclideanDyadicCubeRadius_pos _).le
      _ = Real.sqrt threshold *
          (euclideanDyadicCubeRadius (scale + 1) *
            Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension (scale + 1)))) := by ring
  change (∑ scale ∈ offsets, sourceTerm scale) ≤ _
  calc
    (∑ scale ∈ offsets, sourceTerm scale) ≤
        ∑ scale ∈ offsets, Real.sqrt threshold * sqrtTerm scale := by
          apply Finset.sum_le_sum
          intro scale hscale
          exact hterm scale hscale
    _ = Real.sqrt threshold * ∑ scale ∈ offsets, sqrtTerm scale := by
          rw [Finset.mul_sum]
    _ ≤ Real.sqrt threshold * ∑ scale ∈ Finset.range cutoff, sqrtTerm scale := by
          apply mul_le_mul_of_nonneg_left
          · apply Finset.sum_le_sum_of_subset_of_nonneg hoffsets
            intro scale _ _
            dsimp [sqrtTerm]
            exact mul_nonneg (euclideanDyadicCubeRadius_pos _).le (Real.sqrt_nonneg _)
          · exact Real.sqrt_nonneg _
    _ ≤ Real.sqrt threshold *
        (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) := by
          apply mul_le_mul_of_nonneg_left
            (sum_range_measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_sqrt_le_fifthOrderExponentialRadialTail
              dimension cutoff law halpha hgamma hmoment)
          exact Real.sqrt_nonneg _

/--
The finite noncentral supercritical source head is controlled by the same
square-root radial constant; its fractional mass factor is absorbed locally.
-/
theorem sum_range_measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_rpow_one_sub_inv_le_fifthOrderExponentialRadialTail
    (dimension cutoff : ℕ) (hdimension : 2 ≤ dimension)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑ scale ∈ Finset.range cutoff,
      euclideanDyadicCubeRadius (scale + 1) *
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1))) ^
            (1 - (dimension : ℝ)⁻¹)) ≤
      4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) := by
  let tailConstant := fifthOrderExponentialRadialTailConstant law alpha gamma
  calc
    (∑ scale ∈ Finset.range cutoff,
      euclideanDyadicCubeRadius (scale + 1) *
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (scale + 1))) ^
            (1 - (dimension : ℝ)⁻¹)) ≤
        ∑ scale ∈ Finset.range cutoff,
          2 * Real.sqrt tailConstant * (1 / 2 : ℝ) ^ scale := by
          apply Finset.sum_le_sum
          intro scale hscale
          dsimp [tailConstant]
          exact measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_rpow_one_sub_inv_le_fifthOrderExponentialRadialTail
            dimension scale hdimension law halpha hgamma hmoment
    _ = (2 * Real.sqrt tailConstant) *
        ∑ scale ∈ Finset.range cutoff, (1 / 2 : ℝ) ^ scale := by
          rw [Finset.mul_sum]
    _ ≤ (2 * Real.sqrt tailConstant) * 2 := by
          apply mul_le_mul_of_nonneg_left (sum_geometric_two_le cutoff)
          positivity
    _ = 4 * Real.sqrt tailConstant := by ring
    _ = 4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) := by rfl

/--
The finite active supercritical source-head rate is summable at its exact
fractional-power and confidence scales.  Both radial factors are bounded by
the same fifth-order exponential-moment envelope.
-/
theorem sum_subset_dimensionGreaterTwo_activeRate_le_fifthOrderExponentialRadialTail
    (dimension cutoff count : ℕ) (hdimension : 2 < dimension)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (offsets : Finset ℕ) (hoffsets : offsets ⊆ Finset.range cutoff)
    {alpha gamma confidence : ℝ} (hcount : 0 < count)
    (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑ scale ∈ offsets,
      euclideanDyadicCubeRadius (scale + 1) *
        ((2 * Real.sqrt dimension +
            Real.sqrt dimension * Real.sqrt 2 /
              (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
          ((16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension (scale + 1)) ^ (1 - (dimension : ℝ)⁻¹) /
              (count : ℝ) ^ ((dimension : ℝ)⁻¹))) +
          (2 * Real.sqrt dimension *
            Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
            Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension (scale + 1))) / Real.sqrt count)) ≤
      (((2 * Real.sqrt dimension +
            Real.sqrt dimension * Real.sqrt 2 /
              (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
          (16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹) /
          (count : ℝ) ^ ((dimension : ℝ)⁻¹) +
          (2 * Real.sqrt dimension *
            Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / Real.sqrt count) *
        (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma))) := by
  let mainCoefficient : ℝ :=
    (2 * Real.sqrt dimension + Real.sqrt dimension * Real.sqrt 2 /
      (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
      (16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹) /
      (count : ℝ) ^ ((dimension : ℝ)⁻¹)
  let confidenceCoefficient : ℝ :=
    (2 * Real.sqrt dimension *
      Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / Real.sqrt count
  let fractionalTerm : ℕ → ℝ := fun scale =>
    euclideanDyadicCubeRadius (scale + 1) *
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1))) ^ (1 - (dimension : ℝ)⁻¹)
  let rootTerm : ℕ → ℝ := fun scale =>
    euclideanDyadicCubeRadius (scale + 1) *
      Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1)))
  have hratio : 1 < Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 := by
    apply (lt_div_iff₀ (by norm_num : (0 : ℝ) < 2)).mpr
    simp only [one_mul]
    apply (Real.lt_sqrt (by norm_num : (0 : ℝ) ≤ 2)).mpr
    have hpow : 2 ^ 2 < 2 ^ dimension :=
      Nat.pow_lt_pow_right (by norm_num) hdimension
    norm_num at hpow ⊢
    exact_mod_cast hpow
  have hmain_nonneg : 0 ≤ mainCoefficient := by
    dsimp [mainCoefficient]
    have hden : 0 ≤ Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1 := by linarith
    positivity
  have hconfidence_nonneg : 0 ≤ confidenceCoefficient := by
    dsimp [confidenceCoefficient]
    positivity
  have hfractional_nonneg : ∀ scale, 0 ≤ fractionalTerm scale := by
    intro scale
    dsimp [fractionalTerm]
    exact mul_nonneg (euclideanDyadicCubeRadius_pos _).le (Real.rpow_nonneg
      MeasureTheory.measureReal_nonneg _)
  have hroot_nonneg : ∀ scale, 0 ≤ rootTerm scale := by
    intro scale
    dsimp [rootTerm]
    exact mul_nonneg (euclideanDyadicCubeRadius_pos _).le (Real.sqrt_nonneg _)
  have hfractional_subset : (∑ scale ∈ offsets, fractionalTerm scale) ≤
      ∑ scale ∈ Finset.range cutoff, fractionalTerm scale := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hoffsets
    intro scale _ _
    exact hfractional_nonneg scale
  have hroot_subset : (∑ scale ∈ offsets, rootTerm scale) ≤
      ∑ scale ∈ Finset.range cutoff, rootTerm scale := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hoffsets
    intro scale _ _
    exact hroot_nonneg scale
  have hfractional_sum : (∑ scale ∈ Finset.range cutoff, fractionalTerm scale) ≤
      4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) := by
    dsimp [fractionalTerm]
    exact sum_range_measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_rpow_one_sub_inv_le_fifthOrderExponentialRadialTail
      dimension cutoff (by omega) law halpha hgamma hmoment
  have hroot_sum : (∑ scale ∈ Finset.range cutoff, rootTerm scale) ≤
      4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma) := by
    dsimp [rootTerm]
    exact sum_range_measureReal_euclideanDyadicCubeShell_succ_mul_radius_mul_sqrt_le_fifthOrderExponentialRadialTail
      dimension cutoff law halpha hgamma hmoment
  suffices htarget : (∑ scale ∈ offsets,
      (mainCoefficient * fractionalTerm scale + confidenceCoefficient * rootTerm scale)) ≤
      (mainCoefficient + confidenceCoefficient) *
        (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) by
    convert htarget using 1
    · apply Finset.sum_congr rfl
      intro scale _
      dsimp [mainCoefficient, confidenceCoefficient, fractionalTerm, rootTerm]
      ring
  calc
    (∑ scale ∈ offsets,
        (mainCoefficient * fractionalTerm scale + confidenceCoefficient * rootTerm scale)) =
        mainCoefficient * (∑ scale ∈ offsets, fractionalTerm scale) +
          confidenceCoefficient * (∑ scale ∈ offsets, rootTerm scale) := by
      rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
    _ ≤ mainCoefficient *
          (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) +
        confidenceCoefficient *
          (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) := by
      apply add_le_add
      · exact (mul_le_mul_of_nonneg_left hfractional_subset hmain_nonneg).trans
          (mul_le_mul_of_nonneg_left hfractional_sum hmain_nonneg)
      · exact (mul_le_mul_of_nonneg_left hroot_subset hconfidence_nonneg).trans
          (mul_le_mul_of_nonneg_left hroot_sum hconfidence_nonneg)
    _ = (mainCoefficient + confidenceCoefficient) *
        (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)) := by ring

/--
The source-mass times scale-back-radius tail is summable under the fifth-order
radial-moment envelope.  This is the analytic fact needed before moving the
tail budget into `ENNReal` transport bookkeeping.
-/
theorem summable_measureReal_euclideanDyadicCubeShell_succ_mul_radius
    (dimension cutoff : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    Summable (fun offset : ℕ =>
      (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (cutoff + offset + 1)) *
        euclideanDyadicCubeRadius (cutoff + offset + 1)) := by
  let tailConstant := fifthOrderExponentialRadialTailConstant law alpha gamma
  let sourceTerm : ℕ → ℝ := fun offset =>
    (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
      (euclideanDyadicCubeShell dimension (cutoff + offset + 1)) *
      euclideanDyadicCubeRadius (cutoff + offset + 1)
  let geometricTerm : ℕ → ℝ := fun offset =>
    (2 * tailConstant / (16 : ℝ) ^ cutoff) * (1 / 16 : ℝ) ^ offset
  have hgeometric_summable : Summable geometricTerm := by
    dsimp [geometricTerm]
    exact (summable_geometric_of_norm_lt_one (by norm_num : ‖(1 / 16 : ℝ)‖ < 1)).mul_left _
  have hsource_nonneg : ∀ offset, 0 ≤ sourceTerm offset := by
    intro offset
    dsimp [sourceTerm]
    exact mul_nonneg MeasureTheory.measureReal_nonneg (euclideanDyadicCubeRadius_pos _).le
  apply Summable.of_nonneg_of_le hsource_nonneg _ hgeometric_summable
  intro offset
  let scale := cutoff + offset
  have hshiftBudget : 2 * tailConstant / (16 : ℝ) ^ scale =
      (2 * tailConstant / (16 : ℝ) ^ cutoff) * (1 / 16 : ℝ) ^ offset := by
    dsimp [scale]
    rw [pow_add, div_pow]
    simp only [one_pow]
    field_simp
  change sourceTerm offset ≤ geometricTerm offset
  calc
    sourceTerm offset ≤ 2 * tailConstant / (16 : ℝ) ^ scale := by
      dsimp [sourceTerm, scale]
      exact measureReal_euclideanDyadicCubeShell_succ_mul_radius_le_fifthOrderExponentialRadialTail
        dimension cutoff offset law halpha hgamma hmoment
    _ = geometricTerm offset := hshiftBudget

/--
The fifth-order consequence of the source radial exponential moment makes the
unresolved source-shell transport tail summable.  The index starts at
`cutoff + 1`, matching the noncentral shell indexing in the Fournier--Guillin
allocation; the factor `2 ^ shell` is the scale-back cost of that compact
shell.  This is deterministic source-mass bookkeeping, independent of the
conditional compact concentration schedule.
-/
theorem tsum_measureReal_euclideanDyadicCubeShell_succ_mul_radius_le_fifthOrderExponentialRadialTail
    (dimension cutoff : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑' offset : ℕ,
      (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (cutoff + offset + 1)) *
        euclideanDyadicCubeRadius (cutoff + offset + 1)) ≤
      (32 / 15 : ℝ) * fifthOrderExponentialRadialTailConstant law alpha gamma /
        (16 : ℝ) ^ cutoff := by
  let tailConstant := fifthOrderExponentialRadialTailConstant law alpha gamma
  let sourceTerm : ℕ → ℝ := fun offset =>
    (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
      (euclideanDyadicCubeShell dimension (cutoff + offset + 1)) *
      euclideanDyadicCubeRadius (cutoff + offset + 1)
  let geometricTerm : ℕ → ℝ := fun offset =>
    (2 * tailConstant / (16 : ℝ) ^ cutoff) * (1 / 16 : ℝ) ^ offset
  have htailConstant_nonneg : 0 ≤ tailConstant :=
    (fifthOrderExponentialRadialTailConstant_pos law hgamma hmoment).le
  have hgeometric_nonneg : ∀ offset, 0 ≤ geometricTerm offset := by
    intro offset
    dsimp [geometricTerm]
    positivity
  have hgeometric_summable : Summable geometricTerm := by
    dsimp [geometricTerm]
    exact (summable_geometric_of_norm_lt_one (by norm_num : ‖(1 / 16 : ℝ)‖ < 1)).mul_left _
  have hsource_le : ∀ offset, sourceTerm offset ≤ geometricTerm offset := by
    intro offset
    let scale := cutoff + offset
    have hshiftBudget : 2 * tailConstant / (16 : ℝ) ^ scale =
        (2 * tailConstant / (16 : ℝ) ^ cutoff) * (1 / 16 : ℝ) ^ offset := by
      dsimp [scale]
      rw [pow_add, div_pow]
      simp only [one_pow]
      field_simp
    change sourceTerm offset ≤ geometricTerm offset
    calc
      sourceTerm offset ≤ 2 * tailConstant / (16 : ℝ) ^ scale := by
        dsimp [sourceTerm, scale]
        exact measureReal_euclideanDyadicCubeShell_succ_mul_radius_le_fifthOrderExponentialRadialTail
          dimension cutoff offset law halpha hgamma hmoment
      _ = geometricTerm offset := hshiftBudget
  have hsource_nonneg : ∀ offset, 0 ≤ sourceTerm offset := by
    intro offset
    dsimp [sourceTerm]
    exact mul_nonneg MeasureTheory.measureReal_nonneg (euclideanDyadicCubeRadius_pos _).le
  have hsource_summable : Summable sourceTerm :=
    Summable.of_nonneg_of_le hsource_nonneg hsource_le hgeometric_summable
  have htsum_le : (∑' offset, sourceTerm offset) ≤ ∑' offset, geometricTerm offset :=
    Summable.tsum_le_tsum hsource_le hsource_summable hgeometric_summable
  have htsum_geometric : (∑' offset, geometricTerm offset) =
      (32 / 15 : ℝ) * tailConstant / (16 : ℝ) ^ cutoff := by
    dsimp [geometricTerm]
    rw [tsum_mul_left, tsum_geometric_of_norm_lt_one]
    · field_simp
      ring
    · norm_num
  change (∑' offset, sourceTerm offset) ≤
    (32 / 15 : ℝ) * tailConstant / (16 : ℝ) ^ cutoff
  exact htsum_le.trans_eq htsum_geometric

/-- For a fixed tail envelope, the deterministic radial contribution to the
empirical-`W₁` shell bound vanishes as the common radial cutoff grows. -/
theorem tendsto_pOneFournierGuillinRadialTailBudget_nhds_zero
    (dimension : ℕ) (tailConstant : ℝ) :
    Filter.Tendsto
      (fun cutoff : ℕ =>
        (2 * Real.sqrt dimension) *
          ((32 / 15 : ℝ) * tailConstant / (16 : ℝ) ^ cutoff))
      Filter.atTop (nhds 0) := by
  have htail := AppliedModelingLib.Math.tendsto_const_div_pow_nat_nhds_zero
    (constant := (32 / 15 : ℝ) * tailConstant) (base := 16) (by norm_num : (1 : ℝ) < 16)
  convert htail.const_mul (2 * Real.sqrt dimension) using 1 <;> ring

/-- A positive deterministic W₁ tolerance admits a radial cutoff whose
tail-budget contribution is strictly below it. -/
theorem exists_pOneFournierGuillinRadialTailBudget_lt_of_pos
    (dimension : ℕ) (tailConstant : ℝ) {tolerance : ℝ} (htolerance : 0 < tolerance) :
    ∃ cutoff : ℕ,
      (2 * Real.sqrt dimension) *
          ((32 / 15 : ℝ) * tailConstant / (16 : ℝ) ^ cutoff) < tolerance := by
  have hsmall : ∀ᶠ cutoff : ℕ in Filter.atTop,
      (2 * Real.sqrt dimension) *
          ((32 / 15 : ℝ) * tailConstant / (16 : ℝ) ^ cutoff) < tolerance :=
    (tendsto_pOneFournierGuillinRadialTailBudget_nhds_zero dimension tailConstant).eventually
      (eventually_lt_nhds htolerance)
  exact hsmall.exists

/--
`ENNReal` form of the deterministic source-shell transport tail.  It is the
form consumed by the shell coupling bound, whose compact contributions are
extended nonnegative reals.
-/
theorem tsum_ofReal_measureReal_euclideanDyadicCubeShell_succ_mul_radius_le_fifthOrderExponentialRadialTail
    (dimension cutoff : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {alpha gamma : ℝ} (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma) :
    (∑' offset : ℕ,
      ENNReal.ofReal
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension (cutoff + offset + 1)) *
          euclideanDyadicCubeRadius (cutoff + offset + 1))) ≤
      ENNReal.ofReal
        ((32 / 15 : ℝ) * fifthOrderExponentialRadialTailConstant law alpha gamma /
          (16 : ℝ) ^ cutoff) := by
  let sourceTerm : ℕ → ℝ := fun offset =>
    (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
      (euclideanDyadicCubeShell dimension (cutoff + offset + 1)) *
      euclideanDyadicCubeRadius (cutoff + offset + 1)
  have hsource_nonneg : ∀ offset, 0 ≤ sourceTerm offset := by
    intro offset
    dsimp [sourceTerm]
    exact mul_nonneg MeasureTheory.measureReal_nonneg (euclideanDyadicCubeRadius_pos _).le
  have hsource_summable : Summable sourceTerm := by
    dsimp [sourceTerm]
    exact summable_measureReal_euclideanDyadicCubeShell_succ_mul_radius
      dimension cutoff law halpha hgamma hmoment
  calc
    (∑' offset : ℕ, ENNReal.ofReal (sourceTerm offset)) =
        ENNReal.ofReal (∑' offset : ℕ, sourceTerm offset) := by
      symm
      exact ENNReal.ofReal_tsum_of_nonneg hsource_nonneg hsource_summable
    _ ≤ ENNReal.ofReal
        ((32 / 15 : ℝ) * fifthOrderExponentialRadialTailConstant law alpha gamma /
          (16 : ℝ) ^ cutoff) :=
      ENNReal.ofReal_le_ofReal
        (tsum_measureReal_euclideanDyadicCubeShell_succ_mul_radius_le_fifthOrderExponentialRadialTail
          dimension cutoff law halpha hgamma hmoment)

/--
The exact MGF-weighted compact W₁ tail for one realized source shell.  It is a
finite sum over the compact dyadic levels, while retaining the source's
random-selected-count MGF factor at every level.
-/
theorem measureReal_finiteIIDRealizedCompactShellDyadicWassersteinTail_le_mgf
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count depth : ℕ)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0)
    (threshold : ℕ → ℝ) (hthreshold : ∀ level, 0 ≤ threshold level) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
      (finiteIIDRealizedCompactShellDyadicWassersteinTail
        dimension shell law count depth threshold) ≤
      ∑ level ∈ Finset.range depth,
        (2 ^ (2 ^ (dimension * (level + 1))) : ℕ) *
          Real.exp (-((count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) *
            (1 - Real.exp (-(threshold (level + 1) ^ 2 / 2))))) := by
  let sampleLaw := finiteIIDSampleLaw
    (law : Measure (EuclideanSpace ℝ (Fin dimension))) count
  let tail := fun level : ℕ =>
    finiteIIDRealizedCompactShellDyadicPartitionTail
      dimension shell law count (level + 1) (threshold (level + 1))
  letI : IsProbabilityMeasure sampleLaw := by
    dsimp [sampleLaw, finiteIIDSampleLaw]
    infer_instance
  calc
    sampleLaw.real (finiteIIDRealizedCompactShellDyadicWassersteinTail
        dimension shell law count depth threshold) ≤
        sampleLaw.real (⋃ level ∈ Finset.range depth, tail level) :=
      measureReal_mono
        (finiteIIDRealizedCompactShellDyadicWassersteinTail_subset_biUnion_partitionTail
          dimension shell law count depth threshold)
        (measure_ne_top _ _)
    _ ≤ ∑ level ∈ Finset.range depth, sampleLaw.real (tail level) :=
      measureReal_biUnion_finset_le (μ := sampleLaw) (Finset.range depth) tail
    _ ≤ ∑ level ∈ Finset.range depth,
        (2 ^ (2 ^ (dimension * (level + 1))) : ℕ) *
          Real.exp (-((count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) *
            (1 - Real.exp (-(threshold (level + 1) ^ 2 / 2))))) := by
      apply Finset.sum_le_sum
      intro level hlevel
      dsimp [sampleLaw, tail]
      exact measureReal_finiteIIDRealizedCompactShellDyadicPartitionTail_le_mgf
        dimension shell law count hnonzero (level + 1) (threshold (level + 1))
        (hthreshold (level + 1))

/--
At a positive source shell, the concrete selected-shell geometric threshold
has total finite-depth compact-W₁ failure probability at most
`exp (-confidence)`, provided its effective-count small-error gate holds at
every retained dyadic level.
-/
theorem measureReal_finiteIIDRealizedCompactShellDyadicWassersteinTail_le_selectedShellDyadicGeometricBudget
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count depth : ℕ) (confidence : ℝ)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0)
    (hdimension : 0 < dimension) (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (hshellMass : 0 < (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
      (euclideanDyadicCubeShell dimension shell))
    (hgate : ∀ level, level ∈ Finset.range depth →
      4 * (2 * ((2 ^ (dimension * (level + 1)) : ℕ) : ℝ) + confidence) ≤
        (count : ℝ) *
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell))) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
      (finiteIIDRealizedCompactShellDyadicWassersteinTail
        dimension shell law count depth
          (fun level => selectedShellDyadicGeometricConfidenceThreshold
            dimension count level
              ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
                (euclideanDyadicCubeShell dimension shell)) confidence)) ≤
      Real.exp (-confidence) := by
  let sampleLaw := finiteIIDSampleLaw
    (law : Measure (EuclideanSpace ℝ (Fin dimension))) count
  let threshold := fun level : ℕ => selectedShellDyadicGeometricConfidenceThreshold
    dimension count level
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension shell)) confidence
  let tail := fun level : ℕ => finiteIIDRealizedCompactShellDyadicPartitionTail
    dimension shell law count (level + 1) (threshold (level + 1))
  letI : IsProbabilityMeasure sampleLaw := by
    dsimp [sampleLaw, finiteIIDSampleLaw]
    infer_instance
  calc
    sampleLaw.real (finiteIIDRealizedCompactShellDyadicWassersteinTail
        dimension shell law count depth threshold) ≤
        sampleLaw.real (⋃ level ∈ Finset.range depth, tail level) :=
      measureReal_mono
        (finiteIIDRealizedCompactShellDyadicWassersteinTail_subset_biUnion_partitionTail
          dimension shell law count depth threshold)
        (measure_ne_top _ _)
    _ ≤ ∑ level ∈ Finset.range depth, sampleLaw.real (tail level) :=
      measureReal_biUnion_finset_le (μ := sampleLaw) (Finset.range depth) tail
    _ ≤ ∑ level ∈ Finset.range depth,
        Real.exp (-confidence) * (1 / 2 : ℝ) ^ (level + 1) := by
      apply Finset.sum_le_sum
      intro level hlevel
      dsimp [sampleLaw, tail, threshold]
      refine
        (measureReal_finiteIIDRealizedCompactShellDyadicPartitionTail_le_selectedShellDyadicGeometricBudget
          dimension shell law count (level + 1) confidence hnonzero hdimension hcount hconfidence
          hshellMass (hgate level hlevel)).trans ?_
      apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
      apply pow_le_pow_of_le_one (by norm_num) (by norm_num)
      omega
    _ = Real.exp (-confidence) *
        (∑ level ∈ Finset.range depth, (1 / 2 : ℝ) ^ (level + 1)) := by
      rw [Finset.mul_sum]
    _ ≤ Real.exp (-confidence) * 1 :=
      mul_le_mul_of_nonneg_left (sum_range_half_pow_succ_le_one depth) (Real.exp_pos _).le
    _ = Real.exp (-confidence) := by ring

/--
At a positive source shell, the finite union of the measurable partition
