import AppliedModelingLib.Foundations.Probability.EuclideanShellConcentration
import AppliedModelingLib.Foundations.Probability.EuclideanEmpiricalWasserstein
import AppliedModelingLib.Foundations.Math.Asymptotics

/-!
# Conditional concentration on Euclidean dyadic shells

This module connects the source cube-shell resampling law to the existing
finite compact dyadic-partition concentration theorem.  It keeps the tail
event measurable by using the partition statistic rather than a full
Wasserstein event.

The constituent conditional-IID, shell-normalization, measurable-map, and
compact concentration APIs are local checked results.  Their exact pinned
Mathlib Apache-2.0 provenance is recorded in their owning modules and in
`docs/UPSTREAM_LEAN_SOURCES.md`; no external Lean source is imported, copied,
or ported here.
-/

namespace AppliedModelingLib
namespace Probability

open MeasureTheory ProbabilityTheory
open scoped ENNReal

noncomputable section

/--
For finite extended nonnegative reals, the max-minus-min encoding of an
absolute difference has the expected real-valued form.  This lets the source
shell-coupling discrepancy interface consume the real empirical-frequency
bound without any coercion shortcut.

Library provenance: this directly uses Mathlib's `ENNReal.toReal_sub_of_le`
from [`Data/ENNReal/Operations.lean`](https://github.com/leanprover-community/mathlib4/blob/5450b53e5ddc75d46418fabb605edbf36bd0beb6/Mathlib/Data/ENNReal/Operations.lean)
and `ENNReal.toReal_mono` from
[`Data/ENNReal/Real.lean`](https://github.com/leanprover-community/mathlib4/blob/5450b53e5ddc75d46418fabb605edbf36bd0beb6/Mathlib/Data/ENNReal/Real.lean),
at the pinned Apache-2.0 Mathlib commit. No external Lean source is copied or
ported.
-/
theorem ENNReal_toReal_max_sub_min_eq_abs_sub
    (a b : ℝ≥0∞) (ha : a ≠ ∞) (hb : b ≠ ∞) :
    (max a b - min a b).toReal = |a.toReal - b.toReal| := by
  rcases le_total a b with hab | hba
  · rw [max_eq_right hab, min_eq_left hab, ENNReal.toReal_sub_of_le hab hb]
    rw [abs_of_nonpos (sub_nonpos.mpr (ENNReal.toReal_mono hb hab))]
    ring
  · rw [max_eq_left hba, min_eq_right hba, ENNReal.toReal_sub_of_le hba ha]
    rw [abs_of_nonneg (sub_nonneg.mpr (ENNReal.toReal_mono ha hba))]

/--
The `p = 1`, `eta = 1` relative shell tolerance from Fournier--Guillin
Lemma 13, with its fixed coefficient `1 - 2⁻¹ = 1/2`.  It is only evaluated
on positive-mass shells; null shells are handled by totalization below.
-/
def pOneFournierGuillinShellTolerance
    (deviation shellMass : ℝ) (shell : ℕ) : ℝ :=
  deviation / (2 * (4 : ℝ) ^ shell * shellMass)

/--
The source's `p = 1` shell allocation with an explicit auxiliary `eta > 0`.
Fournier--Guillin choose this parameter small enough relative to the available
tail exponent; retaining it is necessary for their full `alpha > 1`
exponential-moment branch.  The fixed allocation above is its `eta = 1`
specialization.

Library provenance: the real-power operations used in this source-shaped
weight directly reuse Mathlib's `Real.rpow` interface from
[`Analysis/SpecialFunctions/Pow/Real.lean`](https://github.com/leanprover-community/mathlib4/blob/5450b53e5ddc75d46418fabb605edbf36bd0beb6/Mathlib/Analysis/SpecialFunctions/Pow/Real.lean)
([official documentation](https://leanprover-community.github.io/mathlib4_docs/Mathlib/Analysis/SpecialFunctions/Pow/Real.html)),
at the pinned Apache-2.0 Mathlib commit. No external Lean source is copied or
ported.
-/
def pOneFournierGuillinShellCoefficient (eta : ℝ) : ℝ :=
  1 - Real.rpow 2 (-eta)

/-- The source's `p = 1` shell allocation weight at one dyadic scale. -/
def pOneFournierGuillinShellWeight
    (eta deviation : ℝ) (shell : ℕ) : ℝ :=
  pOneFournierGuillinShellCoefficient eta * deviation *
    Real.rpow 2 (-((1 + eta) * (shell : ℝ)))

/--
A concrete source-admissible auxiliary exponent for the `p = 1` exponential
moment regime.  The source permits any sufficiently small `eta`; this choice
is positive, at most one, and satisfies `1 + eta < alpha` whenever
`alpha > 1`.
-/
def pOneFournierGuillinAdmissibleEta (alpha : ℝ) : ℝ :=
  min 1 (alpha - 1) / 2

/-- The canonical allocation exponent is admissible in the source regime. -/
theorem pOneFournierGuillinAdmissibleEta_spec {alpha : ℝ} (halpha : 1 < alpha) :
    0 < pOneFournierGuillinAdmissibleEta alpha ∧
      pOneFournierGuillinAdmissibleEta alpha ≤ 1 ∧
        1 + pOneFournierGuillinAdmissibleEta alpha < alpha := by
  unfold pOneFournierGuillinAdmissibleEta
  have hmin_pos : 0 < min 1 (alpha - 1) := by
    exact lt_min zero_lt_one (sub_pos.mpr halpha)
  have hmin_one : min 1 (alpha - 1) ≤ 1 := min_le_left _ _
  have hmin_alpha : min 1 (alpha - 1) ≤ alpha - 1 := min_le_right _ _
  have hhalf_lt : min 1 (alpha - 1) / 2 < min 1 (alpha - 1) := by
    nlinarith
  constructor
  · positivity
  constructor
  · nlinarith
  · linarith

/-- A positive deviation gives every parameterized source shell positive weight. -/
theorem pOneFournierGuillinShellCoefficient_pos {eta : ℝ} (heta : 0 < eta) :
    0 < pOneFournierGuillinShellCoefficient eta := by
  unfold pOneFournierGuillinShellCoefficient
  exact sub_pos.mpr
    (Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (neg_lt_zero.mpr heta))

/-- A positive deviation gives every parameterized source shell positive weight. -/
theorem pOneFournierGuillinShellWeight_pos
    {eta deviation : ℝ} (shell : ℕ) (heta : 0 < eta) (hdeviation : 0 < deviation) :
    0 < pOneFournierGuillinShellWeight eta deviation shell := by
  unfold pOneFournierGuillinShellWeight
  apply mul_pos
  · apply mul_pos
    · exact pOneFournierGuillinShellCoefficient_pos heta
    · exact hdeviation
  · exact Real.rpow_pos_of_pos (by norm_num) _

/--
A concrete logarithmic shell cutoff for the large-deviation finite head.  Its
exponent is tuned so the source shell weight retains a square-root factor of
the target deviation.  This is a valid explicit alternative to the printed
log-log cutoff, with the same role in the finite-head rate argument.
-/
def pOneFournierGuillinHeadCutoff (eta deviation : ℝ) : ℕ :=
  Nat.ceil (Real.logb 2
    (Real.rpow deviation (-(1 / (2 * (1 + eta))))))

/--
The small-deviation radius at which the explicit finite-head cutoff is at
least a prescribed exponential-moment gate scale.  The gate scale is allowed
to depend on the underlying law; this radius is the corresponding source
``small x'' regime.
-/
def pOneFournierGuillinHeadGateRadius (eta : ℝ) (gateScale : ℕ) : ℝ :=
  Real.rpow ((2 : ℝ) ^ gateScale) (-(2 * (1 + eta)))

/--
Below the gate radius, the explicit finite-head cutoff is beyond any fixed
moment-driven shell gate.  This is the bridge that lets the finite `J_n` head
and the exponential-moment post-tail share one cutoff in a genuine
small-deviation regime.
-/
theorem pOneFournierGuillinGateScale_le_headCutoff_of_le_gateRadius
    {eta deviation : ℝ} (gateScale : ℕ) (heta : 0 < eta)
    (hdeviation_pos : 0 < deviation)
    (hdeviation_le : deviation ≤ pOneFournierGuillinHeadGateRadius eta gateScale) :
    gateScale ≤ pOneFournierGuillinHeadCutoff eta deviation := by
  let exponent : ℝ := 1 + eta
  let threshold : ℝ := Real.rpow deviation (-(1 / (2 * exponent)))
  let gateBase : ℝ := (2 : ℝ) ^ gateScale
  have hexponent_pos : 0 < exponent := by
    dsimp [exponent]
    linarith
  have hgateBase_pos : 0 < gateBase := by
    dsimp [gateBase]
    positivity
  have hgateRadius_pos : 0 < pOneFournierGuillinHeadGateRadius eta gateScale := by
    unfold pOneFournierGuillinHeadGateRadius
    exact Real.rpow_pos_of_pos (pow_pos (by norm_num) _) _
  have hthreshold_pos : 0 < threshold := by
    dsimp [threshold]
    exact Real.rpow_pos_of_pos hdeviation_pos _
  have hgatePower : gateBase ≤ threshold := by
    have hnonpos : -(1 / (2 * exponent)) ≤ 0 := by
      apply neg_nonpos.mpr
      positivity
    have hmono := Real.rpow_le_rpow_of_nonpos hdeviation_pos
      hdeviation_le hnonpos
    have hgateRadius_power :
        pOneFournierGuillinHeadGateRadius eta gateScale ^
          (-(1 / (2 * exponent))) = gateBase := by
      unfold pOneFournierGuillinHeadGateRadius
      dsimp [gateBase]
      calc
        (Real.rpow ((2 : ℝ) ^ gateScale) (-(2 * (1 + eta)))) ^
            (-(1 / (2 * exponent))) =
            Real.rpow ((2 : ℝ) ^ gateScale)
              (-(2 * (1 + eta)) * (-(1 / (2 * exponent)))) := by
          exact (Real.rpow_mul hgateBase_pos.le
            (-(2 * (1 + eta))) (-(1 / (2 * exponent)))).symm
        _ = Real.rpow ((2 : ℝ) ^ gateScale) 1 := by
          congr 1
          dsimp [exponent]
          field_simp [hexponent_pos.ne']
        _ = gateBase := by
          dsimp [gateBase]
          norm_num
    dsimp [threshold]
    rw [hgateRadius_power] at hmono
    exact hmono
  have hheadPower := AppliedModelingLib.Math.le_pow_natCeil_logb
    (base := (2 : ℝ)) (threshold := threshold) (by norm_num) hthreshold_pos
  have hcutoff_eq : pOneFournierGuillinHeadCutoff eta deviation =
      Nat.ceil (Real.logb 2 threshold) := by
    simp only [pOneFournierGuillinHeadCutoff]
    dsimp [threshold, exponent]
  have hpow : (2 : ℝ) ^ gateScale ≤
      (2 : ℝ) ^ pOneFournierGuillinHeadCutoff eta deviation := by
    exact (calc
      (2 : ℝ) ^ gateScale = gateBase := by rfl
      _ ≤ threshold := hgatePower
      _ ≤ (2 : ℝ) ^ Nat.ceil (Real.logb 2 threshold) := hheadPower
      _ = (2 : ℝ) ^ pOneFournierGuillinHeadCutoff eta deviation := by
        rw [hcutoff_eq])
  apply (Nat.pow_le_pow_iff_right (a := 2) (by norm_num)).mp
  exact_mod_cast hpow

/--
The concrete head cutoff converts the deviation's negative logarithm into a
linear shell-index budget.  This is the numerical bridge needed to make the
large-shell moment gate uniform over the small-deviation regime.
-/
theorem neg_log_deviation_le_two_mul_headCutoff_mul_log_two
    {eta deviation : ℝ} (heta : 0 < eta) (hdeviation_pos : 0 < deviation) :
    -Real.log deviation ≤ 2 * (1 + eta) *
      (pOneFournierGuillinHeadCutoff eta deviation : ℝ) * Real.log 2 := by
  let exponent : ℝ := 1 + eta
  let delta : ℝ := 1 / (2 * exponent)
  let threshold : ℝ := Real.rpow deviation (-delta)
  have hexponent_pos : 0 < exponent := by
    dsimp [exponent]
    linarith
  have hdelta_pos : 0 < delta := by
    dsimp [delta]
    positivity
  have hthreshold_pos : 0 < threshold := by
    dsimp [threshold]
    exact Real.rpow_pos_of_pos hdeviation_pos _
  have hheadPower := AppliedModelingLib.Math.le_pow_natCeil_logb
    (base := (2 : ℝ)) (threshold := threshold) (by norm_num) hthreshold_pos
  have hcutoff_eq : pOneFournierGuillinHeadCutoff eta deviation =
      Nat.ceil (Real.logb 2 threshold) := by
    simp only [pOneFournierGuillinHeadCutoff]
    dsimp [threshold, delta, exponent]
  have hpower : threshold ≤ (2 : ℝ) ^ pOneFournierGuillinHeadCutoff eta deviation := by
    calc
      threshold ≤ (2 : ℝ) ^ Nat.ceil (Real.logb 2 threshold) := hheadPower
      _ = (2 : ℝ) ^ pOneFournierGuillinHeadCutoff eta deviation := by
        rw [hcutoff_eq]
  have hlog := Real.log_le_log hthreshold_pos hpower
  have hpow_eq : (2 : ℝ) ^ pOneFournierGuillinHeadCutoff eta deviation =
      Real.rpow 2 (pOneFournierGuillinHeadCutoff eta deviation : ℝ) := by
    norm_num [Real.rpow_natCast]
  have hlog' : -delta * Real.log deviation ≤
      (pOneFournierGuillinHeadCutoff eta deviation : ℝ) * Real.log 2 := by
    calc
      -delta * Real.log deviation = Real.log threshold := by
        dsimp [threshold]
        exact (Real.log_rpow hdeviation_pos (-delta)).symm
      _ ≤ Real.log (Real.rpow 2
          (pOneFournierGuillinHeadCutoff eta deviation : ℝ)) := by
        rw [← hpow_eq]
        exact hlog
      _ = (pOneFournierGuillinHeadCutoff eta deviation : ℝ) * Real.log 2 :=
        Real.log_rpow (by norm_num) _
  have hscaled := mul_le_mul_of_nonneg_left hlog'
    (show 0 ≤ 2 * exponent by positivity)
  calc
    -Real.log deviation = (2 * exponent) * (-delta * Real.log deviation) := by
      dsimp [delta]
      field_simp [hexponent_pos.ne']
    _ ≤ (2 * exponent) *
        ((pOneFournierGuillinHeadCutoff eta deviation : ℝ) * Real.log 2) := hscaled
    _ = 2 * (1 + eta) *
        (pOneFournierGuillinHeadCutoff eta deviation : ℝ) * Real.log 2 := by
      dsimp [exponent]
      ring

/--
The concrete finite-head cutoff itself is strictly below twice its defining
deviation power.

Library provenance: this directly reuses Lean core's `Nat.lt_two_pow_self`
from
[`Init/Data/Nat/Lemmas.lean`](https://github.com/leanprover/lean4/blob/3dc1a088b6d2d8eafe25a7cd7ec7b58d731bd7cc/src/Init/Data/Nat/Lemmas.lean)
([official documentation](https://leanprover-community.github.io/mathlib4_docs/Init/Data/Nat/Lemmas)).
Lean core and the already credited logarithmic-cutoff Mathlib declarations
are Apache-2.0; no external Lean source is copied or ported.
-/
theorem pOneFournierGuillinHeadCutoff_lt_two_mul_rpow_neg
    {eta deviation : ℝ} (heta : 0 < eta) (hdeviation_pos : 0 < deviation)
    (hdeviation_le_one : deviation ≤ 1) :
    (pOneFournierGuillinHeadCutoff eta deviation : ℝ) <
      2 * Real.rpow deviation (-(1 / (2 * (1 + eta)))) := by
  let threshold : ℝ := Real.rpow deviation (-(1 / (2 * (1 + eta))))
  have hexponent_pos : 0 < 1 + eta := by linarith
  have hneg_exponent : -(1 / (2 * (1 + eta))) ≤ 0 := by
    apply neg_nonpos.mpr
    positivity
  have hthreshold_one : 1 ≤ threshold := by
    dsimp [threshold]
    calc
      1 = Real.rpow deviation 0 := (Real.rpow_zero deviation).symm
      _ ≤ Real.rpow deviation (-(1 / (2 * (1 + eta)))) :=
        Real.rpow_le_rpow_of_exponent_ge hdeviation_pos hdeviation_le_one
          hneg_exponent
  have hpower := AppliedModelingLib.Math.pow_natCeil_logb_lt_mul
    (base := (2 : ℝ)) (threshold := threshold) (by norm_num) hthreshold_one
  have hindex : (pOneFournierGuillinHeadCutoff eta deviation : ℝ) ≤
      (2 : ℝ) ^ pOneFournierGuillinHeadCutoff eta deviation := by
    norm_cast
    exact Nat.le_of_lt Nat.lt_two_pow_self
  have hcutoff_eq : pOneFournierGuillinHeadCutoff eta deviation =
      Nat.ceil (Real.logb 2 threshold) := by
    simp only [pOneFournierGuillinHeadCutoff]
    dsimp [threshold]
  calc
    (pOneFournierGuillinHeadCutoff eta deviation : ℝ) ≤
        (2 : ℝ) ^ pOneFournierGuillinHeadCutoff eta deviation := hindex
    _ < 2 * threshold := by
      rw [hcutoff_eq]
      exact hpower
    _ = 2 * Real.rpow deviation (-(1 / (2 * (1 + eta)))) := by
      dsimp [threshold]

/--
The logarithmic cutoff prefactor is exponentially absorbable whenever half of
the available rate dominates twice the inverse square-root deviation.  This
isolates the elementary numerical condition that will later be derived from a
source sample-size lower bound.
-/
theorem two_mul_pOneFournierGuillinHeadPower_le_exp_of_two_mul_rpow_neg_half_le
    {eta deviation allowance : ℝ} (heta : 0 < eta) (hdeviation_pos : 0 < deviation)
    (hdeviation_le_one : deviation ≤ 1)
    (hallowance : 2 * Real.rpow deviation (-(1 / 2)) ≤ allowance) :
    2 * Real.rpow deviation (-(1 / (2 * (1 + eta)))) ≤ Real.exp allowance := by
  have hdenom_pos : 0 < 2 * (1 + eta) := by positivity
  have hdelta_le_half : 1 / (2 * (1 + eta)) ≤ (1 / 2 : ℝ) := by
    apply (div_le_iff₀ hdenom_pos).mpr
    nlinarith
  have hpower : Real.rpow deviation (-(1 / (2 * (1 + eta)))) ≤
      Real.rpow deviation (-(1 / 2)) := by
    apply Real.rpow_le_rpow_of_exponent_ge hdeviation_pos hdeviation_le_one
    linarith
  have hinv_nonneg : 0 ≤ Real.rpow deviation (-(1 / 2)) :=
    (Real.rpow_pos_of_pos hdeviation_pos _).le
  have hlinear : 2 * Real.rpow deviation (-(1 / 2)) ≤
      Real.exp (2 * Real.rpow deviation (-(1 / 2))) := by
    have hexp := Real.add_one_le_exp (2 * Real.rpow deviation (-(1 / 2)))
    linarith
  calc
    2 * Real.rpow deviation (-(1 / (2 * (1 + eta)))) ≤
        2 * Real.rpow deviation (-(1 / 2)) :=
      mul_le_mul_of_nonneg_left hpower (by norm_num)
    _ ≤ Real.exp (2 * Real.rpow deviation (-(1 / 2))) := hlinear
    _ ≤ Real.exp allowance := Real.exp_le_exp.mpr hallowance

/--
A source-shaped quadratic sample-rate lower bound supplies the
inverse-square-root condition needed to absorb the finite `J_n` head.  This
is the exact algebraic `deviation^2` to `deviation^(3/2)` conversion, with no
asymptotic notation or omitted coefficient.
-/
theorem two_mul_rpow_neg_half_le_pOneFournierGuillinHeadRate_half_of_squareRate
    (count : ℕ) {eta deviation : ℝ} (hdeviation_pos : 0 < deviation)
    (hsquare : 1 ≤ (count : ℝ) * pOneFournierGuillinShellCoefficient eta *
      Real.rpow 2 (-(1 + eta)) * deviation ^ 2 * Real.log 9 / 8) :
    2 * Real.rpow deviation (-(1 / 2)) ≤
      ((count : ℝ) * pOneFournierGuillinShellCoefficient eta * deviation *
        (Real.rpow 2 (-(1 + eta)) * Real.sqrt deviation) * Real.log 9 / 2) / 2 := by
  have hinv_nonneg : 0 ≤ 2 * Real.rpow deviation (-(1 / 2)) := by
    exact mul_nonneg (by norm_num) (Real.rpow_pos_of_pos hdeviation_pos _).le
  have hscaled := mul_le_mul_of_nonneg_left hsquare hinv_nonneg
  have hpower : Real.rpow deviation (-(1 / 2)) * deviation ^ 2 =
      deviation * Real.sqrt deviation := by
    calc
      Real.rpow deviation (-(1 / 2)) * deviation ^ 2 =
          Real.rpow deviation (-(1 / 2)) * Real.rpow deviation (2 : ℝ) := by
        norm_num [Real.rpow_natCast]
      _ = Real.rpow deviation ((-(1 / 2)) + 2) :=
        (Real.rpow_add hdeviation_pos (-(1 / 2)) (2 : ℝ)).symm
      _ = Real.rpow deviation (1 + (1 / 2 : ℝ)) := by
        congr 1
        ring
      _ = Real.rpow deviation 1 * Real.rpow deviation (1 / 2 : ℝ) :=
        Real.rpow_add hdeviation_pos 1 (1 / 2)
      _ = deviation * Real.sqrt deviation := by
        norm_num [Real.sqrt_eq_rpow]
  calc
    2 * Real.rpow deviation (-(1 / 2)) =
        (2 * Real.rpow deviation (-(1 / 2))) * 1 := by ring
    _ ≤ (2 * Real.rpow deviation (-(1 / 2))) *
        ((count : ℝ) * pOneFournierGuillinShellCoefficient eta *
          Real.rpow 2 (-(1 + eta)) * deviation ^ 2 * Real.log 9 / 8) := hscaled
    _ = ((count : ℝ) * pOneFournierGuillinShellCoefficient eta *
        Real.rpow 2 (-(1 + eta)) * Real.log 9 / 4) *
          (Real.rpow deviation (-(1 / 2)) * deviation ^ 2) := by ring
    _ = ((count : ℝ) * pOneFournierGuillinShellCoefficient eta * deviation *
        (Real.rpow 2 (-(1 + eta)) * Real.sqrt deviation) * Real.log 9 / 2) / 2 := by
      rw [hpower]
      ring

/--
At the concrete finite-head cutoff, the dyadic shell-weight decay is at least
its first-scale factor times `sqrt deviation`.  This is the quantitative
replacement for the source's intermediate `n_1` lower bound.
-/
theorem pOneFournierGuillinHeadCutoff_decay_lower
    {eta deviation : ℝ} (heta : 0 < eta) (hdeviation_pos : 0 < deviation)
    (hdeviation_le_one : deviation ≤ 1) :
    Real.rpow 2 (-((1 + eta) *
      (pOneFournierGuillinHeadCutoff eta deviation : ℝ))) ≥
      Real.rpow 2 (-(1 + eta)) * Real.sqrt deviation := by
  let exponent : ℝ := 1 + eta
  let threshold : ℝ := Real.rpow deviation (-(1 / (2 * exponent)))
  have hexponent_pos : 0 < exponent := by
    dsimp [exponent]
    linarith
  have hdelta_pos : 0 < 1 / (2 * exponent) := by positivity
  have hthreshold_one : 1 ≤ threshold := by
    dsimp [threshold]
    calc
      1 = Real.rpow deviation 0 := (Real.rpow_zero deviation).symm
      _ ≤ Real.rpow deviation (-(1 / (2 * exponent))) :=
        Real.rpow_le_rpow_of_exponent_ge hdeviation_pos hdeviation_le_one
          (by linarith)
  have hcutoff := AppliedModelingLib.Math.mul_rpow_neg_le_rpow_neg_mul_natCeil_logb
    (base := (2 : ℝ)) (threshold := threshold) (exponent := exponent)
    (by norm_num) hthreshold_one hexponent_pos.le
  have hthreshold_power : threshold ^ (-exponent) = Real.sqrt deviation := by
    dsimp [threshold]
    calc
      (Real.rpow deviation (-(1 / (2 * exponent)))) ^ (-exponent) =
          Real.rpow deviation (-(1 / (2 * exponent)) * (-exponent)) := by
        exact (Real.rpow_mul hdeviation_pos.le
          (-(1 / (2 * exponent))) (-exponent)).symm
      _ = Real.rpow deviation (1 / 2) := by
        congr 1
        field_simp [hexponent_pos.ne']
      _ = Real.sqrt deviation := (Real.sqrt_eq_rpow deviation).symm
  rw [hthreshold_power] at hcutoff
  calc
    Real.rpow 2 (-(1 + eta)) * Real.sqrt deviation =
        Real.rpow 2 (-exponent) * Real.sqrt deviation := by
      congr 1
    _ ≤ Real.rpow 2 (-exponent *
        ((Nat.ceil (Real.logb 2 threshold) : ℕ) : ℝ)) := hcutoff
    _ = Real.rpow 2 (-((1 + eta) *
        (pOneFournierGuillinHeadCutoff eta deviation : ℝ))) := by
      simp only [pOneFournierGuillinHeadCutoff]
      dsimp [exponent, threshold]
      congr 1
      ring

/--
The explicit finite-head cutoff leaves a quantitative shell-mass allocation:
the target deviation retains a square-root factor after the dyadic decay.
-/
theorem pOneFournierGuillinShellWeight_headCutoff_lower
    {eta deviation : ℝ} (heta : 0 < eta) (hdeviation_pos : 0 < deviation)
    (hdeviation_le_one : deviation ≤ 1) :
    pOneFournierGuillinShellCoefficient eta * deviation *
        (Real.rpow 2 (-(1 + eta)) * Real.sqrt deviation) ≤
      pOneFournierGuillinShellWeight eta deviation
        (pOneFournierGuillinHeadCutoff eta deviation) := by
  have hfactor_nonneg : 0 ≤ pOneFournierGuillinShellCoefficient eta * deviation := by
    exact (mul_pos (pOneFournierGuillinShellCoefficient_pos heta) hdeviation_pos).le
  have hdecay := pOneFournierGuillinHeadCutoff_decay_lower
    heta hdeviation_pos hdeviation_le_one
  calc
    pOneFournierGuillinShellCoefficient eta * deviation *
        (Real.rpow 2 (-(1 + eta)) * Real.sqrt deviation) =
        (pOneFournierGuillinShellCoefficient eta * deviation) *
          (Real.rpow 2 (-(1 + eta)) * Real.sqrt deviation) := by ring
    _ ≤ (pOneFournierGuillinShellCoefficient eta * deviation) *
          Real.rpow 2 (-((1 + eta) *
            (pOneFournierGuillinHeadCutoff eta deviation : ℝ))) :=
      mul_le_mul_of_nonneg_left hdecay hfactor_nonneg
    _ = pOneFournierGuillinShellWeight eta deviation
        (pOneFournierGuillinHeadCutoff eta deviation) := by
      rfl

/-- The canonical source exponent produces positive shell weights. -/
theorem pOneFournierGuillinAdmissibleEta_shellWeight_pos
    {alpha deviation : ℝ} (shell : ℕ) (halpha : 1 < alpha) (hdeviation : 0 < deviation) :
    0 < pOneFournierGuillinShellWeight
      (pOneFournierGuillinAdmissibleEta alpha) deviation shell := by
  exact pOneFournierGuillinShellWeight_pos shell
    (pOneFournierGuillinAdmissibleEta_spec halpha).1 hdeviation

/--
When the source allocation has `eta ≤ 1`, the fifth-order shell envelope
still leaves at least one growing dyadic factor after the squared relative
tolerance is inserted.  This is the numerical core of the `I_n` allocation.

Library provenance: this directly reuses Mathlib's `Real.rpow_natCast`,
`Real.rpow_add`, `Real.rpow_mul_natCast`, and
`Real.rpow_le_rpow_of_exponent_le` from
[`Analysis/SpecialFunctions/Pow/Real.lean`](https://github.com/leanprover-community/mathlib4/blob/5450b53e5ddc75d46418fabb605edbf36bd0beb6/Mathlib/Analysis/SpecialFunctions/Pow/Real.lean)
([official documentation](https://leanprover-community.github.io/mathlib4_docs/Mathlib/Analysis/SpecialFunctions/Pow/Real.html)),
at the pinned Apache-2.0 Mathlib commit. No external Lean source is copied or
ported.
-/
theorem two_pow_le_pOneFournierGuillin_etaDecay_sq_mul_fifth
    {eta : ℝ} (shell : ℕ) (heta_le_one : eta ≤ 1) :
    (2 : ℝ) ^ shell ≤
      Real.rpow 2 (-((1 + eta) * (shell : ℝ))) ^ 2 * (2 : ℝ) ^ (5 * shell) := by
  have hshell_nonneg : 0 ≤ (shell : ℝ) := Nat.cast_nonneg _
  have hfactor : 1 ≤ 3 - 2 * eta := by linarith
  have hexponent : (shell : ℝ) ≤ (3 - 2 * eta) * (shell : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right hfactor hshell_nonneg
  calc
    (2 : ℝ) ^ shell = Real.rpow 2 (shell : ℝ) := (Real.rpow_natCast 2 shell).symm
    _ ≤ Real.rpow 2 ((3 - 2 * eta) * (shell : ℝ)) :=
      Real.rpow_le_rpow_of_exponent_le (by norm_num) hexponent
    _ = Real.rpow 2 (-((1 + eta) * (shell : ℝ)) * 2 +
        ((5 * shell : ℕ) : ℝ)) := by
      congr 1
      push_cast
      ring
    _ = Real.rpow 2 (-((1 + eta) * (shell : ℝ)) * 2) *
        Real.rpow 2 ((5 * shell : ℕ) : ℝ) := by
      exact Real.rpow_add (by norm_num) _ _
    _ = Real.rpow 2 (-((1 + eta) * (shell : ℝ))) ^ 2 * (2 : ℝ) ^ (5 * shell) := by
      congr 1
      · convert Real.rpow_mul_natCast (by norm_num : (0 : ℝ) ≤ 2)
          (-((1 + eta) * (shell : ℝ))) 2 using 1
      · exact Real.rpow_natCast 2 (5 * shell)

/-- The radius of a dyadic source cube has the expected radial power. -/
theorem euclideanDyadicCubeRadius_rpow_eq_rpow_pow
    (alpha : ℝ) (shell : ℕ) :
    Real.rpow (euclideanDyadicCubeRadius shell) alpha =
      Real.rpow 2 alpha ^ shell := by
  unfold euclideanDyadicCubeRadius
  rw [Nat.cast_pow]
  calc
    Real.rpow ((2 : ℝ) ^ shell) alpha =
        (Real.rpow 2 alpha) ^ shell :=
      by
        simpa only [Real.rpow_eq_pow] using
          (Real.rpow_pow_comm (by norm_num : (0 : ℝ) ≤ 2) alpha shell).symm
    _ = Real.rpow 2 (alpha * (shell : ℝ)) :=
      by
        simpa only [Real.rpow_eq_pow] using
          (Real.rpow_mul_natCast (by norm_num : (0 : ℝ) ≤ 2) alpha shell).symm
    _ = Real.rpow 2 alpha ^ shell := by
      simpa only [Real.rpow_eq_pow] using
        Real.rpow_mul_natCast (by norm_num : (0 : ℝ) ≤ 2) alpha shell

/--
The moment contribution to a parameterized source shell has the geometric
base `2^(alpha - 1 - eta)` that governs the post-cutoff `J_n` sum.
-/
theorem pOneFournierGuillinShellWeight_mul_euclideanDyadicCubeRadius_rpow
    (eta deviation alpha : ℝ) (shell : ℕ) :
    pOneFournierGuillinShellWeight eta deviation shell *
      Real.rpow (euclideanDyadicCubeRadius shell) alpha =
        pOneFournierGuillinShellCoefficient eta * deviation *
          Real.rpow 2 (alpha - 1 - eta) ^ shell := by
  have hradial : Real.rpow ((2 : ℝ) ^ shell) alpha =
      Real.rpow 2 ((shell : ℝ) * alpha) := by
    calc
      Real.rpow ((2 : ℝ) ^ shell) alpha =
          (Real.rpow 2 alpha) ^ shell :=
        by
          simpa only [Real.rpow_eq_pow] using
            (Real.rpow_pow_comm (by norm_num : (0 : ℝ) ≤ 2) alpha shell).symm
      _ = Real.rpow 2 (alpha * (shell : ℝ)) :=
        by
          simpa only [Real.rpow_eq_pow] using
            (Real.rpow_mul_natCast (by norm_num : (0 : ℝ) ≤ 2) alpha shell).symm
      _ = Real.rpow 2 ((shell : ℝ) * alpha) := by
        congr 1
        ring
  have hadd : Real.rpow 2 (-((1 + eta) * (shell : ℝ))) *
      Real.rpow 2 ((shell : ℝ) * alpha) =
        Real.rpow 2 ((alpha - 1 - eta) * (shell : ℝ)) := by
    calc
      Real.rpow 2 (-((1 + eta) * (shell : ℝ))) *
          Real.rpow 2 ((shell : ℝ) * alpha) =
          Real.rpow 2 (-((1 + eta) * (shell : ℝ)) + (shell : ℝ) * alpha) := by
        simpa only [Real.rpow_eq_pow] using
          (Real.rpow_add (by norm_num : (0 : ℝ) < 2)
            (-((1 + eta) * (shell : ℝ))) ((shell : ℝ) * alpha)).symm
      _ = Real.rpow 2 ((alpha - 1 - eta) * (shell : ℝ)) := by
        congr 1
        ring
  have hpow : Real.rpow 2 ((alpha - 1 - eta) * (shell : ℝ)) =
      Real.rpow 2 (alpha - 1 - eta) ^ shell := by
    simpa only [Real.rpow_eq_pow] using
      Real.rpow_mul_natCast (by norm_num : (0 : ℝ) ≤ 2)
        (alpha - 1 - eta) shell
  unfold pOneFournierGuillinShellWeight euclideanDyadicCubeRadius
  rw [Nat.cast_pow]
  calc
    (pOneFournierGuillinShellCoefficient eta * deviation *
        Real.rpow 2 (-((1 + eta) * (shell : ℝ)))) *
        Real.rpow ((2 : ℝ) ^ shell) alpha =
        pOneFournierGuillinShellCoefficient eta * deviation *
          (Real.rpow 2 (-((1 + eta) * (shell : ℝ))) *
            Real.rpow 2 ((shell : ℝ) * alpha)) := by
      rw [hradial]
      ring
    _ = pOneFournierGuillinShellCoefficient eta * deviation *
        Real.rpow 2 ((alpha - 1 - eta) * (shell : ℝ)) := by
      rw [hadd]
    _ = pOneFournierGuillinShellCoefficient eta * deviation *
        Real.rpow 2 (alpha - 1 - eta) ^ shell := by rw [hpow]

/--
The p-one shell allocation spends exactly one target-deviation unit after the
dyadic transport radius is restored.  This is the deterministic mass-error
budget in the source shell coupling; its geometric normalization is explicit.
-/
theorem tsum_pOneFournierGuillinShellWeight_mul_euclideanDyadicCubeRadius
    (dimension : ℕ) {eta deviation : ℝ} (heta_pos : 0 < eta) :
    ∑' shell : ℕ,
      pOneFournierGuillinShellWeight eta deviation shell *
        (Real.sqrt dimension * euclideanDyadicCubeRadius shell) =
      Real.sqrt dimension * deviation := by
  let ratio : ℝ := Real.rpow 2 (-eta)
  have hratio_pos : 0 < ratio := by
    dsimp [ratio]
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hratio_lt_one : ratio < 1 := by
    dsimp [ratio]
    exact Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (neg_lt_zero.mpr heta_pos)
  have hratio_norm : ‖ratio‖ < 1 := by
    rw [Real.norm_eq_abs, abs_of_pos hratio_pos]
    exact hratio_lt_one
  have hsum : ∑' shell : ℕ, ratio ^ shell = (1 - ratio)⁻¹ :=
    tsum_geometric_of_norm_lt_one hratio_norm
  have hterm : ∀ shell : ℕ,
      pOneFournierGuillinShellWeight eta deviation shell *
          (Real.sqrt dimension * euclideanDyadicCubeRadius shell) =
        (Real.sqrt dimension * deviation * pOneFournierGuillinShellCoefficient eta) *
          ratio ^ shell := by
    intro shell
    have hweight := pOneFournierGuillinShellWeight_mul_euclideanDyadicCubeRadius_rpow
      eta deviation 1 shell
    calc
      pOneFournierGuillinShellWeight eta deviation shell *
          (Real.sqrt dimension * euclideanDyadicCubeRadius shell) =
          Real.sqrt dimension *
            (pOneFournierGuillinShellWeight eta deviation shell *
              Real.rpow (euclideanDyadicCubeRadius shell) 1) := by
            have hrpow_one : Real.rpow (euclideanDyadicCubeRadius shell) (1 : ℝ) =
                euclideanDyadicCubeRadius shell := by
              simpa only using Real.rpow_one (euclideanDyadicCubeRadius shell)
            rw [hrpow_one]
            ring
      _ = Real.sqrt dimension *
          (pOneFournierGuillinShellCoefficient eta * deviation *
            Real.rpow 2 (1 - 1 - eta) ^ shell) := by rw [hweight]
      _ = (Real.sqrt dimension * deviation * pOneFournierGuillinShellCoefficient eta) *
          ratio ^ shell := by
            dsimp [ratio]
            ring
  calc
    ∑' shell : ℕ,
        pOneFournierGuillinShellWeight eta deviation shell *
          (Real.sqrt dimension * euclideanDyadicCubeRadius shell) =
        ∑' shell : ℕ,
          (Real.sqrt dimension * deviation * pOneFournierGuillinShellCoefficient eta) *
            ratio ^ shell := by
          apply tsum_congr
          exact hterm
    _ = (Real.sqrt dimension * deviation * pOneFournierGuillinShellCoefficient eta) *
          (∑' shell : ℕ, ratio ^ shell) := by rw [tsum_mul_left]
    _ = (Real.sqrt dimension * deviation * pOneFournierGuillinShellCoefficient eta) *
          (1 - ratio)⁻¹ := by rw [hsum]
    _ = Real.sqrt dimension * deviation := by
      have hnonzero : 1 - ratio ≠ 0 := sub_ne_zero.mpr (ne_of_gt hratio_lt_one)
      have hcancel : (1 - ratio) * (1 - ratio)⁻¹ = 1 :=
        mul_inv_cancel₀ hnonzero
      unfold pOneFournierGuillinShellCoefficient
      dsimp [ratio]
      calc
        Real.sqrt dimension * deviation * (1 - Real.rpow 2 (-eta)) *
            (1 - Real.rpow 2 (-eta))⁻¹ =
            Real.sqrt dimension * deviation *
              ((1 - Real.rpow 2 (-eta)) * (1 - Real.rpow 2 (-eta))⁻¹) := by ring
        _ = Real.sqrt dimension * deviation := by rw [hcancel]; ring

/--
The logarithm of a positive parameterized shell weight is affine in the shell
index.  This is the numerical term that the radial exponential moment must
eventually dominate in the source's `J_n` cutoff.
-/
theorem log_pOneFournierGuillinShellWeight
    {eta deviation : ℝ} (shell : ℕ)
    (heta_pos : 0 < eta) (hdeviation_pos : 0 < deviation) :
    Real.log (pOneFournierGuillinShellWeight eta deviation shell) =
      Real.log (pOneFournierGuillinShellCoefficient eta * deviation) -
        (1 + eta) * (shell : ℝ) * Real.log 2 := by
  have hcoefficient_pos : 0 < pOneFournierGuillinShellCoefficient eta :=
    pOneFournierGuillinShellCoefficient_pos heta_pos
  have hproduct_ne : pOneFournierGuillinShellCoefficient eta * deviation ≠ 0 :=
    mul_ne_zero hcoefficient_pos.ne' hdeviation_pos.ne'
  have hrpow_ne : Real.rpow 2 (-((1 + eta) * (shell : ℝ))) ≠ 0 := by
    rw [Real.rpow_eq_pow]
    exact (Real.rpow_pos_of_pos (by norm_num) _).ne'
  unfold pOneFournierGuillinShellWeight
  calc
    Real.log (pOneFournierGuillinShellCoefficient eta * deviation *
        Real.rpow 2 (-((1 + eta) * (shell : ℝ)))) =
        Real.log (pOneFournierGuillinShellCoefficient eta * deviation) +
          Real.log (Real.rpow 2 (-((1 + eta) * (shell : ℝ)))) := by
      exact Real.log_mul hproduct_ne hrpow_ne
    _ = Real.log (pOneFournierGuillinShellCoefficient eta * deviation) +
        (-((1 + eta) * (shell : ℝ))) * Real.log 2 := by
      rw [Real.rpow_eq_pow, Real.log_rpow (by norm_num : (0 : ℝ) < 2)]
    _ = Real.log (pOneFournierGuillinShellCoefficient eta * deviation) -
        (1 + eta) * (shell : ℝ) * Real.log 2 := by ring

/-- Positive source shell weights decrease with the dyadic shell index. -/
theorem pOneFournierGuillinShellWeight_le_of_le
    {eta deviation : ℝ} {lower upper : ℕ}
    (heta_pos : 0 < eta) (hdeviation_pos : 0 < deviation)
    (hle : lower ≤ upper) :
    pOneFournierGuillinShellWeight eta deviation upper ≤
      pOneFournierGuillinShellWeight eta deviation lower := by
  have hfactor_pos : 0 < pOneFournierGuillinShellCoefficient eta * deviation :=
    mul_pos (pOneFournierGuillinShellCoefficient_pos heta_pos) hdeviation_pos
  have hcast : (lower : ℝ) ≤ (upper : ℝ) := by exact_mod_cast hle
  have heta_one_nonneg : 0 ≤ 1 + eta := by linarith
  have hforward : (1 + eta) * (lower : ℝ) ≤ (1 + eta) * (upper : ℝ) :=
    mul_le_mul_of_nonneg_left hcast heta_one_nonneg
  have hexponent : -((1 + eta) * (upper : ℝ)) ≤ -((1 + eta) * (lower : ℝ)) :=
    neg_le_neg hforward
  have hrpow : Real.rpow 2 (-((1 + eta) * (upper : ℝ))) ≤
      Real.rpow 2 (-((1 + eta) * (lower : ℝ)) ) := by
    simpa only [Real.rpow_eq_pow] using
      Real.rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2) hexponent
  unfold pOneFournierGuillinShellWeight
  exact mul_le_mul_of_nonneg_left hrpow hfactor_pos.le

/-- The relative shell tolerance corresponding to the source's `eta` weight. -/
def pOneFournierGuillinShellToleranceWithEta
    (eta deviation shellMass : ℝ) (shell : ℕ) : ℝ :=
  pOneFournierGuillinShellWeight eta deviation shell / shellMass

/--
Shifting a source shell from `scale` to `scale + 1` is exactly equivalent to
scaling the deviation parameter by one geometric source-allocation factor.
This identity keeps the all-shell convention aligned with the noncentral
offset convention used by the original shell-union estimates.
-/
theorem pOneFournierGuillinShellToleranceWithEta_succ_eq_scaled
    (eta deviation shellMass : ℝ) (scale : ℕ) :
    pOneFournierGuillinShellToleranceWithEta eta deviation shellMass (scale + 1) =
      pOneFournierGuillinShellToleranceWithEta eta
        (deviation * Real.rpow 2 (-(1 + eta))) shellMass scale := by
  unfold pOneFournierGuillinShellToleranceWithEta pOneFournierGuillinShellWeight
  have hexponent : -((1 + eta) * ((scale + 1 : ℕ) : ℝ)) =
      -(1 + eta) + (-((1 + eta) * (scale : ℝ))) := by
    norm_num
    ring
  rw [hexponent]
  have hrpow : Real.rpow 2 (-(1 + eta) + (-((1 + eta) * (scale : ℝ)))) =
      Real.rpow 2 (-(1 + eta)) * Real.rpow 2 (-((1 + eta) * (scale : ℝ))) := by
    exact Real.rpow_add (by norm_num) _ _
  rw [hrpow]
  ring

/--
On every source shell, the realized mass-error contribution is bounded by its
p-one allocation weight.  Summing after the transport-radius factor therefore
costs at most `sqrt dimension * deviation`, including population-null shells.
-/
theorem tsum_pOneFournierGuillin_relativeMassBudget_mul_euclideanDyadicCubeRadius_le
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    {eta deviation : ℝ} (heta_pos : 0 < eta) (hdeviation_nonneg : 0 ≤ deviation) :
    (∑' shell : ℕ,
      ENNReal.ofReal
        ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell) *
          pOneFournierGuillinShellToleranceWithEta eta deviation
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) shell) *
        ENNReal.ofReal (Real.sqrt dimension * euclideanDyadicCubeRadius shell)) ≤
      ENNReal.ofReal (Real.sqrt dimension * deviation) := by
  have hweight_nonneg : ∀ shell : ℕ,
      0 ≤ pOneFournierGuillinShellWeight eta deviation shell := by
    intro shell
    unfold pOneFournierGuillinShellWeight
    exact mul_nonneg
      (mul_nonneg (pOneFournierGuillinShellCoefficient_pos heta_pos).le hdeviation_nonneg)
      (Real.rpow_pos_of_pos (by norm_num) _).le
  have hscale_nonneg : ∀ shell : ℕ,
      0 ≤ Real.sqrt dimension * euclideanDyadicCubeRadius shell := by
    intro shell
    exact mul_nonneg (Real.sqrt_nonneg _) (euclideanDyadicCubeRadius_pos shell).le
  have hrelative : ∀ shell : ℕ,
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell) *
          pOneFournierGuillinShellToleranceWithEta eta deviation
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) shell) ≤
        pOneFournierGuillinShellWeight eta deviation shell := by
    intro shell
    let mass : ℝ := (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
      (euclideanDyadicCubeShell dimension shell)
    let weight : ℝ := pOneFournierGuillinShellWeight eta deviation shell
    change mass * (weight / mass) ≤ weight
    by_cases hmass : mass = 0
    · simp only [hmass]
      simpa [weight] using hweight_nonneg shell
    · have heq : mass * (weight / mass) = weight := by
        calc
          mass * (weight / mass) = weight * (mass * mass⁻¹) := by
            rw [div_eq_mul_inv]
            ring
          _ = weight := by rw [mul_inv_cancel₀ hmass, mul_one]
      exact heq.le
  have hrelative_nonneg : ∀ shell : ℕ,
      0 ≤ (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell) *
          pOneFournierGuillinShellToleranceWithEta eta deviation
            ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell)) shell := by
    intro shell
    unfold pOneFournierGuillinShellToleranceWithEta
    exact mul_nonneg measureReal_nonneg
      (div_nonneg (hweight_nonneg shell) measureReal_nonneg)
  have hterm_nonneg : ∀ shell : ℕ,
      0 ≤ pOneFournierGuillinShellWeight eta deviation shell *
        (Real.sqrt dimension * euclideanDyadicCubeRadius shell) := by
    intro shell
    exact mul_nonneg (hweight_nonneg shell) (hscale_nonneg shell)
  have hterm_summable : Summable (fun shell : ℕ =>
      pOneFournierGuillinShellWeight eta deviation shell *
        (Real.sqrt dimension * euclideanDyadicCubeRadius shell)) := by
    let ratio : ℝ := Real.rpow 2 (-eta)
    have hratio_pos : 0 < ratio := by
      dsimp [ratio]
      exact Real.rpow_pos_of_pos (by norm_num) _
    have hratio_lt_one : ratio < 1 := by
      dsimp [ratio]
      exact Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (neg_lt_zero.mpr heta_pos)
    have hratio_norm : ‖ratio‖ < 1 := by
      rw [Real.norm_eq_abs, abs_of_pos hratio_pos]
      exact hratio_lt_one
    have hgeometric : Summable (fun shell : ℕ => ratio ^ shell) :=
      summable_geometric_of_norm_lt_one hratio_norm
    have hfunction : (fun shell : ℕ =>
        pOneFournierGuillinShellWeight eta deviation shell *
          (Real.sqrt dimension * euclideanDyadicCubeRadius shell)) =
        fun shell : ℕ =>
          (Real.sqrt dimension * deviation * pOneFournierGuillinShellCoefficient eta) *
            ratio ^ shell := by
      funext shell
      have hweight := pOneFournierGuillinShellWeight_mul_euclideanDyadicCubeRadius_rpow
        eta deviation 1 shell
      have hrpow_one : Real.rpow (euclideanDyadicCubeRadius shell) (1 : ℝ) =
          euclideanDyadicCubeRadius shell := by
        simpa only using Real.rpow_one (euclideanDyadicCubeRadius shell)
      rw [hrpow_one] at hweight
      calc
        pOneFournierGuillinShellWeight eta deviation shell *
            (Real.sqrt dimension * euclideanDyadicCubeRadius shell) =
            Real.sqrt dimension *
              (pOneFournierGuillinShellWeight eta deviation shell *
                euclideanDyadicCubeRadius shell) := by ring
        _ = Real.sqrt dimension *
            (pOneFournierGuillinShellCoefficient eta * deviation *
              Real.rpow 2 (1 - 1 - eta) ^ shell) := by rw [hweight]
        _ = (Real.sqrt dimension * deviation * pOneFournierGuillinShellCoefficient eta) *
            ratio ^ shell := by
              dsimp [ratio]
              ring
    rw [hfunction]
    exact hgeometric.mul_left _
  calc
    (∑' shell : ℕ,
        ENNReal.ofReal
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell) *
            pOneFournierGuillinShellToleranceWithEta eta deviation
              ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
                (euclideanDyadicCubeShell dimension shell)) shell) *
          ENNReal.ofReal (Real.sqrt dimension * euclideanDyadicCubeRadius shell)) ≤
        ∑' shell : ℕ,
          ENNReal.ofReal
            (pOneFournierGuillinShellWeight eta deviation shell *
              (Real.sqrt dimension * euclideanDyadicCubeRadius shell)) := by
      apply ENNReal.tsum_le_tsum
      intro shell
      rw [← ENNReal.ofReal_mul (hrelative_nonneg shell)]
      exact ENNReal.ofReal_le_ofReal
        (mul_le_mul_of_nonneg_right (hrelative shell) (hscale_nonneg shell))
    _ = ENNReal.ofReal (∑' shell : ℕ,
          pOneFournierGuillinShellWeight eta deviation shell *
            (Real.sqrt dimension * euclideanDyadicCubeRadius shell)) := by
      symm
      exact ENNReal.ofReal_tsum_of_nonneg hterm_nonneg hterm_summable
    _ = ENNReal.ofReal (Real.sqrt dimension * deviation) := by
      rw [tsum_pOneFournierGuillinShellWeight_mul_euclideanDyadicCubeRadius
        dimension heta_pos]

/-- The parameterized source tolerance cancels the positive shell mass. -/
theorem shellMass_mul_pOneFournierGuillinShellToleranceWithEta
    {eta deviation shellMass : ℝ} (shell : ℕ) (hshellMass_pos : 0 < shellMass) :
    shellMass * pOneFournierGuillinShellToleranceWithEta eta deviation shellMass shell =
      pOneFournierGuillinShellWeight eta deviation shell := by
  unfold pOneFournierGuillinShellToleranceWithEta
  field_simp [hshellMass_pos.ne']

/--
The fifth-order source shell-mass envelope gives a growing dyadic quadratic
rate for every parameterized allocation with `eta ≤ 1`.  This is the
source's `I_n` exponent before its probability bound is applied.
-/
theorem pOneFournierGuillinShellToleranceWithEta_quadraticExponent_lower
    {eta deviation shellMass massConstant : ℝ} (shell : ℕ)
    (heta_le_one : eta ≤ 1)
    (hshellMass_pos : 0 < shellMass) (hmassConstant_pos : 0 < massConstant)
    (hshellMass : shellMass ≤ massConstant / (2 : ℝ) ^ (5 * shell)) :
    pOneFournierGuillinShellCoefficient eta ^ 2 * deviation ^ 2 * (2 : ℝ) ^ shell /
        (4 * massConstant) ≤
      shellMass *
        (pOneFournierGuillinShellToleranceWithEta eta deviation shellMass shell ^ 2 / 4) := by
  let coefficient := pOneFournierGuillinShellCoefficient eta
  let decay := Real.rpow 2 (-((1 + eta) * (shell : ℝ)))
  let weight := pOneFournierGuillinShellWeight eta deviation shell
  have htwo_fifth_pos : 0 < (2 : ℝ) ^ (5 * shell) := pow_pos (by norm_num) _
  have hmass_scaled : shellMass * (2 : ℝ) ^ (5 * shell) ≤ massConstant := by
    apply (le_div_iff₀ htwo_fifth_pos).mp
    exact hshellMass
  have hinv : (2 : ℝ) ^ (5 * shell) / massConstant ≤ 1 / shellMass := by
    apply (div_le_div_iff₀ hmassConstant_pos hshellMass_pos).mpr
    simpa [mul_comm] using hmass_scaled
  have hdecay : (2 : ℝ) ^ shell ≤ decay ^ 2 * (2 : ℝ) ^ (5 * shell) := by
    simpa [decay] using
      (two_pow_le_pOneFournierGuillin_etaDecay_sq_mul_fifth shell heta_le_one)
  have hcoefficient_deviation_nonneg : 0 ≤ coefficient ^ 2 * deviation ^ 2 := by positivity
  have hweight_scale : coefficient ^ 2 * deviation ^ 2 * (2 : ℝ) ^ shell ≤
      weight ^ 2 * (2 : ℝ) ^ (5 * shell) := by
    calc
      coefficient ^ 2 * deviation ^ 2 * (2 : ℝ) ^ shell ≤
          (coefficient ^ 2 * deviation ^ 2) *
            (decay ^ 2 * (2 : ℝ) ^ (5 * shell)) :=
        mul_le_mul_of_nonneg_left hdecay hcoefficient_deviation_nonneg
      _ = weight ^ 2 * (2 : ℝ) ^ (5 * shell) := by
        dsimp [coefficient, decay, weight, pOneFournierGuillinShellWeight]
        ring
  have htolerance : shellMass *
      (pOneFournierGuillinShellToleranceWithEta eta deviation shellMass shell ^ 2 / 4) =
        weight ^ 2 / (4 * shellMass) := by
    dsimp [weight, pOneFournierGuillinShellToleranceWithEta]
    field_simp [hshellMass_pos.ne']
  calc
    pOneFournierGuillinShellCoefficient eta ^ 2 * deviation ^ 2 * (2 : ℝ) ^ shell /
        (4 * massConstant) =
        coefficient ^ 2 * deviation ^ 2 * (2 : ℝ) ^ shell /
          (4 * massConstant) := by rfl
    _ ≤ weight ^ 2 * (2 : ℝ) ^ (5 * shell) / (4 * massConstant) :=
      div_le_div_of_nonneg_right hweight_scale (by positivity)
    _ = (weight ^ 2 / 4) * ((2 : ℝ) ^ (5 * shell) / massConstant) := by ring
    _ ≤ (weight ^ 2 / 4) * (1 / shellMass) :=
      mul_le_mul_of_nonneg_left hinv (by positivity)
    _ = weight ^ 2 / (4 * shellMass) := by ring
    _ = shellMass *
        (pOneFournierGuillinShellToleranceWithEta eta deviation shellMass shell ^ 2 / 4) :=
      htolerance.symm

/--
The source p-one tolerance cancels the positive shell mass in the Bennett
exponent.  This algebraic identity isolates the shell-scale term that drives
the large-deviation allocation.
-/
theorem shellMass_mul_pOneFournierGuillinShellTolerance
    {deviation shellMass : ℝ} (shell : ℕ) (hshellMass_pos : 0 < shellMass) :
    shellMass * pOneFournierGuillinShellTolerance deviation shellMass shell =
      deviation / (2 * (4 : ℝ) ^ shell) := by
  unfold pOneFournierGuillinShellTolerance
  have hfour_pow_pos : 0 < (4 : ℝ) ^ shell := pow_pos (by norm_num) _
  field_simp [hshellMass_pos.ne', hfour_pow_pos.ne']

/--
The small-deviation exponent generated by the `p = 1`, `eta = 1` source
tolerance.  A fifth-order dyadic source-mass bound turns its inverse shell
mass into a growing `2^n` exponent, exactly the first numerical step in
Fournier--Guillin Lemma 13.
-/
theorem pOneFournierGuillinShellTolerance_quadraticExponent_lower
    {deviation shellMass massConstant : ℝ} (shell : ℕ)
    (hshellMass_pos : 0 < shellMass) (hmassConstant_pos : 0 < massConstant)
    (hshellMass : shellMass ≤ massConstant / (2 : ℝ) ^ (5 * shell)) :
    deviation ^ 2 * (2 : ℝ) ^ shell / (16 * massConstant) ≤
      shellMass * (pOneFournierGuillinShellTolerance deviation shellMass shell ^ 2 / 4) := by
  have htwo_pow_pos : 0 < (2 : ℝ) ^ shell := pow_pos (by norm_num) _
  have hsixteen_pow_pos : 0 < (16 : ℝ) ^ shell := pow_pos (by norm_num) _
  have hthirtyTwo_pow_pos : 0 < (32 : ℝ) ^ shell := pow_pos (by norm_num) _
  have htwo_fifth_pow : (2 : ℝ) ^ (5 * shell) = (32 : ℝ) ^ shell := by
    rw [pow_mul]
    norm_num
  have hshellMass' : shellMass ≤ massConstant / (32 : ℝ) ^ shell := by
    rw [← htwo_fifth_pow]
    exact hshellMass
  have hscaled_mass : shellMass * (32 : ℝ) ^ shell ≤ massConstant := by
    apply (le_div_iff₀ hthirtyTwo_pow_pos).mp
    exact hshellMass'
  have hpow : (32 : ℝ) ^ shell = (2 : ℝ) ^ shell * (16 : ℝ) ^ shell := by
    rw [← mul_pow]
    norm_num
  have hden_bound : (2 : ℝ) ^ shell * ((16 : ℝ) ^ shell * shellMass) ≤ massConstant := by
    calc
      (2 : ℝ) ^ shell * ((16 : ℝ) ^ shell * shellMass) =
          ((2 : ℝ) ^ shell * (16 : ℝ) ^ shell) * shellMass := by ring
      _ = (32 : ℝ) ^ shell * shellMass := by rw [← hpow]
      _ = shellMass * (32 : ℝ) ^ shell := by ring
      _ ≤ massConstant := hscaled_mass
  have hden_pos : 0 < (16 : ℝ) ^ shell * shellMass :=
    mul_pos hsixteen_pow_pos hshellMass_pos
  have hinv_bound : (2 : ℝ) ^ shell / massConstant ≤
      1 / ((16 : ℝ) ^ shell * shellMass) := by
    rw [div_le_div_iff₀ hmassConstant_pos hden_pos]
    simpa [mul_assoc, mul_left_comm, mul_comm] using hden_bound
  have hdev_sq_nonneg : 0 ≤ deviation ^ 2 := sq_nonneg _
  have hfour_pow_mul : (4 : ℝ) ^ (shell * 2) = (16 : ℝ) ^ shell := by
    calc
      (4 : ℝ) ^ (shell * 2) = (4 : ℝ) ^ (2 * shell) := by rw [Nat.mul_comm]
      _ = ((4 : ℝ) ^ 2) ^ shell := by rw [pow_mul]
      _ = (16 : ℝ) ^ shell := by norm_num
  have hfour_pow_sq : ((4 : ℝ) ^ shell) ^ 2 = (16 : ℝ) ^ shell := by
    rw [← pow_mul]
    exact hfour_pow_mul
  calc
    deviation ^ 2 * (2 : ℝ) ^ shell / (16 * massConstant) =
        (deviation ^ 2 / 16) * ((2 : ℝ) ^ shell / massConstant) := by ring
    _ ≤ (deviation ^ 2 / 16) * (1 / ((16 : ℝ) ^ shell * shellMass)) :=
      mul_le_mul_of_nonneg_left hinv_bound (by positivity)
    _ = shellMass *
        (pOneFournierGuillinShellTolerance deviation shellMass shell ^ 2 / 4) := by
      unfold pOneFournierGuillinShellTolerance
      field_simp [hshellMass_pos.ne', hsixteen_pow_pos.ne']
      rw [hfour_pow_sq]
      ring

/--
The literal relative empirical-mass failure event for one source cube shell.
It is stated using real shell masses and empirical frequency so that no
division by a possibly null shell mass is introduced.
-/
def finiteIIDEuclideanDyadicCubeShellMassRelativeTail
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (z : ℝ) : Set (Fin count → EuclideanSpace ℝ (Fin dimension)) :=
  {sample | (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
      (euclideanDyadicCubeShell dimension shell) * z ≤
    |finiteIIDCellFrequency count (euclideanDyadicCubeShell dimension shell) sample -
      (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension shell)|}

/-- A literal relative shell-mass failure event is measurable in the IID sample. -/
theorem measurableSet_finiteIIDEuclideanDyadicCubeShellMassRelativeTail
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (z : ℝ) :
    MeasurableSet (finiteIIDEuclideanDyadicCubeShellMassRelativeTail
      dimension law count shell z) := by
  unfold finiteIIDEuclideanDyadicCubeShellMassRelativeTail
  exact measurableSet_Ici.preimage
    ((measurable_finiteIIDCellFrequency count
      (euclideanDyadicCubeShell dimension shell)
      (measurableSet_euclideanDyadicCubeShell dimension shell)).sub measurable_const).abs

/--
The source's small-deviation shell-count estimate, before selecting the
shell-dependent `z_n`.  The prefactor and exponent are explicit, and the
`z ≤ 1` gate is retained rather than being silently discharged by a later
schedule choice.
-/
theorem measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTail_le_exp_quadratic
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (hcount : 0 < count)
    (z : ℝ) (hz_nonneg : 0 ≤ z) (hz_le_two : z ≤ 2) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (finiteIIDEuclideanDyadicCubeShellMassRelativeTail dimension law count shell z) ≤
      2 * Real.exp (-((count : ℝ) *
        (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell) * (z ^ 2 / 4))) := by
  dsimp [finiteIIDEuclideanDyadicCubeShellMassRelativeTail]
  exact measure_finiteIIDCellFrequency_relativeTail_le_exp_quadratic law count hcount
    (euclideanDyadicCubeShell dimension shell)
    (measurableSet_euclideanDyadicCubeShell dimension shell) z hz_nonneg hz_le_two

/--
The fixed-tilt quadratic shell estimate in the bounded transition band
`2 ≤ z ≤ 9`.
-/
theorem measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTail_le_exp_quadratic_of_two_le_of_le_nine
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (hcount : 0 < count)
    (z : ℝ) (hz_two : 2 ≤ z) (hz_nine : z ≤ 9) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (finiteIIDEuclideanDyadicCubeShellMassRelativeTail dimension law count shell z) ≤
      Real.exp (-((count : ℝ) *
        (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell) * (z ^ 2 / 18))) := by
  dsimp [finiteIIDEuclideanDyadicCubeShellMassRelativeTail]
  exact measure_finiteIIDCellFrequency_relativeTail_le_exp_quadratic_of_two_le_of_le_nine
    law count hcount (euclideanDyadicCubeShell dimension shell)
      (measurableSet_euclideanDyadicCubeShell dimension shell) z hz_two hz_nine

/--
Uniform bounded-relative-deviation shell estimate.  The two source regimes
`z ≤ 2` and `2 ≤ z ≤ 9` share the coarser denominator `18`, so a later
allocation can handle their union without a hidden transition case.
-/
theorem measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTail_le_two_exp_quadratic_of_le_nine
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (hcount : 0 < count)
    (z : ℝ) (hz_nonneg : 0 ≤ z) (hz_nine : z ≤ 9) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (finiteIIDEuclideanDyadicCubeShellMassRelativeTail dimension law count shell z) ≤
      2 * Real.exp (-((count : ℝ) *
        (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell) * (z ^ 2 / 18))) := by
  by_cases hsmall : z ≤ 2
  · have hquadratic :=
      measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTail_le_exp_quadratic
        dimension law count shell hcount z hz_nonneg hsmall
    calc
      (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
          (finiteIIDEuclideanDyadicCubeShellMassRelativeTail dimension law count shell z) ≤
          2 * Real.exp (-((count : ℝ) *
            (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell) * (z ^ 2 / 4))) := hquadratic
      _ ≤ 2 * Real.exp (-((count : ℝ) *
          (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell) * (z ^ 2 / 18))) := by
        apply mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (by norm_num)
        have hscale_nonneg : 0 ≤ (count : ℝ) *
            (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
              (euclideanDyadicCubeShell dimension shell) := by positivity
        have hsquare_nonneg : 0 ≤ z ^ 2 := sq_nonneg _
        nlinarith [mul_nonneg hscale_nonneg hsquare_nonneg]
  · have htwo : 2 ≤ z := le_of_lt (lt_of_not_ge hsmall)
    have hmiddle :=
      measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTail_le_exp_quadratic_of_two_le_of_le_nine
        dimension law count shell hcount z htwo hz_nine
    exact hmiddle.trans (by
      exact le_mul_of_one_le_left (Real.exp_pos _).le (by norm_num))

/--
The totalized shell-mass failure event.  On a population-null shell, the raw
relative event would have zero threshold and hence be vacuous; it is replaced
by the actual event that an iid observation enters that null shell.  This is
the version that can be unioned over all countably many source shells.
-/
def finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (z : ℝ) : Set (Fin count → EuclideanSpace ℝ (Fin dimension)) := by
  classical
  exact if law.toFiniteMeasure.restrict (euclideanDyadicCubeShell dimension shell) = 0 then
    {sample | ∃ index, sample index ∈ euclideanDyadicCubeShell dimension shell}
  else finiteIIDEuclideanDyadicCubeShellMassRelativeTail dimension law count shell z

/-- The null-shell totalization preserves measurability of a shell-mass event. -/
theorem measurableSet_finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (z : ℝ) :
    MeasurableSet (finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized
      dimension law count shell z) := by
  classical
  unfold finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized
  split_ifs with hzero
  · have hentry : {sample : Fin count → EuclideanSpace ℝ (Fin dimension) |
        ∃ index, sample index ∈ euclideanDyadicCubeShell dimension shell} =
        ⋃ index, (fun sample : Fin count → EuclideanSpace ℝ (Fin dimension) =>
          sample index) ⁻¹' euclideanDyadicCubeShell dimension shell := by
      ext sample
      simp
    rw [hentry]
    exact MeasurableSet.iUnion fun index =>
      (measurableSet_euclideanDyadicCubeShell dimension shell).preimage
        (measurable_pi_apply index)
  · exact measurableSet_finiteIIDEuclideanDyadicCubeShellMassRelativeTail
      dimension law count shell z

/--
A totalized shell-mass event is null when the source shell itself is null.
The proof retains the actual sample-entry event; it does not identify a
measure-zero event with the empty set.
-/
theorem measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized_eq_zero
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (z : ℝ)
    (hzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) = 0) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized
          dimension law count shell z) = 0 := by
  let sampleLaw := finiteIIDSampleLaw
    (law : Measure (EuclideanSpace ℝ (Fin dimension))) count
  let shellSet := euclideanDyadicCubeShell dimension shell
  letI : IsProbabilityMeasure sampleLaw := by
    dsimp [sampleLaw, finiteIIDSampleLaw]
    infer_instance
  have hmass_zero : (law : Measure (EuclideanSpace ℝ (Fin dimension))) shellSet = 0 := by
    rw [← ProbabilityMeasure.ennreal_coeFn_eq_coeFn_toMeasure]
    apply ENNReal.coe_eq_zero.mpr
    exact (FiniteMeasure.restrict_eq_zero_iff _ _).mp hzero
  rw [finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized, if_pos hzero]
  apply le_antisymm
  · calc
      sampleLaw.real {sample | ∃ index, sample index ∈ shellSet} ≤
          count * (law : Measure (EuclideanSpace ℝ (Fin dimension))).real shellSet :=
        measure_finiteIID_exists_coordinate_mem_le
          (law : Measure (EuclideanSpace ℝ (Fin dimension))) count shellSet
          (measurableSet_euclideanDyadicCubeShell dimension shell)
      _ = 0 := by simp [Measure.real, hmass_zero]
  · exact measureReal_nonneg

/--
A nonzero normalized source cube-shell restriction has strictly positive real
mass.  This is the reusable coercion bridge required by both large-deviation
shell-count estimates.
-/
theorem euclideanDyadicCubeShellMassReal_pos_of_restrict_ne_zero
    (dimension shell : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0) :
    0 < (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
      (euclideanDyadicCubeShell dimension shell) := by
  let shellSet := euclideanDyadicCubeShell dimension shell
  have hmass_ne_zero :
      (law : Measure (EuclideanSpace ℝ (Fin dimension))).real shellSet ≠ 0 := by
    intro hmass_zero
    apply hnonzero
    apply (FiniteMeasure.restrict_eq_zero_iff _ _).mpr
    apply ENNReal.coe_eq_zero.mp
    calc
      ↑(law.toFiniteMeasure shellSet) =
          (law.toFiniteMeasure : Measure (EuclideanSpace ℝ (Fin dimension))) shellSet :=
        FiniteMeasure.ennreal_coeFn_eq_coeFn_toMeasure _ _
      _ = (law : Measure (EuclideanSpace ℝ (Fin dimension))) shellSet := by
        rw [ProbabilityMeasure.toMeasure_comp_toFiniteMeasure_eq_toMeasure]
      _ = 0 := (measureReal_eq_zero_iff (measure_ne_top _ _)).mp hmass_zero
  exact lt_of_le_of_ne measureReal_nonneg (Ne.symm hmass_ne_zero)

/--
The exponential radial shell-mass envelope becomes a lower bound on the
logarithmic factor of the p-one tolerance.  This is the exact bridge from the
source's moment assumption to the unbounded Bennett regime; it does not yet
choose the source's cutoff or sum its resulting terms.
-/
theorem log_pOneFournierGuillinShellTolerance_lower_of_exponentialRadialMoment
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (scale : ℕ) {deviation alpha gamma : ℝ}
    (hdeviation_pos : 0 < deviation) (halpha : 0 ≤ alpha) (hgamma : 0 ≤ gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension (scale + 1)) ≠ 0) :
    Real.log (pOneFournierGuillinShellTolerance deviation
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1))) scale) ≥
      Real.log (deviation / (2 * (4 : ℝ) ^ scale)) +
        gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha -
          Real.log (∫ x : EuclideanSpace ℝ (Fin dimension),
            Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
              (law : Measure (EuclideanSpace ℝ (Fin dimension))) ) := by
  let shellMass := (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
    (euclideanDyadicCubeShell dimension (scale + 1))
  let moment : ℝ := ∫ x : EuclideanSpace ℝ (Fin dimension),
    Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
      (law : Measure (EuclideanSpace ℝ (Fin dimension)))
  have hshellMass_pos : 0 < shellMass :=
    euclideanDyadicCubeShellMassReal_pos_of_restrict_ne_zero dimension (scale + 1) law hnonzero
  have hmoment_pos : 0 < moment := by
    exact lt_of_lt_of_le zero_lt_one
      (one_le_exponentialRadialMomentIntegral law hgamma hmoment)
  have hshellMass_le : shellMass ≤
      Real.exp (-(gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha)) * moment := by
    simpa [shellMass, moment] using
      (measureReal_euclideanDyadicCubeShell_succ_le_exponentialRadialMoment
        dimension scale law halpha hgamma hmoment)
  have hlog := AppliedModelingLib.Math.log_div_mul_lower_of_le_mul_exp_neg
    hdeviation_pos (show 0 < 2 * (4 : ℝ) ^ scale by positivity)
    hshellMass_pos hmoment_pos (by
      simpa [mul_comm] using hshellMass_le)
  simpa [pOneFournierGuillinShellTolerance, shellMass, moment] using hlog

/--
The exponential radial shell-mass envelope for the parameterized source
allocation.  Positivity of the source weight is kept explicit so this
algebraic bridge can be used independently of a particular admissible choice
of `eta`.
-/
theorem log_pOneFournierGuillinShellToleranceWithEta_lower_of_exponentialRadialMoment
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (scale : ℕ) {eta deviation alpha gamma : ℝ}
    (hweight_pos : 0 < pOneFournierGuillinShellWeight eta deviation scale)
    (halpha : 0 ≤ alpha) (hgamma : 0 ≤ gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension (scale + 1)) ≠ 0) :
    Real.log (pOneFournierGuillinShellToleranceWithEta eta deviation
      ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension (scale + 1))) scale) ≥
      Real.log (pOneFournierGuillinShellWeight eta deviation scale) +
        gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha -
          Real.log (∫ x : EuclideanSpace ℝ (Fin dimension),
            Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
              (law : Measure (EuclideanSpace ℝ (Fin dimension))) ) := by
  let shellMass := (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
    (euclideanDyadicCubeShell dimension (scale + 1))
  let moment : ℝ := ∫ x : EuclideanSpace ℝ (Fin dimension),
    Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
      (law : Measure (EuclideanSpace ℝ (Fin dimension)))
  let weight := pOneFournierGuillinShellWeight eta deviation scale
  have hshellMass_pos : 0 < shellMass :=
    euclideanDyadicCubeShellMassReal_pos_of_restrict_ne_zero dimension (scale + 1) law hnonzero
  have hmoment_pos : 0 < moment := by
    exact lt_of_lt_of_le zero_lt_one
      (one_le_exponentialRadialMomentIntegral law hgamma hmoment)
  have hshellMass_le : shellMass ≤
      Real.exp (-(gamma * Real.rpow (euclideanDyadicCubeRadius scale) alpha)) * moment := by
    simpa [shellMass, moment] using
      (measureReal_euclideanDyadicCubeShell_succ_le_exponentialRadialMoment
        dimension scale law halpha hgamma hmoment)
  have hlog := AppliedModelingLib.Math.log_div_mul_lower_of_le_mul_exp_neg
    hweight_pos (show 0 < (1 : ℝ) by norm_num) hshellMass_pos hmoment_pos (by
      simpa [mul_comm] using hshellMass_le)
  simpa [pOneFournierGuillinShellToleranceWithEta, shellMass, moment, weight] using hlog

/--
The large-relative-deviation branch for a positive source cube shell.  It is
the shell specialization of the raw `N μ(B_n)` bound from Lemma 12(b), with
the totalized event reducing definitionally to the non-null relative event.
-/
theorem measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized_le_count_mul
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (hcount : 0 < count)
    (z : ℝ) (hz_one_lt : 1 < z)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
    (finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized
          dimension law count shell z) ≤
      count * (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
        (euclideanDyadicCubeShell dimension shell) := by
  let shellSet := euclideanDyadicCubeShell dimension shell
  have hmass_pos : 0 <
      (law : Measure (EuclideanSpace ℝ (Fin dimension))).real shellSet :=
    euclideanDyadicCubeShellMassReal_pos_of_restrict_ne_zero dimension shell law hnonzero
  rw [finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized, if_neg hnonzero]
  exact measure_finiteIIDCellFrequency_relativeTail_le_count_mul law count hcount shellSet
    (measurableSet_euclideanDyadicCubeShell dimension shell) z hz_one_lt hmass_pos

/--
The large-relative-deviation Bennett branch for a positive source cube shell.
It retains the logarithmic rate used in Fournier--Guillin Lemma 13 rather than
only its coarser occupancy consequence.
-/
theorem measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized_le_exp_bennett
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (hcount : 0 < count)
    (z : ℝ) (hz_one_lt : 1 < z)
    (hnonzero : law.toFiniteMeasure.restrict
      (euclideanDyadicCubeShell dimension shell) ≠ 0) :
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized
          dimension law count shell z) ≤
      Real.exp (-((count : ℝ) *
        (law : Measure (EuclideanSpace ℝ (Fin dimension))).real
          (euclideanDyadicCubeShell dimension shell) *
        ((1 + z) * Real.log (1 + z) - z))) := by
  let shellSet := euclideanDyadicCubeShell dimension shell
  rw [finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized, if_neg hnonzero]
  exact measure_finiteIIDCellFrequency_relativeTail_le_exp_bennett_of_one_lt
    law count hcount shellSet
      (measurableSet_euclideanDyadicCubeShell dimension shell) z hz_one_lt

/--
For the truly large relative-error regime, expose the `z log z` portion of
the checked Bennett rate.  The bound is deliberately separate from the exact
Bennett theorem so later source schedules can retain either form.
-/
theorem measureReal_finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized_le_exp_half_mul_mul_log_of_nine_le
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (count shell : ℕ) (hcount : 0 < count)
