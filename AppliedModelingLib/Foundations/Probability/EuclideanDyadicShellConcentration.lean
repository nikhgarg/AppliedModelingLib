theorem finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized_subset_pOneFournierGuillinBounded_or_large
    (dimension : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
