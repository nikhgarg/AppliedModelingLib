            2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) /
            Real.sqrt count) *
            (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma))) := by
  apply sum_subset_euclideanDyadicCubeShellMass_mul_selectedShellGeometricCompactBudget_dimensionOne_active_succ_le
    cutoff count law (selectedShellGeometricActiveOffsets 1 cutoff count law confidence)
    (by
      intro scale hscale
      exact (Finset.mem_filter.mp hscale).1)
    hcount hconfidence halpha hgamma hmoment
  · intro scale hscale
    exact measureReal_euclideanDyadicCubeShell_succ_pos_of_mem_selectedShellGeometricActiveOffsets
      1 cutoff count scale law confidence hcount hscale
  · intro scale hscale
    exact (mem_selectedShellGeometricActiveOffsets_iff
      1 cutoff count scale law confidence).mp hscale |>.2

/--
The exact selected-shell compact budget in the critical two-dimensional case
inherits the real-effective-count logarithmic dyadic bound.
-/
theorem selectedShellGeometricCompactBudget_dimensionTwo_le
    (shell count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin 2)))
    (depth : ℕ → ℕ) (confidence : ℝ)
    (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (hshellMass : 0 < (law : Measure (EuclideanSpace ℝ (Fin 2))).real
      (euclideanDyadicCubeShell 2 shell)) :
    selectedShellGeometricCompactBudget 2 count law depth confidence shell ≤
      ENNReal.ofReal (euclideanDyadicCubeRadius shell) * ENNReal.ofReal
        (2 * Real.sqrt 2 / ((2 ^ (depth shell) : ℕ) : ℝ) +
          4 * (depth shell) / Real.sqrt ((count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin 2))).real
              (euclideanDyadicCubeShell 2 shell))) +
          2 * Real.sqrt 2 * Real.sqrt
            (selectedShellGeometricConfidence confidence shell) /
              Real.sqrt ((count : ℝ) *
                ((law : Measure (EuclideanSpace ℝ (Fin 2))).real
                  (euclideanDyadicCubeShell 2 shell)))) := by
  have hconfidenceAt : 0 ≤ selectedShellGeometricConfidence confidence shell := by
    unfold selectedShellGeometricConfidence
    exact add_nonneg hconfidence
      (mul_nonneg (by positivity) (Real.log_nonneg (by norm_num)))
  unfold selectedShellGeometricCompactBudget
  apply mul_le_mul_left'
  apply ENNReal.ofReal_le_ofReal
  rw [show (fun level => selectedShellDyadicGeometricConfidenceThreshold
      2 count level
        ((law : Measure (EuclideanSpace ℝ (Fin 2))).real
          (euclideanDyadicCubeShell 2 shell))
        (selectedShellGeometricConfidence confidence shell)) =
      (fun level => dyadicGeometricConfidenceThresholdReal 2 level
        ((count : ℝ) * ((law : Measure (EuclideanSpace ℝ (Fin 2))).real
          (euclideanDyadicCubeShell 2 shell)) )
        (selectedShellGeometricConfidence confidence shell)) by
      funext level
      exact selectedShellDyadicGeometricConfidenceThreshold_eq_realEffectiveCount
        2 count level _ _]
  exact dyadicDimensionTwoGeometricConfidenceBoundReal_le (depth shell)
    (mul_pos (by exact_mod_cast hcount) hshellMass) hconfidenceAt

/--
On an active positive-mass critical-dimensional source shell, the exact
selected compact budget has the expected square-root source-mass scale.  The
effective depth is deliberately retained: a later finite-head selector must
make the logarithmic factor uniform rather than discard it locally.
-/
theorem euclideanDyadicCubeShellMass_mul_selectedShellGeometricCompactBudget_dimensionTwo_active_le
    (shell count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin 2)))
    (confidence : ℝ) (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (hshellMass : 0 < (law : Measure (EuclideanSpace ℝ (Fin 2))).real
      (euclideanDyadicCubeShell 2 shell))
    (hactive : 16 * ((2 ^ 2 : ℕ) : ℝ) ≤
