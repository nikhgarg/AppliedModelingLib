      simpa [empirical, support, compactTerm] using hbase
    _ = ENNReal.ofReal (Real.sqrt dimension * deviation) +
        ((∑ shell ∈ support.filter (fun shell => cutoff < shell), compactTerm shell) +
          ∑ shell ∈ support.filter (fun shell => ¬ cutoff < shell), compactTerm shell) := by
      rw [hsplit]
    _ = ENNReal.ofReal (Real.sqrt dimension * deviation) +
        ((∑ shell ∈ support.filter (fun shell => cutoff < shell), zeroDepthTerm shell) +
          ∑ shell ∈ support.filter (fun shell => ¬ cutoff < shell), compactTerm shell) := by
      rw [htail_eq]
    _ ≤ ENNReal.ofReal (Real.sqrt dimension * deviation) +
        (tailBound +
          ∑ shell ∈ support.filter (fun shell => ¬ cutoff < shell), compactTerm shell) := by
      gcongr
    _ = ENNReal.ofReal (Real.sqrt dimension * deviation) + tailBound +
        ∑ shell ∈ support.filter (fun shell => shell ≤ cutoff), compactTerm shell := by
      simp only [Nat.not_lt]
      ac_rfl

