/-- The pointwise concrete effective-count selector as an adaptive batch
schedule for a prescribed confidence allocation. -/
noncomputable def selectedShellGeometricSupercriticalConcreteCountSchedule
    (dimension cutoff : ℕ) (confidence : ℕ → ℝ) (tailConstant radius : ℝ) : ℕ → ℕ :=
  fun iteration => selectedShellGeometricSupercriticalEffectiveCount dimension cutoff
    (confidence iteration) tailConstant radius

/-- Every batch in the concrete supercritical schedule is nonempty. -/
theorem pos_selectedShellGeometricSupercriticalConcreteCountSchedule
    (dimension cutoff : ℕ) (confidence : ℕ → ℝ) (tailConstant radius : ℝ)
    (iteration : ℕ) :
    0 < selectedShellGeometricSupercriticalConcreteCountSchedule dimension cutoff confidence
      tailConstant radius iteration := by
  unfold selectedShellGeometricSupercriticalConcreteCountSchedule
  exact lt_of_lt_of_le zero_lt_one
    (one_le_selectedShellGeometricSupercriticalEffectiveCount dimension cutoff
      (confidence iteration) tailConstant radius)

/-- The concrete supercritical schedule bounds the selected-shell head at
every round by its prescribed positive radius. -/
theorem selectedShellGeometricHeadSchedule_dimensionGreaterTwo_le_of_concreteCountSchedule
    (dimension cutoff : ℕ) (confidence : ℕ → ℝ) (tailConstant radius : ℝ)
    (hdimension : 2 < dimension) (hradius : 0 < radius) (iteration : ℕ) :
    selectedShellGeometricHeadSchedule_dimensionGreaterTwo dimension cutoff
      (selectedShellGeometricSupercriticalConcreteCountSchedule dimension cutoff confidence
        tailConstant radius iteration)
      (confidence iteration) tailConstant ≤ ENNReal.ofReal radius := by
  exact selectedShellGeometricHeadSchedule_dimensionGreaterTwo_le_of_concreteEffectiveCount
    dimension cutoff (confidence iteration) tailConstant radius hdimension hradius

/-- A polynomial `N * r^d` gate controls the leading supercritical
selected-shell compact-head term.  The generic numerical inversion is
`Math.div_rpow_nat_inv_le_of_pow_le`; its exact Mathlib provenance is recorded
there rather than duplicated here. -/
theorem selectedShellGeometricSupercriticalRateCoefficient_div_rpow_count_le_of_pow_gate
    (dimension : ℕ) (hdimension : 2 < dimension)
    (count : ℝ) (hcount : 0 < count)
    {radius : ℝ} (hradius : 0 < radius)
    (hgate : selectedShellGeometricSupercriticalRateCoefficient dimension ^ dimension ≤
      count * radius ^ dimension) :
    selectedShellGeometricSupercriticalRateCoefficient dimension /
      count ^ ((dimension : ℝ)⁻¹) ≤ radius := by
  apply Math.div_rpow_nat_inv_le_of_pow_le dimension (by omega) ?_ hcount hradius hgate
  unfold selectedShellGeometricSupercriticalRateCoefficient
  have hratio : 1 < Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 := by
    apply (lt_div_iff₀ (by norm_num : (0 : ℝ) < 2)).mpr
    simp only [one_mul]
    apply (Real.lt_sqrt (by norm_num : (0 : ℝ) ≤ 2)).mpr
    have hpow : 2 ^ 2 < 2 ^ dimension :=
      Nat.pow_lt_pow_right (by norm_num) hdimension
    norm_num at hpow ⊢
    exact_mod_cast hpow
  have hden_pos : 0 < Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1 :=
    sub_pos.mpr hratio
  positivity

/-- The leading term as it appears in the retained selected-shell schedule is
the named supercritical rate coefficient divided by `N^(1/d)`.  Keeping this
rewrite separate preserves the stable schedule syntax used by the older shell
budget proofs. -/
theorem selectedShellGeometricSupercriticalLeadingTerm_eq_rateCoefficient_div
    (dimension : ℕ) (count : ℝ) :
    (2 * Real.sqrt dimension +
        Real.sqrt dimension * Real.sqrt 2 /
          (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
      ((16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹) /
        count ^ ((dimension : ℝ)⁻¹)) =
      selectedShellGeometricSupercriticalRateCoefficient dimension /
        count ^ ((dimension : ℝ)⁻¹) := by
  unfold selectedShellGeometricSupercriticalRateCoefficient
  ring

/-- The original leading term of the supercritical selected-shell schedule is
at most `radius` under its explicit polynomial effective-count gate. -/
theorem selectedShellGeometricSupercriticalLeadingTerm_le_of_pow_gate
    (dimension : ℕ) (hdimension : 2 < dimension)
    (count : ℝ) (hcount : 0 < count)
    {radius : ℝ} (hradius : 0 < radius)
    (hgate : selectedShellGeometricSupercriticalRateCoefficient dimension ^ dimension ≤
      count * radius ^ dimension) :
    (2 * Real.sqrt dimension +
        Real.sqrt dimension * Real.sqrt 2 /
          (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
      ((16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹) /
        count ^ ((dimension : ℝ)⁻¹)) ≤ radius := by
  rw [selectedShellGeometricSupercriticalLeadingTerm_eq_rateCoefficient_div]
  exact selectedShellGeometricSupercriticalRateCoefficient_div_rpow_count_le_of_pow_gate
    dimension hdimension count hcount hradius hgate

/-- A positive real-power inverse-count term plus an inverse-square-root term
vanishes along natural batch counts. -/
theorem tendsto_div_rpow_add_div_sqrt_nat_nhds_zero
    {power : ℝ} (hpower : 0 < power) (first second : ℝ) :
    Filter.Tendsto (fun count : ℕ =>
      first / (count : ℝ) ^ power + second / Real.sqrt (count : ℝ))
      Filter.atTop (nhds 0) := by
  have hcount : Filter.Tendsto (fun count : ℕ => (count : ℝ)) Filter.atTop Filter.atTop :=
    tendsto_natCast_atTop_atTop
  have hpow : Filter.Tendsto (fun count : ℕ => (count : ℝ) ^ power)
      Filter.atTop Filter.atTop :=
    tendsto_rpow_atTop hpower |>.comp hcount
  have hfirst : Filter.Tendsto (fun count : ℕ => first / (count : ℝ) ^ power)
      Filter.atTop (nhds 0) :=
    Filter.Tendsto.const_div_atTop hpow first
  have hsqrt : Filter.Tendsto (fun count : ℕ => Real.sqrt (count : ℝ))
      Filter.atTop Filter.atTop :=
    Real.tendsto_sqrt_atTop.comp hcount
  have hsecond : Filter.Tendsto (fun count : ℕ => second / Real.sqrt (count : ℝ))
      Filter.atTop (nhds 0) :=
    Filter.Tendsto.const_div_atTop hsqrt second
  simpa using hfirst.add hsecond

/-- The square root of a fixed inverse-count term vanishes along natural
batch counts. -/
theorem tendsto_sqrt_div_nat_nhds_zero (constant : ℝ) :
    Filter.Tendsto (fun count : ℕ => Real.sqrt (constant / (count : ℝ)))
      Filter.atTop (nhds 0) := by
  have hcount : Filter.Tendsto (fun count : ℕ => (count : ℝ)) Filter.atTop Filter.atTop :=
    tendsto_natCast_atTop_atTop
  have hdiv : Filter.Tendsto (fun count : ℕ => constant / (count : ℝ))
      Filter.atTop (nhds 0) :=
    Filter.Tendsto.const_div_atTop hcount constant
  simpa only [Function.comp_apply, Real.sqrt_zero] using
    Real.continuous_sqrt.continuousAt.tendsto.comp hdiv

/-- The critical two-dimensional effective dyadic depth grows only
logarithmically, so its contribution divided by `sqrt N` vanishes. -/
theorem tendsto_dyadicEffectiveCountDepth_two_div_sqrt_nat_nhds_zero :
    Filter.Tendsto (fun count : ℕ =>
      (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
        Real.sqrt (count : ℝ)) Filter.atTop (nhds 0) := by
  have hlogFour_pos : 0 < Real.log 4 := Real.log_pos (by norm_num)
  have hright : Filter.Tendsto (fun count : ℕ =>
      (1 / Real.log 4) * (Real.log (count : ℝ) / Real.sqrt (count : ℝ)))
      Filter.atTop (nhds 0) := by
    simpa using (tendsto_const_nhds.mul Math.tendsto_log_div_sqrt_nat_nhds_zero)
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hright ?_ ?_
  · filter_upwards [Filter.eventually_ge_atTop 64] with count hcount
    exact div_nonneg (Nat.cast_nonneg _) (Real.sqrt_nonneg _)
  · filter_upwards [Filter.eventually_ge_atTop 64] with count hcount
    have hcount_real : (64 : ℝ) ≤ count := by exact_mod_cast hcount
    have hcount_pos : 0 < (count : ℝ) := lt_of_lt_of_le (by norm_num) hcount_real
    have hratio_one : 1 ≤ (count : ℝ) / 64 := by
      apply (one_le_div (by norm_num : (0 : ℝ) < 64)).mpr
      simpa using hcount_real
    have hratio_pos : 0 < (count : ℝ) / 64 := lt_of_lt_of_le zero_lt_one hratio_one
    have hlog_nonneg : 0 ≤ Real.logb 4 ((count : ℝ) / 64) := by
      unfold Real.logb
      exact div_nonneg (Real.log_nonneg hratio_one) hlogFour_pos.le
    have hratio_le : (count : ℝ) / 64 ≤ count := by
      apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 64)).mpr
      nlinarith
    have hdepth_le_log : (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) ≤
        Real.log (count : ℝ) / Real.log 4 := by
      have hfloor : (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) ≤
          Real.logb 4 ((count : ℝ) / 64) := by
        change (Nat.floor (Real.logb 4 (((count : ℝ) / 16) / 4)) : ℝ) ≤ _
        convert Nat.floor_le hlog_nonneg using 1 <;> ring
      calc
        (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) ≤
            Real.logb 4 ((count : ℝ) / 64) := hfloor
        _ ≤ Real.logb 4 (count : ℝ) :=
          Real.logb_le_logb_of_le (by norm_num) hratio_pos hratio_le
        _ = Real.log (count : ℝ) / Real.log 4 := by
          rw [Real.logb]
    have hsqrt_pos : 0 < Real.sqrt (count : ℝ) := Real.sqrt_pos.2 hcount_pos
    calc
      (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
          Real.sqrt (count : ℝ) ≤
          (Real.log (count : ℝ) / Real.log 4) / Real.sqrt (count : ℝ) :=
        div_le_div_of_nonneg_right hdepth_le_log hsqrt_pos.le
      _ = (1 / Real.log 4) *
          (Real.log (count : ℝ) / Real.sqrt (count : ℝ)) := by
        field_simp [hlogFour_pos.ne'] <;> ring

/--
For a fixed finite cutoff and confidence allocation, the one-dimensional
finite compact-head budget vanishes as the batch count grows.  This is a
numerical schedule fact only; no source rate inversion is concealed here.
-/
theorem tendsto_selectedShellGeometricHeadSchedule_dimensionOne_nhds_zero
    (cutoff : ℕ) (confidence tailConstant : ℝ) :
    Filter.Tendsto
      (fun count : ℕ =>
        selectedShellGeometricHeadSchedule_dimensionOne cutoff count confidence tailConstant)
      Filter.atTop (nhds 0) := by
  have hcount : Filter.Tendsto (fun count : ℕ => (count : ℝ)) Filter.atTop Filter.atTop :=
    tendsto_natCast_atTop_atTop
  have hsqrtCount : Filter.Tendsto (fun count : ℕ => Real.sqrt (count : ℝ))
      Filter.atTop Filter.atTop :=
    Real.tendsto_sqrt_atTop.comp hcount
  have hdiv : ∀ constant : ℝ,
      Filter.Tendsto (fun count : ℕ => constant / (count : ℝ)) Filter.atTop (nhds 0) := by
    intro constant
    exact Filter.Tendsto.const_div_atTop hcount constant
  have hdivSqrt : ∀ constant : ℝ,
      Filter.Tendsto (fun count : ℕ => constant / Real.sqrt (count : ℝ))
        Filter.atTop (nhds 0) := by
    intro constant
    exact Filter.Tendsto.const_div_atTop hsqrtCount constant
  have hsqrtDiv : ∀ constant : ℝ,
      Filter.Tendsto (fun count : ℕ => Real.sqrt (constant / (count : ℝ)))
        Filter.atTop (nhds 0) := by
    intro constant
    simpa only [Function.comp_apply, Real.sqrt_zero] using
      (Real.continuous_sqrt.continuousAt.tendsto.comp (hdiv constant))
  unfold selectedShellGeometricHeadSchedule_dimensionOne
  have hcentralFirst : Filter.Tendsto (fun count : ℕ => ENNReal.ofReal
      (128 / (count : ℝ) +
        (2 * (1 / (1 - 1 / Real.sqrt 2)) +
          2 * Real.sqrt (confidence + Real.log 2)) / Real.sqrt count))
      Filter.atTop (nhds 0) := by
    have hreal := (hdiv 128).add
      (hdivSqrt (2 * (1 / (1 - 1 / Real.sqrt 2)) +
        2 * Real.sqrt (confidence + Real.log 2)))
    have hrealzero : Filter.Tendsto (fun count : ℕ =>
        128 / (count : ℝ) +
          (2 * (1 / (1 - 1 / Real.sqrt 2)) +
            2 * Real.sqrt (confidence + Real.log 2)) / Real.sqrt count)
        Filter.atTop (nhds 0) := by
      simpa using hreal
    simpa only [Function.comp_apply, ENNReal.ofReal_zero] using
      (ENNReal.continuous_ofReal.tendsto (0 : ℝ)).comp hrealzero
  have hcentralSecond : Filter.Tendsto (fun count : ℕ => ENNReal.ofReal
      (2 * Real.sqrt 1 *
        ((16 * ((2 ^ 1 : ℕ) : ℝ) + 8 * (confidence + Real.log 2)) / (count : ℝ))))
      Filter.atTop (nhds 0) := by
    have hreal := (hdiv (16 * ((2 ^ 1 : ℕ) : ℝ) +
      8 * (confidence + Real.log 2))).const_mul (2 * Real.sqrt 1)
    have hrealzero : Filter.Tendsto (fun count : ℕ => 2 * Real.sqrt 1 *
        ((16 * ((2 ^ 1 : ℕ) : ℝ) + 8 * (confidence + Real.log 2)) / (count : ℝ)))
        Filter.atTop (nhds 0) := by
      simpa using hreal
    simpa only [Function.comp_apply, ENNReal.ofReal_zero, mul_assoc] using
      (ENNReal.continuous_ofReal.tendsto (0 : ℝ)).comp hrealzero
  have hcentral : Filter.Tendsto (fun count : ℕ =>
      ENNReal.ofReal (128 / (count : ℝ) +
        (2 * (1 / (1 - 1 / Real.sqrt 2)) +
          2 * Real.sqrt (confidence + Real.log 2)) / Real.sqrt count) +
      ENNReal.ofReal (2 * Real.sqrt 1 *
        ((16 * ((2 ^ 1 : ℕ) : ℝ) + 8 * (confidence + Real.log 2)) / (count : ℝ))))
      Filter.atTop (nhds 0) := by
    simpa using hcentralFirst.add hcentralSecond
  have hsuccessorFirst : Filter.Tendsto (fun count : ℕ => ENNReal.ofReal
      ((128 / (count : ℝ)) * (2 * ((2 : ℝ) ^ cutoff - 1)) +
        ((2 * (1 / (1 - 1 / Real.sqrt 2)) +
          2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) /
          Real.sqrt count) * (4 * Real.sqrt tailConstant)))
      Filter.atTop (nhds 0) := by
    have hreal := ((hdiv 128).mul_const (2 * ((2 : ℝ) ^ cutoff - 1))).add
      ((hdivSqrt (2 * (1 / (1 - 1 / Real.sqrt 2)) +
        2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2))).mul_const
        (4 * Real.sqrt tailConstant))
    have hrealzero : Filter.Tendsto (fun count : ℕ =>
        (128 / (count : ℝ)) * (2 * ((2 : ℝ) ^ cutoff - 1)) +
          ((2 * (1 / (1 - 1 / Real.sqrt 2)) +
            2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) /
            Real.sqrt count) * (4 * Real.sqrt tailConstant))
        Filter.atTop (nhds 0) := by
      simpa using hreal
    simpa only [Function.comp_apply, ENNReal.ofReal_zero, mul_assoc] using
      (ENNReal.continuous_ofReal.tendsto (0 : ℝ)).comp hrealzero
  have hsuccessorSecond : Filter.Tendsto (fun count : ℕ => ENNReal.ofReal
      (2 * Real.sqrt
        ((16 * ((2 ^ 1 : ℕ) : ℝ) +
          8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / (count : ℝ)) *
        (4 * Real.sqrt tailConstant)))
      Filter.atTop (nhds 0) := by
    let root : ℝ := 16 * ((2 ^ 1 : ℕ) : ℝ) +
      8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)
    let multiplier : ℝ := 2 * Real.sqrt 1
    let tail : ℝ := 4 * Real.sqrt tailConstant
    let transform : ℝ → ℝ≥0∞ := fun x => ENNReal.ofReal (multiplier * x * tail)
    have hroot := hsqrtDiv root
    have hscalar : Continuous (fun x : ℝ => multiplier * x * tail) :=
      (continuous_const.mul continuous_id).mul continuous_const
    have htransform : Continuous transform :=
      ENNReal.continuous_ofReal.comp hscalar
    have hlimit := htransform.continuousAt.tendsto.comp hroot
    have htransform_zero : transform 0 = 0 := by
      simp [transform]
    rw [htransform_zero] at hlimit
    refine Filter.Tendsto.congr' ?_ hlimit
    filter_upwards with count
    dsimp [root, multiplier, tail, transform, Function.comp_apply]
    rw [Real.sqrt_div' _ (Nat.cast_nonneg count)]
    norm_num
  simpa only [add_zero] using hcentral.add (hsuccessorFirst.add hsuccessorSecond)

/-- A fixed one-dimensional source head can be made smaller than any positive
deterministic tolerance by choosing a positive finite batch count. -/
theorem exists_pos_selectedShellGeometricHeadSchedule_dimensionOne_lt_of_pos
    (cutoff : ℕ) (confidence tailConstant : ℝ) {tolerance : ℝ}
    (htolerance : 0 < tolerance) :
    ∃ count : ℕ, 0 < count ∧
      selectedShellGeometricHeadSchedule_dimensionOne cutoff count confidence tailConstant <
        ENNReal.ofReal tolerance := by
  have htarget : 0 < ENNReal.ofReal tolerance := ENNReal.ofReal_pos.mpr htolerance
  have hevent : ∀ᶠ count : ℕ in Filter.atTop,
      selectedShellGeometricHeadSchedule_dimensionOne cutoff count confidence tailConstant <
        ENNReal.ofReal tolerance :=
    tendsto_selectedShellGeometricHeadSchedule_dimensionOne_nhds_zero
      cutoff confidence tailConstant (isOpen_Iio.mem_nhds htarget)
  rcases (Filter.eventually_atTop.1 hevent) with ⟨count, hcount⟩
  refine ⟨max count 1, lt_of_lt_of_le (by norm_num) (Nat.le_max_right _ _), ?_⟩
  exact hcount _ (Nat.le_max_left _ _)

/-- For a fixed cutoff and confidence allocation, the critical-dimensional
compact head schedule vanishes with the batch count. -/
theorem tendsto_selectedShellGeometricHeadSchedule_dimensionTwo_nhds_zero
    (cutoff : ℕ) (confidence tailConstant : ℝ) :
    Filter.Tendsto
      (fun count : ℕ => selectedShellGeometricHeadSchedule_dimensionTwo
        cutoff count confidence tailConstant)
      Filter.atTop (nhds 0) := by
  let centralConstant : ℝ := 32 * Real.sqrt 2 +
    2 * Real.sqrt 2 * Real.sqrt (confidence + Real.log 2)
  let successorConstant : ℝ := 32 * Real.sqrt 2 +
    2 * Real.sqrt 2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)
  let centralCount : ℝ := 2 * Real.sqrt 2 *
    (16 * ((2 ^ 2 : ℕ) : ℝ) + 8 * (confidence + Real.log 2))
  let successorCount : ℝ := 16 * ((2 ^ 2 : ℕ) : ℝ) +
    8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)
  let tail : ℝ := 4 * Real.sqrt tailConstant
  have hcount : Filter.Tendsto (fun count : ℕ => (count : ℝ)) Filter.atTop Filter.atTop :=
    tendsto_natCast_atTop_atTop
  have hsqrtCount : Filter.Tendsto (fun count : ℕ => Real.sqrt (count : ℝ))
      Filter.atTop Filter.atTop :=
    Real.tendsto_sqrt_atTop.comp hcount
  have hdiv : ∀ constant : ℝ,
      Filter.Tendsto (fun count : ℕ => constant / (count : ℝ)) Filter.atTop (nhds 0) := by
    intro constant
    exact Filter.Tendsto.const_div_atTop hcount constant
  have hdivSqrt : ∀ constant : ℝ,
      Filter.Tendsto (fun count : ℕ => constant / Real.sqrt (count : ℝ))
        Filter.atTop (nhds 0) := by
    intro constant
    exact Filter.Tendsto.const_div_atTop hsqrtCount constant
  have hdepth := tendsto_dyadicEffectiveCountDepth_two_div_sqrt_nat_nhds_zero
  have hcentralSum : Filter.Tendsto (fun count : ℕ =>
      centralConstant / Real.sqrt (count : ℝ) +
        4 * ((Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
          Real.sqrt (count : ℝ))) Filter.atTop (nhds 0) := by
    simpa using (hdivSqrt centralConstant).add (hdepth.const_mul 4)
  have hsuccessorSum : Filter.Tendsto (fun count : ℕ =>
      successorConstant / Real.sqrt (count : ℝ) +
        4 * ((Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16) : ℝ) /
          Real.sqrt (count : ℝ))) Filter.atTop (nhds 0) := by
    simpa using (hdivSqrt successorConstant).add (hdepth.const_mul 4)
  have hcentralFirstReal : Filter.Tendsto (fun count : ℕ =>
      (32 * Real.sqrt 2 +
        4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16)) +
        2 * Real.sqrt 2 * Real.sqrt (confidence + Real.log 2)) / Real.sqrt (count : ℝ))
      Filter.atTop (nhds 0) := by
    refine Filter.Tendsto.congr' ?_ hcentralSum
    filter_upwards with count
    dsimp [centralConstant]
    ring
  have hcentralFirst : Filter.Tendsto (fun count : ℕ => ENNReal.ofReal
      ((32 * Real.sqrt 2 +
        4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16)) +
        2 * Real.sqrt 2 * Real.sqrt (confidence + Real.log 2)) / Real.sqrt (count : ℝ)))
      Filter.atTop (nhds 0) := by
    simpa only [Function.comp_apply, ENNReal.ofReal_zero] using
      (ENNReal.continuous_ofReal.tendsto (0 : ℝ)).comp hcentralFirstReal
  have hcentralSecondReal : Filter.Tendsto (fun count : ℕ => centralCount / (count : ℝ))
      Filter.atTop (nhds 0) := hdiv centralCount
  have hcentralSecond : Filter.Tendsto (fun count : ℕ => ENNReal.ofReal
      (2 * Real.sqrt 2 *
        ((16 * ((2 ^ 2 : ℕ) : ℝ) + 8 * (confidence + Real.log 2)) / (count : ℝ))))
      Filter.atTop (nhds 0) := by
    have hreal : Filter.Tendsto (fun count : ℕ => 2 * Real.sqrt 2 *
        ((16 * ((2 ^ 2 : ℕ) : ℝ) + 8 * (confidence + Real.log 2)) / (count : ℝ)))
        Filter.atTop (nhds 0) := by
      refine Filter.Tendsto.congr' ?_ hcentralSecondReal
      filter_upwards with count
      dsimp [centralCount]
      ring
    simpa only [Function.comp_apply, ENNReal.ofReal_zero] using
      (ENNReal.continuous_ofReal.tendsto (0 : ℝ)).comp hreal
  have hsuccessorFirstReal : Filter.Tendsto (fun count : ℕ =>
      ((32 * Real.sqrt 2 +
        4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16)) +
        2 * Real.sqrt 2 *
          Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) /
          Real.sqrt (count : ℝ)) * tail) Filter.atTop (nhds 0) := by
    have hbase : Filter.Tendsto (fun count : ℕ =>
        (32 * Real.sqrt 2 +
          4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16)) +
          2 * Real.sqrt 2 *
            Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) /
            Real.sqrt (count : ℝ)) Filter.atTop (nhds 0) := by
      refine Filter.Tendsto.congr' ?_ hsuccessorSum
      filter_upwards with count
      dsimp [successorConstant]
      ring
    simpa using hbase.mul_const tail
  have hsuccessorFirst : Filter.Tendsto (fun count : ℕ => ENNReal.ofReal
      (((32 * Real.sqrt 2 +
        4 * (Math.dyadicEffectiveCountDepth 2 ((count : ℝ) / 16)) +
        2 * Real.sqrt 2 *
          Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) /
          Real.sqrt (count : ℝ)) * tail)) Filter.atTop (nhds 0) := by
    simpa only [Function.comp_apply, ENNReal.ofReal_zero] using
      (ENNReal.continuous_ofReal.tendsto (0 : ℝ)).comp hsuccessorFirstReal
  have hroot := tendsto_sqrt_div_nat_nhds_zero successorCount
  let multiplier : ℝ := 2 * Real.sqrt 2
  let transform : ℝ → ℝ≥0∞ := fun x => ENNReal.ofReal (multiplier * x * tail)
  have hscalar : Continuous (fun x : ℝ => multiplier * x * tail) :=
    (continuous_const.mul continuous_id).mul continuous_const
  have htransform : Continuous transform := ENNReal.continuous_ofReal.comp hscalar
  have hlimit := htransform.continuousAt.tendsto.comp hroot
  have htransform_zero : transform 0 = 0 := by simp [transform]
  rw [htransform_zero] at hlimit
  have hsuccessorSecond : Filter.Tendsto (fun count : ℕ => ENNReal.ofReal
      (2 * Real.sqrt 2 * Real.sqrt
        ((16 * ((2 ^ 2 : ℕ) : ℝ) +
          8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / (count : ℝ)) * tail))
      Filter.atTop (nhds 0) := by
    refine Filter.Tendsto.congr' ?_ hlimit
    filter_upwards with count
    dsimp [successorCount, multiplier, transform, Function.comp_apply]
  unfold selectedShellGeometricHeadSchedule_dimensionTwo
  simpa only [tail, add_zero] using
    (hcentralFirst.add hcentralSecond).add (hsuccessorFirst.add hsuccessorSecond)

/-- A fixed critical-dimensional source head can be made smaller than any
positive deterministic tolerance by a positive finite batch count. -/
theorem exists_pos_selectedShellGeometricHeadSchedule_dimensionTwo_lt_of_pos
    (cutoff : ℕ) (confidence tailConstant : ℝ) {tolerance : ℝ}
    (htolerance : 0 < tolerance) :
    ∃ count : ℕ, 0 < count ∧
      selectedShellGeometricHeadSchedule_dimensionTwo cutoff count confidence tailConstant <
        ENNReal.ofReal tolerance := by
  have htarget : 0 < ENNReal.ofReal tolerance := ENNReal.ofReal_pos.mpr htolerance
  have hevent : ∀ᶠ count : ℕ in Filter.atTop,
      selectedShellGeometricHeadSchedule_dimensionTwo cutoff count confidence tailConstant <
        ENNReal.ofReal tolerance :=
    tendsto_selectedShellGeometricHeadSchedule_dimensionTwo_nhds_zero
      cutoff confidence tailConstant (isOpen_Iio.mem_nhds htarget)
  rcases (Filter.eventually_atTop.1 hevent) with ⟨count, hcount⟩
  refine ⟨max count 1, lt_of_lt_of_le (by norm_num) (Nat.le_max_right _ _), ?_⟩
  exact hcount _ (Nat.le_max_left _ _)

/-- For a fixed cutoff and confidence allocation, the supercritical compact
head schedule vanishes with the batch count. -/
theorem tendsto_selectedShellGeometricHeadSchedule_dimensionGreaterTwo_nhds_zero
    (dimension cutoff : ℕ) (hdimension : 2 < dimension)
    (confidence tailConstant : ℝ) :
    Filter.Tendsto
      (fun count : ℕ => selectedShellGeometricHeadSchedule_dimensionGreaterTwo
        dimension cutoff count confidence tailConstant)
      Filter.atTop (nhds 0) := by
  let power : ℝ := (dimension : ℝ)⁻¹
  let common : ℝ := 2 * Real.sqrt dimension +
    Real.sqrt dimension * Real.sqrt 2 /
      (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))
  let scale : ℝ := (16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ power
  let centralRoot : ℝ := 2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)
  let successorRoot : ℝ := 2 * Real.sqrt dimension *
    Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)
  let centralCount : ℝ := 2 * Real.sqrt dimension *
    (16 * ((2 ^ dimension : ℕ) : ℝ) + 8 * (confidence + Real.log 2))
  let successorCount : ℝ := 16 * ((2 ^ dimension : ℕ) : ℝ) +
    8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)
  let tail : ℝ := 4 * Real.sqrt tailConstant
  have hdimensionReal : 0 < (dimension : ℝ) := by
    exact_mod_cast (lt_trans (by norm_num : 0 < 2) hdimension)
  have hpower : 0 < power := by
    dsimp [power]
    exact inv_pos.mpr hdimensionReal
  have hcount : Filter.Tendsto (fun count : ℕ => (count : ℝ)) Filter.atTop Filter.atTop :=
    tendsto_natCast_atTop_atTop
  have hpowCount : Filter.Tendsto (fun count : ℕ => (count : ℝ) ^ power)
      Filter.atTop Filter.atTop :=
    tendsto_rpow_atTop hpower |>.comp hcount
  have hscaleDiv : Filter.Tendsto (fun count : ℕ => scale / (count : ℝ) ^ power)
      Filter.atTop (nhds 0) := Filter.Tendsto.const_div_atTop hpowCount scale
  have hsqrtCount : Filter.Tendsto (fun count : ℕ => Real.sqrt (count : ℝ))
      Filter.atTop Filter.atTop :=
    Real.tendsto_sqrt_atTop.comp hcount
  have hdivSqrt : ∀ constant : ℝ,
      Filter.Tendsto (fun count : ℕ => constant / Real.sqrt (count : ℝ))
        Filter.atTop (nhds 0) := by
    intro constant
    exact Filter.Tendsto.const_div_atTop hsqrtCount constant
  have hdiv : ∀ constant : ℝ,
      Filter.Tendsto (fun count : ℕ => constant / (count : ℝ))
        Filter.atTop (nhds 0) := by
    intro constant
    exact Filter.Tendsto.const_div_atTop hcount constant
  have hcentralBase : Filter.Tendsto (fun count : ℕ =>
      common * (scale / (count : ℝ) ^ power) +
        centralRoot / Real.sqrt (count : ℝ)) Filter.atTop (nhds 0) := by
    simpa using (hscaleDiv.const_mul common).add (hdivSqrt centralRoot)
  have hsuccessorBase : Filter.Tendsto (fun count : ℕ =>
      common * (scale / (count : ℝ) ^ power) +
        successorRoot / Real.sqrt (count : ℝ)) Filter.atTop (nhds 0) := by
    simpa using (hscaleDiv.const_mul common).add (hdivSqrt successorRoot)
  have hcentralFirst : Filter.Tendsto (fun count : ℕ => ENNReal.ofReal
      ((2 * Real.sqrt dimension +
        Real.sqrt dimension * Real.sqrt 2 /
          (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
        ((16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹) /
          (count : ℝ) ^ ((dimension : ℝ)⁻¹)) +
        (2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)) /
          Real.sqrt count)) Filter.atTop (nhds 0) := by
    have hreal : Filter.Tendsto (fun count : ℕ =>
        ((2 * Real.sqrt dimension +
          Real.sqrt dimension * Real.sqrt 2 /
            (4 * (Real.sqrt ((2 ^ dimension : ℕ) : ℝ) / 2 - 1))) *
          ((16 * ((2 ^ dimension : ℕ) : ℝ) ^ 2) ^ ((dimension : ℝ)⁻¹) /
            (count : ℝ) ^ ((dimension : ℝ)⁻¹)) +
          (2 * Real.sqrt dimension * Real.sqrt (confidence + Real.log 2)) /
            Real.sqrt count)) Filter.atTop (nhds 0) := by
      refine Filter.Tendsto.congr' ?_ hcentralBase
      filter_upwards with count
      dsimp [common, scale, centralRoot, power]
    simpa only [Function.comp_apply, ENNReal.ofReal_zero] using
      (ENNReal.continuous_ofReal.tendsto (0 : ℝ)).comp hreal
  have hcentralSecond : Filter.Tendsto (fun count : ℕ => ENNReal.ofReal
      (2 * Real.sqrt dimension *
        ((16 * ((2 ^ dimension : ℕ) : ℝ) +
          8 * (confidence + Real.log 2)) / (count : ℝ)))) Filter.atTop (nhds 0) := by
    have hreal : Filter.Tendsto (fun count : ℕ => 2 * Real.sqrt dimension *
        ((16 * ((2 ^ dimension : ℕ) : ℝ) +
          8 * (confidence + Real.log 2)) / (count : ℝ))) Filter.atTop (nhds 0) := by
      refine Filter.Tendsto.congr' ?_ (hdiv centralCount)
      filter_upwards with count
      dsimp [centralCount]
      ring
