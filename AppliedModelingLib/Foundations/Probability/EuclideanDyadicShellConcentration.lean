-/
theorem wassersteinOne_euclideanDyadicCubeShells_le_pOneRelativeMassAndHeadPlusZeroDepthTail
    {count : ℕ} [Nonempty (Fin count)]
    (dimension cutoff : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (sample : Fin count → EuclideanSpace ℝ (Fin dimension))
    {eta deviation alpha gamma : ℝ} (heta_pos : 0 < eta) (hdeviation_nonneg : 0 ≤ deviation)
    (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (hmoment : HasExponentialRadialMoment law alpha gamma)
