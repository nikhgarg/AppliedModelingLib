        have hweight_le := pOneFournierGuillinShellWeight_le_of_le heta_pos hdeviation_pos
          hscale_le_cutoff
        have hfactor_nonneg : 0 ≤ (count : ℝ) * Real.log 9 / 2 := by
          exact div_nonneg
            (mul_nonneg (Nat.cast_nonneg _) (Real.log_nonneg (by norm_num))) (by norm_num)
        have hscaled := mul_le_mul_of_nonneg_right hweight_le hfactor_nonneg
        calc
          sampleLaw.real
              (finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized dimension law count
                (scale + 1)
                (pOneFournierGuillinShellToleranceWithEta eta deviation
                  ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
                    (euclideanDyadicCubeShell dimension (scale + 1))) scale)) ≤
              Real.exp (-((count : ℝ) *
                pOneFournierGuillinShellWeight eta deviation scale * Real.log 9 / 2)) := by
            simpa [sampleLaw] using hsimple
          _ ≤ budget := by
            dsimp [budget]
            apply Real.exp_le_exp.mpr
            nlinarith
    · rw [if_neg hlarge]
      simpa using hbudget_nonneg
  calc
    (finiteIIDSampleLaw (law : Measure (EuclideanSpace ℝ (Fin dimension))) count).real
        (⋃ scale ∈ Finset.range cutoff,
          pOneFournierGuillinLargeShellMassTailWithEta dimension law count eta deviation scale) =
