/--
On a sample outside every realized compact shell-W₁ tail, the global source
shell coupling bound can replace each occupied shell's local W₁ cost by its
scaled finite-depth compact budget.  The shell-mass discrepancy remains
explicit; it is the separate `Z_N` term in Fournier--Guillin Section 6.
-/
def finiteIIDCompactShellDyadicWassersteinBudget
    (dimension : ℕ) (depth : ℕ → ℕ) (threshold : ℕ → ℕ → ℝ) (shell : ℕ) : ℝ≥0∞ :=
  ((NNReal.mk (euclideanDyadicCubeRadius shell)
    (euclideanDyadicCubeRadius_pos shell).le : NNReal) : ℝ≥0∞) *
    ENNReal.ofReal (dyadicMultiscaleThresholdBound dimension
      (depth shell) (threshold shell))

/--
The explicit real-effective-count upper budget for one source shell under the
selected geometric confidence allocation.
-/
def selectedShellGeometricCompactTwoTermBudget
    (dimension count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (depth : ℕ → ℕ) (confidence : ℝ) (shell : ℕ) : ℝ≥0∞ :=
  ENNReal.ofReal (euclideanDyadicCubeRadius shell) *
    ENNReal.ofReal
      (2 * dyadicCubeRadius dimension (depth shell) +
        ∑ level ∈ Finset.range (depth shell),
          dyadicCubeStepRadius dimension level *
            (2 * (Real.sqrt
                (2 * ((2 ^ (dimension * (level + 1)) : ℕ) : ℝ)) +
              Real.sqrt (selectedShellGeometricConfidence confidence shell)) /
              Real.sqrt ((count : ℝ) *
                ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
                  (euclideanDyadicCubeShell dimension shell)))))

/--
The exact finite-depth compact budget under the selected geometric shell
threshold.  Unlike the two-term envelope, this preserves the threshold in
the reusable multiscale expression so that dimension-specific compact-rate
theorems can be applied without discarding a factor before the source-shell
sum is estimated.
-/
def selectedShellGeometricCompactBudget
    (dimension count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (depth : ℕ → ℕ) (confidence : ℝ) (shell : ℕ) : ℝ≥0∞ :=
  ENNReal.ofReal (euclideanDyadicCubeRadius shell) *
    ENNReal.ofReal (dyadicMultiscaleThresholdBound dimension (depth shell)
      (fun level => selectedShellDyadicGeometricConfidenceThreshold
        dimension count level
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension shell))
          (selectedShellGeometricConfidence confidence shell)))

/--
The realized finite-depth compact transport budget is definitionally the
exact selected-shell multiscale budget.  The equality keeps the later
dimension-specific rate calculation at the sharp deterministic surface.
-/
theorem finiteIIDCompactShellDyadicWassersteinBudget_eq_selectedShellGeometricCompactBudget
    (dimension shell count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (depth : ℕ → ℕ) (confidence : ℝ) :
    finiteIIDCompactShellDyadicWassersteinBudget dimension depth
      (fun sourceShell level => selectedShellDyadicGeometricConfidenceThreshold
        dimension count level
          ((law : Measure (EuclideanSpace ℝ (Fin dimension))).real
            (euclideanDyadicCubeShell dimension sourceShell))
          (selectedShellGeometricConfidence confidence sourceShell)) shell =
      selectedShellGeometricCompactBudget dimension count law depth confidence shell := by
  unfold finiteIIDCompactShellDyadicWassersteinBudget
    selectedShellGeometricCompactBudget
  rw [ENNReal.coe_nnreal_eq]
  simp

/--
The exact selected-shell compact budget in dimension one inherits the
subcritical real-effective-count dyadic bound.  It is stated before summing
source shells so the later radial-moment calculation can retain its natural
shell mass factors.
-/
theorem selectedShellGeometricCompactBudget_dimensionOne_le
    (shell count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin 1)))
    (depth : ℕ → ℕ) (confidence : ℝ)
    (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (hshellMass : 0 < (law : Measure (EuclideanSpace ℝ (Fin 1))).real
      (euclideanDyadicCubeShell 1 shell)) :
    selectedShellGeometricCompactBudget 1 count law depth confidence shell ≤
      ENNReal.ofReal (euclideanDyadicCubeRadius shell) * ENNReal.ofReal
        (2 / ((2 ^ (depth shell) : ℕ) : ℝ) +
          (2 / Real.sqrt ((count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 shell)))) *
              (1 / (1 - 1 / Real.sqrt 2)) +
          2 * Real.sqrt (selectedShellGeometricConfidence confidence shell) /
            Real.sqrt ((count : ℝ) *
              ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
                (euclideanDyadicCubeShell 1 shell)))) := by
  have hconfidenceAt : 0 ≤ selectedShellGeometricConfidence confidence shell := by
    unfold selectedShellGeometricConfidence
    exact add_nonneg hconfidence
      (mul_nonneg (by positivity) (Real.log_nonneg (by norm_num)))
  unfold selectedShellGeometricCompactBudget
  apply mul_le_mul_left'
  apply ENNReal.ofReal_le_ofReal
  rw [show (fun level => selectedShellDyadicGeometricConfidenceThreshold
      1 count level
        ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
          (euclideanDyadicCubeShell 1 shell))
        (selectedShellGeometricConfidence confidence shell)) =
      (fun level => dyadicGeometricConfidenceThresholdReal 1 level
        ((count : ℝ) * ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
          (euclideanDyadicCubeShell 1 shell)) )
        (selectedShellGeometricConfidence confidence shell)) by
      funext level
      exact selectedShellDyadicGeometricConfidenceThreshold_eq_realEffectiveCount
        1 count level _ _]
  exact dyadicDimensionOneGeometricConfidenceBoundReal_le (depth shell)
    (mul_pos (by exact_mod_cast hcount) hshellMass) hconfidenceAt

/--
On an active positive-mass one-dimensional source shell, the exact selected
compact budget has an inverse-count terminal contribution and a square-root
source-mass contribution.  This is the local rate form used before summing a
finite noncentral head.
-/
theorem euclideanDyadicCubeShellMass_mul_selectedShellGeometricCompactBudget_dimensionOne_active_le
    (shell count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin 1)))
    (confidence : ℝ) (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (hshellMass : 0 < (law : Measure (EuclideanSpace ℝ (Fin 1))).real
      (euclideanDyadicCubeShell 1 shell))
    (hactive : 16 * ((2 ^ 1 : ℕ) : ℝ) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 shell)) ∧
        8 * selectedShellGeometricConfidence confidence shell ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 shell))) :
    euclideanDyadicCubeShellMass 1 law shell *
        selectedShellGeometricCompactBudget 1 count law
          (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence shell ≤
      ENNReal.ofReal (euclideanDyadicCubeRadius shell) * ENNReal.ofReal
        (128 / (count : ℝ) +
          (2 * (1 / (1 - 1 / Real.sqrt 2)) +
            2 * Real.sqrt (selectedShellGeometricConfidence confidence shell)) *
            Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 shell)) / Real.sqrt count) := by
  let mass : ℝ := (law : Measure (EuclideanSpace ℝ (Fin 1))).real
    (euclideanDyadicCubeShell 1 shell)
  let depth := selectedShellGeometricEffectiveDepth 1 count law confidence
  let envelope : ℝ :=
    2 / ((2 ^ (depth shell) : ℕ) : ℝ) +
      (2 / Real.sqrt ((count : ℝ) * mass)) * (1 / (1 - 1 / Real.sqrt 2)) +
      2 * Real.sqrt (selectedShellGeometricConfidence confidence shell) /
        Real.sqrt ((count : ℝ) * mass)
  let rate : ℝ := 128 / (count : ℝ) +
    (2 * (1 / (1 - 1 / Real.sqrt 2)) +
      2 * Real.sqrt (selectedShellGeometricConfidence confidence shell)) *
        Real.sqrt mass / Real.sqrt count
  have hconfidenceAt : 0 ≤ selectedShellGeometricConfidence confidence shell := by
    unfold selectedShellGeometricConfidence
    exact add_nonneg hconfidence
      (mul_nonneg (by positivity) (Real.log_nonneg (by norm_num)))
  have hlocal :
      selectedShellGeometricCompactBudget 1 count law depth confidence shell ≤
        ENNReal.ofReal (euclideanDyadicCubeRadius shell) * ENNReal.ofReal envelope := by
    dsimp [depth, envelope]
    exact selectedShellGeometricCompactBudget_dimensionOne_le shell count law
      (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence
      hcount hconfidence hshellMass
  have hactive' : 16 * ((2 ^ 1 : ℕ) : ℝ) ≤ (count : ℝ) * mass ∧
      8 * selectedShellGeometricConfidence confidence shell ≤ (count : ℝ) * mass := by
    simpa [mass] using hactive
  have hrate : mass * envelope < rate := by
    dsimp [mass, depth, envelope, rate]
    simpa [selectedShellGeometricEffectiveDepth] using
      (Math.mass_mul_dyadicDimensionOne_activeEnvelope_lt
        (count := (count : ℝ)) (mass :=
          (law : Measure (EuclideanSpace ℝ (Fin 1))).real
            (euclideanDyadicCubeShell 1 shell))
        (confidence := selectedShellGeometricConfidence confidence shell)
        (by exact_mod_cast hcount) hshellMass hactive')
  have hmassENN : euclideanDyadicCubeShellMass 1 law shell = ENNReal.ofReal mass := by
    dsimp [mass, euclideanDyadicCubeShellMass]
    symm
    exact MeasureTheory.ofReal_measureReal (by finiteness)
  have hmass_nonneg : 0 ≤ mass := by
    dsimp [mass]
    exact MeasureTheory.measureReal_nonneg
  change euclideanDyadicCubeShellMass 1 law shell *
      selectedShellGeometricCompactBudget 1 count law depth confidence shell ≤
    ENNReal.ofReal (euclideanDyadicCubeRadius shell) * ENNReal.ofReal rate
  calc
    euclideanDyadicCubeShellMass 1 law shell *
        selectedShellGeometricCompactBudget 1 count law depth confidence shell ≤
        euclideanDyadicCubeShellMass 1 law shell *
          (ENNReal.ofReal (euclideanDyadicCubeRadius shell) * ENNReal.ofReal envelope) :=
      mul_le_mul_left' hlocal _
    _ = ENNReal.ofReal (euclideanDyadicCubeRadius shell) *
        (ENNReal.ofReal mass * ENNReal.ofReal envelope) := by
      rw [hmassENN]
      ac_rfl
    _ = ENNReal.ofReal (euclideanDyadicCubeRadius shell) *
        ENNReal.ofReal (mass * envelope) := by
      rw [← ENNReal.ofReal_mul hmass_nonneg]
    _ ≤ ENNReal.ofReal (euclideanDyadicCubeRadius shell) * ENNReal.ofReal rate :=
      mul_le_mul_left' (ENNReal.ofReal_le_ofReal hrate.le) _

/--
The active one-dimensional local budget is uniform over a finite noncentral
head after replacing its geometric confidence allocation by the head-terminal
allocation.  This makes its square-root source-mass term summable.
-/
theorem euclideanDyadicCubeShellMass_mul_selectedShellGeometricCompactBudget_dimensionOne_active_succ_le_headConfidence
    (cutoff scale count : ℕ)
    (law : ProbabilityMeasure (EuclideanSpace ℝ (Fin 1)))
    (confidence : ℝ) (hcount : 0 < count) (hconfidence : 0 ≤ confidence)
    (hscale : scale ∈ Finset.range cutoff)
    (hshellMass : 0 < (law : Measure (EuclideanSpace ℝ (Fin 1))).real
      (euclideanDyadicCubeShell 1 (scale + 1)))
    (hactive : 16 * ((2 ^ 1 : ℕ) : ℝ) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 (scale + 1))) ∧
        8 * selectedShellGeometricConfidence confidence (scale + 1) ≤
          (count : ℝ) *
            ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 (scale + 1)))) :
    euclideanDyadicCubeShellMass 1 law (scale + 1) *
        selectedShellGeometricCompactBudget 1 count law
          (selectedShellGeometricEffectiveDepth 1 count law confidence) confidence (scale + 1) ≤
      ENNReal.ofReal (euclideanDyadicCubeRadius (scale + 1)) * ENNReal.ofReal
        (128 / (count : ℝ) +
          (2 * (1 / (1 - 1 / Real.sqrt 2)) +
            2 * Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2)) *
            Real.sqrt ((law : Measure (EuclideanSpace ℝ (Fin 1))).real
              (euclideanDyadicCubeShell 1 (scale + 1))) / Real.sqrt count) := by
  have hlocal :=
    euclideanDyadicCubeShellMass_mul_selectedShellGeometricCompactBudget_dimensionOne_active_le
      (scale + 1) count law confidence hcount hconfidence hshellMass hactive
  have hconfidenceHead :=
    selectedShellGeometricConfidence_succ_le_headConfidence confidence cutoff scale hscale
  have hsqrtConfidence :
      Real.sqrt (selectedShellGeometricConfidence confidence (scale + 1)) ≤
        Real.sqrt (confidence + (cutoff + 1 : ℝ) * Real.log 2) :=
