      (count : ℝ) * shellMass * ((1 / 2 : ℝ) * z * Real.log z) =
        (count : ℝ) * deviation / (4 * (4 : ℝ) ^ scale) * Real.log z := by
    calc
      (count : ℝ) * shellMass * ((1 / 2 : ℝ) * z * Real.log z) =
          (count : ℝ) * (shellMass * z) / 2 * Real.log z := by ring
      _ = (count : ℝ) * deviation / (4 * (4 : ℝ) ^ scale) * Real.log z := by
        rw [hmass_z]
