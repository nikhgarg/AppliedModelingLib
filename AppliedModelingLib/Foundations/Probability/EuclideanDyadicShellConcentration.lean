      simpa [sourceTerm] using hsourceSum
    _ = ENNReal.ofReal
        (2 *
          (Real.sqrt threshold *
            (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma)))) := by
      rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2)]
    _ = ENNReal.ofReal
        (2 * Real.sqrt
          ((16 * ((2 ^ 1 : ℕ) : ℝ) +
            8 * (confidence + (cutoff + 1 : ℝ) * Real.log 2)) / (count : ℝ)) *
          (4 * Real.sqrt (fifthOrderExponentialRadialTailConstant law alpha gamma))) := by
      congr 1
      dsimp [threshold]
      ring

