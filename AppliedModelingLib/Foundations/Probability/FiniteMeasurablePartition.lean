        rw [exp_neg_mul_normalizedLogKernelRate_eq_of_pos
          (F := kernel) hn x hx]
      simpa [IntegrableOn] using hkernel_int_restrict.congr hcongr.symm
  exact
    setIntegral_weightedKernel_hasExponentialRate_of_dominating_subfamily_restrict_closure_interior_normalizedLogRate_tendsto_on_pieces_eventually
      P weight kernel phi rate W c selectAdjacent hkernel_int hlaplace_int
      (fun piece => Eventually.of_forall fun n => hkernel_pos n piece)
      hWpos hcpos hweight_lower hweight_bound x0 hmin hx0 hcont
      hclosure huniform minAdjacent hadj_min hadj_dominates

/--
Compact-local version of the piece-restricted normalized-log theorem.  For
each partition piece it is enough to give a compact superset and local uniform
normalized-log estimates on that compact set; compactness supplies the finite
subcover needed for uniform convergence on the piece.
-/
theorem setIntegral_weightedKernel_hasExponentialRate_of_dominating_subfamily_restrict_closure_interior_normalizedLogRate_tendsto_of_locally_on_compact_supersets
    [TopologicalSpace α] [OpensMeasurableSpace α]
    (P : FiniteMeasurableSetPartition μ Piece)
    [IsFiniteMeasure μ] [Measure.IsOpenPosMeasure μ]
    (weight : α → ℝ) (kernel : ℕ → α → ℝ)
    (phi : Piece → α → ℝ)
    (rate W c : Piece → ℝ)
    (selectAdjacent : Adjacent → Piece)
    (K : Piece → Set α)
    (hKcompact : ∀ piece, IsCompact (K piece))
    (hpiece_subset : ∀ piece, P.pieceSet piece ⊆ K piece)
    (hkernel_int :
      ∀ n piece,
        IntegrableOn (fun x : α => weight x * kernel n x)
          (P.pieceSet piece) μ)
    (hweight_int :
      ∀ piece, IntegrableOn weight (P.pieceSet piece) μ)
    (hkernel_pos :
      ∀ n piece,
        ∀ᵐ x ∂μ.restrict (P.pieceSet piece), 0 < kernel n x)
    (hWpos : ∀ piece, 0 < W piece)
    (hcpos : ∀ piece, 0 < c piece)
    (hweight_lower :
      ∀ piece, ∀ᵐ x ∂μ.restrict (P.pieceSet piece), c piece ≤ weight x)
    (hweight_bound :
      ∀ piece, ∀ᵐ x ∂μ.restrict (P.pieceSet piece), weight x ≤ W piece)
    (x0 : Piece → α)
    (hmin :
      ∀ piece x, x ∈ P.pieceSet piece → rate piece ≤ phi piece x)
    (hx0 : ∀ piece, phi piece (x0 piece) = rate piece)
    (hcont : ∀ piece, ContinuousAt (phi piece) (x0 piece))
    (hclosure :
      ∀ piece, x0 piece ∈ closure (interior (P.pieceSet piece)))
    (hlocal_uniform :
      ∀ piece, ∀ x : α, x ∈ K piece → ∀ ε > 0,
        ∃ U : Set α,
          IsOpen U ∧ x ∈ U ∧
            ∀ᶠ n : ℕ in atTop,
              ∀ y : α, y ∈ K piece → y ∈ U →
                |normalizedLogKernelRate kernel n y - phi piece y| ≤ ε)
    (minAdjacent : Adjacent)
    (hadj_min :
      ∀ adj : Adjacent,
        rate (selectAdjacent minAdjacent) ≤ rate (selectAdjacent adj))
    (hadj_dominates :
      ∀ piece : Piece,
        ∃ adj : Adjacent, rate (selectAdjacent adj) ≤ rate piece) :
    HasExponentialRate
      (fun n : ℕ =>
        ∫ x in P.support, weight x * kernel n x ∂μ)
      (rate (selectAdjacent minAdjacent)) := by
  refine
    setIntegral_weightedKernel_hasExponentialRate_of_dominating_subfamily_restrict_closure_interior_normalizedLogRate_tendsto_on_pieces
      P weight kernel phi rate W c selectAdjacent hkernel_int hweight_int
      hkernel_pos hWpos hcpos hweight_lower hweight_bound x0 hmin hx0
      hcont hclosure ?_ minAdjacent hadj_min hadj_dominates
  intro piece ε hε
  exact
    AppliedModelingLib.Math.eventually_uniform_abs_sub_le_on_subset_of_eventually_local_uniform_on_compact
      (s := P.pieceSet piece) (K := K piece) (hKcompact piece)
      (hpiece_subset piece)
      (F := fun n x => normalizedLogKernelRate kernel n x)
      (f := phi piece)
      (hlocal_uniform piece) ε hε

/--
Constant-factor exponential-sandwich version of the piece-restricted
normalized-log theorem.  This is the most common interface for
distribution-specific Cramer/Chernoff work: prove uniform upper and lower
exponential envelopes on each partition piece, then the normalized-log
Laplace hypothesis follows automatically.
-/
theorem setIntegral_weightedKernel_hasExponentialRate_of_dominating_subfamily_restrict_closure_interior_exp_sandwich_const_on_pieces
    [TopologicalSpace α] [OpensMeasurableSpace α]
    (P : FiniteMeasurableSetPartition μ Piece)
    [IsFiniteMeasure μ] [Measure.IsOpenPosMeasure μ]
    (weight : α → ℝ) (kernel : ℕ → α → ℝ)
    (phi : Piece → α → ℝ)
    (rate W c lowerConst upperConst : Piece → ℝ)
    (selectAdjacent : Adjacent → Piece)
    (hkernel_int :
      ∀ n piece,
        IntegrableOn (fun x : α => weight x * kernel n x)
          (P.pieceSet piece) μ)
    (hweight_int :
      ∀ piece, IntegrableOn weight (P.pieceSet piece) μ)
    (hkernel_pos :
      ∀ n piece,
        ∀ᵐ x ∂μ.restrict (P.pieceSet piece), 0 < kernel n x)
    (hWpos : ∀ piece, 0 < W piece)
    (hcpos : ∀ piece, 0 < c piece)
    (hlowerConst_pos : ∀ piece, 0 < lowerConst piece)
    (hupperConst_pos : ∀ piece, 0 < upperConst piece)
    (hweight_lower :
      ∀ piece, ∀ᵐ x ∂μ.restrict (P.pieceSet piece), c piece ≤ weight x)
    (hweight_bound :
      ∀ piece, ∀ᵐ x ∂μ.restrict (P.pieceSet piece), weight x ≤ W piece)
    (x0 : Piece → α)
    (hmin :
      ∀ piece x, x ∈ P.pieceSet piece → rate piece ≤ phi piece x)
    (hx0 : ∀ piece, phi piece (x0 piece) = rate piece)
    (hcont : ∀ piece, ContinuousAt (phi piece) (x0 piece))
    (hclosure :
      ∀ piece, x0 piece ∈ closure (interior (P.pieceSet piece)))
    (hlower :
      ∀ piece, ∀ ε > 0, ∀ᶠ n : ℕ in atTop,
        ∀ x : α, x ∈ P.pieceSet piece →
          lowerConst piece * Real.exp (-(n : ℝ) * (phi piece x + ε)) ≤
            kernel n x)
    (hupper :
      ∀ piece, ∀ ε > 0, ∀ᶠ n : ℕ in atTop,
        ∀ x : α, x ∈ P.pieceSet piece →
          kernel n x ≤
            upperConst piece * Real.exp (-(n : ℝ) * (phi piece x - ε)))
    (minAdjacent : Adjacent)
    (hadj_min :
      ∀ adj : Adjacent,
        rate (selectAdjacent minAdjacent) ≤ rate (selectAdjacent adj))
    (hadj_dominates :
      ∀ piece : Piece,
        ∃ adj : Adjacent, rate (selectAdjacent adj) ≤ rate piece) :
    HasExponentialRate
      (fun n : ℕ =>
        ∫ x in P.support, weight x * kernel n x ∂μ)
      (rate (selectAdjacent minAdjacent)) := by
  refine
    setIntegral_weightedKernel_hasExponentialRate_of_dominating_subfamily_restrict_closure_interior_normalizedLogRate_tendsto_on_pieces
      P weight kernel phi rate W c selectAdjacent hkernel_int hweight_int
      hkernel_pos hWpos hcpos hweight_lower hweight_bound x0 hmin hx0
      hcont hclosure ?_ minAdjacent hadj_min hadj_dominates
  intro piece ε hε
  exact
    normalizedLogKernelRate_uniform_on_of_exp_sandwich_const
      (s := P.pieceSet piece) (F := kernel) (rate := phi piece)
      (hlowerConst_pos piece) (hupperConst_pos piece)
      (hlower piece) (hupper piece) ε hε

/--
Certificate form of
`setIntegral_weightedKernel_hasExponentialRate_of_dominating_subfamily_restrict_closure_interior_exp_sandwich_const_on_pieces`.
Each partition cell supplies a uniform exponential-rate sandwich for its
kernel/rate pair.
-/
theorem setIntegral_weightedKernel_hasExponentialRate_of_dominating_subfamily_restrict_closure_interior_uniformExponentialRateCertificate_on_pieces
    [TopologicalSpace α] [OpensMeasurableSpace α]
    (P : FiniteMeasurableSetPartition μ Piece)
    [IsFiniteMeasure μ] [Measure.IsOpenPosMeasure μ]
    (weight : α → ℝ) (kernel : ℕ → α → ℝ)
    (phi : Piece → α → ℝ)
    (rate W c : Piece → ℝ)
    (selectAdjacent : Adjacent → Piece)
    (hkernel_int :
      ∀ n piece,
        IntegrableOn (fun x : α => weight x * kernel n x)
          (P.pieceSet piece) μ)
    (hweight_int :
      ∀ piece, IntegrableOn weight (P.pieceSet piece) μ)
    (hkernel_pos :
      ∀ n piece,
        ∀ᵐ x ∂μ.restrict (P.pieceSet piece), 0 < kernel n x)
    (hWpos : ∀ piece, 0 < W piece)
    (hcpos : ∀ piece, 0 < c piece)
    (hweight_lower :
      ∀ piece, ∀ᵐ x ∂μ.restrict (P.pieceSet piece), c piece ≤ weight x)
    (hweight_bound :
      ∀ piece, ∀ᵐ x ∂μ.restrict (P.pieceSet piece), weight x ≤ W piece)
    (x0 : Piece → α)
    (hmin :
      ∀ piece x, x ∈ P.pieceSet piece → rate piece ≤ phi piece x)
    (hx0 : ∀ piece, phi piece (x0 piece) = rate piece)
    (hcont : ∀ piece, ContinuousAt (phi piece) (x0 piece))
    (hclosure :
      ∀ piece, x0 piece ∈ closure (interior (P.pieceSet piece)))
    (hcert :
      ∀ piece,
        UniformExponentialRateCertificateOn kernel (phi piece)
          (P.pieceSet piece))
    (minAdjacent : Adjacent)
    (hadj_min :
      ∀ adj : Adjacent,
        rate (selectAdjacent minAdjacent) ≤ rate (selectAdjacent adj))
    (hadj_dominates :
      ∀ piece : Piece,
        ∃ adj : Adjacent, rate (selectAdjacent adj) ≤ rate piece) :
    HasExponentialRate
      (fun n : ℕ =>
        ∫ x in P.support, weight x * kernel n x ∂μ)
      (rate (selectAdjacent minAdjacent)) := by
  refine
    setIntegral_weightedKernel_hasExponentialRate_of_dominating_subfamily_restrict_closure_interior_exp_sandwich_const_on_pieces
      P weight kernel phi rate W c
      (fun piece => (hcert piece).lowerConst)
      (fun piece => (hcert piece).upperConst)
      selectAdjacent hkernel_int hweight_int hkernel_pos hWpos hcpos
      (fun piece => (hcert piece).lowerConst_pos)
      (fun piece => (hcert piece).upperConst_pos)
      hweight_lower hweight_bound x0 hmin hx0 hcont hclosure ?_ ?_
      minAdjacent hadj_min hadj_dominates
  · intro piece
    exact (hcert piece).lower
  · intro piece
    exact (hcert piece).upper

/--
Eventual-positivity certificate form of the piece-restricted normalized-log
Laplace theorem.  The uniform exponential-rate certificate supplies both the
uniform normalized-log convergence and the eventual positivity needed to
identify `kernel n` with the source-normalized Laplace kernel.
-/
theorem setIntegral_weightedKernel_hasExponentialRate_of_dominating_subfamily_restrict_closure_interior_uniformExponentialRateCertificate_on_pieces_eventually
    [TopologicalSpace α] [OpensMeasurableSpace α]
    (P : FiniteMeasurableSetPartition μ Piece)
    [IsFiniteMeasure μ] [Measure.IsOpenPosMeasure μ]
    (weight : α → ℝ) (kernel : ℕ → α → ℝ)
    (phi : Piece → α → ℝ)
    (rate W c : Piece → ℝ)
    (selectAdjacent : Adjacent → Piece)
    (hkernel_int :
      ∀ n piece,
        IntegrableOn (fun x : α => weight x * kernel n x)
          (P.pieceSet piece) μ)
    (hlaplace_int :
      ∀ n : ℕ, ∀ piece,
        IntegrableOn
          (fun x : α =>
            weight x *
              Real.exp (-(n : ℝ) * normalizedLogKernelRate kernel n x))
          (P.pieceSet piece) μ)
    (hWpos : ∀ piece, 0 < W piece)
    (hcpos : ∀ piece, 0 < c piece)
    (hweight_lower :
      ∀ piece, ∀ᵐ x ∂μ.restrict (P.pieceSet piece), c piece ≤ weight x)
    (hweight_bound :
      ∀ piece, ∀ᵐ x ∂μ.restrict (P.pieceSet piece), weight x ≤ W piece)
    (x0 : Piece → α)
    (hmin :
      ∀ piece x, x ∈ P.pieceSet piece → rate piece ≤ phi piece x)
    (hx0 : ∀ piece, phi piece (x0 piece) = rate piece)
    (hcont : ∀ piece, ContinuousAt (phi piece) (x0 piece))
    (hclosure :
      ∀ piece, x0 piece ∈ closure (interior (P.pieceSet piece)))
    (hcert :
      ∀ piece,
        UniformExponentialRateCertificateOn kernel (phi piece)
          (P.pieceSet piece))
    (minAdjacent : Adjacent)
    (hadj_min :
      ∀ adj : Adjacent,
        rate (selectAdjacent minAdjacent) ≤ rate (selectAdjacent adj))
    (hadj_dominates :
      ∀ piece : Piece,
        ∃ adj : Adjacent, rate (selectAdjacent adj) ≤ rate piece) :
    HasExponentialRate
      (fun n : ℕ =>
        ∫ x in P.support, weight x * kernel n x ∂μ)
      (rate (selectAdjacent minAdjacent)) := by
  refine
    setIntegral_weightedKernel_hasExponentialRate_of_dominating_subfamily_restrict_closure_interior_normalizedLogRate_tendsto_on_pieces_eventually
      P weight kernel phi rate W c selectAdjacent hkernel_int hlaplace_int
      ?_ hWpos hcpos hweight_lower hweight_bound x0 hmin hx0 hcont
      hclosure ?_ minAdjacent hadj_min hadj_dominates
  · intro piece
    filter_upwards [(hcert piece).eventually_pos] with n hn
    exact ae_restrict_of_forall_mem (P.measurable_piece piece) hn
  · intro piece
    exact (hcert piece).normalizedLogKernelRate_uniform

