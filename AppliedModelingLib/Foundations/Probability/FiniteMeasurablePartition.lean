import AppliedModelingLib.Foundations.Math.IntegralConvergence
import AppliedModelingLib.Foundations.Probability.IntegralLargeDeviations
import Mathlib.MeasureTheory.Integral.Bochner.Set
import Mathlib.MeasureTheory.Measure.Prod
import Mathlib.Order.Interval.Set.Union

/-!
# Finite Measurable Partition Integral Decompositions

Reusable wrappers for finite measurable partitions of a support set.  These
lemmas package the common continuous-large-deviation step where an integral
over a continuum is split into finitely many measurable components, each
component receives an exponential-rate certificate, and the whole integral
inherits the minimum component exponent.
-/

open Filter MeasureTheory
open scoped BigOperators

namespace AppliedModelingLib
namespace Probability

noncomputable section

/--
A finite measurable partition of a support set.  The measure parameter is
included so downstream APIs can state integrability and rate facts against the
same measure without carrying a separate partition object.
-/
structure FiniteMeasurableSetPartition
    {α : Type*} [MeasurableSpace α]
    (μ : Measure α) (Piece : Type*) [Fintype Piece] where
  support : Set α
  pieceSet : Piece → Set α
  measurable_piece : ∀ piece, MeasurableSet (pieceSet piece)
  pairwiseDisjoint :
    Pairwise (fun piece₁ piece₂ => Disjoint (pieceSet piece₁) (pieceSet piece₂))
  cover : Set.iUnion pieceSet = support

namespace FiniteMeasurableSetPartition

variable {α Piece Adjacent : Type*} [MeasurableSpace α]
variable [Fintype Piece]
variable {μ : Measure α}

/-- The support of a finite measurable set partition is measurable. -/
theorem measurable_support
    (P : FiniteMeasurableSetPartition μ Piece) :
    MeasurableSet P.support := by
  rw [← P.cover]
  exact MeasurableSet.iUnion fun piece => P.measurable_piece piece

/--
A nonnegative integrable weight has positive cell integral when it is continuous
and positive at a point in the closure of the cell interior.  This packages the
standard source move from a local positive density value to a positive weighted
mass on a finite partition cell.
-/
theorem setIntegral_pos_of_ae_nonneg_of_continuousAt_pos_at_closure_interior
    [TopologicalSpace α] [OpensMeasurableSpace α]
    [IsFiniteMeasure μ] [Measure.IsOpenPosMeasure μ]
    {s : Set α} (hs : MeasurableSet s) {w : α → ℝ} {x0 : α}
    (hw_int : IntegrableOn w s μ)
    (hw_nonneg : ∀ᵐ x ∂μ.restrict s, 0 ≤ w x)
    (hw_cont : ContinuousAt w x0)
    (hw_pos : 0 < w x0)
    (hclosure : x0 ∈ closure (interior s)) :
    0 < ∫ x in s, w x ∂μ := by
  have htarget : {y : ℝ | 0 < y} ∈ nhds (w x0) :=
    IsOpen.mem_nhds isOpen_Ioi hw_pos
  have hpre : {x : α | 0 < w x} ∈ nhds x0 := hw_cont htarget
  rcases mem_nhds_iff.mp hpre with ⟨U, hUsub, hUopen, hxU⟩
  have hμ_pos : 0 < μ (s ∩ U) :=
    HasAEEssentialInfimum.local_pos_of_mem_closure_interior
      μ hclosure U hUopen hxU
  have hsupport_pos : 0 < μ (Function.support w ∩ s) := by
    refine lt_of_lt_of_le hμ_pos (measure_mono ?_)
    intro x hx
    exact ⟨ne_of_gt (hUsub hx.2), hx.1⟩
  exact
    (setIntegral_pos_iff_support_of_nonneg_ae hw_nonneg hw_int).2
      hsupport_pos

/--
Ordered real half-open interval partition generated by monotone natural
cutpoints `cut 0, ..., cut n`.  The `i`th piece is `(cut i, cut (i+1)]`.

This is the reusable continuum adapter needed when a paper reduces an integral
over a one-dimensional type space to finitely many step-function cells.
-/
def orderedRealIocNatCutpoints
    (μ : Measure ℝ) (n : ℕ) (cut : ℕ → ℝ) (hmono : Monotone cut) :
    FiniteMeasurableSetPartition μ (Fin n) where
  support := Set.Ioc (cut 0) (cut n)
  pieceSet := fun piece => Set.Ioc (cut piece.val) (cut (piece.val + 1))
  measurable_piece := by
    intro _piece
    exact measurableSet_Ioc
  pairwiseDisjoint := by
    intro piece₁ piece₂ hne
    by_cases hlt : piece₁.val < piece₂.val
    · exact Set.Ioc_disjoint_Ioc_of_le
        (hmono (Nat.succ_le_of_lt hlt))
    · have hval_ne : piece₁.val ≠ piece₂.val := by
        intro hval
        exact hne (Fin.ext hval)
      have hgt : piece₂.val < piece₁.val := by
        exact lt_of_le_of_ne (Nat.le_of_not_gt hlt) hval_ne.symm
      exact (Set.Ioc_disjoint_Ioc_of_le
        (hmono (Nat.succ_le_of_lt hgt))).symm
  cover := by
    ext x
    constructor
    · intro hx
      rcases Set.mem_iUnion.mp hx with ⟨piece, hxpiece⟩
      exact
        ⟨lt_of_le_of_lt (hmono (Nat.zero_le piece.val)) hxpiece.1,
          le_trans hxpiece.2 (hmono (Nat.succ_le_of_lt piece.isLt))⟩
    · intro hx
      have hxUnion :
          x ∈ ⋃ i ∈ Finset.range n,
            Set.Ioc (cut i) (cut (i + 1)) :=
        Ioc_subset_biUnion_Ioc n cut hx
      rcases Set.mem_iUnion.mp hxUnion with ⟨i, hxi⟩
      rcases Set.mem_iUnion.mp hxi with ⟨hirange, hxpiece⟩
      have hi : i < n := by
        simpa using hirange
      exact Set.mem_iUnion.mpr ⟨⟨i, hi⟩, by simpa using hxpiece⟩

/-- Midpoint of one half-open cell in an ordered real cutpoint partition. -/
def orderedRealIocNatCutpointsMidpoint
    (cut : ℕ → ℝ) {n : ℕ} (piece : Fin n) : ℝ :=
  (cut piece.val + cut (piece.val + 1)) / 2

/--
The midpoint of a strictly nonempty cutpoint cell lies in that cell.  This is
the reusable witness for continuum arguments that split an integral into
finitely many ordered intervals.
-/
theorem orderedRealIocNatCutpoints_midpoint_mem
    (μ : Measure ℝ) (n : ℕ) (cut : ℕ → ℝ) (hmono : Monotone cut)
    (piece : Fin n)
    (hstrict : cut piece.val < cut (piece.val + 1)) :
    orderedRealIocNatCutpointsMidpoint cut piece ∈
      (orderedRealIocNatCutpoints μ n cut hmono).pieceSet piece := by
  constructor
  · dsimp [orderedRealIocNatCutpointsMidpoint, orderedRealIocNatCutpoints]
    exact left_lt_add_div_two.mpr hstrict
  · dsimp [orderedRealIocNatCutpointsMidpoint, orderedRealIocNatCutpoints]
    exact (add_div_two_lt_right.mpr hstrict).le

/-- The integral over one partition component. -/
def componentIntegral
    (P : FiniteMeasurableSetPartition μ Piece)
    (f : α → ℝ) (piece : Piece) : ℝ :=
  ∫ x in P.pieceSet piece, f x ∂μ

/--
Finite partition decomposition for set integrals over the support.
-/
theorem setIntegral_eq_sum_componentIntegral
    (P : FiniteMeasurableSetPartition μ Piece)
    (f : α → ℝ)
    (hf : ∀ piece, IntegrableOn f (P.pieceSet piece) μ) :
    ∫ x in P.support, f x ∂μ =
      ∑ piece : Piece, P.componentIntegral f piece := by
  change ∫ x in P.support, f x ∂μ =
    ∑ piece : Piece, ∫ x in P.pieceSet piece, f x ∂μ
  rw [← P.cover]
  exact MeasureTheory.integral_iUnion_fintype
    P.measurable_piece P.pairwiseDisjoint hf

/--
Kernel that is constant on each piece of a finite measurable partition, using
zero outside the partition pieces.  This is useful for source arguments that
first decompose a continuum integral into finitely many cells and then attach
a scalar large-deviation sequence to each cell.
-/
def piecewiseConstKernel
    (P : FiniteMeasurableSetPartition μ Piece)
    (p : Piece → ℕ → ℝ) (n : ℕ) (x : α) : ℝ :=
  ∑ piece : Piece, (P.pieceSet piece).indicator (fun _ : α => p piece n) x

/--
On a partition piece, the associated piecewise-constant kernel is the scalar
sequence attached to that piece.
-/
theorem piecewiseConstKernel_eq_on_piece
    [DecidableEq Piece]
    (P : FiniteMeasurableSetPartition μ Piece)
    (p : Piece → ℕ → ℝ) (n : ℕ)
    (piece : Piece) {x : α}
    (hx : x ∈ P.pieceSet piece) :
    P.piecewiseConstKernel p n x = p piece n := by
  classical
  unfold piecewiseConstKernel
  rw [Finset.sum_eq_single piece]
  · simp [hx]
  · intro other _hmem hne
    have hnot : x ∉ P.pieceSet other := by
      intro hx_other
      exact
        (Set.disjoint_left.mp (P.pairwiseDisjoint hne.symm)) hx hx_other
    simp [hnot]
  · intro hnot
    exact False.elim (hnot (Finset.mem_univ piece))

/--
On a partition component, multiplying a piecewise-constant kernel by a weight
integrates as the scalar component sequence times the component weight
integral.
-/
theorem componentIntegral_weighted_piecewiseConstKernel
    [DecidableEq Piece]
    (P : FiniteMeasurableSetPartition μ Piece)
    (weight : α → ℝ) (p : Piece → ℕ → ℝ) (n : ℕ) (piece : Piece) :
    P.componentIntegral
        (fun x : α => weight x * P.piecewiseConstKernel p n x) piece =
      (∫ x in P.pieceSet piece, weight x ∂μ) * p piece n := by
  classical
  unfold componentIntegral
  have heq :
      (fun x : α => weight x * P.piecewiseConstKernel p n x)
        =ᵐ[μ.restrict (P.pieceSet piece)]
      (fun x : α => weight x * p piece n) := by
    filter_upwards [ae_restrict_mem (P.measurable_piece piece)] with x hx
    rw [P.piecewiseConstKernel_eq_on_piece p n piece hx]
  calc
    ∫ x in P.pieceSet piece,
        weight x * P.piecewiseConstKernel p n x ∂μ =
        ∫ x in P.pieceSet piece, weight x * p piece n ∂μ := by
          exact integral_congr_ae heq
    _ = (∫ x in P.pieceSet piece, weight x ∂μ) * p piece n := by
          rw [integral_mul_const]

/--
Integrability transfer for a weight times a piecewise-constant kernel on one
partition component.
-/
theorem integrableOn_weighted_piecewiseConstKernel
    [DecidableEq Piece]
    (P : FiniteMeasurableSetPartition μ Piece)
    (weight : α → ℝ) (p : Piece → ℕ → ℝ) (n : ℕ) (piece : Piece)
    (hweight : IntegrableOn weight (P.pieceSet piece) μ) :
    IntegrableOn
      (fun x : α => weight x * P.piecewiseConstKernel p n x)
      (P.pieceSet piece) μ := by
  classical
  have heq :
      (fun x : α => weight x * P.piecewiseConstKernel p n x)
        =ᵐ[μ.restrict (P.pieceSet piece)]
      (fun x : α => weight x * p piece n) := by
    filter_upwards [ae_restrict_mem (P.measurable_piece piece)] with x hx
    rw [P.piecewiseConstKernel_eq_on_piece p n piece hx]
  exact Integrable.congr (hweight.mul_const (p piece n)) heq.symm

/--
Nonnegative component weights and nonnegative component kernel values make the
weighted piecewise-constant support integral nonnegative.
-/
theorem setIntegral_weighted_piecewiseConstKernel_nonneg
    [DecidableEq Piece]
    (P : FiniteMeasurableSetPartition μ Piece)
    (weight : α → ℝ) (p : Piece → ℕ → ℝ) (n : ℕ)
    (hweight_int :
      ∀ piece, IntegrableOn weight (P.pieceSet piece) μ)
    (hweight_nonneg :
      ∀ piece, 0 ≤ ∫ x in P.pieceSet piece, weight x ∂μ)
    (hp_nonneg : ∀ piece, 0 ≤ p piece n) :
    0 ≤
      ∫ x in P.support, weight x * P.piecewiseConstKernel p n x ∂μ := by
  classical
  rw [P.setIntegral_eq_sum_componentIntegral
      (fun x : α => weight x * P.piecewiseConstKernel p n x)
      (fun piece =>
        P.integrableOn_weighted_piecewiseConstKernel weight p n piece
          (hweight_int piece))]
  refine Finset.sum_nonneg ?_
  intro piece _hpiece
  rw [P.componentIntegral_weighted_piecewiseConstKernel]
  exact mul_nonneg (hweight_nonneg piece) (hp_nonneg piece)

/--
Dominating-subfamily rate theorem for a weighted integral whose kernel is
piecewise constant on a finite measurable partition.  The scalar component
weights are the integrals of the weight over the partition pieces.
-/
theorem setIntegral_weightedPiecewiseConstKernel_hasExponentialRate_of_dominating_subfamily_certificates
    [DecidableEq Piece]
    {Adjacent : Type*}
    (P : FiniteMeasurableSetPartition μ Piece)
    (weight : α → ℝ) (p : Piece → ℕ → ℝ) (rate : Piece → ℝ)
    (selectAdjacent : Adjacent → Piece)
    (hweight_int :
      ∀ piece, IntegrableOn weight (P.pieceSet piece) μ)
    (hweight_nonneg :
      ∀ piece, 0 ≤ ∫ x in P.pieceSet piece, weight x ∂μ)
    (hcert :
      ∀ piece, ExponentialRateCertificate (p piece) (rate piece))
    (minAdjacent : Adjacent)
    (hweight_pos :
      0 < ∫ x in P.pieceSet (selectAdjacent minAdjacent), weight x ∂μ)
    (hadj_min :
      ∀ adj : Adjacent,
        rate (selectAdjacent minAdjacent) ≤ rate (selectAdjacent adj))
    (hadj_dominates :
      ∀ piece : Piece, ∃ adj : Adjacent,
        rate (selectAdjacent adj) ≤ rate piece) :
    HasExponentialRate
      (fun n : ℕ =>
        ∫ x in P.support, weight x * P.piecewiseConstKernel p n x ∂μ)
      (rate (selectAdjacent minAdjacent)) := by
  classical
  let componentWeight : Piece → ℝ :=
    fun piece => ∫ x in P.pieceSet piece, weight x ∂μ
  have hsum :
      HasExponentialRate
        (fun n : ℕ => ∑ piece : Piece, componentWeight piece * p piece n)
        (rate (selectAdjacent minAdjacent)) :=
    finite_weighted_sum_hasExponentialRate_of_dominating_subfamily_certificates
      (p := p) (weight := componentWeight) (rate := rate)
      selectAdjacent (by simpa [componentWeight] using hweight_nonneg)
      hcert minAdjacent (by simpa [componentWeight] using hweight_pos)
      hadj_min hadj_dominates
  refine HasExponentialRate.congr (p := fun n : ℕ =>
      ∑ piece : Piece, componentWeight piece * p piece n) ?_ hsum
  filter_upwards with n
  calc
    ∑ piece : Piece, componentWeight piece * p piece n =
        ∑ piece : Piece,
          P.componentIntegral
            (fun x : α => weight x * P.piecewiseConstKernel p n x) piece := by
          apply Finset.sum_congr rfl
          intro piece _hmem
          rw [P.componentIntegral_weighted_piecewiseConstKernel
            (weight := weight) (p := p) (n := n) (piece := piece)]
    _ = ∫ x in P.support,
          weight x * P.piecewiseConstKernel p n x ∂μ := by
          symm
          exact P.setIntegral_eq_sum_componentIntegral
            (fun x : α => weight x * P.piecewiseConstKernel p n x)
            (fun piece =>
              P.integrableOn_weighted_piecewiseConstKernel
                (weight := weight) (p := p) (n := n) (piece := piece)
                (hweight_int piece))

/--
Product of two finite measurable partitions.  The component indexed by
`(i, j)` is the measurable rectangle `P_i × Q_j`, and the support is the
cartesian product of the two supports.
-/
def prod {β Pieceβ : Type*} [MeasurableSpace β] [Fintype Pieceβ]
    {ν : Measure β}
    (P : FiniteMeasurableSetPartition μ Piece)
    (Q : FiniteMeasurableSetPartition ν Pieceβ) :
    FiniteMeasurableSetPartition (μ.prod ν) (Piece × Pieceβ) where
  support := P.support ×ˢ Q.support
  pieceSet := fun piece => P.pieceSet piece.1 ×ˢ Q.pieceSet piece.2
  measurable_piece := by
    intro piece
    exact (P.measurable_piece piece.1).prod (Q.measurable_piece piece.2)
  pairwiseDisjoint := by
    intro piece₁ piece₂ hne
    rw [Set.disjoint_left]
    intro x hx₁ hx₂
    rcases x with ⟨x₁, x₂⟩
    by_cases hfirst : piece₁.1 = piece₂.1
    · have hsecond : piece₁.2 ≠ piece₂.2 := by
        intro hsecond
        exact hne (Prod.ext hfirst hsecond)
      exact
        (Set.disjoint_left.mp
          (Q.pairwiseDisjoint hsecond)) hx₁.2 hx₂.2
    · exact
        (Set.disjoint_left.mp
          (P.pairwiseDisjoint hfirst)) hx₁.1 hx₂.1
  cover := by
    ext x
    rcases x with ⟨x₁, x₂⟩
    constructor
    · intro hx
      rcases Set.mem_iUnion.mp hx with ⟨piece, hxpiece⟩
      have hx₁ : x₁ ∈ Set.iUnion P.pieceSet :=
        Set.mem_iUnion.mpr ⟨piece.1, hxpiece.1⟩
      have hx₂ : x₂ ∈ Set.iUnion Q.pieceSet :=
        Set.mem_iUnion.mpr ⟨piece.2, hxpiece.2⟩
      exact ⟨by simpa [P.cover] using hx₁, by simpa [Q.cover] using hx₂⟩
    · intro hx
      have hx₁ : x₁ ∈ Set.iUnion P.pieceSet := by
        simpa [P.cover] using hx.1
      have hx₂ : x₂ ∈ Set.iUnion Q.pieceSet := by
        simpa [Q.cover] using hx.2
      rcases Set.mem_iUnion.mp hx₁ with ⟨piece₁, hxpiece₁⟩
      rcases Set.mem_iUnion.mp hx₂ with ⟨piece₂, hxpiece₂⟩
      exact Set.mem_iUnion.mpr ⟨(piece₁, piece₂), ⟨hxpiece₁, hxpiece₂⟩⟩

/--
Subpartition induced by selecting a finite subfamily of pieces.  The support is
the union of the selected pieces.
-/
def subpartition
    (P : FiniteMeasurableSetPartition μ Piece)
    (selected : Piece → Prop) [DecidablePred selected] :
    FiniteMeasurableSetPartition μ {piece : Piece // selected piece} where
  support := Set.iUnion (fun piece : {piece : Piece // selected piece} =>
    P.pieceSet piece.val)
  pieceSet := fun piece => P.pieceSet piece.val
  measurable_piece := by
    intro piece
    exact P.measurable_piece piece.val
  pairwiseDisjoint := by
    intro piece₁ piece₂ hne
    have hval : piece₁.val ≠ piece₂.val := by
      intro hval
      exact hne (Subtype.ext hval)
    exact P.pairwiseDisjoint hval
  cover := rfl

/--
Selected product partition: first form the product partition, then retain only
the selected product pieces.
-/
def selectedProduct {β Pieceβ : Type*} [MeasurableSpace β] [Fintype Pieceβ]
    {ν : Measure β}
    (P : FiniteMeasurableSetPartition μ Piece)
    (Q : FiniteMeasurableSetPartition ν Pieceβ)
    (selected : Piece × Pieceβ → Prop) [DecidablePred selected] :
    FiniteMeasurableSetPartition (μ.prod ν)
      {piece : Piece × Pieceβ // selected piece} :=
  (P.prod Q).subpartition selected

/-- Product midpoint of two ordered real cutpoint cells. -/
def orderedRealIocNatCutpointsProdMidpoint
    (cut₁ cut₂ : ℕ → ℝ) {n m : ℕ} (piece : Fin n × Fin m) :
    ℝ × ℝ :=
  (orderedRealIocNatCutpointsMidpoint cut₁ piece.1,
    orderedRealIocNatCutpointsMidpoint cut₂ piece.2)

/--
The product midpoint of two strictly nonempty cutpoint cells lies in the
corresponding product-partition cell.
-/
theorem orderedRealIocNatCutpointsProd_midpoint_mem
    (μ ν : Measure ℝ) (n m : ℕ) (cut₁ cut₂ : ℕ → ℝ)
    (hmono₁ : Monotone cut₁) (hmono₂ : Monotone cut₂)
    (piece : Fin n × Fin m)
    (hstrict₁ : cut₁ piece.1.val < cut₁ (piece.1.val + 1))
    (hstrict₂ : cut₂ piece.2.val < cut₂ (piece.2.val + 1)) :
    orderedRealIocNatCutpointsProdMidpoint cut₁ cut₂ piece ∈
      ((orderedRealIocNatCutpoints μ n cut₁ hmono₁).prod
        (orderedRealIocNatCutpoints ν m cut₂ hmono₂)).pieceSet piece := by
  exact
    ⟨orderedRealIocNatCutpoints_midpoint_mem μ n cut₁ hmono₁ piece.1 hstrict₁,
      orderedRealIocNatCutpoints_midpoint_mem ν m cut₂ hmono₂ piece.2 hstrict₂⟩

/--
The product midpoint also lies in a selected product cell whenever the selected
piece has strictly nonempty coordinate cells.
-/
theorem selectedProduct_orderedRealIocNatCutpoints_midpoint_mem
    (μ ν : Measure ℝ) (n m : ℕ) (cut₁ cut₂ : ℕ → ℝ)
    (hmono₁ : Monotone cut₁) (hmono₂ : Monotone cut₂)
    (selected : Fin n × Fin m → Prop) [DecidablePred selected]
    (piece : {piece : Fin n × Fin m // selected piece})
    (hstrict₁ : cut₁ piece.val.1.val < cut₁ (piece.val.1.val + 1))
    (hstrict₂ : cut₂ piece.val.2.val < cut₂ (piece.val.2.val + 1)) :
    orderedRealIocNatCutpointsProdMidpoint cut₁ cut₂ piece.val ∈
      ((orderedRealIocNatCutpoints μ n cut₁ hmono₁).selectedProduct
        (orderedRealIocNatCutpoints ν m cut₂ hmono₂) selected).pieceSet
          piece := by
  simpa [selectedProduct, subpartition] using
    orderedRealIocNatCutpointsProd_midpoint_mem
      μ ν n m cut₁ cut₂ hmono₁ hmono₂ piece.val hstrict₁ hstrict₂

/--
Product topological-support adapter: if each coordinate lies in the closure of
the interior of its cell, then the product point lies in the closure of the
interior of the product cell.
-/
theorem prod_mem_closure_interior_of_mem_closure_interior
    {β : Type*} [TopologicalSpace α] [TopologicalSpace β]
    {s : Set α} {t : Set β} {x : α} {y : β}
    (hx : x ∈ closure (interior s))
    (hy : y ∈ closure (interior t)) :
    (x, y) ∈ closure (interior (s ×ˢ t)) := by
  rw [interior_prod_eq, closure_prod_eq]
  exact ⟨hx, hy⟩

/--
Every point in a half-open real interval cell belongs to the closure of the
cell interior.  This packages the standard topology fact for ordered real
partitions.
-/
theorem orderedRealIocNatCutpoints_piece_mem_closure_interior
    (μ : Measure ℝ) (n : ℕ) (cut : ℕ → ℝ) (hmono : Monotone cut)
    (piece : Fin n) {x : ℝ}
    (hx :
      x ∈ (orderedRealIocNatCutpoints μ n cut hmono).pieceSet piece) :
    x ∈ closure
      (interior ((orderedRealIocNatCutpoints μ n cut hmono).pieceSet piece)) := by
  simpa [orderedRealIocNatCutpoints] using
    Ioc_subset_closure_interior (cut piece.val) (cut (piece.val + 1)) hx

/--
Selected-product closure/interior support adapter.  If both coordinate
partitions have the property that every point of every cell is in the closure of
that cell's interior, then selected product cells have the same property.
-/
theorem selectedProduct_piece_mem_closure_interior
    {β Pieceβ : Type*} [TopologicalSpace α] [TopologicalSpace β]
    [MeasurableSpace β] [Fintype Pieceβ] {ν : Measure β}
    (P : FiniteMeasurableSetPartition μ Piece)
    (Q : FiniteMeasurableSetPartition ν Pieceβ)
    (hP : ∀ piece x, x ∈ P.pieceSet piece →
      x ∈ closure (interior (P.pieceSet piece)))
    (hQ : ∀ piece x, x ∈ Q.pieceSet piece →
      x ∈ closure (interior (Q.pieceSet piece)))
    (selected : Piece × Pieceβ → Prop) [DecidablePred selected]
    (piece : {piece : Piece × Pieceβ // selected piece}) {x : α × β}
    (hx : x ∈ (P.selectedProduct Q selected).pieceSet piece) :
    x ∈ closure
      (interior ((P.selectedProduct Q selected).pieceSet piece)) := by
  have hxprod :
      x ∈ P.pieceSet piece.val.1 ×ˢ Q.pieceSet piece.val.2 := by
    simpa [selectedProduct, subpartition, prod] using hx
  have hsupport :
      x ∈ closure
        (interior (P.pieceSet piece.val.1 ×ˢ Q.pieceSet piece.val.2)) :=
    prod_mem_closure_interior_of_mem_closure_interior
      (hP piece.val.1 x.1 hxprod.1)
      (hQ piece.val.2 x.2 hxprod.2)
  simpa [selectedProduct, subpartition, prod] using hsupport

/--
Closed interval compact superset associated to one ordered half-open cutpoint
cell.
-/
def orderedRealIocNatCutpointsCompactSuperset
    (n : ℕ) (cut : ℕ → ℝ) (piece : Fin n) : Set ℝ :=
  Set.Icc (cut piece.val) (cut (piece.val + 1))

/--
The compact superset associated to a real cutpoint cell is compact.
-/
theorem orderedRealIocNatCutpointsCompactSuperset_isCompact
    (n : ℕ) (cut : ℕ → ℝ) (piece : Fin n) :
    IsCompact (orderedRealIocNatCutpointsCompactSuperset n cut piece) := by
  simpa [orderedRealIocNatCutpointsCompactSuperset] using
    (isCompact_Icc :
      IsCompact (Set.Icc (cut piece.val) (cut (piece.val + 1))))

/--
Each half-open ordered cutpoint cell is contained in its closed interval
compact superset.
-/
theorem orderedRealIocNatCutpoints_piece_subset_compactSuperset
    (μ : Measure ℝ) (n : ℕ) (cut : ℕ → ℝ) (hmono : Monotone cut)
    (piece : Fin n) :
    (orderedRealIocNatCutpoints μ n cut hmono).pieceSet piece ⊆
      orderedRealIocNatCutpointsCompactSuperset n cut piece := by
  intro x hx
  simpa [orderedRealIocNatCutpoints,
    orderedRealIocNatCutpointsCompactSuperset] using
      (Set.Ioc_subset_Icc_self hx)

/--
Product compact superset associated to a pair of ordered half-open cutpoint
cells.
-/
def orderedRealIocNatCutpointsProdCompactSuperset
    (n m : ℕ) (cut₁ cut₂ : ℕ → ℝ) (piece : Fin n × Fin m) :
    Set (ℝ × ℝ) :=
  orderedRealIocNatCutpointsCompactSuperset n cut₁ piece.1 ×ˢ
    orderedRealIocNatCutpointsCompactSuperset m cut₂ piece.2

/--
If the first closed cutpoint cell lies weakly below the second, every point in
the product compact superset has first coordinate below second coordinate.
-/
theorem orderedRealIocNatCutpointsProdCompactSuperset_fst_le_snd_of_index_fst_succ_le_snd
    (n m : ℕ) (cut : ℕ → ℝ) (hmono : Monotone cut)
    (piece : Fin n × Fin m)
    (hindex : piece.1.val + 1 ≤ piece.2.val) :
    ∀ q : ℝ × ℝ,
      q ∈ orderedRealIocNatCutpointsProdCompactSuperset n m cut cut piece →
        q.1 ≤ q.2 := by
  intro q hq
  have hcut : cut (piece.1.val + 1) ≤ cut piece.2.val :=
    hmono hindex
  exact le_trans hq.1.2 (le_trans hcut hq.2.1)

/--
If the second closed cutpoint cell lies weakly below the first, every point in
the product compact superset has second coordinate below first coordinate.
-/
theorem orderedRealIocNatCutpointsProdCompactSuperset_snd_le_fst_of_index_snd_succ_le_fst
    (n m : ℕ) (cut : ℕ → ℝ) (hmono : Monotone cut)
    (piece : Fin n × Fin m)
    (hindex : piece.2.val + 1 ≤ piece.1.val) :
    ∀ q : ℝ × ℝ,
      q ∈ orderedRealIocNatCutpointsProdCompactSuperset n m cut cut piece →
        q.2 ≤ q.1 := by
  intro q hq
  have hcut : cut (piece.2.val + 1) ≤ cut piece.1.val :=
    hmono hindex
  exact le_trans hq.2.2 (le_trans hcut hq.1.1)

/--
The product compact superset associated to two real cutpoint cells is compact.
-/
theorem orderedRealIocNatCutpointsProdCompactSuperset_isCompact
    (n m : ℕ) (cut₁ cut₂ : ℕ → ℝ) (piece : Fin n × Fin m) :
    IsCompact
      (orderedRealIocNatCutpointsProdCompactSuperset n m cut₁ cut₂ piece) := by
  exact
    (orderedRealIocNatCutpointsCompactSuperset_isCompact
        n cut₁ piece.1).prod
      (orderedRealIocNatCutpointsCompactSuperset_isCompact
        m cut₂ piece.2)

/--
A selected product of two ordered half-open cutpoint cells is contained in the
corresponding product of closed interval compact supersets.
-/
theorem selectedProduct_orderedRealIocNatCutpoints_piece_subset_prodCompactSuperset
    (μ ν : Measure ℝ) (n m : ℕ)
    (cut₁ cut₂ : ℕ → ℝ) (hmono₁ : Monotone cut₁)
    (hmono₂ : Monotone cut₂)
    (selected : Fin n × Fin m → Prop) [DecidablePred selected]
    (piece : {piece : Fin n × Fin m // selected piece}) :
    ((orderedRealIocNatCutpoints μ n cut₁ hmono₁).selectedProduct
        (orderedRealIocNatCutpoints ν m cut₂ hmono₂) selected).pieceSet
      piece ⊆
        orderedRealIocNatCutpointsProdCompactSuperset
          n m cut₁ cut₂ piece.val := by
  intro x hx
  rcases x with ⟨x₁, x₂⟩
  have hxprod :
      (x₁, x₂) ∈
        (orderedRealIocNatCutpoints μ n cut₁ hmono₁).pieceSet
            piece.val.1 ×ˢ
          (orderedRealIocNatCutpoints ν m cut₂ hmono₂).pieceSet
            piece.val.2 := by
    simpa [selectedProduct, subpartition, prod] using hx
  exact
    ⟨orderedRealIocNatCutpoints_piece_subset_compactSuperset
        μ n cut₁ hmono₁ piece.val.1 hxprod.1,
      orderedRealIocNatCutpoints_piece_subset_compactSuperset
        ν m cut₂ hmono₂ piece.val.2 hxprod.2⟩

variable [DecidableEq Piece]

/--
If each component integral has an exact exponential-rate certificate, then the
support integral has the exponent of any minimum-rate positive component.
-/
theorem setIntegral_hasExponentialRate_of_min_component_certificates
    (P : FiniteMeasurableSetPartition μ Piece)
    (errorKernel : ℕ → α → ℝ)
    (rate : Piece → ℝ)
    (hcomponent_int :
      ∀ n piece, IntegrableOn (errorKernel n) (P.pieceSet piece) μ)
    (hcert :
      ∀ piece,
        ExponentialRateCertificate
          (fun n : ℕ => P.componentIntegral (errorKernel n) piece)
          (rate piece))
    (minPiece : Piece)
    (hrate_ge : ∀ piece, rate minPiece ≤ rate piece) :
    HasExponentialRate
      (fun n : ℕ => ∫ x in P.support, errorKernel n x ∂μ)
      (rate minPiece) := by
  let componentError : Piece → ℕ → ℝ :=
    fun piece n => P.componentIntegral (errorKernel n) piece
  have hsum :
      HasExponentialRate
        (fun n : ℕ => ∑ piece : Piece, (1 : ℝ) * componentError piece n)
    (rate minPiece) :=
    finite_weighted_sum_hasExponentialRate_of_min_component_certificates
      (p := componentError) (weight := fun _piece : Piece => (1 : ℝ))
      (rate := rate)
      (by intro _piece; norm_num)
      (by intro piece; simpa [componentError] using hcert piece)
      minPiece (by norm_num) hrate_ge
  refine HasExponentialRate.congr ?_ hsum
  filter_upwards with n
  calc
    (∑ piece : Piece, (1 : ℝ) * componentError piece n)
        = ∑ piece : Piece, P.componentIntegral (errorKernel n) piece := by
          simp [componentError]
    _ = ∫ x in P.support, errorKernel n x ∂μ := by
          exact (P.setIntegral_eq_sum_componentIntegral
            (errorKernel n) (hcomponent_int n)).symm

/--
Finite-partition exponential-rate aggregation with a dominating selected
subfamily, matching the adjacent-component reduction common in
large-deviation proofs.
-/
theorem setIntegral_hasExponentialRate_of_dominating_subfamily_certificates
    (P : FiniteMeasurableSetPartition μ Piece)
    (errorKernel : ℕ → α → ℝ)
    (rate : Piece → ℝ)
    (selectAdjacent : Adjacent → Piece)
    (hcomponent_int :
      ∀ n piece, IntegrableOn (errorKernel n) (P.pieceSet piece) μ)
    (hcert :
      ∀ piece,
        ExponentialRateCertificate
          (fun n : ℕ => P.componentIntegral (errorKernel n) piece)
          (rate piece))
    (minAdjacent : Adjacent)
    (hadj_min :
      ∀ adj : Adjacent,
        rate (selectAdjacent minAdjacent) ≤ rate (selectAdjacent adj))
    (hadj_dominates :
      ∀ piece : Piece,
        ∃ adj : Adjacent, rate (selectAdjacent adj) ≤ rate piece) :
    HasExponentialRate
      (fun n : ℕ => ∫ x in P.support, errorKernel n x ∂μ)
      (rate (selectAdjacent minAdjacent)) := by
  let componentError : Piece → ℕ → ℝ :=
    fun piece n => P.componentIntegral (errorKernel n) piece
  have hsum :
      HasExponentialRate
        (fun n : ℕ => ∑ piece : Piece, (1 : ℝ) * componentError piece n)
    (rate (selectAdjacent minAdjacent)) :=
    finite_weighted_sum_hasExponentialRate_of_dominating_subfamily_certificates
      (p := componentError) (weight := fun _piece : Piece => (1 : ℝ))
      (rate := rate) selectAdjacent
      (by intro _piece; norm_num)
      (by intro piece; simpa [componentError] using hcert piece)
      minAdjacent (by norm_num) hadj_min hadj_dominates
  refine HasExponentialRate.congr ?_ hsum
  filter_upwards with n
  calc
    (∑ piece : Piece, (1 : ℝ) * componentError piece n)
        = ∑ piece : Piece, P.componentIntegral (errorKernel n) piece := by
          simp [componentError]
    _ = ∫ x in P.support, errorKernel n x ∂μ := by
          exact (P.setIntegral_eq_sum_componentIntegral
            (errorKernel n) (hcomponent_int n)).symm

/--
Finite-partition aggregation for positive kernels whose normalized negative
log rates converge uniformly on each component.  This is the common
continuous-large-deviation pattern where each measurable cell supplies a
weighted Laplace certificate, and the full partition integral inherits the
minimum component exponent.
-/
theorem setIntegral_weightedKernel_hasExponentialRate_of_min_component_uniform_logRate
    (P : FiniteMeasurableSetPartition μ Piece) [IsFiniteMeasure μ]
    (weight : α → ℝ) (kernel : ℕ → α → ℝ)
    (phi : Piece → α → ℝ) (rate W : Piece → ℝ)
    (hkernel_int :
      ∀ n piece,
        IntegrableOn (fun x : α => weight x * kernel n x)
          (P.pieceSet piece) μ)
    (hweight_int :
      ∀ piece, IntegrableOn weight (P.pieceSet piece) μ)
    (hWpos : ∀ piece, 0 < W piece)
    (hweight_nonneg :
      ∀ piece, ∀ᵐ x ∂μ.restrict (P.pieceSet piece), 0 ≤ weight x)
    (hweight_bound :
      ∀ piece, ∀ᵐ x ∂μ.restrict (P.pieceSet piece), weight x ≤ W piece)
    (hess :
      ∀ piece,
        HasAEEssentialInfimum
          (μ.restrict (P.pieceSet piece)) (phi piece) (rate piece))
    (hweighted_near :
      ∀ piece,
        HasPositiveWeightNearAEEssentialInfimum
          (μ.restrict (P.pieceSet piece)) weight (phi piece) (rate piece))
    (hkernel_pos : ∀ n x, 0 < kernel n x)
    (huniform_log :
      ∀ piece, ∀ ε > 0,
        ∀ᶠ n : ℕ in atTop,
          ∀ x : α,
            |(-Real.log (kernel n x) / (n : ℝ)) - phi piece x| ≤ ε)
    (minPiece : Piece)
    (hrate_ge : ∀ piece, rate minPiece ≤ rate piece) :
    HasExponentialRate
      (fun n : ℕ =>
