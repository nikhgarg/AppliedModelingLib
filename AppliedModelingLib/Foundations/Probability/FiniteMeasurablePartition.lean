      (rate minPiece) := by
  have hcert :
      ∀ piece,
        ExponentialRateCertificate
          (fun n : ℕ =>
            P.componentIntegral
              (fun x : α => weight x * kernel n x) piece)
          (rate piece) := by
    intro piece
    have hcomponent :
        ExponentialRateCertificate
          (fun n : ℕ =>
            ∫ x, weight x * kernel n x ∂(μ.restrict (P.pieceSet piece)))
          (rate piece) :=
      weightedKernelIntegral_exponentialRateCertificate_of_uniform_logRate_tendsto_weightedEssentialInf
        (μ.restrict (P.pieceSet piece)) weight kernel (phi piece)
        (by
          intro n
          simpa [IntegrableOn] using hkernel_int n piece)
        (by
          simpa [IntegrableOn] using hweight_int piece)
        (hWpos piece) (hweight_nonneg piece) (hweight_bound piece)
        (hess piece) (hweighted_near piece) hkernel_pos
        (huniform_log piece)
    simpa [componentIntegral] using hcomponent
  exact
    P.setIntegral_hasExponentialRate_of_min_component_certificates
      (fun n x => weight x * kernel n x) rate hkernel_int hcert
      minPiece hrate_ge

