import AppliedModelingLib.Foundations.Probability.Processes.Palm.QueueLengthPASTA

/-!
# Stationary Campbell/Palm tagged-arrival certificates

This module states the actual stationary-to-Palm provenance required by a
tagged-arrival theorem. It is deliberately separate from the candidate
two-sided iid-gap and independent-product constructions: neither construction
by itself supplies a stationary point process or a Campbell identity.
-/

namespace AppliedModelingLib.Probability.Palm

open MeasureTheory ProbabilityTheory
open scoped ENNReal

noncomputable section

/-- Number of selected arrivals in the unit interval whose recentered sample is in `s`. -/
noncomputable def unitWindowCampbellCount
    {Ωbase Ωtag : Type*} [MeasurableSpace Ωbase] [MeasurableSpace Ωtag]
    (arrivalsIn : ℝ → ℝ → Ωbase → Finset ℤ)
    (recenterAt : Ωbase → ℤ → Ωtag)
    (s : Set Ωtag) (ω : Ωbase) : ℕ := by
  classical
  exact ((arrivalsIn 0 1 ω).filter fun i => recenterAt ω i ∈ s).card

/-- A finite selected count is measurable when its finite containing list is
generated by a countable measurable parameter.  Keeping this generic lemma
next to `unitWindowCampbellCount` lets concrete stationary constructions
discharge its measurability field without imposing a measurable-space
instance on `Finset`. -/
theorem measurable_count_from_countable_parameter
    {Ω κ : Type*} [MeasurableSpace Ω] [MeasurableSpace κ]
    [Countable κ] [MeasurableSingletonClass κ]
    (state : Ω → κ) (hstate : Measurable state)
    (indices : κ → Finset ℤ)
    (selected : Ω → ℤ → Bool) (hselected : Measurable selected) :
    Measurable (fun ω => ((indices (state ω)).filter fun i => selected ω i = true).card) := by
  have hfilter : Measurable (fun p : κ × (ℤ → Bool) =>
      (indices p.1 |>.filter fun i => p.2 i = true).card) := by
    refine measurable_from_prod_countable_right fun k => ?_
    change Measurable (fun y : ℤ → Bool =>
      (indices k |>.filter fun i => y i = true).card)
    have hsum : Measurable (fun y : ℤ → Bool =>
        ∑ i ∈ indices k, if y i = true then 1 else 0) := by
      refine Finset.measurable_fun_sum (indices k) fun i hi => ?_
      have htrue : MeasurableSet {y : ℤ → Bool | y i = true} := by
        exact (measurable_pi_apply (X := fun _ : ℤ => Bool) i)
          (MeasurableSet.singleton true)
      exact Measurable.ite htrue measurable_const measurable_const
    convert hsum using 1
    funext y
    exact Finset.card_filter _ _
  exact hfilter.comp (hstate.prodMk hselected)

/-- A finite weighted sum is measurable when its finite containing list is
generated by a countable measurable parameter.  This is the weighted analogue
of `measurable_count_from_countable_parameter`; it avoids imposing a
measurable-space instance on `Finset`. -/
theorem measurable_sum_from_countable_parameter
    {Ω κ : Type*} [MeasurableSpace Ω] [MeasurableSpace κ]
    [Countable κ] [MeasurableSingletonClass κ]
    (state : Ω → κ) (hstate : Measurable state)
    (indices : κ → Finset ℤ)
    (selected : Ω → ℤ → Bool) (hselected : Measurable selected)
    (weight : Ω → ℤ → ℝ) (hweight : Measurable weight) :
    Measurable (fun ω => ∑ i ∈ indices (state ω),
      if selected ω i = true then weight ω i else 0) := by
  have hsum : Measurable (fun p : κ × ((ℤ → Bool) × (ℤ → ℝ)) =>
      ∑ i ∈ indices p.1, if p.2.1 i = true then p.2.2 i else 0) := by
    refine measurable_from_prod_countable_right fun k => ?_
    change Measurable (fun y : (ℤ → Bool) × (ℤ → ℝ) =>
      ∑ i ∈ indices k, if y.1 i = true then y.2 i else 0)
    refine Finset.measurable_fun_sum (indices k) fun i hi => ?_
    have htrue : MeasurableSet {y : (ℤ → Bool) × (ℤ → ℝ) | y.1 i = true} := by
      exact ((measurable_pi_apply (X := fun _ : ℤ => Bool) i).comp measurable_fst)
        (MeasurableSet.singleton true)
    exact Measurable.ite htrue
      ((measurable_pi_apply (X := fun _ : ℤ => ℝ) i).comp measurable_snd)
      measurable_const
  exact hsum.comp (hstate.prodMk (hselected.prodMk hweight))

/--
A stationary base law together with an actual Campbell/Palm link to a tagged
law.

`base.shift t` uses the convention that an epoch at time `u` is at `u - t`
after shifting by `t`. The unit-window Campbell formula, for all measurable
tagged events, asserts that `tagged.Ptag` is the Palm law of the recentered
base configuration at intensity `arrivalRate`.
-/
structure CampbellPalmTaggedArrivalCertificate
    {Ωbase Ωtag : Type*} [MeasurableSpace Ωbase] [MeasurableSpace Ωtag]
    (base : ShiftInvariantProbabilityLaw Ωbase)
    (tagged : Queueing.TaggedArrivalAtZero Ωtag) where
  arrivalRate : ℝ
  arrivalRate_pos : 0 < arrivalRate
  /-- An ordered enumeration of the untagged base arrival epochs. -/
  baseArrivals : Ωbase → ℤ → ℝ
  baseArrivals_measurable : ∀ i, Measurable (fun ω => baseArrivals ω i)
  baseArrivals_strict : ∀ᵐ ω ∂base.Pbase, StrictMono (baseArrivals ω)
  /-- A finite, exact enumeration of the arrivals in each half-open time window. -/
  arrivalsIn : ℝ → ℝ → Ωbase → Finset ℤ
  arrivalsIn_spec : ∀ a b, ∀ᵐ ω ∂base.Pbase, ∀ i,
    i ∈ arrivalsIn a b ω ↔ a ≤ baseArrivals ω i ∧ baseArrivals ω i < b
  /-- Reindex and recenter the full base sample at a selected arrival. -/
  recenterAt : Ωbase → ℤ → Ωtag
  recenterAt_measurable : ∀ i, Measurable (fun ω => recenterAt ω i)
  /-- The tagged arrival epochs agree with the recentered base epochs. -/
  recenter_arrivals : ∀ᵐ ω ∂base.Pbase, ∀ i j,
    tagged.arrivals (recenterAt ω i) j =
      baseArrivals ω (i + j) - baseArrivals ω i
  /-- The untagged arrival point set covaries with the real-time stationary shift. -/
  baseArrivals_shift : ∀ t, ∀ᵐ ω ∂base.Pbase,
    Set.range (baseArrivals (base.shift t ω)) =
      (fun u : ℝ => u - t) '' Set.range (baseArrivals ω)
  /-- The finite selected-point count is a legitimate random variable for every
  measurable tagged event. -/
  campbellCount_aemeasurable : ∀ s : Set Ωtag, MeasurableSet s →
    AEMeasurable (fun ω => unitWindowCampbellCount arrivalsIn recenterAt s ω)
      base.Pbase
  /-- The defining finite-window Campbell/Palm identity. -/
  campbell_unit_interval : ∀ s : Set Ωtag, MeasurableSet s →
    ∫⁻ ω, (↑(unitWindowCampbellCount arrivalsIn recenterAt s ω) : ENNReal)
      ∂base.Pbase = ENNReal.ofReal arrivalRate * tagged.Ptag s

/--
Combine genuine Campbell/Palm provenance with the independent PASTA
queue-state identity. PASTA remains a separate field: a Campbell identity
alone does not prove it without Poisson/predictability arguments for the
queue state.
-/
structure StationaryPalmPASTAQueueLengthCertificate
    {Ωbase Ωtag : Type*} [MeasurableSpace Ωbase] [MeasurableSpace Ωtag]
    (base : ShiftInvariantProbabilityLaw Ωbase)
    (tagged : Queueing.TaggedArrivalAtZero Ωtag)
    extends CampbellPalmTaggedArrivalCertificate base tagged,
      PalmPASTAQueueLengthCertificate Ωbase Ωtag base tagged

/-- Forget the Campbell/Palm provenance when only the PASTA state-law
consequence is needed. -/
def StationaryPalmPASTAQueueLengthCertificate.to_pasta
    {Ωbase Ωtag : Type*} [MeasurableSpace Ωbase] [MeasurableSpace Ωtag]
    {base : ShiftInvariantProbabilityLaw Ωbase}
    {tagged : Queueing.TaggedArrivalAtZero Ωtag}
    (H : StationaryPalmPASTAQueueLengthCertificate base tagged) :
    PalmPASTAQueueLengthCertificate Ωbase Ωtag base tagged :=
  H.toPalmPASTAQueueLengthCertificate

end

end AppliedModelingLib.Probability.Palm
