/-!
# Finite- and local-horizon Skorokhod `J₁` convergence

This module records the time-change formulation of finite-horizon
Skorokhod `J₁` convergence, its finite-horizon uniform topology, and the
local uniform topology generated by finite sets of integer horizons on
`[0,∞)`.  It remains deliberately separated from the measurable-space and
Polish-space results needed for path-law weak convergence, and from proofs
that concrete random paths are measurable for the explicit Borel structures.
-/

namespace AppliedModelingLib.Probability

open Filter Topology MeasureTheory ProbabilityTheory

/-- An increasing homeomorphic reparametrization of a compact real time
interval. -/
structure SkorokhodTimeChange (horizon : ℝ) where
  toHomeomorph : Set.Icc (0 : ℝ) horizon ≃ₜ Set.Icc (0 : ℝ) horizon
  strictMono' : StrictMono toHomeomorph

namespace SkorokhodTimeChange

/-- The identity time change. -/
def identity (horizon : ℝ) : SkorokhodTimeChange horizon where
  toHomeomorph := Homeomorph.refl _
  strictMono' := strictMono_id

@[simp]
theorem identity_apply (horizon : ℝ) (time : Set.Icc (0 : ℝ) horizon) :
    (identity horizon).toHomeomorph time = time := rfl

/-- Compose two increasing compact-interval time changes. -/
def comp {horizon : ℝ} (first second : SkorokhodTimeChange horizon) :
    SkorokhodTimeChange horizon where
  toHomeomorph := first.toHomeomorph.trans second.toHomeomorph
  strictMono' := second.strictMono'.comp first.strictMono'

@[simp]
theorem comp_apply {horizon : ℝ} (first second : SkorokhodTimeChange horizon)
    (time : Set.Icc (0 : ℝ) horizon) :
    (first.comp second).toHomeomorph time = second.toHomeomorph (first.toHomeomorph time) := rfl

/-- Inverting an increasing time change preserves strict monotonicity. -/
def inverse {horizon : ℝ} (timeChange : SkorokhodTimeChange horizon) :
    SkorokhodTimeChange horizon where
  toHomeomorph := timeChange.toHomeomorph.symm
  strictMono' := by
    intro first second hfirstSecond
    apply lt_of_not_ge
    intro hinverse
    have hforward := timeChange.strictMono'.monotone hinverse
    have hsecondFirst : second ≤ first := by
      simpa using hforward
    exact (not_le_of_gt hfirstSecond) hsecondFirst

@[simp]
theorem inverse_apply {horizon : ℝ} (timeChange : SkorokhodTimeChange horizon)
    (time : Set.Icc (0 : ℝ) horizon) :
    timeChange.inverse.toHomeomorph time = timeChange.toHomeomorph.symm time := rfl

/-- A continuous strictly increasing self-map of a compact interval is a
Skorokhod time change when it fixes both endpoints.  Surjectivity follows
from the intermediate-value theorem, so this packages the usual
piecewise-affine interpolations used to align finitely many jump times. -/
noncomputable def ofContinuousStrictMono {horizon : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (map : Set.Icc (0 : ℝ) horizon → Set.Icc (0 : ℝ) horizon)
    (hcontinuous : Continuous map) (hstrict : StrictMono map)
    (hzero : map ⟨0, le_rfl, horizon_nonneg⟩ = ⟨0, le_rfl, horizon_nonneg⟩)
    (hend : map ⟨horizon, horizon_nonneg, le_rfl⟩ =
      ⟨horizon, horizon_nonneg, le_rfl⟩) :
    SkorokhodTimeChange horizon := by
  let left : Set.Icc (0 : ℝ) horizon := ⟨0, le_rfl, horizon_nonneg⟩
  let right : Set.Icc (0 : ℝ) horizon := ⟨horizon, horizon_nonneg, le_rfl⟩
  letI : PreconnectedSpace (Set.Icc (0 : ℝ) horizon) :=
    Subtype.preconnectedSpace isPreconnected_Icc
  have hsurjective : Function.Surjective map := by
    intro target
    have htarget : target ∈ Set.Icc left right := by
      change (0 : ℝ) ≤ target ∧ (target : ℝ) ≤ horizon
      exact target.property
    have htarget' : target ∈ Set.Icc (map left) (map right) := by
      simpa [left, right, hzero, hend] using htarget
    exact intermediate_value_univ left right hcontinuous htarget'
  let orderIso : Set.Icc (0 : ℝ) horizon ≃o Set.Icc (0 : ℝ) horizon :=
    hstrict.orderIsoOfSurjective map hsurjective
  refine ⟨orderIso.toHomeomorph, ?_⟩
  exact OrderIso.strictMono orderIso

@[simp]
theorem ofContinuousStrictMono_apply {horizon : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (map : Set.Icc (0 : ℝ) horizon → Set.Icc (0 : ℝ) horizon)
    (hcontinuous : Continuous map) (hstrict : StrictMono map)
    (hzero : map ⟨0, le_rfl, horizon_nonneg⟩ = ⟨0, le_rfl, horizon_nonneg⟩)
    (hend : map ⟨horizon, horizon_nonneg, le_rfl⟩ =
      ⟨horizon, horizon_nonneg, le_rfl⟩)
    (time : Set.Icc (0 : ℝ) horizon) :
    (ofContinuousStrictMono horizon_nonneg map hcontinuous hstrict hzero hend).toHomeomorph time =
      map time := by
  simp [ofContinuousStrictMono]

/-- The real-valued piecewise-affine map that sends one prescribed interior
time to another while fixing the endpoints of an interval. -/
noncomputable def oneKnotLinear (horizon source target : ℝ) : ℝ → ℝ :=
  fun time => if time ≤ source then (target / source) * time else
    target + ((horizon - target) / (horizon - source)) * (time - source)

theorem continuous_oneKnotLinear {horizon source target : ℝ}
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon) :
    Continuous (oneKnotLinear horizon source target) := by
  let left : ℝ → ℝ := fun time => (target / source) * time
  let right : ℝ → ℝ := fun time =>
    target + ((horizon - target) / (horizon - source)) * (time - source)
  change Continuous (fun time => if time ≤ source then left time else right time)
  apply Continuous.if
  · intro time htime
    rw [show {time : ℝ | time ≤ source} = Set.Iic source by rfl, frontier_Iic] at htime
    subst time
    dsimp [left, right]
    field_simp
    ring
  · fun_prop
  · fun_prop

theorem strictMono_oneKnotLinear {horizon source target : ℝ}
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon) :
    StrictMono (oneKnotLinear horizon source target) := by
  let left : ℝ → ℝ := fun time => (target / source) * time
  let right : ℝ → ℝ := fun time =>
    target + ((horizon - target) / (horizon - source)) * (time - source)
  have hleft_pos : 0 < target / source := div_pos htarget_pos hsource_pos
  have hright_pos : 0 < (horizon - target) / (horizon - source) :=
    div_pos (sub_pos.mpr htarget_lt) (sub_pos.mpr hsource_lt)
  have hleft : StrictMono left := by
    exact strictMono_mul_left_of_pos hleft_pos
  have hright : StrictMono right := by
    have hsub : StrictMono (fun time : ℝ => time - source) := by
      simpa only [sub_eq_add_neg] using strictMono_id.add_const (-source)
    exact (strictMono_mul_left_of_pos hright_pos).comp hsub |>.const_add target
  change StrictMono (fun time => if time ≤ source then left time else right time)
  apply StrictMono.ite' hleft hright
  · intro first second hfirstSecond hsecond
    exact hfirstSecond.le.trans hsecond
  · intro first second hfirst hsecond hfirstSecond
    have hsource_second : source < second := lt_of_not_ge hsecond
    calc
      left first ≤ left source := hleft.monotone hfirst
      _ = target := by
        dsimp [left]
        field_simp
      _ = right source := by simp [right]
      _ < right second := hright hsource_second

/-- The endpoint-fixing one-knot interpolation, restricted to its compact
time interval. -/
noncomputable def oneKnotMap (horizon source target : ℝ)
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon) :
    Set.Icc (0 : ℝ) horizon → Set.Icc (0 : ℝ) horizon := fun time => by
  refine ⟨oneKnotLinear horizon source target time, ?_⟩
  rw [show oneKnotLinear horizon source target time =
    if (time : ℝ) ≤ source then (target / source) * (time : ℝ) else
      target + ((horizon - target) / (horizon - source)) * ((time : ℝ) - source) by rfl]
  by_cases htime : (time : ℝ) ≤ source
  · simp only [if_pos htime]
    have hratio_nonneg : 0 ≤ target / source := (div_pos htarget_pos hsource_pos).le
    have hproduct_nonneg : 0 ≤ (target / source) * (time : ℝ) :=
      mul_nonneg hratio_nonneg time.property.1
    have hproduct_le : (target / source) * (time : ℝ) ≤ (target / source) * source :=
      mul_le_mul_of_nonneg_left htime hratio_nonneg
    have hproduct_target : (target / source) * source = target := by field_simp
    exact ⟨hproduct_nonneg, hproduct_le.trans_eq hproduct_target |>.trans htarget_lt.le⟩
  · simp only [if_neg htime]
    have htime_source : source ≤ (time : ℝ) := (lt_of_not_ge htime).le
    have hratio_nonneg : 0 ≤ (horizon - target) / (horizon - source) :=
      (div_pos (sub_pos.mpr htarget_lt) (sub_pos.mpr hsource_lt)).le
    have hdiff_nonneg : 0 ≤ (time : ℝ) - source := sub_nonneg.mpr htime_source
    have hdiff_le : (time : ℝ) - source ≤ horizon - source :=
      sub_le_sub_right time.property.2 source
    have hproduct_le : ((horizon - target) / (horizon - source)) * ((time : ℝ) - source) ≤
        ((horizon - target) / (horizon - source)) * (horizon - source) :=
      mul_le_mul_of_nonneg_left hdiff_le hratio_nonneg
    have hproduct_horizon :
        target + ((horizon - target) / (horizon - source)) * (horizon - source) = horizon := by
      field_simp [sub_ne_zero.mpr hsource_lt.ne.symm]
      ring
    have hupper : target + ((horizon - target) / (horizon - source)) * ((time : ℝ) - source)
        ≤ target + ((horizon - target) / (horizon - source)) * (horizon - source) := by
      simpa [add_comm] using add_le_add_left hproduct_le target
    exact ⟨add_nonneg htarget_pos.le (mul_nonneg hratio_nonneg hdiff_nonneg),
      hupper.trans_eq hproduct_horizon⟩

theorem continuous_oneKnotMap {horizon source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon) :
    Continuous (oneKnotMap horizon source target horizon_nonneg
      hsource_pos hsource_lt htarget_pos htarget_lt) := by
  apply Continuous.subtype_mk
  exact (continuous_oneKnotLinear hsource_pos hsource_lt htarget_pos htarget_lt).comp
    continuous_subtype_val

theorem strictMono_oneKnotMap {horizon source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon) :
    StrictMono (oneKnotMap horizon source target horizon_nonneg
      hsource_pos hsource_lt htarget_pos htarget_lt) := by
  intro first second hfirstSecond
  change oneKnotLinear horizon source target (first : ℝ) <
    oneKnotLinear horizon source target (second : ℝ)
  exact strictMono_oneKnotLinear hsource_pos hsource_lt htarget_pos htarget_lt
    (Subtype.coe_lt_coe.mpr hfirstSecond)

@[simp]
theorem oneKnotMap_zero {horizon source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon) :
    oneKnotMap horizon source target horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt
      ⟨0, le_rfl, horizon_nonneg⟩ = ⟨0, le_rfl, horizon_nonneg⟩ := by
  apply Subtype.ext
  change oneKnotLinear horizon source target 0 = 0
  rw [oneKnotLinear, if_pos hsource_pos.le]
  simp

@[simp]
theorem oneKnotMap_horizon {horizon source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon) :
    oneKnotMap horizon source target horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt
      ⟨horizon, horizon_nonneg, le_rfl⟩ = ⟨horizon, horizon_nonneg, le_rfl⟩ := by
  apply Subtype.ext
  change oneKnotLinear horizon source target horizon = horizon
  rw [oneKnotLinear, if_neg (not_le_of_gt hsource_lt)]
  field_simp [sub_ne_zero.mpr hsource_lt.ne.symm]
  ring

@[simp]
theorem oneKnotMap_source {horizon source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon) :
    oneKnotMap horizon source target horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt
      ⟨source, hsource_pos.le, hsource_lt.le⟩ = ⟨target, htarget_pos.le, htarget_lt.le⟩ := by
  apply Subtype.ext
  change oneKnotLinear horizon source target source = target
  rw [oneKnotLinear, if_pos le_rfl]
  field_simp [hsource_pos.ne']

/-- The Skorokhod time change obtained from the endpoint-fixing
one-knot interpolation. -/
noncomputable def oneKnotTimeChange (horizon source target : ℝ)
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon) :
    SkorokhodTimeChange horizon :=
  ofContinuousStrictMono horizon_nonneg
    (oneKnotMap horizon source target horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt)
    (continuous_oneKnotMap horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt)
    (strictMono_oneKnotMap horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt)
    (oneKnotMap_zero horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt)
    (oneKnotMap_horizon horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt)

@[simp]
theorem oneKnotTimeChange_apply {horizon source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon)
    (time : Set.Icc (0 : ℝ) horizon) :
    (oneKnotTimeChange horizon source target horizon_nonneg hsource_pos hsource_lt
      htarget_pos htarget_lt).toHomeomorph time =
      oneKnotMap horizon source target horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt
        time := by
  simp [oneKnotTimeChange]

@[simp]
theorem oneKnotTimeChange_source {horizon source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon) :
    (oneKnotTimeChange horizon source target horizon_nonneg hsource_pos hsource_lt
      htarget_pos htarget_lt).toHomeomorph ⟨source, hsource_pos.le, hsource_lt.le⟩ =
      ⟨target, htarget_pos.le, htarget_lt.le⟩ := by
  rw [oneKnotTimeChange_apply]
  exact oneKnotMap_source horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt

/-- The one-knot time change moves no point by more than the displacement of
the matched knot. -/
theorem abs_sub_oneKnotTimeChange_le {horizon source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon)
    (time : Set.Icc (0 : ℝ) horizon) :
    |(((oneKnotTimeChange horizon source target horizon_nonneg hsource_pos hsource_lt
      htarget_pos htarget_lt).toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
      (time : ℝ)| ≤ |target - source| := by
  rw [oneKnotTimeChange_apply]
  change |oneKnotLinear horizon source target (time : ℝ) - (time : ℝ)| ≤ |target - source|
  rw [oneKnotLinear]
  by_cases htime : (time : ℝ) ≤ source
  · rw [if_pos htime]
    have hrewrite : (target / source) * (time : ℝ) - (time : ℝ) =
        ((target - source) / source) * (time : ℝ) := by
      field_simp [hsource_pos.ne']
    rw [hrewrite, abs_mul, abs_div, abs_of_pos hsource_pos,
      abs_of_nonneg time.property.1]
    have hdiv_le_one : (time : ℝ) / source ≤ 1 := (div_le_one₀ hsource_pos).mpr htime
    calc
      |target - source| / source * (time : ℝ) = |target - source| * ((time : ℝ) / source) := by
        ring
      _ ≤ |target - source| * 1 :=
        mul_le_mul_of_nonneg_left hdiv_le_one (abs_nonneg _)
      _ = |target - source| := by ring
  · rw [if_neg htime]
    have htime_source : source ≤ (time : ℝ) := (lt_of_not_ge htime).le
    have hdenom_pos : 0 < horizon - source := sub_pos.mpr hsource_lt
    have hdiff_nonneg : 0 ≤ (time : ℝ) - source := sub_nonneg.mpr htime_source
    have hdiff_le : (time : ℝ) - source ≤ horizon - source :=
      sub_le_sub_right time.property.2 source
    have hrewrite :
        target + ((horizon - target) / (horizon - source)) * ((time : ℝ) - source) -
            (time : ℝ) =
          (target - source) * (1 - ((time : ℝ) - source) / (horizon - source)) := by
      field_simp [sub_ne_zero.mpr hsource_lt.ne.symm]
      ring
    rw [hrewrite, abs_mul]
    have hquotient_nonneg : 0 ≤ ((time : ℝ) - source) / (horizon - source) :=
      div_nonneg hdiff_nonneg hdenom_pos.le
    have hquotient_le_one : ((time : ℝ) - source) / (horizon - source) ≤ 1 :=
      (div_le_one₀ hdenom_pos).mpr hdiff_le
    have hfactor_nonneg : 0 ≤ 1 - ((time : ℝ) - source) / (horizon - source) :=
      sub_nonneg.mpr hquotient_le_one
    rw [abs_of_nonneg hfactor_nonneg]
    calc
      |target - source| * (1 - ((time : ℝ) - source) / (horizon - source)) ≤
          |target - source| * 1 :=
        mul_le_mul_of_nonneg_left (by linarith) (abs_nonneg _)
      _ = |target - source| := by ring

/-- A one-knot time change preserves the before-versus-after side of its
matched knot. -/
theorem oneKnotTimeChange_lt_source_iff {horizon source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon)
    (time : Set.Icc (0 : ℝ) horizon) :
    (time : ℝ) < source ↔
      ((oneKnotTimeChange horizon source target horizon_nonneg hsource_pos hsource_lt
        htarget_pos htarget_lt).toHomeomorph time : Set.Icc (0 : ℝ) horizon) < target := by
  let sourceTime : Set.Icc (0 : ℝ) horizon :=
    ⟨source, hsource_pos.le, hsource_lt.le⟩
  let targetTime : Set.Icc (0 : ℝ) horizon :=
    ⟨target, htarget_pos.le, htarget_lt.le⟩
  have hstrict := (oneKnotTimeChange horizon source target horizon_nonneg hsource_pos hsource_lt
    htarget_pos htarget_lt).strictMono'
  have hmapsource :
      (oneKnotTimeChange horizon source target horizon_nonneg hsource_pos hsource_lt
        htarget_pos htarget_lt).toHomeomorph sourceTime = targetTime := by
    simpa [sourceTime, targetTime] using
      (oneKnotTimeChange_source horizon_nonneg hsource_pos hsource_lt htarget_pos htarget_lt)
  have hiff := hstrict.lt_iff_lt (a := time) (b := sourceTime)
  rw [hmapsource] at hiff
  simpa [sourceTime, targetTime] using hiff.symm

/-- The real-valued interpolation that fixes the interval up to `anchor` and
then moves one later knot.  It is the inductive step for aligning a finite
ordered family of jumps without disturbing the knots already aligned. -/
noncomputable def tailOneKnotLinear (horizon anchor source target : ℝ) : ℝ → ℝ :=
  fun time => if time ≤ anchor then time else
    anchor + oneKnotLinear (horizon - anchor) (source - anchor) (target - anchor)
      (time - anchor)

theorem continuous_tailOneKnotLinear {horizon anchor source target : ℝ}
    (hanchor_nonneg : 0 ≤ anchor) (hanchor_lt : anchor < horizon)
    (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon) :
    Continuous (tailOneKnotLinear horizon anchor source target) := by
  let left : ℝ → ℝ := fun time => time
  let right : ℝ → ℝ := fun time =>
    anchor + oneKnotLinear (horizon - anchor) (source - anchor) (target - anchor)
      (time - anchor)
  change Continuous (fun time => if time ≤ anchor then left time else right time)
  apply Continuous.if
  · intro time htime
    rw [show {time : ℝ | time ≤ anchor} = Set.Iic anchor by rfl, frontier_Iic] at htime
    subst time
    dsimp [left, right]
    simp only [sub_self]
    change anchor = anchor + oneKnotLinear (horizon - anchor) (source - anchor)
      (target - anchor) 0
    rw [oneKnotLinear, if_pos (sub_nonneg.mpr hsource.le)]
    ring
  · fun_prop
  · exact (continuous_oneKnotLinear (sub_pos.mpr hsource) (sub_lt_sub_right hsource_lt anchor)
      (sub_pos.mpr htarget) (sub_lt_sub_right htarget_lt anchor)).comp
        (continuous_id.sub continuous_const) |>.const_add anchor

theorem strictMono_tailOneKnotLinear {horizon anchor source target : ℝ}
    (hanchor_nonneg : 0 ≤ anchor) (hanchor_lt : anchor < horizon)
    (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon) :
    StrictMono (tailOneKnotLinear horizon anchor source target) := by
  let left : ℝ → ℝ := fun time => time
  let right : ℝ → ℝ := fun time =>
    anchor + oneKnotLinear (horizon - anchor) (source - anchor) (target - anchor)
      (time - anchor)
  have hleft : StrictMono left := strictMono_id
  have hsub : StrictMono (fun time : ℝ => time - anchor) := by
    simpa only [sub_eq_add_neg] using strictMono_id.add_const (-anchor)
  have hright : StrictMono right := by
    exact (strictMono_oneKnotLinear (sub_pos.mpr hsource) (sub_lt_sub_right hsource_lt anchor)
      (sub_pos.mpr htarget) (sub_lt_sub_right htarget_lt anchor)).comp hsub |>.const_add anchor
  change StrictMono (fun time => if time ≤ anchor then left time else right time)
  apply StrictMono.ite' hleft hright
  · intro first second hfirstSecond hsecond
    exact hfirstSecond.le.trans hsecond
  · intro first second hfirst hsecond hfirstSecond
    have hanchor_second : anchor < second := lt_of_not_ge hsecond
    calc
      left first ≤ left anchor := hleft.monotone hfirst
      _ = right anchor := by
        dsimp [left, right]
        simp only [sub_self]
        change anchor = anchor + oneKnotLinear (horizon - anchor) (source - anchor)
          (target - anchor) 0
        rw [oneKnotLinear, if_pos (sub_nonneg.mpr hsource.le)]
        ring
      _ < right second := hright hanchor_second

/-- The compact-interval version of the tail-local one-knot interpolation. -/
noncomputable def tailOneKnotMap (horizon anchor source target : ℝ)
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon) :
    Set.Icc (0 : ℝ) horizon → Set.Icc (0 : ℝ) horizon := fun time => by
  by_cases htime : (time : ℝ) ≤ anchor
  · exact time
  · let tailTime : Set.Icc (0 : ℝ) (horizon - anchor) :=
      ⟨(time : ℝ) - anchor, sub_nonneg.mpr (lt_of_not_ge htime).le,
        sub_le_sub_right time.property.2 anchor⟩
    let mapped : Set.Icc (0 : ℝ) (horizon - anchor) :=
      oneKnotMap (horizon - anchor) (source - anchor) (target - anchor)
        (sub_nonneg.mpr hanchor_lt.le) (sub_pos.mpr hsource)
        (sub_lt_sub_right hsource_lt anchor) (sub_pos.mpr htarget)
        (sub_lt_sub_right htarget_lt anchor) tailTime
    refine ⟨anchor + (mapped : ℝ), ?_⟩
    constructor
    · exact add_nonneg hanchor_nonneg mapped.property.1
    · calc
        anchor + (mapped : ℝ) ≤ anchor + (horizon - anchor) :=
          by simpa [add_comm] using add_le_add_left mapped.property.2 anchor
        _ = horizon := by ring

theorem tailOneKnotMap_coe {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon)
    (time : Set.Icc (0 : ℝ) horizon) :
    (tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt time : ℝ) =
      tailOneKnotLinear horizon anchor source target time := by
  dsimp [tailOneKnotMap]
  split <;> rename_i htime
  · simp [tailOneKnotLinear, htime]
  · change anchor + oneKnotLinear (horizon - anchor) (source - anchor) (target - anchor)
      ((time : ℝ) - anchor) = tailOneKnotLinear horizon anchor source target time
    rw [tailOneKnotLinear, if_neg htime]

theorem continuous_tailOneKnotMap {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon) :
    Continuous (tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt) := by
  apply Continuous.subtype_mk
  convert (continuous_tailOneKnotLinear hanchor_nonneg hanchor_lt hsource hsource_lt
    htarget htarget_lt).comp continuous_subtype_val using 1
  ext time
  exact tailOneKnotMap_coe horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
    htarget htarget_lt time

theorem strictMono_tailOneKnotMap {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon) :
    StrictMono (tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt) := by
  intro first second hfirstSecond
  change (tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
    hsource hsource_lt htarget htarget_lt first : ℝ) <
      (tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
        hsource hsource_lt htarget htarget_lt second : ℝ)
  rw [tailOneKnotMap_coe horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
    htarget htarget_lt first, tailOneKnotMap_coe horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt second]
  exact strictMono_tailOneKnotLinear hanchor_nonneg hanchor_lt hsource hsource_lt
    htarget htarget_lt (Subtype.coe_lt_coe.mpr hfirstSecond)

@[simp]
theorem tailOneKnotMap_zero {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon) :
    tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt ⟨0, le_rfl, horizon_nonneg⟩ =
        ⟨0, le_rfl, horizon_nonneg⟩ := by
  apply Subtype.ext
  rw [tailOneKnotMap_coe horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
    htarget htarget_lt]
  change tailOneKnotLinear horizon anchor source target 0 = 0
  rw [tailOneKnotLinear, if_pos hanchor_nonneg]

@[simp]
theorem tailOneKnotMap_horizon {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon) :
    tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt ⟨horizon, horizon_nonneg, le_rfl⟩ =
        ⟨horizon, horizon_nonneg, le_rfl⟩ := by
  apply Subtype.ext
  rw [tailOneKnotMap_coe horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
    htarget htarget_lt]
  change tailOneKnotLinear horizon anchor source target horizon = horizon
  rw [tailOneKnotLinear, if_neg (not_le_of_gt hanchor_lt), oneKnotLinear,
    if_neg (not_le_of_gt (sub_lt_sub_right hsource_lt anchor))]
  field_simp [sub_ne_zero.mpr hsource_lt.ne.symm]
  ring

@[simp]
theorem tailOneKnotMap_source {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon) :
    tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt
        ⟨source, hanchor_nonneg.trans hsource.le, hsource_lt.le⟩ =
          ⟨target, hanchor_nonneg.trans htarget.le, htarget_lt.le⟩ := by
  apply Subtype.ext
  rw [tailOneKnotMap_coe horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
    htarget htarget_lt]
  change tailOneKnotLinear horizon anchor source target source = target
  rw [tailOneKnotLinear, if_neg (not_le_of_gt hsource), oneKnotLinear,
    if_pos le_rfl]
  have hdenom : source - anchor ≠ 0 := sub_ne_zero.mpr hsource.ne.symm
  rw [div_mul_cancel₀ (target - anchor) hdenom]
  ring

/-- The tail-local one-knot Skorokhod time change. -/
noncomputable def tailOneKnotTimeChange (horizon anchor source target : ℝ)
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon) :
    SkorokhodTimeChange horizon :=
  ofContinuousStrictMono horizon_nonneg
    (tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt)
    (continuous_tailOneKnotMap horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
      htarget htarget_lt)
    (strictMono_tailOneKnotMap horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
      htarget htarget_lt)
    (tailOneKnotMap_zero horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
      htarget htarget_lt)
    (tailOneKnotMap_horizon horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
      htarget htarget_lt)

@[simp]
theorem tailOneKnotTimeChange_apply {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon)
    (time : Set.Icc (0 : ℝ) horizon) :
    (tailOneKnotTimeChange horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt).toHomeomorph time =
      tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
        hsource hsource_lt htarget htarget_lt time := by
  simp [tailOneKnotTimeChange]

theorem tailOneKnotMap_eq_id_of_le {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon)
    (time : Set.Icc (0 : ℝ) horizon) (htime : (time : ℝ) ≤ anchor) :
    tailOneKnotMap horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt time = time := by
  dsimp [tailOneKnotMap]
  rw [dif_pos htime]

@[simp]
theorem tailOneKnotTimeChange_source {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon) :
    (tailOneKnotTimeChange horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt).toHomeomorph
        ⟨source, hanchor_nonneg.trans hsource.le, hsource_lt.le⟩ =
          ⟨target, hanchor_nonneg.trans htarget.le, htarget_lt.le⟩ := by
  rw [tailOneKnotTimeChange_apply]
  exact tailOneKnotMap_source horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
    htarget htarget_lt

/-- The tail-local map moves no point by more than the displacement of the
newly aligned knot. -/
theorem abs_sub_tailOneKnotTimeChange_le {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon)
    (time : Set.Icc (0 : ℝ) horizon) :
    |(((tailOneKnotTimeChange horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt).toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
      (time : ℝ)| ≤ |target - source| := by
  rw [tailOneKnotTimeChange_apply]
  by_cases htime : (time : ℝ) ≤ anchor
  · rw [tailOneKnotMap_eq_id_of_le horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
      htarget htarget_lt time htime]
    simp
  · let tailTime : Set.Icc (0 : ℝ) (horizon - anchor) :=
      ⟨(time : ℝ) - anchor, sub_nonneg.mpr (lt_of_not_ge htime).le,
        sub_le_sub_right time.property.2 anchor⟩
    have hlocal := abs_sub_oneKnotTimeChange_le
      (horizon := horizon - anchor) (source := source - anchor) (target := target - anchor)
      (sub_nonneg.mpr hanchor_lt.le) (sub_pos.mpr hsource)
      (sub_lt_sub_right hsource_lt anchor) (sub_pos.mpr htarget)
      (sub_lt_sub_right htarget_lt anchor) tailTime
    rw [oneKnotTimeChange_apply] at hlocal
    change |oneKnotLinear (horizon - anchor) (source - anchor) (target - anchor)
      (tailTime : ℝ) - (tailTime : ℝ)| ≤ |(target - anchor) - (source - anchor)| at hlocal
    rw [tailOneKnotMap_coe horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
      htarget htarget_lt time, tailOneKnotLinear, if_neg htime]
    convert hlocal using 1 <;> dsimp [tailTime] <;> ring

/-- The tail-local time change fixes all times at or before its anchor. -/
theorem tailOneKnotTimeChange_eq_id_of_le {horizon anchor source target : ℝ}
    (horizon_nonneg : 0 ≤ horizon) (hanchor_nonneg : 0 ≤ anchor)
    (hanchor_lt : anchor < horizon) (hsource : anchor < source) (hsource_lt : source < horizon)
    (htarget : anchor < target) (htarget_lt : target < horizon)
    (time : Set.Icc (0 : ℝ) horizon) (htime : (time : ℝ) ≤ anchor) :
    (tailOneKnotTimeChange horizon anchor source target horizon_nonneg hanchor_nonneg hanchor_lt
      hsource hsource_lt htarget htarget_lt).toHomeomorph time = time := by
  rw [tailOneKnotTimeChange_apply]
  exact tailOneKnotMap_eq_id_of_le horizon_nonneg hanchor_nonneg hanchor_lt hsource hsource_lt
    htarget htarget_lt time htime

/-- The displacement of composed Skorokhod time changes is bounded by the
sum of the second displacement at the first image and the first displacement. -/
theorem abs_sub_comp_le {horizon : ℝ} (first second : SkorokhodTimeChange horizon)
    (time : Set.Icc (0 : ℝ) horizon) :
    |(((first.comp second).toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
      (time : ℝ)| ≤
        (|((second.toHomeomorph (first.toHomeomorph time) : Set.Icc (0 : ℝ) horizon) : ℝ) -
          ((first.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ)| +
        |((first.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) - (time : ℝ)|) := by
  change abs (((second.toHomeomorph (first.toHomeomorph time) : Set.Icc (0 : ℝ) horizon) : ℝ) -
      (time : ℝ)) ≤ _
  exact abs_sub_le _ _ _

/-- A finite ordered family of knots lying strictly after `anchor` can be
matched to another such family by an increasing time change that fixes the
whole prefix through `anchor`.  The construction successively applies the
tail-local one-knot interpolation, so later corrections never disturb knots
that have already been aligned. -/
theorem exists_tailTimeChange_of_strictMono {count : ℕ}
    {horizon anchor : ℝ} (source target : Fin count → ℝ)
    (horizon_nonneg : 0 ≤ horizon) (anchor_nonneg : 0 ≤ anchor) (anchor_lt : anchor < horizon)
    (hsource_anchor : ∀ index, anchor < source index)
    (hsource_horizon : ∀ index, source index < horizon)
    (htarget_anchor : ∀ index, anchor < target index)
    (htarget_horizon : ∀ index, target index < horizon)
    (hsource_strict : StrictMono source) (htarget_strict : StrictMono target) :
    ∃ timeChange : SkorokhodTimeChange horizon,
      (∀ time : Set.Icc (0 : ℝ) horizon, (time : ℝ) ≤ anchor →
        timeChange.toHomeomorph time = time) ∧
      ∀ index,
        timeChange.toHomeomorph
            ⟨source index, anchor_nonneg.trans (hsource_anchor index).le,
              (hsource_horizon index).le⟩ =
          ⟨target index, anchor_nonneg.trans (htarget_anchor index).le,
            (htarget_horizon index).le⟩ := by
  induction count generalizing anchor with
  | zero =>
      refine ⟨identity horizon, ?_, ?_⟩
      · intro time _
        exact identity_apply horizon time
      · intro index
        exact Fin.elim0 index
  | succ count ih =>
      let sourceZero : Set.Icc (0 : ℝ) horizon :=
        ⟨source 0, anchor_nonneg.trans (hsource_anchor 0).le, (hsource_horizon 0).le⟩
      let targetZero : Set.Icc (0 : ℝ) horizon :=
        ⟨target 0, anchor_nonneg.trans (htarget_anchor 0).le, (htarget_horizon 0).le⟩
      let firstChange := tailOneKnotTimeChange horizon anchor (source 0) (target 0)
        horizon_nonneg anchor_nonneg anchor_lt (hsource_anchor 0) (hsource_horizon 0)
        (htarget_anchor 0) (htarget_horizon 0)
      have hfirst_zero : firstChange.toHomeomorph sourceZero = targetZero := by
        dsimp [firstChange, sourceZero, targetZero]
        exact tailOneKnotTimeChange_source horizon_nonneg anchor_nonneg anchor_lt
          (hsource_anchor 0) (hsource_horizon 0) (htarget_anchor 0) (htarget_horizon 0)
      have hfirst_horizon : firstChange.toHomeomorph
          ⟨horizon, horizon_nonneg, le_rfl⟩ = ⟨horizon, horizon_nonneg, le_rfl⟩ := by
        change (tailOneKnotTimeChange horizon anchor (source 0) (target 0)
          horizon_nonneg anchor_nonneg anchor_lt (hsource_anchor 0) (hsource_horizon 0)
          (htarget_anchor 0) (htarget_horizon 0)).toHomeomorph
            ⟨horizon, horizon_nonneg, le_rfl⟩ = ⟨horizon, horizon_nonneg, le_rfl⟩
        rw [tailOneKnotTimeChange_apply]
        exact tailOneKnotMap_horizon horizon_nonneg anchor_nonneg anchor_lt
          (hsource_anchor 0) (hsource_horizon 0) (htarget_anchor 0) (htarget_horizon 0)
      let sourceTail : Fin count → ℝ := fun index =>
        ((firstChange.toHomeomorph
          ⟨source index.succ, anchor_nonneg.trans (hsource_anchor index.succ).le,
            (hsource_horizon index.succ).le⟩ : Set.Icc (0 : ℝ) horizon) : ℝ)
      let targetTail : Fin count → ℝ := fun index => target index.succ
      have hsourceTail_anchor : ∀ index, target 0 < sourceTail index := by
        intro index
        have hstrict := firstChange.strictMono'
          (a := sourceZero)
          (b := ⟨source index.succ,
            anchor_nonneg.trans (hsource_anchor index.succ).le,
            (hsource_horizon index.succ).le⟩)
          (by
            change source 0 < source index.succ
            apply hsource_strict
            change 0 < index.val + 1
            omega)
        rw [hfirst_zero] at hstrict
        simpa [sourceTail, targetZero] using hstrict
      have hsourceTail_horizon : ∀ index, sourceTail index < horizon := by
        intro index
        have hstrict := firstChange.strictMono'
          (a := ⟨source index.succ,
            anchor_nonneg.trans (hsource_anchor index.succ).le,
            (hsource_horizon index.succ).le⟩)
          (b := ⟨horizon, horizon_nonneg, le_rfl⟩)
          (by
            change source index.succ < horizon
            exact hsource_horizon index.succ)
        rw [hfirst_horizon] at hstrict
        simpa [sourceTail] using hstrict
      have htargetTail_anchor : ∀ index, target 0 < targetTail index := by
        intro index
        change target 0 < target index.succ
        exact htarget_strict (by
          change 0 < index.val + 1
          omega)
      have htargetTail_horizon : ∀ index, targetTail index < horizon := by
        intro index
        exact htarget_horizon index.succ
      have hsourceTail_strict : StrictMono sourceTail := by
        intro first second hfirst_second
        have hsucc : first.succ < second.succ := by
          change first.val + 1 < second.val + 1
          change first.val < second.val at hfirst_second
          omega
        have hsource_lt : source first.succ < source second.succ :=
          hsource_strict hsucc
        have hstrict := firstChange.strictMono'
          (a := ⟨source first.succ,
            anchor_nonneg.trans (hsource_anchor first.succ).le,
            (hsource_horizon first.succ).le⟩)
          (b := ⟨source second.succ,
            anchor_nonneg.trans (hsource_anchor second.succ).le,
            (hsource_horizon second.succ).le⟩)
          (by
            change source first.succ < source second.succ
            exact hsource_lt)
        simpa [sourceTail] using hstrict
      have htargetTail_strict : StrictMono targetTail := by
        intro first second hfirst_second
        change target first.succ < target second.succ
        apply htarget_strict
        change first.val + 1 < second.val + 1
        change first.val < second.val at hfirst_second
        omega
      obtain ⟨tailChange, htail_fix, htail_maps⟩ := ih (anchor := target 0) sourceTail targetTail
        (anchor_nonneg.trans (htarget_anchor 0).le) (htarget_horizon 0)
        hsourceTail_anchor hsourceTail_horizon htargetTail_anchor htargetTail_horizon
        hsourceTail_strict htargetTail_strict
      refine ⟨firstChange.comp tailChange, ?_, ?_⟩
      · intro time htime
        rw [comp_apply]
        have hfirst_fix : firstChange.toHomeomorph time = time := by
          dsimp [firstChange]
          exact tailOneKnotTimeChange_eq_id_of_le horizon_nonneg anchor_nonneg anchor_lt
            (hsource_anchor 0) (hsource_horizon 0) (htarget_anchor 0) (htarget_horizon 0)
            time htime
        rw [hfirst_fix]
        exact htail_fix time (htime.trans (htarget_anchor 0).le)
      · intro index
        refine Fin.cases ?_ ?_ index
        · rw [comp_apply, hfirst_zero]
          exact htail_fix targetZero le_rfl
        · intro tailIndex
          rw [comp_apply]
          simpa [sourceTail, targetTail] using htail_maps tailIndex

/-- Quantitative version of `exists_tailTimeChange_of_strictMono`.  If every
source knot is moved by at most `delta`, the successive prefix-preserving
interpolations move every time by at most `(2 ^ count - 1) * delta`.  The
exponential bound is deliberately elementary: at each recursive stage the
already-applied interpolation can add one prior knot displacement to each
remaining knot error. -/
theorem exists_tailTimeChange_of_strictMono_with_displacement {count : ℕ}
    {horizon anchor delta : ℝ} (source target : Fin count → ℝ)
    (horizon_nonneg : 0 ≤ horizon) (anchor_nonneg : 0 ≤ anchor) (anchor_lt : anchor < horizon)
    (hsource_anchor : ∀ index, anchor < source index)
    (hsource_horizon : ∀ index, source index < horizon)
    (htarget_anchor : ∀ index, anchor < target index)
    (htarget_horizon : ∀ index, target index < horizon)
    (hsource_strict : StrictMono source) (htarget_strict : StrictMono target)
    (hdisplacement : ∀ index, |target index - source index| ≤ delta) :
    ∃ timeChange : SkorokhodTimeChange horizon,
      (∀ time : Set.Icc (0 : ℝ) horizon, (time : ℝ) ≤ anchor →
        timeChange.toHomeomorph time = time) ∧
      (∀ index,
        timeChange.toHomeomorph
            ⟨source index, anchor_nonneg.trans (hsource_anchor index).le,
              (hsource_horizon index).le⟩ =
          ⟨target index, anchor_nonneg.trans (htarget_anchor index).le,
            (htarget_horizon index).le⟩) ∧
      ∀ time : Set.Icc (0 : ℝ) horizon,
        |((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
          (time : ℝ)| ≤ ((2 : ℝ) ^ count - 1) * delta := by
  induction count generalizing anchor delta with
  | zero =>
      refine ⟨identity horizon, ?_, ?_, ?_⟩
      · intro time _
        exact identity_apply horizon time
      · intro index
        exact Fin.elim0 index
      · intro time
        rw [identity_apply]
        norm_num
  | succ count ih =>
      let sourceZero : Set.Icc (0 : ℝ) horizon :=
        ⟨source 0, anchor_nonneg.trans (hsource_anchor 0).le, (hsource_horizon 0).le⟩
      let targetZero : Set.Icc (0 : ℝ) horizon :=
        ⟨target 0, anchor_nonneg.trans (htarget_anchor 0).le, (htarget_horizon 0).le⟩
      let firstChange := tailOneKnotTimeChange horizon anchor (source 0) (target 0)
        horizon_nonneg anchor_nonneg anchor_lt (hsource_anchor 0) (hsource_horizon 0)
        (htarget_anchor 0) (htarget_horizon 0)
      have hfirst_zero : firstChange.toHomeomorph sourceZero = targetZero := by
        dsimp [firstChange, sourceZero, targetZero]
        exact tailOneKnotTimeChange_source horizon_nonneg anchor_nonneg anchor_lt
          (hsource_anchor 0) (hsource_horizon 0) (htarget_anchor 0) (htarget_horizon 0)
      have hfirst_horizon : firstChange.toHomeomorph
          ⟨horizon, horizon_nonneg, le_rfl⟩ = ⟨horizon, horizon_nonneg, le_rfl⟩ := by
        change (tailOneKnotTimeChange horizon anchor (source 0) (target 0)
          horizon_nonneg anchor_nonneg anchor_lt (hsource_anchor 0) (hsource_horizon 0)
          (htarget_anchor 0) (htarget_horizon 0)).toHomeomorph
            ⟨horizon, horizon_nonneg, le_rfl⟩ = ⟨horizon, horizon_nonneg, le_rfl⟩
        rw [tailOneKnotTimeChange_apply]
        exact tailOneKnotMap_horizon horizon_nonneg anchor_nonneg anchor_lt
          (hsource_anchor 0) (hsource_horizon 0) (htarget_anchor 0) (htarget_horizon 0)
      let sourceTail : Fin count → ℝ := fun index =>
        ((firstChange.toHomeomorph
          ⟨source index.succ, anchor_nonneg.trans (hsource_anchor index.succ).le,
            (hsource_horizon index.succ).le⟩ : Set.Icc (0 : ℝ) horizon) : ℝ)
      let targetTail : Fin count → ℝ := fun index => target index.succ
      have hsourceTail_anchor : ∀ index, target 0 < sourceTail index := by
        intro index
        have hstrict := firstChange.strictMono'
          (a := sourceZero)
          (b := ⟨source index.succ,
            anchor_nonneg.trans (hsource_anchor index.succ).le,
            (hsource_horizon index.succ).le⟩)
          (by
            change source 0 < source index.succ
            apply hsource_strict
            change 0 < index.val + 1
            omega)
        rw [hfirst_zero] at hstrict
        simpa [sourceTail, targetZero] using hstrict
      have hsourceTail_horizon : ∀ index, sourceTail index < horizon := by
        intro index
        have hstrict := firstChange.strictMono'
          (a := ⟨source index.succ,
            anchor_nonneg.trans (hsource_anchor index.succ).le,
            (hsource_horizon index.succ).le⟩)
          (b := ⟨horizon, horizon_nonneg, le_rfl⟩)
          (by
            change source index.succ < horizon
            exact hsource_horizon index.succ)
        rw [hfirst_horizon] at hstrict
        simpa [sourceTail] using hstrict
      have htargetTail_anchor : ∀ index, target 0 < targetTail index := by
        intro index
        change target 0 < target index.succ
        exact htarget_strict (by
          change 0 < index.val + 1
          omega)
      have htargetTail_horizon : ∀ index, targetTail index < horizon := by
        intro index
        exact htarget_horizon index.succ
      have hsourceTail_strict : StrictMono sourceTail := by
        intro first second hfirst_second
        have hsucc : first.succ < second.succ := by
          change first.val + 1 < second.val + 1
          change first.val < second.val at hfirst_second
          omega
        have hsource_lt : source first.succ < source second.succ :=
          hsource_strict hsucc
        have hstrict := firstChange.strictMono'
          (a := ⟨source first.succ,
            anchor_nonneg.trans (hsource_anchor first.succ).le,
            (hsource_horizon first.succ).le⟩)
          (b := ⟨source second.succ,
            anchor_nonneg.trans (hsource_anchor second.succ).le,
            (hsource_horizon second.succ).le⟩)
          (by
            change source first.succ < source second.succ
            exact hsource_lt)
        simpa [sourceTail] using hstrict
      have htargetTail_strict : StrictMono targetTail := by
        intro first second hfirst_second
        change target first.succ < target second.succ
        apply htarget_strict
        change first.val + 1 < second.val + 1
        change first.val < second.val at hfirst_second
        omega
      have htail_displacement : ∀ index, |targetTail index - sourceTail index| ≤ 2 * delta := by
        intro index
        have hfirst_displacement :
            |sourceTail index - source index.succ| ≤ |target 0 - source 0| := by
          simpa [sourceTail, firstChange, abs_sub_comm] using
            (abs_sub_tailOneKnotTimeChange_le horizon_nonneg anchor_nonneg anchor_lt
              (hsource_anchor 0) (hsource_horizon 0) (htarget_anchor 0)
              (htarget_horizon 0)
              ⟨source index.succ,
                anchor_nonneg.trans (hsource_anchor index.succ).le,
                (hsource_horizon index.succ).le⟩)
        calc
          |targetTail index - sourceTail index| ≤
              |target index.succ - source index.succ| +
                |source index.succ - sourceTail index| := by
            simpa [targetTail] using abs_sub_le (target index.succ) (source index.succ)
              (sourceTail index)
          _ ≤ delta + delta := by
            gcongr
            · exact hdisplacement index.succ
            · calc
                |source index.succ - sourceTail index| ≤ |target 0 - source 0| := by
                  simpa [abs_sub_comm] using hfirst_displacement
                _ ≤ delta := hdisplacement 0
          _ = 2 * delta := by ring
      obtain ⟨tailChange, htail_fix, htail_maps, htail_bound⟩ :=
        ih (anchor := target 0) (delta := 2 * delta) sourceTail targetTail
          (anchor_nonneg.trans (htarget_anchor 0).le) (htarget_horizon 0)
          hsourceTail_anchor hsourceTail_horizon htargetTail_anchor htargetTail_horizon
          hsourceTail_strict htargetTail_strict htail_displacement
      refine ⟨firstChange.comp tailChange, ?_, ?_, ?_⟩
      · intro time htime
        rw [comp_apply]
        have hfirst_fix : firstChange.toHomeomorph time = time := by
          dsimp [firstChange]
          exact tailOneKnotTimeChange_eq_id_of_le horizon_nonneg anchor_nonneg anchor_lt
            (hsource_anchor 0) (hsource_horizon 0) (htarget_anchor 0) (htarget_horizon 0)
            time htime
        rw [hfirst_fix]
        exact htail_fix time (htime.trans (htarget_anchor 0).le)
      · intro index
        refine Fin.cases ?_ ?_ index
        · rw [comp_apply, hfirst_zero]
          exact htail_fix targetZero le_rfl
        · intro tailIndex
          rw [comp_apply]
          simpa [sourceTail, targetTail] using htail_maps tailIndex
      · intro time
        have hfirst_bound :
            |((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
              (time : ℝ)| ≤ delta := by
          calc
            |((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
                (time : ℝ)| ≤ |target 0 - source 0| := by
              simpa [firstChange] using
                (abs_sub_tailOneKnotTimeChange_le horizon_nonneg anchor_nonneg anchor_lt
                  (hsource_anchor 0) (hsource_horizon 0) (htarget_anchor 0)
                  (htarget_horizon 0) time)
            _ ≤ delta := hdisplacement 0
        have htail_bound_at_first :
            |((tailChange.toHomeomorph (firstChange.toHomeomorph time) :
                Set.Icc (0 : ℝ) horizon) : ℝ) -
              ((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ)| ≤
              ((2 : ℝ) ^ count - 1) * (2 * delta) :=
          htail_bound (firstChange.toHomeomorph time)
        calc
          |(((firstChange.comp tailChange).toHomeomorph time :
              Set.Icc (0 : ℝ) horizon) : ℝ) - (time : ℝ)| ≤
              |((tailChange.toHomeomorph (firstChange.toHomeomorph time) :
                  Set.Icc (0 : ℝ) horizon) : ℝ) -
                ((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ)| +
                |((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
                  (time : ℝ)| :=
            abs_sub_comp_le firstChange tailChange time
          _ ≤ ((2 : ℝ) ^ count - 1) * (2 * delta) + delta :=
            add_le_add htail_bound_at_first hfirst_bound
          _ = ((2 : ℝ) ^ Nat.succ count - 1) * delta := by
            rw [pow_succ]
            ring

/-- An increasing self-homeomorphism of a nonempty compact interval fixes its
left endpoint. -/
theorem map_zero {horizon : ℝ} (timeChange : SkorokhodTimeChange horizon)
    (horizon_nonneg : 0 ≤ horizon) :
    timeChange.toHomeomorph ⟨0, le_rfl, horizon_nonneg⟩ =
      ⟨0, le_rfl, horizon_nonneg⟩ := by
  let zeroTime : Set.Icc (0 : ℝ) horizon := ⟨0, le_rfl, horizon_nonneg⟩
  apply Subtype.ext
  apply le_antisymm
  · obtain ⟨preimage, hpreimage⟩ := timeChange.toHomeomorph.surjective zeroTime
    have hzero_le : zeroTime ≤ preimage := by
      exact preimage.property.1
    have hmonotone := timeChange.strictMono'.monotone hzero_le
    rw [hpreimage] at hmonotone
    exact hmonotone
  · exact (timeChange.toHomeomorph zeroTime).property.1

end SkorokhodTimeChange

/-- Two real-time paths are `ε`-close in the finite-horizon `J₁` sense when
one can be matched to the other by an increasing homeomorphic time change
whose displacement and state error are both smaller than `ε`. -/
def SkorokhodJ1CloseOn {State : Type*} [PseudoMetricSpace State]
    (horizon epsilon : ℝ) (first second : ℝ → State) : Prop :=
  ∃ timeChange : SkorokhodTimeChange horizon,
    ∀ time : Set.Icc (0 : ℝ) horizon,
      |((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
          (time : ℝ)| < epsilon ∧
        dist (first (time : ℝ))
          (second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ)) < epsilon

/-- Finite-horizon `J₁` closeness of real paths is invariant under subtracting
the same constant from both paths. -/
theorem SkorokhodJ1CloseOn.sub_const {horizon epsilon constant : ℝ}
    {first second : ℝ → ℝ}
    (hclose : SkorokhodJ1CloseOn horizon epsilon first second) :
    SkorokhodJ1CloseOn horizon epsilon
      (fun time => first time - constant) (fun time => second time - constant) := by
  obtain ⟨timeChange, htimeChange⟩ := hclose
  refine ⟨timeChange, ?_⟩
  intro time
  obtain ⟨htime, hstate⟩ := htimeChange time
  refine ⟨htime, ?_⟩
  simpa [Real.dist_eq] using hstate

/-- A right-continuous path with one jump at a specified time. -/
noncomputable def oneJumpPath {State : Type*} (jump : ℝ) (before after : State) : ℝ → State :=
  fun time => if time < jump then before else after

/-- A right-continuous path with two prescribed jumps.  This elementary
finite-step path is the base case for matching the event times of a
finite-event trajectory in the `J₁` topology. -/
noncomputable def twoJumpPath {State : Type*}
    (firstJump secondJump : ℝ) (before middle after : State) : ℝ → State :=
  fun time => if time < firstJump then before else if time < secondJump then middle else after

/-- The right-continuous step path obtained by changing from `values k` to
`values (k + 1)` at each listed jump time.  The finite set count makes this
definition useful even before an ordering proof for the jump list is supplied. -/
noncomputable def finiteStepPath {State : Type*} {count : ℕ}
    (jumpTimes : Fin count → ℝ) (values : Fin (count + 1) → State) : ℝ → State :=
  fun time => values ⟨((Finset.univ : Finset (Fin count)).filter
      fun index => jumpTimes index ≤ time).card, by
    apply Nat.lt_succ_of_le
    simpa using Finset.card_filter_le (Finset.univ : Finset (Fin count))
      (fun index : Fin count => jumpTimes index ≤ time)⟩

/-- The active value coordinate of a finite step path at a given time. -/
noncomputable def finiteStepIndex {count : ℕ} (jumpTimes : Fin count → ℝ)
    (time : ℝ) : Fin (count + 1) :=
  ⟨((Finset.univ : Finset (Fin count)).filter
      fun index => jumpTimes index ≤ time).card, by
    apply Nat.lt_succ_of_le
    simpa using Finset.card_filter_le (Finset.univ : Finset (Fin count))
      (fun index : Fin count => jumpTimes index ≤ time)⟩

/-- A finite step path takes exactly its active value coordinate at each
time. -/
@[simp]
theorem finiteStepPath_apply_eq_activeValue {State : Type*} {count : ℕ}
    (jumpTimes : Fin count → ℝ) (values : Fin (count + 1) → State) (time : ℝ) :
    finiteStepPath jumpTimes values time = values (finiteStepIndex jumpTimes time) := rfl

/-- The first `mesh²` positive points of the regular grid with spacing
`1 / mesh`.  The square range supplies a single finite step path which
approximates a continuous trajectory on every fixed compact horizon. -/
noncomputable def uniformMeshJumpTimes (mesh : ℕ) : Fin (mesh * mesh) → ℝ :=
  fun index => ((index.val + 1 : ℕ) : ℝ) / (mesh : ℝ)

/-- The nonnegative sample time associated with a value coordinate of the
finite regular mesh. -/
noncomputable def uniformMeshSampleTime (mesh : ℕ) : Fin (mesh * mesh + 1) → NNReal :=
  fun index => ⟨(index.val : ℝ) / (mesh : ℝ),
    div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)⟩

@[simp]
theorem coe_uniformMeshSampleTime (mesh : ℕ) (index : Fin (mesh * mesh + 1)) :
    (uniformMeshSampleTime mesh index : ℝ) = (index.val : ℝ) / (mesh : ℝ) := rfl

@[simp]
theorem uniformMeshSampleTime_zero (mesh : ℕ) : uniformMeshSampleTime mesh 0 = 0 := by
  apply NNReal.eq
  simp [coe_uniformMeshSampleTime]

/-- The regular nonnegative sample times are strictly ordered for a positive
mesh. -/
theorem strictMono_uniformMeshSampleTime {mesh : ℕ} (hmesh : 0 < mesh) :
    StrictMono (uniformMeshSampleTime mesh) := by
  intro first second hfirst_second
  change (uniformMeshSampleTime mesh first : ℝ) < uniformMeshSampleTime mesh second
  simp only [coe_uniformMeshSampleTime]
  have hmesh_real : 0 < (mesh : ℝ) := by exact_mod_cast hmesh
  apply (div_lt_div_iff_of_pos_right hmesh_real).mpr
  exact_mod_cast hfirst_second

/-- Consecutive regular sample times differ by one mesh width. -/
theorem uniformMeshSampleTime_succ_sub_castSucc {mesh : ℕ} (hmesh : 0 < mesh)
    (index : Fin (mesh * mesh)) :
    uniformMeshSampleTime mesh index.succ - uniformMeshSampleTime mesh index.castSucc =
      1 / (mesh : NNReal) := by
  have hle : uniformMeshSampleTime mesh index.castSucc ≤ uniformMeshSampleTime mesh index.succ :=
    (strictMono_uniformMeshSampleTime hmesh).monotone index.castSucc_le_succ
  apply NNReal.eq
  rw [NNReal.coe_sub hle]
  simp only [coe_uniformMeshSampleTime, NNReal.coe_one, NNReal.coe_div, NNReal.coe_natCast,
    Fin.val_succ, Fin.val_castSucc]
  have hmesh_real : (mesh : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hmesh
  field_simp
  push_cast
  ring

@[simp]
theorem toNNReal_coe_uniformMeshSampleTime (mesh : ℕ)
    (index : Fin (mesh * mesh + 1)) :
    ((uniformMeshSampleTime mesh index : ℝ)).toNNReal = uniformMeshSampleTime mesh index := by
  exact Real.toNNReal_coe

/-- The positive uniform mesh times are strictly ordered whenever the mesh is
positive. -/
theorem strictMono_uniformMeshJumpTimes {mesh : ℕ} (hmesh : 0 < mesh) :
    StrictMono (uniformMeshJumpTimes mesh) := by
  intro first second hfirst_second
  have hmesh_real : 0 < (mesh : ℝ) := by exact_mod_cast hmesh
  apply (div_lt_div_iff_of_pos_right hmesh_real).mpr
  exact_mod_cast Nat.succ_lt_succ hfirst_second

/-- On the portion of the regular grid covered by its finite square range,
the active finite-step coordinate is exactly the usual floor-grid index. -/
theorem finiteStepIndex_uniformMesh_val {mesh : ℕ} (hmesh : 0 < mesh)
    {time : ℝ} (htime_nonneg : 0 ≤ time) (htime_le_mesh : time ≤ mesh) :
    (finiteStepIndex (uniformMeshJumpTimes mesh) time).val =
      Nat.floor ((mesh : ℝ) * time) := by
  classical
  let active : Finset (Fin (mesh * mesh)) :=
    (Finset.univ : Finset (Fin (mesh * mesh))).filter
      fun index => uniformMeshJumpTimes mesh index ≤ time
  let floorIndex : ℕ := Nat.floor ((mesh : ℝ) * time)
  have hmesh_real : 0 < (mesh : ℝ) := by exact_mod_cast hmesh
  have hproduct_nonneg : 0 ≤ (mesh : ℝ) * time :=
    mul_nonneg hmesh_real.le htime_nonneg
  have hfloor_le : (floorIndex : ℝ) ≤ (mesh : ℝ) * time := by
    dsimp [floorIndex]
    exact Nat.floor_le hproduct_nonneg
  have htime_scaled_le : (mesh : ℝ) * time ≤ (mesh * mesh : ℕ) := by
    calc
      (mesh : ℝ) * time ≤ (mesh : ℝ) * mesh := by gcongr
      _ = (mesh * mesh : ℕ) := by norm_num
  have hfloor_bound : floorIndex ≤ mesh * mesh := by
    exact_mod_cast hfloor_le.trans htime_scaled_le
  have hcard : active.card = floorIndex := by
    have hbij : (Finset.univ : Finset (Fin floorIndex)).card = active.card := by
      refine Finset.card_bij
        (s := (Finset.univ : Finset (Fin floorIndex))) (t := active)
        (fun index _ => Fin.castLE hfloor_bound index) ?_ ?_ ?_
      · intro index _
        simp only [active, Finset.mem_filter, Finset.mem_univ, true_and]
        rw [uniformMeshJumpTimes]
        apply (div_le_iff₀ hmesh_real).mpr
        have hindex_lt : index.val < floorIndex := index.isLt
        have hindex_succ_le : index.val + 1 ≤ floorIndex := by omega
        change ((index.val + 1 : ℕ) : ℝ) ≤ time * (mesh : ℝ)
        calc
          ((index.val + 1 : ℕ) : ℝ) ≤ (floorIndex : ℝ) := by
            exact_mod_cast hindex_succ_le
          _ ≤ (mesh : ℝ) * time := hfloor_le
          _ = time * (mesh : ℝ) := mul_comm _ _
      · intro first _ second _ heq
        exact Fin.ext (by simpa using congrArg Fin.val heq)
      · intro index hindex
        simp only [active, Finset.mem_filter, Finset.mem_univ, true_and] at hindex
        rw [uniformMeshJumpTimes] at hindex
        have hindex_scaled : ((index.val + 1 : ℕ) : ℝ) ≤ (mesh : ℝ) * time := by
          simpa [mul_comm] using (div_le_iff₀ hmesh_real).mp hindex
        have hindex_succ_le : index.val + 1 ≤ floorIndex := by
          exact_mod_cast Nat.le_floor hindex_scaled
        have hindex_lt : index.val < floorIndex := by omega
        refine ⟨⟨index.val, hindex_lt⟩, ?_, ?_⟩
        · simp
        · apply Fin.ext
          rfl
    simpa using hbij.symm
  change active.card = floorIndex
  exact hcard

/-- The sample time selected by the active coordinate of a positive uniform
mesh is within one mesh width of the current nonnegative time. -/
theorem abs_coe_uniformMeshSampleTime_active_sub_lt_inv
    {mesh : ℕ} (hmesh : 0 < mesh) {time : ℝ}
    (htime_nonneg : 0 ≤ time) (htime_le_mesh : time ≤ mesh) :
    |((uniformMeshSampleTime mesh
      (finiteStepIndex (uniformMeshJumpTimes mesh) time) : NNReal) : ℝ) - time| <
      1 / (mesh : ℝ) := by
  rw [coe_uniformMeshSampleTime,
    finiteStepIndex_uniformMesh_val hmesh htime_nonneg htime_le_mesh]
  exact AppliedModelingLib.Math.nat_floor_mul_div_sub_abs_lt_inv hmesh htime_nonneg

/-- The active regular-mesh sample time never lies after the current time. -/
theorem coe_uniformMeshSampleTime_active_le_time
    {mesh : ℕ} (hmesh : 0 < mesh) {time : ℝ}
    (htime_nonneg : 0 ≤ time) (htime_le_mesh : time ≤ mesh) :
    (uniformMeshSampleTime mesh
      (finiteStepIndex (uniformMeshJumpTimes mesh) time) : ℝ) ≤ time := by
  rw [coe_uniformMeshSampleTime,
    finiteStepIndex_uniformMesh_val hmesh htime_nonneg htime_le_mesh]
  apply (div_le_iff₀ (by exact_mod_cast hmesh)).mpr
  simpa [mul_comm] using
    Nat.floor_le (mul_nonneg (Nat.cast_nonneg mesh) htime_nonneg)

/-- With jump times fixed, uniformly close finite step values give a direct
finite-horizon `J₁` bound.  The identity time change suffices; this is the
value-coordinate counterpart to the moving-knot continuity bridge. -/
theorem finiteStepPath_closeOn_of_valueClose {State : Type*} [PseudoMetricSpace State]
    {horizon epsilon : ℝ} {count : ℕ} (jumpTimes : Fin count → ℝ)
    (firstValues secondValues : Fin (count + 1) → State)
    (hepsilon : 0 < epsilon)
    (hvalues : ∀ index, dist (firstValues index) (secondValues index) < epsilon) :
    SkorokhodJ1CloseOn horizon epsilon
      (finiteStepPath jumpTimes firstValues) (finiteStepPath jumpTimes secondValues) := by
  refine ⟨SkorokhodTimeChange.identity horizon, ?_⟩
  intro time
  constructor
  · rw [SkorokhodTimeChange.identity_apply]
    simpa using hepsilon
  · rw [SkorokhodTimeChange.identity_apply]
    change dist (firstValues ⟨_, _⟩) (secondValues ⟨_, _⟩) < epsilon
    exact hvalues _

/-- If every finite step time is strictly positive, the path value at the
origin is its initial value.  Unlike the ordered-knot variant, this also
covers the empty jump list. -/
theorem finiteStepPath_zero_eq_firstValue_of_all_pos {State : Type*} {count : ℕ}
    (jumpTimes : Fin count → ℝ) (values : Fin (count + 1) → State)
    (hpositive : ∀ index, 0 < jumpTimes index) :
    finiteStepPath jumpTimes values 0 = values 0 := by
  unfold finiteStepPath
  apply congrArg values
  apply Fin.ext
  change ((Finset.univ : Finset (Fin count)).filter
      (fun index => jumpTimes index ≤ (0 : ℝ))).card = 0
  apply Finset.card_eq_zero.mpr
  rw [Finset.filter_eq_empty_iff]
  intro index _
  exact not_le_of_gt (hpositive index)

/-- A strictly ordered finite knot family with no knot at a given horizon has
a unique active prefix: every knot in the prefix is before the horizon and
every remaining knot is after it. -/
theorem exists_activePrefix_of_strictMono_of_forall_ne {count : ℕ}
    (times : Fin count → ℝ) (hstrict : StrictMono times) (horizon : ℝ)
    (hne : ∀ index, times index ≠ horizon) :
    ∃ activePrefix : Fin (count + 1),
      (∀ index : Fin activePrefix.val,
        times (Fin.castLE (Nat.lt_succ_iff.mp activePrefix.isLt) index) < horizon) ∧
      (∀ index : Fin count, activePrefix.val ≤ index.val → horizon < times index) := by
  classical
  by_cases hall : ∀ index : Fin count, times index < horizon
  · refine ⟨⟨count, Nat.lt_succ_self _⟩, ?_, ?_⟩
    · intro index
      simpa using hall (Fin.castLE le_rfl index)
    · intro index hindex
      exact False.elim ((not_lt_of_ge hindex) index.isLt)
  · have hexists : ∃ number : ℕ, ∃ hnumber : number < count,
        ¬ times ⟨number, hnumber⟩ < horizon := by
      simp only [not_forall] at hall
      rcases hall with ⟨index, hindex⟩
      exact ⟨index.val, index.isLt, by simpa using hindex⟩
    let prefixCount : ℕ := Nat.find hexists
    obtain ⟨hprefix_lt, hprefix_not⟩ := Nat.find_spec hexists
    have hprefix : prefixCount < count ∧
        ¬ times ⟨prefixCount, hprefix_lt⟩ < horizon := ⟨hprefix_lt, hprefix_not⟩
    refine ⟨⟨prefixCount, Nat.lt_succ_of_le hprefix.1.le⟩, ?_, ?_⟩
    · intro index
      have hmin : ¬ ∃ hindex : index.val < count,
          ¬ times ⟨index.val, hindex⟩ < horizon :=
        Nat.find_min hexists index.isLt
      by_contra hnot
      apply hmin
      exact ⟨Nat.lt_trans index.isLt hprefix.1, by simpa using hnot⟩
    · intro index hindex
      let first : Fin count := ⟨prefixCount, hprefix.1⟩
      have hfirst : horizon < times first :=
        lt_of_le_of_ne (not_lt.mp hprefix.2) (hne first).symm
      have hfirst_le : first ≤ index := by
        exact Fin.le_iff_val_le_val.mpr hindex
      exact hfirst.trans_le (hstrict.monotone hfirst_le)

/-- On a finite horizon before every knot after a fixed prefix, a finite step
path is exactly the step path formed from that prefix.  This isolates the
active-jump reduction used to analyze local `J₁` restrictions. -/
theorem finiteStepPath_eq_prefix_of_after {State : Type*} {count prefixCount : ℕ}
    (jumpTimes : Fin count → ℝ) (values : Fin (count + 1) → State)
    (hprefix : prefixCount ≤ count) (horizon : ℝ)
    (hafter : ∀ index : Fin count, prefixCount ≤ index.val → horizon < jumpTimes index)
    {time : ℝ} (htime : time ≤ horizon) :
    finiteStepPath jumpTimes values time =
      finiteStepPath
        (fun index : Fin prefixCount => jumpTimes (Fin.castLE hprefix index))
        (fun index : Fin (prefixCount + 1) =>
          values (Fin.castLE (Nat.succ_le_succ hprefix) index)) time := by
  classical
  let prefixTimes : Fin prefixCount → ℝ :=
    fun index => jumpTimes (Fin.castLE hprefix index)
  have hcard : ((Finset.univ : Finset (Fin prefixCount)).filter
      (fun index => prefixTimes index ≤ time)).card =
      ((Finset.univ : Finset (Fin count)).filter
        (fun index => jumpTimes index ≤ time)).card := by
    refine Finset.card_bij
      (s := (Finset.univ : Finset (Fin prefixCount)).filter
        (fun index => prefixTimes index ≤ time))
      (t := (Finset.univ : Finset (Fin count)).filter
        (fun index => jumpTimes index ≤ time))
      (fun index _ => Fin.castLE hprefix index) ?_ ?_ ?_
    · intro index hindex
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hindex ⊢
      simpa [prefixTimes] using hindex
    · intro first _ second _ heq
      apply Fin.ext
      simpa using congrArg Fin.val heq
    · intro index hindex
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hindex
      have hindex_lt : index.val < prefixCount := by
        by_contra hnot
        have hprefix_le : prefixCount ≤ index.val := le_of_not_gt hnot
        have htime_lt : time < jumpTimes index :=
          lt_of_le_of_lt htime (hafter index hprefix_le)
        exact (not_lt_of_ge hindex) htime_lt
      refine ⟨⟨index.val, hindex_lt⟩, ?_, ?_⟩
      · simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        simpa [prefixTimes] using hindex
      · apply Fin.ext
        rfl
  unfold finiteStepPath
  dsimp only [prefixTimes]
  apply congrArg values
  apply Fin.ext
  exact hcard.symm

/-- With a strictly ordered nonempty knot family, a finite step path is the
usual first-jump split: it has the initial value before the first knot and
then follows the tail step path. -/
theorem finiteStepPath_succ {State : Type*} {count : ℕ}
    (jumpTimes : Fin (count + 1) → ℝ) (values : Fin (count + 2) → State)
    (hstrict : StrictMono jumpTimes) (time : ℝ) :
    finiteStepPath jumpTimes values time =
      if time < jumpTimes 0 then values 0 else
        finiteStepPath (fun index : Fin count => jumpTimes index.succ)
          (fun index : Fin (count + 1) => values index.succ) time := by
  by_cases htime : time < jumpTimes 0
  · have hnone : ∀ index : Fin (count + 1), ¬ jumpTimes index ≤ time := by
      intro index hindex
      have hzero_le : jumpTimes 0 ≤ jumpTimes index := by
        rcases Fin.eq_zero_or_eq_succ index with hzero | ⟨predecessor, hpositive⟩
        · subst index
          exact le_rfl
        · subst index
          exact (hstrict (by simpa using hpositive)).le
      exact (not_le_of_gt htime) (hzero_le.trans hindex)
    have hcard : ((Finset.univ : Finset (Fin (count + 1))).filter
        (fun index => jumpTimes index ≤ time)).card = 0 := by
      apply Finset.card_eq_zero.mpr
      rw [Finset.filter_eq_empty_iff]
      intro index hindex
      exact hnone index
    have hleft : finiteStepPath jumpTimes values time = values 0 := by
      unfold finiteStepPath
      apply congrArg values
      apply Fin.ext
      exact hcard
    rw [if_pos htime]
    exact hleft
  · have hzero : jumpTimes 0 ≤ time := le_of_not_gt htime
    rw [if_neg htime]
    have hcard : ((Finset.univ : Finset (Fin (count + 1))).filter
        (fun index => jumpTimes index ≤ time)).card =
        ((Finset.univ : Finset (Fin count)).filter
          (fun index => jumpTimes index.succ ≤ time)).card + 1 := by
      rw [Fin.card_filter_univ_succ]
      simp [hzero]
    unfold finiteStepPath
    apply congrArg values
    apply Fin.ext
    change ((Finset.univ : Finset (Fin (count + 1))).filter
        (fun index => jumpTimes index ≤ time)).card =
      ((Finset.univ : Finset (Fin count)).filter
        (fun index => jumpTimes index.succ ≤ time)).card + 1
    exact hcard

/-- Before the first knot of a nonempty ordered family, its finite step path
has its initial value. -/
theorem finiteStepPath_eq_firstValue_of_lt_first {State : Type*} {count : ℕ}
    (jumpTimes : Fin (count + 1) → ℝ) (values : Fin (count + 2) → State)
    (hstrict : StrictMono jumpTimes) {time : ℝ} (htime : time < jumpTimes 0) :
    finiteStepPath jumpTimes values time = values 0 := by
  rw [finiteStepPath_succ jumpTimes values hstrict time, if_pos htime]

/-- Replacing a càdlàg path by a constant value strictly before an anchor
preserves càdlàg regularity. -/
theorem IsCadlagPath.splice_before {State : Type*} [TopologicalSpace State]
    {path : ℝ → State} {anchor : ℝ} (before : State)
    (hpath : IsCadlagPath path) :
    IsCadlagPath (fun time => if time < anchor then before else path time) := by
  constructor
  · intro time
    by_cases htime : time < anchor
    · change Tendsto (fun other => if other < anchor then before else path other)
        (nhdsWithin time (Set.Ici time)) (nhds (if time < anchor then before else path time))
      rw [if_pos htime]
      apply tendsto_nhds_of_eventually_eq
      refine eventually_nhdsWithin_iff.mpr ?_
      filter_upwards [tendsto_id.eventually_lt_const htime] with other hother _
      have hother' : other < anchor := by simpa using hother
      exact if_pos hother'
    · have hanchor_time : anchor ≤ time := le_of_not_gt htime
      exact (hpath.1 time).congr
        (fun other hother => by
          simp [if_neg (not_lt_of_ge (hanchor_time.trans hother))])
        (by simp [if_neg htime])
  · intro time
    by_cases htime : time ≤ anchor
    · refine ⟨before, ?_⟩
      apply tendsto_nhds_of_eventually_eq
      refine eventually_nhdsWithin_iff.mpr (Filter.Eventually.of_forall fun other hother => ?_)
      simp [if_pos (hother.trans_le htime)]
    · obtain ⟨leftLimit, hleftLimit⟩ := hpath.2 time
      refine ⟨leftLimit, ?_⟩
      apply hleftLimit.congr'
      refine eventually_nhdsWithin_iff.mpr ?_
      filter_upwards [eventually_gt_nhds (lt_of_not_ge htime)] with other hother _
      simp [if_neg (not_lt_of_ge hother.le)]

/-- A finite step path with strictly ordered jump times is càdlàg. -/
theorem isCadlagPath_finiteStepPath {State : Type*} [TopologicalSpace State]
    {count : ℕ} (jumpTimes : Fin count → ℝ) (values : Fin (count + 1) → State)
    (hstrict : StrictMono jumpTimes) :
    IsCadlagPath (finiteStepPath jumpTimes values) := by
  induction count with
  | zero =>
      have hconstant : finiteStepPath jumpTimes values = fun _ => values 0 := by
        funext time
        unfold finiteStepPath
        apply congrArg values
        apply Fin.ext
        simp
      rw [hconstant]
      exact IsCadlagPath.of_continuous continuous_const
  | succ count ih =>
      let tailTimes : Fin count → ℝ := fun index => jumpTimes index.succ
      let tailValues : Fin (count + 1) → State := fun index => values index.succ
      have htailStrict : StrictMono tailTimes := by
        intro first second hfirst_second
        apply hstrict
        simpa using hfirst_second
      have htail : IsCadlagPath (finiteStepPath tailTimes tailValues) :=
        ih tailTimes tailValues htailStrict
      rw [show finiteStepPath jumpTimes values =
          fun time => if time < jumpTimes 0 then values 0 else
            finiteStepPath tailTimes tailValues time by
        funext time
        exact finiteStepPath_succ jumpTimes values hstrict time]
      exact IsCadlagPath.splice_before (values 0) htail

/-- If two finite step paths have the same completed-jump set at two times,
then their values agree at those times. -/
theorem finiteStepPath_eq_of_completed_iff {State : Type*} {count : ℕ}
    (firstTimes secondTimes : Fin count → ℝ) (values : Fin (count + 1) → State)
    (firstTime secondTime : ℝ)
    (hcompleted : ∀ index, firstTimes index ≤ firstTime ↔ secondTimes index ≤ secondTime) :
    finiteStepPath firstTimes values firstTime = finiteStepPath secondTimes values secondTime := by
  have hfilters : (Finset.univ : Finset (Fin count)).filter
      (fun index => firstTimes index ≤ firstTime) =
      (Finset.univ : Finset (Fin count)).filter
        (fun index => secondTimes index ≤ secondTime) := by
    ext index
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact hcompleted index
  simp only [finiteStepPath]
  apply congrArg values
  apply Fin.ext
  exact congrArg Finset.card hfilters

/-- A time change that matches every listed jump time gives an exact
finite-horizon `J₁` match of the corresponding finite step paths.  The
separate construction of such a time change from ordered knots is the
remaining induction problem. -/
theorem finiteStepPath_closeOn_of_timeChange {State : Type*} [PseudoMetricSpace State]
    {horizon epsilon : ℝ} {count : ℕ}
    (timeChange : SkorokhodTimeChange horizon)
    (sourceTimes targetTimes : Fin count → ℝ) (values : Fin (count + 1) → State)
    (hsource_mem : ∀ index, sourceTimes index ∈ Set.Icc (0 : ℝ) horizon)
    (htarget_mem : ∀ index, targetTimes index ∈ Set.Icc (0 : ℝ) horizon)
    (hmaps : ∀ index,
      timeChange.toHomeomorph ⟨sourceTimes index, hsource_mem index⟩ =
        ⟨targetTimes index, htarget_mem index⟩)
    (hepsilon : 0 < epsilon)
    (hdisplacement : ∀ time : Set.Icc (0 : ℝ) horizon,
      |((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
        (time : ℝ)| < epsilon) :
    SkorokhodJ1CloseOn horizon epsilon
      (finiteStepPath sourceTimes values) (finiteStepPath targetTimes values) := by
  refine ⟨timeChange, ?_⟩
  intro time
  constructor
  · exact hdisplacement time
  · have hcompleted : ∀ index, sourceTimes index ≤ (time : ℝ) ↔
        targetTimes index ≤
          ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) := by
      intro index
      have hiff := timeChange.strictMono'.le_iff_le
        (a := ⟨sourceTimes index, hsource_mem index⟩) (b := time)
      rw [hmaps index] at hiff
      simpa using hiff.symm
    have hpath : finiteStepPath sourceTimes values (time : ℝ) =
        finiteStepPath targetTimes values
          ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) :=
      finiteStepPath_eq_of_completed_iff sourceTimes targetTimes values _ _ hcompleted
    rw [hpath]
    exact (dist_self _).trans_lt hepsilon

/-- A uniformly small perturbation of a strictly ordered finite jump family
produces a small finite-horizon `J₁` perturbation of the corresponding step
path.  The explicit factor is the displacement bound of the elementary
prefix-preserving knot alignment. -/
theorem finiteStepPath_closeOn_of_strictMono {State : Type*} [PseudoMetricSpace State]
    {horizon epsilon delta : ℝ} {count : ℕ}
    (sourceTimes targetTimes : Fin count → ℝ) (values : Fin (count + 1) → State)
    (horizon_nonneg : 0 ≤ horizon) (horizon_pos : 0 < horizon)
    (hsource_pos : ∀ index, 0 < sourceTimes index)
    (hsource_horizon : ∀ index, sourceTimes index < horizon)
    (htarget_pos : ∀ index, 0 < targetTimes index)
    (htarget_horizon : ∀ index, targetTimes index < horizon)
    (hsource_strict : StrictMono sourceTimes) (htarget_strict : StrictMono targetTimes)
    (hknot_displacement : ∀ index, |targetTimes index - sourceTimes index| ≤ delta)
    (hepsilon : 0 < epsilon)
    (hbound : ((2 : ℝ) ^ count - 1) * delta < epsilon) :
    SkorokhodJ1CloseOn horizon epsilon
      (finiteStepPath sourceTimes values) (finiteStepPath targetTimes values) := by
  obtain ⟨timeChange, _, hmaps, htimeChange⟩ :=
    SkorokhodTimeChange.exists_tailTimeChange_of_strictMono_with_displacement
      sourceTimes targetTimes horizon_nonneg le_rfl horizon_pos
      hsource_pos hsource_horizon htarget_pos htarget_horizon hsource_strict htarget_strict
      hknot_displacement
  apply finiteStepPath_closeOn_of_timeChange timeChange sourceTimes targetTimes values
    (fun index => ⟨(hsource_pos index).le, (hsource_horizon index).le⟩)
    (fun index => ⟨(htarget_pos index).le, (htarget_horizon index).le⟩) hmaps hepsilon
  intro time
  exact (htimeChange time).trans_lt hbound

/-- Sequential finite-horizon `J₁` convergence, expressed directly through
the standard time-change neighborhoods. -/
def SkorokhodJ1ConvergesOn {State : Type*} [PseudoMetricSpace State]
    (horizon : ℝ) (paths : ℕ → ℝ → State) (limit : ℝ → State) : Prop :=
  ∀ epsilon : ℝ, 0 < epsilon →
    ∀ᶠ n : ℕ in atTop, SkorokhodJ1CloseOn horizon epsilon (paths n) limit

/-- For fixed jump times, convergence of the finite value vector gives
finite-horizon `J₁` convergence of the resulting step paths. -/
theorem finiteStepPath_convergesOn_of_tendsto_values {State : Type*} [PseudoMetricSpace State]
    {horizon : ℝ} {count : ℕ} (jumpTimes : Fin count → ℝ)
    (sourceValues : ℕ → Fin (count + 1) → State)
    (targetValues : Fin (count + 1) → State)
    (hvalues : Tendsto sourceValues atTop (nhds targetValues)) :
    SkorokhodJ1ConvergesOn horizon
      (fun sequence => finiteStepPath jumpTimes (sourceValues sequence))
      (finiteStepPath jumpTimes targetValues) := by
  intro epsilon hepsilon
  have hcoordinate : ∀ index,
      Tendsto (fun sequence => sourceValues sequence index) atTop
        (nhds (targetValues index)) := by
    intro index
    exact tendsto_pi_nhds.mp hvalues index
  have hnear : ∀ᶠ sequence : ℕ in atTop, ∀ index,
      dist (sourceValues sequence index) (targetValues index) < epsilon := by
    rw [eventually_all]
    intro index
    have hball : Metric.ball (targetValues index) epsilon ∈ nhds (targetValues index) :=
      Metric.ball_mem_nhds _ hepsilon
    filter_upwards [(hcoordinate index).eventually hball] with sequence hsequence
    simpa [Metric.mem_ball] using hsequence
  filter_upwards [hnear] with sequence hsequence
  exact finiteStepPath_closeOn_of_valueClose jumpTimes
    (sourceValues sequence) targetValues hepsilon hsequence

/-- For a fixed finite number of events, a convergent sequence of strictly
ordered interior jump-time vectors yields `J₁` convergence of the associated
step paths.  This is the finite-event continuity bridge used when turning
coordinatewise measurable event times into path-space measurability. -/
theorem finiteStepPath_convergesOn_of_tendsto {State : Type*} [PseudoMetricSpace State]
    {horizon : ℝ} {count : ℕ}
    (sourceTimes : ℕ → Fin count → ℝ) (targetTimes : Fin count → ℝ)
    (values : Fin (count + 1) → State)
    (horizon_nonneg : 0 ≤ horizon) (horizon_pos : 0 < horizon)
    (hsource_pos : ∀ sequence index, 0 < sourceTimes sequence index)
    (hsource_horizon : ∀ sequence index, sourceTimes sequence index < horizon)
    (htarget_pos : ∀ index, 0 < targetTimes index)
    (htarget_horizon : ∀ index, targetTimes index < horizon)
    (hsource_strict : ∀ sequence, StrictMono (sourceTimes sequence))
    (htarget_strict : StrictMono targetTimes)
    (htimes_tendsto : Tendsto sourceTimes atTop (nhds targetTimes)) :
    SkorokhodJ1ConvergesOn horizon
      (fun sequence => finiteStepPath (sourceTimes sequence) values)
      (finiteStepPath targetTimes values) := by
  intro epsilon hepsilon
  let delta : ℝ := epsilon / (2 : ℝ) ^ count
  have hpower_pos : 0 < (2 : ℝ) ^ count := pow_pos (by norm_num) _
  have hdelta_pos : 0 < delta := by
    exact div_pos hepsilon hpower_pos
  have hbound : ((2 : ℝ) ^ count - 1) * delta < epsilon := by
    calc
      ((2 : ℝ) ^ count - 1) * delta < (2 : ℝ) ^ count * delta := by
        apply mul_lt_mul_of_pos_right _ hdelta_pos
        linarith
      _ = epsilon := by
        dsimp [delta]
        field_simp
  have hcoordinate_tendsto : ∀ index,
      Tendsto (fun sequence => sourceTimes sequence index) atTop (nhds (targetTimes index)) := by
    intro index
    exact tendsto_pi_nhds.mp htimes_tendsto index
  have hnear : ∀ᶠ sequence : ℕ in atTop, ∀ index,
      |targetTimes index - sourceTimes sequence index| < delta := by
    rw [eventually_all]
    intro index
    have hball : Metric.ball (targetTimes index) delta ∈ nhds (targetTimes index) :=
      Metric.ball_mem_nhds _ hdelta_pos
    filter_upwards [(hcoordinate_tendsto index).eventually hball] with sequence hsequence
    simpa [Metric.mem_ball, Real.dist_eq, abs_sub_comm] using hsequence
  filter_upwards [hnear] with sequence hsequence
  apply finiteStepPath_closeOn_of_strictMono (sourceTimes sequence) targetTimes values
    horizon_nonneg horizon_pos (hsource_pos sequence) (hsource_horizon sequence)
    htarget_pos htarget_horizon (hsource_strict sequence) htarget_strict
    (fun index => (hsequence index).le) hepsilon hbound

/-- Moving one interior jump by less than `epsilon` gives an exact
finite-horizon `J₁` match when the before and after states are unchanged. -/
theorem oneJumpPath_oneKnot_closeOn {State : Type*} [PseudoMetricSpace State]
    {horizon source target epsilon : ℝ} (horizon_nonneg : 0 ≤ horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (htarget_pos : 0 < target) (htarget_lt : target < horizon)
    (hdisplacement : |target - source| < epsilon) (before after : State) :
    SkorokhodJ1CloseOn horizon epsilon
      (oneJumpPath source before after) (oneJumpPath target before after) := by
  refine ⟨SkorokhodTimeChange.oneKnotTimeChange horizon source target horizon_nonneg hsource_pos hsource_lt
    htarget_pos htarget_lt, ?_⟩
  intro time
  constructor
  · exact (SkorokhodTimeChange.abs_sub_oneKnotTimeChange_le horizon_nonneg hsource_pos hsource_lt
      htarget_pos htarget_lt time).trans_lt hdisplacement
  · have hside := SkorokhodTimeChange.oneKnotTimeChange_lt_source_iff horizon_nonneg hsource_pos hsource_lt
      htarget_pos htarget_lt time
    by_cases htime : (time : ℝ) < source
    · have hchanged :
        ((SkorokhodTimeChange.oneKnotTimeChange horizon source target horizon_nonneg hsource_pos hsource_lt
          htarget_pos htarget_lt).toHomeomorph time : Set.Icc (0 : ℝ) horizon) < target :=
        hside.mp htime
      rw [oneJumpPath, oneJumpPath, if_pos htime, if_pos hchanged]
      exact (dist_self before).trans_lt ((abs_nonneg _).trans_lt hdisplacement)
    · have hchanged : ¬
        ((SkorokhodTimeChange.oneKnotTimeChange horizon source target horizon_nonneg hsource_pos hsource_lt
          htarget_pos htarget_lt).toHomeomorph time : Set.Icc (0 : ℝ) horizon) < target := by
        intro hchanged
        exact htime (hside.mpr hchanged)
      rw [oneJumpPath, oneJumpPath, if_neg htime, if_neg hchanged]
      exact (dist_self after).trans_lt ((abs_nonneg _).trans_lt hdisplacement)

/-- Two ordered interior jumps can be aligned by first matching the first
jump and then applying a tail-local time change for the second.  The latter
fixes the first matched jump, which is the essential finite-event induction
invariant. -/
theorem twoJumpPath_twoKnot_closeOn {State : Type*} [PseudoMetricSpace State]
    {horizon sourceFirst sourceSecond targetFirst targetSecond epsilon : ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsourceFirst_pos : 0 < sourceFirst) (hsourceFirst_second : sourceFirst < sourceSecond)
    (hsourceSecond_horizon : sourceSecond < horizon)
    (htargetFirst_pos : 0 < targetFirst) (htargetFirst_second : targetFirst < targetSecond)
    (htargetSecond_horizon : targetSecond < horizon)
    (hdisplacement : 2 * |targetFirst - sourceFirst| + |targetSecond - sourceSecond| < epsilon)
    (before middle after : State) :
    SkorokhodJ1CloseOn horizon epsilon
      (twoJumpPath sourceFirst sourceSecond before middle after)
      (twoJumpPath targetFirst targetSecond before middle after) := by
  let firstChange := SkorokhodTimeChange.oneKnotTimeChange horizon sourceFirst targetFirst
    horizon_nonneg hsourceFirst_pos (hsourceFirst_second.trans hsourceSecond_horizon)
    htargetFirst_pos (htargetFirst_second.trans htargetSecond_horizon)
  let sourceTwoPoint : Set.Icc (0 : ℝ) horizon :=
    firstChange.toHomeomorph
      ⟨sourceSecond, hsourceFirst_pos.le.trans hsourceFirst_second.le,
        hsourceSecond_horizon.le⟩
  let sourceTwo : ℝ := sourceTwoPoint
  have hfirst_source :
      firstChange.toHomeomorph
          ⟨sourceFirst, hsourceFirst_pos.le,
            (hsourceFirst_second.trans hsourceSecond_horizon).le⟩ =
        ⟨targetFirst, htargetFirst_pos.le,
          (htargetFirst_second.trans htargetSecond_horizon).le⟩ := by
    dsimp [firstChange]
    exact SkorokhodTimeChange.oneKnotTimeChange_source horizon_nonneg hsourceFirst_pos
      (hsourceFirst_second.trans hsourceSecond_horizon) htargetFirst_pos
      (htargetFirst_second.trans htargetSecond_horizon)
  have hfirst_horizon :
      firstChange.toHomeomorph ⟨horizon, horizon_nonneg, le_rfl⟩ =
        ⟨horizon, horizon_nonneg, le_rfl⟩ := by
    change (SkorokhodTimeChange.oneKnotTimeChange horizon sourceFirst targetFirst
      horizon_nonneg hsourceFirst_pos (hsourceFirst_second.trans hsourceSecond_horizon)
      htargetFirst_pos (htargetFirst_second.trans htargetSecond_horizon)).toHomeomorph
        ⟨horizon, horizon_nonneg, le_rfl⟩ = ⟨horizon, horizon_nonneg, le_rfl⟩
    rw [SkorokhodTimeChange.oneKnotTimeChange_apply]
    exact SkorokhodTimeChange.oneKnotMap_horizon horizon_nonneg hsourceFirst_pos
      (hsourceFirst_second.trans hsourceSecond_horizon) htargetFirst_pos
      (htargetFirst_second.trans htargetSecond_horizon)
  have hsourceTwo_gt : targetFirst < sourceTwo := by
    have hstrict := firstChange.strictMono'
      (a := ⟨sourceFirst, hsourceFirst_pos.le,
        (hsourceFirst_second.trans hsourceSecond_horizon).le⟩)
      (b := ⟨sourceSecond, hsourceFirst_pos.le.trans hsourceFirst_second.le,
        hsourceSecond_horizon.le⟩)
      (by
        change sourceFirst < sourceSecond
        exact hsourceFirst_second)
    rw [hfirst_source] at hstrict
    simpa [sourceTwo, sourceTwoPoint] using hstrict
  have hsourceTwo_horizon : sourceTwo < horizon := by
    have hstrict := firstChange.strictMono'
      (a := ⟨sourceSecond, hsourceFirst_pos.le.trans hsourceFirst_second.le,
        hsourceSecond_horizon.le⟩)
      (b := ⟨horizon, horizon_nonneg, le_rfl⟩)
      (by
        change sourceSecond < horizon
        exact hsourceSecond_horizon)
    rw [hfirst_horizon] at hstrict
    simpa [sourceTwo, sourceTwoPoint] using hstrict
  have hsourceTwo_pos : 0 < sourceTwo := htargetFirst_pos.trans hsourceTwo_gt
  let secondChange := SkorokhodTimeChange.tailOneKnotTimeChange horizon targetFirst sourceTwo
    targetSecond horizon_nonneg htargetFirst_pos.le
    (htargetFirst_second.trans htargetSecond_horizon) hsourceTwo_gt hsourceTwo_horizon
    htargetFirst_second htargetSecond_horizon
  have hsourceTwoPoint_eq : sourceTwoPoint =
      ⟨sourceTwo, htargetFirst_pos.le.trans hsourceTwo_gt.le, hsourceTwo_horizon.le⟩ := by
    apply Subtype.ext
    rfl
  have hsecond_anchor :
      secondChange.toHomeomorph
          ⟨targetFirst, htargetFirst_pos.le,
            (htargetFirst_second.trans htargetSecond_horizon).le⟩ =
        ⟨targetFirst, htargetFirst_pos.le,
          (htargetFirst_second.trans htargetSecond_horizon).le⟩ := by
    dsimp [secondChange]
    exact SkorokhodTimeChange.tailOneKnotTimeChange_eq_id_of_le horizon_nonneg
      htargetFirst_pos.le (htargetFirst_second.trans htargetSecond_horizon)
      hsourceTwo_gt hsourceTwo_horizon htargetFirst_second htargetSecond_horizon
      ⟨targetFirst, htargetFirst_pos.le,
        (htargetFirst_second.trans htargetSecond_horizon).le⟩ le_rfl
  have hsecond_source : secondChange.toHomeomorph sourceTwoPoint =
      ⟨targetSecond, htargetFirst_pos.le.trans htargetFirst_second.le,
        htargetSecond_horizon.le⟩ := by
    rw [hsourceTwoPoint_eq]
    dsimp [secondChange]
    exact SkorokhodTimeChange.tailOneKnotTimeChange_source horizon_nonneg htargetFirst_pos.le
      (htargetFirst_second.trans htargetSecond_horizon) hsourceTwo_gt hsourceTwo_horizon
      htargetFirst_second htargetSecond_horizon
  have hfinal_sourceFirst :
      (firstChange.comp secondChange).toHomeomorph
          ⟨sourceFirst, hsourceFirst_pos.le,
            (hsourceFirst_second.trans hsourceSecond_horizon).le⟩ =
        ⟨targetFirst, htargetFirst_pos.le,
          (htargetFirst_second.trans htargetSecond_horizon).le⟩ := by
    rw [SkorokhodTimeChange.comp_apply, hfirst_source, hsecond_anchor]
  have hfinal_sourceSecond :
      (firstChange.comp secondChange).toHomeomorph
          ⟨sourceSecond, hsourceFirst_pos.le.trans hsourceFirst_second.le,
            hsourceSecond_horizon.le⟩ =
        ⟨targetSecond, htargetFirst_pos.le.trans htargetFirst_second.le,
          htargetSecond_horizon.le⟩ := by
    rw [SkorokhodTimeChange.comp_apply]
    change secondChange.toHomeomorph sourceTwoPoint = _
    exact hsecond_source
  refine ⟨firstChange.comp secondChange, ?_⟩
  intro time
  constructor
  · have hfirstDisplacement :
        |((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
          (time : ℝ)| ≤ |targetFirst - sourceFirst| := by
      simpa [firstChange] using
        (SkorokhodTimeChange.abs_sub_oneKnotTimeChange_le horizon_nonneg hsourceFirst_pos
          (hsourceFirst_second.trans hsourceSecond_horizon) htargetFirst_pos
          (htargetFirst_second.trans htargetSecond_horizon) time)
    have hsourceTwoDisplacement :
        |sourceTwo - sourceSecond| ≤ |targetFirst - sourceFirst| := by
      simpa [sourceTwo, sourceTwoPoint, firstChange] using
        (SkorokhodTimeChange.abs_sub_oneKnotTimeChange_le horizon_nonneg hsourceFirst_pos
          (hsourceFirst_second.trans hsourceSecond_horizon) htargetFirst_pos
          (htargetFirst_second.trans htargetSecond_horizon)
          ⟨sourceSecond, hsourceFirst_pos.le.trans hsourceFirst_second.le,
            hsourceSecond_horizon.le⟩)
    have htargetSecondSource :
        |targetSecond - sourceTwo| ≤
          |targetSecond - sourceSecond| + |targetFirst - sourceFirst| := by
      calc
        |targetSecond - sourceTwo| ≤
        |targetSecond - sourceSecond| + |sourceSecond - sourceTwo| :=
          abs_sub_le _ _ _
        _ ≤ |targetSecond - sourceSecond| + |targetFirst - sourceFirst| := by
          exact add_le_add_right (by
            simpa [abs_sub_comm] using hsourceTwoDisplacement) _
    have hsecondDisplacement :
        |((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
            Set.Icc (0 : ℝ) horizon) : ℝ) -
          ((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ)| ≤
          |targetSecond - sourceTwo| := by
      simpa [secondChange] using
        (SkorokhodTimeChange.abs_sub_tailOneKnotTimeChange_le horizon_nonneg
          htargetFirst_pos.le (htargetFirst_second.trans htargetSecond_horizon)
          hsourceTwo_gt hsourceTwo_horizon htargetFirst_second htargetSecond_horizon
          (firstChange.toHomeomorph time))
    calc
      |(((firstChange.comp secondChange).toHomeomorph time :
          Set.Icc (0 : ℝ) horizon) : ℝ) - (time : ℝ)| ≤
          |((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
              Set.Icc (0 : ℝ) horizon) : ℝ) -
            ((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ)| +
            |((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
              (time : ℝ)| :=
        SkorokhodTimeChange.abs_sub_comp_le firstChange secondChange time
      _ ≤ |targetSecond - sourceTwo| + |targetFirst - sourceFirst| :=
        add_le_add hsecondDisplacement hfirstDisplacement
      _ ≤ (|targetSecond - sourceSecond| + |targetFirst - sourceFirst|) +
          |targetFirst - sourceFirst| := by
        gcongr
      _ = 2 * |targetFirst - sourceFirst| + |targetSecond - sourceSecond| := by ring
      _ < epsilon := hdisplacement
  · have hfirst_iff :
        (time : ℝ) < sourceFirst ↔
          (((firstChange.comp secondChange).toHomeomorph time :
            Set.Icc (0 : ℝ) horizon) : ℝ) < targetFirst := by
      have hiff := (firstChange.comp secondChange).strictMono'.lt_iff_lt
        (a := time)
        (b := ⟨sourceFirst, hsourceFirst_pos.le,
          (hsourceFirst_second.trans hsourceSecond_horizon).le⟩)
      rw [hfinal_sourceFirst] at hiff
      simpa using hiff.symm
    have hsecond_iff :
        (time : ℝ) < sourceSecond ↔
          (((firstChange.comp secondChange).toHomeomorph time :
            Set.Icc (0 : ℝ) horizon) : ℝ) < targetSecond := by
      have hiff := (firstChange.comp secondChange).strictMono'.lt_iff_lt
        (a := time)
        (b := ⟨sourceSecond, hsourceFirst_pos.le.trans hsourceFirst_second.le,
          hsourceSecond_horizon.le⟩)
      rw [hfinal_sourceSecond] at hiff
      simpa using hiff.symm
    have hepsilon : 0 < epsilon := by
      have hnonneg : 0 ≤ 2 * |targetFirst - sourceFirst| + |targetSecond - sourceSecond| := by
        positivity
      exact hnonneg.trans_lt hdisplacement
    by_cases htime_first : (time : ℝ) < sourceFirst
    · have hchanged_first :
          (((firstChange.comp secondChange).toHomeomorph time :
            Set.Icc (0 : ℝ) horizon) : ℝ) < targetFirst := hfirst_iff.mp htime_first
      have hchanged_first' :
          ((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
            Set.Icc (0 : ℝ) horizon) : ℝ) < targetFirst := by
        simpa only [SkorokhodTimeChange.comp_apply] using hchanged_first
      simpa [twoJumpPath, htime_first, hchanged_first'] using
        (show dist before before < epsilon from (dist_self before).trans_lt hepsilon)
    · by_cases htime_second : (time : ℝ) < sourceSecond
      · have hchanged_first : ¬
            (((firstChange.comp secondChange).toHomeomorph time :
              Set.Icc (0 : ℝ) horizon) : ℝ) < targetFirst := by
            intro h
            exact htime_first (hfirst_iff.mpr h)
        have hchanged_second :
            (((firstChange.comp secondChange).toHomeomorph time :
              Set.Icc (0 : ℝ) horizon) : ℝ) < targetSecond := hsecond_iff.mp htime_second
        have hchanged_first' : ¬
            ((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
              Set.Icc (0 : ℝ) horizon) : ℝ) < targetFirst := by
          simpa only [SkorokhodTimeChange.comp_apply] using hchanged_first
        have hchanged_second' :
            ((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
              Set.Icc (0 : ℝ) horizon) : ℝ) < targetSecond := by
          simpa only [SkorokhodTimeChange.comp_apply] using hchanged_second
        simpa [twoJumpPath, htime_first, htime_second, hchanged_first', hchanged_second'] using
          (show dist middle middle < epsilon from (dist_self middle).trans_lt hepsilon)
      · have hchanged_second : ¬
            (((firstChange.comp secondChange).toHomeomorph time :
              Set.Icc (0 : ℝ) horizon) : ℝ) < targetSecond := by
            intro h
            exact htime_second (hsecond_iff.mpr h)
        have hchanged_second' : ¬
            ((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
              Set.Icc (0 : ℝ) horizon) : ℝ) < targetSecond := by
          simpa only [SkorokhodTimeChange.comp_apply] using hchanged_second
        have hchanged_first' : ¬
            ((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
              Set.Icc (0 : ℝ) horizon) : ℝ) < targetFirst := by
          intro h
          exact hchanged_second' (h.trans htargetFirst_second)
        simpa [twoJumpPath, htime_first, htime_second, hchanged_first', hchanged_second'] using
          (show dist after after < epsilon from (dist_self after).trans_lt hepsilon)

/-- A one-jump path is continuous in its interior jump time for the
finite-horizon `J₁` topology. -/
theorem oneJumpPath_convergesOn_of_tendsto {State : Type*} [PseudoMetricSpace State]
    {horizon source : ℝ} {sources : ℕ → ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsources_pos : ∀ index, 0 < sources index)
    (hsources_lt : ∀ index, sources index < horizon)
    (hsource_pos : 0 < source) (hsource_lt : source < horizon)
    (hsources_tendsto : Tendsto sources atTop (nhds source)) (before after : State) :
    SkorokhodJ1ConvergesOn horizon
      (fun index => oneJumpPath (sources index) before after)
      (oneJumpPath source before after) := by
  intro epsilon hepsilon
  have heventually : ∀ᶠ index : ℕ in atTop, |source - sources index| < epsilon := by
    have hball : Metric.ball source epsilon ∈ nhds source := Metric.ball_mem_nhds _ hepsilon
    filter_upwards [hsources_tendsto.eventually hball] with index hindex
    simpa [Metric.mem_ball, Real.dist_eq, abs_sub_comm] using hindex
  filter_upwards [heventually] with index hindex
  exact oneJumpPath_oneKnot_closeOn horizon_nonneg (hsources_pos index) (hsources_lt index)
    hsource_pos hsource_lt hindex before after

/-- A two-jump step path is continuous in its ordered pair of interior jump
times for the finite-horizon `J₁` topology. -/
theorem twoJumpPath_convergesOn_of_tendsto {State : Type*} [PseudoMetricSpace State]
    {horizon sourceFirst sourceSecond : ℝ}
    {sourceFirsts sourceSeconds : ℕ → ℝ}
    (horizon_nonneg : 0 ≤ horizon)
    (hsourceFirsts_pos : ∀ index, 0 < sourceFirsts index)
    (hsourceFirsts_second : ∀ index, sourceFirsts index < sourceSeconds index)
    (hsourceSeconds_horizon : ∀ index, sourceSeconds index < horizon)
    (hsourceFirst_pos : 0 < sourceFirst) (hsourceFirst_second : sourceFirst < sourceSecond)
    (hsourceSecond_horizon : sourceSecond < horizon)
    (hsourceFirsts_tendsto : Tendsto sourceFirsts atTop (nhds sourceFirst))
    (hsourceSeconds_tendsto : Tendsto sourceSeconds atTop (nhds sourceSecond))
    (before middle after : State) :
    SkorokhodJ1ConvergesOn horizon
      (fun index => twoJumpPath (sourceFirsts index) (sourceSeconds index) before middle after)
      (twoJumpPath sourceFirst sourceSecond before middle after) := by
  intro epsilon hepsilon
  have hfirst_near : ∀ᶠ index : ℕ in atTop,
      |sourceFirst - sourceFirsts index| < epsilon / 4 := by
    have hball : Metric.ball sourceFirst (epsilon / 4) ∈ nhds sourceFirst :=
      Metric.ball_mem_nhds _ (by positivity)
    filter_upwards [hsourceFirsts_tendsto.eventually hball] with index hindex
    simpa [Metric.mem_ball, Real.dist_eq, abs_sub_comm] using hindex
  have hsecond_near : ∀ᶠ index : ℕ in atTop,
      |sourceSecond - sourceSeconds index| < epsilon / 4 := by
    have hball : Metric.ball sourceSecond (epsilon / 4) ∈ nhds sourceSecond :=
      Metric.ball_mem_nhds _ (by positivity)
    filter_upwards [hsourceSeconds_tendsto.eventually hball] with index hindex
    simpa [Metric.mem_ball, Real.dist_eq, abs_sub_comm] using hindex
  filter_upwards [hfirst_near, hsecond_near] with index hfirst hsecond
  apply twoJumpPath_twoKnot_closeOn horizon_nonneg
    (hsourceFirsts_pos index) (hsourceFirsts_second index) (hsourceSeconds_horizon index)
    hsourceFirst_pos hsourceFirst_second hsourceSecond_horizon
  nlinarith

/-- The finite-horizon time set on which a real-valued path lies below a
threshold. The left endpoint is omitted only to match interval-integral
conventions; it has no effect on Lebesgue occupation measures. -/
def occupationBelowSet (horizon threshold : ℝ) (path : ℝ → ℝ) : Set ℝ :=
  Set.Ioc 0 horizon ∩ {time | path time ≤ threshold}

/-- The normalized finite-horizon time spent by a real-valued path at or below
a threshold.  This is the path functional used for queueing delay/occupancy
statistics; the explicit `toReal` expresses Lebesgue time as a real number. -/
noncomputable def occupationBelowFraction (horizon threshold : ℝ) (path : ℝ → ℝ) : ℝ :=
  (MeasureTheory.volume (occupationBelowSet horizon threshold path)).toReal / horizon

/-- If a jointly measurable real-valued process has no atom at a threshold at
each fixed time, then almost every sample path spends zero Lebesgue time at
that threshold.  This is the Fubini bridge behind continuity of threshold
occupation functionals. -/
theorem ae_ae_path_ne_threshold_of_marginal_ae
    {Ω : Type*} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} [SFinite μ]
    {path : Ω → ℝ → ℝ} {threshold : ℝ}
    (hjoint : Measurable (fun point : Ω × ℝ => path point.1 point.2))
    (hmarginal : ∀ time : ℝ, ∀ᵐ omega ∂μ, path omega time ≠ threshold) :
    ∀ᵐ omega ∂μ, ∀ᵐ time ∂MeasureTheory.volume, path omega time ≠ threshold := by
  have hset : MeasurableSet {point : Ω × ℝ | path point.1 point.2 ≠ threshold} := by
    have heq : MeasurableSet {point : Ω × ℝ | path point.1 point.2 = threshold} := by
      simpa only [Set.preimage, Set.mem_singleton_iff] using
        ((measurableSet_singleton threshold).preimage hjoint)
    exact heq.compl
  apply (MeasureTheory.Measure.ae_ae_comm hset).mpr
  exact Filter.Eventually.of_forall hmarginal

/-- The finite-horizon càdlàg path type on which the `J₁` uniform structure
is constructed below. -/
structure SkorokhodJ1Path (horizon : ℝ) (State : Type*) [TopologicalSpace State] where
  toCadlagPath : CadlagPathOn ℝ State (Set.Icc (0 : ℝ) horizon)

instance {horizon : ℝ} {State : Type*} [TopologicalSpace State] :
    CoeFun (SkorokhodJ1Path horizon State) (fun _ => ℝ → State) where
  coe path := path.toCadlagPath

/-- The constant finite-horizon path. -/
noncomputable def constantSkorokhodJ1Path {State : Type*} [TopologicalSpace State]
    (horizon : ℝ) (value : State) : SkorokhodJ1Path horizon State where
  toCadlagPath := CadlagPathOn.constant (Set.Icc (0 : ℝ) horizon) value

@[simp]
theorem constantSkorokhodJ1Path_apply {State : Type*} [TopologicalSpace State]
    (horizon : ℝ) (value : State) (time : ℝ) :
    constantSkorokhodJ1Path horizon value time = value := rfl

/-- A sequence of paths tracks another sequence uniformly on a specified
time domain. -/
def UniformlyTracksOn {State : Type*} [PseudoMetricSpace State]
    (first second : ℕ → ℝ → State) (domain : Set ℝ) : Prop :=
  ∀ epsilon : ℝ, 0 < epsilon →
    ∀ᶠ n : ℕ in atTop, ∀ time : ℝ, time ∈ domain →
      dist (first n time) (second n time) < epsilon

namespace UniformlyTracksOn

variable {State : Type*} [PseudoMetricSpace State]

/-- Ordinary uniform convergence is uniform tracking of the constant limit
sequence. -/
theorem of_tendstoUniformlyOn {paths : ℕ → ℝ → State} {limit : ℝ → State}
    {domain : Set ℝ}
    (huniform : TendstoUniformlyOn paths limit atTop domain) :
    UniformlyTracksOn paths (fun _ : ℕ => limit) domain := by
  intro epsilon hepsilon
  simpa [dist_comm] using
    (Metric.tendstoUniformlyOn_iff.mp huniform) epsilon hepsilon

end UniformlyTracksOn

namespace SkorokhodJ1CloseOn

variable {State : Type*} [PseudoMetricSpace State]

/-- Uniform state-value control on a compact horizon implies `J₁` closeness
on that horizon.  The identity time change witnesses the result. -/
theorem of_forall_dist_lt {horizon epsilon : ℝ} {first second : ℝ → State}
    (hepsilon : 0 < epsilon)
    (hvalues : ∀ time ∈ Set.Icc (0 : ℝ) horizon,
      dist (first time) (second time) < epsilon) :
    SkorokhodJ1CloseOn horizon epsilon first second := by
  refine ⟨SkorokhodTimeChange.identity horizon, ?_⟩
  intro time
  constructor
  · simpa [SkorokhodTimeChange.identity_apply] using hepsilon
  · simpa [SkorokhodTimeChange.identity_apply] using hvalues time time.property

/-- Enlarging the radius preserves finite-horizon `J₁` closeness. -/
theorem mono {horizon epsilon delta : ℝ} {first second : ℝ → State}
    (hclose : SkorokhodJ1CloseOn horizon epsilon first second)
    (hradius : epsilon ≤ delta) :
    SkorokhodJ1CloseOn horizon delta first second := by
  rcases hclose with ⟨timeChange, htimeChange⟩
  refine ⟨timeChange, ?_⟩
  intro time
  exact ⟨(htimeChange time).1.trans_le hradius,
    (htimeChange time).2.trans_le hradius⟩

/-- Every path is positively close to itself in the `J₁` relation. -/
theorem self {horizon epsilon : ℝ} {path : ℝ → State} (hepsilon : 0 < epsilon) :
    SkorokhodJ1CloseOn horizon epsilon path path := by
  refine ⟨SkorokhodTimeChange.identity horizon, ?_⟩
  intro time
  constructor
  · simpa using hepsilon
  · simpa using hepsilon

/-- Finite-horizon `J₁` errors compose by adding their radii. -/
theorem trans {horizon epsilon delta : ℝ} {first second third : ℝ → State}
    (hfirst : SkorokhodJ1CloseOn horizon epsilon first second)
    (hsecond : SkorokhodJ1CloseOn horizon delta second third) :
    SkorokhodJ1CloseOn horizon (epsilon + delta) first third := by
  rcases hfirst with ⟨firstChange, hfirstChange⟩
  rcases hsecond with ⟨secondChange, hsecondChange⟩
  refine ⟨firstChange.comp secondChange, ?_⟩
  intro time
  have hfirstTime := (hfirstChange time).1
  have hsecondTime := (hsecondChange (firstChange.toHomeomorph time)).1
  have hfirstPath := (hfirstChange time).2
  have hsecondPath := (hsecondChange (firstChange.toHomeomorph time)).2
  constructor
  · change |((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
      Set.Icc (0 : ℝ) horizon) : ℝ) - (time : ℝ)| < epsilon + delta
    have htriangle :
        |((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
          Set.Icc (0 : ℝ) horizon) : ℝ) - (time : ℝ)| ≤
          |((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
            Set.Icc (0 : ℝ) horizon) : ℝ) -
              ((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ)| +
            |((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ) -
              (time : ℝ)| := by
      exact abs_sub_le _ _ _
    linarith
  · change dist (first (time : ℝ))
      (third ((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
        Set.Icc (0 : ℝ) horizon) : ℝ)) < epsilon + delta
    calc
      dist (first (time : ℝ))
          (third ((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
            Set.Icc (0 : ℝ) horizon) : ℝ))
          ≤ dist (first (time : ℝ))
              (second ((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ)) +
            dist (second ((firstChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ))
              (third ((secondChange.toHomeomorph (firstChange.toHomeomorph time) :
                Set.Icc (0 : ℝ) horizon) : ℝ)) :=
        dist_triangle _ _ _
      _ < epsilon + delta := add_lt_add hfirstPath hsecondPath

/-- Finite-horizon `J₁` closeness is symmetric. -/
theorem symmetric {horizon epsilon : ℝ} {first second : ℝ → State}
    (hclose : SkorokhodJ1CloseOn horizon epsilon first second) :
    SkorokhodJ1CloseOn horizon epsilon second first := by
  rcases hclose with ⟨timeChange, htimeChange⟩
  refine ⟨timeChange.inverse, ?_⟩
  intro time
  let inverseTime : Set.Icc (0 : ℝ) horizon := timeChange.toHomeomorph.symm time
  have htime := htimeChange inverseTime
  constructor
  · change |((timeChange.toHomeomorph.symm time : Set.Icc (0 : ℝ) horizon) : ℝ) -
      (time : ℝ)| < epsilon
    have hforwardInverse : timeChange.toHomeomorph inverseTime = time := by
      simp [inverseTime]
    have hdisplacement : |((timeChange.toHomeomorph inverseTime :
        Set.Icc (0 : ℝ) horizon) : ℝ) - (inverseTime : ℝ)| < epsilon := htime.1
    rw [hforwardInverse] at hdisplacement
    simpa [inverseTime, abs_sub_comm] using hdisplacement
  · change dist (second (time : ℝ))
      (first ((timeChange.toHomeomorph.symm time : Set.Icc (0 : ℝ) horizon) : ℝ)) < epsilon
    have hforwardInverse : timeChange.toHomeomorph inverseTime = time := by
      simp [inverseTime]
    have hpath : dist (first (inverseTime : ℝ))
        (second ((timeChange.toHomeomorph inverseTime :
          Set.Icc (0 : ℝ) horizon) : ℝ)) < epsilon := htime.2
    rw [hforwardInverse] at hpath
    simpa [inverseTime, dist_comm] using hpath

end SkorokhodJ1CloseOn

/-- The finite-horizon `J₁` entourage of radius `epsilon` on càdlàg paths. -/
def SkorokhodJ1Entourage {State : Type*} [PseudoMetricSpace State]
    (horizon epsilon : ℝ) :
    Set (SkorokhodJ1Path horizon State × SkorokhodJ1Path horizon State) :=
  {pair | SkorokhodJ1CloseOn horizon epsilon pair.1 pair.2}

namespace SkorokhodJ1Entourage

open scoped SetRel

variable {State : Type*} [PseudoMetricSpace State]

@[simp]
theorem mem_iff {horizon epsilon : ℝ}
    {first second : SkorokhodJ1Path horizon State} :
    (first, second) ∈ SkorokhodJ1Entourage horizon epsilon ↔
      SkorokhodJ1CloseOn horizon epsilon first second := Iff.rfl

/-- Positive-radius `J₁` entourages contain the diagonal. -/
theorem refl {horizon epsilon : ℝ} (hepsilon : 0 < epsilon)
    (path : SkorokhodJ1Path horizon State) :
    (path, path) ∈ SkorokhodJ1Entourage horizon epsilon :=
  SkorokhodJ1CloseOn.self hepsilon

/-- Each finite-horizon `J₁` entourage is invariant under swapping its two
paths. -/
theorem swap_preimage {horizon epsilon : ℝ} :
    (Prod.swap : (SkorokhodJ1Path horizon State × SkorokhodJ1Path horizon State) →
      SkorokhodJ1Path horizon State × SkorokhodJ1Path horizon State) ⁻¹'
      SkorokhodJ1Entourage (State := State) horizon epsilon =
      SkorokhodJ1Entourage (State := State) horizon epsilon := by
  ext pair
  rcases pair with ⟨first, second⟩
  exact ⟨SkorokhodJ1CloseOn.symmetric, SkorokhodJ1CloseOn.symmetric⟩

/-- Halving the radius gives a composable `J₁` entourage. -/
theorem comp_subset {horizon epsilon : ℝ} (hepsilon : 0 < epsilon) :
    SkorokhodJ1Entourage (State := State) horizon (epsilon / 2) ○
        SkorokhodJ1Entourage (State := State) horizon (epsilon / 2) ⊆
      SkorokhodJ1Entourage (State := State) horizon epsilon := by
  rintro ⟨first, third⟩ ⟨second, hfirst, hsecond⟩
  change SkorokhodJ1CloseOn horizon epsilon first third
  have hcomposed := SkorokhodJ1CloseOn.trans hfirst hsecond
  simpa using hcomposed

/-- Positive-radius finite-horizon `J₁` entourages are a filter basis. -/
def isBasis (horizon : ℝ) : Filter.IsBasis (fun epsilon : ℝ => 0 < epsilon)
    (fun epsilon => SkorokhodJ1Entourage (State := State) horizon epsilon) := by
    refine ⟨⟨1, zero_lt_one⟩, ?_⟩
    intro epsilon delta hepsilon hdelta
    refine ⟨min epsilon delta, lt_min hepsilon hdelta, ?_⟩
    rintro ⟨first, second⟩ hclose
    constructor
    · exact SkorokhodJ1CloseOn.mono hclose (min_le_left _ _)
    · exact SkorokhodJ1CloseOn.mono hclose (min_le_right _ _)

/-- A basis of finite-horizon `J₁` entourages, indexed by positive real
radii. -/
def basis (horizon : ℝ) :
    FilterBasis (SkorokhodJ1Path horizon State × SkorokhodJ1Path horizon State) :=
  (isBasis (State := State) horizon).filterBasis

/-- The uniform core generated by finite-horizon `J₁` time-change
entourages. -/
noncomputable def uniformCore (horizon : ℝ) :
    UniformSpace.Core (SkorokhodJ1Path horizon State) :=
  UniformSpace.Core.mkOfBasis (basis (State := State) horizon)
    (by
      rintro radius ⟨epsilon, hepsilon, rfl⟩ path
      exact refl hepsilon path)
    (by
      rintro radius ⟨epsilon, hepsilon, rfl⟩
      refine ⟨SkorokhodJ1Entourage horizon epsilon, ⟨epsilon, hepsilon, rfl⟩, ?_⟩
      rintro ⟨first, second⟩ hclose
      exact SkorokhodJ1CloseOn.symmetric hclose)
    (by
      rintro radius ⟨epsilon, hepsilon, rfl⟩
      refine ⟨SkorokhodJ1Entourage horizon (epsilon / 2),
        ⟨epsilon / 2, half_pos hepsilon, rfl⟩, ?_⟩
      exact comp_subset (State := State) hepsilon)

/-- The finite-horizon uniform-space structure generated by the `J₁`
time-change entourages. -/
@[reducible] noncomputable def uniformSpace (horizon : ℝ) :
    UniformSpace (SkorokhodJ1Path horizon State) :=
  UniformSpace.ofCore (uniformCore (State := State) horizon)

/-- The Borel measurable space associated with the finite-horizon `J₁`
uniform topology. It is explicit rather than a global instance so that this
module does not override another path-space measurable-space choice. -/
@[reducible] noncomputable def borelMeasurableSpace (horizon : ℝ) :
    MeasurableSpace (SkorokhodJ1Path horizon State) := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    uniformSpace (State := State) horizon
  exact borel (SkorokhodJ1Path horizon State)

/-- The explicit finite-horizon measurable space is its `J₁` Borel space. -/
theorem borelSpace (horizon : ℝ) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      uniformSpace (State := State) horizon
    letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
      borelMeasurableSpace (State := State) horizon
    BorelSpace (SkorokhodJ1Path horizon State) := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    uniformSpace (State := State) horizon
  letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
    borelMeasurableSpace (State := State) horizon
  exact ⟨rfl⟩

/-- The `J₁` entourages form a basis of the finite-horizon uniformity. -/
theorem uniformity_hasBasis (horizon : ℝ) :
    (@uniformity (SkorokhodJ1Path horizon State) (uniformSpace (State := State) horizon)).HasBasis
      (fun epsilon : ℝ => 0 < epsilon)
      (fun epsilon => SkorokhodJ1Entourage horizon epsilon) := by
  change (isBasis (State := State) horizon).filter.HasBasis
    (fun epsilon : ℝ => 0 < epsilon)
    (fun epsilon => SkorokhodJ1Entourage (State := State) horizon epsilon)
  exact (isBasis (State := State) horizon).hasBasis

/-- Two finite-horizon path representatives that agree at every observed
time are topologically inseparable for the `J₁` topology.  In particular,
their explicit Borel path spaces have exactly the same measurable sets. -/
theorem inseparable_of_eqOn
    {horizon : ℝ} {first second : SkorokhodJ1Path horizon State}
    (heq : ∀ time : ℝ, time ∈ Set.Icc (0 : ℝ) horizon → first time = second time) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      uniformSpace (State := State) horizon
    Inseparable first second := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    uniformSpace (State := State) horizon
  rw [(uniformity_hasBasis (State := State) horizon).inseparable_iff_uniformity]
  intro epsilon hepsilon
  change SkorokhodJ1CloseOn horizon epsilon first second
  refine ⟨SkorokhodTimeChange.identity horizon, ?_⟩
  intro time
  constructor
  · simpa using hepsilon
  · rw [SkorokhodTimeChange.identity_apply]
    rw [heq time time.property]
    simpa using hepsilon

/-- A countable cofinal basis for the finite-horizon `J₁` uniformity, obtained
by discretizing positive radii with reciprocal naturals. -/
theorem uniformity_hasCountableBasis (horizon : ℝ) :
    (@uniformity (SkorokhodJ1Path horizon State)
      (uniformSpace (State := State) horizon)).HasBasis
      (fun _ : ℕ => True)
      (fun index => SkorokhodJ1Entourage (State := State) horizon
        (1 / ((index + 1 : ℕ) : ℝ))) := by
  rw [Filter.hasBasis_iff]
  intro target
  rw [(uniformity_hasBasis (State := State) horizon).mem_iff]
  constructor
  · rintro ⟨epsilon, hepsilon, hsubset⟩
    obtain ⟨radiusIndex, hradiusIndex⟩ := exists_nat_one_div_lt hepsilon
    have hradiusIndex' : 1 / (((radiusIndex + 1 : ℕ) : ℝ)) < epsilon := by
      simpa [Nat.cast_add, Nat.cast_one] using hradiusIndex
    refine ⟨radiusIndex, trivial, ?_⟩
    intro pair hclose
    exact hsubset (SkorokhodJ1CloseOn.mono hclose (le_of_lt hradiusIndex'))
  · rintro ⟨index, -, hsubset⟩
    refine ⟨1 / ((index + 1 : ℕ) : ℝ), ?_, hsubset⟩
    positivity

/-- The finite-horizon `J₁` uniformity is countably generated. -/
theorem uniformity_isCountablyGenerated (horizon : ℝ) :
    (@uniformity (SkorokhodJ1Path horizon State)
      (uniformSpace (State := State) horizon)).IsCountablyGenerated :=
  (uniformity_hasCountableBasis (State := State) horizon).isCountablyGenerated

/-- The finite-horizon `J₁` topology is pseudometrizable through its explicit
time-change uniformity. -/
theorem pseudoMetrizableSpace (horizon : ℝ) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      uniformSpace (State := State) horizon
    TopologicalSpace.PseudoMetrizableSpace (SkorokhodJ1Path horizon State) := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    uniformSpace (State := State) horizon
  letI : (@uniformity (SkorokhodJ1Path horizon State)
    (uniformSpace (State := State) horizon)).IsCountablyGenerated :=
    uniformity_isCountablyGenerated (State := State) horizon
  infer_instance

/-- Evaluation at the initial time is uniformly continuous for finite-horizon
`J₁` paths: every increasing interval time change fixes that endpoint. -/
theorem uniformContinuous_eval_zero (horizon : ℝ) (horizon_nonneg : 0 ≤ horizon) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      uniformSpace (State := State) horizon
    UniformContinuous (fun path : SkorokhodJ1Path horizon State => path 0) := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    uniformSpace (State := State) horizon
  rw [(uniformity_hasBasis (State := State) horizon).uniformContinuous_iff
    Metric.uniformity_basis_dist]
  intro epsilon hepsilon
  refine ⟨epsilon, hepsilon, ?_⟩
  intro first second hclose
  change dist (first 0) (second 0) < epsilon
  rcases hclose with ⟨timeChange, htimeChange⟩
  have hpath := (htimeChange ⟨0, le_rfl, horizon_nonneg⟩).2
  simpa [SkorokhodTimeChange.map_zero timeChange horizon_nonneg] using hpath

/-- Evaluation at an interior time is continuous at every path that is
continuous at that time. This is the standard pathwise continuity property of
the finite-horizon `J₁` topology; unlike time zero, it is not global. -/
theorem continuousAt_eval_of_continuousAt
    {horizon time : ℝ} {path : SkorokhodJ1Path horizon State}
    (htime : time ∈ Set.Icc (0 : ℝ) horizon)
    (hpath : ContinuousAt (fun t : ℝ => path t) time) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      uniformSpace (State := State) horizon
    ContinuousAt (fun candidate : SkorokhodJ1Path horizon State => candidate time) path := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    uniformSpace (State := State) horizon
  change Tendsto (fun candidate : SkorokhodJ1Path horizon State => candidate time)
    (nhds path) (nhds (path time))
  rw [Metric.tendsto_nhds]
  intro epsilon hepsilon
  have hhalf : 0 < epsilon / 2 := half_pos hepsilon
  let target : Set ℝ := (fun t : ℝ => path t) ⁻¹'
    Metric.ball (path time) (epsilon / 2)
  have htarget : target ∈ nhds time := by
    exact hpath (Metric.ball_mem_nhds _ hhalf)
  rcases Metric.mem_nhds_iff.mp htarget with ⟨delta, hdelta, hball⟩
  let eta : ℝ := min delta (epsilon / 2)
  have heta : 0 < eta := lt_min hdelta hhalf
  have hnear : {candidate : SkorokhodJ1Path horizon State |
      (candidate, path) ∈ SkorokhodJ1Entourage horizon eta} ∈ nhds path := by
    exact (nhds_basis_uniformity
      (uniformity_hasBasis (State := State) horizon)).mem_iff.mpr
      ⟨eta, heta, Set.Subset.rfl⟩
  filter_upwards [hnear] with candidate hcandidate
  change SkorokhodJ1CloseOn horizon eta candidate path at hcandidate
  rcases hcandidate with ⟨timeChange, htimeChange⟩
  let changedTime : ℝ :=
    ((timeChange.toHomeomorph ⟨time, htime⟩ : Set.Icc (0 : ℝ) horizon) : ℝ)
  have hdisplacement : |changedTime - time| < eta := by
    simpa [changedTime] using (htimeChange ⟨time, htime⟩).1
  have hchanged_in_ball : changedTime ∈ Metric.ball time delta := by
    have hdisplacement_delta : |changedTime - time| < delta :=
      lt_of_lt_of_le hdisplacement (min_le_left _ _)
    simpa [Metric.mem_ball, Real.dist_eq] using hdisplacement_delta
  have hpath_changed : dist (path changedTime) (path time) < epsilon / 2 := by
    simpa [target, Metric.mem_ball] using hball hchanged_in_ball
  have hcandidate_changed : dist (candidate time) (path changedTime) < epsilon / 2 := by
    apply lt_of_lt_of_le
      (show dist (candidate time) (path changedTime) < eta by
        simpa [changedTime] using (htimeChange ⟨time, htime⟩).2)
    dsimp [eta]
    exact min_le_right _ _
  calc
    dist (candidate time) (path time) ≤
        dist (candidate time) (path changedTime) + dist (path changedTime) (path time) :=
      dist_triangle _ _ _
    _ < epsilon / 2 + epsilon / 2 := add_lt_add hcandidate_changed hpath_changed
    _ = epsilon := by ring

end SkorokhodJ1Entourage

namespace SkorokhodJ1ConvergesOn

variable {State : Type*} [PseudoMetricSpace State]

/-- On finite-horizon càdlàg paths, the direct time-change definition of
`J₁` convergence is exactly convergence in the uniform topology generated by
the `J₁` entourages. -/
theorem tendsto_iff
    {horizon : ℝ} {paths : ℕ → SkorokhodJ1Path horizon State}
    {limit : SkorokhodJ1Path horizon State} :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) horizon
    Tendsto paths atTop (nhds limit) ↔
      SkorokhodJ1ConvergesOn horizon (fun n => paths n) limit := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) horizon
  change Tendsto paths atTop (nhds limit) ↔
    ∀ epsilon : ℝ, 0 < epsilon →
      ∀ᶠ n : ℕ in atTop,
        SkorokhodJ1CloseOn horizon epsilon (paths n) limit
  rw [(nhds_basis_uniformity
    (SkorokhodJ1Entourage.uniformity_hasBasis (State := State) horizon)).tendsto_right_iff]
  rfl

/-- Uniform convergence on a compact time interval gives `J₁` convergence
there, using the identity time change. -/
theorem of_tendstoUniformlyOn {horizon : ℝ} {paths : ℕ → ℝ → State}
    {limit : ℝ → State}
    (huniform : TendstoUniformlyOn paths limit atTop (Set.Icc (0 : ℝ) horizon)) :
    SkorokhodJ1ConvergesOn horizon paths limit := by
  intro epsilon hepsilon
  have hclose := (Metric.tendstoUniformlyOn_iff.mp huniform) epsilon hepsilon
  filter_upwards [hclose] with n hn
  refine ⟨SkorokhodTimeChange.identity horizon, ?_⟩
  intro time
  constructor
  · simpa using hepsilon
  · simpa [dist_comm] using hn (time : ℝ) time.property

/-- A uniformly vanishing pathwise tracking error may be composed with a
finite-horizon `J₁` limit. -/
theorem of_tendstoUniformlyOn_of_converges
    {horizon : ℝ} {paths approximations : ℕ → ℝ → State} {limit : ℝ → State}
    (happroximation : SkorokhodJ1ConvergesOn horizon approximations limit)
    (htracking : UniformlyTracksOn paths approximations (Set.Icc (0 : ℝ) horizon)) :
    SkorokhodJ1ConvergesOn horizon paths limit := by
  intro epsilon hepsilon
  have hhalf : 0 < epsilon / 2 := half_pos hepsilon
  have htracking' := htracking (epsilon / 2) hhalf
  filter_upwards [happroximation (epsilon / 2) hhalf, htracking'] with n hn htrack
  rcases hn with ⟨timeChange, htimeChange⟩
  refine ⟨timeChange, ?_⟩
  intro time
  constructor
  · exact (htimeChange time).1.trans (by linarith)
  · have happrox : dist (approximations n (time : ℝ))
        (limit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ)) <
        epsilon / 2 :=
      (htimeChange time).2
    have htrack' : dist (paths n (time : ℝ)) (approximations n (time : ℝ)) <
        epsilon / 2 := by
      simpa [dist_comm] using htrack (time : ℝ) time.property
    calc
      dist (paths n (time : ℝ))
          (limit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ))
          ≤ dist (paths n (time : ℝ)) (approximations n (time : ℝ)) +
              dist (approximations n (time : ℝ))
                (limit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) horizon) : ℝ)) :=
        dist_triangle _ _ _
      _ < epsilon / 2 + epsilon / 2 := add_lt_add htrack' happrox
      _ = epsilon := by ring

/-- `J₁` convergence of a constant path sequence is immediate. -/
theorem constant {horizon : ℝ} (path : ℝ → State) :
    SkorokhodJ1ConvergesOn horizon (fun _ : ℕ => path) path := by
  intro epsilon hepsilon
  filter_upwards with n
  exact SkorokhodJ1CloseOn.self hepsilon

/-- At every continuity point of the limiting path, finite-horizon `J₁`
convergence gives ordinary convergence of the corresponding coordinates. -/
theorem tendsto_at_of_continuousAt
    {horizon time : ℝ} {paths : ℕ → ℝ → State} {limit : ℝ → State}
    (hpaths : SkorokhodJ1ConvergesOn horizon paths limit)
    (htime : time ∈ Set.Icc (0 : ℝ) horizon)
    (hlimit : ContinuousAt limit time) :
    Tendsto (fun n : ℕ => paths n time) atTop (nhds (limit time)) := by
  rw [Metric.tendsto_nhds]
  intro epsilon hepsilon
  have hhalf : 0 < epsilon / 2 := half_pos hepsilon
  let target : Set ℝ := limit ⁻¹' Metric.ball (limit time) (epsilon / 2)
  have htarget : target ∈ nhds time := by
    exact hlimit (Metric.ball_mem_nhds _ hhalf)
  rcases Metric.mem_nhds_iff.mp htarget with ⟨delta, hdelta, hball⟩
  let eta : ℝ := min delta (epsilon / 2)
  have heta : 0 < eta := lt_min hdelta hhalf
  filter_upwards [hpaths eta heta] with n hn
  rcases hn with ⟨timeChange, htimeChange⟩
  let changedTime : ℝ :=
    ((timeChange.toHomeomorph ⟨time, htime⟩ : Set.Icc (0 : ℝ) horizon) : ℝ)
  have hdisplacement : |changedTime - time| < eta := by
    simpa [changedTime] using (htimeChange ⟨time, htime⟩).1
  have hchanged_in_ball : changedTime ∈ Metric.ball time delta := by
    have hdisplacement_delta : |changedTime - time| < delta :=
      lt_of_lt_of_le hdisplacement (min_le_left _ _)
    simpa [Metric.mem_ball, Real.dist_eq] using hdisplacement_delta
  have hlimit_changed : dist (limit changedTime) (limit time) < epsilon / 2 := by
    simpa [target, Metric.mem_ball] using hball hchanged_in_ball
  have hpath_changed : dist (paths n time) (limit changedTime) < epsilon / 2 := by
    apply lt_of_lt_of_le
      (show dist (paths n time) (limit changedTime) < eta by
        simpa [changedTime] using (htimeChange ⟨time, htime⟩).2)
    dsimp [eta]
    exact min_le_right _ _
  calc
    dist (paths n time) (limit time)
        ≤ dist (paths n time) (limit changedTime) +
            dist (limit changedTime) (limit time) :=
      dist_triangle _ _ _
    _ < epsilon / 2 + epsilon / 2 := by
      exact add_lt_add hpath_changed hlimit_changed
    _ = epsilon := by ring

/-- On a compact time interval, `J₁` convergence to a continuous path is
ordinary uniform convergence.  The time changes disappear because continuity
of the limit is uniform on the compact interval. -/
theorem tendstoUniformlyOn_of_continuousOn
    {horizon : ℝ} {paths : ℕ → ℝ → State} {limit : ℝ → State}
    (hpaths : SkorokhodJ1ConvergesOn horizon paths limit)
    (hlimit : ContinuousOn limit (Set.Icc (0 : ℝ) horizon)) :
    TendstoUniformlyOn paths limit atTop (Set.Icc (0 : ℝ) horizon) := by
  rw [Metric.tendstoUniformlyOn_iff]
  intro epsilon hepsilon
  have huniform : UniformContinuousOn limit (Set.Icc (0 : ℝ) horizon) :=
    IsCompact.uniformContinuousOn_of_continuous isCompact_Icc hlimit
  obtain ⟨delta, hdelta, hmodulus⟩ :=
    (Metric.uniformContinuousOn_iff.mp huniform) (epsilon / 2) (half_pos hepsilon)
  let eta : ℝ := min delta (epsilon / 2)
  have heta : 0 < eta := lt_min hdelta (half_pos hepsilon)
  filter_upwards [hpaths eta heta] with n hn
  intro time htime
  rcases hn with ⟨timeChange, htimeChange⟩
  let changedTime : ℝ :=
    ((timeChange.toHomeomorph ⟨time, htime⟩ : Set.Icc (0 : ℝ) horizon) : ℝ)
  have hdisplacement : |changedTime - time| < eta := by
    simpa [changedTime] using (htimeChange ⟨time, htime⟩).1
  have hchanged_mem : changedTime ∈ Set.Icc (0 : ℝ) horizon := by
    simpa [changedTime] using
      (timeChange.toHomeomorph ⟨time, htime⟩).property
  have htime_changed : dist time changedTime < delta := by
    have hdisplacement' : |changedTime - time| < delta :=
      hdisplacement.trans_le (min_le_left _ _)
    simpa [Real.dist_eq, abs_sub_comm] using hdisplacement'
  have hlimit_changed : dist (limit time) (limit changedTime) < epsilon / 2 :=
    hmodulus time htime changedTime hchanged_mem htime_changed
  have hpath_changed : dist (paths n time) (limit changedTime) < epsilon / 2 := by
    apply lt_of_lt_of_le
      (show dist (paths n time) (limit changedTime) < eta by
        simpa [changedTime] using (htimeChange ⟨time, htime⟩).2)
    dsimp [eta]
    exact min_le_right _ _
  calc
    dist (limit time) (paths n time)
        ≤ dist (limit time) (limit changedTime) +
            dist (limit changedTime) (paths n time) :=
      dist_triangle _ _ _
    _ < epsilon / 2 + epsilon / 2 := by
      exact add_lt_add hlimit_changed (by simpa [dist_comm] using hpath_changed)
    _ = epsilon := by ring

end SkorokhodJ1ConvergesOn

namespace SkorokhodJ1ConvergesOn

/-- Finite-horizon occupation below a threshold is continuous along `J₁`
convergence to a continuous real-valued limit, provided the limiting path
spends zero Lebesgue time exactly at that threshold.  The measurability
assumptions are explicit because this is a pathwise result and does not choose
a path-space Borel representation. -/
theorem tendsto_volume_occupationBelowSet_of_continuousOn
    {horizon threshold : ℝ} {paths : ℕ → ℝ → ℝ} {limit : ℝ → ℝ}
    (hpaths : SkorokhodJ1ConvergesOn horizon paths limit)
    (hlimit : ContinuousOn limit (Set.Icc (0 : ℝ) horizon))
    (hpaths_measurable : ∀ n, Measurable (paths n))
    (hlimit_measurable : Measurable limit)
    (hboundary : ∀ᵐ time ∂MeasureTheory.volume,
      time ∈ Set.Ioc (0 : ℝ) horizon → limit time ≠ threshold) :
    Tendsto
      (fun n : ℕ => MeasureTheory.volume (occupationBelowSet horizon threshold (paths n)))
      atTop
      (𝓝 (MeasureTheory.volume (occupationBelowSet horizon threshold limit))) := by
  have hsets_measurable : ∀ n, MeasurableSet
      (occupationBelowSet horizon threshold (paths n)) := by
    intro n
    exact measurableSet_Ioc.inter
      (MeasurableSet.preimage measurableSet_Iic (hpaths_measurable n))
  have hlimit_set_measurable : MeasurableSet
      (occupationBelowSet horizon threshold limit) :=
    measurableSet_Ioc.inter
      (MeasurableSet.preimage measurableSet_Iic hlimit_measurable)
  have huniform : TendstoUniformlyOn paths limit atTop
      (Set.Icc (0 : ℝ) horizon) :=
    tendstoUniformlyOn_of_continuousOn hpaths hlimit
  rw [Metric.tendstoUniformlyOn_iff] at huniform
  refine MeasureTheory.tendsto_measure_of_ae_tendsto_indicator
    (μ := MeasureTheory.volume) (B := Set.Ioc (0 : ℝ) horizon) atTop
    hlimit_set_measurable hsets_measurable measurableSet_Ioc ?_ ?_ ?_
  · exact measure_Ioc_lt_top.ne
  · filter_upwards with n
    exact Set.inter_subset_left
  · filter_upwards [hboundary] with time htime_boundary
    by_cases htime : time ∈ Set.Ioc (0 : ℝ) horizon
    · have htime_Icc : time ∈ Set.Icc (0 : ℝ) horizon :=
        ⟨htime.1.le, htime.2⟩
      have hpoint : Tendsto (fun n : ℕ => paths n time) atTop
          (𝓝 (limit time)) := by
        rw [Metric.tendsto_nhds]
        intro epsilon hepsilon
        filter_upwards [huniform epsilon hepsilon] with n hn
        simpa [dist_comm] using hn time htime_Icc
      have hneq : limit time ≠ threshold := htime_boundary htime
      rcases lt_or_gt_of_ne hneq with hlt | hgt
      · filter_upwards [hpoint.eventually (Iio_mem_nhds hlt)] with n hn
        simp [occupationBelowSet, htime, hn.le, hlt.le]
      · filter_upwards [hpoint.eventually (Ioi_mem_nhds hgt)] with n hn
        have hnnot : ¬ paths n time ≤ threshold := not_le_of_gt hn
        have hlimit_not : ¬ limit time ≤ threshold := not_le_of_gt hgt
        simp [occupationBelowSet, htime, hnnot, hlimit_not]
    · simp [occupationBelowSet, htime]

/-- The normalized threshold-occupation functional is continuous along the
same `J₁` convergence as its underlying occupation measure. -/
theorem tendsto_occupationBelowFraction_of_continuousOn
    {horizon threshold : ℝ} {paths : ℕ → ℝ → ℝ} {limit : ℝ → ℝ}
    (hpaths : SkorokhodJ1ConvergesOn horizon paths limit)
    (hlimit : ContinuousOn limit (Set.Icc (0 : ℝ) horizon))
    (hpaths_measurable : ∀ n, Measurable (paths n))
    (hlimit_measurable : Measurable limit)
    (hboundary : ∀ᵐ time ∂MeasureTheory.volume,
      time ∈ Set.Ioc (0 : ℝ) horizon → limit time ≠ threshold) :
    Tendsto
      (fun n : ℕ => occupationBelowFraction horizon threshold (paths n))
      atTop
      (𝓝 (occupationBelowFraction horizon threshold limit)) := by
  have hvolume := tendsto_volume_occupationBelowSet_of_continuousOn
    hpaths hlimit hpaths_measurable hlimit_measurable hboundary
  have hlimit_finite :
      MeasureTheory.volume (occupationBelowSet horizon threshold limit) ≠ ⊤ := by
    apply ne_of_lt
    apply lt_of_le_of_lt
      (MeasureTheory.measure_mono (Set.inter_subset_left))
    exact measure_Ioc_lt_top
  have hreal : Tendsto
      (fun n : ℕ =>
        (MeasureTheory.volume (occupationBelowSet horizon threshold (paths n))).toReal)
      atTop
      (𝓝 (MeasureTheory.volume (occupationBelowSet horizon threshold limit)).toReal) :=
    (ENNReal.tendsto_toReal hlimit_finite).comp hvolume
  simpa only [occupationBelowFraction] using hreal.div_const horizon

end SkorokhodJ1ConvergesOn

/-- A finite ordered interior family of jump times, represented as a subtype
so that its strict ordering and endpoint separation are available to every
topological argument using the family. -/
abbrev OrderedInteriorKnotFamily (horizon : ℝ) (count : ℕ) :=
  { times : Fin count → ℝ //
    (∀ index, 0 < times index) ∧
      (∀ index, times index < horizon) ∧ StrictMono times }

/-- Strictly ordered finite knot families on the positive half-line, without a
fixed finite horizon. -/
abbrev OrderedPositiveKnotFamily (count : ℕ) :=
  { times : Fin count → ℝ // (∀ index, 0 < times index) ∧ StrictMono times }

/-- The open unit-time slab containing each knot of an ordered positive
family.  These countably indexed cells keep every knot away from each integer
horizon, which is the boundary relevant to local `J₁` restrictions. -/
def localUnitSlab {count : ℕ} (slabs : Fin count → ℕ) :
    Set (OrderedPositiveKnotFamily count) :=
  {times | ∀ index,
    (slabs index : ℝ) < times.1 index ∧ times.1 index < (slabs index : ℝ) + 1}

/-- Open unit-time slabs contain no integer horizon. -/
theorem localUnitSlab_ne_nat {count : ℕ} (slabs : Fin count → ℕ)
    {times : OrderedPositiveKnotFamily count}
    (htimes : times ∈ localUnitSlab slabs)
    (index : Fin count) (horizon : ℕ) :
    times.1 index ≠ (horizon : ℝ) := by
  rcases htimes index with ⟨hlower, hupper⟩
  by_cases hbelow : horizon ≤ slabs index
  · intro heq
    rw [heq] at hlower
    exact (not_lt_of_ge (Nat.cast_le.mpr hbelow)) hlower
  · have hslab_lt : slabs index < horizon := Nat.lt_of_not_ge hbelow
    have hnext_le : slabs index + 1 ≤ horizon := Nat.succ_le_iff.mpr hslab_lt
    intro heq
    rw [heq] at hupper
    apply (not_lt_of_ge ?_) hupper
    exact_mod_cast hnext_le

/-- Two finite knot families in the same open unit-time slab lie on the same
side of every nonnegative integer horizon, coordinate by coordinate. -/
theorem localUnitSlab_lt_nat_iff {count : ℕ} (slabs : Fin count → ℕ)
    {first second : OrderedPositiveKnotFamily count}
    (hfirst : first ∈ localUnitSlab slabs)
    (hsecond : second ∈ localUnitSlab slabs)
    (index : Fin count) (horizon : ℕ) :
    first.1 index < (horizon : ℝ) ↔ second.1 index < (horizon : ℝ) := by
  rcases hfirst index with ⟨hfirst_lower, hfirst_upper⟩
  rcases hsecond index with ⟨hsecond_lower, hsecond_upper⟩
  by_cases hbelow : horizon ≤ slabs index
  · have hfirst_not : ¬ first.1 index < (horizon : ℝ) := by
      apply not_lt_of_ge
      exact (Nat.cast_le.mpr hbelow).trans hfirst_lower.le
    have hsecond_not : ¬ second.1 index < (horizon : ℝ) := by
      apply not_lt_of_ge
      exact (Nat.cast_le.mpr hbelow).trans hsecond_lower.le
    simp [hfirst_not, hsecond_not]
  · have hslab_lt : slabs index < horizon := Nat.lt_of_not_ge hbelow
    have hnext_le : slabs index + 1 ≤ horizon := Nat.succ_le_iff.mpr hslab_lt
    have hfirst_lt : first.1 index < (horizon : ℝ) := by
      exact hfirst_upper.trans_le (by
        exact_mod_cast hnext_le)
    have hsecond_lt : second.1 index < (horizon : ℝ) := by
      exact hsecond_upper.trans_le (by
        exact_mod_cast hnext_le)
    simp [hfirst_lt, hsecond_lt]

/-- Each open unit-time slab is open in the topology of ordered positive knot
families. -/
theorem isOpen_localUnitSlab {count : ℕ} (slabs : Fin count → ℕ) :
    IsOpen (localUnitSlab slabs) := by
  rw [show localUnitSlab slabs = ⋂ index : Fin count,
      (fun times : OrderedPositiveKnotFamily count => times.1 index) ⁻¹'
        Set.Ioo (slabs index : ℝ) ((slabs index : ℝ) + 1) by
    ext times
    simp [localUnitSlab]]
  rw [show (⋂ index : Fin count,
      (fun times : OrderedPositiveKnotFamily count => times.1 index) ⁻¹'
        Set.Ioo (slabs index : ℝ) ((slabs index : ℝ) + 1)) =
      ⋂ index ∈ (Finset.univ : Finset (Fin count)),
        (fun times : OrderedPositiveKnotFamily count => times.1 index) ⁻¹'
          Set.Ioo (slabs index : ℝ) ((slabs index : ℝ) + 1) by simp]
  apply isOpen_biInter_finset
  intro index _
  exact isOpen_Ioo.preimage
    ((continuous_apply index).comp continuous_subtype_val)

/-- The finite-horizon `J₁` path obtained by bundling a finite ordered step
path with its càdlàg regularity. -/
noncomputable def finiteStepSkorokhodPath {State : Type*} [TopologicalSpace State]
    {horizon : ℝ} {count : ℕ} (times : OrderedInteriorKnotFamily horizon count)
    (values : Fin (count + 1) → State) : SkorokhodJ1Path horizon State where
  toCadlagPath := IsCadlagOn.toCadlagPathOn
    (IsCadlagPath.on_of_isCadlagPath
      (isCadlagPath_finiteStepPath times.1 values
        (And.right (And.right times.property))) (Set.Icc 0 horizon))

@[simp]
theorem finiteStepSkorokhodPath_apply {State : Type*} [TopologicalSpace State]
    {horizon : ℝ} {count : ℕ} (times : OrderedInteriorKnotFamily horizon count)
    (values : Fin (count + 1) → State) (time : ℝ) :
    finiteStepSkorokhodPath times values time = finiteStepPath times.1 values time := rfl

/-- Any càdlàg bundling whose underlying path is the finite step path of an
ordered interior knot family is continuous for the finite-horizon `J₁`
topology.  This separates the elementary topological argument from the
particular construction used to establish càdlàg regularity of a concrete
finite-event process. -/
theorem continuous_finiteStepBundle {State : Type*} [PseudoMetricSpace State]
    {horizon : ℝ} {count : ℕ} (values : Fin (count + 1) → State)
    (horizon_nonneg : 0 ≤ horizon) (horizon_pos : 0 < horizon)
    (bundle : OrderedInteriorKnotFamily horizon count → SkorokhodJ1Path horizon State)
    (hbundle : ∀ (times : OrderedInteriorKnotFamily horizon count) (time : ℝ),
      bundle times time = finiteStepPath times.1 values time) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) horizon
    Continuous bundle := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) horizon
  rw [continuous_iff_seqContinuous]
  intro paths target hpaths
  have htimes : Tendsto (fun sequence => (paths sequence : Fin count → ℝ)) atTop
      (nhds (target : Fin count → ℝ)) := by
    exact (continuous_subtype_val.tendsto target).comp hpaths
  have hraw := finiteStepPath_convergesOn_of_tendsto
    (fun sequence => (paths sequence : Fin count → ℝ)) (target : Fin count → ℝ) values
    horizon_nonneg horizon_pos
    (fun sequence index => (paths sequence).property.1 index)
    (fun sequence index => (paths sequence).property.2.1 index)
    (fun index => target.property.1 index)
    (fun index => target.property.2.1 index)
    (fun sequence => (paths sequence).property.2.2)
    target.property.2.2 htimes
  rw [SkorokhodJ1ConvergesOn.tendsto_iff]
  change SkorokhodJ1ConvergesOn horizon
    (fun sequence => fun time : ℝ => bundle (paths sequence) time)
    (fun time : ℝ => bundle target time)
  have hpaths_eq : (fun sequence => fun time : ℝ => bundle (paths sequence) time) =
      (fun sequence => finiteStepPath (paths sequence : Fin count → ℝ) values) := by
    funext sequence time
    exact hbundle (paths sequence) time
  have htarget_eq : (fun time : ℝ => bundle target time) =
      finiteStepPath (target : Fin count → ℝ) values := by
    funext time
    exact hbundle target time
  rw [hpaths_eq, htarget_eq]
  exact hraw

/-- The finite-step bundle in `continuous_finiteStepBundle` is Borel
measurable for the explicit finite-horizon `J₁` Borel structure. -/
theorem measurable_finiteStepBundle {State : Type*} [PseudoMetricSpace State]
    {horizon : ℝ} {count : ℕ} (values : Fin (count + 1) → State)
    (horizon_nonneg : 0 ≤ horizon) (horizon_pos : 0 < horizon)
    (bundle : OrderedInteriorKnotFamily horizon count → SkorokhodJ1Path horizon State)
    (hbundle : ∀ (times : OrderedInteriorKnotFamily horizon count) (time : ℝ),
      bundle times time = finiteStepPath times.1 values time) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) horizon
    letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.borelMeasurableSpace (State := State) horizon
    Measurable bundle := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) horizon
  letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.borelMeasurableSpace (State := State) horizon
  letI : BorelSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.borelSpace (State := State) horizon
  exact (continuous_finiteStepBundle values horizon_nonneg horizon_pos bundle hbundle).measurable

/-- Ordered finite event times map continuously to their bundled step paths
in the finite-horizon `J₁` topology. -/
theorem continuous_finiteStepSkorokhodPath {State : Type*} [PseudoMetricSpace State]
    {horizon : ℝ} {count : ℕ} (values : Fin (count + 1) → State)
    (horizon_nonneg : 0 ≤ horizon) (horizon_pos : 0 < horizon) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) horizon
    Continuous (fun times : OrderedInteriorKnotFamily horizon count =>
      finiteStepSkorokhodPath times values) := by
  exact continuous_finiteStepBundle values horizon_nonneg horizon_pos
    (fun times => finiteStepSkorokhodPath times values) (fun _ _ => rfl)

/-- Ordered finite event times map measurably to their bundled step paths for
the explicit finite-horizon `J₁` Borel structure. -/
theorem measurable_finiteStepSkorokhodPath {State : Type*} [PseudoMetricSpace State]
    {horizon : ℝ} {count : ℕ} (values : Fin (count + 1) → State)
    (horizon_nonneg : 0 ≤ horizon) (horizon_pos : 0 < horizon) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) horizon
    letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.borelMeasurableSpace (State := State) horizon
    Measurable (fun times : OrderedInteriorKnotFamily horizon count =>
      finiteStepSkorokhodPath times values) := by
  exact measurable_finiteStepBundle values horizon_nonneg horizon_pos
    (fun times => finiteStepSkorokhodPath times values) (fun _ _ => rfl)

/-- A finite-horizon step path is Borel measurable when its ordered event
times are measurable and its finitely many state labels range over a countable
measurable carrier.  The state embedding itself need not be measurable: on
each fixed finite label vector the preceding continuous finite-step theorem
supplies the path-space Borel fact. -/
theorem measurable_finiteStepSkorokhodPath_of_countable_labels
    {Ω Label State : Type*} [MeasurableSpace Ω] [PseudoMetricSpace State]
    [MeasurableSpace Label] [Countable Label] [MeasurableSingletonClass Label]
    {horizon : ℝ} {count : ℕ}
    (times : Ω → OrderedInteriorKnotFamily horizon count)
    (labels : Ω → Fin (count + 1) → Label) (embed : Label → State)
    (htimes : Measurable times) (hlabels : Measurable labels)
    (horizon_nonneg : 0 ≤ horizon) (horizon_pos : 0 < horizon) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) horizon
    letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.borelMeasurableSpace (State := State) horizon
    Measurable (fun omega => finiteStepSkorokhodPath (times omega)
      (fun index => embed (labels omega index))) := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) horizon
  letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.borelMeasurableSpace (State := State) horizon
  refine measurable_of_countable_measurable_cover
    (fun labelVector : Fin (count + 1) → Label =>
      {omega | labels omega = labelVector})
    (fun labelVector => hlabels (measurableSet_singleton labelVector)) ?_
    (fun omega => finiteStepSkorokhodPath (times omega)
      (fun index => embed (labels omega index)))
    (fun labelVector omega => finiteStepSkorokhodPath (times omega)
      (fun index => embed (labelVector index))) ?_ ?_
  · ext omega
    constructor
    · intro _
      simp
    · intro _
      exact Set.mem_iUnion.mpr ⟨labels omega, rfl⟩
  · intro labelVector
    exact (measurable_finiteStepSkorokhodPath
      (fun index => embed (labelVector index)) horizon_nonneg horizon_pos).comp htimes
  · intro labelVector omega homega
    simp only [Set.mem_setOf_eq] at homega
    change finiteStepSkorokhodPath (times omega)
      (fun index => embed (labels omega index)) =
        finiteStepSkorokhodPath (times omega)
          (fun index => embed (labelVector index))
    rw [homega]

/-- A finite-horizon bundled path is Borel measurable when, on each input,
it agrees on the observed interval with a finite step path having measurable
ordered knots and countable labels.  Equality outside that interval is not
needed because the finite-horizon `J₁` Borel structure cannot distinguish
such representatives. -/
theorem measurable_finiteStepBundle_of_countable_labels
    {Ω Label State : Type*} [MeasurableSpace Ω] [PseudoMetricSpace State]
    [MeasurableSpace Label] [Countable Label] [MeasurableSingletonClass Label]
    {horizon : ℝ} {count : ℕ}
    (times : Ω → OrderedInteriorKnotFamily horizon count)
    (labels : Ω → Fin (count + 1) → Label) (embed : Label → State)
    (bundle : Ω → SkorokhodJ1Path horizon State)
    (htimes : Measurable times) (hlabels : Measurable labels)
    (hbundle : ∀ omega time, time ∈ Set.Icc (0 : ℝ) horizon →
      bundle omega time = finiteStepPath (times omega).1
        (fun index => embed (labels omega index)) time)
    (horizon_nonneg : 0 ≤ horizon) (horizon_pos : 0 < horizon) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) horizon
    letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.borelMeasurableSpace (State := State) horizon
    Measurable bundle := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) horizon
  letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.borelMeasurableSpace (State := State) horizon
  letI : BorelSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.borelSpace (State := State) horizon
  refine measurable_of_countable_measurable_cover_inseparable
    (fun labelVector : Fin (count + 1) → Label =>
      {omega | labels omega = labelVector})
    (fun labelVector => hlabels (measurableSet_singleton labelVector)) ?_ bundle
    (fun labelVector omega => finiteStepSkorokhodPath (times omega)
      (fun index => embed (labelVector index))) ?_ ?_
  · ext omega
    constructor
    · intro _
      simp
    · intro _
      exact Set.mem_iUnion.mpr ⟨labels omega, rfl⟩
  · intro labelVector
    exact (measurable_finiteStepSkorokhodPath
      (fun index => embed (labelVector index)) horizon_nonneg horizon_pos).comp htimes
  · intro labelVector omega homega
    apply SkorokhodJ1Entourage.inseparable_of_eqOn (State := State)
    intro time htime
    rw [hbundle omega time htime]
    simp only [Set.mem_setOf_eq] at homega
    rw [homega]
    rfl

/-- At the zero horizon, a finite-horizon path is Borel measurable whenever
its initial value has a measurable countable label.  Values away from zero
are topologically inseparable in this degenerate `J₁` path space. -/
theorem measurable_zeroHorizonBundle_of_countable_labels
    {Ω Label State : Type*} [MeasurableSpace Ω] [PseudoMetricSpace State]
    [MeasurableSpace Label] [Countable Label] [MeasurableSingletonClass Label]
    (labels : Ω → Label) (embed : Label → State)
    (bundle : Ω → SkorokhodJ1Path ((0 : ℕ) : ℝ) State)
    (hlabels : Measurable labels)
    (hzero : ∀ omega, bundle omega 0 = embed (labels omega)) :
    letI : UniformSpace (SkorokhodJ1Path ((0 : ℕ) : ℝ) State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) ((0 : ℕ) : ℝ)
    letI : MeasurableSpace (SkorokhodJ1Path ((0 : ℕ) : ℝ) State) :=
      SkorokhodJ1Entourage.borelMeasurableSpace (State := State) ((0 : ℕ) : ℝ)
    Measurable bundle := by
  letI : UniformSpace (SkorokhodJ1Path ((0 : ℕ) : ℝ) State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) ((0 : ℕ) : ℝ)
  letI : MeasurableSpace (SkorokhodJ1Path ((0 : ℕ) : ℝ) State) :=
    SkorokhodJ1Entourage.borelMeasurableSpace (State := State) ((0 : ℕ) : ℝ)
  letI : BorelSpace (SkorokhodJ1Path ((0 : ℕ) : ℝ) State) :=
    SkorokhodJ1Entourage.borelSpace (State := State) ((0 : ℕ) : ℝ)
  refine measurable_of_countable_measurable_cover_inseparable
    (fun label : Label => {omega | labels omega = label})
    (fun label => hlabels (measurableSet_singleton label)) ?_ bundle
    (fun label _ => constantSkorokhodJ1Path ((0 : ℕ) : ℝ) (embed label))
    (fun _ => measurable_const) ?_
  · ext omega
    constructor
    · intro _
      simp
    · intro _
      exact Set.mem_iUnion.mpr ⟨labels omega, rfl⟩
  · intro label omega homega
    apply SkorokhodJ1Entourage.inseparable_of_eqOn (State := State)
    intro time htime
    have htime_le_zero : time ≤ 0 := by simpa using htime.2
    have htime_zero : time = 0 := le_antisymm htime_le_zero htime.1
    rw [htime_zero, hzero omega]
    simp only [Set.mem_setOf_eq] at homega
    rw [homega]
    rfl

/-- Strict increase of a finite real-valued coordinate vector is a Borel
condition. -/
theorem measurableSet_strictMono_fin
    {Ω : Type*} [MeasurableSpace Ω] {count : ℕ}
    (times : Ω → Fin count → ℝ) (htimes : Measurable times) :
    MeasurableSet {omega | StrictMono (times omega)} := by
  have hstrict : MeasurableSet {vector : Fin count → ℝ | StrictMono vector} := by
    rw [show {vector : Fin count → ℝ | StrictMono vector} =
        ⋂ first : Fin count, ⋂ second : Fin count,
          if first < second then {vector | vector first < vector second} else Set.univ by
      ext vector
      constructor
      · intro h
        simp only [Set.mem_setOf_eq, Set.mem_iInter]
        intro first second
        by_cases hfirst_second : first < second
        · simp [hfirst_second, h hfirst_second]
        · simp [hfirst_second]
      · intro h first second hfirst_second
        simp only [Set.mem_iInter] at h
        simpa [hfirst_second] using h first second]
    refine MeasurableSet.iInter fun first => MeasurableSet.iInter fun second => ?_
    by_cases hfirst_second : first < second
    · simpa [hfirst_second] using
        (measurableSet_lt (measurable_pi_apply first) (measurable_pi_apply second))
    · simp [hfirst_second]
  exact hstrict.preimage htimes

/-- Ordered positive finite knot vectors form a Borel subset of a finite real
product. -/
theorem measurableSet_orderedPositiveKnotFamily {count : ℕ} :
    MeasurableSet {times : Fin count → ℝ |
      (∀ index, 0 < times index) ∧ StrictMono times} := by
  have hpositive : MeasurableSet {times : Fin count → ℝ |
      ∀ index, 0 < times index} := by
    rw [show {times : Fin count → ℝ | ∀ index, 0 < times index} =
        ⋂ index : Fin count, {times | 0 < times index} by
      ext times
      simp]
    exact MeasurableSet.iInter fun index =>
      measurableSet_lt measurable_const (measurable_pi_apply index)
  exact hpositive.inter (measurableSet_strictMono_fin (fun times => times) measurable_id)

/-- A finite-step path admits a Borel extension from a measurable input cell
on which its event times form an ordered interior family.  This lets a
finite-event stochastic construction be analyzed on its fixed event-count
cells without postulating a measurable structure for a random carrier. -/
theorem measurable_dite_finiteStepSkorokhodPath_of_countable_labels
    {Ω Label State : Type*} [MeasurableSpace Ω] [PseudoMetricSpace State]
    [MeasurableSpace Label] [Countable Label] [MeasurableSingletonClass Label]
    {horizon : ℝ} {count : ℕ} (domain : Set Ω) (hdomain : MeasurableSet domain)
    [DecidablePred (· ∈ domain)]
    (times : Ω → Fin count → ℝ) (labels : Ω → Fin (count + 1) → Label)
    (embed : Label → State)
    (htimes : Measurable (domain.restrict times))
    (hlabels : Measurable (domain.restrict labels))
    (hordered : ∀ omega : domain,
      (∀ index, 0 < times omega index) ∧
        (∀ index, times omega index < horizon) ∧ StrictMono (times omega))
    (horizon_nonneg : 0 ≤ horizon) (horizon_pos : 0 < horizon)
    (fallback : SkorokhodJ1Path horizon State) :
    letI : UniformSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) horizon
    letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
      SkorokhodJ1Entourage.borelMeasurableSpace (State := State) horizon
    Measurable (fun omega => if hmem : omega ∈ domain then
      finiteStepSkorokhodPath
        (⟨times omega, hordered ⟨omega, hmem⟩⟩ :
          OrderedInteriorKnotFamily horizon count)
        (fun index => embed (labels omega index))
      else fallback) := by
  letI : UniformSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) horizon
  letI : MeasurableSpace (SkorokhodJ1Path horizon State) :=
    SkorokhodJ1Entourage.borelMeasurableSpace (State := State) horizon
  let knotMap : domain → OrderedInteriorKnotFamily horizon count :=
    fun omega => ⟨times omega, hordered omega⟩
  have hknotMap : Measurable knotMap := htimes.subtype_mk
  have hgood : Measurable (fun omega : domain =>
      finiteStepSkorokhodPath (knotMap omega)
        (fun index => embed (labels omega index))) :=
    measurable_finiteStepSkorokhodPath_of_countable_labels knotMap
      (fun omega => labels omega) embed hknotMap hlabels horizon_nonneg horizon_pos
  simpa only [knotMap] using (Measurable.dite hgood measurable_const hdomain)

/-- A càdlàg path on the nonnegative real half-line, bundled for the local
Skorokhod topology. -/
structure SkorokhodJ1LocalPath (State : Type*) [TopologicalSpace State] where
  toCadlagPath : CadlagPathOn ℝ State (Set.Ici (0 : ℝ))

instance {State : Type*} [TopologicalSpace State] :
    CoeFun (SkorokhodJ1LocalPath State) (fun _ => ℝ → State) where
  coe path := path.toCadlagPath

namespace SkorokhodJ1LocalPath

variable {State : Type*} [TopologicalSpace State]

/-- View a càdlàg path on the nonnegative half-line as a local `J₁` path. -/
def ofCadlagPathOn
    (path : CadlagPathOn ℝ State (Set.Ici (0 : ℝ))) : SkorokhodJ1LocalPath State :=
  ⟨path⟩

@[simp]
theorem ofCadlagPathOn_apply
    (path : CadlagPathOn ℝ State (Set.Ici (0 : ℝ))) (time : ℝ) :
    ofCadlagPathOn path time = path time := rfl

/-- Bundle a continuous real-time path as a local `J₁` path on the
nonnegative half-line. -/
def ofContinuous (path : ℝ → State) (hpath : Continuous path) :
    SkorokhodJ1LocalPath State :=
  ofCadlagPathOn (IsCadlagOn.toCadlagPathOn
    (IsCadlagPath.on_of_isCadlagPath (IsCadlagPath.of_continuous hpath)
      (Set.Ici (0 : ℝ))))

@[simp]
theorem ofContinuous_apply (path : ℝ → State) (hpath : Continuous path) (time : ℝ) :
    ofContinuous path hpath time = path time := rfl

/-- The identically zero local path.  This named object is useful as the
constant limit of negligible local-`J₁` error processes. -/
noncomputable def zeroPath [Zero State] : SkorokhodJ1LocalPath State :=
  ofContinuous (fun _ : ℝ => 0) continuous_const

@[simp]
theorem zeroPath_apply [Zero State] (time : ℝ) :
    zeroPath (State := State) time = 0 := rfl

/-- Restrict a local càdlàg path to an integer finite horizon. -/
def restrict (path : SkorokhodJ1LocalPath State) (horizon : ℕ) :
    SkorokhodJ1Path (horizon : ℝ) State where
  toCadlagPath := path.toCadlagPath.restrict (by
    intro time htime
    exact htime.1)

@[simp]
theorem restrict_apply (path : SkorokhodJ1LocalPath State) (horizon : ℕ) (time : ℝ) :
    path.restrict horizon time = path time := rfl

/-- Extensionality of bundled local càdlàg paths through their underlying
real-time functions. -/
theorem ext {first second : SkorokhodJ1LocalPath State}
    (h : ∀ time : ℝ, first time = second time) : first = second := by
  cases first with
  | mk first =>
    cases second with
    | mk second =>
      cases first with
      | mk first hfirst =>
        cases second with
        | mk second hsecond =>
          congr
          funext time
          exact h time

/-- Pointwise addition of real-valued local càdlàg paths.  This is a path
constructor only: addition is not asserted to be continuous for the `J₁`
topology at simultaneous jumps. -/
noncomputable def add (first second : SkorokhodJ1LocalPath ℝ) :
    SkorokhodJ1LocalPath ℝ :=
  ofCadlagPathOn (CadlagPathOn.add first.toCadlagPath second.toCadlagPath)

@[simp]
theorem add_apply (first second : SkorokhodJ1LocalPath ℝ) (time : ℝ) :
    first.add second time = first time + second time := rfl

/-- Pointwise negation of a real-valued local càdlàg path.  As with
`add`, this is a path constructor only; no global local-`J₁` continuity
claim is made at jump paths. -/
noncomputable def neg (path : SkorokhodJ1LocalPath ℝ) :
    SkorokhodJ1LocalPath ℝ :=
  ofCadlagPathOn path.toCadlagPath.neg

@[simp]
theorem neg_apply (path : SkorokhodJ1LocalPath ℝ) (time : ℝ) :
    path.neg time = -path time := rfl

/-- A local real path perturbed by a path which is `J₁`-close to zero is
close to the original path at the same radius.  Since the comparison path is
zero, the time change in the perturbation bound yields a uniform state bound;
the identity time change then witnesses the conclusion. -/
theorem add_right_of_close_zero {horizon epsilon : ℝ}
    (hepsilon : 0 < epsilon) {path perturbation : SkorokhodJ1LocalPath ℝ}
    (hclose : SkorokhodJ1CloseOn horizon epsilon perturbation
      (zeroPath (State := ℝ))) :
    SkorokhodJ1CloseOn horizon epsilon (path.add perturbation) path := by
  rcases hclose with ⟨timeChange, htimeChange⟩
  apply SkorokhodJ1CloseOn.of_forall_dist_lt hepsilon
  intro time htime
  have hperturbation := (htimeChange ⟨time, htime.1, htime.2⟩).2
  rw [zeroPath_apply, Real.dist_eq] at hperturbation
  rw [add_apply, Real.dist_eq]
  simpa only [sub_zero, add_sub_cancel_left] using hperturbation

/-- Add a deterministic continuous real-valued forcing path to a local
càdlàg path.  This is the path-space operation used to center counting
processes and to pass between additive-noise and drifted representations. -/
noncomputable def addContinuous (forcing : ℝ → ℝ) (hforcing : Continuous forcing)
    (path : SkorokhodJ1LocalPath ℝ) : SkorokhodJ1LocalPath ℝ where
  toCadlagPath :=
    ⟨fun time => path time + forcing time,
      path.toCadlagPath.isCadlag.add
        (IsCadlagPath.on_of_isCadlagPath
          (IsCadlagPath.of_continuous hforcing) (Set.Ici (0 : ℝ)))⟩

@[simp]
theorem addContinuous_apply (forcing : ℝ → ℝ) (hforcing : Continuous forcing)
    (path : SkorokhodJ1LocalPath ℝ) (time : ℝ) :
    addContinuous forcing hforcing path time = path time + forcing time := rfl

/-- Anchor a real-valued local path at its time-zero value.  This operation
preserves the local `J₁` structure because every admissible time change fixes
the left endpoint. -/
noncomputable def anchorAtZero (path : SkorokhodJ1LocalPath ℝ) :
    SkorokhodJ1LocalPath ℝ :=
  addContinuous (fun _ => -path 0) continuous_const path

@[simp]
theorem anchorAtZero_apply (path : SkorokhodJ1LocalPath ℝ) (time : ℝ) :
    anchorAtZero path time = path time - path 0 := by
  simp [anchorAtZero, addContinuous_apply, sub_eq_add_neg]

end SkorokhodJ1LocalPath

/-- The local `J₁` path obtained by bundling a finite step path on the
nonnegative time half-line. -/
noncomputable def finiteStepLocalPath {State : Type*} [TopologicalSpace State]
    {count : ℕ} (jumpTimes : Fin count → ℝ) (values : Fin (count + 1) → State)
    (hstrict : StrictMono jumpTimes) : SkorokhodJ1LocalPath State :=
  SkorokhodJ1LocalPath.ofCadlagPathOn (IsCadlagOn.toCadlagPathOn
    (IsCadlagPath.on_of_isCadlagPath
      (isCadlagPath_finiteStepPath jumpTimes values hstrict) (Set.Ici 0)))

@[simp]
theorem finiteStepLocalPath_apply {State : Type*} [TopologicalSpace State]
    {count : ℕ} (jumpTimes : Fin count → ℝ) (values : Fin (count + 1) → State)
    (hstrict : StrictMono jumpTimes) (time : ℝ) :
    finiteStepLocalPath jumpTimes values hstrict time = finiteStepPath jumpTimes values time := rfl

/-- Pointwise addition commutes with finite-step bundling when both paths use
the same jump clock.  This is an algebraic identity only; it makes no claim
about continuity of addition for arbitrary local-`J₁` paths. -/
theorem finiteStepLocalPath_add {count : ℕ} (jumpTimes : Fin count → ℝ)
    (firstValues secondValues : Fin (count + 1) → ℝ)
    (hstrict : StrictMono jumpTimes) :
    (finiteStepLocalPath jumpTimes firstValues hstrict).add
        (finiteStepLocalPath jumpTimes secondValues hstrict) =
      finiteStepLocalPath jumpTimes (fun index => firstValues index + secondValues index)
        hstrict := by
  apply SkorokhodJ1LocalPath.ext
  intro time
  simp only [SkorokhodJ1LocalPath.add_apply, finiteStepLocalPath_apply,
    finiteStepPath_apply_eq_activeValue]

/-- Reindexing a finite step path along an equality of finite index sizes
does not change the path. -/
theorem finiteStepLocalPath_reindex_eq {State : Type*} [TopologicalSpace State]
    {sourceCount targetCount : ℕ} (hcount : sourceCount = targetCount)
    (jumpTimes : Fin targetCount → ℝ) (values : Fin (targetCount + 1) → State)
    (hsource : StrictMono (fun index : Fin sourceCount => jumpTimes (Fin.cast hcount index)))
    (htarget : StrictMono jumpTimes) :
    finiteStepLocalPath (fun index : Fin sourceCount => jumpTimes (Fin.cast hcount index))
      (fun index : Fin (sourceCount + 1) =>
        values (Fin.cast (congrArg Nat.succ hcount) index)) hsource =
      finiteStepLocalPath jumpTimes values htarget := by
  subst sourceCount
  rfl

/-- Two finite step paths agree when their jump and value coordinates agree
after an equality-based reindexing of the finite index sets. -/
theorem finiteStepLocalPath_eq_of_reindex {State : Type*} [TopologicalSpace State]
    {sourceCount targetCount : ℕ} (hcount : sourceCount = targetCount)
    (sourceJumpTimes : Fin sourceCount → ℝ) (sourceValues : Fin (sourceCount + 1) → State)
    (targetJumpTimes : Fin targetCount → ℝ) (targetValues : Fin (targetCount + 1) → State)
    (hsource : StrictMono sourceJumpTimes) (htarget : StrictMono targetJumpTimes)
    (hjumpTimes : ∀ index,
      sourceJumpTimes index = targetJumpTimes (Fin.cast hcount index))
    (hvalues : ∀ index,
      sourceValues index = targetValues (Fin.cast (congrArg Nat.succ hcount) index)) :
    finiteStepLocalPath sourceJumpTimes sourceValues hsource =
      finiteStepLocalPath targetJumpTimes targetValues htarget := by
  have hjumpTimes' : sourceJumpTimes =
      fun index => targetJumpTimes (Fin.cast hcount index) := by
    funext index
    exact hjumpTimes index
  have hvalues' : sourceValues =
      fun index => targetValues (Fin.cast (congrArg Nat.succ hcount) index) := by
    funext index
    exact hvalues index
  subst sourceJumpTimes
  subst sourceValues
  exact finiteStepLocalPath_reindex_eq hcount targetJumpTimes targetValues _ htarget

/-- The regular finite-step approximation of a path, with mesh `m` on the
time range from zero through `m`. -/
noncomputable def uniformMeshFiniteStepLocalPath {State : Type*} [TopologicalSpace State]
    (path : ℝ → State) (mesh : ℕ) (hmesh : 0 < mesh) : SkorokhodJ1LocalPath State :=
  finiteStepLocalPath (uniformMeshJumpTimes mesh)
    (fun index => path (uniformMeshSampleTime mesh index : ℝ))
    (strictMono_uniformMeshJumpTimes hmesh)

/-- The regular finite-step mesh uses the original path value at time zero. -/
theorem uniformMeshFiniteStepLocalPath_apply_zero {State : Type*} [TopologicalSpace State]
    (path : ℝ → State) {mesh : ℕ} (hmesh : 0 < mesh) :
    uniformMeshFiniteStepLocalPath path mesh hmesh 0 = path 0 := by
  rw [uniformMeshFiniteStepLocalPath, finiteStepLocalPath_apply,
    finiteStepPath_zero_eq_firstValue_of_all_pos]
  · simp only [uniformMeshSampleTime_zero]
    norm_num
  · intro index
    dsimp [uniformMeshJumpTimes]
    exact div_pos (by exact_mod_cast Nat.succ_pos index.val) (by exact_mod_cast hmesh)

/-- Anchoring commutes with regular finite-step meshing of a real-valued
path. -/
theorem anchorAtZero_uniformMeshFiniteStepLocalPath (path : ℝ → ℝ)
    {mesh : ℕ} (hmesh : 0 < mesh) :
    SkorokhodJ1LocalPath.anchorAtZero (uniformMeshFiniteStepLocalPath path mesh hmesh) =
      uniformMeshFiniteStepLocalPath (fun time => path time - path 0) mesh hmesh := by
  apply SkorokhodJ1LocalPath.ext
  intro time
  rw [SkorokhodJ1LocalPath.anchorAtZero_apply,
    uniformMeshFiniteStepLocalPath_apply_zero path hmesh]
  rfl

/-- On a compact horizon covered by a regular mesh, control of all pairs of
path values separated by at most one mesh width gives a direct local
`J₁` approximation by the mesh's finite-step path.  The identity time change
is enough: this is the deterministic approximation bridge used when a
probabilistic modulus estimate controls the pair oscillations. -/
theorem uniformMeshFiniteStepLocalPath_closeOn_of_abs_pairOscillation
    {State : Type*} [PseudoMetricSpace State] (path : ℝ → State)
    {horizon mesh : ℕ} (hmesh : 0 < mesh) (hhorizon_mesh : horizon ≤ mesh)
    {epsilon delta : ℝ} (hepsilon : 0 < epsilon) (hmesh_small : 1 / (mesh : ℝ) < delta)
    (hoscillation : ∀ first second : ℝ,
      first ∈ Set.Icc (0 : ℝ) (horizon : ℝ) →
      second ∈ Set.Icc (0 : ℝ) (horizon : ℝ) →
      |first - second| ≤ delta → dist (path first) (path second) < epsilon) :
    SkorokhodJ1CloseOn (horizon : ℝ) epsilon
      (uniformMeshFiniteStepLocalPath path mesh hmesh) path := by
  refine ⟨SkorokhodTimeChange.identity (horizon : ℝ), ?_⟩
  intro time
  constructor
  · simp [SkorokhodTimeChange.identity_apply, hepsilon]
  · rw [SkorokhodTimeChange.identity_apply]
    let sample : ℝ := (uniformMeshSampleTime mesh
      (finiteStepIndex (uniformMeshJumpTimes mesh) time) : ℝ)
    have htime_nonneg : 0 ≤ (time : ℝ) := time.property.1
    have htime_le_mesh : (time : ℝ) ≤ (mesh : ℝ) := by
      calc
        (time : ℝ) ≤ (horizon : ℝ) := time.property.2
        _ ≤ (mesh : ℝ) := by exact_mod_cast hhorizon_mesh
    have hsample_le : sample ≤ (time : ℝ) := by
      exact coe_uniformMeshSampleTime_active_le_time hmesh htime_nonneg htime_le_mesh
    have hsample_mem : sample ∈ Set.Icc (0 : ℝ) (horizon : ℝ) := by
      exact ⟨NNReal.zero_le_coe, hsample_le.trans time.property.2⟩
    have hsample_distance : |sample - (time : ℝ)| ≤ delta := by
      have hmesh_error := abs_coe_uniformMeshSampleTime_active_sub_lt_inv
        hmesh htime_nonneg htime_le_mesh
      exact (lt_trans hmesh_error hmesh_small).le
    rw [uniformMeshFiniteStepLocalPath, finiteStepLocalPath_apply,
      finiteStepPath_apply_eq_activeValue]
    exact hoscillation sample (time : ℝ) hsample_mem time.property hsample_distance

/-- A continuous path is uniformly approximated on every fixed compact
nonnegative interval by its regular finite-step meshes. -/
theorem tendstoUniformlyOn_uniformMeshFiniteStepLocalPath_of_continuous
    {State : Type*} [MetricSpace State] (path : ℝ → State)
    (hpath : Continuous path) (horizon : ℕ) :
    TendstoUniformlyOn
      (fun n : ℕ => fun time : ℝ =>
        uniformMeshFiniteStepLocalPath path (n + 1) (Nat.succ_pos n) time)
      path atTop (Set.Icc (0 : ℝ) (horizon : ℝ)) := by
  rw [Metric.tendstoUniformlyOn_iff]
  intro epsilon hepsilon
  have huniform : UniformContinuousOn path (Set.Icc (0 : ℝ) (horizon : ℝ)) :=
    isCompact_Icc.uniformContinuousOn_of_continuous hpath.continuousOn
  obtain ⟨delta, hdelta_pos, hdelta⟩ :=
    (Metric.uniformContinuousOn_iff.mp huniform) epsilon hepsilon
  have hmesh_small : ∀ᶠ n : ℕ in atTop, 1 / ((n + 1 : ℕ) : ℝ) < delta := by
    simpa [Nat.cast_add] using
      (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).eventually
        (Iio_mem_nhds hdelta_pos)
  filter_upwards [Filter.eventually_ge_atTop horizon, hmesh_small] with n hn hsmall
  intro time htime
  let sample : ℝ := (uniformMeshSampleTime (n + 1)
    (finiteStepIndex (uniformMeshJumpTimes (n + 1)) time) : ℝ)
  have htime_nonneg : 0 ≤ time := htime.1
  have htime_le_mesh : time ≤ (n + 1 : ℕ) := by
    calc
      time ≤ (horizon : ℝ) := htime.2
      _ ≤ (n : ℕ) := by exact_mod_cast hn
      _ ≤ (n + 1 : ℕ) := by exact_mod_cast Nat.le_succ n
  have hsample_le : sample ≤ time := by
    exact coe_uniformMeshSampleTime_active_le_time (Nat.succ_pos n)
      htime_nonneg htime_le_mesh
  have hsample_mem : sample ∈ Set.Icc (0 : ℝ) (horizon : ℝ) := by
    refine ⟨NNReal.zero_le_coe, hsample_le.trans htime.2⟩
  have hsample_dist : dist sample time < delta := by
    have hmesh_error := abs_coe_uniformMeshSampleTime_active_sub_lt_inv
      (Nat.succ_pos n) htime_nonneg htime_le_mesh
    calc
      dist sample time = |sample - time| := Real.dist_eq _ _
      _ < 1 / ((n + 1 : ℕ) : ℝ) := hmesh_error
      _ < delta := hsmall
  rw [uniformMeshFiniteStepLocalPath, finiteStepLocalPath_apply,
    finiteStepPath_apply_eq_activeValue]
  simpa [sample, dist_comm] using hdelta sample hsample_mem time htime hsample_dist

/-- On a fixed open unit-time slab, the restriction of a finite step path is
continuous in its positive, strictly ordered knot vector.  The slab prevents
a knot from crossing an integer restriction horizon. -/
theorem continuous_finiteStepLocalPath_restrict_on_localUnitSlab
    {State : Type*} [PseudoMetricSpace State] {count : ℕ}
    (slabs : Fin count → ℕ) (values : Fin (count + 1) → State)
    (horizon : ℕ) (hhorizon : 0 < horizon) :
    letI : UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
    Continuous (fun times : localUnitSlab slabs =>
      (finiteStepLocalPath times.1.1 values times.1.2.2).restrict horizon) := by
  classical
  letI : UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
  by_cases hnonempty : Nonempty (localUnitSlab slabs)
  · let anchor : localUnitSlab slabs := Classical.choice hnonempty
    obtain ⟨activePrefix, hbeforeAnchor, hafterAnchor⟩ :=
      exists_activePrefix_of_strictMono_of_forall_ne anchor.1.1 anchor.1.2.2 (horizon : ℝ)
        (fun index => localUnitSlab_ne_nat slabs anchor.2 index horizon)
    let hprefix : activePrefix.val ≤ count := Nat.lt_succ_iff.mp activePrefix.isLt
    let knots : localUnitSlab slabs →
        OrderedInteriorKnotFamily (horizon : ℝ) activePrefix.val :=
      fun times => ⟨fun index => times.1.1 (Fin.castLE hprefix index), by
        refine ⟨?_, ?_, ?_⟩
        · intro index
          exact times.1.2.1 (Fin.castLE hprefix index)
        · intro index
          exact (localUnitSlab_lt_nat_iff slabs anchor.2 times.2
            (Fin.castLE hprefix index) horizon).mp (hbeforeAnchor index)
        · intro first second hfirst_second
          exact times.1.2.2 (by simpa [hprefix] using hfirst_second)⟩
    have hknots : Continuous knots := by
      have hraw : Continuous (fun times : localUnitSlab slabs =>
          (times.1.1 : Fin count → ℝ)) :=
        continuous_subtype_val.comp continuous_subtype_val
      apply Continuous.subtype_mk
      apply continuous_pi
      intro index
      exact (continuous_apply (Fin.castLE hprefix index)).comp hraw
    let prefixValues : Fin (activePrefix.val + 1) → State :=
      fun index => values (Fin.castLE (Nat.succ_le_succ hprefix) index)
    have hbundle : Continuous (fun times : localUnitSlab slabs =>
        finiteStepSkorokhodPath (knots times) prefixValues) := by
      exact (continuous_finiteStepSkorokhodPath prefixValues (Nat.cast_nonneg horizon)
        (Nat.cast_pos.mpr hhorizon)).comp hknots
    apply (continuous_congr_of_inseparable ?_).mpr hbundle
    intro times
    apply SkorokhodJ1Entourage.inseparable_of_eqOn (State := State)
    intro time htime
    have hafter : ∀ index : Fin count, activePrefix.val ≤ index.val →
        (horizon : ℝ) < times.1.1 index := by
      intro index hindex
      have hnot : ¬ times.1.1 index < (horizon : ℝ) := by
        intro htimes
        have hanchor : anchor.1.1 index < (horizon : ℝ) :=
          (localUnitSlab_lt_nat_iff slabs anchor.2 times.2 index horizon).mpr
            htimes
        exact (not_lt_of_ge (hafterAnchor index hindex).le) hanchor
      exact lt_of_le_of_ne (not_lt.mp hnot)
        (localUnitSlab_ne_nat slabs times.2 index horizon).symm
    change finiteStepPath times.1.1 values time =
      finiteStepPath (knots times).1 prefixValues time
    simpa [knots, prefixValues, hprefix] using
      (finiteStepPath_eq_prefix_of_after times.1.1 values hprefix (horizon : ℝ) hafter htime.2)
  · rw [continuous_iff_continuousAt]
    intro times
    exact (hnonempty ⟨times⟩).elim

/-- A local `J₁` entourage requires finite-horizon time-change closeness on
every horizon in a finite set of nonnegative integer horizons. -/
def SkorokhodJ1LocalEntourage {State : Type*} [PseudoMetricSpace State]
    (horizons : Finset ℕ) (epsilon : ℝ) :
    Set (SkorokhodJ1LocalPath State × SkorokhodJ1LocalPath State) :=
  {pair | ∀ horizon ∈ horizons,
    SkorokhodJ1CloseOn (horizon : ℝ) epsilon pair.1 pair.2}

/-- Sequential local `J₁` convergence on `[0,∞)`, tested on each integer
finite horizon. -/
def SkorokhodJ1LocallyConverges {State : Type*} [PseudoMetricSpace State]
    (paths : ℕ → ℝ → State) (limit : ℝ → State) : Prop :=
  ∀ horizon : ℕ, ∀ epsilon : ℝ, 0 < epsilon →
    ∀ᶠ n : ℕ in atTop,
      SkorokhodJ1CloseOn (horizon : ℝ) epsilon (paths n) limit

namespace SkorokhodJ1LocalEntourage

open scoped SetRel

variable {State : Type*} [PseudoMetricSpace State]

@[simp]
theorem mem_iff {horizons : Finset ℕ} {epsilon : ℝ}
    {first second : SkorokhodJ1LocalPath State} :
    (first, second) ∈ SkorokhodJ1LocalEntourage horizons epsilon ↔
      ∀ horizon ∈ horizons,
        SkorokhodJ1CloseOn (horizon : ℝ) epsilon first second := Iff.rfl

/-- Positive-radius local entourages contain the diagonal. -/
theorem refl {horizons : Finset ℕ} {epsilon : ℝ} (hepsilon : 0 < epsilon)
    (path : SkorokhodJ1LocalPath State) :
    (path, path) ∈ SkorokhodJ1LocalEntourage horizons epsilon := by
  intro horizon _
  exact SkorokhodJ1CloseOn.self hepsilon

/-- Local entourages are invariant under swapping their paths. -/
theorem swap_preimage {horizons : Finset ℕ} {epsilon : ℝ} :
    (Prod.swap : (SkorokhodJ1LocalPath State × SkorokhodJ1LocalPath State) →
      SkorokhodJ1LocalPath State × SkorokhodJ1LocalPath State) ⁻¹'
      SkorokhodJ1LocalEntourage (State := State) horizons epsilon =
      SkorokhodJ1LocalEntourage (State := State) horizons epsilon := by
  ext pair
  rcases pair with ⟨first, second⟩
  constructor
  · intro hclose horizon hhorizon
    exact SkorokhodJ1CloseOn.symmetric (hclose horizon hhorizon)
  · intro hclose horizon hhorizon
    exact SkorokhodJ1CloseOn.symmetric (hclose horizon hhorizon)

/-- Halving the radius yields composable local `J₁` entourages. -/
theorem comp_subset {horizons : Finset ℕ} {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    SkorokhodJ1LocalEntourage (State := State) horizons (epsilon / 2) ○
        SkorokhodJ1LocalEntourage (State := State) horizons (epsilon / 2) ⊆
      SkorokhodJ1LocalEntourage (State := State) horizons epsilon := by
  rintro ⟨first, third⟩ ⟨second, hfirst, hsecond⟩ horizon hhorizon
  have hcomposed := SkorokhodJ1CloseOn.trans
    (hfirst horizon hhorizon) (hsecond horizon hhorizon)
  simpa using hcomposed

/-- Positive-radius local `J₁` entourages form a directed filter basis. -/
def isBasis :
    Filter.IsBasis (fun index : Finset ℕ × ℝ => 0 < index.2)
      (fun index => SkorokhodJ1LocalEntourage (State := State) index.1 index.2) := by
  refine ⟨⟨(∅, 1), zero_lt_one⟩, ?_⟩
  rintro ⟨firstHorizons, firstRadius⟩ ⟨secondHorizons, secondRadius⟩
    hfirstRadius hsecondRadius
  refine ⟨(firstHorizons ∪ secondHorizons, min firstRadius secondRadius),
    lt_min hfirstRadius hsecondRadius, ?_⟩
  rintro ⟨first, second⟩ hclose
  constructor
  · intro horizon hhorizon
    exact SkorokhodJ1CloseOn.mono
      (hclose horizon (Finset.mem_union_left _ hhorizon)) (min_le_left _ _)
  · intro horizon hhorizon
    exact SkorokhodJ1CloseOn.mono
      (hclose horizon (Finset.mem_union_right _ hhorizon)) (min_le_right _ _)

/-- The local `J₁` filter basis, indexed by a finite horizon set and a
positive radius. -/
def basis : FilterBasis (SkorokhodJ1LocalPath State × SkorokhodJ1LocalPath State) :=
  (isBasis (State := State)).filterBasis

/-- The uniform core for local `J₁` convergence on the nonnegative time
half-line. -/
noncomputable def uniformCore : UniformSpace.Core (SkorokhodJ1LocalPath State) :=
  UniformSpace.Core.mkOfBasis (basis (State := State))
    (by
      rintro radius ⟨⟨horizons, epsilon⟩, hepsilon, rfl⟩ path
      exact refl hepsilon path)
    (by
      rintro radius ⟨⟨horizons, epsilon⟩, hepsilon, rfl⟩
      refine ⟨SkorokhodJ1LocalEntourage horizons epsilon,
        ⟨(horizons, epsilon), hepsilon, rfl⟩, ?_⟩
      rintro ⟨first, second⟩ hclose
      intro horizon hhorizon
      exact SkorokhodJ1CloseOn.symmetric (hclose horizon hhorizon))
    (by
      rintro radius ⟨⟨horizons, epsilon⟩, hepsilon, rfl⟩
      refine ⟨SkorokhodJ1LocalEntourage horizons (epsilon / 2),
        ⟨(horizons, epsilon / 2), half_pos hepsilon, rfl⟩, ?_⟩
      exact comp_subset (State := State) hepsilon)

/-- The local uniform-space topology generated by finite-horizon `J₁`
time-change entourages. -/
@[reducible] noncomputable def uniformSpace : UniformSpace (SkorokhodJ1LocalPath State) :=
  UniformSpace.ofCore (uniformCore (State := State))

/-- The Borel measurable space associated with the local `J₁` uniform
topology. It remains explicit so clients can select a different measurable
path-space representation when appropriate. -/
@[reducible] noncomputable def borelMeasurableSpace :
    MeasurableSpace (SkorokhodJ1LocalPath State) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  exact borel (SkorokhodJ1LocalPath State)

/-- The explicit local measurable space is its `J₁` Borel space. -/
theorem borelSpace :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
      borelMeasurableSpace (State := State)
    BorelSpace (SkorokhodJ1LocalPath State) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
    borelMeasurableSpace (State := State)
  exact ⟨rfl⟩

/-- The local `J₁` entourages form a basis of the local path uniformity. -/
theorem uniformity_hasBasis :
    (@uniformity (SkorokhodJ1LocalPath State) (uniformSpace (State := State))).HasBasis
      (fun index : Finset ℕ × ℝ => 0 < index.2)
      (fun index => SkorokhodJ1LocalEntourage (State := State) index.1 index.2) := by
  change (isBasis (State := State)).filter.HasBasis
    (fun index : Finset ℕ × ℝ => 0 < index.2)
    (fun index => SkorokhodJ1LocalEntourage (State := State) index.1 index.2)
  exact (isBasis (State := State)).hasBasis

/-- Enlarging the finite horizon set and decreasing the radius gives a
smaller local `J₁` entourage. -/
theorem mono {horizons smallerHorizons : Finset ℕ} {epsilon smallerEpsilon : ℝ}
    (hhorizons : horizons ⊆ smallerHorizons) (hepsilon : smallerEpsilon ≤ epsilon) :
    SkorokhodJ1LocalEntourage (State := State) smallerHorizons smallerEpsilon ⊆
      SkorokhodJ1LocalEntourage (State := State) horizons epsilon := by
  intro pair hclose horizon hhorizon
  exact SkorokhodJ1CloseOn.mono
    (hclose horizon (hhorizons hhorizon)) hepsilon

/-- A countable cofinal basis for the local `J₁` uniformity. Finite horizon
sets are enlarged to initial integer segments, and radii are discretized by
reciprocals of positive naturals. -/
theorem uniformity_hasCountableBasis :
    (@uniformity (SkorokhodJ1LocalPath State) (uniformSpace (State := State))).HasBasis
      (fun _ : ℕ × ℕ => True)
      (fun index => SkorokhodJ1LocalEntourage (State := State)
        (Finset.range index.1) (1 / ((index.2 + 1 : ℕ) : ℝ))) := by
  rw [Filter.hasBasis_iff]
  intro target
  rw [(uniformity_hasBasis (State := State)).mem_iff]
  constructor
  · rintro ⟨⟨horizons, epsilon⟩, hepsilon, hsubset⟩
    obtain ⟨horizonBound, hhorizonBound⟩ := Finset.exists_nat_subset_range horizons
    obtain ⟨radiusIndex, hradiusIndex⟩ := exists_nat_one_div_lt hepsilon
    refine ⟨(horizonBound, radiusIndex), trivial, ?_⟩
    simpa [Nat.cast_add, Nat.cast_one] using
      (mono (State := State) hhorizonBound (le_of_lt hradiusIndex)).trans hsubset
  · rintro ⟨index, -, hsubset⟩
    refine ⟨(Finset.range index.1, 1 / ((index.2 + 1 : ℕ) : ℝ)), ?_, hsubset⟩
    positivity

/-- The local `J₁` uniformity is countably generated. This supplies the
metrization prerequisite for the path-space convergence tools, without yet
asserting completeness, separability, or a particular metric formula. -/
theorem uniformity_isCountablyGenerated :
    (@uniformity (SkorokhodJ1LocalPath State) (uniformSpace (State := State))).IsCountablyGenerated :=
  (uniformity_hasCountableBasis (State := State)).isCountablyGenerated

/-- The local `J₁` topology is pseudometrizable. The compatible uniformity
used here is exactly the time-change uniformity constructed above. -/
theorem pseudoMetrizableSpace :
    letI : UniformSpace (SkorokhodJ1LocalPath State) := uniformSpace (State := State)
    TopologicalSpace.PseudoMetrizableSpace (SkorokhodJ1LocalPath State) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) := uniformSpace (State := State)
  letI : (@uniformity (SkorokhodJ1LocalPath State)
    (uniformSpace (State := State))).IsCountablyGenerated :=
    uniformity_isCountablyGenerated (State := State)
  infer_instance

/-- In a compatible pseudometric realization of local `J₁`, every positive
metric radius contains one explicit finite-horizon local entourage.  This
converts a metric closeness request into finitely many direct time-change
requirements without choosing a source-specific path metric formula. -/
theorem exists_localEntourage_subset_dist_lt (delta : ℝ) (hdelta : 0 < delta) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : (@uniformity (SkorokhodJ1LocalPath State)
      (uniformSpace (State := State))).IsCountablyGenerated :=
      uniformity_isCountablyGenerated (State := State)
    letI : PseudoMetricSpace (SkorokhodJ1LocalPath State) :=
      UniformSpace.pseudoMetricSpace (SkorokhodJ1LocalPath State)
    ∃ horizons : Finset ℕ, ∃ epsilon : ℝ, 0 < epsilon ∧
      SkorokhodJ1LocalEntourage (State := State) horizons epsilon ⊆
        {pair | dist pair.1 pair.2 < delta} := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : (@uniformity (SkorokhodJ1LocalPath State)
    (uniformSpace (State := State))).IsCountablyGenerated :=
    uniformity_isCountablyGenerated (State := State)
  letI : PseudoMetricSpace (SkorokhodJ1LocalPath State) :=
    UniformSpace.pseudoMetricSpace (SkorokhodJ1LocalPath State)
  have hdist : {pair : SkorokhodJ1LocalPath State × SkorokhodJ1LocalPath State |
      dist pair.1 pair.2 < delta} ∈
      @uniformity (SkorokhodJ1LocalPath State) _ :=
    Metric.dist_mem_uniformity hdelta
  rw [(uniformity_hasBasis (State := State)).mem_iff] at hdist
  obtain ⟨⟨horizons, epsilon⟩, hepsilon, hsubset⟩ := hdist
  exact ⟨horizons, epsilon, hepsilon, hsubset⟩

/-- Finite-horizon local-`J₁` perturbation probabilities control the
compatible pseudometric perturbation probability.  A positive metric ball
contains one local entourage involving only finitely many horizons; the
exceptional event is therefore bounded by a finite union of the corresponding
finite-horizon exceptional events. -/
theorem eventually_measureReal_dist_ge_of_tendsto_real_not_skorokhodJ1Close
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : ℕ → Measure Ω) [∀ n, IsProbabilityMeasure (μ n)]
    {X Y : ℕ → Ω → SkorokhodJ1LocalPath State}
    (hclose : ∀ horizon : ℕ, ∀ epsilon : ℝ, 0 < epsilon →
      Tendsto (fun n => (μ n).real {omega |
        ¬ SkorokhodJ1CloseOn (horizon : ℝ) epsilon (X n omega) (Y n omega)})
        atTop (𝓝 0)) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : (@uniformity (SkorokhodJ1LocalPath State)
      (uniformSpace (State := State))).IsCountablyGenerated :=
      uniformity_isCountablyGenerated (State := State)
    letI : PseudoMetricSpace (SkorokhodJ1LocalPath State) :=
      UniformSpace.pseudoMetricSpace (SkorokhodJ1LocalPath State)
    ∀ radius : ℝ, 0 < radius → ∀ᶠ n : ℕ in atTop,
      (μ n).real {omega | radius / 2 ≤ dist (X n omega) (Y n omega)} < radius := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : (@uniformity (SkorokhodJ1LocalPath State)
    (uniformSpace (State := State))).IsCountablyGenerated :=
    uniformity_isCountablyGenerated (State := State)
  letI : PseudoMetricSpace (SkorokhodJ1LocalPath State) :=
    UniformSpace.pseudoMetricSpace (SkorokhodJ1LocalPath State)
  intro radius hradius
  obtain ⟨horizons, epsilon, hepsilon, hsubset⟩ :=
    exists_localEntourage_subset_dist_lt (State := State) (radius / 2) (by linarith)
  let budget : ℝ := radius / ((horizons.card : ℝ) + 1)
  have hbudget_pos : 0 < budget := by
    dsimp [budget]
    positivity
  have hsmall : ∀ᶠ n : ℕ in atTop, ∀ horizon ∈ horizons,
      (μ n).real {omega |
        ¬ SkorokhodJ1CloseOn (horizon : ℝ) epsilon (X n omega) (Y n omega)} < budget := by
    refine (Finset.eventually_all horizons).2 ?_
    intro horizon hhorizon
    simpa [Real.dist_eq, abs_of_nonneg MeasureTheory.measureReal_nonneg] using
      Metric.tendsto_nhds.mp (hclose horizon epsilon hepsilon) budget hbudget_pos
  filter_upwards [hsmall] with n hn
  have hbad_subset : {omega | radius / 2 ≤ dist (X n omega) (Y n omega)} ⊆
      ⋃ horizon ∈ horizons, {omega |
        ¬ SkorokhodJ1CloseOn (horizon : ℝ) epsilon (X n omega) (Y n omega)} := by
    intro omega homega
    by_contra houtside
    have hclose_all : ∀ horizon ∈ horizons,
        SkorokhodJ1CloseOn (horizon : ℝ) epsilon (X n omega) (Y n omega) := by
      intro horizon hhorizon
      by_contra hbad
      apply houtside
      exact Set.mem_iUnion.mpr ⟨horizon, Set.mem_iUnion.mpr ⟨hhorizon, hbad⟩⟩
    have hdist : dist (X n omega) (Y n omega) < radius / 2 := by
      change (X n omega, Y n omega) ∈ {pair |
        dist pair.1 pair.2 < radius / 2}
      apply hsubset
      change ∀ horizon ∈ horizons,
        SkorokhodJ1CloseOn (horizon : ℝ) epsilon (X n omega) (Y n omega)
      exact hclose_all
    exact (not_le_of_gt hdist) homega
  calc
    (μ n).real {omega | radius / 2 ≤ dist (X n omega) (Y n omega)} ≤
        (μ n).real (⋃ horizon ∈ horizons, {omega |
          ¬ SkorokhodJ1CloseOn (horizon : ℝ) epsilon (X n omega) (Y n omega)}) :=
      MeasureTheory.measureReal_mono hbad_subset (measure_ne_top _ _)
    _ ≤ ∑ horizon ∈ horizons, (μ n).real {omega |
        ¬ SkorokhodJ1CloseOn (horizon : ℝ) epsilon (X n omega) (Y n omega)} :=
      MeasureTheory.measureReal_biUnion_finset_le horizons _
    _ ≤ ∑ _horizon ∈ horizons, budget := by
      apply Finset.sum_le_sum
      intro horizon hhorizon
      exact (hn horizon hhorizon).le
    _ = (horizons.card : ℝ) * budget := by simp [budget]
    _ < radius := by
      dsimp [budget]
      have hdenom : 0 < (horizons.card : ℝ) + 1 := by positivity
      rw [← mul_div_assoc]
      apply (div_lt_iff₀ hdenom).2
      calc
        (horizons.card : ℝ) * radius = radius * (horizons.card : ℝ) := by ring
        _ < radius * (horizons.card : ℝ) + radius := by linarith
        _ = radius * ((horizons.card : ℝ) + 1) := by ring

/-- The separated local `J₁` path space quotients only topologically
inseparable paths.  In particular, the present full-real-time representation
does not retain arbitrary negative-time values that the local topology never
observes. -/
noncomputable abbrev separatedPathSpace : Type _ :=
  letI : UniformSpace (SkorokhodJ1LocalPath State) := uniformSpace (State := State)
  SeparationQuotient (SkorokhodJ1LocalPath State)

/-- The canonical map from a local path representation to its separated
local-`J₁` path-space point. -/
noncomputable abbrev toSeparatedPathSpace :
    SkorokhodJ1LocalPath State → separatedPathSpace (State := State) :=
  letI : UniformSpace (SkorokhodJ1LocalPath State) := uniformSpace (State := State)
  SeparationQuotient.mk

/-- Passing to the separated local path space is uniformly continuous. -/
theorem uniformContinuous_toSeparatedPathSpace :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    UniformContinuous (toSeparatedPathSpace (State := State)) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  exact SeparationQuotient.uniformContinuous_mk

/-- The separated local `J₁` quotient still has a countably generated
uniformity. -/
theorem separatedPathSpace_uniformity_isCountablyGenerated :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : (@uniformity (SkorokhodJ1LocalPath State)
      (uniformSpace (State := State))).IsCountablyGenerated :=
      uniformity_isCountablyGenerated (State := State)
    (@uniformity (separatedPathSpace (State := State)) _).IsCountablyGenerated := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : (@uniformity (SkorokhodJ1LocalPath State)
    (uniformSpace (State := State))).IsCountablyGenerated :=
    uniformity_isCountablyGenerated (State := State)
  change ((@uniformity (SkorokhodJ1LocalPath State) _).map
    (Prod.map SeparationQuotient.mk SeparationQuotient.mk)).IsCountablyGenerated
  infer_instance

/-- After quotienting its inseparable representations, the local `J₁` path
space is metrizable.  This does not assert the separate completeness or
separability results required for a Polish-space weak-convergence theorem. -/
theorem separatedPathSpace_metrizableSpace :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : (@uniformity (SkorokhodJ1LocalPath State)
      (uniformSpace (State := State))).IsCountablyGenerated :=
      uniformity_isCountablyGenerated (State := State)
    TopologicalSpace.MetrizableSpace (separatedPathSpace (State := State)) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : (@uniformity (SkorokhodJ1LocalPath State)
    (uniformSpace (State := State))).IsCountablyGenerated :=
    uniformity_isCountablyGenerated (State := State)
  letI : (@uniformity (separatedPathSpace (State := State)) _).IsCountablyGenerated :=
    separatedPathSpace_uniformity_isCountablyGenerated (State := State)
  exact UniformSpace.metrizableSpace

/-- Restriction to a fixed integer horizon is uniformly continuous from the
local `J₁` path space to the corresponding finite-horizon path space. -/
theorem uniformContinuous_restrict (horizon : ℕ) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
    UniformContinuous (fun path : SkorokhodJ1LocalPath State => path.restrict horizon) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
  rw [(uniformity_hasBasis (State := State)).uniformContinuous_iff
    (SkorokhodJ1Entourage.uniformity_hasBasis (State := State) (horizon : ℝ))]
  intro epsilon hepsilon
  refine ⟨({horizon}, epsilon), hepsilon, ?_⟩
  intro first second hclose
  change SkorokhodJ1CloseOn (horizon : ℝ) epsilon
    (first.restrict horizon) (second.restrict horizon)
  simpa using hclose horizon (by simp)

/-- The diagonal map collecting every integer-horizon restriction of a local
path.  Its induced uniformity is exactly the local `J₁` uniformity. -/
noncomputable def allRestrictions (path : SkorokhodJ1LocalPath State) :
    ∀ horizon : ℕ, SkorokhodJ1Path (horizon : ℝ) State :=
  fun horizon => path.restrict horizon

/-- The local `J₁` uniformity is induced by the family of all integer-horizon
restrictions.  This gives a precise route from finite-horizon path
measurability to the local path Borel structure, without treating a raw
coordinate-path sigma algebra as a substitute. -/
theorem isUniformInducing_allRestrictions :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : ∀ horizon : ℕ, UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
      fun horizon => SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
    IsUniformInducing (allRestrictions (State := State)) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : ∀ horizon : ℕ, UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
    fun horizon => SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
  have hcontinuous : UniformContinuous (allRestrictions (State := State)) := by
    rw [uniformContinuous_pi]
    intro horizon
    exact uniformContinuous_restrict (State := State) horizon
  apply IsUniformInducing.mk'
  intro set
  constructor
  · intro hset
    rw [(uniformity_hasBasis (State := State)).mem_iff] at hset
    rcases hset with ⟨⟨horizons, epsilon⟩, hepsilon, hsubset⟩
    let targetSet : Set (((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State) ×
        ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State)) :=
      {pair | ∀ horizon ∈ horizons,
        SkorokhodJ1CloseOn (horizon : ℝ) epsilon (pair.1 horizon) (pair.2 horizon)}
    have htargetSet : targetSet ∈
        (@uniformity ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State) _) := by
      change ∀ᶠ pair in (@uniformity
        ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State) _),
        ∀ horizon ∈ horizons,
          SkorokhodJ1CloseOn (horizon : ℝ) epsilon (pair.1 horizon) (pair.2 horizon)
      apply (Finset.eventually_all horizons).2
      intro horizon _
      have hcoordinate :
          SkorokhodJ1Entourage (State := State) (horizon : ℝ) epsilon ∈
            @uniformity (SkorokhodJ1Path (horizon : ℝ) State) _ :=
        (SkorokhodJ1Entourage.uniformity_hasBasis (State := State) (horizon : ℝ)).mem_iff.mpr
          ⟨epsilon, hepsilon, fun _ h => h⟩
      simpa only [SkorokhodJ1Entourage.mem_iff] using
        (Pi.uniformContinuous_proj
          (fun horizon : ℕ => SkorokhodJ1Path (horizon : ℝ) State) horizon hcoordinate)
    refine ⟨targetSet, htargetSet, ?_⟩
    intro first second hpair
    apply hsubset
    intro horizon hhorizon
    exact hpair horizon hhorizon
  · rintro ⟨targetSet, htargetSet, htarget_subset⟩
    have hpreimage := hcontinuous htargetSet
    change (Prod.map (allRestrictions (State := State))
      (allRestrictions (State := State))) ⁻¹' targetSet ∈
        @uniformity (SkorokhodJ1LocalPath State) _ at hpreimage
    apply Filter.mem_of_superset hpreimage ?_
    rintro ⟨first, second⟩ hpair
    exact htarget_subset first second hpair

/-- The explicit local `J₁` Borel space is the comap of the product Borel
space along all finite-horizon restrictions. -/
theorem borelMeasurableSpace_eq_comap_allRestrictions :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
      borelMeasurableSpace (State := State)
    letI : ∀ horizon : ℕ, UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
      fun horizon => SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
    letI : MeasurableSpace ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State) :=
      borel ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State)
    MeasurableSpace.comap (allRestrictions (State := State))
      (borel ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State)) =
      borelMeasurableSpace (State := State) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
    borelMeasurableSpace (State := State)
  letI : ∀ horizon : ℕ, UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
    fun horizon => SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
  letI : MeasurableSpace ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State) :=
    borel ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State)
  change MeasurableSpace.comap (allRestrictions (State := State))
      (borel ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State)) =
    borel (SkorokhodJ1LocalPath State)
  rw [← borel_comap,
    (isUniformInducing_allRestrictions (State := State)).isInducing.eq_induced]

/-- To establish local-path Borel measurability it is enough, and necessary,
to establish Borel measurability of the single map collecting all
finite-horizon restrictions. -/
theorem measurable_iff_measurable_allRestrictions
    {Ω : Type*} [MeasurableSpace Ω]
    (path : Ω → SkorokhodJ1LocalPath State) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
      borelMeasurableSpace (State := State)
    letI : ∀ horizon : ℕ, UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
      fun horizon => SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
    letI : MeasurableSpace ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State) :=
      borel ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State)
    Measurable path ↔ Measurable (allRestrictions (State := State) ∘ path) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
    borelMeasurableSpace (State := State)
  letI : ∀ horizon : ℕ, UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
    fun horizon => SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
  letI : MeasurableSpace ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State) :=
    borel ((horizon : ℕ) → SkorokhodJ1Path (horizon : ℝ) State)
  rw [← borelMeasurableSpace_eq_comap_allRestrictions (State := State)]
  exact measurable_comap_iff

/-- On each open unit-time slab, a finite step path is continuous in the
local `J₁` topology.  Positive integer restrictions use the active-prefix
continuity theorem; the zero restriction sees only the fixed initial value. -/
theorem continuous_finiteStepLocalPath_on_localUnitSlab
    {State : Type*} [PseudoMetricSpace State] {count : ℕ}
    (slabs : Fin count → ℕ) (values : Fin (count + 1) → State) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    Continuous (fun times : localUnitSlab slabs =>
      finiteStepLocalPath times.1.1 values times.1.2.2) := by
  classical
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : ∀ horizon : ℕ, UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
    fun horizon => SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
  apply (isUniformInducing_allRestrictions (State := State)).isInducing.continuous_iff.mpr
  change Continuous (fun times : localUnitSlab slabs => fun horizon : ℕ =>
    (finiteStepLocalPath times.1.1 values times.1.2.2).restrict horizon)
  rw [continuous_pi_iff]
  intro horizon
  cases horizon with
  | zero =>
      let constantPath : SkorokhodJ1Path ((0 : ℕ) : ℝ) State :=
        constantSkorokhodJ1Path ((0 : ℕ) : ℝ) (values 0)
      refine (continuous_congr_of_inseparable
        (f := fun times : localUnitSlab slabs =>
          (finiteStepLocalPath times.1.1 values times.1.2.2).restrict 0)
        (g := fun _ : localUnitSlab slabs => constantPath) ?_).mpr continuous_const
      intro times
      apply SkorokhodJ1Entourage.inseparable_of_eqOn (State := State)
      intro time htime
      have htime_zero : time = 0 := by
        have htime_le : time ≤ 0 := by simpa using htime.2
        exact le_antisymm htime_le htime.1
      rw [htime_zero, SkorokhodJ1LocalPath.restrict_apply,
        finiteStepLocalPath_apply,
        finiteStepPath_zero_eq_firstValue_of_all_pos]
      · rfl
      · exact times.1.2.1
  | succ horizon =>
      exact continuous_finiteStepLocalPath_restrict_on_localUnitSlab slabs values horizon.succ
        (Nat.succ_pos horizon)

/-- The local finite-step path is Borel measurable on every open unit-time
slab of positive ordered knots. -/
theorem measurable_finiteStepLocalPath_on_localUnitSlab
    {State : Type*} [PseudoMetricSpace State] {count : ℕ}
    (slabs : Fin count → ℕ) (values : Fin (count + 1) → State) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
      borelMeasurableSpace (State := State)
    Measurable (fun times : localUnitSlab slabs =>
      finiteStepLocalPath times.1.1 values times.1.2.2) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
    borelMeasurableSpace (State := State)
  letI : BorelSpace (SkorokhodJ1LocalPath State) :=
    borelSpace (State := State)
  letI : BorelSpace (OrderedPositiveKnotFamily count) :=
    (MeasurableEmbedding.subtype_coe measurableSet_orderedPositiveKnotFamily).borelSpace
      Topology.IsInducing.subtypeVal
  letI : BorelSpace (localUnitSlab slabs) :=
    (MeasurableEmbedding.subtype_coe (isOpen_localUnitSlab slabs).measurableSet).borelSpace
      Topology.IsInducing.subtypeVal
  exact (continuous_finiteStepLocalPath_on_localUnitSlab slabs values).measurable

/-- Evaluation at time zero is uniformly continuous in the local `J₁`
topology. This endpoint is special: its value is unchanged by every increasing
time change. -/
theorem uniformContinuous_eval_zero :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    UniformContinuous (fun path : SkorokhodJ1LocalPath State => path 0) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : UniformSpace (SkorokhodJ1Path ((0 : ℕ) : ℝ) State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) ((0 : ℕ) : ℝ)
  have hrestrict : UniformContinuous
      (fun path : SkorokhodJ1LocalPath State => path.restrict (0 : ℕ)) :=
    uniformContinuous_restrict (State := State) 0
  have heval : UniformContinuous
      (fun path : SkorokhodJ1Path ((0 : ℕ) : ℝ) State => path 0) :=
    SkorokhodJ1Entourage.uniformContinuous_eval_zero (State := State)
      ((0 : ℕ) : ℝ) (by norm_num)
  have hcontinuous := heval.comp hrestrict
  simpa [Function.comp_def] using hcontinuous

/-- Evaluation at a fixed nonnegative time is continuous at a local `J₁` path
whenever that path is continuous there. A finite horizon containing the time
reduces this to the finite-horizon `J₁` result. -/
theorem continuousAt_eval_of_continuousAt
    (horizon : ℕ) {time : ℝ} {path : SkorokhodJ1LocalPath State}
    (htime : time ∈ Set.Icc (0 : ℝ) (horizon : ℝ))
    (hpath : ContinuousAt (fun t : ℝ => path t) time) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
    ContinuousAt (fun candidate : SkorokhodJ1LocalPath State => candidate time) path := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
  have hrestrict : ContinuousAt
      (fun candidate : SkorokhodJ1LocalPath State => candidate.restrict horizon) path :=
    (uniformContinuous_restrict (State := State) horizon).continuous.continuousAt
  have heval : ContinuousAt
      (fun candidate : SkorokhodJ1Path (horizon : ℝ) State => candidate time)
      (path.restrict horizon) :=
    SkorokhodJ1Entourage.continuousAt_eval_of_continuousAt
      (State := State) htime (by
        simpa using hpath)
  have heval' : Tendsto
      (fun candidate : SkorokhodJ1Path (horizon : ℝ) State => candidate time)
      (nhds (path.restrict horizon)) (nhds ((path.restrict horizon) time)) := heval
  have hrestrict' : Tendsto
      (fun candidate : SkorokhodJ1LocalPath State => candidate.restrict horizon)
      (nhds path) (nhds (path.restrict horizon)) := hrestrict
  change Tendsto (fun candidate : SkorokhodJ1LocalPath State => candidate time)
    (nhds path) (nhds (path time))
  simpa only [SkorokhodJ1LocalPath.restrict_apply] using heval'.comp hrestrict'

/-- Time-zero evaluation is measurable for the explicit local `J₁` Borel
space. -/
theorem measurable_eval_zero :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : MeasurableSpace State := borel State
    letI : BorelSpace State := ⟨rfl⟩
    letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
      borelMeasurableSpace (State := State)
    Measurable (fun path : SkorokhodJ1LocalPath State => path 0) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : MeasurableSpace State := borel State
  letI : BorelSpace State := ⟨rfl⟩
  letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
    borelMeasurableSpace (State := State)
  letI : BorelSpace (SkorokhodJ1LocalPath State) :=
    borelSpace (State := State)
  exact (uniformContinuous_eval_zero (State := State)).continuous.measurable

/-- Fixed-horizon restriction is measurable for the explicit local and
finite-horizon `J₁` Borel structures. -/
theorem measurable_restrict (horizon : ℕ) :
