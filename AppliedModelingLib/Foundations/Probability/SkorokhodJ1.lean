/-- Local `J₁` convergence in distribution transfers to every fixed
finite-horizon restriction by the continuous mapping theorem. -/
theorem tendstoInDistribution_restrict
    {ι Ω' : Type*} {Ω : ι → Type*}
    {m : ∀ i, MeasurableSpace (Ω i)} {μ : ∀ i, Measure (Ω i)}
    [∀ i, IsProbabilityMeasure (μ i)]
    {m' : MeasurableSpace Ω'} {μ' : Measure Ω'} [IsProbabilityMeasure μ']
    {X : (i : ι) → Ω i → SkorokhodJ1LocalPath State}
    {Z : Ω' → SkorokhodJ1LocalPath State} {l : Filter ι}
    (horizon : ℕ) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
      borelMeasurableSpace (State := State)
    letI : BorelSpace (SkorokhodJ1LocalPath State) :=
      borelSpace (State := State)
    letI : UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
      SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
    letI : MeasurableSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
      SkorokhodJ1Entourage.borelMeasurableSpace (State := State) (horizon : ℝ)
    letI : BorelSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
      SkorokhodJ1Entourage.borelSpace (State := State) (horizon : ℝ)
    TendstoInDistribution X l Z μ μ' →
      TendstoInDistribution
        (fun i => (fun path : SkorokhodJ1LocalPath State => path.restrict horizon) ∘ X i)
        l
        ((fun path : SkorokhodJ1LocalPath State => path.restrict horizon) ∘ Z)
        μ μ' := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
    borelMeasurableSpace (State := State)
  letI : BorelSpace (SkorokhodJ1LocalPath State) :=
    borelSpace (State := State)
  letI : UniformSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
    SkorokhodJ1Entourage.uniformSpace (State := State) (horizon : ℝ)
  letI : MeasurableSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
    SkorokhodJ1Entourage.borelMeasurableSpace (State := State) (horizon : ℝ)
  letI : BorelSpace (SkorokhodJ1Path (horizon : ℝ) State) :=
    SkorokhodJ1Entourage.borelSpace (State := State) (horizon : ℝ)
  intro h
  exact h.continuous_comp
    (uniformContinuous_restrict (State := State) horizon).continuous

/-- Local `J₁` convergence in distribution transfers to the time-zero
coordinate by the continuous mapping theorem. -/
theorem tendstoInDistribution_eval_zero
    {ι Ω' : Type*} {Ω : ι → Type*}
    {m : ∀ i, MeasurableSpace (Ω i)} {μ : ∀ i, Measure (Ω i)}
    [∀ i, IsProbabilityMeasure (μ i)]
    {m' : MeasurableSpace Ω'} {μ' : Measure Ω'} [IsProbabilityMeasure μ']
    {X : (i : ι) → Ω i → SkorokhodJ1LocalPath State}
    {Z : Ω' → SkorokhodJ1LocalPath State} {l : Filter ι} :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : MeasurableSpace State := borel State
    letI : BorelSpace State := ⟨rfl⟩
    letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
      borelMeasurableSpace (State := State)
    letI : BorelSpace (SkorokhodJ1LocalPath State) :=
      borelSpace (State := State)
    TendstoInDistribution X l Z μ μ' →
      TendstoInDistribution
        (fun i => (fun path : SkorokhodJ1LocalPath State => path 0) ∘ X i)
        l
        ((fun path : SkorokhodJ1LocalPath State => path 0) ∘ Z)
        μ μ' := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : MeasurableSpace State := borel State
  letI : BorelSpace State := ⟨rfl⟩
  letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
    borelMeasurableSpace (State := State)
  letI : BorelSpace (SkorokhodJ1LocalPath State) :=
    borelSpace (State := State)
  intro h
  exact h.continuous_comp (uniformContinuous_eval_zero (State := State)).continuous

/-- Anchoring a local path at time zero is uniformly continuous.  The proof
uses the same admissible time change for both paths and the fact that every
such change fixes zero. -/
theorem uniformContinuous_anchorAtZero :
    letI : UniformSpace (SkorokhodJ1LocalPath ℝ) :=
      uniformSpace (State := ℝ)
    UniformContinuous SkorokhodJ1LocalPath.anchorAtZero := by
  letI : UniformSpace (SkorokhodJ1LocalPath ℝ) := uniformSpace (State := ℝ)
  rw [(uniformity_hasBasis (State := ℝ)).uniformContinuous_iff
    (uniformity_hasBasis (State := ℝ))]
  rintro ⟨horizons, epsilon⟩ hepsilon
  refine ⟨(horizons, epsilon / 2), half_pos hepsilon, ?_⟩
  intro first second hclose horizon hhorizon
  rcases hclose horizon hhorizon with ⟨timeChange, htimeChange⟩
  refine ⟨timeChange, ?_⟩
  intro time
  constructor
  · exact lt_trans (htimeChange time).1 (half_lt_self hepsilon)
  · have hzero := (htimeChange ⟨0, le_rfl, Nat.cast_nonneg horizon⟩).2
    rw [SkorokhodTimeChange.map_zero timeChange (Nat.cast_nonneg horizon)] at hzero
    rw [SkorokhodJ1LocalPath.anchorAtZero_apply,
      SkorokhodJ1LocalPath.anchorAtZero_apply, Real.dist_eq]
    calc
      |(first (time : ℝ) - first 0) -
          (second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ) -
            second 0)| =
          |(first (time : ℝ) -
              second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) -
            (first 0 - second 0)| := by
            congr 1
            ring
      _ = |(first (time : ℝ) -
              second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) +
            -(first 0 - second 0)| := by
            simp only [sub_eq_add_neg]
      _ ≤ |first (time : ℝ) -
            second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)| +
          |-(first 0 - second 0)| := abs_add_le _ _
      _ = |first (time : ℝ) -
            second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)| +
          |first 0 - second 0| := by rw [abs_neg]
      _ = dist (first (time : ℝ))
            (second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) +
          dist (first 0) (second 0) := by
            rw [Real.dist_eq, Real.dist_eq]
      _ < epsilon / 2 + epsilon / 2 :=
            add_lt_add (htimeChange time).2 (by simpa [Real.dist_eq] using hzero)
      _ = epsilon := by ring

/-- The time-zero anchoring map is continuous for the local `J₁` topology. -/
theorem continuous_anchorAtZero :
    letI : UniformSpace (SkorokhodJ1LocalPath ℝ) :=
      uniformSpace (State := ℝ)
    Continuous SkorokhodJ1LocalPath.anchorAtZero := by
  letI : UniformSpace (SkorokhodJ1LocalPath ℝ) := uniformSpace (State := ℝ)
  exact uniformContinuous_anchorAtZero.continuous


/-- Translating a local `J₁` path by a fixed continuous real-valued forcing
path is uniformly continuous for the local time-change uniformity.  On each
finite collection of horizons, uniform continuity of the forcing controls the
extra error introduced by the time changes. -/
theorem uniformContinuous_addContinuous (forcing : ℝ → ℝ) (hforcing : Continuous forcing) :
    letI : UniformSpace (SkorokhodJ1LocalPath ℝ) :=
      uniformSpace (State := ℝ)
    UniformContinuous (SkorokhodJ1LocalPath.addContinuous forcing hforcing) := by
  letI : UniformSpace (SkorokhodJ1LocalPath ℝ) := uniformSpace (State := ℝ)
  rw [(uniformity_hasBasis (State := ℝ)).uniformContinuous_iff
    (uniformity_hasBasis (State := ℝ))]
  rintro ⟨horizons, epsilon⟩ hepsilon
  by_cases hnonempty : horizons.Nonempty
  · let maximum : ℕ := horizons.max' hnonempty
    have hmaximum : ∀ horizon ∈ horizons, horizon ≤ maximum := by
      intro horizon hhorizon
      exact Finset.le_max' horizons horizon hhorizon
    have hcompact : IsCompact (Set.Icc (0 : ℝ) (maximum : ℝ)) := isCompact_Icc
    have huniform : UniformContinuousOn forcing (Set.Icc (0 : ℝ) (maximum : ℝ)) :=
      hcompact.uniformContinuousOn_of_continuous hforcing.continuousOn
    have hhalf : 0 < epsilon / 2 := half_pos hepsilon
    obtain ⟨delta, hdelta_pos, hdelta⟩ :=
      (Metric.uniformContinuousOn_iff.mp huniform) (epsilon / 2) hhalf
    let radius : ℝ := min (epsilon / 2) delta
    have hradius_pos : 0 < radius := lt_min hhalf hdelta_pos
    have hradius_half : radius ≤ epsilon / 2 := min_le_left _ _
    have hradius_delta : radius ≤ delta := min_le_right _ _
    refine ⟨(horizons, radius), hradius_pos, ?_⟩
    intro first second hclose horizon hhorizon
    rcases hclose horizon hhorizon with ⟨timeChange, htimeChange⟩
    refine ⟨timeChange, ?_⟩
    intro time
    constructor
    · exact lt_of_le_of_lt ((htimeChange time).1.le.trans hradius_half) (by linarith)
    · have htime_bound : (horizon : ℝ) ≤ (maximum : ℝ) := by
        exact_mod_cast hmaximum horizon hhorizon
      have htime_dist : dist (time : ℝ)
          ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ) < delta := by
        rw [Real.dist_eq]
        have hdisplacement := (htimeChange time).1
        rw [abs_sub_comm]
        exact hdisplacement.trans_le hradius_delta
      have htime_mem : (time : ℝ) ∈ Set.Icc (0 : ℝ) (maximum : ℝ) :=
        ⟨time.property.1, time.property.2.trans htime_bound⟩
      have hchanged_mem :
          ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ) ∈
            Set.Icc (0 : ℝ) (maximum : ℝ) :=
        ⟨(timeChange.toHomeomorph time).property.1,
          (timeChange.toHomeomorph time).property.2.trans htime_bound⟩
      have hforcing_close := hdelta (time : ℝ) htime_mem
        ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)
        hchanged_mem htime_dist
      have hpath_close := (htimeChange time).2
      rw [SkorokhodJ1LocalPath.addContinuous_apply,
        SkorokhodJ1LocalPath.addContinuous_apply, Real.dist_eq]
      calc
        |(first (time : ℝ) + forcing (time : ℝ)) -
            (second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ) +
              forcing ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ))| =
            |(first (time : ℝ) -
                second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) +
              (forcing (time : ℝ) -
                forcing ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ))| := by
              congr 1
              ring
        _ ≤ |first (time : ℝ) -
              second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)| +
            |forcing (time : ℝ) -
              forcing ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)| :=
            abs_add_le _ _
        _ = dist (first (time : ℝ))
              (second ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) +
            dist (forcing (time : ℝ))
              (forcing ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) := by
            rw [Real.dist_eq, Real.dist_eq]
        _ < radius + epsilon / 2 := add_lt_add hpath_close hforcing_close
        _ ≤ epsilon / 2 + epsilon / 2 := by gcongr
        _ = epsilon := by ring
  · refine ⟨(∅, 1), zero_lt_one, ?_⟩
    intro first second hclose horizon hhorizon
    have hempty : horizons = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    rw [hempty] at hhorizon
    simp at hhorizon

/-- The preceding local-J₁ translation is continuous, hence Borel
measurable whenever the local path space has its explicit Borel structure. -/
theorem continuous_addContinuous (forcing : ℝ → ℝ) (hforcing : Continuous forcing) :
    letI : UniformSpace (SkorokhodJ1LocalPath ℝ) :=
      uniformSpace (State := ℝ)
    Continuous (SkorokhodJ1LocalPath.addContinuous forcing hforcing) := by
  letI : UniformSpace (SkorokhodJ1LocalPath ℝ) := uniformSpace (State := ℝ)
  exact (uniformContinuous_addContinuous forcing hforcing).continuous

end SkorokhodJ1LocalEntourage

namespace SkorokhodJ1LocallyConverges

variable {State : Type*} [PseudoMetricSpace State]

/-- Uniform convergence on every compact nonnegative time interval implies
local `J₁` convergence, using the identity time changes. -/
theorem of_tendstoUniformlyOn
    {paths : ℕ → SkorokhodJ1LocalPath State}
    {limit : SkorokhodJ1LocalPath State}
    (huniform : ∀ horizon : ℕ,
      TendstoUniformlyOn (fun n : ℕ => fun time : ℝ => paths n time) limit atTop
        (Set.Icc (0 : ℝ) (horizon : ℝ))) :
    SkorokhodJ1LocallyConverges (fun n => paths n) limit := by
  intro horizon
  exact SkorokhodJ1ConvergesOn.of_tendstoUniformlyOn (huniform horizon)

/-- The regular finite-step meshes of a continuous path converge locally in
`J₁` to its continuous-path representation. -/
theorem uniformMeshFiniteStepLocalPath_locallyConverges_of_continuous
    {State : Type*} [MetricSpace State] (path : ℝ → State)
    (hpath : Continuous path) :
    SkorokhodJ1LocallyConverges
      (fun n : ℕ => uniformMeshFiniteStepLocalPath path (n + 1) (Nat.succ_pos n))
      (SkorokhodJ1LocalPath.ofContinuous path hpath) := by
  apply of_tendstoUniformlyOn
  intro horizon
  simpa only [SkorokhodJ1LocalPath.ofContinuous_apply] using
    tendstoUniformlyOn_uniformMeshFiniteStepLocalPath_of_continuous path hpath horizon

/-- A sequence of càdlàg paths converges locally in `J₁` when, on each compact
forward-time interval, it eventually agrees pointwise with the limiting path.
This is useful for finite-event truncations of nonexplosive jump paths. -/
theorem of_eventually_eq_on_compacts
    {paths : ℕ → SkorokhodJ1LocalPath State}
    {limit : SkorokhodJ1LocalPath State}
    (heq : ∀ horizon : ℕ, ∀ᶠ n : ℕ in atTop, ∀ time ∈ Set.Icc (0 : ℝ) (horizon : ℝ),
      paths n time = limit time) :
    SkorokhodJ1LocallyConverges (fun n => paths n) limit := by
  intro horizon epsilon hepsilon
  filter_upwards [heq horizon] with n hn
  refine ⟨SkorokhodTimeChange.identity (horizon : ℝ), ?_⟩
  intro time
  constructor
  · simpa using hepsilon
  · simpa [hn time time.property] using hepsilon

/-- Adding one deterministic continuous forcing path preserves local `J₁`
convergence.  Continuity of the forcing controls the extra error caused by
the same time changes that witness convergence of the original paths. -/
theorem addContinuous
    {paths : ℕ → SkorokhodJ1LocalPath ℝ}
    {limit : SkorokhodJ1LocalPath ℝ}
    (forcing : ℝ → ℝ) (hforcing : Continuous forcing)
    (hpaths : SkorokhodJ1LocallyConverges (fun n => paths n) limit) :
    SkorokhodJ1LocallyConverges
      (fun n => SkorokhodJ1LocalPath.addContinuous forcing hforcing (paths n))
      (SkorokhodJ1LocalPath.addContinuous forcing hforcing limit) := by
  intro horizon epsilon hepsilon
  have hcompact : IsCompact (Set.Icc (0 : ℝ) (horizon : ℝ)) := isCompact_Icc
  have huniform : UniformContinuousOn forcing (Set.Icc (0 : ℝ) (horizon : ℝ)) :=
    hcompact.uniformContinuousOn_of_continuous hforcing.continuousOn
  have hhalf : 0 < epsilon / 2 := half_pos hepsilon
  obtain ⟨delta, hdelta_pos, hdelta⟩ :=
    (Metric.uniformContinuousOn_iff.mp huniform) (epsilon / 2) hhalf
  let radius : ℝ := min (epsilon / 2) delta
  have hradius_pos : 0 < radius := lt_min hhalf hdelta_pos
  have hradius_half : radius ≤ epsilon / 2 := min_le_left _ _
  have hradius_delta : radius ≤ delta := min_le_right _ _
  filter_upwards [hpaths horizon radius hradius_pos] with n hclose
  rcases hclose with ⟨timeChange, htimeChange⟩
  refine ⟨timeChange, ?_⟩
  intro time
  constructor
  · exact lt_of_le_of_lt ((htimeChange time).1.le.trans hradius_half) (by linarith)
  · have htime_dist : dist (time : ℝ)
        ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ) < delta := by
      rw [Real.dist_eq]
      have hdisplacement := (htimeChange time).1
      rw [abs_sub_comm]
      exact hdisplacement.trans_le hradius_delta
    have hforcing_close := hdelta (time : ℝ) time.property
      ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)
      (timeChange.toHomeomorph time).property htime_dist
    have hpath_close := (htimeChange time).2
    rw [SkorokhodJ1LocalPath.addContinuous_apply,
      SkorokhodJ1LocalPath.addContinuous_apply, Real.dist_eq]
    calc
      |(paths n (time : ℝ) + forcing (time : ℝ)) -
          (limit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ) +
            forcing ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ))| =
          |(paths n (time : ℝ) -
              limit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) +
            (forcing (time : ℝ) -
              forcing ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ))| := by
            congr 1
            ring
      _ ≤ |paths n (time : ℝ) -
            limit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)| +
          |forcing (time : ℝ) -
            forcing ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)| :=
          abs_add_le _ _
      _ = dist (paths n (time : ℝ))
            (limit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) +
          dist (forcing (time : ℝ))
            (forcing ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) := by
          rw [Real.dist_eq, Real.dist_eq]
      _ < radius + epsilon / 2 := add_lt_add hpath_close hforcing_close
      _ ≤ epsilon / 2 + epsilon / 2 := by gcongr
      _ = epsilon := by ring

/-- Pointwise negation preserves local `J₁` convergence.  The same time
changes witness convergence because negation is an isometry on the real state
space. -/
theorem neg
    {paths : ℕ → SkorokhodJ1LocalPath ℝ}
    {limit : SkorokhodJ1LocalPath ℝ}
    (hpaths : SkorokhodJ1LocallyConverges (fun n => paths n) limit) :
    SkorokhodJ1LocallyConverges
      (fun n => (paths n).neg) limit.neg := by
  intro horizon epsilon hepsilon
  filter_upwards [hpaths horizon epsilon hepsilon] with n hclose
  rcases hclose with ⟨timeChange, htimeChange⟩
  refine ⟨timeChange, ?_⟩
  intro time
  constructor
  · exact (htimeChange time).1
  · simpa only [SkorokhodJ1LocalPath.neg_apply, dist_neg_neg] using
      (htimeChange time).2

/-- Local `J₁` convergence is stable under addition of a second convergent
path sequence whenever that second limiting path is continuous on the
nonnegative time domain.  The first component keeps its time changes;
convergence of the second component becomes uniform on each compact interval,
while continuity of its limit controls the time-change displacement.  No
global continuity of path addition at pairs of jump paths is asserted. -/
theorem add_of_right_locallyConverges_to_continuous
    {firstPaths secondPaths : ℕ → SkorokhodJ1LocalPath ℝ}
    {firstLimit secondLimit : SkorokhodJ1LocalPath ℝ}
    (hfirst : SkorokhodJ1LocallyConverges (fun n => firstPaths n) firstLimit)
    (hsecond : SkorokhodJ1LocallyConverges (fun n => secondPaths n) secondLimit)
    (hsecondLimit : ContinuousOn (fun time : ℝ => secondLimit time) (Set.Ici 0)) :
    SkorokhodJ1LocallyConverges
      (fun n => (firstPaths n).add (secondPaths n))
      (firstLimit.add secondLimit) := by
  intro horizon epsilon hepsilon
  have hcompact : IsCompact (Set.Icc (0 : ℝ) (horizon : ℝ)) := isCompact_Icc
  have huniform : UniformContinuousOn (fun time : ℝ => secondLimit time)
      (Set.Icc (0 : ℝ) (horizon : ℝ)) :=
    hcompact.uniformContinuousOn_of_continuous
      (hsecondLimit.mono (by intro time htime; exact htime.1))
  have hepsilonThird : 0 < epsilon / 3 := by linarith
  obtain ⟨delta, hdelta_pos, hdelta⟩ :=
    (Metric.uniformContinuousOn_iff.mp huniform) (epsilon / 3) hepsilonThird
  let radius : ℝ := min (epsilon / 3) delta
  have hradius_pos : 0 < radius := lt_min hepsilonThird hdelta_pos
  have hradius_third : radius ≤ epsilon / 3 := min_le_left _ _
  have hradius_delta : radius ≤ delta := min_le_right _ _
  have hsecondUniform := SkorokhodJ1ConvergesOn.tendstoUniformlyOn_of_continuousOn
    (hsecond horizon) (hsecondLimit.mono (by intro time htime; exact htime.1))
  have hsecondEventually :=
    Metric.tendstoUniformlyOn_iff.mp hsecondUniform (epsilon / 3) hepsilonThird
  filter_upwards [hfirst horizon radius hradius_pos, hsecondEventually]
    with n hfirst_n hsecond_n
  rcases hfirst_n with ⟨timeChange, htimeChange⟩
  refine ⟨timeChange, ?_⟩
  intro time
  constructor
  · exact lt_of_le_of_lt ((htimeChange time).1.le.trans hradius_third) (by linarith)
  · have htimeDist : dist (time : ℝ)
        ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ) < delta := by
      rw [Real.dist_eq]
      have hdisplacement := (htimeChange time).1
      rw [abs_sub_comm]
      exact hdisplacement.trans_le hradius_delta
    have hlimitAlongTimeChange := hdelta (time : ℝ) time.property
      ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)
      (timeChange.toHomeomorph time).property htimeDist
    have hfirstClose := (htimeChange time).2
    have hsecondClose : dist ((secondPaths n) (time : ℝ))
        (secondLimit (time : ℝ)) < epsilon / 3 := by
      simpa only [dist_comm] using hsecond_n (time : ℝ) time.property
    rw [SkorokhodJ1LocalPath.add_apply, SkorokhodJ1LocalPath.add_apply]
    calc
      dist ((firstPaths n) (time : ℝ) + (secondPaths n) (time : ℝ))
          (firstLimit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ) +
            secondLimit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) ≤
          dist ((firstPaths n) (time : ℝ))
            (firstLimit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) +
            dist ((secondPaths n) (time : ℝ))
              (secondLimit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) :=
        dist_add_add_le _ _ _ _
      _ ≤ dist ((firstPaths n) (time : ℝ))
            (firstLimit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) +
          (dist ((secondPaths n) (time : ℝ)) (secondLimit (time : ℝ)) +
            dist (secondLimit (time : ℝ))
              (secondLimit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ))) := by
        gcongr
        exact dist_triangle _ _ _
      _ < radius + epsilon / 3 + epsilon / 3 := by
        nlinarith [hfirstClose, hsecondClose, hlimitAlongTimeChange]
      _ ≤ epsilon / 3 + epsilon / 3 + epsilon / 3 := by gcongr
      _ = epsilon := by ring

/-- Local `J₁` convergence is preserved by a Lipschitz state transformation.
The same time changes work before and after applying the map; only their
state-error radius is rescaled. -/
theorem comp_lipschitz
    {Target : Type*} [PseudoMetricSpace Target] {map : State → Target}
    {lipschitzConstant : NNReal}
    {paths : ℕ → SkorokhodJ1LocalPath State}
    {limit : SkorokhodJ1LocalPath State}
    (hmap : LipschitzWith lipschitzConstant map)
    (hpaths : SkorokhodJ1LocallyConverges (fun n => paths n) limit) :
    SkorokhodJ1LocallyConverges
      (fun n time => map (paths n time))
      (fun time => map (limit time)) := by
  intro horizon epsilon hepsilon
  let denominator : ℝ := (lipschitzConstant : ℝ) + 1
  let radius : ℝ := epsilon / denominator
  have hconstant_nonneg : 0 ≤ (lipschitzConstant : ℝ) :=
    lipschitzConstant.coe_nonneg
  have hdenominator_pos : 0 < denominator := by
    dsimp [denominator]
    linarith
  have hradius_pos : 0 < radius := by
    exact div_pos hepsilon hdenominator_pos
  have hradius_le : radius ≤ epsilon := by
    apply (div_le_iff₀ hdenominator_pos).mpr
    dsimp [denominator]
    nlinarith
  have hscaled_radius_lt : (lipschitzConstant : ℝ) * radius < epsilon := by
    dsimp [radius, denominator]
    calc
      (lipschitzConstant : ℝ) * (epsilon / denominator) <
          ((lipschitzConstant : ℝ) + 1) * (epsilon / denominator) := by
            exact mul_lt_mul_of_pos_right (lt_add_one _) (div_pos hepsilon hdenominator_pos)
      _ = epsilon := by
        rw [show (lipschitzConstant : ℝ) + 1 = denominator by rfl]
        field_simp [hdenominator_pos.ne']
  filter_upwards [hpaths horizon radius hradius_pos] with n hclose
  rcases hclose with ⟨timeChange, htimeChange⟩
  refine ⟨timeChange, ?_⟩
  intro time
  constructor
  · exact (htimeChange time).1.trans_le hradius_le
  · calc
      dist (map (paths n (time : ℝ)))
          (map (limit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ))) ≤
          (lipschitzConstant : ℝ) *
            dist (paths n (time : ℝ))
              (limit ((timeChange.toHomeomorph time : Set.Icc (0 : ℝ) (horizon : ℝ)) : ℝ)) :=
        hmap.dist_le_mul _ _
      _ ≤ (lipschitzConstant : ℝ) * radius := by
        gcongr
        exact (htimeChange time).2.le
      _ < epsilon := hscaled_radius_lt

/-- The direct local time-change definition is exactly convergence in the
local `J₁` uniform topology. -/
theorem tendsto_iff
    {paths : ℕ → SkorokhodJ1LocalPath State}
    {limit : SkorokhodJ1LocalPath State} :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      SkorokhodJ1LocalEntourage.uniformSpace (State := State)
    Tendsto paths atTop (nhds limit) ↔
      SkorokhodJ1LocallyConverges (fun n => paths n) limit := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    SkorokhodJ1LocalEntourage.uniformSpace (State := State)
  change Tendsto paths atTop (nhds limit) ↔
    ∀ horizon : ℕ, ∀ epsilon : ℝ, 0 < epsilon →
      ∀ᶠ n : ℕ in atTop,
        SkorokhodJ1CloseOn (horizon : ℝ) epsilon (paths n) limit
  rw [(nhds_basis_uniformity
    (SkorokhodJ1LocalEntourage.uniformity_hasBasis (State := State))).tendsto_right_iff]
  constructor
  · intro h horizon epsilon hepsilon
    filter_upwards [h ({horizon}, epsilon) hepsilon] with n hn
    exact hn horizon (by simp)
  · intro h ⟨horizons, epsilon⟩ hepsilon
    have hfinite : ∀ᶠ n : ℕ in atTop, ∀ horizon ∈ horizons,
        SkorokhodJ1CloseOn (horizon : ℝ) epsilon (paths n) limit :=
      (Finset.eventually_all horizons).2
        (fun horizon _ => h horizon epsilon hepsilon)
    filter_upwards [hfinite] with n hn
    exact hn

/-- An almost-sure local-`J₁` limit of almost-everywhere measurable path maps
is almost-everywhere measurable for the local `J₁` Borel structure.  This is
the measurability bridge for finite-event approximations of a nonexplosive
jump path; the approximation and its almost-sure convergence remain explicit
premises. -/
theorem aemeasurable_of_ae_locallyConverges
    {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    {paths : ℕ → Ω → SkorokhodJ1LocalPath State}
    {limit : Ω → SkorokhodJ1LocalPath State}
    (hpaths : letI : UniformSpace (SkorokhodJ1LocalPath State) :=
        SkorokhodJ1LocalEntourage.uniformSpace (State := State)
      letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
        SkorokhodJ1LocalEntourage.borelMeasurableSpace (State := State)
      ∀ n, AEMeasurable (paths n) μ)
    (hconverges : ∀ᵐ omega ∂μ,
      SkorokhodJ1LocallyConverges (fun n => paths n omega) (limit omega)) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      SkorokhodJ1LocalEntourage.uniformSpace (State := State)
    letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
      SkorokhodJ1LocalEntourage.borelMeasurableSpace (State := State)
    AEMeasurable limit μ := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    SkorokhodJ1LocalEntourage.uniformSpace (State := State)
  letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
    SkorokhodJ1LocalEntourage.borelMeasurableSpace (State := State)
  letI : TopologicalSpace.PseudoMetrizableSpace (SkorokhodJ1LocalPath State) :=
    SkorokhodJ1LocalEntourage.pseudoMetrizableSpace (State := State)
  letI : BorelSpace (SkorokhodJ1LocalPath State) :=
    SkorokhodJ1LocalEntourage.borelSpace (State := State)
  apply aemeasurable_of_tendsto_metrizable_ae'
  · intro n
    exact hpaths n
  · filter_upwards [hconverges] with omega homega
    exact tendsto_iff.mpr homega

/-- At every continuity point of the limiting path, local `J₁` convergence
gives ordinary convergence of the corresponding coordinates. -/
theorem tendsto_at_of_continuousAt
    {paths : ℕ → SkorokhodJ1LocalPath State}
    {limit : SkorokhodJ1LocalPath State}
    (hpaths : SkorokhodJ1LocallyConverges (fun n => paths n) limit)
    (horizon : ℕ) {time : ℝ}
    (htime : time ∈ Set.Icc (0 : ℝ) (horizon : ℝ))
    (hlimit : ContinuousAt (fun t : ℝ => limit t) time) :
    Tendsto (fun n : ℕ => paths n time) atTop (nhds (limit time)) := by
  exact SkorokhodJ1ConvergesOn.tendsto_at_of_continuousAt
    (hpaths horizon) htime hlimit

/-- Local `J₁` convergence to a path continuous on a fixed compact horizon
is ordinary uniform convergence on that horizon. -/
theorem tendstoUniformlyOn_of_continuousOn
    {paths : ℕ → SkorokhodJ1LocalPath State}
    {limit : SkorokhodJ1LocalPath State} (horizon : ℕ)
    (hpaths : SkorokhodJ1LocallyConverges (fun n => paths n) limit)
    (hlimit : ContinuousOn (fun time : ℝ => limit time)
      (Set.Icc (0 : ℝ) (horizon : ℝ))) :
    TendstoUniformlyOn (fun n : ℕ => fun time : ℝ => paths n time) limit atTop
      (Set.Icc (0 : ℝ) (horizon : ℝ)) := by
  exact SkorokhodJ1ConvergesOn.tendstoUniformlyOn_of_continuousOn
    (hpaths horizon) hlimit

/-- The finite-horizon occupation-measure consequence of local `J₁`
convergence.  The level-set nullity premise is the deterministic condition
needed for a threshold indicator to be continuous along the limiting path. -/
theorem tendsto_volume_occupationBelowSet_of_continuousOn
    {paths : ℕ → SkorokhodJ1LocalPath ℝ}
    {limit : SkorokhodJ1LocalPath ℝ} (horizon : ℕ) (threshold : ℝ)
    (hpaths : SkorokhodJ1LocallyConverges (fun n => paths n) limit)
    (hlimit : ContinuousOn (fun time : ℝ => limit time)
      (Set.Icc (0 : ℝ) (horizon : ℝ)))
    (hpaths_measurable : ∀ n, Measurable (fun time : ℝ => paths n time))
    (hlimit_measurable : Measurable (fun time : ℝ => limit time))
    (hboundary : ∀ᵐ time ∂MeasureTheory.volume,
      time ∈ Set.Ioc (0 : ℝ) (horizon : ℝ) → limit time ≠ threshold) :
    Tendsto
      (fun n : ℕ => MeasureTheory.volume
        (occupationBelowSet (horizon : ℝ) threshold (fun time : ℝ => paths n time)))
      atTop
      (𝓝 (MeasureTheory.volume
        (occupationBelowSet (horizon : ℝ) threshold (fun time : ℝ => limit time)))) := by
  exact SkorokhodJ1ConvergesOn.tendsto_volume_occupationBelowSet_of_continuousOn
    (paths := fun n time => paths n time) (limit := fun time => limit time)
    (hpaths horizon) hlimit hpaths_measurable hlimit_measurable hboundary

/-- Local `J₁` convergence transfers the normalized threshold occupation on a
fixed finite horizon whenever the limiting path has a null threshold level
set there. -/
theorem tendsto_occupationBelowFraction_of_continuousOn
    {paths : ℕ → SkorokhodJ1LocalPath ℝ}
    {limit : SkorokhodJ1LocalPath ℝ} (horizon : ℕ) (threshold : ℝ)
    (hpaths : SkorokhodJ1LocallyConverges (fun n => paths n) limit)
    (hlimit : ContinuousOn (fun time : ℝ => limit time)
      (Set.Icc (0 : ℝ) (horizon : ℝ)))
    (hpaths_measurable : ∀ n, Measurable (fun time : ℝ => paths n time))
    (hlimit_measurable : Measurable (fun time : ℝ => limit time))
    (hboundary : ∀ᵐ time ∂MeasureTheory.volume,
      time ∈ Set.Ioc (0 : ℝ) (horizon : ℝ) → limit time ≠ threshold) :
    Tendsto
      (fun n : ℕ => occupationBelowFraction (horizon : ℝ) threshold
        (fun time : ℝ => paths n time))
      atTop
      (𝓝 (occupationBelowFraction (horizon : ℝ) threshold
        (fun time : ℝ => limit time))) := by
  exact SkorokhodJ1ConvergesOn.tendsto_occupationBelowFraction_of_continuousOn
    (paths := fun n time => paths n time) (limit := fun time => limit time)
    (hpaths horizon) hlimit hpaths_measurable hlimit_measurable hboundary

/-- Direct local `J₁` convergence also converges in the metrizable separated
path-space quotient.  This removes only topologically inseparable path
representations; it neither proves tightness nor identifies a limit law. -/
theorem tendsto_toSeparatedPathSpace
    {paths : ℕ → SkorokhodJ1LocalPath State}
    {limit : SkorokhodJ1LocalPath State}
    (hpaths : SkorokhodJ1LocallyConverges (fun n => paths n) limit) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      SkorokhodJ1LocalEntourage.uniformSpace (State := State)
    Tendsto (fun n => SkorokhodJ1LocalEntourage.toSeparatedPathSpace (paths n))
      atTop
      (nhds (SkorokhodJ1LocalEntourage.toSeparatedPathSpace limit)) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    SkorokhodJ1LocalEntourage.uniformSpace (State := State)
  have htopological : Tendsto paths atTop (nhds limit) :=
    tendsto_iff.mpr hpaths
  exact (SkorokhodJ1LocalEntourage.uniformContinuous_toSeparatedPathSpace
    (State := State)).continuous.continuousAt.tendsto.comp htopological

end SkorokhodJ1LocallyConverges

namespace SkorokhodJ1LocalEntourage

/-- The subspace of local càdlàg paths that are continuous on the physical
time domain `[0, ∞)`. Keeping this as a subtype makes the continuity premise
for a `J₁` addition operation explicit, instead of falsely treating addition
as continuous at arbitrary simultaneous jumps. -/
abbrev ContinuousLocalPath : Type _ :=
  {path : SkorokhodJ1LocalPath ℝ // ContinuousOn (fun time : ℝ => path time) (Set.Ici 0)}

/-- Addition is continuous when its right input is carried together with a
proof that it is a continuous physical-time path.  This is the topological
form of `add_of_right_locallyConverges_to_continuous`. -/
theorem continuous_add_of_right_continuous :
    letI : UniformSpace (SkorokhodJ1LocalPath ℝ) := uniformSpace (State := ℝ)
    Continuous (fun pair : SkorokhodJ1LocalPath ℝ × ContinuousLocalPath =>
      pair.1.add pair.2.1) := by
  letI : UniformSpace (SkorokhodJ1LocalPath ℝ) := uniformSpace (State := ℝ)
  letI : (@uniformity (SkorokhodJ1LocalPath ℝ)
      (uniformSpace (State := ℝ))).IsCountablyGenerated :=
    uniformity_isCountablyGenerated (State := ℝ)
  letI : PseudoMetricSpace (SkorokhodJ1LocalPath ℝ) :=
    UniformSpace.pseudoMetricSpace (SkorokhodJ1LocalPath ℝ)
  rw [continuous_iff_seqContinuous]
  intro paths target hpaths
  have hfirstTop : Tendsto (fun n => (paths n).1) atTop (𝓝 target.1) :=
    (continuous_fst.tendsto target).comp hpaths
  have hsecondSubtypeTop : Tendsto (fun n => (paths n).2) atTop (𝓝 target.2) :=
    (continuous_snd.tendsto target).comp hpaths
  have hsecondTop : Tendsto (fun n => ((paths n).2.1 : SkorokhodJ1LocalPath ℝ))
      atTop (𝓝 target.2.1) :=
    (continuous_subtype_val.tendsto target.2).comp hsecondSubtypeTop
  have hfirst := SkorokhodJ1LocallyConverges.tendsto_iff.mp hfirstTop
  have hsecond := SkorokhodJ1LocallyConverges.tendsto_iff.mp hsecondTop
  simpa only [Function.comp_apply] using
    (SkorokhodJ1LocallyConverges.tendsto_iff.mpr
      (SkorokhodJ1LocallyConverges.add_of_right_locallyConverges_to_continuous
        hfirst hsecond target.2.2 : SkorokhodJ1LocallyConverges
          (fun n => (paths n).1.add (paths n).2.1) (target.1.add target.2.1)))

/-- Pointwise negation is continuous for the local `J₁` topology. -/
theorem continuous_neg :
    letI : UniformSpace (SkorokhodJ1LocalPath ℝ) := uniformSpace (State := ℝ)
    Continuous SkorokhodJ1LocalPath.neg := by
  letI : UniformSpace (SkorokhodJ1LocalPath ℝ) := uniformSpace (State := ℝ)
  letI : (@uniformity (SkorokhodJ1LocalPath ℝ)
      (uniformSpace (State := ℝ))).IsCountablyGenerated :=
    uniformity_isCountablyGenerated (State := ℝ)
  letI : PseudoMetricSpace (SkorokhodJ1LocalPath ℝ) :=
    UniformSpace.pseudoMetricSpace (SkorokhodJ1LocalPath ℝ)
  rw [continuous_iff_seqContinuous]
  intro paths target hpaths
  have hpaths' := SkorokhodJ1LocallyConverges.tendsto_iff.mp hpaths
  simpa only [Function.comp_apply] using
    (SkorokhodJ1LocallyConverges.tendsto_iff.mpr
      (SkorokhodJ1LocallyConverges.neg hpaths'))

/-- With a fixed strictly ordered jump family, the local `J₁` finite-step
constructor is continuous in its finite vector of state values. -/
theorem continuous_finiteStepLocalPath_values
    {State : Type*} [PseudoMetricSpace State] {count : ℕ}
    (jumpTimes : Fin count → ℝ) (hstrict : StrictMono jumpTimes) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    Continuous (fun values : Fin (count + 1) → State =>
      finiteStepLocalPath jumpTimes values hstrict) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  rw [continuous_iff_seqContinuous]
  intro paths target hpaths
  rw [SkorokhodJ1LocallyConverges.tendsto_iff]
  intro horizon epsilon hepsilon
  simpa only [Function.comp_apply, finiteStepLocalPath_apply] using
    (finiteStepPath_convergesOn_of_tendsto_values jumpTimes paths target hpaths)
      epsilon hepsilon

/-- For a second-countable state space, the family of local finite-step paths
with fixed jump times has separable range. -/
theorem isSeparable_range_finiteStepLocalPath_values
    {State : Type*} [PseudoMetricSpace State] [SecondCountableTopology State] {count : ℕ}
    (jumpTimes : Fin count → ℝ) (hstrict : StrictMono jumpTimes) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    TopologicalSpace.IsSeparable (Set.range (fun values : Fin (count + 1) → State =>
      finiteStepLocalPath jumpTimes values hstrict)) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  exact TopologicalSpace.isSeparable_range
    (continuous_finiteStepLocalPath_values jumpTimes hstrict)

/-- With the explicit local `J₁` Borel structure, a fixed-knot finite-step
path is Borel measurable in its finite vector of state values. -/
theorem measurable_finiteStepLocalPath_values
    {State : Type*} [PseudoMetricSpace State] [SecondCountableTopology State] {count : ℕ}
    (jumpTimes : Fin count → ℝ) (hstrict : StrictMono jumpTimes) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : MeasurableSpace State := borel State
    letI : BorelSpace State := ⟨rfl⟩
    letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
      borelMeasurableSpace (State := State)
    Measurable (fun values : Fin (count + 1) → State =>
      finiteStepLocalPath jumpTimes values hstrict) := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : MeasurableSpace State := borel State
  letI : BorelSpace State := ⟨rfl⟩
  letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
    borelMeasurableSpace (State := State)
  letI : BorelSpace (SkorokhodJ1LocalPath State) :=
    borelSpace (State := State)
  exact (continuous_finiteStepLocalPath_values jumpTimes hstrict).measurable

/-- A fixed-knot finite-step local path is almost-everywhere measurable when
each of its finitely many state coordinates is. -/
theorem aemeasurable_finiteStepLocalPath_of_forall_aemeasurable_values
    {Ω State : Type*} [MeasurableSpace Ω] [PseudoMetricSpace State]
    [SecondCountableTopology State]
    {μ : Measure Ω} {count : ℕ}
    (jumpTimes : Fin count → ℝ) (hstrict : StrictMono jumpTimes)
    (values : Ω → Fin (count + 1) → State) :
    letI : UniformSpace (SkorokhodJ1LocalPath State) :=
      uniformSpace (State := State)
    letI : MeasurableSpace State := borel State
    letI : BorelSpace State := ⟨rfl⟩
    letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
      borelMeasurableSpace (State := State)
    (∀ index, AEMeasurable (fun omega => values omega index) μ) →
      AEMeasurable (fun omega => finiteStepLocalPath jumpTimes (values omega) hstrict) μ := by
  letI : UniformSpace (SkorokhodJ1LocalPath State) :=
    uniformSpace (State := State)
  letI : MeasurableSpace State := borel State
  letI : BorelSpace State := ⟨rfl⟩
  letI : MeasurableSpace (SkorokhodJ1LocalPath State) :=
    borelMeasurableSpace (State := State)
  letI : BorelSpace (SkorokhodJ1LocalPath State) :=
    borelSpace (State := State)
  intro hvalues
  exact (measurable_finiteStepLocalPath_values jumpTimes hstrict).comp_aemeasurable'
