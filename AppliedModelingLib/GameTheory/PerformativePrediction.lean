            2 * (smoothness : ℝ) ^ 2 * sensitivity) -
          2 * stepSize * (modulus * (smoothness : ℝ) /
            (modulus + (smoothness : ℝ))) +
          2 * stepSize * (smoothness : ℝ) * sensitivity) * ‖displacement‖ ^ 2 +
          (stepSize ^ 2 - 2 * stepSize / (modulus + (smoothness : ℝ))) *
            ‖parameterShift‖ ^ 2 := by ring
      _ ≤ (1 + stepSize ^ 2 * (sensitivity ^ 2 * (smoothness : ℝ) ^ 2 +
            2 * (smoothness : ℝ) ^ 2 * sensitivity) -
          2 * stepSize * (modulus * (smoothness : ℝ) /
            (modulus + (smoothness : ℝ))) +
          2 * stepSize * (smoothness : ℝ) * sensitivity) * ‖first - second‖ ^ 2 := by
            nlinarith [hstepSizeSqScaled]
  have hprojected :
      ‖project (first - stepSize • frozenPopulationGradient model gradient first first) -
          project (second - stepSize • frozenPopulationGradient model gradient second second)‖ ≤
