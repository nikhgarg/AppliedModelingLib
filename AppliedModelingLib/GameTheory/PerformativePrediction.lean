    sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ))
  have hsmooth : 0 < (smoothness : ℝ) := lt_of_lt_of_le hmodulus hmodulus_le
  have hdenominator_pos : 0 < modulus + (smoothness : ℝ) := by positivity
  have hfactor_nonneg : 0 ≤ (3 / 2) * stepSize * (smoothness : ℝ) := by positivity
  have hfactor_pos : 0 < 1 + (3 / 2) * stepSize * (smoothness : ℝ) := by positivity
  have hsensitivity_small' :
      sensitivity * ((modulus + (smoothness : ℝ)) *
        (1 + (3 / 2) * stepSize * (smoothness : ℝ))) < modulus :=
    (lt_div_iff₀ (mul_pos hdenominator_pos hfactor_pos)).mp hsensitivity_small
  have hgap_pos : 0 < contractionGap := by
    have hfactorization : contractionGap = (smoothness : ℝ) /
        (modulus + (smoothness : ℝ)) *
          (modulus - sensitivity * ((modulus + (smoothness : ℝ)) *
            (1 + (3 / 2) * stepSize * (smoothness : ℝ)))) := by
      dsimp [contractionGap]
      field_simp
      ring
    rw [hfactorization]
    exact mul_pos (by positivity) (sub_pos.mpr hsensitivity_small')
  have hsensitivity_lt_one : sensitivity < 1 := by
    have hdenominator_gt : modulus < (modulus + (smoothness : ℝ)) *
        (1 + (3 / 2) * stepSize * (smoothness : ℝ)) := by
      have hnonneg : 0 ≤ (modulus + (smoothness : ℝ)) *
        ((3 / 2) * stepSize * (smoothness : ℝ)) := by positivity
      nlinarith
    have hratio_lt_one : modulus /
        ((modulus + (smoothness : ℝ)) *
          (1 + (3 / 2) * stepSize * (smoothness : ℝ))) < 1 :=
      (div_lt_one (mul_pos hdenominator_pos hfactor_pos)).mpr hdenominator_gt
    exact hsensitivity_small.trans hratio_lt_one
  have hsensitivity_sq : sensitivity ^ 2 ≤ sensitivity := by nlinarith
  have hsquareCoefficient :
      1 + stepSize ^ 2 * (sensitivity ^ 2 * (smoothness : ℝ) ^ 2 +
          2 * (smoothness : ℝ) ^ 2 * sensitivity) -
        2 * stepSize * (modulus * (smoothness : ℝ) /
          (modulus + (smoothness : ℝ))) +
        2 * stepSize * (smoothness : ℝ) * sensitivity ≤
      1 - 2 * stepSize * contractionGap := by
    have hscaled : stepSize ^ 2 * (smoothness : ℝ) ^ 2 * sensitivity ^ 2 ≤
        stepSize ^ 2 * (smoothness : ℝ) ^ 2 * sensitivity := by
      exact mul_le_mul_of_nonneg_left hsensitivity_sq (by positivity)
    dsimp [contractionGap]
    nlinarith [hscaled]
  have hsq := sq_norm_measureRepeatedGradientDescentUpdate_sub_le_of_interpolation
    model gradient hjoint hintegrable hgradientAt hsensitivity hsensitive hmodulus hmodulus_le hstrong
    project hproject stepSize hstepSize hstepSize_le first second
  have hcoefficientScaled :
      (1 + stepSize ^ 2 * (sensitivity ^ 2 * (smoothness : ℝ) ^ 2 +
          2 * (smoothness : ℝ) ^ 2 * sensitivity) -
        2 * stepSize * (modulus * (smoothness : ℝ) /
          (modulus + (smoothness : ℝ))) +
        2 * stepSize * (smoothness : ℝ) * sensitivity) * ‖first - second‖ ^ 2 ≤
        (1 - 2 * stepSize * contractionGap) * ‖first - second‖ ^ 2 := by
    exact mul_le_mul_of_nonneg_right hsquareCoefficient (sq_nonneg _)
  have hsqSource :
      ‖measureRepeatedGradientDescentUpdate model gradient project stepSize first -
          measureRepeatedGradientDescentUpdate model gradient project stepSize second‖ ^ 2 ≤
        (1 - 2 * stepSize * contractionGap) * ‖first - second‖ ^ 2 :=
    hsq.trans hcoefficientScaled
  have hgap_le_classical : contractionGap ≤
      modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) := by
    dsimp [contractionGap]
    have hnonneg : 0 ≤ sensitivity *
        ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ)) := by positivity
    linarith
  have hamgm : 4 * modulus * (smoothness : ℝ) ≤
      (modulus + (smoothness : ℝ)) ^ 2 := by
    nlinarith [sq_nonneg (modulus - (smoothness : ℝ))]
  have hclassicalStep : stepSize *
      (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) ≤ 1 / 2 := by
    have hstepScaled := mul_le_mul_of_nonneg_right hstepSize_le
      (by positivity : 0 ≤ modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)))
    have hratio : 2 * modulus * (smoothness : ℝ) /
        (modulus + (smoothness : ℝ)) ^ 2 ≤ 1 / 2 :=
      (div_le_iff₀ (sq_pos_of_pos hdenominator_pos)).mpr (by nlinarith [hamgm])
    calc
      stepSize * (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) ≤
          (2 / (modulus + (smoothness : ℝ))) *
            (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) := hstepScaled
      _ = 2 * modulus * (smoothness : ℝ) /
          (modulus + (smoothness : ℝ)) ^ 2 := by field_simp
      _ ≤ 1 / 2 := hratio
  have hgapStep : stepSize * contractionGap ≤ 1 / 2 := by
    calc
      stepSize * contractionGap ≤ stepSize *
          (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) :=
        mul_le_mul_of_nonneg_left hgap_le_classical hstepSize
      _ ≤ 1 / 2 := hclassicalStep
  have hright_nonneg : 0 ≤ (1 - stepSize * contractionGap) * ‖first - second‖ := by
    have : 0 ≤ 1 - stepSize * contractionGap := by linarith
    positivity
  have hsqToNorm :
      ‖measureRepeatedGradientDescentUpdate model gradient project stepSize first -
          measureRepeatedGradientDescentUpdate model gradient project stepSize second‖ ^ 2 ≤
        ((1 - stepSize * contractionGap) * ‖first - second‖) ^ 2 := by
    calc
      ‖measureRepeatedGradientDescentUpdate model gradient project stepSize first -
          measureRepeatedGradientDescentUpdate model gradient project stepSize second‖ ^ 2 ≤
          (1 - 2 * stepSize * contractionGap) * ‖first - second‖ ^ 2 := hsqSource
      _ ≤ ((1 - stepSize * contractionGap) * ‖first - second‖) ^ 2 := by
        have hnonneg : 0 ≤ (stepSize * contractionGap) ^ 2 * ‖first - second‖ ^ 2 := by positivity
        nlinarith
  exact (sq_le_sq₀ (norm_nonneg _) hright_nonneg).mp hsqToNorm

/--
The PZ A1/A2/W₁ contraction estimate with the frozen-risk derivative
representation discharged directly from A1. Local loss measurability and
pointwise differentiability remain explicit because joint gradient smoothness
alone does not establish them. This packages the population RGD contraction
needed by the empirical Theorem 3.10 trajectory without asking a caller to
restate a separate `HasGradientAt` premise.
-/
theorem dist_measureRepeatedGradientDescentUpdate_sub_le_of_A1_A2_wassersteinSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (hmodulus : 0 < modulus) (hmodulus_le : modulus ≤ (smoothness : ℝ))
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (project : Parameter → Parameter) (hproject : LipschitzWith 1 project)
    (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    (hstepSize_le : stepSize ≤ 2 / (modulus + (smoothness : ℝ)))
    (hsensitivity_small : sensitivity < modulus /
      ((modulus + (smoothness : ℝ)) * (1 + (3 / 2) * stepSize * (smoothness : ℝ))))
    (hloss_meas : ∀ distributionParameter evaluatedParameter,
      ∀ᶠ parameter in nhds evaluatedParameter,
        AEStronglyMeasurable (fun datum => model.loss datum parameter)
          (model.dataLaw distributionParameter : Measure Data))
    (hpointwise : ∀ datum parameter,
      HasGradientAt (fun theta => model.loss datum theta) (gradient datum parameter) parameter)
    (first second : Parameter) :
    dist (measureRepeatedGradientDescentUpdate model gradient project stepSize first)
      (measureRepeatedGradientDescentUpdate model gradient project stepSize second) ≤
      (1 - stepSize * (modulus * (smoothness : ℝ) /
        (modulus + (smoothness : ℝ)) -
          sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 +
            (smoothness : ℝ)))) * dist first second := by
  simpa only [dist_eq_norm] using
    norm_measureRepeatedGradientDescentUpdate_sub_le_of_interpolation
      model gradient hjoint hintegrable
      (fun distributionParameter evaluatedParameter =>
        hasGradientAt_measureDecoupledPerformativeRisk_of_jointSmooth model gradient hjoint
          distributionParameter evaluatedParameter
          (hloss_meas distributionParameter evaluatedParameter)
          (hintegrable distributionParameter evaluatedParameter) hpointwise 1 (by norm_num))
      hsensitivity hsensitive hmodulus hmodulus_le hstrong project hproject stepSize hstepSize
      hstepSize_le hsensitivity_small first second

/--
The scalar side conditions behind Theorem 3.8's displayed contraction factor:
the gap is positive and the source step-size restriction keeps the factor
nonnegative.  Isolating them makes the Banach packaging independent of the
squared-distance calculation.
-/
theorem rgd_contractionGap_pos_and_step_mul_le_half
    {smoothness : NNReal} {sensitivity modulus stepSize : ℝ}
    (hsensitivity : 0 ≤ sensitivity) (hmodulus : 0 < modulus)
    (hmodulus_le : modulus ≤ (smoothness : ℝ)) (hstepSize : 0 ≤ stepSize)
    (hstepSize_le : stepSize ≤ 2 / (modulus + (smoothness : ℝ)))
    (hsensitivity_small : sensitivity < modulus /
      ((modulus + (smoothness : ℝ)) * (1 + (3 / 2) * stepSize * (smoothness : ℝ)))) :
    0 < modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
        sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ)) ∧
      stepSize * (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
        sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ))) ≤ 1 / 2 := by
  let contractionGap := modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
    sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ))
  have hsmooth : 0 < (smoothness : ℝ) := lt_of_lt_of_le hmodulus hmodulus_le
  have hdenominator_pos : 0 < modulus + (smoothness : ℝ) := by positivity
  have hfactor_pos : 0 < 1 + (3 / 2) * stepSize * (smoothness : ℝ) := by positivity
  have hsensitivity_small' :
      sensitivity * ((modulus + (smoothness : ℝ)) *
        (1 + (3 / 2) * stepSize * (smoothness : ℝ))) < modulus :=
    (lt_div_iff₀ (mul_pos hdenominator_pos hfactor_pos)).mp hsensitivity_small
  have hgap_pos : 0 < contractionGap := by
    have hfactorization : contractionGap = (smoothness : ℝ) /
        (modulus + (smoothness : ℝ)) *
          (modulus - sensitivity * ((modulus + (smoothness : ℝ)) *
            (1 + (3 / 2) * stepSize * (smoothness : ℝ)))) := by
      dsimp [contractionGap]
      field_simp
      ring
    rw [hfactorization]
    exact mul_pos (by positivity) (sub_pos.mpr hsensitivity_small')
  have hgap_le_classical : contractionGap ≤
      modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) := by
    dsimp [contractionGap]
    have hnonneg : 0 ≤ sensitivity *
        ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ)) := by positivity
    linarith
  have hamgm : 4 * modulus * (smoothness : ℝ) ≤
      (modulus + (smoothness : ℝ)) ^ 2 := by
    nlinarith [sq_nonneg (modulus - (smoothness : ℝ))]
  have hclassicalStep : stepSize *
      (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) ≤ 1 / 2 := by
    have hstepScaled := mul_le_mul_of_nonneg_right hstepSize_le
      (by positivity : 0 ≤ modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)))
    have hratio : 2 * modulus * (smoothness : ℝ) /
        (modulus + (smoothness : ℝ)) ^ 2 ≤ 1 / 2 :=
      (div_le_iff₀ (sq_pos_of_pos hdenominator_pos)).mpr (by nlinarith [hamgm])
    calc
      stepSize * (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) ≤
          (2 / (modulus + (smoothness : ℝ))) *
            (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) := hstepScaled
      _ = 2 * modulus * (smoothness : ℝ) /
          (modulus + (smoothness : ℝ)) ^ 2 := by field_simp
      _ ≤ 1 / 2 := hratio
  have hgapStep : stepSize * contractionGap ≤ 1 / 2 := by
    calc
      stepSize * contractionGap ≤ stepSize *
          (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) :=
        mul_le_mul_of_nonneg_left hgap_le_classical hstepSize
      _ ≤ 1 / 2 := hclassicalStep
  exact ⟨by simpa [contractionGap] using hgap_pos, by simpa [contractionGap] using hgapStep⟩

/--
The arbitrary-measure realization of PZ Theorem 3.8(b).  With the source
step-size and sensitivity restrictions, projected RGD has one domain-stable
point and its iterates converge to it at the displayed linear rate.
-/
theorem measureRepeatedGradientDescent_convergesLinearly_of_interpolation
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (hmodulus : 0 < modulus) (hmodulus_le : modulus ≤ (smoothness : ℝ))
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (hclosed : IsClosed domain) (hnonempty : domain.Nonempty)
    (hconvex : Convex ℝ domain) (project : Parameter → Parameter)
    (hproject : IsVariationalEuclideanProjectionOn domain project)
    (hproject_nonexpansive : LipschitzWith 1 project)
    (stepSize : ℝ) (hstepSize : 0 < stepSize)
    (hstepSize_le : stepSize ≤ 2 / (modulus + (smoothness : ℝ)))
    (hsensitivity_small : sensitivity < modulus /
      ((modulus + (smoothness : ℝ)) * (1 + (3 / 2) * stepSize * (smoothness : ℝ))))
    (initial : Parameter) (hinitial : initial ∈ domain) :
    ∃ stable ∈ domain, IsMeasurePerformativelyStableOn model domain stable ∧
      (∀ other ∈ domain, IsMeasurePerformativelyStableOn model domain other → other = stable) ∧
      Filter.Tendsto
        (fun iteration => (measureRepeatedGradientDescentUpdate model gradient project stepSize)^[iteration]
          initial)
        Filter.atTop (nhds stable) ∧
      ∀ iteration,
        ‖(measureRepeatedGradientDescentUpdate model gradient project stepSize)^[iteration] initial -
            stable‖ ≤
          (1 - stepSize * (modulus * (smoothness : ℝ) /
            (modulus + (smoothness : ℝ)) -
              sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 +
                (smoothness : ℝ)))) ^ iteration * ‖initial - stable‖ := by
  let contractionGap := modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
    sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ))
  have hgap := rgd_contractionGap_pos_and_step_mul_le_half hsensitivity hmodulus hmodulus_le
    hstepSize.le hstepSize_le hsensitivity_small
  have hgap' : 0 < contractionGap ∧ stepSize * contractionGap ≤ 1 / 2 := by
    simpa [contractionGap] using hgap
  have hfactor_nonneg : 0 ≤ 1 - stepSize * contractionGap := by linarith [hgap'.2]
  let factor : NNReal := ⟨1 - stepSize * contractionGap, hfactor_nonneg⟩
  have hfactor_lt : factor < 1 := by
    change 1 - stepSize * contractionGap < 1
    have hpositive : 0 < stepSize * contractionGap := mul_pos hstepSize hgap'.1
    linarith
  have hmaps : Set.MapsTo (measureRepeatedGradientDescentUpdate model gradient project stepSize)
      domain domain := fun _ _ => hproject.1 _
  let restricted : domain → domain := restrictedUpdate domain
    (measureRepeatedGradientDescentUpdate model gradient project stepSize) hmaps
  have hbound : ∀ first ∈ domain, ∀ second ∈ domain,
      dist (measureRepeatedGradientDescentUpdate model gradient project stepSize first)
        (measureRepeatedGradientDescentUpdate model gradient project stepSize second) ≤
          (factor : ℝ) * dist first second := by
    intro first hfirst second hsecond
    simpa only [factor, contractionGap, dist_eq_norm, NNReal.coe_mk] using
      norm_measureRepeatedGradientDescentUpdate_sub_le_of_interpolation
        model gradient hjoint hintegrable hgradientAt hsensitivity hsensitive hmodulus hmodulus_le
        hstrong project hproject_nonexpansive stepSize hstepSize.le hstepSize_le hsensitivity_small
        first second
  have hcontract : ContractingWith factor restricted := by
    simpa [restricted] using contractingWith_restrictedUpdate_of_bound domain
      (measureRepeatedGradientDescentUpdate model gradient project stepSize) hmaps hfactor_lt hbound
  letI : IsClosed domain := hclosed
  letI : Nonempty domain := Set.nonempty_coe_sort.mpr hnonempty
  let stableSub : domain := hcontract.fixedPoint restricted
  have hstableFixed : Function.IsFixedPt restricted stableSub := hcontract.fixedPoint_isFixedPt
  have hstableFixedVal : measureRepeatedGradientDescentUpdate model gradient project stepSize stableSub =
      stableSub := by
    simpa [restricted, restrictedUpdate] using congrArg Subtype.val hstableFixed
  have hstable : IsMeasurePerformativelyStableOn model domain stableSub := by
    have hfixed' : project
        (stableSub - stepSize • measureFrozenPopulationGradient model gradient stableSub stableSub) =
          stableSub := by
      simpa [measureRepeatedGradientDescentUpdate] using hstableFixedVal
    refine ⟨stableSub.2, ?_⟩
    intro candidate hcandidate
    have hfirstOrder : 0 ≤ ⟪candidate - stableSub,
        measureFrozenPopulationGradient model gradient stableSub stableSub⟫_ℝ := by
      rw [real_inner_comm]
      exact projectedGradient_fixedPoint_firstOrder domain project hproject
        (measureFrozenPopulationGradient model gradient stableSub stableSub) stableSub stepSize hstepSize
        hfixed' candidate hcandidate
    have hlower := measureFrozenRisk_strongConvex_lowerBound model gradient hstrong hintegrable
      stableSub stableSub candidate
    have hquadratic : 0 ≤ modulus / 2 * ‖candidate - stableSub‖ ^ 2 := by positivity
    change measureDecoupledPerformativeRisk model stableSub stableSub ≤
      measureDecoupledPerformativeRisk model stableSub candidate
    nlinarith
  refine ⟨stableSub, stableSub.2, hstable, ?_, ?_, ?_⟩
  · intro other hother hotherStable
    have hotherFixed : measureRepeatedGradientDescentUpdate model gradient project stepSize other =
        other := by
      have hfirstOrder := isMeasureFrozenGradientFirstOrderOptimalOn_of_hasGradientAt
        model gradient domain hconvex other other hotherStable (hgradientAt other other)
      have hprojected := projectedGradient_fixedPoint_of_firstOrder domain project hproject
        (measureFrozenPopulationGradient model gradient other other) other hotherStable.1 stepSize hstepSize
        (fun candidate hcandidate => by
          have hfirst := hfirstOrder candidate hcandidate
          rw [real_inner_comm] at hfirst
          exact hfirst)
      simpa [measureRepeatedGradientDescentUpdate] using hprojected
    have hotherFixedSub : Function.IsFixedPt restricted ⟨other, hother⟩ := by
      apply Subtype.ext
      simpa [restricted, restrictedUpdate] using hotherFixed
    exact congrArg Subtype.val (hcontract.fixedPoint_unique' hotherFixedSub hstableFixed)
  · have hlimit := hcontract.tendsto_iterate_fixedPoint ⟨initial, hinitial⟩
    convert (continuous_subtype_val.tendsto _).comp hlimit using 1
    funext iteration
    change (measureRepeatedGradientDescentUpdate model gradient project stepSize)^[iteration] initial =
      ((restricted^[iteration] ⟨initial, hinitial⟩ : domain) : Parameter)
    simp only [restricted, restrictedUpdate]
    rw [Set.MapsTo.coe_iterate_restrict]
  · intro iteration
    have hrate := (hcontract.toLipschitzWith.iterate iteration).dist_le_mul
      ⟨initial, hinitial⟩ stableSub
    rw [(hstableFixed.iterate iteration).eq] at hrate
    simpa only [factor, contractionGap, restricted, restrictedUpdate,
      Set.MapsTo.iterate_restrict, Set.MapsTo.val_restrict_apply, Subtype.dist_eq,
      dist_eq_norm, NNReal.coe_pow, NNReal.coe_mk] using hrate

/--
The arbitrary-law projected-RGD conclusion with the Euclidean projection
selected from the closed convex domain itself.  This discharges the two
projection certificates in `measureRepeatedGradientDescent_convergesLinearly_of_interpolation`
using the reusable Hilbert-projection construction.
-/
theorem measureRepeatedGradientDescent_convergesLinearly_withHilbertProjection_of_interpolation
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (hmodulus : 0 < modulus) (hmodulus_le : modulus ≤ (smoothness : ℝ))
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (hclosed : IsClosed domain) (hnonempty : domain.Nonempty)
    (hconvex : Convex ℝ domain)
    (stepSize : ℝ) (hstepSize : 0 < stepSize)
    (hstepSize_le : stepSize ≤ 2 / (modulus + (smoothness : ℝ)))
    (hsensitivity_small : sensitivity < modulus /
      ((modulus + (smoothness : ℝ)) * (1 + (3 / 2) * stepSize * (smoothness : ℝ))))
    (initial : Parameter) (hinitial : initial ∈ domain) :
    ∃ stable ∈ domain, IsMeasurePerformativelyStableOn model domain stable ∧
      (∀ other ∈ domain, IsMeasurePerformativelyStableOn model domain other → other = stable) ∧
      Filter.Tendsto
        (fun iteration =>
          (measureRepeatedGradientDescentUpdate model gradient
            (hilbertProjection domain hnonempty hclosed hconvex) stepSize)^[iteration] initial)
        Filter.atTop (nhds stable) ∧
      ∀ iteration,
        ‖(measureRepeatedGradientDescentUpdate model gradient
          (hilbertProjection domain hnonempty hclosed hconvex) stepSize)^[iteration] initial - stable‖ ≤
          (1 - stepSize * (modulus * (smoothness : ℝ) /
            (modulus + (smoothness : ℝ)) -
              sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 +
                (smoothness : ℝ)))) ^ iteration * ‖initial - stable‖ := by
  exact measureRepeatedGradientDescent_convergesLinearly_of_interpolation
    model gradient hjoint hintegrable hgradientAt hsensitivity hsensitive hmodulus hmodulus_le hstrong
    domain hclosed hnonempty hconvex (hilbertProjection domain hnonempty hclosed hconvex)
    (isVariationalEuclideanProjectionOn_hilbertProjection domain hnonempty hclosed hconvex)
    (hilbertProjection_lipschitzWith_one domain hnonempty hclosed hconvex) stepSize hstepSize
    hstepSize_le hsensitivity_small initial hinitial

/--
A conservative arbitrary-law squared-distance estimate for projected repeated
gradient descent.  It uses only the two coordinate-wise A1 bounds, pointwise
A2, W₁ sensitivity, and projection nonexpansiveness.  The sharper source
Theorem 3.8 coefficient additionally requires the averaged interpolation
inequality developed separately.
-/
theorem sq_norm_measureRepeatedGradientDescentUpdate_sub_le_of_jointSmooth
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (project : Parameter → Parameter) (hproject : LipschitzWith 1 project)
    (stepSize : ℝ) (hstepSize : 0 ≤ stepSize) (first second : Parameter) :
    ‖measureRepeatedGradientDescentUpdate model gradient project stepSize first -
        measureRepeatedGradientDescentUpdate model gradient project stepSize second‖ ^ 2 ≤
      (1 - 2 * stepSize * (modulus - (smoothness : ℝ) * sensitivity) +
        stepSize ^ 2 * ((smoothness : ℝ) * (sensitivity + 1)) ^ 2) *
          ‖first - second‖ ^ 2 := by
  let displacement := first - second
  let gradientShift := measureFrozenPopulationGradient model gradient first first -
    measureFrozenPopulationGradient model gradient second second
  have hmonotone := measureDiagonalFrozenPopulationGradient_strongMonotone_of_jointSmooth
    model gradient hgradient hintegrable hsensitive hstrong first second
  have hmonotone' :
      (modulus - (smoothness : ℝ) * sensitivity) * ‖displacement‖ ^ 2 ≤
        ⟪displacement, gradientShift⟫_ℝ := by
    simpa [displacement, gradientShift] using hmonotone
  have hgradientNorm := norm_measureDiagonalFrozenPopulationGradient_sub_le_of_jointSmooth
    model gradient hgradient hintegrable hsensitive first second
  have hgradientNorm' :
      ‖gradientShift‖ ≤ (smoothness : ℝ) * (sensitivity + 1) * ‖displacement‖ := by
    simpa [displacement, gradientShift] using hgradientNorm
  have hgradientBoundNonneg :
      0 ≤ (smoothness : ℝ) * (sensitivity + 1) * ‖displacement‖ := by positivity
  have hgradientSq :
      ‖gradientShift‖ ^ 2 ≤
        ((smoothness : ℝ) * (sensitivity + 1) * ‖displacement‖) ^ 2 := by
    exact (sq_le_sq₀ (norm_nonneg _) hgradientBoundNonneg).mpr hgradientNorm'
  have hraw :
      ‖(first - stepSize • measureFrozenPopulationGradient model gradient first first) -
          (second - stepSize • measureFrozenPopulationGradient model gradient second second)‖ ^ 2 ≤
        (1 - 2 * stepSize * (modulus - (smoothness : ℝ) * sensitivity) +
          stepSize ^ 2 * ((smoothness : ℝ) * (sensitivity + 1)) ^ 2) *
          ‖first - second‖ ^ 2 := by
    have hexpand :
        ‖(first - stepSize • measureFrozenPopulationGradient model gradient first first) -
            (second - stepSize • measureFrozenPopulationGradient model gradient second second)‖ ^ 2 =
          ‖displacement‖ ^ 2 - 2 * stepSize * ⟪displacement, gradientShift⟫_ℝ +
            stepSize ^ 2 * ‖gradientShift‖ ^ 2 := by
      rw [show (first - stepSize • measureFrozenPopulationGradient model gradient first first) -
          (second - stepSize • measureFrozenPopulationGradient model gradient second second) =
          displacement - stepSize • gradientShift by
            simp only [displacement, gradientShift, smul_sub]
            abel, norm_sub_sq_real, real_inner_smul_right, norm_smul,
        Real.norm_eq_abs, abs_of_nonneg hstepSize]
      ring
    rw [hexpand]
    nlinarith
  have hprojected :
      ‖project (first - stepSize • measureFrozenPopulationGradient model gradient first first) -
          project (second - stepSize • measureFrozenPopulationGradient model gradient second second)‖ ≤
        ‖(first - stepSize • measureFrozenPopulationGradient model gradient first first) -
          (second - stepSize • measureFrozenPopulationGradient model gradient second second)‖ := by
    simpa only [dist_eq_norm, NNReal.coe_one, one_mul] using
      hproject.dist_le_mul
        (first - stepSize • measureFrozenPopulationGradient model gradient first first)
        (second - stepSize • measureFrozenPopulationGradient model gradient second second)
  have hprojectedSq :
      ‖project (first - stepSize • measureFrozenPopulationGradient model gradient first first) -
          project (second - stepSize • measureFrozenPopulationGradient model gradient second second)‖ ^ 2 ≤
        ‖(first - stepSize • measureFrozenPopulationGradient model gradient first first) -
          (second - stepSize • measureFrozenPopulationGradient model gradient second second)‖ ^ 2 := by
    exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr hprojected
  simpa only [measureRepeatedGradientDescentUpdate] using hprojectedSq.trans hraw

/--
A fixed point of the arbitrary-law projected RGD update is performatively
stable on the projection domain.  The variational projection property is what
provides the constrained first-order inequality; nonexpansiveness alone is
used only in the contraction estimate above.
-/
theorem isMeasurePerformativelyStableOn_of_measureRepeatedGradientDescent_fixedPoint
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ}
    (hmodulus : 0 < modulus)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    (domain : Set Parameter) (project : Parameter → Parameter)
    (hproject : IsVariationalEuclideanProjectionOn domain project)
    (stepSize : ℝ) (hstepSize : 0 < stepSize) {parameter : Parameter}
    (hfixed : measureRepeatedGradientDescentUpdate model gradient project stepSize parameter = parameter) :
    IsMeasurePerformativelyStableOn model domain parameter := by
  have hfixed' : project
      (parameter - stepSize • measureFrozenPopulationGradient model gradient parameter parameter) =
        parameter := by
    simpa [measureRepeatedGradientDescentUpdate] using hfixed
  have hparameter : parameter ∈ domain := by
    rw [← hfixed']
    exact hproject.1 _
  refine ⟨hparameter, ?_⟩
  intro candidate hcandidate
  have hfirstOrder : 0 ≤ ⟪candidate - parameter,
      measureFrozenPopulationGradient model gradient parameter parameter⟫_ℝ := by
    rw [real_inner_comm]
    exact projectedGradient_fixedPoint_firstOrder domain project hproject
      (measureFrozenPopulationGradient model gradient parameter parameter) parameter stepSize hstepSize
      hfixed' candidate hcandidate
  have hlower := measureFrozenRisk_strongConvex_lowerBound model gradient hstrong hintegrable
    parameter parameter candidate
  have hquadratic : 0 ≤ modulus / 2 * ‖candidate - parameter‖ ^ 2 := by positivity
  change measureDecoupledPerformativeRisk model parameter parameter ≤
    measureDecoupledPerformativeRisk model parameter candidate
  nlinarith

/--
Conversely, a domain-stable arbitrary-law parameter is a fixed point of the
projected RGD update whenever the frozen-risk derivative representation is
available.  This is the second fixed-point/stability bridge used by Banach.
-/
theorem measureRepeatedGradientDescent_fixedPoint_of_isMeasurePerformativelyStableOn
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (project : Parameter → Parameter)
    (hproject : IsVariationalEuclideanProjectionOn domain project)
    (stepSize : ℝ) (hstepSize : 0 < stepSize) {parameter : Parameter}
    (hstable : IsMeasurePerformativelyStableOn model domain parameter) :
    measureRepeatedGradientDescentUpdate model gradient project stepSize parameter = parameter := by
  have hfirstOrder := isMeasureFrozenGradientFirstOrderOptimalOn_of_hasGradientAt
    model gradient domain hconvex parameter parameter hstable
    (hgradientAt parameter parameter)
  have hprojected := projectedGradient_fixedPoint_of_firstOrder domain project hproject
    (measureFrozenPopulationGradient model gradient parameter parameter) parameter hstable.1 stepSize hstepSize
    (fun candidate hcandidate => by
      have hfirst := hfirstOrder candidate hcandidate
      rw [real_inner_comm] at hfirst
      exact hfirst)
  simpa [measureRepeatedGradientDescentUpdate] using hprojected

/--
The stable-point-to-fixed-point bridge for projected RGD with the frozen-risk
derivative representation derived from the A1 joint-smoothness condition.
As elsewhere in the arbitrary-law layer, measurability of the loss family and
pointwise differentiability are explicit analytic premises rather than hidden
consequences of a gradient Lipschitz bound.
-/
theorem measureRepeatedGradientDescent_fixedPoint_of_isMeasurePerformativelyStableOn_of_A1
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (project : Parameter → Parameter)
    (hproject : IsVariationalEuclideanProjectionOn domain project)
    (stepSize : ℝ) (hstepSize : 0 < stepSize)
    (hloss_meas : ∀ distributionParameter evaluatedParameter,
      ∀ᶠ parameter in nhds evaluatedParameter,
        AEStronglyMeasurable (fun datum => model.loss datum parameter)
          (model.dataLaw distributionParameter : Measure Data))
    (hpointwise : ∀ datum parameter,
      HasGradientAt (fun theta => model.loss datum theta) (gradient datum parameter) parameter)
    {parameter : Parameter}
    (hstable : IsMeasurePerformativelyStableOn model domain parameter) :
    measureRepeatedGradientDescentUpdate model gradient project stepSize parameter = parameter := by
  apply measureRepeatedGradientDescent_fixedPoint_of_isMeasurePerformativelyStableOn
    model gradient
      (fun distributionParameter evaluatedParameter =>
        hasGradientAt_measureDecoupledPerformativeRisk_of_jointSmooth model gradient hjoint
          distributionParameter evaluatedParameter
          (hloss_meas distributionParameter evaluatedParameter)
          (hintegrable distributionParameter evaluatedParameter) hpointwise 1 (by norm_num))
      domain hconvex project hproject stepSize hstepSize hstable

/--
The complete A1/A2 population datum needed by the corrected RGD branch of
Theorem 3.10.  The explicit projection and differentiation hypotheses turn a
source-domain stable point into a fixed point, while the Theorem 3.8
interpolation calculation supplies the strict contraction used before and
after empirical perturbations.
-/
theorem rgd_theorem310PopulationData_of_A1_A2
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hsensitivity_nonneg : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (hmodulus_pos : 0 < modulus) (hmodulus_le : modulus ≤ (smoothness : ℝ))
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (project : Parameter → Parameter) (hproject : IsVariationalEuclideanProjectionOn domain project)
    (hproject_nonexpansive : LipschitzWith 1 project)
    (stepSize : ℝ) (hstepSize_pos : 0 < stepSize)
    (hstepSize_le : stepSize ≤ 2 / (modulus + (smoothness : ℝ)))
    (hsensitivity_small : sensitivity < modulus /
      ((modulus + (smoothness : ℝ)) * (1 + (3 / 2) * stepSize * (smoothness : ℝ))))
    (hloss_meas : ∀ distributionParameter evaluatedParameter,
      ∀ᶠ parameter in nhds evaluatedParameter,
        AEStronglyMeasurable (fun datum => model.loss datum parameter)
          (model.dataLaw distributionParameter : Measure Data))
    (hpointwise : ∀ datum parameter,
      HasGradientAt (fun theta => model.loss datum theta) (gradient datum parameter) parameter)
    (stable : Parameter) (hstable : IsMeasurePerformativelyStableOn model domain stable) :
    (0 ≤ 1 - stepSize * (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
      sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ))) ∧
      1 - stepSize * (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
        sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ))) < 1) ∧
      measureRepeatedGradientDescentUpdate model gradient project stepSize stable = stable ∧
      ∀ parameter,
        dist (measureRepeatedGradientDescentUpdate model gradient project stepSize parameter)
          (measureRepeatedGradientDescentUpdate model gradient project stepSize stable) ≤
          (1 - stepSize * (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
            sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ)))) *
            dist parameter stable := by
  let contractionGap := modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
    sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ))
  have hgap := rgd_contractionGap_pos_and_step_mul_le_half hsensitivity_nonneg hmodulus_pos
    hmodulus_le hstepSize_pos.le hstepSize_le hsensitivity_small
  have hgap' : 0 < contractionGap ∧ stepSize * contractionGap ≤ 1 / 2 := by
    simpa [contractionGap] using hgap
  have hfactor_nonneg : 0 ≤ 1 - stepSize * contractionGap := by linarith [hgap'.2]
  have hfactor_lt : 1 - stepSize * contractionGap < 1 := by
    have hproduct_pos : 0 < stepSize * contractionGap := mul_pos hstepSize_pos hgap'.1
    linarith
  refine ⟨?_, ?_, ?_⟩
  · exact ⟨by simpa [contractionGap] using hfactor_nonneg,
      by simpa [contractionGap] using hfactor_lt⟩
  · exact measureRepeatedGradientDescent_fixedPoint_of_isMeasurePerformativelyStableOn_of_A1
      model gradient hjoint hintegrable domain hconvex project hproject stepSize hstepSize_pos
        hloss_meas hpointwise hstable
  · intro parameter
    simpa [contractionGap] using
      (dist_measureRepeatedGradientDescentUpdate_sub_le_of_A1_A2_wassersteinSensitive
        model gradient hjoint hintegrable hsensitivity_nonneg hsensitive hmodulus_pos hmodulus_le
          hstrong project hproject_nonexpansive stepSize hstepSize_pos.le hstepSize_le
          hsensitivity_small hloss_meas hpointwise parameter stable)

/--
Banach's fixed-point conclusion for arbitrary-law projected RGD on a complete
convex domain.  The analytic contraction certificate is kept separate so it
can be supplied by either the conservative bound above or the sharper PZ
interpolation calculation.
-/
theorem contracting_measureRepeatedGradientDescent_has_unique_stablePoint_on
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    (domain : Set Parameter) (hcomplete : IsComplete domain) (hnonempty : domain.Nonempty)
    (hconvex : Convex ℝ domain) (project : Parameter → Parameter)
    (hproject : IsVariationalEuclideanProjectionOn domain project)
    (stepSize : ℝ) (hstepSize : 0 < stepSize)
    (hmaps : Set.MapsTo (measureRepeatedGradientDescentUpdate model gradient project stepSize)
      domain domain)
    {factor : NNReal}
    (hcontract : ContractingWith factor
      (restrictedUpdate domain (measureRepeatedGradientDescentUpdate model gradient project stepSize) hmaps)) :
    ∃ parameter, parameter ∈ domain ∧ IsMeasurePerformativelyStableOn model domain parameter ∧
      ∀ other, other ∈ domain → IsMeasurePerformativelyStableOn model domain other → other = parameter := by
  letI : Nonempty domain := Set.nonempty_coe_sort.mpr hnonempty
  letI : CompleteSpace domain := hcomplete.completeSpace_coe
  let fixed : domain := hcontract.fixedPoint _
  refine ⟨fixed, fixed.2, ?_, ?_⟩
  · apply isMeasurePerformativelyStableOn_of_measureRepeatedGradientDescent_fixedPoint
      model gradient hmodulus hstrong hintegrable domain project hproject stepSize hstepSize
    have hfixed := hcontract.fixedPoint_isFixedPt
    exact by
      simpa [fixed, restrictedUpdate] using congrArg Subtype.val hfixed
  · intro other hother hstable
    have hotherFixed := measureRepeatedGradientDescent_fixedPoint_of_isMeasurePerformativelyStableOn
      model gradient hgradientAt domain hconvex project hproject stepSize hstepSize hstable
    have hotherFixedRestricted : Function.IsFixedPt
        (restrictedUpdate domain (measureRepeatedGradientDescentUpdate model gradient project stepSize) hmaps)
        ⟨other, hother⟩ := by
      apply Subtype.ext
      simpa [restrictedUpdate] using hotherFixed
    have hequal : (⟨other, hother⟩ : domain) = fixed :=
      hcontract.fixedPoint_unique hotherFixedRestricted
    exact congrArg Subtype.val hequal

/--
The Proposition 4.2 loss gradient is jointly `2`-smooth on its finite binary
data encoding.  The data-coordinate calculation is by the four literal
feature/label cases; the parameter-coordinate calculation is above.
-/
theorem proposition42Gradient_jointSmooth :
    IsJointlySmoothGradient proposition42Gradient 2 := by
  refine ⟨?_, ?_⟩
  · intro datum first second
    rw [show proposition42Gradient datum first - proposition42Gradient datum second =
      2 * (first - second) by
        exact proposition42Gradient_parameterDifference datum first second]
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2),
      Real.norm_eq_abs]
    norm_num
  · intro first second parameter
    rcases first with ⟨firstFeature, firstLabel⟩
    rcases second with ⟨secondFeature, secondLabel⟩
    fin_cases firstFeature <;> fin_cases firstLabel <;>
      fin_cases secondFeature <;> fin_cases secondLabel <;>
      simp [proposition42Gradient, Prod.dist_eq, proposition42Bool_dist] <;>
        ring_nf <;> norm_num

/--
Pairing a data-Lipschitz gradient with a fixed parameter displacement gives a
real Lipschitz test function.  This is the Cauchy--Schwarz step in the proof of
Theorem 3.5 of Perdomo--Zrnic--Mendler-Dünner--Hardt (2020).
-/
theorem gradientPairing_lipschitz
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MetricSpace Data]
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hsmooth : IsDataGradientLipschitz gradient smoothness)
    (displacement parameter : Parameter) :
    LipschitzWith (smoothness * ‖displacement‖₊)
      (fun datum => ⟪displacement, gradient datum parameter⟫_ℝ) := by
  refine LipschitzWith.of_dist_le_mul ?_
  intro first second
  rw [Real.dist_eq]
  calc
    |⟪displacement, gradient first parameter⟫_ℝ -
        ⟪displacement, gradient second parameter⟫_ℝ|
        = |⟪displacement, gradient first parameter - gradient second parameter⟫_ℝ| := by
      rw [inner_sub_right]
    _ ≤ ‖displacement‖ * ‖gradient first parameter - gradient second parameter‖ :=
      abs_real_inner_le_norm _ _
    _ ≤ ‖displacement‖ * ((smoothness : ℝ) * dist first second) := by
      exact mul_le_mul_of_nonneg_left (hsmooth first second parameter)
        (norm_nonneg displacement)
    _ = ((smoothness * ‖displacement‖₊ : NNReal) : ℝ) * dist first second := by
      simp [mul_assoc, mul_left_comm]

/--
The expected gradient pairing at a frozen data law.  In the PZ proof this is
the scalar quantity compared across two induced distributions.
-/
noncomputable def frozenGradientPairing {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (distributionParameter evaluatedParameter displacement : Parameter) : ℝ :=
  pmfExp (model.dataLaw distributionParameter)
    (fun datum => ⟪displacement, gradient datum evaluatedParameter⟫_ℝ)

/-- The pointwise first-order form of the source's `γ`-strong-convexity assumption. -/
def IsPointwiseGradientStronglyConvex {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (modulus : ℝ) : Prop :=
  ∀ datum center candidate,
    model.loss datum candidate ≥
    model.loss datum center +
        ⟪gradient datum center, candidate - center⟫_ℝ +
          modulus / 2 * ‖candidate - center‖ ^ 2

/-- The linear loss is convex, as required in Proposition 3.6(a). -/
theorem proposition36aLoss_convexOn (datum : Bool) :
    ConvexOn ℝ Set.univ (fun theta : ℝ => proposition36aLoss datum theta) := by
  cases datum
  · refine ⟨convex_univ, ?_⟩
    intro first _ second _ weightFirst weightSecond _ _ _
    simp [proposition36aLoss, smul_eq_mul]
  · exact convexOn_id convex_univ

/-- The source's linear gradient is jointly `2`-smooth in the finite binary encoding. -/
theorem proposition36aGradient_jointSmooth :
    IsJointlySmoothGradient proposition36aGradient 2 := by
  refine ⟨?_, ?_⟩
  · intro datum first second
    simp [proposition36aGradient]
  · intro first second _parameter
    fin_cases first <;> fin_cases second <;>
      simp [proposition36aGradient, proposition42Bool_dist] <;> norm_num

/-- No positive modulus makes the source's linear loss pointwise strongly convex. -/
theorem proposition36a_not_pointwiseGradientStronglyConvex {modulus : ℝ}
    (hmodulus : 0 < modulus) :
    ¬ IsPointwiseGradientStronglyConvex proposition36aModel proposition36aGradient modulus := by
  intro hstrong
  have h := hstrong true 0 1
  simp [proposition36aModel, proposition36aLoss, proposition36aGradient] at h
  linarith

/--
The expected strong-convexity lower bound obtained by averaging the pointwise
assumption under any finite frozen data law.
-/
theorem frozenRisk_strongConvex_lowerBound
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ}
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (distributionParameter center candidate : Parameter) :
    decoupledPerformativeRisk model distributionParameter candidate ≥
      decoupledPerformativeRisk model distributionParameter center +
        frozenGradientPairing model gradient distributionParameter center (candidate - center) +
          modulus / 2 * ‖candidate - center‖ ^ 2 := by
  unfold decoupledPerformativeRisk frozenGradientPairing
  calc
    pmfExp (model.dataLaw distributionParameter) (fun datum => model.loss datum candidate)
        ≥ pmfExp (model.dataLaw distributionParameter)
          (fun datum => model.loss datum center +
            (⟪gradient datum center, candidate - center⟫_ℝ +
              modulus / 2 * ‖candidate - center‖ ^ 2)) :=
      pmfExp_le_pmfExp_of_forall_le _ _ _ (fun datum => by
        simpa [add_assoc] using hstrong datum center candidate)
    _ = pmfExp (model.dataLaw distributionParameter) (fun datum => model.loss datum center) +
          pmfExp (model.dataLaw distributionParameter)
            (fun datum => ⟪candidate - center, gradient datum center⟫_ℝ) +
          modulus / 2 * ‖candidate - center‖ ^ 2 := by
      rw [pmfExp_add, pmfExp_add, pmfExp_const]
      have hpair :
          pmfExp (model.dataLaw distributionParameter)
              (fun datum => ⟪gradient datum center, candidate - center⟫_ℝ) =
            pmfExp (model.dataLaw distributionParameter)
              (fun datum => ⟪candidate - center, gradient datum center⟫_ℝ) :=
        pmfExp_congr _ (fun datum => real_inner_comm _ _)
      rw [hpair]
      ring

/--
The first-order variational inequality at a frozen-law minimizer.  For a
differentiable convex objective on a closed convex parameter set, this is the
condition supplied by the source's Lemma D.1.
-/
def IsFrozenFirstOrderOptimal {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (distributionParameter minimizer : Parameter) : Prop :=
  ∀ candidate,
    0 ≤ frozenGradientPairing model gradient distributionParameter minimizer
      (candidate - minimizer)

/-- The finite expected gradient of loss under a frozen induced data law. -/
noncomputable def frozenPopulationGradient {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (distributionParameter evaluatedParameter : Parameter) : Parameter :=
  ∑ datum, (model.dataLaw distributionParameter datum).toReal • gradient datum evaluatedParameter

/--
Differentiating a finite frozen risk commutes with its finite expectation. This
is the unconstrained calculus bridge behind the source's first-order lemma.
-/
theorem hasGradientAt_decoupledPerformativeRisk
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradient : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    (distributionParameter evaluatedParameter : Parameter) :
    HasGradientAt
      (fun parameter => decoupledPerformativeRisk model distributionParameter parameter)
      (frozenPopulationGradient model gradient distributionParameter evaluatedParameter)
      evaluatedParameter := by
  have hsum :
      HasFDerivAt
        (fun parameter => ∑ datum,
          (model.dataLaw distributionParameter datum).toReal * model.loss datum parameter)
        (∑ datum, (model.dataLaw distributionParameter datum).toReal •
          (InnerProductSpace.toDual ℝ Parameter) (gradient datum evaluatedParameter))
        evaluatedParameter := by
    apply HasFDerivAt.fun_sum
    intro datum _
    simpa [smul_eq_mul] using
      (hgradient datum evaluatedParameter).hasFDerivAt.const_smul
        ((model.dataLaw distributionParameter datum).toReal)
  rw [hasGradientAt_iff_hasFDerivAt]
  simpa [decoupledPerformativeRisk, pmfExp, frozenPopulationGradient] using hsum

/-- Pairing with the finite expected gradient is the expected gradient pairing. -/
theorem frozenGradientPairing_eq_inner_frozenPopulationGradient
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (distributionParameter evaluatedParameter displacement : Parameter) :
    frozenGradientPairing model gradient distributionParameter evaluatedParameter displacement =
      ⟪displacement,
        frozenPopulationGradient model gradient distributionParameter evaluatedParameter⟫_ℝ := by
  unfold frozenGradientPairing frozenPopulationGradient pmfExp
  calc
    ∑ datum : Data,
        (model.dataLaw distributionParameter datum).toReal *
          ⟪displacement, gradient datum evaluatedParameter⟫_ℝ =
        ∑ datum : Data,
          ⟪displacement,
            (model.dataLaw distributionParameter datum).toReal • gradient datum evaluatedParameter⟫_ℝ := by
      refine Finset.sum_congr rfl ?_
      intro datum _
      rw [real_inner_smul_right]
    _ = ⟪displacement,
          ∑ datum : Data,
            (model.dataLaw distributionParameter datum).toReal • gradient datum evaluatedParameter⟫_ℝ := by
      rw [inner_sum]

/--
For an unconstrained finite parameter space, Fermat's theorem turns the
finite expected-loss gradient into the first-order condition used by RRM.
-/
theorem isFrozenFirstOrderOptimal_of_hasGradientAt_univ
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradient : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    (distributionParameter minimizer : Parameter)
    (hminimizer : ∀ candidate,
      decoupledPerformativeRisk model distributionParameter minimizer ≤
        decoupledPerformativeRisk model distributionParameter candidate) :
    IsFrozenFirstOrderOptimal model gradient distributionParameter minimizer := by
  have hlocal : IsLocalMin
      (fun parameter => decoupledPerformativeRisk model distributionParameter parameter) minimizer := by
    apply IsMinOn.isLocalMin (s := Set.univ)
    · intro candidate _
      exact hminimizer candidate
    · simp
  have hderivative := hasGradientAt_decoupledPerformativeRisk model gradient hgradient
    distributionParameter minimizer
  have hfrechet_zero :
      (InnerProductSpace.toDual ℝ Parameter)
        (frozenPopulationGradient model gradient distributionParameter minimizer) = 0 :=
    hlocal.hasFDerivAt_eq_zero hderivative.hasFDerivAt
  have hgradient_zero :
      frozenPopulationGradient model gradient distributionParameter minimizer = 0 := by
    apply (InnerProductSpace.toDual ℝ Parameter).injective
    simpa using hfrechet_zero
  intro candidate
  rw [frozenGradientPairing_eq_inner_frozenPopulationGradient, hgradient_zero]
  simp

/--
On a convex parameter domain, the tangent-cone form of Fermat's theorem gives
the variational first-order condition at any frozen-risk minimizer.
-/
theorem isFrozenFirstOrderOptimal_on_of_hasGradientAt
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradient : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (distributionParameter minimizer : Parameter)
    (hminimizer : IsPopulationRiskMinimizerOn model domain
      (model.dataLaw distributionParameter) minimizer) :
    minimizer ∈ domain ∧ ∀ candidate ∈ domain,
      0 ≤ frozenGradientPairing model gradient distributionParameter minimizer
        (candidate - minimizer) := by
  refine ⟨hminimizer.1, ?_⟩
  intro candidate hcandidate
  have hminOn : IsMinOn
      (fun parameter => decoupledPerformativeRisk model distributionParameter parameter)
      domain minimizer := by
    intro alternative halternative
    exact hminimizer.2 alternative halternative
  have htangent : candidate - minimizer ∈ posTangentConeAt domain minimizer :=
    sub_mem_posTangentConeAt_of_segment_subset
      (hconvex.segment_subset hminimizer.1 hcandidate)
  have hderivative := hasGradientAt_decoupledPerformativeRisk model gradient hgradient
    distributionParameter minimizer
  have hnonneg :
      0 ≤ (InnerProductSpace.toDual ℝ Parameter)
        (frozenPopulationGradient model gradient distributionParameter minimizer)
        (candidate - minimizer) :=
    hminOn.localize.hasFDerivWithinAt_nonneg hderivative.hasFDerivAt.hasFDerivWithinAt htangent
  rw [InnerProductSpace.toDual_apply_apply] at hnonneg
  rw [frozenGradientPairing_eq_inner_frozenPopulationGradient, real_inner_comm]
  exact hnonneg

/--
On a convex parameter domain, a frozen-law minimizer with its variational
first-order inequality is unique under positive pointwise strong convexity.
This is the uniqueness ingredient in the stable-point conclusion of repeated
risk minimization.
-/
theorem populationRiskMinimizerOn_unique_of_strongConvex_firstOrder
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (deployed first second : Parameter)
    (hfirst : IsPopulationRiskMinimizerOn model domain (model.dataLaw deployed) first)
    (hsecond : IsPopulationRiskMinimizerOn model domain (model.dataLaw deployed) second)
    (hfirstOrder : ∀ candidate ∈ domain,
      0 ≤ frozenGradientPairing model gradient deployed first (candidate - first)) :
    first = second := by
  have hminimum := hsecond.2 first hfirst.1
  change decoupledPerformativeRisk model deployed second ≤
    decoupledPerformativeRisk model deployed first at hminimum
  have hlower := frozenRisk_strongConvex_lowerBound model gradient hstrong deployed first second
  have hnonneg := hfirstOrder second hsecond.1
  have hsq_nonpos : ‖second - first‖ ^ 2 ≤ 0 := by
    nlinarith
  have hsq_zero : ‖second - first‖ ^ 2 = 0 :=
    le_antisymm hsq_nonpos (sq_nonneg _)
  have hnorm_zero : ‖second - first‖ = 0 := (sq_eq_zero_iff).mp hsq_zero
  exact (sub_eq_zero.mp (norm_eq_zero.mp hnorm_zero)).symm

/--
Finite transport sensitivity controls the change in a frozen gradient pairing
when the data law changes but the evaluation parameter is held fixed.
-/
theorem abs_frozenGradientPairing_sub_le_of_finiteTransportSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness) {sensitivity : ℝ}
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (displacement evaluated first second : Parameter) :
    |frozenGradientPairing model gradient first evaluated displacement -
        frozenGradientPairing model gradient second evaluated displacement| ≤
      ((smoothness * ‖displacement‖₊ : NNReal) : ℝ) *
        (sensitivity * dist first second) := by
  unfold frozenGradientPairing
  exact abs_pmfExp_dataLaw_sub_le_of_finiteTransportSensitive model hsensitive
    (gradientPairing_lipschitz gradient hgradient displacement evaluated) first second

/--
Finite-W₁ sensitivity controls the change in a frozen gradient pairing when
the evaluation parameter is held fixed.  This is the finite-PMF realization of
the Kantorovich--Rubinstein substep in Appendix E.1.
-/
theorem abs_frozenGradientPairing_sub_le_of_finiteWassersteinSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness) {sensitivity : ℝ}
    (hsensitive : IsFiniteWassersteinSensitive model sensitivity)
    (displacement evaluated first second : Parameter) :
    |frozenGradientPairing model gradient first evaluated displacement -
        frozenGradientPairing model gradient second evaluated displacement| ≤
      ((smoothness * ‖displacement‖₊ : NNReal) : ℝ) *
        (sensitivity * dist first second) := by
  unfold frozenGradientPairing
  exact abs_pmfExp_dataLaw_sub_le_of_finiteWassersteinSensitive model hsensitive
    (gradientPairing_lipschitz gradient hgradient displacement evaluated) first second

/--
Finite-PMF vector transport bound for an expected loss gradient.  This is the
finite primal counterpart of Appendix D.4: data-Lipschitz gradients have
Lipschitz expectations under the induced distribution map.
-/
theorem norm_frozenPopulationGradient_sub_le_of_finiteTransportSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness) {sensitivity : ℝ}
    (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (evaluated first second : Parameter) :
    ‖frozenPopulationGradient model gradient first evaluated -
        frozenPopulationGradient model gradient second evaluated‖ ≤
      (smoothness : ℝ) * (sensitivity * dist first second) := by
  let displacement := frozenPopulationGradient model gradient first evaluated -
    frozenPopulationGradient model gradient second evaluated
  have htransport := abs_frozenGradientPairing_sub_le_of_finiteTransportSensitive
    model gradient hgradient hsensitive displacement evaluated first second
  have hpair :
      frozenGradientPairing model gradient first evaluated displacement -
          frozenGradientPairing model gradient second evaluated displacement =
        ⟪displacement,
          frozenPopulationGradient model gradient first evaluated -
            frozenPopulationGradient model gradient second evaluated⟫_ℝ := by
    rw [frozenGradientPairing_eq_inner_frozenPopulationGradient,
      frozenGradientPairing_eq_inner_frozenPopulationGradient, ← inner_sub_right]
  have hquadratic :
      ‖displacement‖ ^ 2 ≤
        ((smoothness * ‖displacement‖₊ : NNReal) : ℝ) *
          (sensitivity * dist first second) := by
    rw [hpair, show (frozenPopulationGradient model gradient first evaluated -
        frozenPopulationGradient model gradient second evaluated) = displacement by rfl,
      real_inner_self_eq_norm_sq, abs_of_nonneg (sq_nonneg _)] at htransport
    exact htransport
  have hcoefficient_nonneg :
      0 ≤ (smoothness : ℝ) * (sensitivity * dist first second) := by positivity
  have hnorm : ((smoothness * ‖displacement‖₊ : NNReal) : ℝ) =
      (smoothness : ℝ) * ‖displacement‖ := by simp
  rw [hnorm] at hquadratic
  by_cases hzero : ‖displacement‖ = 0
  · rw [hzero]
    exact hcoefficient_nonneg
  · have hpositive : 0 < ‖displacement‖ :=
      lt_of_le_of_ne (norm_nonneg _) (Ne.symm hzero)
    apply le_of_mul_le_mul_right _ hpositive
    calc
      ‖displacement‖ * ‖displacement‖ = ‖displacement‖ ^ 2 := by ring
      _ ≤ ((smoothness : ℝ) * (sensitivity * dist first second)) * ‖displacement‖ := by
        convert hquadratic using 1
        all_goals ring

/--
Finite-W₁ sensitivity controls the expected-gradient shift.  It is the vector
form of the finite Kantorovich--Rubinstein bridge needed by the PZ contraction
and projected-RGD arguments.
-/
theorem norm_frozenPopulationGradient_sub_le_of_finiteWassersteinSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness) {sensitivity : ℝ}
    (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteWassersteinSensitive model sensitivity)
    (evaluated first second : Parameter) :
    ‖frozenPopulationGradient model gradient first evaluated -
        frozenPopulationGradient model gradient second evaluated‖ ≤
      (smoothness : ℝ) * (sensitivity * dist first second) := by
  let displacement := frozenPopulationGradient model gradient first evaluated -
    frozenPopulationGradient model gradient second evaluated
  have htransport := abs_frozenGradientPairing_sub_le_of_finiteWassersteinSensitive
    model gradient hgradient hsensitive displacement evaluated first second
  have hpair :
      frozenGradientPairing model gradient first evaluated displacement -
          frozenGradientPairing model gradient second evaluated displacement =
        ⟪displacement,
          frozenPopulationGradient model gradient first evaluated -
            frozenPopulationGradient model gradient second evaluated⟫_ℝ := by
    rw [frozenGradientPairing_eq_inner_frozenPopulationGradient,
      frozenGradientPairing_eq_inner_frozenPopulationGradient, ← inner_sub_right]
  have hquadratic :
      ‖displacement‖ ^ 2 ≤
        ((smoothness * ‖displacement‖₊ : NNReal) : ℝ) *
          (sensitivity * dist first second) := by
    rw [hpair, show (frozenPopulationGradient model gradient first evaluated -
        frozenPopulationGradient model gradient second evaluated) = displacement by rfl,
      real_inner_self_eq_norm_sq, abs_of_nonneg (sq_nonneg _)] at htransport
    exact htransport
  have hcoefficient_nonneg :
      0 ≤ (smoothness : ℝ) * (sensitivity * dist first second) := by positivity
  have hnorm : ((smoothness * ‖displacement‖₊ : NNReal) : ℝ) =
      (smoothness : ℝ) * ‖displacement‖ := by simp
  rw [hnorm] at hquadratic
  by_cases hzero : ‖displacement‖ = 0
  · rw [hzero]
    exact hcoefficient_nonneg
  · have hpositive : 0 < ‖displacement‖ :=
      lt_of_le_of_ne (norm_nonneg _) (Ne.symm hzero)
    apply le_of_mul_le_mul_right _ hpositive
    calc
      ‖displacement‖ * ‖displacement‖ = ‖displacement‖ ^ 2 := by ring
      _ ≤ ((smoothness : ℝ) * (sensitivity * dist first second)) * ‖displacement‖ := by
        convert hquadratic using 1
        all_goals ring

/--
A finite expected gradient inherits the parameter-coordinate Lipschitz bound
of each pointwise gradient.  This is the fixed-law part of the gradient split
used by repeated gradient descent.
-/
theorem norm_frozenPopulationGradient_parameter_sub_le_of_gradientLipschitz
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : ∀ datum first second,
      ‖gradient datum first - gradient datum second‖ ≤
        (smoothness : ℝ) * ‖first - second‖)
    (distributionParameter first second : Parameter) :
    ‖frozenPopulationGradient model gradient distributionParameter first -
        frozenPopulationGradient model gradient distributionParameter second‖ ≤
      (smoothness : ℝ) * ‖first - second‖ := by
  calc
    ‖frozenPopulationGradient model gradient distributionParameter first -
        frozenPopulationGradient model gradient distributionParameter second‖ =
        ‖∑ datum, (model.dataLaw distributionParameter datum).toReal •
          (gradient datum first - gradient datum second)‖ := by
      simp [frozenPopulationGradient, Finset.sum_sub_distrib, smul_sub]
    _ ≤ ∑ datum, ‖(model.dataLaw distributionParameter datum).toReal •
          (gradient datum first - gradient datum second)‖ :=
      norm_sum_le Finset.univ _
    _ = ∑ datum, (model.dataLaw distributionParameter datum).toReal *
          ‖gradient datum first - gradient datum second‖ := by
      refine Finset.sum_congr rfl ?_
      intro datum _
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
    _ ≤ ∑ datum, (model.dataLaw distributionParameter datum).toReal *
          ((smoothness : ℝ) * ‖first - second‖) := by
      apply Finset.sum_le_sum
      intro datum _
      exact mul_le_mul_of_nonneg_left (hgradient datum first second) ENNReal.toReal_nonneg
    _ = (smoothness : ℝ) * ‖first - second‖ := by
      exact pmfExp_const (model.dataLaw distributionParameter)
        ((smoothness : ℝ) * ‖first - second‖)

/--
The expected gradient of a pointwise strongly convex loss is strongly monotone
at every frozen data law.  This is the strong-convexity component of the
repeated-gradient-descent calculation.
-/
theorem frozenPopulationGradient_strongMonotone
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ}
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (distributionParameter first second : Parameter) :
    modulus * ‖first - second‖ ^ 2 ≤
      ⟪first - second,
        frozenPopulationGradient model gradient distributionParameter first -
          frozenPopulationGradient model gradient distributionParameter second⟫_ℝ := by
  have hleft := frozenRisk_strongConvex_lowerBound model gradient hstrong distributionParameter
    first second
  have hright := frozenRisk_strongConvex_lowerBound model gradient hstrong distributionParameter
    second first
  rw [norm_sub_rev] at hleft
  have hpairs :
      frozenGradientPairing model gradient distributionParameter first (second - first) +
          frozenGradientPairing model gradient distributionParameter second (first - second) =
        -⟪first - second,
          frozenPopulationGradient model gradient distributionParameter first -
            frozenPopulationGradient model gradient distributionParameter second⟫_ℝ := by
    rw [frozenGradientPairing_eq_inner_frozenPopulationGradient,
      frozenGradientPairing_eq_inner_frozenPopulationGradient,
      show second - first = -(first - second) by abel, inner_neg_left, inner_sub_right]
    ring
  nlinarith

/--
At every frozen data law, a positive-smoothness pointwise convex loss has a
cocoercive expected gradient.  This finite-expectation theorem packages the
smooth-convex portion of the interpolation calculation used by first-order
performative algorithms.
-/
theorem frozenPopulationGradient_cocoercive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hsmoothness : 0 < (smoothness : ℝ))
    (hgradient : ∀ datum first second,
      ‖gradient datum first - gradient datum second‖ ≤
        (smoothness : ℝ) * ‖first - second‖)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    {modulus : ℝ} (hmodulus : 0 ≤ modulus)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (distributionParameter first second : Parameter) :
    (1 / (smoothness : ℝ)) *
        ‖frozenPopulationGradient model gradient distributionParameter first -
          frozenPopulationGradient model gradient distributionParameter second‖ ^ 2 ≤
      ⟪frozenPopulationGradient model gradient distributionParameter first -
          frozenPopulationGradient model gradient distributionParameter second,
        first - second⟫_ℝ := by
  apply gradient_cocoercive_of_smooth_firstOrder
    (f := fun parameter => decoupledPerformativeRisk model distributionParameter parameter)
    (gradient := frozenPopulationGradient model gradient distributionParameter)
    (smoothness := (smoothness : ℝ)) hsmoothness
  · intro left right
    exact norm_frozenPopulationGradient_parameter_sub_le_of_gradientLipschitz
      model gradient hgradient distributionParameter left right
  · intro parameter
    exact hasGradientAt_decoupledPerformativeRisk model gradient hgradientAt distributionParameter
      parameter
  · intro center candidate
    have hlower := frozenRisk_strongConvex_lowerBound model gradient hstrong distributionParameter
      center candidate
    rw [frozenGradientPairing_eq_inner_frozenPopulationGradient] at hlower
    rw [real_inner_comm] at hlower
    have hquadratic : 0 ≤ modulus / 2 * ‖candidate - center‖ ^ 2 := by positivity
    linarith

/--
The pointwise Appendix D.2 interpolation bound for a performative loss,
including the `modulus = smoothness` boundary used by Theorem 3.8.
-/
theorem pointwiseGradient_interpolation_of_jointSmooth
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    {modulus : ℝ} (hmodulus : 0 < modulus) (hmodulus_le : modulus ≤ (smoothness : ℝ))
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (datum : Data) (first second : Parameter) :
    (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) *
        ‖first - second‖ ^ 2 +
      (1 / (modulus + (smoothness : ℝ))) *
        ‖gradient datum first - gradient datum second‖ ^ 2 ≤
      ⟪gradient datum first - gradient datum second, first - second⟫_ℝ := by
  rcases lt_or_eq_of_le hmodulus_le with hmodulus_lt | hmodulus_eq
  · exact smooth_strong_interpolation_of_firstOrder
      (fun parameter => model.loss datum parameter) (gradient datum)
      (smoothness : ℝ) modulus hmodulus hmodulus_lt
      (hjoint.1 datum) (hgradientAt datum) (hstrong datum) first second
  · subst modulus
    have hboundary := smooth_strong_interpolation_eq_of_firstOrder
      (fun parameter => model.loss datum parameter) (gradient datum) (smoothness : ℝ)
      hmodulus (hjoint.1 datum) (hstrong datum) first second
    have hquadraticCoefficient :
        (smoothness : ℝ) * (smoothness : ℝ) /
          ((smoothness : ℝ) + (smoothness : ℝ)) = (smoothness : ℝ) / 2 := by
      field_simp
      ring
    have hgradientCoefficient :
        1 / ((smoothness : ℝ) + (smoothness : ℝ)) = 1 / (2 * (smoothness : ℝ)) := by
      ring
    rw [hquadraticCoefficient, hgradientCoefficient]
    exact hboundary

/-- A frozen expected gradient difference is a finite vector expectation. -/
theorem frozenPopulationGradient_sub_eq_pmfVectorExp
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (distributionParameter first second : Parameter) :
    frozenPopulationGradient model gradient distributionParameter first -
        frozenPopulationGradient model gradient distributionParameter second =
      pmfVectorExp (model.dataLaw distributionParameter)
        (fun datum => gradient datum first - gradient datum second) := by
  simp only [frozenPopulationGradient, pmfVectorExp, Finset.sum_sub_distrib, smul_sub]

/-- Finite-PMF vector Jensen inequality for a frozen gradient difference. -/
theorem sq_norm_frozenPopulationGradient_sub_le_pmfExp_sq_norm
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (distributionParameter first second : Parameter) :
    ‖frozenPopulationGradient model gradient distributionParameter first -
        frozenPopulationGradient model gradient distributionParameter second‖ ^ 2 ≤
      pmfExp (model.dataLaw distributionParameter)
        (fun datum => ‖gradient datum first - gradient datum second‖ ^ 2) := by
  rw [frozenPopulationGradient_sub_eq_pmfVectorExp]
  exact sq_norm_pmfVectorExp_le_pmfExp_sq_norm _ _

/-- Averaging a pointwise gradient difference commutes with its pairing. -/
theorem pmfExp_inner_gradientDifference_eq_frozenPopulationGradient
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (distributionParameter first second displacement : Parameter) :
    pmfExp (model.dataLaw distributionParameter)
      (fun datum => ⟪gradient datum first - gradient datum second, displacement⟫_ℝ) =
      ⟪frozenPopulationGradient model gradient distributionParameter first -
        frozenPopulationGradient model gradient distributionParameter second, displacement⟫_ℝ := by
  rw [frozenPopulationGradient_sub_eq_pmfVectorExp]
  simp only [pmfExp, pmfVectorExp]
  rw [sum_inner]
  simp only [real_inner_smul_left]

/--
The frozen-law form of Appendix D.2, including `modulus = smoothness`.  It
combines the pointwise interpolation inequality with finite vector Jensen.
-/
theorem frozenPopulationGradient_interpolation_of_jointSmooth
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    {modulus : ℝ} (hmodulus : 0 < modulus) (hmodulus_le : modulus ≤ (smoothness : ℝ))
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (distributionParameter first second : Parameter) :
    (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) *
        ‖first - second‖ ^ 2 +
      (1 / (modulus + (smoothness : ℝ))) *
        ‖frozenPopulationGradient model gradient distributionParameter first -
          frozenPopulationGradient model gradient distributionParameter second‖ ^ 2 ≤
      ⟪frozenPopulationGradient model gradient distributionParameter first -
          frozenPopulationGradient model gradient distributionParameter second,
        first - second⟫_ℝ := by
  have hpoint : ∀ datum,
      (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) *
          ‖first - second‖ ^ 2 +
        (1 / (modulus + (smoothness : ℝ))) *
          ‖gradient datum first - gradient datum second‖ ^ 2 ≤
        ⟪gradient datum first - gradient datum second, first - second⟫_ℝ := fun datum =>
    pointwiseGradient_interpolation_of_jointSmooth model gradient hjoint hgradientAt hmodulus
      hmodulus_le hstrong datum first second
  have havg := pmfExp_le_pmfExp_of_forall_le (model.dataLaw distributionParameter) _ _ hpoint
  simp only [pmfExp_add, pmfExp_const, pmfExp_const_mul] at havg
  rw [pmfExp_inner_gradientDifference_eq_frozenPopulationGradient model gradient
    distributionParameter first second (first - second)] at havg
  have hjensen := sq_norm_frozenPopulationGradient_sub_le_pmfExp_sq_norm
    model gradient distributionParameter first second
  have hcoefficient : 0 ≤ 1 / (modulus + (smoothness : ℝ)) := by positivity
  calc
    (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) *
        ‖first - second‖ ^ 2 +
      (1 / (modulus + (smoothness : ℝ))) *
        ‖frozenPopulationGradient model gradient distributionParameter first -
          frozenPopulationGradient model gradient distributionParameter second‖ ^ 2 ≤
        (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) *
          ‖first - second‖ ^ 2 +
        (1 / (modulus + (smoothness : ℝ))) *
          pmfExp (model.dataLaw distributionParameter)
            (fun datum => ‖gradient datum first - gradient datum second‖ ^ 2) := by
          gcongr
    _ ≤ ⟪frozenPopulationGradient model gradient distributionParameter first -
          frozenPopulationGradient model gradient distributionParameter second,
        first - second⟫_ℝ := havg

/--
Distribution shift degrades the frozen-law interpolation lower bound by at
most `smoothness * sensitivity`.  This is the `T₂` lower-bound component of
the source's Appendix E.3 calculation.
-/
theorem diagonalFrozenPopulationGradient_interpolation_of_jointSmooth_transport
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (hmodulus : 0 < modulus) (hmodulus_le : modulus ≤ (smoothness : ℝ))
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (first second : Parameter) :
    (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
        (smoothness : ℝ) * sensitivity) * ‖first - second‖ ^ 2 +
      (1 / (modulus + (smoothness : ℝ))) *
        ‖frozenPopulationGradient model gradient second first -
          frozenPopulationGradient model gradient second second‖ ^ 2 ≤
      ⟪first - second,
        frozenPopulationGradient model gradient first first -
          frozenPopulationGradient model gradient second second⟫_ℝ := by
  let displacement := first - second
  let dataShift := frozenPopulationGradient model gradient first first -
    frozenPopulationGradient model gradient second first
  let parameterShift := frozenPopulationGradient model gradient second first -
    frozenPopulationGradient model gradient second second
  have hdataNorm := norm_frozenPopulationGradient_sub_le_of_finiteTransportSensitive
    model gradient hjoint.2 hsensitivity hsensitive first first second
  rw [dist_eq_norm] at hdataNorm
  have hdataLower :
      -((smoothness : ℝ) * sensitivity * ‖displacement‖ ^ 2) ≤
        ⟪displacement, dataShift⟫_ℝ := by
    have hproduct : ‖displacement‖ * ‖dataShift‖ ≤
        ‖displacement‖ * ((smoothness : ℝ) * sensitivity * ‖displacement‖) := by
      apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
      simpa [dataShift, displacement, mul_assoc] using hdataNorm
    calc
      -((smoothness : ℝ) * sensitivity * ‖displacement‖ ^ 2) =
          -(‖displacement‖ * ((smoothness : ℝ) * sensitivity * ‖displacement‖)) := by ring
      _ ≤ -(‖displacement‖ * ‖dataShift‖) := neg_le_neg hproduct
      _ ≤ ⟪displacement, dataShift⟫_ℝ :=
        neg_le_of_abs_le (abs_real_inner_le_norm _ _)
  have hinterpolation := frozenPopulationGradient_interpolation_of_jointSmooth model gradient hjoint
    hgradientAt hmodulus hmodulus_le hstrong second first second
  have hinterpolation' :
      (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) *
          ‖displacement‖ ^ 2 +
        (1 / (modulus + (smoothness : ℝ))) * ‖parameterShift‖ ^ 2 ≤
        ⟪displacement, parameterShift⟫_ℝ := by
    simpa [displacement, parameterShift, real_inner_comm] using hinterpolation
  have hsplit :
      frozenPopulationGradient model gradient first first -
          frozenPopulationGradient model gradient second second = dataShift + parameterShift := by
    simp only [dataShift, parameterShift]
    abel
  rw [hsplit, inner_add_right]
  nlinarith [hdataLower, hinterpolation']

/--
The squared diagonal-gradient upper bound (`T₃`) from Appendix E.3, retaining
the frozen-law parameter-gradient term instead of replacing it by a global
Lipschitz bound.
-/
theorem sq_norm_diagonalFrozenPopulationGradient_sub_le_of_jointSmooth_transport
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (first second : Parameter) :
    ‖frozenPopulationGradient model gradient first first -
        frozenPopulationGradient model gradient second second‖ ^ 2 ≤
      ((smoothness : ℝ) ^ 2 * sensitivity ^ 2 +
        2 * (smoothness : ℝ) ^ 2 * sensitivity) * ‖first - second‖ ^ 2 +
        ‖frozenPopulationGradient model gradient second first -
          frozenPopulationGradient model gradient second second‖ ^ 2 := by
  let displacement := first - second
  let dataShift := frozenPopulationGradient model gradient first first -
    frozenPopulationGradient model gradient second first
  let parameterShift := frozenPopulationGradient model gradient second first -
    frozenPopulationGradient model gradient second second
  have hdataNorm := norm_frozenPopulationGradient_sub_le_of_finiteTransportSensitive
    model gradient hjoint.2 hsensitivity hsensitive first first second
  rw [dist_eq_norm] at hdataNorm
  have hdataNorm' : ‖dataShift‖ ≤
      (smoothness : ℝ) * sensitivity * ‖displacement‖ := by
    simpa [dataShift, displacement, mul_assoc] using hdataNorm
  have hparameterNorm := norm_frozenPopulationGradient_parameter_sub_le_of_gradientLipschitz
    model gradient hjoint.1 second first second
  have hparameterNorm' : ‖parameterShift‖ ≤ (smoothness : ℝ) * ‖displacement‖ := by
    simpa [parameterShift, displacement] using hparameterNorm
  have hdataBoundNonneg : 0 ≤ (smoothness : ℝ) * sensitivity * ‖displacement‖ := by positivity
  have hdataSq : ‖dataShift‖ ^ 2 ≤
      ((smoothness : ℝ) * sensitivity * ‖displacement‖) ^ 2 :=
    (sq_le_sq₀ (norm_nonneg _) hdataBoundNonneg).mpr hdataNorm'
  have hproduct : ‖dataShift‖ * ‖parameterShift‖ ≤
      ((smoothness : ℝ) * sensitivity * ‖displacement‖) *
        ((smoothness : ℝ) * ‖displacement‖) := by
    exact mul_le_mul hdataNorm' hparameterNorm' (norm_nonneg _) hdataBoundNonneg
  have hcross : 2 * ⟪dataShift, parameterShift⟫_ℝ ≤
      2 * (smoothness : ℝ) ^ 2 * sensitivity * ‖displacement‖ ^ 2 := by
    calc
      2 * ⟪dataShift, parameterShift⟫_ℝ ≤ 2 * (‖dataShift‖ * ‖parameterShift‖) := by
        exact mul_le_mul_of_nonneg_left (real_inner_le_norm _ _) (by positivity)
      _ ≤ 2 * (((smoothness : ℝ) * sensitivity * ‖displacement‖) *
          ((smoothness : ℝ) * ‖displacement‖)) := by
        exact mul_le_mul_of_nonneg_left hproduct (by positivity)
      _ = 2 * (smoothness : ℝ) ^ 2 * sensitivity * ‖displacement‖ ^ 2 := by ring
  have hsplit :
      frozenPopulationGradient model gradient first first -
          frozenPopulationGradient model gradient second second = dataShift + parameterShift := by
    simp only [dataShift, parameterShift]
    abel
  rw [hsplit, norm_add_sq_real]
  nlinarith [hdataSq, hcross]

/--
The diagonal expected-gradient map is Lipschitz when both the data and
parameter coordinates of the pointwise gradient are Lipschitz.  The two terms
respectively account for performative distribution shift and ordinary
within-law smoothness.
-/
theorem norm_diagonalFrozenPopulationGradient_sub_le_of_jointSmooth_transport
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsJointlySmoothGradient gradient smoothness) {sensitivity : ℝ}
    (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (first second : Parameter) :
    ‖frozenPopulationGradient model gradient first first -
        frozenPopulationGradient model gradient second second‖ ≤
      (smoothness : ℝ) * (sensitivity + 1) * ‖first - second‖ := by
  calc
    ‖frozenPopulationGradient model gradient first first -
        frozenPopulationGradient model gradient second second‖ =
        ‖(frozenPopulationGradient model gradient first first -
          frozenPopulationGradient model gradient second first) +
          (frozenPopulationGradient model gradient second first -
            frozenPopulationGradient model gradient second second)‖ := by
      congr 1
      abel
    _ ≤ ‖frozenPopulationGradient model gradient first first -
          frozenPopulationGradient model gradient second first‖ +
        ‖frozenPopulationGradient model gradient second first -
          frozenPopulationGradient model gradient second second‖ :=
      norm_add_le _ _
    _ ≤ (smoothness : ℝ) * (sensitivity * dist first second) +
          (smoothness : ℝ) * ‖first - second‖ := by
      gcongr
      · exact norm_frozenPopulationGradient_sub_le_of_finiteTransportSensitive model gradient
          hgradient.2 hsensitivity hsensitive first first second
      · exact norm_frozenPopulationGradient_parameter_sub_le_of_gradientLipschitz model gradient
          hgradient.1 second first second
    _ = (smoothness : ℝ) * (sensitivity + 1) * ‖first - second‖ := by
      rw [dist_eq_norm]
      ring

