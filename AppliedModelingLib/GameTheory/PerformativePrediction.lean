  let parameterShift := measureFrozenPopulationGradient model gradient second first -
    measureFrozenPopulationGradient model gradient second second
  have hdataNorm := norm_measureFrozenPopulationGradient_sub_le_of_wassersteinSensitive
    model gradient hjoint.2 hintegrable hsensitive first first second
  rw [dist_eq_norm] at hdataNorm
  have hdataLower :
      -((smoothness : ℝ) * sensitivity * ‖displacement‖ ^ 2) ≤
        ⟪displacement, dataShift⟫_ℝ := by
    have hproduct : ‖displacement‖ * ‖dataShift‖ ≤
        ‖displacement‖ * ((smoothness : ℝ) * sensitivity * ‖displacement‖) := by
      apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
      simpa [dataShift, displacement, mul_assoc] using hdataNorm
    calc
      -((smoothness : ℝ) * sensitivity * ‖displacement‖ ^ 2) =
          -(‖displacement‖ * ((smoothness : ℝ) * sensitivity * ‖displacement‖)) := by ring
      _ ≤ -(‖displacement‖ * ‖dataShift‖) := neg_le_neg hproduct
      _ ≤ ⟪displacement, dataShift⟫_ℝ :=
        neg_le_of_abs_le (abs_real_inner_le_norm _ _)
  have hinterpolation := measureFrozenPopulationGradient_interpolation_of_jointSmooth
    model gradient hjoint hintegrable hgradientAt hmodulus hmodulus_le hstrong second first second
  have hinterpolation' :
      (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ))) *
          ‖displacement‖ ^ 2 +
        (1 / (modulus + (smoothness : ℝ))) * ‖parameterShift‖ ^ 2 ≤
        ⟪displacement, parameterShift⟫_ℝ := by
    simpa [displacement, parameterShift, real_inner_comm] using hinterpolation
  have hsplit :
      measureFrozenPopulationGradient model gradient first first -
          measureFrozenPopulationGradient model gradient second second = dataShift + parameterShift := by
    simp only [dataShift, parameterShift]
