/--
The arbitrary-measure `T₃` squared diagonal-gradient upper bound from PZ
Appendix E.3.  It preserves the fixed-law parameter-gradient term for later
cancellation against the interpolation lower bound.
-/
theorem sq_norm_measureDiagonalFrozenPopulationGradient_sub_le_of_jointSmooth
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (first second : Parameter) :
    ‖measureFrozenPopulationGradient model gradient first first -
        measureFrozenPopulationGradient model gradient second second‖ ^ 2 ≤
      ((smoothness : ℝ) ^ 2 * sensitivity ^ 2 +
        2 * (smoothness : ℝ) ^ 2 * sensitivity) * ‖first - second‖ ^ 2 +
        ‖measureFrozenPopulationGradient model gradient second first -
          measureFrozenPopulationGradient model gradient second second‖ ^ 2 := by
  let displacement := first - second
  let dataShift := measureFrozenPopulationGradient model gradient first first -
    measureFrozenPopulationGradient model gradient second first
  let parameterShift := measureFrozenPopulationGradient model gradient second first -
    measureFrozenPopulationGradient model gradient second second
  have hdataNorm := norm_measureFrozenPopulationGradient_sub_le_of_wassersteinSensitive
    model gradient hjoint.2 hintegrable hsensitive first first second
  rw [dist_eq_norm] at hdataNorm
  have hdataNorm' : ‖dataShift‖ ≤
      (smoothness : ℝ) * sensitivity * ‖displacement‖ := by
    simpa [dataShift, displacement, mul_assoc] using hdataNorm
  have hparameterNorm := norm_measureFrozenPopulationGradient_parameter_sub_le_of_gradientLipschitz
    model gradient hjoint.1 hintegrable second first second
  have hparameterNorm' : ‖parameterShift‖ ≤ (smoothness : ℝ) * ‖displacement‖ := by
    simpa [parameterShift, displacement] using hparameterNorm
  have hdataBoundNonneg : 0 ≤ (smoothness : ℝ) * sensitivity * ‖displacement‖ := by positivity
  have hdataSq : ‖dataShift‖ ^ 2 ≤
      ((smoothness : ℝ) * sensitivity * ‖displacement‖) ^ 2 :=
    (sq_le_sq₀ (norm_nonneg _) hdataBoundNonneg).mpr hdataNorm'
  have hproduct : ‖dataShift‖ * ‖parameterShift‖ ≤
      ((smoothness : ℝ) * sensitivity * ‖displacement‖) *
        ((smoothness : ℝ) * ‖displacement‖) := by
    exact mul_le_mul hdataNorm' hparameterNorm' (norm_nonneg _) hdataBoundNonneg
  have hcross : 2 * ⟪dataShift, parameterShift⟫_ℝ ≤
      2 * (smoothness : ℝ) ^ 2 * sensitivity * ‖displacement‖ ^ 2 := by
    calc
      2 * ⟪dataShift, parameterShift⟫_ℝ ≤ 2 * (‖dataShift‖ * ‖parameterShift‖) := by
        exact mul_le_mul_of_nonneg_left (real_inner_le_norm _ _) (by positivity)
      _ ≤ 2 * (((smoothness : ℝ) * sensitivity * ‖displacement‖) *
          ((smoothness : ℝ) * ‖displacement‖)) := by
        exact mul_le_mul_of_nonneg_left hproduct (by positivity)
      _ = 2 * (smoothness : ℝ) ^ 2 * sensitivity * ‖displacement‖ ^ 2 := by ring
  have hsplit :
      measureFrozenPopulationGradient model gradient first first -
          measureFrozenPopulationGradient model gradient second second = dataShift + parameterShift := by
    simp only [dataShift, parameterShift]
    abel
  rw [hsplit, norm_add_sq_real]
  nlinarith [hdataSq, hcross]

/-- A projected repeated-gradient-descent update under arbitrary induced laws. -/
noncomputable def measureRepeatedGradientDescentUpdate {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (stepSize : ℝ) : Parameter → Parameter :=
  fun deployed => project
    (deployed - stepSize • measureFrozenPopulationGradient model gradient deployed deployed)

/--
The gradient averaged under a supplied empirical data law.  The caller may
construct this law from a sample; keeping it as a probability measure makes
the deterministic Wasserstein-to-update bridge reusable independently of a
particular empirical-measure implementation.
-/
noncomputable def measureEmpiricalPopulationGradient {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter] [MeasurableSpace Data]
    (gradient : Data → Parameter → Parameter) (empiricalLaw : ProbabilityMeasure Data)
    (evaluatedParameter : Parameter) : Parameter :=
  ∫ datum, gradient datum evaluatedParameter ∂(empiricalLaw : Measure Data)

/--
Projected empirical RGD under a supplied (possibly deployed-parameter
dependent) empirical law.  This is the general-law deterministic shell of
Theorem 3.10; concentration of the empirical law is deliberately separate.
-/
noncomputable def measureRepeatedEmpiricalGradientDescentUpdate {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter] [MeasurableSpace Data]
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (stepSize : ℝ) (empiricalLaw : Parameter → ProbabilityMeasure Data) : Parameter → Parameter :=
  fun deployed => project
    (deployed - stepSize • measureEmpiricalPopulationGradient gradient (empiricalLaw deployed) deployed)

/--
The one-step empirical RGD update from an actual nonempty finite batch.  This
is the history-local form used by adaptive traces; it is definitionally the
general empirical-law update at the batch's empirical probability measure.
-/
noncomputable def measureSampledGradientDescentUpdate {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter] [MeasurableSpace Data]
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (stepSize : ℝ) {sampleCount : ℕ} (hsampleCount : 0 < sampleCount)
    (sample : Fin sampleCount → Data) : Parameter → Parameter :=
  fun deployed => project
    (deployed - stepSize • measureEmpiricalPopulationGradient gradient
      (empiricalSampleProbabilityMeasureOfPos hsampleCount sample) deployed)

/--
At a deployed parameter, general-law empirical RGD differs from population
RGD by at most the step size times its empirical-gradient error.
-/
theorem norm_measureRepeatedEmpiricalGradientDescentUpdate_sub_measureRepeatedGradientDescentUpdate_le
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (hproject : LipschitzWith 1 project) (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    (empiricalLaw : Parameter → ProbabilityMeasure Data) (deployed : Parameter) :
    ‖measureRepeatedEmpiricalGradientDescentUpdate gradient project stepSize empiricalLaw deployed -
        measureRepeatedGradientDescentUpdate model gradient project stepSize deployed‖ ≤
      stepSize * ‖measureEmpiricalPopulationGradient gradient (empiricalLaw deployed) deployed -
        measureFrozenPopulationGradient model gradient deployed deployed‖ := by
  have hnonexpansive :
      ‖project (deployed - stepSize •
          measureEmpiricalPopulationGradient gradient (empiricalLaw deployed) deployed) -
          project (deployed - stepSize •
            measureFrozenPopulationGradient model gradient deployed deployed)‖ ≤
        ‖(deployed - stepSize •
          measureEmpiricalPopulationGradient gradient (empiricalLaw deployed) deployed) -
          (deployed - stepSize •
            measureFrozenPopulationGradient model gradient deployed deployed)‖ := by
    simpa only [dist_eq_norm, NNReal.coe_one, one_mul] using hproject.dist_le_mul
      (deployed - stepSize • measureEmpiricalPopulationGradient gradient (empiricalLaw deployed) deployed)
      (deployed - stepSize • measureFrozenPopulationGradient model gradient deployed deployed)
  calc
    ‖measureRepeatedEmpiricalGradientDescentUpdate gradient project stepSize empiricalLaw deployed -
        measureRepeatedGradientDescentUpdate model gradient project stepSize deployed‖ ≤
      ‖(deployed - stepSize • measureEmpiricalPopulationGradient gradient (empiricalLaw deployed) deployed) -
          (deployed - stepSize •
            measureFrozenPopulationGradient model gradient deployed deployed)‖ := by
        simpa only [measureRepeatedEmpiricalGradientDescentUpdate,
          measureRepeatedGradientDescentUpdate] using hnonexpansive
    _ = stepSize * ‖measureEmpiricalPopulationGradient gradient (empiricalLaw deployed) deployed -
        measureFrozenPopulationGradient model gradient deployed deployed‖ := by
      rw [show (deployed - stepSize •
          measureEmpiricalPopulationGradient gradient (empiricalLaw deployed) deployed) -
          (deployed - stepSize • measureFrozenPopulationGradient model gradient deployed deployed) =
          stepSize • (measureFrozenPopulationGradient model gradient deployed deployed -
            measureEmpiricalPopulationGradient gradient (empiricalLaw deployed) deployed) by
              simp only [smul_sub]
              abel,
        norm_smul, Real.norm_eq_abs, abs_of_nonneg hstepSize, norm_sub_rev]

/--
A finite-real W₁ estimate between a supplied empirical law and the deployed
data law controls the general-law empirical-gradient error.  This is the
deterministic analytical input to the RGD branch of Theorem 3.10, without
claiming the separate Fournier--Guillin concentration theorem.
-/
theorem norm_measureEmpiricalPopulationGradient_sub_measureFrozenPopulationGradient_le_of_wassersteinOne
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (empiricalLaw : ProbabilityMeasure Data) (deployed : Parameter)
    (hempirical_integrable : Integrable (fun datum => gradient datum deployed)
      (empiricalLaw : Measure Data))
    (hpopulation_integrable : Integrable (fun datum => gradient datum deployed)
      (model.dataLaw deployed : Measure Data))
    (hfinite : (ProbabilityCoupling.expectedDistanceCosts empiricalLaw (model.dataLaw deployed)).Nonempty)
    {wassersteinBound : ℝ}
    (hWasserstein : ProbabilityCoupling.wassersteinOneReal empiricalLaw (model.dataLaw deployed)
      hfinite ≤ wassersteinBound) :
    ‖measureEmpiricalPopulationGradient gradient empiricalLaw deployed -
        measureFrozenPopulationGradient model gradient deployed deployed‖ ≤
      (smoothness : ℝ) * wassersteinBound := by
  have hgradient_lipschitz : LipschitzWith smoothness (fun datum => gradient datum deployed) := by
    apply LipschitzWith.of_dist_le_mul
    intro first second
    simpa only [dist_eq_norm] using hjoint.2 first second deployed
  exact (ProbabilityCoupling.norm_integral_sub_le_lipschitz_wassersteinOneReal
    hgradient_lipschitz hempirical_integrable hpopulation_integrable hfinite).trans
      (mul_le_mul_of_nonneg_left hWasserstein (NNReal.coe_nonneg smoothness))

/--
An extended-real primal W₁ estimate controls the arbitrary-law empirical
gradient error.  This is the direct interface for the Euclidean
Fournier--Guillin concentration event; a positive smoothness constant and a
nonnegative real threshold make the ENNReal-to-real conversion explicit.
-/
theorem norm_measureEmpiricalPopulationGradient_sub_measureFrozenPopulationGradient_le_of_wassersteinOneENNReal
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MeasurableSpace Data] [MetricSpace Data] [OpensMeasurableSpace Data]
    [SecondCountableTopology Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness) (hsmoothness : smoothness ≠ 0)
    (empiricalLaw : ProbabilityMeasure Data) (deployed : Parameter)
    (hempirical_integrable : Integrable (fun datum => gradient datum deployed)
      (empiricalLaw : Measure Data))
    (hpopulation_integrable : Integrable (fun datum => gradient datum deployed)
      (model.dataLaw deployed : Measure Data))
    {wassersteinBound : ℝ} (hbound_nonneg : 0 ≤ wassersteinBound)
    (hWasserstein : ProbabilityCoupling.wassersteinOne empiricalLaw (model.dataLaw deployed) ≤
      ENNReal.ofReal wassersteinBound) :
    ‖measureEmpiricalPopulationGradient gradient empiricalLaw deployed -
        measureFrozenPopulationGradient model gradient deployed deployed‖ ≤
      (smoothness : ℝ) * wassersteinBound := by
  have hgradient_lipschitz : LipschitzWith smoothness (fun datum => gradient datum deployed) := by
    apply LipschitzWith.of_dist_le_mul
    intro first second
    simpa only [dist_eq_norm] using hjoint.2 first second deployed
  have hintegral := ProbabilityCoupling.ofReal_norm_integral_sub_le_lipschitz_wassersteinOne
    hgradient_lipschitz hsmoothness hempirical_integrable hpopulation_integrable
  have hproduct :
      (smoothness : ℝ≥0∞) * ProbabilityCoupling.wassersteinOne empiricalLaw
          (model.dataLaw deployed) ≤ ENNReal.ofReal ((smoothness : ℝ) * wassersteinBound) := by
    calc
      (smoothness : ℝ≥0∞) * ProbabilityCoupling.wassersteinOne empiricalLaw
          (model.dataLaw deployed) ≤ (smoothness : ℝ≥0∞) * ENNReal.ofReal wassersteinBound :=
        mul_le_mul_right hWasserstein _
      _ = ENNReal.ofReal ((smoothness : ℝ) * wassersteinBound) := by
        rw [ENNReal.ofReal_mul (NNReal.coe_nonneg smoothness)]
        rw [ENNReal.ofReal_coe_nnreal]
  apply (ENNReal.ofReal_le_ofReal_iff
    (mul_nonneg (NNReal.coe_nonneg smoothness) hbound_nonneg)).mp
  simpa only [measureEmpiricalPopulationGradient, measureFrozenPopulationGradient] using
    hintegral.trans hproduct

/--
At a sampled deployment, an extended-real primal W₁ bound controls the
empirical-RGD update perturbation.  This is the deterministic one-step bridge
used with Euclidean empirical-W₁ concentration on an adaptive trace.
-/
theorem norm_measureSampledGradientDescentUpdate_sub_measureRepeatedGradientDescentUpdate_le_of_wassersteinOneENNReal
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MeasurableSpace Data] [MetricSpace Data] [OpensMeasurableSpace Data]
    [SecondCountableTopology Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (hproject : LipschitzWith 1 project) (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    {smoothness : NNReal} (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hsmoothness : smoothness ≠ 0)
    {sampleCount : ℕ} (hsampleCount : 0 < sampleCount) (sample : Fin sampleCount → Data)
    (deployed : Parameter)
    (hempirical_integrable : Integrable (fun datum => gradient datum deployed)
      (empiricalSampleProbabilityMeasureOfPos hsampleCount sample : Measure Data))
    (hpopulation_integrable : Integrable (fun datum => gradient datum deployed)
      (model.dataLaw deployed : Measure Data))
    {wassersteinBound : ℝ} (hbound_nonneg : 0 ≤ wassersteinBound)
    (hWasserstein : ProbabilityCoupling.wassersteinOne
      (empiricalSampleProbabilityMeasureOfPos hsampleCount sample) (model.dataLaw deployed) ≤
      ENNReal.ofReal wassersteinBound) :
    ‖measureSampledGradientDescentUpdate gradient project stepSize hsampleCount sample deployed -
        measureRepeatedGradientDescentUpdate model gradient project stepSize deployed‖ ≤
      stepSize * (smoothness : ℝ) * wassersteinBound := by
  let empiricalLaw : Parameter → ProbabilityMeasure Data :=
    fun _ => empiricalSampleProbabilityMeasureOfPos hsampleCount sample
  have hupdate : measureSampledGradientDescentUpdate gradient project stepSize hsampleCount sample =
      measureRepeatedEmpiricalGradientDescentUpdate gradient project stepSize empiricalLaw := by
    funext parameter
    rfl
  rw [hupdate]
  calc
    ‖measureRepeatedEmpiricalGradientDescentUpdate gradient project stepSize empiricalLaw deployed -
        measureRepeatedGradientDescentUpdate model gradient project stepSize deployed‖ ≤
      stepSize * ‖measureEmpiricalPopulationGradient gradient (empiricalLaw deployed) deployed -
        measureFrozenPopulationGradient model gradient deployed deployed‖ :=
      norm_measureRepeatedEmpiricalGradientDescentUpdate_sub_measureRepeatedGradientDescentUpdate_le
        model gradient project hproject stepSize hstepSize empiricalLaw deployed
    _ ≤ stepSize * ((smoothness : ℝ) * wassersteinBound) :=
      mul_le_mul_of_nonneg_left
        (norm_measureEmpiricalPopulationGradient_sub_measureFrozenPopulationGradient_le_of_wassersteinOneENNReal
          model gradient hjoint hsmoothness (empiricalLaw deployed) deployed hempirical_integrable
          hpopulation_integrable hbound_nonneg hWasserstein)
        hstepSize
    _ = stepSize * (smoothness : ℝ) * wassersteinBound := by ring

/--
On a heterogeneous adaptive trace, the complement of any batch event that
certifies an extended-real empirical-W₁ bound keeps sampled RGD inside a
contractive absorbing ball.  The concentration argument is deliberately
separate: it need only prove the displayed local implication for `bad`.
-/
theorem dist_heterogeneousMeasureRGDState_le_radius_of_not_wassersteinOneENNRealBad
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MeasurableSpace Data] [MetricSpace Data] [OpensMeasurableSpace Data]
    [SecondCountableTopology Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness) (hsmoothness : smoothness ≠ 0)
    (project : Parameter → Parameter) (hproject : LipschitzWith 1 project)
    (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    (sampleCount : ℕ → ℕ) (hsampleCount : ∀ iteration, 0 < sampleCount iteration)
    (deployedOfHistory : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration → Parameter)
    (hempirical : ∀ iteration history batch,
      deployedOfHistory (iteration + 1) (heterogeneousBatchTraceSnoc history batch) =
        measureSampledGradientDescentUpdate gradient project stepSize
          (hsampleCount iteration) batch (deployedOfHistory iteration history))
    (hintegrablePopulation : ∀ deployed,
      Integrable (fun datum => gradient datum deployed) (model.dataLaw deployed : Measure Data))
    (hintegrableEmpirical : ∀ (iteration : ℕ)
      (history : HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration)
      (batch : Fin (sampleCount iteration) → Data),
      Integrable (fun datum => gradient datum (deployedOfHistory iteration history))
        (empiricalSampleProbabilityMeasureOfPos (hsampleCount iteration) batch : Measure Data))
    (stable : Parameter) {contraction wassersteinBound radius : ℝ}
    (hcontraction_nonneg : 0 ≤ contraction)
    (hstable : measureRepeatedGradientDescentUpdate model gradient project stepSize stable = stable)
    (hcontract : ∀ parameter,
      dist (measureRepeatedGradientDescentUpdate model gradient project stepSize parameter)
        (measureRepeatedGradientDescentUpdate model gradient project stepSize stable) ≤
        contraction * dist parameter stable)
    (hinitial : ∀ history : HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data 0,
      dist (deployedOfHistory 0 history) stable ≤ radius)
    (hbound_nonneg : 0 ≤ wassersteinBound)
    (herror_absorbed : stepSize * (smoothness : ℝ) * wassersteinBound ≤
      (1 - contraction) * radius)
    (bad : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration →
      (Fin (sampleCount iteration) → Data) → Prop)
    (hgoodWasserstein : ∀ iteration history batch, ¬ bad iteration history batch →
      ProbabilityCoupling.wassersteinOne
        (empiricalSampleProbabilityMeasureOfPos (hsampleCount iteration) batch)
        (model.dataLaw (deployedOfHistory iteration history)) ≤ ENNReal.ofReal wassersteinBound)
    (iteration : ℕ) :
    ∀ history : HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration,
      ¬ adaptiveFreshHeterogeneousTraceAnyBadEvent (fun round => Fin (sampleCount round))
        bad iteration history →
      dist (deployedOfHistory iteration history) stable ≤ radius := by
  classical
  let traceInit : ∀ {round : ℕ},
      HeterogeneousBatchTrace (fun index => Fin (sampleCount index)) Data (round + 1) →
      HeterogeneousBatchTrace (fun index => Fin (sampleCount index)) Data round :=
    fun {round} history =>
      heterogeneousBatchTraceInit (BatchIndex := fun index => Fin (sampleCount index)) history
  let traceLast : ∀ {round : ℕ},
      HeterogeneousBatchTrace (fun index => Fin (sampleCount index)) Data (round + 1) →
      Fin (sampleCount round) → Data :=
    fun {round} history =>
      heterogeneousBatchTraceLast (BatchIndex := fun index => Fin (sampleCount index)) history
  intro history hgood
  induction iteration with
  | zero => exact hinitial history
  | succ iteration ih =>
      change ¬ (adaptiveFreshHeterogeneousTraceAnyBadEvent (fun round => Fin (sampleCount round))
        bad iteration (traceInit history) ∨
        bad iteration (traceInit history) (traceLast history)) at hgood
      have hprevious : ¬ adaptiveFreshHeterogeneousTraceAnyBadEvent
          (fun round => Fin (sampleCount round)) bad iteration (traceInit history) :=
        fun hbad => hgood (Or.inl hbad)
      have hbatch : ¬ bad iteration (traceInit history) (traceLast history) :=
        fun hbad => hgood (Or.inr hbad)
      have hprevious_radius := ih (traceInit history) hprevious
      have hWasserstein := hgoodWasserstein iteration (traceInit history) (traceLast history) hbatch
      have hupdate := hempirical iteration (traceInit history) (traceLast history)
      simp [traceInit, traceLast] at hupdate
      have hperturb :
          dist (deployedOfHistory (iteration + 1) history)
            (measureRepeatedGradientDescentUpdate model gradient project stepSize
              (deployedOfHistory iteration (traceInit history))) ≤
            stepSize * (smoothness : ℝ) * wassersteinBound := by
        rw [hupdate, dist_eq_norm]
        exact norm_measureSampledGradientDescentUpdate_sub_measureRepeatedGradientDescentUpdate_le_of_wassersteinOneENNReal
          model gradient project hproject stepSize hstepSize hjoint hsmoothness
          (hsampleCount iteration) (traceLast history)
          (deployedOfHistory iteration (traceInit history))
          (hintegrableEmpirical iteration (traceInit history) (traceLast history))
          (hintegrablePopulation (deployedOfHistory iteration (traceInit history)))
          hbound_nonneg hWasserstein
      have hcontract' :
          dist (measureRepeatedGradientDescentUpdate model gradient project stepSize
            (deployedOfHistory iteration (traceInit history))) stable ≤ contraction *
              dist (deployedOfHistory iteration (traceInit history)) stable := by
        simpa [hstable] using hcontract (deployedOfHistory iteration (traceInit history))
      calc
        dist (deployedOfHistory (iteration + 1) history) stable ≤
            dist (deployedOfHistory (iteration + 1) history)
              (measureRepeatedGradientDescentUpdate model gradient project stepSize
                (deployedOfHistory iteration (traceInit history))) +
            dist (measureRepeatedGradientDescentUpdate model gradient project stepSize
              (deployedOfHistory iteration (traceInit history))) stable := dist_triangle _ _ _
        _ ≤ stepSize * (smoothness : ℝ) * wassersteinBound +
            contraction * dist (deployedOfHistory iteration (traceInit history)) stable :=
          add_le_add hperturb hcontract'
        _ ≤ stepSize * (smoothness : ℝ) * wassersteinBound + contraction * radius :=
          add_le_add_right
            (mul_le_mul_of_nonneg_left hprevious_radius hcontraction_nonneg) _
        _ ≤ radius := by linarith

