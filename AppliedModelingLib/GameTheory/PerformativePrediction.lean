      ¬ FiniteCoupling.HasExpectedCostLE
        (empiricalSampleLawOfPos (hsampleCount iteration) (samples outcome iteration))
        (model.dataLaw (trajectory outcome iteration))
        (fun left right => dist left right) transportBound) ≤
      measureProb law (fun outcome => ∀ iteration, iteration ≤ horizon →
        dist (trajectory outcome iteration) stable ≤ radius) := by
  classical
  let good : ℕ → Outcome → Prop := fun iteration outcome =>
    FiniteCoupling.HasExpectedCostLE
      (empiricalSampleLawOfPos (hsampleCount iteration) (samples outcome iteration))
      (model.dataLaw (trajectory outcome iteration))
      (fun left right => dist left right) transportBound
  have hgood_measurable : ∀ iteration ∈ Finset.range horizon,
      MeasurableSet {outcome | good iteration outcome} := by
    intro iteration hiteration
    simpa [good] using htransport_measurable iteration hiteration
  have hgood_probability := measureProb_inter_ge_one_sub_sum_compl law
    (Finset.range horizon) good hgood_measurable
  have hgood_implies : ∀ outcome,
      (∀ iteration ∈ Finset.range horizon, good iteration outcome) →
      (∀ iteration, iteration ≤ horizon →
        dist (trajectory outcome iteration) stable ≤ radius) := by
    intro outcome hgood iteration hiteration
    apply dist_repeatedEmpiricalGradientDescentTrajectory_le_radius_up_to_of_gradientError
      model gradient project hproject stepSize hstepSize sampleCount (samples outcome)
      (trajectory outcome) (htrajectory outcome) stable horizon hcontraction_nonneg hstable hcontract
    · intro round hround
