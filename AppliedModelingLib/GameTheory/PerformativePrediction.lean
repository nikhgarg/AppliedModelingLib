/--
Under a fixed arbitrary probability law, the Bochner-averaged gradient
inherits the parameter-coordinate Lipschitz bound of the pointwise gradient.
This is the fixed-law term in the PZ repeated-gradient-descent split.
-/
theorem norm_measureFrozenPopulationGradient_parameter_sub_le_of_gradientLipschitz
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : ∀ datum first second,
      ‖gradient datum first - gradient datum second‖ ≤
        (smoothness : ℝ) * ‖first - second‖)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    (distributionParameter first second : Parameter) :
    ‖measureFrozenPopulationGradient model gradient distributionParameter first -
        measureFrozenPopulationGradient model gradient distributionParameter second‖ ≤
      (smoothness : ℝ) * ‖first - second‖ := by
  let μ : Measure Data := model.dataLaw distributionParameter
  have hfirst : Integrable (fun datum => gradient datum first) μ :=
    hintegrable distributionParameter first
  have hsecond : Integrable (fun datum => gradient datum second) μ :=
    hintegrable distributionParameter second
  change ‖(∫ datum, gradient datum first ∂μ) -
      ∫ datum, gradient datum second ∂μ‖ ≤
    (smoothness : ℝ) * ‖first - second‖
  rw [← integral_sub hfirst hsecond]
  calc
    ‖∫ datum, gradient datum first - gradient datum second ∂μ‖ ≤
        ∫ _ : Data, (smoothness : ℝ) * ‖first - second‖ ∂μ :=
      norm_integral_le_of_norm_le (integrable_const _)
        (ae_of_all μ fun datum => hgradient datum first second)
    _ = (smoothness : ℝ) * ‖first - second‖ := by
      rw [integral_const, probReal_univ, one_smul]

/--
The diagonal arbitrary-law expected-gradient map is Lipschitz under the PZ
W₁ sensitivity and joint-smoothness hypotheses.  It combines the transport
and fixed-law components without assuming finite data support.
-/
theorem norm_measureDiagonalFrozenPopulationGradient_sub_le_of_jointSmooth
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity : ℝ} (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (first second : Parameter) :
    ‖measureFrozenPopulationGradient model gradient first first -
        measureFrozenPopulationGradient model gradient second second‖ ≤
      (smoothness : ℝ) * (sensitivity + 1) * ‖first - second‖ := by
  calc
    ‖measureFrozenPopulationGradient model gradient first first -
        measureFrozenPopulationGradient model gradient second second‖ =
        ‖(measureFrozenPopulationGradient model gradient first first -
          measureFrozenPopulationGradient model gradient second first) +
          (measureFrozenPopulationGradient model gradient second first -
            measureFrozenPopulationGradient model gradient second second)‖ := by
      congr 1
      abel
    _ ≤ ‖measureFrozenPopulationGradient model gradient first first -
          measureFrozenPopulationGradient model gradient second first‖ +
        ‖measureFrozenPopulationGradient model gradient second first -
          measureFrozenPopulationGradient model gradient second second‖ :=
      norm_add_le _ _
    _ ≤ (smoothness : ℝ) * (sensitivity * dist first second) +
          (smoothness : ℝ) * ‖first - second‖ := by
      gcongr
      · exact norm_measureFrozenPopulationGradient_sub_le_of_wassersteinSensitive
          model gradient hgradient.2 hintegrable hsensitive first first second
      · exact norm_measureFrozenPopulationGradient_parameter_sub_le_of_gradientLipschitz
          model gradient hgradient.1 hintegrable second first second
    _ = (smoothness : ℝ) * (sensitivity + 1) * ‖first - second‖ := by
      rw [dist_eq_norm]
      ring

/--
Distribution shift reduces the strong monotonicity of the diagonal
arbitrary-law expected gradient by at most `smoothness * sensitivity`.
This is the conservative (pre-interpolation) monotonicity ingredient for
general-law projected repeated gradient descent.
-/
theorem measureDiagonalFrozenPopulationGradient_strongMonotone_of_jointSmooth
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (first second : Parameter) :
    (modulus - (smoothness : ℝ) * sensitivity) * ‖first - second‖ ^ 2 ≤
      ⟪first - second,
        measureFrozenPopulationGradient model gradient first first -
          measureFrozenPopulationGradient model gradient second second⟫_ℝ := by
  let displacement := first - second
  let dataShift := measureFrozenPopulationGradient model gradient first first -
    measureFrozenPopulationGradient model gradient second first
  let parameterShift := measureFrozenPopulationGradient model gradient second first -
    measureFrozenPopulationGradient model gradient second second
  have hdataNorm := norm_measureFrozenPopulationGradient_sub_le_of_wassersteinSensitive
    model gradient hgradient.2 hintegrable hsensitive first first second
  rw [dist_eq_norm] at hdataNorm
  have hdataLower :
      -((smoothness : ℝ) * sensitivity * ‖displacement‖ ^ 2) ≤
        ⟪displacement, dataShift⟫_ℝ := by
    have hproduct :
