/--
Pointwise convexity of loss is preserved by integration under every frozen
arbitrary probability law.  This supplies the convex-values step in the
general Proposition 4.1 best-response argument directly from the paper's
loss-side assumption.
-/
theorem convexOn_measureDecoupledPerformativeRisk_of_lossConvex
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [NormedSpace ℝ Parameter]
    [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (hconvex : Convex ℝ domain)
    (hlossConvex : ∀ datum, ConvexOn ℝ domain (model.loss datum)) :
    ∀ deployed : domain, ConvexOn ℝ domain (fun candidate =>
      measureDecoupledPerformativeRisk model deployed.1 candidate) := by
  intro deployed
  refine ⟨hconvex, ?_⟩
  intro first hfirst second hsecond a b ha hb hab
  let μ : Measure Data := model.dataLaw deployed.1
  have hfirst_integrable : Integrable (fun datum => model.loss datum first) μ :=
    model.loss_integrable deployed.1 first
  have hsecond_integrable : Integrable (fun datum => model.loss datum second) μ :=
    model.loss_integrable deployed.1 second
  have hcombined_integrable : Integrable (fun datum =>
      model.loss datum (a • first + b • second)) μ :=
    model.loss_integrable deployed.1 (a • first + b • second)
  have hright_integrable : Integrable (fun datum =>
      a * model.loss datum first + b * model.loss datum second) μ :=
    (hfirst_integrable.const_mul a).add (hsecond_integrable.const_mul b)
  have haverage := integral_mono_ae hcombined_integrable hright_integrable
    (ae_of_all μ fun datum => by
      simpa only [smul_eq_mul] using
        (hlossConvex datum).2 hfirst hsecond ha hb hab)
  change ∫ datum, model.loss datum (a • first + b • second) ∂μ ≤
    a * (∫ datum, model.loss datum first ∂μ) +
      b * ∫ datum, model.loss datum second ∂μ
  calc
    ∫ datum, model.loss datum (a • first + b • second) ∂μ ≤
        ∫ datum, a * model.loss datum first + b * model.loss datum second ∂μ := haverage
    _ = a * (∫ datum, model.loss datum first ∂μ) +
          b * ∫ datum, model.loss datum second ∂μ := by
      rw [integral_add (hfirst_integrable.const_mul a) (hsecond_integrable.const_mul b),
        integral_const_mul, integral_const_mul]

/-- Frozen-risk convexity makes arbitrary-law best-response values convex. -/
theorem convex_measurePerformativeBestResponseOn
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [NormedSpace ℝ Parameter]
    [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (hfrozenConvex : ∀ deployed : domain,
      ConvexOn ℝ domain (fun candidate =>
        measureDecoupledPerformativeRisk model deployed.1 candidate)) :
    ∀ deployed : domain, Convex ℝ (measurePerformativeBestResponseOn model domain deployed) := by
  intro deployed
  rw [convex_iff_add_mem]
  intro first hfirst second hsecond a b ha hb hab
  change a • first + b • second ∈ domain ∧ ∀ candidate ∈ domain,
    measureDecoupledPerformativeRisk model deployed.1 (a • first + b • second) ≤
      measureDecoupledPerformativeRisk model deployed.1 candidate
  constructor
  · exact (hfrozenConvex deployed).1 hfirst.1 hsecond.1 ha hb hab
  · intro candidate hcandidate
    have hconvexity := (hfrozenConvex deployed).2 hfirst.1 hsecond.1 ha hb hab
    have hfirst_min := hfirst.2 candidate hcandidate
    have hsecond_min := hsecond.2 candidate hcandidate
    change measureDecoupledPerformativeRisk model deployed.1 first ≤
      measureDecoupledPerformativeRisk model deployed.1 candidate at hfirst_min
    change measureDecoupledPerformativeRisk model deployed.1 second ≤
      measureDecoupledPerformativeRisk model deployed.1 candidate at hsecond_min
    simp only [smul_eq_mul] at hconvexity
    calc
      measureDecoupledPerformativeRisk model deployed.1 (a • first + b • second) ≤
          a * measureDecoupledPerformativeRisk model deployed.1 first +
            b * measureDecoupledPerformativeRisk model deployed.1 second := hconvexity
      _ ≤ a * measureDecoupledPerformativeRisk model deployed.1 candidate +
            b * measureDecoupledPerformativeRisk model deployed.1 candidate :=
          add_le_add (mul_le_mul_of_nonneg_left hfirst_min ha)
            (mul_le_mul_of_nonneg_left hsecond_min hb)
      _ = measureDecoupledPerformativeRisk model deployed.1 candidate := by
          rw [← add_mul, hab, one_mul]

/--
