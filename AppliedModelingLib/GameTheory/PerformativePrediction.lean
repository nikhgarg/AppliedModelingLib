        (hsampleCount iteration) (traceLast history) tolerance hbatch
      have hminimizer := hempirical iteration (traceInit history) (traceLast history)
      simp [traceInit, traceLast] at hminimizer
      have hperturb :
          dist (deployedOfHistory (iteration + 1) history)
            (populationUpdate (deployedOfHistory iteration (traceInit history))) ≤
            Real.sqrt (4 * tolerance / modulus) := by
        rw [dist_eq_norm]
        exact norm_empiricalRiskMinimizer_sub_populationRiskMinimizer_le_of_uniformDeviation
          model gradient hmodulus hstrong domain (traceLast history)
          (deployedOfHistory iteration (traceInit history))
          (deployedOfHistory (iteration + 1) history)
          (populationUpdate (deployedOfHistory iteration (traceInit history)))
          hminimizer
          (hpopulation (deployedOfHistory iteration (traceInit history))
            (hdomain iteration (traceInit history)))
          (hfirstOrder (deployedOfHistory iteration (traceInit history))
            (hdomain iteration (traceInit history)))
          htolerance_nonneg huniform
      have hcontract' :
          dist (populationUpdate (deployedOfHistory iteration (traceInit history)))
            stable ≤ contraction *
              dist (deployedOfHistory iteration (traceInit history)) stable := by
        simpa [hstable] using
          hcontract (deployedOfHistory iteration (traceInit history))
      calc
        dist (deployedOfHistory (iteration + 1) history) stable ≤
            dist (deployedOfHistory (iteration + 1) history)
              (populationUpdate (deployedOfHistory iteration (traceInit history))) +
            dist (populationUpdate (deployedOfHistory iteration (traceInit history)))
              stable := dist_triangle _ _ _
        _ ≤ Real.sqrt (4 * tolerance / modulus) + contraction *
              dist (deployedOfHistory iteration (traceInit history)) stable :=
          add_le_add hperturb hcontract'
        _ ≤ Real.sqrt (4 * tolerance / modulus) + contraction * radius := by
          exact add_le_add_right
            (mul_le_mul_of_nonneg_left hprevious_radius hcontraction_nonneg) _
        _ ≤ radius := by linarith

/--
The inverse-square RERM confidence schedule turns any trace-wise consequence
of the no-deviation event into a finite-horizon probability guarantee.  In
particular, `dist_heterogeneousRERMState_le_radius_of_not_bad` can be supplied
as `hsafe` to recover the absorbing-ball conclusion of Theorem 3.10's RERM
branch in the finite-PMF model.
-/
theorem one_sub_le_pmfProb_of_heterogeneousRERMConfidenceBudget
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (sampleCount : ℕ → ℕ)
    (deployedOfHistory : ∀ iteration,
      PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount iteration → Parameter)
    (horizon : ℕ) (domain : Set Parameter) (tolerance p : ℝ) (hp : 0 ≤ p)
    (hbudget : ∀ round history,
      finiteIidUniformEmpiricalRiskDeviationFailure model domain
        (deployedOfHistory round history) tolerance (sampleCount round) ≤
          theorem310FailureBudget p round)
    (safe : PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount horizon → Prop)
    [DecidablePred safe]
    (hsafe : ∀ trace,
      ¬ adaptiveFreshHeterogeneousTraceAnyBadEvent (fun round => Fin (sampleCount round))
        (fun round history batch => finiteIidUniformEmpiricalRiskDeviationEvent model domain
          (deployedOfHistory round history) tolerance batch) horizon trace →
      safe trace) :
    1 - p ≤ pmfProb (freshPerformativeHeterogeneousTraceLaw model sampleCount deployedOfHistory horizon)
      safe := by
  classical
  let bad : PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount horizon → Prop :=
    adaptiveFreshHeterogeneousTraceAnyBadEvent (fun round => Fin (sampleCount round))
      (fun round history batch => finiteIidUniformEmpiricalRiskDeviationEvent model domain
        (deployedOfHistory round history) tolerance batch) horizon
  have hbad := freshPerformativeHeterogeneousTraceLawEmpiricalRiskDeviationUpToFailure_le_theorem310Budget
    model sampleCount deployedOfHistory horizon domain tolerance p hp hbudget
  have hbad' :
      pmfProb (freshPerformativeHeterogeneousTraceLaw model sampleCount deployedOfHistory horizon) bad ≤ p := by
    simpa [bad, freshPerformativeHeterogeneousTraceLawEmpiricalRiskDeviationUpToFailure,
      adaptiveFreshHeterogeneousTraceAnyBadProbability, freshPerformativeHeterogeneousTraceLaw] using hbad
  calc
    1 - p ≤ 1 - pmfProb
        (freshPerformativeHeterogeneousTraceLaw model sampleCount deployedOfHistory horizon) bad :=
      sub_le_sub_left hbad' 1
    _ = pmfProb (freshPerformativeHeterogeneousTraceLaw model sampleCount deployedOfHistory horizon)
        (fun trace => ¬ bad trace) :=
      (pmfProb_compl
        (freshPerformativeHeterogeneousTraceLaw model sampleCount deployedOfHistory horizon) bad).symm
    _ ≤ pmfProb (freshPerformativeHeterogeneousTraceLaw model sampleCount deployedOfHistory horizon)
        safe := pmfProb_le_of_imp _ _ _ (fun trace hgood => hsafe trace hgood)

/-- The finite empirical gradient average used by repeated empirical gradient descent. -/
noncomputable def empiricalPopulationGradient {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (gradient : Data → Parameter → Parameter) {sampleCount : ℕ}
    (sample : Fin sampleCount → Data) (evaluatedParameter : Parameter) : Parameter :=
  finiteSampleStatisticMean sample (fun datum => gradient datum evaluatedParameter)

/-- The finite empirical gradient average is vector expectation under its empirical PMF. -/
theorem empiricalPopulationGradient_eq_pmfVectorExp_empiricalSampleLaw
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (gradient : Data → Parameter → Parameter) {sampleCount : ℕ}
    [Nonempty (Fin sampleCount)] (sample : Fin sampleCount → Data)
    (evaluatedParameter : Parameter) :
    empiricalPopulationGradient gradient sample evaluatedParameter =
      pmfVectorExp (empiricalSampleLaw sample) (fun datum => gradient datum evaluatedParameter) := by
  simpa [empiricalPopulationGradient] using
    (pmfVectorExp_empiricalSampleLaw_eq_finiteSampleMean sample
      (fun datum => gradient datum evaluatedParameter)).symm

/--
The realized-sample update in Definition 3.9's repeated empirical gradient
descent.  As in the source, it averages loss gradients at the deployed
parameter and then projects the gradient step onto the parameter domain.
-/
noncomputable def repeatedEmpiricalGradientDescentUpdate {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (stepSize : ℝ) {sampleCount : ℕ} (sample : Fin sampleCount → Data) :
    Parameter → Parameter :=
  fun deployed => project
    (deployed - stepSize • empiricalPopulationGradient gradient sample deployed)

/--
At one deployed parameter, empirical RGD differs from population RGD by at
most the step size times the empirical-gradient error.  This deterministic
bridge is the algorithmic input for Theorem 3.10's concentration argument.
-/
theorem norm_repeatedEmpiricalGradientDescentUpdate_sub_repeatedGradientDescentUpdate_le
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (hproject : LipschitzWith 1 project) (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    {sampleCount : ℕ} (sample : Fin sampleCount → Data) (deployed : Parameter) :
    ‖repeatedEmpiricalGradientDescentUpdate gradient project stepSize sample deployed -
        repeatedGradientDescentUpdate model gradient project stepSize deployed‖ ≤
      stepSize * ‖empiricalPopulationGradient gradient sample deployed -
        frozenPopulationGradient model gradient deployed deployed‖ := by
  have hnonexpansive :
      ‖project (deployed - stepSize • empiricalPopulationGradient gradient sample deployed) -
          project (deployed - stepSize • frozenPopulationGradient model gradient deployed deployed)‖ ≤
        ‖(deployed - stepSize • empiricalPopulationGradient gradient sample deployed) -
          (deployed - stepSize • frozenPopulationGradient model gradient deployed deployed)‖ := by
    simpa only [dist_eq_norm, NNReal.coe_one, one_mul] using hproject.dist_le_mul
      (deployed - stepSize • empiricalPopulationGradient gradient sample deployed)
      (deployed - stepSize • frozenPopulationGradient model gradient deployed deployed)
  calc
    ‖repeatedEmpiricalGradientDescentUpdate gradient project stepSize sample deployed -
        repeatedGradientDescentUpdate model gradient project stepSize deployed‖ ≤
      ‖(deployed - stepSize • empiricalPopulationGradient gradient sample deployed) -
          (deployed - stepSize • frozenPopulationGradient model gradient deployed deployed)‖ := by
        simpa [repeatedEmpiricalGradientDescentUpdate, repeatedGradientDescentUpdate] using hnonexpansive
    _ = stepSize * ‖empiricalPopulationGradient gradient sample deployed -
        frozenPopulationGradient model gradient deployed deployed‖ := by
      rw [show (deployed - stepSize • empiricalPopulationGradient gradient sample deployed) -
          (deployed - stepSize • frozenPopulationGradient model gradient deployed deployed) =
          stepSize • (frozenPopulationGradient model gradient deployed deployed -
            empiricalPopulationGradient gradient sample deployed) by
              simp only [smul_sub]
              abel,
        norm_smul, Real.norm_eq_abs, abs_of_nonneg hstepSize, norm_sub_rev]

/--
Finite-transport control of the empirical gradient error.  This is the exact
finite-PMF bridge from a Wasserstein-style empirical-law estimate to the
gradient perturbation used by repeated empirical gradient descent.
-/
theorem norm_empiricalPopulationGradient_sub_frozenPopulationGradient_le_of_transport
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    {sampleCount : ℕ} [Nonempty (Fin sampleCount)]
    (sample : Fin sampleCount → Data) (deployed : Parameter) {transportBound : ℝ}
    (htransport : FiniteCoupling.HasExpectedCostLE (empiricalSampleLaw sample)
      (model.dataLaw deployed) (fun left right => dist left right) transportBound) :
    ‖empiricalPopulationGradient gradient sample deployed -
        frozenPopulationGradient model gradient deployed deployed‖ ≤
      (smoothness : ℝ) * transportBound := by
  have hgradient_lipschitz : LipschitzWith smoothness (fun datum => gradient datum deployed) := by
    apply LipschitzWith.of_dist_le_mul
    intro first second
    simpa only [dist_eq_norm] using hjoint.2 first second deployed
  rw [empiricalPopulationGradient_eq_pmfVectorExp_empiricalSampleLaw]
  change ‖pmfVectorExp (empiricalSampleLaw sample) (fun datum => gradient datum deployed) -
      pmfVectorExp (model.dataLaw deployed) (fun datum => gradient datum deployed)‖ ≤
    (smoothness : ℝ) * transportBound
  exact FiniteCoupling.norm_pmfVectorExp_sub_le_lipschitz_of_expectedCostLE
    hgradient_lipschitz htransport

/--
Finite-W₁ control of the empirical gradient error.  This is the direct
finite-PMF analogue of the empirical-Wasserstein input in the RGD branch of
Theorem 3.10.
-/
theorem norm_empiricalPopulationGradient_sub_frozenPopulationGradient_le_of_finiteWassersteinOne
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    {sampleCount : ℕ} [Nonempty (Fin sampleCount)]
    (sample : Fin sampleCount → Data) (deployed : Parameter) {wassersteinBound : ℝ}
    (hWasserstein : FiniteCoupling.finiteWassersteinOne (empiricalSampleLaw sample)
      (model.dataLaw deployed) ≤ wassersteinBound) :
    ‖empiricalPopulationGradient gradient sample deployed -
        frozenPopulationGradient model gradient deployed deployed‖ ≤
      (smoothness : ℝ) * wassersteinBound := by
  have hgradient_lipschitz : LipschitzWith smoothness (fun datum => gradient datum deployed) := by
    apply LipschitzWith.of_dist_le_mul
    intro first second
    simpa only [dist_eq_norm] using hjoint.2 first second deployed
  rw [empiricalPopulationGradient_eq_pmfVectorExp_empiricalSampleLaw]
  change ‖pmfVectorExp (empiricalSampleLaw sample) (fun datum => gradient datum deployed) -
      pmfVectorExp (model.dataLaw deployed) (fun datum => gradient datum deployed)‖ ≤
    (smoothness : ℝ) * wassersteinBound
  exact (FiniteCoupling.norm_pmfVectorExp_sub_le_lipschitz_finiteWassersteinOne
    hgradient_lipschitz).trans
      (mul_le_mul_of_nonneg_left hWasserstein (by positivity))

/--
Finite-alphabet empirical mass error also controls the empirical gradient.  A
reference datum centers the gradient, so only its data-Lipschitz range—not its
absolute magnitude—enters the bound.
-/
theorem norm_empiricalPopulationGradient_sub_frozenPopulationGradient_le_of_massDeviation
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hdataSmooth : IsDataGradientLipschitz gradient smoothness)
    {sampleCount : ℕ} [Nonempty (Fin sampleCount)]
    (sample : Fin sampleCount → Data) (deployed : Parameter) (reference : Data)
    (epsilon dataRadius : ℝ) (hepsilon : 0 ≤ epsilon)
    (hdataRadius : ∀ datum, dist datum reference ≤ dataRadius)
    (hmass : ∀ datum,
      |(empiricalSampleLaw sample datum).toReal - (model.dataLaw deployed datum).toReal| ≤
        epsilon) :
    ‖empiricalPopulationGradient gradient sample deployed -
        frozenPopulationGradient model gradient deployed deployed‖ ≤
      (Fintype.card Data : ℝ) * epsilon * ((smoothness : ℝ) * dataRadius) := by
  rw [empiricalPopulationGradient_eq_pmfVectorExp_empiricalSampleLaw]
  change ‖pmfVectorExp (empiricalSampleLaw sample) (fun datum => gradient datum deployed) -
      pmfVectorExp (model.dataLaw deployed) (fun datum => gradient datum deployed)‖ ≤
    (Fintype.card Data : ℝ) * epsilon * ((smoothness : ℝ) * dataRadius)
  apply norm_pmfVectorExp_sub_le_card_mul_of_massDeviation
    (empiricalSampleLaw sample) (model.dataLaw deployed)
    (fun datum => gradient datum deployed) reference epsilon ((smoothness : ℝ) * dataRadius)
    hepsilon hmass
  intro datum
  calc
    ‖gradient datum deployed - gradient reference deployed‖ ≤
        (smoothness : ℝ) * dist datum reference := hdataSmooth datum reference deployed
    _ ≤ (smoothness : ℝ) * dataRadius := by
      apply mul_le_mul_of_nonneg_left (hdataRadius datum)
      positivity

/--
The literal finite-sample count deviation event implies the coordinatewise
empirical-PMF deviation used by the finite-alphabet gradient bound.
-/
theorem norm_empiricalPopulationGradient_sub_frozenPopulationGradient_le_of_empiricalCountDeviation
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hdataSmooth : IsDataGradientLipschitz gradient smoothness)
    {sampleCount : ℕ} (hsampleCount : 0 < sampleCount)
    (sample : Fin sampleCount → Data) (deployed : Parameter) (reference : Data)
    (epsilon dataRadius : ℝ) (hepsilon : 0 ≤ epsilon)
    (hdataRadius : ∀ datum, dist datum reference ≤ dataRadius)
    (hcountDeviation : ∀ datum,
      |(Probability.empiricalCount sample datum : ℝ) -
          (sampleCount : ℝ) * (model.dataLaw deployed datum).toReal| ≤
        (sampleCount : ℝ) * epsilon) :
    ‖empiricalPopulationGradient gradient sample deployed -
        frozenPopulationGradient model gradient deployed deployed‖ ≤
      (Fintype.card Data : ℝ) * epsilon * ((smoothness : ℝ) * dataRadius) := by
  letI : Nonempty (Fin sampleCount) := Fin.pos_iff_nonempty.mp hsampleCount
  apply norm_empiricalPopulationGradient_sub_frozenPopulationGradient_le_of_massDeviation
    model gradient hdataSmooth sample deployed reference epsilon dataRadius hepsilon hdataRadius
  intro datum
  rw [empiricalSampleLaw_apply_toReal_eq_empiricalCount_div]
  have hsampleCount_pos : 0 < (sampleCount : ℝ) := by exact_mod_cast hsampleCount
  calc
    |(Probability.empiricalCount sample datum : ℝ) / (sampleCount : ℝ) -
        (model.dataLaw deployed datum).toReal| =
        |(Probability.empiricalCount sample datum : ℝ) -
          (sampleCount : ℝ) * (model.dataLaw deployed datum).toReal| /
          (sampleCount : ℝ) := by
      rw [show (Probability.empiricalCount sample datum : ℝ) / (sampleCount : ℝ) -
          (model.dataLaw deployed datum).toReal =
          ((Probability.empiricalCount sample datum : ℝ) -
            (sampleCount : ℝ) * (model.dataLaw deployed datum).toReal) /
            (sampleCount : ℝ) by field_simp]
      rw [abs_div, abs_of_pos hsampleCount_pos]
    _ ≤ epsilon := by
      apply (div_le_iff₀ hsampleCount_pos).mpr
      simpa [mul_comm] using hcountDeviation datum

/--
The finite-IID event on which at least one empirical data mass has a large
deviation from the frozen deployed law.
-/
abbrev finiteIidEmpiricalGradientMassDeviationEvent
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (deployed : Parameter)
    (epsilon : ℝ) {sampleCount : ℕ} (sample : Fin sampleCount → Data) : Prop :=
  ∃ datum,
    (sampleCount : ℝ) * epsilon ≤
      |(Probability.empiricalCount sample datum : ℝ) -
        (sampleCount : ℝ) * (model.dataLaw deployed datum).toReal|

/--
Outside the finite-IID mass-deviation event, the empirical gradient satisfies
the finite-alphabet perturbation bound at the frozen deployed parameter.
-/
theorem norm_empiricalPopulationGradient_sub_frozenPopulationGradient_le_of_not_finiteIidEmpiricalGradientMassDeviationEvent
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hdataSmooth : IsDataGradientLipschitz gradient smoothness)
    {sampleCount : ℕ} (hsampleCount : 0 < sampleCount)
    (sample : Fin sampleCount → Data) (deployed : Parameter) (reference : Data)
    (epsilon dataRadius : ℝ) (hepsilon : 0 ≤ epsilon)
    (hdataRadius : ∀ datum, dist datum reference ≤ dataRadius)
    (hgood : ¬ finiteIidEmpiricalGradientMassDeviationEvent model deployed epsilon sample) :
    ‖empiricalPopulationGradient gradient sample deployed -
        frozenPopulationGradient model gradient deployed deployed‖ ≤
      (Fintype.card Data : ℝ) * epsilon * ((smoothness : ℝ) * dataRadius) := by
  apply norm_empiricalPopulationGradient_sub_frozenPopulationGradient_le_of_empiricalCountDeviation
    model gradient hdataSmooth hsampleCount sample deployed reference epsilon dataRadius hepsilon
    hdataRadius
  intro datum
  exact le_of_lt (lt_of_not_ge (fun hdeviation => hgood ⟨datum, hdeviation⟩))

/--
Outside the same finite-IID mass-deviation event, the empirical data law lies
in an explicit finite primal-W₁ ball about the deployed law.  This converts
the existing coordinatewise Hoeffding event into the W₁ event used by the
source-shaped RGD trajectory theorem.
-/
theorem finiteWassersteinOne_empiricalSampleLaw_le_of_not_finiteIidEmpiricalGradientMassDeviationEvent
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) (deployed : Parameter)
    {sampleCount : ℕ} (hsampleCount : 0 < sampleCount)
    (sample : Fin sampleCount → Data) (epsilon diameter : ℝ)
    (hdiameter : ∀ first second : Data, dist first second ≤ diameter)
    (hgood : ¬ finiteIidEmpiricalGradientMassDeviationEvent model deployed epsilon sample) :
    FiniteCoupling.finiteWassersteinOne
      (empiricalSampleLawOfPos hsampleCount sample) (model.dataLaw deployed) ≤
      diameter * ((Fintype.card Data : ℝ) * epsilon) := by
  letI : Nonempty (Fin sampleCount) := Fin.pos_iff_nonempty.mp hsampleCount
  rw [empiricalSampleLawOfPos_eq_empiricalSampleLaw]
  apply FiniteCoupling.finiteWassersteinOne_le_diameter_card_mul_of_forall_abs_sub_le
    (empiricalSampleLaw sample) (model.dataLaw deployed) diameter hdiameter
  intro datum
  rw [empiricalSampleLaw_apply_toReal_eq_empiricalCount_div]
  have hsampleCount_pos : 0 < (sampleCount : ℝ) := by exact_mod_cast hsampleCount
  have hcountDeviation :
      |(Probability.empiricalCount sample datum : ℝ) -
          (sampleCount : ℝ) * (model.dataLaw deployed datum).toReal| <
        (sampleCount : ℝ) * epsilon :=
    lt_of_not_ge (fun hdeviation => hgood ⟨datum, hdeviation⟩)
  calc
    |(Probability.empiricalCount sample datum : ℝ) / (sampleCount : ℝ) -
        (model.dataLaw deployed datum).toReal| =
        |(Probability.empiricalCount sample datum : ℝ) -
          (sampleCount : ℝ) * (model.dataLaw deployed datum).toReal| /
          (sampleCount : ℝ) := by
      rw [show (Probability.empiricalCount sample datum : ℝ) / (sampleCount : ℝ) -
          (model.dataLaw deployed datum).toReal =
          ((Probability.empiricalCount sample datum : ℝ) -
            (sampleCount : ℝ) * (model.dataLaw deployed datum).toReal) /
            (sampleCount : ℝ) by field_simp]
      rw [abs_div, abs_of_pos hsampleCount_pos]
    _ ≤ epsilon := by
      apply (div_le_iff₀ hsampleCount_pos).mpr
      simpa [mul_comm] using hcountDeviation.le

/-- The probability of the finite-IID empirical-gradient mass-deviation event. -/
noncomputable def finiteIidEmpiricalGradientMassDeviationFailure
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (deployed : Parameter)
    (epsilon : ℝ) (sampleCount : ℕ) : ℝ :=
  Probability.finiteIidAnyMassDeviationFailure (model.dataLaw deployed) epsilon sampleCount

/--
Explicit finite-alphabet concentration for the empirical-mass event used in
the RGD branch.  The strict `tolerance < epsilon` premise is retained from
the reusable non-strict mass-deviation Hoeffding adapter.
-/
theorem finiteIidEmpiricalGradientMassDeviationFailure_le_hoeffding
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (deployed : Parameter)
    (epsilon tolerance : ℝ) (sampleCount : ℕ) (hsampleCount : 0 < sampleCount)
    (htolerance : 0 ≤ tolerance) (htolerance_lt : tolerance < epsilon) :
    finiteIidEmpiricalGradientMassDeviationFailure model deployed epsilon sampleCount ≤
      (Fintype.card Data : ℝ) * 2 *
        Real.exp (-2 * (sampleCount : ℝ) * tolerance ^ 2) := by
  exact Probability.finiteIidAnyMassDeviationFailure_le_hoeffding
    (model.dataLaw deployed) epsilon tolerance sampleCount hsampleCount htolerance htolerance_lt

/--
The literal finite-IID probability of missing the finite-W₁ radius induced by
coordinatewise mass control.  The radius is the data diameter times the
finite-alphabet cardinality and the atom-mass tolerance.
-/
noncomputable def finiteIidEmpiricalWassersteinOneFailure
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) (deployed : Parameter)
    (epsilon diameter : ℝ) (sampleCount : ℕ) (hsampleCount : 0 < sampleCount) : ℝ :=
  pmfProb (pmfProduct (Fin sampleCount) Data (model.dataLaw deployed))
    (fun sample => ¬ FiniteCoupling.finiteWassersteinOne
      (empiricalSampleLawOfPos hsampleCount sample) (model.dataLaw deployed) ≤
        diameter * ((Fintype.card Data : ℝ) * epsilon))

/--
The finite-W₁ failure event is contained in the already-concentrated
coordinatewise empirical-mass event.
-/
theorem finiteIidEmpiricalWassersteinOneFailure_le_massDeviationFailure
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) (deployed : Parameter)
    (epsilon diameter : ℝ) (sampleCount : ℕ) (hsampleCount : 0 < sampleCount)
    (hdiameter : ∀ first second : Data, dist first second ≤ diameter) :
    finiteIidEmpiricalWassersteinOneFailure model deployed epsilon diameter sampleCount hsampleCount ≤
      finiteIidEmpiricalGradientMassDeviationFailure model deployed epsilon sampleCount := by
  unfold finiteIidEmpiricalWassersteinOneFailure
    finiteIidEmpiricalGradientMassDeviationFailure
  apply pmfProb_le_of_imp
  intro sample hfailure
  by_contra hmass
  apply hfailure
  simpa only [empiricalSampleLawOfPos_eq_empiricalSampleLaw] using
    (finiteWassersteinOne_empiricalSampleLaw_le_of_not_finiteIidEmpiricalGradientMassDeviationEvent
      model deployed hsampleCount sample epsilon diameter hdiameter hmass)

/--
An explicit Hoeffding upper bound for the finite-W₁ empirical-law failure
probability.  This is the finite-alphabet concentration replacement for the
source paper's general Fournier--Guillin input.
-/
theorem finiteIidEmpiricalWassersteinOneFailure_le_hoeffding
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) (deployed : Parameter)
    (epsilon diameter tolerance : ℝ) (sampleCount : ℕ) (hsampleCount : 0 < sampleCount)
    (hdiameter : ∀ first second : Data, dist first second ≤ diameter)
    (htolerance : 0 ≤ tolerance) (htolerance_lt : tolerance < epsilon) :
    finiteIidEmpiricalWassersteinOneFailure model deployed epsilon diameter sampleCount hsampleCount ≤
      (Fintype.card Data : ℝ) * 2 *
        Real.exp (-2 * (sampleCount : ℝ) * tolerance ^ 2) := by
  exact (finiteIidEmpiricalWassersteinOneFailure_le_massDeviationFailure model deployed
    epsilon diameter sampleCount hsampleCount hdiameter).trans
      (finiteIidEmpiricalGradientMassDeviationFailure_le_hoeffding model deployed epsilon
        tolerance sampleCount hsampleCount htolerance htolerance_lt)

/--
For each fixed deployed parameter in the finite-data specialization, the
empirical-gradient mass-deviation failure probability vanishes as the literal
IID sample size grows.
-/
theorem finiteIidEmpiricalGradientMassDeviationFailure_tendsto_zero
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (deployed : Parameter)
    (epsilon : ℝ) (hepsilon : 0 < epsilon) :
    Filter.Tendsto
