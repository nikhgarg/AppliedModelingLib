      PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount iteration → Parameter)
    (horizon : ℕ) (domain : Set Parameter) (tolerance p : ℝ) (hp : 0 ≤ p)
    (hsampleCount : ∀ round, 0 < sampleCount round) (htolerance : 0 ≤ tolerance)
    (hloss : ∀ candidate datum, model.loss datum candidate ∈ Set.Icc (0 : ℝ) 1)
    (hschedule : ∀ round,
      (Fintype.card Parameter : ℝ) * 2 *
        Real.exp (-2 * (sampleCount round : ℝ) * tolerance ^ 2) ≤
          theorem310FailureBudget p round) :
    freshPerformativeHeterogeneousTraceLawEmpiricalRiskDeviationUpToFailure model sampleCount
      deployedOfHistory horizon domain tolerance ≤ p := by
  apply freshPerformativeHeterogeneousTraceLawEmpiricalRiskDeviationUpToFailure_le_theorem310Budget
    model sampleCount deployedOfHistory horizon domain tolerance p hp
  intro round history
  exact (finiteIidUniformEmpiricalRiskDeviationFailure_le_hoeffding model domain
    (deployedOfHistory round history) tolerance (sampleCount round)
    (hsampleCount round) htolerance hloss).trans (hschedule round)

/--
In the finite-PMF specialization, the per-law uniform-loss concentration
constructors are sufficient to choose a positive batch count `n_t` at every
