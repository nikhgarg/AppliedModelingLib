theorem freshPerformativeHeterogeneousTraceLawEmpiricalRiskDeviationUpToFailure_le_theorem310Budget_of_hoeffding
    {Parameter Data : Type*} [Fintype Parameter] [DecidableEq Parameter]
    [TopologicalSpace Parameter] [Fintype Data] [DecidableEq Data]
