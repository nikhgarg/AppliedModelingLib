      decoupledPerformativeRisk model point.1 point.2))
    (hlossConvex : ∀ datum, ConvexOn ℝ domain (model.loss datum)) :
    ∃ parameter ∈ domain, IsPerformativelyStableOn model domain parameter :=
  exists_isPerformativelyStableOn_of_compact_convex model domain hcompact hne hconvex hjoint
    (convexOn_decoupledPerformativeRisk_of_lossConvex model domain hconvex hlossConvex)

/--
A projected-RGD fixed point is performatively stable on the projection domain.
This is the projected first-order bridge needed for the stable-point conclusion
of Theorem 3.8; it uses the variational Euclidean-projection property, not
merely the nonexpansiveness used by the contraction estimate.
-/
theorem isPerformativelyStableOn_of_repeatedGradientDescent_fixedPoint
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ}
    (hmodulus : 0 < modulus) (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (project : Parameter → Parameter)
    (hproject : IsVariationalEuclideanProjectionOn domain project)
    (stepSize : ℝ) (hstepSize : 0 < stepSize) {parameter : Parameter}
    (hfixed : repeatedGradientDescentUpdate model gradient project stepSize parameter = parameter) :
    IsPerformativelyStableOn model domain parameter := by
  have hfixed' : project
      (parameter - stepSize • frozenPopulationGradient model gradient parameter parameter) = parameter := by
    simpa [repeatedGradientDescentUpdate] using hfixed
  have hparameter : parameter ∈ domain := by
    rw [← hfixed']
    exact hproject.1 _
  refine ⟨hparameter, ?_⟩
  intro candidate hcandidate
  have hfirstOrder : 0 ≤ frozenGradientPairing model gradient parameter parameter
      (candidate - parameter) := by
    rw [frozenGradientPairing_eq_inner_frozenPopulationGradient, real_inner_comm]
    exact projectedGradient_fixedPoint_firstOrder domain project hproject
      (frozenPopulationGradient model gradient parameter parameter) parameter stepSize hstepSize
      hfixed' candidate hcandidate
  have hlower := frozenRisk_strongConvex_lowerBound model gradient hstrong parameter parameter candidate
  have hquadratic : 0 ≤ modulus / 2 * ‖candidate - parameter‖ ^ 2 := by positivity
  change decoupledPerformativeRisk model parameter parameter ≤
    decoupledPerformativeRisk model parameter candidate
  nlinarith

/--
On a convex domain, a performatively stable point is also a fixed point of the
projected-RGD update.  This is the converse half of the stable/fixed-point
bridge used by the Banach argument in Theorem 3.8.
-/
theorem repeatedGradientDescent_fixedPoint_of_isPerformativelyStableOn
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (project : Parameter → Parameter)
    (hproject : IsVariationalEuclideanProjectionOn domain project)
    (stepSize : ℝ) (hstepSize : 0 < stepSize) {parameter : Parameter}
    (hstable : IsPerformativelyStableOn model domain parameter) :
    repeatedGradientDescentUpdate model gradient project stepSize parameter = parameter := by
  have hfirstOrder := (isFrozenFirstOrderOptimal_on_of_hasGradientAt model gradient hgradientAt
    domain hconvex parameter parameter hstable).2
  have hprojected := projectedGradient_fixedPoint_of_firstOrder domain project hproject
    (frozenPopulationGradient model gradient parameter parameter) parameter hstable.1 stepSize hstepSize
    (fun candidate hcandidate => by
      have hfirst := hfirstOrder candidate hcandidate
      rw [frozenGradientPairing_eq_inner_frozenPopulationGradient, real_inner_comm] at hfirst
      exact hfirst)
  simpa [repeatedGradientDescentUpdate] using hprojected

/-- A general-law loss is uniformly Lipschitz in its parameter coordinate. -/
def IsMeasureParameterLossLipschitz {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (constant : NNReal) : Prop :=
  ∀ datum, LipschitzWith constant (model.loss datum)

/--
General W₁ sensitivity controls the data-law shift in a frozen expected loss.
This is the arbitrary-measure counterpart of the loss estimate used in PZ
Theorem 4.3 and Corollary 5.1.
-/
theorem abs_measureDecoupledPerformativeRisk_sub_le_of_wassersteinSensitive
    {Parameter Data : Type*} [MetricSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data) {constant : NNReal}
    (hloss : IsMeasureDataLossLipschitz model constant) {sensitivity : ℝ}
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (evaluated first second : Parameter) :
    |measureDecoupledPerformativeRisk model first evaluated -
        measureDecoupledPerformativeRisk model second evaluated| ≤
      (constant : ℝ) * (sensitivity * dist first second) := by
  rcases hsensitive first second with ⟨hfinite, hWasserstein⟩
  have htransport := ProbabilityCoupling.norm_integral_sub_le_lipschitz_wassersteinOneReal
    (μ := model.dataLaw first) (ν := model.dataLaw second) (f := fun datum => model.loss datum evaluated)
    (hloss evaluated) (model.loss_integrable first evaluated)
    (model.loss_integrable second evaluated) hfinite
  calc
    |measureDecoupledPerformativeRisk model first evaluated -
        measureDecoupledPerformativeRisk model second evaluated| ≤
        (constant : ℝ) * ProbabilityCoupling.wassersteinOneReal
          (model.dataLaw first) (model.dataLaw second) hfinite := by
      simpa only [measureDecoupledPerformativeRisk, Real.norm_eq_abs] using htransport
    _ ≤ (constant : ℝ) * (sensitivity * dist first second) :=
      mul_le_mul_of_nonneg_left hWasserstein (NNReal.coe_nonneg constant)

/-- Domain-restricted W₁ sensitivity controls the frozen-risk law shift when
the deployed and evaluated parameters lie in that domain. -/
theorem abs_measureDecoupledPerformativeRisk_sub_le_of_wassersteinSensitiveOn
    {Parameter Data : Type*} [MetricSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    {constant : NNReal} (hloss : IsMeasureDataLossLipschitzOn model domain constant)
    {sensitivity : ℝ} (hsensitive : IsMeasureWassersteinSensitiveOn model domain sensitivity)
    (evaluated : Parameter) (hevaluated : evaluated ∈ domain)
    (first : Parameter) (hfirst : first ∈ domain)
    (second : Parameter) (hsecond : second ∈ domain) :
    |measureDecoupledPerformativeRisk model first evaluated -
        measureDecoupledPerformativeRisk model second evaluated| ≤
      (constant : ℝ) * (sensitivity * dist first second) := by
  rcases hsensitive first hfirst second hsecond with ⟨hfinite, hWasserstein⟩
  have htransport := ProbabilityCoupling.norm_integral_sub_le_lipschitz_wassersteinOneReal
    (μ := model.dataLaw first) (ν := model.dataLaw second)
    (f := fun datum => model.loss datum evaluated)
    (hloss evaluated hevaluated) (model.loss_integrable first evaluated)
    (model.loss_integrable second evaluated) hfinite
  calc
    |measureDecoupledPerformativeRisk model first evaluated -
        measureDecoupledPerformativeRisk model second evaluated| ≤
        (constant : ℝ) * ProbabilityCoupling.wassersteinOneReal
          (model.dataLaw first) (model.dataLaw second) hfinite := by
      simpa only [measureDecoupledPerformativeRisk, Real.norm_eq_abs] using htransport
    _ ≤ (constant : ℝ) * (sensitivity * dist first second) :=
      mul_le_mul_of_nonneg_left hWasserstein (NNReal.coe_nonneg constant)

/--
At a fixed arbitrary data law, parameter-Lipschitz loss controls the change in
the frozen expected loss.
-/
theorem abs_measureDecoupledPerformativeRisk_parameter_sub_le_of_parameterLipschitz
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) {constant : NNReal}
    (hloss : IsMeasureParameterLossLipschitz model constant)
    (distributionParameter first second : Parameter) :
    |measureDecoupledPerformativeRisk model distributionParameter first -
        measureDecoupledPerformativeRisk model distributionParameter second| ≤
      (constant : ℝ) * ‖first - second‖ := by
  let μ : Measure Data := model.dataLaw distributionParameter
  have hfirst_integrable : Integrable (fun datum => model.loss datum first) μ :=
    model.loss_integrable distributionParameter first
  have hsecond_integrable : Integrable (fun datum => model.loss datum second) μ :=
    model.loss_integrable distributionParameter second
  have hdifference_integrable : Integrable (fun datum =>
      model.loss datum first - model.loss datum second) μ :=
    hfirst_integrable.sub hsecond_integrable
  have hconstant_integrable : Integrable (fun _ : Data =>
      (constant : ℝ) * ‖first - second‖) μ :=
    integrable_const _
  change |(∫ datum, model.loss datum first ∂μ) -
      ∫ datum, model.loss datum second ∂μ| ≤ (constant : ℝ) * ‖first - second‖
  rw [← integral_sub hfirst_integrable hsecond_integrable, ← Real.norm_eq_abs]
  calc
    ‖∫ datum, model.loss datum first - model.loss datum second ∂μ‖ ≤
        ∫ datum, ‖model.loss datum first - model.loss datum second‖ ∂μ :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ _ : Data, (constant : ℝ) * ‖first - second‖ ∂μ :=
      integral_mono_ae hdifference_integrable.norm hconstant_integrable
        (ae_of_all μ fun datum => by
          simpa only [Real.norm_eq_abs, dist_eq_norm] using
            (hloss datum).dist_le_mul first second)
    _ = (constant : ℝ) * ‖first - second‖ := by
      rw [integral_const, probReal_univ, one_smul]

/--
Joint Lipschitz continuity of arbitrary-law decoupled risk.  Data-coordinate
loss Lipschitzness and W₁ sensitivity control the deployed-law coordinate,
while parameter-coordinate loss Lipschitzness controls the evaluation
coordinate.  This is a reusable sufficient bridge for the continuity premise
in compact-convex performative-stability arguments.
-/
theorem lipschitzWith_measureDecoupledPerformativeRisk_of_wassersteinSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [MeasurableSpace Data]
    [MetricSpace Data] (model : MeasurePerformativeModel Parameter Data)
    {dataConstant parameterConstant : NNReal}
    (hdataLoss : IsMeasureDataLossLipschitz model dataConstant)
    (hparameterLoss : IsMeasureParameterLossLipschitz model parameterConstant)
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity) :
    LipschitzWith
      ⟨(dataConstant : ℝ) * sensitivity + (parameterConstant : ℝ), by positivity⟩
      (fun point : Parameter × Parameter =>
        measureDecoupledPerformativeRisk model point.1 point.2) := by
  refine LipschitzWith.of_dist_le_mul ?_
  intro first second
  have hdata := abs_measureDecoupledPerformativeRisk_sub_le_of_wassersteinSensitive
    model hdataLoss hsensitive first.2 first.1 second.1
  have hparameter := abs_measureDecoupledPerformativeRisk_parameter_sub_le_of_parameterLipschitz
    model hparameterLoss second.1 first.2 second.2
  have hdata' :
      |measureDecoupledPerformativeRisk model first.1 first.2 -
          measureDecoupledPerformativeRisk model second.1 first.2| ≤
        ((dataConstant : ℝ) * sensitivity) * dist first.1 second.1 := by
    simpa only [mul_assoc] using hdata
  have hparameter' :
      |measureDecoupledPerformativeRisk model second.1 first.2 -
          measureDecoupledPerformativeRisk model second.1 second.2| ≤
        (parameterConstant : ℝ) * dist first.2 second.2 := by
    simpa only [dist_eq_norm] using hparameter
  have hfirst_le : dist first.1 second.1 ≤ dist first second := by
    rw [Prod.dist_eq]
    exact le_max_left _ _
  have hsecond_le : dist first.2 second.2 ≤ dist first second := by
    rw [Prod.dist_eq]
    exact le_max_right _ _
  change |measureDecoupledPerformativeRisk model first.1 first.2 -
      measureDecoupledPerformativeRisk model second.1 second.2| ≤
    ((dataConstant : ℝ) * sensitivity + (parameterConstant : ℝ)) * dist first second
  calc
    |measureDecoupledPerformativeRisk model first.1 first.2 -
        measureDecoupledPerformativeRisk model second.1 second.2| =
        |(measureDecoupledPerformativeRisk model first.1 first.2 -
          measureDecoupledPerformativeRisk model second.1 first.2) +
          (measureDecoupledPerformativeRisk model second.1 first.2 -
            measureDecoupledPerformativeRisk model second.1 second.2)| := by
      congr 1
      ring
    _ ≤ |measureDecoupledPerformativeRisk model first.1 first.2 -
          measureDecoupledPerformativeRisk model second.1 first.2| +
        |measureDecoupledPerformativeRisk model second.1 first.2 -
          measureDecoupledPerformativeRisk model second.1 second.2| :=
      abs_add_le _ _
    _ ≤ ((dataConstant : ℝ) * sensitivity) * dist first.1 second.1 +
          (parameterConstant : ℝ) * dist first.2 second.2 :=
      add_le_add hdata' hparameter'
    _ ≤ ((dataConstant : ℝ) * sensitivity) * dist first second +
          (parameterConstant : ℝ) * dist first second := by
      gcongr
    _ = ((dataConstant : ℝ) * sensitivity + (parameterConstant : ℝ)) * dist first second := by
      ring

/--
The joint decoupled risk is continuous under the reusable data- and
parameter-coordinate loss Lipschitz bridges and W₁ sensitivity.
-/
theorem continuous_measureDecoupledPerformativeRisk_of_wassersteinSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [MeasurableSpace Data]
    [MetricSpace Data] (model : MeasurePerformativeModel Parameter Data)
    {dataConstant parameterConstant : NNReal}
    (hdataLoss : IsMeasureDataLossLipschitz model dataConstant)
    (hparameterLoss : IsMeasureParameterLossLipschitz model parameterConstant)
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity) :
    Continuous (fun point : Parameter × Parameter =>
      measureDecoupledPerformativeRisk model point.1 point.2) :=
  (lipschitzWith_measureDecoupledPerformativeRisk_of_wassersteinSensitive model hdataLoss
    hparameterLoss hsensitivity hsensitive).continuous

/--
An arbitrary-law compact-convex stable point obtained without a separate
joint-risk-continuity assumption.  Uniform coordinate-wise loss Lipschitz
bounds and W₁ sensitivity provide that continuity before the compact
best-response/Kakutani argument is applied.
-/
theorem exists_isMeasurePerformativelyStableOn_of_compact_convex_of_lossConvex_of_wassersteinLossLipschitz
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [NormedSpace ℝ Parameter]
    [FiniteDimensional ℝ Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (hcompact : IsCompact domain) (hne : domain.Nonempty) (hconvex : Convex ℝ domain)
    (hlossConvex : ∀ datum, ConvexOn ℝ domain (model.loss datum))
    {dataConstant parameterConstant : NNReal}
    (hdataLoss : IsMeasureDataLossLipschitz model dataConstant)
    (hparameterLoss : IsMeasureParameterLossLipschitz model parameterConstant)
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity) :
    ∃ parameter ∈ domain, IsMeasurePerformativelyStableOn model domain parameter :=
  exists_isMeasurePerformativelyStableOn_of_compact_convex_of_lossConvex model domain hcompact hne
    hconvex (continuous_measureDecoupledPerformativeRisk_of_wassersteinSensitive model hdataLoss
      hparameterLoss hsensitivity hsensitive) hlossConvex

namespace MeasurePerformativeModelOn

/-- Performative optimality for a model defined only on its parameter domain. -/
def IsPerformativelyOptimal
    {Parameter Data : Type*} [MeasurableSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (optimal : domain) : Prop :=
  ∀ candidate, model.performativeRisk optimal ≤ model.performativeRisk candidate

/-- Performative stability for a model defined only on its parameter domain. -/
def IsPerformativelyStable
    {Parameter Data : Type*} [MeasurableSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (stable : domain) : Prop :=
  ∀ candidate, model.decoupledPerformativeRisk stable stable ≤
    model.decoupledPerformativeRisk stable candidate

/-- Wasserstein sensitivity for a model defined only on its parameter domain. -/
def IsWassersteinSensitive
    {Parameter Data : Type*} [MetricSpace Parameter] [MeasurableSpace Data]
    [MetricSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (sensitivity : ℝ) : Prop :=
  ∀ first second,
    ∃ hfinite : (ProbabilityCoupling.expectedDistanceCosts
      (model.dataLaw first) (model.dataLaw second)).Nonempty,
      ProbabilityCoupling.wassersteinOneReal
          (model.dataLaw first) (model.dataLaw second) hfinite ≤
        sensitivity * dist (first : Parameter) (second : Parameter)

/-- Data-coordinate loss Lipschitzness on a model's parameter domain. -/
def IsDataLossLipschitz
    {Parameter Data : Type*} [MeasurableSpace Data] [MetricSpace Data]
    {domain : Set Parameter} (model : MeasurePerformativeModelOn Parameter Data domain)
    (constant : NNReal) : Prop :=
  ∀ parameter, LipschitzWith constant (fun datum => model.loss datum parameter)

/-- A2 uses the actual loss derivative on the feasible parameter domain.
The zero extension is read only along the domain; no off-domain loss value or
regularity is required. The lower-model inequality uses this same derivative. -/
def IsPointwiseGradientStronglyConvex
    {Parameter Data : Type*} [MeasurableSpace Data]
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    {domain : Set Parameter} (model : MeasurePerformativeModelOn Parameter Data domain)
    (gradient : Data → domain → Parameter) (modulus : ℝ) : Prop := by
  classical
  exact
    (∀ datum (center : domain),
      HasFDerivWithinAt
        (fun parameter => if hparameter : parameter ∈ domain then
          model.loss datum ⟨parameter, hparameter⟩ else 0)
        (innerSL ℝ (gradient datum center)) domain (center : Parameter)) ∧
    ∀ datum center candidate,
      model.loss datum candidate ≥
        model.loss datum center +
          ⟪gradient datum center, (candidate : Parameter) - (center : Parameter)⟫_ℝ +
            modulus / 2 * ‖(candidate : Parameter) - (center : Parameter)‖ ^ 2

/-- On-domain performative optimality is preserved by ambient extension. -/
theorem isMeasurePerformativelyOptimalOn_extend
    {Parameter Data : Type*} [MeasurableSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (anchor optimal : domain) (hoptimal : model.IsPerformativelyOptimal optimal) :
    IsMeasurePerformativelyOptimalOn (model.extend anchor) domain optimal := by
  refine ⟨optimal.property, ?_⟩
  intro candidate hcandidate
  let candidateOn : domain := ⟨candidate, hcandidate⟩
  rw [model.performativeRisk_extend anchor optimal,
    model.performativeRisk_extend anchor candidateOn]
  exact hoptimal candidateOn

/-- On-domain performative stability is preserved by ambient extension. -/
theorem isMeasurePerformativelyStableOn_extend
    {Parameter Data : Type*} [MeasurableSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (anchor stable : domain) (hstable : model.IsPerformativelyStable stable) :
    IsMeasurePerformativelyStableOn (model.extend anchor) domain stable := by
  refine ⟨stable.property, ?_⟩
  intro candidate hcandidate
  let candidateOn : domain := ⟨candidate, hcandidate⟩
  rw [model.decoupledPerformativeRisk_extend anchor stable stable,
    model.decoupledPerformativeRisk_extend anchor stable candidateOn]
  exact hstable candidateOn

/-- On-domain Wasserstein sensitivity is preserved by ambient extension. -/
theorem isMeasureWassersteinSensitiveOn_extend
    {Parameter Data : Type*} [MetricSpace Parameter] [MeasurableSpace Data]
    [MetricSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (anchor : domain) {sensitivity : ℝ}
    (hsensitive : model.IsWassersteinSensitive sensitivity) :
    IsMeasureWassersteinSensitiveOn (model.extend anchor) domain sensitivity := by
  intro first hfirst second hsecond
  let firstOn : domain := ⟨first, hfirst⟩
  let secondOn : domain := ⟨second, hsecond⟩
  rcases hsensitive firstOn secondOn with ⟨hfinite, hbound⟩
  refine ⟨?_, ?_⟩
  · simpa [extend, hfirst, hsecond] using hfinite
  · simpa [extend, hfirst, hsecond, firstOn, secondOn] using hbound

/-- On-domain data Lipschitzness is preserved by ambient extension. -/
theorem isMeasureDataLossLipschitzOn_extend
    {Parameter Data : Type*} [MeasurableSpace Data] [MetricSpace Data]
    {domain : Set Parameter} (model : MeasurePerformativeModelOn Parameter Data domain)
    (anchor : domain) {constant : NNReal}
    (hloss : model.IsDataLossLipschitz constant) :
    IsMeasureDataLossLipschitzOn (model.extend anchor) domain constant := by
  intro parameter hparameter
  simpa [extend, hparameter] using hloss (⟨parameter, hparameter⟩ : domain)

/-- On-domain A2 is preserved by extending its gradient at the same anchor. -/
theorem isMeasurePointwiseGradientStronglyConvexOn_extend
    {Parameter Data : Type*} [MeasurableSpace Data]
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    {domain : Set Parameter} (model : MeasurePerformativeModelOn Parameter Data domain)
    (gradient : Data → domain → Parameter) (anchor : domain) {modulus : ℝ}
    (hstrong : model.IsPointwiseGradientStronglyConvex gradient modulus) :
    IsMeasurePointwiseGradientStronglyConvexOn
      (model.extend anchor) (extendGradient gradient anchor) domain modulus := by
  intro datum center hcenter candidate hcandidate
  simpa [extend, extendGradient, hcenter, hcandidate] using
    hstrong.2 datum (⟨center, hcenter⟩ : domain) (⟨candidate, hcandidate⟩ : domain)

end MeasurePerformativeModelOn

/-- A domain-relative performative optimum and stable parameter lie within
`2 L_z ε / γ`. Pointwise A2 is averaged after its gradient terms cancel, so
the result needs neither differentiability nor gradient integrability. -/
theorem norm_measurePerformativelyOptimalOn_sub_measureStableOn_le_of_strongConvexOn_wasserstein
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (domain : Set Parameter)
    (hconvex : Convex ℝ domain)
    {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsMeasurePointwiseGradientStronglyConvexOn
      model gradient domain modulus)
    {constant : NNReal} (hloss : IsMeasureDataLossLipschitzOn model domain constant)
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitiveOn model domain sensitivity)
    (optimal stable : Parameter)
    (hoptimal : IsMeasurePerformativelyOptimalOn model domain optimal)
    (hstable : IsMeasurePerformativelyStableOn model domain stable) :
    ‖optimal - stable‖ ≤ 2 * (constant : ℝ) * sensitivity / modulus := by
  have hoptimal_le :
      measureDecoupledPerformativeRisk model optimal optimal ≤
        measureDecoupledPerformativeRisk model stable stable :=
    hoptimal.2 stable hstable.1
  have hquadratic_gap :
      modulus / 2 * ‖optimal - stable‖ ^ 2 ≤
        measureDecoupledPerformativeRisk model stable optimal -
          measureDecoupledPerformativeRisk model stable stable :=
    StrongConvexOn.quadratic_gap_le_of_isMinOn
      (strongConvexOn_measureDecoupledPerformativeRisk_of_pointwiseGradientStronglyConvexOn
        model gradient domain hconvex hstrong stable)
      hstable.1 hoptimal.1 (fun candidate hcandidate => hstable.2 candidate hcandidate)
  have hgap_le :
      measureDecoupledPerformativeRisk model stable optimal -
          measureDecoupledPerformativeRisk model stable stable ≤
        measureDecoupledPerformativeRisk model stable optimal -
          measureDecoupledPerformativeRisk model optimal optimal := by
    linarith
  have htransport :=
    abs_measureDecoupledPerformativeRisk_sub_le_of_wassersteinSensitiveOn
      model domain hloss hsensitive optimal hoptimal.1 stable hstable.1 optimal hoptimal.1
  have htransport_upper :
      measureDecoupledPerformativeRisk model stable optimal -
          measureDecoupledPerformativeRisk model optimal optimal ≤
        (constant : ℝ) * (sensitivity * dist stable optimal) :=
    le_trans (le_abs_self _) htransport
  have hquadratic :
      modulus / 2 * ‖optimal - stable‖ ^ 2 ≤
        (constant : ℝ) * sensitivity * ‖optimal - stable‖ := by
    rw [dist_eq_norm, norm_sub_rev] at htransport_upper
    nlinarith
  by_cases hzero : ‖optimal - stable‖ = 0
  · rw [hzero]
    positivity
  · have hpositive : 0 < ‖optimal - stable‖ :=
      lt_of_le_of_ne (norm_nonneg _) (Ne.symm hzero)
    have hcancel :
        modulus / 2 * ‖optimal - stable‖ ≤ (constant : ℝ) * sensitivity := by
      apply le_of_mul_le_mul_right _ hpositive
      calc
        (modulus / 2 * ‖optimal - stable‖) * ‖optimal - stable‖ =
            modulus / 2 * ‖optimal - stable‖ ^ 2 := by ring
        _ ≤ (constant : ℝ) * sensitivity * ‖optimal - stable‖ := hquadratic
    calc
      ‖optimal - stable‖ = (2 * (modulus / 2 * ‖optimal - stable‖)) / modulus := by
        field_simp
      _ ≤ (2 * ((constant : ℝ) * sensitivity)) / modulus := by
        exact div_le_div_of_nonneg_right
          (mul_le_mul_of_nonneg_left hcancel (by norm_num)) hmodulus.le
      _ = 2 * (constant : ℝ) * sensitivity / modulus := by ring

/-- The domain-only form of the derivative-free Wasserstein bound. The stable
parameter anchors an ambient extension, whose off-domain loss is zero; all
on-domain risks and hypotheses are preserved by the extension lemmas above. -/
theorem MeasurePerformativeModelOn.norm_optimal_sub_stable_le_of_strongConvex_wasserstein
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MeasurableSpace Data] [MetricSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (gradient : Data → domain → Parameter)
    (hconvex : Convex ℝ domain)
    {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : model.IsPointwiseGradientStronglyConvex gradient modulus)
    {constant : NNReal} (hloss : model.IsDataLossLipschitz constant)
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : model.IsWassersteinSensitive sensitivity)
    (optimal stable : domain)
    (hoptimal : model.IsPerformativelyOptimal optimal)
    (hstable : model.IsPerformativelyStable stable) :
    ‖(optimal : Parameter) - (stable : Parameter)‖ ≤
      2 * (constant : ℝ) * sensitivity / modulus := by
  apply norm_measurePerformativelyOptimalOn_sub_measureStableOn_le_of_strongConvexOn_wasserstein
    (model.extend stable) (extendGradient gradient stable) domain hconvex hmodulus
    (model.isMeasurePointwiseGradientStronglyConvexOn_extend gradient stable hstrong)
    (model.isMeasureDataLossLipschitzOn_extend stable hloss) hsensitivity
    (model.isMeasureWassersteinSensitiveOn_extend stable hsensitive)
      optimal stable
    (model.isMeasurePerformativelyOptimalOn_extend stable optimal hoptimal)
    (model.isMeasurePerformativelyStableOn_extend stable stable hstable)

/--
Compatibility form of the arbitrary-law Wasserstein bound with an explicit
frozen-risk derivative. New callers that only need Theorem 4.3 should use the
derivative-free pointwise-strong-convexity theorem above.
-/
theorem norm_measurePerformativelyOptimal_sub_measureStable_le_of_strongConvex_wasserstein
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {constant : NNReal} (hloss : IsMeasureDataLossLipschitz model constant)
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (optimal stable : Parameter)
    (hoptimal : IsMeasurePerformativelyOptimal model optimal)
    (hstable : IsMeasurePerformativelyStable model stable) :
    ‖optimal - stable‖ ≤ 2 * (constant : ℝ) * sensitivity / modulus := by
  have hoptimal_le :
      measureDecoupledPerformativeRisk model optimal optimal ≤
        measureDecoupledPerformativeRisk model stable stable :=
    hoptimal stable
  have hstable_le :
      measureDecoupledPerformativeRisk model stable stable ≤
        measureDecoupledPerformativeRisk model stable optimal :=
    hstable optimal
  have hfirstOrderRaw := isMeasureFrozenGradientFirstOrderOptimalOn_of_hasGradientAt
    model gradient Set.univ convex_univ stable stable
      ⟨Set.mem_univ stable, fun candidate _ => hstable candidate⟩ (hgradientAt stable stable)
  have hfirstOrder :
      0 ≤ ⟪optimal - stable,
        measureFrozenPopulationGradient model gradient stable stable⟫_ℝ :=
    hfirstOrderRaw optimal (Set.mem_univ optimal)
  have hlower := measureFrozenRisk_strongConvex_lowerBound model gradient hstrong hintegrable
    stable stable optimal
  have hquadratic_gap :
      modulus / 2 * ‖optimal - stable‖ ^ 2 ≤
        measureDecoupledPerformativeRisk model stable optimal -
          measureDecoupledPerformativeRisk model stable stable := by
    nlinarith
  have hgap_le :
      measureDecoupledPerformativeRisk model stable optimal -
          measureDecoupledPerformativeRisk model stable stable ≤
        measureDecoupledPerformativeRisk model stable optimal -
          measureDecoupledPerformativeRisk model optimal optimal := by
    nlinarith
  have htransport := abs_measureDecoupledPerformativeRisk_sub_le_of_wassersteinSensitive
    model hloss hsensitive optimal stable optimal
  have htransport_upper :
      measureDecoupledPerformativeRisk model stable optimal -
          measureDecoupledPerformativeRisk model optimal optimal ≤
        (constant : ℝ) * (sensitivity * dist stable optimal) :=
    le_trans (le_abs_self _) htransport
  have hquadratic :
      modulus / 2 * ‖optimal - stable‖ ^ 2 ≤
        (constant : ℝ) * sensitivity * ‖optimal - stable‖ := by
    rw [dist_comm, dist_eq_norm] at htransport_upper
    nlinarith
  by_cases hzero : ‖optimal - stable‖ = 0
  · rw [hzero]
    positivity
  · have hpositive : 0 < ‖optimal - stable‖ :=
      lt_of_le_of_ne (norm_nonneg _) (Ne.symm hzero)
    have hcancel :
        modulus / 2 * ‖optimal - stable‖ ≤ (constant : ℝ) * sensitivity := by
      apply le_of_mul_le_mul_right _ hpositive
      calc
        (modulus / 2 * ‖optimal - stable‖) * ‖optimal - stable‖ =
            modulus / 2 * ‖optimal - stable‖ ^ 2 := by ring
        _ ≤ (constant : ℝ) * sensitivity * ‖optimal - stable‖ := hquadratic
    calc
      ‖optimal - stable‖ = (2 * (modulus / 2 * ‖optimal - stable‖)) / modulus := by
        field_simp
      _ ≤ (2 * ((constant : ℝ) * sensitivity)) / modulus := by
        exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hcancel (by norm_num))
          hmodulus.le
      _ = 2 * (constant : ℝ) * sensitivity / modulus := by ring

/--
Arbitrary-law Wasserstein realization of Corollary 5.1.  Combining the
Theorem 4.3 distance estimate with data- and parameter-coordinate Lipschitz
loss bounds yields the source objective-gap constant.
-/
theorem measurePerformativeRisk_sub_measurePerformativelyOptimal_le_of_stable_wasserstein
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {dataConstant parameterConstant : NNReal}
    (hdataLoss : IsMeasureDataLossLipschitz model dataConstant)
    (hparameterLoss : IsMeasureParameterLossLipschitz model parameterConstant)
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (optimal stable : Parameter)
    (hoptimal : IsMeasurePerformativelyOptimal model optimal)
    (hstable : IsMeasurePerformativelyStable model stable) :
    measurePerformativeRisk model stable - measurePerformativeRisk model optimal ≤
      2 * (dataConstant : ℝ) * sensitivity *
        ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) / modulus := by
  have hdistance := norm_measurePerformativelyOptimal_sub_measureStable_le_of_strongConvex_wasserstein
    model gradient hgradientAt hmodulus hstrong hintegrable hdataLoss hsensitivity hsensitive optimal stable
      hoptimal hstable
  rw [norm_sub_rev] at hdistance
  have hparameter := abs_measureDecoupledPerformativeRisk_parameter_sub_le_of_parameterLipschitz
    model hparameterLoss stable stable optimal
  have hparameterUpper :
      measureDecoupledPerformativeRisk model stable stable -
          measureDecoupledPerformativeRisk model stable optimal ≤
        (parameterConstant : ℝ) * ‖stable - optimal‖ :=
    le_trans (le_abs_self _) hparameter
  have hdata := abs_measureDecoupledPerformativeRisk_sub_le_of_wassersteinSensitive
    model hdataLoss hsensitive optimal stable optimal
  have hdataUpper :
      measureDecoupledPerformativeRisk model stable optimal -
          measureDecoupledPerformativeRisk model optimal optimal ≤
        (dataConstant : ℝ) * (sensitivity * dist stable optimal) :=
    le_trans (le_abs_self _) hdata
  have hcoefficient_nonneg :
      0 ≤ (parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity := by positivity
  calc
    measurePerformativeRisk model stable - measurePerformativeRisk model optimal =
        (measureDecoupledPerformativeRisk model stable stable -
          measureDecoupledPerformativeRisk model stable optimal) +
        (measureDecoupledPerformativeRisk model stable optimal -
          measureDecoupledPerformativeRisk model optimal optimal) := by
      change measureDecoupledPerformativeRisk model stable stable -
          measureDecoupledPerformativeRisk model optimal optimal = _
      ring
    _ ≤ (parameterConstant : ℝ) * ‖stable - optimal‖ +
          (dataConstant : ℝ) * (sensitivity * dist stable optimal) :=
      add_le_add hparameterUpper hdataUpper
    _ = ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) *
          ‖stable - optimal‖ := by
      rw [dist_eq_norm]
      ring
    _ ≤ ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) *
          (2 * (dataConstant : ℝ) * sensitivity / modulus) :=
      mul_le_mul_of_nonneg_left hdistance hcoefficient_nonneg
    _ = 2 * (dataConstant : ℝ) * sensitivity *
          ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) / modulus := by
      ring

/-- A loss is uniformly Lipschitz in the data coordinate. -/
def IsDataLossLipschitz {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) (constant : NNReal) : Prop :=
  ∀ parameter, LipschitzWith constant (fun datum => model.loss datum parameter)

/-- A loss is uniformly Lipschitz in the parameter coordinate. -/
def IsParameterLossLipschitz {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] [NormedAddCommGroup Parameter]
    (model : FinitePerformativeModel Parameter Data) (constant : NNReal) : Prop :=
  ∀ datum, LipschitzWith constant (model.loss datum)

/--
Finite-PMF transport version of the source's data-Lipschitz loss estimate.
It controls the effect of changing the induced data law while holding the
evaluation parameter fixed.
-/
theorem abs_decoupledPerformativeRisk_sub_le_of_finiteTransportSensitive
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    [MetricSpace Parameter] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) {constant : NNReal}
    (hloss : IsDataLossLipschitz model constant) {sensitivity : ℝ}
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (evaluated first second : Parameter) :
    |decoupledPerformativeRisk model first evaluated -
        decoupledPerformativeRisk model second evaluated| ≤
      (constant : ℝ) * (sensitivity * dist first second) := by
  exact abs_pmfExp_dataLaw_sub_le_of_finiteTransportSensitive model hsensitive
    (hloss evaluated) first second

/--
Finite-W₁ version of the data-Lipschitz loss estimate.  It controls frozen-risk
change without selecting a primal coupling witness.
-/
theorem abs_decoupledPerformativeRisk_sub_le_of_finiteWassersteinSensitive
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    [MetricSpace Parameter] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) {constant : NNReal}
    (hloss : IsDataLossLipschitz model constant) {sensitivity : ℝ}
    (hsensitive : IsFiniteWassersteinSensitive model sensitivity)
    (evaluated first second : Parameter) :
    |decoupledPerformativeRisk model first evaluated -
        decoupledPerformativeRisk model second evaluated| ≤
      (constant : ℝ) * (sensitivity * dist first second) := by
  exact abs_pmfExp_dataLaw_sub_le_of_finiteWassersteinSensitive model hsensitive
    (hloss evaluated) first second

/--
At a fixed data law, parameter-Lipschitz loss controls the change in decoupled
performative risk between two evaluation parameters.
-/
theorem abs_decoupledPerformativeRisk_parameter_sub_le_of_parameterLipschitz
    {Parameter Data : Type*} [NormedAddCommGroup Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) {constant : NNReal}
    (hloss : IsParameterLossLipschitz model constant)
    (distributionParameter first second : Parameter) :
    |decoupledPerformativeRisk model distributionParameter first -
        decoupledPerformativeRisk model distributionParameter second| ≤
      (constant : ℝ) * ‖first - second‖ := by
  exact FiniteCoupling.abs_pmfExp_sub_le_of_forall_abs_sub_le
    (model.dataLaw distributionParameter) (fun datum => model.loss datum first)
    (fun datum => model.loss datum second) ((constant : ℝ) * ‖first - second‖)
    (fun datum => by
      simpa only [dist_eq_norm] using (hloss datum).dist_le_mul first second)

/-- A finite parameter domain has a minimizer for risk under any fixed data law. -/
theorem exists_populationRiskMinimizer
    {Parameter Data : Type*} [Fintype Parameter] [Nonempty Parameter]
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (law : PMF Data) :
    ∃ parameter, IsPopulationRiskMinimizer model law parameter := by
  obtain ⟨parameter, _, hminimum⟩ :=
    Optimization.exists_isMinimizerOn_of_finite (fun _ : Parameter => True)
      (fun candidate => pmfExp law (fun datum => model.loss datum candidate))
      (by exact ⟨Classical.choice inferInstance, trivial⟩)
  exact ⟨parameter, fun candidate => hminimum candidate trivial⟩

/-- A fixed finite-domain selection from the population-risk argmin. -/
noncomputable def selectedPopulationRiskMinimizer
    {Parameter Data : Type*} [Fintype Parameter] [Nonempty Parameter]
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (law : PMF Data) : Parameter :=
  Classical.choose (exists_populationRiskMinimizer model law)

/-- The selected population-risk minimizer satisfies the argmin specification. -/
theorem selectedPopulationRiskMinimizer_spec
    {Parameter Data : Type*} [Fintype Parameter] [Nonempty Parameter]
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (law : PMF Data) :
    IsPopulationRiskMinimizer model law (selectedPopulationRiskMinimizer model law) :=
  Classical.choose_spec (exists_populationRiskMinimizer model law)

/-- A performatively stable parameter minimizes decoupled risk at its own law. -/
def IsPerformativelyStable {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (parameter : Parameter) : Prop :=
  IsPopulationRiskMinimizer model (model.dataLaw parameter) parameter

theorem isPerformativelyStable_iff {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (parameter : Parameter) :
    IsPerformativelyStable model parameter ↔
      ∀ candidate,
      decoupledPerformativeRisk model parameter parameter ≤
          decoupledPerformativeRisk model parameter candidate :=
  Iff.rfl

