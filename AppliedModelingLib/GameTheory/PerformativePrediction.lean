    {Outcome Parameter Data : Type*} [MeasurableSpace Outcome]
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (law : Measure Outcome) [IsProbabilityMeasure law]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (project : Parameter → Parameter) (hproject : LipschitzWith 1 project)
    (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    (sampleCount : ℕ → ℕ) (hsampleCount : ∀ iteration, 0 < sampleCount iteration)
    (samples : Outcome → (iteration : ℕ) → Fin (sampleCount iteration) → Data)
    (trajectory : Outcome → ℕ → Parameter)
    (htrajectory : ∀ outcome,
      IsRepeatedEmpiricalGradientDescentTrajectory gradient project stepSize sampleCount
        (samples outcome) (trajectory outcome))
    (stable : Parameter) {contraction wassersteinBound radius : ℝ} (horizon : ℕ)
    (hcontraction_nonneg : 0 ≤ contraction)
    (hstable : repeatedGradientDescentUpdate model gradient project stepSize stable = stable)
    (hcontract : ∀ parameter,
      dist (repeatedGradientDescentUpdate model gradient project stepSize parameter)
        (repeatedGradientDescentUpdate model gradient project stepSize stable) ≤
          contraction * dist parameter stable)
    (hWasserstein_measurable : ∀ iteration, iteration ∈ Finset.range horizon →
      MeasurableSet {outcome | FiniteCoupling.finiteWassersteinOne
        (empiricalSampleLawOfPos (hsampleCount iteration) (samples outcome iteration))
        (model.dataLaw (trajectory outcome iteration)) ≤ wassersteinBound})
    (hinitial : ∀ outcome, dist (trajectory outcome 0) stable ≤ radius)
    (herror_absorbed : stepSize * (smoothness : ℝ) * wassersteinBound ≤
      (1 - contraction) * radius) :
    1 - ∑ iteration ∈ Finset.range horizon, measureProb law (fun outcome =>
      ¬ FiniteCoupling.finiteWassersteinOne
        (empiricalSampleLawOfPos (hsampleCount iteration) (samples outcome iteration))
        (model.dataLaw (trajectory outcome iteration)) ≤ wassersteinBound) ≤
      measureProb law (fun outcome => ∀ iteration, iteration ≤ horizon →
        dist (trajectory outcome iteration) stable ≤ radius) := by
  classical
  let good : ℕ → Outcome → Prop := fun iteration outcome =>
    FiniteCoupling.finiteWassersteinOne
      (empiricalSampleLawOfPos (hsampleCount iteration) (samples outcome iteration))
      (model.dataLaw (trajectory outcome iteration)) ≤ wassersteinBound
  have hgood_measurable : ∀ iteration ∈ Finset.range horizon,
      MeasurableSet {outcome | good iteration outcome} := by
    intro iteration hiteration
    simpa [good] using hWasserstein_measurable iteration hiteration
  have hgood_probability := measureProb_inter_ge_one_sub_sum_compl law
    (Finset.range horizon) good hgood_measurable
  have hgood_implies : ∀ outcome,
      (∀ iteration ∈ Finset.range horizon, good iteration outcome) →
      (∀ iteration, iteration ≤ horizon →
        dist (trajectory outcome iteration) stable ≤ radius) := by
    intro outcome hgood iteration hiteration
    apply dist_repeatedEmpiricalGradientDescentTrajectory_le_radius_up_to_of_gradientError
      model gradient project hproject stepSize hstepSize sampleCount (samples outcome)
      (trajectory outcome) (htrajectory outcome) stable horizon hcontraction_nonneg hstable hcontract
    · intro round hround
      letI : Nonempty (Fin (sampleCount round)) := Fin.pos_iff_nonempty.mp
        (hsampleCount round)
      simpa only [empiricalSampleLawOfPos_eq_empiricalSampleLaw] using
        (norm_empiricalPopulationGradient_sub_frozenPopulationGradient_le_of_finiteWassersteinOne
          model gradient hjoint (samples outcome round) (trajectory outcome round)
          (hgood round (Finset.mem_range.mpr hround)))
    · exact hinitial outcome
    · simpa [mul_assoc] using herror_absorbed
    · exact hiteration
  calc
    1 - ∑ iteration ∈ Finset.range horizon, measureProb law (fun outcome =>
        ¬ FiniteCoupling.finiteWassersteinOne
          (empiricalSampleLawOfPos (hsampleCount iteration) (samples outcome iteration))
          (model.dataLaw (trajectory outcome iteration)) ≤ wassersteinBound) =
        1 - ∑ iteration ∈ Finset.range horizon,
          measureProb law (fun outcome => ¬ good iteration outcome) := by
            simp [good]
    _ ≤ measureProb law (fun outcome => ∀ iteration ∈ Finset.range horizon,
        good iteration outcome) := hgood_probability
    _ ≤ measureProb law (fun outcome => ∀ iteration, iteration ≤ horizon →
        dist (trajectory outcome iteration) stable ≤ radius) :=
      measureProb_mono law _ _ hgood_implies

/--
The finite-horizon form of the same deterministic empirical-RGD argument.
It retains the geometric sum so it applies without dividing by `1 - q`.
-/
theorem dist_repeatedEmpiricalGradientDescentTrajectory_le_geometric_sum_of_gradientError
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (hproject : LipschitzWith 1 project) (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    (sampleCount : ℕ → ℕ)
    (samples : (iteration : ℕ) → Fin (sampleCount iteration) → Data)
    (trajectory : ℕ → Parameter)
    (htrajectory : IsRepeatedEmpiricalGradientDescentTrajectory gradient project stepSize
      sampleCount samples trajectory)
    (stable : Parameter) {contraction gradientError : ℝ}
    (hcontraction_nonneg : 0 ≤ contraction)
    (hstable : repeatedGradientDescentUpdate model gradient project stepSize stable = stable)
    (hcontract : ∀ parameter,
      dist (repeatedGradientDescentUpdate model gradient project stepSize parameter)
        (repeatedGradientDescentUpdate model gradient project stepSize stable) ≤
          contraction * dist parameter stable)
    (hgradientError : ∀ iteration,
      ‖empiricalPopulationGradient gradient (samples iteration) (trajectory iteration) -
          frozenPopulationGradient model gradient (trajectory iteration) (trajectory iteration)‖ ≤
        gradientError) :
    ∀ iteration, dist (trajectory iteration) stable ≤
      contraction ^ iteration * dist (trajectory 0) stable +
        (stepSize * gradientError) *
          ∑ index ∈ Finset.range iteration, contraction ^ index := by
  apply Optimization.affine_recurrence_le_geometric_sum hcontraction_nonneg
  intro iteration
  have hperturb : dist (trajectory (iteration + 1))
      (repeatedGradientDescentUpdate model gradient project stepSize
        (trajectory iteration)) ≤ stepSize * gradientError := by
      rw [htrajectory iteration, dist_eq_norm]
      calc
        ‖repeatedEmpiricalGradientDescentUpdate gradient project stepSize (samples iteration)
            (trajectory iteration) -
            repeatedGradientDescentUpdate model gradient project stepSize
              (trajectory iteration)‖ ≤
            stepSize * ‖empiricalPopulationGradient gradient (samples iteration)
              (trajectory iteration) - frozenPopulationGradient model gradient
                (trajectory iteration) (trajectory iteration)‖ :=
          norm_repeatedEmpiricalGradientDescentUpdate_sub_repeatedGradientDescentUpdate_le
            model gradient project hproject stepSize hstepSize (samples iteration)
            (trajectory iteration)
        _ ≤ stepSize * gradientError :=
          mul_le_mul_of_nonneg_left (hgradientError iteration) hstepSize
  calc
    dist (trajectory (iteration + 1)) stable ≤
        dist (trajectory (iteration + 1))
          (repeatedGradientDescentUpdate model gradient project stepSize
            (trajectory iteration)) +
          dist (repeatedGradientDescentUpdate model gradient project stepSize
            (trajectory iteration)) stable := by
              simpa [hstable] using dist_triangle (trajectory (iteration + 1))
                (repeatedGradientDescentUpdate model gradient project stepSize
                  (trajectory iteration))
                (repeatedGradientDescentUpdate model gradient project stepSize stable)
    _ ≤ stepSize * gradientError + contraction * dist (trajectory iteration) stable := by
      exact add_le_add hperturb (by simpa [hstable] using hcontract (trajectory iteration))
    _ = contraction * dist (trajectory iteration) stable + stepSize * gradientError := by ring

/--
A conservative squared-distance estimate for projected repeated gradient
descent.  It follows only from the source's coordinate-wise smoothness,
strong convexity, finite transport sensitivity, and nonexpansiveness of the
projection.  The sharper Theorem 3.8 coefficient additionally uses its cited
smooth-strongly-convex interpolation lemma.
-/
theorem sq_norm_repeatedGradientDescentUpdate_sub_le_of_jointSmooth_transport
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsJointlySmoothGradient gradient smoothness)
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (project : Parameter → Parameter) (hproject : LipschitzWith 1 project)
    (stepSize : ℝ) (hstepSize : 0 ≤ stepSize) (first second : Parameter) :
    ‖repeatedGradientDescentUpdate model gradient project stepSize first -
        repeatedGradientDescentUpdate model gradient project stepSize second‖ ^ 2 ≤
      (1 - 2 * stepSize * (modulus - (smoothness : ℝ) * sensitivity) +
        stepSize ^ 2 * ((smoothness : ℝ) * (sensitivity + 1)) ^ 2) *
          ‖first - second‖ ^ 2 := by
  let displacement := first - second
  let gradientShift := frozenPopulationGradient model gradient first first -
    frozenPopulationGradient model gradient second second
  have hmonotone := diagonalFrozenPopulationGradient_strongMonotone_of_jointSmooth_transport
    model gradient hgradient hsensitivity hsensitive hstrong first second
  have hmonotone' :
      (modulus - (smoothness : ℝ) * sensitivity) * ‖displacement‖ ^ 2 ≤
        ⟪displacement, gradientShift⟫_ℝ := by
    simpa [displacement, gradientShift] using hmonotone
  have hgradientNorm := norm_diagonalFrozenPopulationGradient_sub_le_of_jointSmooth_transport
    model gradient hgradient hsensitivity hsensitive first second
  have hgradientNorm' :
      ‖gradientShift‖ ≤ (smoothness : ℝ) * (sensitivity + 1) * ‖displacement‖ := by
    simpa [displacement, gradientShift] using hgradientNorm
  have hgradientBoundNonneg :
      0 ≤ (smoothness : ℝ) * (sensitivity + 1) * ‖displacement‖ := by positivity
  have hgradientSq :
      ‖gradientShift‖ ^ 2 ≤
        ((smoothness : ℝ) * (sensitivity + 1) * ‖displacement‖) ^ 2 := by
    exact (sq_le_sq₀ (norm_nonneg _) hgradientBoundNonneg).mpr hgradientNorm'
  have hraw :
      ‖(first - stepSize • frozenPopulationGradient model gradient first first) -
          (second - stepSize • frozenPopulationGradient model gradient second second)‖ ^ 2 ≤
        (1 - 2 * stepSize * (modulus - (smoothness : ℝ) * sensitivity) +
          stepSize ^ 2 * ((smoothness : ℝ) * (sensitivity + 1)) ^ 2) *
          ‖first - second‖ ^ 2 := by
    have hexpand :
        ‖(first - stepSize • frozenPopulationGradient model gradient first first) -
            (second - stepSize • frozenPopulationGradient model gradient second second)‖ ^ 2 =
          ‖displacement‖ ^ 2 - 2 * stepSize * ⟪displacement, gradientShift⟫_ℝ +
            stepSize ^ 2 * ‖gradientShift‖ ^ 2 := by
      rw [show (first - stepSize • frozenPopulationGradient model gradient first first) -
          (second - stepSize • frozenPopulationGradient model gradient second second) =
          displacement - stepSize • gradientShift by
            simp only [displacement, gradientShift, smul_sub]
            abel, norm_sub_sq_real, real_inner_smul_right, norm_smul,
        Real.norm_eq_abs, abs_of_nonneg hstepSize]
      ring
    rw [hexpand]
    nlinarith
  have hprojected :
      ‖project (first - stepSize • frozenPopulationGradient model gradient first first) -
          project (second - stepSize • frozenPopulationGradient model gradient second second)‖ ≤
        ‖(first - stepSize • frozenPopulationGradient model gradient first first) -
          (second - stepSize • frozenPopulationGradient model gradient second second)‖ := by
    simpa only [dist_eq_norm, NNReal.coe_one, one_mul] using
      hproject.dist_le_mul
        (first - stepSize • frozenPopulationGradient model gradient first first)
        (second - stepSize • frozenPopulationGradient model gradient second second)
  have hprojectedSq :
      ‖project (first - stepSize • frozenPopulationGradient model gradient first first) -
          project (second - stepSize • frozenPopulationGradient model gradient second second)‖ ^ 2 ≤
        ‖(first - stepSize • frozenPopulationGradient model gradient first first) -
          (second - stepSize • frozenPopulationGradient model gradient second second)‖ ^ 2 := by
    exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr hprojected
  exact hprojectedSq.trans hraw

/--
The squared contraction estimate in Appendix E.3 underlying Theorem 3.8.
Unlike the conservative estimate above, it retains the source's
interpolation coefficient.  The conversion from this squared estimate to the
paper's displayed norm rate is kept separate.
-/
theorem sq_norm_repeatedGradientDescentUpdate_sub_le_of_interpolation_transport
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (hmodulus : 0 < modulus) (hmodulus_le : modulus ≤ (smoothness : ℝ))
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (project : Parameter → Parameter) (hproject : LipschitzWith 1 project)
    (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    (hstepSize_le : stepSize ≤ 2 / (modulus + (smoothness : ℝ)))
    (first second : Parameter) :
    ‖repeatedGradientDescentUpdate model gradient project stepSize first -
        repeatedGradientDescentUpdate model gradient project stepSize second‖ ^ 2 ≤
      (1 + stepSize ^ 2 * (sensitivity ^ 2 * (smoothness : ℝ) ^ 2 +
          2 * (smoothness : ℝ) ^ 2 * sensitivity) -
        2 * stepSize * (modulus * (smoothness : ℝ) /
          (modulus + (smoothness : ℝ))) +
        2 * stepSize * (smoothness : ℝ) * sensitivity) * ‖first - second‖ ^ 2 := by
  let displacement := first - second
  let gradientShift := frozenPopulationGradient model gradient first first -
    frozenPopulationGradient model gradient second second
  let parameterShift := frozenPopulationGradient model gradient second first -
    frozenPopulationGradient model gradient second second
  have hinterpolation := diagonalFrozenPopulationGradient_interpolation_of_jointSmooth_transport
    model gradient hjoint hgradientAt hsensitivity hsensitive hmodulus hmodulus_le hstrong first second
  have hinterpolation' :
      (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
          (smoothness : ℝ) * sensitivity) * ‖displacement‖ ^ 2 +
        (1 / (modulus + (smoothness : ℝ))) * ‖parameterShift‖ ^ 2 ≤
        ⟪displacement, gradientShift⟫_ℝ := by
    simpa [displacement, gradientShift, parameterShift] using hinterpolation
  have hgradientSq := sq_norm_diagonalFrozenPopulationGradient_sub_le_of_jointSmooth_transport
    model gradient hjoint hsensitivity hsensitive first second
  have hgradientSq' : ‖gradientShift‖ ^ 2 ≤
      ((smoothness : ℝ) ^ 2 * sensitivity ^ 2 +
        2 * (smoothness : ℝ) ^ 2 * sensitivity) * ‖displacement‖ ^ 2 +
        ‖parameterShift‖ ^ 2 := by
    simpa [displacement, gradientShift, parameterShift] using hgradientSq
  have hpairScaled :
      -2 * stepSize * ⟪displacement, gradientShift⟫_ℝ ≤
        -2 * stepSize *
          ((modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
            (smoothness : ℝ) * sensitivity) * ‖displacement‖ ^ 2 +
            (1 / (modulus + (smoothness : ℝ))) * ‖parameterShift‖ ^ 2) := by
    have hscaled := mul_le_mul_of_nonneg_left hinterpolation' (by positivity : 0 ≤ 2 * stepSize)
    convert neg_le_neg hscaled using 1 <;> ring
  have hgradientScaled : stepSize ^ 2 * ‖gradientShift‖ ^ 2 ≤
      stepSize ^ 2 *
        (((smoothness : ℝ) ^ 2 * sensitivity ^ 2 +
          2 * (smoothness : ℝ) ^ 2 * sensitivity) * ‖displacement‖ ^ 2 +
          ‖parameterShift‖ ^ 2) := by
    exact mul_le_mul_of_nonneg_left hgradientSq' (sq_nonneg stepSize)
  have hdenominator_pos : 0 < modulus + (smoothness : ℝ) := by positivity
  have hstepSizeSq : stepSize ^ 2 ≤ 2 * stepSize / (modulus + (smoothness : ℝ)) := by
    have hscaled := mul_le_mul_of_nonneg_left hstepSize_le hstepSize
    calc
      stepSize ^ 2 = stepSize * stepSize := by ring
      _ ≤ stepSize * (2 / (modulus + (smoothness : ℝ))) := hscaled
      _ = 2 * stepSize / (modulus + (smoothness : ℝ)) := by ring
  have hstepSizeSqScaled : stepSize ^ 2 * ‖parameterShift‖ ^ 2 ≤
      (2 * stepSize / (modulus + (smoothness : ℝ))) * ‖parameterShift‖ ^ 2 := by
    exact mul_le_mul_of_nonneg_right hstepSizeSq (sq_nonneg _)
  have hraw :
      ‖(first - stepSize • frozenPopulationGradient model gradient first first) -
          (second - stepSize • frozenPopulationGradient model gradient second second)‖ ^ 2 ≤
        (1 + stepSize ^ 2 * (sensitivity ^ 2 * (smoothness : ℝ) ^ 2 +
            2 * (smoothness : ℝ) ^ 2 * sensitivity) -
          2 * stepSize * (modulus * (smoothness : ℝ) /
            (modulus + (smoothness : ℝ))) +
          2 * stepSize * (smoothness : ℝ) * sensitivity) * ‖first - second‖ ^ 2 := by
    have hexpand :
        ‖(first - stepSize • frozenPopulationGradient model gradient first first) -
            (second - stepSize • frozenPopulationGradient model gradient second second)‖ ^ 2 =
          ‖displacement‖ ^ 2 - 2 * stepSize * ⟪displacement, gradientShift⟫_ℝ +
            stepSize ^ 2 * ‖gradientShift‖ ^ 2 := by
      rw [show (first - stepSize • frozenPopulationGradient model gradient first first) -
          (second - stepSize • frozenPopulationGradient model gradient second second) =
          displacement - stepSize • gradientShift by
            simp only [displacement, gradientShift, smul_sub]
            abel, norm_sub_sq_real, real_inner_smul_right, norm_smul,
        Real.norm_eq_abs, abs_of_nonneg hstepSize]
      ring
    rw [hexpand]
    have hsumBound := add_le_add hpairScaled hgradientScaled
    calc
      ‖displacement‖ ^ 2 - 2 * stepSize * ⟪displacement, gradientShift⟫_ℝ +
          stepSize ^ 2 * ‖gradientShift‖ ^ 2 ≤
          ‖displacement‖ ^ 2 - 2 * stepSize *
            ((modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
              (smoothness : ℝ) * sensitivity) * ‖displacement‖ ^ 2 +
              (1 / (modulus + (smoothness : ℝ))) * ‖parameterShift‖ ^ 2) +
            stepSize ^ 2 *
              (((smoothness : ℝ) ^ 2 * sensitivity ^ 2 +
                2 * (smoothness : ℝ) ^ 2 * sensitivity) * ‖displacement‖ ^ 2 +
                ‖parameterShift‖ ^ 2) := by
            nlinarith [hsumBound]
      _ = (1 + stepSize ^ 2 * (sensitivity ^ 2 * (smoothness : ℝ) ^ 2 +
            2 * (smoothness : ℝ) ^ 2 * sensitivity) -
          2 * stepSize * (modulus * (smoothness : ℝ) /
            (modulus + (smoothness : ℝ))) +
          2 * stepSize * (smoothness : ℝ) * sensitivity) * ‖displacement‖ ^ 2 +
          (stepSize ^ 2 - 2 * stepSize / (modulus + (smoothness : ℝ))) *
            ‖parameterShift‖ ^ 2 := by ring
      _ ≤ (1 + stepSize ^ 2 * (sensitivity ^ 2 * (smoothness : ℝ) ^ 2 +
            2 * (smoothness : ℝ) ^ 2 * sensitivity) -
          2 * stepSize * (modulus * (smoothness : ℝ) /
            (modulus + (smoothness : ℝ))) +
          2 * stepSize * (smoothness : ℝ) * sensitivity) * ‖first - second‖ ^ 2 := by
            nlinarith [hstepSizeSqScaled]
  have hprojected :
      ‖project (first - stepSize • frozenPopulationGradient model gradient first first) -
          project (second - stepSize • frozenPopulationGradient model gradient second second)‖ ≤
        ‖(first - stepSize • frozenPopulationGradient model gradient first first) -
          (second - stepSize • frozenPopulationGradient model gradient second second)‖ := by
    simpa only [dist_eq_norm, NNReal.coe_one, one_mul] using
      hproject.dist_le_mul
        (first - stepSize • frozenPopulationGradient model gradient first first)
        (second - stepSize • frozenPopulationGradient model gradient second second)
  have hprojectedSq :
      ‖project (first - stepSize • frozenPopulationGradient model gradient first first) -
          project (second - stepSize • frozenPopulationGradient model gradient second second)‖ ^ 2 ≤
        ‖(first - stepSize • frozenPopulationGradient model gradient first first) -
          (second - stepSize • frozenPopulationGradient model gradient second second)‖ ^ 2 := by
    exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr hprojected
  exact hprojectedSq.trans hraw

/--
The finite-PMF 1-Wasserstein version of the squared contraction estimate in
Appendix E.3 underlying Theorem 3.8.  Its coefficient is the source's
interpolation coefficient; only the distribution-shift bridge is finite W₁.
-/
theorem sq_norm_repeatedGradientDescentUpdate_sub_le_of_interpolation_finiteWasserstein
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteWassersteinSensitive model sensitivity)
    (hmodulus : 0 < modulus) (hmodulus_le : modulus ≤ (smoothness : ℝ))
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (project : Parameter → Parameter) (hproject : LipschitzWith 1 project)
    (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    (hstepSize_le : stepSize ≤ 2 / (modulus + (smoothness : ℝ)))
    (first second : Parameter) :
    ‖repeatedGradientDescentUpdate model gradient project stepSize first -
        repeatedGradientDescentUpdate model gradient project stepSize second‖ ^ 2 ≤
      (1 + stepSize ^ 2 * (sensitivity ^ 2 * (smoothness : ℝ) ^ 2 +
          2 * (smoothness : ℝ) ^ 2 * sensitivity) -
        2 * stepSize * (modulus * (smoothness : ℝ) /
          (modulus + (smoothness : ℝ))) +
        2 * stepSize * (smoothness : ℝ) * sensitivity) * ‖first - second‖ ^ 2 := by
  let displacement := first - second
  let gradientShift := frozenPopulationGradient model gradient first first -
    frozenPopulationGradient model gradient second second
  let parameterShift := frozenPopulationGradient model gradient second first -
    frozenPopulationGradient model gradient second second
  have hinterpolation := diagonalFrozenPopulationGradient_interpolation_of_jointSmooth_finiteWasserstein
    model gradient hjoint hgradientAt hsensitivity hsensitive hmodulus hmodulus_le hstrong first second
  have hinterpolation' :
      (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
          (smoothness : ℝ) * sensitivity) * ‖displacement‖ ^ 2 +
        (1 / (modulus + (smoothness : ℝ))) * ‖parameterShift‖ ^ 2 ≤
        ⟪displacement, gradientShift⟫_ℝ := by
    simpa [displacement, gradientShift, parameterShift] using hinterpolation
  have hgradientSq := sq_norm_diagonalFrozenPopulationGradient_sub_le_of_jointSmooth_finiteWasserstein
    model gradient hjoint hsensitivity hsensitive first second
  have hgradientSq' : ‖gradientShift‖ ^ 2 ≤
      ((smoothness : ℝ) ^ 2 * sensitivity ^ 2 +
        2 * (smoothness : ℝ) ^ 2 * sensitivity) * ‖displacement‖ ^ 2 +
        ‖parameterShift‖ ^ 2 := by
    simpa [displacement, gradientShift, parameterShift] using hgradientSq
  have hpairScaled :
      -2 * stepSize * ⟪displacement, gradientShift⟫_ℝ ≤
        -2 * stepSize *
          ((modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
            (smoothness : ℝ) * sensitivity) * ‖displacement‖ ^ 2 +
            (1 / (modulus + (smoothness : ℝ))) * ‖parameterShift‖ ^ 2) := by
    have hscaled := mul_le_mul_of_nonneg_left hinterpolation' (by positivity : 0 ≤ 2 * stepSize)
    convert neg_le_neg hscaled using 1 <;> ring
  have hgradientScaled : stepSize ^ 2 * ‖gradientShift‖ ^ 2 ≤
      stepSize ^ 2 *
        (((smoothness : ℝ) ^ 2 * sensitivity ^ 2 +
          2 * (smoothness : ℝ) ^ 2 * sensitivity) * ‖displacement‖ ^ 2 +
          ‖parameterShift‖ ^ 2) := by
    exact mul_le_mul_of_nonneg_left hgradientSq' (sq_nonneg stepSize)
  have hstepSizeSq : stepSize ^ 2 ≤ 2 * stepSize / (modulus + (smoothness : ℝ)) := by
    have hscaled := mul_le_mul_of_nonneg_left hstepSize_le hstepSize
    calc
      stepSize ^ 2 = stepSize * stepSize := by ring
      _ ≤ stepSize * (2 / (modulus + (smoothness : ℝ))) := hscaled
      _ = 2 * stepSize / (modulus + (smoothness : ℝ)) := by ring
  have hstepSizeSqScaled : stepSize ^ 2 * ‖parameterShift‖ ^ 2 ≤
      (2 * stepSize / (modulus + (smoothness : ℝ))) * ‖parameterShift‖ ^ 2 := by
    exact mul_le_mul_of_nonneg_right hstepSizeSq (sq_nonneg _)
  have hraw :
      ‖(first - stepSize • frozenPopulationGradient model gradient first first) -
          (second - stepSize • frozenPopulationGradient model gradient second second)‖ ^ 2 ≤
        (1 + stepSize ^ 2 * (sensitivity ^ 2 * (smoothness : ℝ) ^ 2 +
            2 * (smoothness : ℝ) ^ 2 * sensitivity) -
          2 * stepSize * (modulus * (smoothness : ℝ) /
            (modulus + (smoothness : ℝ))) +
          2 * stepSize * (smoothness : ℝ) * sensitivity) * ‖first - second‖ ^ 2 := by
    have hexpand :
        ‖(first - stepSize • frozenPopulationGradient model gradient first first) -
            (second - stepSize • frozenPopulationGradient model gradient second second)‖ ^ 2 =
          ‖displacement‖ ^ 2 - 2 * stepSize * ⟪displacement, gradientShift⟫_ℝ +
            stepSize ^ 2 * ‖gradientShift‖ ^ 2 := by
      rw [show (first - stepSize • frozenPopulationGradient model gradient first first) -
          (second - stepSize • frozenPopulationGradient model gradient second second) =
          displacement - stepSize • gradientShift by
            simp only [displacement, gradientShift, smul_sub]
            abel, norm_sub_sq_real, real_inner_smul_right, norm_smul,
        Real.norm_eq_abs, abs_of_nonneg hstepSize]
      ring
    rw [hexpand]
    have hsumBound := add_le_add hpairScaled hgradientScaled
    calc
      ‖displacement‖ ^ 2 - 2 * stepSize * ⟪displacement, gradientShift⟫_ℝ +
          stepSize ^ 2 * ‖gradientShift‖ ^ 2 ≤
          ‖displacement‖ ^ 2 - 2 * stepSize *
            ((modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
              (smoothness : ℝ) * sensitivity) * ‖displacement‖ ^ 2 +
              (1 / (modulus + (smoothness : ℝ))) * ‖parameterShift‖ ^ 2) +
            stepSize ^ 2 *
              (((smoothness : ℝ) ^ 2 * sensitivity ^ 2 +
                2 * (smoothness : ℝ) ^ 2 * sensitivity) * ‖displacement‖ ^ 2 +
                ‖parameterShift‖ ^ 2) := by
            nlinarith [hsumBound]
