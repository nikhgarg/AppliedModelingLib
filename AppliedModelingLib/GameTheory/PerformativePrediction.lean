/--
Finite-PMF objective-value consequence of the optimality--stability distance
bound.  This is the analytic core of the source's Corollary 5.1 once a stable
point has been obtained by a retraining procedure.
-/
theorem performativeRisk_sub_performativelyOptimal_le_of_stable
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    {dataConstant parameterConstant : NNReal}
    (hdataLoss : IsDataLossLipschitz model dataConstant)
    (hparameterLoss : IsParameterLossLipschitz model parameterConstant)
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (optimal stable : Parameter)
    (hoptimal : ∀ candidate, performativeRisk model optimal ≤ performativeRisk model candidate)
    (hstable : IsPerformativelyStable model stable) :
    performativeRisk model stable - performativeRisk model optimal ≤
      2 * (dataConstant : ℝ) * sensitivity *
        ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) / modulus := by
  have hdistance := norm_performativelyOptimal_sub_stable_le_of_strongConvex_transport
    model gradient hgradientAt hmodulus hstrong hdataLoss hsensitivity hsensitive optimal stable
      hoptimal hstable
  rw [norm_sub_rev] at hdistance
  have hparameter := abs_decoupledPerformativeRisk_parameter_sub_le_of_parameterLipschitz
    model hparameterLoss stable stable optimal
  have hparameterUpper :
      decoupledPerformativeRisk model stable stable -
          decoupledPerformativeRisk model stable optimal ≤
        (parameterConstant : ℝ) * ‖stable - optimal‖ :=
    le_trans (le_abs_self _) hparameter
  have hdata := abs_decoupledPerformativeRisk_sub_le_of_finiteTransportSensitive
    model hdataLoss hsensitive optimal stable optimal
  have hdataUpper :
      decoupledPerformativeRisk model stable optimal -
          decoupledPerformativeRisk model optimal optimal ≤
        (dataConstant : ℝ) * (sensitivity * dist stable optimal) :=
    le_trans (le_abs_self _) hdata
  have hcoefficient_nonneg :
      0 ≤ (parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity := by positivity
  calc
    performativeRisk model stable - performativeRisk model optimal =
        (decoupledPerformativeRisk model stable stable -
          decoupledPerformativeRisk model stable optimal) +
        (decoupledPerformativeRisk model stable optimal -
          decoupledPerformativeRisk model optimal optimal) := by
      rw [performativeRisk_eq_decoupledPerformativeRisk_self,
        performativeRisk_eq_decoupledPerformativeRisk_self]
      ring
    _ ≤ (parameterConstant : ℝ) * ‖stable - optimal‖ +
          (dataConstant : ℝ) * (sensitivity * dist stable optimal) :=
      add_le_add hparameterUpper hdataUpper
    _ = ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) *
          ‖stable - optimal‖ := by
      rw [dist_eq_norm]
      ring
    _ ≤ ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) *
          (2 * (dataConstant : ℝ) * sensitivity / modulus) :=
      mul_le_mul_of_nonneg_left hdistance hcoefficient_nonneg
    _ = 2 * (dataConstant : ℝ) * sensitivity *
          ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) / modulus := by
      ring

/--
Finite-W₁ version of Corollary 5.1's stable-point objective bound.  It combines
the finite-W₁ Theorem 4.3 distance estimate with the same parameter- and
data-coordinate loss Lipschitz bounds.
-/
theorem performativeRisk_sub_performativelyOptimal_le_of_stable_finiteWasserstein
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    {dataConstant parameterConstant : NNReal}
    (hdataLoss : IsDataLossLipschitz model dataConstant)
    (hparameterLoss : IsParameterLossLipschitz model parameterConstant)
    {sensitivity : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteWassersteinSensitive model sensitivity)
    (optimal stable : Parameter)
    (hoptimal : ∀ candidate, performativeRisk model optimal ≤ performativeRisk model candidate)
    (hstable : IsPerformativelyStable model stable) :
    performativeRisk model stable - performativeRisk model optimal ≤
      2 * (dataConstant : ℝ) * sensitivity *
        ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) / modulus := by
  have hdistance := norm_performativelyOptimal_sub_stable_le_of_strongConvex_finiteWasserstein
    model gradient hgradientAt hmodulus hstrong hdataLoss hsensitivity hsensitive optimal stable
      hoptimal hstable
  rw [norm_sub_rev] at hdistance
  have hparameter := abs_decoupledPerformativeRisk_parameter_sub_le_of_parameterLipschitz
    model hparameterLoss stable stable optimal
  have hparameterUpper :
      decoupledPerformativeRisk model stable stable -
          decoupledPerformativeRisk model stable optimal ≤
        (parameterConstant : ℝ) * ‖stable - optimal‖ :=
    le_trans (le_abs_self _) hparameter
  have hdata := abs_decoupledPerformativeRisk_sub_le_of_finiteWassersteinSensitive
    model hdataLoss hsensitive optimal stable optimal
  have hdataUpper :
      decoupledPerformativeRisk model stable optimal -
          decoupledPerformativeRisk model optimal optimal ≤
        (dataConstant : ℝ) * (sensitivity * dist stable optimal) :=
    le_trans (le_abs_self _) hdata
  have hcoefficient_nonneg :
      0 ≤ (parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity := by positivity
  calc
    performativeRisk model stable - performativeRisk model optimal =
        (decoupledPerformativeRisk model stable stable -
          decoupledPerformativeRisk model stable optimal) +
        (decoupledPerformativeRisk model stable optimal -
          decoupledPerformativeRisk model optimal optimal) := by
      rw [performativeRisk_eq_decoupledPerformativeRisk_self,
        performativeRisk_eq_decoupledPerformativeRisk_self]
      ring
    _ ≤ (parameterConstant : ℝ) * ‖stable - optimal‖ +
          (dataConstant : ℝ) * (sensitivity * dist stable optimal) :=
      add_le_add hparameterUpper hdataUpper
    _ = ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) *
          ‖stable - optimal‖ := by
      rw [dist_eq_norm]
      ring
    _ ≤ ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) *
          (2 * (dataConstant : ℝ) * sensitivity / modulus) :=
      mul_le_mul_of_nonneg_left hdistance hcoefficient_nonneg
    _ = 2 * (dataConstant : ℝ) * sensitivity *
          ((parameterConstant : ℝ) + (dataConstant : ℝ) * sensitivity) / modulus := by
      ring

/-- A selected risk-minimizing retraining update. -/
def IsRepeatedRiskMinimization {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (retrain : Parameter → Parameter) : Prop :=
  ∀ parameter, IsPopulationRiskMinimizer model (model.dataLaw parameter) (retrain parameter)

/-- An RRM selector over a domain maps that domain into itself. -/
theorem repeatedRiskMinimizationOn_mapsTo
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (update : Parameter → Parameter) (hupdate : IsRepeatedRiskMinimizationOn model domain update) :
    Set.MapsTo update domain domain :=
  fun deployed hdeployed => (hupdate deployed hdeployed).1

/-- A fixed point of domain-constrained RRM is stable on that domain. -/
theorem isPerformativelyStableOn_of_retrainingOn_fixedPoint
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (retrain : Parameter → Parameter) (hretrain : IsRepeatedRiskMinimizationOn model domain retrain)
    {parameter : Parameter} (hparameter : parameter ∈ domain)
    (hfixed : retrain parameter = parameter) :
    IsPerformativelyStableOn model domain parameter := by
  simpa [IsPerformativelyStableOn, hfixed] using hretrain parameter hparameter

/--
If frozen-law minimizers are unique on a domain, every domain-stable parameter
is a fixed point of any domain-constrained RRM selection.
-/
theorem retrainingOn_fixedPoint_of_isPerformativelyStableOn_of_uniqueMinimizer
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (retrain : Parameter → Parameter) (hretrain : IsRepeatedRiskMinimizationOn model domain retrain)
    (hunique : ∀ deployed ∈ domain, ∀ first second,
      IsPopulationRiskMinimizerOn model domain (model.dataLaw deployed) first →
        IsPopulationRiskMinimizerOn model domain (model.dataLaw deployed) second → first = second)
    {parameter : Parameter} (hstable : IsPerformativelyStableOn model domain parameter) :
    retrain parameter = parameter :=
  hunique parameter hstable.1 (retrain parameter) parameter
    (hretrain parameter hstable.1) hstable

/--
A strict distance contraction for a domain-constrained RRM update yields one
domain-stable point, convergence of every in-domain trajectory to that point,
and the geometric distance bound.  The separate stable-to-fixed premise is
the exact uniqueness condition needed to rule out additional stable points.

The fixed-point and iterate-rate steps directly reuse Mathlib's
`ContractingWith.fixedPoint`, `tendsto_iterate_fixedPoint`, and iterated
Lipschitz bound from
[`Topology/MetricSpace/Contracting.lean`](https://github.com/leanprover-community/mathlib4/blob/5450b53e5ddc75d46418fabb605edbf36bd0beb6/Mathlib/Topology/MetricSpace/Contracting.lean)
at the repository's pinned Mathlib commit, under Apache-2.0. No upstream proof
is copied or ported here.
-/
theorem repeatedRiskMinimizationOn_convergesLinearly_of_distanceBound
    {Parameter Data : Type*}
    [MetricSpace Parameter] [CompleteSpace Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (domain : Set Parameter) (hclosed : IsClosed domain)
    (update : Parameter → Parameter)
    (hupdate : IsRepeatedRiskMinimizationOn model domain update)
    (factor : NNReal) (hfactor : factor < 1)
    (hbound : ∀ first ∈ domain, ∀ second ∈ domain,
      dist (update first) (update second) ≤ (factor : ℝ) * dist first second)
    (hstableFixed : ∀ parameter,
      IsPerformativelyStableOn model domain parameter → update parameter = parameter)
    (initial : Parameter) (hinitial : initial ∈ domain) :
    ∃ stable ∈ domain, IsPerformativelyStableOn model domain stable ∧
      (∀ other ∈ domain, IsPerformativelyStableOn model domain other → other = stable) ∧
      Filter.Tendsto (fun iteration => update^[iteration] initial)
        Filter.atTop (nhds stable) ∧
      ∀ iteration, dist (update^[iteration] initial) stable ≤
        (factor : ℝ) ^ iteration * dist initial stable := by
  have hmaps : Set.MapsTo update domain domain :=
    repeatedRiskMinimizationOn_mapsTo model domain update hupdate
  let restricted : domain → domain := restrictedUpdate domain update hmaps
  have hcontract : ContractingWith factor restricted := by
    simpa [restricted] using contractingWith_restrictedUpdate_of_bound
      domain update hmaps hfactor hbound
  letI : IsClosed domain := hclosed
  letI : Nonempty domain := ⟨⟨initial, hinitial⟩⟩
  let stableSub : domain := hcontract.fixedPoint restricted
  have hstableFixedSub : Function.IsFixedPt restricted stableSub :=
    hcontract.fixedPoint_isFixedPt
  have hstableFixedValue : update stableSub = stableSub := by
    exact_mod_cast congrArg Subtype.val hstableFixedSub
  have hstable : IsPerformativelyStableOn model domain stableSub :=
    isPerformativelyStableOn_of_retrainingOn_fixedPoint model domain update hupdate
      stableSub.2 hstableFixedValue
  refine ⟨stableSub, stableSub.2, hstable, ?_, ?_, ?_⟩
  · intro other hother hotherStable
    have hotherFixed : update other = other := hstableFixed other hotherStable
    have hotherFixedSub : Function.IsFixedPt restricted ⟨other, hother⟩ := by
      apply Subtype.ext
      exact hotherFixed
    exact congrArg Subtype.val
      (hcontract.fixedPoint_unique' hotherFixedSub hstableFixedSub)
  · have hlimit := hcontract.tendsto_iterate_fixedPoint ⟨initial, hinitial⟩
    convert (continuous_subtype_val.tendsto _).comp hlimit using 1
    funext iteration
    change update^[iteration] initial =
      ((restricted^[iteration] ⟨initial, hinitial⟩ : domain) : Parameter)
    simp only [restricted, restrictedUpdate]
    rw [Set.MapsTo.coe_iterate_restrict]
  · intro iteration
    have hrate := (hcontract.toLipschitzWith.iterate iteration).dist_le_mul
      ⟨initial, hinitial⟩ stableSub
    rw [(hstableFixedSub.iterate iteration).eq] at hrate
    simpa only [restricted, restrictedUpdate, Set.MapsTo.iterate_restrict,
      Set.MapsTo.val_restrict_apply, Subtype.dist_eq, NNReal.coe_pow] using hrate

/--
Banach's fixed-point conclusion for projected RGD on a complete convex domain.
The contraction certificate is kept separate from its analytic derivation, so
other projected-gradient analyses can reuse the stable/fixed-point bridge.
-/
theorem contracting_repeatedGradientDescent_has_unique_stablePoint_on
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (hcomplete : IsComplete domain) (hnonempty : domain.Nonempty)
    (hconvex : Convex ℝ domain) (project : Parameter → Parameter)
    (hproject : IsVariationalEuclideanProjectionOn domain project)
    (stepSize : ℝ) (hstepSize : 0 < stepSize)
    (hmaps : Set.MapsTo (repeatedGradientDescentUpdate model gradient project stepSize) domain domain)
    {factor : NNReal}
    (hcontract : ContractingWith factor
      (restrictedUpdate domain (repeatedGradientDescentUpdate model gradient project stepSize) hmaps)) :
    ∃ parameter, parameter ∈ domain ∧ IsPerformativelyStableOn model domain parameter ∧
      ∀ other, other ∈ domain → IsPerformativelyStableOn model domain other → other = parameter := by
  letI : Nonempty domain := Set.nonempty_coe_sort.mpr hnonempty
  letI : CompleteSpace domain := hcomplete.completeSpace_coe
  let fixed : domain := hcontract.fixedPoint _
  refine ⟨fixed, fixed.2, ?_, ?_⟩
  · apply isPerformativelyStableOn_of_repeatedGradientDescent_fixedPoint
      model gradient hmodulus hstrong domain project hproject stepSize hstepSize
    have hfixed := hcontract.fixedPoint_isFixedPt
    exact by
      simpa [fixed, restrictedUpdate] using congrArg Subtype.val hfixed
  · intro other hother hstable
    have hotherFixed := repeatedGradientDescent_fixedPoint_of_isPerformativelyStableOn
      model gradient hgradientAt domain hconvex project hproject stepSize hstepSize hstable
    have hotherFixedRestricted : Function.IsFixedPt
        (restrictedUpdate domain (repeatedGradientDescentUpdate model gradient project stepSize) hmaps)
        ⟨other, hother⟩ := by
      apply Subtype.ext
      simpa [restrictedUpdate] using hotherFixed
    have hequal : (⟨other, hother⟩ : domain) = fixed :=
      hcontract.fixedPoint_unique hotherFixedRestricted
    exact congrArg Subtype.val hequal

/--
Finite-PMF primal-transport realization of Theorem 3.8(b).  Under the source
step-size and sensitivity bounds, projected RGD has a unique stable point on a
closed convex domain and converges to it at the displayed linear rate.  The
finite transport certificate is the current concrete specialization of the
paper's Wasserstein-1 sensitivity assumption.
-/
theorem repeatedGradientDescent_convergesLinearly_of_interpolation_transport
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => model.loss datum parameter) (gradient datum evaluated) evaluated)
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (hmodulus : 0 < modulus) (hmodulus_le : modulus ≤ (smoothness : ℝ))
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (hclosed : IsClosed domain) (hnonempty : domain.Nonempty)
    (hconvex : Convex ℝ domain) (project : Parameter → Parameter)
    (hproject : IsVariationalEuclideanProjectionOn domain project)
    (hproject_nonexpansive : LipschitzWith 1 project)
    (stepSize : ℝ) (hstepSize : 0 < stepSize)
    (hstepSize_le : stepSize ≤ 2 / (modulus + (smoothness : ℝ)))
    (hsensitivity_small : sensitivity < modulus /
      ((modulus + (smoothness : ℝ)) * (1 + (3 / 2) * stepSize * (smoothness : ℝ))))
    (initial : Parameter) (hinitial : initial ∈ domain) :
    ∃ stable ∈ domain, IsPerformativelyStableOn model domain stable ∧
      (∀ other ∈ domain, IsPerformativelyStableOn model domain other → other = stable) ∧
      Filter.Tendsto
        (fun iteration => (repeatedGradientDescentUpdate model gradient project stepSize)^[iteration] initial)
        Filter.atTop (nhds stable) ∧
      ∀ iteration,
        ‖(repeatedGradientDescentUpdate model gradient project stepSize)^[iteration] initial - stable‖ ≤
          (1 - stepSize * (modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
            sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ)))) ^ iteration *
              ‖initial - stable‖ := by
  let contractionGap := modulus * (smoothness : ℝ) / (modulus + (smoothness : ℝ)) -
    sensitivity * ((3 / 2) * stepSize * (smoothness : ℝ) ^ 2 + (smoothness : ℝ))
  have hgap := rgd_contractionGap_pos_and_step_mul_le_half hsensitivity hmodulus hmodulus_le
    hstepSize.le hstepSize_le hsensitivity_small
  have hgap' : 0 < contractionGap ∧ stepSize * contractionGap ≤ 1 / 2 := by
    simpa [contractionGap] using hgap
  have hfactor_nonneg : 0 ≤ 1 - stepSize * contractionGap := by linarith [hgap'.2]
  let factor : NNReal := ⟨1 - stepSize * contractionGap, hfactor_nonneg⟩
  have hfactor_lt : factor < 1 := by
    change 1 - stepSize * contractionGap < 1
    have hpositive : 0 < stepSize * contractionGap := mul_pos hstepSize hgap'.1
    linarith
  have hmaps : Set.MapsTo (repeatedGradientDescentUpdate model gradient project stepSize)
      domain domain := fun _ _ => hproject.1 _
  let restricted : domain → domain := restrictedUpdate domain
    (repeatedGradientDescentUpdate model gradient project stepSize) hmaps
  have hbound : ∀ first ∈ domain, ∀ second ∈ domain,
      dist (repeatedGradientDescentUpdate model gradient project stepSize first)
        (repeatedGradientDescentUpdate model gradient project stepSize second) ≤
          (factor : ℝ) * dist first second := by
    intro first hfirst second hsecond
    simpa only [factor, contractionGap, dist_eq_norm, NNReal.coe_mk] using
      norm_repeatedGradientDescentUpdate_sub_le_of_interpolation_transport
        model gradient hjoint hgradientAt hsensitivity hsensitive hmodulus hmodulus_le hstrong
        project hproject_nonexpansive stepSize hstepSize.le hstepSize_le hsensitivity_small first second
  have hcontract : ContractingWith factor restricted := by
    simpa [restricted] using contractingWith_restrictedUpdate_of_bound domain
      (repeatedGradientDescentUpdate model gradient project stepSize) hmaps hfactor_lt hbound
  letI : IsClosed domain := hclosed
  letI : Nonempty domain := Set.nonempty_coe_sort.mpr hnonempty
  let stableSub : domain := hcontract.fixedPoint restricted
  have hstableFixed : Function.IsFixedPt restricted stableSub := hcontract.fixedPoint_isFixedPt
  have hstableFixedVal : repeatedGradientDescentUpdate model gradient project stepSize stableSub = stableSub := by
    simpa [restricted, restrictedUpdate] using congrArg Subtype.val hstableFixed
  have hstable : IsPerformativelyStableOn model domain stableSub :=
    isPerformativelyStableOn_of_repeatedGradientDescent_fixedPoint model gradient hmodulus hstrong
      domain project hproject stepSize hstepSize hstableFixedVal
  refine ⟨stableSub, stableSub.2, hstable, ?_, ?_, ?_⟩
  · intro other hother hotherStable
    have hotherFixed := repeatedGradientDescent_fixedPoint_of_isPerformativelyStableOn
      model gradient hgradientAt domain hconvex project hproject stepSize hstepSize hotherStable
    have hotherFixedSub : Function.IsFixedPt restricted ⟨other, hother⟩ := by
      apply Subtype.ext
      simpa [restricted, restrictedUpdate] using hotherFixed
    exact congrArg Subtype.val (hcontract.fixedPoint_unique' hotherFixedSub hstableFixed)
  · have hlimit := hcontract.tendsto_iterate_fixedPoint ⟨initial, hinitial⟩
    convert (continuous_subtype_val.tendsto _).comp hlimit using 1
    funext iteration
    change (repeatedGradientDescentUpdate model gradient project stepSize)^[iteration] initial =
      ((restricted^[iteration] ⟨initial, hinitial⟩ : domain) : Parameter)
    simp only [restricted, restrictedUpdate]
    rw [Set.MapsTo.coe_iterate_restrict]
  · intro iteration
    have hrate := (hcontract.toLipschitzWith.iterate iteration).dist_le_mul
      ⟨initial, hinitial⟩ stableSub
    rw [(hstableFixed.iterate iteration).eq] at hrate
    simpa only [factor, contractionGap, restricted, restrictedUpdate,
      Set.MapsTo.iterate_restrict, Set.MapsTo.val_restrict_apply, Subtype.dist_eq,
      dist_eq_norm, NNReal.coe_pow, NNReal.coe_mk] using hrate

