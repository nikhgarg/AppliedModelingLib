theorem measureProb_repeatedEmpiricalGradientDescentTrajectory_le_radius_up_to
    {Outcome Parameter Data : Type*} [MeasurableSpace Outcome]
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (law : Measure Outcome) [IsProbabilityMeasure law]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (hproject : LipschitzWith 1 project) (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    (sampleCount : ℕ → ℕ)
    (samples : Outcome → (iteration : ℕ) → Fin (sampleCount iteration) → Data)
    (trajectory : Outcome → ℕ → Parameter)
    (htrajectory : ∀ outcome,
      IsRepeatedEmpiricalGradientDescentTrajectory gradient project stepSize sampleCount
        (samples outcome) (trajectory outcome))
    (stable : Parameter) {contraction gradientError radius : ℝ} (horizon : ℕ)
    (hcontraction_nonneg : 0 ≤ contraction)
    (hstable : repeatedGradientDescentUpdate model gradient project stepSize stable = stable)
    (hcontract : ∀ parameter,
      dist (repeatedGradientDescentUpdate model gradient project stepSize parameter)
        (repeatedGradientDescentUpdate model gradient project stepSize stable) ≤
          contraction * dist parameter stable)
    (hgood_measurable : ∀ iteration, iteration ∈ Finset.range horizon →
      MeasurableSet {outcome |
        ‖empiricalPopulationGradient gradient (samples outcome iteration)
            (trajectory outcome iteration) - frozenPopulationGradient model gradient
              (trajectory outcome iteration) (trajectory outcome iteration)‖ ≤ gradientError})
    (hinitial : ∀ outcome, dist (trajectory outcome 0) stable ≤ radius)
    (herror_absorbed : stepSize * gradientError ≤ (1 - contraction) * radius) :
    1 - ∑ iteration ∈ Finset.range horizon, measureProb law (fun outcome =>
      ¬ ‖empiricalPopulationGradient gradient (samples outcome iteration)
          (trajectory outcome iteration) - frozenPopulationGradient model gradient
            (trajectory outcome iteration) (trajectory outcome iteration)‖ ≤ gradientError) ≤
      measureProb law (fun outcome => ∀ iteration, iteration ≤ horizon →
        dist (trajectory outcome iteration) stable ≤ radius) := by
  classical
  let good : ℕ → Outcome → Prop := fun iteration outcome =>
    ‖empiricalPopulationGradient gradient (samples outcome iteration)
        (trajectory outcome iteration) - frozenPopulationGradient model gradient
          (trajectory outcome iteration) (trajectory outcome iteration)‖ ≤ gradientError
  have hgood_measurable' : ∀ iteration ∈ Finset.range horizon,
      MeasurableSet {outcome | good iteration outcome} := by
    intro iteration hiteration
    simpa [good] using hgood_measurable iteration hiteration
  have hgood_probability := measureProb_inter_ge_one_sub_sum_compl law
    (Finset.range horizon) good hgood_measurable'
  have hgood_implies : ∀ outcome,
      (∀ iteration ∈ Finset.range horizon, good iteration outcome) →
