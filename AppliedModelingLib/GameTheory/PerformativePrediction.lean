    ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
        (EuclideanSpace ℝ (Fin dimension)) iteration →
      (Fin (countSchedule iteration) → EuclideanSpace ℝ (Fin dimension)) → Prop :=
  fun iteration history batch =>
    Probability.pOneFournierGuillinSelectedShellPartitionCertificate
