    batchKernel batchKernelMarkov).real
      {trace | ∀ iteration, entryIteration ≤ iteration →
        dist (deployedOfHistory iteration
          (heterogeneousBatchTraceOfInfiniteTrace iteration trace)) stable ≤ radius} ≥ 1 - p
  apply one_sub_le_measureReal_heterogeneousMeasureRERMState_le_radius_after_of_badEvent
    model gradient hmodulus hstrong hintegrable domain sampleCount hcountPositive deployedOfHistory
      hempirical populationUpdate hpopulation hfirstOrder stable hcontraction_nonneg hcontraction_le_outer
      hstable hcontract htolerance_nonneg hinitial herror_outer herror_absorbed entryIteration hentry
      batchKernel bad hevent
  · simpa only [batchKernel, oneKernel] using hbad
  · exact hgood

/--
The expected frozen gradient of a pointwise strongly convex loss is strongly
monotone at every arbitrary probability data law.  This discharges the
strong-monotonicity premise of the general closed-convex RRM theorem directly
from the paper's A2 assumption.
-/
theorem isMeasureFrozenGradientStronglyMonotoneInner_of_pointwiseStronglyConvex
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ}
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data)) :
    IsMeasureFrozenGradientStronglyMonotoneInner model gradient modulus := by
  intro deployed first second
  have hleft := measureFrozenRisk_strongConvex_lowerBound model gradient hstrong hintegrable
    deployed first second
  have hright := measureFrozenRisk_strongConvex_lowerBound model gradient hstrong hintegrable
    deployed second first
  rw [norm_sub_rev] at hleft
  have hpairs :
      ⟪second - first,
          measureFrozenPopulationGradient model gradient deployed first⟫_ℝ +
        ⟪first - second,
          measureFrozenPopulationGradient model gradient deployed second⟫_ℝ =
        -⟪first - second,
          measureFrozenPopulationGradient model gradient deployed first -
            measureFrozenPopulationGradient model gradient deployed second⟫_ℝ := by
    rw [show second - first = -(first - second) by abel, inner_neg_left, inner_sub_right]
    ring
  nlinarith

/--
Positive inner-product strong monotonicity implies the norm lower bound used
by the whole-space RRM argument.  This is a Hilbert-space consequence of
Cauchy--Schwarz, separated so both the domain and whole-space source routes
can reuse the same A2 bridge.
-/
theorem isMeasureFrozenGradientStronglyMonotone_of_inner
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ}
    (hstrong : IsMeasureFrozenGradientStronglyMonotoneInner model gradient modulus) :
    IsMeasureFrozenGradientStronglyMonotone model gradient modulus := by
  intro deployed first second
  by_cases hequal : first = second
  · subst second
    simp
  have hnorm_pos : 0 < ‖first - second‖ :=
    norm_pos_iff.mpr (sub_ne_zero.mpr hequal)
  have hinner := hstrong deployed first second
  have hupper :
      ⟪first - second,
        measureFrozenPopulationGradient model gradient deployed first -
          measureFrozenPopulationGradient model gradient deployed second⟫_ℝ ≤
        ‖first - second‖ *
          ‖measureFrozenPopulationGradient model gradient deployed first -
            measureFrozenPopulationGradient model gradient deployed second‖ :=
    real_inner_le_norm _ _
  apply le_of_mul_le_mul_left _ hnorm_pos
  calc
    ‖first - second‖ * (modulus * ‖first - second‖) =
        modulus * ‖first - second‖ ^ 2 := by ring
    _ ≤ ⟪first - second,
        measureFrozenPopulationGradient model gradient deployed first -
          measureFrozenPopulationGradient model gradient deployed second⟫_ℝ := hinner
    _ ≤ ‖first - second‖ *
        ‖measureFrozenPopulationGradient model gradient deployed first -
          measureFrozenPopulationGradient model gradient deployed second‖ := hupper

/--
Fermat's variational inequality for a frozen population-risk minimizer on a
convex parameter domain, expressed using its assumed Bochner-gradient
representation.
-/
theorem isMeasureFrozenGradientFirstOrderOptimalOn_of_hasGradientAt
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (distributionParameter minimizer : Parameter)
    (hminimizer : minimizer ∈ domain ∧ ∀ candidate ∈ domain,
      measureDecoupledPerformativeRisk model distributionParameter minimizer ≤
        measureDecoupledPerformativeRisk model distributionParameter candidate)
    (hgradientAt : HasGradientAt
      (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
      (measureFrozenPopulationGradient model gradient distributionParameter minimizer)
      minimizer) :
    IsMeasureFrozenGradientFirstOrderOptimalOn model gradient domain distributionParameter minimizer := by
  intro candidate hcandidate
  have hminOn : IsMinOn
      (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
      domain minimizer := by
    intro alternative halternative
    exact hminimizer.2 alternative halternative
  have htangent : candidate - minimizer ∈ posTangentConeAt domain minimizer :=
    sub_mem_posTangentConeAt_of_segment_subset
      (hconvex.segment_subset hminimizer.1 hcandidate)
  have hnonneg :
      0 ≤ (InnerProductSpace.toDual ℝ Parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter minimizer)
        (candidate - minimizer) :=
    hminOn.localize.hasFDerivWithinAt_nonneg hgradientAt.hasFDerivAt.hasFDerivWithinAt htangent
  rw [InnerProductSpace.toDual_apply_apply] at hnonneg
  simpa only [real_inner_comm] using hnonneg

/--
The arbitrary-measure W₁ RRM contraction estimate on a convex parameter
domain.  This is the domain-aware Appendix E.1 calculation: variational
first-order conditions and inner-product strong monotonicity control the two
frozen minimizers, while the general transport theorem controls their
distribution shift.
-/
theorem norm_measureRRMOn_sub_le_of_wassersteinSensitive_hasGradientAt
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity) (hmodulus : 0 < modulus)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimizationOn model domain update)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    (hstrong : IsMeasureFrozenGradientStronglyMonotoneInner model gradient modulus)
    (first second : Parameter) (hfirst : first ∈ domain) (hsecond : second ∈ domain) :
    ‖update first - update second‖ ≤
      (sensitivity * (smoothness : ℝ) / modulus) * ‖first - second‖ := by
  have hleft_out : update first ∈ domain := (hrrm first hfirst).1
  have hright_out : update second ∈ domain := (hrrm second hsecond).1
  have hleft_firstOrder := isMeasureFrozenGradientFirstOrderOptimalOn_of_hasGradientAt
    model gradient domain hconvex first (update first) (hrrm first hfirst)
      (hgradientAt first (update first))
  have hright_firstOrder := isMeasureFrozenGradientFirstOrderOptimalOn_of_hasGradientAt
    model gradient domain hconvex second (update second) (hrrm second hsecond)
      (hgradientAt second (update second))
  have hleft_pair_raw := hleft_firstOrder (update second) hright_out
  rw [show update second - update first = -(update first - update second) by abel,
    inner_neg_left] at hleft_pair_raw
  have hleft_pair :
      ⟪update first - update second,
        measureFrozenPopulationGradient model gradient first (update first)⟫_ℝ ≤ 0 := by
    linarith
  have hright_pair :
      0 ≤ ⟪update first - update second,
        measureFrozenPopulationGradient model gradient second (update second)⟫_ℝ :=
    hright_firstOrder (update first) hleft_out
  have hstrong_bound :
      modulus * ‖update first - update second‖ ^ 2 ≤
        ⟪update first - update second,
          measureFrozenPopulationGradient model gradient second (update second) -
            measureFrozenPopulationGradient model gradient first (update second)⟫_ℝ := by
    calc
      modulus * ‖update first - update second‖ ^ 2 ≤
          ⟪update first - update second,
            measureFrozenPopulationGradient model gradient first (update first) -
              measureFrozenPopulationGradient model gradient first (update second)⟫_ℝ :=
        hstrong first (update first) (update second)
      _ = ⟪update first - update second,
            measureFrozenPopulationGradient model gradient first (update first)⟫_ℝ -
          ⟪update first - update second,
            measureFrozenPopulationGradient model gradient first (update second)⟫_ℝ := by
        rw [inner_sub_right]
      _ ≤ 0 - ⟪update first - update second,
            measureFrozenPopulationGradient model gradient first (update second)⟫_ℝ := by
        gcongr
      _ ≤ ⟪update first - update second,
            measureFrozenPopulationGradient model gradient second (update second)⟫_ℝ -
          ⟪update first - update second,
            measureFrozenPopulationGradient model gradient first (update second)⟫_ℝ := by
        linarith
      _ = ⟪update first - update second,
            measureFrozenPopulationGradient model gradient second (update second) -
              measureFrozenPopulationGradient model gradient first (update second)⟫_ℝ := by
        rw [inner_sub_right]
  have hshift := norm_measureFrozenPopulationGradient_sub_le_of_wassersteinSensitive
    model gradient hgradient hintegrable hsensitive (update second) first second
  have hshift_rev :
      ‖measureFrozenPopulationGradient model gradient second (update second) -
        measureFrozenPopulationGradient model gradient first (update second)‖ ≤
        (smoothness : ℝ) * (sensitivity * dist first second) := by
    simpa only [norm_sub_rev] using hshift
  have hquadratic : modulus * ‖update first - update second‖ ^ 2 ≤
      ‖update first - update second‖ *
        ((smoothness : ℝ) * (sensitivity * dist first second)) := by
    calc
      modulus * ‖update first - update second‖ ^ 2 ≤
          ⟪update first - update second,
            measureFrozenPopulationGradient model gradient second (update second) -
              measureFrozenPopulationGradient model gradient first (update second)⟫_ℝ := hstrong_bound
      _ ≤ ‖update first - update second‖ *
          ‖measureFrozenPopulationGradient model gradient second (update second) -
            measureFrozenPopulationGradient model gradient first (update second)‖ :=
        real_inner_le_norm _ _
      _ ≤ ‖update first - update second‖ *
          ((smoothness : ℝ) * (sensitivity * dist first second)) :=
        mul_le_mul_of_nonneg_left hshift_rev (norm_nonneg _)
  by_cases hzero : ‖update first - update second‖ = 0
  · have hcoefficient : 0 ≤ sensitivity * (smoothness : ℝ) / modulus := by positivity
    rw [hzero]
    exact mul_nonneg hcoefficient (norm_nonneg _)
  · have hpositive : 0 < ‖update first - update second‖ :=
      lt_of_le_of_ne (norm_nonneg _) (Ne.symm hzero)
    have hcancel :
        modulus * ‖update first - update second‖ ≤
          (sensitivity * (smoothness : ℝ)) * ‖first - second‖ := by
      apply le_of_mul_le_mul_right _ hpositive
      calc
        (modulus * ‖update first - update second‖) * ‖update first - update second‖ =
            modulus * ‖update first - update second‖ ^ 2 := by ring
        _ ≤ ‖update first - update second‖ *
            ((smoothness : ℝ) * (sensitivity * dist first second)) := hquadratic
        _ = ((sensitivity * (smoothness : ℝ)) * ‖first - second‖) *
            ‖update first - update second‖ := by
          rw [dist_eq_norm]
          ring
    have hdivide :
        ‖update first - update second‖ ≤
          ((sensitivity * (smoothness : ℝ)) * ‖first - second‖) / modulus := by
      calc
        ‖update first - update second‖ =
            (modulus * ‖update first - update second‖) / modulus := by field_simp
        _ ≤ ((sensitivity * (smoothness : ℝ)) * ‖first - second‖) / modulus :=
          div_le_div_of_nonneg_right hcancel hmodulus.le
    convert hdivide using 1
    all_goals ring

/--
On a convex parameter domain, frozen population-risk minimizers are unique
under a positive inner-product strong-monotonicity modulus and the visible
frozen-risk derivative representation.
-/
theorem measureFrozenRiskMinimizerOn_unique_of_hasGradientAt
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsMeasureFrozenGradientStronglyMonotoneInner model gradient modulus)
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (distributionParameter first second : Parameter)
    (hfirst : first ∈ domain ∧ ∀ candidate ∈ domain,
      measureDecoupledPerformativeRisk model distributionParameter first ≤
        measureDecoupledPerformativeRisk model distributionParameter candidate)
    (hsecond : second ∈ domain ∧ ∀ candidate ∈ domain,
      measureDecoupledPerformativeRisk model distributionParameter second ≤
        measureDecoupledPerformativeRisk model distributionParameter candidate)
    (hgradientAt : ∀ evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter) :
    first = second := by
  have hfirst_order := isMeasureFrozenGradientFirstOrderOptimalOn_of_hasGradientAt
    model gradient domain hconvex distributionParameter first hfirst (hgradientAt first)
  have hsecond_order := isMeasureFrozenGradientFirstOrderOptimalOn_of_hasGradientAt
    model gradient domain hconvex distributionParameter second hsecond (hgradientAt second)
  have hfirst_pair_raw := hfirst_order second hsecond.1
  rw [show second - first = -(first - second) by abel, inner_neg_left] at hfirst_pair_raw
  have hfirst_pair :
      ⟪first - second,
        measureFrozenPopulationGradient model gradient distributionParameter first⟫_ℝ ≤ 0 := by
    linarith
  have hsecond_pair :
      0 ≤ ⟪first - second,
        measureFrozenPopulationGradient model gradient distributionParameter second⟫_ℝ :=
    hsecond_order first hfirst.1
  have hbound : modulus * ‖first - second‖ ^ 2 ≤ 0 := by
    calc
      modulus * ‖first - second‖ ^ 2 ≤
          ⟪first - second,
            measureFrozenPopulationGradient model gradient distributionParameter first -
              measureFrozenPopulationGradient model gradient distributionParameter second⟫_ℝ :=
        hstrong distributionParameter first second
      _ = ⟪first - second,
            measureFrozenPopulationGradient model gradient distributionParameter first⟫_ℝ -
          ⟪first - second,
            measureFrozenPopulationGradient model gradient distributionParameter second⟫_ℝ := by
        rw [inner_sub_right]
      _ ≤ 0 - ⟪first - second,
            measureFrozenPopulationGradient model gradient distributionParameter second⟫_ℝ := by
        gcongr
      _ ≤ 0 := by linarith
  have hsq_nonpos : ‖first - second‖ ^ 2 ≤ 0 := by
    apply le_of_mul_le_mul_left _ hmodulus
    simpa using hbound
  have hnorm : ‖first - second‖ = 0 := by
    nlinarith [sq_nonneg ‖first - second‖]
  exact sub_eq_zero.mp (norm_eq_zero.mp hnorm)

/--
Every domain-stable point is fixed by a strongly monotone differentiable
general-law RRM selector, because both it and the selector output minimize the
same frozen population risk.
-/
theorem measureRRMOn_fixedPoint_of_isMeasurePerformativelyStableOn_of_hasGradientAt
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsMeasureFrozenGradientStronglyMonotoneInner model gradient modulus)
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimizationOn model domain update)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    (parameter : Parameter) (hstable : IsMeasurePerformativelyStableOn model domain parameter) :
    update parameter = parameter := by
  have hunique := measureFrozenRiskMinimizerOn_unique_of_hasGradientAt model gradient hmodulus hstrong
    domain hconvex parameter parameter (update parameter) hstable (hrrm parameter hstable.1)
      (fun evaluatedParameter => hgradientAt parameter evaluatedParameter)
  exact hunique.symm

/--
General-law closed-convex-domain realization of Theorem 3.5(b): a strict
arbitrary-measure W₁ RRM contraction has one domain-stable fixed point and
the source's geometric iterate bound.
-/
theorem measureRRMOn_convergesLinearly_of_wassersteinSensitive_hasGradientAt
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity) (hmodulus : 0 < modulus)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (domain : Set Parameter) (hclosed : IsClosed domain) (hconvex : Convex ℝ domain)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimizationOn model domain update)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    (hstrong : IsMeasureFrozenGradientStronglyMonotoneInner model gradient modulus)
    (hfactor : sensitivity * (smoothness : ℝ) / modulus < 1)
    (initial : Parameter) (hinitial : initial ∈ domain) :
    ∃ stable ∈ domain, IsMeasurePerformativelyStableOn model domain stable ∧
      (∀ other ∈ domain, IsMeasurePerformativelyStableOn model domain other → other = stable) ∧
      Filter.Tendsto (fun iteration => update^[iteration] initial) Filter.atTop (nhds stable) ∧
      ∀ iteration, ‖update^[iteration] initial - stable‖ ≤
        (sensitivity * (smoothness : ℝ) / modulus) ^ iteration * ‖initial - stable‖ := by
  have hfactor_nonneg : 0 ≤ sensitivity * (smoothness : ℝ) / modulus := by positivity
  let factor : NNReal := ⟨sensitivity * (smoothness : ℝ) / modulus, hfactor_nonneg⟩
  have hfactor_lt : factor < 1 := by simpa [factor] using hfactor
  have hmaps : Set.MapsTo update domain domain :=
    measureRepeatedRiskMinimizationOn_mapsTo model domain update hrrm
  let restricted : domain → domain := restrictedUpdate domain update hmaps
  have hbound : ∀ first ∈ domain, ∀ second ∈ domain,
      dist (update first) (update second) ≤ (factor : ℝ) * dist first second := by
    intro first hfirst second hsecond
    simpa only [factor, NNReal.coe_mk, dist_eq_norm] using
      norm_measureRRMOn_sub_le_of_wassersteinSensitive_hasGradientAt
        model gradient hgradient hintegrable hsensitivity hmodulus hsensitive domain hconvex update hrrm
          hgradientAt hstrong first second hfirst hsecond
  have hcontract : ContractingWith factor restricted := by
    simpa [restricted] using contractingWith_restrictedUpdate_of_bound domain update hmaps
      hfactor_lt hbound
  letI : IsClosed domain := hclosed
  letI : Nonempty domain := ⟨⟨initial, hinitial⟩⟩
  let stableSub : domain := hcontract.fixedPoint restricted
  have hstableFixed : Function.IsFixedPt restricted stableSub := hcontract.fixedPoint_isFixedPt
  have hstableFixedVal : update stableSub = stableSub := by
    exact_mod_cast congrArg Subtype.val hstableFixed
  have hstable : IsMeasurePerformativelyStableOn model domain stableSub :=
    isMeasurePerformativelyStableOn_of_rrmOn_fixedPoint model domain update hrrm stableSub.2
      hstableFixedVal
  refine ⟨stableSub, stableSub.2, hstable, ?_, ?_, ?_⟩
  · intro other hother hotherStable
    have hotherFixed : update other = other :=
      measureRRMOn_fixedPoint_of_isMeasurePerformativelyStableOn_of_hasGradientAt
        model gradient hmodulus hstrong domain hconvex update hrrm hgradientAt other hotherStable
    have hotherFixedSub : Function.IsFixedPt restricted ⟨other, hother⟩ := by
      apply Subtype.ext
      simpa [restricted, restrictedUpdate] using hotherFixed
    exact congrArg Subtype.val (hcontract.fixedPoint_unique' hotherFixedSub hstableFixed)
  · have hlimit := hcontract.tendsto_iterate_fixedPoint ⟨initial, hinitial⟩
    convert (continuous_subtype_val.tendsto _).comp hlimit using 1
    funext iteration
    change update^[iteration] initial =
      ((restricted^[iteration] ⟨initial, hinitial⟩ : domain) : Parameter)
    simp only [restricted, restrictedUpdate]
    rw [Set.MapsTo.coe_iterate_restrict]
  · intro iteration
    have hrate := (hcontract.toLipschitzWith.iterate iteration).dist_le_mul
      ⟨initial, hinitial⟩ stableSub
    rw [(hstableFixed.iterate iteration).eq] at hrate
    simpa only [restricted, restrictedUpdate, Set.MapsTo.iterate_restrict,
      Set.MapsTo.val_restrict_apply, Subtype.dist_eq, dist_eq_norm, NNReal.coe_pow] using hrate

/--
The arbitrary-measure whole-space RRM contraction estimate from the PZ proof:
W₁-sensitive distribution shift and strong monotonicity contract a stationary
frozen-risk update.
-/
theorem norm_measureRRM_sub_le_of_wassersteinSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hmodulus : 0 < modulus)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (update : Parameter → Parameter)
    (hstationary : IsMeasureFrozenGradientStationary model gradient update)
    (hstrong : IsMeasureFrozenGradientStronglyMonotone model gradient modulus)
    (first second : Parameter) :
    ‖update first - update second‖ ≤
      ((smoothness : ℝ) * (sensitivity * dist first second)) / modulus := by
  have hshift := norm_measureFrozenPopulationGradient_sub_le_of_wassersteinSensitive
    model gradient hgradient hintegrable hsensitive (update second) first second
  have hlower := hstrong first (update first) (update second)
  have hbound : modulus * ‖update first - update second‖ ≤
      (smoothness : ℝ) * (sensitivity * dist first second) := by
    calc
      modulus * ‖update first - update second‖ ≤
          ‖measureFrozenPopulationGradient model gradient first (update first) -
            measureFrozenPopulationGradient model gradient first (update second)‖ := hlower
      _ = ‖measureFrozenPopulationGradient model gradient first (update second) -
            measureFrozenPopulationGradient model gradient second (update second)‖ := by
        rw [hstationary first, hstationary second]
        simp
      _ ≤ (smoothness : ℝ) * (sensitivity * dist first second) := hshift
  apply (le_div_iff₀ hmodulus).mpr
  simpa only [mul_comm] using hbound

/--
The general W₁ RRM contraction with first-order stationarity derived from a
frozen-risk gradient representation.
-/
theorem norm_measureRRM_sub_le_of_wassersteinSensitive_hasGradientAt
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hmodulus : 0 < modulus)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimization model update)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    (hstrong : IsMeasureFrozenGradientStronglyMonotone model gradient modulus)
    (first second : Parameter) :
    ‖update first - update second‖ ≤
      ((smoothness : ℝ) * (sensitivity * dist first second)) / modulus := by
  apply norm_measureRRM_sub_le_of_wassersteinSensitive model gradient hgradient hintegrable
    hmodulus hsensitive update
    (isMeasureFrozenGradientStationary_of_rrm_hasGradientAt_univ
      model gradient update hrrm hgradientAt)
    hstrong first second

/--
Under a positive frozen-gradient strong-monotonicity modulus, every
performatively stable point is a fixed point of a differentiable whole-space
RRM selector.  This supplies the stable-point uniqueness bridge for the
general-law RRM convergence theorem below.
-/
theorem measureRRM_fixedPoint_of_isMeasurePerformativelyStable_of_hasGradientAt
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimization model update)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    (hstrong : IsMeasureFrozenGradientStronglyMonotone model gradient modulus)
    (parameter : Parameter) (hstable : IsMeasurePerformativelyStable model parameter) :
    update parameter = parameter := by
  have hstable_zero :
      measureFrozenPopulationGradient model gradient parameter parameter = 0 :=
    measureFrozenPopulationGradient_eq_zero_of_hasGradientAt_univ model gradient parameter parameter
      hstable (hgradientAt parameter parameter)
  have hupdate_zero :
      measureFrozenPopulationGradient model gradient parameter (update parameter) = 0 :=
    measureFrozenPopulationGradient_eq_zero_of_hasGradientAt_univ model gradient parameter
      (update parameter) (hrrm parameter) (hgradientAt parameter (update parameter))
  have hlower := hstrong parameter parameter (update parameter)
  have hnorm_nonpos : ‖parameter - update parameter‖ ≤ 0 := by
    apply le_of_mul_le_mul_left _ hmodulus
    simpa [hstable_zero, hupdate_zero] using hlower
  have hzero : parameter - update parameter = 0 :=
    norm_eq_zero.mp (le_antisymm hnorm_nonpos (norm_nonneg _))
  exact (sub_eq_zero.mp hzero).symm

/--
General-law realization of the fixed-point and rate conclusion in Theorem
3.5(b) of Perdomo et al.  The previously established arbitrary-measure W₁
contraction is turned into a Banach fixed point; all additional analytic
premises needed to make the source proof meaningful for Bochner integrals
remain explicit.
-/
theorem measureRRM_convergesLinearly_of_wassersteinSensitive_hasGradientAt
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Nonempty Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity) (hmodulus : 0 < modulus)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimization model update)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter)
    (hstrong : IsMeasureFrozenGradientStronglyMonotone model gradient modulus)
    (hfactor : sensitivity * (smoothness : ℝ) / modulus < 1)
    (initial : Parameter) :
    ∃ stable, IsMeasurePerformativelyStable model stable ∧
      (∀ other, IsMeasurePerformativelyStable model other → other = stable) ∧
      Filter.Tendsto (fun iteration => update^[iteration] initial) Filter.atTop (nhds stable) ∧
      ∀ iteration, ‖update^[iteration] initial - stable‖ ≤
        (sensitivity * (smoothness : ℝ) / modulus) ^ iteration * ‖initial - stable‖ := by
  have hfactor_nonneg : 0 ≤ sensitivity * (smoothness : ℝ) / modulus := by positivity
  let factor : NNReal := ⟨sensitivity * (smoothness : ℝ) / modulus, hfactor_nonneg⟩
  have hfactor_lt : factor < 1 := by simpa [factor] using hfactor
  have hbound : ∀ first second,
      dist (update first) (update second) ≤ (factor : ℝ) * dist first second := by
    intro first second
    have hraw := norm_measureRRM_sub_le_of_wassersteinSensitive_hasGradientAt
      model gradient hgradient hintegrable hmodulus hsensitive update hrrm hgradientAt hstrong
        first second
    calc
      dist (update first) (update second) = ‖update first - update second‖ := dist_eq_norm _ _
      _ ≤ ((smoothness : ℝ) * (sensitivity * dist first second)) / modulus := hraw
      _ = (factor : ℝ) * dist first second := by
        change ((smoothness : ℝ) * (sensitivity * dist first second)) / modulus =
          (sensitivity * (smoothness : ℝ) / modulus) * dist first second
        ring
  have hcontract : ContractingWith factor update :=
    ⟨hfactor_lt, LipschitzWith.of_dist_le_mul hbound⟩
  let stable : Parameter := hcontract.fixedPoint update
  have hstable_fixed : Function.IsFixedPt update stable := hcontract.fixedPoint_isFixedPt
  have hstable : IsMeasurePerformativelyStable model stable :=
    isMeasurePerformativelyStable_of_rrm_fixedPoint model update hrrm hstable_fixed
  refine ⟨stable, hstable, ?_, hcontract.tendsto_iterate_fixedPoint initial, ?_⟩
  · intro other hother
    have hother_fixed : Function.IsFixedPt update other :=
      measureRRM_fixedPoint_of_isMeasurePerformativelyStable_of_hasGradientAt
        model gradient hmodulus update hrrm hgradientAt hstrong other hother
    exact hcontract.fixedPoint_unique' hother_fixed hstable_fixed
  · intro iteration
    have hrate := (hcontract.toLipschitzWith.iterate iteration).dist_le_mul initial stable
    rw [(hstable_fixed.iterate iteration).eq] at hrate
    simpa only [factor, dist_eq_norm, NNReal.coe_pow] using hrate

/-- The two-coordinate joint-smoothness condition used in the PZ paper. -/
def IsJointlySmoothGradient {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter] [MetricSpace Data]
    (gradient : Data → Parameter → Parameter) (smoothness : NNReal) : Prop :=
  (∀ (datum : Data) (first second : Parameter),
    ‖gradient datum first - gradient datum second‖ ≤
      (smoothness : ℝ) * ‖first - second‖) ∧
  IsDataGradientLipschitz gradient smoothness

/-- A joint-smoothness certificate can be safely enlarged to a larger modulus. -/
theorem IsJointlySmoothGradient.mono {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter] [MetricSpace Data]
    {gradient : Data → Parameter → Parameter} {smoothness larger : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hle : (smoothness : ℝ) ≤ (larger : ℝ)) :
    IsJointlySmoothGradient gradient larger := by
  constructor
  · intro datum first second
    exact (hjoint.1 datum first second).trans
      (mul_le_mul_of_nonneg_right hle (norm_nonneg _))
  · intro first second parameter
    exact (hjoint.2 first second parameter).trans
      (mul_le_mul_of_nonneg_right hle (dist_nonneg))

/-- The Proposition 3.6(c) squared-loss gradient is jointly `2`-smooth. -/
theorem proposition36cGradient_jointSmooth :
    IsJointlySmoothGradient proposition36cGradient 2 := by
  constructor
  · intro datum first second
    rw [show proposition36cGradient datum first - proposition36cGradient datum second =
      2 * (first - second) by
        simp [proposition36cGradient]
        ring]
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2),
      Real.norm_eq_abs]
    norm_num
  · intro first second parameter
    rw [show proposition36cGradient first parameter - proposition36cGradient second parameter =
      -2 * (first - second) by
        simp [proposition36cGradient]
        ring]
    rw [Real.norm_eq_abs, abs_mul, abs_neg, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2),
      Real.dist_eq]
    norm_num

/-- The scaled Proposition 3.6(c) gradient is jointly `gamma`-smooth. -/
theorem proposition36cScaledGradient_jointSmooth
    {gamma : ℝ} (hgamma : 0 ≤ gamma) :
    IsJointlySmoothGradient (proposition36cScaledGradient gamma) gamma.toNNReal := by
  constructor
  · intro datum first second
    rw [show proposition36cScaledGradient gamma datum first -
        proposition36cScaledGradient gamma datum second = gamma * (first - second) by
      simp [proposition36cScaledGradient]
      ring]
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hgamma, Real.norm_eq_abs,
      Real.coe_toNNReal _ hgamma]
  · intro first second parameter
    rw [show proposition36cScaledGradient gamma first parameter -
        proposition36cScaledGradient gamma second parameter = -gamma * (first - second) by
      simp [proposition36cScaledGradient]
      ring]
    rw [Real.norm_eq_abs, abs_mul, abs_neg, abs_of_nonneg hgamma, Real.dist_eq,
      Real.coe_toNNReal _ hgamma]

/--
When `gamma ≤ beta`, the scaled construction satisfies the paper's
`beta`-joint-smoothness assumption with the larger admissible modulus.
-/
theorem proposition36cScaledGradient_jointSmooth_of_le
    {beta gamma : ℝ} (hbeta : 0 ≤ beta) (hgamma : 0 ≤ gamma) (hle : gamma ≤ beta) :
    IsJointlySmoothGradient (proposition36cScaledGradient gamma) beta.toNNReal := by
  apply (proposition36cScaledGradient_jointSmooth hgamma).mono
  simpa [Real.coe_toNNReal _ hgamma, Real.coe_toNNReal _ hbeta] using hle

/--
For `gamma ≤ beta`, the quadratic-linear gradient is jointly `beta`-smooth:
its parameter slope is `gamma` and its datum slope is exactly `beta`.
-/
theorem proposition36cRegularityGradient_jointSmooth
    {beta gamma : ℝ} (hbeta : 0 ≤ beta) (hgamma : 0 ≤ gamma) (hle : gamma ≤ beta) :
    IsJointlySmoothGradient
      (proposition36cRegularityGradient beta gamma) beta.toNNReal := by
  constructor
  · intro datum first second
    rw [show proposition36cRegularityGradient beta gamma datum first -
        proposition36cRegularityGradient beta gamma datum second =
          gamma * (first - second) by
      simp [proposition36cRegularityGradient]
      ring]
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hgamma, Real.norm_eq_abs,
      Real.coe_toNNReal _ hbeta]
    exact mul_le_mul_of_nonneg_right hle (abs_nonneg _)
  · intro first second parameter
    rw [show proposition36cRegularityGradient beta gamma first parameter -
        proposition36cRegularityGradient beta gamma second parameter =
          -beta * (first - second) by
      simp [proposition36cRegularityGradient]
      ring]
    rw [Real.norm_eq_abs, abs_mul, abs_neg, abs_of_nonneg hbeta, Real.dist_eq,
      Real.coe_toNNReal _ hbeta]

/--
The exact Proposition 3.6(a) linear gradient is jointly `beta`-smooth when
`beta` is nonnegative: it is constant in the evaluated parameter and
`beta`-Lipschitz in the real datum.
-/
theorem proposition36aMeasureGradient_jointSmooth
    {beta : ℝ} (hbeta : 0 ≤ beta) :
    IsJointlySmoothGradient (proposition36aMeasureGradient beta) beta.toNNReal := by
  constructor
  · intro datum first second
    simp only [proposition36aMeasureGradient, sub_self, norm_zero]
    positivity
  · intro first second parameter
    rw [show proposition36aMeasureGradient beta first parameter -
        proposition36aMeasureGradient beta second parameter = beta * (first - second) by
      simp [proposition36aMeasureGradient]
      ring]
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hbeta, Real.dist_eq,
      Real.coe_toNNReal _ hbeta]

/--
The parameter-coordinate part of PZ assumption A1 supplies the integrable
derivative domination needed for differentiation under a frozen law on any
open ball, once the gradient at its centre is integrable.  This is a reusable
bridge: measurability of the loss family and pointwise differentiability are
kept explicit, because smoothness alone does not establish either analytic
condition.
-/
theorem hasGradientAt_measureDecoupledPerformativeRisk_of_jointSmooth
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (distributionParameter evaluatedParameter : Parameter)
    (hloss_meas : ∀ᶠ parameter in nhds evaluatedParameter,
      AEStronglyMeasurable (fun datum => model.loss datum parameter)
        (model.dataLaw distributionParameter : Measure Data))
    (hintegrable : Integrable (fun datum => gradient datum evaluatedParameter)
      (model.dataLaw distributionParameter : Measure Data))
    (hpointwise : ∀ datum parameter,
      HasGradientAt (fun theta => model.loss datum theta) (gradient datum parameter) parameter)
    (radius : ℝ) (hradius : 0 < radius) :
    HasGradientAt
      (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
      (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
      evaluatedParameter := by
  let μ : Measure Data := model.dataLaw distributionParameter
  have hgradient_meas : AEStronglyMeasurable (fun datum =>
      (InnerProductSpace.toDual ℝ Parameter) (gradient datum evaluatedParameter)) μ := by
    simpa only [Function.comp_apply] using
      (InnerProductSpace.toDual ℝ Parameter).toLinearIsometry.toContinuousLinearMap.continuous
        |>.comp_aestronglyMeasurable hintegrable.aestronglyMeasurable
  have hbound_integrable : Integrable (fun datum =>
      ‖gradient datum evaluatedParameter‖ + (smoothness : ℝ) * radius) μ := by
    exact hintegrable.norm.add (integrable_const _)
  apply hasGradientAt_measureDecoupledPerformativeRisk_of_dominated model gradient
    distributionParameter evaluatedParameter (Metric.ball evaluatedParameter radius)
    (Metric.ball_mem_nhds _ hradius) hloss_meas hgradient_meas hintegrable
    (fun datum => ‖gradient datum evaluatedParameter‖ + (smoothness : ℝ) * radius)
  · filter_upwards [] with datum
    intro parameter hparameter
    have hdistance : ‖parameter - evaluatedParameter‖ ≤ radius := by
      have hball : dist parameter evaluatedParameter < radius := by
        simpa only [Metric.mem_ball] using hparameter
      simpa only [dist_eq_norm] using le_of_lt hball
    have hbound : ‖gradient datum parameter‖ ≤
        ‖gradient datum evaluatedParameter‖ + (smoothness : ℝ) * radius := by
      calc
        ‖gradient datum parameter‖ =
            ‖(gradient datum parameter - gradient datum evaluatedParameter) +
              gradient datum evaluatedParameter‖ := by rw [sub_add_cancel]
        _ ≤ ‖gradient datum parameter - gradient datum evaluatedParameter‖ +
            ‖gradient datum evaluatedParameter‖ := norm_add_le _ _
        _ ≤ (smoothness : ℝ) * ‖parameter - evaluatedParameter‖ +
            ‖gradient datum evaluatedParameter‖ := by
          linarith [hjoint.1 datum parameter evaluatedParameter]
        _ ≤ ‖gradient datum evaluatedParameter‖ + (smoothness : ℝ) * radius := by
          have hscaled := mul_le_mul_of_nonneg_left hdistance (by positivity : 0 ≤ (smoothness : ℝ))
          linarith
    simpa only [InnerProductSpace.toDual_apply_eq_toDualMap_apply,
      InnerProductSpace.toLinearIsometry_toDual, LinearIsometry.norm_map] using hbound
  · exact hbound_integrable
  · filter_upwards [] with datum
    intro parameter _
    exact hpointwise datum parameter

/--
Whole-space RERM contraction with the A1 derivative bridge and the A2
strong-monotonicity bridge both discharged. The remaining loss measurability
and pointwise differentiability hypotheses are the analytic conditions needed
to turn the paper's smooth loss description into a Bochner-gradient identity.
-/
theorem dist_measureRRM_sub_le_of_A1_A2_wassersteinSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hmodulus : 0 < modulus)
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimization model update)
    (hloss_meas : ∀ distributionParameter evaluatedParameter,
      ∀ᶠ parameter in nhds evaluatedParameter,
        AEStronglyMeasurable (fun datum => model.loss datum parameter)
          (model.dataLaw distributionParameter : Measure Data))
    (hpointwise : ∀ datum parameter,
      HasGradientAt (fun theta => model.loss datum theta) (gradient datum parameter) parameter)
    (first second : Parameter) :
    dist (update first) (update second) ≤
      (sensitivity * (smoothness : ℝ) / modulus) * dist first second := by
  have hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter := fun distributionParameter evaluatedParameter =>
    hasGradientAt_measureDecoupledPerformativeRisk_of_jointSmooth model gradient hjoint
      distributionParameter evaluatedParameter
      (hloss_meas distributionParameter evaluatedParameter)
      (hintegrable distributionParameter evaluatedParameter) hpointwise 1 (by norm_num)
  have hinner : IsMeasureFrozenGradientStronglyMonotoneInner model gradient modulus :=
    isMeasureFrozenGradientStronglyMonotoneInner_of_pointwiseStronglyConvex
      model gradient hstrong hintegrable
  have hmonotone : IsMeasureFrozenGradientStronglyMonotone model gradient modulus :=
    isMeasureFrozenGradientStronglyMonotone_of_inner model gradient hinner
  have hraw := norm_measureRRM_sub_le_of_wassersteinSensitive_hasGradientAt
    model gradient hjoint.2 hintegrable hmodulus hsensitive update hrrm hgradientAt hmonotone
      first second
  calc
    dist (update first) (update second) = ‖update first - update second‖ := dist_eq_norm _ _
    _ ≤ ((smoothness : ℝ) * (sensitivity * dist first second)) / modulus := hraw
    _ = (sensitivity * (smoothness : ℝ) / modulus) * dist first second := by ring

/--
The numerical RERM condition used in Theorem 3.10 makes the population
contraction factor nonnegative and strictly below one half.  This is the
outer-contraction regime used by the empirical two-phase recurrence.
-/
theorem rerm_contractionRatio_nonneg_lt_half_of_theorem310Condition
    {sensitivity modulus : ℝ} {smoothness : NNReal}
    (hsensitivity_nonneg : 0 ≤ sensitivity) (hsmoothness_pos : 0 < (smoothness : ℝ))
    (hmodulus_pos : 0 < modulus)
    (hsensitivity_lt : sensitivity < modulus / (2 * (smoothness : ℝ))) :
    0 ≤ sensitivity * (smoothness : ℝ) / modulus ∧
      sensitivity * (smoothness : ℝ) / modulus < 1 / 2 :=
  Optimization.contraction_ratio_nonneg_lt_half_of_lt_modulus_div_two_smoothness
    hsensitivity_nonneg hsmoothness_pos hmodulus_pos hsensitivity_lt

/--
The population RERM update satisfies the complete contraction datum required
by the Theorem 3.10 two-phase argument: its A1/A2 contraction estimate has a
nonnegative factor strictly below one half under the paper's RERM numerical
condition.
-/
theorem rerm_populationContractionData_of_A1_A2_theorem310
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hsensitivity_nonneg : 0 ≤ sensitivity)
    (hsmoothness_pos : 0 < (smoothness : ℝ)) (hmodulus_pos : 0 < modulus)
    (hsensitivity_lt : sensitivity < modulus / (2 * (smoothness : ℝ)))
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimization model update)
    (hloss_meas : ∀ distributionParameter evaluatedParameter,
      ∀ᶠ parameter in nhds evaluatedParameter,
        AEStronglyMeasurable (fun datum => model.loss datum parameter)
          (model.dataLaw distributionParameter : Measure Data))
    (hpointwise : ∀ datum parameter,
      HasGradientAt (fun theta => model.loss datum theta) (gradient datum parameter) parameter) :
    (0 ≤ sensitivity * (smoothness : ℝ) / modulus ∧
      sensitivity * (smoothness : ℝ) / modulus < 1 / 2) ∧
      ∀ first second,
        dist (update first) (update second) ≤
          (sensitivity * (smoothness : ℝ) / modulus) * dist first second := by
  refine ⟨rerm_contractionRatio_nonneg_lt_half_of_theorem310Condition
    hsensitivity_nonneg hsmoothness_pos hmodulus_pos hsensitivity_lt, ?_⟩
  intro first second
  exact dist_measureRRM_sub_le_of_A1_A2_wassersteinSensitive
    model gradient hjoint hintegrable hmodulus_pos hsensitive hstrong update hrrm
      hloss_meas hpointwise first second

/--
Domain-constrained A1/A2 version of the population RRM contraction estimate.
Unlike the whole-space convenience theorem above, this is the form needed by
the constrained RERM dynamics in the paper: the update only has to contract
between deployed parameters in its feasible convex domain.
-/
theorem dist_measureRRMOn_sub_le_of_A1_A2_wassersteinSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hsensitivity_nonneg : 0 ≤ sensitivity)
    (hmodulus : 0 < modulus) (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimizationOn model domain update)
    (hloss_meas : ∀ distributionParameter evaluatedParameter,
      ∀ᶠ parameter in nhds evaluatedParameter,
        AEStronglyMeasurable (fun datum => model.loss datum parameter)
          (model.dataLaw distributionParameter : Measure Data))
    (hpointwise : ∀ datum parameter,
      HasGradientAt (fun theta => model.loss datum theta) (gradient datum parameter) parameter)
    (first second : Parameter) (hfirst : first ∈ domain) (hsecond : second ∈ domain) :
    dist (update first) (update second) ≤
      (sensitivity * (smoothness : ℝ) / modulus) * dist first second := by
  have hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter := fun distributionParameter evaluatedParameter =>
    hasGradientAt_measureDecoupledPerformativeRisk_of_jointSmooth model gradient hjoint
      distributionParameter evaluatedParameter
      (hloss_meas distributionParameter evaluatedParameter)
      (hintegrable distributionParameter evaluatedParameter) hpointwise 1 (by norm_num)
  have hinner : IsMeasureFrozenGradientStronglyMonotoneInner model gradient modulus :=
    isMeasureFrozenGradientStronglyMonotoneInner_of_pointwiseStronglyConvex
      model gradient hstrong hintegrable
  have hraw := norm_measureRRMOn_sub_le_of_wassersteinSensitive_hasGradientAt
    model gradient hjoint.2 hintegrable hsensitivity_nonneg hmodulus hsensitive domain hconvex
      update hrrm hgradientAt hinner first second hfirst hsecond
  calc
    dist (update first) (update second) = ‖update first - update second‖ := dist_eq_norm _ _
    _ ≤ (sensitivity * (smoothness : ℝ) / modulus) * ‖first - second‖ := hraw
    _ = (sensitivity * (smoothness : ℝ) / modulus) * dist first second := by
      rw [dist_eq_norm]

/--
The constrained A1/A2 population RRM update supplies the exact contraction
datum for Theorem 3.10 on the feasible parameter domain.  Its strict-half
numerical part is intentionally separated from the domain membership premise.
-/
theorem rermOn_populationContractionData_of_A1_A2_theorem310
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity modulus : ℝ} (hsensitivity_nonneg : 0 ≤ sensitivity)
    (hsmoothness_pos : 0 < (smoothness : ℝ)) (hmodulus_pos : 0 < modulus)
    (hsensitivity_lt : sensitivity < modulus / (2 * (smoothness : ℝ)))
    (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (hconvex : Convex ℝ domain)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimizationOn model domain update)
    (hloss_meas : ∀ distributionParameter evaluatedParameter,
      ∀ᶠ parameter in nhds evaluatedParameter,
        AEStronglyMeasurable (fun datum => model.loss datum parameter)
          (model.dataLaw distributionParameter : Measure Data))
    (hpointwise : ∀ datum parameter,
      HasGradientAt (fun theta => model.loss datum theta) (gradient datum parameter) parameter) :
    (0 ≤ sensitivity * (smoothness : ℝ) / modulus ∧
      sensitivity * (smoothness : ℝ) / modulus < 1 / 2) ∧
      ∀ first ∈ domain, ∀ second ∈ domain,
        dist (update first) (update second) ≤
          (sensitivity * (smoothness : ℝ) / modulus) * dist first second := by
  refine ⟨rerm_contractionRatio_nonneg_lt_half_of_theorem310Condition
    hsensitivity_nonneg hsmoothness_pos hmodulus_pos hsensitivity_lt, ?_⟩
  intro first hfirst second hsecond
  exact dist_measureRRMOn_sub_le_of_A1_A2_wassersteinSensitive
    model gradient hjoint hintegrable hsensitivity_nonneg hmodulus_pos hsensitive hstrong domain hconvex
      update hrrm hloss_meas hpointwise first second hfirst hsecond

/--
A domain-stable point is fixed by a constrained RRM selector under the A1/A2
derivative and strong-convexity bridges.  This packages the source-facing
fixed-point datum needed to start the empirical RERM recurrence.
-/
theorem measureRRMOn_fixedPoint_of_isMeasurePerformativelyStableOn_of_A1_A2
