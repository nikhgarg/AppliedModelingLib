@[simp] theorem performativeRisk_eq_decoupledPerformativeRisk_self
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (parameter : Parameter) :
    performativeRisk model parameter =
      decoupledPerformativeRisk model parameter parameter :=
  rfl

/-- `parameter` minimizes loss on a specified finite data law. -/
def IsPopulationRiskMinimizer {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (law : PMF Data) (parameter : Parameter) : Prop :=
  ∀ candidate, pmfExp law (fun datum => model.loss datum parameter) ≤
    pmfExp law (fun datum => model.loss datum candidate)

/-- A performatively stable parameter relative to a designated parameter domain. -/
def IsPerformativelyStableOn {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (domain : Set Parameter) (parameter : Parameter) : Prop :=
  IsPopulationRiskMinimizerOn model domain (model.dataLaw parameter) parameter

/-- The two-point compact parameter domain used to isolate Proposition 4.1's missing convexity. -/
def proposition41NonconvexDomain : Set ℝ := {(-1 : ℝ), 1}

/--
A continuous convex square loss whose frozen target reverses the two points of
`proposition41NonconvexDomain`.
-/
def proposition41NonconvexLoss (datum : Bool) (candidate : ℝ) : ℝ :=
  (candidate - if datum then (1 : ℝ) else -1) ^ 2

/--
The distribution map needed only on the two-point domain for the Proposition
4.1 counterexample. Its arbitrary extension outside that domain is harmless:
domain-restricted sensitivity is the source notion for a constrained Θ.
-/
noncomputable def proposition41NonconvexLaw (deployed : ℝ) : PMF Bool :=
  if deployed = -1 then PMF.pure true else PMF.pure false

/-- A finite model realizing the compact nonconvex-domain obstruction to Proposition 4.1. -/
noncomputable def proposition41NonconvexModel : FinitePerformativeModel ℝ Bool where
  dataLaw := proposition41NonconvexLaw
  loss := proposition41NonconvexLoss

/-- The Boolean metric used by the finite model has diameter at most one. -/
private theorem proposition41Nonconvex_bool_diameter (first second : Bool) :
    dist first second ≤ (1 : ℝ) := by
  cases first <;> cases second <;> norm_num [proposition42Bool_dist]

/-- The two-point source domain is compact. -/
theorem proposition41NonconvexDomain_isCompact : IsCompact proposition41NonconvexDomain := by
  rw [proposition41NonconvexDomain]
  exact (Set.finite_singleton (1 : ℝ)).insert (-1 : ℝ) |>.isCompact

/-- The source square loss is convex in its evaluated parameter on all of ℝ. -/
theorem proposition41NonconvexLoss_convex (datum : Bool) :
    ConvexOn ℝ Set.univ (proposition41NonconvexLoss datum) := by
  refine ⟨convex_univ, ?_⟩
  intro first _ second _ firstWeight secondWeight hfirstWeight hsecondWeight hweights
  simp only [smul_eq_mul]
  let target : ℝ := if datum then 1 else -1
  have hproduct : 0 ≤ firstWeight * secondWeight * (first - second) ^ 2 := by positivity
  have hsecondWeight : secondWeight = 1 - firstWeight := by linarith
  change (firstWeight * first + secondWeight * second - target) ^ 2 ≤
    firstWeight * (first - target) ^ 2 + secondWeight * (second - target) ^ 2
  calc
    (firstWeight * first + secondWeight * second - target) ^ 2 =
        firstWeight * (first - target) ^ 2 + secondWeight * (second - target) ^ 2 -
          firstWeight * secondWeight * (first - second) ^ 2 := by
      rw [hsecondWeight]
      ring
    _ ≤ firstWeight * (first - target) ^ 2 + secondWeight * (second - target) ^ 2 :=
      sub_le_self _ hproduct

/-- The finite square loss is jointly continuous in the data and evaluated parameter. -/
theorem proposition41NonconvexLoss_continuous :
    Continuous (fun point : Bool × ℝ => proposition41NonconvexLoss point.1 point.2) := by
  rw [continuous_prod_of_discrete_left]
  intro datum
  cases datum <;> simp [proposition41NonconvexLoss] <;> fun_prop

/--
On its declared parameter domain, the counterexample's induced laws are
one-Wasserstein-sensitive with coefficient one.
-/
theorem proposition41NonconvexModel_finiteWassersteinSensitiveOn :
    IsFiniteWassersteinSensitiveOn proposition41NonconvexModel
      proposition41NonconvexDomain 1 := by
  intro first hfirst second hsecond
  have hfirst_cases : first = -1 ∨ first = 1 := by
    simpa [proposition41NonconvexDomain] using hfirst
  have hsecond_cases : second = -1 ∨ second = 1 := by
    simpa [proposition41NonconvexDomain] using hsecond
  rcases hfirst_cases with rfl | rfl <;> rcases hsecond_cases with rfl | rfl
  · have hmass : ∀ datum : Bool,
        |((PMF.pure true : PMF Bool) datum).toReal - (PMF.pure true datum).toReal| ≤ (0 : ℝ) := by
      intro datum
      simp
    have hbound := FiniteCoupling.finiteWassersteinOne_le_diameter_card_mul_of_forall_abs_sub_le
      (PMF.pure true) (PMF.pure true) 1 proposition41Nonconvex_bool_diameter hmass
    simpa [proposition41NonconvexModel, proposition41NonconvexLaw] using hbound
  · have hmass : ∀ datum : Bool,
        |((PMF.pure true : PMF Bool) datum).toReal - (PMF.pure false datum).toReal| ≤ (1 : ℝ) := by
      intro datum
      cases datum <;> simp [PMF.pure_apply]
    have hbound := FiniteCoupling.finiteWassersteinOne_le_diameter_card_mul_of_forall_abs_sub_le
      (PMF.pure true) (PMF.pure false) 1 proposition41Nonconvex_bool_diameter hmass
    norm_num [Fintype.card_bool, proposition41NonconvexModel, proposition41NonconvexLaw,
      Real.dist_eq] at hbound ⊢
    exact hbound
  · have hmass : ∀ datum : Bool,
        |((PMF.pure false : PMF Bool) datum).toReal - (PMF.pure true datum).toReal| ≤ (1 : ℝ) := by
      intro datum
      cases datum <;> simp [PMF.pure_apply]
    have hbound := FiniteCoupling.finiteWassersteinOne_le_diameter_card_mul_of_forall_abs_sub_le
      (PMF.pure false) (PMF.pure true) 1 proposition41Nonconvex_bool_diameter hmass
    norm_num [Fintype.card_bool, proposition41NonconvexModel, proposition41NonconvexLaw,
      Real.dist_eq] at hbound ⊢
    exact hbound
  · have hmass : ∀ datum : Bool,
        |((PMF.pure false : PMF Bool) datum).toReal - (PMF.pure false datum).toReal| ≤ (0 : ℝ) := by
      intro datum
      simp
    have hbound := FiniteCoupling.finiteWassersteinOne_le_diameter_card_mul_of_forall_abs_sub_le
      (PMF.pure false) (PMF.pure false) 1 proposition41Nonconvex_bool_diameter hmass
    convert hbound using 1 <;>
      norm_num [proposition41NonconvexModel, proposition41NonconvexLaw, Real.dist_eq]

/-- The compact nonconvex source domain has no performatively stable point. -/
theorem proposition41NonconvexModel_no_performativelyStablePoint :
    ¬ ∃ parameter ∈ proposition41NonconvexDomain,
      IsPerformativelyStableOn proposition41NonconvexModel proposition41NonconvexDomain parameter := by
  rintro ⟨parameter, hparameter, hstable⟩
  have hcases : parameter = -1 ∨ parameter = 1 := by
    simpa [proposition41NonconvexDomain] using hparameter
  rcases hcases with rfl | rfl
  · have hminimum := hstable.2 1 (by simp [proposition41NonconvexDomain])
    change decoupledPerformativeRisk proposition41NonconvexModel (-1) (-1) ≤
      decoupledPerformativeRisk proposition41NonconvexModel (-1) 1 at hminimum
    norm_num [decoupledPerformativeRisk, proposition41NonconvexModel,
      proposition41NonconvexLaw, proposition41NonconvexLoss] at hminimum
  · have hminimum := hstable.2 (-1) (by simp [proposition41NonconvexDomain])
    change decoupledPerformativeRisk proposition41NonconvexModel 1 1 ≤
      decoupledPerformativeRisk proposition41NonconvexModel 1 (-1) at hminimum
    norm_num [decoupledPerformativeRisk, proposition41NonconvexModel,
      proposition41NonconvexLaw, proposition41NonconvexLoss] at hminimum

/-- The finite Proposition 3.6(a) specialization has exactly the stable point `0`. -/
theorem proposition36a_isPerformativelyStableOn_iff (parameter : ℝ) :
    IsPerformativelyStableOn proposition36aModel proposition36aDomain parameter ↔ parameter = 0 := by
  constructor
  · intro hstable
    rcases hstable with ⟨hparameter, hminimizes⟩
    have hlow := hminimizes (-1) (by norm_num : (-1 : ℝ) ∈ proposition36aDomain)
    have hhigh := hminimizes 1 (by norm_num : (1 : ℝ) ∈ proposition36aDomain)
    change decoupledPerformativeRisk proposition36aModel parameter parameter ≤
      decoupledPerformativeRisk proposition36aModel parameter (-1) at hlow
    change decoupledPerformativeRisk proposition36aModel parameter parameter ≤
      decoupledPerformativeRisk proposition36aModel parameter 1 at hhigh
    rw [proposition36a_decoupledPerformativeRisk_eq,
      proposition36a_decoupledPerformativeRisk_eq,
      proposition36aClip_eq_self hparameter] at hlow hhigh
    have hsquare := sq_nonneg parameter
    nlinarith
  · rintro rfl
    constructor
    · norm_num
    · intro candidate _
      change decoupledPerformativeRisk proposition36aModel 0 0 ≤
        decoupledPerformativeRisk proposition36aModel 0 candidate
      rw [proposition36a_decoupledPerformativeRisk_eq,
        proposition36a_decoupledPerformativeRisk_eq]
      norm_num [proposition36aClip]

/--
On a compact domain, continuity of the jointly decoupled risk gives a minimizer
for every frozen deployed parameter.  This is the existence-of-best-responses
part of the Berge step in the Appendix D.5 proof of Proposition 4.1.
-/
theorem performativeBestResponseOn_nonempty_of_compact
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (hcompact : IsCompact domain) (hne : domain.Nonempty)
    (hjoint : Continuous (fun point : Parameter × Parameter =>
      decoupledPerformativeRisk model point.1 point.2))
    (deployed : domain) :
    (performativeBestResponseOn model domain deployed).Nonempty := by
  have hcontinuous : Continuous (fun candidate : Parameter =>
      decoupledPerformativeRisk model deployed.1 candidate) :=
    hjoint.comp (continuous_const.prodMk continuous_id)
  obtain ⟨minimizer, hminimizer_mem, hminimizer⟩ :=
    hcompact.exists_isMinOn hne hcontinuous.continuousOn
  refine ⟨minimizer, ?_⟩
  change minimizer ∈ domain ∧ ∀ candidate ∈ domain,
    decoupledPerformativeRisk model deployed.1 minimizer ≤
      decoupledPerformativeRisk model deployed.1 candidate
  exact ⟨hminimizer_mem, hminimizer⟩

/-- Every frozen-law best-response value is closed under the same continuity hypothesis. -/
theorem isClosed_performativeBestResponseOn_of_compact
    {Parameter Data : Type*} [TopologicalSpace Parameter] [T2Space Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (hcompact : IsCompact domain)
    (hjoint : Continuous (fun point : Parameter × Parameter =>
      decoupledPerformativeRisk model point.1 point.2))
    (deployed : domain) : IsClosed (performativeBestResponseOn model domain deployed) := by
  have hcontinuous : Continuous (fun candidate : Parameter =>
      decoupledPerformativeRisk model deployed.1 candidate) :=
    hjoint.comp (continuous_const.prodMk continuous_id)
  have hminimum : IsClosed {candidate : Parameter | ∀ other : domain,
      decoupledPerformativeRisk model deployed.1 candidate ≤
        decoupledPerformativeRisk model deployed.1 other.1} := by
    simpa only [Set.setOf_forall] using
      (isClosed_iInter fun other : domain =>
        isClosed_le hcontinuous continuous_const)
  unfold performativeBestResponseOn IsPopulationRiskMinimizerOn
  change IsClosed {candidate : Parameter | candidate ∈ domain ∧ ∀ other ∈ domain,
    decoupledPerformativeRisk model deployed.1 candidate ≤
      decoupledPerformativeRisk model deployed.1 other}
  have hvalue_eq :
      {candidate : Parameter | candidate ∈ domain ∧ ∀ other ∈ domain,
        decoupledPerformativeRisk model deployed.1 candidate ≤
          decoupledPerformativeRisk model deployed.1 other} =
      {candidate : Parameter | candidate ∈ domain ∧ ∀ other : domain,
        decoupledPerformativeRisk model deployed.1 candidate ≤
          decoupledPerformativeRisk model deployed.1 other.1} := by
    ext candidate
    simp only [Set.mem_setOf_eq]
    constructor
    · rintro ⟨hcandidate, hminimum⟩
      exact ⟨hcandidate, fun other => hminimum other other.2⟩
    · rintro ⟨hcandidate, hminimum⟩
      exact ⟨hcandidate, fun other hother => hminimum ⟨other, hother⟩⟩
  rw [hvalue_eq]
  simpa only [Set.setOf_and] using hcompact.isClosed.inter hminimum

/-- Compactness of every frozen-law best-response value. -/
theorem isCompact_performativeBestResponseOn_of_compact
    {Parameter Data : Type*} [TopologicalSpace Parameter] [T2Space Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (hcompact : IsCompact domain)
    (hjoint : Continuous (fun point : Parameter × Parameter =>
      decoupledPerformativeRisk model point.1 point.2))
    (deployed : domain) : IsCompact (performativeBestResponseOn model domain deployed) :=
  hcompact.of_isClosed_subset
    (isClosed_performativeBestResponseOn_of_compact model domain hcompact hjoint deployed)
    (fun _candidate hcandidate => hcandidate.1)

/--
Frozen-risk convexity makes the entire best-response correspondence convex
valued.  This is the convex-loss step in the Appendix D.5 proof of Proposition
4.1, stated directly for the finite-PMF decoupled risk.
-/
theorem convex_performativeBestResponseOn
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [NormedSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (hfrozenConvex : ∀ deployed : domain,
      ConvexOn ℝ domain (fun candidate =>
        decoupledPerformativeRisk model deployed.1 candidate)) :
    ∀ deployed : domain, Convex ℝ (performativeBestResponseOn model domain deployed) := by
  intro deployed
  rw [convex_iff_add_mem]
  intro first hfirst second hsecond a b ha hb hab
  change a • first + b • second ∈ domain ∧ ∀ candidate ∈ domain,
    decoupledPerformativeRisk model deployed.1 (a • first + b • second) ≤
      decoupledPerformativeRisk model deployed.1 candidate
  constructor
  · exact (hfrozenConvex deployed).1 hfirst.1 hsecond.1 ha hb hab
  · intro candidate hcandidate
    have hconvexity := (hfrozenConvex deployed).2 hfirst.1 hsecond.1 ha hb hab
    have hfirst_min := hfirst.2 candidate hcandidate
    have hsecond_min := hsecond.2 candidate hcandidate
    change decoupledPerformativeRisk model deployed.1 first ≤
      decoupledPerformativeRisk model deployed.1 candidate at hfirst_min
    change decoupledPerformativeRisk model deployed.1 second ≤
      decoupledPerformativeRisk model deployed.1 candidate at hsecond_min
    simp only [smul_eq_mul] at hconvexity
    calc
      decoupledPerformativeRisk model deployed.1 (a • first + b • second) ≤
          a * decoupledPerformativeRisk model deployed.1 first +
            b * decoupledPerformativeRisk model deployed.1 second := hconvexity
      _ ≤ a * decoupledPerformativeRisk model deployed.1 candidate +
            b * decoupledPerformativeRisk model deployed.1 candidate :=
          add_le_add (mul_le_mul_of_nonneg_left hfirst_min ha)
            (mul_le_mul_of_nonneg_left hsecond_min hb)
      _ = decoupledPerformativeRisk model deployed.1 candidate := by
          rw [← add_mul, hab, one_mul]

/-- Pointwise convex loss implies convexity of every finite-PMF frozen risk. -/
theorem convexOn_decoupledPerformativeRisk_of_lossConvex
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [NormedSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (hconvex : Convex ℝ domain)
    (hlossConvex : ∀ datum, ConvexOn ℝ domain (model.loss datum)) :
    ∀ deployed : domain, ConvexOn ℝ domain (fun candidate =>
      decoupledPerformativeRisk model deployed.1 candidate) := by
  intro deployed
  simpa only [decoupledPerformativeRisk] using
    (convexOn_pmfExp (model.dataLaw deployed.1) domain hconvex model.loss hlossConvex)

/--
Joint continuity of decoupled risk makes the frozen-law minimizer
correspondence have a closed graph.  This is the direct sufficient condition
used by the local Kakutani port; the arXiv proof instead invokes Berge's
upper-hemicontinuity conclusion.
-/
theorem closedGraph_performativeBestResponseOn_of_compact
    {Parameter Data : Type*} [TopologicalSpace Parameter] [T2Space Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (hcompact : IsCompact domain)
    (hjoint : Continuous (fun point : Parameter × Parameter =>
      decoupledPerformativeRisk model point.1 point.2)) :
    closedGraph (performativeBestResponseOn model domain) := by
  have hdeployed : Continuous (fun point : domain × Parameter => (point.1 : Parameter)) :=
    continuous_subtype_val.comp continuous_fst
  have hevaluated : Continuous (fun point : domain × Parameter => point.2) :=
    continuous_snd
  have hleft : Continuous (fun point : domain × Parameter =>
      decoupledPerformativeRisk model point.1 point.2) :=
    hjoint.comp (hdeployed.prodMk hevaluated)
  have hmember : IsClosed {point : domain × Parameter | point.2 ∈ domain} :=
    hcompact.isClosed.preimage hevaluated
  have hminimum : IsClosed {point : domain × Parameter | ∀ candidate : domain,
      decoupledPerformativeRisk model point.1 point.2 ≤
        decoupledPerformativeRisk model point.1 candidate.1} := by
    simpa only [Set.setOf_forall] using
      (isClosed_iInter fun candidate : domain =>
        isClosed_le hleft (hjoint.comp (hdeployed.prodMk continuous_const)))
  unfold closedGraph performativeBestResponseOn
  change IsClosed {point : domain × Parameter |
    point.2 ∈ domain ∧ ∀ candidate ∈ domain,
      decoupledPerformativeRisk model point.1 point.2 ≤
        decoupledPerformativeRisk model point.1 candidate}
  have hgraph_eq :
      {point : domain × Parameter | point.2 ∈ domain ∧ ∀ candidate ∈ domain,
        decoupledPerformativeRisk model point.1 point.2 ≤
          decoupledPerformativeRisk model point.1 candidate} =
      {point : domain × Parameter | point.2 ∈ domain ∧ ∀ candidate : domain,
        decoupledPerformativeRisk model point.1 point.2 ≤
          decoupledPerformativeRisk model point.1 candidate.1} := by
    ext point
    simp only [Set.mem_setOf_eq]
    constructor
    · rintro ⟨hpoint, hminimum⟩
      exact ⟨hpoint, fun candidate => hminimum candidate candidate.2⟩
    · rintro ⟨hpoint, hminimum⟩
      exact ⟨hpoint, fun candidate hcandidate => hminimum ⟨candidate, hcandidate⟩⟩
  rw [hgraph_eq]
  simpa only [Set.setOf_and] using hmember.inter hminimum

