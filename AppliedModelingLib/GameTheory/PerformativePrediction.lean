        _ ≤ (constant : ℝ) * sensitivity * ‖optimal - stable‖ := hquadratic
    calc
      ‖optimal - stable‖ = (2 * (modulus / 2 * ‖optimal - stable‖)) / modulus := by
        field_simp
      _ ≤ (2 * ((constant : ℝ) * sensitivity)) / modulus := by
        exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hcancel (by norm_num))
          hmodulus.le
      _ = 2 * (constant : ℝ) * sensitivity / modulus := by ring

/--
Finite-W₁ version of Theorem 4.3's optimum--stability distance estimate.
The proof is the same finite strongly-convex frozen-risk argument, with the
data-risk shift controlled by the finite-W₁ Lipschitz-test bridge.
-/
theorem norm_performativelyOptimal_sub_stable_le_of_strongConvex_finiteWasserstein
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [Fintype Data] [DecidableEq Data] [MetricSpace Data]
