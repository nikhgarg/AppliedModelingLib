    (iteration : ℕ) (epsilon : ℝ) :
    freshPerformativeTraceLawEmpiricalGradientMassDeviationUpToFailure initialLaw model sampleCount
      deployedOfHistory iteration epsilon ≤
      (iteration : ℝ) * finiteIidEmpiricalGradientMassDeviationTotalFailure
        model epsilon sampleCount := by
  unfold freshPerformativeTraceLawEmpiricalGradientMassDeviationUpToFailure
  apply adaptiveFreshTraceAnyBadProbability_le_mul
  intro round history
  have hconditional :
      adaptiveFreshConditionalBadProbability model.dataLaw deployedOfHistory
        (fun round history batch => finiteIidEmpiricalGradientMassDeviationEvent model
          (deployedOfHistory round history) epsilon batch) round history =
        finiteIidEmpiricalGradientMassDeviationFailure model
          (deployedOfHistory round history) epsilon sampleCount := by
    unfold adaptiveFreshConditionalBadProbability
      finiteIidEmpiricalGradientMassDeviationFailure
      Probability.finiteIidAnyMassDeviationFailure pmfProb
    apply pmfExp_congr
    intro batch
    by_cases hbad : finiteIidEmpiricalGradientMassDeviationEvent model
        (deployedOfHistory round history) epsilon batch <;> simp [hbad]
  rw [hconditional]
  exact finiteIidEmpiricalGradientMassDeviationFailure_le_totalFailure model
    (deployedOfHistory round history) epsilon sampleCount

