/-- A projected repeated-gradient-descent update for a performative model. -/
noncomputable def repeatedGradientDescentUpdate {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (stepSize : ℝ) : Parameter → Parameter :=
  fun deployed => project
    (deployed - stepSize • frozenPopulationGradient model gradient deployed deployed)

/-- Empirical decoupled risk evaluated on a realized finite data sample. -/
noncomputable def empiricalDecoupledPerformativeRisk {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) {sampleCount : ℕ}
    (sample : Fin sampleCount → Data) (evaluatedParameter : Parameter) : ℝ :=
  finiteSampleStatisticMean sample (fun datum => model.loss datum evaluatedParameter)

/-- Empirical decoupled risk is expectation under the sample's empirical PMF. -/
theorem empiricalDecoupledPerformativeRisk_eq_pmfExp_empiricalSampleLaw
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) {sampleCount : ℕ}
    [Nonempty (Fin sampleCount)] (sample : Fin sampleCount → Data)
    (evaluatedParameter : Parameter) :
    empiricalDecoupledPerformativeRisk model sample evaluatedParameter =
      pmfExp (empiricalSampleLaw sample) (fun datum => model.loss datum evaluatedParameter) := by
  simpa [empiricalDecoupledPerformativeRisk] using
    (pmfExp_empiricalSampleLaw_eq_finiteSampleMean sample
      (fun datum => model.loss datum evaluatedParameter)).symm

/--
The realized-sample update rule for Definition 3.9's repeated empirical risk
minimization.  `samples deployed` is the finite sample collected from the law
induced by `deployed`; the sampling-law assertion is deliberately kept separate
from this deterministic empirical optimization definition.
-/
def IsEmpiricalRepeatedRiskMinimizationOn {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    {sampleCount : ℕ} (samples : Parameter → Fin sampleCount → Data)
    (update : Parameter → Parameter) : Prop :=
  ∀ deployed ∈ domain, update deployed ∈ domain ∧ ∀ candidate ∈ domain,
    empiricalDecoupledPerformativeRisk model (samples deployed) (update deployed) ≤
      empiricalDecoupledPerformativeRisk model (samples deployed) candidate

/--
A time-indexed realization of Definition 3.9's repeated empirical risk
minimization.  Each fresh sample is minimized at the parameter deployed in the
preceding round.
-/
def IsRepeatedEmpiricalRiskMinimizationTrajectoryOn {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (sampleCount : ℕ → ℕ)
    (samples : (iteration : ℕ) → Fin (sampleCount iteration) → Data)
    (trajectory : ℕ → Parameter) : Prop :=
  ∀ iteration, trajectory (iteration + 1) ∈ domain ∧ ∀ candidate ∈ domain,
    empiricalDecoupledPerformativeRisk model (samples iteration) (trajectory (iteration + 1)) ≤
      empiricalDecoupledPerformativeRisk model (samples iteration) candidate

/--
Uniform empirical-risk error controls one empirical RRM update around the
population RRM update.  This is the deterministic strong-convexity step in
the RERM branch of Theorem 3.10; a concentration theorem supplies the uniform
deviation premise on a realized sample.
-/
theorem scaled_sq_norm_empiricalRRM_sub_populationRRM_le_of_uniformDeviation
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ}
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) {sampleCount : ℕ}
    (samples : Parameter → Fin sampleCount → Data)
    (empiricalUpdate populationUpdate : Parameter → Parameter)
    (hempirical : IsEmpiricalRepeatedRiskMinimizationOn model domain samples empiricalUpdate)
    (hpopulation : IsRepeatedRiskMinimizationOn model domain populationUpdate)
    (hfirstOrder : ∀ deployed ∈ domain,
      IsFrozenFirstOrderOptimal model gradient deployed (populationUpdate deployed))
    {deviation : ℝ} (huniform : ∀ deployed ∈ domain, ∀ candidate ∈ domain,
      |empiricalDecoupledPerformativeRisk model (samples deployed) candidate -
          decoupledPerformativeRisk model deployed candidate| ≤ deviation)
    (deployed : Parameter) (hdeployed : deployed ∈ domain) :
    modulus / 2 * ‖empiricalUpdate deployed - populationUpdate deployed‖ ^ 2 ≤
      2 * deviation := by
  have hempiricalUpdate := hempirical deployed hdeployed
  have hpopulationUpdate := hpopulation deployed hdeployed
  have hempiricalMin :
      empiricalDecoupledPerformativeRisk model (samples deployed) (empiricalUpdate deployed) ≤
        empiricalDecoupledPerformativeRisk model (samples deployed) (populationUpdate deployed) :=
    hempiricalUpdate.2 (populationUpdate deployed) hpopulationUpdate.1
  have hdeviationEmpirical := huniform deployed hdeployed (empiricalUpdate deployed)
    hempiricalUpdate.1
  have hdeviationPopulation := huniform deployed hdeployed (populationUpdate deployed)
    hpopulationUpdate.1
  have hpopulationRisk_le :
      decoupledPerformativeRisk model deployed (empiricalUpdate deployed) ≤
        decoupledPerformativeRisk model deployed (populationUpdate deployed) + 2 * deviation := by
    have hfirst :
        decoupledPerformativeRisk model deployed (empiricalUpdate deployed) ≤
          empiricalDecoupledPerformativeRisk model (samples deployed) (empiricalUpdate deployed) +
            deviation := by
      rcases abs_le.mp hdeviationEmpirical with ⟨hlower, _⟩
      linarith
    have hthird :
        empiricalDecoupledPerformativeRisk model (samples deployed) (populationUpdate deployed) ≤
          decoupledPerformativeRisk model deployed (populationUpdate deployed) + deviation := by
      rcases abs_le.mp hdeviationPopulation with ⟨_, hupper⟩
      linarith
    linarith
  have hstrongLower := frozenRisk_strongConvex_lowerBound model gradient hstrong deployed
    (populationUpdate deployed) (empiricalUpdate deployed)
  have hfirstOrderValue := hfirstOrder deployed hdeployed (empiricalUpdate deployed)
  have hpairing_nonneg : 0 ≤ frozenGradientPairing model gradient deployed
      (populationUpdate deployed) (empiricalUpdate deployed - populationUpdate deployed) :=
    hfirstOrderValue
  nlinarith

/-- The corresponding norm-form empirical-RRM perturbation estimate. -/
theorem norm_empiricalRRM_sub_populationRRM_le_of_uniformDeviation
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) {sampleCount : ℕ}
    (samples : Parameter → Fin sampleCount → Data)
    (empiricalUpdate populationUpdate : Parameter → Parameter)
    (hempirical : IsEmpiricalRepeatedRiskMinimizationOn model domain samples empiricalUpdate)
    (hpopulation : IsRepeatedRiskMinimizationOn model domain populationUpdate)
    (hfirstOrder : ∀ deployed ∈ domain,
      IsFrozenFirstOrderOptimal model gradient deployed (populationUpdate deployed))
    {deviation : ℝ} (hdeviation_nonneg : 0 ≤ deviation)
    (huniform : ∀ deployed ∈ domain, ∀ candidate ∈ domain,
      |empiricalDecoupledPerformativeRisk model (samples deployed) candidate -
          decoupledPerformativeRisk model deployed candidate| ≤ deviation)
    (deployed : Parameter) (hdeployed : deployed ∈ domain) :
    ‖empiricalUpdate deployed - populationUpdate deployed‖ ≤
      Real.sqrt (4 * deviation / modulus) := by
  have hscaled := scaled_sq_norm_empiricalRRM_sub_populationRRM_le_of_uniformDeviation
    model gradient hstrong domain samples empiricalUpdate populationUpdate hempirical hpopulation
    hfirstOrder huniform deployed hdeployed
  have hsq : ‖empiricalUpdate deployed - populationUpdate deployed‖ ^ 2 ≤
      4 * deviation / modulus := by
    apply (le_div_iff₀ hmodulus).mpr
    nlinarith
  have hright_nonneg : 0 ≤ 4 * deviation / modulus := by positivity
  have hsq_sqrt : ‖empiricalUpdate deployed - populationUpdate deployed‖ ^ 2 ≤
      (Real.sqrt (4 * deviation / modulus)) ^ 2 := by
    simpa [Real.sq_sqrt hright_nonneg] using hsq
  exact (sq_le_sq₀ (norm_nonneg _) (Real.sqrt_nonneg _)).mp hsq_sqrt

/--
One-step empirical minimization is close to a frozen-law population minimizer
under uniform loss deviation and strong convexity.
-/
theorem norm_empiricalRiskMinimizer_sub_populationRiskMinimizer_le_of_uniformDeviation
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) {sampleCount : ℕ} (sample : Fin sampleCount → Data)
    (deployed empiricalMinimizer populationMinimizer : Parameter)
    (hempirical : empiricalMinimizer ∈ domain ∧ ∀ candidate ∈ domain,
      empiricalDecoupledPerformativeRisk model sample empiricalMinimizer ≤
        empiricalDecoupledPerformativeRisk model sample candidate)
    (hpopulation : IsPopulationRiskMinimizerOn model domain (model.dataLaw deployed)
      populationMinimizer)
    (hfirstOrder : IsFrozenFirstOrderOptimal model gradient deployed populationMinimizer)
    {deviation : ℝ} (hdeviation_nonneg : 0 ≤ deviation)
    (huniform : ∀ candidate ∈ domain,
      |empiricalDecoupledPerformativeRisk model sample candidate -
          decoupledPerformativeRisk model deployed candidate| ≤ deviation) :
    ‖empiricalMinimizer - populationMinimizer‖ ≤
      Real.sqrt (4 * deviation / modulus) := by
  have hmin := hempirical.2 populationMinimizer hpopulation.1
  have hdeviationEmpirical := huniform empiricalMinimizer hempirical.1
  have hdeviationPopulation := huniform populationMinimizer hpopulation.1
  have hpopulationRisk_le :
      decoupledPerformativeRisk model deployed empiricalMinimizer ≤
        decoupledPerformativeRisk model deployed populationMinimizer + 2 * deviation := by
    have hfirst :
        decoupledPerformativeRisk model deployed empiricalMinimizer ≤
          empiricalDecoupledPerformativeRisk model sample empiricalMinimizer + deviation := by
      rcases abs_le.mp hdeviationEmpirical with ⟨hlower, _⟩
      linarith
    have hthird :
        empiricalDecoupledPerformativeRisk model sample populationMinimizer ≤
          decoupledPerformativeRisk model deployed populationMinimizer + deviation := by
      rcases abs_le.mp hdeviationPopulation with ⟨_, hupper⟩
      linarith
    linarith
  have hstrongLower := frozenRisk_strongConvex_lowerBound model gradient hstrong deployed
    populationMinimizer empiricalMinimizer
  have hpairing_nonneg : 0 ≤ frozenGradientPairing model gradient deployed populationMinimizer
      (empiricalMinimizer - populationMinimizer) := hfirstOrder empiricalMinimizer
  have hscaled : modulus / 2 * ‖empiricalMinimizer - populationMinimizer‖ ^ 2 ≤
      2 * deviation := by
    nlinarith
  have hsq : ‖empiricalMinimizer - populationMinimizer‖ ^ 2 ≤
      4 * deviation / modulus := by
    apply (le_div_iff₀ hmodulus).mpr
    nlinarith
  have hright_nonneg : 0 ≤ 4 * deviation / modulus := by positivity
  have hsq_sqrt : ‖empiricalMinimizer - populationMinimizer‖ ^ 2 ≤
      (Real.sqrt (4 * deviation / modulus)) ^ 2 := by
    simpa [Real.sq_sqrt hright_nonneg] using hsq
  exact (sq_le_sq₀ (norm_nonneg _) (Real.sqrt_nonneg _)).mp hsq_sqrt

/--
Finite-prefix RERM stability around a contractive population retraining map.
The perturbation radius is the strong-convexity conversion of the per-round
uniform empirical-risk deviation used in Theorem 3.10.
-/
theorem dist_repeatedEmpiricalRiskMinimizationTrajectory_le_radius_of_uniformDeviation
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (sampleCount : ℕ → ℕ)
    (samples : (iteration : ℕ) → Fin (sampleCount iteration) → Data)
    (trajectory : ℕ → Parameter)
    (htrajectory : IsRepeatedEmpiricalRiskMinimizationTrajectoryOn model domain sampleCount
      samples trajectory)
    (populationUpdate : Parameter → Parameter)
    (hpopulation : IsRepeatedRiskMinimizationOn model domain populationUpdate)
    (hfirstOrder : ∀ deployed ∈ domain,
      IsFrozenFirstOrderOptimal model gradient deployed (populationUpdate deployed))
    (stable : Parameter) {contraction deviation radius : ℝ} (horizon : ℕ)
    (hcontraction_nonneg : 0 ≤ contraction)
    (hstable : populationUpdate stable = stable)
    (hcontract : ∀ parameter,
      dist (populationUpdate parameter) (populationUpdate stable) ≤
        contraction * dist parameter stable)
    (hdeviation_nonneg : 0 ≤ deviation)
    (huniform : ∀ iteration, iteration < horizon → ∀ candidate ∈ domain,
      |empiricalDecoupledPerformativeRisk model (samples iteration) candidate -
          decoupledPerformativeRisk model (trajectory iteration) candidate| ≤ deviation)
    (hinitial : trajectory 0 ∈ domain ∧ dist (trajectory 0) stable ≤ radius)
    (herror_absorbed : Real.sqrt (4 * deviation / modulus) ≤
      (1 - contraction) * radius) :
    ∀ iteration, iteration ≤ horizon → dist (trajectory iteration) stable ≤ radius := by
  have hdomain : ∀ iteration, trajectory iteration ∈ domain := by
    intro iteration
    induction iteration with
    | zero => exact hinitial.1
    | succ iteration _ => exact (htrajectory iteration).1
  apply Optimization.dist_le_radius_of_perturbed_contraction_up_to
    (update := populationUpdate) (trajectory := trajectory) (fixedPoint := stable) horizon
    hcontraction_nonneg hstable hcontract
  · intro iteration hiteration
    rw [dist_eq_norm]
    exact norm_empiricalRiskMinimizer_sub_populationRiskMinimizer_le_of_uniformDeviation
      model gradient hmodulus hstrong domain (samples iteration) (trajectory iteration)
      (trajectory (iteration + 1)) (populationUpdate (trajectory iteration))
      (htrajectory iteration)
      (hpopulation (trajectory iteration) (hdomain iteration))
      (hfirstOrder (trajectory iteration) (hdomain iteration)) hdeviation_nonneg
      (huniform iteration hiteration)
  · exact hinitial.2
  · exact herror_absorbed

/--
Finite-horizon probability bridge for the RERM branch of Theorem 3.10.  It
uses a union bound over measurable uniform empirical-risk events; concentration
of those events is a separate finite-sample obligation.
-/
theorem measureProb_repeatedEmpiricalRiskMinimizationTrajectory_le_radius_up_to
    {Outcome Parameter Data : Type*} [MeasurableSpace Outcome]
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (law : Measure Outcome) [IsProbabilityMeasure law]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (domain : Set Parameter) (sampleCount : ℕ → ℕ)
    (samples : Outcome → (iteration : ℕ) → Fin (sampleCount iteration) → Data)
    (trajectory : Outcome → ℕ → Parameter)
    (htrajectory : ∀ outcome,
      IsRepeatedEmpiricalRiskMinimizationTrajectoryOn model domain sampleCount
        (samples outcome) (trajectory outcome))
    (populationUpdate : Parameter → Parameter)
    (hpopulation : IsRepeatedRiskMinimizationOn model domain populationUpdate)
    (hfirstOrder : ∀ deployed ∈ domain,
      IsFrozenFirstOrderOptimal model gradient deployed (populationUpdate deployed))
    (stable : Parameter) {contraction deviation radius : ℝ} (horizon : ℕ)
    (hcontraction_nonneg : 0 ≤ contraction)
    (hstable : populationUpdate stable = stable)
    (hcontract : ∀ parameter,
      dist (populationUpdate parameter) (populationUpdate stable) ≤
        contraction * dist parameter stable)
    (hdeviation_nonneg : 0 ≤ deviation)
    (hgood_measurable : ∀ iteration, iteration ∈ Finset.range horizon →
      MeasurableSet {outcome | ∀ candidate ∈ domain,
        |empiricalDecoupledPerformativeRisk model (samples outcome iteration) candidate -
            decoupledPerformativeRisk model (trajectory outcome iteration) candidate| ≤ deviation})
    (hinitial : ∀ outcome,
      trajectory outcome 0 ∈ domain ∧ dist (trajectory outcome 0) stable ≤ radius)
    (herror_absorbed : Real.sqrt (4 * deviation / modulus) ≤
      (1 - contraction) * radius) :
    1 - ∑ iteration ∈ Finset.range horizon, measureProb law (fun outcome =>
      ¬ ∀ candidate ∈ domain,
        |empiricalDecoupledPerformativeRisk model (samples outcome iteration) candidate -
            decoupledPerformativeRisk model (trajectory outcome iteration) candidate| ≤ deviation) ≤
      measureProb law (fun outcome => ∀ iteration, iteration ≤ horizon →
        dist (trajectory outcome iteration) stable ≤ radius) := by
  classical
  let good : ℕ → Outcome → Prop := fun iteration outcome => ∀ candidate ∈ domain,
    |empiricalDecoupledPerformativeRisk model (samples outcome iteration) candidate -
        decoupledPerformativeRisk model (trajectory outcome iteration) candidate| ≤ deviation
  have hgood_measurable' : ∀ iteration ∈ Finset.range horizon,
      MeasurableSet {outcome | good iteration outcome} := by
    intro iteration hiteration
    simpa [good] using hgood_measurable iteration hiteration
  have hgood_probability := measureProb_inter_ge_one_sub_sum_compl law
    (Finset.range horizon) good hgood_measurable'
  have hgood_implies : ∀ outcome,
      (∀ iteration ∈ Finset.range horizon, good iteration outcome) →
      (∀ iteration, iteration ≤ horizon →
        dist (trajectory outcome iteration) stable ≤ radius) := by
    intro outcome hgood iteration hiteration
    apply dist_repeatedEmpiricalRiskMinimizationTrajectory_le_radius_of_uniformDeviation
      model gradient hmodulus hstrong domain sampleCount (samples outcome) (trajectory outcome)
      (htrajectory outcome) populationUpdate hpopulation hfirstOrder stable horizon
      hcontraction_nonneg hstable hcontract hdeviation_nonneg
    · intro round hround candidate hcandidate
      exact hgood round (Finset.mem_range.mpr hround) candidate hcandidate
    · exact hinitial outcome
    · exact herror_absorbed
    · exact hiteration
  calc
    1 - ∑ iteration ∈ Finset.range horizon, measureProb law (fun outcome =>
        ¬ ∀ candidate ∈ domain,
          |empiricalDecoupledPerformativeRisk model (samples outcome iteration) candidate -
              decoupledPerformativeRisk model (trajectory outcome iteration) candidate| ≤ deviation) =
        1 - ∑ iteration ∈ Finset.range horizon,
          measureProb law (fun outcome => ¬ good iteration outcome) := by
            simp [good]
    _ ≤ measureProb law (fun outcome => ∀ iteration ∈ Finset.range horizon,
        good iteration outcome) := hgood_probability
    _ ≤ measureProb law (fun outcome => ∀ iteration, iteration ≤ horizon →
        dist (trajectory outcome iteration) stable ≤ radius) :=
      measureProb_mono law _ _ hgood_implies

/--
The complement of the finite-alphabet uniform-loss deviation event gives the
uniform empirical-risk premise used by empirical RRM.
-/
theorem uniform_empiricalRiskDeviation_of_not_finiteIidUniformScoreDeviationEvent
    {Parameter Data : Type*} [TopologicalSpace Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (deployed : Parameter) {sampleCount : ℕ} (hsampleCount : 0 < sampleCount)
    (sample : Fin sampleCount → Data) (tolerance : ℝ)
    (hgood : ¬ Probability.finiteIidUniformScoreDeviationEvent (model.dataLaw deployed)
      (fun candidate datum => model.loss datum candidate) domain tolerance sample) :
    ∀ candidate ∈ domain,
      |empiricalDecoupledPerformativeRisk model sample candidate -
          decoupledPerformativeRisk model deployed candidate| ≤ tolerance := by
  intro candidate hcandidate
  by_contra hnot
  have hdistance : tolerance <
      |empiricalDecoupledPerformativeRisk model sample candidate -
        decoupledPerformativeRisk model deployed candidate| := lt_of_not_ge hnot
  apply hgood
  refine ⟨candidate, hcandidate, ?_⟩
  have hcount_pos : 0 < (sampleCount : ℝ) := by exact_mod_cast hsampleCount
  have hcount_ne : (sampleCount : ℝ) ≠ 0 := ne_of_gt hcount_pos
  have hrewrite :
      Probability.finiteIidScoreSum (fun datum => model.loss datum candidate) sample -
          (sampleCount : ℝ) * pmfExp (model.dataLaw deployed)
            (fun datum => model.loss datum candidate) =
        (sampleCount : ℝ) *
          (empiricalDecoupledPerformativeRisk model sample candidate -
            decoupledPerformativeRisk model deployed candidate) := by
    unfold Probability.finiteIidScoreSum empiricalDecoupledPerformativeRisk
      decoupledPerformativeRisk pmfExp
    rw [finiteSampleStatisticMean_real_eq_div]
    field_simp
  rw [hrewrite, abs_mul, abs_of_pos hcount_pos]
  exact mul_lt_mul_of_pos_left hdistance hcount_pos

/-- The finite-IID uniform empirical-risk failure event for one deployed parameter. -/
abbrev finiteIidUniformEmpiricalRiskDeviationEvent
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (deployed : Parameter) (tolerance : ℝ) {sampleCount : ℕ}
    (sample : Fin sampleCount → Data) : Prop :=
  Probability.finiteIidUniformScoreDeviationEvent (model.dataLaw deployed)
    (fun candidate datum => model.loss datum candidate) domain tolerance sample

/-- The probability of the finite-IID uniform empirical-risk failure event. -/
noncomputable def finiteIidUniformEmpiricalRiskDeviationFailure
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (deployed : Parameter) (tolerance : ℝ) (sampleCount : ℕ) : ℝ :=
  Probability.finiteIidUniformScoreDeviationFailure (model.dataLaw deployed)
    (fun candidate datum => model.loss datum candidate) domain tolerance sampleCount

/--
An explicit finite-PMF uniform-loss concentration rate for the RERM branch.
It reuses the library's finite-family Hoeffding adapter, so its additional
`[0,1]` loss normalization is visible rather than hidden in the adaptive
sampling argument.
-/
theorem finiteIidUniformEmpiricalRiskDeviationFailure_le_hoeffding
    {Parameter Data : Type*} [Fintype Parameter] [TopologicalSpace Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (deployed : Parameter) (tolerance : ℝ) (sampleCount : ℕ)
    (hsampleCount : 0 < sampleCount) (htolerance : 0 ≤ tolerance)
    (hloss : ∀ candidate datum, model.loss datum candidate ∈ Set.Icc (0 : ℝ) 1) :
    finiteIidUniformEmpiricalRiskDeviationFailure model domain deployed tolerance sampleCount ≤
      (Fintype.card Parameter : ℝ) * 2 *
        Real.exp (-2 * (sampleCount : ℝ) * tolerance ^ 2) := by
  exact Probability.finiteIidUniformScoreDeviationFailure_le_hoeffding
    (model.dataLaw deployed) (fun candidate datum => model.loss datum candidate) domain
    tolerance sampleCount hsampleCount htolerance hloss

/--
For finite data, compactness and loss continuity give a concrete uniform
empirical-risk concentration constructor for each frozen deployed law.
-/
theorem finiteIidUniformEmpiricalRiskDeviationFailure_tendsto_zero
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Data] [DecidableEq Data] [Nonempty Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (deployed : Parameter) (hcompact : IsCompact domain)
    (hcontinuous : ∀ datum, Continuous (fun candidate => model.loss datum candidate))
    (tolerance : ℝ) (htolerance : 0 < tolerance) :
    Filter.Tendsto
      (finiteIidUniformEmpiricalRiskDeviationFailure model domain deployed tolerance)
      Filter.atTop (nhds 0) := by
  exact Probability.finiteIidUniformScoreDeviationFailure_tendsto_zero
    (model.dataLaw deployed) (fun candidate datum => model.loss datum candidate) domain hcompact
    hcontinuous tolerance htolerance

/-- A one-law finite-IID uniform empirical-risk failure probability is nonnegative. -/
theorem finiteIidUniformEmpiricalRiskDeviationFailure_nonneg
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (deployed : Parameter) (tolerance : ℝ) (sampleCount : ℕ) :
    0 ≤ finiteIidUniformEmpiricalRiskDeviationFailure model domain deployed tolerance sampleCount := by
  classical
  unfold finiteIidUniformEmpiricalRiskDeviationFailure
  exact pmfProb_nonneg _ _

/--
One finite-PMF failure budget that is uniform over every possible deployed
parameter.  It is deliberately a finite union bound: this avoids assuming
that adaptive rounds share a fixed deployed distribution.
-/
noncomputable def finiteIidUniformEmpiricalRiskDeviationTotalFailure
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (tolerance : ℝ) (sampleCount : ℕ) : ℝ :=
  ∑ deployed, finiteIidUniformEmpiricalRiskDeviationFailure
    model domain deployed tolerance sampleCount

/-- Every deployed-law failure probability is controlled by the finite uniform budget. -/
theorem finiteIidUniformEmpiricalRiskDeviationFailure_le_totalFailure
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (deployed : Parameter) (tolerance : ℝ) (sampleCount : ℕ) :
    finiteIidUniformEmpiricalRiskDeviationFailure model domain deployed tolerance sampleCount ≤
      finiteIidUniformEmpiricalRiskDeviationTotalFailure model domain tolerance sampleCount := by
  classical
  unfold finiteIidUniformEmpiricalRiskDeviationTotalFailure
  exact Finset.single_le_sum
    (f := fun other =>
      finiteIidUniformEmpiricalRiskDeviationFailure model domain other tolerance sampleCount)
    (s := Finset.univ)
    (fun other _ => finiteIidUniformEmpiricalRiskDeviationFailure_nonneg
      model domain other tolerance sampleCount)
    (Finset.mem_univ deployed)

/-- The finite uniform failure budget vanishes as the IID batch size grows. -/
theorem finiteIidUniformEmpiricalRiskDeviationTotalFailure_tendsto_zero
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data] [Nonempty Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (hcompact : IsCompact domain)
    (hcontinuous : ∀ datum, Continuous (fun candidate => model.loss datum candidate))
    (tolerance : ℝ) (htolerance : 0 < tolerance) :
    Filter.Tendsto (finiteIidUniformEmpiricalRiskDeviationTotalFailure model domain tolerance)
      Filter.atTop (nhds 0) := by
  unfold finiteIidUniformEmpiricalRiskDeviationTotalFailure
  simpa using tendsto_finset_sum Finset.univ (fun deployed _ =>
    finiteIidUniformEmpiricalRiskDeviationFailure_tendsto_zero model domain deployed hcompact
      hcontinuous tolerance htolerance)

/--
The probability that an adaptive round's fresh batch has a uniform
empirical-risk deviation.  The `by classical` block supplies the finite-event
decidability without adding a global classical instance.
-/
noncomputable def freshPerformativeTraceLawEmpiricalRiskDeviationFailure
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (sampleCount : ℕ)
    (deployedOfHistory : ∀ iteration, (Fin iteration → Fin sampleCount → Data) → Parameter)
    (iteration : ℕ) (domain : Set Parameter) (tolerance : ℝ) :
    ℝ := by
  classical
  let event : (Fin (iteration + 1) → Fin sampleCount → Data) → Prop := fun trace =>
    finiteIidUniformEmpiricalRiskDeviationEvent model domain
      (deployedOfHistory iteration (Fin.init trace)) tolerance (trace (Fin.last iteration))
  letI : DecidablePred event := Classical.decPred _
  exact pmfProb (freshPerformativeTraceLaw (BatchIndex := Fin sampleCount)
    initialLaw model deployedOfHistory (iteration + 1)) event

/--
At an adaptive round, the current-batch uniform empirical-risk deviation is
bounded by the single finite parameter-space failure budget.  The conclusion
is a genuine joint-trace probability statement; no independence between
different rounds is assumed.
-/
theorem freshPerformativeTraceLawEmpiricalRiskDeviationFailure_le_totalFailure
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (sampleCount : ℕ)
    (deployedOfHistory : ∀ iteration, (Fin iteration → Fin sampleCount → Data) → Parameter)
    (iteration : ℕ) (domain : Set Parameter) (tolerance : ℝ) :
    freshPerformativeTraceLawEmpiricalRiskDeviationFailure initialLaw model sampleCount
      deployedOfHistory iteration domain tolerance ≤
      finiteIidUniformEmpiricalRiskDeviationTotalFailure model domain tolerance sampleCount := by
  classical
  let event : (Fin (iteration + 1) → Fin sampleCount → Data) → Prop := fun trace =>
    finiteIidUniformEmpiricalRiskDeviationEvent model domain
      (deployedOfHistory iteration (Fin.init trace)) tolerance (trace (Fin.last iteration))
  letI : DecidablePred event := Classical.decPred _
  change pmfProb (freshPerformativeTraceLaw (BatchIndex := Fin sampleCount)
    initialLaw model deployedOfHistory (iteration + 1)) event ≤ _
  apply pmfProb_freshPerformativeTraceLaw_succ_le_of_forall
    initialLaw model deployedOfHistory iteration event
    (finiteIidUniformEmpiricalRiskDeviationTotalFailure model domain tolerance sampleCount)
  intro history
  dsimp [event]
  simpa only [Fin.init_snoc, Fin.snoc_last,
    finiteIidUniformEmpiricalRiskDeviationFailure,
    Probability.finiteIidUniformScoreDeviationFailure_eq] using
    finiteIidUniformEmpiricalRiskDeviationFailure_le_totalFailure model domain
      (deployedOfHistory iteration history) tolerance sampleCount

/--
The event that one of the first `iteration` adaptively selected batches has a
uniform empirical-risk deviation.  It is expressed recursively on a single
finite batch trace, so no inter-round independence is built into the event.
-/
def freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (sampleCount : ℕ)
    (deployedOfHistory : ∀ iteration, (Fin iteration → Fin sampleCount → Data) → Parameter)
    (domain : Set Parameter) (tolerance : ℝ) :
    ∀ iteration, (Fin iteration → Fin sampleCount → Data) → Prop :=
  adaptiveFreshTraceAnyBadEvent (fun iteration history batch =>
    finiteIidUniformEmpiricalRiskDeviationEvent model domain
      (deployedOfHistory iteration history) tolerance batch)

/-- The finite-PMF probability of a uniform loss deviation at any round before a horizon. -/
noncomputable def freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Data] [DecidableEq Data]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (sampleCount : ℕ)
    (deployedOfHistory : ∀ iteration, (Fin iteration → Fin sampleCount → Data) → Parameter)
    (iteration : ℕ) (domain : Set Parameter) (tolerance : ℝ) : ℝ := by
  classical
  letI : DecidablePred (freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
      deployedOfHistory domain tolerance iteration) := Classical.decPred _
  exact pmfProb (freshPerformativeTraceLaw (BatchIndex := Fin sampleCount)
    initialLaw model deployedOfHistory iteration)
    (freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
      deployedOfHistory domain tolerance iteration)

/--
The finite-horizon adaptive union bound: the probability of any uniform-loss
deviation through the next round is at most the previous-horizon probability
plus the common finite parameter-space failure budget.
-/
theorem freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure_succ_le
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (sampleCount : ℕ)
    (deployedOfHistory : ∀ iteration, (Fin iteration → Fin sampleCount → Data) → Parameter)
    (iteration : ℕ) (domain : Set Parameter) (tolerance : ℝ) :
    freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure initialLaw model sampleCount
      deployedOfHistory (iteration + 1) domain tolerance ≤
      freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure initialLaw model sampleCount
        deployedOfHistory iteration domain tolerance +
        finiteIidUniformEmpiricalRiskDeviationTotalFailure model domain tolerance sampleCount := by
  classical
  unfold freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure
  simp only [freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent,
    adaptiveFreshTraceAnyBadEvent]
  have hmarginal :
      (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1)).map
        (fun trace : Fin (iteration + 1) → Fin sampleCount → Data => Fin.init trace) =
      freshPerformativeTraceLaw initialLaw model deployedOfHistory iteration :=
    adaptiveFreshTraceLaw_init_marginal initialLaw model.dataLaw deployedOfHistory iteration
  have hprefix :
      pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1))
        (fun trace => freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
          deployedOfHistory domain tolerance iteration (Fin.init trace)) =
        pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory iteration)
          (freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
            deployedOfHistory domain tolerance iteration) := by
    calc
      pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1))
          (fun trace => freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
            deployedOfHistory domain tolerance iteration (Fin.init trace)) =
        pmfProb ((freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1)).map
          (fun trace : Fin (iteration + 1) → Fin sampleCount → Data => Fin.init trace))
          (freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
            deployedOfHistory domain tolerance iteration) :=
        (pmfProb_map (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1))
      (fun trace : Fin (iteration + 1) → Fin sampleCount → Data => Fin.init trace)
      (freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
        deployedOfHistory domain tolerance iteration)).symm
      _ = pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory iteration)
          (freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
            deployedOfHistory domain tolerance iteration) := by rw [hmarginal]
  have hunion := pmfProb_or_le
    (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1))
    (fun trace : Fin (iteration + 1) → Fin sampleCount → Data =>
      freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
        deployedOfHistory domain tolerance iteration (Fin.init trace))
    (fun trace : Fin (iteration + 1) → Fin sampleCount → Data =>
      finiteIidUniformEmpiricalRiskDeviationEvent model domain
        (deployedOfHistory iteration (Fin.init trace)) tolerance (trace (Fin.last iteration)))
  refine (le_trans ?_ hunion).trans ?_
  · unfold pmfProb
    apply le_of_eq
    apply pmfExp_congr
    intro trace
    by_cases hbad : (
        freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
            deployedOfHistory domain tolerance iteration (Fin.init trace) ∨
          finiteIidUniformEmpiricalRiskDeviationEvent model domain
            (deployedOfHistory iteration (Fin.init trace)) tolerance (trace (Fin.last iteration))) <;>
      simp [freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent]
  · calc
      pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1))
          (fun trace => freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
            deployedOfHistory domain tolerance iteration (Fin.init trace)) +
        pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1))
          (fun trace => finiteIidUniformEmpiricalRiskDeviationEvent model domain
            (deployedOfHistory iteration (Fin.init trace)) tolerance (trace (Fin.last iteration))) =
        pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory iteration)
          (freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
            deployedOfHistory domain tolerance iteration) +
        pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1))
          (fun trace => finiteIidUniformEmpiricalRiskDeviationEvent model domain
            (deployedOfHistory iteration (Fin.init trace)) tolerance (trace (Fin.last iteration))) := by
          rw [hprefix]
      _ ≤ pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory iteration)
            (freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent model sampleCount
              deployedOfHistory domain tolerance iteration) +
            finiteIidUniformEmpiricalRiskDeviationTotalFailure model domain tolerance sampleCount := by
          apply add_le_add_right
          simpa only [freshPerformativeTraceLawEmpiricalRiskDeviationFailure] using
            freshPerformativeTraceLawEmpiricalRiskDeviationFailure_le_totalFailure initialLaw model
              sampleCount deployedOfHistory iteration domain tolerance

/--
The probability of a uniform empirical-risk deviation in any of the first
`iteration` adaptive batches is at most `iteration` times the shared finite
parameter-space failure budget.
-/
theorem freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure_le_mul_totalFailure
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (sampleCount : ℕ)
    (deployedOfHistory : ∀ iteration, (Fin iteration → Fin sampleCount → Data) → Parameter)
    (iteration : ℕ) (domain : Set Parameter) (tolerance : ℝ) :
    freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure initialLaw model sampleCount
      deployedOfHistory iteration domain tolerance ≤
      (iteration : ℝ) * finiteIidUniformEmpiricalRiskDeviationTotalFailure
        model domain tolerance sampleCount := by
  induction iteration with
  | zero =>
      classical
      unfold freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure
      simp [freshPerformativeTraceLawEmpiricalRiskDeviationUpToEvent,
        adaptiveFreshTraceAnyBadEvent, pmfProb, pmfExp]
  | succ iteration hiteration =>
      calc
        freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure initialLaw model sampleCount
            deployedOfHistory (iteration + 1) domain tolerance ≤
          freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure initialLaw model sampleCount
              deployedOfHistory iteration domain tolerance +
            finiteIidUniformEmpiricalRiskDeviationTotalFailure model domain tolerance sampleCount :=
          freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure_succ_le initialLaw model
            sampleCount deployedOfHistory iteration domain tolerance
        _ ≤ (iteration : ℝ) * finiteIidUniformEmpiricalRiskDeviationTotalFailure
              model domain tolerance sampleCount +
            finiteIidUniformEmpiricalRiskDeviationTotalFailure model domain tolerance sampleCount :=
          add_le_add_left hiteration _
        _ = ((iteration + 1 : ℕ) : ℝ) *
            finiteIidUniformEmpiricalRiskDeviationTotalFailure model domain tolerance sampleCount := by
          push_cast
          ring

/--
For every fixed horizon, the adaptive finite-trace uniform-loss failure
probability vanishes with the fresh IID batch size.  The history-to-deployment
rule may itself vary with that batch size.
-/
theorem freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure_tendsto_zero
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data] [Nonempty Data]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (deployedOfHistory : ∀ sampleCount iteration,
      (Fin iteration → Fin sampleCount → Data) → Parameter)
    (iteration : ℕ) (domain : Set Parameter) (hcompact : IsCompact domain)
    (hcontinuous : ∀ datum, Continuous (fun candidate => model.loss datum candidate))
    (tolerance : ℝ) (htolerance : 0 < tolerance) :
    Filter.Tendsto (fun sampleCount =>
      freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure initialLaw model sampleCount
        (deployedOfHistory sampleCount) iteration domain tolerance) Filter.atTop (nhds 0) := by
  have hnonneg : ∀ sampleCount,
      0 ≤ freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure initialLaw model sampleCount
        (deployedOfHistory sampleCount) iteration domain tolerance := by
    intro sampleCount
    classical
    unfold freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure
    exact pmfProb_nonneg _ _
  have hupper : ∀ sampleCount,
      freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure initialLaw model sampleCount
          (deployedOfHistory sampleCount) iteration domain tolerance ≤
        (iteration : ℝ) * finiteIidUniformEmpiricalRiskDeviationTotalFailure
          model domain tolerance sampleCount := by
    intro sampleCount
    exact freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure_le_mul_totalFailure
      initialLaw model sampleCount (deployedOfHistory sampleCount) iteration domain tolerance
  have htotal := finiteIidUniformEmpiricalRiskDeviationTotalFailure_tendsto_zero
    model domain hcompact hcontinuous tolerance htolerance
  have hscaled : Filter.Tendsto (fun sampleCount =>
      (iteration : ℝ) * finiteIidUniformEmpiricalRiskDeviationTotalFailure
        model domain tolerance sampleCount) Filter.atTop (nhds 0) := by
    simpa using htotal.const_mul (iteration : ℝ)
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hscaled hnonneg hupper

/--
The summable per-round confidence allocation used in the proof of Theorem
3.10.  Appendix E.4 assigns `6 p / (pi^2 * t^2)` to round `t ≥ 1`; the Lean
index `iteration` starts at zero, hence the `iteration + 1` shift.
-/
noncomputable def theorem310FailureBudget (p : ℝ) (iteration : ℕ) : ℝ :=
  6 * p / (Real.pi ^ 2 * ((iteration + 1 : ℕ) : ℝ) ^ 2)

/--
Mathlib's Basel-sum identity gives the exact total mass of the shifted
inverse-square schedule used in the source's Appendix E.4 union bound.
-/
theorem hasSum_theorem310_inverseSquare :
    HasSum (fun iteration : ℕ =>
      (1 : ℝ) / (((iteration + 1 : ℕ) : ℝ) ^ 2)) (Real.pi ^ 2 / 6) := by
  let inverseSquare : ℕ → ℝ := fun iteration => (1 : ℝ) / (iteration : ℝ) ^ 2
  change HasSum (fun iteration => inverseSquare (iteration + 1)) (Real.pi ^ 2 / 6)
  apply (hasSum_nat_add_iff 1).mpr
  change HasSum inverseSquare
    (Real.pi ^ 2 / 6 + ∑ iteration ∈ Finset.range 1, inverseSquare iteration)
  simpa [inverseSquare] using hasSum_zeta_two

/--
The full source confidence schedule has total mass exactly `p`.  This is only
the deterministic series identity; applying it to a stochastic process still
requires a single infinite-horizon probability law for its round events.
-/
theorem hasSum_theorem310FailureBudget (p : ℝ) :
    HasSum (theorem310FailureBudget p) p := by
  have hfactor : ∀ iteration : ℕ,
      theorem310FailureBudget p iteration =
        (6 * p / Real.pi ^ 2) *
          ((1 : ℝ) / (((iteration + 1 : ℕ) : ℝ) ^ 2)) := by
    intro iteration
    unfold theorem310FailureBudget
    field_simp
  have hscaled := HasSum.mul_left (6 * p / Real.pi ^ 2)
    hasSum_theorem310_inverseSquare
  have hsum : HasSum (fun iteration : ℕ =>
      (6 * p / Real.pi ^ 2) *
        ((1 : ℝ) / (((iteration + 1 : ℕ) : ℝ) ^ 2))) p := by
    have hvalue :
        (6 * p / Real.pi ^ 2) * (Real.pi ^ 2 / 6) = p := by
      field_simp
    simpa only [hvalue] using hscaled
  have hfunction : theorem310FailureBudget p = fun iteration =>
      (6 * p / Real.pi ^ 2) *
        ((1 : ℝ) / (((iteration + 1 : ℕ) : ℝ) ^ 2)) := funext hfactor
  rw [hfunction]
  exact hsum

/--
The literal countable union-bound conclusion behind Appendix E.4's confidence
allocation.  It is deliberately stated for an already constructed probability
space carrying every round event: the finite adaptive-PMF trace below supplies
only fixed-horizon laws, so it cannot instantiate this theorem as an
infinite-horizon trajectory without further probability construction.
-/
theorem measureReal_iUnion_le_theorem310FailureBudget
    {Omega : Type*} [MeasurableSpace Omega] (mu : Measure Omega) [IsFiniteMeasure mu]
    (p : ℝ) (hp : 0 ≤ p) (bad : ℕ → Set Omega)
    (hbudget : ∀ iteration : ℕ,
      mu.real (bad iteration) ≤ theorem310FailureBudget p iteration) :
    mu.real (⋃ iteration, bad iteration) ≤ p := by
  have hbudget_nonneg : ∀ iteration : ℕ, 0 ≤ theorem310FailureBudget p iteration := by
    intro iteration
    unfold theorem310FailureBudget
    positivity
  have hseries := hasSum_theorem310FailureBudget p
  have hseries_ennreal :
      ENNReal.ofReal p = ∑' iteration : ℕ, ENNReal.ofReal
        (theorem310FailureBudget p iteration) := by
    calc
      ENNReal.ofReal p = ENNReal.ofReal (∑' iteration : ℕ,
          theorem310FailureBudget p iteration) :=
        congrArg ENNReal.ofReal hseries.tsum_eq.symm
      _ = ∑' iteration : ℕ, ENNReal.ofReal
          (theorem310FailureBudget p iteration) :=
        ENNReal.ofReal_tsum_of_nonneg hbudget_nonneg hseries.summable
  have hseries_finite :
      (∑' iteration : ℕ, ENNReal.ofReal
        (theorem310FailureBudget p iteration)) ≠ ⊤ := by
    rw [← hseries_ennreal]
    exact ENNReal.ofReal_ne_top
  calc
    mu.real (⋃ iteration, bad iteration) ≤
        (∑' iteration : ℕ, ENNReal.ofReal
          (theorem310FailureBudget p iteration)).toReal :=
      measureReal_iUnion_le_tsum_ofReal_bound mu bad
        (theorem310FailureBudget p) hbudget_nonneg hbudget hseries_finite
    _ = (ENNReal.ofReal p).toReal := by rw [hseries_ennreal]
    _ = p := ENNReal.toReal_ofReal hp

/--
Every finite prefix of the source's Theorem 3.10 confidence schedule has total
failure budget at most `p`.  This is a finite-horizon statement; it does not
claim the paper's general empirical-Wasserstein concentration result.
-/
theorem sum_theorem310FailureBudget_le (p : ℝ) (hp : 0 ≤ p) (horizon : ℕ) :
    ∑ iteration ∈ Finset.range horizon, theorem310FailureBudget p iteration ≤ p := by
  have hpi_sq_pos : 0 < Real.pi ^ 2 := sq_pos_of_pos Real.pi_pos
  have hinverse_nonneg : ∀ iteration : ℕ,
      0 ≤ (1 : ℝ) / (((iteration + 1 : ℕ) : ℝ) ^ 2) := by
    intro iteration
    positivity
  have hinverse_sum :
      ∑ iteration ∈ Finset.range horizon,
        (1 : ℝ) / (((iteration + 1 : ℕ) : ℝ) ^ 2) ≤ Real.pi ^ 2 / 6 := by
    rw [← hasSum_theorem310_inverseSquare.tsum_eq]
    exact hasSum_theorem310_inverseSquare.summable.sum_le_tsum (Finset.range horizon)
      (fun iteration _ => hinverse_nonneg iteration)
  have hfactor_nonneg : 0 ≤ 6 * p / Real.pi ^ 2 := by positivity
  have hfactor : ∀ iteration : ℕ,
      theorem310FailureBudget p iteration =
        (6 * p / Real.pi ^ 2) * ((1 : ℝ) / (((iteration + 1 : ℕ) : ℝ) ^ 2)) := by
    intro iteration
    unfold theorem310FailureBudget
    field_simp
  calc
    ∑ iteration ∈ Finset.range horizon, theorem310FailureBudget p iteration =
        (6 * p / Real.pi ^ 2) *
          ∑ iteration ∈ Finset.range horizon,
            (1 : ℝ) / (((iteration + 1 : ℕ) : ℝ) ^ 2) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro iteration _
      rw [hfactor]
    _ ≤ (6 * p / Real.pi ^ 2) * (Real.pi ^ 2 / 6) :=
      mul_le_mul_of_nonneg_left hinverse_sum hfactor_nonneg
    _ = p := by
      field_simp

/--
Finite-horizon general-Euclidean bridge for the confidence allocation in
Theorem 3.10 of Perdomo--Zrnic--Mendler-Dünner--Hardt (2020).

Each round may use its own radius, dyadic depth, and nonnegative threshold
schedule.  The premise charges the concrete finite-IID global-truncation
failure budget to the paper's inverse-square allocation; the conclusion sums
the resulting empirical-W₁ failures over a finite prefix.  This theorem does
not construct a common adaptive general-law trace, select those schedules, or
claim the sharper annular-shell Fournier--Guillin rate.
-/
theorem sum_finiteIIDEuclideanRadialCollapseCompactFailure_le_theorem310Budget
    (dimension : ℕ)
    (law : ℕ → ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (sampleCount : ℕ → ℕ) (hsampleCount : ∀ round, 0 < sampleCount round)
    (alpha gamma : ℝ) (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (radius : ℕ → ℝ) (hradius : ∀ round, 0 < radius round)
    (hmoment : ∀ round, Probability.HasExponentialRadialMoment (law round) alpha gamma)
    (depth : ℕ → ℕ) (threshold : ℕ → ℕ → ℝ)
    (hthreshold : ∀ round level, 0 ≤ threshold round level)
    (p : ℝ) (hp : 0 ≤ p) (horizon : ℕ)
    (hschedule : ∀ round,
      Probability.finiteIIDRadialCollapseCompactFailureBudget dimension (law round)
        (sampleCount round) alpha gamma (radius round) (depth round) (threshold round) ≤
        theorem310FailureBudget p round) :
    ∑ round ∈ Finset.range horizon,
      (Probability.finiteIIDSampleLaw (law round :
        Measure (EuclideanSpace ℝ (Fin dimension))) (sampleCount round)).real
        {sample |
          ((NNReal.mk (2 * radius round) (by nlinarith [hradius round]) : NNReal) : ℝ≥0∞) *
            ENNReal.ofReal (Probability.dyadicMultiscaleThresholdBound dimension
              (depth round) (threshold round)) +
          ENNReal.ofReal ((1 + (gamma / 2)⁻¹) *
            Real.exp (-(gamma / 2) * Real.rpow (radius round) alpha) *
            ∫ x, Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
              (law round : Measure (EuclideanSpace ℝ (Fin dimension)))) <
            Probability.empiricalWassersteinOne (law round) (hsampleCount round) sample} ≤ p := by
  calc
    ∑ round ∈ Finset.range horizon,
        (Probability.finiteIIDSampleLaw (law round :
          Measure (EuclideanSpace ℝ (Fin dimension))) (sampleCount round)).real
          {sample |
            ((NNReal.mk (2 * radius round) (by nlinarith [hradius round]) : NNReal) : ℝ≥0∞) *
              ENNReal.ofReal (Probability.dyadicMultiscaleThresholdBound dimension
                (depth round) (threshold round)) +
            ENNReal.ofReal ((1 + (gamma / 2)⁻¹) *
              Real.exp (-(gamma / 2) * Real.rpow (radius round) alpha) *
              ∫ x, Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
                (law round : Measure (EuclideanSpace ℝ (Fin dimension)))) <
              Probability.empiricalWassersteinOne (law round) (hsampleCount round) sample} ≤
        ∑ round ∈ Finset.range horizon,
          Probability.finiteIIDRadialCollapseCompactFailureBudget dimension (law round)
            (sampleCount round) alpha gamma (radius round) (depth round) (threshold round) := by
      apply Finset.sum_le_sum
      intro round hround
      exact Probability.measure_finiteIID_empiricalWassersteinOne_gt_radialCollapseCompactBound_le_failureBudget
        dimension (law round) (sampleCount round) (hsampleCount round) halpha hgamma
        (hradius round) (hmoment round) (depth round) (threshold round) (hthreshold round)
    _ ≤ ∑ round ∈ Finset.range horizon, theorem310FailureBudget p round := by
      apply Finset.sum_le_sum
      intro round hround
      exact hschedule round
    _ ≤ p := sum_theorem310FailureBudget_le p hp horizon

/--
Finite-horizon general-Euclidean Theorem 3.10 bridge with the geometric dyadic
confidence allocation already discharged.  The per-round premise is the
explicit global-cutoff radius-escape bound plus `exp (-confidence)`; it is
still a supplied schedule, rather than a claimed sharp
Fournier--Guillin inversion or an adaptive general-law construction.
-/
theorem sum_finiteIIDEuclideanRadialCollapseGeometricConfidenceFailure_le_theorem310Budget
    (dimension : ℕ) (hdimension : 0 < dimension)
    (law : ℕ → ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (sampleCount : ℕ → ℕ) (hsampleCount : ∀ round, 0 < sampleCount round)
    (alpha gamma : ℝ) (halpha : 1 ≤ alpha) (hgamma : 0 < gamma)
    (radius : ℕ → ℝ) (hradius : ∀ round, 0 < radius round)
    (hmoment : ∀ round, Probability.HasExponentialRadialMoment (law round) alpha gamma)
    (depth : ℕ → ℕ) (confidence : ℕ → ℝ)
    (hconfidence : ∀ round, 0 ≤ confidence round)
    (p : ℝ) (hp : 0 ≤ p) (horizon : ℕ)
    (hschedule : ∀ round,
      (sampleCount round : ℝ) * (∫ x, Real.exp (gamma * Real.rpow ‖x‖ alpha) /
        Real.exp (gamma * Real.rpow (radius round) alpha) ∂
          (law round : Measure (EuclideanSpace ℝ (Fin dimension)))) +
        Real.exp (-(confidence round)) ≤ theorem310FailureBudget p round) :
    ∑ round ∈ Finset.range horizon,
      (Probability.finiteIIDSampleLaw (law round :
        Measure (EuclideanSpace ℝ (Fin dimension))) (sampleCount round)).real
        {sample |
          ((NNReal.mk (2 * radius round) (by nlinarith [hradius round]) : NNReal) : ℝ≥0∞) *
            ENNReal.ofReal (Probability.dyadicMultiscaleThresholdBound dimension (depth round)
              (fun level ↦ Probability.dyadicGeometricConfidenceThreshold dimension
                (sampleCount round) level (confidence round))) +
          ENNReal.ofReal ((1 + (gamma / 2)⁻¹) *
            Real.exp (-(gamma / 2) * Real.rpow (radius round) alpha) *
            ∫ x, Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
              (law round : Measure (EuclideanSpace ℝ (Fin dimension)))) <
            Probability.empiricalWassersteinOne (law round) (hsampleCount round) sample} ≤ p := by
  calc
    ∑ round ∈ Finset.range horizon,
        (Probability.finiteIIDSampleLaw (law round :
          Measure (EuclideanSpace ℝ (Fin dimension))) (sampleCount round)).real
          {sample |
            ((NNReal.mk (2 * radius round) (by nlinarith [hradius round]) : NNReal) : ℝ≥0∞) *
              ENNReal.ofReal (Probability.dyadicMultiscaleThresholdBound dimension (depth round)
                (fun level ↦ Probability.dyadicGeometricConfidenceThreshold dimension
                  (sampleCount round) level (confidence round))) +
            ENNReal.ofReal ((1 + (gamma / 2)⁻¹) *
              Real.exp (-(gamma / 2) * Real.rpow (radius round) alpha) *
              ∫ x, Real.exp (gamma * Real.rpow ‖x‖ alpha) ∂
                (law round : Measure (EuclideanSpace ℝ (Fin dimension)))) <
              Probability.empiricalWassersteinOne (law round) (hsampleCount round) sample} ≤
        ∑ round ∈ Finset.range horizon, (
          (sampleCount round : ℝ) * (∫ x, Real.exp (gamma * Real.rpow ‖x‖ alpha) /
            Real.exp (gamma * Real.rpow (radius round) alpha) ∂
              (law round : Measure (EuclideanSpace ℝ (Fin dimension)))) +
            Real.exp (-(confidence round))) := by
      apply Finset.sum_le_sum
      intro round hround
      exact Probability.measure_finiteIID_empiricalWassersteinOne_gt_radialCollapseGeometricConfidenceBound_le
        dimension hdimension (law round) (sampleCount round) (hsampleCount round) halpha hgamma
        (hradius round) (hmoment round) (depth round) (confidence round) (hconfidence round)
    _ ≤ ∑ round ∈ Finset.range horizon, theorem310FailureBudget p round := by
      apply Finset.sum_le_sum
      intro round hround
      exact hschedule round
    _ ≤ p := sum_theorem310FailureBudget_le p hp horizon

/--
Finite-horizon annular-shell empirical-W₁ bridge for Theorem 3.10.

Each round supplies the already verified finite compact-head schedule and the
literal all-shell mass-failure bound.  Charging their sum to the source's
inverse-square allocation yields the corresponding finite-horizon
concentration conclusion.  The hypothesis is deliberately quantitative: this
theorem does not assert a Fournier--Guillin rate inversion that has not been
proved for the displayed schedules.
-/
theorem sum_finiteIIDEuclideanPoneScheduledHeadFailure_le_theorem310Budget
    (dimension : ℕ) (hdimension : 0 < dimension)
    (cutoff : ℕ → ℕ)
    (law : ℕ → ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (sampleCount : ℕ → ℕ) (hsampleCount : ∀ round, 0 < sampleCount round)
    (eta : ℝ) (heta : 0 < eta)
    (deviation alpha gamma : ℕ → ℝ)
    (hdeviation : ∀ round, 0 ≤ deviation round)
    (halpha : ∀ round, 1 ≤ alpha round) (hgamma : ∀ round, 0 < gamma round)
    (hmoment : ∀ round,
      Probability.HasExponentialRadialMoment (law round) (alpha round) (gamma round))
    (confidence massBudget : ℕ → ℝ) (hconfidence : ∀ round, 0 ≤ confidence round)
    (headBudget : ℕ → ℝ≥0∞)
    (hheadBudget : ∀ round,
      Probability.selectedShellGeometricCompactHeadBudget dimension (cutoff round)
        (sampleCount round) (law round)
        (Probability.selectedShellGeometricEffectiveHeadDepth dimension (cutoff round)
          (sampleCount round) (law round) (confidence round)) (confidence round) ≤
        headBudget round)
    (hmassFailure : ∀ round,
      (Probability.finiteIIDSampleLaw (law round :
        Measure (EuclideanSpace ℝ (Fin dimension))) (sampleCount round)).real
        (⋃ shell,
          Probability.finiteIIDEuclideanDyadicCubeShellMassRelativeTailTotalized
            dimension (law round) (sampleCount round) shell
            (Probability.pOneFournierGuillinShellToleranceWithEta eta (deviation round)
              ((law round : Measure (EuclideanSpace ℝ (Fin dimension))).real
                (Probability.euclideanDyadicCubeShell dimension shell)) shell)) ≤
        massBudget round)
    (p : ℝ) (hp : 0 ≤ p) (horizon : ℕ)
    (hschedule : ∀ round,
      massBudget round + Real.exp (-(confidence round)) ≤ theorem310FailureBudget p round) :
    ∑ round ∈ Finset.range horizon,
      (Probability.finiteIIDSampleLaw (law round :
        Measure (EuclideanSpace ℝ (Fin dimension))) (sampleCount round)).real
        {sample |
          ENNReal.ofReal (Real.sqrt dimension * deviation round) +
            ENNReal.ofReal
              ((2 * Real.sqrt dimension) *
                ((32 / 15 : ℝ) *
                  Probability.fifthOrderExponentialRadialTailConstant (law round)
                    (alpha round) (gamma round) /
                  (16 : ℝ) ^ cutoff round)) +
            headBudget round <
            ProbabilityCoupling.wassersteinOne (law round)
              (empiricalSampleProbabilityMeasureOfPos (hsampleCount round) sample)} ≤ p := by
  calc
    ∑ round ∈ Finset.range horizon,
        (Probability.finiteIIDSampleLaw (law round :
          Measure (EuclideanSpace ℝ (Fin dimension))) (sampleCount round)).real
          {sample |
            ENNReal.ofReal (Real.sqrt dimension * deviation round) +
              ENNReal.ofReal
                ((2 * Real.sqrt dimension) *
                  ((32 / 15 : ℝ) *
                    Probability.fifthOrderExponentialRadialTailConstant (law round)
                      (alpha round) (gamma round) /
                    (16 : ℝ) ^ cutoff round)) +
              headBudget round <
              ProbabilityCoupling.wassersteinOne (law round)
                (empiricalSampleProbabilityMeasureOfPos (hsampleCount round) sample)} ≤
        ∑ round ∈ Finset.range horizon,
          (massBudget round + Real.exp (-(confidence round))) := by
      apply Finset.sum_le_sum
      intro round hround
      letI : Nonempty (Fin (sampleCount round)) := Fin.pos_iff_nonempty.mp
        (hsampleCount round)
      simpa only [empiricalSampleProbabilityMeasureOfPos_eq_empiricalSampleProbabilityMeasure] using
        (Probability.measureReal_finiteIID_empiricalWassersteinOne_gt_pOneScheduledHeadBudget_le
          dimension (cutoff round) hdimension (law round) heta (hdeviation round)
          (halpha round) (hgamma round) (hmoment round) (confidence round) (massBudget round)
          (hsampleCount round) (hconfidence round) (headBudget round)
          (hheadBudget round) (hmassFailure round))
    _ ≤ ∑ round ∈ Finset.range horizon, theorem310FailureBudget p round := by
      apply Finset.sum_le_sum
      intro round hround
      exact hschedule round
    _ ≤ p := sum_theorem310FailureBudget_le p hp horizon

/--
All-rounds Theorem 3.10 confidence allocation for a general adaptive batch
kernel.  The supplied kernel is the explicit measurability boundary needed
for Euclidean laws selected from a random history; its round kernels must
already carry the displayed history-uniform concentration bounds.  Thus this
theorem performs the paper's countable union step on one genuine probability
space, without treating an arbitrary law-valued deployment map as a kernel.
-/
theorem measureReal_iUnion_heterogeneousBatchTraceBadEvent_le_theorem310Budget
    {Data : Type*} [MeasurableSpace Data]
    (BatchIndex : ℕ → Type*)
    (kernel : (iteration : ℕ) →
      Kernel
        ((i : Finset.Iic iteration) →
          HeterogeneousBatchTraceCoordinate BatchIndex Data i.1)
        (HeterogeneousBatchTraceCoordinate BatchIndex Data (iteration + 1)))
    [∀ iteration, IsMarkovKernel (kernel iteration)]
    (bad : ∀ iteration, HeterogeneousBatchTrace BatchIndex Data iteration →
      (BatchIndex iteration → Data) → Prop)
    (p : ℝ) (hp : 0 ≤ p)
    (hevent : ∀ iteration, MeasurableSet
      (heterogeneousBatchTraceBadEventPair BatchIndex bad iteration))
    (hfailure : ∀ iteration historyPrefix,
      kernel iteration historyPrefix
        {batch | bad iteration
          (heterogeneousBatchTraceOfPrefix iteration historyPrefix) batch} ≤
        ENNReal.ofReal (theorem310FailureBudget p iteration)) :
    (heterogeneousBatchTraceInfiniteLaw BatchIndex kernel).real
      (⋃ iteration,
        adaptiveFreshHeterogeneousInfiniteTraceBadEvent BatchIndex bad iteration) ≤ p := by
  apply measureReal_iUnion_le_theorem310FailureBudget
    (heterogeneousBatchTraceInfiniteLaw BatchIndex kernel) p hp
    (fun iteration =>
      adaptiveFreshHeterogeneousInfiniteTraceBadEvent BatchIndex bad iteration)
  intro iteration
  have hbudget_nonneg : 0 ≤ theorem310FailureBudget p iteration := by
    unfold theorem310FailureBudget
    positivity
  exact measureReal_heterogeneousBatchTraceInfiniteBadEvent_le BatchIndex kernel bad iteration
    (theorem310FailureBudget p iteration) hbudget_nonneg (hevent iteration)
    (hfailure iteration)

/--
The all-round Theorem 3.10 union bound when each batch is conditionally IID
from a measurable one-observation kernel.  The finite-batch kernel is built
by the reusable `Probability.finiteIIDBatchKernel`, so no equality between a
history-indexed law and a Markov kernel is silently assumed.
-/
theorem measureReal_iUnion_heterogeneousFiniteIIDBatchTraceBadEvent_le_theorem310Budget
    {Data : Type*} [MeasurableSpace Data]
    (countSchedule : ℕ → ℕ)
    (oneKernel : (iteration : ℕ) →
      Kernel
        ((i : Finset.Iic iteration) →
          HeterogeneousBatchTraceCoordinate (fun round => Fin (countSchedule round)) Data i.1)
        Data)
    (oneKernelMarkov : ∀ iteration, IsMarkovKernel (oneKernel iteration))
    (bad : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round)) Data iteration →
      (Fin (countSchedule iteration) → Data) → Prop)
    (p : ℝ) (hp : 0 ≤ p)
    (hevent : ∀ iteration, MeasurableSet
      (heterogeneousBatchTraceBadEventPair (fun round => Fin (countSchedule round)) bad iteration))
    (hfailure : ∀ iteration historyPrefix,
      Probability.finiteIIDSampleLaw (oneKernel iteration historyPrefix)
        (countSchedule iteration) {batch | bad iteration
          (heterogeneousBatchTraceOfPrefix iteration historyPrefix) batch} ≤
        ENNReal.ofReal (theorem310FailureBudget p iteration)) :
    (@heterogeneousBatchTraceInfiniteLaw Data _ (fun round => Fin (countSchedule round))
      (fun iteration => Probability.finiteIIDBatchKernel (countSchedule iteration)
        (oneKernel iteration))
      (fun iteration => by
        letI : IsMarkovKernel (oneKernel iteration) := oneKernelMarkov iteration
        exact Probability.finiteIIDBatchKernel_isMarkov (countSchedule iteration)
          (oneKernel iteration))).real
      (⋃ iteration,
        adaptiveFreshHeterogeneousInfiniteTraceBadEvent
          (fun round => Fin (countSchedule round)) bad iteration) ≤ p := by
  let batchKernel : (iteration : ℕ) →
      Kernel
        ((i : Finset.Iic iteration) →
          HeterogeneousBatchTraceCoordinate (fun round => Fin (countSchedule round)) Data i.1)
        (Fin (countSchedule iteration) → Data) :=
    fun iteration => Probability.finiteIIDBatchKernel (countSchedule iteration)
      (oneKernel iteration)
  have batchKernelMarkov : ∀ iteration, IsMarkovKernel (batchKernel iteration) := fun iteration => by
    dsimp [batchKernel]
    letI : IsMarkovKernel (oneKernel iteration) := oneKernelMarkov iteration
    exact Probability.finiteIIDBatchKernel_isMarkov (countSchedule iteration) (oneKernel iteration)
  letI : ∀ iteration, IsMarkovKernel (batchKernel iteration) := batchKernelMarkov
  change (@heterogeneousBatchTraceInfiniteLaw Data _ (fun round => Fin (countSchedule round))
    batchKernel batchKernelMarkov).real
      (⋃ iteration,
        adaptiveFreshHeterogeneousInfiniteTraceBadEvent
          (fun round => Fin (countSchedule round)) bad iteration) ≤ p
  apply @measureReal_iUnion_heterogeneousBatchTraceBadEvent_le_theorem310Budget Data _
    (fun round => Fin (countSchedule round)) batchKernel batchKernelMarkov bad p hp hevent
  intro iteration historyPrefix
  change (Probability.finiteIIDBatchKernel (countSchedule iteration)
      (oneKernel iteration) historyPrefix)
      {batch | bad iteration
        (heterogeneousBatchTraceOfPrefix iteration historyPrefix) batch} ≤
      ENNReal.ofReal (theorem310FailureBudget p iteration)
  rw [Probability.finiteIIDBatchKernel_apply_eq_finiteIIDSampleLaw]
  exact hfailure iteration historyPrefix

/--
On a compact deployed domain, continuity of the data-law exponential moment
supplies the uniform envelope needed by one adaptive empirical-W₁ schedule.
This is a source-to-model bridge for the strengthened compact/continuous
version of Theorem 3.10: its continuity premise is not silently inferred from
the paper's pointwise moment condition.
-/
theorem exists_boundedExponentialRadialMoment_for_deployedHistory_of_compact_continuous
    {Parameter : Type*} [TopologicalSpace Parameter] (dimension : ℕ)
    (model : MeasurePerformativeModel Parameter (EuclideanSpace ℝ (Fin dimension)))
    (domain : Set Parameter) (alpha gamma : ℝ)
    (hcompact : IsCompact domain)
    (hmoment : ∀ parameter ∈ domain,
      Probability.HasExponentialRadialMoment (model.dataLaw parameter) alpha gamma)
    (hcontinuous : ContinuousOn (fun parameter =>
      ∫ datum : EuclideanSpace ℝ (Fin dimension),
        Real.exp (gamma * Real.rpow ‖datum‖ alpha) ∂(model.dataLaw parameter : Measure _))
        domain)
    (countSchedule : ℕ → ℕ)
    (deployedOfHistory : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
        (EuclideanSpace ℝ (Fin dimension)) iteration → Parameter)
    (hdeployed : ∀ iteration history, deployedOfHistory iteration history ∈ domain) :
    ∃ momentBound : ℝ, ∀ iteration history,
      Probability.HasBoundedExponentialRadialMoment
        (model.dataLaw (deployedOfHistory iteration history)) alpha gamma momentBound := by
  obtain ⟨momentBound, hbound⟩ :=
    Probability.exists_boundedExponentialRadialMoment_on_compact_of_continuous
      model.dataLaw domain alpha gamma hcompact hmoment hcontinuous
  exact ⟨momentBound, fun iteration history =>
    hbound (deployedOfHistory iteration history) (hdeployed iteration history)⟩

/--
A uniform bound on the initial deployed history gives the all-trace geometric
entry premise used by the two-phase adaptive RERM and RGD conclusions.
This keeps the entry-time construction independent of the sampled trajectory's
later randomness.
-/
theorem exists_entryIteration_for_deployedHistory_of_uniformInitialDistance
    {Parameter Data : Type*} [MetricSpace Parameter]
    (countSchedule : ℕ → ℕ)
    (deployedOfHistory : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round)) Data iteration → Parameter)
    (stable : Parameter) (outerContraction initialDistance radius : ℝ)
    (houter_nonneg : 0 ≤ outerContraction) (houter_lt_one : outerContraction < 1)
    (hradius_pos : 0 < radius)
    (hinitial : ∀ history : HeterogeneousBatchTrace (fun round => Fin (countSchedule round)) Data 0,
      dist (deployedOfHistory 0 history) stable ≤ initialDistance) :
    ∃ entryIteration : ℕ,
      ∀ trace : (i : ℕ) → HeterogeneousBatchTraceCoordinate
        (fun round => Fin (countSchedule round)) Data i,
        outerContraction ^ entryIteration *
          dist (deployedOfHistory 0 (heterogeneousBatchTraceOfInfiniteTrace 0 trace)) stable ≤
            radius := by
  obtain ⟨entryIteration, hentry⟩ :=
    Optimization.exists_entryIteration_of_nonneg_lt_one
      houter_nonneg houter_lt_one hradius_pos
      (initialDistance := initialDistance)
  refine ⟨entryIteration, fun trace => ?_⟩
  exact (mul_le_mul_of_nonneg_left
    (hinitial (heterogeneousBatchTraceOfInfiniteTrace 0 trace))
    (pow_nonneg houter_nonneg _)).trans hentry

/-- The round-wise threshold in the corrected adaptive Euclidean empirical-W₁
concentration event. -/
noncomputable def pOneFournierGuillinAdaptiveEuclideanWassersteinOneThreshold
    (dimension cutoff : ℕ) (alpha gamma momentBound deviation : ℝ)
    (confidence : ℕ → ℝ) (countSchedule : ℕ → ℕ)
    (law : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
        (EuclideanSpace ℝ (Fin dimension)) iteration →
        ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension))) :
    ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
        (EuclideanSpace ℝ (Fin dimension)) iteration → ℝ≥0∞ :=
  fun iteration history =>
    ENNReal.ofReal (Real.sqrt dimension * deviation) +
        ENNReal.ofReal
          ((2 * Real.sqrt dimension) *
            ((32 / 15 : ℝ) *
              Probability.fifthOrderExponentialRadialTailConstant (law iteration history)
                alpha gamma / (16 : ℝ) ^ cutoff)) +
        Probability.selectedShellGeometricHeadSchedule_byDimension dimension cutoff
          (countSchedule iteration) (confidence iteration)
          ((Nat.factorial 5 : ℝ) * gamma⁻¹ ^ 5 * momentBound)

/--
An explicit real upper bound for one adaptive Euclidean empirical-W₁ threshold.
The three terms are respectively the compact deviation, the exponential-tail
envelope, and the selected compact-head tolerance.
-/
theorem pOneFournierGuillinAdaptiveEuclideanWassersteinOneThreshold_le_of_tail_head
    (dimension cutoff : ℕ) (alpha gamma momentBound deviation : ℝ)
    (confidence : ℕ → ℝ) (countSchedule : ℕ → ℕ)
    (law : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
        (EuclideanSpace ℝ (Fin dimension)) iteration →
        ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (iteration : ℕ)
    (history : HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
      (EuclideanSpace ℝ (Fin dimension)) iteration)
    (tailBound headTolerance : ℝ)
    (hdeviation : 0 ≤ deviation)
    (htailNonneg : 0 ≤ Probability.fifthOrderExponentialRadialTailConstant
      (law iteration history) alpha gamma)
    (htail : Probability.fifthOrderExponentialRadialTailConstant (law iteration history)
      alpha gamma ≤ tailBound)
    (hheadNonneg : 0 ≤ headTolerance)
    (hhead : Probability.selectedShellGeometricHeadSchedule_byDimension dimension cutoff
      (countSchedule iteration) (confidence iteration)
      ((Nat.factorial 5 : ℝ) * gamma⁻¹ ^ 5 * momentBound) ≤
        ENNReal.ofReal headTolerance) :
    pOneFournierGuillinAdaptiveEuclideanWassersteinOneThreshold dimension cutoff
      alpha gamma momentBound deviation confidence countSchedule law iteration history ≤
      ENNReal.ofReal
        (Real.sqrt dimension * deviation +
          (2 * Real.sqrt dimension) *
            ((32 / 15 : ℝ) * tailBound / (16 : ℝ) ^ cutoff) + headTolerance) := by
  have hsqrtNonneg : 0 ≤ Real.sqrt dimension := Real.sqrt_nonneg _
  have hmainNonneg : 0 ≤ Real.sqrt dimension * deviation :=
    mul_nonneg hsqrtNonneg hdeviation
  have houterNonneg : 0 ≤ 2 * Real.sqrt dimension := by positivity
  have hratioNonneg : 0 ≤ (32 / 15 : ℝ) := by norm_num
  have hdenomPos : 0 < (16 : ℝ) ^ cutoff := by positivity
  have htailTermNonneg : 0 ≤ (2 * Real.sqrt dimension) *
      ((32 / 15 : ℝ) *
        Probability.fifthOrderExponentialRadialTailConstant (law iteration history)
          alpha gamma / (16 : ℝ) ^ cutoff) := by
    apply mul_nonneg houterNonneg
    exact div_nonneg (mul_nonneg hratioNonneg htailNonneg) hdenomPos.le
  have htailBoundNonneg : 0 ≤ tailBound := htailNonneg.trans htail
  have htailBoundTermNonneg : 0 ≤ (2 * Real.sqrt dimension) *
      ((32 / 15 : ℝ) * tailBound / (16 : ℝ) ^ cutoff) := by
    apply mul_nonneg houterNonneg
    exact div_nonneg (mul_nonneg hratioNonneg htailBoundNonneg) hdenomPos.le
  have htailTerm : (2 * Real.sqrt dimension) *
      ((32 / 15 : ℝ) *
        Probability.fifthOrderExponentialRadialTailConstant (law iteration history)
          alpha gamma / (16 : ℝ) ^ cutoff) ≤
      (2 * Real.sqrt dimension) *
        ((32 / 15 : ℝ) * tailBound / (16 : ℝ) ^ cutoff) := by
    apply mul_le_mul_of_nonneg_left _ houterNonneg
    apply div_le_div_of_nonneg_right _ hdenomPos.le
    exact mul_le_mul_of_nonneg_left htail hratioNonneg
  unfold pOneFournierGuillinAdaptiveEuclideanWassersteinOneThreshold
  calc
    ENNReal.ofReal (Real.sqrt dimension * deviation) +
        ENNReal.ofReal
          ((2 * Real.sqrt dimension) *
            ((32 / 15 : ℝ) *
              Probability.fifthOrderExponentialRadialTailConstant (law iteration history)
                alpha gamma / (16 : ℝ) ^ cutoff)) +
        Probability.selectedShellGeometricHeadSchedule_byDimension dimension cutoff
          (countSchedule iteration) (confidence iteration)
          ((Nat.factorial 5 : ℝ) * gamma⁻¹ ^ 5 * momentBound) ≤
      ENNReal.ofReal (Real.sqrt dimension * deviation) +
        ENNReal.ofReal
          ((2 * Real.sqrt dimension) * ((32 / 15 : ℝ) * tailBound / (16 : ℝ) ^ cutoff)) +
        ENNReal.ofReal headTolerance := by
      exact add_le_add
        (add_le_add_right (ENNReal.ofReal_le_ofReal htailTerm)
          (ENNReal.ofReal (Real.sqrt dimension * deviation))) hhead
    _ = ENNReal.ofReal
        (Real.sqrt dimension * deviation +
          (2 * Real.sqrt dimension) *
            ((32 / 15 : ℝ) * tailBound / (16 : ℝ) ^ cutoff) + headTolerance) := by
      rw [← ENNReal.ofReal_add hmainNonneg htailBoundTermNonneg,
        ← ENNReal.ofReal_add (add_nonneg hmainNonneg htailBoundTermNonneg) hheadNonneg]

/-- The source's three deterministic empirical-W₁ contributions can be
discharged against one displayed real error budget.  This is deliberately a
separate final comparison: concentration scheduling supplies the head
tolerance, while the RERM and RGD recurrences choose the target budget. -/
theorem pOneFournierGuillinAdaptiveEuclideanWassersteinOneThreshold_le_of_tail_headBudget
    (dimension cutoff : ℕ) (alpha gamma momentBound deviation : ℝ)
    (confidence : ℕ → ℝ) (countSchedule : ℕ → ℕ)
    (law : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
        (EuclideanSpace ℝ (Fin dimension)) iteration →
        ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension)))
    (iteration : ℕ)
    (history : HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
      (EuclideanSpace ℝ (Fin dimension)) iteration)
    (tailBound headTolerance wassersteinBound : ℝ)
    (hdeviation : 0 ≤ deviation)
    (htailNonneg : 0 ≤ Probability.fifthOrderExponentialRadialTailConstant
      (law iteration history) alpha gamma)
    (htail : Probability.fifthOrderExponentialRadialTailConstant
      (law iteration history) alpha gamma ≤ tailBound)
    (hheadNonneg : 0 ≤ headTolerance)
    (hhead : Probability.selectedShellGeometricHeadSchedule_byDimension dimension cutoff
      (countSchedule iteration) (confidence iteration)
      ((Nat.factorial 5 : ℝ) * gamma⁻¹ ^ 5 * momentBound) ≤
        ENNReal.ofReal headTolerance)
    (hbudget : Real.sqrt dimension * deviation +
      (2 * Real.sqrt dimension) *
        ((32 / 15 : ℝ) * tailBound / (16 : ℝ) ^ cutoff) + headTolerance ≤
          wassersteinBound) :
    pOneFournierGuillinAdaptiveEuclideanWassersteinOneThreshold dimension cutoff
      alpha gamma momentBound deviation confidence countSchedule law iteration history ≤
      ENNReal.ofReal wassersteinBound := by
  exact (pOneFournierGuillinAdaptiveEuclideanWassersteinOneThreshold_le_of_tail_head
    dimension cutoff alpha gamma momentBound deviation confidence countSchedule law iteration history
      tailBound headTolerance hdeviation htailNonneg htail
      hheadNonneg hhead).trans (ENNReal.ofReal_le_ofReal hbudget)

/-- The round-wise empirical-W₁ failure predicate used by the corrected
all-dimensional PZ concentration interface.  The law is allowed to depend on
the observed finite history; the enclosing trace theorem below makes the
kernel realization and measurability requirements explicit. -/
def pOneFournierGuillinAdaptiveEuclideanWassersteinOneBadEvent
    (dimension cutoff : ℕ) (alpha gamma momentBound deviation : ℝ)
    (confidence : ℕ → ℝ) (countSchedule : ℕ → ℕ)
    (hcountPositive : ∀ round, 0 < countSchedule round)
    (law : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
        (EuclideanSpace ℝ (Fin dimension)) iteration →
        ProbabilityMeasure (EuclideanSpace ℝ (Fin dimension))) :
    ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
        (EuclideanSpace ℝ (Fin dimension)) iteration →
      (Fin (countSchedule iteration) → EuclideanSpace ℝ (Fin dimension)) → Prop :=
  fun iteration history batch =>
    pOneFournierGuillinAdaptiveEuclideanWassersteinOneThreshold dimension cutoff
      alpha gamma momentBound deviation confidence countSchedule law iteration history <
      ProbabilityCoupling.wassersteinOne (law iteration history)
        (empiricalSampleProbabilityMeasureOfPos (hcountPositive iteration) batch)

/--
The adaptive source-shell partition certificate used in place of a raw
empirical-`W₁` bad event.  Its batch component is measurable by construction;
measurability of its dependence on a random history remains an explicit
source-to-model obligation at the Ionescu--Tulcea boundary.
-/
noncomputable def pOneFournierGuillinAdaptiveEuclideanSelectedShellPartitionCertificateBadEvent
    (dimension cutoff : ℕ) (eta deviation : ℝ)
    (confidence : ℕ → ℝ) (countSchedule : ℕ → ℕ)
    (law : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
