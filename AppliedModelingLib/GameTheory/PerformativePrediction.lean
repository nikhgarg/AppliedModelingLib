theorem freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure_le_theorem310Budget
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (sampleCount : ℕ)
    (deployedOfHistory : ∀ iteration, (Fin iteration → Fin sampleCount → Data) → Parameter)
    (horizon : ℕ) (domain : Set Parameter) (tolerance p : ℝ) (hp : 0 ≤ p)
    (hbudget : ∀ round history,
      finiteIidUniformEmpiricalRiskDeviationFailure model domain
        (deployedOfHistory round history) tolerance sampleCount ≤
          theorem310FailureBudget p round) :
    freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure initialLaw model sampleCount
      deployedOfHistory horizon domain tolerance ≤ p := by
  calc
    freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure initialLaw model sampleCount
        deployedOfHistory horizon domain tolerance ≤
        ∑ round ∈ Finset.range horizon, theorem310FailureBudget p round := by
      unfold freshPerformativeTraceLawEmpiricalRiskDeviationUpToFailure
      apply adaptiveFreshTraceAnyBadProbability_le_sum
      intro round history
      have hconditional :
          adaptiveFreshConditionalBadProbability model.dataLaw deployedOfHistory
            (fun round history batch => finiteIidUniformEmpiricalRiskDeviationEvent model domain
              (deployedOfHistory round history) tolerance batch) round history =
            finiteIidUniformEmpiricalRiskDeviationFailure model domain
              (deployedOfHistory round history) tolerance sampleCount := by
        unfold adaptiveFreshConditionalBadProbability
          finiteIidUniformEmpiricalRiskDeviationFailure
          Probability.finiteIidUniformScoreDeviationFailure pmfProb
        apply pmfExp_congr
        intro batch
        by_cases hbad : finiteIidUniformEmpiricalRiskDeviationEvent model domain
          (deployedOfHistory round history) tolerance batch <;> simp [hbad]
      rw [hconditional]
      exact hbudget round history
    _ ≤ p := sum_theorem310FailureBudget_le p hp horizon

/-- A complete performative sample trace with the source's round-dependent batch sizes. -/
abbrev PerformativeHeterogeneousSampleTrace {Data : Type*}
    (sampleCount : ℕ → ℕ) (iteration : ℕ) :=
  HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration

/--
The adaptive fresh-sampling trace for a sequence of batch sizes `n_t`.  At
round `t`, the IID batch has carrier `Fin (sampleCount t)` and is drawn from
the law selected by the complete preceding history.
-/
noncomputable def freshPerformativeHeterogeneousTraceLaw
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (sampleCount : ℕ → ℕ)
    (deployedOfHistory : ∀ iteration,
      PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount iteration → Parameter) :
    (iteration : ℕ) → PMF
      (PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount iteration) :=
  adaptiveFreshHeterogeneousTraceLaw (fun round => Fin (sampleCount round)) model.dataLaw
    deployedOfHistory

/-- A common probability law for all rounds of a source-shaped adaptive
performative deployment.  Coordinate zero is a dummy value; coordinate
`round + 1` is the batch of size `n_round` drawn from the law deployed after
the preceding history. -/
noncomputable def freshPerformativeHeterogeneousInfiniteTraceLaw
    {Parameter Data : Type*} [MeasurableSpace Data] [MeasurableSingletonClass Data]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (sampleCount : ℕ → ℕ)
    (deployedOfHistory : ∀ iteration,
      PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount iteration → Parameter) :
    Measure ((i : ℕ) → HeterogeneousBatchTraceCoordinate
      (fun round => Fin (sampleCount round)) Data i) :=
  adaptiveFreshHeterogeneousInfiniteTraceLaw (fun round => Fin (sampleCount round)) model.dataLaw
    deployedOfHistory

/-- The round-`t` uniform empirical-risk deviation event on the common
infinite adaptive trace. -/
def freshPerformativeHeterogeneousInfiniteTraceEmpiricalRiskDeviationEvent
