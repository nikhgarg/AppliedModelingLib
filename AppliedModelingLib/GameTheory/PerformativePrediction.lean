      ConvexOn ℝ domain (fun candidate =>
        decoupledPerformativeRisk model deployed.1 candidate)) :
    ∃ parameter ∈ domain, IsPerformativelyStableOn model domain parameter := by
  obtain ⟨fixed, hfixed⟩ := kakutani_fixed_point domain hconvex hcompact hne
    (performativeBestResponseOn model domain)
    (closedGraph_performativeBestResponseOn_of_compact model domain hcompact hjoint)
    (fun deployed => ⟨fun _candidate hcandidate => hcandidate.1,
      convex_performativeBestResponseOn model domain hfrozenConvex deployed,
      performativeBestResponseOn_nonempty_of_compact model domain hcompact hne hjoint deployed⟩)
  exact ⟨fixed.1, fixed.2, hfixed⟩

/--
