      Filter.atTop (nhds 0) := by
  unfold finiteIidEmpiricalGradientMassDeviationTotalFailure
  simpa using tendsto_finset_sum Finset.univ (fun deployed _ =>
    finiteIidEmpiricalGradientMassDeviationFailure_tendsto_zero model deployed epsilon hepsilon)

/--
