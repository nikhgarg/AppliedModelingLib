/-- The finite-domain selected argmin gives a total repeated-risk-minimization update. -/
noncomputable def selectedRepeatedRiskMinimization
    {Parameter Data : Type*} [Fintype Parameter] [Nonempty Parameter]
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data) :
    Parameter → Parameter :=
  fun parameter => selectedPopulationRiskMinimizer model (model.dataLaw parameter)

/-- The selected finite RRM update meets Definition 3.3's argmin condition. -/
theorem selectedRepeatedRiskMinimization_spec
    {Parameter Data : Type*} [Fintype Parameter] [Nonempty Parameter]
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data) :
    IsRepeatedRiskMinimization model (selectedRepeatedRiskMinimization model) :=
  fun parameter => selectedPopulationRiskMinimizer_spec model (model.dataLaw parameter)

/-- A finite parameter domain attains a performative-risk optimum. -/
theorem exists_performativelyOptimal
    {Parameter Data : Type*} [Fintype Parameter] [Nonempty Parameter]
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data) :
    ∃ parameter, ∀ candidate, performativeRisk model parameter ≤ performativeRisk model candidate := by
  obtain ⟨parameter, _, hminimum⟩ :=
    Optimization.exists_isMinimizerOn_of_finite (fun _ : Parameter => True)
      (performativeRisk model) (by exact ⟨Classical.choice inferInstance, trivial⟩)
  exact ⟨parameter, fun candidate => hminimum candidate trivial⟩

/-- A fixed point of repeated risk minimization is performatively stable. -/
theorem isPerformativelyStable_of_retraining_fixedPoint
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (retrain : Parameter → Parameter)
