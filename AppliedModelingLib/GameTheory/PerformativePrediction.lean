/--
The algebraic contraction conclusion in the proof of Theorem 3.5, abstracted
over its distribution-shift gradient-pairing estimate.  This isolates the
shared strong-convexity/first-order algebra from the particular transport
realization (finite primal plans or finite-W₁).
-/
theorem rrm_distance_le_of_strongConvex_firstOrder_of_gradientPairingBound
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    {sensitivity modulus : ℝ}
    (hsensitivity : 0 ≤ sensitivity) (hmodulus : 0 < modulus)
    (hpairingBound : ∀ displacement evaluated first second : Parameter,
      |frozenGradientPairing model gradient first evaluated displacement -
          frozenGradientPairing model gradient second evaluated displacement| ≤
        ((smoothness * ‖displacement‖₊ : NNReal) : ℝ) *
          (sensitivity * dist first second))
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (update : Parameter → Parameter)
    (hupdate : ∀ deployed candidate,
      decoupledPerformativeRisk model deployed (update deployed) ≤
        decoupledPerformativeRisk model deployed candidate)
    (hfirstOrder : ∀ deployed,
      IsFrozenFirstOrderOptimal model gradient deployed (update deployed))
    (first second : Parameter) :
    ‖update first - update second‖ ≤
      (sensitivity * (smoothness : ℝ) / modulus) * ‖first - second‖ := by
  have hleft_firstOrder :
      0 ≤ frozenGradientPairing model gradient first (update first)
        (update second - update first) :=
    hfirstOrder first (update second)
  have hright_firstOrder :
      0 ≤ frozenGradientPairing model gradient second (update second)
        (update first - update second) :=
    hfirstOrder second (update first)
  have hleft_lower := frozenRisk_strongConvex_lowerBound model gradient hstrong first
    (update first) (update second)
  have hright_lower := frozenRisk_strongConvex_lowerBound model gradient hstrong first
    (update second) (update first)
  have hleft_min := hupdate first (update second)
  have hvalue_gap :
      modulus / 2 * ‖update first - update second‖ ^ 2 ≤
        decoupledPerformativeRisk model first (update second) -
          decoupledPerformativeRisk model first (update first) := by
    rw [norm_sub_rev] at hleft_lower
    nlinarith [hleft_firstOrder]
  have hpair_upper :
      frozenGradientPairing model gradient first (update second)
        (update first - update second) ≤
        -modulus * ‖update first - update second‖ ^ 2 := by
    nlinarith
  have htransport := hpairingBound (update first - update second) (update second) first second
  have hpair_lower :
      -(((smoothness * ‖update first - update second‖₊ : NNReal) : ℝ) *
          (sensitivity * dist first second)) ≤
        frozenGradientPairing model gradient first (update second)
          (update first - update second) := by
    have hsub :
        -(((smoothness * ‖update first - update second‖₊ : NNReal) : ℝ) *
            (sensitivity * dist first second)) ≤
          frozenGradientPairing model gradient first (update second) (update first - update second) -
            frozenGradientPairing model gradient second (update second) (update first - update second) :=
      neg_le_of_abs_le htransport
    nlinarith
  have hquadratic :
      modulus * ‖update first - update second‖ ^ 2 ≤
        (sensitivity * (smoothness : ℝ)) * ‖update first - update second‖ * ‖first - second‖ := by
    rw [dist_eq_norm] at hpair_lower
    have hnorm : ((smoothness * ‖update first - update second‖₊ : NNReal) : ℝ) =
        (smoothness : ℝ) * ‖update first - update second‖ := by simp
    rw [hnorm] at hpair_lower
    nlinarith [hpair_upper]
  by_cases hzero : ‖update first - update second‖ = 0
  · have hcoefficient : 0 ≤ sensitivity * (smoothness : ℝ) / modulus := by positivity
    rw [hzero]
    exact mul_nonneg hcoefficient (norm_nonneg _)
  · have hpositive : 0 < ‖update first - update second‖ :=
      lt_of_le_of_ne (norm_nonneg _) (Ne.symm hzero)
    have hcancel :
        modulus * ‖update first - update second‖ ≤
          (sensitivity * (smoothness : ℝ)) * ‖first - second‖ := by
      apply le_of_mul_le_mul_right _ hpositive
      calc
        (modulus * ‖update first - update second‖) * ‖update first - update second‖ =
            modulus * ‖update first - update second‖ ^ 2 := by ring
        _ ≤ (sensitivity * (smoothness : ℝ)) * ‖update first - update second‖ *
            ‖first - second‖ :=
          hquadratic
        _ = ((sensitivity * (smoothness : ℝ)) * ‖first - second‖) *
            ‖update first - update second‖ := by
          ring
    have hdivide :
        ‖update first - update second‖ ≤
          ((sensitivity * (smoothness : ℝ)) * ‖first - second‖) / modulus := by
      calc
        ‖update first - update second‖ =
            (modulus * ‖update first - update second‖) / modulus := by
          field_simp
        _ ≤ ((sensitivity * (smoothness : ℝ)) * ‖first - second‖) / modulus :=
          div_le_div_of_nonneg_right hcancel hmodulus.le
    convert hdivide using 1
    all_goals ring

/--
The algebraic contraction conclusion in the proof of Theorem 3.5 under an
explicit finite primal transport certificate.  The result is routed through
the generic gradient-pairing algebra so its proof is shared with finite-W₁.
-/
theorem rrm_distance_le_of_strongConvex_firstOrder_transport
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness) {sensitivity modulus : ℝ}
    (hsensitivity : 0 ≤ sensitivity) (hmodulus : 0 < modulus)
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    (hstrong : IsPointwiseGradientStronglyConvex model gradient modulus)
    (update : Parameter → Parameter)
    (hupdate : ∀ deployed candidate,
      decoupledPerformativeRisk model deployed (update deployed) ≤
        decoupledPerformativeRisk model deployed candidate)
    (hfirstOrder : ∀ deployed,
      IsFrozenFirstOrderOptimal model gradient deployed (update deployed))
    (first second : Parameter) :
    ‖update first - update second‖ ≤
      (sensitivity * (smoothness : ℝ) / modulus) * ‖first - second‖ :=
  rrm_distance_le_of_strongConvex_firstOrder_of_gradientPairingBound model gradient
    hsensitivity hmodulus
    (fun displacement evaluated first second =>
      abs_frozenGradientPairing_sub_le_of_finiteTransportSensitive model gradient hgradient
        hsensitive displacement evaluated first second)
    hstrong update hupdate hfirstOrder first second

