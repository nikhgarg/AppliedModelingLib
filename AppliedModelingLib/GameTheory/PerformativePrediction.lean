theorem exists_heterogeneousRERMSampleCount_meeting_theorem310Budget
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data] [Nonempty Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (hcompact : IsCompact domain)
    (hcontinuous : ∀ datum, Continuous (fun candidate => model.loss datum candidate))
    (tolerance p : ℝ) (htolerance : 0 < tolerance) (hp : 0 < p) :
    ∃ sampleCount : ℕ → ℕ, (∀ round, 0 < sampleCount round) ∧
      ∀ round deployed,
        finiteIidUniformEmpiricalRiskDeviationFailure model domain deployed tolerance
          (sampleCount round) ≤ theorem310FailureBudget p round := by
  have htotal := finiteIidUniformEmpiricalRiskDeviationTotalFailure_tendsto_zero
