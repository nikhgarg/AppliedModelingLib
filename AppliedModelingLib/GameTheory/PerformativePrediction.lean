/-- A finite parameter-uniform budget for empirical-gradient mass deviations. -/
noncomputable def finiteIidEmpiricalGradientMassDeviationTotalFailure
    {Parameter Data : Type*} [Fintype Parameter] [DecidableEq Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (epsilon : ℝ) (sampleCount : ℕ) : ℝ :=
  ∑ deployed, finiteIidEmpiricalGradientMassDeviationFailure model deployed epsilon sampleCount

/-- One finite-IID empirical-gradient mass-deviation failure is nonnegative. -/
theorem finiteIidEmpiricalGradientMassDeviationFailure_nonneg
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (deployed : Parameter)
    (epsilon : ℝ) (sampleCount : ℕ) :
    0 ≤ finiteIidEmpiricalGradientMassDeviationFailure model deployed epsilon sampleCount := by
  unfold finiteIidEmpiricalGradientMassDeviationFailure
  exact pmfProb_nonneg _ _

/-- The finite parameter-uniform gradient-mass budget controls every deployed law. -/
theorem finiteIidEmpiricalGradientMassDeviationFailure_le_totalFailure
    {Parameter Data : Type*} [Fintype Parameter] [DecidableEq Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (deployed : Parameter)
    (epsilon : ℝ) (sampleCount : ℕ) :
    finiteIidEmpiricalGradientMassDeviationFailure model deployed epsilon sampleCount ≤
      finiteIidEmpiricalGradientMassDeviationTotalFailure model epsilon sampleCount := by
  classical
  unfold finiteIidEmpiricalGradientMassDeviationTotalFailure
  exact Finset.single_le_sum
    (f := fun other => finiteIidEmpiricalGradientMassDeviationFailure model other epsilon sampleCount)
    (s := Finset.univ)
    (fun other _ => finiteIidEmpiricalGradientMassDeviationFailure_nonneg
      model other epsilon sampleCount)
    (Finset.mem_univ deployed)

/-- The finite parameter-uniform gradient-mass failure budget vanishes with batch size. -/
theorem finiteIidEmpiricalGradientMassDeviationTotalFailure_tendsto_zero
    {Parameter Data : Type*} [Fintype Parameter] [DecidableEq Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (epsilon : ℝ) (hepsilon : 0 < epsilon) :
