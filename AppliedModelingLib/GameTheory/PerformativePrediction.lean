  have hnonneg : ∀ sampleCount,
      0 ≤ freshPerformativeTraceLawEmpiricalGradientMassDeviationUpToFailure initialLaw model sampleCount
        (deployedOfHistory sampleCount) iteration epsilon := by
    intro sampleCount
    unfold freshPerformativeTraceLawEmpiricalGradientMassDeviationUpToFailure
    exact adaptiveFreshTraceAnyBadProbability_nonneg initialLaw model.dataLaw
      (deployedOfHistory sampleCount)
