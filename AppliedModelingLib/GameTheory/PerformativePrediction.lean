/-!
# Finite Performative Prediction

Reusable game-theoretic definitions for a model whose deployed parameter changes the data
law.  The terminology follows Perdomo--Zrnic--Mendler-Dünner--Hardt (2020):
performative risk evaluates a parameter on its own induced distribution, while
performative stability is best response to that frozen distribution.
-/

namespace AppliedModelingLib

open MeasureTheory
open ProbabilityTheory
open scoped InnerProductSpace ENNReal

/--
The binary data encoding used for Appendix E.5 carries the metric induced by
`false ↦ 0`, `true ↦ 1`.  Products therefore use the max product metric.
This is local to the present finite-model formalization.
-/
noncomputable instance proposition42BoolMetricSpace : MetricSpace Bool :=
  MetricSpace.induced (fun value : Bool => if value then (1 : ℝ) else 0) (by
    intro first second h
    cases first <;> cases second <;> simp_all) inferInstance

/-- The local binary metric is the distance between its `0`/`1` real encoding. -/
theorem proposition42Bool_dist (first second : Bool) :
    dist first second = |(if first then (1 : ℝ) else 0) - (if second then (1 : ℝ) else 0)| := rfl

/-- A finite performative model: parameters index a data distribution and loss. -/
structure FinitePerformativeModel (Parameter Data : Type*)
    [Fintype Data] [DecidableEq Data] where
  dataLaw : Parameter → PMF Data
  loss : Data → Parameter → ℝ

/--
A performative model over arbitrary probability measures.  Integrability is
part of the model because the general-distribution population risks below are
real Bochner integrals rather than finite sums.
-/
structure MeasurePerformativeModel (Parameter Data : Type*) [MeasurableSpace Data] where
  dataLaw : Parameter → ProbabilityMeasure Data
  loss : Data → Parameter → ℝ
  loss_integrable : ∀ distributionParameter evaluatedParameter,
    Integrable (fun datum => loss datum evaluatedParameter)
      (dataLaw distributionParameter : Measure Data)

/-- A performative model defined only on a designated parameter domain. -/
structure MeasurePerformativeModelOn (Parameter Data : Type*) [MeasurableSpace Data]
    (domain : Set Parameter) where
  dataLaw : domain → ProbabilityMeasure Data
  loss : Data → domain → ℝ
  loss_integrable : ∀ distributionParameter evaluatedParameter,
    Integrable (fun datum => loss datum evaluatedParameter)
      (dataLaw distributionParameter : Measure Data)

namespace MeasurePerformativeModelOn

/-- Extend a domain model to the ambient parameter space. Outside the domain,
the induced law is frozen at an in-domain anchor and the evaluated loss is
zero. -/
noncomputable def extend {Parameter Data : Type*} [MeasurableSpace Data]
    {domain : Set Parameter} (model : MeasurePerformativeModelOn Parameter Data domain)
    (anchor : domain) : MeasurePerformativeModel Parameter Data := by
  classical
  refine {
    dataLaw := fun parameter =>
      if hparameter : parameter ∈ domain then model.dataLaw ⟨parameter, hparameter⟩
      else model.dataLaw anchor
    loss := fun datum parameter =>
      if hparameter : parameter ∈ domain then model.loss datum ⟨parameter, hparameter⟩
      else 0
    loss_integrable := ?_
  }
  intro distributionParameter evaluatedParameter
  by_cases hevaluated : evaluatedParameter ∈ domain
  · by_cases hdistribution : distributionParameter ∈ domain
    · simpa [hevaluated, hdistribution] using
        model.loss_integrable ⟨distributionParameter, hdistribution⟩
          ⟨evaluatedParameter, hevaluated⟩
    · simpa [hevaluated, hdistribution] using
        model.loss_integrable anchor ⟨evaluatedParameter, hevaluated⟩
  · simp [hevaluated]

/-- Extend an on-domain gradient witness by its value at the same anchor. -/
noncomputable def extendGradient {Parameter Data : Type*}
    {domain : Set Parameter} (gradient : Data → domain → Parameter)
    (anchor : domain) : Data → Parameter → Parameter := by
  classical
  exact fun datum parameter =>
      if hparameter : parameter ∈ domain then gradient datum ⟨parameter, hparameter⟩
      else gradient datum anchor

/-- Decoupled performative risk for a model whose parameter carrier is a set. -/
noncomputable def decoupledPerformativeRisk
    {Parameter Data : Type*} [MeasurableSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (deployed evaluated : domain) : ℝ :=
  ∫ datum, model.loss datum evaluated ∂(model.dataLaw deployed : Measure Data)

/-- Performative risk for a model whose parameter carrier is a set. -/
noncomputable def performativeRisk
    {Parameter Data : Type*} [MeasurableSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (parameter : domain) : ℝ :=
  model.decoupledPerformativeRisk parameter parameter

end MeasurePerformativeModelOn

/--
A measurable sampling realization of a measure-valued performative model.
Its kernel is the additional analytic datum needed to sample sequentially from
the model on one probability space; a bare map `Parameter → ProbabilityMeasure
Data` does not provide this measurability automatically.
-/
structure MeasurePerformativeSamplingKernel {Parameter Data : Type*}
    [MeasurableSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) where
  kernel : Kernel Parameter Data
  isMarkov : IsMarkovKernel kernel
  apply_eq_dataLaw : ∀ parameter, kernel parameter = model.dataLaw parameter

/-- The law induced at each adaptive history by deployment in a measure model. -/
noncomputable def measurePerformativeDeployedLaw {Parameter Data : Type*}
    [MeasurableSpace Data] (model : MeasurePerformativeModel Parameter Data)
    (BatchIndex : ℕ → Type*)
    (deployedOfHistory : ∀ iteration,
      HeterogeneousBatchTrace BatchIndex Data iteration → Parameter) :
    ∀ iteration, HeterogeneousBatchTrace BatchIndex Data iteration → ProbabilityMeasure Data :=
  fun iteration history => model.dataLaw (deployedOfHistory iteration history)

/--
The common infinite batch trace induced by a measurable adaptive deployment
and a measure-performative sampling kernel. At round `t`, its batch coordinate
is conditionally IID from the data law selected by the preceding history.
-/
noncomputable def measurePerformativeHeterogeneousBatchTraceInfiniteLaw
    {Parameter Data : Type*} [MeasurableSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (sampling : MeasurePerformativeSamplingKernel model)
    (sampleCount : ℕ → ℕ)
    (deployedOfHistory : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration → Parameter)
    (hmeasurableDeployed : ∀ iteration, Measurable (deployedOfHistory iteration)) :
    Measure ((i : ℕ) → HeterogeneousBatchTraceCoordinate
      (fun round => Fin (sampleCount round)) Data i) :=
  @heterogeneousBatchTraceInfiniteLaw Data _ (fun round => Fin (sampleCount round))
    (fun iteration => Probability.finiteIIDBatchKernel (sampleCount iteration)
      (heterogeneousBatchTraceOneObservationKernel (fun round => Fin (sampleCount round))
        sampling.kernel deployedOfHistory iteration (hmeasurableDeployed iteration)))
    (fun iteration => by
      letI : IsMarkovKernel sampling.kernel := sampling.isMarkov
      letI : IsMarkovKernel
          (heterogeneousBatchTraceOneObservationKernel (fun round => Fin (sampleCount round))
            sampling.kernel deployedOfHistory iteration (hmeasurableDeployed iteration)) :=
        heterogeneousBatchTraceOneObservationKernel_isMarkov
          (fun round => Fin (sampleCount round)) sampling.kernel deployedOfHistory iteration
          (hmeasurableDeployed iteration)
      exact Probability.finiteIIDBatchKernel_isMarkov (sampleCount iteration)
        (heterogeneousBatchTraceOneObservationKernel (fun round => Fin (sampleCount round))
          sampling.kernel deployedOfHistory iteration (hmeasurableDeployed iteration)))

/-- General-distribution frozen population risk. -/
noncomputable def measureDecoupledPerformativeRisk {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (distributionParameter evaluatedParameter : Parameter) : ℝ :=
  ∫ datum, model.loss datum evaluatedParameter ∂(model.dataLaw distributionParameter : Measure Data)

/--
The frozen empirical risk of a parameter under a supplied empirical data law.
Keeping the law explicit lets a deterministic RERM perturbation theorem apply
both to a realized finite batch and to other empirical-measure constructions.
-/
noncomputable def measureEmpiricalDecoupledPerformativeRisk {Parameter Data : Type*}
    [MeasurableSpace Data] (model : MeasurePerformativeModel Parameter Data)
    (empiricalLaw : ProbabilityMeasure Data) (evaluatedParameter : Parameter) : ℝ :=
  ∫ datum, model.loss datum evaluatedParameter ∂(empiricalLaw : Measure Data)

/-- A population-risk minimizer at a specified arbitrary probability law. -/
def IsMeasurePopulationRiskMinimizerOn {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (distribution : ProbabilityMeasure Data) (minimizer : Parameter) : Prop :=
  minimizer ∈ domain ∧ ∀ candidate ∈ domain,
    (∫ datum, model.loss datum minimizer ∂(distribution : Measure Data)) ≤
      ∫ datum, model.loss datum candidate ∂(distribution : Measure Data)

/-- General-distribution performative risk evaluated on the induced data law. -/
noncomputable def measurePerformativeRisk {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (parameter : Parameter) : ℝ :=
  measureDecoupledPerformativeRisk model parameter parameter

namespace MeasurePerformativeModelOn

/-- The ambient extension preserves every on-domain decoupled risk. -/
theorem decoupledPerformativeRisk_extend
    {Parameter Data : Type*} [MeasurableSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (anchor deployed evaluated : domain) :
    measureDecoupledPerformativeRisk (model.extend anchor) deployed evaluated =
      model.decoupledPerformativeRisk deployed evaluated := by
  simp [measureDecoupledPerformativeRisk, decoupledPerformativeRisk,
    extend, deployed.property, evaluated.property]

/-- The ambient extension preserves every on-domain performative risk. -/
theorem performativeRisk_extend
    {Parameter Data : Type*} [MeasurableSpace Data] {domain : Set Parameter}
    (model : MeasurePerformativeModelOn Parameter Data domain)
    (anchor parameter : domain) :
    measurePerformativeRisk (model.extend anchor) parameter =
      model.performativeRisk parameter := by
  simp [measurePerformativeRisk, performativeRisk,
    model.decoupledPerformativeRisk_extend]

end MeasurePerformativeModelOn

/-- General-distribution performative optimality. -/
def IsMeasurePerformativelyOptimal {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (parameter : Parameter) : Prop :=
  ∀ candidate, measurePerformativeRisk model parameter ≤ measurePerformativeRisk model candidate

/-- General-distribution performative optimality relative to a parameter domain. -/
def IsMeasurePerformativelyOptimalOn {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (parameter : Parameter) : Prop :=
  parameter ∈ domain ∧ ∀ candidate ∈ domain,
    measurePerformativeRisk model parameter ≤ measurePerformativeRisk model candidate

/-- General-distribution performative stability under the deployed law. -/
def IsMeasurePerformativelyStable {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (parameter : Parameter) : Prop :=
  ∀ candidate,
    measureDecoupledPerformativeRisk model parameter parameter ≤
      measureDecoupledPerformativeRisk model parameter candidate

/-- A selected repeated population-risk minimization update for arbitrary data laws. -/
def IsMeasureRepeatedRiskMinimization {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (update : Parameter → Parameter) : Prop :=
  ∀ deployed candidate,
    measureDecoupledPerformativeRisk model deployed (update deployed) ≤
      measureDecoupledPerformativeRisk model deployed candidate

/-- A minimizer of a frozen empirical risk over a parameter domain. -/
def IsMeasureEmpiricalRiskMinimizerOn {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (empiricalLaw : ProbabilityMeasure Data) (minimizer : Parameter) : Prop :=
  minimizer ∈ domain ∧ ∀ candidate ∈ domain,
    measureEmpiricalDecoupledPerformativeRisk model empiricalLaw minimizer ≤
      measureEmpiricalDecoupledPerformativeRisk model empiricalLaw candidate

/--
A history-indexed RERM realization for nonempty finite batches.  At each
round the next deployed parameter minimizes the realized batch's empirical
risk over the parameter domain.
-/
def IsHeterogeneousMeasureRepeatedEmpiricalRiskMinimizationTrajectoryOn
    {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (sampleCount : ℕ → ℕ) (hcountPositive : ∀ iteration, 0 < sampleCount iteration)
    (deployedOfHistory : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration → Parameter) : Prop :=
  ∀ iteration history batch,
    IsMeasureEmpiricalRiskMinimizerOn model domain
      (empiricalSampleProbabilityMeasureOfPos (hcountPositive iteration) batch)
      (deployedOfHistory (iteration + 1) (heterogeneousBatchTraceSnoc history batch))

/--
The uniform empirical-risk failure event at one adaptive batch.  Its
measurability is an application-specific analytic premise, supplied when the
event is placed on an Ionescu--Tulcea trace.
-/
def measurePerformativeUniformEmpiricalRiskDeviationBadEvent
    {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (tolerance : ℝ) (sampleCount : ℕ → ℕ)
    (hcountPositive : ∀ iteration, 0 < sampleCount iteration)
    (deployedOfHistory : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration → Parameter)
    (iteration : ℕ)
    (history : HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration)
    (batch : Fin (sampleCount iteration) → Data) : Prop :=
  ¬ ∀ candidate ∈ domain,
    |measureEmpiricalDecoupledPerformativeRisk model
        (empiricalSampleProbabilityMeasureOfPos (hcountPositive iteration) batch) candidate -
      measureDecoupledPerformativeRisk model (deployedOfHistory iteration history) candidate| ≤
        tolerance

/-- The restriction of a forward-invariant update to its parameter domain. -/
def restrictedUpdate {Parameter : Type*} (domain : Set Parameter)
    (update : Parameter → Parameter) (hmaps : Set.MapsTo update domain domain) :
    domain → domain :=
  hmaps.restrict update domain domain

/-- A domain-restricted update is contracting when its ambient distance bound is strict. -/
theorem contractingWith_restrictedUpdate_of_bound
    {Parameter : Type*} [MetricSpace Parameter] (domain : Set Parameter)
    (update : Parameter → Parameter) (hmaps : Set.MapsTo update domain domain)
    {factor : NNReal} (hfactor : factor < 1)
    (hbound : ∀ first ∈ domain, ∀ second ∈ domain,
      dist (update first) (update second) ≤ (factor : ℝ) * dist first second) :
    ContractingWith factor (restrictedUpdate domain update hmaps) := by
  refine ⟨hfactor, LipschitzWith.of_dist_le_mul ?_⟩
  intro first second
  simpa only [restrictedUpdate, Set.MapsTo.val_restrict_apply, Subtype.dist_eq] using
    hbound first first.2 second second.2

/-- General-distribution performative stability relative to a parameter domain. -/
def IsMeasurePerformativelyStableOn {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (parameter : Parameter) : Prop :=
  parameter ∈ domain ∧ ∀ candidate ∈ domain,
    measureDecoupledPerformativeRisk model parameter parameter ≤
      measureDecoupledPerformativeRisk model parameter candidate

/--
The frozen-law best-response correspondence for arbitrary data laws.  The
deployed parameter is restricted to the source parameter domain so that the
compact-convex fixed-point theorem applies directly.
-/
def measurePerformativeBestResponseOn {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (deployed : domain) : Set Parameter :=
  {candidate | candidate ∈ domain ∧ ∀ other ∈ domain,
    measureDecoupledPerformativeRisk model deployed.1 candidate ≤
      measureDecoupledPerformativeRisk model deployed.1 other}

/-- Membership in an arbitrary-law frozen best-response value. -/
@[simp] theorem mem_measurePerformativeBestResponseOn_iff
    {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (deployed : domain) (candidate : Parameter) :
    candidate ∈ measurePerformativeBestResponseOn model domain deployed ↔
      candidate ∈ domain ∧ ∀ other ∈ domain,
        measureDecoupledPerformativeRisk model deployed.1 candidate ≤
          measureDecoupledPerformativeRisk model deployed.1 other :=
  Iff.rfl

/-- A selected general-law RRM update whose frozen-law minimizers stay in a parameter domain. -/
def IsMeasureRepeatedRiskMinimizationOn {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (update : Parameter → Parameter) : Prop :=
  ∀ deployed ∈ domain, update deployed ∈ domain ∧ ∀ candidate ∈ domain,
    measureDecoupledPerformativeRisk model deployed (update deployed) ≤
      measureDecoupledPerformativeRisk model deployed candidate

/-- A fixed point of a general-law repeated-minimization selector is performatively stable. -/
theorem isMeasurePerformativelyStable_of_rrm_fixedPoint
    {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (update : Parameter → Parameter)
    (hrrm : IsMeasureRepeatedRiskMinimization model update) {parameter : Parameter}
    (hfixed : update parameter = parameter) :
    IsMeasurePerformativelyStable model parameter := by
  intro candidate
  simpa only [hfixed] using hrrm parameter candidate

/-- A fixed point of a domain-restricted general-law RRM selector is domain-stable. -/
theorem isMeasurePerformativelyStableOn_of_rrmOn_fixedPoint
    {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimizationOn model domain update)
    {parameter : Parameter} (hparameter : parameter ∈ domain) (hfixed : update parameter = parameter) :
    IsMeasurePerformativelyStableOn model domain parameter := by
  refine ⟨hparameter, ?_⟩
  intro candidate hcandidate
  simpa only [hfixed] using (hrrm parameter hparameter).2 candidate hcandidate

/-- A domain-restricted RRM selector maps its parameter domain into itself. -/
theorem measureRepeatedRiskMinimizationOn_mapsTo
    {Parameter Data : Type*} [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (update : Parameter → Parameter) (hrrm : IsMeasureRepeatedRiskMinimizationOn model domain update) :
    Set.MapsTo update domain domain :=
  fun deployed hdeployed => (hrrm deployed hdeployed).1

/--
One adaptive fresh-sampling round for a performative model: first draw the
currently deployed parameter, then conditionally draw an IID batch from its
induced data law.  This makes the current-law dependence in Definition 3.9
explicit at the PMF level.
-/
noncomputable def freshPerformativeBatchLaw
    {Parameter Data BatchIndex : Type*}
    [Fintype Data] [DecidableEq Data] [Fintype BatchIndex] [DecidableEq BatchIndex]
    (parameterLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data) :
    PMF (Parameter × (BatchIndex → Data)) :=
  adaptiveFreshProductLaw parameterLaw model.dataLaw

/-- The current-parameter marginal is preserved by one adaptive fresh-sampling round. -/
theorem freshPerformativeBatchLaw_fst_marginal
    {Parameter Data BatchIndex : Type*}
    [Fintype Data] [DecidableEq Data] [Fintype BatchIndex] [DecidableEq BatchIndex]
    (parameterLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data) :
    (freshPerformativeBatchLaw parameterLaw model (BatchIndex := BatchIndex)).map Prod.fst =
      parameterLaw :=
  adaptiveFreshProductLaw_fst_marginal parameterLaw model.dataLaw

/--
Expected values under the fresh-batch law condition first on the deployed
parameter and then average over its IID induced-data batch.
-/
theorem pmfExp_freshPerformativeBatchLaw
    {Parameter Data BatchIndex : Type*}
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data]
    [Fintype BatchIndex] [DecidableEq BatchIndex]
    (parameterLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (statistic : Parameter × (BatchIndex → Data) → ℝ) :
    pmfExp (freshPerformativeBatchLaw parameterLaw model) statistic =
      pmfExp parameterLaw (fun parameter =>
        pmfExp (pmfProduct BatchIndex Data (model.dataLaw parameter))
          (fun batch => statistic (parameter, batch))) :=
  pmfExp_adaptiveFreshProductLaw parameterLaw model.dataLaw statistic

/--
Distributional state evolution for repeated empirical procedures: at each
round the update receives a new IID batch drawn from the data law of the
random currently deployed parameter.
-/
noncomputable def freshPerformativeIterateLaw
    {Parameter Data BatchIndex : Type*}
    [Fintype Data] [DecidableEq Data] [Fintype BatchIndex] [DecidableEq BatchIndex]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (update : Parameter → (BatchIndex → Data) → Parameter) : ℕ → PMF Parameter :=
  adaptiveFreshIterateLaw initialLaw model.dataLaw update

/-- The recursive equation for one performative fresh-sampling transition. -/
theorem freshPerformativeIterateLaw_succ
    {Parameter Data BatchIndex : Type*}
    [Fintype Data] [DecidableEq Data] [Fintype BatchIndex] [DecidableEq BatchIndex]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (update : Parameter → (BatchIndex → Data) → Parameter) (iteration : ℕ) :
    freshPerformativeIterateLaw initialLaw model update (iteration + 1) =
      adaptiveFreshStepLaw (freshPerformativeIterateLaw initialLaw model update iteration)
        model.dataLaw update :=
  adaptiveFreshIterateLaw_succ initialLaw model.dataLaw update iteration

/--
Finite trace law for an adaptive performative procedure, retaining every
fresh batch so later event statements can be expressed on the joint history.
-/
noncomputable def freshPerformativeTraceLaw
    {Parameter Data BatchIndex : Type*}
    [Fintype Data] [DecidableEq Data] [Fintype BatchIndex] [DecidableEq BatchIndex]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (deployedOfHistory : ∀ iteration, (Fin iteration → BatchIndex → Data) → Parameter) :
    (iteration : ℕ) → PMF (Fin iteration → BatchIndex → Data) :=
  adaptiveFreshTraceLaw initialLaw model.dataLaw deployedOfHistory

/-- The expectation expansion for one fresh performative trace extension. -/
theorem pmfExp_freshPerformativeTraceLaw_succ
    {Parameter Data BatchIndex : Type*}
    [Fintype Data] [DecidableEq Data] [Fintype BatchIndex] [DecidableEq BatchIndex]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (deployedOfHistory : ∀ iteration, (Fin iteration → BatchIndex → Data) → Parameter)
    (iteration : ℕ) (statistic : (Fin (iteration + 1) → BatchIndex → Data) → ℝ) :
    pmfExp (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1)) statistic =
      pmfExp (freshPerformativeTraceLaw initialLaw model deployedOfHistory iteration) (fun history =>
        pmfExp (pmfProduct BatchIndex Data (model.dataLaw (deployedOfHistory iteration history)))
          (fun batch => statistic (Fin.snoc history batch))) :=
  pmfExp_adaptiveFreshTraceLaw_succ initialLaw model.dataLaw deployedOfHistory iteration statistic

/--
Adaptive performative trace events factor into their preceding-history law and
the conditional IID probability of the fresh batch event.
-/
theorem pmfProb_freshPerformativeTraceLaw_succ
    {Parameter Data BatchIndex : Type*}
    [Fintype Data] [DecidableEq Data] [Fintype BatchIndex] [DecidableEq BatchIndex]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (deployedOfHistory : ∀ iteration, (Fin iteration → BatchIndex → Data) → Parameter)
    (iteration : ℕ) (event : (Fin (iteration + 1) → BatchIndex → Data) → Prop)
    [DecidablePred event] :
    pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1)) event =
      pmfExp (freshPerformativeTraceLaw initialLaw model deployedOfHistory iteration) (fun history =>
        pmfProb (pmfProduct BatchIndex Data (model.dataLaw (deployedOfHistory iteration history)))
          (fun batch => event (Fin.snoc history batch))) :=
  pmfProb_adaptiveFreshTraceLaw_succ initialLaw model.dataLaw deployedOfHistory iteration event

/-- A uniform conditional batch-failure bound remains valid at an adaptive round. -/
theorem pmfProb_freshPerformativeTraceLaw_succ_le_of_forall
    {Parameter Data BatchIndex : Type*}
    [Fintype Data] [DecidableEq Data] [Fintype BatchIndex] [DecidableEq BatchIndex]
    (initialLaw : PMF Parameter) (model : FinitePerformativeModel Parameter Data)
    (deployedOfHistory : ∀ iteration, (Fin iteration → BatchIndex → Data) → Parameter)
    (iteration : ℕ) (event : (Fin (iteration + 1) → BatchIndex → Data) → Prop)
    [DecidablePred event] (failure : ℝ)
    (hfailure : ∀ history,
      pmfProb (pmfProduct BatchIndex Data (model.dataLaw (deployedOfHistory iteration history)))
        (fun batch => event (Fin.snoc history batch)) ≤ failure) :
    pmfProb (freshPerformativeTraceLaw initialLaw model deployedOfHistory (iteration + 1)) event ≤
      failure :=
  pmfProb_adaptiveFreshTraceLaw_succ_le_of_forall initialLaw model.dataLaw deployedOfHistory
    iteration event failure hfailure

/-- Performative risk `E_{Z ~ D(theta)} loss(Z, theta)`. -/
noncomputable def performativeRisk {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (parameter : Parameter) : ℝ :=
  pmfExp (model.dataLaw parameter) fun datum => model.loss datum parameter

/-- Decoupled performative risk, with distribution and evaluated parameter separate. -/
noncomputable def decoupledPerformativeRisk {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (distributionParameter evaluatedParameter : Parameter) : ℝ :=
  pmfExp (model.dataLaw distributionParameter) fun datum => model.loss datum evaluatedParameter

/--
The algebraic tail of Proposition 4.2: the quadratic normal form computed in
Appendix E.5 is concave whenever the sensitivity coefficient is at least one
half.  This isolates the appendix's direct calculation; constructing its
particular Bernoulli distribution map inside the finite-PMF model is separate.
-/
theorem concaveOn_proposition42_sourceQuadratic
    (epsilon mu : ℝ) (hepsilon : (1 : ℝ) / 2 ≤ epsilon) :
    ConcaveOn ℝ Set.univ
      (fun theta : ℝ => (1 : ℝ) / 4 - 2 * theta * mu +
        (1 - 2 * epsilon) * theta ^ 2) := by
  have hquadratic : 1 - 2 * epsilon ≤ 0 := by linarith
  have hcore := concaveOn_real_quadratic_of_nonpos
    ((1 : ℝ) / 4) (-2 * mu) (1 - 2 * epsilon) hquadratic
  convert hcore using 1
  ext theta
  ring

/--
The strict form of the Proposition 4.2 algebraic tail when the sensitivity
coefficient exceeds one half.
-/
theorem strictConcaveOn_proposition42_sourceQuadratic
    (epsilon mu : ℝ) (hepsilon : (1 : ℝ) / 2 < epsilon) :
    StrictConcaveOn ℝ Set.univ
      (fun theta : ℝ => (1 : ℝ) / 4 - 2 * theta * mu +
        (1 - 2 * epsilon) * theta ^ 2) := by
  have hquadratic : 1 - 2 * epsilon < 0 := by linarith
  have hcore := strictConcaveOn_real_quadratic_of_neg
    ((1 : ℝ) / 4) (-2 * mu) (1 - 2 * epsilon) hquadratic
  convert hcore using 1
  ext theta
  ring

/--
Appendix E.5's displayed condition `|mu + epsilon| ≤ 1/2` alone does not make
its Bernoulli parameter valid over all `theta ∈ [0, 1]`: the omitted endpoint
condition on `mu` is mathematically necessary for the announced model family.
-/
theorem proposition42_source_muCondition_allows_invalidBernoulliParameter :
    ∃ epsilon mu theta : ℝ,
      (1 : ℝ) / 2 < epsilon ∧ |mu + epsilon| ≤ (1 : ℝ) / 2 ∧
        theta ∈ Set.Icc (0 : ℝ) 1 ∧
          (1 : ℝ) / 2 + mu + epsilon * theta < 0 := by
  refine ⟨(3 : ℝ) / 4, -(3 : ℝ) / 4, 0, ?_⟩
  norm_num

/--
The endpoint repair still admits the nontrivial sensitivity regime used in
Proposition 4.2: `epsilon` can be strictly between one half and `2 / 2`.
-/
theorem proposition42_repaired_parameter_conditions_consistent :
    ∃ mu epsilon : ℝ,
      (1 : ℝ) / 2 < epsilon ∧ epsilon < (2 : ℝ) / 2 ∧
        |mu| ≤ (1 : ℝ) / 2 ∧ |mu + epsilon| ≤ (1 : ℝ) / 2 := by
  refine ⟨-(3 : ℝ) / 8, (3 : ℝ) / 4, ?_⟩
  norm_num

/--
Adding the missing `|mu| ≤ 1/2` endpoint condition makes the Appendix E.5
Bernoulli parameter lie in `[0, 1]` throughout the advertised parameter
interval.  This is a model-validity repair, not a construction of the full
source example.
-/
theorem proposition42_bernoulliParameter_unitInterval_of_endpoint_bounds
    (mu epsilon theta : ℝ) (hmu : |mu| ≤ (1 : ℝ) / 2)
    (hmuEpsilon : |mu + epsilon| ≤ (1 : ℝ) / 2)
    (htheta : theta ∈ Set.Icc (0 : ℝ) 1) :
    (1 : ℝ) / 2 + mu + epsilon * theta ∈ Set.Icc (0 : ℝ) 1 := by
  have hcore := abs_affine_parameter_le_of_endpoint_abs_le mu (mu + epsilon)
    ((1 : ℝ) / 2) theta hmu hmuEpsilon htheta
  have habs : |mu + epsilon * theta| ≤ (1 : ℝ) / 2 := by
    have hrewrite : mu + epsilon * theta =
        (1 - theta) * mu + theta * (mu + epsilon) := by ring
    rw [hrewrite]
    exact hcore
  have hbounds := abs_le.mp habs
  constructor <;> linarith

/-- The Bernoulli parameter used by the repaired finite form of Appendix E.5. -/
noncomputable def proposition42BernoulliParameter (bias : ℝ) (feature : Bool) : NNReal :=
  (if feature then (1 : ℝ) / 2 + bias else (1 : ℝ) / 2 - bias).toNNReal

/-- The repaired endpoint bounds ensure the Bernoulli parameter is at most one. -/
theorem proposition42BernoulliParameter_le_one (bias : ℝ) (feature : Bool)
    (hbias : |bias| ≤ (1 : ℝ) / 2) : proposition42BernoulliParameter bias feature ≤ 1 := by
  unfold proposition42BernoulliParameter
  rw [Real.toNNReal_le_iff_le_coe]
  split_ifs with h <;> have hbounds := abs_le.mp hbias
  · norm_num
    linarith
  · norm_num
    linarith

/--
The finite joint law in the repaired Appendix E.5 example: a uniform binary
feature followed by the displayed feature-dependent Bernoulli label.
-/
noncomputable def proposition42Law (bias : ℝ) (hbias : |bias| ≤ (1 : ℝ) / 2) :
    PMF (Bool × Bool) :=
  (PMF.uniformOfFintype Bool).bind fun feature =>
    (PMF.bernoulli (proposition42BernoulliParameter bias feature)
      (proposition42BernoulliParameter_le_one bias feature hbias)).map
      (fun label => (feature, label))

/--
For ordered biases, couple each conditional Bernoulli label law monotonically
and retain the common binary feature.  The false-feature branch reverses the
Bernoulli coupling because its label probability decreases with the bias.
-/
noncomputable def proposition42OrderedFeatureCoupling
    (low high : ℝ) (hlow : |low| ≤ (1 : ℝ) / 2) (hhigh : |high| ≤ (1 : ℝ) / 2)
    (hordered : low ≤ high) (feature : Bool) :
    FiniteCoupling
      ((PMF.bernoulli (proposition42BernoulliParameter low feature)
        (proposition42BernoulliParameter_le_one low feature hlow)).map
          (fun label => (feature, label)))
      ((PMF.bernoulli (proposition42BernoulliParameter high feature)
        (proposition42BernoulliParameter_le_one high feature hhigh)).map
          (fun label => (feature, label))) := by
  cases feature
  · have hlowBounds := abs_le.mp hlow
    have hhighBounds := abs_le.mp hhigh
    have horderedProbability :
        proposition42BernoulliParameter high false ≤ proposition42BernoulliParameter low false := by
      apply Real.toNNReal_monotone
      dsimp [proposition42BernoulliParameter]
      linarith
    exact ((FiniteCoupling.monotoneBernoulliCoupling
      (proposition42BernoulliParameter high false)
      (proposition42BernoulliParameter low false) horderedProbability
      (proposition42BernoulliParameter_le_one high false hhigh)
      (proposition42BernoulliParameter_le_one low false hlow)).swap).map
        (fun label => (false, label)) (fun label => (false, label))
  · have hlowBounds := abs_le.mp hlow
    have hhighBounds := abs_le.mp hhigh
    have horderedProbability :
        proposition42BernoulliParameter low true ≤ proposition42BernoulliParameter high true := by
      apply Real.toNNReal_monotone
      dsimp [proposition42BernoulliParameter]
      linarith
    exact (FiniteCoupling.monotoneBernoulliCoupling
      (proposition42BernoulliParameter low true)
      (proposition42BernoulliParameter high true) horderedProbability
      (proposition42BernoulliParameter_le_one low true hlow)
      (proposition42BernoulliParameter_le_one high true hhigh)).map
        (fun label => (true, label)) (fun label => (true, label))

/--
A finite transport plan between two ordered Proposition 4.2 data laws, built
by combining their featurewise monotone label couplings over the common uniform
feature law.
-/
noncomputable def proposition42OrderedLawCoupling
    (low high : ℝ) (hlow : |low| ≤ (1 : ℝ) / 2) (hhigh : |high| ≤ (1 : ℝ) / 2)
    (hordered : low ≤ high) :
    FiniteCoupling (proposition42Law low hlow) (proposition42Law high hhigh) :=
  FiniteCoupling.bindSharedBase (PMF.uniformOfFintype Bool)
    (fun feature =>
      (PMF.bernoulli (proposition42BernoulliParameter low feature)
        (proposition42BernoulliParameter_le_one low feature hlow)).map
        (fun label => (feature, label)))
    (fun feature =>
      (PMF.bernoulli (proposition42BernoulliParameter high feature)
        (proposition42BernoulliParameter_le_one high feature hhigh)).map
        (fun label => (feature, label)))
    (proposition42OrderedFeatureCoupling low high hlow hhigh hordered)

/-- The real value of each conditional Bernoulli probability. -/
theorem coe_proposition42BernoulliParameter
    (bias : ℝ) (feature : Bool) (hbias : |bias| ≤ (1 : ℝ) / 2) :
    (proposition42BernoulliParameter bias feature : ℝ) =
      if feature then (1 : ℝ) / 2 + bias else (1 : ℝ) / 2 - bias := by
  unfold proposition42BernoulliParameter
  split_ifs with h
  · apply Real.coe_toNNReal
    have hbounds := abs_le.mp hbias
    linarith
  · apply Real.coe_toNNReal
    have hbounds := abs_le.mp hbias
    linarith

/--
The featurewise transport plan has cost exactly the change in the scalar bias.
Both feature branches move the same label mass, in opposite Bernoulli orders.
-/
theorem expectedCost_proposition42OrderedFeatureCoupling
    (low high : ℝ) (hlow : |low| ≤ (1 : ℝ) / 2) (hhigh : |high| ≤ (1 : ℝ) / 2)
    (hordered : low ≤ high) (feature : Bool) :
    (proposition42OrderedFeatureCoupling low high hlow hhigh hordered feature).expectedCost
      (fun left right => dist left right) = high - low := by
  cases feature
  · simp only [proposition42OrderedFeatureCoupling]
    rw [FiniteCoupling.expectedCost_map, FiniteCoupling.expectedCost_swap]
    have hcost :
        (fun left right : Bool => dist (false, right) (false, left)) =
          fun left right => if left = right then (0 : ℝ) else 1 := by
      funext left right
      fin_cases left <;> fin_cases right <;>
        norm_num [Prod.dist_eq, proposition42Bool_dist]
    rw [hcost, FiniteCoupling.expectedCost_monotoneBernoulliCoupling]
    rw [coe_proposition42BernoulliParameter low false hlow,
      coe_proposition42BernoulliParameter high false hhigh]
    simp
  · simp only [proposition42OrderedFeatureCoupling]
    rw [FiniteCoupling.expectedCost_map]
    have hcost :
        (fun left right : Bool => dist (true, left) (true, right)) =
          fun left right => if left = right then (0 : ℝ) else 1 := by
      funext left right
      fin_cases left <;> fin_cases right <;>
        norm_num [Prod.dist_eq, proposition42Bool_dist]
    rw [hcost, FiniteCoupling.expectedCost_monotoneBernoulliCoupling]
    rw [coe_proposition42BernoulliParameter low true hlow,
      coe_proposition42BernoulliParameter high true hhigh]
    simp

/--
Combining the two featurewise plans over a uniform feature retains the same
total transport cost: both conditional costs equal the bias difference.
-/
theorem expectedCost_proposition42OrderedLawCoupling
    (low high : ℝ) (hlow : |low| ≤ (1 : ℝ) / 2) (hhigh : |high| ≤ (1 : ℝ) / 2)
    (hordered : low ≤ high) :
    (proposition42OrderedLawCoupling low high hlow hhigh hordered).expectedCost
      (fun left right => dist left right) = high - low := by
  unfold proposition42OrderedLawCoupling
  calc
    (FiniteCoupling.bindSharedBase (PMF.uniformOfFintype Bool)
        (fun feature =>
          (PMF.bernoulli (proposition42BernoulliParameter low feature)
            (proposition42BernoulliParameter_le_one low feature hlow)).map
            (fun label => (feature, label)))
        (fun feature =>
          (PMF.bernoulli (proposition42BernoulliParameter high feature)
            (proposition42BernoulliParameter_le_one high feature hhigh)).map
            (fun label => (feature, label)))
        (proposition42OrderedFeatureCoupling low high hlow hhigh hordered)).expectedCost
        (fun left right => dist left right) =
        pmfExp (PMF.uniformOfFintype Bool) (fun feature =>
          (proposition42OrderedFeatureCoupling low high hlow hhigh hordered feature).expectedCost
            (fun left right => dist left right)) :=
      FiniteCoupling.expectedCost_bindSharedBase _ _ _ _ _
    _ = high - low := by
      simp_rw [expectedCost_proposition42OrderedFeatureCoupling low high hlow hhigh hordered]
      simp [pmfExp, PMF.uniformOfFintype_apply]

/--
Every pair of valid Proposition 4.2 laws has a finite transport certificate
whose binary-data cost is at most the absolute bias difference.
-/
theorem proposition42Law_hasExpectedCostLE
    (first second : ℝ) (hfirst : |first| ≤ (1 : ℝ) / 2)
    (hsecond : |second| ≤ (1 : ℝ) / 2) :
    FiniteCoupling.HasExpectedCostLE (proposition42Law first hfirst)
      (proposition42Law second hsecond) (fun left right => dist left right) |first - second| := by
  rcases le_total first second with hordered | hordered
  · refine ⟨proposition42OrderedLawCoupling first second hfirst hsecond hordered, ?_⟩
    rw [expectedCost_proposition42OrderedLawCoupling]
    rw [abs_of_nonpos (sub_nonpos.mpr hordered)]
    linarith
  · refine ⟨(proposition42OrderedLawCoupling second first hsecond hfirst hordered).swap, ?_⟩
    rw [FiniteCoupling.expectedCost_swap]
    have hcost :
        (fun left right : Bool × Bool => dist right left) = fun left right => dist left right := by
      funext left right
      exact dist_comm _ _
    rw [hcost, expectedCost_proposition42OrderedLawCoupling]
    rw [abs_of_nonneg (sub_nonneg.mpr hordered)]

/-- The square loss and affine predictor in Appendix E.5. -/
noncomputable def proposition42Loss (theta : ℝ) (datum : Bool × Bool) : ℝ :=
  ((if datum.2 then (1 : ℝ) else 0) -
    (theta * (if datum.1 then (1 : ℝ) else -1) + (1 : ℝ) / 2)) ^ 2

/-- The scalar parameter gradient of the Proposition 4.2 square loss. -/
noncomputable def proposition42Gradient (datum : Bool × Bool) (theta : ℝ) : ℝ :=
  2 * (if datum.1 then (1 : ℝ) else -1) *
    (theta * (if datum.1 then (1 : ℝ) else -1) + (1 : ℝ) / 2 -
      (if datum.2 then (1 : ℝ) else 0))

/-- Exact second-order expansion of the Proposition 4.2 square loss. -/
theorem proposition42Loss_quadraticExpansion
    (datum : Bool × Bool) (center candidate : ℝ) :
    proposition42Loss candidate datum = proposition42Loss center datum +
      proposition42Gradient datum center * (candidate - center) + (candidate - center) ^ 2 := by
  rcases datum with ⟨feature, label⟩
  fin_cases feature <;> fin_cases label <;>
    simp [proposition42Loss, proposition42Gradient] <;> ring

/-- The source example's square loss is `2`-strongly convex in the parameter. -/
theorem proposition42Loss_strongConvex
    (datum : Bool × Bool) (center candidate : ℝ) :
    proposition42Loss candidate datum ≥ proposition42Loss center datum +
      proposition42Gradient datum center * (candidate - center) +
        (2 : ℝ) / 2 * (candidate - center) ^ 2 := by
  have h := (proposition42Loss_quadraticExpansion datum center candidate).ge
  norm_num
  exact h

/-- The parameter-coordinate smoothness calculation for the Proposition 4.2 loss. -/
theorem proposition42Gradient_parameterDifference
    (datum : Bool × Bool) (first second : ℝ) :
    proposition42Gradient datum first - proposition42Gradient datum second = 2 * (first - second) := by
  rcases datum with ⟨feature, label⟩
  fin_cases feature <;> fin_cases label <;>
    simp [proposition42Gradient] <;> ring

/-- The parameter-coordinate gradient is `2`-Lipschitz. -/
theorem proposition42Gradient_parameterLipschitz
    (datum : Bool × Bool) (first second : ℝ) :
    |proposition42Gradient datum first - proposition42Gradient datum second| ≤
      2 * |first - second| := by
  rw [proposition42Gradient_parameterDifference, abs_mul,
    abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]

/--
The direct expectation calculation in Appendix E.5, with the law's bias
kept explicit.  This also checks all PMF normalization and coercion details
that the informal calculation suppresses.
-/
theorem proposition42_expectedLoss_eq (bias theta : ℝ) (hbias : |bias| ≤ (1 : ℝ) / 2) :
    pmfExp (proposition42Law bias hbias) (proposition42Loss theta) =
      (1 : ℝ) / 4 - 2 * theta * bias + theta ^ 2 := by
  unfold pmfExp proposition42Law proposition42Loss
  simp only [PMF.bind_apply, PMF.map_apply, tsum_fintype,
    PMF.uniformOfFintype_apply, Fintype.card_bool, PMF.bernoulli_apply]
  rw [Fintype.sum_prod_type]
  simp_rw [Fintype.sum_bool]
  simp
  have hbounds := abs_le.mp hbias
  have htrue_nonneg : 0 ≤ (1 : ℝ) / 2 + bias := by linarith
  have hfalse_nonneg : 0 ≤ (1 : ℝ) / 2 - bias := by linarith
  have htrue : (proposition42BernoulliParameter bias true : ℝ) =
      (1 : ℝ) / 2 + bias := by
    change ((1 / 2 + bias).toNNReal : ℝ) = 1 / 2 + bias
    exact Real.coe_toNNReal _ htrue_nonneg
  have hfalse : (proposition42BernoulliParameter bias false : ℝ) =
      (1 : ℝ) / 2 - bias := by
    change ((1 / 2 - bias).toNNReal : ℝ) = 1 / 2 - bias
    exact Real.coe_toNNReal _ hfalse_nonneg
  have htrue_sub :
      (1 - (proposition42BernoulliParameter bias true : ENNReal)).toReal =
        1 - ((1 : ℝ) / 2 + bias) := by
    rw [ENNReal.toReal_sub_of_le]
    · simp only [ENNReal.toReal_one, ENNReal.coe_toReal]
      rw [htrue]
    · exact_mod_cast proposition42BernoulliParameter_le_one bias true hbias
    · exact ENNReal.one_ne_top
  have hfalse_sub :
      (1 - (proposition42BernoulliParameter bias false : ENNReal)).toReal =
        1 - ((1 : ℝ) / 2 - bias) := by
    rw [ENNReal.toReal_sub_of_le]
    · simp only [ENNReal.toReal_one, ENNReal.coe_toReal]
      rw [hfalse]
    · exact_mod_cast proposition42BernoulliParameter_le_one bias false hbias
    · exact ENNReal.one_ne_top
  rw [htrue, hfalse, htrue_sub, hfalse_sub]
  ring

/--
The corrected finite-PMF realization of Appendix E.5 on the source parameter
interval.  Its extra endpoint hypothesis is exactly what makes all data laws
well-defined.
-/
noncomputable def correctedProposition42Model
    (mu epsilon : ℝ) (hmu : |mu| ≤ (1 : ℝ) / 2)
    (hmuEpsilon : |mu + epsilon| ≤ (1 : ℝ) / 2) :
    FinitePerformativeModel {theta : ℝ // theta ∈ Set.Icc (0 : ℝ) 1} (Bool × Bool) where
  dataLaw theta := proposition42Law (mu + epsilon * theta)
    (by
      have hcore := abs_affine_parameter_le_of_endpoint_abs_le mu (mu + epsilon)
        ((1 : ℝ) / 2) theta hmu hmuEpsilon theta.2
      have hrewrite : mu + epsilon * (theta : ℝ) =
          (1 - (theta : ℝ)) * mu + (theta : ℝ) * (mu + epsilon) := by ring
      rw [hrewrite]
      exact hcore)
  loss datum theta := proposition42Loss theta datum

/--
The repaired finite model has exactly the performative-risk quadratic stated
in Appendix E.5.
-/
theorem performativeRisk_correctedProposition42Model_eq
    (mu epsilon : ℝ) (hmu : |mu| ≤ (1 : ℝ) / 2)
    (hmuEpsilon : |mu + epsilon| ≤ (1 : ℝ) / 2)
    (theta : {theta : ℝ // theta ∈ Set.Icc (0 : ℝ) 1}) :
    performativeRisk (correctedProposition42Model mu epsilon hmu hmuEpsilon) theta =
      (1 : ℝ) / 4 - 2 * theta * mu + (1 - 2 * epsilon) * theta ^ 2 := by
  have hbias : |mu + epsilon * (theta : ℝ)| ≤ (1 : ℝ) / 2 := by
    have hcore := abs_affine_parameter_le_of_endpoint_abs_le mu (mu + epsilon)
      ((1 : ℝ) / 2) theta hmu hmuEpsilon theta.2
    have hrewrite : mu + epsilon * (theta : ℝ) =
        (1 - (theta : ℝ)) * mu + (theta : ℝ) * (mu + epsilon) := by ring
    rw [hrewrite]
    exact hcore
  change pmfExp (proposition42Law (mu + epsilon * (theta : ℝ)) hbias)
      (proposition42Loss (theta : ℝ)) = _
  rw [proposition42_expectedLoss_eq (mu + epsilon * (theta : ℝ)) (theta : ℝ) hbias]
  ring

/-- A frozen-law population-risk minimizer constrained to a parameter domain. -/
def IsPopulationRiskMinimizerOn {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (domain : Set Parameter) (law : PMF Data) (parameter : Parameter) : Prop :=
  parameter ∈ domain ∧ ∀ candidate ∈ domain,
    pmfExp law (fun datum => model.loss datum parameter) ≤
      pmfExp law (fun datum => model.loss datum candidate)

/--
The frozen-distribution best-response correspondence on a parameter domain.
The domain is a subtype so that Kakutani's fixed-point theorem has precisely
the compact convex source set required by Proposition 4.1.
-/
def performativeBestResponseOn {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (domain : Set Parameter) (deployed : domain) : Set Parameter :=
  {candidate | IsPopulationRiskMinimizerOn model domain (model.dataLaw deployed.1) candidate}

@[simp] theorem mem_performativeBestResponseOn_iff
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (deployed : domain) (candidate : Parameter) :
    candidate ∈ performativeBestResponseOn model domain deployed ↔
      IsPopulationRiskMinimizerOn model domain (model.dataLaw deployed.1) candidate :=
  Iff.rfl

/--
Repeated risk minimization over a designated parameter domain.  This is the
closed-convex-domain form of Definition 3.3.
-/
def IsRepeatedRiskMinimizationOn {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] (model : FinitePerformativeModel Parameter Data)
    (domain : Set Parameter) (update : Parameter → Parameter) : Prop :=
  ∀ deployed ∈ domain,
    IsPopulationRiskMinimizerOn model domain (model.dataLaw deployed) (update deployed)

/--
The finite binary specialization of Proposition 3.6(a) clips the distribution
map outside the source domain `[-1, 1]`, so it is a total finite-PMF model on
`ℝ` while agreeing exactly with the displayed example on that domain.
-/
noncomputable def proposition36aClip (theta : ℝ) : ℝ :=
  max (-1) (min 1 theta)

/-- The clipped distributional mean always lies in the source parameter interval. -/
theorem proposition36aClip_mem (theta : ℝ) :
    proposition36aClip theta ∈ Set.Icc (-1 : ℝ) 1 := by
  unfold proposition36aClip
  constructor
  · exact le_max_left _ _
  · exact max_le (by norm_num) (min_le_left _ _)

/-- On the source domain, the finite specialization has the unmodified mean `theta`. -/
theorem proposition36aClip_eq_self {theta : ℝ} (htheta : theta ∈ Set.Icc (-1 : ℝ) 1) :
    proposition36aClip theta = theta := by
  unfold proposition36aClip
  rw [min_eq_right htheta.2, max_eq_right htheta.1]

/-- Clipping to the source interval is nonexpansive. -/
theorem proposition36aClip_lipschitz : LipschitzWith 1 proposition36aClip := by
  simpa [proposition36aClip] using
    ((LipschitzWith.id : LipschitzWith 1 (fun theta : ℝ => theta)).const_min (1 : ℝ)).const_max
      (-1 : ℝ)

/-- The probability of the positive signed binary observation. -/
noncomputable def proposition36aProbability (theta : ℝ) : NNReal :=
  ((1 + proposition36aClip theta) / 2).toNNReal

/-- The finite binary parameter is a valid Bernoulli probability. -/
theorem proposition36aProbability_le_one (theta : ℝ) : proposition36aProbability theta ≤ 1 := by
  unfold proposition36aProbability
  rcases proposition36aClip_mem theta with ⟨hlow, hhigh⟩
  rw [Real.toNNReal_le_iff_le_coe]
  norm_num
  linarith

/-- The real value of the binary law's positive-observation probability. -/
theorem coe_proposition36aProbability (theta : ℝ) :
    (proposition36aProbability theta : ℝ) = (1 + proposition36aClip theta) / 2 := by
  unfold proposition36aProbability
  apply Real.coe_toNNReal
  rcases proposition36aClip_mem theta with ⟨hlow, _⟩
  linarith

/-- The binary-law probability map is one-half Lipschitz in the ambient real metric. -/
theorem abs_sub_proposition36aProbability_le (first second : ℝ) :
    |(proposition36aProbability first : ℝ) - proposition36aProbability second| ≤
      (1 : ℝ) / 2 * dist first second := by
  rw [coe_proposition36aProbability, coe_proposition36aProbability]
  have hclip := proposition36aClip_lipschitz.dist_le_mul first second
  simp only [Real.dist_eq, NNReal.coe_one, one_mul] at hclip ⊢
  calc
    |(1 + proposition36aClip first) / 2 - (1 + proposition36aClip second) / 2| =
        (1 : ℝ) / 2 * |proposition36aClip first - proposition36aClip second| := by
      rw [show (1 + proposition36aClip first) / 2 -
          (1 + proposition36aClip second) / 2 =
          ((1 : ℝ) / 2) * (proposition36aClip first - proposition36aClip second) by ring,
        abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
    _ ≤ (1 : ℝ) / 2 * |first - second| :=
      mul_le_mul_of_nonneg_left hclip (by norm_num)

/-- The binary law with signed mean equal to the clipped deployed parameter. -/
noncomputable def proposition36aLaw (theta : ℝ) : PMF Bool :=
  PMF.bernoulli (proposition36aProbability theta) (proposition36aProbability_le_one theta)

/-- A monotone finite coupling for two ordered Proposition 3.6(a) binary laws. -/
noncomputable def proposition36aOrderedLawCoupling (first second : ℝ)
    (hordered : proposition36aProbability first ≤ proposition36aProbability second) :
    FiniteCoupling (proposition36aLaw first) (proposition36aLaw second) :=
  FiniteCoupling.monotoneBernoulliCoupling (proposition36aProbability first)
    (proposition36aProbability second) hordered
    (proposition36aProbability_le_one first) (proposition36aProbability_le_one second)

/-- The ordered binary coupling has cost equal to its probability difference. -/
theorem expectedCost_proposition36aOrderedLawCoupling (first second : ℝ)
    (hordered : proposition36aProbability first ≤ proposition36aProbability second) :
    (proposition36aOrderedLawCoupling first second hordered).expectedCost
      (fun left right => dist left right) =
        (proposition36aProbability second : ℝ) - proposition36aProbability first := by
  have hcost : (fun left right : Bool => dist left right) =
      fun left right => if left = right then (0 : ℝ) else 1 := by
    funext left right
    fin_cases left <;> fin_cases right <;> norm_num [proposition42Bool_dist]
  rw [hcost]
  exact FiniteCoupling.expectedCost_monotoneBernoulliCoupling _ _ hordered
    (proposition36aProbability_le_one first) (proposition36aProbability_le_one second)

/-- The source's linear loss, with `true` representing the signed datum `1`. -/
noncomputable def proposition36aLoss (datum : Bool) (theta : ℝ) : ℝ :=
  if datum then theta else -theta

/-- A total finite-PMF version of the Proposition 3.6(a) counterexample. -/
noncomputable def proposition36aModel : FinitePerformativeModel ℝ Bool where
  dataLaw := proposition36aLaw
  loss := proposition36aLoss

/-- The pointwise gradient of the source's linear loss. -/
noncomputable def proposition36aGradient (datum : Bool) (_theta : ℝ) : ℝ :=
  if datum then 1 else -1

/-- The frozen risk in the finite Proposition 3.6(a) model is bilinear. -/
theorem proposition36a_decoupledPerformativeRisk_eq (deployed candidate : ℝ) :
    decoupledPerformativeRisk proposition36aModel deployed candidate =
      proposition36aClip deployed * candidate := by
  unfold decoupledPerformativeRisk pmfExp proposition36aModel proposition36aLaw proposition36aLoss
  simp [PMF.bernoulli_apply, coe_proposition36aProbability,
    proposition36aProbability_le_one]
  ring

/-- The source parameter domain for the finite Proposition 3.6(a) specialization. -/
abbrev proposition36aDomain : Set ℝ := Set.Icc (-1) 1

/-- A valid best-response selection for the frozen linear risks. -/
noncomputable def proposition36aRRMUpdate (theta : ℝ) : ℝ :=
  if theta < 0 then 1 else -1

/-- The selected update is repeated risk minimization on the source domain. -/
theorem proposition36a_isRepeatedRiskMinimization :
    IsRepeatedRiskMinimizationOn proposition36aModel proposition36aDomain proposition36aRRMUpdate := by
  intro deployed hdeployed
  constructor
  · unfold proposition36aRRMUpdate
    split <;> constructor <;> norm_num
  · intro candidate hcandidate
    change decoupledPerformativeRisk proposition36aModel deployed
        (proposition36aRRMUpdate deployed) ≤
      decoupledPerformativeRisk proposition36aModel deployed candidate
    rw [proposition36a_decoupledPerformativeRisk_eq,
      proposition36a_decoupledPerformativeRisk_eq,
      proposition36aClip_eq_self hdeployed]
    rcases hcandidate with ⟨hcandidateLow, hcandidateHigh⟩
    unfold proposition36aRRMUpdate
    split
    · exact mul_le_mul_of_nonpos_left hcandidateHigh (le_of_lt ‹deployed < 0›)
    · exact mul_le_mul_of_nonneg_left hcandidateLow (le_of_not_gt ‹¬ deployed < 0›)

/-- The selected update exchanges the two source-domain endpoints. -/
theorem proposition36aRRMUpdate_endpoint_cycle :
    proposition36aRRMUpdate 1 = -1 ∧ proposition36aRRMUpdate (-1) = 1 := by
  simp [proposition36aRRMUpdate]

/-- Two repeated-risk-minimization steps return the positive endpoint to itself. -/
theorem proposition36aRRMUpdate_iterate_two :
    proposition36aRRMUpdate^[2] 1 = 1 := by
  norm_num [Function.iterate_succ_apply', proposition36aRRMUpdate]

/-- The even iterates of the selected RRM update remain at the positive endpoint. -/
theorem proposition36aRRMUpdate_iterate_even (iteration : ℕ) :
    proposition36aRRMUpdate^[2 * iteration] 1 = 1 := by
  rw [Function.iterate_mul]
  exact Function.iterate_fixed proposition36aRRMUpdate_iterate_two iteration

/-- The odd iterates of the selected RRM update remain at the negative endpoint. -/
theorem proposition36aRRMUpdate_iterate_odd (iteration : ℕ) :
    proposition36aRRMUpdate^[2 * iteration + 1] 1 = -1 := by
  rw [show 2 * iteration + 1 = (2 * iteration).succ by omega,
    Function.iterate_succ_apply', proposition36aRRMUpdate_iterate_even]
  norm_num [proposition36aRRMUpdate]

/--
Starting from `1`, the selected RRM trajectory in the finite Proposition 3.6(a)
specialization does not converge.
-/
theorem proposition36aRRMUpdate_not_tendsto_from_one :
    ¬ ∃ limit : ℝ, Filter.Tendsto
      (fun iteration => proposition36aRRMUpdate^[iteration] 1) Filter.atTop (nhds limit) := by
  rintro ⟨limit, hlimit⟩
  rcases (Metric.cauchySeq_iff.mp hlimit.cauchySeq) 1 zero_lt_one with ⟨threshold, htail⟩
  have hdistance := htail (2 * threshold) (by omega) (2 * threshold + 1) (by omega)
  rw [proposition36aRRMUpdate_iterate_even, proposition36aRRMUpdate_iterate_odd] at hdistance
  norm_num [Real.dist_eq] at hdistance

/-- The scalar RRM recurrence calculated in the proof of Proposition 3.6(c). -/
noncomputable def proposition36cRRMUpdate (epsilon theta : ℝ) : ℝ :=
  1 + epsilon * theta

/--
The real-valued point-mass law used in Proposition 3.6(c): after deploying
`theta`, the source outcome is deterministically `1 + epsilon * theta`.
-/
noncomputable def proposition36cMeasureLaw (epsilon theta : ℝ) : ProbabilityMeasure ℝ :=
  diracProba (1 + epsilon * theta)

/-- The squared loss used in Proposition 3.6(c). -/
noncomputable def proposition36cLoss (datum candidate : ℝ) : ℝ :=
  (datum - candidate) ^ 2

/-- The parameter gradient of the Proposition 3.6(c) squared loss. -/
noncomputable def proposition36cGradient (datum candidate : ℝ) : ℝ :=
  2 * (candidate - datum)

/-- Exact second-order expansion of the Proposition 3.6(c) squared loss. -/
theorem proposition36cLoss_quadraticExpansion
    (datum center candidate : ℝ) :
    proposition36cLoss datum candidate = proposition36cLoss datum center +
      proposition36cGradient datum center * (candidate - center) + (candidate - center) ^ 2 := by
  simp [proposition36cLoss, proposition36cGradient]
  ring

/-- The displayed Proposition 3.6(c) gradient is the actual derivative of its loss. -/
theorem hasGradientAt_proposition36cLoss (datum candidate : ℝ) :
    HasGradientAt (fun parameter => proposition36cLoss datum parameter)
      (proposition36cGradient datum candidate) candidate := by
  have hderiv := (((hasDerivAt_id candidate).sub_const datum).pow 2).hasGradientAt'
  convert hderiv using 1
  · funext parameter
    simp [proposition36cLoss]
    ring
  · simp [proposition36cGradient]

/-- The standard real inner product is multiplication, recorded for the scalar example. -/
theorem proposition36c_real_inner_eq_mul (first second : ℝ) :
    ⟪first, second⟫_ℝ = first * second := by
  change RCLike.re (inner ℝ first second) = first * second
  change RCLike.re (second * star first) = first * second
  simp [mul_comm]

/--
The source's real-data Proposition 3.6(c) model, represented without a
finite-PMF surrogate.  Its integrability follows directly from the Dirac law.
-/
noncomputable def proposition36cMeasureModel (epsilon : ℝ) : MeasurePerformativeModel ℝ ℝ where
  dataLaw := proposition36cMeasureLaw epsilon
  loss := proposition36cLoss
  loss_integrable := by
    intro distributionParameter evaluatedParameter
    exact integrable_dirac (by finiteness)

/-- The Proposition 3.6(c) gradient is integrable under every induced Dirac law. -/
theorem proposition36cGradient_integrable
    (epsilon distributionParameter evaluatedParameter : ℝ) :
    Integrable (fun datum => proposition36cGradient datum evaluatedParameter)
      ((proposition36cMeasureModel epsilon).dataLaw distributionParameter : Measure ℝ) := by
  change Integrable (fun datum => 2 * (evaluatedParameter - datum))
    (Measure.dirac (1 + epsilon * distributionParameter))
  apply integrable_dirac
  exact ENNReal.coe_ne_top.lt_top

/-- The exact frozen squared risk of the Proposition 3.6(c) point-mass model. -/
theorem proposition36c_measureDecoupledPerformativeRisk_eq
    (epsilon deployed candidate : ℝ) :
    measureDecoupledPerformativeRisk (proposition36cMeasureModel epsilon) deployed candidate =
      (1 + epsilon * deployed - candidate) ^ 2 := by
  change (∫ datum : ℝ, (datum - candidate) ^ 2 ∂Measure.dirac (1 + epsilon * deployed)) =
    (1 + epsilon * deployed - candidate) ^ 2
  rw [integral_dirac]

/--
For every frozen deployed parameter, `1 + epsilon * deployed` is the unique
minimizer of the Proposition 3.6(c) squared risk on the real line.
-/
theorem proposition36c_measureUniqueFrozenMinimizer
    (epsilon deployed candidate : ℝ) :
    measureDecoupledPerformativeRisk (proposition36cMeasureModel epsilon) deployed
        (proposition36cRRMUpdate epsilon deployed) ≤
      measureDecoupledPerformativeRisk (proposition36cMeasureModel epsilon) deployed candidate ∧
      (measureDecoupledPerformativeRisk (proposition36cMeasureModel epsilon) deployed candidate =
        measureDecoupledPerformativeRisk (proposition36cMeasureModel epsilon) deployed
          (proposition36cRRMUpdate epsilon deployed) →
        candidate = proposition36cRRMUpdate epsilon deployed) := by
  rw [proposition36c_measureDecoupledPerformativeRisk_eq,
    proposition36c_measureDecoupledPerformativeRisk_eq]
  constructor
  · simpa [proposition36cRRMUpdate] using
      (sq_nonneg (1 + epsilon * deployed - candidate))
  · intro hequality
    simp [proposition36cRRMUpdate] at hequality
    unfold proposition36cRRMUpdate
    linarith

/-- The source recurrence is an exact selected RRM update for its real-data model. -/
theorem proposition36c_isMeasureRepeatedRiskMinimization (epsilon : ℝ) :
    IsMeasureRepeatedRiskMinimization (proposition36cMeasureModel epsilon)
      (proposition36cRRMUpdate epsilon) := by
  intro deployed candidate
  exact (proposition36c_measureUniqueFrozenMinimizer epsilon deployed candidate).1

/--
The scaled squared loss used to expose Proposition 3.6(c)'s feasible
regularity-constant family.  A scalar `gamma / 2` gives strong-convexity and
gradient-smoothness constant `gamma` while preserving the source RRM map.
-/
noncomputable def proposition36cScaledLoss (gamma datum candidate : ℝ) : ℝ :=
  (gamma / 2) * (datum - candidate) ^ 2

/-- The actual parameter gradient of `proposition36cScaledLoss`. -/
noncomputable def proposition36cScaledGradient (gamma datum candidate : ℝ) : ℝ :=
  gamma * (candidate - datum)

/-- The real Dirac model with the scaled Proposition 3.6(c) loss. -/
noncomputable def proposition36cScaledMeasureModel
    (epsilon gamma : ℝ) : MeasurePerformativeModel ℝ ℝ where
  dataLaw := proposition36cMeasureLaw epsilon
  loss := proposition36cScaledLoss gamma
  loss_integrable := by
    intro distributionParameter evaluatedParameter
    exact integrable_dirac (by finiteness)

/-- The scaled loss has its displayed scaled gradient. -/
theorem hasGradientAt_proposition36cScaledLoss (gamma datum candidate : ℝ) :
    HasGradientAt (fun parameter => proposition36cScaledLoss gamma datum parameter)
      (proposition36cScaledGradient gamma datum candidate) candidate := by
  have hderiv := (hasGradientAt_proposition36cLoss datum candidate).const_smul (gamma / 2)
  change HasFDerivAtFilter
    (fun parameter => proposition36cScaledLoss gamma datum parameter)
    ((InnerProductSpace.toDual ℝ ℝ)
      (proposition36cScaledGradient gamma datum candidate))
    (nhds candidate ×ˢ pure candidate)
  convert hderiv using 1
  ext
  change ⟪proposition36cScaledGradient gamma datum candidate, (1 : ℝ)⟫_ℝ =
    (gamma / 2) * ⟪proposition36cGradient datum candidate, (1 : ℝ)⟫_ℝ
  rw [proposition36c_real_inner_eq_mul, proposition36c_real_inner_eq_mul]
  simp [proposition36cScaledGradient, proposition36cGradient]
  ring

/-- The scaled gradient is integrable under every induced Dirac law. -/
theorem proposition36cScaledGradient_integrable
    (epsilon gamma distributionParameter evaluatedParameter : ℝ) :
    Integrable (fun datum => proposition36cScaledGradient gamma datum evaluatedParameter)
      ((proposition36cScaledMeasureModel epsilon gamma).dataLaw distributionParameter : Measure ℝ) := by
  change Integrable (fun datum => gamma * (evaluatedParameter - datum))
    (Measure.dirac (1 + epsilon * distributionParameter))
  apply integrable_dirac
  exact ENNReal.coe_ne_top.lt_top

/-- The exact frozen risk of the scaled real Dirac construction. -/
theorem proposition36cScaled_measureDecoupledPerformativeRisk_eq
    (epsilon gamma deployed candidate : ℝ) :
    measureDecoupledPerformativeRisk (proposition36cScaledMeasureModel epsilon gamma)
        deployed candidate =
      (gamma / 2) * (1 + epsilon * deployed - candidate) ^ 2 := by
  change (∫ datum : ℝ, (gamma / 2) * (datum - candidate) ^ 2
    ∂Measure.dirac (1 + epsilon * deployed)) =
      (gamma / 2) * (1 + epsilon * deployed - candidate) ^ 2
  rw [integral_dirac]

/--
For positive `gamma`, the frozen scaled squared risk has the same unique
minimizer as the unscaled source construction.
-/
theorem proposition36cScaled_measureUniqueFrozenMinimizer
    {gamma : ℝ} (hgamma : 0 < gamma) (epsilon deployed candidate : ℝ) :
    measureDecoupledPerformativeRisk (proposition36cScaledMeasureModel epsilon gamma) deployed
        (proposition36cRRMUpdate epsilon deployed) ≤
      measureDecoupledPerformativeRisk (proposition36cScaledMeasureModel epsilon gamma) deployed
        candidate ∧
      (measureDecoupledPerformativeRisk (proposition36cScaledMeasureModel epsilon gamma) deployed
          candidate =
        measureDecoupledPerformativeRisk (proposition36cScaledMeasureModel epsilon gamma) deployed
          (proposition36cRRMUpdate epsilon deployed) →
        candidate = proposition36cRRMUpdate epsilon deployed) := by
  rw [proposition36cScaled_measureDecoupledPerformativeRisk_eq,
    proposition36cScaled_measureDecoupledPerformativeRisk_eq]
  constructor
  · have hnonneg : 0 ≤ (gamma / 2) * (1 + epsilon * deployed - candidate) ^ 2 :=
      mul_nonneg (by linarith) (sq_nonneg _)
    simpa [proposition36cRRMUpdate] using hnonneg
  · intro hequality
    have hfactor_ne : gamma / 2 ≠ 0 := by linarith
    have hsq : (1 + epsilon * deployed - candidate) ^ 2 = 0 := by
      apply (mul_eq_zero.mp ?_).resolve_left hfactor_ne
      simpa [proposition36cRRMUpdate] using hequality
    have hzero : 1 + epsilon * deployed - candidate = 0 := sq_eq_zero_iff.mp hsq
    unfold proposition36cRRMUpdate
    linarith

/-- The source recurrence remains an exact RRM update after positive scaling. -/
theorem proposition36cScaled_isMeasureRepeatedRiskMinimization
    {gamma : ℝ} (hgamma : 0 < gamma) (epsilon : ℝ) :
    IsMeasureRepeatedRiskMinimization (proposition36cScaledMeasureModel epsilon gamma)
      (proposition36cRRMUpdate epsilon) := by
  intro deployed candidate
  exact (proposition36cScaled_measureUniqueFrozenMinimizer hgamma epsilon deployed candidate).1

/--
The quadratic-linear loss that realizes arbitrary compatible regularity
constants in Proposition 3.6(c).  Its parameter curvature is `gamma`, while
its dependence on the datum has coefficient `beta`.
-/
noncomputable def proposition36cRegularityLoss
    (beta gamma datum candidate : ℝ) : ℝ :=
  (gamma / 2) * candidate ^ 2 - beta * datum * candidate

/-- The actual parameter gradient of `proposition36cRegularityLoss`. -/
noncomputable def proposition36cRegularityGradient
    (beta gamma datum candidate : ℝ) : ℝ :=
  gamma * candidate - beta * datum

/--
The Proposition 3.6(c) Dirac law equipped with the quadratic-linear loss.
The induced data law remains exactly `delta_(1 + epsilon * theta)`.
-/
noncomputable def proposition36cRegularityMeasureModel
    (epsilon beta gamma : ℝ) : MeasurePerformativeModel ℝ ℝ where
  dataLaw := proposition36cMeasureLaw epsilon
  loss := proposition36cRegularityLoss beta gamma
  loss_integrable := by
    intro distributionParameter evaluatedParameter
    exact integrable_dirac (by finiteness)

/-- The selected frozen-risk minimizer for the quadratic-linear construction. -/
noncomputable def proposition36cRegularityRRMUpdate
    (epsilon beta gamma theta : ℝ) : ℝ :=
  (beta / gamma) * (1 + epsilon * theta)

/-- The quadratic-linear loss has its displayed parameter gradient. -/
theorem hasGradientAt_proposition36cRegularityLoss
    (beta gamma datum candidate : ℝ) :
    HasGradientAt (fun parameter =>
      proposition36cRegularityLoss beta gamma datum parameter)
      (proposition36cRegularityGradient beta gamma datum candidate) candidate := by
  have hderiv :=
    ((((hasDerivAt_id candidate).pow 2).const_mul (gamma / 2)).sub
      ((hasDerivAt_id candidate).const_mul (beta * datum))).hasGradientAt'
  convert hderiv using 1 <;>
    simp [proposition36cRegularityLoss, proposition36cRegularityGradient] <;> ring

/-- The quadratic-linear gradient is integrable under every induced Dirac law. -/
theorem proposition36cRegularityGradient_integrable
    (epsilon beta gamma distributionParameter evaluatedParameter : ℝ) :
    Integrable (fun datum =>
      proposition36cRegularityGradient beta gamma datum evaluatedParameter)
      ((proposition36cRegularityMeasureModel epsilon beta gamma).dataLaw
        distributionParameter : Measure ℝ) := by
  change Integrable (fun datum => gamma * evaluatedParameter - beta * datum)
    (Measure.dirac (1 + epsilon * distributionParameter))
  apply integrable_dirac
  exact ENNReal.coe_ne_top.lt_top

/-- The exact frozen risk of the quadratic-linear Dirac construction. -/
theorem proposition36cRegularity_measureDecoupledPerformativeRisk_eq
    (epsilon beta gamma deployed candidate : ℝ) :
    measureDecoupledPerformativeRisk
        (proposition36cRegularityMeasureModel epsilon beta gamma) deployed candidate =
      (gamma / 2) * candidate ^ 2 -
        beta * (1 + epsilon * deployed) * candidate := by
  change (∫ datum : ℝ, (gamma / 2) * candidate ^ 2 - beta * datum * candidate
    ∂Measure.dirac (1 + epsilon * deployed)) =
      (gamma / 2) * candidate ^ 2 - beta * (1 + epsilon * deployed) * candidate
  rw [integral_dirac]

/--
For positive `gamma`, the selected update is the unique minimizer of every
frozen quadratic-linear risk.
-/
theorem proposition36cRegularity_measureUniqueFrozenMinimizer
    {gamma : ℝ} (hgamma : 0 < gamma) (epsilon beta deployed candidate : ℝ) :
    measureDecoupledPerformativeRisk
        (proposition36cRegularityMeasureModel epsilon beta gamma) deployed
        (proposition36cRegularityRRMUpdate epsilon beta gamma deployed) ≤
      measureDecoupledPerformativeRisk
        (proposition36cRegularityMeasureModel epsilon beta gamma) deployed candidate ∧
      (measureDecoupledPerformativeRisk
          (proposition36cRegularityMeasureModel epsilon beta gamma) deployed candidate =
        measureDecoupledPerformativeRisk
          (proposition36cRegularityMeasureModel epsilon beta gamma) deployed
          (proposition36cRegularityRRMUpdate epsilon beta gamma deployed) →
        candidate = proposition36cRegularityRRMUpdate epsilon beta gamma deployed) := by
  rw [proposition36cRegularity_measureDecoupledPerformativeRisk_eq,
    proposition36cRegularity_measureDecoupledPerformativeRisk_eq]
  have hgamma_ne : gamma ≠ 0 := ne_of_gt hgamma
  have hidentity :
      (gamma / 2) * candidate ^ 2 - beta * (1 + epsilon * deployed) * candidate =
        (gamma / 2) *
            (proposition36cRegularityRRMUpdate epsilon beta gamma deployed) ^ 2 -
          beta * (1 + epsilon * deployed) *
            proposition36cRegularityRRMUpdate epsilon beta gamma deployed +
          (gamma / 2) *
            (candidate - proposition36cRegularityRRMUpdate epsilon beta gamma deployed) ^ 2 := by
    unfold proposition36cRegularityRRMUpdate
    field_simp [hgamma_ne]
    ring
  constructor
  · rw [hidentity]
    exact le_add_of_nonneg_right (mul_nonneg (by linarith) (sq_nonneg _))
  · intro hequality
    rw [hidentity] at hequality
    have hfactor_ne : gamma / 2 ≠ 0 := by linarith
    have hsq :
        (candidate - proposition36cRegularityRRMUpdate epsilon beta gamma deployed) ^ 2 = 0 := by
      apply (mul_eq_zero.mp ?_).resolve_left hfactor_ne
      linarith
    exact sub_eq_zero.mp (sq_eq_zero_iff.mp hsq)

/-- The selected quadratic-linear minimizer is an exact RRM update. -/
theorem proposition36cRegularity_isMeasureRepeatedRiskMinimization
    {gamma : ℝ} (hgamma : 0 < gamma) (epsilon beta : ℝ) :
    IsMeasureRepeatedRiskMinimization
      (proposition36cRegularityMeasureModel epsilon beta gamma)
      (proposition36cRegularityRRMUpdate epsilon beta gamma) := by
  intro deployed candidate
  exact
    (proposition36cRegularity_measureUniqueFrozenMinimizer
      hgamma epsilon beta deployed candidate).1

/--
The real-valued point-mass law in Proposition 3.6(a): the outcome is
deterministically `epsilon * theta` after deployment at `theta`.
-/
noncomputable def proposition36aMeasureLaw (epsilon theta : ℝ) : ProbabilityMeasure ℝ :=
  diracProba (epsilon * theta)

/-- The source's `beta * y * theta` linear loss from Proposition 3.6(a). -/
noncomputable def proposition36aMeasureLoss (beta datum candidate : ℝ) : ℝ :=
  beta * datum * candidate

/-- The parameter gradient of the exact Proposition 3.6(a) linear loss. -/
noncomputable def proposition36aMeasureGradient (beta datum _candidate : ℝ) : ℝ :=
  beta * datum

/--
The real point-mass form of Proposition 3.6(a), distinct from the earlier
finite signed-Bernoulli specialization.  Integrability is immediate under the
deterministic induced law.
-/
noncomputable def proposition36aMeasureModel (epsilon beta : ℝ) :
    MeasurePerformativeModel ℝ ℝ where
  dataLaw := proposition36aMeasureLaw epsilon
  loss := proposition36aMeasureLoss beta
  loss_integrable := by
    intro distributionParameter evaluatedParameter
    exact integrable_dirac (by finiteness)

/-- The exact Proposition 3.6(a) gradient is integrable under every induced Dirac law. -/
theorem proposition36aMeasureGradient_integrable
    (epsilon beta distributionParameter evaluatedParameter : ℝ) :
    Integrable (fun datum => proposition36aMeasureGradient beta datum evaluatedParameter)
      ((proposition36aMeasureModel epsilon beta).dataLaw distributionParameter : Measure ℝ) := by
  change Integrable (fun datum => beta * datum)
    (Measure.dirac (epsilon * distributionParameter))
  exact integrable_dirac (by finiteness)

/-- The frozen risk in the exact Proposition 3.6(a) model is `beta * epsilon * theta * phi`. -/
theorem proposition36a_measureDecoupledPerformativeRisk_eq
    (epsilon beta deployed candidate : ℝ) :
    measureDecoupledPerformativeRisk (proposition36aMeasureModel epsilon beta) deployed candidate =
      beta * epsilon * deployed * candidate := by
  change (∫ datum : ℝ, beta * datum * candidate ∂Measure.dirac (epsilon * deployed)) =
    beta * epsilon * deployed * candidate
  rw [integral_dirac]
  ring

/-- The displayed Proposition 3.6(a) gradient is the actual derivative of its linear loss. -/
theorem hasGradientAt_proposition36aMeasureLoss (beta datum candidate : ℝ) :
    HasGradientAt (fun parameter => proposition36aMeasureLoss beta datum parameter)
      (proposition36aMeasureGradient beta datum candidate) candidate := by
  simpa [proposition36aMeasureLoss, proposition36aMeasureGradient, mul_assoc] using
    ((hasDerivAt_id candidate).const_mul (beta * datum)).hasGradientAt'

/-- The exact Proposition 3.6(a) linear loss is convex in its evaluated parameter. -/
theorem proposition36aMeasureLoss_convexOn (beta datum : ℝ) :
    ConvexOn ℝ Set.univ (fun candidate => proposition36aMeasureLoss beta datum candidate) := by
  refine ⟨convex_univ, ?_⟩
  intro first _ second _ firstWeight secondWeight _ _ hweights
  simp only [smul_eq_mul]
  apply le_of_eq
  simp [proposition36aMeasureLoss]
  ring

/--
For positive `epsilon` and `beta`, the source's endpoint selector is repeated
risk minimization for the exact real point-mass model on `[-1, 1]`.
-/
theorem proposition36a_isMeasureRepeatedRiskMinimizationOn
    {epsilon beta : ℝ} (hepsilon : 0 < epsilon) (hbeta : 0 < beta) :
    IsMeasureRepeatedRiskMinimizationOn (proposition36aMeasureModel epsilon beta)
      proposition36aDomain proposition36aRRMUpdate := by
  intro deployed hdeployed
  constructor
  · unfold proposition36aRRMUpdate
    split <;> constructor <;> norm_num
  · intro candidate hcandidate
    rw [proposition36a_measureDecoupledPerformativeRisk_eq,
      proposition36a_measureDecoupledPerformativeRisk_eq]
    unfold proposition36aRRMUpdate
    split
    · have hcoefficient : beta * epsilon * deployed ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (mul_nonneg hbeta.le hepsilon.le) (le_of_lt ‹deployed < 0›)
      simpa [mul_assoc] using mul_le_mul_of_nonpos_left hcandidate.2 hcoefficient
    · have hcoefficient : 0 ≤ beta * epsilon * deployed :=
        mul_nonneg (mul_nonneg hbeta.le hepsilon.le) (le_of_not_gt ‹¬ deployed < 0›)
      simpa [mul_assoc] using mul_le_mul_of_nonneg_left hcandidate.1 hcoefficient

/-- The exact real Proposition 3.6(a) model has the unique stable point `0` on its source domain. -/
theorem proposition36a_isMeasurePerformativelyStableOn_iff
    {epsilon beta : ℝ} (hepsilon : 0 < epsilon) (hbeta : 0 < beta) (parameter : ℝ) :
    IsMeasurePerformativelyStableOn (proposition36aMeasureModel epsilon beta)
      proposition36aDomain parameter ↔ parameter = 0 := by
  constructor
  · rintro ⟨hparameter, hminimizes⟩
    have hlow := hminimizes (-1) (by norm_num : (-1 : ℝ) ∈ proposition36aDomain)
    have hhigh := hminimizes 1 (by norm_num : (1 : ℝ) ∈ proposition36aDomain)
    rw [proposition36a_measureDecoupledPerformativeRisk_eq,
      proposition36a_measureDecoupledPerformativeRisk_eq] at hlow hhigh
    have hcoefficient : 0 < beta * epsilon := mul_pos hbeta hepsilon
    have hsquare : 0 ≤ parameter ^ 2 := sq_nonneg parameter
    nlinarith
  · rintro rfl
    constructor
    · norm_num
    · intro candidate _
      rw [proposition36a_measureDecoupledPerformativeRisk_eq,
        proposition36a_measureDecoupledPerformativeRisk_eq]
      norm_num

/--
The exact real Proposition 3.6(a) RRM model inherits the selected endpoint
two-cycle, so its trajectory from `1` fails to converge.
-/
theorem proposition36aMeasureRRMUpdate_not_tendsto_from_one
    : ¬ ∃ limit : ℝ, Filter.Tendsto
      (fun iteration => proposition36aRRMUpdate^[iteration] 1) Filter.atTop (nhds limit) :=
  proposition36aRRMUpdate_not_tendsto_from_one

/-- A fixed point of the scalar recurrence, whenever the sensitivity is not one. -/
noncomputable def proposition36cStablePoint (epsilon : ℝ) : ℝ :=
  1 / (1 - epsilon)

/-- The source's scalar RRM map expands every pairwise distance by `|epsilon|`. -/
theorem proposition36cRRMUpdate_dist (epsilon first second : ℝ) :
    dist (proposition36cRRMUpdate epsilon first) (proposition36cRRMUpdate epsilon second) =
      |epsilon| * dist first second := by
  rw [Real.dist_eq, Real.dist_eq, show proposition36cRRMUpdate epsilon first -
      proposition36cRRMUpdate epsilon second = epsilon * (first - second) by
      simp [proposition36cRRMUpdate]
      ring, abs_mul]

/-- At sensitivity one, the scalar squared-loss RRM recurrence has no fixed point. -/
theorem proposition36cRRMUpdate_one_no_fixed (theta : ℝ) :
    proposition36cRRMUpdate 1 theta ≠ theta := by
  norm_num [proposition36cRRMUpdate]

/-- The displayed stable point is a fixed point when `epsilon ≠ 1`. -/
theorem proposition36cStablePoint_isFixed {epsilon : ℝ} (hepsilon : epsilon ≠ 1) :
    proposition36cRRMUpdate epsilon (proposition36cStablePoint epsilon) =
      proposition36cStablePoint epsilon := by
  unfold proposition36cRRMUpdate proposition36cStablePoint
  have hdenom : 1 - epsilon ≠ 0 := sub_ne_zero.mpr hepsilon.symm
  field_simp [hdenom]
  ring

/-- The iterate displacement from any fixed point has the exact geometric form. -/
theorem proposition36cRRMUpdate_iterate_sub_fixed (epsilon theta stable : ℝ)
    (hstable : proposition36cRRMUpdate epsilon stable = stable) (iteration : ℕ) :
    (proposition36cRRMUpdate epsilon)^[iteration] theta - stable =
      epsilon ^ iteration * (theta - stable) := by
  induction iteration with
  | zero => simp
  | succ iteration ih =>
      rw [Function.iterate_succ_apply']
      calc
        proposition36cRRMUpdate epsilon ((proposition36cRRMUpdate epsilon)^[iteration] theta) -
            stable = proposition36cRRMUpdate epsilon
              ((proposition36cRRMUpdate epsilon)^[iteration] theta) -
                proposition36cRRMUpdate epsilon stable := by rw [hstable]
        _ = epsilon * ((proposition36cRRMUpdate epsilon)^[iteration] theta - stable) := by
          simp [proposition36cRRMUpdate]
          ring
        _ = epsilon ^ (Nat.succ iteration) * (theta - stable) := by
          rw [ih, pow_succ]
          ring

/-- Above the threshold `epsilon = 1`, an initial point above the fixed point diverges to `+∞`. -/
theorem proposition36cRRMUpdate_tendsto_atTop_of_gt_stable {epsilon theta : ℝ}
    (hepsilon : 1 < epsilon) (htheta : proposition36cStablePoint epsilon < theta) :
    Filter.Tendsto (fun iteration => (proposition36cRRMUpdate epsilon)^[iteration] theta)
      Filter.atTop Filter.atTop := by
  have hstable := proposition36cStablePoint_isFixed (ne_of_gt hepsilon)
  have hshift : Filter.Tendsto
      (fun iteration => (proposition36cRRMUpdate epsilon)^[iteration] theta -
        proposition36cStablePoint epsilon) Filter.atTop Filter.atTop :=
    tendsto_atTop_of_geom_le (by
      simpa using sub_pos.mpr htheta) hepsilon (fun iteration => by
      calc
        epsilon * ((proposition36cRRMUpdate epsilon)^[iteration] theta -
            proposition36cStablePoint epsilon) =
            proposition36cRRMUpdate epsilon ((proposition36cRRMUpdate epsilon)^[iteration] theta) -
              proposition36cRRMUpdate epsilon (proposition36cStablePoint epsilon) := by
            simp [proposition36cRRMUpdate]
            ring
        _ = proposition36cRRMUpdate epsilon ((proposition36cRRMUpdate epsilon)^[iteration] theta) -
              proposition36cStablePoint epsilon := by rw [hstable]
        _ ≤ (proposition36cRRMUpdate epsilon)^[iteration + 1] theta -
              proposition36cStablePoint epsilon := by
              rw [Function.iterate_succ_apply'])
  have hrecompose : (fun iteration => (proposition36cRRMUpdate epsilon)^[iteration] theta) =
      fun iteration => ((proposition36cRRMUpdate epsilon)^[iteration] theta -
        proposition36cStablePoint epsilon) + proposition36cStablePoint epsilon := by
    funext iteration
    ring
  rw [hrecompose]
  refine Filter.tendsto_atTop.2 fun bound => ?_
  have hboundEventually : ∀ᶠ iteration in Filter.atTop,
      bound - proposition36cStablePoint epsilon ≤
        (proposition36cRRMUpdate epsilon)^[iteration] theta -
          proposition36cStablePoint epsilon :=
    (Filter.tendsto_atTop.1 hshift) (bound - proposition36cStablePoint epsilon)
  filter_upwards [hboundEventually] with iteration hiteration
  linarith

/-- Above the threshold `epsilon = 1`, an initial point below the fixed point diverges to `-∞`. -/
theorem proposition36cRRMUpdate_tendsto_atBot_of_lt_stable {epsilon theta : ℝ}
    (hepsilon : 1 < epsilon) (htheta : theta < proposition36cStablePoint epsilon) :
    Filter.Tendsto (fun iteration => (proposition36cRRMUpdate epsilon)^[iteration] theta)
      Filter.atTop Filter.atBot := by
  have hstable := proposition36cStablePoint_isFixed (ne_of_gt hepsilon)
  have hshift : Filter.Tendsto
      (fun iteration => proposition36cStablePoint epsilon -
        (proposition36cRRMUpdate epsilon)^[iteration] theta) Filter.atTop Filter.atTop :=
    tendsto_atTop_of_geom_le (by
      simpa using sub_pos.mpr htheta) hepsilon (fun iteration => by
      calc
        epsilon * (proposition36cStablePoint epsilon -
            (proposition36cRRMUpdate epsilon)^[iteration] theta) =
            proposition36cRRMUpdate epsilon (proposition36cStablePoint epsilon) -
              proposition36cRRMUpdate epsilon ((proposition36cRRMUpdate epsilon)^[iteration] theta) := by
            simp [proposition36cRRMUpdate]
            ring
        _ = proposition36cStablePoint epsilon -
              proposition36cRRMUpdate epsilon ((proposition36cRRMUpdate epsilon)^[iteration] theta) := by
              rw [hstable]
        _ ≤ proposition36cStablePoint epsilon -
              (proposition36cRRMUpdate epsilon)^[iteration + 1] theta := by
              rw [Function.iterate_succ_apply'])
  refine Filter.tendsto_atBot.2 fun bound => ?_
  have hboundEventually : ∀ᶠ iteration in Filter.atTop,
      proposition36cStablePoint epsilon - bound ≤
        proposition36cStablePoint epsilon -
          (proposition36cRRMUpdate epsilon)^[iteration] theta :=
    (Filter.tendsto_atTop.1 hshift) (proposition36cStablePoint epsilon - bound)
  filter_upwards [hboundEventually] with iteration hiteration
  linarith

/-- The affine expansion factor of the quadratic-linear Proposition 3.6(c) update. -/
noncomputable def proposition36cRegularityRRMFactor
    (epsilon beta gamma : ℝ) : ℝ :=
  beta * epsilon / gamma

/-- The fixed point of the quadratic-linear update when its factor is not one. -/
noncomputable def proposition36cRegularityStablePoint
    (epsilon beta gamma : ℝ) : ℝ :=
  beta / (gamma - beta * epsilon)

/-- Away from factor one, the displayed affine stable point is fixed. -/
theorem proposition36cRegularityStablePoint_isFixed
    {epsilon beta gamma : ℝ} (hgamma : gamma ≠ 0)
    (hfactor : proposition36cRegularityRRMFactor epsilon beta gamma ≠ 1) :
    proposition36cRegularityRRMUpdate epsilon beta gamma
        (proposition36cRegularityStablePoint epsilon beta gamma) =
      proposition36cRegularityStablePoint epsilon beta gamma := by
  have hdenom : gamma - beta * epsilon ≠ 0 := by
    intro hzero
    apply hfactor
    unfold proposition36cRegularityRRMFactor
    field_simp [hgamma]
    linarith
  unfold proposition36cRegularityRRMUpdate proposition36cRegularityStablePoint
  field_simp [hgamma, hdenom]
  ring

/-- Displacement from a fixed point follows the exact affine geometric recurrence. -/
theorem proposition36cRegularityRRMUpdate_iterate_sub_fixed
    (epsilon beta gamma theta stable : ℝ)
    (hstable : proposition36cRegularityRRMUpdate epsilon beta gamma stable = stable)
    (iteration : ℕ) :
    (proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] theta - stable =
      proposition36cRegularityRRMFactor epsilon beta gamma ^ iteration * (theta - stable) := by
  induction iteration with
  | zero => simp
  | succ iteration ih =>
      rw [Function.iterate_succ_apply']
      calc
        proposition36cRegularityRRMUpdate epsilon beta gamma
              ((proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] theta) -
            stable =
            proposition36cRegularityRRMUpdate epsilon beta gamma
                ((proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] theta) -
              proposition36cRegularityRRMUpdate epsilon beta gamma stable := by rw [hstable]
        _ = proposition36cRegularityRRMFactor epsilon beta gamma *
              ((proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] theta -
                stable) := by
          simp [proposition36cRegularityRRMUpdate, proposition36cRegularityRRMFactor]
          ring
        _ = proposition36cRegularityRRMFactor epsilon beta gamma ^
              (Nat.succ iteration) * (theta - stable) := by
          rw [ih, pow_succ]
          ring

/-- With affine factor above one, every point above the fixed point diverges to `+∞`. -/
theorem proposition36cRegularityRRMUpdate_tendsto_atTop_of_gt_stable
    {epsilon beta gamma theta : ℝ} (hgamma : gamma ≠ 0)
    (hfactor : 1 < proposition36cRegularityRRMFactor epsilon beta gamma)
    (htheta : proposition36cRegularityStablePoint epsilon beta gamma < theta) :
    Filter.Tendsto
      (fun iteration =>
        (proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] theta)
      Filter.atTop Filter.atTop := by
  have hstable := proposition36cRegularityStablePoint_isFixed hgamma (ne_of_gt hfactor)
  have hshift : Filter.Tendsto
      (fun iteration =>
        (proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] theta -
          proposition36cRegularityStablePoint epsilon beta gamma)
      Filter.atTop Filter.atTop :=
    tendsto_atTop_of_geom_le (by simpa using sub_pos.mpr htheta) hfactor
      (fun iteration => by
        calc
          proposition36cRegularityRRMFactor epsilon beta gamma *
                ((proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] theta -
                  proposition36cRegularityStablePoint epsilon beta gamma) =
              proposition36cRegularityRRMUpdate epsilon beta gamma
                  ((proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] theta) -
                proposition36cRegularityRRMUpdate epsilon beta gamma
                  (proposition36cRegularityStablePoint epsilon beta gamma) := by
            simp [proposition36cRegularityRRMUpdate, proposition36cRegularityRRMFactor]
            ring
          _ = proposition36cRegularityRRMUpdate epsilon beta gamma
                  ((proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] theta) -
                proposition36cRegularityStablePoint epsilon beta gamma := by rw [hstable]
          _ ≤ (proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration + 1] theta -
                proposition36cRegularityStablePoint epsilon beta gamma := by
            rw [Function.iterate_succ_apply'])
  refine Filter.tendsto_atTop.2 fun bound => ?_
  have hboundEventually : ∀ᶠ iteration in Filter.atTop,
      bound - proposition36cRegularityStablePoint epsilon beta gamma ≤
        (proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] theta -
          proposition36cRegularityStablePoint epsilon beta gamma :=
    (Filter.tendsto_atTop.1 hshift)
      (bound - proposition36cRegularityStablePoint epsilon beta gamma)
  filter_upwards [hboundEventually] with iteration hiteration
  linarith

/-- At the source boundary, the affine update adds the positive constant `beta / gamma`. -/
theorem proposition36cRegularityRRMUpdate_at_threshold
    {beta gamma : ℝ} (hbeta : beta ≠ 0) (hgamma : gamma ≠ 0) (theta : ℝ) :
    proposition36cRegularityRRMUpdate (gamma / beta) beta gamma theta =
      theta + beta / gamma := by
  unfold proposition36cRegularityRRMUpdate
  field_simp [hbeta, hgamma]
  ring

/-- The boundary recurrence is translation by `beta / gamma` at every step. -/
theorem proposition36cRegularityRRMUpdate_iterate_at_threshold
    {beta gamma : ℝ} (hbeta : beta ≠ 0) (hgamma : gamma ≠ 0)
    (initial : ℝ) (iteration : ℕ) :
    (proposition36cRegularityRRMUpdate (gamma / beta) beta gamma)^[iteration] initial =
      initial + (iteration : ℝ) * (beta / gamma) := by
  induction iteration with
  | zero => simp
  | succ iteration ih =>
      rw [Function.iterate_succ_apply', ih,
        proposition36cRegularityRRMUpdate_at_threshold hbeta hgamma]
      push_cast
      ring

/-- At equality in the source threshold, the positive translation diverges to `+∞`. -/
theorem proposition36cRegularityRRMUpdate_tendsto_atTop_at_threshold
    {beta gamma : ℝ} (hbeta : 0 < beta) (hgamma : 0 < gamma) (initial : ℝ) :
    Filter.Tendsto
      (fun iteration =>
        (proposition36cRegularityRRMUpdate (gamma / beta) beta gamma)^[iteration] initial)
      Filter.atTop Filter.atTop := by
  have hlinear : Filter.Tendsto
      (fun iteration : ℕ => (beta / gamma) * (iteration : ℝ))
      Filter.atTop Filter.atTop :=
    tendsto_natCast_atTop_atTop.const_mul_atTop (div_pos hbeta hgamma)
  have htranslated : Filter.Tendsto
      (fun iteration : ℕ => initial + (beta / gamma) * (iteration : ℝ))
      Filter.atTop Filter.atTop :=
    Filter.tendsto_atTop_add_const_left Filter.atTop initial hlinear
  simpa [proposition36cRegularityRRMUpdate_iterate_at_threshold
      (ne_of_gt hbeta) (ne_of_gt hgamma), mul_comm] using htranslated

/--
At and above the source threshold `epsilon = gamma / beta`, the selected
quadratic-linear RRM recurrence has a trajectory diverging to `+∞`.
-/
theorem proposition36cRegularityRRMUpdate_exists_tendsto_atTop
    {epsilon beta gamma : ℝ} (hbeta : 0 < beta) (hgamma : 0 < gamma)
    (hthreshold : gamma / beta ≤ epsilon) :
    ∃ initial, Filter.Tendsto
      (fun iteration =>
        (proposition36cRegularityRRMUpdate epsilon beta gamma)^[iteration] initial)
      Filter.atTop Filter.atTop := by
  rcases hthreshold.eq_or_lt with hequality | hstrict
  · subst epsilon
    exact ⟨0, proposition36cRegularityRRMUpdate_tendsto_atTop_at_threshold hbeta hgamma 0⟩
  · have hfactor : 1 < proposition36cRegularityRRMFactor epsilon beta gamma := by
      unfold proposition36cRegularityRRMFactor
      apply (lt_div_iff₀ hgamma).2
      have hcrossed : gamma < epsilon * beta := (div_lt_iff₀ hbeta).1 hstrict
      simpa [mul_comm] using hcrossed
    refine ⟨proposition36cRegularityStablePoint epsilon beta gamma + 1, ?_⟩
    exact proposition36cRegularityRRMUpdate_tendsto_atTop_of_gt_stable
      (ne_of_gt hgamma) hfactor (by linarith)

/-- The lower endpoint used in the regularized-hinge construction of Proposition 3.6(b). -/
noncomputable def proposition36bLowerEndpoint (epsilon : ℝ) : ℝ :=
  -(1 / (2 * epsilon))

/-- The closed parameter interval used by Proposition 3.6(b)'s construction. -/
def proposition36bDomain (epsilon : ℝ) : Set ℝ :=
  Set.Icc (proposition36bLowerEndpoint epsilon) 2

/--
The frozen point-mass objective in the regularized-hinge construction of
Proposition 3.6(b).  This is a scalar source-calculation model, rather than a
finite-PMF instance: the source's point mass ranges over a continuum of labels.
-/
noncomputable def proposition36bFrozenRisk
    (epsilon gamma penalty deployed candidate : ℝ) : ℝ :=
  penalty * max (-1) (epsilon * deployed * candidate) +
    gamma / 2 * (candidate - 1) ^ 2

/-- The exact real-valued deterministic outcome law in Proposition 3.6(b). -/
noncomputable def proposition36bMeasureLaw (epsilon theta : ℝ) : ProbabilityMeasure ℝ :=
  diracProba (epsilon * theta)

/-- The source regularized-hinge loss in the real-data model of Proposition 3.6(b). -/
noncomputable def proposition36bMeasureLoss
    (gamma penalty datum candidate : ℝ) : ℝ :=
  penalty * max (-1) (datum * candidate) + gamma / 2 * (candidate - 1) ^ 2

/--
The real point-mass performative model in Proposition 3.6(b), without a
finite-PMF surrogate.  The loss is integrable because every induced law is a
Dirac probability measure.
-/
noncomputable def proposition36bMeasureModel (epsilon gamma penalty : ℝ) :
    MeasurePerformativeModel ℝ ℝ where
  dataLaw := proposition36bMeasureLaw epsilon
  loss := proposition36bMeasureLoss gamma penalty
  loss_integrable := by
    intro distributionParameter evaluatedParameter
    exact integrable_dirac (by finiteness)

/-- The exact model's frozen risk is the scalar regularized-hinge formula. -/
theorem proposition36b_measureDecoupledPerformativeRisk_eq
    (epsilon gamma penalty deployed candidate : ℝ) :
    measureDecoupledPerformativeRisk (proposition36bMeasureModel epsilon gamma penalty)
      deployed candidate = proposition36bFrozenRisk epsilon gamma penalty deployed candidate := by
  change (∫ datum : ℝ,
      penalty * max (-1) (datum * candidate) + gamma / 2 * (candidate - 1) ^ 2 ∂
        Measure.dirac (epsilon * deployed)) =
    proposition36bFrozenRisk epsilon gamma penalty deployed candidate
  rw [integral_dirac]
  rfl

/-- A sufficient explicit reading of the source phrase "picking `C` big enough". -/
def IsProposition36bLargePenalty (epsilon gamma penalty : ℝ) : Prop :=
  gamma * (1 - proposition36bLowerEndpoint epsilon) ≤ 2 * penalty * epsilon ∧
    2 * gamma ≤ penalty

/-- An explicit sufficient choice for the source phrase "pick `C` big enough". -/
noncomputable def proposition36bSufficientPenalty (epsilon gamma : ℝ) : ℝ :=
  gamma * (1 / epsilon ^ 2 + 2)

/-- The explicit Proposition 3.6(b) penalty satisfies both endpoint inequalities. -/
theorem proposition36b_sufficientPenalty_large
    {epsilon gamma : ℝ} (hepsilon : 0 < epsilon) (hgamma : 0 < gamma) :
    IsProposition36bLargePenalty epsilon gamma
      (proposition36bSufficientPenalty epsilon gamma) := by
  have hepsilon_ne : epsilon ≠ 0 := ne_of_gt hepsilon
  have hdenom : 0 < 2 * epsilon := by positivity
  have hquadratic : 0 ≤ 8 * epsilon ^ 2 - 2 * epsilon + 3 := by
    nlinarith [sq_nonneg (epsilon - (1 : ℝ) / 8)]
  have hcomparison : 1 + 1 / (2 * epsilon) ≤ 2 / epsilon + 4 * epsilon := by
    have hnonneg : 0 ≤ (2 / epsilon + 4 * epsilon) -
        (1 + 1 / (2 * epsilon)) := by
      rw [show (2 / epsilon + 4 * epsilon) - (1 + 1 / (2 * epsilon)) =
          (8 * epsilon ^ 2 - 2 * epsilon + 3) / (2 * epsilon) by
        field_simp [hepsilon_ne]
        ring]
      exact div_nonneg hquadratic (le_of_lt hdenom)
    linarith
  constructor
  · calc
      gamma * (1 - proposition36bLowerEndpoint epsilon) =
          gamma * (1 + 1 / (2 * epsilon)) := by
            unfold proposition36bLowerEndpoint
            ring
      _ ≤ gamma * (2 / epsilon + 4 * epsilon) :=
        mul_le_mul_of_nonneg_left hcomparison (le_of_lt hgamma)
      _ = 2 * proposition36bSufficientPenalty epsilon gamma * epsilon := by
        unfold proposition36bSufficientPenalty
        field_simp [hepsilon_ne]
        ring
  · unfold proposition36bSufficientPenalty
    have hinv : 0 ≤ 1 / epsilon ^ 2 := by positivity
    nlinarith [mul_nonneg (le_of_lt hgamma) hinv]

/-- The maximum of a constant and a scalar affine map is convex. -/
theorem convexOn_max_const_affine (constant slope : ℝ) :
    ConvexOn ℝ Set.univ (fun candidate : ℝ => max constant (slope * candidate)) := by
  refine ⟨convex_univ, ?_⟩
  intro first _ second _ firstWeight secondWeight hfirstWeight hsecondWeight hweights
  simp only [smul_eq_mul]
  have hconstant : constant ≤
      firstWeight * max constant (slope * first) +
        secondWeight * max constant (slope * second) := by
    calc
      constant = (firstWeight + secondWeight) * constant := by
        rw [hweights]
        ring
      _ = firstWeight * constant + secondWeight * constant := by ring
      _ ≤ firstWeight * max constant (slope * first) +
          secondWeight * max constant (slope * second) := by
          exact add_le_add
            (mul_le_mul_of_nonneg_left (le_max_left _ _) hfirstWeight)
            (mul_le_mul_of_nonneg_left (le_max_left _ _) hsecondWeight)
  have haffine : slope * (firstWeight * first + secondWeight * second) ≤
      firstWeight * max constant (slope * first) +
        secondWeight * max constant (slope * second) := by
    calc
      slope * (firstWeight * first + secondWeight * second) =
          firstWeight * (slope * first) + secondWeight * (slope * second) := by ring
      _ ≤ firstWeight * max constant (slope * first) +
          secondWeight * max constant (slope * second) := by
          exact add_le_add
            (mul_le_mul_of_nonneg_left (le_max_right _ _) hfirstWeight)
            (mul_le_mul_of_nonneg_left (le_max_right _ _) hsecondWeight)
  exact max_le hconstant haffine

/--
The regularized hinge loss in Proposition 3.6(b) is `gamma`-strongly convex:
subtracting its quadratic modulus leaves a nonnegative multiple of a convex
hinge plus an affine function.
-/
theorem proposition36bFrozenRisk_strongConvex
    (epsilon gamma penalty deployed : ℝ) (hpenalty : 0 ≤ penalty) :
    StrongConvexOn Set.univ gamma
      (proposition36bFrozenRisk epsilon gamma penalty deployed) := by
  rw [strongConvexOn_iff_convex]
  have hhinge := (convexOn_max_const_affine (-1) (epsilon * deployed)).smul hpenalty
  have haffine : ConvexOn ℝ Set.univ
      (fun candidate : ℝ => gamma / 2 * (-2 * candidate + 1)) := by
    refine ⟨convex_univ, ?_⟩
    intro first _ second _ firstWeight secondWeight _ _ hweights
    simp only [smul_eq_mul]
    apply le_of_eq
    calc
      gamma / 2 * (-2 * (firstWeight * first + secondWeight * second) + 1) =
          gamma / 2 * (-2 * (firstWeight * first + secondWeight * second) +
            (firstWeight + secondWeight)) := by rw [hweights]
      _ = firstWeight * (gamma / 2 * (-2 * first + 1)) +
          secondWeight * (gamma / 2 * (-2 * second + 1)) := by ring
  have hsum := hhinge.add haffine
  convert hsum using 1
  ext candidate
  simp only [Pi.add_apply, smul_eq_mul, Real.norm_eq_abs, sq_abs]
  unfold proposition36bFrozenRisk
  ring

/--
The exact regularized-hinge loss is pointwise `gamma`-strongly convex for
every real datum when the source penalty is nonnegative.
-/
theorem proposition36bMeasureLoss_strongConvex
    (gamma penalty datum : ℝ) (hpenalty : 0 ≤ penalty) :
    StrongConvexOn Set.univ gamma
      (fun candidate => proposition36bMeasureLoss gamma penalty datum candidate) := by
  convert proposition36bFrozenRisk_strongConvex 1 gamma penalty datum hpenalty using 1
  ext candidate
  simp [proposition36bMeasureLoss, proposition36bFrozenRisk]

/-- The first frozen label makes the lower endpoint attain the hinge minimum. -/
theorem proposition36b_lowerEndpoint_hinge_at_two {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    epsilon * 2 * proposition36bLowerEndpoint epsilon = -1 := by
  unfold proposition36bLowerEndpoint
  field_simp [ne_of_gt hepsilon]

/-- The hinge gap at the first frozen label is its distance above the lower endpoint. -/
theorem proposition36b_hinge_gap_at_two {epsilon candidate : ℝ} (hepsilon : 0 < epsilon) :
    1 + epsilon * 2 * candidate =
      2 * epsilon * (candidate - proposition36bLowerEndpoint epsilon) := by
  unfold proposition36bLowerEndpoint
  field_simp [ne_of_gt hepsilon]
  ring

/--
Under the first large-penalty inequality, freezing the source construction at
`2` makes the left endpoint a population-risk minimizer on its stated domain.
-/
theorem proposition36b_lowerEndpoint_isMinimizer
    {epsilon gamma penalty candidate : ℝ} (hepsilon : 0 < epsilon) (hgamma : 0 < gamma)
    (hpenalty : IsProposition36bLargePenalty epsilon gamma penalty)
    (hcandidate : candidate ∈ proposition36bDomain epsilon) :
    proposition36bFrozenRisk epsilon gamma penalty 2 (proposition36bLowerEndpoint epsilon) ≤
      proposition36bFrozenRisk epsilon gamma penalty 2 candidate := by
  rcases hcandidate with ⟨hlower, _⟩
  have hhingeCandidate : -1 ≤ epsilon * 2 * candidate := by
    rw [← proposition36b_lowerEndpoint_hinge_at_two hepsilon]
    exact mul_le_mul_of_nonneg_left hlower (by positivity)
  have hhingeLower :
      max (-1) (epsilon * 2 * proposition36bLowerEndpoint epsilon) = -1 := by
    rw [proposition36b_lowerEndpoint_hinge_at_two hepsilon]
    simp
  have hhingeCandidate' : max (-1) (epsilon * 2 * candidate) = epsilon * 2 * candidate :=
    max_eq_right hhingeCandidate
  have hgap : 0 ≤ candidate - proposition36bLowerEndpoint epsilon := sub_nonneg.mpr hlower
  have hbase : 0 ≤ 2 * penalty * epsilon +
      gamma * (proposition36bLowerEndpoint epsilon - 1) := by
    linarith [hpenalty.1]
  have hlinearBound : gamma * (proposition36bLowerEndpoint epsilon - 1) ≤
      gamma / 2 * (candidate + proposition36bLowerEndpoint epsilon - 2) := by
    nlinarith
  have hbracket : 0 ≤ 2 * penalty * epsilon +
      gamma / 2 * (candidate + proposition36bLowerEndpoint epsilon - 2) := by
    linarith
  have hfactor :
      proposition36bFrozenRisk epsilon gamma penalty 2 candidate -
          proposition36bFrozenRisk epsilon gamma penalty 2
            (proposition36bLowerEndpoint epsilon) =
        (candidate - proposition36bLowerEndpoint epsilon) *
          (2 * penalty * epsilon +
            gamma / 2 * (candidate + proposition36bLowerEndpoint epsilon - 2)) := by
    unfold proposition36bFrozenRisk
    rw [hhingeCandidate', hhingeLower]
    calc
      penalty * (epsilon * 2 * candidate) + gamma / 2 * (candidate - 1) ^ 2 -
          (penalty * -1 + gamma / 2 * (proposition36bLowerEndpoint epsilon - 1) ^ 2) =
        penalty * (1 + epsilon * 2 * candidate) + gamma / 2 *
          ((candidate - 1) ^ 2 - (proposition36bLowerEndpoint epsilon - 1) ^ 2) := by
          ring
      _ = penalty * (2 * epsilon * (candidate - proposition36bLowerEndpoint epsilon)) +
          gamma / 2 * ((candidate - 1) ^ 2 -
            (proposition36bLowerEndpoint epsilon - 1) ^ 2) := by
          rw [proposition36b_hinge_gap_at_two (candidate := candidate) hepsilon]
      _ = (candidate - proposition36bLowerEndpoint epsilon) *
          (2 * penalty * epsilon +
            gamma / 2 * (candidate + proposition36bLowerEndpoint epsilon - 2)) := by
          ring
  apply sub_nonneg.mp
  rw [hfactor]
  exact mul_nonneg hgap hbracket

/-- At the second frozen iterate, the source point mass has label `-1 / 2`. -/
theorem proposition36b_lowerEndpoint_label {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    epsilon * proposition36bLowerEndpoint epsilon = -(1 / 2 : ℝ) := by
  unfold proposition36bLowerEndpoint
  field_simp [ne_of_gt hepsilon]

/-- The first frozen hinge can be written as an affine term plus an absolute-value kink. -/
theorem proposition36b_hinge_at_two_eq_affine_add_abs
    {epsilon candidate : ℝ} (hepsilon : 0 < epsilon) :
    max (-1) (epsilon * 2 * candidate) =
      epsilon * candidate - 1 / 2 +
        epsilon * |candidate - proposition36bLowerEndpoint epsilon| := by
  rcases le_total candidate (proposition36bLowerEndpoint epsilon) with hleft | hright
  · have hhinge : epsilon * 2 * candidate ≤ -1 := by
      calc
        epsilon * 2 * candidate ≤
            epsilon * 2 * proposition36bLowerEndpoint epsilon := by
              gcongr
        _ = -1 := proposition36b_lowerEndpoint_hinge_at_two hepsilon
    rw [max_eq_left hhinge, abs_of_nonpos (sub_nonpos.mpr hleft)]
    nlinarith [proposition36b_lowerEndpoint_label hepsilon]
  · have hhinge : -1 ≤ epsilon * 2 * candidate := by
      rw [← proposition36b_lowerEndpoint_hinge_at_two hepsilon]
      gcongr
    rw [max_eq_right hhinge, abs_of_nonneg (sub_nonneg.mpr hright)]
    nlinarith [proposition36b_lowerEndpoint_label hepsilon]

/-- The source's regularized hinge objective at the first endpoint is nondifferentiable. -/
theorem proposition36bFrozenRisk_not_differentiableAt_lowerEndpoint
    {epsilon gamma penalty : ℝ} (hepsilon : 0 < epsilon) (hpenalty : 0 < penalty) :
    ¬ DifferentiableAt ℝ
      (proposition36bFrozenRisk epsilon gamma penalty 2)
      (proposition36bLowerEndpoint epsilon) := by
  intro hdifferentiable
  let endpoint := proposition36bLowerEndpoint epsilon
  let kink : ℝ → ℝ := fun candidate => penalty * epsilon * |candidate - endpoint|
  let regular : ℝ → ℝ := fun candidate =>
    penalty * (epsilon * candidate - 1 / 2) + gamma / 2 * (candidate - 1) ^ 2
  have hdecomposition : proposition36bFrozenRisk epsilon gamma penalty 2 = kink + regular := by
    funext candidate
    dsimp [kink, regular, endpoint]
    unfold proposition36bFrozenRisk
    rw [proposition36b_hinge_at_two_eq_affine_add_abs hepsilon]
    ring
  rw [hdecomposition] at hdifferentiable
  have hregular : DifferentiableAt ℝ regular endpoint := by
    dsimp [regular]
    fun_prop
  have hkink : DifferentiableAt ℝ kink endpoint := by
    have hsub := hdifferentiable.sub hregular
    convert hsub using 1
    ext candidate
    simp only [Pi.add_apply, Pi.sub_apply]
    ring
  have hscale : penalty * epsilon ≠ 0 := mul_ne_zero hpenalty.ne' hepsilon.ne'
  have habsShift : DifferentiableAt ℝ (fun candidate : ℝ => |candidate - endpoint|) endpoint := by
    convert hkink.const_mul (penalty * epsilon)⁻¹ using 1
    ext candidate
    dsimp [kink]
    field_simp [hscale]
  have habs : DifferentiableAt ℝ (abs : ℝ → ℝ) 0 := by
    have houter : DifferentiableAt ℝ (fun candidate : ℝ => |candidate - endpoint|)
        ((fun candidate : ℝ => candidate + endpoint) 0) := by
      simpa using habsShift
    have htranslate := DifferentiableAt.comp 0 houter
      (differentiableAt_id.add_const endpoint)
    simpa [Function.comp_def] using htranslate
  exact not_differentiableAt_abs_zero habs

/--
At the first source iterate, the exact pointwise regularized-hinge loss is
nondifferentiable at the lower endpoint.  Thus this real-data construction
cannot satisfy a gradient-based joint-smoothness premise.
-/
theorem proposition36bMeasureLoss_not_differentiableAt_lowerEndpoint
    {epsilon gamma penalty : ℝ} (hepsilon : 0 < epsilon) (hpenalty : 0 < penalty) :
    ¬ DifferentiableAt ℝ
      (fun candidate => proposition36bMeasureLoss gamma penalty (epsilon * 2) candidate)
      (proposition36bLowerEndpoint epsilon) := by
  simpa [proposition36bMeasureLoss, proposition36bFrozenRisk] using
    (proposition36bFrozenRisk_not_differentiableAt_lowerEndpoint
      (gamma := gamma) hepsilon hpenalty)

/--
Under the second large-penalty inequality, freezing the source construction at
the lower endpoint makes `2` a population-risk minimizer on its stated domain.
-/
theorem proposition36b_upperEndpoint_isMinimizer
    {epsilon gamma penalty candidate : ℝ} (hepsilon : 0 < epsilon) (hgamma : 0 < gamma)
    (hpenalty : IsProposition36bLargePenalty epsilon gamma penalty)
    (hcandidate : candidate ∈ proposition36bDomain epsilon) :
    proposition36bFrozenRisk epsilon gamma penalty
        (proposition36bLowerEndpoint epsilon) 2 ≤
      proposition36bFrozenRisk epsilon gamma penalty
        (proposition36bLowerEndpoint epsilon) candidate := by
  rcases hcandidate with ⟨_, hupper⟩
  have hlabel := proposition36b_lowerEndpoint_label hepsilon
  have hhingeCandidate : -1 ≤ epsilon * proposition36bLowerEndpoint epsilon * candidate := by
    rw [hlabel]
    nlinarith
  have hhingeCandidate' :
      max (-1) (epsilon * proposition36bLowerEndpoint epsilon * candidate) =
        epsilon * proposition36bLowerEndpoint epsilon * candidate :=
    max_eq_right hhingeCandidate
  have hhingeUpper :
      max (-1) (epsilon * proposition36bLowerEndpoint epsilon * 2) = -1 := by
    rw [hlabel]
    norm_num
  have hgap : 0 ≤ 2 - candidate := sub_nonneg.mpr hupper
  have hbracket : 0 ≤ penalty / 2 - gamma * candidate / 2 := by
    nlinarith [hpenalty.2]
  have hfactor :
      proposition36bFrozenRisk epsilon gamma penalty
          (proposition36bLowerEndpoint epsilon) candidate -
        proposition36bFrozenRisk epsilon gamma penalty
          (proposition36bLowerEndpoint epsilon) 2 =
        (2 - candidate) * (penalty / 2 - gamma * candidate / 2) := by
    unfold proposition36bFrozenRisk
    rw [hhingeCandidate', hhingeUpper, hlabel]
    ring
  apply sub_nonneg.mp
  rw [hfactor]
  exact mul_nonneg hgap hbracket

/--
The endpoint selection used by the regularized-hinge counterexample.  Its
values away from the two source iterates are immaterial to the exhibited RRM
cycle; the endpoint argmin facts below justify the two displayed updates.
-/
noncomputable def proposition36bRRMUpdate (epsilon : ℝ) (deployed : ℝ) : ℝ :=
  if deployed = 2 then proposition36bLowerEndpoint epsilon else 2

/-- The two frozen endpoint argmin conditions that the source uses for RRM. -/
def IsProposition36bEndpointRRM (epsilon gamma penalty : ℝ) (update : ℝ → ℝ) : Prop :=
  (∀ candidate ∈ proposition36bDomain epsilon,
    proposition36bFrozenRisk epsilon gamma penalty 2 (update 2) ≤
      proposition36bFrozenRisk epsilon gamma penalty 2 candidate) ∧
  (∀ candidate ∈ proposition36bDomain epsilon,
    proposition36bFrozenRisk epsilon gamma penalty
        (proposition36bLowerEndpoint epsilon) (update (proposition36bLowerEndpoint epsilon)) ≤
      proposition36bFrozenRisk epsilon gamma penalty
        (proposition36bLowerEndpoint epsilon) candidate)

/-- The lower endpoint is distinct from the upper endpoint for positive sensitivity. -/
theorem proposition36b_lowerEndpoint_ne_two {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    proposition36bLowerEndpoint epsilon ≠ 2 := by
  intro htwo
  have hhinge := proposition36b_lowerEndpoint_hinge_at_two hepsilon
  rw [htwo] at hhinge
  nlinarith

/-- The selected endpoint update realizes the two source frozen-risk argmins. -/
theorem proposition36bRRMUpdate_isEndpointRRM
    {epsilon gamma penalty : ℝ} (hepsilon : 0 < epsilon) (hgamma : 0 < gamma)
    (hpenalty : IsProposition36bLargePenalty epsilon gamma penalty) :
    IsProposition36bEndpointRRM epsilon gamma penalty (proposition36bRRMUpdate epsilon) := by
  constructor
  · intro candidate hcandidate
    simpa [proposition36bRRMUpdate] using
      proposition36b_lowerEndpoint_isMinimizer hepsilon hgamma hpenalty hcandidate
  · intro candidate hcandidate
    have hne := proposition36b_lowerEndpoint_ne_two hepsilon
    simpa [proposition36bRRMUpdate, hne] using
      proposition36b_upperEndpoint_isMinimizer hepsilon hgamma hpenalty hcandidate

/-- The endpoint RRM selection exchanges the two source iterates. -/
theorem proposition36bRRMUpdate_endpoint_cycle {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    proposition36bRRMUpdate epsilon 2 = proposition36bLowerEndpoint epsilon ∧
      proposition36bRRMUpdate epsilon (proposition36bLowerEndpoint epsilon) = 2 := by
  have hne := proposition36b_lowerEndpoint_ne_two hepsilon
  simp [proposition36bRRMUpdate, hne]

/--
The two steps of the exhibited Proposition 3.6(b) orbit are genuine
domain-constrained RRM steps for the exact real point-mass model.  The update
is deliberately certified only on this source orbit, which is all the
counterexample's divergence argument uses.
-/
theorem proposition36bRRMUpdate_isEndpointMeasureRRM
    {epsilon gamma penalty : ℝ} (hepsilon : 0 < epsilon) (hgamma : 0 < gamma)
    (hpenalty : IsProposition36bLargePenalty epsilon gamma penalty) :
    (proposition36bRRMUpdate epsilon 2 ∈ proposition36bDomain epsilon ∧
      ∀ candidate ∈ proposition36bDomain epsilon,
        measureDecoupledPerformativeRisk (proposition36bMeasureModel epsilon gamma penalty)
          2 (proposition36bRRMUpdate epsilon 2) ≤
        measureDecoupledPerformativeRisk (proposition36bMeasureModel epsilon gamma penalty)
          2 candidate) ∧
    (proposition36bRRMUpdate epsilon (proposition36bLowerEndpoint epsilon) ∈
      proposition36bDomain epsilon ∧
      ∀ candidate ∈ proposition36bDomain epsilon,
        measureDecoupledPerformativeRisk (proposition36bMeasureModel epsilon gamma penalty)
          (proposition36bLowerEndpoint epsilon)
          (proposition36bRRMUpdate epsilon (proposition36bLowerEndpoint epsilon)) ≤
        measureDecoupledPerformativeRisk (proposition36bMeasureModel epsilon gamma penalty)
          (proposition36bLowerEndpoint epsilon) candidate) := by
  have hcycle := proposition36bRRMUpdate_endpoint_cycle hepsilon
  have hlower : proposition36bLowerEndpoint epsilon ∈ proposition36bDomain epsilon := by
    constructor
    · rfl
    · unfold proposition36bLowerEndpoint
      have hpositive : 0 < 1 / (2 * epsilon) := by positivity
      linarith
  have hupper : (2 : ℝ) ∈ proposition36bDomain epsilon := by
    constructor
    · unfold proposition36bLowerEndpoint
      have hpositive : 0 < 1 / (2 * epsilon) := by positivity
      linarith
    · rfl
  have horbit := proposition36bRRMUpdate_isEndpointRRM hepsilon hgamma hpenalty
  constructor
  · refine ⟨by rw [hcycle.1]; exact hlower, ?_⟩
    intro candidate hcandidate
    rw [proposition36b_measureDecoupledPerformativeRisk_eq,
      proposition36b_measureDecoupledPerformativeRisk_eq]
    exact horbit.1 candidate hcandidate
  · refine ⟨by rw [hcycle.2]; exact hupper, ?_⟩
    intro candidate hcandidate
    rw [proposition36b_measureDecoupledPerformativeRisk_eq,
      proposition36b_measureDecoupledPerformativeRisk_eq]
    exact horbit.2 candidate hcandidate

/-- Two endpoint-RRM steps return `2` to itself. -/
theorem proposition36bRRMUpdate_iterate_two {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    (proposition36bRRMUpdate epsilon)^[2] 2 = 2 := by
  rw [Function.iterate_succ_apply', Function.iterate_one]
  rw [(proposition36bRRMUpdate_endpoint_cycle hepsilon).1]
  exact (proposition36bRRMUpdate_endpoint_cycle hepsilon).2

/-- The even iterates of the regularized-hinge endpoint RRM stay at `2`. -/
theorem proposition36bRRMUpdate_iterate_even {epsilon : ℝ} (hepsilon : 0 < epsilon)
    (iteration : ℕ) :
    (proposition36bRRMUpdate epsilon)^[2 * iteration] 2 = 2 := by
  rw [Function.iterate_mul]
  exact Function.iterate_fixed (proposition36bRRMUpdate_iterate_two hepsilon) iteration

/-- The odd iterates of the regularized-hinge endpoint RRM stay at the lower endpoint. -/
theorem proposition36bRRMUpdate_iterate_odd {epsilon : ℝ} (hepsilon : 0 < epsilon)
    (iteration : ℕ) :
    (proposition36bRRMUpdate epsilon)^[2 * iteration + 1] 2 =
      proposition36bLowerEndpoint epsilon := by
  rw [show 2 * iteration + 1 = (2 * iteration).succ by omega,
    Function.iterate_succ_apply', proposition36bRRMUpdate_iterate_even hepsilon iteration]
  exact (proposition36bRRMUpdate_endpoint_cycle hepsilon).1

/-- The source's regularized-hinge endpoint RRM sequence does not converge. -/
theorem proposition36bRRMUpdate_not_tendsto_from_two {epsilon : ℝ} (hepsilon : 0 < epsilon) :
    ¬ ∃ limit : ℝ, Filter.Tendsto
      (fun iteration => (proposition36bRRMUpdate epsilon)^[iteration] 2)
        Filter.atTop (nhds limit) := by
  rintro ⟨limit, hlimit⟩
  have hne : (2 : ℝ) ≠ proposition36bLowerEndpoint epsilon :=
    (proposition36b_lowerEndpoint_ne_two hepsilon).symm
  have hdistancePos : 0 < dist (2 : ℝ) (proposition36bLowerEndpoint epsilon) :=
    dist_pos.mpr hne
  rcases (Metric.cauchySeq_iff.mp hlimit.cauchySeq)
      (dist (2 : ℝ) (proposition36bLowerEndpoint epsilon) / 2)
      (half_pos hdistancePos) with ⟨threshold, htail⟩
  have hdistance := htail (2 * threshold) (by omega) (2 * threshold + 1) (by omega)
  rw [proposition36bRRMUpdate_iterate_even hepsilon,
    proposition36bRRMUpdate_iterate_odd hepsilon] at hdistance
  nlinarith

/--
A finite-PMF transport formulation of distribution-map sensitivity.  For each
pair of parameters it requires a coupling of the induced data laws whose
expected data distance is at most `sensitivity * dist parameter parameter'`.
It is the finite primal transport bridge used for Wasserstein-sensitive models.
-/
def IsFiniteTransportSensitive {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] [MetricSpace Parameter] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) (sensitivity : ℝ) : Prop :=
  ∀ first second,
    FiniteCoupling.HasExpectedCostLE (model.dataLaw first) (model.dataLaw second)
      (fun left right => dist left right) (sensitivity * dist first second)

/--
The finite binary Proposition 3.6(a) specialization is transport-sensitive
with positive coefficient `1 / 2`.
-/
theorem proposition36aModel_finiteTransportSensitive :
    IsFiniteTransportSensitive proposition36aModel ((1 : ℝ) / 2) := by
  intro first second
  rcases le_total (proposition36aProbability first) (proposition36aProbability second) with
      hordered | hordered
  · refine ⟨proposition36aOrderedLawCoupling first second hordered, ?_⟩
    change (proposition36aOrderedLawCoupling first second hordered).expectedCost
        (fun left right : Bool => dist left right) ≤ (1 : ℝ) / 2 * dist first second
    rw [expectedCost_proposition36aOrderedLawCoupling]
    have horderedReal : (proposition36aProbability first : ℝ) ≤
        proposition36aProbability second := by
      exact_mod_cast hordered
    have hbound := abs_sub_proposition36aProbability_le first second
    rw [abs_of_nonpos (sub_nonpos.mpr horderedReal)] at hbound
    simpa only [neg_sub] using hbound
  · refine ⟨(proposition36aOrderedLawCoupling second first hordered).swap, ?_⟩
    change (proposition36aOrderedLawCoupling second first hordered).swap.expectedCost
        (fun left right : Bool => dist left right) ≤ (1 : ℝ) / 2 * dist first second
    have hsymmetry : (fun left right : Bool => dist right left) =
        fun left right => dist left right := by
      funext left right
      exact dist_comm _ _
    calc
      (proposition36aOrderedLawCoupling second first hordered).swap.expectedCost
          (fun left right : Bool => dist left right) =
          (proposition36aOrderedLawCoupling second first hordered).expectedCost
            (fun left right => dist right left) :=
        FiniteCoupling.expectedCost_swap _ _
      _ = (proposition36aOrderedLawCoupling second first hordered).expectedCost
            (fun left right => dist left right) := by rw [hsymmetry]
      _ = (proposition36aProbability first : ℝ) - proposition36aProbability second :=
        expectedCost_proposition36aOrderedLawCoupling second first hordered
      _ ≤ (1 : ℝ) / 2 * dist first second := by
        have horderedReal : (proposition36aProbability second : ℝ) ≤
            proposition36aProbability first := by
          exact_mod_cast hordered
        have hbound := abs_sub_proposition36aProbability_le first second
        rw [abs_of_nonneg (sub_nonneg.mpr horderedReal)] at hbound
        exact hbound

/--
Finite-PMF Wasserstein-1 sensitivity, using the infimum over finite coupling
costs.  An explicit transport certificate is sufficient for this condition.
-/
def IsFiniteWassersteinSensitive {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] [MetricSpace Parameter] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) (sensitivity : ℝ) : Prop :=
  ∀ first second,
    FiniteCoupling.finiteWassersteinOne (model.dataLaw first) (model.dataLaw second) ≤
      sensitivity * dist first second

/--
Finite primal transport sensitivity restricted to a parameter domain.  The
paper defines its distribution map only on `Θ`, so this is the natural form
for constrained performative models.
-/
def IsFiniteTransportSensitiveOn {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] [MetricSpace Parameter] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (sensitivity : ℝ) : Prop :=
  ∀ first ∈ domain, ∀ second ∈ domain,
    FiniteCoupling.HasExpectedCostLE (model.dataLaw first) (model.dataLaw second)
      (fun left right => dist left right) (sensitivity * dist first second)

/--
Finite Wasserstein-1 sensitivity restricted to a parameter domain.  This
avoids imposing behavior on distribution laws outside the constrained model
space.
-/
def IsFiniteWassersteinSensitiveOn {Parameter Data : Type*}
    [Fintype Data] [DecidableEq Data] [MetricSpace Parameter] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
    (sensitivity : ℝ) : Prop :=
  ∀ first ∈ domain, ∀ second ∈ domain,
    FiniteCoupling.finiteWassersteinOne (model.dataLaw first) (model.dataLaw second) ≤
      sensitivity * dist first second

/-- An explicit domain-restricted transport plan gives domain-restricted W₁ sensitivity. -/
theorem IsFiniteWassersteinSensitiveOn.of_finiteTransportSensitiveOn
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    [MetricSpace Parameter] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter) {sensitivity : ℝ}
    (hsensitive : IsFiniteTransportSensitiveOn model domain sensitivity) :
    IsFiniteWassersteinSensitiveOn model domain sensitivity := by
  intro first hfirst second hsecond
  exact FiniteCoupling.finiteWassersteinOne_le_of_expectedCostLE
    (hsensitive first hfirst second hsecond)

/-- Every finite primal transport-sensitive model is finite Wasserstein-sensitive. -/
theorem IsFiniteWassersteinSensitive.of_finiteTransportSensitive
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    [MetricSpace Parameter] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) {sensitivity : ℝ}
    (hsensitive : IsFiniteTransportSensitive model sensitivity) :
    IsFiniteWassersteinSensitive model sensitivity := by
  intro first second
  exact FiniteCoupling.finiteWassersteinOne_le_of_expectedCostLE (hsensitive first second)

/-- The Proposition 3.6(a) finite binary specialization is W₁-sensitive with `epsilon = 1 / 2`. -/
theorem proposition36aModel_finiteWassersteinSensitive :
    IsFiniteWassersteinSensitive proposition36aModel ((1 : ℝ) / 2) :=
  IsFiniteWassersteinSensitive.of_finiteTransportSensitive proposition36aModel
    proposition36aModel_finiteTransportSensitive

/--
The repaired Appendix E.5 model is transport-sensitive with coefficient
`epsilon` (for nonnegative `epsilon`) in the local binary-data metric.  The
proof uses the explicit finite coupling above rather than an abstract
Wasserstein existence theorem.
-/
theorem correctedProposition42Model_finiteTransportSensitive
    (mu epsilon : ℝ) (hmu : |mu| ≤ (1 : ℝ) / 2)
    (hmuEpsilon : |mu + epsilon| ≤ (1 : ℝ) / 2) (hepsilon : 0 ≤ epsilon) :
    IsFiniteTransportSensitive (correctedProposition42Model mu epsilon hmu hmuEpsilon) epsilon := by
  intro first second
  have hfirstBias : |mu + epsilon * (first : ℝ)| ≤ (1 : ℝ) / 2 := by
    have hcore := abs_affine_parameter_le_of_endpoint_abs_le mu (mu + epsilon)
      ((1 : ℝ) / 2) first hmu hmuEpsilon first.2
    have hrewrite : mu + epsilon * (first : ℝ) =
        (1 - (first : ℝ)) * mu + (first : ℝ) * (mu + epsilon) := by ring
    rw [hrewrite]
    exact hcore
  have hsecondBias : |mu + epsilon * (second : ℝ)| ≤ (1 : ℝ) / 2 := by
    have hcore := abs_affine_parameter_le_of_endpoint_abs_le mu (mu + epsilon)
      ((1 : ℝ) / 2) second hmu hmuEpsilon second.2
    have hrewrite : mu + epsilon * (second : ℝ) =
        (1 - (second : ℝ)) * mu + (second : ℝ) * (mu + epsilon) := by ring
    rw [hrewrite]
    exact hcore
  obtain ⟨coupling, hcost⟩ := proposition42Law_hasExpectedCostLE
    (mu + epsilon * (first : ℝ)) (mu + epsilon * (second : ℝ)) hfirstBias hsecondBias
  refine ⟨coupling, hcost.trans ?_⟩
  calc
    |(mu + epsilon * (first : ℝ)) - (mu + epsilon * (second : ℝ))| =
        |epsilon * ((first : ℝ) - (second : ℝ))| := by
      congr 1
      ring
    _ = epsilon * |(first : ℝ) - (second : ℝ)| := by
      rw [abs_mul, abs_of_nonneg hepsilon]
    _ ≤ epsilon * dist first second := by
      rw [Subtype.dist_eq, Real.dist_eq]

/--
The corrected Appendix E.5 example also satisfies the finite W₁ sensitivity
condition appearing in the paper, by its explicit primal transport plan.
-/
theorem correctedProposition42Model_finiteWassersteinSensitive
    (mu epsilon : ℝ) (hmu : |mu| ≤ (1 : ℝ) / 2)
    (hmuEpsilon : |mu + epsilon| ≤ (1 : ℝ) / 2) (hepsilon : 0 ≤ epsilon) :
    IsFiniteWassersteinSensitive (correctedProposition42Model mu epsilon hmu hmuEpsilon) epsilon :=
  IsFiniteWassersteinSensitive.of_finiteTransportSensitive _
    (correctedProposition42Model_finiteTransportSensitive mu epsilon hmu hmuEpsilon hepsilon)

/--
The source paper's general-distribution Wasserstein-1 sensitivity condition.
For every pair of deployed parameters, the induced laws have a finite
expected-distance coupling and their real W₁ cost is bounded by the displayed
parameter-distance modulus.
-/
def IsMeasureWassersteinSensitive {Parameter Data : Type*}
    [MetricSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (sensitivity : ℝ) : Prop :=
  ∀ first second,
    ∃ hfinite : (ProbabilityCoupling.expectedDistanceCosts
      (model.dataLaw first) (model.dataLaw second)).Nonempty,
      ProbabilityCoupling.wassersteinOneReal (model.dataLaw first) (model.dataLaw second) hfinite ≤
        sensitivity * dist first second

/-- The source Wasserstein-sensitivity condition restricted to a parameter domain. -/
def IsMeasureWassersteinSensitiveOn {Parameter Data : Type*}
    [MetricSpace Parameter] [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data) (domain : Set Parameter)
    (sensitivity : ℝ) : Prop :=
  ∀ first ∈ domain, ∀ second ∈ domain,
    ∃ hfinite : (ProbabilityCoupling.expectedDistanceCosts
      (model.dataLaw first) (model.dataLaw second)).Nonempty,
      ProbabilityCoupling.wassersteinOneReal (model.dataLaw first) (model.dataLaw second) hfinite ≤
        sensitivity * dist first second

/--
The real point-mass model in Proposition 3.6(c) is W₁-sensitive with the
source coefficient `epsilon` whenever that coefficient is nonnegative.  The
proof uses the reusable deterministic Dirac coupling and the real-W₁ infimum
bound, rather than postulating transport for the point-mass family.
-/
theorem proposition36cMeasureModel_wassersteinSensitive {epsilon : ℝ}
    (hepsilon : 0 ≤ epsilon) :
    IsMeasureWassersteinSensitive (proposition36cMeasureModel epsilon) epsilon := by
  intro first second
  let hfinite : (ProbabilityCoupling.expectedDistanceCosts
      (proposition36cMeasureLaw epsilon first)
      (proposition36cMeasureLaw epsilon second)).Nonempty :=
    ProbabilityCoupling.expectedDistanceCosts_dirac_nonempty
      (1 + epsilon * first) (1 + epsilon * second)
  refine ⟨by simpa [proposition36cMeasureModel] using hfinite, ?_⟩
  change ProbabilityCoupling.wassersteinOneReal
      (proposition36cMeasureLaw epsilon first) (proposition36cMeasureLaw epsilon second) hfinite ≤
    epsilon * dist first second
  calc
    ProbabilityCoupling.wassersteinOneReal
        (proposition36cMeasureLaw epsilon first) (proposition36cMeasureLaw epsilon second) hfinite ≤
        dist (1 + epsilon * first) (1 + epsilon * second) :=
      ProbabilityCoupling.wassersteinOneReal_dirac_le_dist
        (1 + epsilon * first) (1 + epsilon * second) hfinite
    _ = |epsilon| * dist first second := by
      simpa [proposition36cRRMUpdate] using proposition36cRRMUpdate_dist epsilon first second
    _ = epsilon * dist first second := by rw [abs_of_nonneg hepsilon]

/--
Positive scaling changes no induced data law, so the scaled Proposition 3.6(c)
construction has the same exact W₁ sensitivity.
-/
theorem proposition36cScaledMeasureModel_wassersteinSensitive {epsilon gamma : ℝ}
    (hepsilon : 0 ≤ epsilon) :
    IsMeasureWassersteinSensitive (proposition36cScaledMeasureModel epsilon gamma) epsilon := by
  simpa [proposition36cScaledMeasureModel] using
    (proposition36cMeasureModel_wassersteinSensitive (epsilon := epsilon) hepsilon)

/--
Changing the loss leaves the induced Dirac law unchanged, so the
quadratic-linear construction inherits the same exact W₁ sensitivity.
-/
theorem proposition36cRegularityMeasureModel_wassersteinSensitive
    {epsilon beta gamma : ℝ} (hepsilon : 0 ≤ epsilon) :
    IsMeasureWassersteinSensitive
      (proposition36cRegularityMeasureModel epsilon beta gamma) epsilon := by
  simpa [proposition36cRegularityMeasureModel] using
    (proposition36cMeasureModel_wassersteinSensitive (epsilon := epsilon) hepsilon)

/--
The exact real Proposition 3.6(a) model is W₁-sensitive with coefficient
`epsilon`.  It reuses the general deterministic-Dirac transport bound.
-/
theorem proposition36aMeasureModel_wassersteinSensitive
    {epsilon beta : ℝ} (hepsilon : 0 ≤ epsilon) :
    IsMeasureWassersteinSensitive (proposition36aMeasureModel epsilon beta) epsilon := by
  intro first second
  let hfinite : (ProbabilityCoupling.expectedDistanceCosts
      (proposition36aMeasureLaw epsilon first)
      (proposition36aMeasureLaw epsilon second)).Nonempty :=
    ProbabilityCoupling.expectedDistanceCosts_dirac_nonempty
      (epsilon * first) (epsilon * second)
  refine ⟨by simpa [proposition36aMeasureModel] using hfinite, ?_⟩
  change ProbabilityCoupling.wassersteinOneReal
      (proposition36aMeasureLaw epsilon first) (proposition36aMeasureLaw epsilon second) hfinite ≤
    epsilon * dist first second
  calc
    ProbabilityCoupling.wassersteinOneReal
        (proposition36aMeasureLaw epsilon first) (proposition36aMeasureLaw epsilon second) hfinite ≤
        dist (epsilon * first) (epsilon * second) :=
      ProbabilityCoupling.wassersteinOneReal_dirac_le_dist
        (epsilon * first) (epsilon * second) hfinite
    _ = |epsilon| * dist first second := by
      rw [Real.dist_eq, Real.dist_eq,
        show epsilon * first - epsilon * second = epsilon * (first - second) by ring,
        abs_mul]
    _ = epsilon * dist first second := by rw [abs_of_nonneg hepsilon]

/--
The exact real Proposition 3.6(b) point-mass model is W₁-sensitive with the
source coefficient `epsilon`, independently of its loss parameters.
-/
theorem proposition36bMeasureModel_wassersteinSensitive
    {epsilon gamma penalty : ℝ} (hepsilon : 0 ≤ epsilon) :
    IsMeasureWassersteinSensitive (proposition36bMeasureModel epsilon gamma penalty) epsilon := by
  intro first second
  let hfinite : (ProbabilityCoupling.expectedDistanceCosts
      (proposition36bMeasureLaw epsilon first)
      (proposition36bMeasureLaw epsilon second)).Nonempty :=
    ProbabilityCoupling.expectedDistanceCosts_dirac_nonempty
      (epsilon * first) (epsilon * second)
  refine ⟨by simpa [proposition36bMeasureModel] using hfinite, ?_⟩
  change ProbabilityCoupling.wassersteinOneReal
      (proposition36bMeasureLaw epsilon first) (proposition36bMeasureLaw epsilon second) hfinite ≤
    epsilon * dist first second
  calc
    ProbabilityCoupling.wassersteinOneReal
        (proposition36bMeasureLaw epsilon first) (proposition36bMeasureLaw epsilon second) hfinite ≤
        dist (epsilon * first) (epsilon * second) :=
      ProbabilityCoupling.wassersteinOneReal_dirac_le_dist
        (epsilon * first) (epsilon * second) hfinite
    _ = |epsilon| * dist first second := by
      rw [Real.dist_eq, Real.dist_eq,
        show epsilon * first - epsilon * second = epsilon * (first - second) by ring,
        abs_mul]
    _ = epsilon * dist first second := by rw [abs_of_nonneg hepsilon]

/--
For the exact Proposition 3.6(c) model, performative stability is equivalent
to being a fixed point of its source-derived RRM update.
-/
theorem proposition36c_isMeasurePerformativelyStable_iff_fixedPoint
    (epsilon theta : ℝ) :
    IsMeasurePerformativelyStable (proposition36cMeasureModel epsilon) theta ↔
      proposition36cRRMUpdate epsilon theta = theta := by
  constructor
  · intro hstable
    have hstable_at_update := hstable (proposition36cRRMUpdate epsilon theta)
    have hminimizes := (proposition36c_measureUniqueFrozenMinimizer epsilon theta theta).1
    have hequality :
        measureDecoupledPerformativeRisk (proposition36cMeasureModel epsilon) theta theta =
          measureDecoupledPerformativeRisk (proposition36cMeasureModel epsilon) theta
            (proposition36cRRMUpdate epsilon theta) :=
      le_antisymm hstable_at_update hminimizes
    exact (proposition36c_measureUniqueFrozenMinimizer epsilon theta theta).2 hequality |>.symm
  · intro hfixed candidate
    simpa only [hfixed] using
      proposition36c_isMeasureRepeatedRiskMinimization epsilon theta candidate

/--
When `epsilon ≠ 1`, the source model has exactly the displayed stable point
`1 / (1 - epsilon)`.
-/
theorem proposition36c_isMeasurePerformativelyStable_iff
    {epsilon : ℝ} (hepsilon : epsilon ≠ 1) (theta : ℝ) :
    IsMeasurePerformativelyStable (proposition36cMeasureModel epsilon) theta ↔
      theta = proposition36cStablePoint epsilon := by
  rw [proposition36c_isMeasurePerformativelyStable_iff_fixedPoint]
  constructor
  · intro hfixed
    apply (eq_div_iff (sub_ne_zero.mpr hepsilon.symm)).2
    unfold proposition36cRRMUpdate at hfixed
    nlinarith
  · intro hstable
    rw [hstable]
    exact proposition36cStablePoint_isFixed hepsilon

/-- At `epsilon = 1`, the exact Proposition 3.6(c) model has no stable point. -/
theorem proposition36cMeasureModel_one_no_performativelyStablePoint :
    ¬ ∃ theta, IsMeasurePerformativelyStable (proposition36cMeasureModel 1) theta := by
  rintro ⟨theta, hstable⟩
  have hfixed := (proposition36c_isMeasurePerformativelyStable_iff_fixedPoint 1 theta).mp hstable
  exact proposition36cRRMUpdate_one_no_fixed theta hfixed

/--
For a positive scaled loss, stability is again exactly fixedness of the
source-derived RRM map.
-/
theorem proposition36cScaled_isMeasurePerformativelyStable_iff_fixedPoint
    {gamma : ℝ} (hgamma : 0 < gamma) (epsilon theta : ℝ) :
    IsMeasurePerformativelyStable (proposition36cScaledMeasureModel epsilon gamma) theta ↔
      proposition36cRRMUpdate epsilon theta = theta := by
  constructor
  · intro hstable
    have hstable_at_update := hstable (proposition36cRRMUpdate epsilon theta)
    have hminimizes :=
      (proposition36cScaled_measureUniqueFrozenMinimizer hgamma epsilon theta theta).1
    have hequality :
        measureDecoupledPerformativeRisk (proposition36cScaledMeasureModel epsilon gamma)
            theta theta =
          measureDecoupledPerformativeRisk (proposition36cScaledMeasureModel epsilon gamma)
            theta (proposition36cRRMUpdate epsilon theta) :=
      le_antisymm hstable_at_update hminimizes
    exact
      (proposition36cScaled_measureUniqueFrozenMinimizer hgamma epsilon theta theta).2 hequality |>.symm
  · intro hfixed candidate
    simpa only [hfixed] using
      proposition36cScaled_isMeasureRepeatedRiskMinimization hgamma epsilon theta candidate

/-- The scaled model has the same unique stable point whenever `epsilon ≠ 1`. -/
theorem proposition36cScaled_isMeasurePerformativelyStable_iff
    {gamma epsilon : ℝ} (hgamma : 0 < gamma) (hepsilon : epsilon ≠ 1) (theta : ℝ) :
    IsMeasurePerformativelyStable (proposition36cScaledMeasureModel epsilon gamma) theta ↔
      theta = proposition36cStablePoint epsilon := by
  rw [proposition36cScaled_isMeasurePerformativelyStable_iff_fixedPoint hgamma]
  constructor
  · intro hfixed
    apply (eq_div_iff (sub_ne_zero.mpr hepsilon.symm)).2
    unfold proposition36cRRMUpdate at hfixed
    nlinarith
  · intro hstable
    rw [hstable]
    exact proposition36cStablePoint_isFixed hepsilon

/-- At `epsilon = 1`, the positive scaled source model has no stable point. -/
theorem proposition36cScaledMeasureModel_one_no_performativelyStablePoint
    {gamma : ℝ} (hgamma : 0 < gamma) :
    ¬ ∃ theta, IsMeasurePerformativelyStable (proposition36cScaledMeasureModel 1 gamma) theta := by
  rintro ⟨theta, hstable⟩
  have hfixed :=
    (proposition36cScaled_isMeasurePerformativelyStable_iff_fixedPoint hgamma 1 theta).mp hstable
  exact proposition36cRRMUpdate_one_no_fixed theta hfixed

/--
Under finite transport sensitivity, every Lipschitz data statistic changes in
expectation at most proportionally to the distance between deployed parameters.
-/
theorem abs_pmfExp_dataLaw_sub_le_of_finiteTransportSensitive
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    [MetricSpace Parameter] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) {sensitivity : ℝ}
    (hsensitive : IsFiniteTransportSensitive model sensitivity)
    {L : NNReal} {statistic : Data → ℝ} (hstatistic : LipschitzWith L statistic)
    (first second : Parameter) :
    |pmfExp (model.dataLaw first) statistic - pmfExp (model.dataLaw second) statistic| ≤
      (L : ℝ) * (sensitivity * dist first second) :=
  FiniteCoupling.abs_pmfExp_sub_le_lipschitz_of_expectedCostLE hstatistic
    (hsensitive first second)

/--
Finite-Wasserstein-1 sensitivity controls every Lipschitz data statistic.  This
is the finite-PMF Kantorovich--Rubinstein direction used in Appendix D.1: the
underlying finite-W₁ infimum is connected to the test-function inequality in
`FiniteCoupling.abs_pmfExp_sub_le_lipschitz_finiteWassersteinOne`.
-/
theorem abs_pmfExp_dataLaw_sub_le_of_finiteWassersteinSensitive
    {Parameter Data : Type*} [Fintype Data] [DecidableEq Data]
    [MetricSpace Parameter] [MetricSpace Data]
    (model : FinitePerformativeModel Parameter Data) {sensitivity : ℝ}
    (hsensitive : IsFiniteWassersteinSensitive model sensitivity)
    {L : NNReal} {statistic : Data → ℝ} (hstatistic : LipschitzWith L statistic)
    (first second : Parameter) :
    |pmfExp (model.dataLaw first) statistic - pmfExp (model.dataLaw second) statistic| ≤
      (L : ℝ) * (sensitivity * dist first second) := by
  exact (FiniteCoupling.abs_pmfExp_sub_le_lipschitz_finiteWassersteinOne hstatistic).trans
    (mul_le_mul_of_nonneg_left (hsensitive first second) (by positivity))

/--
The data-coordinate component of the paper's joint-smoothness condition for a
gradient-valued loss.  It is stated independently of any particular
performative model so it can also be used for distributionally robust or
strategic-response objectives.
-/
def IsDataGradientLipschitz {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter] [MetricSpace Data]
    (gradient : Data → Parameter → Parameter) (smoothness : NNReal) : Prop :=
  ∀ (first second : Data) (parameter : Parameter),
    ‖gradient first parameter - gradient second parameter‖ ≤
      (smoothness : ℝ) * dist first second

/-- The general-distribution expected loss gradient under a frozen induced law. -/
noncomputable def measureFrozenPopulationGradient {Parameter Data : Type*}
    [MeasurableSpace Data] [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (distributionParameter evaluatedParameter : Parameter) : Parameter :=
  ∫ datum, gradient datum evaluatedParameter ∂(model.dataLaw distributionParameter : Measure Data)

/--
Differentiation under a frozen arbitrary data law.  This packages Mathlib's
dominated parametric-integral theorem in the performative-model API: pointwise
gradient realization, local domination by an integrable derivative bound, and
local measurability yield the frozen-risk gradient representation required by
the general PZ RRM theorems.
-/
theorem hasGradientAt_measureDecoupledPerformativeRisk_of_dominated
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (distributionParameter evaluatedParameter : Parameter)
    (domain : Set Parameter) (hdomain : domain ∈ nhds evaluatedParameter)
    (hloss_meas : ∀ᶠ parameter in nhds evaluatedParameter,
      AEStronglyMeasurable (fun datum => model.loss datum parameter)
        (model.dataLaw distributionParameter : Measure Data))
    (hgradient_meas : AEStronglyMeasurable (fun datum =>
      (InnerProductSpace.toDual ℝ Parameter) (gradient datum evaluatedParameter))
        (model.dataLaw distributionParameter : Measure Data))
    (hintegrable : Integrable (fun datum => gradient datum evaluatedParameter)
      (model.dataLaw distributionParameter : Measure Data))
    (bound : Data → ℝ)
    (hbound : ∀ᵐ datum ∂(model.dataLaw distributionParameter : Measure Data),
      ∀ parameter ∈ domain,
        ‖(InnerProductSpace.toDual ℝ Parameter) (gradient datum parameter)‖ ≤ bound datum)
    (hbound_integrable : Integrable bound
      (model.dataLaw distributionParameter : Measure Data))
    (hpointwise : ∀ᵐ datum ∂(model.dataLaw distributionParameter : Measure Data),
      ∀ parameter ∈ domain,
        HasGradientAt (fun theta => model.loss datum theta) (gradient datum parameter) parameter) :
    HasGradientAt
      (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
      (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
      evaluatedParameter := by
  have hcomm :=
    (InnerProductSpace.toDual ℝ Parameter).toLinearIsometry.toContinuousLinearMap
      |>.integral_comp_comm hintegrable
  have hcomm' :
      (∫ datum,
        (InnerProductSpace.toDual ℝ Parameter) (gradient datum evaluatedParameter) ∂
          (model.dataLaw distributionParameter : Measure Data)) =
        (InnerProductSpace.toDual ℝ Parameter)
          (∫ datum, gradient datum evaluatedParameter ∂
            (model.dataLaw distributionParameter : Measure Data)) := by
    simpa only [InnerProductSpace.toDual_apply_eq_toDualMap_apply,
      InnerProductSpace.toLinearIsometry_toDual] using hcomm
  have hderiv := hasFDerivAt_integral_of_dominated_of_fderiv_le hdomain hloss_meas
    (model.loss_integrable distributionParameter evaluatedParameter) hgradient_meas hbound
    hbound_integrable (hpointwise.mono fun datum hdatum parameter hparameter =>
      (hdatum parameter hparameter).hasFDerivAt)
  rw [hcomm'] at hderiv
  rw [hasGradientAt_iff_hasFDerivAt]
  simpa only [measureDecoupledPerformativeRisk, measureFrozenPopulationGradient] using hderiv

/--
General W₁ sensitivity controls the shift in an integrable frozen population
gradient.  This is the arbitrary-measure primal transport bridge used by the
PZ contraction argument before applying strong convexity.
-/
theorem norm_measureFrozenPopulationGradient_sub_le_of_wassersteinSensitive
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [MeasurableSpace Data] [MetricSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {smoothness : NNReal}
    (hgradient : IsDataGradientLipschitz gradient smoothness)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    {sensitivity : ℝ} (hsensitive : IsMeasureWassersteinSensitive model sensitivity)
    (evaluated first second : Parameter) :
    ‖measureFrozenPopulationGradient model gradient first evaluated -
        measureFrozenPopulationGradient model gradient second evaluated‖ ≤
      (smoothness : ℝ) * (sensitivity * dist first second) := by
  rcases hsensitive first second with ⟨hfinite, hWasserstein⟩
  have hlipschitz : LipschitzWith smoothness (fun datum => gradient datum evaluated) :=
    LipschitzWith.of_dist_le_mul fun left right => by
      simpa only [dist_eq_norm] using hgradient left right evaluated
  have htransport := ProbabilityCoupling.norm_integral_sub_le_lipschitz_wassersteinOneReal
    (μ := model.dataLaw first) (ν := model.dataLaw second) (V := Parameter)
    hlipschitz (hintegrable first evaluated) (hintegrable second evaluated) hfinite
  calc
    ‖measureFrozenPopulationGradient model gradient first evaluated -
        measureFrozenPopulationGradient model gradient second evaluated‖ ≤
        (smoothness : ℝ) *
          ProbabilityCoupling.wassersteinOneReal (model.dataLaw first) (model.dataLaw second) hfinite := by
      simpa only [measureFrozenPopulationGradient] using htransport
    _ ≤ (smoothness : ℝ) * (sensitivity * dist first second) :=
      mul_le_mul_of_nonneg_left hWasserstein (NNReal.coe_nonneg smoothness)

/--
The first-order stationarity condition for a general-law RRM update.  It is
the whole-space conclusion supplied by differentiating a frozen population
risk at its minimizer.
-/
def IsMeasureFrozenGradientStationary {Parameter Data : Type*}
    [MeasurableSpace Data] [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (update : Parameter → Parameter) : Prop :=
  ∀ deployed,
    measureFrozenPopulationGradient model gradient deployed (update deployed) = 0

/--
A whole-space general-law RRM update is stationary whenever its frozen
population gradient realizes the derivative of the frozen population risk.
-/
theorem isMeasureFrozenGradientStationary_of_rrm_hasGradientAt_univ
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (update : Parameter → Parameter)
    (hrrm : IsMeasureRepeatedRiskMinimization model update)
    (hgradientAt : ∀ distributionParameter evaluatedParameter,
      HasGradientAt
        (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter evaluatedParameter)
        evaluatedParameter) :
    IsMeasureFrozenGradientStationary model gradient update := by
  intro deployed
  have hlocal : IsLocalMin
      (fun parameter => measureDecoupledPerformativeRisk model deployed parameter) (update deployed) := by
    apply IsMinOn.isLocalMin (s := Set.univ)
    · intro candidate _
      exact hrrm deployed candidate
    · simp
  have hderivative := hgradientAt deployed (update deployed)
  have hfrechet_zero :
      (InnerProductSpace.toDual ℝ Parameter)
        (measureFrozenPopulationGradient model gradient deployed (update deployed)) = 0 :=
    hlocal.hasFDerivAt_eq_zero hderivative.hasFDerivAt
  apply (InnerProductSpace.toDual ℝ Parameter).injective
  simpa using hfrechet_zero

/--
At a whole-space minimizer of a differentiable frozen population risk, the
represented frozen population gradient vanishes.  This is the reusable Fermat
step needed both for RRM updates and for identifying any stable point with an
RRM fixed point.
-/
theorem measureFrozenPopulationGradient_eq_zero_of_hasGradientAt_univ
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter)
    (distributionParameter minimizer : Parameter)
    (hminimizer : ∀ candidate,
      measureDecoupledPerformativeRisk model distributionParameter minimizer ≤
        measureDecoupledPerformativeRisk model distributionParameter candidate)
    (hgradientAt : HasGradientAt
      (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
      (measureFrozenPopulationGradient model gradient distributionParameter minimizer)
      minimizer) :
    measureFrozenPopulationGradient model gradient distributionParameter minimizer = 0 := by
  have hlocal : IsLocalMin
      (fun parameter => measureDecoupledPerformativeRisk model distributionParameter parameter)
      minimizer := by
    apply IsMinOn.isLocalMin (s := Set.univ)
    · intro candidate _
      exact hminimizer candidate
    · simp
  have hfrechet_zero :
      (InnerProductSpace.toDual ℝ Parameter)
        (measureFrozenPopulationGradient model gradient distributionParameter minimizer) = 0 :=
    hlocal.hasFDerivAt_eq_zero hgradientAt.hasFDerivAt
  apply (InnerProductSpace.toDual ℝ Parameter).injective
  simpa using hfrechet_zero

/--
The norm lower bound on a frozen population gradient supplied by strong
convexity.  Keeping this independently reusable form separates the
measure-theoretic W₁ step from the analytic strong-convexity derivation.
-/
def IsMeasureFrozenGradientStronglyMonotone {Parameter Data : Type*}
    [MeasurableSpace Data] [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (modulus : ℝ) : Prop :=
  ∀ deployed first second,
    modulus * ‖first - second‖ ≤
      ‖measureFrozenPopulationGradient model gradient deployed first -
        measureFrozenPopulationGradient model gradient deployed second‖

/--
The variational first-order inequality for a differentiable frozen population
risk on a convex parameter domain.
-/
def IsMeasureFrozenGradientFirstOrderOptimalOn {Parameter Data : Type*}
    [MeasurableSpace Data] [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (domain : Set Parameter)
    (distributionParameter minimizer : Parameter) : Prop :=
  ∀ candidate ∈ domain,
    0 ≤ ⟪candidate - minimizer,
      measureFrozenPopulationGradient model gradient distributionParameter minimizer⟫_ℝ

/--
The inner-product strong-monotonicity form used by the convex-domain RRM proof.
It is the expected-gradient consequence of the source's strong-convexity
assumption before Cauchy--Schwarz is applied.
-/
def IsMeasureFrozenGradientStronglyMonotoneInner {Parameter Data : Type*}
    [MeasurableSpace Data] [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (modulus : ℝ) : Prop :=
  ∀ deployed first second,
    modulus * ‖first - second‖ ^ 2 ≤
      ⟪first - second,
        measureFrozenPopulationGradient model gradient deployed first -
          measureFrozenPopulationGradient model gradient deployed second⟫_ℝ

/--
The pointwise form of the source's A2 strong-convexity assumption for an
arbitrary probability data law.  Together with integrability of the gradient,
it implies strong monotonicity of the frozen expected gradient below.
-/
def IsMeasurePointwiseGradientStronglyConvex {Parameter Data : Type*}
    [MeasurableSpace Data] [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (modulus : ℝ) : Prop :=
  ∀ datum center candidate,
    model.loss datum candidate ≥
      model.loss datum center +
        ⟪gradient datum center, candidate - center⟫_ℝ +
          modulus / 2 * ‖candidate - center‖ ^ 2

/-- The pointwise A2 strong-convexity condition on a parameter domain. -/
def IsMeasurePointwiseGradientStronglyConvexOn {Parameter Data : Type*}
    [MeasurableSpace Data] [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (domain : Set Parameter)
    (modulus : ℝ) : Prop :=
  ∀ datum, ∀ center ∈ domain, ∀ candidate ∈ domain,
    model.loss datum candidate ≥
      model.loss datum center +
        ⟪gradient datum center, candidate - center⟫_ℝ +
          modulus / 2 * ‖candidate - center‖ ^ 2

/-- The source A2 lower model implies ordinary strong convexity of each
pointwise loss on the same convex parameter domain. -/
theorem strongConvexOn_measureLoss_of_pointwiseGradientStronglyConvexOn
    {Parameter Data : Type*}
    [MeasurableSpace Data] [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (domain : Set Parameter)
    (hconvex : Convex ℝ domain) {modulus : ℝ}
    (hstrong : IsMeasurePointwiseGradientStronglyConvexOn
      model gradient domain modulus)
    (datum : Data) : StrongConvexOn domain modulus (model.loss datum) := by
  refine ⟨hconvex, ?_⟩
  intro first hfirst second hsecond a b ha hb hab
  let center := a • first + b • second
  have hcenter : center ∈ domain := hconvex hfirst hsecond ha hb hab
  have hfirst_lower := hstrong datum center hcenter first hfirst
  have hsecond_lower := hstrong datum center hcenter second hsecond
  have hfirst_weighted := mul_le_mul_of_nonneg_left hfirst_lower ha
  have hsecond_weighted := mul_le_mul_of_nonneg_left hsecond_lower hb
  have hfirst_sub : first - center = b • (first - second) := by
    dsimp [center]
    have : 1 - a = b := by linarith
    rw [← this]
    module
  have hsecond_sub : second - center = -a • (first - second) := by
    dsimp [center]
    have : 1 - b = a := by linarith
    rw [← this]
    module
  rw [hfirst_sub, inner_smul_right, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg hb] at hfirst_weighted
  rw [hsecond_sub, inner_smul_right, norm_smul, Real.norm_eq_abs,
    abs_neg, abs_of_nonneg ha] at hsecond_weighted
  simp only [smul_eq_mul]
  change model.loss datum center ≤
    a * model.loss datum first + b * model.loss datum second -
      a * b * (modulus / 2 * ‖first - second‖ ^ 2)
  have hsum := add_le_add hfirst_weighted hsecond_weighted
  have halgebra :
      a * (model.loss datum center +
          b * ⟪gradient datum center, first - second⟫_ℝ +
          modulus / 2 * (b * ‖first - second‖) ^ 2) +
        b * (model.loss datum center -
          a * ⟪gradient datum center, first - second⟫_ℝ +
          modulus / 2 * (a * ‖first - second‖) ^ 2) =
        model.loss datum center +
          a * b * (modulus / 2 * ‖first - second‖ ^ 2) := by
    have : b = 1 - a := by linarith
    rw [this]
    ring
  have hsum' :
      model.loss datum center +
          a * b * (modulus / 2 * ‖first - second‖ ^ 2) ≤
        a * model.loss datum first + b * model.loss datum second := by
    rw [← halgebra]
    convert hsum using 1
    ring
  linarith

/-- Pointwise A2 is preserved by integration under a frozen probability law.
The gradient terms cancel before integration, so no gradient-integrability or
differentiation-under-expectation premise is needed. -/
theorem strongConvexOn_measureDecoupledPerformativeRisk_of_pointwiseGradientStronglyConvexOn
    {Parameter Data : Type*}
    [MeasurableSpace Data] [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (domain : Set Parameter)
    (hconvex : Convex ℝ domain) {modulus : ℝ}
    (hstrong : IsMeasurePointwiseGradientStronglyConvexOn
      model gradient domain modulus)
    (deployed : Parameter) :
    StrongConvexOn domain modulus
      (measureDecoupledPerformativeRisk model deployed) := by
  refine ⟨hconvex, ?_⟩
  intro first hfirst second hsecond a b ha hb hab
  let μ : Measure Data := model.dataLaw deployed
  let curvature := a * b * (modulus / 2 * ‖first - second‖ ^ 2)
  have hfirst_integrable : Integrable (fun datum => model.loss datum first) μ :=
    model.loss_integrable deployed first
  have hsecond_integrable : Integrable (fun datum => model.loss datum second) μ :=
    model.loss_integrable deployed second
  have hcombined_integrable : Integrable (fun datum =>
      model.loss datum (a • first + b • second)) μ :=
    model.loss_integrable deployed (a • first + b • second)
  have hconstant_integrable : Integrable (fun _ : Data => curvature) μ :=
    integrable_const _
  have hright_integrable : Integrable (fun datum =>
      a * model.loss datum first + b * model.loss datum second - curvature) μ :=
    ((hfirst_integrable.const_mul a).add
      (hsecond_integrable.const_mul b)).sub hconstant_integrable
  have haverage := integral_mono_ae hcombined_integrable hright_integrable
    (ae_of_all μ fun datum => by
      simpa only [smul_eq_mul, curvature] using
        (strongConvexOn_measureLoss_of_pointwiseGradientStronglyConvexOn
          model gradient domain hconvex hstrong datum).2
            hfirst hsecond ha hb hab)
  change ∫ datum, model.loss datum (a • first + b • second) ∂μ ≤
    a * (∫ datum, model.loss datum first ∂μ) +
      b * (∫ datum, model.loss datum second ∂μ) - curvature
  calc
    ∫ datum, model.loss datum (a • first + b • second) ∂μ ≤
        ∫ datum, a * model.loss datum first + b * model.loss datum second - curvature ∂μ :=
      haverage
    _ = a * (∫ datum, model.loss datum first ∂μ) +
          b * (∫ datum, model.loss datum second ∂μ) - curvature := by
      have hsplit_sub :
          (∫ datum, a * model.loss datum first + b * model.loss datum second - curvature ∂μ) =
            (∫ datum, a * model.loss datum first + b * model.loss datum second ∂μ) -
              ∫ _ : Data, curvature ∂μ :=
        integral_sub ((hfirst_integrable.const_mul a).add
          (hsecond_integrable.const_mul b)) hconstant_integrable
      have hsplit_add :
          (∫ datum, a * model.loss datum first + b * model.loss datum second ∂μ) =
            (∫ datum, a * model.loss datum first ∂μ) +
              ∫ datum, b * model.loss datum second ∂μ :=
        integral_add (hfirst_integrable.const_mul a) (hsecond_integrable.const_mul b)
      rw [hsplit_sub, hsplit_add, integral_const_mul, integral_const_mul,
        integral_const, probReal_univ, one_smul]

/-- The Proposition 3.6(c) squared loss is pointwise `2`-strongly convex. -/
theorem proposition36cMeasureModel_pointwiseGradientStronglyConvex (epsilon : ℝ) :
    IsMeasurePointwiseGradientStronglyConvex (proposition36cMeasureModel epsilon)
      proposition36cGradient 2 := by
  intro datum center candidate
  have h := (proposition36cLoss_quadraticExpansion datum center candidate).ge
  change (datum - candidate) ^ 2 ≥ (datum - center) ^ 2 +
    ⟪2 * (center - datum), candidate - center⟫_ℝ +
      (2 : ℝ) / 2 * ‖candidate - center‖ ^ 2
  rw [proposition36c_real_inner_eq_mul]
  norm_num
  simpa [proposition36cLoss, proposition36cGradient] using h

/-- The scaled squared loss is pointwise `gamma`-strongly convex. -/
theorem proposition36cScaledMeasureModel_pointwiseGradientStronglyConvex
    (epsilon gamma : ℝ) :
    IsMeasurePointwiseGradientStronglyConvex (proposition36cScaledMeasureModel epsilon gamma)
      (proposition36cScaledGradient gamma) gamma := by
  intro datum center candidate
  change (gamma / 2) * (datum - candidate) ^ 2 ≥
    (gamma / 2) * (datum - center) ^ 2 +
      ⟪gamma * (center - datum), candidate - center⟫_ℝ +
        gamma / 2 * ‖candidate - center‖ ^ 2
  rw [proposition36c_real_inner_eq_mul]
  have hidentity :
      (gamma / 2) * (datum - candidate) ^ 2 =
        (gamma / 2) * (datum - center) ^ 2 +
          gamma * (center - datum) * (candidate - center) +
            gamma / 2 * (candidate - center) ^ 2 := by
    ring
  rw [hidentity]
  simp only [Real.norm_eq_abs, sq_abs]
  exact le_rfl

/-- The quadratic-linear loss is pointwise `gamma`-strongly convex. -/
theorem proposition36cRegularityMeasureModel_pointwiseGradientStronglyConvex
    (epsilon beta gamma : ℝ) :
    IsMeasurePointwiseGradientStronglyConvex
      (proposition36cRegularityMeasureModel epsilon beta gamma)
      (proposition36cRegularityGradient beta gamma) gamma := by
  intro datum center candidate
  change (gamma / 2) * candidate ^ 2 - beta * datum * candidate ≥
    (gamma / 2) * center ^ 2 - beta * datum * center +
      ⟪gamma * center - beta * datum, candidate - center⟫_ℝ +
        gamma / 2 * ‖candidate - center‖ ^ 2
  rw [proposition36c_real_inner_eq_mul]
  have hidentity :
      (gamma / 2) * candidate ^ 2 - beta * datum * candidate =
        (gamma / 2) * center ^ 2 - beta * datum * center +
          (gamma * center - beta * datum) * (candidate - center) +
            gamma / 2 * (candidate - center) ^ 2 := by
    ring
  rw [hidentity]
  simp only [Real.norm_eq_abs, sq_abs]
  exact le_rfl

/--
No positive modulus makes the exact linear Proposition 3.6(a) loss pointwise
strongly convex.  The zero datum exposes the missing quadratic curvature.
-/
theorem proposition36aMeasure_not_pointwiseGradientStronglyConvex
    {epsilon beta modulus : ℝ} (hmodulus : 0 < modulus) :
    ¬ IsMeasurePointwiseGradientStronglyConvex (proposition36aMeasureModel epsilon beta)
      (proposition36aMeasureGradient beta) modulus := by
  intro hstrong
  have h := hstrong 0 0 1
  simp [proposition36aMeasureModel, proposition36aMeasureLoss,
    proposition36aMeasureGradient] at h
  linarith

/--
Averaging the source's pointwise A2 inequality under a frozen probability law
gives the corresponding strong-convexity lower bound for population risk.
The Bochner-integrability assumption is precisely what licenses taking the
gradient pairing through that expectation.
-/
theorem measureFrozenRisk_strongConvex_lowerBound
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ}
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    (distributionParameter center candidate : Parameter) :
    measureDecoupledPerformativeRisk model distributionParameter candidate ≥
      measureDecoupledPerformativeRisk model distributionParameter center +
        ⟪candidate - center,
          measureFrozenPopulationGradient model gradient distributionParameter center⟫_ℝ +
          modulus / 2 * ‖candidate - center‖ ^ 2 := by
  let μ : Measure Data := model.dataLaw distributionParameter
  let displacement := candidate - center
  have hgradient_integrable : Integrable (fun datum => gradient datum center) μ :=
    hintegrable distributionParameter center
  have hpair_integrable : Integrable (fun datum =>
      ⟪displacement, gradient datum center⟫_ℝ) μ :=
    hgradient_integrable.const_inner displacement
  have hconstant_integrable : Integrable (fun _ : Data =>
      modulus / 2 * ‖displacement‖ ^ 2) μ :=
    integrable_const _
  have hright_integrable : Integrable (fun datum =>
      model.loss datum center +
        (⟪displacement, gradient datum center⟫_ℝ +
          modulus / 2 * ‖displacement‖ ^ 2)) μ :=
    (model.loss_integrable distributionParameter center).add
      (hpair_integrable.add hconstant_integrable)
  have hleft_integrable : Integrable (fun datum => model.loss datum candidate) μ :=
    model.loss_integrable distributionParameter candidate
  have haverage := integral_mono_ae hright_integrable hleft_integrable (ae_of_all μ fun datum => by
    simpa only [displacement, add_assoc, real_inner_comm] using hstrong datum center candidate)
  have hpair :
      (∫ datum, ⟪displacement, gradient datum center⟫_ℝ ∂μ) =
        ⟪displacement,
          measureFrozenPopulationGradient model gradient distributionParameter center⟫_ℝ := by
    simpa only [measureFrozenPopulationGradient, μ] using
      (integral_inner hgradient_integrable displacement)
  change ∫ datum, model.loss datum candidate ∂μ ≥
    (∫ datum, model.loss datum center ∂μ) +
      ⟪displacement,
        measureFrozenPopulationGradient model gradient distributionParameter center⟫_ℝ +
        modulus / 2 * ‖displacement‖ ^ 2
  have hsplit_outer :
      (∫ datum, model.loss datum center +
        (⟪displacement, gradient datum center⟫_ℝ +
          modulus / 2 * ‖displacement‖ ^ 2) ∂μ) =
        (∫ datum, model.loss datum center ∂μ) +
          ∫ datum, (⟪displacement, gradient datum center⟫_ℝ +
            modulus / 2 * ‖displacement‖ ^ 2) ∂μ :=
    integral_add (model.loss_integrable distributionParameter center)
      (hpair_integrable.add hconstant_integrable)
  have hsplit_inner :
      (∫ datum, (⟪displacement, gradient datum center⟫_ℝ +
        modulus / 2 * ‖displacement‖ ^ 2) ∂μ) =
        (∫ datum, ⟪displacement, gradient datum center⟫_ℝ ∂μ) +
          ∫ _ : Data, modulus / 2 * ‖displacement‖ ^ 2 ∂μ :=
    integral_add hpair_integrable hconstant_integrable
  calc
    ∫ datum, model.loss datum candidate ∂μ ≥
        ∫ datum, model.loss datum center +
          (⟪displacement, gradient datum center⟫_ℝ +
            modulus / 2 * ‖displacement‖ ^ 2) ∂μ := haverage
    _ = (∫ datum, model.loss datum center ∂μ) +
          ⟪displacement,
            measureFrozenPopulationGradient model gradient distributionParameter center⟫_ℝ +
          modulus / 2 * ‖displacement‖ ^ 2 := by
      rw [hsplit_outer, hsplit_inner, integral_const, probReal_univ, one_smul, hpair]
      ring

/--
Uniform frozen-risk deviation controls the distance between an empirical RERM
minimizer and a population minimizer.  This is the arbitrary-law deterministic
strong-convexity step used by the RERM part of Theorem 3.10.
-/
theorem norm_measureEmpiricalRiskMinimizer_sub_measurePopulationRiskMinimizer_le_of_uniformDeviation
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    (domain : Set Parameter) (empiricalLaw : ProbabilityMeasure Data)
    (deployed empiricalMinimizer populationMinimizer : Parameter)
    (hempirical : IsMeasureEmpiricalRiskMinimizerOn model domain empiricalLaw empiricalMinimizer)
    (hpopulation : IsMeasurePopulationRiskMinimizerOn model domain
      (model.dataLaw deployed) populationMinimizer)
    (hfirstOrder : IsMeasureFrozenGradientFirstOrderOptimalOn model gradient domain
      deployed populationMinimizer)
    {deviation : ℝ} (hdeviation_nonneg : 0 ≤ deviation)
    (huniform : ∀ candidate ∈ domain,
      |measureEmpiricalDecoupledPerformativeRisk model empiricalLaw candidate -
          measureDecoupledPerformativeRisk model deployed candidate| ≤ deviation) :
    ‖empiricalMinimizer - populationMinimizer‖ ≤ Real.sqrt (4 * deviation / modulus) := by
  have hempiricalMin := hempirical.2 populationMinimizer hpopulation.1
  have hdeviationEmpirical := huniform empiricalMinimizer hempirical.1
  have hdeviationPopulation := huniform populationMinimizer hpopulation.1
  have hpopulationRisk_le :
      measureDecoupledPerformativeRisk model deployed empiricalMinimizer ≤
        measureDecoupledPerformativeRisk model deployed populationMinimizer + 2 * deviation := by
    have hfirst :
        measureDecoupledPerformativeRisk model deployed empiricalMinimizer ≤
          measureEmpiricalDecoupledPerformativeRisk model empiricalLaw empiricalMinimizer +
            deviation := by
      rcases abs_le.mp hdeviationEmpirical with ⟨hlower, _⟩
      linarith
    have hthird :
        measureEmpiricalDecoupledPerformativeRisk model empiricalLaw populationMinimizer ≤
          measureDecoupledPerformativeRisk model deployed populationMinimizer + deviation := by
      rcases abs_le.mp hdeviationPopulation with ⟨_, hupper⟩
      linarith
    linarith
  have hstrongLower := measureFrozenRisk_strongConvex_lowerBound model gradient hstrong hintegrable
    deployed populationMinimizer empiricalMinimizer
  have hpairing_nonneg : 0 ≤ ⟪empiricalMinimizer - populationMinimizer,
      measureFrozenPopulationGradient model gradient deployed populationMinimizer⟫_ℝ :=
    hfirstOrder empiricalMinimizer hempirical.1
  have hscaled : modulus / 2 * ‖empiricalMinimizer - populationMinimizer‖ ^ 2 ≤
      2 * deviation := by
    nlinarith
  have hsq : ‖empiricalMinimizer - populationMinimizer‖ ^ 2 ≤ 4 * deviation / modulus := by
    apply (le_div_iff₀ hmodulus).mpr
    nlinarith
  have hright_nonneg : 0 ≤ 4 * deviation / modulus := by positivity
  have hsq_sqrt : ‖empiricalMinimizer - populationMinimizer‖ ^ 2 ≤
      (Real.sqrt (4 * deviation / modulus)) ^ 2 := by
    simpa [Real.sq_sqrt hright_nonneg] using hsq
  exact (sq_le_sq₀ (norm_nonneg _) (Real.sqrt_nonneg _)).mp hsq_sqrt

/--
On a heterogeneous adaptive trace, per-round uniform empirical-risk control
keeps arbitrary-law RERM iterates in the contractive absorbing ball.  The
probability and concentration arguments remain separate in the supplied
history-indexed `bad` event.
-/
theorem dist_heterogeneousMeasureRERMState_le_radius_of_not_bad
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    (domain : Set Parameter) (sampleCount : ℕ → ℕ)
    (hcountPositive : ∀ iteration, 0 < sampleCount iteration)
    (deployedOfHistory : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration → Parameter)
    (hempirical : IsHeterogeneousMeasureRepeatedEmpiricalRiskMinimizationTrajectoryOn model domain
      sampleCount hcountPositive deployedOfHistory)
    (populationUpdate : Parameter → Parameter)
    (hpopulation : IsMeasureRepeatedRiskMinimizationOn model domain populationUpdate)
    (hfirstOrder : ∀ deployed ∈ domain,
      IsMeasureFrozenGradientFirstOrderOptimalOn model gradient domain deployed
        (populationUpdate deployed))
    (stable : Parameter) {contraction tolerance radius : ℝ}
    (hcontraction_nonneg : 0 ≤ contraction)
    (hstable : populationUpdate stable = stable)
    (hcontract : ∀ parameter ∈ domain,
      dist (populationUpdate parameter) (populationUpdate stable) ≤
        contraction * dist parameter stable)
    (htolerance_nonneg : 0 ≤ tolerance)
    (hinitial : ∀ history : HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data 0,
      deployedOfHistory 0 history ∈ domain ∧ dist (deployedOfHistory 0 history) stable ≤ radius)
    (herror_absorbed : Real.sqrt (4 * tolerance / modulus) ≤ (1 - contraction) * radius)
    (bad : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration →
      (Fin (sampleCount iteration) → Data) → Prop)
    (hgood : ∀ iteration history batch, ¬ bad iteration history batch →
      ∀ candidate ∈ domain,
        |measureEmpiricalDecoupledPerformativeRisk model
            (empiricalSampleProbabilityMeasureOfPos (hcountPositive iteration) batch) candidate -
          measureDecoupledPerformativeRisk model (deployedOfHistory iteration history) candidate| ≤
            tolerance)
    (iteration : ℕ) :
    ∀ history : HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration,
      ¬ adaptiveFreshHeterogeneousTraceAnyBadEvent (fun round => Fin (sampleCount round)) bad
        iteration history → dist (deployedOfHistory iteration history) stable ≤ radius := by
  let traceInit : ∀ {round : ℕ},
      HeterogeneousBatchTrace (fun index => Fin (sampleCount index)) Data (round + 1) →
        HeterogeneousBatchTrace (fun index => Fin (sampleCount index)) Data round :=
    fun {round} history => heterogeneousBatchTraceInit
      (BatchIndex := fun index => Fin (sampleCount index)) history
  let traceLast : ∀ {round : ℕ},
      HeterogeneousBatchTrace (fun index => Fin (sampleCount index)) Data (round + 1) →
        Fin (sampleCount round) → Data :=
    fun {round} history => heterogeneousBatchTraceLast
      (BatchIndex := fun index => Fin (sampleCount index)) history
  have hdomain : ∀ iteration
      (history : HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration),
      deployedOfHistory iteration history ∈ domain := by
    intro round history
    induction round with
    | zero => exact (hinitial history).1
    | succ round _ =>
        have hminimizer := hempirical round (traceInit history) (traceLast history)
        simpa [traceInit, traceLast] using hminimizer.1
  intro history hsafe
  induction iteration with
  | zero => exact (hinitial history).2
  | succ iteration ih =>
      change ¬ (adaptiveFreshHeterogeneousTraceAnyBadEvent
        (fun round => Fin (sampleCount round)) bad iteration (traceInit history) ∨
        bad iteration (traceInit history) (traceLast history)) at hsafe
      have hprevious : ¬ adaptiveFreshHeterogeneousTraceAnyBadEvent
          (fun round => Fin (sampleCount round)) bad iteration (traceInit history) :=
        fun hbad => hsafe (Or.inl hbad)
      have hbatch : ¬ bad iteration (traceInit history) (traceLast history) :=
        fun hbad => hsafe (Or.inr hbad)
      have hprevious_radius := ih (traceInit history) hprevious
      have huniform := hgood iteration (traceInit history) (traceLast history) hbatch
      have hminimizer := hempirical iteration (traceInit history) (traceLast history)
      simp [traceInit, traceLast] at hminimizer
      have hpopulationMin : IsMeasurePopulationRiskMinimizerOn model domain
          (model.dataLaw (deployedOfHistory iteration (traceInit history)))
          (populationUpdate (deployedOfHistory iteration (traceInit history))) := by
        simpa [IsMeasurePopulationRiskMinimizerOn, measureDecoupledPerformativeRisk] using
          (hpopulation (deployedOfHistory iteration (traceInit history))
            (hdomain iteration (traceInit history)))
      have hperturb :
          dist (deployedOfHistory (iteration + 1) history)
            (populationUpdate (deployedOfHistory iteration (traceInit history))) ≤
              Real.sqrt (4 * tolerance / modulus) := by
        rw [dist_eq_norm]
        exact norm_measureEmpiricalRiskMinimizer_sub_measurePopulationRiskMinimizer_le_of_uniformDeviation
          model gradient hmodulus hstrong hintegrable domain
          (empiricalSampleProbabilityMeasureOfPos (hcountPositive iteration) (traceLast history))
          (deployedOfHistory iteration (traceInit history))
          (deployedOfHistory (iteration + 1) history)
          (populationUpdate (deployedOfHistory iteration (traceInit history)))
          hminimizer hpopulationMin
          (hfirstOrder (deployedOfHistory iteration (traceInit history))
            (hdomain iteration (traceInit history)))
          htolerance_nonneg huniform
      have hcontract' :
          dist (populationUpdate (deployedOfHistory iteration (traceInit history))) stable ≤
            contraction * dist (deployedOfHistory iteration (traceInit history)) stable := by
        simpa [hstable] using hcontract (deployedOfHistory iteration (traceInit history))
          (hdomain iteration (traceInit history))
      calc
        dist (deployedOfHistory (iteration + 1) history) stable ≤
            dist (deployedOfHistory (iteration + 1) history)
              (populationUpdate (deployedOfHistory iteration (traceInit history))) +
            dist (populationUpdate (deployedOfHistory iteration (traceInit history))) stable :=
          dist_triangle _ _ _
        _ ≤ Real.sqrt (4 * tolerance / modulus) + contraction *
              dist (deployedOfHistory iteration (traceInit history)) stable :=
          add_le_add hperturb hcontract'
        _ ≤ Real.sqrt (4 * tolerance / modulus) + contraction * radius := by
          exact add_le_add_right
            (mul_le_mul_of_nonneg_left hprevious_radius hcontraction_nonneg) _
        _ ≤ radius := by linarith

/--
The probabilistic adaptive-trace counterpart of
`dist_heterogeneousMeasureRERMState_le_radius_of_not_bad`.  Any measurable
history-indexed concentration event whose complement supplies uniform risk
deviation yields a simultaneous high-probability RERM absorbing-ball bound.
-/
theorem one_sub_le_measureReal_heterogeneousMeasureRERMState_le_radius_of_badEvent
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter] [MeasurableSpace Data]
    (model : MeasurePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsMeasurePointwiseGradientStronglyConvex model gradient modulus)
    (hintegrable : ∀ distributionParameter evaluatedParameter,
      Integrable (fun datum => gradient datum evaluatedParameter)
        (model.dataLaw distributionParameter : Measure Data))
    (domain : Set Parameter) (sampleCount : ℕ → ℕ)
    (hcountPositive : ∀ iteration, 0 < sampleCount iteration)
    (deployedOfHistory : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration → Parameter)
    (hempirical : IsHeterogeneousMeasureRepeatedEmpiricalRiskMinimizationTrajectoryOn model domain
      sampleCount hcountPositive deployedOfHistory)
    (populationUpdate : Parameter → Parameter)
    (hpopulation : IsMeasureRepeatedRiskMinimizationOn model domain populationUpdate)
    (hfirstOrder : ∀ deployed ∈ domain,
      IsMeasureFrozenGradientFirstOrderOptimalOn model gradient domain deployed
        (populationUpdate deployed))
    (stable : Parameter) {contraction tolerance radius p : ℝ}
    (hcontraction_nonneg : 0 ≤ contraction)
    (hstable : populationUpdate stable = stable)
    (hcontract : ∀ parameter ∈ domain,
      dist (populationUpdate parameter) (populationUpdate stable) ≤
        contraction * dist parameter stable)
    (htolerance_nonneg : 0 ≤ tolerance)
    (hinitial : ∀ history : HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data 0,
      deployedOfHistory 0 history ∈ domain ∧ dist (deployedOfHistory 0 history) stable ≤ radius)
    (herror_absorbed : Real.sqrt (4 * tolerance / modulus) ≤ (1 - contraction) * radius)
    (kernel : (iteration : ℕ) →
      Kernel
        ((i : Finset.Iic iteration) → HeterogeneousBatchTraceCoordinate
          (fun round => Fin (sampleCount round)) Data i.1)
        (Fin (sampleCount iteration) → Data))
    [hkernelMarkov : ∀ iteration, IsMarkovKernel (kernel iteration)]
    (bad : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (sampleCount round)) Data iteration →
      (Fin (sampleCount iteration) → Data) → Prop)
    (hevent : ∀ iteration, MeasurableSet
      (heterogeneousBatchTraceBadEventPair (fun round => Fin (sampleCount round)) bad iteration))
    (hbad : (@heterogeneousBatchTraceInfiniteLaw Data _
      (fun round => Fin (sampleCount round)) kernel hkernelMarkov).real
      (⋃ iteration,
        adaptiveFreshHeterogeneousInfiniteTraceBadEvent (fun round => Fin (sampleCount round)) bad
          iteration) ≤ p)
    (hgood : ∀ iteration history batch, ¬ bad iteration history batch →
      ∀ candidate ∈ domain,
        |measureEmpiricalDecoupledPerformativeRisk model
            (empiricalSampleProbabilityMeasureOfPos (hcountPositive iteration) batch) candidate -
          measureDecoupledPerformativeRisk model (deployedOfHistory iteration history) candidate| ≤
            tolerance) :
    (@heterogeneousBatchTraceInfiniteLaw Data _
      (fun round => Fin (sampleCount round)) kernel hkernelMarkov).real
      {trace | ∀ iteration,
        dist (deployedOfHistory iteration
          (heterogeneousBatchTraceOfInfiniteTrace iteration trace)) stable ≤ radius} ≥ 1 - p := by
  change 1 - p ≤
    (@heterogeneousBatchTraceInfiniteLaw Data _
      (fun round => Fin (sampleCount round)) kernel hkernelMarkov).real
      {trace | ∀ iteration,
