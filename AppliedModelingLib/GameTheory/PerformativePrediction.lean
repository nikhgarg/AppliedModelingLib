      (trajectory outcome) (htrajectory outcome) stable horizon hcontraction_nonneg hstable hcontract
    · intro round hround
      exact hgood round (Finset.mem_range.mpr hround)
    · exact hinitial outcome
    · exact herror_absorbed
    · exact hiteration
  calc
    1 - ∑ iteration ∈ Finset.range horizon, measureProb law (fun outcome =>
        ¬ ‖empiricalPopulationGradient gradient (samples outcome iteration)
            (trajectory outcome iteration) - frozenPopulationGradient model gradient
              (trajectory outcome iteration) (trajectory outcome iteration)‖ ≤ gradientError) =
        1 - ∑ iteration ∈ Finset.range horizon,
          measureProb law (fun outcome => ¬ good iteration outcome) := by
            simp [good]
    _ ≤ measureProb law (fun outcome => ∀ iteration ∈ Finset.range horizon,
        good iteration outcome) := hgood_probability
    _ ≤ measureProb law (fun outcome => ∀ iteration, iteration ≤ horizon →
        dist (trajectory outcome iteration) stable ≤ radius) :=
      measureProb_mono law _ _ hgood_implies

