    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (sampleCount : ℕ → ℕ)
    (deployedOfHistory : ∀ iteration,
      PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount iteration → Parameter)
    (domain : Set Parameter) (tolerance : ℝ) (iteration : ℕ) :
    Set ((i : ℕ) → HeterogeneousBatchTraceCoordinate
      (fun round => Fin (sampleCount round)) Data i) :=
  adaptiveFreshHeterogeneousInfiniteTraceBadEvent (fun round => Fin (sampleCount round))
    (fun round history batch => finiteIidUniformEmpiricalRiskDeviationEvent model domain
      (deployedOfHistory round history) tolerance batch) iteration

/--
The probability that at least one batch before a horizon has a uniform
empirical-risk deviation, now with a potentially different sample count at
each round as in Theorem 3.10.
-/
noncomputable def freshPerformativeHeterogeneousTraceLawEmpiricalRiskDeviationUpToFailure
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (sampleCount : ℕ → ℕ)
    (deployedOfHistory : ∀ iteration,
      PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount iteration → Parameter)
    (iteration : ℕ) (domain : Set Parameter) (tolerance : ℝ) : ℝ :=
  adaptiveFreshHeterogeneousTraceAnyBadProbability (fun round => Fin (sampleCount round))
    model.dataLaw deployedOfHistory
    (fun round history batch => finiteIidUniformEmpiricalRiskDeviationEvent model domain
      (deployedOfHistory round history) tolerance batch) iteration

/--
Finite-PMF Theorem 3.10 confidence bridge with the paper's time-varying batch
sizes.  When the fresh conditional IID failure at round `t` meets the source
budget `6p/(pi^2 (t + 1)^2)`, the probability of any uniform-risk deviation in
the first `horizon` batches is at most `p`.
-/
theorem freshPerformativeHeterogeneousTraceLawEmpiricalRiskDeviationUpToFailure_le_theorem310Budget
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [Fintype Parameter] [DecidableEq Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (sampleCount : ℕ → ℕ)
    (deployedOfHistory : ∀ iteration,
      PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount iteration → Parameter)
    (horizon : ℕ) (domain : Set Parameter) (tolerance p : ℝ) (hp : 0 ≤ p)
    (hbudget : ∀ round history,
      finiteIidUniformEmpiricalRiskDeviationFailure model domain
        (deployedOfHistory round history) tolerance (sampleCount round) ≤
          theorem310FailureBudget p round) :
    freshPerformativeHeterogeneousTraceLawEmpiricalRiskDeviationUpToFailure model sampleCount
      deployedOfHistory horizon domain tolerance ≤ p := by
  calc
    freshPerformativeHeterogeneousTraceLawEmpiricalRiskDeviationUpToFailure model sampleCount
        deployedOfHistory horizon domain tolerance ≤
        ∑ round ∈ Finset.range horizon, theorem310FailureBudget p round := by
      unfold freshPerformativeHeterogeneousTraceLawEmpiricalRiskDeviationUpToFailure
      apply adaptiveFreshHeterogeneousTraceAnyBadProbability_le_sum
      intro round history
      have hconditional :
          adaptiveFreshHeterogeneousConditionalBadProbability
            (fun round => Fin (sampleCount round)) model.dataLaw deployedOfHistory
            (fun round history batch => finiteIidUniformEmpiricalRiskDeviationEvent model domain
              (deployedOfHistory round history) tolerance batch) round history =
            finiteIidUniformEmpiricalRiskDeviationFailure model domain
              (deployedOfHistory round history) tolerance (sampleCount round) := by
        unfold adaptiveFreshHeterogeneousConditionalBadProbability
          finiteIidUniformEmpiricalRiskDeviationFailure
          Probability.finiteIidUniformScoreDeviationFailure pmfProb
        apply pmfExp_congr
        intro batch
        by_cases hbad : finiteIidUniformEmpiricalRiskDeviationEvent model domain
          (deployedOfHistory round history) tolerance batch <;> simp [hbad]
      rw [hconditional]
      exact hbudget round history
    _ ≤ p := sum_theorem310FailureBudget_le p hp horizon

/--
The all-rounds form of the Theorem 3.10 confidence allocation.  Unlike the
finite-prefix theorem above, every event here lives on the one common infinite
adaptive trace constructed by Ionescu--Tulcea.  Thus the countable union is
literal: if each history-conditional IID empirical-risk failure meets the
source's inverse-square budget, no round ever fails with probability at least
`1 - p`.
-/
theorem measureReal_iUnion_freshPerformativeHeterogeneousInfiniteTraceEmpiricalRiskDeviation_le_theorem310Budget
    {Parameter Data : Type*} [TopologicalSpace Parameter]
    [MeasurableSpace Data] [MeasurableSingletonClass Data]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (sampleCount : ℕ → ℕ)
    (deployedOfHistory : ∀ iteration,
      PerformativeHeterogeneousSampleTrace (Data := Data) sampleCount iteration → Parameter)
    (domain : Set Parameter) (tolerance p : ℝ) (hp : 0 ≤ p)
    (hbudget : ∀ round history,
      finiteIidUniformEmpiricalRiskDeviationFailure model domain
        (deployedOfHistory round history) tolerance (sampleCount round) ≤
          theorem310FailureBudget p round) :
    (freshPerformativeHeterogeneousInfiniteTraceLaw model sampleCount deployedOfHistory).real
      (⋃ round,
        freshPerformativeHeterogeneousInfiniteTraceEmpiricalRiskDeviationEvent model sampleCount
          deployedOfHistory domain tolerance round) ≤ p := by
  classical
  letI : IsProbabilityMeasure
      (freshPerformativeHeterogeneousInfiniteTraceLaw model sampleCount deployedOfHistory) := by
    unfold freshPerformativeHeterogeneousInfiniteTraceLaw
    infer_instance
  apply measureReal_iUnion_le_theorem310FailureBudget
    (freshPerformativeHeterogeneousInfiniteTraceLaw model sampleCount deployedOfHistory) p hp
  intro round
  apply measureReal_adaptiveFreshHeterogeneousInfiniteTraceBadEvent_le
    (fun round => Fin (sampleCount round)) model.dataLaw deployedOfHistory
    (fun round history batch => finiteIidUniformEmpiricalRiskDeviationEvent model domain
      (deployedOfHistory round history) tolerance batch)
    round (theorem310FailureBudget p round)
  · unfold theorem310FailureBudget
    positivity
  · intro historyPrefix
    apply (ENNReal.toReal_le_toReal (by finiteness) ENNReal.ofReal_ne_top).mp
    rw [ENNReal.toReal_ofReal]
    · change (pmfProduct (Fin (sampleCount round)) Data
          (model.dataLaw (deployedOfHistory round
            (heterogeneousBatchTraceOfPrefix round historyPrefix)))).toMeasure.real
          {batch | finiteIidUniformEmpiricalRiskDeviationEvent model domain
            (deployedOfHistory round (heterogeneousBatchTraceOfPrefix round historyPrefix))
              tolerance batch} ≤ theorem310FailureBudget p round
      rw [← pmfProb_eq_toMeasure_real]
      change finiteIidUniformEmpiricalRiskDeviationFailure model domain
        (deployedOfHistory round (heterogeneousBatchTraceOfPrefix round historyPrefix)) tolerance
          (sampleCount round) ≤ theorem310FailureBudget p round
      exact hbudget round (heterogeneousBatchTraceOfPrefix round historyPrefix)
    · unfold theorem310FailureBudget
      positivity

/--
Concrete finite-class alternative to the RERM concentration premise in the
previous Theorem 3.10 bridge.  If the visible Hoeffding exponent at each
