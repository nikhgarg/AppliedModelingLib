    (hlossConvex : ∀ datum, ConvexOn ℝ domain (model.loss datum)) :
    ∃ parameter ∈ domain, IsMeasurePerformativelyStableOn model domain parameter :=
  exists_isMeasurePerformativelyStableOn_of_compact_convex model domain hcompact hne hconvex
    hjoint (convexOn_measureDecoupledPerformativeRisk_of_lossConvex model domain hconvex hlossConvex)

/--
Finite-PMF compact-convex specialization of Perdomo--Zrnic--Mendler-Dünner--
Hardt (2020), Proposition 4.1.  The proof follows arXiv v4, Appendix D.5:
compactness gives frozen-law minimizers, convex frozen risk gives convex
values, and joint continuity supplies the closed graph used by Kakutani.
-/
theorem exists_isPerformativelyStableOn_of_compact_convex
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [NormedSpace ℝ Parameter]
    [FiniteDimensional ℝ Parameter] [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data) (domain : Set Parameter)
