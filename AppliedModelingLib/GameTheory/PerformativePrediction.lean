/--
A realization of repeated empirical gradient descent uses the sample collected
at round `iteration` to produce the next deployed parameter.  The sample size
may vary by round, as in Theorem 3.10.
-/
def IsRepeatedEmpiricalGradientDescentTrajectory {Parameter Data : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (stepSize : ℝ) (sampleCount : ℕ → ℕ)
    (samples : (iteration : ℕ) → Fin (sampleCount iteration) → Data)
    (trajectory : ℕ → Parameter) : Prop :=
  ∀ iteration, trajectory (iteration + 1) =
    repeatedEmpiricalGradientDescentUpdate gradient project stepSize (samples iteration)
      (trajectory iteration)

/--
On any realization where empirical gradients have a uniform error bound, a
contracting population RGD update keeps repeated empirical gradient descent in
the corresponding absorbing ball around its fixed point.  The probability and
sample-size conditions that establish the gradient-error premise are separate
concentration obligations in Theorem 3.10.
-/
theorem dist_repeatedEmpiricalGradientDescentTrajectory_le_radius_of_gradientError
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
    (model : FinitePerformativeModel Parameter Data)
    (gradient : Data → Parameter → Parameter) (project : Parameter → Parameter)
    (hproject : LipschitzWith 1 project) (stepSize : ℝ) (hstepSize : 0 ≤ stepSize)
    (sampleCount : ℕ → ℕ)
    (samples : (iteration : ℕ) → Fin (sampleCount iteration) → Data)
    (trajectory : ℕ → Parameter)
    (htrajectory : IsRepeatedEmpiricalGradientDescentTrajectory gradient project stepSize
      sampleCount samples trajectory)
    (stable : Parameter) {contraction gradientError radius : ℝ}
    (hcontraction_nonneg : 0 ≤ contraction)
    (hstable : repeatedGradientDescentUpdate model gradient project stepSize stable = stable)
    (hcontract : ∀ parameter,
      dist (repeatedGradientDescentUpdate model gradient project stepSize parameter)
        (repeatedGradientDescentUpdate model gradient project stepSize stable) ≤
          contraction * dist parameter stable)
    (hgradientError : ∀ iteration,
      ‖empiricalPopulationGradient gradient (samples iteration) (trajectory iteration) -
          frozenPopulationGradient model gradient (trajectory iteration) (trajectory iteration)‖ ≤
        gradientError)
    (hinitial : dist (trajectory 0) stable ≤ radius)
    (herror_absorbed : stepSize * gradientError ≤ (1 - contraction) * radius) :
    ∀ iteration, dist (trajectory iteration) stable ≤ radius := by
  apply Optimization.dist_le_radius_of_perturbed_contraction
    (update := repeatedGradientDescentUpdate model gradient project stepSize)
    (trajectory := trajectory) (fixedPoint := stable)
    hcontraction_nonneg hstable hcontract
  · intro iteration
    rw [htrajectory iteration, dist_eq_norm]
    calc
      ‖repeatedEmpiricalGradientDescentUpdate gradient project stepSize (samples iteration)
          (trajectory iteration) -
          repeatedGradientDescentUpdate model gradient project stepSize
            (trajectory iteration)‖ ≤
          stepSize * ‖empiricalPopulationGradient gradient (samples iteration)
            (trajectory iteration) - frozenPopulationGradient model gradient
              (trajectory iteration) (trajectory iteration)‖ :=
        norm_repeatedEmpiricalGradientDescentUpdate_sub_repeatedGradientDescentUpdate_le
          model gradient project hproject stepSize hstepSize (samples iteration)
          (trajectory iteration)
      _ ≤ stepSize * gradientError :=
        mul_le_mul_of_nonneg_left (hgradientError iteration) hstepSize
  · exact hinitial
  · exact herror_absorbed

/--
The horizon-restricted form of the empirical-RGD absorbing-ball theorem.  It
requires gradient accuracy only for the sample rounds that have occurred.
-/
theorem dist_repeatedEmpiricalGradientDescentTrajectory_le_radius_up_to_of_gradientError
    {Parameter Data : Type*} [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [Fintype Data] [DecidableEq Data]
