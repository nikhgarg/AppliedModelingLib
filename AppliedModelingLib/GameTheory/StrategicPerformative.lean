import AppliedModelingLib.GameTheory.PerformativePrediction
import AppliedModelingLib.Learning.StrategicResponseWelfare

/-!
# Strategic Responses as Performative Models

This module connects finite strategic classification to performative
prediction.  A deployed (possibly randomized) binary classifier induces a
best-response kernel, which pushes a fixed population law forward to the data
law seen by the learner.  Binary error is then both a Stackelberg objective and
the performative risk of that induced model.

The stochastic composition uses Mathlib's `PMF.pure`, `PMF.map`, and
`PMF.bind` at the repository's pinned commit
[`5450b53e`](https://github.com/leanprover-community/mathlib4/tree/5450b53e5ddc75d46418fabb605edbf36bd0beb6),
under Apache-2.0.  The finite best-response selector is the repository-local
`Optimization.exists_isMaximizerOn_of_finite`; no external theorem or proof is
copied or ported.
-/

namespace AppliedModelingLib

/-- The selected best-response kernel generated by each deployed randomized classifier. -/
noncomputable def selectedRandomizedClassifierResponseFamily
    {Parameter Feature : Type*} [Fintype Feature]
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (cost : Feature → Feature → ℝ) : Parameter → Feature → PMF Feature :=
  fun parameter =>
    selectedRandomizedClassifierResponseKernel negativeScore positiveScore
      (classifier parameter) cost

/-- Every action in the selected response kernel maximizes expected strategic utility. -/
theorem selectedRandomizedClassifierResponseFamily_spec
    {Parameter Feature : Type*} [Fintype Feature]
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (cost : Feature → Feature → ℝ) (parameter : Parameter) :
    IsStrategicBestResponseKernel
      (randomizedBinaryScore negativeScore positiveScore (classifier parameter)) cost
      (selectedRandomizedClassifierResponseFamily
        negativeScore positiveScore classifier cost parameter) :=
  selectedRandomizedClassifierResponseKernel_spec
    negativeScore positiveScore (classifier parameter) cost

/--
The selected best-response kernel for a heterogeneous population whose agents,
economic types, initial features, and type-dependent costs are explicit.
-/
noncomputable def selectedRandomizedClassifierAgentResponseFamily
    {Parameter Agent AgentType Feature : Type*} [Fintype Feature]
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature) :
    Parameter → Agent → PMF Feature :=
  fun parameter =>
    selectedAgentStrategicResponseKernel
      (randomizedBinaryScore negativeScore positiveScore (classifier parameter))
      environment

/-- Every selected heterogeneous-agent response maximizes expected classifier utility. -/
theorem selectedRandomizedClassifierAgentResponseFamily_spec
    {Parameter Agent AgentType Feature : Type*} [Fintype Feature]
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (parameter : Parameter) :
    IsAgentStrategicBestResponseKernel
      (randomizedBinaryScore negativeScore positiveScore (classifier parameter))
      environment
      (selectedRandomizedClassifierAgentResponseFamily
        negativeScore positiveScore classifier environment parameter) :=
  selectedAgentStrategicResponseKernel_spec
    (randomizedBinaryScore negativeScore positiveScore (classifier parameter))
    environment

/--
The full-support uniform best-response kernel generated by each deployed
randomized classifier in a heterogeneous population.
-/
noncomputable def uniformRandomizedClassifierAgentResponseFamily
    {Parameter Agent AgentType Feature : Type*} [Fintype Feature]
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature) :
    Parameter → Agent → PMF Feature :=
  fun parameter =>
    uniformAgentStrategicResponseKernel
      (randomizedBinaryScore negativeScore positiveScore (classifier parameter))
      environment

/-- The uniform response family has exactly the best responses in its support. -/
@[simp] theorem uniformRandomizedClassifierAgentResponseFamily_support
    {Parameter Agent AgentType Feature : Type*} [Fintype Feature]
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (parameter : Parameter) (agent : Agent) (chosen : Feature) :
    chosen ∈
        (uniformRandomizedClassifierAgentResponseFamily
          negativeScore positiveScore classifier environment parameter agent).support ↔
      IsAgentStrategicBestResponse
        (randomizedBinaryScore negativeScore positiveScore (classifier parameter))
        environment agent chosen := by
  exact uniformAgentStrategicResponseKernel_support
    (randomizedBinaryScore negativeScore positiveScore (classifier parameter))
    environment agent chosen

theorem uniformRandomizedClassifierAgentResponseFamily_spec
    {Parameter Agent AgentType Feature : Type*} [Fintype Feature]
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (parameter : Parameter) :
    IsAgentStrategicBestResponseKernel
      (randomizedBinaryScore negativeScore positiveScore (classifier parameter))
      environment
      (uniformRandomizedClassifierAgentResponseFamily
        negativeScore positiveScore classifier environment parameter) :=
  uniformAgentStrategicResponseKernel_spec
    (randomizedBinaryScore negativeScore positiveScore (classifier parameter))
    environment

/-- Uniform best-response tie-breaking in the homogeneous feature-indexed model. -/
noncomputable def uniformRandomizedClassifierResponseFamily
    {Parameter Feature : Type*} [Fintype Feature]
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (cost : Feature → Feature → ℝ) : Parameter → Feature → PMF Feature :=
  fun parameter =>
    uniformStrategicResponseKernel
      (randomizedBinaryScore negativeScore positiveScore (classifier parameter)) cost

@[simp] theorem uniformRandomizedClassifierResponseFamily_support
    {Parameter Feature : Type*} [Fintype Feature]
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (cost : Feature → Feature → ℝ)
    (parameter : Parameter) (initial chosen : Feature) :
    chosen ∈
        (uniformRandomizedClassifierResponseFamily
          negativeScore positiveScore classifier cost parameter initial).support ↔
      IsStrategicBestResponse
        (randomizedBinaryScore negativeScore positiveScore (classifier parameter))
        cost initial chosen := by
  exact uniformStrategicResponseKernel_support
    (randomizedBinaryScore negativeScore positiveScore (classifier parameter))
    cost initial chosen

theorem uniformRandomizedClassifierResponseFamily_spec
    {Parameter Feature : Type*} [Fintype Feature]
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (cost : Feature → Feature → ℝ) (parameter : Parameter) :
    IsStrategicBestResponseKernel
      (randomizedBinaryScore negativeScore positiveScore (classifier parameter)) cost
      (uniformRandomizedClassifierResponseFamily
        negativeScore positiveScore classifier cost parameter) :=
  uniformStrategicResponseKernel_spec
    (randomizedBinaryScore negativeScore positiveScore (classifier parameter)) cost

/-!
## Parameter-indexed response welfare

The observable performative data law forgets agent identity and its original
feature.  Welfare calculations instead use the joint response trace from
`StrategicResponseWelfare`, retaining enough information to evaluate realized
manipulation cost and strategic utility under randomized response families.
-/

/-- Population expected realized score under one parameter-indexed response family. -/
noncomputable def agentPerformativeExpectedResponseScore
    {Parameter Agent Label Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Label] [DecidableEq Label]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Label)) (score : Parameter → Feature → ℝ)
    (response : Parameter → Agent → PMF Feature) (parameter : Parameter) : ℝ :=
  agentPopulationExpectedResponseScore baseLaw (score parameter)
    (response parameter)

/-- Population expected realized manipulation cost under a response family. -/
noncomputable def agentPerformativeExpectedManipulationCost
    {Parameter Agent AgentType Label Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Label] [DecidableEq Label]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Label))
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (response : Parameter → Agent → PMF Feature) (parameter : Parameter) : ℝ :=
  agentPopulationExpectedManipulationCost baseLaw environment
    (response parameter)

/-- Population expected strategic utility under a parameter-indexed response family. -/
noncomputable def agentPerformativeExpectedResponseUtility
    {Parameter Agent AgentType Label Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Label] [DecidableEq Label]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Label)) (score : Parameter → Feature → ℝ)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (response : Parameter → Agent → PMF Feature) (parameter : Parameter) : ℝ :=
  agentPopulationExpectedResponseUtility baseLaw (score parameter) environment
    (response parameter)

/-- Positive-label realized response burden at one deployed parameter. -/
noncomputable def agentPerformativeResponseSocialBurden
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (response : Parameter → Agent → PMF Feature) (parameter : Parameter) : ℝ :=
  agentResponseSocialBurden baseLaw environment (response parameter)

/-- Positive-label realized response burden for one economic agent type. -/
noncomputable def agentTypePerformativeResponseSocialBurden
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent] [DecidableEq AgentType]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (response : Parameter → Agent → PMF Feature)
    (parameter : Parameter) (agentType : AgentType) : ℝ :=
  agentTypeResponseSocialBurden baseLaw environment (response parameter) agentType

/-- Difference in realized response burden between two types at one parameter. -/
noncomputable def agentTypePerformativeResponseSocialGap
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent] [DecidableEq AgentType]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (response : Parameter → Agent → PMF Feature)
    (parameter : Parameter) (first second : AgentType) : ℝ :=
  agentTypePerformativeResponseSocialBurden
      baseLaw environment response parameter second -
    agentTypePerformativeResponseSocialBurden
      baseLaw environment response parameter first

/-- Performative expected utility is score minus realized manipulation cost. -/
theorem agentPerformativeExpectedResponseUtility_eq_score_sub_cost
    {Parameter Agent AgentType Label Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Label] [DecidableEq Label]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Label)) (score : Parameter → Feature → ℝ)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (response : Parameter → Agent → PMF Feature) (parameter : Parameter) :
    agentPerformativeExpectedResponseUtility
        baseLaw score environment response parameter =
      agentPerformativeExpectedResponseScore baseLaw score response parameter -
        agentPerformativeExpectedManipulationCost
          baseLaw environment response parameter :=
  agentPopulationExpectedResponseUtility_eq_score_sub_cost
    baseLaw (score parameter) environment (response parameter)

/--
Expected utility is invariant across any two parameter-indexed best-response
families, even when their induced observable laws and manipulation costs differ.
-/
theorem agentPerformativeExpectedResponseUtility_eq_of_bestResponseFamilies
    {Parameter Agent AgentType Label Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Label] [DecidableEq Label]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Label)) (score : Parameter → Feature → ℝ)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (first second : Parameter → Agent → PMF Feature)
    (hfirst : ∀ parameter,
      IsAgentStrategicBestResponseKernel
        (score parameter) environment (first parameter))
    (hsecond : ∀ parameter,
      IsAgentStrategicBestResponseKernel
        (score parameter) environment (second parameter))
    (parameter : Parameter) :
    agentPerformativeExpectedResponseUtility
        baseLaw score environment first parameter =
      agentPerformativeExpectedResponseUtility
        baseLaw score environment second parameter :=
  agentPopulationExpectedResponseUtility_eq_of_bestResponseKernels
    baseLaw (score parameter) environment (first parameter) (second parameter)
    (hfirst parameter) (hsecond parameter)

/--
Across best-response response families, the population score change equals the
population manipulation-cost change at every parameter.
-/
theorem agentPerformativeExpectedResponseScore_sub_eq_cost_sub_of_bestResponseFamilies
    {Parameter Agent AgentType Label Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Label] [DecidableEq Label]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Label)) (score : Parameter → Feature → ℝ)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (first second : Parameter → Agent → PMF Feature)
    (hfirst : ∀ parameter,
      IsAgentStrategicBestResponseKernel
        (score parameter) environment (first parameter))
    (hsecond : ∀ parameter,
      IsAgentStrategicBestResponseKernel
        (score parameter) environment (second parameter))
    (parameter : Parameter) :
    agentPerformativeExpectedResponseScore baseLaw score first parameter -
        agentPerformativeExpectedResponseScore baseLaw score second parameter =
      agentPerformativeExpectedManipulationCost
          baseLaw environment first parameter -
        agentPerformativeExpectedManipulationCost
          baseLaw environment second parameter :=
  agentPopulationExpectedResponseScore_sub_eq_cost_sub_of_bestResponseKernels
    baseLaw (score parameter) environment (first parameter) (second parameter)
    (hfirst parameter) (hsecond parameter)

/-- Selected and uniform best-response tie breaking give equal population utility. -/
theorem selectedRandomizedClassifierAgentPerformativeExpectedUtility_eq_uniform
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (parameter : Parameter) :
    agentPerformativeExpectedResponseUtility baseLaw
        (fun deployed => randomizedBinaryScore negativeScore positiveScore
          (classifier deployed)) environment
        (selectedRandomizedClassifierAgentResponseFamily
          negativeScore positiveScore classifier environment) parameter =
      agentPerformativeExpectedResponseUtility baseLaw
        (fun deployed => randomizedBinaryScore negativeScore positiveScore
          (classifier deployed)) environment
        (uniformRandomizedClassifierAgentResponseFamily
          negativeScore positiveScore classifier environment) parameter := by
  apply agentPerformativeExpectedResponseUtility_eq_of_bestResponseFamilies
  · exact selectedRandomizedClassifierAgentResponseFamily_spec
      negativeScore positiveScore classifier environment
  · exact uniformRandomizedClassifierAgentResponseFamily_spec
      negativeScore positiveScore classifier environment

/--
For selected versus uniform classifier best responses, the population score
difference is exactly the population manipulation-cost difference.
-/
theorem selectedRandomizedClassifierAgentPerformativeExpectedScore_sub_eq_cost_sub_uniform
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (parameter : Parameter) :
    agentPerformativeExpectedResponseScore baseLaw
        (fun deployed => randomizedBinaryScore negativeScore positiveScore
          (classifier deployed))
        (selectedRandomizedClassifierAgentResponseFamily
          negativeScore positiveScore classifier environment) parameter -
      agentPerformativeExpectedResponseScore baseLaw
        (fun deployed => randomizedBinaryScore negativeScore positiveScore
          (classifier deployed))
        (uniformRandomizedClassifierAgentResponseFamily
          negativeScore positiveScore classifier environment) parameter =
    agentPerformativeExpectedManipulationCost baseLaw environment
        (selectedRandomizedClassifierAgentResponseFamily
          negativeScore positiveScore classifier environment) parameter -
      agentPerformativeExpectedManipulationCost baseLaw environment
        (uniformRandomizedClassifierAgentResponseFamily
          negativeScore positiveScore classifier environment) parameter := by
  apply agentPerformativeExpectedResponseScore_sub_eq_cost_sub_of_bestResponseFamilies
  · exact selectedRandomizedClassifierAgentResponseFamily_spec
      negativeScore positiveScore classifier environment
  · exact uniformRandomizedClassifierAgentResponseFamily_spec
      negativeScore positiveScore classifier environment

/-- Conditional probability that a randomized classifier predicts the binary label correctly. -/
noncomputable def randomizedBinaryCorrectness
    {Parameter Feature : Type*}
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (datum : Feature × Bool) (parameter : Parameter) : ℝ :=
  if datum.2 then acceptanceProbability (classifier parameter) datum.1
  else 1 - acceptanceProbability (classifier parameter) datum.1

/-- Conditional zero-one loss of a randomized classifier. -/
noncomputable def randomizedBinaryMisclassificationLoss
    {Parameter Feature : Type*}
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (datum : Feature × Bool) (parameter : Parameter) : ℝ :=
  1 - randomizedBinaryCorrectness classifier datum parameter

/--
A randomized classifier paired with an arbitrary heterogeneous response
kernel, viewed as a performative model.  Best-response optimality is a
separate property of the kernel, so the data-law and risk identities below
also apply to behavioral or empirically estimated response maps.
-/
noncomputable def randomizedClassifierAgentPerformativeModel
    {Parameter Agent Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (response : Parameter → Agent → PMF Feature) :
    FinitePerformativeModel Parameter (Feature × Bool) :=
  agentStrategicPerformativeModel baseLaw response
    (randomizedBinaryMisclassificationLoss classifier)

@[simp] theorem randomizedClassifierAgentPerformativeModel_dataLaw
    {Parameter Agent Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (response : Parameter → Agent → PMF Feature)
    (parameter : Parameter) :
    (randomizedClassifierAgentPerformativeModel
      baseLaw classifier response).dataLaw parameter =
      inducedAgentStrategicDataLaw baseLaw (response parameter) :=
  rfl

/-- Zero-one performative risk is the complement of induced randomized accuracy. -/
theorem performativeRisk_randomizedClassifierAgentPerformativeModel
    {Parameter Agent Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (response : Parameter → Agent → PMF Feature)
    (parameter : Parameter) :
    performativeRisk
        (randomizedClassifierAgentPerformativeModel
          baseLaw classifier response) parameter =
      1 - randomizedAgentStrategicAccuracy baseLaw (classifier parameter)
        (response parameter) := by
  unfold performativeRisk randomizedClassifierAgentPerformativeModel
    agentStrategicPerformativeModel randomizedBinaryMisclassificationLoss
    randomizedBinaryCorrectness randomizedAgentStrategicAccuracy
  rw [pmfExp_sub, pmfExp_const]

/-- The arbitrary-response diagonal objective in leader--follower notation. -/
noncomputable def randomizedClassifierAgentStackelbergRisk
    {Parameter Agent Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (response : Parameter → Agent → PMF Feature)
    (parameter : Parameter) : ℝ :=
  agentStackelbergRisk baseLaw response
    (randomizedBinaryMisclassificationLoss classifier) parameter

@[simp] theorem randomizedClassifierAgentStackelbergRisk_eq_performativeRisk
    {Parameter Agent Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (response : Parameter → Agent → PMF Feature)
    (parameter : Parameter) :
    randomizedClassifierAgentStackelbergRisk
        baseLaw classifier response parameter =
      performativeRisk
        (randomizedClassifierAgentPerformativeModel
          baseLaw classifier response) parameter :=
  rfl

theorem randomizedClassifierAgentStackelbergRisk_eq_one_sub_accuracy
    {Parameter Agent Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (response : Parameter → Agent → PMF Feature)
    (parameter : Parameter) :
    randomizedClassifierAgentStackelbergRisk
        baseLaw classifier response parameter =
      1 - randomizedAgentStrategicAccuracy baseLaw (classifier parameter)
        (response parameter) := by
  rw [randomizedClassifierAgentStackelbergRisk_eq_performativeRisk,
    performativeRisk_randomizedClassifierAgentPerformativeModel]

/--
The performative model induced by full-support uniform tie-breaking among all
