/--
The performative model generated by the selected responses of a heterogeneous
population.  The base law retains agent identity and label, while the learner
observes only the post-response feature and the unchanged label.
-/
noncomputable def selectedRandomizedClassifierAgentPerformativeModel
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature) :
    FinitePerformativeModel Parameter (Feature × Bool) :=
  agentStrategicPerformativeModel baseLaw
    (selectedRandomizedClassifierAgentResponseFamily
      negativeScore positiveScore classifier environment)
    (randomizedBinaryMisclassificationLoss classifier)

@[simp] theorem selectedRandomizedClassifierAgentPerformativeModel_dataLaw
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (parameter : Parameter) :
    (selectedRandomizedClassifierAgentPerformativeModel
      baseLaw negativeScore positiveScore classifier environment).dataLaw parameter =
      inducedAgentStrategicDataLaw baseLaw
        (selectedRandomizedClassifierAgentResponseFamily
          negativeScore positiveScore classifier environment parameter) :=
  rfl

/--
The heterogeneous-agent performative risk is one minus accuracy under the
same selected response law.
-/
theorem performativeRisk_selectedRandomizedClassifierAgentPerformativeModel
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (parameter : Parameter) :
    performativeRisk
        (selectedRandomizedClassifierAgentPerformativeModel
          baseLaw negativeScore positiveScore classifier environment) parameter =
      1 - randomizedAgentStrategicAccuracy baseLaw (classifier parameter)
        (selectedRandomizedClassifierAgentResponseFamily
          negativeScore positiveScore classifier environment parameter) := by
  unfold performativeRisk selectedRandomizedClassifierAgentPerformativeModel
    agentStrategicPerformativeModel randomizedBinaryMisclassificationLoss
    randomizedBinaryCorrectness randomizedAgentStrategicAccuracy
  rw [pmfExp_sub, pmfExp_const]

/-- The heterogeneous leader--follower objective for the selected response family. -/
noncomputable def selectedRandomizedClassifierAgentStackelbergRisk
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (parameter : Parameter) : ℝ :=
  agentStackelbergRisk baseLaw
    (selectedRandomizedClassifierAgentResponseFamily
      negativeScore positiveScore classifier environment)
    (randomizedBinaryMisclassificationLoss classifier) parameter

theorem selectedRandomizedClassifierAgentStackelbergRisk_eq_performativeRisk
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (parameter : Parameter) :
    selectedRandomizedClassifierAgentStackelbergRisk
        baseLaw negativeScore positiveScore classifier environment parameter =
      performativeRisk
        (selectedRandomizedClassifierAgentPerformativeModel
          baseLaw negativeScore positiveScore classifier environment) parameter :=
  rfl

/-- Heterogeneous Stackelberg risk is exactly one minus induced accuracy. -/
theorem selectedRandomizedClassifierAgentStackelbergRisk_eq_one_sub_accuracy
    {Parameter Agent AgentType Feature : Type*}
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (environment : StrategicAgentEnvironment Agent AgentType Feature)
    (parameter : Parameter) :
    selectedRandomizedClassifierAgentStackelbergRisk
        baseLaw negativeScore positiveScore classifier environment parameter =
      1 - randomizedAgentStrategicAccuracy baseLaw (classifier parameter)
        (selectedRandomizedClassifierAgentResponseFamily
          negativeScore positiveScore classifier environment parameter) := by
  rw [selectedRandomizedClassifierAgentStackelbergRisk_eq_performativeRisk,
    performativeRisk_selectedRandomizedClassifierAgentPerformativeModel]

/--
The performative model generated by finite-agent best responses to a deployed
randomized classifier.
-/
