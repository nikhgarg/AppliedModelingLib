    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (cost : Feature → Feature → ℝ) :
    FinitePerformativeModel Parameter (Feature × Bool) :=
  strategicPerformativeModel baseLaw
    (selectedRandomizedClassifierResponseFamily
      negativeScore positiveScore classifier cost)
    (randomizedBinaryMisclassificationLoss classifier)

@[simp] theorem selectedRandomizedClassifierPerformativeModel_dataLaw
    {Parameter Feature : Type*}
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Feature × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (cost : Feature → Feature → ℝ) (parameter : Parameter) :
    (selectedRandomizedClassifierPerformativeModel
      baseLaw negativeScore positiveScore classifier cost).dataLaw parameter =
      inducedStrategicDataLaw baseLaw
        (selectedRandomizedClassifierResponseFamily
          negativeScore positiveScore classifier cost parameter) :=
  rfl

/-- The model's performative risk is one minus its strategically induced accuracy. -/
theorem performativeRisk_selectedRandomizedClassifierPerformativeModel
    {Parameter Feature : Type*}
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Feature × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (cost : Feature → Feature → ℝ) (parameter : Parameter) :
    performativeRisk
        (selectedRandomizedClassifierPerformativeModel
          baseLaw negativeScore positiveScore classifier cost) parameter =
      1 - randomizedStrategicAccuracy baseLaw (classifier parameter)
        (selectedRandomizedClassifierResponseFamily
          negativeScore positiveScore classifier cost parameter) := by
  unfold performativeRisk selectedRandomizedClassifierPerformativeModel
    strategicPerformativeModel randomizedBinaryMisclassificationLoss
    randomizedBinaryCorrectness randomizedStrategicAccuracy
  rw [pmfExp_sub, pmfExp_const]

/-- The same diagonal objective, named in its leader--follower interpretation. -/
