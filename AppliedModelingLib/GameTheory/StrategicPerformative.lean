/-- Deterministic classifiers embed into the selected randomized-classifier model. -/
noncomputable def selectedDeterministicClassifierPerformativeModel
    {Parameter Feature : Type*}
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Feature × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → BinaryClassifier Feature)
    (cost : Feature → Feature → ℝ) :
    FinitePerformativeModel Parameter (Feature × Bool) :=
  selectedRandomizedClassifierPerformativeModel baseLaw negativeScore positiveScore
    (fun parameter => deterministicAsRandomized (classifier parameter)) cost

/--
For deterministic classifiers, performative zero-one risk is the complement
of the strategic-classification jury accuracy under the same selected response.
-/
theorem performativeRisk_selectedDeterministicClassifierPerformativeModel
    {Parameter Feature : Type*}
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Feature × Bool))
    (negativeScore positiveScore : ℝ)
    (classifier : Parameter → BinaryClassifier Feature)
    (cost : Feature → Feature → ℝ) (parameter : Parameter) :
    performativeRisk
        (selectedDeterministicClassifierPerformativeModel
          baseLaw negativeScore positiveScore classifier cost) parameter =
      1 - strategicAccuracy baseLaw (classifier parameter)
        (selectedRandomizedClassifierResponse negativeScore positiveScore
          (deterministicAsRandomized (classifier parameter)) cost) := by
  rw [selectedDeterministicClassifierPerformativeModel,
    performativeRisk_selectedRandomizedClassifierPerformativeModel]
  simp [selectedRandomizedClassifierResponseFamily,
    selectedRandomizedClassifierResponseKernel]

/--
Agent-level response transport stability lifts to transport sensitivity of the
observable strategic performative model.  The common population draw couples
agent identity and label exactly, so the lift loses no constant.
-/
theorem agentStrategicPerformativeModel_finiteTransportSensitive_of_response
    {Parameter Agent Feature Label : Type*}
    [MetricSpace Parameter] [MetricSpace Feature] [MetricSpace Label]
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    [Fintype Label] [DecidableEq Label]
    (baseLaw : PMF (Agent × Label))
    (response : Parameter → Agent → PMF Feature)
    (loss : (Feature × Label) → Parameter → ℝ) (sensitivity : ℝ)
    (hresponse : IsAgentResponseTransportSensitive response sensitivity) :
    IsFiniteTransportSensitive
      (agentStrategicPerformativeModel baseLaw response loss) sensitivity := by
  intro first second
  simpa [agentStrategicPerformativeModel] using
    (inducedAgentStrategicDataLaw_hasExpectedCostLE baseLaw
      (response first) (response second) (sensitivity * dist first second)
      (fun agent => hresponse first second agent))

/-- The same primitive response condition implies finite Wasserstein sensitivity. -/
theorem agentStrategicPerformativeModel_finiteWassersteinSensitive_of_response
    {Parameter Agent Feature Label : Type*}
    [MetricSpace Parameter] [MetricSpace Feature] [MetricSpace Label]
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    [Fintype Label] [DecidableEq Label]
    (baseLaw : PMF (Agent × Label))
    (response : Parameter → Agent → PMF Feature)
    (loss : (Feature × Label) → Parameter → ℝ) (sensitivity : ℝ)
    (hresponse : IsAgentResponseTransportSensitive response sensitivity) :
    IsFiniteWassersteinSensitive
      (agentStrategicPerformativeModel baseLaw response loss) sensitivity :=
  IsFiniteWassersteinSensitive.of_finiteTransportSensitive _
    (agentStrategicPerformativeModel_finiteTransportSensitive_of_response
      baseLaw response loss sensitivity hresponse)

/--
Pointwise Lipschitz deterministic strategic behavior therefore supplies the
distribution-sensitivity premise used by performative convergence theorems.
-/
theorem agentStrategicPerformativeModel_finiteTransportSensitive_of_deterministic_lipschitz
    {Parameter Agent Feature Label : Type*}
    [MetricSpace Parameter] [MetricSpace Feature] [MetricSpace Label]
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    [Fintype Label] [DecidableEq Label]
    (baseLaw : PMF (Agent × Label))
    (response : Parameter → Agent → Feature)
    (loss : (Feature × Label) → Parameter → ℝ) (sensitivity : NNReal)
    (hresponse : ∀ agent,
      LipschitzWith sensitivity (fun parameter => response parameter agent)) :
    IsFiniteTransportSensitive
      (agentStrategicPerformativeModel baseLaw
        (fun parameter => deterministicAgentResponseKernel (response parameter)) loss)
      (sensitivity : ℝ) :=
  agentStrategicPerformativeModel_finiteTransportSensitive_of_response
    baseLaw (fun parameter => deterministicAgentResponseKernel (response parameter))
    loss (sensitivity : ℝ)
    (isAgentResponseTransportSensitive_deterministicAgentResponseKernel
      response sensitivity hresponse)

/-- Homogeneous strategic response families inherit the same transport coefficient. -/
theorem strategicPerformativeModel_finiteTransportSensitive_of_response
    {Parameter Feature Label : Type*}
    [MetricSpace Parameter] [MetricSpace Feature] [MetricSpace Label]
    [Fintype Feature] [DecidableEq Feature]
    [Fintype Label] [DecidableEq Label]
    (baseLaw : PMF (Feature × Label))
    (response : Parameter → Feature → PMF Feature)
    (loss : (Feature × Label) → Parameter → ℝ) (sensitivity : ℝ)
    (hresponse : IsAgentResponseTransportSensitive response sensitivity) :
    IsFiniteTransportSensitive
      (strategicPerformativeModel baseLaw response loss) sensitivity := by
  simpa only [agentStrategicPerformativeModel_featureAgents] using
    (agentStrategicPerformativeModel_finiteTransportSensitive_of_response
      baseLaw response loss sensitivity hresponse)

/-- Homogeneous transport sensitivity also yields Wasserstein sensitivity. -/
theorem strategicPerformativeModel_finiteWassersteinSensitive_of_response
    {Parameter Feature Label : Type*}
    [MetricSpace Parameter] [MetricSpace Feature] [MetricSpace Label]
    [Fintype Feature] [DecidableEq Feature]
    [Fintype Label] [DecidableEq Label]
    (baseLaw : PMF (Feature × Label))
    (response : Parameter → Feature → PMF Feature)
    (loss : (Feature × Label) → Parameter → ℝ) (sensitivity : ℝ)
    (hresponse : IsAgentResponseTransportSensitive response sensitivity) :
    IsFiniteWassersteinSensitive
      (strategicPerformativeModel baseLaw response loss) sensitivity :=
  IsFiniteWassersteinSensitive.of_finiteTransportSensitive _
    (strategicPerformativeModel_finiteTransportSensitive_of_response
      baseLaw response loss sensitivity hresponse)

/--
An arbitrary randomized-classifier response model is transport-sensitive as
soon as its agent response family satisfies the primitive transport condition.
-/
theorem randomizedClassifierAgentPerformativeModel_finiteTransportSensitive
    {Parameter Agent Feature : Type*}
    [MetricSpace Parameter] [MetricSpace Feature]
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (response : Parameter → Agent → PMF Feature) (sensitivity : ℝ)
    (hresponse : IsAgentResponseTransportSensitive response sensitivity) :
    IsFiniteTransportSensitive
      (randomizedClassifierAgentPerformativeModel baseLaw classifier response)
      sensitivity := by
  exact agentStrategicPerformativeModel_finiteTransportSensitive_of_response
    baseLaw response (randomizedBinaryMisclassificationLoss classifier)
    sensitivity hresponse

/-- The randomized-classifier model consequently satisfies finite Wasserstein sensitivity. -/
theorem randomizedClassifierAgentPerformativeModel_finiteWassersteinSensitive
    {Parameter Agent Feature : Type*}
    [MetricSpace Parameter] [MetricSpace Feature]
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    (baseLaw : PMF (Agent × Bool))
    (classifier : Parameter → RandomizedBinaryClassifier Feature)
    (response : Parameter → Agent → PMF Feature) (sensitivity : ℝ)
    (hresponse : IsAgentResponseTransportSensitive response sensitivity) :
    IsFiniteWassersteinSensitive
      (randomizedClassifierAgentPerformativeModel baseLaw classifier response)
      sensitivity :=
  IsFiniteWassersteinSensitive.of_finiteTransportSensitive _
    (randomizedClassifierAgentPerformativeModel_finiteTransportSensitive
      baseLaw classifier response sensitivity hresponse)

/--
End-to-end repeated-risk-minimization convergence for a strategic population.
Agent-level transport stability supplies the performative distribution-shift
coefficient; joint gradient smoothness, pointwise strong convexity, and the
strict `sensitivity * smoothness / modulus < 1` condition then give a unique
domain-stable point and the geometric retraining rate.
-/
theorem agentStrategicPerformativeModel_rrmOn_convergesLinearly_of_responseTransportSensitive
    {Parameter Agent Feature Label : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter]
    [MetricSpace Feature] [MetricSpace Label]
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    [Fintype Label] [DecidableEq Label]
    (baseLaw : PMF (Agent × Label))
    (response : Parameter → Agent → PMF Feature)
    (loss : (Feature × Label) → Parameter → ℝ)
    (gradient : (Feature × Label) → Parameter → Parameter)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => loss datum parameter)
        (gradient datum evaluated) evaluated)
    {smoothness : NNReal} (hjoint : IsJointlySmoothGradient gradient smoothness)
    {sensitivity modulus : ℝ} (hsensitivity : 0 ≤ sensitivity)
    (hresponse : IsAgentResponseTransportSensitive response sensitivity)
    (hmodulus : 0 < modulus)
    (hstrong : IsPointwiseGradientStronglyConvex
      (agentStrategicPerformativeModel baseLaw response loss) gradient modulus)
    (domain : Set Parameter) (hclosed : IsClosed domain) (hconvex : Convex ℝ domain)
    (update : Parameter → Parameter)
    (hrrm : IsRepeatedRiskMinimizationOn
      (agentStrategicPerformativeModel baseLaw response loss) domain update)
    (hfactor : sensitivity * (smoothness : ℝ) / modulus < 1)
    (initial : Parameter) (hinitial : initial ∈ domain) :
    ∃ stable ∈ domain,
      IsPerformativelyStableOn
        (agentStrategicPerformativeModel baseLaw response loss) domain stable ∧
      (∀ other ∈ domain,
        IsPerformativelyStableOn
          (agentStrategicPerformativeModel baseLaw response loss) domain other →
          other = stable) ∧
      Filter.Tendsto (fun iteration => update^[iteration] initial)
        Filter.atTop (nhds stable) ∧
      ∀ iteration, ‖update^[iteration] initial - stable‖ ≤
        (sensitivity * (smoothness : ℝ) / modulus) ^ iteration *
          ‖initial - stable‖ := by
  let model := agentStrategicPerformativeModel baseLaw response loss
  have hsensitive : IsFiniteTransportSensitive model sensitivity := by
    exact agentStrategicPerformativeModel_finiteTransportSensitive_of_response
      baseLaw response loss sensitivity hresponse
  have hdistance : ∀ first ∈ domain, ∀ second ∈ domain,
      ‖update first - update second‖ ≤
        (sensitivity * (smoothness : ℝ) / modulus) * ‖first - second‖ := by
    intro first hfirst second hsecond
    exact rrm_distance_le_on_of_strongConvex_firstOrder_transport
      model gradient hjoint.2 hsensitivity hmodulus hsensitive hstrong
      domain update hrrm
      (fun deployed hdeployed =>
        isFrozenFirstOrderOptimal_on_of_hasGradientAt
          model gradient hgradientAt domain hconvex deployed (update deployed)
          (hrrm deployed hdeployed))
      first second hfirst hsecond
  have hcoefficient_nonneg :
      0 ≤ sensitivity * (smoothness : ℝ) / modulus := by positivity
  let factor : NNReal :=
    ⟨sensitivity * (smoothness : ℝ) / modulus, hcoefficient_nonneg⟩
  have hfactor_lt : factor < 1 := by simpa [factor] using hfactor
  have hdistance' : ∀ first ∈ domain, ∀ second ∈ domain,
      dist (update first) (update second) ≤ (factor : ℝ) * dist first second := by
    intro first hfirst second hsecond
    simpa only [factor, NNReal.coe_mk, dist_eq_norm] using
      hdistance first hfirst second hsecond
  have hstableFixed : ∀ parameter,
      IsPerformativelyStableOn model domain parameter → update parameter = parameter := by
    intro parameter hstable
    have hunique : ∀ deployed ∈ domain, ∀ first second,
        IsPopulationRiskMinimizerOn model domain (model.dataLaw deployed) first →
          IsPopulationRiskMinimizerOn model domain (model.dataLaw deployed) second →
          first = second := by
      intro deployed hdeployed first second hfirst hsecond
      exact populationRiskMinimizerOn_unique_of_strongConvex_firstOrder
        model gradient hmodulus hstrong domain deployed first second hfirst hsecond
        (isFrozenFirstOrderOptimal_on_of_hasGradientAt
          model gradient hgradientAt domain hconvex deployed first hfirst).2
    exact retrainingOn_fixedPoint_of_isPerformativelyStableOn_of_uniqueMinimizer
      model domain update hrrm hunique hstable
  have hconvergence :=
    repeatedRiskMinimizationOn_convergesLinearly_of_distanceBound
      model domain hclosed update hrrm factor hfactor_lt hdistance'
      hstableFixed initial hinitial
  simpa only [model, factor, NNReal.coe_mk, dist_eq_norm] using hconvergence

/--
Deterministic-response specialization with the primitive assumption exposed at
the theorem boundary: each named agent's feature response is Lipschitz in the
deployed parameter.  No separate distribution-map sensitivity certificate is
required from the caller.
-/
theorem agentStrategicPerformativeModel_rrmOn_convergesLinearly_of_deterministicResponseLipschitz
    {Parameter Agent Feature Label : Type*}
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter]
    [MetricSpace Feature] [MetricSpace Label]
    [Fintype Agent] [DecidableEq Agent]
    [Fintype Feature] [DecidableEq Feature]
    [Fintype Label] [DecidableEq Label]
    (baseLaw : PMF (Agent × Label))
    (response : Parameter → Agent → Feature)
    (loss : (Feature × Label) → Parameter → ℝ)
    (gradient : (Feature × Label) → Parameter → Parameter)
    (hgradientAt : ∀ datum evaluated,
      HasGradientAt (fun parameter => loss datum parameter)
        (gradient datum evaluated) evaluated)
    {smoothness responseSensitivity : NNReal}
    (hjoint : IsJointlySmoothGradient gradient smoothness)
    (hresponse : ∀ agent,
      LipschitzWith responseSensitivity (fun parameter => response parameter agent))
    {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : IsPointwiseGradientStronglyConvex
      (agentStrategicPerformativeModel baseLaw
        (fun parameter => deterministicAgentResponseKernel (response parameter)) loss)
      gradient modulus)
    (domain : Set Parameter) (hclosed : IsClosed domain) (hconvex : Convex ℝ domain)
    (update : Parameter → Parameter)
    (hrrm : IsRepeatedRiskMinimizationOn
      (agentStrategicPerformativeModel baseLaw
        (fun parameter => deterministicAgentResponseKernel (response parameter)) loss)
      domain update)
    (hfactor : (responseSensitivity : ℝ) * (smoothness : ℝ) / modulus < 1)
    (initial : Parameter) (hinitial : initial ∈ domain) :
    ∃ stable ∈ domain,
      IsPerformativelyStableOn
        (agentStrategicPerformativeModel baseLaw
          (fun parameter => deterministicAgentResponseKernel (response parameter)) loss)
        domain stable ∧
      (∀ other ∈ domain,
        IsPerformativelyStableOn
          (agentStrategicPerformativeModel baseLaw
            (fun parameter => deterministicAgentResponseKernel (response parameter)) loss)
          domain other → other = stable) ∧
      Filter.Tendsto (fun iteration => update^[iteration] initial)
        Filter.atTop (nhds stable) ∧
      ∀ iteration, ‖update^[iteration] initial - stable‖ ≤
        ((responseSensitivity : ℝ) * (smoothness : ℝ) / modulus) ^ iteration *
          ‖initial - stable‖ := by
  exact
    agentStrategicPerformativeModel_rrmOn_convergesLinearly_of_responseTransportSensitive
      baseLaw
      (fun parameter => deterministicAgentResponseKernel (response parameter))
      loss gradient hgradientAt hjoint responseSensitivity.coe_nonneg
      (isAgentResponseTransportSensitive_deterministicAgentResponseKernel
        response responseSensitivity hresponse)
      hmodulus hstrong domain hclosed hconvex update hrrm hfactor initial hinitial

