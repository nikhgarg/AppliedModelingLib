  "items": {
    "defect/CGGG20-LEMMA2-INTERPOLATION-TYPO-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "726f1bfc58d9f5b892baf36134fffb9dbd4a11ec265e1dc5301b1620c61ab07a",
      "source_reading": "Appendix Lemma 5's proof defines `tau = sum_i c_i * t_i` although `t_i` is undefined, then sets `alpha = delta / (tau * rho)` after defining `delta = Upsilon(t) - upsilon`.",
      "memo_heading": "Appendix Lemma 5 interpolation display",
      "memo_anchor": "appendix-lemma-5-interpolation-display",
      "report_home": 4
    },
    "convention/CGGG20-FULL-VECTOR-POSTERIOR-SUFFICIENCY-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "726f1bfc58d9f5b892baf36134fffb9dbd4a11ec265e1dc5301b1620c61ab07a",
      "source_reading": "For every screening policy and applicant, the displayed post-screening estimate hat U_i is a version of E[U_i | sigma(hat U)], where sigma(hat U) is generated by the entire vector of post-screening estimates available to the lender. Allocation remains an arbitrary bounded Borel rule A(hat U) of that full vector.",
      "memo_heading": "Full-vector posterior reading for allocation policies",
      "memo_anchor": "full-vector-posterior-reading-for-allocation-policies",
      "report_home": 4
    },
    "defect/CGGG20-THEOREM6-THRESHOLD-DOMAIN-PROOF-GAP-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "726f1bfc58d9f5b892baf36134fffb9dbd4a11ec265e1dc5301b1620c61ab07a",
      "source_reading": "Appendix Theorem 6 applies the exact-cost witness supplied by Appendix Lemma 5 and then invokes Appendix Lemma 4 Case 1. Lemma 4 states that Case 1 only for a single finite threshold `t > 0`, whereas Definition 3 and Lemma 5 permit arbitrary real or infinite threshold witnesses.",
      "memo_heading": "Appendix Theorem 6 threshold-domain proof route",
      "memo_anchor": "appendix-theorem-6-threshold-domain-proof-route",
      "report_home": 4
    },
    "convention/CGGG20-STRICT-POSITIVE-ALLOCATION-COST-01": {
      "disposition": "not_material",
      "reason": "The source defines the cost-aware threshold by the ratio `hat U_i / c_i`; strict positivity is the displayed ratio and exchange argument's well-defined source domain rather than a separate premise added to a selected conclusion. A zero-cost extension would require a different ratio convention and is not asserted by the displayed definition."
    },
    "convention/CGGG20-EXOGENOUS-SCREENING-RANDOMIZATION-01": {
      "disposition": "not_material",
      "reason": "The source fixes latent utilities/information before independent screening coins reveal information; the sequential model is unchanged."
    }
  },
