          model rank ≤
        paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_price
          model lastRank
  | _ :: tail, lastRank =>
      paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_last_threshold_le
        model tail lastRank

/-- Appending to the empty schedule has no boundary threshold check. -/
theorem paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_last_threshold_le_nil
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
