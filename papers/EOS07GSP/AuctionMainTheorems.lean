/-- Clock-sorted finite exact-drop schedules: the current clock is at most the
next rank's threshold, and thresholds are weakly increasing along the list. -/
noncomputable def paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_clock_sorted
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate) :
    ℝ → List ℕ → Prop
  | _clock, [] => True
  | clock, rank :: tail =>
      clock ≤
          paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_price
            model rank ∧
        paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_clock_sorted
          model
          (paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_price
            model rank)
          tail

/-- The empty exact-drop schedule is clock-sorted. -/
theorem paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_clock_sorted_nil
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    (clock : ℝ) :
