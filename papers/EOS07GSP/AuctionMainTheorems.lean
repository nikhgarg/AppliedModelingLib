  induction scheduledPrefix generalizing state with
  | nil =>
      simpa using
        paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_final_state_clock_singleton
          model state lastRank
  | cons head tail ih =>
      simpa [paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_final_state]
        using
          ih
            (paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_next_state
              model state head)

/--
Terminality for a nonempty exact-drop schedule can be checked against the last
scheduled threshold instead of the recursively computed final state. This is a
human-verification helper for finite paper instances.
-/
theorem paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_unscheduled_threshold_gt_of_append_singleton
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
