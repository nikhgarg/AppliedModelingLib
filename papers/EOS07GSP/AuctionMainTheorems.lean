/--
EOS Theorem 8 exact finite-`B*` dynamic-game certificate from local optimality.
Lean first derives the named local-optimality statement from the certificate and
then uses the supplied local-optimality-to-sequential-rationality bridge to
recover the unique-PBE/VCG-outcome conclusion.
-/
theorem paper_theorem8_bstar_ranked_threshold_dynamic_game_unique_pbe_of_local_optimality_extensional_outcome_certificate
    {Belief : Type*}
    (model :
      PaperTheorem8BStarRankedThresholdLocalOptimalityDynamicGameExtensionalOutcomeCertificate
        Belief) :
    paper_theorem8_bstar_ranked_threshold_local_optimality_statement
      model.localModel.clickThroughRate model.localModel.value
      model.localModel.remaining ∧
    (∀ state rank,
      paper_theorem8_ranked_threshold_dropout_strategy
          model.localModel.clickThroughRate
          (fun k =>
            paper_theorem8_bstar_threshold_bid
              model.localModel.value model.localModel.clickThroughRate
              model.localModel.remaining (k + 2))
          model.localModel.value state rank ↔
        paper_theorem8_bstar_threshold_bid
          model.localModel.value model.localModel.clickThroughRate
          (model.localModel.remaining + 1) (rank + 1) ≤ state.clockPrice) ∧
      ∃ equilibrium : PaperTheorem8GeneralizedEnglishStrategy ℕ,
        model.game.PerfectBayesianEquilibrium equilibrium ∧
          (∀ strategy,
            model.game.PerfectBayesianEquilibrium strategy →
              strategy = equilibrium) ∧
          model.game.outcomeOf equilibrium = model.game.vcgOutcome := by
  have hlocal :
      paper_theorem8_bstar_ranked_threshold_local_optimality_statement
        model.localModel.clickThroughRate model.localModel.value
        model.localModel.remaining :=
    paper_theorem8_bstar_ranked_threshold_local_optimality_statement_of_certificate
      model.localModel
  let dynamicModel :
      PaperTheorem8BStarRankedThresholdDynamicGameExtensionalOutcomeCertificate
        Belief :=
    { game := model.game
      clickThroughRate := model.localModel.clickThroughRate
      value := model.localModel.value
      remaining := model.localModel.remaining
      click_ne := fun rank => ne_of_gt (model.localModel.click_pos rank)
      game_click_eq := model.game_click_eq
      game_value_eq := model.game_value_eq
      belief := model.belief
      equilibrium_consistent := by
        simpa [paper_theorem8_bstar_threshold_bid] using
          model.equilibrium_consistent
      equilibrium_sequentially_rational := by
        simpa [paper_theorem8_bstar_threshold_bid] using
          model.local_optimality_implies_sequential_rationality hlocal
      pbe_bstar_threshold_characterization := by
        intro strategy hpbe state rank
        simpa [paper_theorem8_bstar_threshold_bid] using
          model.pbe_bstar_threshold_characterization strategy hpbe state rank
      equilibrium_same_slots_as_vcg := by
        intro i
        simpa [paper_theorem8_bstar_threshold_bid] using
          model.equilibrium_same_slots_as_vcg i
      equilibrium_same_payments_as_vcg := by
        intro i
        simpa [paper_theorem8_bstar_threshold_bid] using
          model.equilibrium_same_payments_as_vcg i }
  have hdyn :=
    paper_theorem8_bstar_ranked_threshold_dynamic_game_unique_pbe_of_extensional_outcome_certificate
      dynamicModel
  exact ⟨hlocal, by
    simpa [paper_theorem8_bstar_threshold_bid] using hdyn⟩

/--
