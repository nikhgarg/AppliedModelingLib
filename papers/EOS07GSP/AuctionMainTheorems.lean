theorem paper_theorem8_bstar_ranked_threshold_local_optimality_certificate_of_strict_ordered_local_model_eq
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    (current_lt : ∀ rank,
      model.clickThroughRate (rank + 1) < model.clickThroughRate rank)
    (value_nonneg : ∀ rank, 0 ≤ model.value rank)
    (value_mono : ∀ rank, model.value (rank + 1) ≤ model.value rank)
