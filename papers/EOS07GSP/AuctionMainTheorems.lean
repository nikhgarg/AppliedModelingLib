/--
Reduced-form strict ordered local-deviation source-completion certificate. This
validates the sharpest source-obligation interface end-to-end on the
reduced-form checker: sequential rationality is definitionally equality to the
named finite `B*` strategy, and local one-step optimality plus threshold
tie-breaking characterizes that strategy.
-/
noncomputable def paper_theorem8_bstar_ranked_threshold_strict_ordered_reduced_form_local_deviation_core_source_completion_certificate
    (terminal :
      PaperTheorem8BStarRankedThresholdTerminalHistoryBehaviorCertificate)
    (model :
      PaperTheorem8BStarRankedThresholdStrictOrderedLocalOptimalityCertificate)
    (hmodel :
      paper_theorem8_bstar_ranked_threshold_local_optimality_certificate_of_strict
          (paper_theorem8_bstar_ranked_threshold_strict_ordered_reduced_form_constructed_outcome_certificate
            model).base.strictModel =
        terminal.localModel) :
    PaperTheorem8BStarRankedThresholdStrictOrderedLocalDeviationCoreSourceCompletionCertificate
      Unit where
  integrated :=
    paper_theorem8_bstar_ranked_threshold_strict_ordered_reduced_form_terminal_dynamic_certificate
      terminal model hmodel
  concrete_belief_consistency := rfl
  one_step_best_response_implies_sequential_rationality := by
    intro _
    rfl
  sequential_rationality_iff_local_deviation := by
    intro strategy _belief
    constructor
    · intro hsequential
      rw [hsequential]
      exact
        ⟨paper_theorem8_bstar_ranked_threshold_strict_named_strategy_one_step_best_response
            (paper_theorem8_bstar_ranked_threshold_strict_ordered_reduced_form_constructed_outcome_certificate
              model).base.strictModel,
          paper_theorem8_bstar_ranked_threshold_strict_named_strategy_drop_at_threshold
            (paper_theorem8_bstar_ranked_threshold_strict_ordered_reduced_form_constructed_outcome_certificate
              model).base.strictModel⟩
    · intro hlocal
      let localModel :=
        paper_theorem8_bstar_ranked_threshold_local_optimality_certificate_of_strict
          (paper_theorem8_bstar_ranked_threshold_strict_ordered_reduced_form_constructed_outcome_certificate
            model).base.strictModel
      have hstrategy :=
        paper_theorem8_bstar_ranked_threshold_strategy_eq_of_one_step_best_response_and_drop_at_threshold
          localModel
          (by
            simpa [localModel,
              paper_theorem8_bstar_ranked_threshold_local_optimality_certificate_of_strict] using
              hlocal.1)
          (by
            simpa [localModel,
              paper_theorem8_bstar_ranked_threshold_local_optimality_certificate_of_strict] using
              hlocal.2)
      simpa [localModel,
        paper_theorem8_bstar_ranked_threshold_local_optimality_certificate_of_strict] using
        hstrategy

