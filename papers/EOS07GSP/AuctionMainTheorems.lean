/--
EOS Theorem 8 concrete ranked-threshold dynamic-game certificate form. The
equilibrium strategy drops exactly at the ranked generalized-English formula,
and the certified dynamic game has a unique PBE with VCG-equivalent outcome.
-/
theorem paper_theorem8_ranked_threshold_strategy_dynamic_game_unique_pbe_of_certificate
    {Belief : Type*}
    (model :
      PaperTheorem8RankedThresholdStrategyDynamicGameCertificate Belief) :
    (∀ state rank,
      paper_theorem8_ranked_threshold_dropout_strategy
          model.clickThroughRate model.lastDropout model.value state rank ↔
        paper_theorem8_generalized_english_ranked_dropout_price
          model.clickThroughRate model.lastDropout model.value rank ≤
            state.clockPrice) ∧
