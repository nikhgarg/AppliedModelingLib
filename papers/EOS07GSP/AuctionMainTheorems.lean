/--
Strict exact finite-`B*` generic dynamic-game PBE certificate induced by the
local-optimality extensional-outcome boundary. This packages the named
finite-`B*` strategy, its belief, sequential rationality bridge, uniqueness,
and VCG-outcome equality into the reusable abstract certificate interface.
-/
def paper_theorem8_bstar_ranked_threshold_strict_dynamic_game_pbe_certificate_of_local_optimality_extensional_outcome_certificate
    {Belief : Type*}
    (model :
      PaperTheorem8BStarRankedThresholdStrictLocalOptimalityDynamicGameExtensionalOutcomeCertificate
        Belief) :
    PaperTheorem8DynamicGamePBECertificate
      ℕ ℕ (PaperTheorem8GeneralizedEnglishStrategy ℕ) Belief where
  game := model.game
  equilibrium :=
    paper_theorem8_bstar_ranked_threshold_strategy
      model.strictModel.value model.strictModel.clickThroughRate
      model.strictModel.remaining
  belief := model.belief
  equilibrium_consistent := by
    simpa [paper_theorem8_bstar_ranked_threshold_strategy,
      paper_theorem8_bstar_threshold_bid] using
      model.equilibrium_consistent
  equilibrium_sequentially_rational := by
    let localModel :
        PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate :=
      paper_theorem8_bstar_ranked_threshold_local_optimality_certificate_of_strict
        model.strictModel
    have hlocal :
        paper_theorem8_bstar_ranked_threshold_local_optimality_statement
          model.strictModel.clickThroughRate model.strictModel.value
          model.strictModel.remaining := by
      simpa [localModel,
        paper_theorem8_bstar_ranked_threshold_local_optimality_certificate_of_strict]
        using
          paper_theorem8_bstar_ranked_threshold_local_optimality_statement_of_certificate
            localModel
    simpa [paper_theorem8_bstar_ranked_threshold_strategy,
      paper_theorem8_bstar_threshold_bid] using
      model.local_optimality_implies_sequential_rationality hlocal
  unique_pbe := by
    intro strategy hpbe
    exact
      (paper_theorem8_bstar_ranked_threshold_strict_dynamic_game_pbe_iff_strategy_eq_of_local_optimality_extensional_outcome_certificate
        model strategy).mp hpbe
  equilibrium_outcome_eq_vcg :=
    paper_theorem8_bstar_ranked_threshold_strict_dynamic_game_named_strategy_outcome_eq_vcg_of_local_optimality_extensional_outcome_certificate
      model

