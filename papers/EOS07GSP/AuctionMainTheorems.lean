      exact Or.inr
        ⟨j, s, by simpa [M, hout] using hslot, hdevslot,
          by simpa [M, hout] using hpay⟩
  exact
    paper_position_stable_assignment_locally_envy_free_equilibrium_of_deviation_slot_payment_shape
