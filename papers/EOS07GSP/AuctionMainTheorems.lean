  rcases hordered with
    ⟨_hordered_cutoff, hslot_eq, hpayment_eq, hnamed_slot, hnamed_payment,
      hvcg_slot, hvcg_payment, hnamed_tail, hnamed_bounds, hnamed_ir,
      hnamed_no_positive_transfers, hvcg_ir, hvcg_no_positive_transfers⟩
  exact
