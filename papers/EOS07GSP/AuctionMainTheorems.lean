          model.clickThroughRate model.lastDropout model.value,
        ?_, ?_, model.equilibrium_outcome_eq_vcg⟩
    · exact
        ⟨model.belief, model.equilibrium_consistent,
          model.equilibrium_sequentially_rational⟩
    · intro strategy hpbe
