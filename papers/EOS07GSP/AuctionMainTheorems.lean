  rfl

/-- A one-rank exact-drop schedule is clock-sorted exactly when the current
clock is at most that rank's threshold price. -/
theorem paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_clock_sorted_singleton
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
