          model.clickThroughRate model.value model.remaining strategy ∧
        PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory
          strategy initialState finalState ∧
          PaperTheorem8GeneralizedEnglishAuctionState.StrategyTerminal
            strategy finalState := by
  constructor
  · intro hsource
    exact
      ⟨(paper_theorem8_bstar_ranked_threshold_source_sequential_rationality_iff_local_deviation
          model.clickThroughRate model.value model.remaining initialState strategy).mp
          hsource.1,
        hsource.2.1,
        hsource.2.2⟩
  · intro hlocal
    exact
      ⟨(paper_theorem8_bstar_ranked_threshold_source_sequential_rationality_iff_local_deviation
          model.clickThroughRate model.value model.remaining initialState strategy).mpr
          hlocal.1,
        hlocal.2.1,
