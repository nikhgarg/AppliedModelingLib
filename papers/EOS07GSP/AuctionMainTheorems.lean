        model nextRank := by
  simp [paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_final_state,
    paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_next_state,
    PaperTheorem8GeneralizedEnglishAuctionState.recordDropout,
    PaperTheorem8GeneralizedEnglishAuctionState.advanceClock]

/--
Any nonempty exact-drop schedule written as `prefix ++ [lastRank]` ends with
clock price equal to the finite `B*` threshold of `lastRank`. This is the
list-level version of the singleton and pair clock lemmas, useful for checking
terminality of finite source schedules without unfolding the recursive final
state.
-/
theorem paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_final_state_clock_append_singleton
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    (state : PaperTheorem8GeneralizedEnglishAuctionState ℕ)
