  simp [paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_last_threshold_le]

/-- Boundary check for appending to a singleton schedule. -/
theorem paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_last_threshold_le_singleton
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    (rank lastRank : ℕ)
    (hle :
      paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_price
          model rank ≤
        paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_price
          model lastRank) :
    paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_last_threshold_le
      model [rank] lastRank := by
  exact hle

/-- Unfolding lemma for the append boundary check on schedules with at least
two ranks: only the tail's last threshold matters. -/
theorem paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_last_threshold_le_cons_cons_iff
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    (rank nextRank lastRank : ℕ) (tail : List ℕ) :
    paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_last_threshold_le
        model (rank :: nextRank :: tail) lastRank ↔
      paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_last_threshold_le
        model (nextRank :: tail) lastRank := by
  rfl

/--
Append one rank to an adjacent-threshold sorted exact-drop schedule. This is a
human-verification helper for building finite schedules incrementally.
-/
theorem paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_threshold_sorted_append_singleton
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate) :
    ∀ (scheduledPrefix : List ℕ) (lastRank : ℕ),
      paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_threshold_sorted
        model scheduledPrefix →
      paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_last_threshold_le
        model scheduledPrefix lastRank →
      paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_threshold_sorted
        model (scheduledPrefix ++ [lastRank]) := by
  intro scheduledPrefix
  induction scheduledPrefix with
  | nil =>
      intro lastRank _ _
      exact
        paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_threshold_sorted_singleton
          model lastRank
  | cons head tail ih =>
      intro lastRank hsorted hlast
      cases tail with
      | nil =>
          exact
            paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_threshold_sorted_pair
