  simp [paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_clock_sorted]

/-- Unfolding lemma for a nonempty clock-sorted exact-drop schedule. -/
theorem paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_clock_sorted_cons_iff
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    (clock : ℝ) (rank : ℕ) (tail : List ℕ) :
    paper_theorem8_bstar_ranked_threshold_exact_drop_schedule_clock_sorted
        model clock (rank :: tail) ↔
