  | @cons state finalState rank tailRanks hclock hactive htail ih =>
      exact
        PaperTheorem8BStarRankedThresholdExactDropHistory.trans model
          (paper_theorem8_bstar_ranked_threshold_single_exact_drop_history
            model state rank hclock hactive)
          ih

