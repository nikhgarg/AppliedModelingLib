/-- Named statement of the exact finite-`B*` strict threshold interval. -/
def paper_theorem8_bstar_ranked_threshold_strict_interval_statement
    (clickThroughRate value : ℕ → ℝ) (remaining : ℕ) : Prop :=
  ∀ rank,
    paper_theorem8_bstar_threshold_bid value clickThroughRate remaining
        (rank + 2) <
      paper_theorem8_bstar_threshold_bid value clickThroughRate
        (remaining + 1) (rank + 1) ∧
    paper_theorem8_bstar_threshold_bid value clickThroughRate
        (remaining + 1) (rank + 1) < value (rank + 1)

/-- The strict finite-`B*` certificate proves the named strict-threshold
statement. -/
theorem paper_theorem8_bstar_ranked_threshold_strict_interval_statement_of_certificate
    (model :
      PaperTheorem8BStarRankedThresholdStrictLocalOptimalityCertificate) :
    paper_theorem8_bstar_ranked_threshold_strict_interval_statement
      model.clickThroughRate model.value model.remaining := by
  simpa [paper_theorem8_bstar_ranked_threshold_strict_interval_statement,
    paper_theorem8_bstar_threshold_bid] using
    paper_theorem8_bstar_ranked_threshold_strict_interval_of_certificate model

/--
Under the strict finite `B*` certificate, the named `B*` threshold strategy does
not drop at or before the continuation finite `B*` bid.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_not_drop_at_or_before_continuation
    (model :
      PaperTheorem8BStarRankedThresholdStrictLocalOptimalityCertificate)
    (state : PaperTheorem8GeneralizedEnglishAuctionState ℕ) (rank : ℕ)
    (hclock_le :
      state.clockPrice ≤
        paper_theorem8_bstar_threshold_bid
          model.value model.clickThroughRate model.remaining (rank + 2)) :
    ¬ paper_theorem8_bstar_ranked_threshold_strategy
        model.value model.clickThroughRate model.remaining state rank := by
  have hstrict :=
    paper_theorem8_bstar_ranked_threshold_strict_interval_statement_of_certificate
      model rank
  have hdrop_iff :=
    paper_theorem8_bstar_ranked_threshold_strategy_drops_iff_threshold_bid
      model.value model.clickThroughRate state rank model.remaining
      (ne_of_gt (model.click_pos rank))
      (ne_of_gt (model.click_pos (rank + 1)))
  intro hdrop
  have hcurrent_le_clock := hdrop_iff.mp hdrop
  nlinarith [hstrict.1, hclock_le, hcurrent_le_clock]

/--
Under the strict finite `B*` certificate, the named `B*` threshold strategy has
dropped by the time the clock reaches the lower bidder's value.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_drops_at_or_after_value
    (model :
      PaperTheorem8BStarRankedThresholdStrictLocalOptimalityCertificate)
    (state : PaperTheorem8GeneralizedEnglishAuctionState ℕ) (rank : ℕ)
    (hvalue_le_clock : model.value (rank + 1) ≤ state.clockPrice) :
    paper_theorem8_bstar_ranked_threshold_strategy
        model.value model.clickThroughRate model.remaining state rank := by
  have hstrict :=
    paper_theorem8_bstar_ranked_threshold_strict_interval_statement_of_certificate
      model rank
  have hdrop_iff :=
    paper_theorem8_bstar_ranked_threshold_strategy_drops_iff_threshold_bid
      model.value model.clickThroughRate state rank model.remaining
        (ne_of_gt (model.click_pos rank))
        (ne_of_gt (model.click_pos (rank + 1)))
  exact hdrop_iff.mpr (by nlinarith [hstrict.2, hvalue_le_clock])

/--
In a strategy-consistent finite-`B*` ranked-threshold step, any rank that is
active before the step and inactive afterward must have reached its finite
`B*` threshold bid.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_step_new_dropout_threshold_le
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    {state next : PaperTheorem8GeneralizedEnglishAuctionState ℕ}
    {rank : ℕ}
    (hstep :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyStep
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) state next)
    (hactive : state.IsActive rank) (hinactive : ¬ next.IsActive rank) :
    paper_theorem8_bstar_threshold_bid
      model.value model.clickThroughRate (model.remaining + 1) (rank + 1) ≤
        state.clockPrice := by
  have hdrop :
      paper_theorem8_bstar_ranked_threshold_strategy
        model.value model.clickThroughRate model.remaining state rank :=
    PaperTheorem8GeneralizedEnglishAuctionState.StrategyStep_new_dropout_strategy
      hstep hactive hinactive
  have hdrop_iff :=
    paper_theorem8_bstar_ranked_threshold_strategy_drops_iff_threshold_bid
      model.value model.clickThroughRate state rank model.remaining
      (ne_of_gt (model.click_pos rank))
      (ne_of_gt (model.click_pos (rank + 1)))
  exact hdrop_iff.mp hdrop

/--
In a finite-`B*` ranked-threshold-strategy-consistent step, a rank that newly
becomes inactive is recorded as dropping at the previous clock price, and that
clock has reached the rank's finite `B*` threshold bid.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_step_new_dropout_record_eq_and_threshold_le
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    {state next : PaperTheorem8GeneralizedEnglishAuctionState ℕ}
    {rank : ℕ}
    (hstep :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyStep
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) state next)
    (hactive : state.IsActive rank) (hinactive : ¬ next.IsActive rank) :
    next.lastDropout rank = some state.clockPrice ∧
      paper_theorem8_bstar_threshold_bid
        model.value model.clickThroughRate (model.remaining + 1) (rank + 1) ≤
          state.clockPrice := by
  exact
    ⟨PaperTheorem8GeneralizedEnglishAuctionState.StrategyStep_new_dropout_lastDropout_eq_current_clock
        hstep hactive hinactive,
      paper_theorem8_bstar_ranked_threshold_strategy_step_new_dropout_threshold_le
        model hstep hactive hinactive⟩

/--
A strategy-consistent finite-`B*` ranked-threshold step cannot newly drop a rank
before its finite `B*` threshold bid.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_step_no_new_dropout_before_threshold
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    {state next : PaperTheorem8GeneralizedEnglishAuctionState ℕ}
    {rank : ℕ}
    (hstep :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyStep
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) state next)
    (hclock_lt :
      state.clockPrice <
        paper_theorem8_bstar_threshold_bid
          model.value model.clickThroughRate (model.remaining + 1) (rank + 1))
    (hactive : state.IsActive rank) :
    next.IsActive rank := by
  by_contra hinactive
  have hthreshold :=
    paper_theorem8_bstar_ranked_threshold_strategy_step_new_dropout_threshold_le
      model hstep hactive hinactive
  exact (not_le_of_gt hclock_lt) hthreshold

/--
A finite-`B*` ranked-threshold strategy-consistent history cannot newly drop a
rank if the final clock is still strictly below that rank's finite `B*`
threshold bid.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_history_no_new_dropout_before_threshold
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    {state finalState : PaperTheorem8GeneralizedEnglishAuctionState ℕ}
    {rank : ℕ}
    (hhist :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) state finalState)
    (hfinal_lt :
      finalState.clockPrice <
        paper_theorem8_bstar_threshold_bid
          model.value model.clickThroughRate (model.remaining + 1) (rank + 1))
    (hactive : state.IsActive rank) :
    finalState.IsActive rank := by
  induction hhist with
  | refl state =>
      exact hactive
  | cons hstep hhist ih =>
      have hstate_lt :
          _ <
            paper_theorem8_bstar_threshold_bid
              model.value model.clickThroughRate (model.remaining + 1)
              (rank + 1) :=
        lt_of_le_of_lt
          (le_trans
            (PaperTheorem8GeneralizedEnglishAuctionState.Step_clock_mono
              hstep.toStep)
            (PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory_clock_mono
              hhist))
          hfinal_lt
      have hactive_mid :
          _ :=
        paper_theorem8_bstar_ranked_threshold_strategy_step_no_new_dropout_before_threshold
          model hstep hstate_lt hactive
      exact ih hfinal_lt hactive_mid

/--
If a rank starts active but is inactive after a finite-`B*`
ranked-threshold-strategy-consistent history, the final clock has reached that
rank's finite `B*` threshold bid.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_history_new_dropout_threshold_le
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    {state finalState : PaperTheorem8GeneralizedEnglishAuctionState ℕ}
    {rank : ℕ}
    (hhist :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) state finalState)
    (hactive : state.IsActive rank) (hinactive : ¬ finalState.IsActive rank) :
    paper_theorem8_bstar_threshold_bid
      model.value model.clickThroughRate (model.remaining + 1) (rank + 1) ≤
        finalState.clockPrice := by
  by_contra hnot
  have hfinal_lt :
      finalState.clockPrice <
        paper_theorem8_bstar_threshold_bid
          model.value model.clickThroughRate (model.remaining + 1)
          (rank + 1) := not_le.mp hnot
  exact
    hinactive
      (paper_theorem8_bstar_ranked_threshold_strategy_history_no_new_dropout_before_threshold
        model hhist hfinal_lt hactive)

/--
If a rank starts active but is inactive after a finite-`B*`
ranked-threshold-strategy-consistent history, the final state contains a
concrete dropout record at some price that reached the finite `B*` threshold
bid and is no later than the final clock.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_history_new_dropout_record_exists
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    {state finalState : PaperTheorem8GeneralizedEnglishAuctionState ℕ}
    {rank : ℕ}
    (hhist :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) state finalState)
    (hactive : state.IsActive rank) (hinactive : ¬ finalState.IsActive rank) :
    ∃ price,
      finalState.lastDropout rank = some price ∧
        paper_theorem8_bstar_threshold_bid
          model.value model.clickThroughRate (model.remaining + 1) (rank + 1) ≤
            price ∧
          price ≤ finalState.clockPrice := by
  induction hhist with
  | refl state =>
      exact False.elim (hinactive hactive)
  | @cons state0 mid finalState0 hstep hhist ih =>
      by_cases hmid_active : mid.IsActive rank
      · exact ih hmid_active hinactive
      · have hrecord :=
          paper_theorem8_bstar_ranked_threshold_strategy_step_new_dropout_record_eq_and_threshold_le
            model hstep hactive hmid_active
        refine ⟨state0.clockPrice, ?_, hrecord.2, ?_⟩
        · exact
            PaperTheorem8GeneralizedEnglishAuctionState.History_lastDropout_eq_of_initial_some
              hhist.toHistory hrecord.1
        · exact
            le_trans
              (PaperTheorem8GeneralizedEnglishAuctionState.Step_clock_mono
                hstep.toStep)
              (PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory_clock_mono
                hhist)

/--
In a terminal finite-`B*` ranked-threshold-strategy-consistent history, a rank
remains active at the final state exactly when the final clock is still below
that rank's finite `B*` threshold bid.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_terminal_history_active_iff_clock_lt_threshold_bid
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    {state finalState : PaperTheorem8GeneralizedEnglishAuctionState ℕ}
    {rank : ℕ}
    (hhist :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) state finalState)
    (hterminal :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyTerminal
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) finalState)
    (hinitial_active : state.IsActive rank) :
    finalState.IsActive rank ↔
      finalState.clockPrice <
        paper_theorem8_bstar_threshold_bid
          model.value model.clickThroughRate (model.remaining + 1) (rank + 1) := by
  constructor
  · intro hactive_final
    have hnot_drop :
        ¬ paper_theorem8_bstar_ranked_threshold_strategy
            model.value model.clickThroughRate model.remaining finalState rank :=
      hterminal rank hactive_final
    have hiff :=
      paper_theorem8_bstar_ranked_threshold_strategy_not_drop_iff_clock_lt_threshold_bid
        model.value model.clickThroughRate finalState rank model.remaining
        (ne_of_gt (model.click_pos rank))
        (ne_of_gt (model.click_pos (rank + 1)))
    exact hiff.mp hnot_drop
  · intro hclock_lt
    exact
      paper_theorem8_bstar_ranked_threshold_strategy_history_no_new_dropout_before_threshold
        model hhist hclock_lt hinitial_active

/--
In a terminal finite-`B*` ranked-threshold-strategy-consistent history, a rank
is inactive at the final state exactly when the final clock has reached that
rank's finite `B*` threshold bid, provided the rank was initially active.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_terminal_history_inactive_iff_threshold_le_clock
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    {state finalState : PaperTheorem8GeneralizedEnglishAuctionState ℕ}
    {rank : ℕ}
    (hhist :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) state finalState)
    (hterminal :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyTerminal
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) finalState)
    (hinitial_active : state.IsActive rank) :
    ¬ finalState.IsActive rank ↔
      paper_theorem8_bstar_threshold_bid
        model.value model.clickThroughRate (model.remaining + 1) (rank + 1) ≤
          finalState.clockPrice := by
  have hactive_iff :=
    paper_theorem8_bstar_ranked_threshold_strategy_terminal_history_active_iff_clock_lt_threshold_bid
      model hhist hterminal hinitial_active
  rw [hactive_iff]
  exact not_lt

/--
In a terminal finite-`B*` ranked-threshold-strategy-consistent history from an
initially active rank, final inactivity is equivalent to the named finite `B*`
strategy prescribing a drop at the terminal state.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_terminal_history_inactive_iff_strategy
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    {state finalState : PaperTheorem8GeneralizedEnglishAuctionState ℕ}
    {rank : ℕ}
    (hhist :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) state finalState)
    (hterminal :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyTerminal
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) finalState)
    (hinitial_active : state.IsActive rank) :
    ¬ finalState.IsActive rank ↔
      paper_theorem8_bstar_ranked_threshold_strategy
        model.value model.clickThroughRate model.remaining finalState rank := by
  have hinactive_iff :=
    paper_theorem8_bstar_ranked_threshold_strategy_terminal_history_inactive_iff_threshold_le_clock
      model hhist hterminal hinitial_active
  have hdrop_iff :=
    paper_theorem8_bstar_ranked_threshold_strategy_drops_iff_threshold_bid
      model.value model.clickThroughRate finalState rank model.remaining
      (ne_of_gt (model.click_pos rank))
      (ne_of_gt (model.click_pos (rank + 1)))
  exact hinactive_iff.trans hdrop_iff.symm

/--
In a terminal finite-`B*` ranked-threshold-strategy-consistent history from an
initially active rank, final activity is equivalent to the named finite `B*`
strategy not prescribing a drop at the terminal state.
-/
theorem paper_theorem8_bstar_ranked_threshold_strategy_terminal_history_active_iff_not_strategy
    (model : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate)
    {state finalState : PaperTheorem8GeneralizedEnglishAuctionState ℕ}
    {rank : ℕ}
    (hhist :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) state finalState)
    (hterminal :
      PaperTheorem8GeneralizedEnglishAuctionState.StrategyTerminal
        (paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining) finalState)
    (hinitial_active : state.IsActive rank) :
    finalState.IsActive rank ↔
      ¬ paper_theorem8_bstar_ranked_threshold_strategy
          model.value model.clickThroughRate model.remaining finalState rank := by
  constructor
  · intro hactive_final
    exact hterminal rank hactive_final
  · intro hnot_drop
    have hiff :=
      paper_theorem8_bstar_ranked_threshold_strategy_not_drop_iff_clock_lt_threshold_bid
        model.value model.clickThroughRate finalState rank model.remaining
        (ne_of_gt (model.click_pos rank))
        (ne_of_gt (model.click_pos (rank + 1)))
    exact
      paper_theorem8_bstar_ranked_threshold_strategy_history_no_new_dropout_before_threshold
        model hhist (hiff.mp hnot_drop) hinitial_active

/--
Paper-facing terminal-history behavior certificate for the finite-`B*`
ranked-threshold strategy. It isolates the concrete English-auction history
obligations needed to identify the terminal active/dropout set with the named
finite `B*` threshold strategy.
-/
structure PaperTheorem8BStarRankedThresholdTerminalHistoryBehaviorCertificate where
  localModel : PaperTheorem8BStarRankedThresholdLocalOptimalityCertificate
  initialState : PaperTheorem8GeneralizedEnglishAuctionState ℕ
  finalState : PaperTheorem8GeneralizedEnglishAuctionState ℕ
  history :
    PaperTheorem8GeneralizedEnglishAuctionState.StrategyHistory
      (paper_theorem8_bstar_ranked_threshold_strategy
        localModel.value localModel.clickThroughRate localModel.remaining)
      initialState finalState
  terminal :
    PaperTheorem8GeneralizedEnglishAuctionState.StrategyTerminal
      (paper_theorem8_bstar_ranked_threshold_strategy
        localModel.value localModel.clickThroughRate localModel.remaining)
      finalState
  initially_active : ∀ rank, initialState.IsActive rank

/--
Terminal-history behavior certificate: a rank is active at the terminal state
exactly below its finite `B*` threshold bid.
-/
theorem paper_theorem8_bstar_ranked_threshold_terminal_history_behavior_active_iff_clock_lt_threshold_bid
    (cert :
      PaperTheorem8BStarRankedThresholdTerminalHistoryBehaviorCertificate)
    (rank : ℕ) :
    cert.finalState.IsActive rank ↔
      cert.finalState.clockPrice <
        paper_theorem8_bstar_threshold_bid
          cert.localModel.value cert.localModel.clickThroughRate
          (cert.localModel.remaining + 1) (rank + 1) := by
  exact
    paper_theorem8_bstar_ranked_threshold_strategy_terminal_history_active_iff_clock_lt_threshold_bid
      cert.localModel cert.history cert.terminal (cert.initially_active rank)

/--
Terminal-history behavior certificate: a rank is inactive at the terminal state
exactly when its finite `B*` threshold bid has been reached.
-/
theorem paper_theorem8_bstar_ranked_threshold_terminal_history_behavior_inactive_iff_threshold_le_clock
    (cert :
      PaperTheorem8BStarRankedThresholdTerminalHistoryBehaviorCertificate)
    (rank : ℕ) :
    ¬ cert.finalState.IsActive rank ↔
      paper_theorem8_bstar_threshold_bid
        cert.localModel.value cert.localModel.clickThroughRate
        (cert.localModel.remaining + 1) (rank + 1) ≤
          cert.finalState.clockPrice := by
  exact
    paper_theorem8_bstar_ranked_threshold_strategy_terminal_history_inactive_iff_threshold_le_clock
      cert.localModel cert.history cert.terminal (cert.initially_active rank)

/--
Terminal-history behavior certificate: terminal inactivity is exactly the named
finite `B*` strategy's terminal drop predicate.
-/
theorem paper_theorem8_bstar_ranked_threshold_terminal_history_behavior_inactive_iff_strategy
    (cert :
      PaperTheorem8BStarRankedThresholdTerminalHistoryBehaviorCertificate)
    (rank : ℕ) :
    ¬ cert.finalState.IsActive rank ↔
      paper_theorem8_bstar_ranked_threshold_strategy
        cert.localModel.value cert.localModel.clickThroughRate
        cert.localModel.remaining cert.finalState rank := by
  exact
    paper_theorem8_bstar_ranked_threshold_strategy_terminal_history_inactive_iff_strategy
      cert.localModel cert.history cert.terminal (cert.initially_active rank)

/--
Terminal-history behavior certificate: every inactive rank has a concrete
dropout record at a price that reached its finite `B*` threshold bid and is no
later than the terminal clock.
-/
theorem paper_theorem8_bstar_ranked_threshold_terminal_history_behavior_inactive_record_exists
    (cert :
      PaperTheorem8BStarRankedThresholdTerminalHistoryBehaviorCertificate)
    {rank : ℕ}
    (hinactive : ¬ cert.finalState.IsActive rank) :
    ∃ price,
      cert.finalState.lastDropout rank = some price ∧
        paper_theorem8_bstar_threshold_bid
          cert.localModel.value cert.localModel.clickThroughRate
          (cert.localModel.remaining + 1) (rank + 1) ≤
            price ∧
          price ≤ cert.finalState.clockPrice := by
  exact
    paper_theorem8_bstar_ranked_threshold_strategy_history_new_dropout_record_exists
      cert.localModel cert.history (cert.initially_active rank) hinactive

/--
Terminal-history behavior certificate: terminal activity is exactly the named
finite `B*` strategy's terminal not-drop predicate.
-/
theorem paper_theorem8_bstar_ranked_threshold_terminal_history_behavior_active_iff_not_strategy
    (cert :
      PaperTheorem8BStarRankedThresholdTerminalHistoryBehaviorCertificate)
