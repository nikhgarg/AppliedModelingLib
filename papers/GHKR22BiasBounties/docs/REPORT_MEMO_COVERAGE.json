  "report_inventory_complete": true,
  "items": {
    "defect/observation-4-pointwise-null-set": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "5952dac0f4dd51b2f269e0d84802a6780d4c6d09f33dd17355e7823e3f89ecc8",
      "source_reading": "Bayes optimality, defined through pointwise conditional risk on the support, is equivalent to optimality against every alternative model on every subgroup.",
      "report_home": 4,
      "memo_heading": "Bayes optimality and Observation 4",
      "memo_anchor": "bayes-optimality-and-observation-4"
    },
    "defect/adaptive-checker-confidence-and-transcript-count": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "5952dac0f4dd51b2f269e0d84802a6780d4c6d09f33dd17355e7823e3f89ecc8",
      "source_reading": "The adaptive certificate checker and its downstream update processes satisfy the stated accept/reject guarantees at the displayed logarithmic sample size.",
      "report_home": 4,
      "memo_heading": "Adaptive certificate checking",
      "memo_anchor": "adaptive-certificate-checking"
    },
    "defect/algorithm-4-shared-state-and-restart": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "5952dac0f4dd51b2f269e0d84802a6780d4c6d09f33dd17355e7823e3f89ecc8",
      "source_reading": "MonotoneFalsifyAndUpdate feeds external proposals and repair proposals through CertificateChecker and recursively repairs losses on protected historical groups.",
      "report_home": 4,
      "memo_heading": "Shared state in Algorithm 4",
      "memo_anchor": "shared-state-in-algorithm-4"
    },
    "defect/algorithm-2-nonstrict-guard-final-acceptance": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "5952dac0f4dd51b2f269e0d84802a6780d4c6d09f33dd17355e7823e3f89ecc8",
      "source_reading": "The printed non-strict guard processes a proposal while NumberAccepted is at most 2/epsilon, while the proof says the transcript contains at most 2/epsilon acceptances.",
      "report_home": 4,
      "memo_heading": "Adaptive certificate checking",
      "memo_anchor": "adaptive-certificate-checking"
    },
    "defect/algorithm-5-fresh-block-and-integer-horizon": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "5952dac0f4dd51b2f269e0d84802a6780d4c6d09f33dd17355e7823e3f89ecc8",
      "source_reading": "TrainByOpt partitions the sample into T=2/epsilon blocks and optimizes and tests one certificate at every round before either halting or applying ListUpdate.",
      "report_home": 4,
      "memo_heading": "Fresh blocks, integer rounds, and the Lemma 15 typo",
      "memo_anchor": "fresh-blocks-integer-rounds-and-the-lemma-15-typo"
    },
    "defect/lemma-15-undefined-gp": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "5952dac0f4dd51b2f269e0d84802a6780d4c6d09f33dd17355e7823e3f89ecc8",
      "source_reading": "Uniform convergence bounds the difference between the population and empirical certificate objectives for every quantified g in G and h in H.",
      "report_home": 4,
      "memo_heading": "Fresh blocks, integer rounds, and the Lemma 15 typo",
      "memo_anchor": "fresh-blocks-integer-rounds-and-the-lemma-15-typo"
    },
    "defect/lemma-22-disagreement-normalization": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "5952dac0f4dd51b2f269e0d84802a6780d4c6d09f33dd17355e7823e3f89ecc8",
      "source_reading": "An empirical-risk minimizer on the disagreement-labelled sample maximizes the fixed-model certificate objective over the group class.",
      "report_home": 7,
      "memo_heading": "Lemma 22 proof route",
      "memo_anchor": "lemma-22-proof-route"
    },
    "defect/algorithm-6-two-gap-and-positive-initialization": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "5952dac0f4dd51b2f269e0d84802a6780d4c6d09f33dd17355e7823e3f89ecc8",
      "source_reading": "From an arbitrary initial pair, alternating ERM returns after at most 2/epsilon ERM calls over each class with a positive certificate that is epsilon-locally optimal in both coordinates.",
      "report_home": 4,
      "memo_heading": "Algorithm 6 and Theorem 23",
      "memo_anchor": "algorithm-6-and-theorem-23"
    },
    "convention/measurable-arbitrary-population-law": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "5952dac0f4dd51b2f269e0d84802a6780d4c6d09f33dd17355e7823e3f89ecc8",
      "source_reading": "Population expectations are taken under an arbitrary probability measure; losses, models, groups, adaptive submissions, and bad events carry the measurability or integrability premises needed for those expectations and probabilities to exist.",
      "report_home": 4,
      "memo_heading": "Conditional group loss and null groups",
      "memo_anchor": "conditional-group-loss-and-null-groups"
    },
    "convention/zero-mass-group-totalization": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "5952dac0f4dd51b2f269e0d84802a6780d4c6d09f33dd17355e7823e3f89ecc8",
      "source_reading": "The mass-weighted group-loss numerator is the total primitive; conditional group loss is totalized to zero at mass zero, and every divided source display is recovered on positive-mass groups.",
      "report_home": 4,
      "memo_heading": "Conditional group loss and null groups",
      "memo_anchor": "conditional-group-loss-and-null-groups"
    },
