  "items": {
    "defect/GHW01-LEMMA8.1-CROSS-BIDDER-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "8400c8a578211901be7e3dc42cbd46771a83227df38ce01b965d46733bb93256",
      "source_reading": "The preliminary SODA text claims that truthfulness alone makes winning probabilities monotone across two bidders ordered by their bid values.",
      "memo_heading": "Lemma 8.1 and Theorem 8.2",
      "memo_anchor": "lemma-81-and-theorem-82",
      "report_home": 4
    },
    "defect/GHW01-THEOREM82-SODA-SOURCE-VERSION-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "8400c8a578211901be7e3dc42cbd46771a83227df38ce01b965d46733bb93256",
      "source_reading": "The preliminary SODA text states E[R] <= F for any truthful auction, while the proof uses a cross-bidder monotonicity step not implied by truthfulness alone.",
      "memo_heading": "Lemma 8.1 and Theorem 8.2",
      "memo_anchor": "lemma-81-and-theorem-82",
      "report_home": 4
    },
    "defect/GHW01-THEOREM4.1-LOG-DOMAIN-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "8400c8a578211901be7e3dc42cbd46771a83227df38ce01b965d46733bb93256",
      "source_reading": "Theorem 4.1 states F >= T/(2 log h) without an explicit nondegenerate logarithmic domain.",
      "memo_heading": "Logarithmic domains",
      "memo_anchor": "logarithmic-domains",
      "report_home": 4
    },
    "defect/GHW01-COROLLARY4.2-LOG-DOMAIN-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "8400c8a578211901be7e3dc42cbd46771a83227df38ce01b965d46733bb93256",
      "source_reading": "Corollary 4.2 states F >= T/(4 log n) without excluding the one-bidder case.",
      "memo_heading": "Logarithmic domains",
      "memo_anchor": "logarithmic-domains",
      "report_home": 4
    },
    "defect/GHW01-THEOREM7-LOG-DOMAIN-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "8400c8a578211901be7e3dc42cbd46771a83227df38ce01b965d46733bb93256",
      "source_reading": "Theorems 7.1 and 7.2 use logarithmic and square-root-logarithmic asymptotic denominators without excluding the normalized boundary h = 1.",
      "memo_heading": "Logarithmic domains",
      "memo_anchor": "logarithmic-domains",
      "report_home": 4
    },
    "convention/GHW01-NORMALIZED-BID-DOMAIN-01": {
      "disposition": "not_material",
      "reason": "Bids at least one are the explicit source normalization."
    },
    "convention/GHW01-HIGHEST-BID-PARAMETER-01": {
      "disposition": "not_material",
      "reason": "The maximum bid h is attained by definition in the source finite model."
    },
    "convention/GHW01-TOTAL-VALUE-TRUTHFUL-BIDDING-01": {
      "disposition": "not_material",
      "reason": "Truthful bidding identifies bids and values exactly as in the source utility interpretation."
    },
    "convention/GHW01-BOUNDED-OPT-CAP-SEMANTICS-01": {
      "disposition": "not_material",
      "reason": "Capping threshold sales at supply implements the source bounded-supply benchmark without an extra no-ties assumption."
    },
    "convention/GHW01-BOUNDED-TOP-K-EXACT-CARDINALITY-01": {
      "disposition": "not_material",
      "reason": "On the stated nonnegative source domain, the top-k sum equals both the exact-k and at-most-k revenue maximum."
    },
    "convention/GHW01-BID-INDEPENDENT-BOUNDARY-01": {
      "disposition": "not_material",
      "reason": "The own-erased multiset and boundary acceptance flag represent source bid independence and preserve repeated bids."
    },
    "convention/GHW01-RANDOMIZED-EXPECTED-PROFIT-FINITENESS-01": {
      "disposition": "not_material",
      "reason": "Finite expected profit is the source domain of the compared real-valued expected utilities."
    },
    "convention/GHW01-RANDOMIZED-AUCTION-PMF-DOMAIN-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "8400c8a578211901be7e3dc42cbd46771a83227df38ce01b965d46733bb93256",
      "source_reading": "The generic randomized-auction carrier is restricted to discrete, countably supported probability laws, represented in Lean by BidProfile Agent -> PMF (AuctionOutcome Agent). It does not claim to represent every continuous probability law on the real-price outcome space allowed by the source's unrestricted phrase 'probability distributions on auction outcomes'.",
      "memo_heading": "Randomization and bounded supply",
      "memo_anchor": "randomization-and-bounded-supply",
      "report_home": 10
    },
    "convention/GHW01-NONEMPTY-OTHER-BID-DOMAIN-01": {
      "disposition": "not_material",
      "reason": "Choosing an optimal offer from other bids or a sample already requires that source input to be nonempty."
    },
    "convention/GHW01-THEOREM93-SET-OF-BIDS-ERASED-MULTISET-01": {
      "disposition": "not_material",
      "reason": "The erased multiset encodes the source bid collection while preserving multiplicities and anonymity."
    },
    "convention/GHW01-THEOREM93-SALE-PRICE-CONVENTION-01": {
      "disposition": "not_material",
      "reason": "Binary allocation, loser-zero payments, and prices between zero and the winning bid are source auction conventions."
    },
    "convention/GHW01-THEOREM93-HIGH-VALUE-DISCRETIZATION-01": {
      "disposition": "not_material",
      "reason": "This is a concrete finite representation of an already stated auction primitive; it does not repair a source formula or add a condition to a named paper conclusion."
    },
    "convention/GHW01-THEOREM62-EXACT-HALF-SAMPLING-01": {
      "disposition": "not_material",
      "reason": "Uniform exact-half sampling and complementary selling are the source mechanism."
    },
    "convention/GHW01-THEOREM62-DISCRETE-ALPHA-01": {
      "disposition": "not_material",
      "reason": "This is a concrete finite representation of an already stated auction primitive; it does not repair a source formula or add a condition to a named paper conclusion."
    },
    "convention/GHW01-WEIGHTED-PAIRING-PROBABILITY-DOMAIN-01": {
      "disposition": "not_material",
      "reason": "Source normalized bids and an available other bidder imply the positive denominator of its displayed pairing law."
    },
    "convention/GHW01-WEIGHTED-PAIRING-JOINT-LAW-01": {
      "disposition": "not_material",
      "reason": "Independent bidderwise weighted draws implement the source randomized mechanism."
    },
    "convention/GHW01-BOUNDED-SAMPLE-CAPACITY-FLOOR-01": {
      "disposition": "not_material",
      "reason": "The floor turns source proportional sample capacity into its integer item count."
    },
    "convention/GHW01-BOUNDED-REJECTION-PRIORITY-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "8400c8a578211901be7e3dc42cbd46771a83227df38ce01b965d46733bb93256",
      "source_reading": "When more than k bids satisfy the bounded-sampling threshold, the source permits an arbitrary rejection rule. The formal model instantiates that choice with one fixed exogenous linear priority order on bidder labels and retains the first k accepted bidders in that order.",
      "memo_heading": "Randomization and bounded supply",
      "memo_anchor": "randomization-and-bounded-supply",
      "report_home": 4
    },
    "convention/GHW01-BOUNDED-DUAL-EVEN-CAPACITY-01": {
