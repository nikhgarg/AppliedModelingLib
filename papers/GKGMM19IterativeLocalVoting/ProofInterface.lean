  rw [hupdate]
  apply congrArg project
  funext i
  rw [finiteModelAL1LinfOutcomeDirection_eq_sampledLpGradient_add_perturbation]
  simp only [finiteModelAL1LinfOutcomeLpGradientNoise]
  ring

