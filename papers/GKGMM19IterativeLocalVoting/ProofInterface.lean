/--
Expected-subgradient interchange for the exact joint Definition 2 cost.
The explicit cost-integrability hypothesis is precisely the finite-valued
expectation condition in the source's Appendix Theorem 4; C1/C2 support is
what discharges it in a concrete ILV environment.
-/
theorem weightedEuclideanJointSamplePopulationDirection_subgradient
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ)
    (hcost : ∀ y : Coord → ℝ,
      Integrable (fun sample => weightedEuclideanJointSampleCost D sample y)
        D.jointMeasure) :
    FiniteSubgradientAt (weightedEuclideanJointSamplePopulationCost D) state
      (weightedEuclideanJointSamplePopulationDirection D state) := by
  have hfull := AppliedModelingLib.Optimization.finiteSubgradientAt_integral
    (weightedEuclideanJointSampleDirection_subgradient_ae D state)
    hcost
    (fun i => integrable_weightedEuclideanJointSampleDirection_coordinate D state i)
  simpa only [weightedEuclideanJointSamplePopulationCost,
    weightedEuclideanJointSamplePopulationDirection] using hfull

/-- One unprojected Model B update as a Borel map of its current state and ideal point. -/
noncomputable def finiteModelBOutcomeStep
    {Coord : Type*} [Fintype Coord]
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (n : ℕ)
    (stateIdeal : (Coord → ℝ) × (Coord → ℝ)) : Coord → ℝ :=
  project (fun i =>
    stateIdeal.1 i - ilvRadius r0 (n + 1) *
      lpCostGradientCandidate p (fun j => stateIdeal.1 j - stateIdeal.2 j) i)

/-- A Borel projection makes each finite Model B update Borel measurable. -/
theorem measurable_finiteModelBOutcomeStep
    {Coord : Type*} [Fintype Coord]
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Measurable (finiteModelBOutcomeStep p r0 project n) := by
  apply hproject.comp
  have hdiff : Measurable
      (fun z : (Coord → ℝ) × (Coord → ℝ) => fun j => z.1 j - z.2 j) :=
    measurable_pi_lambda _
      (fun j => ((measurable_pi_apply j).comp measurable_fst).sub
        ((measurable_pi_apply j).comp measurable_snd))
  have hgradient : Measurable
      (fun z : (Coord → ℝ) × (Coord → ℝ) =>
        lpCostGradientCandidate p (fun j => z.1 j - z.2 j)) :=
    (measurable_lpCostGradientCandidate p).comp hdiff
  apply measurable_pi_lambda
  intro i
  exact
    ((measurable_pi_apply i).comp measurable_fst).sub
      (measurable_const.mul ((measurable_pi_apply i).comp hgradient))

/-- The exact coordinatewise `L1/L∞` raw response is a Borel map of state and ideal. -/
theorem measurable_l1LinfBallResponse
    {Coord : Type*} [Fintype Coord] (r : ℝ) :
    Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      l1LinfBallResponse z.1 z.2 r) := by
  apply measurable_pi_lambda
  intro i
  exact
    (((measurable_pi_apply i).comp measurable_fst).sub measurable_const).max
      ((((measurable_pi_apply i).comp measurable_fst).add measurable_const).min
        ((measurable_pi_apply i).comp measurable_snd))

/-- The displayed exact clamp direction is Borel measurable in state and ideal. -/
theorem measurable_l1LinfBallDirection
    {Coord : Type*} [Fintype Coord] (r : ℝ) :
    Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      l1LinfBallDirection z.1 z.2 r) := by
  apply measurable_pi_lambda
  intro i
  exact
    (((measurable_pi_apply i).comp measurable_fst).sub
      ((measurable_pi_apply i).comp (measurable_l1LinfBallResponse r))).div_const r

/--
The symmetric active-coordinate `L∞` subgradient is Borel measurable in the
state and ideal point.  Its denominator is expanded as a finite indicator sum
rather than relying on an arbitrary maximizer selection.
-/
theorem measurable_linfL1SymmetricActiveDirection
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord] :
    Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      linfL1SymmetricActiveDirection z.1 z.2) := by
  let difference : (Coord → ℝ) × (Coord → ℝ) → Coord → ℝ :=
    fun z i => z.1 i - z.2 i
  have hdifference : Measurable difference := by
    apply measurable_pi_lambda
    intro i
    exact ((measurable_pi_apply i).comp measurable_fst).sub
      ((measurable_pi_apply i).comp measurable_snd)
  have hlinf : Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      AppliedModelingLib.FiniteDimensionalNorms.linf (difference z)) :=
    AppliedModelingLib.FiniteDimensionalNorms.continuous_linf.measurable.comp hdifference
  have hcoordinate : ∀ i : Coord, Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      difference z i) := by
    intro i
    exact (measurable_pi_apply i).comp hdifference
  have hactive : ∀ i : Coord, MeasurableSet {z : (Coord → ℝ) × (Coord → ℝ) |
      |difference z i| = AppliedModelingLib.FiniteDimensionalNorms.linf (difference z)} := by
    intro i
    exact measurableSet_eq_fun (hcoordinate i).abs hlinf
  have hcount : Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      ∑ j : Coord, if |difference z j| =
        AppliedModelingLib.FiniteDimensionalNorms.linf (difference z) then (1 : ℝ) else 0) := by
    exact Finset.measurable_sum Finset.univ fun j _ =>
      Measurable.ite (hactive j) measurable_const measurable_const
  apply measurable_pi_lambda
  intro i
  have hformula : (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      linfL1SymmetricActiveDirection z.1 z.2 i) =
      fun z => if AppliedModelingLib.FiniteDimensionalNorms.linf (difference z) = 0 then 0
        else if |difference z i| = AppliedModelingLib.FiniteDimensionalNorms.linf (difference z)
          then (difference z i / |difference z i|) /
            (∑ j : Coord, if |difference z j| =
              AppliedModelingLib.FiniteDimensionalNorms.linf (difference z) then (1 : ℝ) else 0)
          else 0 := by
    funext z
    simp [linfL1SymmetricActiveDirection, linfL1ActiveCoordinates, difference]
    split_ifs <;> simp_all
  rw [hformula]
  refine Measurable.ite (measurableSet_eq_fun hlinf measurable_const) measurable_const ?_
  refine Measurable.ite (hactive i) ?_ measurable_const
  exact ((hcoordinate i).div (hcoordinate i).abs).div hcount

/-- The exact-direction/sample-subgradient perturbation is Borel measurable. -/
theorem measurable_l1LinfBallDirectionSubgradientPerturbation
    {Coord : Type*} [Fintype Coord] (r : ℝ) :
    Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      l1LinfBallDirectionSubgradientPerturbation z.1 z.2 r) := by
  apply measurable_pi_lambda
  intro i
  have hdiff : Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      fun j => z.1 j - z.2 j) :=
    measurable_pi_lambda _
      (fun j => ((measurable_pi_apply j).comp measurable_fst).sub
        ((measurable_pi_apply j).comp measurable_snd))
  exact ((measurable_pi_apply i).comp (measurable_l1LinfBallDirection r)).sub
    ((measurable_pi_apply i).comp ((measurable_lpCostGradientCandidate 1).comp hdiff))

/-- The normalized finite Euclidean direction is Borel measurable in state and ideal. -/
theorem measurable_l2DistanceNormalizedGradient
    {Coord : Type*} [Fintype Coord] :
    Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      l2DistanceNormalizedGradient z.1 z.2) := by
  let difference : (Coord → ℝ) × (Coord → ℝ) → Coord → ℝ :=
    fun z i => z.1 i - z.2 i
  have hdifference : Measurable difference := by
    apply measurable_pi_lambda
    intro i
    exact ((measurable_pi_apply i).comp measurable_fst).sub
      ((measurable_pi_apply i).comp measurable_snd)
  apply measurable_pi_lambda
  intro i
  exact (((measurable_pi_apply i).comp measurable_fst).sub
    ((measurable_pi_apply i).comp measurable_snd)).div
      (AppliedModelingLib.FiniteDimensionalNorms.continuous_l2.measurable.comp hdifference)

/-- The exact finite `L2` Model A raw response is Borel measurable in state and ideal. -/
theorem measurable_l2BallResponse
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] (r : ℝ) :
    Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      l2BallResponse z.1 z.2 r) := by
  let difference : (Coord → ℝ) × (Coord → ℝ) → Coord → ℝ :=
    fun z i => z.1 i - z.2 i
  have hdifference : Measurable difference := by
    apply measurable_pi_lambda
    intro i
    exact ((measurable_pi_apply i).comp measurable_fst).sub
      ((measurable_pi_apply i).comp measurable_snd)
  have hdistance : Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      finiteCoordinateDistance SourceNorm.l2 z.1 z.2) :=
    AppliedModelingLib.FiniteDimensionalNorms.continuous_l2.measurable.comp hdifference
  apply measurable_pi_lambda
  intro i
  unfold l2BallResponse
  have hformula : (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      (if finiteCoordinateDistance SourceNorm.l2 z.1 z.2 ≤ r then z.2 else
        fun i => z.1 i - r * l2DistanceNormalizedGradient z.1 z.2 i) i) =
      (fun z : (Coord → ℝ) × (Coord → ℝ) => if
        finiteCoordinateDistance SourceNorm.l2 z.1 z.2 ≤ r then z.2 i else
          z.1 i - r * l2DistanceNormalizedGradient z.1 z.2 i) := by
    funext z
    split <;> rfl
  rw [hformula]
  refine Measurable.ite (measurableSet_le hdistance measurable_const) ?_ ?_
  · exact (measurable_pi_apply i).comp measurable_snd
  · exact ((measurable_pi_apply i).comp measurable_fst).sub
      (((measurable_pi_apply i).comp measurable_l2DistanceNormalizedGradient).const_mul r)

/-- The exact finite `L2` Model A direction is Borel measurable in state and ideal. -/
theorem measurable_l2BallDirection
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] (r : ℝ) :
    Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      l2BallDirection z.1 z.2 r) := by
  apply measurable_pi_lambda
  intro i
  exact (((measurable_pi_apply i).comp measurable_fst).sub
    ((measurable_pi_apply i).comp (measurable_l2BallResponse r))).div_const r

/-- The exact finite `L2` direction/subgradient perturbation is Borel measurable. -/
theorem measurable_l2BallDirectionSubgradientPerturbation
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] (r : ℝ) :
    Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      l2BallDirectionSubgradientPerturbation z.1 z.2 r) := by
  apply measurable_pi_lambda
  intro i
  exact ((measurable_pi_apply i).comp (measurable_l2BallDirection r)).sub
    ((measurable_pi_apply i).comp measurable_l2DistanceNormalizedGradient)

/-- The strict finite `L2` ideal-containing-ball event is Borel measurable. -/
theorem measurableSet_l2BallBadEvent
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (center : Coord → ℝ) (r : ℝ) :
    MeasurableSet (l2BallBadEvent center r) := by
  have hdifference : Measurable (fun ideal : Coord → ℝ =>
      fun i => center i - ideal i) := by
    apply measurable_pi_lambda
    intro i
    exact measurable_const.sub (measurable_pi_apply i)
  change MeasurableSet {ideal : Coord → ℝ |
    AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => center i - ideal i) < r}
  exact measurableSet_lt
    (AppliedModelingLib.FiniteDimensionalNorms.continuous_l2.measurable.comp hdifference)
    measurable_const

/--
The source's Euclidean exceptional event is Borel jointly in the predictable
current state and the fresh ideal draw.  This is the measurability bridge used
when its conditional probability is stated along an iid execution, rather
than only as a one-draw geometric bound.
-/
theorem measurableSet_l2BallBadEvent_state_ideal
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (r : ℝ) :
    MeasurableSet {z : (Coord → ℝ) × (Coord → ℝ) |
      z.2 ∈ l2BallBadEvent z.1 r} := by
  change MeasurableSet {z : (Coord → ℝ) × (Coord → ℝ) |
    AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => z.1 i - z.2 i) < r}
  have hdifference : Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      fun i => z.1 i - z.2 i) := by
    apply measurable_pi_lambda
    intro i
    exact ((measurable_pi_apply i).comp measurable_fst).sub
      ((measurable_pi_apply i).comp measurable_snd)
  exact measurableSet_lt
    (AppliedModelingLib.FiniteDimensionalNorms.continuous_l2.measurable.comp hdifference)
    measurable_const

/-- The `L1/L∞` slab exceptional event is Borel jointly in state and ideal. -/
theorem measurableSet_l1LinfSlabBadEvent_state_ideal
    {Coord : Type*} [Fintype Coord]
    (r : ℝ) :
    MeasurableSet {z : (Coord → ℝ) × (Coord → ℝ) |
      z.2 ∈ l1LinfSlabBadEvent z.1 r} := by
  classical
  change MeasurableSet {z : (Coord → ℝ) × (Coord → ℝ) |
    ∃ i, |z.1 i - z.2 i| < r}
  rw [show {z : (Coord → ℝ) × (Coord → ℝ) | ∃ i, |z.1 i - z.2 i| < r} =
      ⋃ i : Coord, {z | |z.1 i - z.2 i| < r} by
    ext z
    simp]
  apply MeasurableSet.iUnion
  intro i
  exact measurableSet_lt
    (((measurable_pi_apply i).comp measurable_fst).sub
      ((measurable_pi_apply i).comp measurable_snd) |>.abs)
    measurable_const

/-- The finite `L∞` near-tie envelope is Borel jointly in state and ideal. -/
theorem measurableSet_linfL1NearTieBadEvent_state_ideal
    {Coord : Type*} [Fintype Coord]
    (r : ℝ) :
    MeasurableSet {z : (Coord → ℝ) × (Coord → ℝ) |
      z.2 ∈ linfL1NearTieBadEvent z.1 r} := by
  classical
  change MeasurableSet {z : (Coord → ℝ) × (Coord → ℝ) | ∃ i j, i ≠ j ∧
    abs (abs (z.1 i - z.2 i) - abs (z.1 j - z.2 j)) < r}
  rw [show {z : (Coord → ℝ) × (Coord → ℝ) | ∃ i j, i ≠ j ∧
      abs (abs (z.1 i - z.2 i) - abs (z.1 j - z.2 j)) < r} =
      ⋃ i : Coord, ⋃ j : Coord, {z | i ≠ j ∧
        abs (abs (z.1 i - z.2 i) - abs (z.1 j - z.2 j)) < r} by
    ext z
    simp]
  apply MeasurableSet.iUnion
  intro i
  apply MeasurableSet.iUnion
  intro j
  by_cases hij : i = j
  · simp [hij]
  · rw [show {z : (Coord → ℝ) × (Coord → ℝ) | i ≠ j ∧
        abs (abs (z.1 i - z.2 i) - abs (z.1 j - z.2 j)) < r} =
        {z | abs (abs (z.1 i - z.2 i) - abs (z.1 j - z.2 j)) < r} by
      ext z
      simp [hij]]
    exact measurableSet_lt
      ((((measurable_pi_apply i).comp measurable_fst).sub
        ((measurable_pi_apply i).comp measurable_snd) |>.abs).sub
        (((measurable_pi_apply j).comp measurable_fst).sub
          ((measurable_pi_apply j).comp measurable_snd) |>.abs) |>.abs)
      measurable_const

/-- The squared norm of the rare exact `L2` perturbation is controlled by its ball-event probability. -/
theorem integral_l2BallDirectionSubgradientPerturbation_l2Sq_le
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (center : Coord → ℝ) {r : ℝ} (hr : 0 < r) :
    (∫ ideal, AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (l2BallDirectionSubgradientPerturbation center ideal r) ∂D.idealMeasure) ≤
      4 * (D.idealMeasure (l2BallBadEvent center r)).toReal := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let perturbation : (Coord → ℝ) → Coord → ℝ := fun ideal =>
    l2BallDirectionSubgradientPerturbation center ideal r
  have hmeas : Measurable perturbation := by
    exact (measurable_l2BallDirectionSubgradientPerturbation r).comp
      (measurable_const.prodMk measurable_id)
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  have hintegrable : Integrable (fun ideal =>
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq (perturbation ideal)) D.idealMeasure := by
    refine Integrable.mono' (integrable_const (4 : ℝ))
      (hl2sq.comp hmeas).aestronglyMeasurable ?_
    filter_upwards [] with ideal
    have hbound := l2BallDirectionSubgradientPerturbation_l2Sq_le_four
      (center := center) (ideal := ideal) hr
    simpa only [Real.norm_eq_abs,
      abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hbound
  simpa [Measure.real, perturbation] using
    AppliedModelingLib.integral_le_measureReal_mul_add_compl_of_le_on_of_le_on_compl
      D.idealMeasure (measurableSet_l2BallBadEvent center r) hintegrable
      (lowBound := (4 : ℝ)) (highBound := 0)
      (fun ideal _ =>
        l2BallDirectionSubgradientPerturbation_l2Sq_le_four
          (center := center) (ideal := ideal) hr)
      (fun ideal hideal => by
        change AppliedModelingLib.FiniteDimensionalNorms.l2Sq
          (l2BallDirectionSubgradientPerturbation center ideal r) ≤ 0
        rw [l2BallDirectionSubgradientPerturbation_eq_zero_of_notMem_badEvent hr hideal]
        norm_num [AppliedModelingLib.FiniteDimensionalNorms.l2Sq])

/-- The Euclidean norm of the rare exact `L2` perturbation is controlled by the same ball probability. -/
theorem integral_l2BallDirectionSubgradientPerturbation_l2_le
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (center : Coord → ℝ) {r : ℝ} (hr : 0 < r) :
    (∫ ideal, AppliedModelingLib.FiniteDimensionalNorms.l2
      (l2BallDirectionSubgradientPerturbation center ideal r) ∂D.idealMeasure) ≤
      2 * (D.idealMeasure (l2BallBadEvent center r)).toReal := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let perturbation : (Coord → ℝ) → Coord → ℝ := fun ideal =>
    l2BallDirectionSubgradientPerturbation center ideal r
  have hmeas : Measurable perturbation := by
    exact (measurable_l2BallDirectionSubgradientPerturbation r).comp
      (measurable_const.prodMk measurable_id)
  have hintegrable : Integrable (fun ideal =>
      AppliedModelingLib.FiniteDimensionalNorms.l2 (perturbation ideal)) D.idealMeasure := by
    refine Integrable.mono' (integrable_const (2 : ℝ))
      (AppliedModelingLib.FiniteDimensionalNorms.continuous_l2.measurable.comp hmeas).aestronglyMeasurable ?_
    filter_upwards [] with ideal
    have hbound := l2BallDirectionSubgradientPerturbation_l2_le_two
      (center := center) (ideal := ideal) hr
    simpa only [Real.norm_eq_abs,
      abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _)] using hbound
  simpa [Measure.real, perturbation] using
    AppliedModelingLib.integral_le_measureReal_mul_add_compl_of_le_on_of_le_on_compl
      D.idealMeasure (measurableSet_l2BallBadEvent center r) hintegrable
      (lowBound := (2 : ℝ)) (highBound := 0)
      (fun ideal _ =>
        l2BallDirectionSubgradientPerturbation_l2_le_two
          (center := center) (ideal := ideal) hr)
      (fun ideal hideal => by
        change AppliedModelingLib.FiniteDimensionalNorms.l2
          (l2BallDirectionSubgradientPerturbation center ideal r) ≤ 0
        rw [l2BallDirectionSubgradientPerturbation_eq_zero_of_notMem_badEvent hr hideal]
        norm_num [AppliedModelingLib.FiniteDimensionalNorms.l2,
          AppliedModelingLib.FiniteDimensionalNorms.l2Sq])

/-- One projected source-faithful `L2/L2` Model A update as a Borel state/ideal map. -/
noncomputable def finiteModelAL2OutcomeStep
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (n : ℕ)
    (stateIdeal : (Coord → ℝ) × (Coord → ℝ)) : Coord → ℝ :=
  project (l2BallResponse stateIdeal.1 stateIdeal.2 (ilvRadius r0 (n + 1)))

/-- A Borel projection makes each exact `L2/L2` Model A update Borel measurable. -/
theorem measurable_finiteModelAL2OutcomeStep
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Measurable (finiteModelAL2OutcomeStep r0 project n) := by
  exact hproject.comp (measurable_l2BallResponse (ilvRadius r0 (n + 1)))

/-- The raw point selected at a step of the canonical exact `L2/L2` Model A process. -/
noncomputable def finiteModelAL2OutcomeRawResponse
    {Omega Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (r0 : ℝ) (trajectory : ℕ → Omega → Coord → ℝ)
    (idealSample : ℕ → Omega → Coord → ℝ)
    (n : ℕ) (omega : Omega) : Coord → ℝ :=
  l2BallResponse (trajectory n omega) (idealSample n omega)
    (ilvRadius r0 (n + 1))

/-- The actual iid source Model A recursion at the `(p,q) = (2,2)` endpoint. -/
noncomputable def finiteModelAL2OutcomeTrajectory
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) : ℕ → (ℕ → Coord → ℝ) → Coord → ℝ
  | 0, _ => initial
  | n + 1, omega =>
      finiteModelAL2OutcomeStep r0 project n
        (finiteModelAL2OutcomeTrajectory D r0 project initial n omega,
          finiteModelBIdealSample n omega)

/-- The exact `L2/L2` source trajectory begins at its supplied feasible initial state. -/
theorem finiteModelAL2OutcomeTrajectory_zero
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (omega : ℕ → Coord → ℝ) :
    finiteModelAL2OutcomeTrajectory D r0 project initial 0 omega = initial :=
  rfl

/-- Each exact `L2/L2` successor is the projection of its radial raw response. -/
theorem finiteModelAL2OutcomeTrajectory_succ
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelAL2OutcomeTrajectory D r0 project initial (n + 1) omega =
      project (l2BallResponse
        (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1))) := by
  rfl

/-- The named raw response is exactly the raw point in the canonical `(2,2)` successor equation. -/
theorem finiteModelAL2OutcomeTrajectory_succ_rawResponse
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelAL2OutcomeTrajectory D r0 project initial (n + 1) omega =
      project (finiteModelAL2OutcomeRawResponse r0
        (finiteModelAL2OutcomeTrajectory D r0 project initial)
        finiteModelBIdealSample n omega) := by
  rfl

/-- Every raw `(2,2)` response stays in its source `L2` query ball. -/
theorem finiteModelAL2OutcomeRawResponse_l2_distance_le
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteCoordinateDistance SourceNorm.l2
      (finiteModelAL2OutcomeRawResponse r0
        (finiteModelAL2OutcomeTrajectory D r0 project initial)
        finiteModelBIdealSample n omega)
      (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) ≤
      ilvRadius r0 (n + 1) := by
  exact l2BallResponse_l2_distance_le
    (ilvRadius_nonneg (le_of_lt hr0) (n + 1))

/-- The canonical radial raw response minimizes the sampled Euclidean cost on its source query ball. -/
theorem finiteModelAL2OutcomeRawResponse_minimizes_l2_on_l2Ball
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ) {candidate : Coord → ℝ}
    (hcandidate : finiteCoordinateDistance SourceNorm.l2 candidate
      (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) ≤
      ilvRadius r0 (n + 1)) :
    AppliedModelingLib.FiniteDimensionalNorms.l2
        (fun i => finiteModelAL2OutcomeRawResponse r0
          (finiteModelAL2OutcomeTrajectory D r0 project initial)
          finiteModelBIdealSample n omega i - finiteModelBIdealSample n omega i) ≤
      AppliedModelingLib.FiniteDimensionalNorms.l2
        (fun i => candidate i - finiteModelBIdealSample n omega i) := by
  exact l2BallResponse_minimizes_l2_on_l2Ball
    (ilvRadius_nonneg (le_of_lt hr0) (n + 1)) hcandidate

/-- The canonical raw `(2,2)` response realizes the source Model A choice before projection. -/
theorem finiteModelAL2OutcomeRawResponse_is_modelARawResponseAt
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hNorm : UsesFiniteCoordinateNormDistance E)
    (hUtil : IsLpNormedUtilities E SourceNorm.l2)
    (n : ℕ) (omega : ℕ → Coord → ℝ) (voter : Voter)
    (hideal : E.ideal voter = finiteModelBIdealSample n omega) :
    ModelARawResponseAt E SourceNorm.l2
      (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
      (ilvRadius r0 (n + 1)) voter
      (finiteModelAL2OutcomeRawResponse r0
        (finiteModelAL2OutcomeTrajectory D r0 project initial)
        finiteModelBIdealSample n omega) := by
  exact l2BallResponse_is_modelARawResponseAt hNorm hUtil hideal
    (ilvRadius_nonneg (le_of_lt hr0) (n + 1))

/-- Projection preserves feasibility along the exact source-faithful `(2,2)` Model A recursion. -/
theorem finiteModelAL2OutcomeTrajectory_mem_solutionSpace
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) {solutionSpace : Set (Coord → ℝ)}
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hinitial : initial ∈ solutionSpace)
    (hproject : ∀ y, project y ∈ solutionSpace) :
    ∀ n omega,
      finiteModelAL2OutcomeTrajectory D r0 project initial n omega ∈ solutionSpace := by
  intro n omega
  induction n with
  | zero => simpa [finiteModelAL2OutcomeTrajectory] using hinitial
  | succ n ih =>
      rw [finiteModelAL2OutcomeTrajectory_succ]
      exact hproject _

/-- The exact radial direction differs from the sampled `L2` subgradient only on the rare ball event. -/
noncomputable def finiteModelAL2OutcomeSubgradientPerturbation
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) : Coord → ℝ :=
  l2BallDirectionSubgradientPerturbation
    (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
    (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1))

/-- The exact radial direction is the ordinary normalized `L2` subgradient plus this perturbation. -/
theorem finiteModelAL2OutcomeDirection_eq_sampledL2Gradient_add_perturbation
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    l2BallDirection
        (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1)) =
      fun i => l2DistanceNormalizedGradient
          (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
          (finiteModelBIdealSample n omega) i +
        finiteModelAL2OutcomeSubgradientPerturbation D r0 project initial n omega i := by
  ext i
  simp only [finiteModelAL2OutcomeSubgradientPerturbation,
    l2BallDirectionSubgradientPerturbation]
  ring

/-- Every exact radial successor is a projected stochastic-subgradient-shaped update. -/
theorem finiteModelAL2OutcomeTrajectory_projected_direction_update
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    FiniteProjectedSSGMUpdateAt project
      (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
      (ilvRadius r0 (n + 1))
      (l2BallDirection
        (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1)))
      (fun _ => 0) (fun _ => 0)
      (finiteModelAL2OutcomeTrajectory D r0 project initial (n + 1) omega) := by
  rw [finiteProjectedSSGMUpdateAt_formula,
    finiteModelAL2OutcomeTrajectory_succ]
  congr
  ext i
  unfold l2BallDirection
  have hpos : 0 < ilvRadius r0 (n + 1) := ilvRadius_succ_pos hr0 n
  have hcancel : ilvRadius r0 (n + 1) * (ilvRadius r0 (n + 1))⁻¹ = 1 :=
    mul_inv_cancel₀ hpos.ne'
  calc
    l2BallResponse
        (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1)) i =
        finiteModelAL2OutcomeTrajectory D r0 project initial n omega i -
          finiteModelAL2OutcomeTrajectory D r0 project initial n omega i *
            (ilvRadius r0 (n + 1) * (ilvRadius r0 (n + 1))⁻¹) +
          (ilvRadius r0 (n + 1) * (ilvRadius r0 (n + 1))⁻¹) *
            l2BallResponse
              (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
              (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1)) i := by
          rw [hcancel]
          ring
    _ = _ := by ring

/-- The exact radial Model A state is adapted to the raw ideal history. -/
theorem stronglyMeasurable_finiteModelAL2OutcomeTrajectory_natural
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) :
    ∀ n, StronglyMeasurable[
      finiteModelBIdealNaturalFiltration (Coord := Coord) n]
      (finiteModelAL2OutcomeTrajectory D r0 project initial n) := by
  intro n
  induction n with
  | zero =>
      change StronglyMeasurable[
        finiteModelBIdealNaturalFiltration (Coord := Coord) 0]
        (fun _ : ℕ → Coord → ℝ => initial)
      exact @stronglyMeasurable_const _ _
        (finiteModelBIdealNaturalFiltration (Coord := Coord) 0) _ initial
  | succ n ih =>
      change StronglyMeasurable[
        finiteModelBIdealNaturalFiltration (Coord := Coord) (n + 1)]
        (finiteModelAL2OutcomeStep r0 project n ∘ fun omega =>
          (finiteModelAL2OutcomeTrajectory D r0 project initial n omega,
            finiteModelBIdealSample n omega))
      have hprev : StronglyMeasurable[
          finiteModelBIdealNaturalFiltration (Coord := Coord) (n + 1)]
          (finiteModelAL2OutcomeTrajectory D r0 project initial n) :=
        ih.mono (Filtration.mono _ (Nat.le_succ n))
      have hsample : StronglyMeasurable[
          finiteModelBIdealNaturalFiltration (Coord := Coord) (n + 1)]
          (finiteModelBIdealSample (Coord := Coord) n) := by
        apply Measurable.stronglyMeasurable
        change Measurable[⨆ j ≤ n + 1,
          MeasurableSpace.comap (fun omega : ℕ → Coord → ℝ => omega j) inferInstance]
          (fun omega : ℕ → Coord → ℝ => omega (n + 1))
        apply (comap_measurable (fun omega : ℕ → Coord → ℝ => omega (n + 1))).mono
        · exact le_iSup_of_le (n + 1) (le_iSup_of_le le_rfl le_rfl)
        · exact le_rfl
      exact
        ((measurable_finiteModelAL2OutcomeStep r0 project hproject n).comp
          (hprev.prodMk hsample).measurable).stronglyMeasurable

/-- The exact radial perturbation is Borel measurable on the iid product space. -/
theorem measurable_finiteModelAL2OutcomeSubgradientPerturbation
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) (n : ℕ) :
    Measurable (finiteModelAL2OutcomeSubgradientPerturbation D r0 project initial n) := by
  unfold finiteModelAL2OutcomeSubgradientPerturbation
  simpa only [Function.comp_apply] using
    (measurable_l2BallDirectionSubgradientPerturbation
      (ilvRadius r0 (n + 1))).comp
    (((stronglyMeasurable_finiteModelAL2OutcomeTrajectory_natural D r0 project
      initial hproject n).measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl).prodMk
      (measurable_finiteModelBIdealSample n))

/-- The exact radial perturbation has uniformly bounded squared Euclidean norm. -/
theorem finiteModelAL2OutcomeSubgradientPerturbation_l2Sq_le_four
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ) :
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (finiteModelAL2OutcomeSubgradientPerturbation D r0 project initial n omega) ≤ 4 := by
  unfold finiteModelAL2OutcomeSubgradientPerturbation
  exact l2BallDirectionSubgradientPerturbation_l2Sq_le_four
    (ilvRadius_pos hr0 (by omega))

/-- The exact radial perturbation has uniformly bounded Euclidean norm. -/
theorem finiteModelAL2OutcomeSubgradientPerturbation_l2_le_two
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ) :
    AppliedModelingLib.FiniteDimensionalNorms.l2
      (finiteModelAL2OutcomeSubgradientPerturbation D r0 project initial n omega) ≤ 2 := by
  unfold finiteModelAL2OutcomeSubgradientPerturbation
  exact l2BallDirectionSubgradientPerturbation_l2_le_two
    (ilvRadius_pos hr0 (by omega))

/-- The squared Euclidean exact radial perturbation is integrable at every step. -/
theorem integrable_finiteModelAL2OutcomeSubgradientPerturbation_l2Sq
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Integrable (fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (finiteModelAL2OutcomeSubgradientPerturbation D r0 project initial n omega))
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  refine Integrable.mono' (integrable_const 4)
    (hl2sq.comp (measurable_finiteModelAL2OutcomeSubgradientPerturbation
      D r0 project initial hproject n)).aestronglyMeasurable ?_
  filter_upwards [Filter.Eventually.of_forall
    (finiteModelAL2OutcomeSubgradientPerturbation_l2Sq_le_four
      D hr0 project initial n)] with omega hbound
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hbound

/-- The Euclidean exact radial perturbation is integrable at every step. -/
theorem integrable_finiteModelAL2OutcomeSubgradientPerturbation_l2
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Integrable (fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2
      (finiteModelAL2OutcomeSubgradientPerturbation D r0 project initial n omega))
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  refine Integrable.mono' (integrable_const 2)
    (AppliedModelingLib.FiniteDimensionalNorms.continuous_l2.measurable.comp
      (measurable_finiteModelAL2OutcomeSubgradientPerturbation
        D r0 project initial hproject n)).aestronglyMeasurable ?_
  filter_upwards [Filter.Eventually.of_forall
    (finiteModelAL2OutcomeSubgradientPerturbation_l2_le_two
      D hr0 project initial n)] with omega hbound
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _)] using hbound

/--
The squared norm of the rare exact-direction perturbation is controlled by
its slab-event probability.  This is the analytic conversion used to turn a
C3 density estimate into a conditional stochastic-approximation moment bound.
-/
theorem integral_l1LinfBallDirectionSubgradientPerturbation_l2Sq_le
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (center : Coord → ℝ) {r : ℝ} (hr : 0 < r) :
    (∫ ideal, AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (l1LinfBallDirectionSubgradientPerturbation center ideal r) ∂D.idealMeasure) ≤
      (4 * Fintype.card Coord) *
        (D.idealMeasure (l1LinfSlabBadEvent center r)).toReal := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let perturbation : (Coord → ℝ) → Coord → ℝ := fun ideal =>
    l1LinfBallDirectionSubgradientPerturbation center ideal r
  have hmeas : Measurable perturbation := by
    exact (measurable_l1LinfBallDirectionSubgradientPerturbation r).comp
      (measurable_const.prodMk measurable_id)
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  have hintegrable : Integrable (fun ideal =>
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq (perturbation ideal)) D.idealMeasure := by
    refine Integrable.mono' (integrable_const (4 * (Fintype.card Coord : ℝ)))
      (hl2sq.comp hmeas).aestronglyMeasurable ?_
    filter_upwards [] with ideal
    have hbound := l1LinfBallDirectionSubgradientPerturbation_l2Sq_le_four_card
      (center := center) (ideal := ideal) hr
    simpa only [Real.norm_eq_abs,
      abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hbound
  simpa [Measure.real, perturbation] using
    AppliedModelingLib.integral_le_measureReal_mul_add_compl_of_le_on_of_le_on_compl
      D.idealMeasure (measurableSet_l1LinfSlabBadEvent center r) hintegrable
      (lowBound := 4 * (Fintype.card Coord : ℝ)) (highBound := 0)
      (fun ideal _ =>
        l1LinfBallDirectionSubgradientPerturbation_l2Sq_le_four_card
          (center := center) (ideal := ideal) hr)
      (fun ideal hideal => by
        change AppliedModelingLib.FiniteDimensionalNorms.l2Sq
          (l1LinfBallDirectionSubgradientPerturbation center ideal r) ≤ 0
        rw [l1LinfBallDirectionSubgradientPerturbation_eq_zero_of_notMem_slabBadEvent
          hr hideal]
        norm_num [AppliedModelingLib.FiniteDimensionalNorms.l2Sq])

/-- The Euclidean norm of the rare perturbation is controlled by the same slab probability. -/
theorem integral_l1LinfBallDirectionSubgradientPerturbation_l2_le
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (center : Coord → ℝ) {r : ℝ} (hr : 0 < r) :
    (∫ ideal, AppliedModelingLib.FiniteDimensionalNorms.l2
      (l1LinfBallDirectionSubgradientPerturbation center ideal r) ∂D.idealMeasure) ≤
      (2 * Real.sqrt (Fintype.card Coord)) *
        (D.idealMeasure (l1LinfSlabBadEvent center r)).toReal := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let perturbation : (Coord → ℝ) → Coord → ℝ := fun ideal =>
    l1LinfBallDirectionSubgradientPerturbation center ideal r
  have hmeas : Measurable perturbation := by
    exact (measurable_l1LinfBallDirectionSubgradientPerturbation r).comp
      (measurable_const.prodMk measurable_id)
  have hintegrable : Integrable (fun ideal =>
      AppliedModelingLib.FiniteDimensionalNorms.l2 (perturbation ideal)) D.idealMeasure := by
    refine Integrable.mono' (integrable_const (2 * Real.sqrt (Fintype.card Coord)))
      (AppliedModelingLib.FiniteDimensionalNorms.continuous_l2.measurable.comp hmeas).aestronglyMeasurable ?_
    filter_upwards [] with ideal
    have hbound := l1LinfBallDirectionSubgradientPerturbation_l2_le_two_mul_sqrt_card
      (center := center) (ideal := ideal) hr
    simpa only [Real.norm_eq_abs,
      abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _)] using hbound
  simpa [Measure.real, perturbation] using
    AppliedModelingLib.integral_le_measureReal_mul_add_compl_of_le_on_of_le_on_compl
      D.idealMeasure (measurableSet_l1LinfSlabBadEvent center r) hintegrable
      (lowBound := 2 * Real.sqrt (Fintype.card Coord)) (highBound := 0)
      (fun ideal _ =>
        l1LinfBallDirectionSubgradientPerturbation_l2_le_two_mul_sqrt_card
          (center := center) (ideal := ideal) hr)
      (fun ideal hideal => by
        change AppliedModelingLib.FiniteDimensionalNorms.l2
          (l1LinfBallDirectionSubgradientPerturbation center ideal r) ≤ 0
        rw [l1LinfBallDirectionSubgradientPerturbation_eq_zero_of_notMem_slabBadEvent
          hr hideal]
        norm_num [AppliedModelingLib.FiniteDimensionalNorms.l2,
          AppliedModelingLib.FiniteDimensionalNorms.l2Sq])

/-- One projected source-faithful `L1/L∞` Model A update as a Borel state/ideal map. -/
noncomputable def finiteModelAL1LinfOutcomeStep
    {Coord : Type*} [Fintype Coord]
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (n : ℕ)
    (stateIdeal : (Coord → ℝ) × (Coord → ℝ)) : Coord → ℝ :=
  project (l1LinfBallResponse stateIdeal.1 stateIdeal.2 (ilvRadius r0 (n + 1)))

/-- A Borel projection makes each exact `L1/L∞` Model A update Borel measurable. -/
theorem measurable_finiteModelAL1LinfOutcomeStep
    {Coord : Type*} [Fintype Coord]
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Measurable (finiteModelAL1LinfOutcomeStep r0 project n) := by
  exact hproject.comp (measurable_l1LinfBallResponse (ilvRadius r0 (n + 1)))

/--
The raw response selected at a step of the canonical source-faithful
`L1/L∞` Model A process.  It is the exact coordinatewise clamp, before
Algorithm 1 applies its projection.
-/
noncomputable def finiteModelAL1LinfOutcomeRawResponse
    {Omega Coord : Type*} [Fintype Coord]
    (r0 : ℝ) (trajectory : ℕ → Omega → Coord → ℝ)
    (idealSample : ℕ → Omega → Coord → ℝ)
    (n : ℕ) (omega : Omega) : Coord → ℝ :=
  l1LinfBallResponse (trajectory n omega) (idealSample n omega)
    (ilvRadius r0 (n + 1))

/--
The actual outcome-indexed source Model A recursion at `(p,q) = (1,∞)`,
driven by the canonical iid C3 ideal sequence.  Unlike the Model B process,
this uses the exact clamped raw maximizer on every draw.
-/
noncomputable def finiteModelAL1LinfOutcomeTrajectory
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) : ℕ → (ℕ → Coord → ℝ) → Coord → ℝ
  | 0, _ => initial
  | n + 1, omega =>
      finiteModelAL1LinfOutcomeStep r0 project n
        (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega,
          finiteModelBIdealSample n omega)

/-- The source Model A trajectory starts from its supplied initial point. -/
theorem finiteModelAL1LinfOutcomeTrajectory_zero
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (omega : ℕ → Coord → ℝ) :
    finiteModelAL1LinfOutcomeTrajectory D r0 project initial 0 omega = initial :=
  rfl

/-- Each successor of the source Model A trajectory is the projected exact clamp response. -/
theorem finiteModelAL1LinfOutcomeTrajectory_succ
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelAL1LinfOutcomeTrajectory D r0 project initial (n + 1) omega =
      project (l1LinfBallResponse
        (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1))) := by
  rfl

/-- The raw point in the displayed source Model A successor equation is its named raw response. -/
theorem finiteModelAL1LinfOutcomeTrajectory_succ_rawResponse
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelAL1LinfOutcomeTrajectory D r0 project initial (n + 1) omega =
      project (finiteModelAL1LinfOutcomeRawResponse r0
        (finiteModelAL1LinfOutcomeTrajectory D r0 project initial)
        finiteModelBIdealSample n omega) := by
  rfl

/-- One Borel source-faithful `L∞/L1` Model A update, using the exact water-filled response. -/
noncomputable def finiteModelALinfL1OutcomeStep
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (n : ℕ)
    (stateIdeal : (Coord → ℝ) × (Coord → ℝ)) : Coord → ℝ :=
  project (linfL1WaterfillRawResponse stateIdeal.1 stateIdeal.2 (ilvRadius r0 (n + 1)))

/-- The exact water-filled Model A step is Borel whenever the projection is. -/
theorem measurable_finiteModelALinfL1OutcomeStep
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Measurable (finiteModelALinfL1OutcomeStep r0 project n) := by
  exact hproject.comp (measurable_linfL1WaterfillRawResponse (ilvRadius r0 (n + 1)))

/-- The unprojected exact water-filled response in the canonical `L∞/L1` Model A trace. -/
noncomputable def finiteModelALinfL1OutcomeRawResponse
    {Omega Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (r0 : ℝ) (trajectory : ℕ → Omega → Coord → ℝ)
    (idealSample : ℕ → Omega → Coord → ℝ)
    (n : ℕ) (omega : Omega) : Coord → ℝ :=
  linfL1WaterfillRawResponse (trajectory n omega) (idealSample n omega)
    (ilvRadius r0 (n + 1))

/-- The canonical iid exact Model A recursion at the source `(∞,1)` endpoint. -/
noncomputable def finiteModelALinfL1OutcomeTrajectory
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) : ℕ → (ℕ → Coord → ℝ) → Coord → ℝ
  | 0, _ => initial
  | n + 1, omega =>
      finiteModelALinfL1OutcomeStep r0 project n
        (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega,
          finiteModelBIdealSample n omega)

/-- The water-filled Model A trajectory has the displayed projected raw-response update. -/
theorem finiteModelALinfL1OutcomeTrajectory_succ_rawResponse
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelALinfL1OutcomeTrajectory D r0 project initial (n + 1) omega =
      project (finiteModelALinfL1OutcomeRawResponse r0
        (finiteModelALinfL1OutcomeTrajectory D r0 project initial)
        finiteModelBIdealSample n omega) := by
  rfl

/-- The water-filled raw response remains in the Model A `L1` query ball. -/
theorem finiteModelALinfL1OutcomeRawResponse_l1_distance_le
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteCoordinateDistance SourceNorm.l1
      (finiteModelALinfL1OutcomeRawResponse r0
        (finiteModelALinfL1OutcomeTrajectory D r0 project initial)
        finiteModelBIdealSample n omega)
      (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega) ≤
      ilvRadius r0 (n + 1) := by
  exact linfL1WaterfillRawResponse_l1_distance_le _ _
    (ilvRadius_nonneg (le_of_lt hr0) (n + 1))

/-- The concrete water-filled raw point is an exact source Model A response. -/
theorem finiteModelALinfL1OutcomeRawResponse_is_modelARawResponseAt
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hNorm : UsesFiniteCoordinateNormDistance E)
    (hUtil : IsLpNormedUtilities E SourceNorm.linfty)
    (n : ℕ) (omega : ℕ → Coord → ℝ) (voter : Voter)
    (hideal : E.ideal voter = finiteModelBIdealSample n omega) :
    ModelARawResponseAt E SourceNorm.l1
      (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega)
      (ilvRadius r0 (n + 1)) voter
      (finiteModelALinfL1OutcomeRawResponse r0
        (finiteModelALinfL1OutcomeTrajectory D r0 project initial)
        finiteModelBIdealSample n omega) := by
  exact linfL1WaterfillRawResponse_is_modelARawResponseAt hNorm hUtil hideal
    (ilvRadius_nonneg (le_of_lt hr0) (n + 1))

/--
The water-filled recursion is a projected normalized-direction update.  The
next lemmas split that direction into the symmetric sampled subgradient and
the corrected exceptional-set perturbation.
-/
theorem finiteModelALinfL1OutcomeTrajectory_projected_rawDirection_update
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelALinfL1OutcomeTrajectory D r0 project initial (n + 1) omega =
      project (fun i =>
        finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega i -
          ilvRadius r0 (n + 1) *
            linfL1RawDirection
              (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega)
              (finiteModelALinfL1OutcomeRawResponse r0
                (finiteModelALinfL1OutcomeTrajectory D r0 project initial)
                finiteModelBIdealSample n omega)
              (ilvRadius r0 (n + 1)) i) := by
  rw [finiteModelALinfL1OutcomeTrajectory_succ_rawResponse]
  apply congrArg project
  funext i
  rw [linfL1RawDirection]
  rw [← mul_div_assoc]
  rw [mul_div_cancel_left₀ _ (ne_of_gt (ilvRadius_succ_pos hr0 n))]
  ring

/-- Projection keeps every exact water-filled Model A iterate feasible. -/
theorem finiteModelALinfL1OutcomeTrajectory_mem_solutionSpace
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) {solutionSpace : Set (Coord → ℝ)}
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hinitial : initial ∈ solutionSpace)
    (hproject : ∀ y, project y ∈ solutionSpace) :
    ∀ n omega,
      finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega ∈ solutionSpace := by
  intro n omega
  induction n with
  | zero => simpa [finiteModelALinfL1OutcomeTrajectory] using hinitial
  | succ n ih =>
      rw [finiteModelALinfL1OutcomeTrajectory_succ_rawResponse]
      exact hproject _

/-- The water-filled state at time `n` is measurable with respect to its ideal history. -/
theorem stronglyMeasurable_finiteModelALinfL1OutcomeTrajectory_natural
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) :
    ∀ n, StronglyMeasurable[
      finiteModelBIdealNaturalFiltration (Coord := Coord) n]
      (finiteModelALinfL1OutcomeTrajectory D r0 project initial n) := by
  intro n
  induction n with
  | zero =>
      change StronglyMeasurable[
        finiteModelBIdealNaturalFiltration (Coord := Coord) 0]
        (fun _ : ℕ → Coord → ℝ => initial)
      exact @stronglyMeasurable_const _ _
        (finiteModelBIdealNaturalFiltration (Coord := Coord) 0) _ initial
  | succ n ih =>
      change StronglyMeasurable[
        finiteModelBIdealNaturalFiltration (Coord := Coord) (n + 1)]
        (finiteModelALinfL1OutcomeStep r0 project n ∘ fun omega =>
          (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega,
            finiteModelBIdealSample n omega))
      have hprev : StronglyMeasurable[
          finiteModelBIdealNaturalFiltration (Coord := Coord) (n + 1)]
          (finiteModelALinfL1OutcomeTrajectory D r0 project initial n) :=
        ih.mono (Filtration.mono _ (Nat.le_succ n))
      have hsample : StronglyMeasurable[
          finiteModelBIdealNaturalFiltration (Coord := Coord) (n + 1)]
          (finiteModelBIdealSample (Coord := Coord) n) := by
        apply Measurable.stronglyMeasurable
        change Measurable[⨆ j ≤ n + 1,
          MeasurableSpace.comap (fun omega : ℕ → Coord → ℝ => omega j) inferInstance]
          (fun omega : ℕ → Coord → ℝ => omega (n + 1))
        apply (comap_measurable (fun omega : ℕ → Coord → ℝ => omega (n + 1))).mono
        · exact le_iSup_of_le (n + 1) (le_iSup_of_le le_rfl le_rfl)
        · exact le_rfl
      exact
        ((measurable_finiteModelALinfL1OutcomeStep r0 project hproject n).comp
          (hprev.prodMk hsample).measurable).stronglyMeasurable

/-- The finite-history water-filled recursion used for fresh-sample conditioning. -/
noncomputable def finiteModelALinfL1OutcomePrefixTrajectory
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) :
    (n : ℕ) → (Fin (n + 1) → Coord → ℝ) → Coord → ℝ
  | 0, _ => initial
  | n + 1, history =>
      finiteModelALinfL1OutcomeStep r0 project n
        (finiteModelALinfL1OutcomePrefixTrajectory D r0 project initial n
          (fun j => history j.castSucc), history (Fin.last (n + 1)))

/-- The finite-history water-filled state is Borel measurable. -/
theorem measurable_finiteModelALinfL1OutcomePrefixTrajectory
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) :
    ∀ n, Measurable (finiteModelALinfL1OutcomePrefixTrajectory D r0 project initial n) := by
  intro n
  induction n with
  | zero => exact measurable_const
  | succ n ih =>
      change Measurable (fun history : Fin (n + 2) → Coord → ℝ =>
        finiteModelALinfL1OutcomeStep r0 project n
          (finiteModelALinfL1OutcomePrefixTrajectory D r0 project initial n
            (fun j => history j.castSucc), history (Fin.last (n + 1))))
      have hrestrict : Measurable (fun history : Fin (n + 2) → Coord → ℝ =>
          fun j : Fin (n + 1) => history j.castSucc) := by
        apply measurable_pi_lambda _
        intro j
        exact measurable_pi_apply j.castSucc
      have hlast : Measurable (fun history : Fin (n + 2) → Coord → ℝ =>
          history (Fin.last (n + 1))) :=
        measurable_pi_apply _
      exact (measurable_finiteModelALinfL1OutcomeStep r0 project hproject n).comp
        ((ih.comp hrestrict).prodMk hlast)

/-- The canonical raw prefix evaluates the finite-history water-filled recursion exactly. -/
theorem finiteModelALinfL1OutcomePrefixTrajectory_pastPrefix_eq
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelALinfL1OutcomePrefixTrajectory D r0 project initial n
      (finiteModelBIdealPastPrefix n omega) =
      finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega := by
  induction n with
  | zero => rfl
  | succ n ih =>
      simp only [finiteModelALinfL1OutcomeTrajectory,
        finiteModelALinfL1OutcomePrefixTrajectory, finiteModelBIdealPastPrefix]
      have hprefix : (fun j : Fin (n + 1) =>
          AppliedModelingLib.iidSequencePastPrefix (n + 1) omega j.castSucc) =
          finiteModelBIdealPastPrefix n omega := rfl
      rw [hprefix, ih]
      simp [finiteModelBIdealSample, AppliedModelingLib.iidSequencePastPrefix,
        AppliedModelingLib.iidSequenceSample]

/--
Conditioning an integrable statistic of the water-filled state and fresh C3
sample on the past returns its C3 population integral.
-/
theorem finiteModelALinfL1OutcomeTrajectory_condExp_ae_eq_integral
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ)
    (test : (Coord → ℝ) → (Coord → ℝ) → ℝ)
    (htest : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
        test (finiteModelALinfL1OutcomePrefixTrajectory D r0 project initial n z.1) z.2)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D))) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega => test (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) |
        finiteModelBIdealNaturalFiltration (Coord := Coord) n] =ᵐ[
          finiteModelBIdealSequenceMeasure D]
      fun omega => ∫ ideal,
        test (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega) ideal
          ∂D.idealMeasure := by
  have hcond := finiteModelBIdealPastPrefix_condExp_ae_eq_integral D n
    (fun history ideal =>
      test (finiteModelALinfL1OutcomePrefixTrajectory D r0 project initial n history) ideal)
    htest
  simpa [finiteModelALinfL1OutcomePrefixTrajectory_pastPrefix_eq] using hcond

/-- The canonical raw Model A response stays in the source `L∞` query ball. -/
theorem finiteModelAL1LinfOutcomeRawResponse_linf_distance_le
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteCoordinateDistance SourceNorm.linfty
      (finiteModelAL1LinfOutcomeRawResponse r0
        (finiteModelAL1LinfOutcomeTrajectory D r0 project initial)
        finiteModelBIdealSample n omega)
      (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega) ≤
      ilvRadius r0 (n + 1) := by
  exact l1LinfBallResponse_linf_distance_le
    (ilvRadius_nonneg (le_of_lt hr0) (n + 1))

/-- The canonical raw response minimizes the sampled `L1` cost over its full source query ball. -/
theorem finiteModelAL1LinfOutcomeRawResponse_minimizes_l1_on_linfBall
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ) {candidate : Coord → ℝ}
    (hcandidate : finiteCoordinateDistance SourceNorm.linfty candidate
      (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega) ≤
      ilvRadius r0 (n + 1)) :
    AppliedModelingLib.FiniteDimensionalNorms.l1
        (fun i => finiteModelAL1LinfOutcomeRawResponse r0
          (finiteModelAL1LinfOutcomeTrajectory D r0 project initial)
          finiteModelBIdealSample n omega i - finiteModelBIdealSample n omega i) ≤
      AppliedModelingLib.FiniteDimensionalNorms.l1
        (fun i => candidate i - finiteModelBIdealSample n omega i) := by
  exact l1LinfBallResponse_minimizes_l1_on_linfBall
    (ilvRadius_nonneg (le_of_lt hr0) (n + 1)) hcandidate

/--
When a sampled voter realizes the canonical ideal sample, the raw point in the
concrete trajectory is an exact source Model A response, before projection.
-/
theorem finiteModelAL1LinfOutcomeRawResponse_is_modelARawResponseAt
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hNorm : UsesFiniteCoordinateNormDistance E)
    (hUtil : IsLpNormedUtilities E SourceNorm.l1)
    (n : ℕ) (omega : ℕ → Coord → ℝ) (voter : Voter)
    (hideal : E.ideal voter = finiteModelBIdealSample n omega) :
    ModelARawResponseAt E SourceNorm.linfty
      (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)
      (ilvRadius r0 (n + 1)) voter
      (finiteModelAL1LinfOutcomeRawResponse r0
        (finiteModelAL1LinfOutcomeTrajectory D r0 project initial)
        finiteModelBIdealSample n omega) := by
  exact l1LinfBallResponse_is_modelARawResponseAt hNorm hUtil hideal
    (ilvRadius_nonneg (le_of_lt hr0) (n + 1))

/--
Every canonical source Model A successor is the finite projected SSGM-shaped
update for the exact clamp direction.  On the slab-good event that direction
reduces to the sampled `L1` subgradient.
-/
theorem finiteModelAL1LinfOutcomeTrajectory_projected_clamp_update
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    FiniteProjectedSSGMUpdateAt project
      (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)
      (ilvRadius r0 (n + 1))
      (l1LinfBallDirection
        (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1)))
      (fun _ => 0) (fun _ => 0)
      (finiteModelAL1LinfOutcomeTrajectory D r0 project initial (n + 1) omega) := by
  apply finiteProjectedSSGMUpdateAt_of_l1LinfBallResponse project
    (radius := ilvRadius r0 (n + 1)) rfl
  exact finiteModelAL1LinfOutcomeTrajectory_succ_rawResponse
    D r0 project initial n omega

/--
On the actual source slab-good event at a canonical step, the displayed clamp
direction is exactly the sampled `L1` subgradient used by the paper's SSGM
comparison.
-/
theorem finiteModelAL1LinfOutcomeDirection_eq_sampledLpGradient_of_notMem_slabBadEvent
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ)
    (hgood : finiteModelBIdealSample n omega ∉ l1LinfSlabBadEvent
      (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)
      (ilvRadius r0 (n + 1))) :
    l1LinfBallDirection
        (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1)) =
      lpCostGradientCandidate 1
        (fun i => finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega i -
          finiteModelBIdealSample n omega i) := by
  apply l1LinfBallDirection_eq_lpCostGradientCandidate_one_of_notMem_slabBadEvent
  · exact ilvRadius_pos hr0 (by omega)
  · exact hgood

/--
The state-dependent discrepancy between the exact Model A clamp direction and
the ordinary sampled `L1` subgradient at one canonical step.
-/
noncomputable def finiteModelAL1LinfOutcomeSubgradientPerturbation
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) : Coord → ℝ :=
  l1LinfBallDirectionSubgradientPerturbation
    (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)
    (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1))

/-- The exact Model A perturbation vanishes whenever the current slab event does not occur. -/
theorem finiteModelAL1LinfOutcomeSubgradientPerturbation_eq_zero_of_notMem_slabBadEvent
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ)
    (hgood : finiteModelBIdealSample n omega ∉ l1LinfSlabBadEvent
      (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)
      (ilvRadius r0 (n + 1))) :
    finiteModelAL1LinfOutcomeSubgradientPerturbation D r0 project initial n omega = 0 := by
  unfold finiteModelAL1LinfOutcomeSubgradientPerturbation
  exact l1LinfBallDirectionSubgradientPerturbation_eq_zero_of_notMem_slabBadEvent
    (ilvRadius_pos hr0 (by omega)) hgood

/-- The exact clamp direction is the sampled `L1` subgradient plus its rare perturbation. -/
theorem finiteModelAL1LinfOutcomeDirection_eq_sampledLpGradient_add_perturbation
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    l1LinfBallDirection
        (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) (ilvRadius r0 (n + 1)) =
      fun i => lpCostGradientCandidate 1
        (fun j => finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega j -
          finiteModelBIdealSample n omega j) i +
        finiteModelAL1LinfOutcomeSubgradientPerturbation D r0 project initial n omega i := by
  ext i
  simp only [finiteModelAL1LinfOutcomeSubgradientPerturbation,
    l1LinfBallDirectionSubgradientPerturbation]
  ring

/-- The exact Model A perturbation has a uniform squared Euclidean bound. -/
theorem finiteModelAL1LinfOutcomeSubgradientPerturbation_l2Sq_le_four_card
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ) :
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (finiteModelAL1LinfOutcomeSubgradientPerturbation D r0 project initial n omega) ≤
      4 * Fintype.card Coord := by
  unfold finiteModelAL1LinfOutcomeSubgradientPerturbation
  exact l1LinfBallDirectionSubgradientPerturbation_l2Sq_le_four_card
    (ilvRadius_pos hr0 (by omega))

/-- Projection keeps every source-faithful `L1/L∞` Model A iterate feasible. -/
theorem finiteModelAL1LinfOutcomeTrajectory_mem_solutionSpace
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) {solutionSpace : Set (Coord → ℝ)}
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hinitial : initial ∈ solutionSpace)
    (hproject : ∀ y, project y ∈ solutionSpace) :
    ∀ n omega,
      finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega ∈ solutionSpace := by
  intro n omega
  induction n with
  | zero => simpa [finiteModelAL1LinfOutcomeTrajectory] using hinitial
  | succ n ih =>
      rw [finiteModelAL1LinfOutcomeTrajectory_succ]
      exact hproject _

/--
The source-faithful Model A state at time `n` is measurable with respect to
the raw ideal history through `n`; its response uses only the fresh step-`n`
ideal after that state is determined.
-/
theorem stronglyMeasurable_finiteModelAL1LinfOutcomeTrajectory_natural
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) :
    ∀ n, StronglyMeasurable[
      finiteModelBIdealNaturalFiltration (Coord := Coord) n]
      (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n) := by
  intro n
  induction n with
  | zero =>
      change StronglyMeasurable[
        finiteModelBIdealNaturalFiltration (Coord := Coord) 0]
        (fun _ : ℕ → Coord → ℝ => initial)
      exact @stronglyMeasurable_const _ _
        (finiteModelBIdealNaturalFiltration (Coord := Coord) 0) _ initial
  | succ n ih =>
      change StronglyMeasurable[
        finiteModelBIdealNaturalFiltration (Coord := Coord) (n + 1)]
        (finiteModelAL1LinfOutcomeStep r0 project n ∘ fun omega =>
          (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega,
            finiteModelBIdealSample n omega))
      have hprev : StronglyMeasurable[
          finiteModelBIdealNaturalFiltration (Coord := Coord) (n + 1)]
          (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n) :=
        ih.mono (Filtration.mono _ (Nat.le_succ n))
      have hsample : StronglyMeasurable[
          finiteModelBIdealNaturalFiltration (Coord := Coord) (n + 1)]
          (finiteModelBIdealSample (Coord := Coord) n) := by
        apply Measurable.stronglyMeasurable
        change Measurable[⨆ j ≤ n + 1,
          MeasurableSpace.comap (fun omega : ℕ → Coord → ℝ => omega j) inferInstance]
          (fun omega : ℕ → Coord → ℝ => omega (n + 1))
        apply (comap_measurable (fun omega : ℕ → Coord → ℝ => omega (n + 1))).mono
        · exact le_iSup_of_le (n + 1) (le_iSup_of_le le_rfl le_rfl)
        · exact le_rfl
      exact
        ((measurable_finiteModelAL1LinfOutcomeStep r0 project hproject n).comp
          (hprev.prodMk hsample).measurable).stronglyMeasurable

/-- The canonical exact Model A perturbation is Borel measurable on the iid product space. -/
theorem measurable_finiteModelAL1LinfOutcomeSubgradientPerturbation
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) (n : ℕ) :
    Measurable (finiteModelAL1LinfOutcomeSubgradientPerturbation D r0 project initial n) := by
  unfold finiteModelAL1LinfOutcomeSubgradientPerturbation
  simpa only [Function.comp_apply] using
    (measurable_l1LinfBallDirectionSubgradientPerturbation
      (ilvRadius r0 (n + 1))).comp
    (((stronglyMeasurable_finiteModelAL1LinfOutcomeTrajectory_natural D r0 project
      initial hproject n).measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl).prodMk
      (measurable_finiteModelBIdealSample n))

/-- The squared Euclidean exact Model A perturbation is integrable at every step. -/
theorem integrable_finiteModelAL1LinfOutcomeSubgradientPerturbation_l2Sq
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Integrable (fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (finiteModelAL1LinfOutcomeSubgradientPerturbation D r0 project initial n omega))
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  refine Integrable.mono' (integrable_const (4 * (Fintype.card Coord : ℝ)))
    (hl2sq.comp (measurable_finiteModelAL1LinfOutcomeSubgradientPerturbation
      D r0 project initial hproject n)).aestronglyMeasurable ?_
  filter_upwards [Filter.Eventually.of_forall
    (finiteModelAL1LinfOutcomeSubgradientPerturbation_l2Sq_le_four_card
      D hr0 project initial n)] with omega hbound
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hbound

/-- The Euclidean norm of the exact Model A perturbation is integrable at every step. -/
theorem integrable_finiteModelAL1LinfOutcomeSubgradientPerturbation_l2
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Integrable (fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2
      (finiteModelAL1LinfOutcomeSubgradientPerturbation D r0 project initial n omega))
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  refine Integrable.mono' (integrable_const (2 * Real.sqrt (Fintype.card Coord)))
    (AppliedModelingLib.FiniteDimensionalNorms.continuous_l2.measurable.comp
      (measurable_finiteModelAL1LinfOutcomeSubgradientPerturbation
        D r0 project initial hproject n)).aestronglyMeasurable ?_
  filter_upwards [] with omega
