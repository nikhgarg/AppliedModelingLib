    exact proof_probability_partial_sum_stronglyAdapted_of_stronglyAdapted
      (Y := Y) (ℱ := ℱ) h_adapted
  have hintegrable :
      ∀ n : ℕ,
        Integrable (fun ω => ∑ i ∈ Finset.range n, Y i ω) μ := by
    intro n
    exact
      proof_probability_partial_sum_integrable_of_condSubgaussian
