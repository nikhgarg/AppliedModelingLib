/-- C1 compactness and the exact radial Model A noise bound give target-noise integrability. -/
theorem integrable_finiteModelAL2OutcomeTrajectory_target_noise_product_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) (i : Coord) :
    Integrable (fun omega =>
      (finiteModelAL2OutcomeTrajectory D r0 project initial n omega i - target i) *
        finiteModelAL2OutcomeLpGradientNoise D r0 project initial n omega i)
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have htrajectory := stronglyMeasurable_finiteModelAL2OutcomeTrajectory_natural
    D r0 project initial S.project_measurable n
  have htrajectory_meas : Measurable
      (finiteModelAL2OutcomeTrajectory D r0 project initial n) :=
    htrajectory.measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl
  have hstate : Measurable (fun omega : ℕ → Coord → ℝ =>
      finiteModelAL2OutcomeTrajectory D r0 project initial n omega i - target i) :=
    ((measurable_pi_apply i).comp htrajectory_meas).sub measurable_const
  have hnoise := measurable_finiteModelAL2OutcomeLpGradientNoise
    D r0 project initial S.project_measurable n
  have hmeas : Measurable (fun omega : ℕ → Coord → ℝ =>
      (finiteModelAL2OutcomeTrajectory D r0 project initial n omega i - target i) *
        finiteModelAL2OutcomeLpGradientNoise D r0 project initial n omega i) :=
    hstate.mul ((measurable_pi_apply i).comp hnoise)
  refine Integrable.mono' (integrable_const (2 * finiteModelBC1C2L2Diameter S))
    hmeas.aestronglyMeasurable ?_
  filter_upwards [] with omega
  have hnoise_bound := finiteModelAL2OutcomeLpGradientNoise_coord_abs_le_two
    D r0 project initial n omega i
  have hfeasible := finiteModelAL2OutcomeTrajectory_mem_solutionSpace_of_C1C2
    S r0 initial hinitial n omega
  have hdistance := finiteModelBC1C2L2Diameter_bound S hfeasible htarget
  have hcoordinate := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
    (fun j => finiteModelAL2OutcomeTrajectory D r0 project initial n omega j - target j) i
  have hcoordinate_bound :
      |finiteModelAL2OutcomeTrajectory D r0 project initial n omega i - target i| ≤
        finiteModelBC1C2L2Diameter S :=
    hcoordinate.trans hdistance
  rw [Real.norm_eq_abs, abs_mul]
  calc
    |finiteModelAL2OutcomeTrajectory D r0 project initial n omega i - target i| *
        |finiteModelAL2OutcomeLpGradientNoise D r0 project initial n omega i| ≤
        finiteModelBC1C2L2Diameter S * 2 :=
      mul_le_mul hcoordinate_bound hnoise_bound (abs_nonneg _)
        (finiteModelBC1C2L2Diameter_nonneg S)
    _ = 2 * finiteModelBC1C2L2Diameter S := by ring

/-- At every exact radial iterate, the population Euclidean direction is an expected-cost subgradient. -/
theorem finiteModelAL2OutcomeTrajectory_populationLpGradient_two_subgradient_ae
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (solutionSpace : Set (Coord → ℝ)) (n : ℕ)
    (hcost_integrable : ∀ state : Coord → ℝ,
      Integrable (fun ideal => AppliedModelingLib.FiniteDimensionalNorms.lp 2
        (fun j => state j - ideal j)) D.idealMeasure) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D,
      AppliedModelingLib.Optimization.FiniteSubgradientOn
        (finiteModelBExpectedLpCost D 2) solutionSpace
        (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
        (finiteModelBPopulationLpGradient D 2
          (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)) := by
  filter_upwards [] with omega
  exact finiteModelBPopulationLpGradient_subgradientOn_expectedLpCost
    D (by norm_num)
    solutionSpace
    (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
    hcost_integrable
    (fun i => integrable_lpCostGradientCandidate_coordinate D
      HolderDualFinite.two_two
      (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) i)

/-- The exact radial recursion is a projected population-subgradient update with noise and perturbation. -/
theorem finiteModelAL2OutcomeTrajectory_projected_populationNoisePerturbation_update
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelAL2OutcomeTrajectory D r0 project initial (n + 1) omega =
      project (fun i => finiteModelAL2OutcomeTrajectory D r0 project initial n omega i -
        ilvRadius r0 (n + 1) *
          (finiteModelBPopulationLpGradient D 2
            (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) i +
            finiteModelAL2OutcomeLpGradientNoise D r0 project initial n omega i +
            finiteModelAL2OutcomeSubgradientPerturbation D r0 project initial n omega i)) := by
  have hupdate := finiteModelAL2OutcomeTrajectory_projected_direction_update
    D hr0 project initial n omega
  unfold FiniteProjectedSSGMUpdateAt at hupdate
  rw [hupdate]
  apply congrArg project
  funext i
  rw [finiteModelAL2OutcomeDirection_eq_sampledL2Gradient_add_perturbation,
    ← lpCostGradientCandidate_two_eq_l2DistanceNormalizedGradient]
  simp only [finiteModelAL2OutcomeLpGradientNoise]
  ring

