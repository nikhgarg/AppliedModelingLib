      fun omega =>
        2 * ilvRadius r0 (n + 1) * distanceBound *
          AppliedModelingLib.FiniteDimensionalNorms.l2
            (weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation
              A r0 project initial n omega) +
        3 * ilvRadius r0 (n + 1) ^ 2 *
          AppliedModelingLib.FiniteDimensionalNorms.l2Sq
            (weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation
              A r0 project initial n omega) |
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n] ≤ᵐ[
          AppliedModelingLib.iidSequenceMeasure D.jointMeasure]
      fun _ =>
        (2 * ilvRadius r0 (n + 1) * distanceBound) *
          (2 * (ilvRadius r0 (n + 1) * finiteModelBC1C2CoordinateSlabRealConstant S)) +
        (3 * ilvRadius r0 (n + 1) ^ 2) *
          (4 * (ilvRadius r0 (n + 1) * finiteModelBC1C2CoordinateSlabRealConstant S)) := by
  apply AppliedModelingLib.Optimization.condExp_linear_combination_le_of_bounds
  · exact integrable_weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation_l2
      D A hr0 project initial S.project_measurable n
  · exact integrable_weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation_l2Sq
      D A hr0 project initial S.project_measurable n
  · exact mul_nonneg
      (mul_nonneg (by norm_num) (ilvRadius_nonneg (le_of_lt hr0) (n + 1)))
      hdistanceBound
  · exact mul_nonneg (by norm_num) (sq_nonneg _)
  · exact weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation_condExp_l2_le
      S A hr0 initial n
  · exact weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation_condExp_l2Sq_le
      S A hr0 initial n

/--
The corrected `(∞,1)` exceptional event has the required C1/C2/C3 linear
probability envelope: a coordinate-crossing slab plus the finite union of
near-tie linear slabs.
-/
theorem finiteModelBC1C2_linfL1CorrectedBadEvent_measureReal_le
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (state : Coord → ℝ) {r : ℝ} (hr : 0 ≤ r) :
    (D.idealMeasure (linfL1CorrectedBadEvent state r)).toReal ≤
      r * (finiteModelBC1C2CoordinateSlabRealConstant S +
        finiteModelBC1C2LinearTieSlabRealConstant S) := by
  classical
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let box : Set (Coord → ℝ) :=
    Set.Icc (fun _ => -finiteModelBC1C2OriginL2Radius S)
      (fun _ => finiteModelBC1C2OriginL2Radius S)
  let boundedBad : Set (Coord → ℝ) :=
    linfL1CorrectedBadEvent state r ∩ box
  let coordinateSlabs : Set (Coord → ℝ) := {ideal |
    ∃ i, ideal i ∈ Set.Icc (state i - r) (state i + r)}
  let tieSlabs : Set (Coord → ℝ) := linfL1LinearTieSlabBadRegion
    (fun _ => -finiteModelBC1C2OriginL2Radius S)
    (fun _ => finiteModelBC1C2OriginL2Radius S) state r
  have hsupported : ∀ᵐ ideal ∂D.idealMeasure, ideal ∈ box := by
    filter_upwards [S.ideal_mem_solutionSpace_ae] with ideal hideal
    exact finiteModelBC1C2_mem_symmetric_coordinateBox S hideal
  have hcongr : linfL1CorrectedBadEvent state r =ᵐ[D.idealMeasure] boundedBad := by
    filter_upwards [hsupported] with ideal hideal
    simp only [boundedBad]
    apply propext
    constructor
    · intro hbad
      exact ⟨hbad, hideal⟩
    · exact fun hbad => hbad.1
  have hsubset : boundedBad ⊆ coordinateSlabs ∪ tieSlabs := by
    intro ideal hideal
    rcases linfL1CorrectedBadEvent_subset_slab_union_nearTie state r hideal.1 with
      hslab | hnear
    · left
      exact l1LinfSlabBadEvent_subset_coordinateSlabs state r hslab
    · right
      exact inter_linfL1NearTieBadEvent_subset_linearTieSlabBadRegion
        (fun _ => -finiteModelBC1C2OriginL2Radius S)
        (fun _ => finiteModelBC1C2OriginL2Radius S) state r ⟨hideal.2, hnear⟩
  calc
    (D.idealMeasure (linfL1CorrectedBadEvent state r)).toReal =
        (D.idealMeasure boundedBad).toReal := measureReal_congr hcongr
    _ ≤ (D.idealMeasure (coordinateSlabs ∪ tieSlabs)).toReal :=
      measureReal_mono hsubset (measure_ne_top D.idealMeasure _)
    _ ≤ (D.idealMeasure coordinateSlabs).toReal +
        (D.idealMeasure tieSlabs).toReal := measureReal_union_le _ _
    _ ≤ r * finiteModelBC1C2CoordinateSlabRealConstant S +
        r * finiteModelBC1C2LinearTieSlabRealConstant S := by
      apply add_le_add
      · exact finiteModelBC1C2_ideal_exists_coordinate_slab_measureReal_le S state hr
      · exact finiteModelBC1C2_linearTieSlabBadRegion_measureReal_le S state hr
    _ = r * (finiteModelBC1C2CoordinateSlabRealConstant S +
        finiteModelBC1C2LinearTieSlabRealConstant S) := by ring

/--
The Borel crossing-or-near-tie envelope used for the water-filled symmetric
perturbation has the same C1/C2/C3 linear probability rate as the corrected
exceptional event.
-/
theorem finiteModelBC1C2_linfL1SymmetricPerturbationEnvelope_measureReal_le
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (state : Coord → ℝ) {r : ℝ} (hr : 0 ≤ r) :
    (D.idealMeasure (l1LinfSlabBadEvent state r ∪
      linfL1NearTieBadEvent state r)).toReal ≤
      r * (finiteModelBC1C2CoordinateSlabRealConstant S +
        finiteModelBC1C2LinearTieSlabRealConstant S) := by
  classical
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let box : Set (Coord → ℝ) :=
    Set.Icc (fun _ => -finiteModelBC1C2OriginL2Radius S)
      (fun _ => finiteModelBC1C2OriginL2Radius S)
  let envelope : Set (Coord → ℝ) := l1LinfSlabBadEvent state r ∪
    linfL1NearTieBadEvent state r
  let boundedEnvelope : Set (Coord → ℝ) := envelope ∩ box
  let coordinateSlabs : Set (Coord → ℝ) := {ideal |
    ∃ i, ideal i ∈ Set.Icc (state i - r) (state i + r)}
  let tieSlabs : Set (Coord → ℝ) := linfL1LinearTieSlabBadRegion
    (fun _ => -finiteModelBC1C2OriginL2Radius S)
    (fun _ => finiteModelBC1C2OriginL2Radius S) state r
  have hsupported : ∀ᵐ ideal ∂D.idealMeasure, ideal ∈ box := by
    filter_upwards [S.ideal_mem_solutionSpace_ae] with ideal hideal
    exact finiteModelBC1C2_mem_symmetric_coordinateBox S hideal
  have hcongr : envelope =ᵐ[D.idealMeasure] boundedEnvelope := by
    filter_upwards [hsupported] with ideal hideal
    simp only [boundedEnvelope]
    apply propext
    constructor
    · intro henvelope
      exact ⟨henvelope, hideal⟩
    · exact fun henvelope => henvelope.1
  have hsubset : boundedEnvelope ⊆ coordinateSlabs ∪ tieSlabs := by
    intro ideal hideal
    rcases hideal.1 with hslab | hnear
    · left
      exact l1LinfSlabBadEvent_subset_coordinateSlabs state r hslab
    · right
      exact inter_linfL1NearTieBadEvent_subset_linearTieSlabBadRegion
        (fun _ => -finiteModelBC1C2OriginL2Radius S)
        (fun _ => finiteModelBC1C2OriginL2Radius S) state r ⟨hideal.2, hnear⟩
  calc
    (D.idealMeasure (l1LinfSlabBadEvent state r ∪
        linfL1NearTieBadEvent state r)).toReal =
        (D.idealMeasure boundedEnvelope).toReal := by
          change (D.idealMeasure envelope).toReal = _
          exact measureReal_congr hcongr
    _ ≤ (D.idealMeasure (coordinateSlabs ∪ tieSlabs)).toReal :=
      measureReal_mono hsubset (measure_ne_top D.idealMeasure _)
    _ ≤ (D.idealMeasure coordinateSlabs).toReal +
        (D.idealMeasure tieSlabs).toReal := measureReal_union_le _ _
    _ ≤ r * finiteModelBC1C2CoordinateSlabRealConstant S +
        r * finiteModelBC1C2LinearTieSlabRealConstant S := by
      apply add_le_add
      · exact finiteModelBC1C2_ideal_exists_coordinate_slab_measureReal_le S state hr
      · exact finiteModelBC1C2_linearTieSlabBadRegion_measureReal_le S state hr
    _ = r * (finiteModelBC1C2CoordinateSlabRealConstant S +
        finiteModelBC1C2LinearTieSlabRealConstant S) := by ring

/-- C1/C2/C3 give the strict finite Euclidean ideal-containing ball the same linear envelope. -/
theorem finiteModelBC1C2_l2BallBadEvent_measureReal_le
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (state : Coord → ℝ) {r : ℝ} (hr : 0 ≤ r) :
    (D.idealMeasure (l2BallBadEvent state r)).toReal ≤
      r * finiteModelBC1C2CoordinateSlabRealConstant S := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  calc
    (D.idealMeasure (l2BallBadEvent state r)).toReal ≤
        (D.idealMeasure (l1LinfSlabBadEvent state r)).toReal :=
      measureReal_mono (l2BallBadEvent_subset_l1LinfSlabBadEvent state r)
        (measure_ne_top D.idealMeasure _)
    _ ≤ r * finiteModelBC1C2CoordinateSlabRealConstant S :=
      finiteModelBC1C2_l1LinfSlabBadEvent_measureReal_le S state hr

/--
Conditional squared-moment bound for the exact Model A perturbation.  C3
makes the perturbation's support have probability `O(r_t)`, while its squared
norm is uniformly bounded; hence its conditional squared moment is `O(r_t)`.
-/
theorem finiteModelAL1LinfOutcomeSubgradientPerturbation_condExp_l2Sq_le
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (n : ℕ) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (finiteModelAL1LinfOutcomeSubgradientPerturbation D r0 project initial n omega) |
      finiteModelBIdealNaturalFiltration (Coord := Coord) n] ≤ᵐ[
        finiteModelBIdealSequenceMeasure D]
      fun _ => (4 * Fintype.card Coord) *
        (ilvRadius r0 (n + 1) * finiteModelBC1C2CoordinateSlabRealConstant S) := by
  classical
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  let radius : ℝ := ilvRadius r0 (n + 1)
  let test : (Coord → ℝ) → (Coord → ℝ) → ℝ := fun state ideal =>
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (l1LinfBallDirectionSubgradientPerturbation state ideal radius)
  let pair : (ℕ → Coord → ℝ) →
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) := fun omega =>
    (finiteModelBIdealPastPrefix n omega, finiteModelBIdealSample n omega)
  have hpair_measurable : Measurable pair :=
    (measurable_finiteModelBIdealPastPrefix n).prodMk
      (measurable_finiteModelBIdealSample n)
  letI : IsProbabilityMeasure (Measure.map pair (finiteModelBIdealSequenceMeasure D)) :=
    Measure.isProbabilityMeasure_map hpair_measurable.aemeasurable
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  have hstate_ideal : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      (finiteModelAL1LinfOutcomePrefixTrajectory D r0 project initial n z.1, z.2)) :=
    ((measurable_finiteModelAL1LinfOutcomePrefixTrajectory D r0 project initial
      S.project_measurable n).comp measurable_fst).prodMk measurable_snd
  have htest_measurable : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      test (finiteModelAL1LinfOutcomePrefixTrajectory D r0 project initial n z.1) z.2) := by
    exact hl2sq.comp ((measurable_l1LinfBallDirectionSubgradientPerturbation radius).comp
      hstate_ideal)
  have htest : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      test (finiteModelAL1LinfOutcomePrefixTrajectory D r0 project initial n z.1) z.2)
      (Measure.map pair (finiteModelBIdealSequenceMeasure D)) := by
    refine Integrable.mono' (integrable_const (4 * (Fintype.card Coord : ℝ)))
      htest_measurable.aestronglyMeasurable ?_
    filter_upwards [] with z
    have hbound := l1LinfBallDirectionSubgradientPerturbation_l2Sq_le_four_card
      (center := finiteModelAL1LinfOutcomePrefixTrajectory D r0 project initial n z.1)
      (ideal := z.2) (ilvRadius_succ_pos hr0 n)
    simpa only [test, radius, Real.norm_eq_abs,
      abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hbound
  have hconditional := finiteModelAL1LinfOutcomeTrajectory_condExp_ae_eq_integral
    D r0 project initial n test (by simpa only [pair] using htest)
  have hintegral : ∀ state : Coord → ℝ,
      (∫ ideal, test state ideal ∂D.idealMeasure) ≤
        (4 * Fintype.card Coord) *
          (radius * finiteModelBC1C2CoordinateSlabRealConstant S) := by
    intro state
    calc
      (∫ ideal, test state ideal ∂D.idealMeasure) ≤
          (4 * Fintype.card Coord) *
            (D.idealMeasure (l1LinfSlabBadEvent state radius)).toReal := by
        simpa only [test] using
          integral_l1LinfBallDirectionSubgradientPerturbation_l2Sq_le D state
            (ilvRadius_succ_pos hr0 n)
      _ ≤ (4 * Fintype.card Coord) *
          (radius * finiteModelBC1C2CoordinateSlabRealConstant S) := by
        apply mul_le_mul_of_nonneg_left
        · exact finiteModelBC1C2_l1LinfSlabBadEvent_measureReal_le S state
            (ilvRadius_nonneg (le_of_lt hr0) (n + 1))
        · positivity
  filter_upwards [hconditional] with omega hconditional
  change (finiteModelBIdealSequenceMeasure D)[
      fun omega => test (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) |
      finiteModelBIdealNaturalFiltration (Coord := Coord) n] omega ≤ _
  rw [hconditional]
  simpa only [radius] using
    hintegral (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega)

