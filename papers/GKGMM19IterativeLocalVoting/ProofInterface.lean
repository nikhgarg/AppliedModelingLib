      finiteModelBExpectedLinfMinimizerSet D E.solutionSpace :=
  Classical.choose_spec (finiteModelBExpectedLinfMinimizerSet_nonempty_of_C1C2 S)

/-- C1 compactness gives an expected finite `L1` cost minimizer. -/
theorem finiteModelBExpectedLpMinimizerSet_one_nonempty_of_C1C2
