  noiseBound_nonneg := by positivity
  target_distanceBound_nonneg := by
    intro _ _
    exact finiteModelBC1C2L2Diameter_nonneg S
  noise_energy_bound := by
    intro n
    exact finiteModelBLinfOutcomeGradientNoise_condExp_l2Sq_le_four_card
      C3.data r0 project initial S.project_measurable n
  update := by
    intro n
    filter_upwards [] with omega
    exact finiteModelBLinfOutcomeTrajectory_projected_populationNoise_update
      C3.data r0 project initial n omega
  subgradient := by
    intro n
    filter_upwards [] with omega
    exact finiteModelBPopulationLinfGradient_subgradientOn_expectedLinfCost
      C3.data E.solutionSpace
      (finiteModelBLinfOutcomeTrajectory C3.data r0 project initial n omega)
      (fun state => integrable_finiteModelBLinfCost_of_C1C2 S state)
  gradient_bound := by
    intro n
    filter_upwards [] with omega
    exact finiteModelBPopulationLinfGradient_l2_le_card C3.data
      (finiteModelBLinfOutcomeTrajectory C3.data r0 project initial n omega)
  target_distance_bound := by
    intro target htarget n
    filter_upwards [] with omega
    exact finiteModelBC1C2L2Diameter_bound S
      (finiteModelBLinfOutcomeTrajectory_mem_solutionSpace_of_C1C2
        S r0 initial hinitial n omega) htarget.1
  radius_nonneg := by
    intro n
    exact ilvRadius_nonneg (le_of_lt hr0) (n + 1)
  biasBound := 0
  biasBound_nonneg := le_rfl
  bias_bound := by
    intro n
    rw [AppliedModelingLib.FiniteDimensionalNorms.normL2_zero]
  step_bias_summable := by
    simp [AppliedModelingLib.FiniteDimensionalNorms.normL2_zero]
  radius_sq_summable := ilvRadius_sq_summable r0
  radius_diverges := ilvRadius_sum_tendsto_atTop hr0
  trajectory_mem_solutionSpace := by
    filter_upwards [] with omega
    intro n
    exact finiteModelBLinfOutcomeTrajectory_mem_solutionSpace_of_C1C2
      S r0 initial hinitial n omega
  compact_solutionSpace := S.compact_solutionSpace
  objective_continuous :=
    (continuous_finiteModelBExpectedLinfCost_of_C1C2 S).continuousOn

/-- The source finite `(∞,1)` Model B recursion converges almost surely to its expected `L∞` minimizer set. -/
theorem finiteModelBLinfCanonicalMinimizerSetExecution_outcomeIndexedConverges
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (C3 : FiniteCoordinateC3Carrier E)
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E C3.data project)
    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (hinitial : initial ∈ E.solutionSpace) :
    @AppliedModelingLib.Optimization.OutcomeIndexedConvergesToSet
      (ℕ → Coord → ℝ) (Coord → ℝ) inferInstance inferInstance
      (finiteModelBIdealSequenceMeasure C3.data)
      (finiteModelBLinfOutcomeTrajectory C3.data r0 project initial)
      (finiteModelBExpectedLinfMinimizerSet C3.data E.solutionSpace) := by
  exact AppliedModelingLib.Optimization.ProjectedStochasticSubgradientMinimizerSetExecution.outcomeIndexedConvergesToSet
    (finiteModelBLinfCanonicalMinimizerSetExecution C3 S hr0 initial hinitial)

/-- With the explicit finite `L∞` social-objective identity, the symmetric Model B trace converges to social optima. -/
theorem finiteModelBLinfCanonicalMinimizerSetExecution_outcomeIndexedConvergesToSocialOptimal
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (C3 : FiniteCoordinateC3Carrier E)
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E C3.data project)
    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (hinitial : initial ∈ E.solutionSpace)
    (T : FiniteModelBLinfSocialObjectiveSource E C3.data) :
    @OutcomeIndexedILVConvergesToSocietalOptimal
      Voter (ℕ → Coord → ℝ) (Coord → ℝ) inferInstance inferInstance E
      (finiteModelBIdealSequenceMeasure C3.data)
      (finiteModelBLinfOutcomeTrajectory C3.data r0 project initial) := by
  simpa only [OutcomeIndexedILVConvergesToSocietalOptimal,
    T.minimizerSet_eq_socialOptimal] using
    finiteModelBLinfCanonicalMinimizerSetExecution_outcomeIndexedConverges
      C3 S hr0 initial hinitial

theorem proof_finiteCoordinateNorm_l1_singleActiveSign_eq_one
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {x ideal : Coord → ℝ} {i0 : Coord}
    (hnz : x i0 ≠ ideal i0) :
    finiteCoordinateNorm SourceNorm.l1
      (fun i => if i = i0 then
        (x i0 - ideal i0) / |x i0 - ideal i0| else 0) = 1 := by
  exact finiteCoordinateNorm_l1_singleActiveSign_eq_one hnz

