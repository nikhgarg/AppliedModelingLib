/--
The difference between a realized sampled direction and its C3 population
direction.  This is the canonical martingale-noise process for Model B.
-/
noncomputable def finiteModelBOutcomeLpGradientNoise
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) : Coord → ℝ :=
  fun i => lpCostGradientCandidate p
    (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
      finiteModelBIdealSample n omega j) i -
    finiteModelBPopulationLpGradient D p
      (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i

/-- The canonical centered Model B noise vector is Borel measurable. -/
theorem measurable_finiteModelBOutcomeLpGradientNoise
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) (n : ℕ) :
    Measurable (finiteModelBOutcomeLpGradientNoise D p r0 project initial n) := by
  apply measurable_pi_lambda _
  intro i
  unfold finiteModelBOutcomeLpGradientNoise
  have hstate : Measurable (finiteModelBOutcomeTrajectory D p r0 project initial n) :=
    (stronglyMeasurable_finiteModelBOutcomeTrajectory_natural D p r0 project
      initial hproject n).measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl
  have hdiff : Measurable (fun omega : ℕ → Coord → ℝ =>
      fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
        finiteModelBIdealSample n omega j) := by
    apply measurable_pi_lambda _
    intro j
    exact ((measurable_pi_apply j).comp hstate).sub
      ((measurable_pi_apply j).comp (measurable_finiteModelBIdealSample n))
  have hsample : Measurable (fun omega => lpCostGradientCandidate p
      (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
        finiteModelBIdealSample n omega j) i) :=
    (measurable_pi_apply i).comp ((measurable_lpCostGradientCandidate p).comp hdiff)
  have hpopulation : Measurable (fun omega => finiteModelBPopulationLpGradient D p
      (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i) :=
    (stronglyMeasurable_finiteModelBPopulationLpGradient_coordinate_natural
      D p r0 project initial hproject n i).measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl
  exact hsample.sub hpopulation

/-- Every coordinate of the canonical centered Model B noise is bounded by two. -/
theorem finiteModelBOutcomeLpGradientNoise_coord_abs_le_two_ae
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q r0 : ℝ} (hdual : HolderDualFinite p q)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D,
      |finiteModelBOutcomeLpGradientNoise D p r0 project initial n omega i| ≤ 2 := by
  filter_upwards [finiteModelBOutcomeTrajectory_sampledLpDirection_coord_abs_le_one_ae
    D hdual project initial hproject n i] with omega hsample
  rw [finiteModelBOutcomeLpGradientNoise]
  have hpopulation := finiteModelBPopulationLpGradient_coord_abs_le_one
    D hdual (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i
  calc
    |lpCostGradientCandidate p
        (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
          finiteModelBIdealSample n omega j) i -
        finiteModelBPopulationLpGradient D p
          (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i| ≤
        |lpCostGradientCandidate p
          (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
            finiteModelBIdealSample n omega j) i| +
          |finiteModelBPopulationLpGradient D p
            (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i| := by
              simpa using (abs_sub_le
                (lpCostGradientCandidate p
                  (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
                    finiteModelBIdealSample n omega j) i)
                0
                (finiteModelBPopulationLpGradient D p
                  (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i))
    _ ≤ 2 := by linarith

