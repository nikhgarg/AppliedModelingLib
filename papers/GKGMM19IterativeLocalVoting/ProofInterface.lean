/--
Almost surely, every step of the canonical Model B run is coordinatewise
noncolliding with its fresh C3 ideal draw.  The conclusion is simultaneous in
time, so it can be used for the whole recursive response trajectory.
-/
theorem finiteModelBOutcomeTrajectory_ae_all_coordinate_noncollision
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D, ∀ n i,
      finiteModelBOutcomeTrajectory D p r0 project initial n omega i ≠
        finiteModelBIdealSample n omega i := by
  rw [ae_all_iff]
  intro n
  exact finiteModelBOutcomeTrajectory_ae_coordinate_noncollision
    D p r0 project initial hproject n

/--
For each fixed step, the unprojected response of the canonical run obeys the
paper's Model B formula almost surely.  The sole exceptional event is the C3
coordinate-collision event, which was discharged from bounded density above.
-/
theorem finiteModelBOutcomeRawResponse_is_modelBResponse_ae
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q r0 : ℝ} (hdual : HolderDualFinite p q)
    (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) (n : ℕ) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D,
      ModelBFiniteResponseAt (SourceNorm.lp q)
        (finiteModelBOutcomeTrajectory D p r0 project initial n omega)
        (ilvRadius r0 (n + 1))
        (fun i => -lpCostGradientCandidate p
          (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
            finiteModelBIdealSample n omega j) i)
        (finiteModelBOutcomeRawResponse p r0
          (finiteModelBOutcomeTrajectory D p r0 project initial)
          finiteModelBIdealSample n omega) := by
  filter_upwards [finiteModelBOutcomeTrajectory_ae_coordinate_noncollision
    D p r0 project initial hproject n] with omega hcoord
  exact
    (modelBFiniteResponseAt_neg_lpCostGradientCandidate_formula hdual hcoord
      (ilvRadius r0 (n + 1)) _).mpr rfl

/-- The canonical `p = 1` raw response obeys the source Model B `L∞` formula a.e. -/
theorem finiteModelBOutcomeRawResponse_is_modelBResponse_one_ae
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) (n : ℕ) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D,
      ModelBFiniteResponseAt SourceNorm.linfty
        (finiteModelBOutcomeTrajectory D 1 r0 project initial n omega)
        (ilvRadius r0 (n + 1))
        (fun i => -lpCostGradientCandidate 1
          (fun j => finiteModelBOutcomeTrajectory D 1 r0 project initial n omega j -
            finiteModelBIdealSample n omega j) i)
        (finiteModelBOutcomeRawResponse 1 r0
          (finiteModelBOutcomeTrajectory D 1 r0 project initial)
          finiteModelBIdealSample n omega) := by
  filter_upwards [finiteModelBOutcomeTrajectory_ae_coordinate_noncollision
    D 1 r0 project initial hproject n] with omega hcoord
  exact
    (modelBFiniteResponseAt_neg_lpCostGradientCandidate_one_formula hcoord
      (ilvRadius r0 (n + 1)) _).mpr rfl

/--
The Model B raw-response equation holds for every step on a single
probability-one event of the canonical run.
-/
theorem finiteModelBOutcomeRawResponse_is_modelBResponse_ae_all
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q r0 : ℝ} (hdual : HolderDualFinite p q)
    (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) :
