/--
Sampled Algorithm 2 data over a possibly non-singleton target set.  The sample
cost and selected voter make the ILV connection explicit, while the inherited
execution supplies the proved stochastic-approximation hypotheses rather than
a conclusion certificate.
-/
structure FiniteCoordinateILVRandomSampledMinimizerSetExecution
    {Voter Coord : Type*} [Fintype Coord]
    (E : ILVEnvironment Voter (Coord → ℝ)) (target : Set (Coord → ℝ)) extends
    AppliedModelingLib.Optimization.SampledProjectedStochasticSubgradientMinimizerSetExecution
      Coord where
  solutionSpace_eq : toSampledProjectedStochasticSubgradientMinimizerSetExecution.solutionSpace =
    E.solutionSpace
  voterOfSample : toSampledProjectedStochasticSubgradientMinimizerSetExecution.Sample → Voter
  sampleCost_eq_neg_utility : ∀ sample x,
    toSampledProjectedStochasticSubgradientMinimizerSetExecution.sampleCost sample x =
      -E.utility (voterOfSample sample) x
  objective_eq_socialCost :
    toSampledProjectedStochasticSubgradientMinimizerSetExecution.objective = socialCostObjective E
  targetSet_eq : toSampledProjectedStochasticSubgradientMinimizerSetExecution.targetSet =
    target

/-- The voter selected by a sampled minimizer-set ILV execution. -/
noncomputable def FiniteCoordinateILVRandomSampledMinimizerSetExecution.selectedVoter
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)} {targetSet : Set (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSampledMinimizerSetExecution E targetSet)
    (n : ℕ) (omega : S.Ω) : Voter :=
  S.voterOfSample (S.sample n omega)

/-- Each sampled Algorithm 2 direction is a subgradient of the selected cost. -/
theorem FiniteCoordinateILVRandomSampledMinimizerSetExecution.sampledDirection_subgradient
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)} {targetSet : Set (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSampledMinimizerSetExecution E targetSet) (n : ℕ) :
    ∀ᵐ omega ∂S.μ,
      FiniteSubgradientWithinAt
        (fun x => -E.utility (S.selectedVoter n omega) x) E.solutionSpace
        (S.trajectory n omega) (S.sampledDirection n omega) := by
  filter_upwards [S.sampled_direction_subgradient n] with omega hsub
  have hcost : S.sampleCost (S.sample n omega) =
      fun x => -E.utility (S.selectedVoter n omega) x := by
    funext x
    exact S.sampleCost_eq_neg_utility (S.sample n omega) x
  simpa [hcost, selectedVoter, S.solutionSpace_eq] using hsub

/-- Algorithm 2's projected update for a sampled minimizer-set execution. -/
theorem FiniteCoordinateILVRandomSampledMinimizerSetExecution.algorithm2_update
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)} {targetSet : Set (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSampledMinimizerSetExecution E targetSet) (n : ℕ) :
    ∀ᵐ omega ∂S.μ,
      S.trajectory (n + 1) omega = S.project (fun i => S.trajectory n omega i -
        S.radius (n + 1) * S.sampledDirection n omega i) := by
  exact AppliedModelingLib.Optimization.SampledProjectedStochasticSubgradientMinimizerSetExecution.update_eq_sampled_direction
    S.toSampledProjectedStochasticSubgradientMinimizerSetExecution n

/-- A sampled minimizer-set execution reaches the designated social optimum set. -/
theorem FiniteCoordinateILVRandomSampledMinimizerSetExecution.outcomeIndexed_convergesToSocialOptimal
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSampledMinimizerSetExecution E E.socialOptimal) :
    @OutcomeIndexedILVConvergesToSocietalOptimal
      Voter S.Ω (Coord → ℝ) S.measurableSpace inferInstance E S.μ S.trajectory := by
  letI := S.measurableSpace
  have h := AppliedModelingLib.Optimization.ProjectedStochasticSubgradientMinimizerSetExecution.outcomeIndexedConvergesToSet
    S.toSampledProjectedStochasticSubgradientMinimizerSetExecution.toProjectedStochasticSubgradientMinimizerSetExecution
  have htarget : S.toSampledProjectedStochasticSubgradientMinimizerSetExecution.toProjectedStochasticSubgradientMinimizerSetExecution.targetSet = E.socialOptimal :=
    S.targetSet_eq
  simpa only [OutcomeIndexedILVConvergesToSocietalOptimal, htarget] using h

/-- A sampled minimizer-set execution reaches the designated median set. -/
theorem FiniteCoordinateILVRandomSampledMinimizerSetExecution.outcomeIndexed_convergesToMedianSet
    {Voter Coord : Type*} [Fintype Coord]
