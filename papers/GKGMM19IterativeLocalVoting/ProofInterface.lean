      measureReal_mono (l1LinfSlabBadEvent_subset_coordinateSlabs state r)
        (measure_ne_top D.idealMeasure _)
    _ ≤ r * finiteModelBC1C2CoordinateSlabRealConstant S :=
      finiteModelBC1C2_ideal_exists_coordinate_slab_measureReal_le S state hr

/--
C1/C2/C3 give the linear-in-radius probability bound required by Appendix
C.5's weighted-Euclidean Model A reduction.  The proof transports the event
through the actual joint law's ideal marginal; it does not separate a voter's
weights and ideal point.
-/
theorem weightedEuclideanJointSampleBlockBadEvent_measureReal_le
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (state : Coord → ℝ) {radius : ℝ} (hradius : 0 ≤ radius) :
    (D.jointMeasure (weightedEuclideanJointSampleBlockBadEvent D state radius)).toReal ≤
      radius * finiteModelBC1C2CoordinateSlabRealConstant S := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  let slab : Set (Coord → ℝ) := l1LinfSlabBadEvent state radius
  have hslab_measurable : MeasurableSet slab :=
    measurableSet_l1LinfSlabBadEvent state radius
  have hmarginal : D.jointMeasure (Prod.snd ⁻¹' slab) =
      D.idealDistribution.idealMeasure slab := by
    calc
      D.jointMeasure (Prod.snd ⁻¹' slab) =
          Measure.map Prod.snd D.jointMeasure slab := by
            symm
            exact Measure.map_apply measurable_snd hslab_measurable
      _ = D.idealDistribution.idealMeasure slab := by rw [D.ideal_marginal]
  calc
    (D.jointMeasure (weightedEuclideanJointSampleBlockBadEvent D state radius)).toReal ≤
        (D.jointMeasure (Prod.snd ⁻¹' slab)).toReal :=
      measureReal_mono
        (weightedEuclideanJointSampleBlockBadEvent_subset_idealSlab D state radius)
        (measure_ne_top D.jointMeasure _)
    _ = (D.idealDistribution.idealMeasure slab).toReal := by rw [hmarginal]
    _ ≤ radius * finiteModelBC1C2CoordinateSlabRealConstant S :=
      finiteModelBC1C2_l1LinfSlabBadEvent_measureReal_le S state hradius

/--
The selected weighted-Euclidean Model A exceptional direction has first
moment `O(r)` under C1/C2/C3.  The argument keeps the arbitrary valid
tie-breaking response intact and uses only its exact agreement off the
block-crossing event.
-/
theorem integral_weightedEuclideanJointSampleModelASubgradientPerturbation_l2_le
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (state : Coord → ℝ) {radius : ℝ} (hradius : 0 < radius) :
    (∫ sample, AppliedModelingLib.FiniteDimensionalNorms.l2
      (weightedEuclideanJointSampleModelASubgradientPerturbation A state radius sample)
      ∂D.jointMeasure) ≤
      2 * (radius * finiteModelBC1C2CoordinateSlabRealConstant S) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  let bad : Set ((Component → ℝ) × (Coord → ℝ)) :=
    weightedEuclideanJointSampleBlockBadEvent D state radius
  have hpiece : ∀ᵐ sample ∂D.jointMeasure,
      (sample ∈ bad → AppliedModelingLib.FiniteDimensionalNorms.l2
        (weightedEuclideanJointSampleModelASubgradientPerturbation A state radius sample) ≤ 2) ∧
      (sample ∉ bad → AppliedModelingLib.FiniteDimensionalNorms.l2
        (weightedEuclideanJointSampleModelASubgradientPerturbation A state radius sample) ≤ 0) := by
    filter_upwards [D.sampleWeight_nonnegative_ae, D.sampleWeightNorm2_pos_ae,
      weightedEuclideanJointSampleModelASubgradientPerturbation_l2_le_two_ae
        D A state hradius] with sample hweight hnorm hbound
    constructor
    · intro _
      exact hbound
    · intro hnot
      rw [weightedEuclideanJointSampleModelASubgradientPerturbation_eq_zero_of_valid_of_notMem_blockBadEvent
        A hradius sample hweight hnorm (by simpa only [bad] using hnot)]
      change AppliedModelingLib.FiniteDimensionalNorms.l2 (fun _ : Coord => 0) ≤ 0
      rw [AppliedModelingLib.FiniteDimensionalNorms.normL2_zero]
  have htwoPiece := AppliedModelingLib.integral_le_measureReal_mul_add_compl_of_ae_le_on_of_ae_le_on_compl
    D.jointMeasure (measurableSet_weightedEuclideanJointSampleBlockBadEvent D state radius)
    (integrable_weightedEuclideanJointSampleModelASubgradientPerturbation_l2
      D A state hradius) hpiece
  calc
    (∫ sample, AppliedModelingLib.FiniteDimensionalNorms.l2
        (weightedEuclideanJointSampleModelASubgradientPerturbation A state radius sample)
        ∂D.jointMeasure) ≤
        2 * D.jointMeasure.real bad + 0 * D.jointMeasure.real badᶜ := by
          simpa only [bad] using htwoPiece
    _ = 2 * D.jointMeasure.real bad := by ring
    _ ≤ 2 * (radius * finiteModelBC1C2CoordinateSlabRealConstant S) := by
      apply mul_le_mul_of_nonneg_left
      · exact weightedEuclideanJointSampleBlockBadEvent_measureReal_le S state (le_of_lt hradius)
      · norm_num

