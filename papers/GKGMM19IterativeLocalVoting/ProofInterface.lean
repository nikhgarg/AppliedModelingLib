    S.toSampledProjectedStochasticSubgradientMinimizerSetExecution.toProjectedStochasticSubgradientMinimizerSetExecution
  have htarget : S.toSampledProjectedStochasticSubgradientMinimizerSetExecution.toProjectedStochasticSubgradientMinimizerSetExecution.targetSet = E.medianSet :=
    S.targetSet_eq
  simpa only [OutcomeIndexedILVConvergesToMedianSet, htarget] using h

/--
Conditional fresh-voter sampling makes a centered sampled direction into the
martingale noise required by the minimizer-set SSGM execution.  This is the
paper-specific source-to-model calculation; it uses no convergence result.
-/
theorem FiniteCoordinateILVRandomSampledMinimizerSetExecution.noise_mean_zero_of_centered_direction
    {Voter Coord : Type*} [MeasurableSpace Voter] [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)} {target : Set (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSampledMinimizerSetExecution E target)
    (voterMeasure : Measure Voter) (n : ℕ) (i : Coord)
    (direction : S.Ω → Voter → Coord → ℝ)
    (hconditional :
      S.μ[fun omega => direction omega (S.selectedVoter n omega) i | S.filtration n] =ᵐ[S.μ]
        fun omega => ∫ voter, direction omega voter i ∂voterMeasure)
    (hintegrable : Integrable
      (fun omega => direction omega (S.selectedVoter n omega) i) S.μ)
    (hpopulation_measurable : StronglyMeasurable[S.filtration n]
      (fun omega => ∫ voter, direction omega voter i ∂voterMeasure))
    (hpopulation_integrable : Integrable
      (fun omega => ∫ voter, direction omega voter i ∂voterMeasure) S.μ)
    (hnoise : (fun omega => S.noise n omega i) =ᵐ[S.μ]
      (fun omega => direction omega (S.selectedVoter n omega) i) -
        (fun omega => ∫ voter, direction omega voter i ∂voterMeasure)) :
    S.μ[fun omega => S.noise n omega i | S.filtration n] =ᵐ[S.μ] 0 := by
  letI := S.measurableSpace
  letI := S.probability
  apply (condExp_congr_ae hnoise).trans
  have hpopulation_conditional :
      S.μ[fun omega => ∫ voter, direction omega voter i ∂voterMeasure | S.filtration n] =ᵐ[S.μ]
        fun omega => ∫ voter, direction omega voter i ∂voterMeasure := by
    rw [condExp_of_stronglyMeasurable (S.filtration.le n) hpopulation_measurable
      hpopulation_integrable]
  filter_upwards [
    condExp_sub hintegrable hpopulation_integrable (S.filtration n),
    hconditional, hpopulation_conditional] with omega hsub hsample hpopulation
  rw [hsub]
  simp only [Pi.sub_apply, Pi.zero_apply]
  rw [hsample, hpopulation]
  ring

/--
Fresh sampling at the level of the actual sample type, rather than only a
selected-voter marginal, gives the martingale-noise calculation for a
minimizer-set ILV execution.  It is the form used when the source model samples
ideal points or response records directly.
-/
theorem FiniteCoordinateILVRandomSampledMinimizerSetExecution.noise_mean_zero_of_fresh_sample
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)} {target : Set (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSampledMinimizerSetExecution E target)
    [MeasurableSpace S.Sample]
    (L : AppliedModelingLib.Optimization.AdaptedConditionalLawSampledMinimizerSetStream
      S.toSampledProjectedStochasticSubgradientMinimizerSetExecution)
    (n : ℕ) (i : Coord) (direction : S.Ω → S.Sample → Coord → ℝ)
    (hadapted : ∀ sample,
      StronglyMeasurable[S.filtration n] (fun omega => direction omega sample i))
    (hintegrable : Integrable
      (fun omega => direction omega (S.sample n omega) i) S.μ)
    (hpopulation_measurable : StronglyMeasurable[S.filtration n]
      (fun omega => ∫ sample, direction omega sample i ∂L.sampleMeasure))
    (hpopulation_integrable : Integrable
      (fun omega => ∫ sample, direction omega sample i ∂L.sampleMeasure) S.μ)
    (hnoise : (fun omega => S.noise n omega i) =ᵐ[S.μ]
      (fun omega => direction omega (S.sample n omega) i) -
        (fun omega => ∫ sample, direction omega sample i ∂L.sampleMeasure)) :
    S.μ[fun omega => S.noise n omega i | S.filtration n] =ᵐ[S.μ] 0 := by
  apply (condExp_congr_ae hnoise).trans
  exact AppliedModelingLib.Optimization.AdaptedConditionalLawSampledMinimizerSetStream.condExp_centered_statistic_eq_zero
    L n (fun omega sample => direction omega sample i)
      hadapted hintegrable hpopulation_measurable hpopulation_integrable

/--
A finite-coordinate ILV execution whose unique stochastic-subgradient target
is identified with the Proposition 2 median set.  The parent execution still
