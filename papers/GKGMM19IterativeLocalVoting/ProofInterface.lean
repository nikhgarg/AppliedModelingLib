/-- The fresh-sample Euclidean gradient coordinate is integrable on the exact radial prefix/product law. -/
theorem integrable_finiteModelAL2OutcomePrefixTrajectory_lpCostGradientCandidate_two
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project)
    (n : ℕ) (i : Coord) :
    Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      lpCostGradientCandidate 2
        (fun j => finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1 j -
          z.2 j) i)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D)) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let pair : (ℕ → Coord → ℝ) →
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) := fun omega =>
    (finiteModelBIdealPastPrefix n omega, finiteModelBIdealSample n omega)
  have hpair : Measurable pair :=
    (measurable_finiteModelBIdealPastPrefix n).prodMk
      (measurable_finiteModelBIdealSample n)
  letI : IsProbabilityMeasure (Measure.map pair (finiteModelBIdealSequenceMeasure D)) :=
    Measure.isProbabilityMeasure_map hpair.aemeasurable
  have hprefix := measurable_finiteModelAL2OutcomePrefixTrajectory
    D r0 project initial hproject n
  have hdiff : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      fun j => finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1 j - z.2 j) := by
    apply measurable_pi_lambda _
    intro j
    exact ((measurable_pi_apply j).comp (hprefix.comp measurable_fst)).sub
      ((measurable_pi_apply j).comp measurable_snd)
  have htest : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      lpCostGradientCandidate 2
        (fun j => finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1 j -
          z.2 j) i) :=
    (measurable_pi_apply i).comp ((measurable_lpCostGradientCandidate 2).comp hdiff)
  change Integrable _ (Measure.map pair (finiteModelBIdealSequenceMeasure D))
  refine Integrable.mono' (integrable_const 1) htest.aestronglyMeasurable ?_
  rw [finiteModelBIdealPastPrefix_idealSample_pair_law D n]
  have hmeasSet : MeasurableSet {z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) |
      ‖lpCostGradientCandidate 2
        (fun j => finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1 j -
          z.2 j) i‖ ≤ 1} := by
    simpa only [Function.comp_apply, Set.preimage_setOf_eq, Set.mem_Iic] using
      (continuous_norm.measurable.comp htest) measurableSet_Iic
  rw [Measure.ae_prod_iff_ae_ae hmeasSet]
  exact Filter.Eventually.of_forall fun past => by
    filter_upwards [lpCostGradientCandidate_coord_abs_le_one_ae D
      HolderDualFinite.two_two
      (finiteModelAL2OutcomePrefixTrajectory D r0 project initial n past) i]
      with ideal hbound
    simpa only [Real.norm_eq_abs] using hbound

/-- The conditional mean of a sampled Euclidean gradient at an exact radial state is its population direction. -/
theorem finiteModelAL2OutcomeTrajectory_lpCostGradientCandidate_condExp_ae_eq_population
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (i : Coord)
    (hintegrable : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      lpCostGradientCandidate 2
        (fun j => finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1 j -
          z.2 j) i)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D))) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega => lpCostGradientCandidate 2
        (fun j => finiteModelAL2OutcomeTrajectory D r0 project initial n omega j -
          finiteModelBIdealSample n omega j) i |
        finiteModelBIdealNaturalFiltration (Coord := Coord) n] =ᵐ[
          finiteModelBIdealSequenceMeasure D]
      fun omega => finiteModelBPopulationLpGradient D 2
        (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) i := by
  simpa only [finiteModelBPopulationLpGradient] using
    (finiteModelAL2OutcomeTrajectory_condExp_ae_eq_integral D r0 project initial n
      (fun state ideal => lpCostGradientCandidate 2 (fun j => state j - ideal j) i)
      hintegrable)

/-- The population Euclidean direction at an exact radial state is adapted to the ideal history. -/
theorem stronglyMeasurable_finiteModelAL2PopulationLpGradient_coordinate_natural
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project)
    (n : ℕ) (i : Coord) :
    StronglyMeasurable[finiteModelBIdealNaturalFiltration (Coord := Coord) n]
      (fun omega => finiteModelBPopulationLpGradient D 2
        (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) i) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  have hdiff : Measurable
      (fun z : (Coord → ℝ) × (Coord → ℝ) => fun j => z.1 j - z.2 j) := by
    apply measurable_pi_lambda _
    intro j
    exact ((measurable_pi_apply j).comp measurable_fst).sub
      ((measurable_pi_apply j).comp measurable_snd)
  have hcoordinate : StronglyMeasurable
      (fun z : (Coord → ℝ) × (Coord → ℝ) =>
        lpCostGradientCandidate 2 (fun j => z.1 j - z.2 j) i) :=
    ((measurable_pi_apply i).comp
      ((measurable_lpCostGradientCandidate 2).comp hdiff)).stronglyMeasurable
  have hpopulation : StronglyMeasurable
      (fun state : Coord → ℝ => ∫ ideal,
        lpCostGradientCandidate 2 (fun j => state j - ideal j) i ∂D.idealMeasure) :=
    hcoordinate.integral_prod_right
  simpa only [finiteModelBPopulationLpGradient] using
    hpopulation.comp_measurable
      (stronglyMeasurable_finiteModelAL2OutcomeTrajectory_natural D r0 project
        initial hproject n).measurable

/-- The martingale-noise component of the sampled Euclidean gradient along exact radial Model A. -/
noncomputable def finiteModelAL2OutcomeLpGradientNoise
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) : Coord → ℝ :=
  fun i => lpCostGradientCandidate 2
    (fun j => finiteModelAL2OutcomeTrajectory D r0 project initial n omega j -
      finiteModelBIdealSample n omega j) i -
    finiteModelBPopulationLpGradient D 2
      (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) i

/-- The exact radial centered gradient noise is Borel measurable. -/
theorem measurable_finiteModelAL2OutcomeLpGradientNoise
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) (n : ℕ) :
    Measurable (finiteModelAL2OutcomeLpGradientNoise D r0 project initial n) := by
  apply measurable_pi_lambda _
  intro i
  unfold finiteModelAL2OutcomeLpGradientNoise
  have hstate : Measurable (finiteModelAL2OutcomeTrajectory D r0 project initial n) :=
    (stronglyMeasurable_finiteModelAL2OutcomeTrajectory_natural D r0 project
      initial hproject n).measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl
  have hdiff : Measurable (fun omega : ℕ → Coord → ℝ =>
      fun j => finiteModelAL2OutcomeTrajectory D r0 project initial n omega j -
        finiteModelBIdealSample n omega j) := by
    apply measurable_pi_lambda _
    intro j
    exact ((measurable_pi_apply j).comp hstate).sub
      ((measurable_pi_apply j).comp (measurable_finiteModelBIdealSample n))
  have hsample : Measurable (fun omega => lpCostGradientCandidate 2
      (fun j => finiteModelAL2OutcomeTrajectory D r0 project initial n omega j -
        finiteModelBIdealSample n omega j) i) :=
    (measurable_pi_apply i).comp ((measurable_lpCostGradientCandidate 2).comp hdiff)
  have hpopulation : Measurable (fun omega => finiteModelBPopulationLpGradient D 2
      (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) i) :=
    (stronglyMeasurable_finiteModelAL2PopulationLpGradient_coordinate_natural
      D r0 project initial hproject n i).measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl
  exact hsample.sub hpopulation

/-- Every coordinate of the exact radial martingale noise is bounded by two. -/
theorem finiteModelAL2OutcomeLpGradientNoise_coord_abs_le_two
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) (i : Coord) :
    |finiteModelAL2OutcomeLpGradientNoise D r0 project initial n omega i| ≤ 2 := by
  rw [finiteModelAL2OutcomeLpGradientNoise]
  calc
    |lpCostGradientCandidate 2
        (fun j => finiteModelAL2OutcomeTrajectory D r0 project initial n omega j -
          finiteModelBIdealSample n omega j) i -
        finiteModelBPopulationLpGradient D 2
          (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) i| ≤
        |lpCostGradientCandidate 2
          (fun j => finiteModelAL2OutcomeTrajectory D r0 project initial n omega j -
            finiteModelBIdealSample n omega j) i| +
          |finiteModelBPopulationLpGradient D 2
            (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) i| := by
          simpa using (abs_sub_le
            (lpCostGradientCandidate 2
              (fun j => finiteModelAL2OutcomeTrajectory D r0 project initial n omega j -
                finiteModelBIdealSample n omega j) i)
            0
            (finiteModelBPopulationLpGradient D 2
              (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) i))
    _ ≤ 2 := by
      have hsample : |lpCostGradientCandidate 2
          (fun j => finiteModelAL2OutcomeTrajectory D r0 project initial n omega j -
            finiteModelBIdealSample n omega j) i| ≤ 1 := by
        rw [lpCostGradientCandidate_two_eq_l2DistanceNormalizedGradient]
        exact (AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
          (l2DistanceNormalizedGradient
            (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
            (finiteModelBIdealSample n omega)) i).trans
          (l2DistanceNormalizedGradient_l2_le_one _ _)
      have hpopulation := finiteModelBPopulationLpGradient_coord_abs_le_one D
        HolderDualFinite.two_two
        (finiteModelAL2OutcomeTrajectory D r0 project initial n omega) i
      linarith

/-- The exact radial martingale noise has squared Euclidean norm at most `4 * card`. -/
theorem finiteModelAL2OutcomeLpGradientNoise_l2Sq_le_four_card
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (finiteModelAL2OutcomeLpGradientNoise D r0 project initial n omega) ≤
      4 * Fintype.card Coord := by
  have hnorm := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_card_mul_sq_of_abs_le
    (finiteModelAL2OutcomeLpGradientNoise D r0 project initial n omega)
    (by norm_num : (0 : ℝ) ≤ 2)
    (fun i => finiteModelAL2OutcomeLpGradientNoise_coord_abs_le_two
      D r0 project initial n omega i)
  norm_num at hnorm ⊢
  nlinarith

/-- Prefix-product integrability transfers to the realized sampled Euclidean gradient. -/
theorem finiteModelAL2OutcomeTrajectory_lpCostGradientCandidate_integrable
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project)
    (n : ℕ) (i : Coord) :
    Integrable (fun omega => lpCostGradientCandidate 2
      (fun j => finiteModelAL2OutcomeTrajectory D r0 project initial n omega j -
        finiteModelBIdealSample n omega j) i)
      (finiteModelBIdealSequenceMeasure D) := by
  let pair : (ℕ → Coord → ℝ) →
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) := fun omega =>
    (finiteModelBIdealPastPrefix n omega, finiteModelBIdealSample n omega)
  have hpair_measurable : Measurable pair :=
    (measurable_finiteModelBIdealPastPrefix n).prodMk
      (measurable_finiteModelBIdealSample n)
  have hprefix := integrable_finiteModelAL2OutcomePrefixTrajectory_lpCostGradientCandidate_two
    D r0 project initial hproject n i
  have hcomposed : Integrable (fun omega => lpCostGradientCandidate 2
      (fun j => finiteModelAL2OutcomePrefixTrajectory D r0 project initial n
        (finiteModelBIdealPastPrefix n omega) j - finiteModelBIdealSample n omega j) i)
