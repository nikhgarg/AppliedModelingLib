        finiteModelBIdealSample n omega))
      (finiteModelBIdealSequenceMeasure D) =
        (Measure.map (finiteModelBOutcomeTrajectory D p r0 project initial n)
          (finiteModelBIdealSequenceMeasure D)).prod D.idealMeasure := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  rw [← finiteModelBIdealSample_law D n]
  exact (indepFun_iff_map_prod_eq_prod_map_map
    ((stronglyMeasurable_finiteModelBOutcomeTrajectory_natural D p r0 project
      initial hproject n).measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl).aemeasurable
    (measurable_finiteModelBIdealSample n).aemeasurable).mp
      (finiteModelBOutcomeTrajectory_indep_idealSample D p r0 project initial hproject n)

/--
Fresh-sampling factorization for any integrable state/ideal statistic at a
fixed step.  It turns expectations along the actual run into an iterated
integral over the current-state law and the C3 ideal law.
-/
theorem finiteModelBOutcomeTrajectory_integral_pair_eq
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) (n : ℕ)
    (test : (Coord → ℝ) → (Coord → ℝ) → ℝ)
    (htest : Integrable (fun z : (Coord → ℝ) × (Coord → ℝ) => test z.1 z.2)
      ((Measure.map (finiteModelBOutcomeTrajectory D p r0 project initial n)
        (finiteModelBIdealSequenceMeasure D)).prod D.idealMeasure)) :
    (∫ omega, test (finiteModelBOutcomeTrajectory D p r0 project initial n omega)
      (finiteModelBIdealSample n omega) ∂finiteModelBIdealSequenceMeasure D) =
      ∫ state, ∫ ideal, test state ideal ∂D.idealMeasure ∂
        Measure.map (finiteModelBOutcomeTrajectory D p r0 project initial n)
          (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  let pair : (ℕ → Coord → ℝ) → (Coord → ℝ) × (Coord → ℝ) := fun omega =>
    (finiteModelBOutcomeTrajectory D p r0 project initial n omega,
      finiteModelBIdealSample n omega)
  have hpair_meas : Measurable pair := by
    exact
      (((stronglyMeasurable_finiteModelBOutcomeTrajectory_natural D p r0 project
        initial hproject n).measurable.mono
        ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl).prodMk
          (measurable_finiteModelBIdealSample n))
  have hpair_law : Measure.map pair (finiteModelBIdealSequenceMeasure D) =
      (Measure.map (finiteModelBOutcomeTrajectory D p r0 project initial n)
        (finiteModelBIdealSequenceMeasure D)).prod D.idealMeasure := by
    exact finiteModelBOutcomeTrajectory_idealSample_pair_law
      D p r0 project initial hproject n
  have htest_map : AEStronglyMeasurable
      (fun z : (Coord → ℝ) × (Coord → ℝ) => test z.1 z.2)
      (Measure.map pair (finiteModelBIdealSequenceMeasure D)) := by
    rw [hpair_law]
    exact htest.aestronglyMeasurable
  calc
    (∫ omega, test (finiteModelBOutcomeTrajectory D p r0 project initial n omega)
      (finiteModelBIdealSample n omega) ∂finiteModelBIdealSequenceMeasure D) =
        ∫ z : (Coord → ℝ) × (Coord → ℝ), test z.1 z.2 ∂
          Measure.map pair (finiteModelBIdealSequenceMeasure D) := by
            exact (integral_map hpair_meas.aemeasurable htest_map).symm
    _ = ∫ z : (Coord → ℝ) × (Coord → ℝ), test z.1 z.2 ∂
        ((Measure.map (finiteModelBOutcomeTrajectory D p r0 project initial n)
          (finiteModelBIdealSequenceMeasure D)).prod D.idealMeasure) := by rw [hpair_law]
    _ = ∫ state, ∫ ideal, test state ideal ∂D.idealMeasure ∂
        Measure.map (finiteModelBOutcomeTrajectory D p r0 project initial n)
          (finiteModelBIdealSequenceMeasure D) := by
            exact integral_prod _ htest

