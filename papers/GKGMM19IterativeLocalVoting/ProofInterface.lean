  rw [ae_all_iff]
  intro n
  exact finiteModelBOutcomeRawResponse_is_modelBResponse_ae
    D hdual project initial hproject n

/-- The source Model B `L∞` response equation holds at every time on one full-measure event. -/
theorem finiteModelBOutcomeRawResponse_is_modelBResponse_one_ae_all
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
