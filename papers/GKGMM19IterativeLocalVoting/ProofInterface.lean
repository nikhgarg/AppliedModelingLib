/--
Along the exact iid `(∞,1)` Model A execution, the Borel crossing-or-near-tie
envelope for a possible non-subgradient response has conditional `O(r_t)`
probability.  Outside the envelope the water-filled raw direction is a valid
sampled `L∞` subgradient.
-/
theorem finiteModelALinfL1Outcome_correctedEnvelope_condExp_le
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (n : ℕ) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega =>
        (l1LinfSlabBadEvent
          (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega)
          (ilvRadius r0 (n + 1)) ∪
          linfL1NearTieBadEvent
            (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega)
            (ilvRadius r0 (n + 1))).indicator (fun _ => (1 : ℝ))
          (finiteModelBIdealSample n omega) |
      finiteModelBIdealNaturalFiltration (Coord := Coord) n] ≤ᵐ[
        finiteModelBIdealSequenceMeasure D]
      fun _ => ilvRadius r0 (n + 1) *
        (finiteModelBC1C2CoordinateSlabRealConstant S +
          finiteModelBC1C2LinearTieSlabRealConstant S) := by
  classical
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  let radius : ℝ := ilvRadius r0 (n + 1)
  let envelope : (Coord → ℝ) → Set (Coord → ℝ) := fun state =>
    l1LinfSlabBadEvent state radius ∪ linfL1NearTieBadEvent state radius
  let test : (Coord → ℝ) → (Coord → ℝ) → ℝ := fun state ideal =>
    (envelope state).indicator (fun _ => (1 : ℝ)) ideal
  let pair : (ℕ → Coord → ℝ) →
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) := fun omega =>
    (finiteModelBIdealPastPrefix n omega, finiteModelBIdealSample n omega)
  have hpair_measurable : Measurable pair :=
    (measurable_finiteModelBIdealPastPrefix n).prodMk
      (measurable_finiteModelBIdealSample n)
  letI : IsProbabilityMeasure
      (Measure.map pair (finiteModelBIdealSequenceMeasure D)) :=
    Measure.isProbabilityMeasure_map hpair_measurable.aemeasurable
  have hstate_ideal : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      (finiteModelALinfL1OutcomePrefixTrajectory D r0 project initial n z.1, z.2)) :=
    ((measurable_finiteModelALinfL1OutcomePrefixTrajectory D r0 project initial
      S.project_measurable n).comp measurable_fst).prodMk measurable_snd
  have htest : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      test (finiteModelALinfL1OutcomePrefixTrajectory D r0 project initial n z.1) z.2)
      (Measure.map pair (finiteModelBIdealSequenceMeasure D)) := by
    let event : Set ((Coord → ℝ) × (Coord → ℝ)) :=
      {z | z.2 ∈ l1LinfSlabBadEvent z.1 radius ∪ linfL1NearTieBadEvent z.1 radius}
    have hevent : MeasurableSet event :=
      (measurableSet_l1LinfSlabBadEvent_state_ideal radius).union
        (measurableSet_linfL1NearTieBadEvent_state_ideal radius)
    simpa only [test, envelope, event] using
      ((integrable_const (1 : ℝ)).indicator (hevent.preimage hstate_ideal))
  have hconditional := finiteModelALinfL1OutcomeTrajectory_condExp_ae_eq_integral
    D r0 project initial n test (by simpa only [pair] using htest)
  have hintegral : ∀ state : Coord → ℝ,
      (∫ ideal, test state ideal ∂D.idealMeasure) ≤
        radius * (finiteModelBC1C2CoordinateSlabRealConstant S +
          finiteModelBC1C2LinearTieSlabRealConstant S) := by
    intro state
    calc
      (∫ ideal, test state ideal ∂D.idealMeasure) =
          (D.idealMeasure (envelope state)).toReal := by
        simpa only [test, Measure.real] using
          (MeasureTheory.integral_indicator_one (μ := D.idealMeasure)
            ((measurableSet_l1LinfSlabBadEvent state radius).union
              (measurableSet_linfL1NearTieBadEvent state radius)))
      _ ≤ radius * (finiteModelBC1C2CoordinateSlabRealConstant S +
          finiteModelBC1C2LinearTieSlabRealConstant S) :=
        finiteModelBC1C2_linfL1SymmetricPerturbationEnvelope_measureReal_le
          S state (ilvRadius_nonneg (le_of_lt hr0) (n + 1))
  filter_upwards [hconditional] with omega hconditional
  change (finiteModelBIdealSequenceMeasure D)[
      fun omega => test (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) |
      finiteModelBIdealNaturalFiltration (Coord := Coord) n] omega ≤ _
  rw [hconditional]
  simpa only [radius] using
    hintegral (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega)

/-- The conditional one-step descent contribution of the water-filled perturbation is summable. -/
theorem finiteModelALinfL1OutcomeSubgradientPerturbation_condExp_descentError_le
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (n : ℕ) {distanceBound : ℝ} (hdistanceBound : 0 ≤ distanceBound) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega =>
        2 * ilvRadius r0 (n + 1) * distanceBound *
          AppliedModelingLib.FiniteDimensionalNorms.l2
            (finiteModelALinfL1OutcomeSubgradientPerturbation D r0 project initial n omega) +
        3 * ilvRadius r0 (n + 1) ^ 2 *
          AppliedModelingLib.FiniteDimensionalNorms.l2Sq
            (finiteModelALinfL1OutcomeSubgradientPerturbation D r0 project initial n omega) |
      finiteModelBIdealNaturalFiltration (Coord := Coord) n] ≤ᵐ[
        finiteModelBIdealSequenceMeasure D]
      fun _ =>
        (2 * ilvRadius r0 (n + 1) * distanceBound) *
          ((2 * Real.sqrt (Fintype.card Coord)) *
            (ilvRadius r0 (n + 1) *
              (finiteModelBC1C2CoordinateSlabRealConstant S +
                finiteModelBC1C2LinearTieSlabRealConstant S))) +
        (3 * ilvRadius r0 (n + 1) ^ 2) *
          ((4 * Fintype.card Coord) *
            (ilvRadius r0 (n + 1) *
              (finiteModelBC1C2CoordinateSlabRealConstant S +
                finiteModelBC1C2LinearTieSlabRealConstant S))) := by
  apply AppliedModelingLib.Optimization.condExp_linear_combination_le_of_bounds
  · exact integrable_finiteModelALinfL1OutcomeSubgradientPerturbation_l2
      D hr0 project initial S.project_measurable n
  · exact integrable_finiteModelALinfL1OutcomeSubgradientPerturbation_l2Sq
      D hr0 project initial S.project_measurable n
  · exact mul_nonneg
      (mul_nonneg (by norm_num) (ilvRadius_nonneg (le_of_lt hr0) (n + 1)))
      hdistanceBound
  · exact mul_nonneg (by norm_num) (sq_nonneg _)
  · exact finiteModelALinfL1OutcomeSubgradientPerturbation_condExp_l2_le
      S hr0 initial n
  · exact finiteModelALinfL1OutcomeSubgradientPerturbation_condExp_l2Sq_le
      S hr0 initial n

/-- The water-filled recursion is a projected population update plus centered noise and perturbation. -/
theorem finiteModelALinfL1OutcomeTrajectory_projected_populationNoisePerturbation_update
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelALinfL1OutcomeTrajectory D r0 project initial (n + 1) omega =
      project (fun i => finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega i -
        ilvRadius r0 (n + 1) *
          (finiteModelBPopulationLinfGradient D
            (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega) i +
            finiteModelALinfL1OutcomeGradientNoise D r0 project initial n omega i +
            finiteModelALinfL1OutcomeSubgradientPerturbation
              D r0 project initial n omega i)) := by
  rw [finiteModelALinfL1OutcomeTrajectory_projected_rawDirection_update D hr0]
  apply congrArg project
  funext i
  rw [linfL1RawDirection_eq_symmetricDirection_add_perturbation]
  simp only [finiteModelALinfL1OutcomeGradientNoise,
    finiteModelALinfL1OutcomeSubgradientPerturbation]
  ring

/-- A C3-normalized sampled `Lp` direction has every coordinate bounded by one. -/
theorem lpCostGradientCandidate_coord_abs_le_one_ae
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q : ℝ} (hdual : HolderDualFinite p q)
    (state : Coord → ℝ) (i : Coord) :
    ∀ᵐ ideal ∂D.idealMeasure,
      |lpCostGradientCandidate p (fun j => state j - ideal j) i| ≤ 1 := by
  filter_upwards [
    FiniteCoordinateIdealDistributionData.lpCostGradientCandidate_lq_norm_eq_one_ae
      D hdual state] with ideal hnorm
  have hcoord := AppliedModelingLib.FiniteDimensionalNorms.abs_le_lp hdual.2.1
    (lpCostGradientCandidate p (fun j => state j - ideal j)) i
  rw [← finiteCoordinateNorm_lp] at hcoord
  linarith

/-- Every coordinate of a C3-normalized sampled `Lp` direction is integrable. -/
theorem integrable_lpCostGradientCandidate_coordinate
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q : ℝ} (hdual : HolderDualFinite p q)
    (state : Coord → ℝ) (i : Coord) :
    Integrable (fun ideal => lpCostGradientCandidate p
      (fun j => state j - ideal j) i) D.idealMeasure := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  have hdiff : Measurable (fun ideal : Coord → ℝ => fun j => state j - ideal j) := by
    apply measurable_pi_lambda _
    intro j
    exact measurable_const.sub (measurable_pi_apply j)
  have hmeas : Measurable (fun ideal : Coord → ℝ => lpCostGradientCandidate p
      (fun j => state j - ideal j) i) :=
    (measurable_pi_apply i).comp ((measurable_lpCostGradientCandidate p).comp hdiff)
  refine Integrable.mono' (integrable_const 1) hmeas.aestronglyMeasurable ?_
  filter_upwards [lpCostGradientCandidate_coord_abs_le_one_ae D hdual state i]
    with ideal hbound
  simpa only [Real.norm_eq_abs] using hbound

/-- Every coordinate of the `p = 1` sampled direction is integrable under C3. -/
theorem integrable_lpCostGradientCandidate_one_coordinate
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (state : Coord → ℝ) (i : Coord) :
    Integrable (fun ideal => lpCostGradientCandidate 1
      (fun j => state j - ideal j) i) D.idealMeasure := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  have hdiff : Measurable (fun ideal : Coord → ℝ => fun j => state j - ideal j) := by
    apply measurable_pi_lambda _
    intro j
    exact measurable_const.sub (measurable_pi_apply j)
  have hmeas : Measurable (fun ideal : Coord → ℝ => lpCostGradientCandidate 1
      (fun j => state j - ideal j) i) :=
    (measurable_pi_apply i).comp ((measurable_lpCostGradientCandidate 1).comp hdiff)
  refine Integrable.mono' (integrable_const 1) hmeas.aestronglyMeasurable ?_
  filter_upwards [] with ideal
  simpa only [Real.norm_eq_abs] using
    lpCostGradientCandidate_one_coord_abs_le_one
      (fun j => state j - ideal j) i

/-- The `p = 1` population direction is a subgradient of the expected finite `L1` cost. -/
theorem finiteModelBPopulationLpGradient_one_subgradientOn_expectedLpCost
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (solutionSpace : Set (Coord → ℝ)) (state : Coord → ℝ)
    (hcost_integrable : ∀ y : Coord → ℝ,
      Integrable (fun ideal => AppliedModelingLib.FiniteDimensionalNorms.lp 1
        (fun j => y j - ideal j)) D.idealMeasure) :
    AppliedModelingLib.Optimization.FiniteSubgradientOn
      (finiteModelBExpectedLpCost D 1) solutionSpace state
      (finiteModelBPopulationLpGradient D 1 state) := by
  have hfull := AppliedModelingLib.Optimization.finiteSubgradientAt_integral
    (FiniteCoordinateIdealDistributionData.finiteSubgradientAt_lpCostGradientCandidate_one_ae
      D state)
    hcost_integrable
    (integrable_lpCostGradientCandidate_one_coordinate D state)
  intro y _hy
  simpa only [finiteModelBExpectedLpCost, finiteModelBPopulationLpGradient] using hfull y

/--
The finite-history/fresh-sample statistic used in the canonical conditional
expectation bridge is integrable.  This removes the earlier manual
integrability premise using the C3-normalization bound.
-/
theorem integrable_finiteModelBOutcomePrefixTrajectory_lpCostGradientCandidate
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q r0 : ℝ} (hdual : HolderDualFinite p q)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    Integrable (fun z : (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      lpCostGradientCandidate p
        (fun j => finiteModelBOutcomePrefixTrajectory D p r0 project initial n z.1 j - z.2 j) i)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D)) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let pair : (ℕ → Coord → ℝ) →
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) := fun omega =>
    (finiteModelBIdealPastPrefix n omega, finiteModelBIdealSample n omega)
  have hpair : Measurable pair :=
    (measurable_finiteModelBIdealPastPrefix n).prodMk
      (measurable_finiteModelBIdealSample n)
  letI : IsProbabilityMeasure (Measure.map pair (finiteModelBIdealSequenceMeasure D)) :=
    Measure.isProbabilityMeasure_map hpair.aemeasurable
  have hprefix := measurable_finiteModelBOutcomePrefixTrajectory
    D p r0 project initial hproject n
  have hdiff : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
        fun j => finiteModelBOutcomePrefixTrajectory D p r0 project initial n z.1 j - z.2 j) := by
    apply measurable_pi_lambda _
    intro j
    exact ((measurable_pi_apply j).comp (hprefix.comp measurable_fst)).sub
      ((measurable_pi_apply j).comp measurable_snd)
  have htest : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      lpCostGradientCandidate p
        (fun j => finiteModelBOutcomePrefixTrajectory D p r0 project initial n z.1 j - z.2 j) i) :=
    (measurable_pi_apply i).comp ((measurable_lpCostGradientCandidate p).comp hdiff)
  change Integrable _ (Measure.map pair (finiteModelBIdealSequenceMeasure D))
  refine Integrable.mono' (integrable_const 1) htest.aestronglyMeasurable ?_
  rw [finiteModelBIdealPastPrefix_idealSample_pair_law D n]
  have hmeasSet : MeasurableSet {z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) |
      ‖lpCostGradientCandidate p
        (fun j => finiteModelBOutcomePrefixTrajectory D p r0 project initial n z.1 j - z.2 j) i‖ ≤ 1} := by
    simpa only [Function.comp_apply, Set.preimage_setOf_eq, Set.mem_Iic] using
      (continuous_norm.measurable.comp htest) measurableSet_Iic
  rw [Measure.ae_prod_iff_ae_ae hmeasSet]
  exact Filter.Eventually.of_forall fun past => by
    filter_upwards [lpCostGradientCandidate_coord_abs_le_one_ae D hdual
      (finiteModelBOutcomePrefixTrajectory D p r0 project initial n past) i]
      with ideal hbound
    simpa only [Real.norm_eq_abs] using hbound

/-- The finite-history/fresh-sample `p = 1` direction statistic is integrable. -/
theorem integrable_finiteModelBOutcomePrefixTrajectory_lpCostGradientCandidate_one
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) (n : ℕ) (i : Coord) :
    Integrable (fun z : (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      lpCostGradientCandidate 1
        (fun j => finiteModelBOutcomePrefixTrajectory D 1 r0 project initial n z.1 j - z.2 j) i)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D)) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  let pair : (ℕ → Coord → ℝ) →
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) := fun omega =>
    (finiteModelBIdealPastPrefix n omega, finiteModelBIdealSample n omega)
  have hpair : Measurable pair :=
    (measurable_finiteModelBIdealPastPrefix n).prodMk
      (measurable_finiteModelBIdealSample n)
  letI : IsProbabilityMeasure (Measure.map pair (finiteModelBIdealSequenceMeasure D)) :=
    Measure.isProbabilityMeasure_map hpair.aemeasurable
  have hprefix := measurable_finiteModelBOutcomePrefixTrajectory
    D 1 r0 project initial hproject n
  have hdiff : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
        fun j => finiteModelBOutcomePrefixTrajectory D 1 r0 project initial n z.1 j - z.2 j) := by
    apply measurable_pi_lambda _
    intro j
    exact ((measurable_pi_apply j).comp (hprefix.comp measurable_fst)).sub
      ((measurable_pi_apply j).comp measurable_snd)
  have htest : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
        lpCostGradientCandidate 1
          (fun j => finiteModelBOutcomePrefixTrajectory D 1 r0 project initial n z.1 j - z.2 j) i) :=
    (measurable_pi_apply i).comp ((measurable_lpCostGradientCandidate 1).comp hdiff)
  change Integrable _ (Measure.map pair (finiteModelBIdealSequenceMeasure D))
  refine Integrable.mono' (integrable_const 1) htest.aestronglyMeasurable ?_
  filter_upwards [] with z
  simpa only [Real.norm_eq_abs] using
    lpCostGradientCandidate_one_coord_abs_le_one
      (fun j => finiteModelBOutcomePrefixTrajectory D 1 r0 project initial n z.1 j - z.2 j) i

/-- Every coordinate of the C3 population `Lp` direction is bounded by one. -/
theorem finiteModelBPopulationLpGradient_coord_abs_le_one
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q : ℝ} (hdual : HolderDualFinite p q)
    (state : Coord → ℝ) (i : Coord) :
    |finiteModelBPopulationLpGradient D p state i| ≤ 1 := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  rw [finiteModelBPopulationLpGradient]
  have hbound : ∀ᵐ ideal ∂D.idealMeasure,
      ‖lpCostGradientCandidate p (fun j => state j - ideal j) i‖ ≤ 1 := by
    filter_upwards [lpCostGradientCandidate_coord_abs_le_one_ae D hdual state i]
      with ideal hbound
    simpa only [Real.norm_eq_abs] using hbound
  have hintegral := norm_integral_le_of_norm_le_const hbound
  simpa using hintegral

/-- Every coordinate of the C3 population direction is bounded by one at `p = 1`. -/
theorem finiteModelBPopulationLpGradient_one_coord_abs_le_one
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (state : Coord → ℝ) (i : Coord) :
    |finiteModelBPopulationLpGradient D 1 state i| ≤ 1 := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  rw [finiteModelBPopulationLpGradient]
  have hbound : ∀ᵐ ideal ∂D.idealMeasure,
      ‖lpCostGradientCandidate 1 (fun j => state j - ideal j) i‖ ≤ 1 := by
    filter_upwards [] with ideal
    simpa only [Real.norm_eq_abs] using
      lpCostGradientCandidate_one_coord_abs_le_one
        (fun j => state j - ideal j) i
  have hintegral := norm_integral_le_of_norm_le_const hbound
  simpa using hintegral

/-- Along the adaptive canonical run, every sampled `Lp` direction coordinate is bounded by one. -/
theorem finiteModelBOutcomeTrajectory_sampledLpDirection_coord_abs_le_one_ae
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q r0 : ℝ} (hdual : HolderDualFinite p q)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D,
      |lpCostGradientCandidate p
        (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
          finiteModelBIdealSample n omega j) i| ≤ 1 := by
  filter_upwards [finiteModelBOutcomeTrajectory_ae_coordinate_noncollision
    D p r0 project initial hproject n] with omega hcoord
  have hnorm := lemma3_finite_holder_dual_gradient_candidate_norm_formula_impl
    hdual hcoord
  have hcoord_bound := AppliedModelingLib.FiniteDimensionalNorms.abs_le_lp hdual.2.1
    (lpCostGradientCandidate p
      (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
        finiteModelBIdealSample n omega j)) i
  rw [← finiteCoordinateNorm_lp] at hcoord_bound
  linarith

/-- Along the canonical run, every sampled `p = 1` direction coordinate is bounded by one. -/
theorem finiteModelBOutcomeTrajectory_sampledLpDirection_one_coord_abs_le_one_ae
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (i : Coord) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D,
      |lpCostGradientCandidate 1
        (fun j => finiteModelBOutcomeTrajectory D 1 r0 project initial n omega j -
          finiteModelBIdealSample n omega j) i| ≤ 1 := by
  filter_upwards [] with omega
  exact lpCostGradientCandidate_one_coord_abs_le_one
    (fun j => finiteModelBOutcomeTrajectory D 1 r0 project initial n omega j -
      finiteModelBIdealSample n omega j) i

/-- The adaptive canonical sampled direction has uniformly bounded squared Euclidean norm. -/
theorem finiteModelBOutcomeTrajectory_sampledLpDirection_l2Sq_le_card_ae
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q r0 : ℝ} (hdual : HolderDualFinite p q)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D,
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (lpCostGradientCandidate p
          (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
            finiteModelBIdealSample n omega j)) ≤ Fintype.card Coord := by
  filter_upwards [(Filter.eventually_all_finset (Finset.univ : Finset Coord)).mpr
    (fun i _ => finiteModelBOutcomeTrajectory_sampledLpDirection_coord_abs_le_one_ae
      D hdual project initial hproject n i)] with omega hbound
  have hnorm := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_card_mul_sq_of_abs_le
    (lpCostGradientCandidate p
      (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
        finiteModelBIdealSample n omega j)) (by norm_num : (0 : ℝ) ≤ 1)
    (fun i => hbound i (Finset.mem_univ i))
  norm_num at hnorm ⊢
  exact hnorm

/-- The C3 population `Lp` direction has uniformly bounded squared Euclidean norm. -/
theorem finiteModelBPopulationLpGradient_l2Sq_le_card
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q : ℝ} (hdual : HolderDualFinite p q)
    (state : Coord → ℝ) :
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq (finiteModelBPopulationLpGradient D p state) ≤
      Fintype.card Coord := by
  have hnorm := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_card_mul_sq_of_abs_le
    (finiteModelBPopulationLpGradient D p state) (by norm_num : (0 : ℝ) ≤ 1)
    (finiteModelBPopulationLpGradient_coord_abs_le_one D hdual state)
  norm_num at hnorm ⊢
  exact hnorm

/-- The C3 population direction has a paper-uniform Euclidean bound. -/
theorem finiteModelBPopulationLpGradient_l2_le_card
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p q : ℝ} (hdual : HolderDualFinite p q)
    (state : Coord → ℝ) :
    AppliedModelingLib.FiniteDimensionalNorms.l2 (finiteModelBPopulationLpGradient D p state) ≤
      Fintype.card Coord := by
  have hsq := finiteModelBPopulationLpGradient_l2Sq_le_card D hdual state
  have hcard_nat : 1 ≤ Fintype.card Coord := by
    have hpos : 0 < Fintype.card Coord :=
      Fintype.card_pos_iff.mpr inferInstance
    omega
  have hcard : (1 : ℝ) ≤ Fintype.card Coord := by
    exact_mod_cast hcard_nat
  rw [← AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq] at hsq
  nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg
    (finiteModelBPopulationLpGradient D p state)]

/-- The C3 population `p = 1` direction has the same finite Euclidean bound. -/
theorem finiteModelBPopulationLpGradient_one_l2_le_card
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (state : Coord → ℝ) :
    AppliedModelingLib.FiniteDimensionalNorms.l2 (finiteModelBPopulationLpGradient D 1 state) ≤
      Fintype.card Coord := by
  have hsq : AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (finiteModelBPopulationLpGradient D 1 state) ≤ Fintype.card Coord := by
    have hnorm := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_card_mul_sq_of_abs_le
      (finiteModelBPopulationLpGradient D 1 state) (by norm_num : (0 : ℝ) ≤ 1)
      (finiteModelBPopulationLpGradient_one_coord_abs_le_one D state)
    norm_num at hnorm ⊢
    exact hnorm
  have hcard_nat : 1 ≤ Fintype.card Coord := by
    have hpos : 0 < Fintype.card Coord := Fintype.card_pos_iff.mpr inferInstance
    omega
  have hcard : (1 : ℝ) ≤ Fintype.card Coord := by
    exact_mod_cast hcard_nat
  rw [← AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq] at hsq
  nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg
    (finiteModelBPopulationLpGradient D 1 state)]

/--
Under the concrete C1/C2 source reading, the population Model B direction is
a bounded subgradient of the expected finite-`Lp` cost at every feasible
state.  This is the deterministic optimization input needed by the canonical
sampled execution.
-/
theorem finiteModelBPopulationLpGradient_exists_bounded_subgradientOn_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {p q : ℝ} (hdual : HolderDualFinite p q) :
    ∀ state, state ∈ E.solutionSpace → ∃ g,
      AppliedModelingLib.Optimization.FiniteSubgradientOn
        (finiteModelBExpectedLpCost D p) E.solutionSpace state g ∧
        AppliedModelingLib.FiniteDimensionalNorms.l2 g ≤ Fintype.card Coord := by
  intro state hstate
  refine ⟨finiteModelBPopulationLpGradient D p state, ?_, ?_⟩
  · exact finiteModelBPopulationLpGradient_subgradientOn_expectedLpCost
      D hdual.one_lt_left E.solutionSpace state
      (fun y => integrable_finiteModelBLpCost_of_C1C2 S hdual.1 y)
      (fun i => integrable_lpCostGradientCandidate_coordinate D hdual state i)
  · exact finiteModelBPopulationLpGradient_l2_le_card D hdual state

/-- C1/C2/C3 yield a bounded expected-cost subgradient at the `p = 1` endpoint. -/
theorem finiteModelBPopulationLpGradient_one_exists_bounded_subgradientOn_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    ∀ state, state ∈ E.solutionSpace → ∃ g,
      AppliedModelingLib.Optimization.FiniteSubgradientOn
        (finiteModelBExpectedLpCost D 1) E.solutionSpace state g ∧
        AppliedModelingLib.FiniteDimensionalNorms.l2 g ≤ Fintype.card Coord := by
  intro state hstate
  refine ⟨finiteModelBPopulationLpGradient D 1 state, ?_, ?_⟩
  · exact finiteModelBPopulationLpGradient_one_subgradientOn_expectedLpCost
      D E.solutionSpace state
      (fun y => integrable_finiteModelBLpCost_of_C1C2 S (by norm_num) y)
  · exact finiteModelBPopulationLpGradient_one_l2_le_card D state

/--
The expected finite-`Lp` objective is continuous on the C1 feasible set.  The
proof uses the concrete expected subgradients and their C3-normalized uniform
bound, not an additional continuity premise.
-/
theorem finiteModelBExpectedLpCost_continuousOn_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {p q : ℝ} (hdual : HolderDualFinite p q) :
    ContinuousOn (finiteModelBExpectedLpCost D p) E.solutionSpace := by
  apply AppliedModelingLib.Optimization.continuousOn_of_exists_bounded_subgradientOn
    (C := Fintype.card Coord)
  · positivity
  · exact finiteModelBPopulationLpGradient_exists_bounded_subgradientOn_of_C1C2
      S hdual

/-- The expected finite `L1` objective is continuous on the C1 feasible set. -/
theorem finiteModelBExpectedLpCost_one_continuousOn_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    ContinuousOn (finiteModelBExpectedLpCost D 1) E.solutionSpace := by
  apply AppliedModelingLib.Optimization.continuousOn_of_exists_bounded_subgradientOn
    (C := Fintype.card Coord)
  · positivity
  · exact finiteModelBPopulationLpGradient_one_exists_bounded_subgradientOn_of_C1C2 S

/-- The exact minimizer set of the canonical expected finite-`Lp` objective. -/
def finiteModelBExpectedLpMinimizerSet
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) (p : ℝ)
    (solutionSpace : Set (Coord → ℝ)) : Set (Coord → ℝ) :=
  {x | x ∈ solutionSpace ∧ IsMinOn (finiteModelBExpectedLpCost D p) solutionSpace x}

/-- The exact minimizer set of the expected finite-coordinate `L∞` objective. -/
def finiteModelBExpectedLinfMinimizerSet
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (solutionSpace : Set (Coord → ℝ)) : Set (Coord → ℝ) :=
  {x | x ∈ solutionSpace ∧ IsMinOn (finiteModelBExpectedLinfCost D) solutionSpace x}

/-- C1 compactness gives an expected finite `L∞` cost minimizer. -/
theorem finiteModelBExpectedLinfMinimizerSet_nonempty_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    (finiteModelBExpectedLinfMinimizerSet D E.solutionSpace).Nonempty := by
  rcases S.compact_solutionSpace.exists_isMinOn S.solutionSpace_nonempty
    (continuous_finiteModelBExpectedLinfCost_of_C1C2 S).continuousOn with
      ⟨reference, href, hmin⟩
  exact ⟨reference, href, hmin⟩

/-- A canonical expected finite-`L∞` minimizer selected from the compact C1 target set. -/
noncomputable def finiteModelBExpectedLinfReference
