          (E.trajectory SourceNorm.l2 VoterResponseModel.modelA (t + N))
          (ilvTailRadius r0 N t))
    (hFirstOrder :
      ∀ t voter,
        FiniteModelAFirstOrderExpansionAt E M.utilityGradient voter
          (E.trajectory SourceNorm.l2 VoterResponseModel.modelA (t + N)))
    (hgradient :
