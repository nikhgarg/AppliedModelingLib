local instance classicalDecidableEq (α : Type*) : DecidableEq α := Classical.decEq α

/--
Conditional expectation preserves an almost-everywhere inclusion of measurable
events.  This is the probability bridge used when a paper names an actual
failure event but its proof controls it through a measurable envelope.
-/
theorem condExp_indicator_le_of_ae_subset
    {Ω : Type*} [m₀ : MeasurableSpace Ω] (μ : Measure Ω) (m : MeasurableSpace Ω)
    [IsFiniteMeasure μ] {A B : Set Ω} (hA : MeasurableSet[m₀] A)
    (hB : MeasurableSet[m₀] B)
    (hAB : ∀ᵐ omega ∂μ, omega ∈ A → omega ∈ B) :
    μ[A.indicator (fun _ => (1 : ℝ)) | m] ≤ᵐ[μ]
      μ[B.indicator (fun _ => (1 : ℝ)) | m] := by
  apply condExp_mono
  · exact (integrable_const (μ := μ) (1 : ℝ)).indicator hA
  · exact (integrable_const (μ := μ) (1 : ℝ)).indicator hB
  · filter_upwards [hAB] with omega hABomega
    by_cases hmem : omega ∈ A
    · simp [Set.indicator_of_mem hmem, Set.indicator_of_mem (hABomega hmem)]
    · simp [hmem]
      exact Set.indicator_nonneg (fun _ _ => by norm_num) omega

/--
The canonical probability space for an outcome-indexed Model B run: every
coordinate is one independently drawn ideal point from the C3 distribution.
The shifted sample timing reserves coordinate zero for the initial state, so
the step-`n` sample is fresh relative to the natural filtration through time
`n`.
-/
noncomputable def finiteModelBIdealSequenceMeasure
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) :
    Measure (ℕ → Coord → ℝ) :=
  AppliedModelingLib.iidSequenceMeasure D.idealMeasure

/-- The canonical Model B ideal-sequence law is a probability measure. -/
theorem finiteModelBIdealSequenceMeasure_isProbabilityMeasure
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) :
    IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  exact AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.idealMeasure

/-- The ideal point used at Algorithm 1 step `n`. -/
def finiteModelBIdealSample
    {Coord : Type*} [Fintype Coord]
    (n : ℕ) (omega : ℕ → Coord → ℝ) : Coord → ℝ :=
  AppliedModelingLib.iidSequenceSample n omega

/-- Each realized Model B step has exactly the C3 ideal-point marginal law. -/
theorem finiteModelBIdealSample_law
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) (n : ℕ) :
    Measure.map (finiteModelBIdealSample n)
      (finiteModelBIdealSequenceMeasure D) = D.idealMeasure := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  exact AppliedModelingLib.iidSequenceSample_law D.idealMeasure n

/-- The raw coordinates of the canonical ideal sequence are mutually independent. -/
theorem finiteModelBIdealSequence_iIndepFun
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) :
    ProbabilityTheory.iIndepFun (fun n (omega : ℕ → Coord → ℝ) => omega n)
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  exact AppliedModelingLib.iidSequence_iIndepFun D.idealMeasure

/-- The shifted ideal samples used by Algorithm 1 are mutually independent. -/
theorem finiteModelBIdealSample_iIndepFun
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) :
    ProbabilityTheory.iIndepFun
      (fun n (omega : ℕ → Coord → ℝ) => finiteModelBIdealSample n omega)
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  exact AppliedModelingLib.iidSequenceSample_iIndepFun D.idealMeasure

/-- Every step sample is Borel measurable on the canonical product space. -/
theorem measurable_finiteModelBIdealSample
    {Coord : Type*} [Fintype Coord] (n : ℕ) :
    Measurable (finiteModelBIdealSample (Coord := Coord) n) := by
  exact AppliedModelingLib.measurable_iidSequenceSample n

/-- The natural filtration of the raw iid ideal sequence. -/
noncomputable def finiteModelBIdealNaturalFiltration
    {Coord : Type*} [Fintype Coord] :
    Filtration (Ω := ℕ → Coord → ℝ) ℕ inferInstance :=
  AppliedModelingLib.iidSequenceNaturalFiltration

/--
A fresh ideal sample has its population conditional expectation under the
natural past filtration.  The sample at Algorithm 1 step `n` is coordinate
`n + 1`, while the filtration contains coordinates through `n`.
-/
theorem finiteModelBIdealSample_condExp_natural_ae_eq_integral
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) (n : ℕ)
    (test : (Coord → ℝ) → ℝ) (htest : StronglyMeasurable test) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega => test (finiteModelBIdealSample n omega) |
        finiteModelBIdealNaturalFiltration (Coord := Coord) n] =ᵐ[
          finiteModelBIdealSequenceMeasure D]
      fun _ => ∫ ideal, test ideal ∂D.idealMeasure := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  let raw : ℕ → (ℕ → Coord → ℝ) → Coord → ℝ :=
    fun k omega => omega k
  let hraw : ∀ k, StronglyMeasurable (raw k) :=
    fun k => (measurable_pi_apply k).stronglyMeasurable
  have hcond :
      (finiteModelBIdealSequenceMeasure D)[
        fun omega => test (raw (n + 1) omega) |
          Filtration.natural raw hraw n] =ᵐ[
            finiteModelBIdealSequenceMeasure D]
        fun _ => ∫ omega, test (raw (n + 1) omega) ∂finiteModelBIdealSequenceMeasure D := by
    apply condExp_indep_eq
      ((measurable_pi_apply (n + 1)).comap_le)
      ((Filtration.natural raw hraw).le n)
    · exact
        ((htest.measurable.comp (comap_measurable (raw (n + 1)))).stronglyMeasurable)
    · exact
        (finiteModelBIdealSequence_iIndepFun D).indep_comap_natural_of_lt
          hraw n.lt_succ_self
  have hintegral :
      (∫ omega, test (raw (n + 1) omega) ∂finiteModelBIdealSequenceMeasure D) =
        ∫ ideal, test ideal ∂D.idealMeasure := by
    calc
      (∫ omega, test (raw (n + 1) omega) ∂finiteModelBIdealSequenceMeasure D) =
          ∫ ideal, test ideal ∂Measure.map (raw (n + 1))
            (finiteModelBIdealSequenceMeasure D) := by
              exact (integral_map
                (μ := finiteModelBIdealSequenceMeasure D)
                (φ := raw (n + 1)) (f := test)
                (measurable_pi_apply (n + 1)).aemeasurable
                htest.aestronglyMeasurable).symm
      _ = ∫ ideal, test ideal ∂D.idealMeasure := by
        rw [show Measure.map (raw (n + 1))
          (finiteModelBIdealSequenceMeasure D) = D.idealMeasure by
            simpa [raw] using finiteModelBIdealSample_law D n]
  simpa [finiteModelBIdealSample, finiteModelBIdealNaturalFiltration, raw, hraw,
    hintegral] using hcond

/-- The finite raw history available before the step-`n` ideal draw. -/
def finiteModelBIdealPastPrefix
    {Coord : Type*} [Fintype Coord]
    (n : ℕ) (omega : ℕ → Coord → ℝ) : Fin (n + 1) → Coord → ℝ :=
  AppliedModelingLib.iidSequencePastPrefix n omega

/-- The finite raw history is Borel measurable on the canonical sequence space. -/
theorem measurable_finiteModelBIdealPastPrefix
    {Coord : Type*} [Fintype Coord] (n : ℕ) :
    Measurable (finiteModelBIdealPastPrefix (Coord := Coord) n) := by
  exact AppliedModelingLib.measurable_iidSequencePastPrefix n

/--
The natural filtration through time `n` is exactly the pullback of the
finite raw prefix through coordinate `n`.  This finite presentation permits
conditional-distribution arguments for state-dependent fresh samples.
-/
theorem finiteModelBIdealNaturalFiltration_eq_comap_pastPrefix
    {Coord : Type*} [Fintype Coord] (n : ℕ) :
    finiteModelBIdealNaturalFiltration (Coord := Coord) n =
      MeasurableSpace.comap (finiteModelBIdealPastPrefix (Coord := Coord) n)
        inferInstance := by
  exact AppliedModelingLib.iidSequenceNaturalFiltration_eq_comap_pastPrefix n

/-- The finite past prefix is independent of the fresh ideal draw at step `n`. -/
theorem finiteModelBIdealPastPrefix_indep_idealSample
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) (n : ℕ) :
    IndepFun (finiteModelBIdealPastPrefix (Coord := Coord) n)
      (finiteModelBIdealSample (Coord := Coord) n)
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  exact AppliedModelingLib.iidSequencePastPrefix_indep_sample D.idealMeasure n

/-- The finite past prefix and fresh ideal draw have their product law. -/
theorem finiteModelBIdealPastPrefix_idealSample_pair_law
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) (n : ℕ) :
    Measure.map (fun omega =>
      (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
        finiteModelBIdealSample (Coord := Coord) n omega))
      (finiteModelBIdealSequenceMeasure D) =
        (Measure.map (finiteModelBIdealPastPrefix (Coord := Coord) n)
          (finiteModelBIdealSequenceMeasure D)).prod D.idealMeasure := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  exact AppliedModelingLib.iidSequencePastPrefix_sample_pair_law D.idealMeasure n

/--
Conditional expectation for an integrable statistic of the finite past and
its fresh ideal draw.  The proof identifies the conditional distribution of
the draw with its C3 law, rather than assuming a state-dependent conditional
mean as an input.
-/
theorem finiteModelBIdealPastPrefix_condExp_ae_eq_integral
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) (n : ℕ)
    (test : (Fin (n + 1) → Coord → ℝ) → (Coord → ℝ) → ℝ)
    (htest : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) => test z.1 z.2)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D))) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega => test (finiteModelBIdealPastPrefix n omega)
        (finiteModelBIdealSample n omega) |
        finiteModelBIdealNaturalFiltration (Coord := Coord) n] =ᵐ[
          finiteModelBIdealSequenceMeasure D]
      fun omega => ∫ ideal, test (finiteModelBIdealPastPrefix n omega) ideal
        ∂D.idealMeasure := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  exact AppliedModelingLib.iidSequencePastPrefix_condExp_ae_eq_integral
    D.idealMeasure n test htest

/--
An independent current C3 ideal point avoids every coordinate of any
measurable past-dependent center almost surely.  This is the Fubini bridge
needed to apply the Appendix C.4 response formula along an actual stochastic
trajectory; it does not replace the center by a deterministic path.
-/
theorem ae_coordinate_noncollision_of_indep_idealSample
    {Omega Coord : Type*} [MeasurableSpace Omega] [Fintype Coord]
    (mu : Measure Omega) [IsProbabilityMeasure mu]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (center sample : Omega → Coord → ℝ)
    (hcenter : Measurable center) (hsample : Measurable sample)
    (hindep : ProbabilityTheory.IndepFun center sample mu)
    (hsample_law : Measure.map sample mu = D.idealMeasure) :
    ∀ᵐ omega ∂mu, ∀ i, center omega i ≠ sample omega i := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  have hmeas : MeasurableSet
      {z : (Coord → ℝ) × (Coord → ℝ) | ∀ i, z.1 i ≠ z.2 i} := by
    simp only [Set.setOf_forall]
    apply MeasurableSet.iInter
    intro i
    have heq : Measurable
        (fun z : (Coord → ℝ) × (Coord → ℝ) => z.1 i = z.2 i) :=
      ((measurable_pi_apply i).comp measurable_fst).eq
        ((measurable_pi_apply i).comp measurable_snd)
    exact (measurableSet_setOf.mpr heq).compl
  have hproduct : ∀ᵐ z ∂(Measure.map center mu).prod D.idealMeasure,
      ∀ i, z.1 i ≠ z.2 i := by
    rw [Measure.ae_prod_iff_ae_ae hmeas]
    exact Filter.Eventually.of_forall
      (fun x => D.coordinate_noncollision_ae x)
  have hpair_law :
      Measure.map (fun omega => (center omega, sample omega)) mu =
        (Measure.map center mu).prod D.idealMeasure := by
    rw [← hsample_law]
    exact (ProbabilityTheory.indepFun_iff_map_prod_eq_prod_map_map
      hcenter.aemeasurable hsample.aemeasurable).mp hindep
  have hpair : ∀ᵐ z ∂Measure.map (fun omega => (center omega, sample omega)) mu,
      ∀ i, z.1 i ≠ z.2 i := by
    rw [hpair_law]
    exact hproduct
  exact MeasureTheory.ae_of_ae_map
    (hcenter.prodMk hsample).aemeasurable hpair

/-- The finite `Lp` power sum is Borel measurable in its vector argument. -/
theorem measurable_finiteCoordinate_lpPower
    {Coord : Type*} [Fintype Coord] (p : ℝ) :
    Measurable (fun x : Coord → ℝ =>
      AppliedModelingLib.FiniteDimensionalNorms.lpPower p x) := by
  unfold AppliedModelingLib.FiniteDimensionalNorms.lpPower
  exact Finset.measurable_sum Finset.univ
    (fun i _ => (measurable_pi_apply i).abs.pow_const p)

/-- The displayed finite-coordinate `Lp` candidate direction is Borel measurable. -/
theorem measurable_lpCostGradientCandidate
    {Coord : Type*} [Fintype Coord] (p : ℝ) :
    Measurable (fun d : Coord → ℝ => lpCostGradientCandidate p d) := by
  unfold lpCostGradientCandidate lpGradientCandidate
  apply measurable_pi_lambda
  intro i
  exact
    (((measurable_pi_apply i).abs.pow_const (p - 1)).mul
      ((measurable_pi_apply i).div (measurable_pi_apply i).abs)).div
        ((measurable_finiteCoordinate_lpPower p).pow_const ((p - 1) / p))

/-- A finite-coordinate block Euclidean distance is Borel measurable in its two arguments. -/
theorem measurable_finiteCoordinateBlockL2Distance
    {Coord : Type*} [Fintype Coord] (block : Finset Coord) :
    Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      finiteCoordinateBlockL2Distance block z.1 z.2) := by
  unfold finiteCoordinateBlockL2Distance AppliedModelingLib.FiniteDimensionalNorms.l2
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq
  exact (Finset.measurable_sum (Finset.univ : Finset {i : Coord // i ∈ block})
    (fun i _ => (((measurable_pi_apply (i : Coord)).comp measurable_fst).sub
      ((measurable_pi_apply (i : Coord)).comp measurable_snd)).pow_const 2)).sqrt

/-- The finite-coordinate Euclidean quantity is Borel measurable. -/
theorem measurable_finiteDimensional_l2
    {Coord : Type*} [Fintype Coord] :
    Measurable (fun x : Coord → ℝ => AppliedModelingLib.FiniteDimensionalNorms.l2 x) := by
  unfold AppliedModelingLib.FiniteDimensionalNorms.l2 AppliedModelingLib.FiniteDimensionalNorms.l2Sq
  exact (Finset.measurable_sum Finset.univ
    (fun i _ => (measurable_pi_apply i).pow_const 2)).sqrt

/-- The zero-extended normalized Euclidean direction on a finite block is Borel measurable. -/
theorem measurable_l2BlockDistanceNormalizedGradient
    {Coord : Type*} [Fintype Coord] (block : Finset Coord) :
    Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      l2BlockDistanceNormalizedGradient block z.1 z.2) := by
  classical
  apply measurable_pi_lambda
  intro i
  by_cases hi : i ∈ block
  · simpa [l2BlockDistanceNormalizedGradient, hi] using
      (((measurable_pi_apply i).comp measurable_fst).sub
        ((measurable_pi_apply i).comp measurable_snd)).div
          (measurable_finiteCoordinateBlockL2Distance block)
  · simp [l2BlockDistanceNormalizedGradient, hi]

/-- The Definition 2 weighted direction produced by one joint sample. -/
noncomputable def weightedEuclideanL2BlockSampleDirection
    {Coord Component Sample : Type*} [Fintype Coord]
    (components : Finset Component) (componentBlock : Component → Finset Coord)
    (sampleWeight : Sample → Component → ℝ) (sampleWeightNorm2 : Sample → ℝ)
    (sampleIdeal : Sample → Component → Coord → ℝ)
    (state : Coord → ℝ) (sample : Sample) : Coord → ℝ :=
  fun i => components.sum (fun k =>
    (sampleWeight sample k / sampleWeightNorm2 sample) *
      l2BlockDistanceNormalizedGradient (componentBlock k) state
        (sampleIdeal sample k) i)

/-- The weighted block direction is Borel whenever the joint sample coordinates are Borel. -/
theorem measurable_weightedEuclideanL2BlockSampleDirection
    {Coord Component Sample : Type*} [Fintype Coord] [MeasurableSpace Sample]
    (components : Finset Component) (componentBlock : Component → Finset Coord)
    (sampleWeight : Sample → Component → ℝ) (sampleWeightNorm2 : Sample → ℝ)
    (sampleIdeal : Sample → Component → Coord → ℝ)
    (hweight : ∀ k, Measurable (fun sample => sampleWeight sample k))
    (hweightNorm2 : Measurable sampleWeightNorm2)
    (hideal : ∀ k, Measurable (fun sample => sampleIdeal sample k)) :
    Measurable (fun z : (Coord → ℝ) × Sample =>
      weightedEuclideanL2BlockSampleDirection components componentBlock
        sampleWeight sampleWeightNorm2 sampleIdeal z.1 z.2) := by
  apply measurable_pi_lambda
  intro i
  apply Finset.measurable_sum components
  intro k _hk
  have hblock : Measurable (fun z : (Coord → ℝ) × Sample =>
      l2BlockDistanceNormalizedGradient (componentBlock k) z.1
        (sampleIdeal z.2 k)) :=
    (measurable_l2BlockDistanceNormalizedGradient (componentBlock k)).comp
      (measurable_fst.prodMk ((hideal k).comp measurable_snd))
  exact (((hweight k).comp measurable_snd).div
    (hweightNorm2.comp measurable_snd)).mul
      ((measurable_pi_apply i).comp hblock)

/-- One projected weighted-Euclidean update from a current state and a joint sample. -/
noncomputable def weightedEuclideanL2BlockOutcomeStep
    {Coord Component Sample : Type*} [Fintype Coord]
    (components : Finset Component) (componentBlock : Component → Finset Coord)
    (sampleWeight : Sample → Component → ℝ) (sampleWeightNorm2 : Sample → ℝ)
    (sampleIdeal : Sample → Component → Coord → ℝ)
    (project : (Coord → ℝ) → Coord → ℝ) (radius : ℝ)
    (stateSample : (Coord → ℝ) × Sample) : Coord → ℝ :=
  project (fun i => stateSample.1 i - radius *
    weightedEuclideanL2BlockSampleDirection components componentBlock
      sampleWeight sampleWeightNorm2 sampleIdeal stateSample.1 stateSample.2 i)

/-- A Borel projection makes the complete weighted update Borel. -/
theorem measurable_weightedEuclideanL2BlockOutcomeStep
    {Coord Component Sample : Type*} [Fintype Coord] [MeasurableSpace Sample]
    (components : Finset Component) (componentBlock : Component → Finset Coord)
    (sampleWeight : Sample → Component → ℝ) (sampleWeightNorm2 : Sample → ℝ)
    (sampleIdeal : Sample → Component → Coord → ℝ)
    (project : (Coord → ℝ) → Coord → ℝ) (radius : ℝ)
    (hweight : ∀ k, Measurable (fun sample => sampleWeight sample k))
    (hweightNorm2 : Measurable sampleWeightNorm2)
    (hideal : ∀ k, Measurable (fun sample => sampleIdeal sample k))
    (hproject : Measurable project) :
    Measurable (weightedEuclideanL2BlockOutcomeStep components componentBlock
      sampleWeight sampleWeightNorm2 sampleIdeal project radius) := by
  apply hproject.comp
  apply measurable_pi_lambda
  intro i
  exact ((measurable_pi_apply i).comp measurable_fst).sub
    (measurable_const.mul ((measurable_pi_apply i).comp
      (measurable_weightedEuclideanL2BlockSampleDirection components componentBlock
        sampleWeight sampleWeightNorm2 sampleIdeal hweight hweightNorm2 hideal)))

/-- The canonical outcome-indexed weighted-Euclidean recursion driven by iid joint samples. -/
noncomputable def weightedEuclideanL2BlockOutcomeTrajectory
    {Coord Component Sample : Type*} [Fintype Coord]
    (components : Finset Component) (componentBlock : Component → Finset Coord)
    (sampleWeight : Sample → Component → ℝ) (sampleWeightNorm2 : Sample → ℝ)
    (sampleIdeal : Sample → Component → Coord → ℝ)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ) :
    ℕ → (ℕ → Sample) → Coord → ℝ
  | 0, _ => initial
  | n + 1, omega =>
      weightedEuclideanL2BlockOutcomeStep components componentBlock
        sampleWeight sampleWeightNorm2 sampleIdeal project (ilvRadius r0 (n + 1))
        (weightedEuclideanL2BlockOutcomeTrajectory components componentBlock
          sampleWeight sampleWeightNorm2 sampleIdeal r0 project initial n omega,
          AppliedModelingLib.iidSequenceSample n omega)

/-- The same weighted recursion evaluated from the finite iid history available at each step. -/
noncomputable def weightedEuclideanL2BlockOutcomePrefixTrajectory
    {Coord Component Sample : Type*} [Fintype Coord]
    (components : Finset Component) (componentBlock : Component → Finset Coord)
    (sampleWeight : Sample → Component → ℝ) (sampleWeightNorm2 : Sample → ℝ)
    (sampleIdeal : Sample → Component → Coord → ℝ)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ) :
    (n : ℕ) → (Fin (n + 1) → Sample) → Coord → ℝ
  | 0, _ => initial
  | n + 1, history =>
      weightedEuclideanL2BlockOutcomeStep components componentBlock
        sampleWeight sampleWeightNorm2 sampleIdeal project (ilvRadius r0 (n + 1))
        (weightedEuclideanL2BlockOutcomePrefixTrajectory components componentBlock
          sampleWeight sampleWeightNorm2 sampleIdeal r0 project initial n
          (fun j => history j.castSucc), history (Fin.last (n + 1)))

/-- The finite-history weighted state is Borel whenever the joint sample and projection data are Borel. -/
theorem measurable_weightedEuclideanL2BlockOutcomePrefixTrajectory
    {Coord Component Sample : Type*} [Fintype Coord] [MeasurableSpace Sample]
    (components : Finset Component) (componentBlock : Component → Finset Coord)
    (sampleWeight : Sample → Component → ℝ) (sampleWeightNorm2 : Sample → ℝ)
    (sampleIdeal : Sample → Component → Coord → ℝ)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hweight : ∀ k, Measurable (fun sample => sampleWeight sample k))
    (hweightNorm2 : Measurable sampleWeightNorm2)
    (hideal : ∀ k, Measurable (fun sample => sampleIdeal sample k))
    (hproject : Measurable project) :
    ∀ n, Measurable (weightedEuclideanL2BlockOutcomePrefixTrajectory components
      componentBlock sampleWeight sampleWeightNorm2 sampleIdeal r0 project initial n) := by
  intro n
  induction n with
  | zero => exact measurable_const
  | succ n ih =>
      change Measurable (fun history : Fin (n + 2) → Sample =>
        weightedEuclideanL2BlockOutcomeStep components componentBlock
          sampleWeight sampleWeightNorm2 sampleIdeal project (ilvRadius r0 (n + 1))
          (weightedEuclideanL2BlockOutcomePrefixTrajectory components componentBlock
            sampleWeight sampleWeightNorm2 sampleIdeal r0 project initial n
            (fun j => history j.castSucc), history (Fin.last (n + 1))))
      have hrestrict : Measurable (fun history : Fin (n + 2) → Sample =>
          fun j : Fin (n + 1) => history j.castSucc) := by
        apply measurable_pi_lambda
        intro j
        exact measurable_pi_apply j.castSucc
      have hlast : Measurable (fun history : Fin (n + 2) → Sample =>
          history (Fin.last (n + 1))) := measurable_pi_apply _
      exact (measurable_weightedEuclideanL2BlockOutcomeStep components componentBlock
        sampleWeight sampleWeightNorm2 sampleIdeal project (ilvRadius r0 (n + 1))
        hweight hweightNorm2 hideal hproject).comp
        ((ih.comp hrestrict).prodMk hlast)

/-- Evaluating the finite-history weighted recursion on its iid prefix recovers the outcome trace. -/
theorem weightedEuclideanL2BlockOutcomePrefixTrajectory_pastPrefix_eq
    {Coord Component Sample : Type*} [Fintype Coord]
    (components : Finset Component) (componentBlock : Component → Finset Coord)
    (sampleWeight : Sample → Component → ℝ) (sampleWeightNorm2 : Sample → ℝ)
    (sampleIdeal : Sample → Component → Coord → ℝ)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → Sample) :
    weightedEuclideanL2BlockOutcomePrefixTrajectory components componentBlock
      sampleWeight sampleWeightNorm2 sampleIdeal r0 project initial n
      (AppliedModelingLib.iidSequencePastPrefix n omega) =
      weightedEuclideanL2BlockOutcomeTrajectory components componentBlock
        sampleWeight sampleWeightNorm2 sampleIdeal r0 project initial n omega := by
  induction n with
  | zero => rfl
  | succ n ih =>
      simp only [weightedEuclideanL2BlockOutcomeTrajectory,
        weightedEuclideanL2BlockOutcomePrefixTrajectory,
        AppliedModelingLib.iidSequencePastPrefix]
      have hprefix : (fun j : Fin (n + 1) => omega j.castSucc) =
          AppliedModelingLib.iidSequencePastPrefix n omega := rfl
      rw [hprefix, ih]
      simp [AppliedModelingLib.iidSequenceSample]

/--
Conditioning an integrable statistic of the actual weighted state and its
fresh iid joint sample gives the population integral at that current state.
-/
theorem weightedEuclideanL2BlockOutcomeTrajectory_condExp_ae_eq_integral
    {Coord Component Sample : Type*} [Fintype Coord]
    [NormedAddCommGroup Sample] [SecondCountableTopology Sample]
    [MeasurableSpace Sample] [BorelSpace Sample] [StandardBorelSpace Sample] [Nonempty Sample]
    (components : Finset Component) (componentBlock : Component → Finset Coord)
    (sampleWeight : Sample → Component → ℝ) (sampleWeightNorm2 : Sample → ℝ)
    (sampleIdeal : Sample → Component → Coord → ℝ)
    (ν : Measure Sample) [IsProbabilityMeasure ν]
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (test : (Coord → ℝ) → Sample → ℝ)
    (htest : Integrable (fun z : (Fin (n + 1) → Sample) × Sample =>
      test (weightedEuclideanL2BlockOutcomePrefixTrajectory components componentBlock
        sampleWeight sampleWeightNorm2 sampleIdeal r0 project initial n z.1) z.2)
      (Measure.map (fun omega =>
        (AppliedModelingLib.iidSequencePastPrefix n omega, AppliedModelingLib.iidSequenceSample n omega))
        (AppliedModelingLib.iidSequenceMeasure ν))) :
    (AppliedModelingLib.iidSequenceMeasure ν)[
      fun omega => test
        (weightedEuclideanL2BlockOutcomeTrajectory components componentBlock
          sampleWeight sampleWeightNorm2 sampleIdeal r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) |
        AppliedModelingLib.iidSequenceNaturalFiltration (α := Sample) n] =ᵐ[
          AppliedModelingLib.iidSequenceMeasure ν]
      fun omega => ∫ sample, test
        (weightedEuclideanL2BlockOutcomeTrajectory components componentBlock
          sampleWeight sampleWeightNorm2 sampleIdeal r0 project initial n omega)
        sample ∂ν := by
  have hcond := AppliedModelingLib.iidSequencePastPrefix_condExp_ae_eq_integral
    ν n
    (fun past sample => test
      (weightedEuclideanL2BlockOutcomePrefixTrajectory components componentBlock
        sampleWeight sampleWeightNorm2 sampleIdeal r0 project initial n past) sample)
    htest
  simpa only [weightedEuclideanL2BlockOutcomePrefixTrajectory_pastPrefix_eq] using hcond

theorem WeightedEuclideanJointSampleData.measurable_sampleWeight
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) (k : Component) :
    Measurable (fun sample => D.sampleWeight sample k) := by
  exact (measurable_pi_apply k).comp measurable_fst

theorem WeightedEuclideanJointSampleData.measurable_sampleWeightNorm2
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) :
    Measurable D.sampleWeightNorm2 := by
  exact measurable_finiteDimensional_l2.comp measurable_fst

theorem WeightedEuclideanJointSampleData.measurable_sampleIdeal
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) (k : Component) :
    Measurable (fun sample => D.sampleIdeal sample k) := by
  exact measurable_snd

/-- The canonical iid Definition 2 trajectory from an explicit joint weight/ideal law. -/
noncomputable def weightedEuclideanJointSampleOutcomeTrajectory
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ) :
    ℕ → (ℕ → (Component → ℝ) × (Coord → ℝ)) → Coord → ℝ :=
  weightedEuclideanL2BlockOutcomeTrajectory Finset.univ D.componentBlock
    D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal r0 project initial

/-- The finite-history form of the canonical iid Definition 2 trajectory. -/
noncomputable def weightedEuclideanJointSampleOutcomePrefixTrajectory
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ) :
    (n : ℕ) → (Fin (n + 1) → (Component → ℝ) × (Coord → ℝ)) → Coord → ℝ :=
  weightedEuclideanL2BlockOutcomePrefixTrajectory Finset.univ D.componentBlock
    D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal r0 project initial

/-- The Definition 2 finite-history state is Borel under a Borel projection. -/
theorem measurable_weightedEuclideanJointSampleOutcomePrefixTrajectory
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) :
    ∀ n, Measurable (weightedEuclideanJointSampleOutcomePrefixTrajectory D r0 project initial n) := by
  exact measurable_weightedEuclideanL2BlockOutcomePrefixTrajectory Finset.univ
    D.componentBlock D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal r0 project initial
    D.measurable_sampleWeight D.measurable_sampleWeightNorm2 D.measurable_sampleIdeal hproject

/-- The finite iid prefix recovers the canonical Definition 2 outcome trajectory. -/
theorem weightedEuclideanJointSampleOutcomePrefixTrajectory_pastPrefix_eq
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → (Component → ℝ) × (Coord → ℝ)) :
    weightedEuclideanJointSampleOutcomePrefixTrajectory D r0 project initial n
      (AppliedModelingLib.iidSequencePastPrefix n omega) =
      weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega := by
  exact weightedEuclideanL2BlockOutcomePrefixTrajectory_pastPrefix_eq Finset.univ
    D.componentBlock D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal r0 project initial n omega

/--
The canonical Definition 2 state and its fresh joint voter draw satisfy the
population conditional-expectation identity needed for martingale centering.
-/
theorem weightedEuclideanJointSampleOutcomeTrajectory_condExp_ae_eq_integral
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (test : (Coord → ℝ) → ((Component → ℝ) × (Coord → ℝ)) → ℝ)
    (htest : Integrable (fun z :
      (Fin (n + 1) → (Component → ℝ) × (Coord → ℝ)) ×
        ((Component → ℝ) × (Coord → ℝ)) =>
      test (weightedEuclideanJointSampleOutcomePrefixTrajectory D r0 project initial n z.1) z.2)
      (Measure.map (fun omega =>
        (AppliedModelingLib.iidSequencePastPrefix n omega, AppliedModelingLib.iidSequenceSample n omega))
        (AppliedModelingLib.iidSequenceMeasure D.jointMeasure))) :
    (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)[
      fun omega => test (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) |
        AppliedModelingLib.iidSequenceNaturalFiltration
          (α := (Component → ℝ) × (Coord → ℝ)) n] =ᵐ[
            AppliedModelingLib.iidSequenceMeasure D.jointMeasure]
      fun omega => ∫ sample,
        test (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
          sample ∂D.jointMeasure := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  exact weightedEuclideanL2BlockOutcomeTrajectory_condExp_ae_eq_integral
    Finset.univ D.componentBlock D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal
    D.jointMeasure r0 project initial n test htest

/-- The canonical weighted state is strongly measurable with respect to its iid past. -/
theorem stronglyMeasurable_weightedEuclideanJointSampleOutcomeTrajectory_natural
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    StronglyMeasurable[
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n]
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n) := by
  have hfactor : weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n =
      weightedEuclideanJointSampleOutcomePrefixTrajectory D r0 project initial n ∘
        AppliedModelingLib.iidSequencePastPrefix n := by
    funext omega
    exact (weightedEuclideanJointSampleOutcomePrefixTrajectory_pastPrefix_eq
      D r0 project initial n omega).symm
  rw [hfactor, AppliedModelingLib.iidSequenceNaturalFiltration_eq_comap_pastPrefix]
  exact ((measurable_weightedEuclideanJointSampleOutcomePrefixTrajectory
    D r0 project initial hproject n).comp (comap_measurable _)).stronglyMeasurable

/-- The current weighted state is independent of the fresh joint voter sample. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_indep_jointSample
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    IndepFun (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n)
      (AppliedModelingLib.iidSequenceSample n)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  have hindep := (AppliedModelingLib.iidSequencePastPrefix_indep_sample D.jointMeasure n).comp
    (measurable_weightedEuclideanJointSampleOutcomePrefixTrajectory
      D r0 project initial hproject n) measurable_id
  have hfactor : weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n =
      weightedEuclideanJointSampleOutcomePrefixTrajectory D r0 project initial n ∘
        AppliedModelingLib.iidSequencePastPrefix n := by
    funext omega
    exact (weightedEuclideanJointSampleOutcomePrefixTrajectory_pastPrefix_eq
      D r0 project initial n omega).symm
  rw [hfactor]
  exact hindep

/-- The ideal-coordinate projection of every fresh joint sample has the C3 ideal law. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_idealSample_law
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) (n : ℕ) :
    Measure.map (fun omega => (AppliedModelingLib.iidSequenceSample n omega).2)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) =
        D.idealDistribution.idealMeasure := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  calc
    Measure.map (fun omega => (AppliedModelingLib.iidSequenceSample n omega).2)
        (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) =
        Measure.map Prod.snd
          (Measure.map (AppliedModelingLib.iidSequenceSample n)
            (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)) := by
          symm
          simpa [Function.comp_def] using
            (Measure.map_map (μ := AppliedModelingLib.iidSequenceMeasure D.jointMeasure)
              measurable_snd (AppliedModelingLib.measurable_iidSequenceSample n))
    _ = Measure.map Prod.snd D.jointMeasure := by
      rw [AppliedModelingLib.iidSequenceSample_law D.jointMeasure n]
    _ = D.idealDistribution.idealMeasure := D.ideal_marginal

/-- The current weighted state is independent of the ideal part of its fresh joint sample. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_indep_idealSample
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    IndepFun (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n)
      (fun omega => (AppliedModelingLib.iidSequenceSample n omega).2)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  have hindep := weightedEuclideanJointSampleOutcomeTrajectory_indep_jointSample
    D r0 project initial hproject n
  simpa only [Function.comp_apply] using hindep.comp measurable_id measurable_snd

/-- The current weighted state avoids every coordinate of the fresh joint-sample ideal a.e. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_ae_coordinate_noncollision
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure, ∀ i,
      weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega i ≠
        (AppliedModelingLib.iidSequenceSample n omega).2 i := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  exact ae_coordinate_noncollision_of_indep_idealSample
    (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) D.idealDistribution
    (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n)
    (fun omega => (AppliedModelingLib.iidSequenceSample n omega).2)
    ((stronglyMeasurable_weightedEuclideanJointSampleOutcomeTrajectory_natural
      D r0 project initial hproject n).measurable.mono
        ((AppliedModelingLib.iidSequenceNaturalFiltration
          (α := (Component → ℝ) × (Coord → ℝ))).le n) le_rfl)
    (measurable_snd.comp (AppliedModelingLib.measurable_iidSequenceSample n))
    (weightedEuclideanJointSampleOutcomeTrajectory_indep_idealSample
      D r0 project initial hproject n)
    (weightedEuclideanJointSampleOutcomeTrajectory_idealSample_law D n)

/--
At every step, the actual Definition 2 sampled direction has Euclidean
quantity one almost surely.  This is the bounded-gradient input for the
projected stochastic-subgradient argument.
-/
theorem weightedEuclideanJointSampleOutcomeTrajectory_sampledDirection_l2_eq_one_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure,
      finiteCoordinateNorm SourceNorm.l2
        (weightedEuclideanL2BlockSampleDirection Finset.univ D.componentBlock
          D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega)) = 1 := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  have hweightNorm : ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure,
      0 < D.sampleWeightNorm2 (AppliedModelingLib.iidSequenceSample n omega) := by
    have hmap : ∀ᵐ sample ∂Measure.map (AppliedModelingLib.iidSequenceSample n)
        (AppliedModelingLib.iidSequenceMeasure D.jointMeasure),
        0 < D.sampleWeightNorm2 sample := by
      rw [AppliedModelingLib.iidSequenceSample_law D.jointMeasure n]
      exact D.sampleWeightNorm2_pos_ae
    exact MeasureTheory.ae_of_ae_map
      (AppliedModelingLib.measurable_iidSequenceSample n).aemeasurable hmap
  filter_upwards [
    weightedEuclideanJointSampleOutcomeTrajectory_ae_coordinate_noncollision
      D r0 project initial hproject n,
    hweightNorm] with omega hnoncollision hweightNorm
  unfold weightedEuclideanL2BlockSampleDirection
  apply weightedEuclidean_l2_direction_norm_eq_one_of_coordinate_blocks
    Finset.univ
    (fun k =>
      D.sampleWeight (AppliedModelingLib.iidSequenceSample n omega) k /
        D.sampleWeightNorm2 (AppliedModelingLib.iidSequenceSample n omega))
    (fun k =>
      l2BlockDistanceNormalizedGradient (D.componentBlock k)
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
        (D.sampleIdeal (AppliedModelingLib.iidSequenceSample n omega) k))
  · intro i k l _hk _hl hkl
    exact l2BlockDistanceNormalizedGradients_coordinatewise_disjoint
      Finset.univ D.componentBlock
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
      (D.sampleIdeal (AppliedModelingLib.iidSequenceSample n omega))
      (fun k l _ _ hne => D.componentBlocks_disjoint k l hne)
      i k l (by simp) (by simp) hkl
  · intro k _hk
    rw [finiteCoordinateNorm_l2]
    apply l2BlockDistanceNormalizedGradient_l2_eq_one
    rcases D.componentBlocks_nonempty k with ⟨i, hi⟩
    exact ⟨i, hi, by
      simpa [WeightedEuclideanJointSampleData.sampleIdeal] using hnoncollision i⟩
  · have hdenom_ne_zero :
        D.sampleWeightNorm2 (AppliedModelingLib.iidSequenceSample n omega) ≠ 0 :=
      hweightNorm.ne'
    calc
      (∑ k ∈ Finset.univ,
          (D.sampleWeight (AppliedModelingLib.iidSequenceSample n omega) k /
              D.sampleWeightNorm2 (AppliedModelingLib.iidSequenceSample n omega)) ^ 2) =
          ∑ k ∈ Finset.univ,
            D.sampleWeight (AppliedModelingLib.iidSequenceSample n omega) k ^ 2 /
              D.sampleWeightNorm2 (AppliedModelingLib.iidSequenceSample n omega) ^ 2 := by
            apply Finset.sum_congr rfl
            intro k _hk
            field_simp
      _ = (∑ k ∈ Finset.univ,
            D.sampleWeight (AppliedModelingLib.iidSequenceSample n omega) k ^ 2) /
              D.sampleWeightNorm2 (AppliedModelingLib.iidSequenceSample n omega) ^ 2 := by
            rw [Finset.sum_div]
      _ = 1 := by
            rw [D.sampleWeightNorm2_sq, div_self (pow_ne_zero _ hdenom_ne_zero)]

/--
The nonnegative weighted block-distance cost of one joint Definition 2 voter.
This is the negative of the corresponding weighted-Euclidean utility, written
as a cost for the stochastic-subgradient argument.
-/
noncomputable def weightedEuclideanJointSampleCost
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ)) (state : Coord → ℝ) : ℝ :=
  Finset.univ.sum (fun k =>
    (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
      finiteCoordinateBlockL2Distance (D.componentBlock k) state
        (D.sampleIdeal sample k))

/-- The exact one-sample weighted cost is continuous in the queried outcome. -/
theorem continuous_weightedEuclideanJointSampleCost
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ)) :
    Continuous (weightedEuclideanJointSampleCost D sample) := by
  unfold weightedEuclideanJointSampleCost finiteCoordinateBlockL2Distance
  apply continuous_finset_sum
  intro k _hk
  apply continuous_const.mul
  apply AppliedModelingLib.FiniteDimensionalNorms.continuous_l2.comp
  apply continuous_pi
  intro i
  exact (continuous_apply (i : Coord) : Continuous fun state : Coord → ℝ => state i).sub
    continuous_const

/-- Definition 2's one-voter utility, written as the negative sampled cost. -/
noncomputable def weightedEuclideanJointSampleUtility
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ)) (state : Coord → ℝ) : ℝ :=
  -weightedEuclideanJointSampleCost D sample state

/-- The Definition 2 sampled-utility/cost sign convention. -/
theorem weightedEuclideanJointSampleUtility_eq_neg_cost
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ)) (state : Coord → ℝ) :
    weightedEuclideanJointSampleUtility D sample state =
      -weightedEuclideanJointSampleCost D sample state := rfl

/-- The raw Euclidean query set used by one Model A update. -/
def weightedEuclideanJointSampleModelARawQueryBall
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (state : Coord → ℝ) (radius : ℝ) : Set (Coord → ℝ) :=
  {response | finiteCoordinateDistance SourceNorm.l2 response state ≤ radius}

/--
In a finite-coordinate model, every nonnegative-radius raw Euclidean query
set is compact.  This is the pointwise existence input for a Model A
maximizer; it intentionally says nothing about measurable tie-breaking across
different samples.
-/
theorem isCompact_weightedEuclideanJointSampleModelARawQueryBall
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (state : Coord → ℝ) (radius : ℝ) (hradius : 0 ≤ radius) :
    IsCompact (weightedEuclideanJointSampleModelARawQueryBall state radius) := by
  letI : ProperSpace (Coord → ℝ) := FiniteDimensional.proper ℝ (Coord → ℝ)
  rw [Metric.isCompact_iff_isClosed_bounded]
  constructor
  · change IsClosed {response : Coord → ℝ |
      AppliedModelingLib.FiniteDimensionalNorms.l2
        (fun i => response i - state i) ≤ radius}
    exact isClosed_le
      (AppliedModelingLib.FiniteDimensionalNorms.continuous_l2_sub state) continuous_const
  · rw [isBounded_iff_forall_norm_le]
    refine ⟨‖state‖ + radius, ?_⟩
    intro response hresponse
    have hl2 : AppliedModelingLib.FiniteDimensionalNorms.l2
        (fun i => response i - state i) ≤ radius := by
      simpa only [finiteCoordinateDistance_l2] using hresponse
    have hsubnorm : ‖response - state‖ ≤ radius := by
      rw [pi_norm_le_iff_of_nonneg hradius]
      intro i
      rw [Real.norm_eq_abs]
      exact (AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
        (fun j => response j - state j) i).trans hl2
    calc
      ‖response‖ = ‖(response - state) + state‖ := by
        congr 1
        funext i
        simp
      _ ≤ ‖response - state‖ + ‖state‖ := norm_add_le _ _
      _ ≤ ‖state‖ + radius := by linarith

/-- The finite family of possible saturated component sets for block water filling. -/
noncomputable def weightedEuclideanJointSampleWaterfillSubsets
    (Component : Type*) [Fintype Component] : Finset (Finset Component) := by
  classical
  exact (Finset.univ : Finset Component).powerset

/-- The finite water-filling family always contains the empty saturated set. -/
theorem weightedEuclideanJointSampleWaterfillSubsets_nonempty
    (Component : Type*) [Fintype Component] :
    (weightedEuclideanJointSampleWaterfillSubsets Component).Nonempty := by
  classical
  refine ⟨∅, ?_⟩
  exact Finset.mem_powerset.mpr (Finset.empty_subset _)

/-- The Euclidean distance from a state to one sampled ideal coordinate block. -/
noncomputable def weightedEuclideanJointSampleBlockDistance
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (sample : (Component → ℝ) × (Coord → ℝ))
    (k : Component) : ℝ :=
  finiteCoordinateBlockL2Distance (D.componentBlock k) state (D.sampleIdeal sample k)

/-- The nonnegative normalized component coefficient used in block water filling. -/
noncomputable def weightedEuclideanJointSamplePositiveCoefficient
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ)) (k : Component) : ℝ :=
  max 0 (D.sampleWeight sample k / D.sampleWeightNorm2 sample)

/-- One finite block distance is Borel in the state and joint voter sample. -/
theorem measurable_weightedEuclideanJointSampleBlockDistance
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) (k : Component) :
    Measurable (fun z : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      weightedEuclideanJointSampleBlockDistance D z.1 z.2 k) := by
  exact (measurable_finiteCoordinateBlockL2Distance (D.componentBlock k)).comp
    (measurable_fst.prodMk ((D.measurable_sampleIdeal k).comp measurable_snd))

/-- One nonnegative normalized component coefficient is Borel in the joint sample. -/
theorem measurable_weightedEuclideanJointSamplePositiveCoefficient
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) (k : Component) :
    Measurable (fun sample : (Component → ℝ) × (Coord → ℝ) =>
      weightedEuclideanJointSamplePositiveCoefficient D sample k) := by
  unfold weightedEuclideanJointSamplePositiveCoefficient
  exact measurable_const.max ((D.measurable_sampleWeight k).div
    D.measurable_sampleWeightNorm2)

/-- The squared block-distance budget consumed by a proposed saturated set. -/
noncomputable def weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) : ℝ :=
  ∑ k ∈ saturated, (weightedEuclideanJointSampleBlockDistance D state sample k) ^ 2

/-- The squared normalized weight of the blocks outside a proposed saturated set. -/
noncomputable def weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) : ℝ :=
  ∑ k ∈ (Finset.univ \ saturated),
    (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2

/-- The candidate multiplier associated to one proposed saturated component set. -/
noncomputable def weightedEuclideanJointSampleWaterfillCandidateLevel
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) : ℝ :=
  Real.sqrt (
    max 0 (radius ^ 2 -
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated) /
    weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated)

/-- A fixed saturated-set candidate multiplier is Borel in state and sample. -/
theorem measurable_weightedEuclideanJointSampleWaterfillCandidateLevel
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) (radius : ℝ)
    (saturated : Finset Component) :
    Measurable (fun z : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      weightedEuclideanJointSampleWaterfillCandidateLevel D z.1 radius z.2 saturated) := by
  unfold weightedEuclideanJointSampleWaterfillCandidateLevel
    weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
    weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq
  have hdist : Measurable (fun z :
      (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      ∑ k ∈ saturated,
        (weightedEuclideanJointSampleBlockDistance D z.1 z.2 k) ^ 2) :=
    Finset.measurable_sum saturated fun k _ =>
      (measurable_weightedEuclideanJointSampleBlockDistance D k).pow_const 2
  have hcoefficient : Measurable (fun z :
      (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      ∑ k ∈ (Finset.univ \ saturated),
        (weightedEuclideanJointSamplePositiveCoefficient D z.2 k) ^ 2) :=
    Finset.measurable_sum (Finset.univ \ saturated) fun k _ =>
      ((measurable_weightedEuclideanJointSamplePositiveCoefficient D k).comp
        measurable_snd).pow_const 2
  exact (measurable_const.max (measurable_const.sub hdist)).div hcoefficient |>.sqrt

/--
The finite block water-filling level.  A subset records the blocks that have
already reached their ideal; taking the maximum over all subsets makes the
formula Borel without invoking a nonmeasurable arg-min choice.
-/
noncomputable def weightedEuclideanJointSampleWaterfillLevel
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) : ℝ :=
  (weightedEuclideanJointSampleWaterfillSubsets Component).sup'
    (weightedEuclideanJointSampleWaterfillSubsets_nonempty Component)
    fun saturated =>
      weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample saturated

/-- The finite weighted block water-filling level is Borel in state and sample. -/
theorem measurable_weightedEuclideanJointSampleWaterfillLevel
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) (radius : ℝ) :
    Measurable (fun z : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      weightedEuclideanJointSampleWaterfillLevel D z.1 radius z.2) := by
  classical
  unfold weightedEuclideanJointSampleWaterfillLevel
  have hsup := Finset.measurable_sup' (α := ℝ)
    (δ := (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)))
    (s := weightedEuclideanJointSampleWaterfillSubsets Component)
    (f := fun saturated z =>
      weightedEuclideanJointSampleWaterfillCandidateLevel D z.1 radius z.2 saturated)
    (weightedEuclideanJointSampleWaterfillSubsets_nonempty Component) (by
      intro saturated _hsaturated
      exact measurable_weightedEuclideanJointSampleWaterfillCandidateLevel
        D radius saturated)
  convert hsup using 1
  funext z
  exact (Finset.sup'_apply
    (C := fun _ : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) => ℝ)
    (weightedEuclideanJointSampleWaterfillSubsets_nonempty Component)
    (fun saturated z =>
      weightedEuclideanJointSampleWaterfillCandidateLevel D z.1 radius z.2 saturated) z).symm

/-- Each candidate multiplier is bounded by the finite water-filling level. -/
theorem weightedEuclideanJointSampleWaterfillCandidateLevel_le_level
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) :
    weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample saturated ≤
      weightedEuclideanJointSampleWaterfillLevel D state radius sample := by
  classical
  unfold weightedEuclideanJointSampleWaterfillLevel
  apply Finset.le_sup'
  exact Finset.mem_powerset.mpr (Finset.subset_univ saturated)

/-- Some finite saturated set attains the water-filling level. -/
theorem exists_weightedEuclideanJointSampleWaterfillCandidateLevel_eq_level
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) :
    ∃ saturated ∈ weightedEuclideanJointSampleWaterfillSubsets Component,
      weightedEuclideanJointSampleWaterfillLevel D state radius sample =
        weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample saturated := by
  classical
  unfold weightedEuclideanJointSampleWaterfillLevel
  exact Finset.exists_mem_eq_sup'
    (weightedEuclideanJointSampleWaterfillSubsets_nonempty Component) _

/-- A finite saturated set chosen to attain the Borel water-filling level. -/
noncomputable def weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) : Finset Component :=
  Classical.choose
    (exists_weightedEuclideanJointSampleWaterfillCandidateLevel_eq_level
      D state radius sample)

/-- The selected saturated set is one of the finite candidate sets. -/
theorem weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet_mem
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) :
    weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample ∈
      weightedEuclideanJointSampleWaterfillSubsets Component :=
  (Classical.choose_spec
    (exists_weightedEuclideanJointSampleWaterfillCandidateLevel_eq_level
      D state radius sample)).1

/-- The selected saturated set realizes the finite water-filling level. -/
theorem weightedEuclideanJointSampleWaterfillLevel_eq_maximizingCandidate
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) :
    weightedEuclideanJointSampleWaterfillLevel D state radius sample =
      weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample
        (weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample) :=
  (Classical.choose_spec
    (exists_weightedEuclideanJointSampleWaterfillCandidateLevel_eq_level
      D state radius sample)).2

/-- Every truncated normalized component coefficient is nonnegative. -/
theorem weightedEuclideanJointSamplePositiveCoefficient_nonneg
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ)) (k : Component) :
    0 ≤ weightedEuclideanJointSamplePositiveCoefficient D sample k := by
  unfold weightedEuclideanJointSamplePositiveCoefficient
  exact le_max_left _ _

/-- On a nonnegative weight vector, truncation leaves the normalized coefficient unchanged. -/
theorem weightedEuclideanJointSamplePositiveCoefficient_eq_normalizedWeight
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ)) (k : Component)
    (hcoefficient : 0 ≤ D.sampleWeight sample k / D.sampleWeightNorm2 sample) :
    weightedEuclideanJointSamplePositiveCoefficient D sample k =
      D.sampleWeight sample k / D.sampleWeightNorm2 sample := by
  unfold weightedEuclideanJointSamplePositiveCoefficient
  exact max_eq_right hcoefficient

/--
For a valid Definition 2 weight vector, the positive coefficients retain the
Euclidean normalization of the original weights.
-/
theorem weightedEuclideanJointSamplePositiveCoefficient_sq_sum_eq_one_of_valid
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    ∑ k, (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2 = 1 := by
  have hcoefficient : ∀ k,
      weightedEuclideanJointSamplePositiveCoefficient D sample k =
        D.sampleWeight sample k / D.sampleWeightNorm2 sample := by
    intro k
    apply weightedEuclideanJointSamplePositiveCoefficient_eq_normalizedWeight
    exact div_nonneg (hweight k) hnorm.le
  calc
    ∑ k, (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2 =
        ∑ k, (D.sampleWeight sample k / D.sampleWeightNorm2 sample) ^ 2 := by
      apply Finset.sum_congr rfl
      intro k _hk
      rw [hcoefficient k]
    _ = ∑ k, D.sampleWeight sample k ^ 2 /
        D.sampleWeightNorm2 sample ^ 2 := by
      apply Finset.sum_congr rfl
      intro k _hk
      field_simp
    _ = (∑ k, D.sampleWeight sample k ^ 2) /
        D.sampleWeightNorm2 sample ^ 2 := by
      rw [Finset.sum_div]
    _ = 1 := by
      rw [D.sampleWeightNorm2_sq, div_self (pow_ne_zero _ hnorm.ne')]

/-- Every proposed saturated-set squared-distance total is nonnegative. -/
theorem weightedEuclideanJointSampleWaterfillSaturatedDistanceSq_nonneg
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) :
    0 ≤ weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated := by
  unfold weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
  exact Finset.sum_nonneg fun k _hk => sq_nonneg _

/-- Every proposed unsaturated coefficient-square total is nonnegative. -/
theorem weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq_nonneg
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) :
    0 ≤ weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated := by
  unfold weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq
  exact Finset.sum_nonneg fun k _hk => sq_nonneg _

/-- Saturated and complementary block-distance squares partition the full total. -/
theorem weightedEuclideanJointSampleWaterfillSaturatedDistanceSq_add_complement
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) :
    weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated +
      ∑ k ∈ (Finset.univ \ saturated),
        (weightedEuclideanJointSampleBlockDistance D state sample k) ^ 2 =
      ∑ k, (weightedEuclideanJointSampleBlockDistance D state sample k) ^ 2 := by
  unfold weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
  rw [add_comm, Finset.sum_sdiff (Finset.subset_univ saturated)]

/-- Saturated and complementary normalized coefficient squares partition the total. -/
theorem weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq_add_saturated
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) :
    weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated +
      ∑ k ∈ saturated,
        (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2 =
      ∑ k, (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2 := by
  unfold weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq
  exact Finset.sum_sdiff (Finset.subset_univ saturated)

/-- Inserting a new saturated block adds exactly its squared distance. -/
theorem weightedEuclideanJointSampleWaterfillSaturatedDistanceSq_insert
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) {k : Component} (hk : k ∉ saturated) :
    weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample (insert k saturated) =
      (weightedEuclideanJointSampleBlockDistance D state sample k) ^ 2 +
        weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated := by
  unfold weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
  rw [Finset.sum_insert hk]

/-- Inserting a saturated block removes exactly its squared coefficient from the complement. -/
theorem weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq_insert_add
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) {k : Component} (hk : k ∉ saturated) :
    weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample (insert k saturated) +
      (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2 =
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated := by
  unfold weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq
  rw [Finset.sdiff_insert]
  apply Finset.sum_erase_add
  exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hk⟩

/-- Removing a saturated block subtracts exactly its squared distance. -/
theorem weightedEuclideanJointSampleWaterfillSaturatedDistanceSq_erase_add
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) {k : Component} (hk : k ∈ saturated) :
    weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample (saturated.erase k) +
      (weightedEuclideanJointSampleBlockDistance D state sample k) ^ 2 =
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated := by
  unfold weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
  exact Finset.sum_erase_add _ _ hk

/-- Removing a saturated block adds exactly its squared coefficient to the complement. -/
theorem weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq_erase
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) {k : Component} (hk : k ∈ saturated) :
    weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated +
      (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2 =
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample (saturated.erase k) := by
  have hnotmem : k ∉ saturated.erase k := by simp
  have hinsert : insert k (saturated.erase k) = saturated := Finset.insert_erase hk
  calc
    weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated +
        (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2 =
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
        (insert k (saturated.erase k)) +
          (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2 := by
        rw [hinsert]
    _ = weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
        (saturated.erase k) :=
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq_insert_add
        D sample (saturated.erase k) hnotmem

/-- Squaring a candidate multiplier recovers its finite water-filling ratio. -/
theorem weightedEuclideanJointSampleWaterfillCandidateLevel_sq
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) :
    (weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample saturated) ^ 2 =
      max 0 (radius ^ 2 -
        weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated) /
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated := by
  unfold weightedEuclideanJointSampleWaterfillCandidateLevel
  rw [Real.sq_sqrt]
  exact div_nonneg (le_max_left _ _)
    (weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq_nonneg
      D sample saturated)

/-- A candidate with no unsaturated positive coefficient has multiplier zero. -/
theorem weightedEuclideanJointSampleWaterfillCandidateLevel_eq_zero_of_unsaturatedCoefficientSq_eq_zero
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component)
    (hzero : weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated = 0) :
    weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample saturated = 0 := by
  unfold weightedEuclideanJointSampleWaterfillCandidateLevel
  rw [hzero, div_zero, Real.sqrt_zero]

/-- A candidate multiplier exceeds any nonnegative scalar whose square is below its ratio. -/
theorem lt_weightedEuclideanJointSampleWaterfillCandidateLevel_of_sq_lt_ratio
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) (level : ℝ)
    (hlevel : 0 ≤ level)
    (hresidual : 0 < radius ^ 2 -
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated)
    (hdenominator : 0 <
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated)
    (hsq : level ^ 2 <
      (radius ^ 2 - weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
        D state sample saturated) /
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated) :
    level < weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample saturated := by
  unfold weightedEuclideanJointSampleWaterfillCandidateLevel
  rw [max_eq_right hresidual.le]
  exact (Real.lt_sqrt hlevel).mpr hsq

/-- Each candidate water-filling multiplier is nonnegative. -/
theorem weightedEuclideanJointSampleWaterfillCandidateLevel_nonneg
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (saturated : Finset Component) :
    0 ≤ weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample saturated :=
  Real.sqrt_nonneg _

/-- The finite water-filling multiplier is nonnegative. -/
theorem weightedEuclideanJointSampleWaterfillLevel_nonneg
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) :
    0 ≤ weightedEuclideanJointSampleWaterfillLevel D state radius sample := by
  rcases exists_weightedEuclideanJointSampleWaterfillCandidateLevel_eq_level
    D state radius sample with ⟨saturated, _hsaturated, hlevel⟩
  rw [hlevel]
  exact weightedEuclideanJointSampleWaterfillCandidateLevel_nonneg
    D state radius sample saturated

/--
With a valid normalized weight vector, the empty saturated set shows that the
water-filling multiplier is at least every nonnegative query radius.
-/
theorem weightedEuclideanJointSampleWaterfillLevel_ge_radius_of_valid
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 ≤ radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    radius ≤ weightedEuclideanJointSampleWaterfillLevel D state radius sample := by
  have hsum := weightedEuclideanJointSamplePositiveCoefficient_sq_sum_eq_one_of_valid
    D sample hweight hnorm
  have hcandidate :
      weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample ∅ = radius := by
    unfold weightedEuclideanJointSampleWaterfillCandidateLevel
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq
    simp only [Finset.sum_empty, Finset.sdiff_empty, sub_zero]
    rw [max_eq_right (sq_nonneg radius), hsum, div_one,
      Real.sqrt_sq_eq_abs, abs_of_nonneg hradius]
  calc
    radius = weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample ∅ :=
      hcandidate.symm
    _ ≤ weightedEuclideanJointSampleWaterfillLevel D state radius sample :=
      weightedEuclideanJointSampleWaterfillCandidateLevel_le_level D state radius sample ∅

/-- A positive-radius valid water-filling maximizer retains a positive unsaturated coefficient. -/
theorem weightedEuclideanJointSampleWaterfillMaximizingUnsaturatedCoefficientSq_pos_of_valid
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    0 < weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
      (weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample) := by
  have hlevel_pos : 0 < weightedEuclideanJointSampleWaterfillLevel D state radius sample :=
    lt_of_lt_of_le hradius
      (weightedEuclideanJointSampleWaterfillLevel_ge_radius_of_valid
        D state radius sample hradius.le hweight hnorm)
  have hnonneg := weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq_nonneg
    D sample (weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample)
  by_contra hnotpos
  have hzero : weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
      (weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample) = 0 :=
    le_antisymm (le_of_not_gt hnotpos) hnonneg
  have hcandidate_zero :=
    weightedEuclideanJointSampleWaterfillCandidateLevel_eq_zero_of_unsaturatedCoefficientSq_eq_zero
      D state radius sample
      (weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample) hzero
  rw [weightedEuclideanJointSampleWaterfillLevel_eq_maximizingCandidate,
    hcandidate_zero] at hlevel_pos
  linarith

/-- The selected water-filling multiplier satisfies its maximizing-set square formula. -/
theorem weightedEuclideanJointSampleWaterfillLevel_sq_eq_maximizingRatio
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) :
    (weightedEuclideanJointSampleWaterfillLevel D state radius sample) ^ 2 =
      max 0 (radius ^ 2 - weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
        D state sample
          (weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample)) /
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
        (weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample) := by
  rw [weightedEuclideanJointSampleWaterfillLevel_eq_maximizingCandidate]
  exact weightedEuclideanJointSampleWaterfillCandidateLevel_sq D state radius sample _

/-- A positive-radius valid maximizing saturated set leaves a strictly positive radius budget. -/
theorem weightedEuclideanJointSampleWaterfillMaximizingResidual_pos_of_valid
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    0 < radius ^ 2 - weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
      D state sample
        (weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample) := by
  let saturated := weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet
    D state radius sample
  have hlevel_pos : 0 < weightedEuclideanJointSampleWaterfillLevel D state radius sample :=
    lt_of_lt_of_le hradius
      (weightedEuclideanJointSampleWaterfillLevel_ge_radius_of_valid
        D state radius sample hradius.le hweight hnorm)
  have hdenom_pos : 0 < weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq
      D sample saturated :=
    weightedEuclideanJointSampleWaterfillMaximizingUnsaturatedCoefficientSq_pos_of_valid
      D state radius sample hradius hweight hnorm
  have hsq := weightedEuclideanJointSampleWaterfillLevel_sq_eq_maximizingRatio
    D state radius sample
  change 0 < radius ^ 2 -
    weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated
  by_contra hnotpos
  have hnonpos : radius ^ 2 -
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated ≤ 0 :=
    le_of_not_gt hnotpos
  rw [show weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet
      D state radius sample = saturated by rfl,
    max_eq_left hnonpos] at hsq
  have hlevel_sq_zero :
      (weightedEuclideanJointSampleWaterfillLevel D state radius sample) ^ 2 = 0 := by
    simpa using hsq
  nlinarith

/-- The maximizing multiplier exactly exhausts its proposed unsaturated budget. -/
theorem weightedEuclideanJointSampleWaterfillLevel_sq_mul_maximizingUnsaturatedCoefficientSq
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    (weightedEuclideanJointSampleWaterfillLevel D state radius sample) ^ 2 *
        weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
          (weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample) =
      radius ^ 2 - weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample
        (weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample) := by
  let saturated := weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet
    D state radius sample
  have hdenom_pos : 0 < weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq
      D sample saturated :=
    weightedEuclideanJointSampleWaterfillMaximizingUnsaturatedCoefficientSq_pos_of_valid
      D state radius sample hradius hweight hnorm
  have hresidual_pos : 0 < radius ^ 2 -
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated :=
    weightedEuclideanJointSampleWaterfillMaximizingResidual_pos_of_valid
      D state radius sample hradius hweight hnorm
  have hsq := weightedEuclideanJointSampleWaterfillLevel_sq_eq_maximizingRatio
    D state radius sample
  rw [show weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet
      D state radius sample = saturated by rfl,
    max_eq_right hresidual_pos.le] at hsq
  exact (eq_div_iff hdenom_pos.ne').mp hsq

/-- A block selected by the maximizing saturated set has reached its water-filling cap. -/
theorem weightedEuclideanJointSampleBlockDistance_le_waterfillLevel_mul_coefficient_of_maximizingSaturated
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample)
    {k : Component}
    (hk : k ∈ weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet
      D state radius sample) :
    weightedEuclideanJointSampleBlockDistance D state sample k ≤
      weightedEuclideanJointSampleWaterfillLevel D state radius sample *
        weightedEuclideanJointSamplePositiveCoefficient D sample k := by
  let saturated := weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet
    D state radius sample
  let level := weightedEuclideanJointSampleWaterfillLevel D state radius sample
  let distance := weightedEuclideanJointSampleBlockDistance D state sample k
  let coefficient := weightedEuclideanJointSamplePositiveCoefficient D sample k
  have hlevel_nonneg : 0 ≤ level :=
    weightedEuclideanJointSampleWaterfillLevel_nonneg D state radius sample
  have hdistance_nonneg : 0 ≤ distance := by
    unfold distance weightedEuclideanJointSampleBlockDistance
      finiteCoordinateBlockL2Distance
    exact AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _
  have hcoefficient_nonneg : 0 ≤ coefficient :=
    weightedEuclideanJointSamplePositiveCoefficient_nonneg D sample k
  have hdenominator_pos : 0 <
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated :=
    weightedEuclideanJointSampleWaterfillMaximizingUnsaturatedCoefficientSq_pos_of_valid
      D state radius sample hradius hweight hnorm
  have hresidual_pos : 0 < radius ^ 2 -
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated :=
    weightedEuclideanJointSampleWaterfillMaximizingResidual_pos_of_valid
      D state radius sample hradius hweight hnorm
  have hbudget :=
    weightedEuclideanJointSampleWaterfillLevel_sq_mul_maximizingUnsaturatedCoefficientSq
      D state radius sample hradius hweight hnorm
  change distance ≤ level * coefficient
  by_contra hnotle
  have hstep_lt : level * coefficient < distance := lt_of_not_ge hnotle
  have hstep_sq_lt : (level * coefficient) ^ 2 < distance ^ 2 :=
    (sq_lt_sq₀ (mul_nonneg hlevel_nonneg hcoefficient_nonneg) hdistance_nonneg).mpr hstep_lt
  have hdistance_sum :=
    weightedEuclideanJointSampleWaterfillSaturatedDistanceSq_erase_add
      D state sample saturated (show k ∈ saturated by simpa [saturated] using hk)
  have hcoefficient_sum :=
    weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq_erase
      D sample saturated (show k ∈ saturated by simpa [saturated] using hk)
  have hdenominator_erase_pos : 0 <
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample (saturated.erase k) := by
    rw [← hcoefficient_sum]
    exact add_pos_of_pos_of_nonneg hdenominator_pos (sq_nonneg coefficient)
  have hresidual_erase_pos : 0 < radius ^ 2 -
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample (saturated.erase k) := by
    nlinarith
  have hratio_sq_lt : level ^ 2 <
      (radius ^ 2 - weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
        D state sample (saturated.erase k)) /
      weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
        (saturated.erase k) := by
    apply (lt_div_iff₀ hdenominator_erase_pos).mpr
    nlinarith [hbudget, hstep_sq_lt, hdistance_sum, hcoefficient_sum]
  have hcandidate_lt : level <
      weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample
        (saturated.erase k) :=
    lt_weightedEuclideanJointSampleWaterfillCandidateLevel_of_sq_lt_ratio
      D state radius sample (saturated.erase k) level hlevel_nonneg
      hresidual_erase_pos hdenominator_erase_pos hratio_sq_lt
  have hcandidate_le := weightedEuclideanJointSampleWaterfillCandidateLevel_le_level
    D state radius sample (saturated.erase k)
  change level < _ at hcandidate_lt
  change _ ≤ level at hcandidate_le
  exact (not_lt_of_ge hcandidate_le) hcandidate_lt

/-- The amount moved toward one component ideal by the finite water-filling rule. -/
noncomputable def weightedEuclideanJointSampleWaterfillAmount
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) (k : Component) : ℝ :=
  min (weightedEuclideanJointSampleBlockDistance D state sample k)
    (weightedEuclideanJointSampleWaterfillLevel D state radius sample *
      weightedEuclideanJointSamplePositiveCoefficient D sample k)

/-- A water-filling amount is Borel in the state and joint sample. -/
theorem measurable_weightedEuclideanJointSampleWaterfillAmount
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) (radius : ℝ)
    (k : Component) :
    Measurable (fun z : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      weightedEuclideanJointSampleWaterfillAmount D z.1 radius z.2 k) := by
  unfold weightedEuclideanJointSampleWaterfillAmount
  exact (measurable_weightedEuclideanJointSampleBlockDistance D k).min
    ((measurable_weightedEuclideanJointSampleWaterfillLevel D radius).mul
      ((measurable_weightedEuclideanJointSamplePositiveCoefficient D k).comp
        measurable_snd))

/-- Every water-filling amount is nonnegative. -/
theorem weightedEuclideanJointSampleWaterfillAmount_nonneg
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) (k : Component) :
    0 ≤ weightedEuclideanJointSampleWaterfillAmount D state radius sample k := by
  unfold weightedEuclideanJointSampleWaterfillAmount
  apply le_min
  · unfold weightedEuclideanJointSampleBlockDistance finiteCoordinateBlockL2Distance
    exact AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _
  · exact mul_nonneg (weightedEuclideanJointSampleWaterfillLevel_nonneg D state radius sample)
      (weightedEuclideanJointSamplePositiveCoefficient_nonneg D sample k)

/-- A water-filling amount never exceeds its block distance cap. -/
theorem weightedEuclideanJointSampleWaterfillAmount_le_blockDistance
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) (k : Component) :
    weightedEuclideanJointSampleWaterfillAmount D state radius sample k ≤
      weightedEuclideanJointSampleBlockDistance D state sample k := by
  exact min_le_left _ _

/--
The blocks whose ideal-distance cap is active at the explicit water-filling
multiplier.  This set is defined from the Borel multiplier rather than chosen
by an arbitrary `argmax`, so it is suitable for the exact response formula.
-/
noncomputable def weightedEuclideanJointSampleWaterfillCappedSet
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) : Finset Component :=
  Finset.univ.filter fun k =>
    weightedEuclideanJointSampleBlockDistance D state sample k ≤
      weightedEuclideanJointSampleWaterfillLevel D state radius sample *
        weightedEuclideanJointSamplePositiveCoefficient D sample k

/-- Membership in the capped set is exactly the scalar cap inequality. -/
theorem mem_weightedEuclideanJointSampleWaterfillCappedSet_iff
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) (k : Component) :
    k ∈ weightedEuclideanJointSampleWaterfillCappedSet D state radius sample ↔
      weightedEuclideanJointSampleBlockDistance D state sample k ≤
        weightedEuclideanJointSampleWaterfillLevel D state radius sample *
          weightedEuclideanJointSamplePositiveCoefficient D sample k := by
  simp [weightedEuclideanJointSampleWaterfillCappedSet]

/-- Every block in the finite maximizing witness is cap-active. -/
theorem weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet_subset_cappedSet
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet D state radius sample ⊆
      weightedEuclideanJointSampleWaterfillCappedSet D state radius sample := by
  intro k hk
  rw [mem_weightedEuclideanJointSampleWaterfillCappedSet_iff]
  exact weightedEuclideanJointSampleBlockDistance_le_waterfillLevel_mul_coefficient_of_maximizingSaturated
    D state radius sample hradius hweight hnorm hk

/-- A cap-active block is moved all the way to its component ideal. -/
theorem weightedEuclideanJointSampleWaterfillAmount_eq_blockDistance_of_mem_cappedSet
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) {k : Component}
    (hk : k ∈ weightedEuclideanJointSampleWaterfillCappedSet D state radius sample) :
    weightedEuclideanJointSampleWaterfillAmount D state radius sample k =
      weightedEuclideanJointSampleBlockDistance D state sample k := by
  unfold weightedEuclideanJointSampleWaterfillAmount
  exact min_eq_left (mem_weightedEuclideanJointSampleWaterfillCappedSet_iff
    D state radius sample k |>.mp hk)

/-- A non-cap-active block uses its multiplier-proportional water-filling amount. -/
theorem weightedEuclideanJointSampleWaterfillAmount_eq_level_mul_coefficient_of_not_mem_cappedSet
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) {k : Component}
    (hk : k ∉ weightedEuclideanJointSampleWaterfillCappedSet D state radius sample) :
    weightedEuclideanJointSampleWaterfillAmount D state radius sample k =
      weightedEuclideanJointSampleWaterfillLevel D state radius sample *
        weightedEuclideanJointSamplePositiveCoefficient D sample k := by
  unfold weightedEuclideanJointSampleWaterfillAmount
  apply min_eq_right
  exact le_of_not_ge fun hle => hk
    (mem_weightedEuclideanJointSampleWaterfillCappedSet_iff D state radius sample k |>.mpr hle)

/--
The squared norm budget used by the explicit amounts splits into capped block
distances and multiplier-scaled uncapped coefficient squares.
-/
theorem weightedEuclideanJointSampleWaterfillAmount_sq_sum
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) :
    (∑ k, (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) =
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample
        (weightedEuclideanJointSampleWaterfillCappedSet D state radius sample) +
      (weightedEuclideanJointSampleWaterfillLevel D state radius sample) ^ 2 *
        weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
          (weightedEuclideanJointSampleWaterfillCappedSet D state radius sample) := by
  let capped := weightedEuclideanJointSampleWaterfillCappedSet D state radius sample
  let level := weightedEuclideanJointSampleWaterfillLevel D state radius sample
  have hsplit :
      (∑ k, (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) =
        (∑ k ∈ capped,
          (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) +
        ∑ k ∈ (Finset.univ \ capped),
          (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 := by
    symm
    calc
      (∑ k ∈ capped,
          (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) +
          ∑ k ∈ (Finset.univ \ capped),
            (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 =
          (∑ k ∈ (Finset.univ \ capped),
            (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) +
          ∑ k ∈ capped,
            (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 := by
              rw [add_comm]
      _ = ∑ k, (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 :=
        Finset.sum_sdiff (Finset.subset_univ capped)
  rw [hsplit]
  change _ =
    weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample capped +
      level ^ 2 * weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample capped
  have hcap :
      (∑ k ∈ capped,
        (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) =
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample capped := by
    unfold weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
    apply Finset.sum_congr rfl
    intro k hk
    rw [weightedEuclideanJointSampleWaterfillAmount_eq_blockDistance_of_mem_cappedSet
      D state radius sample (by simpa [capped] using hk)]
  have huncapped :
      (∑ k ∈ (Finset.univ \ capped),
        (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) =
      level ^ 2 * weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample capped := by
    unfold weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k hk
    rw [weightedEuclideanJointSampleWaterfillAmount_eq_level_mul_coefficient_of_not_mem_cappedSet
      D state radius sample (by simpa [capped] using hk)]
    ring
  rw [hcap, huncapped]

/-- A water-filling amount is bounded by its multiplier-proportional amount. -/
theorem weightedEuclideanJointSampleWaterfillAmount_le_level_mul_coefficient
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) (k : Component) :
    weightedEuclideanJointSampleWaterfillAmount D state radius sample k ≤
      weightedEuclideanJointSampleWaterfillLevel D state radius sample *
        weightedEuclideanJointSamplePositiveCoefficient D sample k := by
  exact min_le_right _ _

/-- Squaring preserves the multiplier-proportional amount bound. -/
theorem weightedEuclideanJointSampleWaterfillAmount_sq_le_level_sq_mul_coefficient_sq
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) (k : Component) :
    (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 ≤
      (weightedEuclideanJointSampleWaterfillLevel D state radius sample) ^ 2 *
        (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2 := by
  have hamount_nonneg :=
    weightedEuclideanJointSampleWaterfillAmount_nonneg D state radius sample k
  have hmult_nonneg : 0 ≤
      weightedEuclideanJointSampleWaterfillLevel D state radius sample *
        weightedEuclideanJointSamplePositiveCoefficient D sample k :=
    mul_nonneg (weightedEuclideanJointSampleWaterfillLevel_nonneg D state radius sample)
      (weightedEuclideanJointSamplePositiveCoefficient_nonneg D sample k)
  have hsq := (sq_le_sq₀ hamount_nonneg hmult_nonneg).mpr
    (weightedEuclideanJointSampleWaterfillAmount_le_level_mul_coefficient
      D state radius sample k)
  nlinarith

/-- The explicit water-filling response never spends more than the query's squared radius. -/
theorem weightedEuclideanJointSampleWaterfillAmount_sq_sum_le_radius_sq_of_valid
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    (∑ k, (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) ≤
      radius ^ 2 := by
  let saturated := weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet
    D state radius sample
  let level := weightedEuclideanJointSampleWaterfillLevel D state radius sample
  have hsaturated_subset :=
    weightedEuclideanJointSampleWaterfillMaximizingSaturatedSet_subset_cappedSet
      D state radius sample hradius hweight hnorm
  have hsplit :
      (∑ k, (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) =
        (∑ k ∈ saturated,
          (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) +
        ∑ k ∈ (Finset.univ \ saturated),
          (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 := by
    symm
    calc
      (∑ k ∈ saturated,
          (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) +
          ∑ k ∈ (Finset.univ \ saturated),
            (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 =
          (∑ k ∈ (Finset.univ \ saturated),
            (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) +
          ∑ k ∈ saturated,
            (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 := by
              rw [add_comm]
      _ = ∑ k, (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 :=
        Finset.sum_sdiff (Finset.subset_univ saturated)
  have hsaturated_eq :
      (∑ k ∈ saturated,
        (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) =
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated := by
    unfold weightedEuclideanJointSampleWaterfillSaturatedDistanceSq
    apply Finset.sum_congr rfl
    intro k hk
    rw [weightedEuclideanJointSampleWaterfillAmount_eq_blockDistance_of_mem_cappedSet
      D state radius sample (hsaturated_subset hk)]
  have hcomplement_le :
      (∑ k ∈ (Finset.univ \ saturated),
        (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) ≤
      level ^ 2 * weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated := by
    unfold weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro k hk
    simpa [level, mul_pow] using
      (weightedEuclideanJointSampleWaterfillAmount_sq_le_level_sq_mul_coefficient_sq
        D state radius sample k)
  have hbudget :=
    weightedEuclideanJointSampleWaterfillLevel_sq_mul_maximizingUnsaturatedCoefficientSq
      D state radius sample hradius hweight hnorm
  change _ ≤ radius ^ 2
  rw [hsplit, hsaturated_eq]
  calc
    weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated +
        ∑ k ∈ (Finset.univ \ saturated),
          (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 ≤
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated +
        level ^ 2 * weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample saturated :=
      by simpa [add_comm] using
        add_le_add_left hcomplement_le
          (weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample saturated)
    _ = radius ^ 2 := by
      change _ + level ^ 2 * _ = _
      nlinarith [hbudget]

/-- The explicit amount budget is exact whenever some positive coefficient remains uncapped. -/
theorem weightedEuclideanJointSampleWaterfillAmount_sq_sum_eq_radius_sq_of_uncappedCoefficient_pos
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample)
    (huncapped : 0 < weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
      (weightedEuclideanJointSampleWaterfillCappedSet D state radius sample)) :
    (∑ k, (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2) =
      radius ^ 2 := by
  let capped := weightedEuclideanJointSampleWaterfillCappedSet D state radius sample
  let level := weightedEuclideanJointSampleWaterfillLevel D state radius sample
  have hcandidate_le := weightedEuclideanJointSampleWaterfillCandidateLevel_le_level
    D state radius sample capped
  have hcandidate_nonneg := weightedEuclideanJointSampleWaterfillCandidateLevel_nonneg
    D state radius sample capped
  have hlevel_nonneg := weightedEuclideanJointSampleWaterfillLevel_nonneg D state radius sample
  have hcandidate_sq_le :
      (weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample capped) ^ 2 ≤
        level ^ 2 :=
    (sq_le_sq₀ hcandidate_nonneg hlevel_nonneg).mpr (by simpa [level] using hcandidate_le)
  have hcandidate_sq := weightedEuclideanJointSampleWaterfillCandidateLevel_sq
    D state radius sample capped
  have hresidual_le : radius ^ 2 -
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample capped ≤
      (weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample capped) ^ 2 *
        weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample capped := by
    rw [hcandidate_sq, div_mul_cancel₀ _ (ne_of_gt huncapped)]
    exact le_max_right _ _
  have hbudget_lower : radius ^ 2 ≤
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample capped +
        level ^ 2 * weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample capped := by
    have hmult :
        (weightedEuclideanJointSampleWaterfillCandidateLevel D state radius sample capped) ^ 2 *
          weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample capped ≤
        level ^ 2 * weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample capped :=
      mul_le_mul_of_nonneg_right hcandidate_sq_le huncapped.le
    nlinarith
  have hamounts := weightedEuclideanJointSampleWaterfillAmount_sq_sum D state radius sample
  have hupper := weightedEuclideanJointSampleWaterfillAmount_sq_sum_le_radius_sq_of_valid
    D state radius sample hradius hweight hnorm
  have hupper' :
      weightedEuclideanJointSampleWaterfillSaturatedDistanceSq D state sample capped +
        level ^ 2 * weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample capped ≤
      radius ^ 2 := by
    simpa only [capped, level, ← hamounts] using hupper
  exact hamounts.trans (le_antisymm hupper' hbudget_lower)

/--
The explicit Borel raw response determined by the weighted block water-filling
amounts.  The later optimality lemma proves that this is the exact Model A
choice under a valid Definition 2 weight vector.
-/
noncomputable def weightedEuclideanJointSampleWaterfillRawResponse
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) : Coord → ℝ :=
  fun i => state i - ∑ k,
    if i ∈ D.componentBlock k then
      (weightedEuclideanJointSampleWaterfillAmount D state radius sample k /
        weightedEuclideanJointSampleBlockDistance D state sample k) *
        (state i - D.sampleIdeal sample k i)
    else 0

/-- The finite weighted block water-filling raw response is Borel. -/
theorem measurable_weightedEuclideanJointSampleWaterfillRawResponse
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) (radius : ℝ) :
    Measurable (fun z : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      weightedEuclideanJointSampleWaterfillRawResponse D z.1 radius z.2) := by
  classical
  apply measurable_pi_lambda
  intro i
  unfold weightedEuclideanJointSampleWaterfillRawResponse
  apply ((measurable_pi_apply i).comp measurable_fst).sub
  apply Finset.measurable_sum Finset.univ
  intro k _hk
  by_cases hi : i ∈ D.componentBlock k
  · simp only [hi, if_true]
    exact ((measurable_weightedEuclideanJointSampleWaterfillAmount D radius k).div
      (measurable_weightedEuclideanJointSampleBlockDistance D k)).mul
      (((measurable_pi_apply i).comp measurable_fst).sub
        ((measurable_pi_apply i).comp ((D.measurable_sampleIdeal k).comp measurable_snd)))
  · simp [hi]

/-- On one component block, the raw water-filled response has its scalar radial formula. -/
theorem weightedEuclideanJointSampleWaterfillRawResponse_apply_of_mem_block
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    {k : Component} {i : Coord} (hi : i ∈ D.componentBlock k) :
    weightedEuclideanJointSampleWaterfillRawResponse D state radius sample i =
      state i -
        (weightedEuclideanJointSampleWaterfillAmount D state radius sample k /
          weightedEuclideanJointSampleBlockDistance D state sample k) *
          (state i - D.sampleIdeal sample k i) := by
  classical
  unfold weightedEuclideanJointSampleWaterfillRawResponse
  rw [Finset.sum_eq_single k]
  · simp [hi]
  · intro l _hl hlk
    have hinot : i ∉ D.componentBlock l := by
      intro hil
      exact (Finset.disjoint_left.mp
        (D.componentBlocks_disjoint k l (Ne.symm hlk))) hi hil
    simp [hinot]
  · simp

/-- The raw response is the state minus the finite sum of its block directions. -/
theorem weightedEuclideanJointSampleWaterfillRawResponse_eq_state_sub_sum
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) :
    weightedEuclideanJointSampleWaterfillRawResponse D state radius sample =
      fun i => state i - ∑ k,
        weightedEuclideanJointSampleWaterfillAmount D state radius sample k *
          l2BlockDistanceNormalizedGradient (D.componentBlock k) state
            (D.sampleIdeal sample k) i := by
  classical
  funext i
  unfold weightedEuclideanJointSampleWaterfillRawResponse
    l2BlockDistanceNormalizedGradient
  congr 1
  apply Finset.sum_congr rfl
  intro k _hk
  by_cases hi : i ∈ D.componentBlock k
  · simp [hi]
    unfold weightedEuclideanJointSampleBlockDistance finiteCoordinateBlockL2Distance
    ring
  · simp [hi]

/--
The squared Euclidean displacement of the raw response is exactly the sum of
the squared scalar water-filling amounts.
-/
theorem weightedEuclideanJointSampleWaterfillRawResponse_l2Sq_distance
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) :
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (fun i => weightedEuclideanJointSampleWaterfillRawResponse D state radius sample i -
        state i) =
      ∑ k, (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 := by
  classical
  let direction : Component → Coord → ℝ := fun k =>
    l2BlockDistanceNormalizedGradient (D.componentBlock k) state
      (D.sampleIdeal sample k)
  have hraw := weightedEuclideanJointSampleWaterfillRawResponse_eq_state_sub_sum
    D state radius sample
  have hdiff :
      (fun i => weightedEuclideanJointSampleWaterfillRawResponse D state radius sample i -
        state i) =
      fun i => (-1 : ℝ) * ∑ k,
        weightedEuclideanJointSampleWaterfillAmount D state radius sample k * direction k i := by
    funext i
    rw [hraw]
    ring
  rw [hdiff, AppliedModelingLib.FiniteDimensionalNorms.l2Sq_smul]
  norm_num
  rw [AppliedModelingLib.FiniteDimensionalNorms.l2Sq_finset_weighted_sum_eq_of_coordinatewise_disjoint
    Finset.univ
    (fun k => weightedEuclideanJointSampleWaterfillAmount D state radius sample k)
    direction]
  · apply Finset.sum_congr rfl
    intro k _hk
    by_cases hdistance : weightedEuclideanJointSampleBlockDistance D state sample k = 0
    · have hamount : weightedEuclideanJointSampleWaterfillAmount D state radius sample k = 0 :=
        le_antisymm
          ((weightedEuclideanJointSampleWaterfillAmount_le_blockDistance
            D state radius sample k).trans_eq hdistance)
          (weightedEuclideanJointSampleWaterfillAmount_nonneg D state radius sample k)
      rw [hamount]
      ring
    · have hne : ∃ i, i ∈ D.componentBlock k ∧ state i ≠ D.sampleIdeal sample k i := by
        by_contra hnone
        push_neg at hnone
        apply hdistance
        unfold weightedEuclideanJointSampleBlockDistance
          finiteCoordinateBlockL2Distance
        have hzero : (fun i : {i : Coord // i ∈ D.componentBlock k} =>
            state i - D.sampleIdeal sample k i) = 0 := by
          funext i
          simp [hnone i i.property]
        rw [hzero]
        exact AppliedModelingLib.FiniteDimensionalNorms.normL2_zero
      have hunit : AppliedModelingLib.FiniteDimensionalNorms.l2 (direction k) = 1 :=
        l2BlockDistanceNormalizedGradient_l2_eq_one
          (D.componentBlock k) state (D.sampleIdeal sample k) hne
      have hunit_sq : AppliedModelingLib.FiniteDimensionalNorms.l2Sq (direction k) = 1 := by
        calc
          AppliedModelingLib.FiniteDimensionalNorms.l2Sq (direction k) =
              AppliedModelingLib.FiniteDimensionalNorms.l2 (direction k) ^ 2 :=
            (AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq _).symm
          _ = 1 := by rw [hunit]; norm_num
      rw [hunit_sq, mul_one]
  · intro i k l _hk _hl hkl
    exact l2BlockDistanceNormalizedGradients_coordinatewise_disjoint
      Finset.univ D.componentBlock state (D.sampleIdeal sample)
      (fun k l _ _ hne => D.componentBlocks_disjoint k l hne)
      i k l (by simp) (by simp) hkl

/-- The Borel water-filled raw response lies in the exact raw `L2` query ball. -/
theorem weightedEuclideanJointSampleWaterfillRawResponse_l2_distance_le_of_valid
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    finiteCoordinateDistance SourceNorm.l2
      (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample) state ≤ radius := by
  have hsum := weightedEuclideanJointSampleWaterfillAmount_sq_sum_le_radius_sq_of_valid
    D state radius sample hradius hweight hnorm
  have hsq :
      (finiteCoordinateDistance SourceNorm.l2
        (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample) state) ^ 2 =
        ∑ k, (weightedEuclideanJointSampleWaterfillAmount D state radius sample k) ^ 2 := by
    rw [finiteCoordinateDistance_l2,
      AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq]
    exact weightedEuclideanJointSampleWaterfillRawResponse_l2Sq_distance
      D state radius sample
  have hnonneg := finiteCoordinateDistance_l2_nonneg
    (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample) state
  nlinarith [sq_nonneg
    (finiteCoordinateDistance SourceNorm.l2
      (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample) state - radius)]

/--
Disjoint component blocks form a finite Euclidean partition: the sum of their
squared restricted distances is the squared full-coordinate distance.
-/
theorem weightedEuclideanJointSampleBlockDistance_sq_sum_eq_l2Sq
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (x y : Coord → ℝ) :
    (∑ k, (finiteCoordinateBlockL2Distance (D.componentBlock k) x y) ^ 2) =
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq (fun i => x i - y i) := by
  classical
  let mask : Component → Coord → ℝ := fun k i =>
    if i ∈ D.componentBlock k then x i - y i else 0
  have hsum : (fun i => ∑ k, mask k i) = fun i => x i - y i := by
    funext i
    rcases D.componentBlocks_cover i with ⟨k, hik⟩
    rw [Finset.sum_eq_single k]
    · simp [mask, hik]
    · intro l _hl hlk
      have hil : i ∉ D.componentBlock l := by
        intro hil
        exact (Finset.disjoint_left.mp
          (D.componentBlocks_disjoint k l (Ne.symm hlk))) hik hil
      simp [mask, hil]
    · simp
  have hmask_sq : ∀ k,
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq (mask k) =
        (finiteCoordinateBlockL2Distance (D.componentBlock k) x y) ^ 2 := by
    intro k
    unfold mask AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    calc
      (∑ i : Coord, (if i ∈ D.componentBlock k then x i - y i else 0) ^ 2) =
          ∑ i ∈ D.componentBlock k, (x i - y i) ^ 2 := by
            calc
              (∑ i : Coord, (if i ∈ D.componentBlock k then x i - y i else 0) ^ 2) =
                  ∑ i : Coord, if i ∈ D.componentBlock k then (x i - y i) ^ 2 else 0 := by
                    apply Finset.sum_congr rfl
                    intro i _hi
                    by_cases hik : i ∈ D.componentBlock k <;> simp [hik]
              _ = ∑ i ∈ (Finset.univ : Finset Coord) with i ∈ D.componentBlock k,
                  (x i - y i) ^ 2 :=
                (Finset.sum_filter _ _).symm
              _ = ∑ i ∈ D.componentBlock k, (x i - y i) ^ 2 := by simp
      _ = ∑ i : {i : Coord // i ∈ D.componentBlock k}, (x i - y i) ^ 2 :=
        Finset.sum_subtype (D.componentBlock k) (by simp) _
      _ = (finiteCoordinateBlockL2Distance (D.componentBlock k) x y) ^ 2 := by
        unfold finiteCoordinateBlockL2Distance
        exact (AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq _).symm
  calc
    (∑ k, (finiteCoordinateBlockL2Distance (D.componentBlock k) x y) ^ 2) =
        ∑ k, AppliedModelingLib.FiniteDimensionalNorms.l2Sq (mask k) := by
          apply Finset.sum_congr rfl
          intro k _hk
          exact (hmask_sq k).symm
    _ = ∑ k, (1 : ℝ) ^ 2 * AppliedModelingLib.FiniteDimensionalNorms.l2Sq (mask k) := by
      simp
    _ = AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (fun i => ∑ k, (1 : ℝ) * mask k i) := by
      symm
      apply AppliedModelingLib.FiniteDimensionalNorms.l2Sq_finset_weighted_sum_eq_of_coordinatewise_disjoint
        Finset.univ (fun _ => (1 : ℝ)) mask
      intro i k l _hk _hl hkl
      by_cases hik : i ∈ D.componentBlock k
      · right
        have hil : i ∉ D.componentBlock l := by
          intro hil
          exact (Finset.disjoint_left.mp
            (D.componentBlocks_disjoint k l hkl)) hik hil
        simp [mask, hil]
      · left
        simp [mask, hik]
    _ = AppliedModelingLib.FiniteDimensionalNorms.l2Sq (fun i => x i - y i) := by
      congr 1
      funext i
      simp only [one_mul]
      exact congrFun hsum i

/-- Any point in the raw query ball has block-distance squares within its radius budget. -/
theorem weightedEuclideanJointSampleBlockDistance_sq_sum_le_radius_sq_of_rawBall
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state candidate : Coord → ℝ) (radius : ℝ)
    (hcandidate : finiteCoordinateDistance SourceNorm.l2 candidate state ≤ radius) :
    (∑ k, (finiteCoordinateBlockL2Distance (D.componentBlock k) candidate state) ^ 2) ≤
      radius ^ 2 := by
  rw [weightedEuclideanJointSampleBlockDistance_sq_sum_eq_l2Sq D candidate state]
  have hdistance_nonneg := finiteCoordinateDistance_l2_nonneg candidate state
  have hsq : AppliedModelingLib.FiniteDimensionalNorms.l2Sq (fun i => candidate i - state i) =
      (finiteCoordinateDistance SourceNorm.l2 candidate state) ^ 2 := by
    rw [finiteCoordinateDistance_l2]
    exact (AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq _).symm
  rw [hsq]
  exact (sq_le_sq₀ hdistance_nonneg (le_trans hdistance_nonneg hcandidate)).mpr hcandidate

/--
On each component block, the raw response leaves exactly the initial block
distance minus its scalar water-filling amount.
-/
theorem weightedEuclideanJointSampleBlockDistance_waterfillRawResponse_eq_sub_amount
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) (k : Component) :
    finiteCoordinateBlockL2Distance (D.componentBlock k)
      (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample)
      (D.sampleIdeal sample k) =
      weightedEuclideanJointSampleBlockDistance D state sample k -
        weightedEuclideanJointSampleWaterfillAmount D state radius sample k := by
  let distance := weightedEuclideanJointSampleBlockDistance D state sample k
  let amount := weightedEuclideanJointSampleWaterfillAmount D state radius sample k
  have hamount_le : amount ≤ distance := by
    exact weightedEuclideanJointSampleWaterfillAmount_le_blockDistance D state radius sample k
  by_cases hdistance : distance = 0
  · have hamount_zero : amount = 0 :=
      le_antisymm (by simpa [distance] using hamount_le.trans_eq hdistance)
        (weightedEuclideanJointSampleWaterfillAmount_nonneg D state radius sample k)
    have hraw_eq_state : (fun i : {i : Coord // i ∈ D.componentBlock k} =>
        weightedEuclideanJointSampleWaterfillRawResponse D state radius sample i -
          D.sampleIdeal sample k i) =
        fun i : {i : Coord // i ∈ D.componentBlock k} =>
          state i - D.sampleIdeal sample k i := by
      funext i
      rw [weightedEuclideanJointSampleWaterfillRawResponse_apply_of_mem_block
        D state radius sample i.property]
      change state i - (amount / distance) * (state i - D.sampleIdeal sample k i) -
        D.sampleIdeal sample k i = state i - D.sampleIdeal sample k i
      rw [hamount_zero]
      ring
    unfold finiteCoordinateBlockL2Distance
    change AppliedModelingLib.FiniteDimensionalNorms.l2 _ = distance - amount
    rw [hraw_eq_state]
    change distance = distance - amount
    rw [hamount_zero]
    ring
  · have hdistance_pos : 0 < distance :=
      lt_of_le_of_ne
        (by
          unfold distance weightedEuclideanJointSampleBlockDistance
            finiteCoordinateBlockL2Distance
          exact AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _) (Ne.symm hdistance)
    have hscale_nonneg : 0 ≤ (distance - amount) / distance :=
      div_nonneg (sub_nonneg.mpr hamount_le) hdistance_pos.le
    have hraw_eq_scaled : (fun i : {i : Coord // i ∈ D.componentBlock k} =>
        weightedEuclideanJointSampleWaterfillRawResponse D state radius sample i -
          D.sampleIdeal sample k i) =
        fun i : {i : Coord // i ∈ D.componentBlock k} => ((distance - amount) / distance) *
          (state i - D.sampleIdeal sample k i) := by
      funext i
      rw [weightedEuclideanJointSampleWaterfillRawResponse_apply_of_mem_block
        D state radius sample i.property]
      change state i - (amount / distance) * (state i - D.sampleIdeal sample k i) -
        D.sampleIdeal sample k i =
        ((distance - amount) / distance) * (state i - D.sampleIdeal sample k i)
      field_simp
      ring
    unfold finiteCoordinateBlockL2Distance
    change AppliedModelingLib.FiniteDimensionalNorms.l2 _ = distance - amount
    rw [hraw_eq_scaled, AppliedModelingLib.FiniteDimensionalNorms.normL2_smul,
      abs_of_nonneg hscale_nonneg]
    change ((distance - amount) / distance) * distance = distance - amount
    field_simp

/--
On the radius-exhausting branch, the capped water-filling amounts maximize
weighted block-distance reduction among all raw-ball displacements.
-/
theorem weightedEuclideanJointSampleWaterfill_gain_le_amount_gain_of_uncappedCoefficient_pos
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state candidate : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample)
    (hcandidate : finiteCoordinateDistance SourceNorm.l2 candidate state ≤ radius)
    (huncapped : 0 < weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
      (weightedEuclideanJointSampleWaterfillCappedSet D state radius sample)) :
    (∑ k,
      weightedEuclideanJointSamplePositiveCoefficient D sample k *
        min (finiteCoordinateBlockL2Distance (D.componentBlock k) candidate state)
          (weightedEuclideanJointSampleBlockDistance D state sample k)) ≤
      ∑ k,
        weightedEuclideanJointSamplePositiveCoefficient D sample k *
          weightedEuclideanJointSampleWaterfillAmount D state radius sample k := by
  let level := weightedEuclideanJointSampleWaterfillLevel D state radius sample
  let amount : Component → ℝ := fun k =>
    weightedEuclideanJointSampleWaterfillAmount D state radius sample k
  let distance : Component → ℝ := fun k =>
    weightedEuclideanJointSampleBlockDistance D state sample k
  let displacement : Component → ℝ := fun k =>
    finiteCoordinateBlockL2Distance (D.componentBlock k) candidate state
  let gain : Component → ℝ := fun k => min (displacement k) (distance k)
  let coefficient : Component → ℝ := fun k =>
    weightedEuclideanJointSamplePositiveCoefficient D sample k
  have hlevel_pos : 0 < level :=
    lt_of_lt_of_le hradius
      (weightedEuclideanJointSampleWaterfillLevel_ge_radius_of_valid
        D state radius sample hradius.le hweight hnorm)
  have hamount_sq : (∑ k, (amount k) ^ 2) = radius ^ 2 := by
    simpa [amount] using
      (weightedEuclideanJointSampleWaterfillAmount_sq_sum_eq_radius_sq_of_uncappedCoefficient_pos
        D state radius sample hradius hweight hnorm huncapped)
  have hdisplacement_sq : (∑ k, (displacement k) ^ 2) ≤ radius ^ 2 := by
    simpa [displacement] using
      (weightedEuclideanJointSampleBlockDistance_sq_sum_le_radius_sq_of_rawBall
        D state candidate radius hcandidate)
  have hgain_sq : (∑ k, (gain k) ^ 2) ≤ radius ^ 2 := by
    calc
      (∑ k, (gain k) ^ 2) ≤ ∑ k, (displacement k) ^ 2 := by
        apply Finset.sum_le_sum
        intro k _hk
        have hgain_nonneg : 0 ≤ gain k := le_min
          (by
            unfold displacement finiteCoordinateBlockL2Distance
            exact AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _)
          (by
            unfold distance weightedEuclideanJointSampleBlockDistance
              finiteCoordinateBlockL2Distance
            exact AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _)
        have hdisp_nonneg : 0 ≤ displacement k := by
          unfold displacement finiteCoordinateBlockL2Distance
          exact AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _
        exact (sq_le_sq₀ hgain_nonneg hdisp_nonneg).mpr (min_le_left _ _)
      _ ≤ radius ^ 2 := hdisplacement_sq
  have hdot_le : (∑ k, amount k * gain k) ≤ radius ^ 2 := by
    calc
      (∑ k, amount k * gain k) ≤
          Real.sqrt (∑ k, (amount k) ^ 2) *
            Real.sqrt (∑ k, (gain k) ^ 2) :=
        Real.sum_mul_le_sqrt_mul_sqrt (Finset.univ : Finset Component) amount gain
      _ = radius * Real.sqrt (∑ k, (gain k) ^ 2) := by
        rw [hamount_sq, Real.sqrt_sq_eq_abs, abs_of_pos hradius]
      _ ≤ radius * radius := by
        apply mul_le_mul_of_nonneg_left
        · calc
            Real.sqrt (∑ k, gain k ^ 2) ≤ Real.sqrt (radius ^ 2) :=
              Real.sqrt_le_sqrt hgain_sq
            _ = radius := by rw [Real.sqrt_sq_eq_abs, abs_of_pos hradius]
        · exact hradius.le
      _ = radius ^ 2 := by ring
  have hright_nonpos :
      (∑ k, amount k * (gain k - amount k)) ≤ 0 := by
    calc
      (∑ k, amount k * (gain k - amount k)) =
          (∑ k, amount k * gain k) - ∑ k, (amount k) ^ 2 := by
            calc
              (∑ k, amount k * (gain k - amount k)) =
                  ∑ k, (amount k * gain k - (amount k) ^ 2) := by
                    apply Finset.sum_congr rfl
                    intro k _hk
                    ring
              _ = (∑ k, amount k * gain k) - ∑ k, (amount k) ^ 2 :=
                Finset.sum_sub_distrib _ _
      _ ≤ 0 := by rw [hamount_sq]; linarith
  have hterm : ∀ k,
      level * (coefficient k * (gain k - amount k)) ≤
        amount k * (gain k - amount k) := by
    intro k
    by_cases hk : k ∈ weightedEuclideanJointSampleWaterfillCappedSet D state radius sample
    · have hamount_eq : amount k = distance k := by
        exact weightedEuclideanJointSampleWaterfillAmount_eq_blockDistance_of_mem_cappedSet
          D state radius sample hk
      have hcap : distance k ≤ level * coefficient k := by
        simpa [distance, level, coefficient] using
          (mem_weightedEuclideanJointSampleWaterfillCappedSet_iff D state radius sample k).mp hk
      have hgain_le : gain k ≤ amount k := by
        rw [hamount_eq]
        exact min_le_right _ _
      calc
        level * (coefficient k * (gain k - amount k)) =
            (level * coefficient k) * (gain k - amount k) := by ring
        _ ≤ amount k * (gain k - amount k) :=
          mul_le_mul_of_nonpos_right (by simpa [hamount_eq] using hcap)
            (sub_nonpos.mpr hgain_le)
    · rw [show amount k = level * coefficient k by
      exact weightedEuclideanJointSampleWaterfillAmount_eq_level_mul_coefficient_of_not_mem_cappedSet
        D state radius sample hk]
      rw [mul_assoc]
  have hsum_term :
      level * (∑ k, coefficient k * (gain k - amount k)) ≤
        ∑ k, amount k * (gain k - amount k) := by
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun k _hk => hterm k
  have hgain_difference : (∑ k, coefficient k * (gain k - amount k)) ≤ 0 := by
    nlinarith [hsum_term, hright_nonpos]
  change (∑ k, coefficient k * gain k) ≤ ∑ k, coefficient k * amount k
  calc
    (∑ k, coefficient k * gain k) =
        (∑ k, coefficient k * (gain k - amount k)) +
          ∑ k, coefficient k * amount k := by
            calc
              (∑ k, coefficient k * gain k) =
                  ∑ k, (coefficient k * (gain k - amount k) + coefficient k * amount k) := by
                    apply Finset.sum_congr rfl
                    intro k _hk
                    ring
              _ = (∑ k, coefficient k * (gain k - amount k)) +
                  ∑ k, coefficient k * amount k :=
                Finset.sum_add_distrib
    _ ≤ ∑ k, coefficient k * amount k := by linarith

/-- Triangle inequality on one finite component block. -/
theorem finiteCoordinateBlockL2Distance_le_add_candidate_distance
    {Coord : Type*} [Fintype Coord]
    (block : Finset Coord) (state candidate ideal : Coord → ℝ) :
    finiteCoordinateBlockL2Distance block state ideal ≤
      finiteCoordinateBlockL2Distance block candidate state +
        finiteCoordinateBlockL2Distance block candidate ideal := by
  unfold finiteCoordinateBlockL2Distance
  have htriangle := AppliedModelingLib.FiniteDimensionalNorms.normL2_add_le
    (fun i : {i : Coord // i ∈ block} => state i - candidate i)
    (fun i : {i : Coord // i ∈ block} => candidate i - ideal i)
  calc
    AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i : {i : Coord // i ∈ block} =>
        state i - ideal i) =
        AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i : {i : Coord // i ∈ block} =>
          (state i - candidate i) + (candidate i - ideal i)) := by
            congr 1
            funext i
            ring
    _ ≤ AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i : {i : Coord // i ∈ block} =>
        state i - candidate i) +
        AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i : {i : Coord // i ∈ block} =>
          candidate i - ideal i) := htriangle
    _ = finiteCoordinateBlockL2Distance block candidate state +
        finiteCoordinateBlockL2Distance block candidate ideal := by
          congr 1
          · exact AppliedModelingLib.FiniteDimensionalNorms.normL2_sub_rev _ _

/--
Moving a component block by a distance `t` can reduce its ideal-distance by
at most `min(t, d)`, where `d` is the current ideal-distance.
-/
theorem finiteCoordinateBlockL2Distance_sub_min_candidate_distance_le
    {Coord : Type*} [Fintype Coord]
    (block : Finset Coord) (state candidate ideal : Coord → ℝ) :
    finiteCoordinateBlockL2Distance block state ideal -
      min (finiteCoordinateBlockL2Distance block candidate state)
        (finiteCoordinateBlockL2Distance block state ideal) ≤
      finiteCoordinateBlockL2Distance block candidate ideal := by
  by_cases hmove : finiteCoordinateBlockL2Distance block candidate state ≤
      finiteCoordinateBlockL2Distance block state ideal
  · rw [min_eq_left hmove]
    linarith [finiteCoordinateBlockL2Distance_le_add_candidate_distance
      block state candidate ideal]
  · rw [min_eq_right (le_of_not_ge hmove)]
    ring_nf
    exact AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg
      (fun i : {i : Coord // i ∈ block} => candidate i - ideal i)

/-- A candidate's sampled cost is bounded below by its componentwise attainable reductions. -/
theorem weightedEuclideanJointSampleCost_candidate_lower_bound
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state candidate : Coord → ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    (∑ k,
      weightedEuclideanJointSamplePositiveCoefficient D sample k *
        (weightedEuclideanJointSampleBlockDistance D state sample k -
          min (finiteCoordinateBlockL2Distance (D.componentBlock k) candidate state)
            (weightedEuclideanJointSampleBlockDistance D state sample k))) ≤
      weightedEuclideanJointSampleCost D sample candidate := by
  have hcoefficient : ∀ k,
      D.sampleWeight sample k / D.sampleWeightNorm2 sample =
        weightedEuclideanJointSamplePositiveCoefficient D sample k := by
    intro k
    symm
    apply weightedEuclideanJointSamplePositiveCoefficient_eq_normalizedWeight
    exact div_nonneg (hweight k) hnorm.le
  unfold weightedEuclideanJointSampleCost
  rw [show (∑ k,
      (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
        finiteCoordinateBlockL2Distance (D.componentBlock k) candidate
          (D.sampleIdeal sample k)) =
      ∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
        finiteCoordinateBlockL2Distance (D.componentBlock k) candidate
          (D.sampleIdeal sample k) by
    apply Finset.sum_congr rfl
    intro k _hk
    rw [hcoefficient k]]
  apply Finset.sum_le_sum
  intro k _hk
  apply mul_le_mul_of_nonneg_left
  · exact finiteCoordinateBlockL2Distance_sub_min_candidate_distance_le
      (D.componentBlock k) state candidate (D.sampleIdeal sample k)
  · exact weightedEuclideanJointSamplePositiveCoefficient_nonneg D sample k

/-- The raw water-filled cost is the original weighted cost minus its scalar amounts. -/
theorem weightedEuclideanJointSampleWaterfillRawResponse_cost_eq_sum_sub_amount
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    weightedEuclideanJointSampleCost D sample
      (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample) =
      ∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
        (weightedEuclideanJointSampleBlockDistance D state sample k -
          weightedEuclideanJointSampleWaterfillAmount D state radius sample k) := by
  have hcoefficient : ∀ k,
      D.sampleWeight sample k / D.sampleWeightNorm2 sample =
        weightedEuclideanJointSamplePositiveCoefficient D sample k := by
    intro k
    symm
    apply weightedEuclideanJointSamplePositiveCoefficient_eq_normalizedWeight
    exact div_nonneg (hweight k) hnorm.le
  unfold weightedEuclideanJointSampleCost
  apply Finset.sum_congr rfl
  intro k _hk
  rw [hcoefficient k,
    weightedEuclideanJointSampleBlockDistance_waterfillRawResponse_eq_sub_amount
      D state radius sample k]

/-- Exact Model A cost minimization for one joint Definition 2 sample and raw `L2` query ball. -/
def WeightedEuclideanJointSampleModelARawResponseAt
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) (response : Coord → ℝ) : Prop :=
  finiteCoordinateDistance SourceNorm.l2 response state ≤ radius ∧
    ∀ candidate, finiteCoordinateDistance SourceNorm.l2 candidate state ≤ radius →
      weightedEuclideanJointSampleCost D sample response ≤
        weightedEuclideanJointSampleCost D sample candidate

/-- In the radius-exhausting case, the Borel water-filled raw response is exact Model A. -/
theorem weightedEuclideanJointSampleWaterfillRawResponse_is_modelAResponse_of_uncappedCoefficient_pos
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample)
    (huncapped : 0 < weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
      (weightedEuclideanJointSampleWaterfillCappedSet D state radius sample)) :
    WeightedEuclideanJointSampleModelARawResponseAt D state radius sample
      (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample) := by
  refine ⟨weightedEuclideanJointSampleWaterfillRawResponse_l2_distance_le_of_valid
    D state radius sample hradius hweight hnorm, ?_⟩
  intro candidate hcandidate
  have hgain := weightedEuclideanJointSampleWaterfill_gain_le_amount_gain_of_uncappedCoefficient_pos
    D state candidate radius sample hradius hweight hnorm hcandidate huncapped
  have hlower := weightedEuclideanJointSampleCost_candidate_lower_bound
    D state candidate sample hweight hnorm
  rw [weightedEuclideanJointSampleWaterfillRawResponse_cost_eq_sum_sub_amount
    D state radius sample hweight hnorm]
  calc
    (∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
        (weightedEuclideanJointSampleBlockDistance D state sample k -
          weightedEuclideanJointSampleWaterfillAmount D state radius sample k)) ≤
      ∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
        (weightedEuclideanJointSampleBlockDistance D state sample k -
          min (finiteCoordinateBlockL2Distance (D.componentBlock k) candidate state)
            (weightedEuclideanJointSampleBlockDistance D state sample k)) := by
          have hrewrite :
              (∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
                (weightedEuclideanJointSampleBlockDistance D state sample k -
                  weightedEuclideanJointSampleWaterfillAmount D state radius sample k)) =
              (∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
                weightedEuclideanJointSampleBlockDistance D state sample k) -
                ∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
                weightedEuclideanJointSampleWaterfillAmount D state radius sample k := by
                calc
                  (∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
                    (weightedEuclideanJointSampleBlockDistance D state sample k -
                      weightedEuclideanJointSampleWaterfillAmount D state radius sample k)) =
                      ∑ k, (weightedEuclideanJointSamplePositiveCoefficient D sample k *
                        weightedEuclideanJointSampleBlockDistance D state sample k -
                        weightedEuclideanJointSamplePositiveCoefficient D sample k *
                          weightedEuclideanJointSampleWaterfillAmount D state radius sample k) := by
                            apply Finset.sum_congr rfl
                            intro k _hk
                            ring
                  _ = _ := Finset.sum_sub_distrib _ _
          have hrewrite' :
              (∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
                (weightedEuclideanJointSampleBlockDistance D state sample k -
                  min (finiteCoordinateBlockL2Distance (D.componentBlock k) candidate state)
                    (weightedEuclideanJointSampleBlockDistance D state sample k))) =
              (∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
                weightedEuclideanJointSampleBlockDistance D state sample k) -
                ∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
                  min (finiteCoordinateBlockL2Distance (D.componentBlock k) candidate state)
                    (weightedEuclideanJointSampleBlockDistance D state sample k) := by
                calc
                  (∑ k, weightedEuclideanJointSamplePositiveCoefficient D sample k *
                    (weightedEuclideanJointSampleBlockDistance D state sample k -
                      min (finiteCoordinateBlockL2Distance (D.componentBlock k) candidate state)
                        (weightedEuclideanJointSampleBlockDistance D state sample k))) =
                      ∑ k, (weightedEuclideanJointSamplePositiveCoefficient D sample k *
                        weightedEuclideanJointSampleBlockDistance D state sample k -
                        weightedEuclideanJointSamplePositiveCoefficient D sample k *
                          min (finiteCoordinateBlockL2Distance (D.componentBlock k) candidate state)
                            (weightedEuclideanJointSampleBlockDistance D state sample k)) := by
                            apply Finset.sum_congr rfl
                            intro k _hk
                            ring
                  _ = _ := Finset.sum_sub_distrib _ _
          rw [hrewrite, hrewrite']
          linarith
    _ ≤ weightedEuclideanJointSampleCost D sample candidate := hlower

/-- A cap-active block of the raw response is exactly at its component ideal. -/
theorem weightedEuclideanJointSampleWaterfillRawResponse_apply_eq_ideal_of_mem_cappedSet
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    {k : Component} {i : Coord}
    (hk : k ∈ weightedEuclideanJointSampleWaterfillCappedSet D state radius sample)
    (hi : i ∈ D.componentBlock k) :
    weightedEuclideanJointSampleWaterfillRawResponse D state radius sample i =
      D.sampleIdeal sample k i := by
  rw [weightedEuclideanJointSampleWaterfillRawResponse_apply_of_mem_block D state radius sample hi,
    weightedEuclideanJointSampleWaterfillAmount_eq_blockDistance_of_mem_cappedSet
      D state radius sample hk]
  let distance := weightedEuclideanJointSampleBlockDistance D state sample k
  change state i - (distance / distance) * (state i - D.sampleIdeal sample k i) =
    D.sampleIdeal sample k i
  by_cases hdistance : distance = 0
  · have hbound := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
      (fun j : {j : Coord // j ∈ D.componentBlock k} =>
        state j - D.sampleIdeal sample k j) ⟨i, hi⟩
    change |state i - D.sampleIdeal sample k i| ≤ distance at hbound
    rw [hdistance] at hbound
    have hzero : state i - D.sampleIdeal sample k i = 0 := by
      apply abs_eq_zero.mp
      exact le_antisymm hbound (abs_nonneg _)
    rw [hdistance, hzero]
    linarith
  · rw [div_self hdistance]
    ring

/-- If no positive coefficient remains uncapped, every positive component is cap-active. -/
theorem weightedEuclideanJointSamplePositiveCoefficient_pos_mem_cappedSet_of_uncappedCoefficientSq_eq_zero
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (huncapped : weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
      (weightedEuclideanJointSampleWaterfillCappedSet D state radius sample) = 0)
    {k : Component}
    (hk : 0 < weightedEuclideanJointSamplePositiveCoefficient D sample k) :
    k ∈ weightedEuclideanJointSampleWaterfillCappedSet D state radius sample := by
  by_contra hnotcap
  have hmem : k ∈ Finset.univ \
      weightedEuclideanJointSampleWaterfillCappedSet D state radius sample := by
    simp [hnotcap]
  have hterm_zero : (weightedEuclideanJointSamplePositiveCoefficient D sample k) ^ 2 = 0 := by
    have hterms := (Finset.sum_eq_zero_iff_of_nonneg
      (fun j _ => sq_nonneg (weightedEuclideanJointSamplePositiveCoefficient D sample j))).mp
      huncapped
    exact hterms k hmem
  nlinarith

/-- The raw response has zero component distance on every cap-active block. -/
theorem weightedEuclideanJointSampleBlockDistance_waterfillRawResponse_eq_zero_of_mem_cappedSet
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    {k : Component}
    (hk : k ∈ weightedEuclideanJointSampleWaterfillCappedSet D state radius sample) :
    finiteCoordinateBlockL2Distance (D.componentBlock k)
      (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample)
      (D.sampleIdeal sample k) = 0 := by
  unfold finiteCoordinateBlockL2Distance
  have hzero : (fun i : {i : Coord // i ∈ D.componentBlock k} =>
      weightedEuclideanJointSampleWaterfillRawResponse D state radius sample i -
        D.sampleIdeal sample k i) = 0 := by
    funext i
    rw [weightedEuclideanJointSampleWaterfillRawResponse_apply_eq_ideal_of_mem_cappedSet
      D state radius sample hk i.property]
    simp
  rw [hzero]
  exact AppliedModelingLib.FiniteDimensionalNorms.normL2_zero

/-- A valid nonnegative Definition 2 sampled cost is nonnegative. -/
theorem weightedEuclideanJointSampleCost_nonneg_of_valid
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    0 ≤ weightedEuclideanJointSampleCost D sample state := by
  unfold weightedEuclideanJointSampleCost
  apply Finset.sum_nonneg
  intro k _hk
  exact mul_nonneg (div_nonneg (hweight k) hnorm.le)
    (by
      unfold finiteCoordinateBlockL2Distance
      exact AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _)

/--
If every positive coefficient is capped, the explicit raw response has the
globally minimal (zero) sampled cost.
-/
theorem weightedEuclideanJointSampleWaterfillRawResponse_cost_eq_zero_of_uncappedCoefficientSq_eq_zero
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample)
    (huncapped : weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
      (weightedEuclideanJointSampleWaterfillCappedSet D state radius sample) = 0) :
    weightedEuclideanJointSampleCost D sample
      (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample) = 0 := by
  have hcoefficient : ∀ k,
      D.sampleWeight sample k / D.sampleWeightNorm2 sample =
        weightedEuclideanJointSamplePositiveCoefficient D sample k := by
    intro k
    symm
    apply weightedEuclideanJointSamplePositiveCoefficient_eq_normalizedWeight
    exact div_nonneg (hweight k) hnorm.le
  unfold weightedEuclideanJointSampleCost
  apply Finset.sum_eq_zero
  intro k _hk
  rw [hcoefficient k]
  by_cases hk : k ∈ weightedEuclideanJointSampleWaterfillCappedSet D state radius sample
  · rw [weightedEuclideanJointSampleBlockDistance_waterfillRawResponse_eq_zero_of_mem_cappedSet
      D state radius sample hk]
    ring
  · have hnotpos : ¬ 0 < weightedEuclideanJointSamplePositiveCoefficient D sample k := by
      intro hpos
      exact hk
        (weightedEuclideanJointSamplePositiveCoefficient_pos_mem_cappedSet_of_uncappedCoefficientSq_eq_zero
          D state radius sample huncapped hpos)
    have hcoefficient_zero : weightedEuclideanJointSamplePositiveCoefficient D sample k = 0 :=
      le_antisymm (le_of_not_gt hnotpos)
        (weightedEuclideanJointSamplePositiveCoefficient_nonneg D sample k)
    rw [hcoefficient_zero]
    ring

/-- In the all-capped case, the water-filled raw response is an exact Model A favorite point. -/
theorem weightedEuclideanJointSampleWaterfillRawResponse_is_modelAResponse_of_uncappedCoefficientSq_eq_zero
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample)
    (huncapped : weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
      (weightedEuclideanJointSampleWaterfillCappedSet D state radius sample) = 0) :
    WeightedEuclideanJointSampleModelARawResponseAt D state radius sample
      (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample) := by
  refine ⟨weightedEuclideanJointSampleWaterfillRawResponse_l2_distance_le_of_valid
    D state radius sample hradius hweight hnorm, ?_⟩
  intro candidate _hcandidate
  rw [weightedEuclideanJointSampleWaterfillRawResponse_cost_eq_zero_of_uncappedCoefficientSq_eq_zero
    D state radius sample hweight hnorm huncapped]
  exact weightedEuclideanJointSampleCost_nonneg_of_valid D candidate sample hweight hnorm

/--
The Borel weighted block water-filling formula is an exact Definition 2 Model
A response for every positive-radius valid joint sample.
-/
theorem weightedEuclideanJointSampleWaterfillRawResponse_is_modelAResponse_of_valid
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hradius : 0 < radius)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hnorm : 0 < D.sampleWeightNorm2 sample) :
    WeightedEuclideanJointSampleModelARawResponseAt D state radius sample
      (weightedEuclideanJointSampleWaterfillRawResponse D state radius sample) := by
  let uncapped := weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq D sample
    (weightedEuclideanJointSampleWaterfillCappedSet D state radius sample)
  have huncapped_nonneg : 0 ≤ uncapped := by
    exact weightedEuclideanJointSampleWaterfillUnsaturatedCoefficientSq_nonneg D sample _
  by_cases hpos : 0 < uncapped
  · exact weightedEuclideanJointSampleWaterfillRawResponse_is_modelAResponse_of_uncappedCoefficient_pos
      D state radius sample hradius hweight hnorm (by simpa [uncapped] using hpos)
  · have hzero : uncapped = 0 := le_antisymm (le_of_not_gt hpos) huncapped_nonneg
    exact weightedEuclideanJointSampleWaterfillRawResponse_is_modelAResponse_of_uncappedCoefficientSq_eq_zero
      D state radius sample hradius hweight hnorm (by simpa [uncapped] using hzero)

/-- The displayed normalized weighted block direction of one joint voter. -/
noncomputable def weightedEuclideanJointSampleDirection
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (sample : (Component → ℝ) × (Coord → ℝ)) :
    Coord → ℝ :=
  weightedEuclideanL2BlockSampleDirection Finset.univ D.componentBlock
    D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal state sample

/--
The exceptional event in Appendix C.5's weighted-Euclidean Model A argument:
at least one component block can reach its ideal within the current query
radius.  This is deliberately stronger than the full-vector ball event: a
single block can cross its ideal even when the complete ideal lies outside the
query ball.
-/
def weightedEuclideanJointSampleBlockBadEvent
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ) :
    Set ((Component → ℝ) × (Coord → ℝ)) :=
  {sample | ∃ k,
    finiteCoordinateBlockL2Distance (D.componentBlock k) state
      (D.sampleIdeal sample k) < radius}

/-- The weighted Model A block-crossing event is Borel measurable. -/
theorem measurableSet_weightedEuclideanJointSampleBlockBadEvent
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ) :
    MeasurableSet (weightedEuclideanJointSampleBlockBadEvent D state radius) := by
  change MeasurableSet {sample | ∃ k,
    finiteCoordinateBlockL2Distance (D.componentBlock k) state
      (D.sampleIdeal sample k) < radius}
  rw [show {sample | ∃ k,
      finiteCoordinateBlockL2Distance (D.componentBlock k) state
        (D.sampleIdeal sample k) < radius} =
      ⋃ k : Component, {sample |
        finiteCoordinateBlockL2Distance (D.componentBlock k) state
          (D.sampleIdeal sample k) < radius} by
    ext sample
    simp]
  apply MeasurableSet.iUnion
  intro k
  exact measurableSet_lt
    ((measurable_finiteCoordinateBlockL2Distance (D.componentBlock k)).comp
      (measurable_const.prodMk (D.measurable_sampleIdeal k)))
    measurable_const

/--
The weighted Appendix-C.5 block-crossing event is Borel jointly in the
predictable state and the fresh joint weight--ideal sample.
-/
theorem measurableSet_weightedEuclideanJointSampleBlockBadEvent_state_sample
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (radius : ℝ) :
    MeasurableSet {z : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) |
      z.2 ∈ weightedEuclideanJointSampleBlockBadEvent D z.1 radius} := by
  change MeasurableSet {z : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) |
    ∃ k, weightedEuclideanJointSampleBlockDistance D z.1 z.2 k < radius}
  rw [show {z : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) |
      ∃ k, weightedEuclideanJointSampleBlockDistance D z.1 z.2 k < radius} =
      ⋃ k : Component, {z |
        weightedEuclideanJointSampleBlockDistance D z.1 z.2 k < radius} by
    ext z
    simp]
  apply MeasurableSet.iUnion
  intro k
  exact measurableSet_lt
    (measurable_weightedEuclideanJointSampleBlockDistance D k)
    measurable_const

/--
Every weighted Model A block crossing forces one ordinary ideal coordinate
into the C3 slab envelope.  Thus the existing finite-dimensional density bound
controls the exact exceptional event used in Appendix C.5.
-/
theorem weightedEuclideanJointSampleBlockBadEvent_subset_idealSlab
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ) :
    weightedEuclideanJointSampleBlockBadEvent D state radius ⊆
      Prod.snd ⁻¹' l1LinfSlabBadEvent state radius := by
  intro sample hbad
  rcases hbad with ⟨k, hk⟩
  rcases D.componentBlocks_nonempty k with ⟨i, hi⟩
  refine ⟨i, ?_⟩
  exact (AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
    (fun j : {j : Coord // j ∈ D.componentBlock k} =>
      state j - D.sampleIdeal sample k j) ⟨i, hi⟩).trans_lt hk

/-- The complement of the block-crossing event is the componentwise no-crossing condition. -/
def weightedEuclideanJointSampleBlockGood
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) : Prop :=
  ∀ k, radius ≤ finiteCoordinateBlockL2Distance (D.componentBlock k) state
    (D.sampleIdeal sample k)

theorem notMem_weightedEuclideanJointSampleBlockBadEvent_iff
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) :
    sample ∉ weightedEuclideanJointSampleBlockBadEvent D state radius ↔
      weightedEuclideanJointSampleBlockGood D state radius sample := by
  constructor
  · intro hnot k
    exact le_of_not_gt fun hlt => hnot ⟨k, hlt⟩
  · intro hgood hbad
    rcases hbad with ⟨k, hk⟩
    exact (not_lt_of_ge (hgood k)) hk

/-- On the no-crossing event, every component block has a nonzero distance direction. -/
theorem weightedEuclideanJointSampleBlock_nonzero_of_good
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hgood : weightedEuclideanJointSampleBlockGood D state radius sample)
    (k : Component) :
    ∃ i, i ∈ D.componentBlock k ∧ state i ≠ D.sampleIdeal sample k i := by
  by_contra hnonzero
  push_neg at hnonzero
  have hzero : (fun i : {i : Coord // i ∈ D.componentBlock k} =>
      state i - D.sampleIdeal sample k i) = 0 := by
    funext i
    simp [hnonzero i i.property]
  have hdistance_zero : finiteCoordinateBlockL2Distance (D.componentBlock k) state
      (D.sampleIdeal sample k) = 0 := by
    rw [finiteCoordinateBlockL2Distance, hzero]
    exact AppliedModelingLib.FiniteDimensionalNorms.normL2_zero
  linarith [hgood k]

/--
Away from the exact block-crossing event, Definition 2's normalized sampled
direction has Euclidean norm one pointwise.  This is the deterministic part of
Appendix C.6 before the C3 probability estimate is applied.
-/
theorem weightedEuclideanJointSampleDirection_l2_eq_one_of_blockGood
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweightNorm : 0 < D.sampleWeightNorm2 sample)
    (hgood : weightedEuclideanJointSampleBlockGood D state radius sample) :
    finiteCoordinateNorm SourceNorm.l2
      (weightedEuclideanJointSampleDirection D state sample) = 1 := by
  letI : Nonempty Coord := D.coordinate_nonempty
  unfold weightedEuclideanJointSampleDirection
  apply weightedEuclidean_l2_direction_norm_eq_one_of_coordinate_blocks
    Finset.univ
    (fun k => D.sampleWeight sample k / D.sampleWeightNorm2 sample)
    (fun k => l2BlockDistanceNormalizedGradient (D.componentBlock k) state
      (D.sampleIdeal sample k))
  · intro i k l _hk _hl hkl
    exact l2BlockDistanceNormalizedGradients_coordinatewise_disjoint
      Finset.univ D.componentBlock state (D.sampleIdeal sample)
      (fun k l _ _ hne => D.componentBlocks_disjoint k l hne)
      i k l (by simp) (by simp) hkl
  · intro k _hk
    rw [finiteCoordinateNorm_l2]
    exact l2BlockDistanceNormalizedGradient_l2_eq_one
      (D.componentBlock k) state (D.sampleIdeal sample k)
      (weightedEuclideanJointSampleBlock_nonzero_of_good D hradius sample hgood k)
  · have hdenom_ne_zero : D.sampleWeightNorm2 sample ≠ 0 := hweightNorm.ne'
    calc
      (∑ k ∈ Finset.univ,
          (D.sampleWeight sample k / D.sampleWeightNorm2 sample) ^ 2) =
          ∑ k ∈ Finset.univ,
            D.sampleWeight sample k ^ 2 / D.sampleWeightNorm2 sample ^ 2 := by
          apply Finset.sum_congr rfl
          intro k _hk
          field_simp
      _ = (∑ k ∈ Finset.univ, D.sampleWeight sample k ^ 2) /
            D.sampleWeightNorm2 sample ^ 2 := by
          rw [Finset.sum_div]
      _ = 1 := by
          rw [D.sampleWeightNorm2_sq, div_self (pow_ne_zero _ hdenom_ne_zero)]

/--
On the no-crossing event, the displayed weighted direction is a subgradient of
the exact one-voter Definition 2 cost.  The weights are kept joint with the
ideal throughout.
-/
theorem weightedEuclideanJointSampleDirection_subgradient_of_blockGood
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k / D.sampleWeightNorm2 sample)
    (hgood : weightedEuclideanJointSampleBlockGood D state radius sample) :
    FiniteSubgradientAt (weightedEuclideanJointSampleCost D sample) state
      (weightedEuclideanJointSampleDirection D state sample) := by
  have hsub := finiteSubgradientAt_finset_nonneg_weighted_sum
    (Finset.univ : Finset Component)
    (fun k _ => hweight k)
    (fun k _ => finiteSubgradientAt_blockL2DistanceNormalizedGradient
      (D.componentBlock k) state (D.sampleIdeal sample k)
      (weightedEuclideanJointSampleBlock_nonzero_of_good D hradius sample hgood k))
  simpa only [weightedEuclideanJointSampleCost,
    weightedEuclideanJointSampleDirection,
    weightedEuclideanL2BlockSampleDirection] using hsub

/-- On a component block, all other normalized block directions vanish. -/
theorem weightedEuclideanJointSampleDirection_apply_of_mem_block
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (sample : (Component → ℝ) × (Coord → ℝ))
    {k : Component} {i : Coord} (hi : i ∈ D.componentBlock k) :
    weightedEuclideanJointSampleDirection D state sample i =
      (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
        l2BlockDistanceNormalizedGradient (D.componentBlock k) state
          (D.sampleIdeal sample k) i := by
  classical
  unfold weightedEuclideanJointSampleDirection
    weightedEuclideanL2BlockSampleDirection
  rw [Finset.sum_eq_single k]
  · intro l _hl hlk
    have hinot : i ∉ D.componentBlock l := by
      intro hil
      exact (Finset.disjoint_left.mp
        (D.componentBlocks_disjoint k l (Ne.symm hlk))) hi hil
    simp [l2BlockDistanceNormalizedGradient, hinot]
  · simp

/--
The radial raw point used by the weighted-Euclidean Model A reduction.  Off
the block-crossing event it will be shown to be the (unique) exact favorite
point in the raw `L2` query ball.
-/
noncomputable def weightedEuclideanJointSampleRadialRawResponse
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) : Coord → ℝ :=
  fun i => state i - radius * weightedEuclideanJointSampleDirection D state sample i

/-- The radial weighted response lies in its raw `L2` query ball off the crossing event. -/
theorem weightedEuclideanJointSampleRadialRawResponse_l2_distance_le
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweightNorm : 0 < D.sampleWeightNorm2 sample)
    (hgood : weightedEuclideanJointSampleBlockGood D state radius sample) :
    finiteCoordinateDistance SourceNorm.l2
      (weightedEuclideanJointSampleRadialRawResponse D state radius sample) state ≤
        radius := by
  letI : Nonempty Coord := D.coordinate_nonempty
  have hdirection : AppliedModelingLib.FiniteDimensionalNorms.l2
      (weightedEuclideanJointSampleDirection D state sample) = 1 := by
    simpa only [finiteCoordinateNorm_l2] using
      weightedEuclideanJointSampleDirection_l2_eq_one_of_blockGood
        D hradius sample hweightNorm hgood
  have hrewrite :
      (fun i => weightedEuclideanJointSampleRadialRawResponse D state radius sample i -
        state i) =
        fun i => (-radius) * weightedEuclideanJointSampleDirection D state sample i := by
    funext i
    simp only [weightedEuclideanJointSampleRadialRawResponse]
    ring
  change AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => weightedEuclideanJointSampleRadialRawResponse D state radius sample i -
        state i) ≤ radius
  rw [hrewrite, AppliedModelingLib.FiniteDimensionalNorms.normL2_smul,
    hdirection, abs_neg, abs_of_pos hradius]
  simp

/--
On one no-crossing component block, the radial weighted response decreases the
block distance by exactly the radius times that block's normalized weight.
-/
theorem finiteCoordinateBlockL2Distance_radialWeightedResponse_eq_sub
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweightNorm : 0 < D.sampleWeightNorm2 sample)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k / D.sampleWeightNorm2 sample)
    (hgood : weightedEuclideanJointSampleBlockGood D state radius sample)
    (k : Component) :
    finiteCoordinateBlockL2Distance (D.componentBlock k)
      (weightedEuclideanJointSampleRadialRawResponse D state radius sample)
      (D.sampleIdeal sample k) =
      finiteCoordinateBlockL2Distance (D.componentBlock k) state
        (D.sampleIdeal sample k) -
        radius * (D.sampleWeight sample k / D.sampleWeightNorm2 sample) := by
  let coefficient : ℝ := D.sampleWeight sample k / D.sampleWeightNorm2 sample
  let distance : ℝ := finiteCoordinateBlockL2Distance (D.componentBlock k) state
    (D.sampleIdeal sample k)
  have hcoefficient_nonneg : 0 ≤ coefficient := hweight k
  have hweight_nonneg : 0 ≤ D.sampleWeight sample k := by
    have hproduct : 0 ≤
        (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
          D.sampleWeightNorm2 sample :=
      mul_nonneg hcoefficient_nonneg hweightNorm.le
    simpa [div_mul_cancel₀ _ hweightNorm.ne'] using hproduct
  have hcoefficient_le_one : coefficient ≤ 1 := by
    apply (div_le_iff₀ hweightNorm).mpr
    simpa [WeightedEuclideanJointSampleData.sampleWeightNorm2,
      abs_of_nonneg hweight_nonneg] using
      (AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
        (D.sampleWeight sample) k)
  have hdistance_pos : 0 < distance := lt_of_lt_of_le hradius (hgood k)
  have hscaled_le : radius * coefficient ≤ distance := by
    calc
      radius * coefficient ≤ radius * 1 :=
        mul_le_mul_of_nonneg_left hcoefficient_le_one hradius.le
      _ = radius := by ring
      _ ≤ distance := hgood k
  have hfactor_nonneg : 0 ≤ 1 - radius * coefficient / distance := by
    rw [sub_nonneg]
    exact (div_le_one₀ hdistance_pos).mpr hscaled_le
  have hvector :
      (fun i : {i : Coord // i ∈ D.componentBlock k} =>
        weightedEuclideanJointSampleRadialRawResponse D state radius sample i -
          D.sampleIdeal sample k i) =
        fun i : {i : Coord // i ∈ D.componentBlock k} =>
          (1 - radius * coefficient / distance) *
          (state i - D.sampleIdeal sample k i) := by
    funext i
    simp only [weightedEuclideanJointSampleRadialRawResponse]
    rw [weightedEuclideanJointSampleDirection_apply_of_mem_block
      D state sample i.property]
    simp only [
      l2BlockDistanceNormalizedGradient, if_pos i.property]
    dsimp only [coefficient, distance]
    field_simp [hdistance_pos.ne']
    ring
  change AppliedModelingLib.FiniteDimensionalNorms.l2 _ = distance - radius * coefficient
  rw [hvector, AppliedModelingLib.FiniteDimensionalNorms.normL2_smul,
    abs_of_nonneg hfactor_nonneg]
  change (1 - radius * coefficient / distance) * distance =
    distance - radius * coefficient
  field_simp [hdistance_pos.ne']

/--
Off the block-crossing event, the radial response decreases the exact
Definition 2 sample cost by exactly one query radius.  This is the
finite-dimensional identity behind Appendix C.6's displayed arg-min formula.
-/
theorem weightedEuclideanJointSampleCost_radialRawResponse_eq_sub
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweightNorm : 0 < D.sampleWeightNorm2 sample)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k / D.sampleWeightNorm2 sample)
    (hgood : weightedEuclideanJointSampleBlockGood D state radius sample) :
    weightedEuclideanJointSampleCost D sample
      (weightedEuclideanJointSampleRadialRawResponse D state radius sample) =
      weightedEuclideanJointSampleCost D sample state - radius := by
  have hdenom_ne_zero : D.sampleWeightNorm2 sample ≠ 0 := hweightNorm.ne'
  have hweight_sq : ∑ k : Component,
      (D.sampleWeight sample k / D.sampleWeightNorm2 sample) ^ 2 = 1 := by
    calc
      (∑ k : Component, (D.sampleWeight sample k /
          D.sampleWeightNorm2 sample) ^ 2) =
          ∑ k : Component, D.sampleWeight sample k ^ 2 /
            D.sampleWeightNorm2 sample ^ 2 := by
          apply Finset.sum_congr rfl
          intro k _hk
          field_simp
      _ = (∑ k : Component, D.sampleWeight sample k ^ 2) /
            D.sampleWeightNorm2 sample ^ 2 := by
          rw [Finset.sum_div]
      _ = 1 := by
          rw [D.sampleWeightNorm2_sq, div_self (pow_ne_zero _ hdenom_ne_zero)]
  unfold weightedEuclideanJointSampleCost
  calc
    ∑ k ∈ Finset.univ,
        (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
          finiteCoordinateBlockL2Distance (D.componentBlock k)
            (weightedEuclideanJointSampleRadialRawResponse D state radius sample)
            (D.sampleIdeal sample k) =
        ∑ k ∈ Finset.univ,
          (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
            (finiteCoordinateBlockL2Distance (D.componentBlock k) state
              (D.sampleIdeal sample k) - radius *
                (D.sampleWeight sample k / D.sampleWeightNorm2 sample)) := by
      apply Finset.sum_congr rfl
      intro k _hk
      rw [finiteCoordinateBlockL2Distance_radialWeightedResponse_eq_sub
        D hradius sample hweightNorm hweight hgood k]
    _ = (∑ k ∈ Finset.univ,
          (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
            finiteCoordinateBlockL2Distance (D.componentBlock k) state
              (D.sampleIdeal sample k)) -
          radius * ∑ k ∈ Finset.univ,
            (D.sampleWeight sample k / D.sampleWeightNorm2 sample) ^ 2 := by
      calc
        ∑ k ∈ Finset.univ,
            (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
              (finiteCoordinateBlockL2Distance (D.componentBlock k) state
                (D.sampleIdeal sample k) - radius *
                  (D.sampleWeight sample k / D.sampleWeightNorm2 sample)) =
            ∑ k ∈ Finset.univ,
              ((D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
                finiteCoordinateBlockL2Distance (D.componentBlock k) state
                  (D.sampleIdeal sample k) -
                radius * (D.sampleWeight sample k / D.sampleWeightNorm2 sample) ^ 2) := by
              apply Finset.sum_congr rfl
              intro k _hk
              ring
        _ = _ := by
          rw [Finset.sum_sub_distrib, Finset.mul_sum]
    _ = (∑ k ∈ Finset.univ,
          (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
            finiteCoordinateBlockL2Distance (D.componentBlock k) state
              (D.sampleIdeal sample k)) - radius := by
      rw [hweight_sq]
      ring

/--
For every finite Definition 2 sample and nonnegative query radius, an exact
raw Model A favorite point exists.  The result is pointwise: the paper leaves
ties unspecified, and obtaining one Borel choice across all states and joint
samples is a separate measurable-selection task.
-/
theorem exists_weightedEuclideanJointSampleModelARawResponseAt
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) (hradius : 0 ≤ radius) :
    ∃ response,
      WeightedEuclideanJointSampleModelARawResponseAt D state radius sample response := by
  let rawBall := weightedEuclideanJointSampleModelARawQueryBall state radius
  have hcompact : IsCompact rawBall :=
    isCompact_weightedEuclideanJointSampleModelARawQueryBall state radius hradius
  have hnonempty : rawBall.Nonempty := by
    refine ⟨state, ?_⟩
    change finiteCoordinateDistance SourceNorm.l2 state state ≤ radius
    simpa [finiteCoordinateDistance_l2_self] using hradius
  rcases hcompact.exists_isMinOn hnonempty
    (continuous_weightedEuclideanJointSampleCost D sample).continuousOn with
      ⟨response, hresponse, hmin⟩
  refine ⟨response, ?_⟩
  constructor
  · exact hresponse
  · intro candidate hcandidate
    exact hmin hcandidate

/--
Outside the exact block-crossing event, the radial point is a source-valid
Model A response for the actual weighted joint-sample cost.
-/
theorem weightedEuclideanJointSampleRadialRawResponse_is_modelAResponse_of_blockGood
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweightNorm : 0 < D.sampleWeightNorm2 sample)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k / D.sampleWeightNorm2 sample)
    (hgood : weightedEuclideanJointSampleBlockGood D state radius sample) :
    WeightedEuclideanJointSampleModelARawResponseAt D state radius sample
      (weightedEuclideanJointSampleRadialRawResponse D state radius sample) := by
  letI : Nonempty Coord := D.coordinate_nonempty
  constructor
  · exact weightedEuclideanJointSampleRadialRawResponse_l2_distance_le
      D hradius sample hweightNorm hgood
  · intro candidate hcandidate
    let direction : Coord → ℝ := weightedEuclideanJointSampleDirection D state sample
    have hdirection : AppliedModelingLib.FiniteDimensionalNorms.l2 direction = 1 := by
      simpa only [direction, finiteCoordinateNorm_l2] using
        weightedEuclideanJointSampleDirection_l2_eq_one_of_blockGood
          D hradius sample hweightNorm hgood
    have hdot_abs : |AppliedModelingLib.FiniteDimensionalNorms.dot direction
        (fun i => candidate i - state i)| ≤ radius := by
      calc
        |AppliedModelingLib.FiniteDimensionalNorms.dot direction
            (fun i => candidate i - state i)| ≤
            AppliedModelingLib.FiniteDimensionalNorms.l2 direction *
              AppliedModelingLib.FiniteDimensionalNorms.l2
                (fun i => candidate i - state i) :=
          AppliedModelingLib.FiniteDimensionalNorms.abs_dot_le_l2_mul_l2 _ _
        _ = AppliedModelingLib.FiniteDimensionalNorms.l2
              (fun i => candidate i - state i) := by rw [hdirection, one_mul]
        _ ≤ radius := hcandidate
    have hdot_lower : -radius ≤
        AppliedModelingLib.FiniteDimensionalNorms.coordinateLinearFunctional direction
          (fun i => candidate i - state i) := by
      rw [← AppliedModelingLib.Optimization.dot_eq_coordinateLinearFunctional]
      exact (abs_le.mp hdot_abs).1
    have hsub := weightedEuclideanJointSampleDirection_subgradient_of_blockGood
      D hradius sample hweight hgood candidate
    have hcost := weightedEuclideanJointSampleCost_radialRawResponse_eq_sub
      D hradius sample hweightNorm hweight hgood
    change weightedEuclideanJointSampleCost D sample
      (weightedEuclideanJointSampleRadialRawResponse D state radius sample) ≤ _
    rw [hcost]
    change weightedEuclideanJointSampleCost D sample state - radius ≤ _
    dsimp only [direction] at hdot_lower
    linarith

/--
Off the block-crossing event, every exact Model A response equals the radial
response.  This removes any unspecified tie-breaking from the Appendix C.5
stochastic-subgradient reduction on its good event.
-/
theorem weightedEuclideanJointSampleModelARawResponse_eq_radial_of_blockGood
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweightNorm : 0 < D.sampleWeightNorm2 sample)
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k / D.sampleWeightNorm2 sample)
    (hgood : weightedEuclideanJointSampleBlockGood D state radius sample)
    {response : Coord → ℝ}
    (hresponse : WeightedEuclideanJointSampleModelARawResponseAt D state radius sample
      response) :
    response = weightedEuclideanJointSampleRadialRawResponse D state radius sample := by
  letI : Nonempty Coord := D.coordinate_nonempty
  rcases hresponse with ⟨hresponse_ball, hresponse_min⟩
  let direction : Coord → ℝ := weightedEuclideanJointSampleDirection D state sample
  let displacement : Coord → ℝ := fun i => response i - state i
  have hdirection : AppliedModelingLib.FiniteDimensionalNorms.l2 direction = 1 := by
    simpa only [direction, finiteCoordinateNorm_l2] using
      weightedEuclideanJointSampleDirection_l2_eq_one_of_blockGood
        D hradius sample hweightNorm hgood
  have hradial :=
    weightedEuclideanJointSampleRadialRawResponse_is_modelAResponse_of_blockGood
      D hradius sample hweightNorm hweight hgood
  have hresponse_le : weightedEuclideanJointSampleCost D sample response ≤
      weightedEuclideanJointSampleCost D sample
        (weightedEuclideanJointSampleRadialRawResponse D state radius sample) :=
    hresponse_min _ hradial.1
  have hdot_abs : |AppliedModelingLib.FiniteDimensionalNorms.dot direction displacement| ≤ radius := by
    calc
      |AppliedModelingLib.FiniteDimensionalNorms.dot direction displacement| ≤
          AppliedModelingLib.FiniteDimensionalNorms.l2 direction *
            AppliedModelingLib.FiniteDimensionalNorms.l2 displacement :=
        AppliedModelingLib.FiniteDimensionalNorms.abs_dot_le_l2_mul_l2 _ _
      _ = AppliedModelingLib.FiniteDimensionalNorms.l2 displacement := by rw [hdirection, one_mul]
      _ ≤ radius := hresponse_ball
  have hdot_lower : -radius ≤
      AppliedModelingLib.FiniteDimensionalNorms.coordinateLinearFunctional direction displacement := by
    rw [← AppliedModelingLib.Optimization.dot_eq_coordinateLinearFunctional]
    exact (abs_le.mp hdot_abs).1
  have hsub := weightedEuclideanJointSampleDirection_subgradient_of_blockGood
    D hradius sample hweight hgood response
  have hcost := weightedEuclideanJointSampleCost_radialRawResponse_eq_sub
    D hradius sample hweightNorm hweight hgood
  have hdot_upper :
      AppliedModelingLib.FiniteDimensionalNorms.coordinateLinearFunctional direction displacement ≤
        -radius := by
    dsimp only [displacement, direction]
    rw [hcost] at hresponse_le
    linarith
  have hdot : AppliedModelingLib.FiniteDimensionalNorms.dot direction displacement = -radius := by
    rw [AppliedModelingLib.Optimization.dot_eq_coordinateLinearFunctional]
    exact le_antisymm hdot_upper hdot_lower
  have hstep_sq : AppliedModelingLib.FiniteDimensionalNorms.l2Sq displacement ≤ radius ^ 2 := by
    apply AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_sq_of_normL2_le hradius.le
    exact hresponse_ball
  have hdirection_sq : AppliedModelingLib.FiniteDimensionalNorms.l2Sq direction = 1 := by
    rw [← AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq, hdirection]
    norm_num
  have hdot_neg : AppliedModelingLib.FiniteDimensionalNorms.dot displacement
      (fun i => -radius * direction i) =
      -radius * AppliedModelingLib.FiniteDimensionalNorms.dot direction displacement := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.dot
    calc
      (∑ i : Coord, displacement i * (-radius * direction i)) =
          ∑ i : Coord, (-radius) * (direction i * displacement i) := by
        apply Finset.sum_congr rfl
        intro i _hi
        ring
      _ = -radius * ∑ i : Coord, direction i * displacement i := by
        rw [Finset.mul_sum]
  have hquadratic :
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (fun i => response i -
          weightedEuclideanJointSampleRadialRawResponse D state radius sample i) =
        AppliedModelingLib.FiniteDimensionalNorms.l2Sq displacement +
          2 * radius * AppliedModelingLib.FiniteDimensionalNorms.dot direction displacement +
          radius ^ 2 * AppliedModelingLib.FiniteDimensionalNorms.l2Sq direction := by
    calc
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
          (fun i => response i -
            weightedEuclideanJointSampleRadialRawResponse D state radius sample i) =
          AppliedModelingLib.FiniteDimensionalNorms.l2Sq
            (fun i => displacement i - (-radius * direction i)) := by
          congr 1
          funext i
          simp only [displacement, direction,
            weightedEuclideanJointSampleRadialRawResponse]
          ring
      _ = AppliedModelingLib.FiniteDimensionalNorms.l2Sq displacement -
          2 * AppliedModelingLib.FiniteDimensionalNorms.dot displacement
            (fun i => -radius * direction i) +
          AppliedModelingLib.FiniteDimensionalNorms.l2Sq
            (fun i => -radius * direction i) :=
          AppliedModelingLib.FiniteDimensionalNorms.l2Sq_sub_eq _ _
      _ = AppliedModelingLib.FiniteDimensionalNorms.l2Sq displacement +
          2 * radius * AppliedModelingLib.FiniteDimensionalNorms.dot direction displacement +
          radius ^ 2 * AppliedModelingLib.FiniteDimensionalNorms.l2Sq direction := by
          rw [hdot_neg, AppliedModelingLib.FiniteDimensionalNorms.l2Sq_smul]
          ring
  have herr_nonpos : AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (fun i => response i -
        weightedEuclideanJointSampleRadialRawResponse D state radius sample i) ≤ 0 := by
    rw [hquadratic, hdot, hdirection_sq]
    nlinarith
  have herr_nonneg := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg
    (fun i => response i -
      weightedEuclideanJointSampleRadialRawResponse D state radius sample i)
  have herr_zero : AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (fun i => response i -
        weightedEuclideanJointSampleRadialRawResponse D state radius sample i) = 0 :=
    le_antisymm herr_nonpos herr_nonneg
  funext i
  have hcoordinate_sq :
      (response i - weightedEuclideanJointSampleRadialRawResponse D state radius sample i) ^ 2 ≤
        AppliedModelingLib.FiniteDimensionalNorms.l2Sq
          (fun j => response j -
            weightedEuclideanJointSampleRadialRawResponse D state radius sample j) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact Finset.single_le_sum
      (fun j _hj => sq_nonneg
        (response j - weightedEuclideanJointSampleRadialRawResponse D state radius sample j))
      (Finset.mem_univ i)
  rw [herr_zero] at hcoordinate_sq
  nlinarith

/--
An actual measurable selection of the source Model A raw favorite point.  The
paper permits arbitrary tie-breaking between local maximizers, so the
selection is part of the stochastic process rather than an implicit choice in
the proof.  Its exact-optimality condition is required on the valid
nonnegative, nonzero weight vectors that occur almost surely under Definition
2's joint law.
-/
structure WeightedEuclideanJointSampleModelAResponseSource
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component) where
  rawResponse : (Coord → ℝ) → ((Component → ℝ) × (Coord → ℝ)) → ℝ → Coord → ℝ
  rawResponse_measurable : ∀ radius, Measurable (fun z :
      (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      rawResponse z.1 z.2 radius)
  rawResponse_exact_of_valid : ∀ state radius sample, 0 < radius →
      (∀ k, 0 ≤ D.sampleWeight sample k) →
      0 < D.sampleWeightNorm2 sample →
      WeightedEuclideanJointSampleModelARawResponseAt D state radius sample
        (rawResponse state sample radius)

/--
Canonical measurable exact tie-breaking for Definition 2 Model A: finite
weighted block water-filling in the raw Euclidean query ball.
-/
noncomputable def weightedEuclideanJointSampleWaterfillModelAResponseSource
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component) :
    WeightedEuclideanJointSampleModelAResponseSource D where
  rawResponse := fun state sample radius =>
    weightedEuclideanJointSampleWaterfillRawResponse D state radius sample
  rawResponse_measurable := fun radius =>
    measurable_weightedEuclideanJointSampleWaterfillRawResponse D radius
  rawResponse_exact_of_valid := fun state radius sample hradius hweight hnorm =>
    weightedEuclideanJointSampleWaterfillRawResponse_is_modelAResponse_of_valid
      D state radius sample hradius hweight hnorm

/-- The normalized displacement from the current state to a selected Model A response. -/
noncomputable def weightedEuclideanJointSampleModelARawDirection
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) : Coord → ℝ :=
  fun i => (state i - A.rawResponse state sample radius i) / radius

/-- A Borel Model A selection gives a Borel normalized response direction. -/
theorem measurable_weightedEuclideanJointSampleModelARawDirection
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D) (radius : ℝ) :
    Measurable (fun z : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      weightedEuclideanJointSampleModelARawDirection A z.1 radius z.2) := by
  apply measurable_pi_lambda
  intro i
  exact (((measurable_pi_apply i).comp measurable_fst).sub
    ((measurable_pi_apply i).comp (A.rawResponse_measurable radius))).div_const radius

/--
On the C3-good event, any selected exact Model A response is the radial
response.  Thus all permissible measurable tie-breakers induce the same
stochastic direction outside the rare block-crossing event.
-/
theorem weightedEuclideanJointSampleModelAResponseSource_rawResponse_eq_radial_of_blockGood
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hweightNorm : 0 < D.sampleWeightNorm2 sample)
    (hgood : weightedEuclideanJointSampleBlockGood D state radius sample) :
    A.rawResponse state sample radius =
      weightedEuclideanJointSampleRadialRawResponse D state radius sample := by
  apply weightedEuclideanJointSampleModelARawResponse_eq_radial_of_blockGood
    D hradius sample hweightNorm (fun k => div_nonneg (hweight k) hweightNorm.le) hgood
  exact A.rawResponse_exact_of_valid state radius sample hradius hweight hweightNorm

/--
The selected Model A direction agrees with the weighted sampled subgradient
outside the block-crossing event.
-/
theorem weightedEuclideanJointSampleModelARawDirection_eq_direction_of_blockGood
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hweightNorm : 0 < D.sampleWeightNorm2 sample)
    (hgood : weightedEuclideanJointSampleBlockGood D state radius sample) :
    weightedEuclideanJointSampleModelARawDirection A state radius sample =
      weightedEuclideanJointSampleDirection D state sample := by
  unfold weightedEuclideanJointSampleModelARawDirection
  rw [weightedEuclideanJointSampleModelAResponseSource_rawResponse_eq_radial_of_blockGood
    D A hradius sample hweight hweightNorm hgood]
  funext i
  simp only [weightedEuclideanJointSampleRadialRawResponse]
  field_simp [hradius.ne']
  ring

/-- A valid Model A response has normalized Euclidean displacement at most one. -/
theorem weightedEuclideanJointSampleModelARawDirection_l2_le_one_of_valid
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    {state : Coord → ℝ} {radius : ℝ}
    (hradius : 0 < radius) (sample : (Component → ℝ) × (Coord → ℝ))
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hweightNorm : 0 < D.sampleWeightNorm2 sample) :
    AppliedModelingLib.FiniteDimensionalNorms.l2
      (weightedEuclideanJointSampleModelARawDirection A state radius sample) ≤ 1 := by
  have hresponse := A.rawResponse_exact_of_valid state radius sample hradius hweight hweightNorm
  have hreverse : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => state i - A.rawResponse state sample radius i) =
      AppliedModelingLib.FiniteDimensionalNorms.l2
        (fun i => A.rawResponse state sample radius i - state i) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2 AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    congr 1
    apply Finset.sum_congr rfl
    intro i _hi
    ring
  have hball : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => state i - A.rawResponse state sample radius i) ≤ radius := by
    rw [hreverse]
    simpa only [finiteCoordinateDistance] using hresponse.1
  unfold weightedEuclideanJointSampleModelARawDirection
  rw [show (fun i => (state i - A.rawResponse state sample radius i) / radius) =
      fun i => radius⁻¹ * (state i - A.rawResponse state sample radius i) by
        funext i
        rw [div_eq_inv_mul],
    AppliedModelingLib.FiniteDimensionalNorms.normL2_smul, abs_of_pos (inv_pos.mpr hradius)]
  rw [← div_eq_inv_mul]
  exact (div_le_iff₀ hradius).2 (by simpa using hball)

/-- One projected source Model A step from a current state and a joint voter draw. -/
noncomputable def weightedEuclideanJointSampleModelAOutcomeStep
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (n : ℕ)
    (stateSample : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ))) : Coord → ℝ :=
  project (A.rawResponse stateSample.1 stateSample.2 (ilvRadius r0 (n + 1)))

/-- A Borel selection and projection make the Model A step Borel. -/
theorem measurable_weightedEuclideanJointSampleModelAOutcomeStep
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Measurable (weightedEuclideanJointSampleModelAOutcomeStep A r0 project n) := by
  exact hproject.comp (A.rawResponse_measurable (ilvRadius r0 (n + 1)))

/-- The outcome-indexed iid recursion generated by a selected Model A response. -/
noncomputable def weightedEuclideanJointSampleModelAOutcomeTrajectory
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ) :
    ℕ → (ℕ → (Component → ℝ) × (Coord → ℝ)) → Coord → ℝ
  | 0, _ => initial
  | n + 1, omega =>
      weightedEuclideanJointSampleModelAOutcomeStep A r0 project n
        (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega,
          AppliedModelingLib.iidSequenceSample n omega)

/-- The finite-history form of the selected Model A recursion. -/
noncomputable def weightedEuclideanJointSampleModelAOutcomePrefixTrajectory
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ) :
    (n : ℕ) → (Fin (n + 1) → (Component → ℝ) × (Coord → ℝ)) → Coord → ℝ
  | 0, _ => initial
  | n + 1, history =>
      weightedEuclideanJointSampleModelAOutcomeStep A r0 project n
        (weightedEuclideanJointSampleModelAOutcomePrefixTrajectory A r0 project initial n
          (fun j => history j.castSucc), history (Fin.last (n + 1)))

/-- The selected Model A finite-past state is Borel measurable. -/
theorem measurable_weightedEuclideanJointSampleModelAOutcomePrefixTrajectory
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) :
    ∀ n, Measurable
      (weightedEuclideanJointSampleModelAOutcomePrefixTrajectory A r0 project initial n) := by
  intro n
  induction n with
  | zero => exact measurable_const
  | succ n ih =>
      change Measurable (fun history : Fin (n + 2) →
          (Component → ℝ) × (Coord → ℝ) =>
        weightedEuclideanJointSampleModelAOutcomeStep A r0 project n
          (weightedEuclideanJointSampleModelAOutcomePrefixTrajectory A r0 project initial n
            (fun j => history j.castSucc), history (Fin.last (n + 1))) )
      have hrestrict : Measurable (fun history : Fin (n + 2) →
          (Component → ℝ) × (Coord → ℝ) =>
          fun j : Fin (n + 1) => history j.castSucc) := by
        apply measurable_pi_lambda
        intro j
        exact measurable_pi_apply j.castSucc
      have hlast : Measurable (fun history : Fin (n + 2) →
          (Component → ℝ) × (Coord → ℝ) => history (Fin.last (n + 1))) :=
        measurable_pi_apply _
      exact (measurable_weightedEuclideanJointSampleModelAOutcomeStep
        A r0 project hproject n).comp ((ih.comp hrestrict).prodMk hlast)

/-- Evaluating the finite selected Model A history on the iid past gives its outcome trace. -/
theorem weightedEuclideanJointSampleModelAOutcomePrefixTrajectory_pastPrefix_eq
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → (Component → ℝ) × (Coord → ℝ)) :
    weightedEuclideanJointSampleModelAOutcomePrefixTrajectory A r0 project initial n
      (AppliedModelingLib.iidSequencePastPrefix n omega) =
      weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega := by
  induction n with
  | zero => rfl
  | succ n ih =>
      simp only [weightedEuclideanJointSampleModelAOutcomeTrajectory,
        weightedEuclideanJointSampleModelAOutcomePrefixTrajectory,
        AppliedModelingLib.iidSequencePastPrefix]
      have hprefix : (fun j : Fin (n + 1) => omega j.castSucc) =
          AppliedModelingLib.iidSequencePastPrefix n omega := rfl
      rw [hprefix, ih]
      simp [AppliedModelingLib.iidSequenceSample]

/-- The selected Model A state is strongly measurable with respect to its iid past. -/
theorem stronglyMeasurable_weightedEuclideanJointSampleModelAOutcomeTrajectory_natural
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    StronglyMeasurable[
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n]
      (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n) := by
  have hfactor : weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n =
      weightedEuclideanJointSampleModelAOutcomePrefixTrajectory A r0 project initial n ∘
        AppliedModelingLib.iidSequencePastPrefix n := by
    funext omega
    exact (weightedEuclideanJointSampleModelAOutcomePrefixTrajectory_pastPrefix_eq
      A r0 project initial n omega).symm
  rw [hfactor, AppliedModelingLib.iidSequenceNaturalFiltration_eq_comap_pastPrefix]
  exact ((measurable_weightedEuclideanJointSampleModelAOutcomePrefixTrajectory
    A r0 project initial hproject n).comp (comap_measurable _)).stronglyMeasurable

/--
Conditioning an integrable statistic of the selected Model A current state and
its fresh joint sample gives the corresponding joint-law integral.
-/
theorem weightedEuclideanJointSampleModelAOutcomeTrajectory_condExp_ae_eq_integral
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (test : (Coord → ℝ) → ((Component → ℝ) × (Coord → ℝ)) → ℝ)
    (htest : Integrable (fun z :
      (Fin (n + 1) → (Component → ℝ) × (Coord → ℝ)) ×
        ((Component → ℝ) × (Coord → ℝ)) =>
      test (weightedEuclideanJointSampleModelAOutcomePrefixTrajectory A r0 project initial n z.1)
        z.2)
      (Measure.map (fun omega =>
        (AppliedModelingLib.iidSequencePastPrefix n omega, AppliedModelingLib.iidSequenceSample n omega))
        (AppliedModelingLib.iidSequenceMeasure D.jointMeasure))) :
    (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)[
      fun omega => test
        (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) |
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n] =ᵐ[
          AppliedModelingLib.iidSequenceMeasure D.jointMeasure]
      fun omega => ∫ sample, test
        (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
          sample ∂D.jointMeasure := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  have hcond := AppliedModelingLib.iidSequencePastPrefix_condExp_ae_eq_integral
    D.jointMeasure n
    (fun past sample => test
      (weightedEuclideanJointSampleModelAOutcomePrefixTrajectory A r0 project initial n past)
        sample)
    htest
  simpa only [weightedEuclideanJointSampleModelAOutcomePrefixTrajectory_pastPrefix_eq] using hcond

/-- The Definition 2 population cost, expressed directly as a joint-law integral. -/
noncomputable def weightedEuclideanJointSamplePopulationCost
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) :
    (Coord → ℝ) → ℝ :=
  fun state => ∫ sample, weightedEuclideanJointSampleCost D sample state ∂D.jointMeasure

/-- The population direction obtained by integrating the normalized sampled direction. -/
noncomputable def weightedEuclideanJointSamplePopulationDirection
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) : Coord → ℝ :=
  fun i => ∫ sample, weightedEuclideanJointSampleDirection D state sample i ∂D.jointMeasure

/--
For every fixed state, a joint Definition 2 draw supplies a subgradient of its
own weighted block-distance cost almost surely.  Bounded density is used only
to remove the nondifferentiability event where a sampled ideal shares a
coordinate with the state; dependence between weights and ideals is retained.
-/
theorem weightedEuclideanJointSampleDirection_subgradient_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) :
    ∀ᵐ sample ∂D.jointMeasure,
      FiniteSubgradientAt (weightedEuclideanJointSampleCost D sample) state
        (weightedEuclideanJointSampleDirection D state sample) := by
  letI : Nonempty Coord := D.coordinate_nonempty
  have hnoncollision : ∀ᵐ sample ∂D.jointMeasure, ∀ i,
      state i ≠ sample.2 i := by
    have hmap : ∀ᵐ ideal ∂Measure.map
        (Prod.snd : ((Component → ℝ) × (Coord → ℝ)) → Coord → ℝ)
        D.jointMeasure, ∀ i, state i ≠ ideal i := by
      rw [D.ideal_marginal]
      exact D.idealDistribution.coordinate_noncollision_ae state
    exact MeasureTheory.ae_of_ae_map measurable_snd.aemeasurable hmap
  filter_upwards [D.normalizedWeight_nonnegative_ae, hnoncollision]
    with sample hweight hnoncollision
  have hsub := finiteSubgradientAt_finset_nonneg_weighted_sum
    (Finset.univ : Finset Component)
    (fun k _ => hweight k)
    (fun k _ =>
      finiteSubgradientAt_blockL2DistanceNormalizedGradient
        (D.componentBlock k) state (D.sampleIdeal sample k) (by
          rcases D.componentBlocks_nonempty k with ⟨i, hi⟩
          exact ⟨i, hi, by
            simpa [WeightedEuclideanJointSampleData.sampleIdeal] using
              hnoncollision i⟩))
  simpa only [weightedEuclideanJointSampleCost,
    weightedEuclideanJointSampleDirection,
    weightedEuclideanL2BlockSampleDirection] using hsub

/-- The normalized weighted block direction has Euclidean quantity one a.e. at any fixed state. -/
theorem weightedEuclideanJointSampleDirection_l2_eq_one_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) :
    ∀ᵐ sample ∂D.jointMeasure,
      finiteCoordinateNorm SourceNorm.l2
        (weightedEuclideanJointSampleDirection D state sample) = 1 := by
  have hnoncollision : ∀ᵐ sample ∂D.jointMeasure, ∀ i,
      state i ≠ sample.2 i := by
    have hmap : ∀ᵐ ideal ∂Measure.map
        (Prod.snd : ((Component → ℝ) × (Coord → ℝ)) → Coord → ℝ)
        D.jointMeasure, ∀ i, state i ≠ ideal i := by
      rw [D.ideal_marginal]
      exact D.idealDistribution.coordinate_noncollision_ae state
    exact MeasureTheory.ae_of_ae_map measurable_snd.aemeasurable hmap
  filter_upwards [hnoncollision, D.sampleWeightNorm2_pos_ae]
    with sample hnoncollision hweightNorm
  unfold weightedEuclideanJointSampleDirection
  apply weightedEuclidean_l2_direction_norm_eq_one_of_coordinate_blocks
    Finset.univ
    (fun k => D.sampleWeight sample k / D.sampleWeightNorm2 sample)
    (fun k => l2BlockDistanceNormalizedGradient (D.componentBlock k) state
      (D.sampleIdeal sample k))
  · intro i k l _hk _hl hkl
    exact l2BlockDistanceNormalizedGradients_coordinatewise_disjoint
      Finset.univ D.componentBlock state (D.sampleIdeal sample)
      (fun k l _ _ hne => D.componentBlocks_disjoint k l hne)
      i k l (by simp) (by simp) hkl
  · intro k _hk
    rw [finiteCoordinateNorm_l2]
    apply l2BlockDistanceNormalizedGradient_l2_eq_one
    rcases D.componentBlocks_nonempty k with ⟨i, hi⟩
    exact ⟨i, hi, by
      simpa [WeightedEuclideanJointSampleData.sampleIdeal] using hnoncollision i⟩
  · have hdenom_ne_zero : D.sampleWeightNorm2 sample ≠ 0 := hweightNorm.ne'
    calc
      (∑ k ∈ Finset.univ,
          (D.sampleWeight sample k / D.sampleWeightNorm2 sample) ^ 2) =
          ∑ k ∈ Finset.univ,
            D.sampleWeight sample k ^ 2 / D.sampleWeightNorm2 sample ^ 2 := by
          apply Finset.sum_congr rfl
          intro k _hk
          field_simp
      _ = (∑ k ∈ Finset.univ, D.sampleWeight sample k ^ 2) /
            D.sampleWeightNorm2 sample ^ 2 := by
          rw [Finset.sum_div]
      _ = 1 := by
          rw [D.sampleWeightNorm2_sq, div_self (pow_ne_zero _ hdenom_ne_zero)]

/-- Every coordinate of the joint sampled direction is integrable. -/
theorem integrable_weightedEuclideanJointSampleDirection_coordinate
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (i : Coord) :
    Integrable (fun sample => weightedEuclideanJointSampleDirection D state sample i)
      D.jointMeasure := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : Nonempty Coord := D.coordinate_nonempty
  have hmeas : Measurable
      (fun sample => weightedEuclideanJointSampleDirection D state sample i) := by
    exact (measurable_pi_apply i).comp
      ((measurable_weightedEuclideanL2BlockSampleDirection Finset.univ
        D.componentBlock D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal
        D.measurable_sampleWeight D.measurable_sampleWeightNorm2
          D.measurable_sampleIdeal).comp (measurable_const.prodMk measurable_id))
  refine Integrable.mono' (integrable_const (1 : ℝ)) hmeas.aestronglyMeasurable ?_
  filter_upwards [weightedEuclideanJointSampleDirection_l2_eq_one_ae D state]
    with sample hunit
  have hcoord := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
    (weightedEuclideanJointSampleDirection D state sample) i
  have hbound : |weightedEuclideanJointSampleDirection D state sample i| ≤ 1 := by
    calc
      |weightedEuclideanJointSampleDirection D state sample i| ≤
          AppliedModelingLib.FiniteDimensionalNorms.l2
            (weightedEuclideanJointSampleDirection D state sample) := hcoord
      _ = 1 := by simpa only [finiteCoordinateNorm_l2] using hunit
  simpa only [Real.norm_eq_abs] using hbound

/--
The selected Model A direction minus the displayed weighted sampled
subgradient.  It vanishes away from the block-crossing event and is the sole
exceptional-update term passed to the stochastic convergence argument.
-/
noncomputable def weightedEuclideanJointSampleModelASubgradientPerturbation
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (state : Coord → ℝ) (radius : ℝ)
    (sample : (Component → ℝ) × (Coord → ℝ)) : Coord → ℝ :=
  fun i => weightedEuclideanJointSampleModelARawDirection A state radius sample i -
    weightedEuclideanJointSampleDirection D state sample i

/-- The Model A exceptional-direction term is Borel measurable. -/
theorem measurable_weightedEuclideanJointSampleModelASubgradientPerturbation
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D) (radius : ℝ) :
    Measurable (fun z : (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      weightedEuclideanJointSampleModelASubgradientPerturbation A z.1 radius z.2) := by
  apply measurable_pi_lambda
  intro i
  exact ((measurable_pi_apply i).comp
    (measurable_weightedEuclideanJointSampleModelARawDirection A radius)).sub
      ((measurable_pi_apply i).comp
        (measurable_weightedEuclideanL2BlockSampleDirection Finset.univ
          D.componentBlock D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal
          D.measurable_sampleWeight D.measurable_sampleWeightNorm2 D.measurable_sampleIdeal))

/-- The selected Model A perturbation has Euclidean quantity at most two almost surely. -/
theorem weightedEuclideanJointSampleModelASubgradientPerturbation_l2_le_two_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (state : Coord → ℝ) {radius : ℝ} (hradius : 0 < radius) :
    ∀ᵐ sample ∂D.jointMeasure,
      AppliedModelingLib.FiniteDimensionalNorms.l2
        (weightedEuclideanJointSampleModelASubgradientPerturbation A state radius sample) ≤ 2 := by
  filter_upwards [D.sampleWeight_nonnegative_ae, D.sampleWeightNorm2_pos_ae,
    weightedEuclideanJointSampleDirection_l2_eq_one_ae D state]
      with sample hweight hweightNorm hdirection
  have hraw := weightedEuclideanJointSampleModelARawDirection_l2_le_one_of_valid
    A (state := state) hradius sample hweight hweightNorm
  have hneg : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => -weightedEuclideanJointSampleDirection D state sample i) =
      AppliedModelingLib.FiniteDimensionalNorms.l2
        (weightedEuclideanJointSampleDirection D state sample) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2 AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    congr 1
    apply Finset.sum_congr rfl
    intro i _hi
    ring
  have htriangle := AppliedModelingLib.FiniteDimensionalNorms.normL2_add_le
    (weightedEuclideanJointSampleModelARawDirection A state radius sample)
    (fun i => -weightedEuclideanJointSampleDirection D state sample i)
  calc
    AppliedModelingLib.FiniteDimensionalNorms.l2
        (weightedEuclideanJointSampleModelASubgradientPerturbation A state radius sample) =
        AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun i => weightedEuclideanJointSampleModelARawDirection A state radius sample i +
            (-weightedEuclideanJointSampleDirection D state sample i)) := by
              apply congrArg AppliedModelingLib.FiniteDimensionalNorms.l2
              funext i
              unfold weightedEuclideanJointSampleModelASubgradientPerturbation
              ring
    _ ≤ AppliedModelingLib.FiniteDimensionalNorms.l2
          (weightedEuclideanJointSampleModelARawDirection A state radius sample) +
        AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun i => -weightedEuclideanJointSampleDirection D state sample i) := htriangle
    _ = AppliedModelingLib.FiniteDimensionalNorms.l2
          (weightedEuclideanJointSampleModelARawDirection A state radius sample) + 1 := by
            rw [hneg]
            rw [show AppliedModelingLib.FiniteDimensionalNorms.l2
                (weightedEuclideanJointSampleDirection D state sample) = 1 by
              simpa only [finiteCoordinateNorm_l2] using hdirection]
    _ ≤ 2 := by linarith

/-- Away from the block-crossing event the selected Model A perturbation is zero. -/
theorem weightedEuclideanJointSampleModelASubgradientPerturbation_eq_zero_of_valid_of_notMem_blockBadEvent
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    {state : Coord → ℝ} {radius : ℝ} (hradius : 0 < radius)
    (sample : (Component → ℝ) × (Coord → ℝ))
    (hweight : ∀ k, 0 ≤ D.sampleWeight sample k)
    (hweightNorm : 0 < D.sampleWeightNorm2 sample)
    (hnot : sample ∉ weightedEuclideanJointSampleBlockBadEvent D state radius) :
    weightedEuclideanJointSampleModelASubgradientPerturbation A state radius sample = 0 := by
  have heq := weightedEuclideanJointSampleModelARawDirection_eq_direction_of_blockGood
    A hradius sample hweight hweightNorm
      ((notMem_weightedEuclideanJointSampleBlockBadEvent_iff D state radius sample).mp hnot)
  unfold weightedEuclideanJointSampleModelASubgradientPerturbation
  rw [heq]
  simp
  rfl

/-- The Model A exceptional-direction term is integrable at a fixed state. -/
theorem integrable_weightedEuclideanJointSampleModelASubgradientPerturbation_l2
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (state : Coord → ℝ) {radius : ℝ} (hradius : 0 < radius) :
    Integrable (fun sample => AppliedModelingLib.FiniteDimensionalNorms.l2
      (weightedEuclideanJointSampleModelASubgradientPerturbation A state radius sample))
      D.jointMeasure := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  refine Integrable.mono' (integrable_const (2 : ℝ))
