/-- C1 compactness makes every canonical joint target potential integrable. -/
theorem integrable_weightedEuclideanJointSampleOutcomeTrajectory_target_l2Sq_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) :
    Integrable (fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (fun i => weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega i -
        target i)) (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  have htrajectory := stronglyMeasurable_weightedEuclideanJointSampleOutcomeTrajectory_natural
    D r0 project initial S.project_measurable n
  have htrajectory_meas : Measurable
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n) :=
    htrajectory.measurable.mono
      ((AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ))).le n) le_rfl
  have hmeas : Measurable (fun omega : ℕ → (Component → ℝ) × (Coord → ℝ) =>
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (fun i => weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega i -
          target i)) := by
    apply hl2sq.comp
    apply measurable_pi_lambda _
    intro i
    exact ((measurable_pi_apply i).comp htrajectory_meas).sub measurable_const
  refine Integrable.mono' (integrable_const (finiteModelBC1C2L2Diameter S ^ 2))
    hmeas.aestronglyMeasurable ?_
  filter_upwards [] with omega
  have hfeasible := weightedEuclideanJointSampleOutcomeTrajectory_mem_solutionSpace_of_C1C2
    S r0 initial hinitial n omega
  have hdistance := finiteModelBC1C2L2Diameter_bound S hfeasible htarget
  have hsq := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_sq_of_normL2_le
    (finiteModelBC1C2L2Diameter_nonneg S) hdistance
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hsq

/-- C1/C2 bounds make each exact joint population objective gap integrable. -/
theorem integrable_weightedEuclideanJointSamplePopulationCost_gap_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) :
    Integrable (fun omega => weightedEuclideanJointSamplePopulationCost D
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) -
        weightedEuclideanJointSamplePopulationCost D target)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  have hadapted := stronglyAdapted_weightedEuclideanJointSamplePopulationCost_gap_natural
    S r0 initial target
  refine Integrable.mono' (integrable_const
      ((Fintype.card Component : ℝ) * finiteModelBC1C2L2Diameter S))
    ((hadapted n).measurable.mono
      ((AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ))).le n) le_rfl).aestronglyMeasurable ?_
  filter_upwards [] with omega
  have hfeasible := weightedEuclideanJointSampleOutcomeTrajectory_mem_solutionSpace_of_C1C2
    S r0 initial hinitial n omega
  simpa only [Real.norm_eq_abs] using
    weightedEuclideanJointSamplePopulationCost_gap_abs_le_card_mul_l2Diameter_of_C1C2
      S hfeasible htarget

/-- Compact C1 geometry and bounded joint noise make every target-noise product integrable. -/
theorem integrable_weightedEuclideanJointSampleOutcomeTrajectory_target_noise_product_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) (i : Coord) :
    Integrable (fun omega =>
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega i - target i) *
        weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega i)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  have htrajectory := stronglyMeasurable_weightedEuclideanJointSampleOutcomeTrajectory_natural
    D r0 project initial S.project_measurable n
  have htrajectory_meas : Measurable
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n) :=
    htrajectory.measurable.mono
      ((AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ))).le n) le_rfl
  have hstate : Measurable (fun omega : ℕ → (Component → ℝ) × (Coord → ℝ) =>
      weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega i - target i) :=
    ((measurable_pi_apply i).comp htrajectory_meas).sub measurable_const
  have hnoise := measurable_weightedEuclideanJointSampleOutcomeGradientNoise
    D r0 project initial S.project_measurable n
  have hmeas : Measurable (fun omega : ℕ → (Component → ℝ) × (Coord → ℝ) =>
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega i - target i) *
        weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega i) :=
    hstate.mul ((measurable_pi_apply i).comp hnoise)
  refine Integrable.mono' (integrable_const (2 * finiteModelBC1C2L2Diameter S))
    hmeas.aestronglyMeasurable ?_
  filter_upwards [
    weightedEuclideanJointSampleOutcomeGradientNoise_coord_abs_le_two_ae
      D r0 project initial S.project_measurable n i] with omega hnoise_bound
  have hfeasible := weightedEuclideanJointSampleOutcomeTrajectory_mem_solutionSpace_of_C1C2
    S r0 initial hinitial n omega
  have hdistance := finiteModelBC1C2L2Diameter_bound S hfeasible htarget
  have hcoordinate := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
    (fun j => weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega j -
      target j) i
  have hcoordinate_bound :
      |weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega i - target i| ≤
        finiteModelBC1C2L2Diameter S := hcoordinate.trans hdistance
  rw [Real.norm_eq_abs, abs_mul]
  calc
    |weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega i - target i| *
        |weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega i| ≤
        finiteModelBC1C2L2Diameter S * 2 :=
      mul_le_mul hcoordinate_bound hnoise_bound (abs_nonneg _)
        (finiteModelBC1C2L2Diameter_nonneg S)
    _ = 2 * finiteModelBC1C2L2Diameter S := by ring

/-- The exact joint objective is strongly measurable along the selected Model A iid past. -/
theorem stronglyMeasurable_weightedEuclideanJointSampleModelAPopulationCost_natural
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
