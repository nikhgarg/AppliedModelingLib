/-- Joint population-objective gaps are adapted along the selected Model A recursion. -/
theorem stronglyAdapted_weightedEuclideanJointSampleModelAPopulationCost_gap_natural
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
