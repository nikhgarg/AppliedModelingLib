/--
On its probability-one C3 noncollision event, the symmetric `(∞,1)` raw
response obeys the source Model B formula with a valid negative utility
subgradient.
-/
theorem finiteModelBLinfOutcomeRawResponse_is_modelBResponse_ae
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) (n : ℕ) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D,
      ModelBFiniteResponseAt SourceNorm.l1
        (finiteModelBLinfOutcomeTrajectory D r0 project initial n omega)
        (ilvRadius r0 (n + 1))
        (fun i => -linfL1SymmetricActiveDirection
          (finiteModelBLinfOutcomeTrajectory D r0 project initial n omega)
          (finiteModelBIdealSample n omega) i)
        (finiteModelBLinfOutcomeRawResponse r0
          (finiteModelBLinfOutcomeTrajectory D r0 project initial)
          finiteModelBIdealSample n omega) := by
  filter_upwards [finiteModelBLinfOutcomeTrajectory_ae_coordinate_noncollision
    D r0 project initial hproject n] with omega hcoord
  let state := finiteModelBLinfOutcomeTrajectory D r0 project initial n omega
  let ideal := finiteModelBIdealSample n omega
  let i0 : Coord := Classical.choice inferInstance
  have hnonzero : AppliedModelingLib.FiniteDimensionalNorms.linf
      (fun i => state i - ideal i) ≠ 0 := by
    apply ne_of_gt
    apply AppliedModelingLib.FiniteDimensionalNorms.linf_pos_of_exists_ne_zero
    refine ⟨i0, ?_⟩
    exact sub_ne_zero.mpr (hcoord i0)
  change finiteModelBLinfOutcomeRawResponse r0
      (finiteModelBLinfOutcomeTrajectory D r0 project initial)
      finiteModelBIdealSample n omega =
    fun i => state i + ilvRadius r0 (n + 1) *
      modelBFiniteNormalizedDirection SourceNorm.l1
        (fun j => -linfL1SymmetricActiveDirection state ideal j) i
  rw [modelBFiniteNormalizedDirection_l1_neg_linfL1SymmetricActiveDirection hnonzero]
  funext i
  simp [finiteModelBLinfOutcomeRawResponse, state, ideal]
  ring

/--
An ILV specialization of the reusable finite-dimensional projected stochastic-
subgradient execution.  It is deliberately separate from
`ILVEnvironment.trajectory`: Appendix 5 concerns a trajectory indexed by a
probability-space outcome.  The only ILV-specific addition identifies the
generic optimizer as a social optimum and connects each sampled direction to
the selected voter's cost.  It captures Algorithm 2's displayed update; its
population sampling law is recorded separately below, rather than inferred
from the deterministic environment.
-/
structure FiniteCoordinateILVRandomSSGMExecution
    {Voter Coord : Type*} [Fintype Coord]
    (E : ILVEnvironment Voter (Coord → ℝ)) extends
    AppliedModelingLib.Optimization.SampledProjectedStochasticSubgradientExecution Coord where
  solutionSpace_eq : toSampledProjectedStochasticSubgradientExecution.solutionSpace = E.solutionSpace
  voterOfSample : toSampledProjectedStochasticSubgradientExecution.Sample → Voter
  sampleCost_eq_neg_utility : ∀ sample x,
    toSampledProjectedStochasticSubgradientExecution.sampleCost sample x =
      -E.utility (voterOfSample sample) x
  objective_eq_socialCost :
    toSampledProjectedStochasticSubgradientExecution.objective = socialCostObjective E
  target_socialOptimal : toSampledProjectedStochasticSubgradientExecution.target ∈ E.socialOptimal

/-- The voter selected by a sampled ILV execution at a given step and outcome. -/
noncomputable def FiniteCoordinateILVRandomSSGMExecution.selectedVoter
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSSGMExecution E) (n : ℕ) (omega : S.Ω) : Voter :=
  S.voterOfSample (S.sample n omega)

/-- Each realized Algorithm 2 direction is a subgradient of the selected voter's cost. -/
theorem FiniteCoordinateILVRandomSSGMExecution.sampledDirection_subgradient
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSSGMExecution E) (n : ℕ) :
    ∀ᵐ omega ∂S.μ,
      FiniteSubgradientWithinAt
        (fun x => -E.utility (S.selectedVoter n omega) x) E.solutionSpace
        (S.trajectory n omega) (S.sampledDirection n omega) := by
  filter_upwards [S.sampled_direction_subgradient n] with omega hsub
  have hcost : S.sampleCost (S.sample n omega) =
      fun x => -E.utility (S.selectedVoter n omega) x := by
    funext x
    exact S.sampleCost_eq_neg_utility (S.sample n omega) x
  simpa [hcost, selectedVoter, S.solutionSpace_eq] using hsub

/-- Algorithm 2's displayed projected update for the realized selected-voter direction. -/
theorem FiniteCoordinateILVRandomSSGMExecution.algorithm2_update
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSSGMExecution E) (n : ℕ) :
    ∀ᵐ omega ∂S.μ,
      S.trajectory (n + 1) omega = S.project (fun i => S.trajectory n omega i -
        S.radius (n + 1) * S.sampledDirection n omega i) :=
  S.toSampledProjectedStochasticSubgradientExecution.update_eq_sampled_direction n

/--
The population law attached to a sampled ILV execution.  This records the
paper's statement that each selected voter has the population distribution.
It deliberately states only the marginal law: the stronger conditional
freshness property needed to derive martingale noise bounds belongs in the
subsequent stochastic source-to-model bridge.
-/
structure FiniteCoordinateILVSelectedVoterLaw
    {Voter Coord : Type*} [MeasurableSpace Voter] [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSSGMExecution E) where
  voterMeasure : Measure Voter
  voterProbability : IsProbabilityMeasure voterMeasure
  selectedVoter_measurable : ∀ n,
    @Measurable S.Ω Voter S.measurableSpace inferInstance (S.selectedVoter n)
  selectedVoter_law : ∀ n,
    @Measure.map S.Ω Voter S.measurableSpace inferInstance
      (S.selectedVoter n) S.μ = voterMeasure

/-- Each time-indexed selected voter has the declared population law. -/
theorem FiniteCoordinateILVSelectedVoterLaw.selectedVoter_map_eq
    {Voter Coord : Type*} [MeasurableSpace Voter] [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {S : FiniteCoordinateILVRandomSSGMExecution E}
    (L : FiniteCoordinateILVSelectedVoterLaw S) (n : ℕ) :
    @Measure.map S.Ω Voter S.measurableSpace inferInstance
      (S.selectedVoter n) S.μ = L.voterMeasure :=
  L.selectedVoter_law n

/--
The source-model form of independent population sampling for Algorithm 2.
Unlike a marginal distribution statement, this identifies each selected
voter's conditional law given the current optimization filtration.  It is the
precise bridge needed to obtain martingale noise from a sampled voter
direction.
-/
structure FiniteCoordinateILVConditionalVoterLaw
    {Voter Coord : Type*} [MeasurableSpace Voter] [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSSGMExecution E) where
  voterMeasure : Measure Voter
  voterProbability : IsProbabilityMeasure voterMeasure
  selectedVoter_measurable : ∀ n,
    @Measurable S.Ω Voter S.measurableSpace inferInstance (S.selectedVoter n)
  conditional_integral_eq : ∀ n (test : Voter → ℝ),
    Integrable test voterMeasure →
      Integrable (fun omega => test (S.selectedVoter n omega)) S.μ →
        S.μ[fun omega => test (S.selectedVoter n omega) | S.filtration n] =ᵐ[S.μ]
          fun _ => ∫ voter, test voter ∂voterMeasure

/-- The conditional population-sampling identity in the form used for
conditional means of selected-voter statistics. -/
theorem FiniteCoordinateILVConditionalVoterLaw.conditional_integral
    {Voter Coord : Type*} [MeasurableSpace Voter] [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {S : FiniteCoordinateILVRandomSSGMExecution E}
    (L : FiniteCoordinateILVConditionalVoterLaw S)
    (n : ℕ) (test : Voter → ℝ)
    (htest : Integrable test L.voterMeasure)
    (hselected : Integrable (fun omega => test (S.selectedVoter n omega)) S.μ) :
    S.μ[fun omega => test (S.selectedVoter n omega) | S.filtration n] =ᵐ[S.μ]
      fun _ => ∫ voter, test voter ∂L.voterMeasure :=
  L.conditional_integral_eq n test htest hselected

/--
A conditionally fresh ILV voter stream for statistics that depend on the
current iterate.  This is the paper specialization of the shared adapted
conditional-law interface: it is the appropriate sampling hypothesis for the
sampled response direction, whose value depends both on the selected voter and
on the filtration-measurable current point.
-/
structure FiniteCoordinateILVAdaptedConditionalVoterLaw
    {Voter Coord : Type*} [MeasurableSpace Voter] [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSSGMExecution E) extends
    FiniteCoordinateILVConditionalVoterLaw S where
  conditional_integral_eq_adapted : ∀ n (test : S.Ω → Voter → ℝ),
    (∀ voter, StronglyMeasurable[S.filtration n] (fun omega => test omega voter)) →
      Integrable (fun omega => test omega (S.selectedVoter n omega)) S.μ →
        S.μ[fun omega => test omega (S.selectedVoter n omega) | S.filtration n] =ᵐ[S.μ]
          fun omega => ∫ voter, test omega voter ∂voterMeasure

/-- The state-dependent conditional population identity for an ILV voter statistic. -/
theorem FiniteCoordinateILVAdaptedConditionalVoterLaw.conditional_integral
    {Voter Coord : Type*} [MeasurableSpace Voter] [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {S : FiniteCoordinateILVRandomSSGMExecution E}
    (L : FiniteCoordinateILVAdaptedConditionalVoterLaw S)
    (n : ℕ) (test : S.Ω → Voter → ℝ)
    (hadapted : ∀ voter,
      StronglyMeasurable[S.filtration n] (fun omega => test omega voter))
    (hintegrable : Integrable (fun omega => test omega (S.selectedVoter n omega)) S.μ) :
    S.μ[fun omega => test omega (S.selectedVoter n omega) | S.filtration n] =ᵐ[S.μ]
      fun omega => ∫ voter, test omega voter ∂L.voterMeasure :=
  L.conditional_integral_eq_adapted n test hadapted hintegrable

/--
Centering a fresh-voter statistic by its state-dependent population mean has
conditional mean zero.  This is the direct ILV martingale-noise calculation
for one coordinate of a sampled response direction.
-/
theorem FiniteCoordinateILVAdaptedConditionalVoterLaw.condExp_centered_statistic_eq_zero
    {Voter Coord : Type*} [MeasurableSpace Voter] [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {S : FiniteCoordinateILVRandomSSGMExecution E}
    (L : FiniteCoordinateILVAdaptedConditionalVoterLaw S)
    (n : ℕ) (test : S.Ω → Voter → ℝ)
    (hadapted : ∀ voter,
      StronglyMeasurable[S.filtration n] (fun omega => test omega voter))
    (hintegrable : Integrable (fun omega => test omega (S.selectedVoter n omega)) S.μ)
    (hpopulation_measurable : StronglyMeasurable[S.filtration n]
      (fun omega => ∫ voter, test omega voter ∂L.voterMeasure))
    (hpopulation_integrable : Integrable
      (fun omega => ∫ voter, test omega voter ∂L.voterMeasure) S.μ) :
    S.μ[(fun omega => test omega (S.selectedVoter n omega)) -
      (fun omega => ∫ voter, test omega voter ∂L.voterMeasure) | S.filtration n] =ᵐ[S.μ] 0 := by
  letI := S.measurableSpace
  letI := S.probability
  have hpopulation_conditional :
      S.μ[fun omega => ∫ voter, test omega voter ∂L.voterMeasure | S.filtration n] =ᵐ[S.μ]
        fun omega => ∫ voter, test omega voter ∂L.voterMeasure := by
    rw [condExp_of_stronglyMeasurable (S.filtration.le n) hpopulation_measurable
      hpopulation_integrable]
  filter_upwards [
    condExp_sub hintegrable hpopulation_integrable (S.filtration n),
    L.conditional_integral_eq_adapted n test hadapted hintegrable,
    hpopulation_conditional] with omega hsub hsample hpopulation
  rw [hsub]
  simp only [Pi.sub_apply, Pi.zero_apply]
  rw [hsample, hpopulation]
  ring

/--
When an ILV execution records its noise as the realized sampled direction less
the conditional population direction, conditional fresh-voter sampling proves
the coordinatewise martingale-noise condition required by the shared SSGM
convergence theorem.
-/
theorem FiniteCoordinateILVAdaptedConditionalVoterLaw.noise_mean_zero_of_centered_direction
    {Voter Coord : Type*} [MeasurableSpace Voter] [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {S : FiniteCoordinateILVRandomSSGMExecution E}
    (L : FiniteCoordinateILVAdaptedConditionalVoterLaw S)
    (n : ℕ) (i : Coord) (direction : S.Ω → Voter → Coord → ℝ)
    (hadapted : ∀ voter,
      StronglyMeasurable[S.filtration n] (fun omega => direction omega voter i))
    (hintegrable : Integrable
      (fun omega => direction omega (S.selectedVoter n omega) i) S.μ)
    (hpopulation_measurable : StronglyMeasurable[S.filtration n]
      (fun omega => ∫ voter, direction omega voter i ∂L.voterMeasure))
    (hpopulation_integrable : Integrable
      (fun omega => ∫ voter, direction omega voter i ∂L.voterMeasure) S.μ)
    (hnoise : (fun omega => S.noise n omega i) =ᵐ[S.μ]
      (fun omega => direction omega (S.selectedVoter n omega) i) -
        (fun omega => ∫ voter, direction omega voter i ∂L.voterMeasure)) :
    S.μ[fun omega => S.noise n omega i | S.filtration n] =ᵐ[S.μ] 0 := by
  apply (condExp_congr_ae hnoise).trans
  exact L.condExp_centered_statistic_eq_zero n
    (fun omega voter => direction omega voter i) hadapted hintegrable
      hpopulation_measurable hpopulation_integrable

/-- The sampled trajectory in a concrete ILV execution converges a.s. to its social optimum. -/
theorem FiniteCoordinateILVRandomSSGMExecution.ae_tendsto
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSSGMExecution E) :
    ∀ᵐ omega ∂S.μ,
      Filter.Tendsto (fun n => S.trajectory n omega)
        Filter.atTop (nhds S.target) := by
  exact S.toProjectedStochasticSubgradientExecution.ae_tendsto

/-- The random execution converges a.s. to a point identified as socially optimal. -/
theorem FiniteCoordinateILVRandomSSGMExecution.ae_tendsto_socialOptimal
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSSGMExecution E) :
    ∀ᵐ omega ∂S.μ,
      Filter.Tendsto (fun n => S.trajectory n omega)
        Filter.atTop (nhds S.target) ∧ S.target ∈ E.socialOptimal := by
  filter_upwards [S.ae_tendsto] with omega homega
  exact ⟨homega, S.target_socialOptimal⟩

/-- A concrete random ILV execution satisfies the outcome-indexed social-optimality conclusion. -/
theorem FiniteCoordinateILVRandomSSGMExecution.outcomeIndexed_convergesToSocialOptimal
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (S : FiniteCoordinateILVRandomSSGMExecution E) :
    @OutcomeIndexedILVConvergesToSocietalOptimal
      Voter S.Ω (Coord → ℝ) S.measurableSpace inferInstance E S.μ S.trajectory := by
  letI := S.measurableSpace
  exact AppliedModelingLib.Optimization.outcomeIndexedConvergesToSet_of_ae_tendsto
    S.target_socialOptimal S.ae_tendsto

