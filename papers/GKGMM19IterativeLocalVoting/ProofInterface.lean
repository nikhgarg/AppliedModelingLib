/-- A fixed C1 Euclidean diameter bound, chosen from compactness. -/
noncomputable def finiteModelBC1C2L2Diameter
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) : ℝ :=
  Classical.choose (AppliedModelingLib.FiniteDimensionalNorms.exists_l2_diameter_on_isCompact
    S.compact_solutionSpace)

theorem finiteModelBC1C2L2Diameter_nonneg
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    0 ≤ finiteModelBC1C2L2Diameter S :=
  (Classical.choose_spec
    (AppliedModelingLib.FiniteDimensionalNorms.exists_l2_diameter_on_isCompact
      S.compact_solutionSpace)).1

theorem finiteModelBC1C2L2Diameter_bound
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {x y : Coord → ℝ} (hx : x ∈ E.solutionSpace) (hy : y ∈ E.solutionSpace) :
    AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => x i - y i) ≤
      finiteModelBC1C2L2Diameter S :=
  (Classical.choose_spec
    (AppliedModelingLib.FiniteDimensionalNorms.exists_l2_diameter_on_isCompact
      S.compact_solutionSpace)).2 x hx y hy

/-- The joint-law C2 support follows from the C2 support of its ideal marginal. -/
theorem weightedEuclideanJointSample_ideal_mem_solutionSpace_ae_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project) :
    ∀ᵐ sample ∂D.jointMeasure, sample.2 ∈ E.solutionSpace := by
  have hmarginal : ∀ᵐ ideal ∂Measure.map
      (Prod.snd : ((Component → ℝ) × (Coord → ℝ)) → Coord → ℝ)
      D.jointMeasure, ideal ∈ E.solutionSpace := by
    rw [D.ideal_marginal]
    exact S.ideal_mem_solutionSpace_ae
  exact MeasureTheory.ae_of_ae_map measurable_snd.aemeasurable hmarginal

/-- The finite Definition 2 cost is Borel in one joint voter sample. -/
theorem measurable_weightedEuclideanJointSampleCost
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) :
    Measurable (fun sample => weightedEuclideanJointSampleCost D sample state) := by
  unfold weightedEuclideanJointSampleCost
  apply Finset.measurable_sum Finset.univ
  intro k _hk
  apply (D.measurable_sampleWeight k).div D.measurable_sampleWeightNorm2 |>.mul
  exact (measurable_finiteCoordinateBlockL2Distance (D.componentBlock k)).comp
    (measurable_const.prodMk (D.measurable_sampleIdeal k))

/-- A normalized nonnegative Definition 2 weight coefficient is at most one. -/
theorem weightedEuclideanJointSample_normalizedWeight_le_one_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) :
    ∀ᵐ sample ∂D.jointMeasure, ∀ k,
      D.sampleWeight sample k / D.sampleWeightNorm2 sample ≤ 1 := by
  filter_upwards [D.sampleWeight_nonnegative_ae, D.sampleWeightNorm2_pos_ae]
    with sample hweight hnorm
  intro k
  apply (div_le_iff₀ hnorm).2
  simpa [WeightedEuclideanJointSampleData.sampleWeightNorm2,
    abs_of_nonneg (hweight k)] using
    (AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
      (D.sampleWeight sample) k)

/--
C1 and C2 make every exact Definition 2 joint voter cost integrable.  The
proof retains the source's joint within-voter law: it uses only the ideal
marginal to obtain compact support, and never separates weights from ideals.
-/
theorem integrable_weightedEuclideanJointSampleCost_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (state : Coord → ℝ) :
    Integrable (fun sample => weightedEuclideanJointSampleCost D sample state)
      D.jointMeasure := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  rcases AppliedModelingLib.FiniteDimensionalNorms.exists_l2_bound_on_isCompact
    S.compact_solutionSpace state with ⟨C, hC_nonneg, hC⟩
  refine Integrable.mono' (integrable_const ((Fintype.card Component : ℝ) * C))
    (measurable_weightedEuclideanJointSampleCost D state).aestronglyMeasurable ?_
  filter_upwards [
    weightedEuclideanJointSample_ideal_mem_solutionSpace_ae_of_C1C2 S,
    D.normalizedWeight_nonnegative_ae,
    weightedEuclideanJointSample_normalizedWeight_le_one_ae D]
      with sample hideal hcoefficient hcoefficient_le
  have hdistance : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => state i - sample.2 i) ≤ C := by
    have hraw := hC sample.2 hideal
    have hsymm : AppliedModelingLib.FiniteDimensionalNorms.l2
        (fun i => state i - sample.2 i) =
        AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun i => sample.2 i - state i) := by
      unfold AppliedModelingLib.FiniteDimensionalNorms.l2
        AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      congr 1
      apply Finset.sum_congr rfl
      intro i _hi
      ring
    rw [hsymm]
    exact hraw
  have hterm : ∀ k : Component,
      (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
          finiteCoordinateBlockL2Distance (D.componentBlock k) state
            (D.sampleIdeal sample k) ≤ C := by
    intro k
    have hblock_nonneg : 0 ≤ finiteCoordinateBlockL2Distance
        (D.componentBlock k) state (D.sampleIdeal sample k) :=
      AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _
    have hblock_le : finiteCoordinateBlockL2Distance
        (D.componentBlock k) state (D.sampleIdeal sample k) ≤ C := by
      calc
        finiteCoordinateBlockL2Distance (D.componentBlock k) state
            (D.sampleIdeal sample k) ≤
            AppliedModelingLib.FiniteDimensionalNorms.l2
              (fun i => state i - D.sampleIdeal sample k i) :=
          finiteCoordinateBlockL2Distance_le_l2 _ _ _
        _ = AppliedModelingLib.FiniteDimensionalNorms.l2
              (fun i => state i - sample.2 i) := by rfl
        _ ≤ C := hdistance
    calc
      (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
          finiteCoordinateBlockL2Distance (D.componentBlock k) state
            (D.sampleIdeal sample k) ≤
          1 * finiteCoordinateBlockL2Distance (D.componentBlock k) state
            (D.sampleIdeal sample k) :=
        mul_le_mul_of_nonneg_right (hcoefficient_le k) hblock_nonneg
      _ ≤ 1 * C := mul_le_mul_of_nonneg_left hblock_le (by norm_num)
      _ = C := one_mul C
  have hcost_nonneg : 0 ≤ weightedEuclideanJointSampleCost D sample state := by
    unfold weightedEuclideanJointSampleCost
    exact Finset.sum_nonneg fun k _ => mul_nonneg (hcoefficient k)
      (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _)
  have hcost_le : weightedEuclideanJointSampleCost D sample state ≤
      (Fintype.card Component : ℝ) * C := by
    unfold weightedEuclideanJointSampleCost
    calc
      ∑ k ∈ Finset.univ,
          (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
            finiteCoordinateBlockL2Distance (D.componentBlock k) state
              (D.sampleIdeal sample k) ≤ ∑ _k ∈ Finset.univ, C := by
        apply Finset.sum_le_sum
        intro k _hk
        exact hterm k
      _ = (Fintype.card Component : ℝ) * C := by simp
  simpa only [Real.norm_eq_abs, abs_of_nonneg hcost_nonneg] using hcost_le

/--
C1/C2 discharge the finite-valued expectation premise in the Definition 2
expected-subgradient interchange.  In particular, this is a subgradient of
the actual joint voter population cost, rather than of independently sampled
weight and ideal marginals.
-/
theorem weightedEuclideanJointSamplePopulationDirection_subgradient_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (state : Coord → ℝ) :
    FiniteSubgradientAt (weightedEuclideanJointSamplePopulationCost D) state
      (weightedEuclideanJointSamplePopulationDirection D state) := by
  apply weightedEuclideanJointSamplePopulationDirection_subgradient D state
  intro y
  exact integrable_weightedEuclideanJointSampleCost_of_C1C2 S y

/-- A block Euclidean distance is one-Lipschitz in its ambient finite vector. -/
theorem finiteCoordinateBlockL2Distance_le_add_l2
    {Coord : Type*} [Fintype Coord]
    (block : Finset Coord) (state target ideal : Coord → ℝ) :
    finiteCoordinateBlockL2Distance block state ideal ≤
      finiteCoordinateBlockL2Distance block target ideal +
        AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => state i - target i) := by
  unfold finiteCoordinateBlockL2Distance
  calc
    AppliedModelingLib.FiniteDimensionalNorms.l2
        (fun i : {i : Coord // i ∈ block} => state i - ideal i) =
        AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun i : {i : Coord // i ∈ block} =>
            (state i - target i) + (target i - ideal i)) := by
          congr 1
          funext i
          ring
    _ ≤ AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun i : {i : Coord // i ∈ block} => state i - target i) +
        AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun i : {i : Coord // i ∈ block} => target i - ideal i) :=
      AppliedModelingLib.FiniteDimensionalNorms.normL2_add_le _ _
    _ ≤ AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun i : Coord => state i - target i) +
        AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun i : {i : Coord // i ∈ block} => target i - ideal i) := by
      exact add_le_add_left
        (finiteCoordinateBlockL2Distance_le_l2 block state target) _
    _ = AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun i : {i : Coord // i ∈ block} => target i - ideal i) +
        AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun i : Coord => state i - target i) := by ring

/--
Each exact joint Definition 2 cost is Lipschitz in the outcome, with the
finite component count as a uniform (deliberately coarse) constant.
-/
theorem weightedEuclideanJointSampleCost_le_add_card_mul_l2_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state target : Coord → ℝ) :
    ∀ᵐ sample ∂D.jointMeasure,
      weightedEuclideanJointSampleCost D sample state ≤
        weightedEuclideanJointSampleCost D sample target +
          (Fintype.card Component : ℝ) *
            AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => state i - target i) := by
  filter_upwards [D.normalizedWeight_nonnegative_ae,
    weightedEuclideanJointSample_normalizedWeight_le_one_ae D]
      with sample hcoefficient hcoefficient_le
  let distance : ℝ := AppliedModelingLib.FiniteDimensionalNorms.l2
    (fun i => state i - target i)
  have hdistance_nonneg : 0 ≤ distance :=
    AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _
  have hterm : ∀ k : Component,
      (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
          finiteCoordinateBlockL2Distance (D.componentBlock k) state
            (D.sampleIdeal sample k) ≤
        (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
          finiteCoordinateBlockL2Distance (D.componentBlock k) target
            (D.sampleIdeal sample k) + distance := by
    intro k
    have hblock := finiteCoordinateBlockL2Distance_le_add_l2
      (D.componentBlock k) state target (D.sampleIdeal sample k)
    calc
      (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
          finiteCoordinateBlockL2Distance (D.componentBlock k) state
            (D.sampleIdeal sample k) ≤
          (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
            (finiteCoordinateBlockL2Distance (D.componentBlock k) target
              (D.sampleIdeal sample k) + distance) :=
        mul_le_mul_of_nonneg_left hblock (hcoefficient k)
      _ = (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
            finiteCoordinateBlockL2Distance (D.componentBlock k) target
              (D.sampleIdeal sample k) +
            (D.sampleWeight sample k / D.sampleWeightNorm2 sample) * distance := by
          ring
      _ ≤ (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
            finiteCoordinateBlockL2Distance (D.componentBlock k) target
              (D.sampleIdeal sample k) + 1 * distance := by
          exact add_le_add_right
            (mul_le_mul_of_nonneg_right (hcoefficient_le k) hdistance_nonneg) _
      _ = (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
            finiteCoordinateBlockL2Distance (D.componentBlock k) target
              (D.sampleIdeal sample k) + distance := by ring
  unfold weightedEuclideanJointSampleCost
  calc
    ∑ k ∈ Finset.univ,
        (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
          finiteCoordinateBlockL2Distance (D.componentBlock k) state
            (D.sampleIdeal sample k) ≤
        ∑ k ∈ Finset.univ,
          ((D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
            finiteCoordinateBlockL2Distance (D.componentBlock k) target
              (D.sampleIdeal sample k) + distance) := by
      apply Finset.sum_le_sum
      intro k _hk
      exact hterm k
    _ = ∑ k ∈ Finset.univ,
          (D.sampleWeight sample k / D.sampleWeightNorm2 sample) *
            finiteCoordinateBlockL2Distance (D.componentBlock k) target
              (D.sampleIdeal sample k) +
        (Fintype.card Component : ℝ) * distance := by
      rw [Finset.sum_add_distrib]
      simp

/--
The joint Definition 2 population objective inherits the finite block
Lipschitz estimate.  Its use of `jointMeasure` is intentional: no independence
between a voter's weights and ideal point is introduced.
-/
theorem weightedEuclideanJointSamplePopulationCost_le_add_card_mul_l2_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (state target : Coord → ℝ) :
    weightedEuclideanJointSamplePopulationCost D state ≤
      weightedEuclideanJointSamplePopulationCost D target +
        (Fintype.card Component : ℝ) *
          AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => state i - target i) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  let distance : ℝ := AppliedModelingLib.FiniteDimensionalNorms.l2
    (fun i => state i - target i)
  have hstate := integrable_weightedEuclideanJointSampleCost_of_C1C2 S state
  have htarget := integrable_weightedEuclideanJointSampleCost_of_C1C2 S target
  have hbound := weightedEuclideanJointSampleCost_le_add_card_mul_l2_ae
    D state target
  unfold weightedEuclideanJointSamplePopulationCost
  calc
    ∫ sample, weightedEuclideanJointSampleCost D sample state ∂D.jointMeasure ≤
        ∫ sample, weightedEuclideanJointSampleCost D sample target +
          (Fintype.card Component : ℝ) * distance ∂D.jointMeasure :=
      MeasureTheory.integral_mono_ae hstate
        (htarget.add (integrable_const ((Fintype.card Component : ℝ) * distance))
        ) (by simpa [distance] using hbound)
    _ = _ := by
      rw [MeasureTheory.integral_add htarget
        (integrable_const ((Fintype.card Component : ℝ) * distance)),
        MeasureTheory.integral_const]
      simp [distance]

/-- C1/C2 make the exact joint Definition 2 population objective continuous. -/
theorem continuous_weightedEuclideanJointSamplePopulationCost_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project) :
    Continuous (weightedEuclideanJointSamplePopulationCost D) := by
  letI : Nonempty Component := D.component_nonempty
  have hcard_nat : 0 < Fintype.card Component := Fintype.card_pos_iff.mpr inferInstance
  have hcard_pos : 0 < (Fintype.card Component : ℝ) := by
    exact_mod_cast hcard_nat
  rw [continuous_iff_continuousAt]
  intro state
  rw [Metric.continuousAt_iff]
  intro epsilon hepsilon
  rcases Metric.continuousAt_iff.mp
      (AppliedModelingLib.FiniteDimensionalNorms.continuous_l2_sub state).continuousAt
      (epsilon / Fintype.card Component) (div_pos hepsilon hcard_pos) with
      ⟨delta, hdelta, hclose⟩
  refine ⟨delta, hdelta, ?_⟩
  intro target htarget
  have hdistance_raw := hclose htarget
  have hdistance : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => target i - state i) < epsilon / Fintype.card Component := by
    simpa [AppliedModelingLib.FiniteDimensionalNorms.normL2_zero,
      Real.dist_eq,
      abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _)] using
      hdistance_raw
  have hscaled : (Fintype.card Component : ℝ) *
      AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => target i - state i) < epsilon :=
    by simpa [mul_comm] using (lt_div_iff₀ hcard_pos).mp hdistance
  rw [Real.dist_eq]
  have hforward :=
    weightedEuclideanJointSamplePopulationCost_le_add_card_mul_l2_of_C1C2
      S target state
  have hbackward :=
    weightedEuclideanJointSamplePopulationCost_le_add_card_mul_l2_of_C1C2
      S state target
  have hsymm : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => state i - target i) =
      AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => target i - state i) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    congr 1
    apply Finset.sum_congr rfl
    intro i _hi
    ring
  rw [hsymm] at hbackward
  rw [abs_lt]
  constructor <;> linarith

/-- C1 compactness converts the joint objective's finite Lipschitz estimate into a gap bound. -/
theorem weightedEuclideanJointSamplePopulationCost_gap_abs_le_card_mul_l2Diameter_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    {state target : Coord → ℝ}
    (hstate : state ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace) :
    |weightedEuclideanJointSamplePopulationCost D state -
        weightedEuclideanJointSamplePopulationCost D target| ≤
      (Fintype.card Component : ℝ) * finiteModelBC1C2L2Diameter S := by
  have hforward :=
    weightedEuclideanJointSamplePopulationCost_le_add_card_mul_l2_of_C1C2
      S state target
  have hbackward :=
    weightedEuclideanJointSamplePopulationCost_le_add_card_mul_l2_of_C1C2
      S target state
  have hstate_target : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => state i - target i) ≤ finiteModelBC1C2L2Diameter S :=
    finiteModelBC1C2L2Diameter_bound S hstate htarget
  have htarget_state : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => target i - state i) ≤ finiteModelBC1C2L2Diameter S := by
    have hsymm : AppliedModelingLib.FiniteDimensionalNorms.l2
        (fun i => target i - state i) =
        AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => state i - target i) := by
      unfold AppliedModelingLib.FiniteDimensionalNorms.l2
        AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      congr 1
      apply Finset.sum_congr rfl
      intro i _hi
      ring
    rw [hsymm]
    exact hstate_target
  rw [abs_le]
  constructor
  · nlinarith [mul_le_mul_of_nonneg_left hbackward
      (by positivity : (0 : ℝ) ≤ Fintype.card Component)]
  · nlinarith [mul_le_mul_of_nonneg_left hforward
      (by positivity : (0 : ℝ) ≤ Fintype.card Component)]

/-- The exact joint objective is strongly measurable along the canonical iid past. -/
theorem stronglyMeasurable_weightedEuclideanJointSamplePopulationCost_natural
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (r0 : ℝ) (initial : Coord → ℝ) (n : ℕ) :
    StronglyMeasurable[
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n]
      (fun omega => weightedEuclideanJointSamplePopulationCost D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)) := by
  have hcost : StronglyMeasurable (weightedEuclideanJointSamplePopulationCost D) :=
    (continuous_weightedEuclideanJointSamplePopulationCost_of_C1C2 S).measurable.stronglyMeasurable
  exact hcost.comp_measurable
    (stronglyMeasurable_weightedEuclideanJointSampleOutcomeTrajectory_natural
      D r0 project initial S.project_measurable n).measurable

/-- Joint population objective gaps are adapted to the canonical iid past. -/
theorem stronglyAdapted_weightedEuclideanJointSamplePopulationCost_gap_natural
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (r0 : ℝ) (initial target : Coord → ℝ) :
    StronglyAdapted
      (AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)))
      (fun n omega => weightedEuclideanJointSamplePopulationCost D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) -
          weightedEuclideanJointSamplePopulationCost D target) := by
  intro n
  exact (stronglyMeasurable_weightedEuclideanJointSamplePopulationCost_natural
    S r0 initial n).sub stronglyMeasurable_const

/-- The exact feasible minimizer set for the joint Definition 2 population cost. -/
def weightedEuclideanJointSamplePopulationMinimizerSet
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (solutionSpace : Set (Coord → ℝ)) : Set (Coord → ℝ) :=
  {x | x ∈ solutionSpace ∧
    IsMinOn (weightedEuclideanJointSamplePopulationCost D) solutionSpace x}

/--
The societal utility determined by Definition 2's joint voter law: the
expected sampled utility.
-/
noncomputable def weightedEuclideanJointSamplePopulationSocialUtility
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) :
    (Coord → ℝ) → ℝ :=
  fun state => ∫ sample, weightedEuclideanJointSampleUtility D sample state ∂D.jointMeasure

/-- The Definition 2 expected utility is the negative population cost. -/
theorem weightedEuclideanJointSamplePopulationSocialUtility_eq_neg_populationCost
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) (state : Coord → ℝ) :
    weightedEuclideanJointSamplePopulationSocialUtility D state =
      -weightedEuclideanJointSamplePopulationCost D state := by
  simp only [weightedEuclideanJointSamplePopulationSocialUtility,
    weightedEuclideanJointSampleUtility_eq_neg_cost,
    weightedEuclideanJointSamplePopulationCost, integral_neg]

/-- The social-optimal set for the directly defined Definition 2 social utility. -/
def weightedEuclideanJointSamplePopulationSocialOptimalSet
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (solutionSpace : Set (Coord → ℝ)) : Set (Coord → ℝ) :=
  {x | x ∈ solutionSpace ∧
    IsMaxOn (weightedEuclideanJointSamplePopulationSocialUtility D) solutionSpace x}

/-- Maximizing Definition 2's expected utility is exactly minimizing its population cost. -/
theorem weightedEuclideanJointSamplePopulationSocialOptimalSet_eq_minimizerSet
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (solutionSpace : Set (Coord → ℝ)) :
    weightedEuclideanJointSamplePopulationSocialOptimalSet D solutionSpace =
      weightedEuclideanJointSamplePopulationMinimizerSet D solutionSpace := by
  ext state
  simp only [weightedEuclideanJointSamplePopulationSocialOptimalSet,
    weightedEuclideanJointSamplePopulationMinimizerSet, Set.mem_setOf_eq]
  constructor
  · rintro ⟨hstate, hmax⟩
    refine ⟨hstate, isMinOn_iff.mpr ?_⟩
    intro candidate hcandidate
    have hvalue := isMaxOn_iff.mp hmax candidate hcandidate
    rw [weightedEuclideanJointSamplePopulationSocialUtility_eq_neg_populationCost,
      weightedEuclideanJointSamplePopulationSocialUtility_eq_neg_populationCost] at hvalue
    linarith
  · rintro ⟨hstate, hmin⟩
    refine ⟨hstate, isMaxOn_iff.mpr ?_⟩
    intro candidate hcandidate
    have hvalue := isMinOn_iff.mp hmin candidate hcandidate
    rw [weightedEuclideanJointSamplePopulationSocialUtility_eq_neg_populationCost,
      weightedEuclideanJointSamplePopulationSocialUtility_eq_neg_populationCost]
    linarith

/-- C1 compactness supplies a genuine minimizer of the joint Definition 2 cost. -/
theorem weightedEuclideanJointSamplePopulationMinimizerSet_nonempty_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project) :
    (weightedEuclideanJointSamplePopulationMinimizerSet D E.solutionSpace).Nonempty := by
  rcases S.compact_solutionSpace.exists_isMinOn S.solutionSpace_nonempty
    (continuous_weightedEuclideanJointSamplePopulationCost_of_C1C2 S).continuousOn with
      ⟨reference, href, hmin⟩
  exact ⟨reference, href, hmin⟩

/-- A fixed C1 minimizer of the exact joint Definition 2 population objective. -/
noncomputable def weightedEuclideanJointSamplePopulationReference
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project) : Coord → ℝ :=
  Classical.choose (weightedEuclideanJointSamplePopulationMinimizerSet_nonempty_of_C1C2 S)

theorem weightedEuclideanJointSamplePopulationReference_mem_minimizerSet
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project) :
    weightedEuclideanJointSamplePopulationReference S ∈
      weightedEuclideanJointSamplePopulationMinimizerSet D E.solutionSpace :=
  Classical.choose_spec
    (weightedEuclideanJointSamplePopulationMinimizerSet_nonempty_of_C1C2 S)

/-- Every coordinate of the joint Definition 2 population direction is bounded by one. -/
theorem weightedEuclideanJointSamplePopulationDirection_coord_abs_le_one
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (i : Coord) :
    |weightedEuclideanJointSamplePopulationDirection D state i| ≤ 1 := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : Nonempty Coord := D.coordinate_nonempty
  rw [weightedEuclideanJointSamplePopulationDirection]
  have hbound : ∀ᵐ sample ∂D.jointMeasure,
      ‖weightedEuclideanJointSampleDirection D state sample i‖ ≤ 1 := by
    filter_upwards [weightedEuclideanJointSampleDirection_l2_eq_one_ae D state]
      with sample hunit
    have hcoordinate := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
      (weightedEuclideanJointSampleDirection D state sample) i
    calc
      ‖weightedEuclideanJointSampleDirection D state sample i‖ =
          |weightedEuclideanJointSampleDirection D state sample i| := Real.norm_eq_abs _
      _ ≤ AppliedModelingLib.FiniteDimensionalNorms.l2
          (weightedEuclideanJointSampleDirection D state sample) := hcoordinate
      _ = 1 := by simpa only [finiteCoordinateNorm_l2] using hunit
  have hintegral := norm_integral_le_of_norm_le_const hbound
  simpa using hintegral

/-- Every coordinate of a fixed-state joint sampled direction is bounded by one a.e. -/
theorem weightedEuclideanJointSampleDirection_coord_abs_le_one_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) (i : Coord) :
    ∀ᵐ sample ∂D.jointMeasure,
      |weightedEuclideanJointSampleDirection D state sample i| ≤ 1 := by
  letI : Nonempty Coord := D.coordinate_nonempty
  filter_upwards [weightedEuclideanJointSampleDirection_l2_eq_one_ae D state]
    with sample hunit
  calc
    |weightedEuclideanJointSampleDirection D state sample i| ≤
        AppliedModelingLib.FiniteDimensionalNorms.l2
          (weightedEuclideanJointSampleDirection D state sample) :=
      AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le _ i
    _ = 1 := by simpa only [finiteCoordinateNorm_l2] using hunit

/--
The finite-past/fresh-sample joint direction statistic is integrable.  This
is the concrete product-law input for its conditional-expectation identity.
-/
theorem integrable_weightedEuclideanJointSampleOutcomePrefixTrajectory_direction_coordinate
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    Integrable (fun z :
      (Fin (n + 1) → (Component → ℝ) × (Coord → ℝ)) ×
        ((Component → ℝ) × (Coord → ℝ)) =>
      weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleOutcomePrefixTrajectory D r0 project initial n z.1)
        z.2 i)
      (Measure.map (fun omega =>
        (AppliedModelingLib.iidSequencePastPrefix n omega,
          AppliedModelingLib.iidSequenceSample n omega))
        (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  let pair : (ℕ → (Component → ℝ) × (Coord → ℝ)) →
      (Fin (n + 1) → (Component → ℝ) × (Coord → ℝ)) ×
        ((Component → ℝ) × (Coord → ℝ)) := fun omega =>
    (AppliedModelingLib.iidSequencePastPrefix n omega, AppliedModelingLib.iidSequenceSample n omega)
  have hpair : Measurable pair :=
    (AppliedModelingLib.measurable_iidSequencePastPrefix n).prodMk
      (AppliedModelingLib.measurable_iidSequenceSample n)
  letI : IsProbabilityMeasure
      (Measure.map pair (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)) :=
    Measure.isProbabilityMeasure_map hpair.aemeasurable
  let test : (Fin (n + 1) → (Component → ℝ) × (Coord → ℝ)) ×
      ((Component → ℝ) × (Coord → ℝ)) → ℝ := fun z =>
    weightedEuclideanJointSampleDirection D
      (weightedEuclideanJointSampleOutcomePrefixTrajectory D r0 project initial n z.1)
      z.2 i
  have hprefix := measurable_weightedEuclideanJointSampleOutcomePrefixTrajectory
    D r0 project initial hproject n
  have htest : Measurable test := by
    exact (measurable_pi_apply i).comp
      ((measurable_weightedEuclideanL2BlockSampleDirection Finset.univ
        D.componentBlock D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal
        D.measurable_sampleWeight D.measurable_sampleWeightNorm2
          D.measurable_sampleIdeal).comp
        ((hprefix.comp measurable_fst).prodMk measurable_snd))
  change Integrable test (Measure.map pair (AppliedModelingLib.iidSequenceMeasure D.jointMeasure))
  refine Integrable.mono' (integrable_const (1 : ℝ)) htest.aestronglyMeasurable ?_
  let pastMeasure := Measure.map (AppliedModelingLib.iidSequencePastPrefix n)
    (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)
  have hmeasSet : MeasurableSet {z |
      ‖test z‖ ≤ 1} := by
    simpa only [Set.preimage_setOf_eq, Set.mem_Iic] using
      (continuous_norm.measurable.comp htest) measurableSet_Iic
  have hproduct_bound : ∀ᵐ z ∂pastMeasure.prod D.jointMeasure,
      ‖test z‖ ≤ 1 := by
    rw [Measure.ae_prod_iff_ae_ae hmeasSet]
    exact Filter.Eventually.of_forall fun past => by
      simpa [test, Real.norm_eq_abs] using
        weightedEuclideanJointSampleDirection_coord_abs_le_one_ae D
          (weightedEuclideanJointSampleOutcomePrefixTrajectory D r0 project initial n past) i
  have hpair_bound : ∀ᵐ z ∂Measure.map pair
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure), ‖test z‖ ≤ 1 := by
    rw [AppliedModelingLib.iidSequencePastPrefix_sample_pair_law D.jointMeasure n]
    exact hproduct_bound
  exact hpair_bound

/-- The joint Definition 2 population direction has a finite uniform `L2` bound. -/
theorem weightedEuclideanJointSamplePopulationDirection_l2_le_card
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (state : Coord → ℝ) :
    AppliedModelingLib.FiniteDimensionalNorms.l2
      (weightedEuclideanJointSamplePopulationDirection D state) ≤ Fintype.card Coord := by
  letI : Nonempty Coord := D.coordinate_nonempty
  have hsq : AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (weightedEuclideanJointSamplePopulationDirection D state) ≤ Fintype.card Coord := by
    have hnorm := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_card_mul_sq_of_abs_le
      (weightedEuclideanJointSamplePopulationDirection D state)
      (by norm_num : (0 : ℝ) ≤ 1)
      (weightedEuclideanJointSamplePopulationDirection_coord_abs_le_one D state)
    norm_num at hnorm ⊢
    exact hnorm
  have hcard_nat : 1 ≤ Fintype.card Coord := by
    have hpos : 0 < Fintype.card Coord := Fintype.card_pos_iff.mpr inferInstance
    omega
  have hcard : (1 : ℝ) ≤ Fintype.card Coord := by
    exact_mod_cast hcard_nat
  rw [← AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq] at hsq
  nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg
    (weightedEuclideanJointSamplePopulationDirection D state)]

/-- The exact joint-law population direction is Borel in the current outcome. -/
theorem measurable_weightedEuclideanJointSamplePopulationDirection
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component) :
    Measurable (weightedEuclideanJointSamplePopulationDirection D) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  apply measurable_pi_lambda
  intro i
  have hcoordinate : StronglyMeasurable (fun z :
      (Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ)) =>
      weightedEuclideanJointSampleDirection D z.1 z.2 i) :=
    ((measurable_pi_apply i).comp
      (measurable_weightedEuclideanL2BlockSampleDirection Finset.univ
        D.componentBlock D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal
        D.measurable_sampleWeight D.measurable_sampleWeightNorm2
          D.measurable_sampleIdeal)).stronglyMeasurable
  simpa only [weightedEuclideanJointSamplePopulationDirection] using
    hcoordinate.integral_prod_right.measurable

/-- The exact joint-law population direction is adapted to the canonical iid past. -/
theorem stronglyMeasurable_weightedEuclideanJointSamplePopulationDirection_coordinate_natural
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    StronglyMeasurable[
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n]
      (fun omega => weightedEuclideanJointSamplePopulationDirection D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i) := by
  have hpopulation : StronglyMeasurable (fun state : Coord → ℝ =>
      weightedEuclideanJointSamplePopulationDirection D state i) :=
    ((measurable_pi_apply i).comp
      (measurable_weightedEuclideanJointSamplePopulationDirection D)).stronglyMeasurable
  exact hpopulation.comp_measurable
    (stronglyMeasurable_weightedEuclideanJointSampleOutcomeTrajectory_natural
      D r0 project initial hproject n).measurable

/-- The centered sampled-minus-population gradient noise of the canonical joint run. -/
noncomputable def weightedEuclideanJointSampleOutcomeGradientNoise
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → (Component → ℝ) × (Coord → ℝ)) : Coord → ℝ :=
  fun i => weightedEuclideanJointSampleDirection D
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
      (AppliedModelingLib.iidSequenceSample n omega) i -
    weightedEuclideanJointSamplePopulationDirection D
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i

/-- The canonical joint sampled-minus-population noise is Borel measurable. -/
theorem measurable_weightedEuclideanJointSampleOutcomeGradientNoise
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Measurable (weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n) := by
  apply measurable_pi_lambda
  intro i
  unfold weightedEuclideanJointSampleOutcomeGradientNoise
  have hstate : Measurable
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n) :=
    (stronglyMeasurable_weightedEuclideanJointSampleOutcomeTrajectory_natural
      D r0 project initial hproject n).measurable.mono
        ((AppliedModelingLib.iidSequenceNaturalFiltration
          (α := (Component → ℝ) × (Coord → ℝ))).le n) le_rfl
  have hsample : Measurable (fun omega => weightedEuclideanJointSampleDirection D
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
      (AppliedModelingLib.iidSequenceSample n omega) i) :=
    (measurable_pi_apply i).comp
      ((measurable_weightedEuclideanL2BlockSampleDirection Finset.univ
        D.componentBlock D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal
        D.measurable_sampleWeight D.measurable_sampleWeightNorm2
          D.measurable_sampleIdeal).comp
        (hstate.prodMk (AppliedModelingLib.measurable_iidSequenceSample n)))
  have hpopulation : Measurable (fun omega =>
      weightedEuclideanJointSamplePopulationDirection D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i) :=
    (stronglyMeasurable_weightedEuclideanJointSamplePopulationDirection_coordinate_natural
      D r0 project initial hproject n i).measurable.mono
        ((AppliedModelingLib.iidSequenceNaturalFiltration
          (α := (Component → ℝ) × (Coord → ℝ))).le n) le_rfl
  exact hsample.sub hpopulation

/-- Each coordinate of the canonical joint gradient noise is bounded by two a.e. -/
theorem weightedEuclideanJointSampleOutcomeGradientNoise_coord_abs_le_two_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure,
      |weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega i| ≤ 2 := by
  letI : Nonempty Coord := D.coordinate_nonempty
  filter_upwards [
    weightedEuclideanJointSampleOutcomeTrajectory_sampledDirection_l2_eq_one_ae
      D r0 project initial hproject n] with omega hunit
  unfold weightedEuclideanJointSampleOutcomeGradientNoise
  have hsample_coordinate := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
    (weightedEuclideanJointSampleDirection D
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
      (AppliedModelingLib.iidSequenceSample n omega)) i
  have hsample : |weightedEuclideanJointSampleDirection D
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
      (AppliedModelingLib.iidSequenceSample n omega) i| ≤ 1 := by
    calc
      _ ≤ AppliedModelingLib.FiniteDimensionalNorms.l2
        (weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega)) := hsample_coordinate
      _ = 1 := by simpa only [finiteCoordinateNorm_l2] using hunit
  have hpopulation := weightedEuclideanJointSamplePopulationDirection_coord_abs_le_one
    D (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i
  calc
    |weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) i -
      weightedEuclideanJointSamplePopulationDirection D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i| ≤
        |weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega) i| +
          |weightedEuclideanJointSamplePopulationDirection D
            (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i| :=
      by
        simpa using abs_sub_le
          (weightedEuclideanJointSampleDirection D
            (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
            (AppliedModelingLib.iidSequenceSample n omega) i)
          0
          (weightedEuclideanJointSamplePopulationDirection D
            (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i)
    _ ≤ 2 := by linarith

/-- Every coordinate of the canonical joint gradient noise is integrable. -/
theorem integrable_weightedEuclideanJointSampleOutcomeGradientNoise_coordinate
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    Integrable (fun omega =>
      weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega i)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  refine Integrable.mono' (integrable_const (2 : ℝ))
    ((measurable_pi_apply i).comp
      (measurable_weightedEuclideanJointSampleOutcomeGradientNoise
        D r0 project initial hproject n)).aestronglyMeasurable ?_
  filter_upwards [
    weightedEuclideanJointSampleOutcomeGradientNoise_coord_abs_le_two_ae
      D r0 project initial hproject n i] with omega hbound
  simpa only [Real.norm_eq_abs] using hbound

/-- The current joint sampled-direction coordinate has the population conditional mean. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_direction_condExp_ae_eq_population
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)[
      fun omega => weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) i |
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n] =ᵐ[
          AppliedModelingLib.iidSequenceMeasure D.jointMeasure]
      fun omega => weightedEuclideanJointSamplePopulationDirection D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i := by
  simpa only [weightedEuclideanJointSamplePopulationDirection] using
    (weightedEuclideanJointSampleOutcomeTrajectory_condExp_ae_eq_integral
      D r0 project initial n
      (fun state sample => weightedEuclideanJointSampleDirection D state sample i)
      (integrable_weightedEuclideanJointSampleOutcomePrefixTrajectory_direction_coordinate
        D r0 project initial hproject n i))

/-- Prefix-product integrability transfers to the realized current joint direction. -/
theorem integrable_weightedEuclideanJointSampleOutcomeTrajectory_direction_coordinate_of_prefix
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    Integrable (fun omega => weightedEuclideanJointSampleDirection D
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
      (AppliedModelingLib.iidSequenceSample n omega) i)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  let pair : (ℕ → (Component → ℝ) × (Coord → ℝ)) →
      (Fin (n + 1) → (Component → ℝ) × (Coord → ℝ)) ×
        ((Component → ℝ) × (Coord → ℝ)) := fun omega =>
    (AppliedModelingLib.iidSequencePastPrefix n omega, AppliedModelingLib.iidSequenceSample n omega)
  have hpair : Measurable pair :=
    (AppliedModelingLib.measurable_iidSequencePastPrefix n).prodMk
      (AppliedModelingLib.measurable_iidSequenceSample n)
  have hcomposed : Integrable (fun omega =>
      weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleOutcomePrefixTrajectory D r0 project initial n
          (AppliedModelingLib.iidSequencePastPrefix n omega))
        (AppliedModelingLib.iidSequenceSample n omega) i)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
    exact (integrable_map_measure
      (integrable_weightedEuclideanJointSampleOutcomePrefixTrajectory_direction_coordinate
        D r0 project initial hproject n i).1 hpair.aemeasurable).mp
      (integrable_weightedEuclideanJointSampleOutcomePrefixTrajectory_direction_coordinate
        D r0 project initial hproject n i)
  apply hcomposed.congr
  filter_upwards [] with omega
  rw [weightedEuclideanJointSampleOutcomePrefixTrajectory_pastPrefix_eq]

/-- The adapted joint population-direction coordinate is integrable. -/
theorem integrable_weightedEuclideanJointSamplePopulationDirection_coordinate
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    Integrable (fun omega => weightedEuclideanJointSamplePopulationDirection D
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  refine Integrable.mono' (integrable_const (1 : ℝ))
    ((stronglyMeasurable_weightedEuclideanJointSamplePopulationDirection_coordinate_natural
      D r0 project initial hproject n i).measurable.mono
        ((AppliedModelingLib.iidSequenceNaturalFiltration
          (α := (Component → ℝ) × (Coord → ℝ))).le n) le_rfl).aestronglyMeasurable ?_
  filter_upwards [] with omega
  simpa only [Real.norm_eq_abs] using
    weightedEuclideanJointSamplePopulationDirection_coord_abs_le_one D
      (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i

/-- The centered canonical joint direction has conditional mean zero. -/
theorem weightedEuclideanJointSampleOutcomeGradientNoise_condExp_ae_eq_zero
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)[
      fun omega => weightedEuclideanJointSampleOutcomeGradientNoise
        D r0 project initial n omega i |
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n] =ᵐ[
          AppliedModelingLib.iidSequenceMeasure D.jointMeasure] 0 := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  have hsample :=
    integrable_weightedEuclideanJointSampleOutcomeTrajectory_direction_coordinate_of_prefix
      D r0 project initial hproject n i
  have hpopulation := integrable_weightedEuclideanJointSamplePopulationDirection_coordinate
    D r0 project initial hproject n i
  have hpopulation_conditional :
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)[
        fun omega => weightedEuclideanJointSamplePopulationDirection D
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i |
        AppliedModelingLib.iidSequenceNaturalFiltration
          (α := (Component → ℝ) × (Coord → ℝ)) n] =ᵐ[
            AppliedModelingLib.iidSequenceMeasure D.jointMeasure]
        fun omega => weightedEuclideanJointSamplePopulationDirection D
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i := by
    rw [condExp_of_stronglyMeasurable
      ((AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ))).le n)
      (stronglyMeasurable_weightedEuclideanJointSamplePopulationDirection_coordinate_natural
        D r0 project initial hproject n i) hpopulation]
  change (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)[
      (fun omega => weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) i) -
        (fun omega => weightedEuclideanJointSamplePopulationDirection D
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i) |
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n] =ᵐ[
          AppliedModelingLib.iidSequenceMeasure D.jointMeasure] 0
  filter_upwards [
    condExp_sub hsample hpopulation
      (AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n),
    weightedEuclideanJointSampleOutcomeTrajectory_direction_condExp_ae_eq_population
      D r0 project initial hproject n i,
    hpopulation_conditional] with omega hsub hsample hpopulation
  rw [hsub]
  simp only [Pi.sub_apply, Pi.zero_apply]
  rw [hsample, hpopulation]
  ring

/-- The canonical joint gradient-noise energy is bounded by four times dimension. -/
theorem weightedEuclideanJointSampleOutcomeGradientNoise_l2Sq_le_four_card_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure,
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega) ≤
          4 * Fintype.card Coord := by
  letI : Nonempty Coord := D.coordinate_nonempty
  filter_upwards [
    weightedEuclideanJointSampleOutcomeTrajectory_sampledDirection_l2_eq_one_ae
      D r0 project initial hproject n] with omega hunit
  have hsample_coordinate : ∀ i,
      |weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) i| ≤ 1 := by
    intro i
    calc
      _ ≤ AppliedModelingLib.FiniteDimensionalNorms.l2
        (weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega)) :=
        AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le _ i
      _ = 1 := by simpa only [finiteCoordinateNorm_l2] using hunit
  have hnoise_coordinate : ∀ i,
      |weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega i| ≤ 2 := by
    intro i
    unfold weightedEuclideanJointSampleOutcomeGradientNoise
    have hpopulation := weightedEuclideanJointSamplePopulationDirection_coord_abs_le_one
      D (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i
    calc
      |weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega) i -
        weightedEuclideanJointSamplePopulationDirection D
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i| ≤
          |weightedEuclideanJointSampleDirection D
            (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
            (AppliedModelingLib.iidSequenceSample n omega) i| +
            |weightedEuclideanJointSamplePopulationDirection D
              (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i| := by
        simpa using abs_sub_le
          (weightedEuclideanJointSampleDirection D
            (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
            (AppliedModelingLib.iidSequenceSample n omega) i)
          0
          (weightedEuclideanJointSamplePopulationDirection D
            (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i)
      _ ≤ 2 := by linarith [hsample_coordinate i]
  have hbound := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_card_mul_sq_of_abs_le
    (weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega)
    (by norm_num : (0 : ℝ) ≤ 2) hnoise_coordinate
  norm_num at hbound ⊢
  simpa [mul_comm] using hbound

/-- The canonical joint gradient-noise energy is integrable. -/
theorem integrable_weightedEuclideanJointSampleOutcomeGradientNoise_l2Sq
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Integrable (fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega))
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  refine Integrable.mono' (integrable_const (4 * (Fintype.card Coord : ℝ)))
    (hl2sq.comp (measurable_weightedEuclideanJointSampleOutcomeGradientNoise
      D r0 project initial hproject n)).aestronglyMeasurable ?_
  filter_upwards [
    weightedEuclideanJointSampleOutcomeGradientNoise_l2Sq_le_four_card_ae
      D r0 project initial hproject n] with omega hbound
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hbound

/-- The natural-filtration conditional joint gradient-noise energy has the same bound. -/
theorem weightedEuclideanJointSampleOutcomeGradientNoise_condExp_l2Sq_le_four_card
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)[
      fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega) |
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n] ≤ᵐ[
          AppliedModelingLib.iidSequenceMeasure D.jointMeasure] fun _ => 4 * Fintype.card Coord := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  have henergy := integrable_weightedEuclideanJointSampleOutcomeGradientNoise_l2Sq
    D r0 project initial hproject n
  have hbound := weightedEuclideanJointSampleOutcomeGradientNoise_l2Sq_le_four_card_ae
    D r0 project initial hproject n
  have hcond := condExp_mono
    (m := AppliedModelingLib.iidSequenceNaturalFiltration
      (α := (Component → ℝ) × (Coord → ℝ)) n)
    henergy (integrable_const (4 * (Fintype.card Coord : ℝ))) hbound
  rw [condExp_const
    ((AppliedModelingLib.iidSequenceNaturalFiltration
      (α := (Component → ℝ) × (Coord → ℝ))).le n)
    (4 * (Fintype.card Coord : ℝ))] at hcond
  exact hcond

/-- C1/C2 provide bounded population subgradients for the exact joint objective. -/
theorem weightedEuclideanJointSamplePopulationDirection_exists_bounded_subgradientOn_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project) :
    ∀ state, state ∈ E.solutionSpace → ∃ g,
      AppliedModelingLib.Optimization.FiniteSubgradientOn
        (weightedEuclideanJointSamplePopulationCost D) E.solutionSpace state g ∧
        AppliedModelingLib.FiniteDimensionalNorms.l2 g ≤ Fintype.card Coord := by
  intro state hstate
  refine ⟨weightedEuclideanJointSamplePopulationDirection D state, ?_, ?_⟩
  · intro y _hy
    exact weightedEuclideanJointSamplePopulationDirection_subgradient_of_C1C2 S state y
  · exact weightedEuclideanJointSamplePopulationDirection_l2_le_card D state

/-- Every canonical joint-sample Definition 2 iterate remains C1 feasible. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_mem_solutionSpace_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (r0 : ℝ) (initial : Coord → ℝ) (hinitial : initial ∈ E.solutionSpace) :
    ∀ n omega,
      weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega ∈
        E.solutionSpace := by
  intro n
  induction n with
  | zero =>
      intro _omega
      exact hinitial
  | succ n ih =>
