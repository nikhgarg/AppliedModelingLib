/-- A fixed positive-`Lp` C1 diameter bound, chosen from compactness. -/
noncomputable def finiteModelBC1C2LpDiameter
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (p : ℝ) (hp : 0 < p) : ℝ :=
  Classical.choose (AppliedModelingLib.FiniteDimensionalNorms.exists_lp_diameter_on_isCompact
    S.compact_solutionSpace hp.le)

theorem finiteModelBC1C2LpDiameter_nonneg
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (p : ℝ) (hp : 0 < p) :
    0 ≤ finiteModelBC1C2LpDiameter S p hp :=
  (Classical.choose_spec
    (AppliedModelingLib.FiniteDimensionalNorms.exists_lp_diameter_on_isCompact
      S.compact_solutionSpace hp.le)).1

theorem finiteModelBC1C2LpDiameter_bound
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (p : ℝ) (hp : 0 < p)
    {x y : Coord → ℝ} (hx : x ∈ E.solutionSpace) (hy : y ∈ E.solutionSpace) :
    AppliedModelingLib.FiniteDimensionalNorms.lp p (fun i => x i - y i) ≤
      finiteModelBC1C2LpDiameter S p hp :=
  (Classical.choose_spec
    (AppliedModelingLib.FiniteDimensionalNorms.exists_lp_diameter_on_isCompact
      S.compact_solutionSpace hp.le)).2 x hx y hy

/--
C2 support and compact C1 geometry make every finite positive-`Lp` sample
cost integrable.  The bound depends on the evaluation point, as required for
the expected-subgradient interchange.
-/
theorem integrable_finiteModelBLpCost_of_C1C2
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {p : ℝ} (hp : 0 < p) (state : Coord → ℝ) :
    Integrable (fun ideal => AppliedModelingLib.FiniteDimensionalNorms.lp p
      (fun j => state j - ideal j)) D.idealMeasure := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  rcases AppliedModelingLib.FiniteDimensionalNorms.exists_lp_bound_on_isCompact
    S.compact_solutionSpace hp.le state with ⟨C, hC_nonneg, hbound⟩
  have hmeas : Measurable (fun ideal : Coord → ℝ =>
      AppliedModelingLib.FiniteDimensionalNorms.lp p (fun j => state j - ideal j)) := by
    apply (AppliedModelingLib.FiniteDimensionalNorms.continuous_lp hp.le).measurable.comp
    apply measurable_pi_lambda _
    intro j
    exact measurable_const.sub (measurable_pi_apply j)
  refine Integrable.mono' (integrable_const C) hmeas.aestronglyMeasurable ?_
  filter_upwards [S.ideal_mem_solutionSpace_ae] with ideal hideal
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.lp_nonneg p _)] using
      hbound ideal hideal

/-- C1/C2 also make every finite `L∞` sample cost integrable. -/
theorem integrable_finiteModelBLinfCost_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (state : Coord → ℝ) :
    Integrable (fun ideal => AppliedModelingLib.FiniteDimensionalNorms.linf
      (fun j => state j - ideal j)) D.idealMeasure := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  rcases AppliedModelingLib.FiniteDimensionalNorms.exists_l2_bound_on_isCompact
    S.compact_solutionSpace state with ⟨C, hC_nonneg, hbound⟩
  have hmeas : Measurable (fun ideal : Coord → ℝ =>
      AppliedModelingLib.FiniteDimensionalNorms.linf (fun j => state j - ideal j)) := by
    apply AppliedModelingLib.FiniteDimensionalNorms.continuous_linf.measurable.comp
    apply measurable_pi_lambda _
    intro j
    exact measurable_const.sub (measurable_pi_apply j)
  refine Integrable.mono' (integrable_const C) hmeas.aestronglyMeasurable ?_
  filter_upwards [S.ideal_mem_solutionSpace_ae] with ideal hideal
  have hlinf_le_l2 := AppliedModelingLib.FiniteDimensionalNorms.linf_le_l2
    (fun j => state j - ideal j)
  have hl2 := hbound ideal hideal
  have hl2_symm : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun j => state j - ideal j) =
      AppliedModelingLib.FiniteDimensionalNorms.l2 (fun j => ideal j - state j) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    congr 1
    apply Finset.sum_congr rfl
    intro j _hj
    ring
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.linf_nonneg _)] using
      hlinf_le_l2.trans (by rw [hl2_symm]; exact hl2)

/-- Each coordinate of the symmetric `L∞` sample subgradient is integrable. -/
theorem integrable_linfL1SymmetricActiveDirection_coordinate
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (state : Coord → ℝ) (i : Coord) :
    Integrable (fun ideal => linfL1SymmetricActiveDirection state ideal i)
      D.idealMeasure := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  have hmeas : Measurable (fun ideal : Coord → ℝ =>
      linfL1SymmetricActiveDirection state ideal i) :=
    ((measurable_pi_apply i).comp measurable_linfL1SymmetricActiveDirection).comp
      (measurable_const.prodMk measurable_id)
  refine Integrable.mono' (integrable_const (1 : ℝ)) hmeas.aestronglyMeasurable ?_
  filter_upwards [] with ideal
  simpa only [Real.norm_eq_abs] using
    linfL1SymmetricActiveDirection_coordinate_abs_le_one state ideal i

/--
The population symmetric direction is a subgradient of the expected finite
`L∞` cost.  This is a concrete use of the reusable expected-subgradient
interchange theorem.
-/
theorem finiteModelBPopulationLinfGradient_subgradientOn_expectedLinfCost
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (solutionSpace : Set (Coord → ℝ)) (state : Coord → ℝ)
    (hcost_integrable : ∀ y : Coord → ℝ,
      Integrable (fun ideal => AppliedModelingLib.FiniteDimensionalNorms.linf
        (fun j => y j - ideal j)) D.idealMeasure) :
    AppliedModelingLib.Optimization.FiniteSubgradientOn
      (finiteModelBExpectedLinfCost D) solutionSpace state
      (finiteModelBPopulationLinfGradient D state) := by
  have hfull := AppliedModelingLib.Optimization.finiteSubgradientAt_integral
    (Filter.Eventually.of_forall fun ideal => by
      intro y
      exact finiteSubgradientAt_linfL1SymmetricActiveDirection state ideal y)
    hcost_integrable
    (fun i => integrable_linfL1SymmetricActiveDirection_coordinate D state i)
  intro y _hy
  simpa only [finiteModelBExpectedLinfCost, finiteModelBPopulationLinfGradient] using
    hfull y

/-- Every coordinate of the population symmetric `L∞` direction has absolute value at most one. -/
theorem finiteModelBPopulationLinfGradient_coord_abs_le_one
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (state : Coord → ℝ) (i : Coord) :
    |finiteModelBPopulationLinfGradient D state i| ≤ 1 := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  rw [finiteModelBPopulationLinfGradient]
  have hbound : ∀ᵐ ideal ∂D.idealMeasure,
      ‖linfL1SymmetricActiveDirection state ideal i‖ ≤ 1 := by
    filter_upwards [] with ideal
    simpa only [Real.norm_eq_abs] using
      linfL1SymmetricActiveDirection_coordinate_abs_le_one state ideal i
  have hintegral := norm_integral_le_of_norm_le_const hbound
  simpa using hintegral

/-- The population symmetric `L∞` direction has a finite uniform Euclidean bound. -/
theorem finiteModelBPopulationLinfGradient_l2_le_card
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (state : Coord → ℝ) :
    AppliedModelingLib.FiniteDimensionalNorms.l2 (finiteModelBPopulationLinfGradient D state) ≤
      Fintype.card Coord := by
  have hsq : AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (finiteModelBPopulationLinfGradient D state) ≤ Fintype.card Coord := by
    have hnorm := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_card_mul_sq_of_abs_le
      (finiteModelBPopulationLinfGradient D state) (by norm_num : (0 : ℝ) ≤ 1)
      (finiteModelBPopulationLinfGradient_coord_abs_le_one D state)
    norm_num at hnorm ⊢
    exact hnorm
  have hcard_nat : 1 ≤ Fintype.card Coord := by
    have hpos : 0 < Fintype.card Coord := Fintype.card_pos_iff.mpr inferInstance
    omega
  have hcard : (1 : ℝ) ≤ Fintype.card Coord := by
    exact_mod_cast hcard_nat
  rw [← AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq] at hsq
  nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg
    (finiteModelBPopulationLinfGradient D state)]

/--
Under C1/C2, the expected finite-`L∞` objective has a concrete uniformly
bounded population subgradient at every feasible state.
-/
theorem finiteModelBPopulationLinfGradient_exists_bounded_subgradientOn_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    ∀ state, state ∈ E.solutionSpace → ∃ g,
      AppliedModelingLib.Optimization.FiniteSubgradientOn
        (finiteModelBExpectedLinfCost D) E.solutionSpace state g ∧
        AppliedModelingLib.FiniteDimensionalNorms.l2 g ≤ Fintype.card Coord := by
  intro state hstate
  refine ⟨finiteModelBPopulationLinfGradient D state, ?_, ?_⟩
  · exact finiteModelBPopulationLinfGradient_subgradientOn_expectedLinfCost
      D E.solutionSpace state
      (fun y => integrable_finiteModelBLinfCost_of_C1C2 S y)
  · exact finiteModelBPopulationLinfGradient_l2_le_card D state

/--
The expected finite `L∞` cost is Lipschitz in the finite Euclidean quantity.
This supplies the analytic continuity route for the `(∞,1)` endpoint without
introducing a tie-breaking convention for active coordinates.
-/
theorem finiteModelBExpectedLinfCost_le_add_l2_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (state target : Coord → ℝ) :
    finiteModelBExpectedLinfCost D state ≤
      finiteModelBExpectedLinfCost D target +
        AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => state i - target i) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let distance : ℝ := AppliedModelingLib.FiniteDimensionalNorms.l2
    (fun i => state i - target i)
  have hstate := integrable_finiteModelBLinfCost_of_C1C2 S state
  have htarget := integrable_finiteModelBLinfCost_of_C1C2 S target
  have hbound : ∀ᵐ ideal ∂D.idealMeasure,
      AppliedModelingLib.FiniteDimensionalNorms.linf (fun i => state i - ideal i) ≤
        AppliedModelingLib.FiniteDimensionalNorms.linf (fun i => target i - ideal i) + distance := by
    filter_upwards [] with ideal
    calc
      AppliedModelingLib.FiniteDimensionalNorms.linf (fun i => state i - ideal i) ≤
          AppliedModelingLib.FiniteDimensionalNorms.linf (fun i => target i - ideal i) +
            AppliedModelingLib.FiniteDimensionalNorms.linf (fun i => state i - target i) :=
        AppliedModelingLib.FiniteDimensionalNorms.linf_sub_le_linf_sub_add_linf_sub state target ideal
      _ ≤ AppliedModelingLib.FiniteDimensionalNorms.linf (fun i => target i - ideal i) +
            distance := by
        exact add_le_add_right
          (AppliedModelingLib.FiniteDimensionalNorms.linf_le_l2 _) _
  unfold finiteModelBExpectedLinfCost
  calc
    _ ≤ ∫ ideal, AppliedModelingLib.FiniteDimensionalNorms.linf
          (fun i => target i - ideal i) + distance ∂D.idealMeasure :=
      MeasureTheory.integral_mono_ae hstate (htarget.add (integrable_const distance)) hbound
    _ = _ := by
      rw [MeasureTheory.integral_add htarget (integrable_const distance),
        MeasureTheory.integral_const]
      simp [distance]

/-- The expected finite `L∞` objective is continuous, via its Euclidean Lipschitz bound. -/
theorem continuous_finiteModelBExpectedLinfCost_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    Continuous (finiteModelBExpectedLinfCost D) := by
  rw [continuous_iff_continuousAt]
  intro state
  rw [Metric.continuousAt_iff]
  intro epsilon hepsilon
  rcases Metric.continuousAt_iff.mp
      (AppliedModelingLib.FiniteDimensionalNorms.continuous_l2_sub state).continuousAt
      epsilon hepsilon with ⟨delta, hdelta, hclose⟩
  refine ⟨delta, hdelta, ?_⟩
  intro target htarget
  have hdistance_raw := hclose htarget
  have hdistance : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => target i - state i) < epsilon := by
    simpa [AppliedModelingLib.FiniteDimensionalNorms.normL2_zero,
      Real.dist_eq,
      abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg _)] using hdistance_raw
  rw [Real.dist_eq]
  have hforward := finiteModelBExpectedLinfCost_le_add_l2_of_C1C2 S target state
  have hbackward := finiteModelBExpectedLinfCost_le_add_l2_of_C1C2 S state target
  have hsymm : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => state i - target i) =
      AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => target i - state i) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    congr 1
    apply Finset.sum_congr rfl
    intro i _hi
    ring
  rw [hsymm] at hbackward
  rw [abs_lt]
  constructor <;> linarith

/-- Feasible expected finite-`L∞` gaps are bounded by the C1/C2 Euclidean diameter. -/
theorem finiteModelBExpectedLinfCost_gap_abs_le_l2Diameter_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {state target : Coord → ℝ}
    (hstate : state ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace) :
    |finiteModelBExpectedLinfCost D state - finiteModelBExpectedLinfCost D target| ≤
      finiteModelBC1C2L2Diameter S := by
  have hdistance := finiteModelBC1C2L2Diameter_bound S hstate htarget
  have hforward := finiteModelBExpectedLinfCost_le_add_l2_of_C1C2 S state target
  have hbackward := finiteModelBExpectedLinfCost_le_add_l2_of_C1C2 S target state
  have hsymm : AppliedModelingLib.FiniteDimensionalNorms.l2
      (fun i => target i - state i) =
      AppliedModelingLib.FiniteDimensionalNorms.l2 (fun i => state i - target i) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    congr 1
    apply Finset.sum_congr rfl
    intro i _hi
    ring
  rw [hsymm] at hbackward
  rw [abs_le]
  constructor <;> linarith

/-- The C3 expected finite-`Lp` objective is Borel measurable in the state. -/
theorem measurable_finiteModelBExpectedLpCost
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    {p : ℝ} (hp : 0 ≤ p) :
    Measurable (finiteModelBExpectedLpCost D p) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  have hdiff : Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      fun j => z.1 j - z.2 j) := by
    apply measurable_pi_lambda _
    intro j
    exact ((measurable_pi_apply j).comp measurable_fst).sub
      ((measurable_pi_apply j).comp measurable_snd)
  have hcost : StronglyMeasurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      AppliedModelingLib.FiniteDimensionalNorms.lp p (fun j => z.1 j - z.2 j)) :=
    ((AppliedModelingLib.FiniteDimensionalNorms.continuous_lp hp).measurable.comp hdiff).stronglyMeasurable
  exact (hcost.integral_prod_right).measurable

/-- The expected finite-coordinate `L∞` objective is Borel measurable in the state. -/
theorem measurable_finiteModelBExpectedLinfCost
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) :
    Measurable (finiteModelBExpectedLinfCost D) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  have hdiff : Measurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      fun j => z.1 j - z.2 j) := by
    apply measurable_pi_lambda _
    intro j
    exact ((measurable_pi_apply j).comp measurable_fst).sub
      ((measurable_pi_apply j).comp measurable_snd)
  have hcost : StronglyMeasurable (fun z : (Coord → ℝ) × (Coord → ℝ) =>
      AppliedModelingLib.FiniteDimensionalNorms.linf (fun j => z.1 j - z.2 j)) :=
    (AppliedModelingLib.FiniteDimensionalNorms.continuous_linf.measurable.comp hdiff).stronglyMeasurable
  exact (hcost.integral_prod_right).measurable

/-- Expected finite-`Lp` costs are nonnegative. -/
theorem finiteModelBExpectedLpCost_nonneg
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p : ℝ) (state : Coord → ℝ) :
    0 ≤ finiteModelBExpectedLpCost D p state := by
  apply MeasureTheory.integral_nonneg
  intro ideal
  exact AppliedModelingLib.FiniteDimensionalNorms.lp_nonneg p _

/-- Expected finite-coordinate `L∞` costs are nonnegative. -/
theorem finiteModelBExpectedLinfCost_nonneg
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (state : Coord → ℝ) :
    0 ≤ finiteModelBExpectedLinfCost D state := by
  apply MeasureTheory.integral_nonneg
  intro ideal
  exact AppliedModelingLib.FiniteDimensionalNorms.linf_nonneg _

/--
For feasible states, C1 compactness and C2 support give a uniform bound on
the expected finite-`Lp` cost.
-/
theorem finiteModelBExpectedLpCost_le_of_C1C2
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {p : ℝ} (hp : 0 < p) {state : Coord → ℝ}
    (hstate : state ∈ E.solutionSpace) :
    ∃ C : ℝ, 0 ≤ C ∧ finiteModelBExpectedLpCost D p state ≤ C := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  rcases AppliedModelingLib.FiniteDimensionalNorms.exists_lp_diameter_on_isCompact
    S.compact_solutionSpace hp.le with ⟨C, hC_nonneg, hbound⟩
  refine ⟨C, hC_nonneg, ?_⟩
  apply le_trans (MeasureTheory.integral_mono_ae
    (integrable_finiteModelBLpCost_of_C1C2 S hp state)
    (integrable_const C) ?_) ?_
  · filter_upwards [S.ideal_mem_solutionSpace_ae] with ideal hideal
    exact hbound state hstate ideal hideal
  · rw [MeasureTheory.integral_const]
    simp

/-- The chosen C1 `Lp` diameter gives a uniform feasible-state cost bound. -/
theorem finiteModelBExpectedLpCost_le_LpDiameter_of_C1C2
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {p : ℝ} (hp : 0 < p) {state : Coord → ℝ}
    (hstate : state ∈ E.solutionSpace) :
    finiteModelBExpectedLpCost D p state ≤ finiteModelBC1C2LpDiameter S p hp := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  apply le_trans (MeasureTheory.integral_mono_ae
    (integrable_finiteModelBLpCost_of_C1C2 S hp state)
    (integrable_const (finiteModelBC1C2LpDiameter S p hp)) ?_) ?_
  · filter_upwards [S.ideal_mem_solutionSpace_ae] with ideal hideal
    exact finiteModelBC1C2LpDiameter_bound S p hp hstate hideal
  · rw [MeasureTheory.integral_const]
    simp

/-- Feasible expected-cost gaps are bounded by the chosen compact `Lp` diameter. -/
theorem finiteModelBExpectedLpCost_gap_abs_le_LpDiameter_of_C1C2
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {p : ℝ} (hp : 0 < p)
    {state target : Coord → ℝ}
    (hstate : state ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace) :
    |finiteModelBExpectedLpCost D p state -
        finiteModelBExpectedLpCost D p target| ≤ finiteModelBC1C2LpDiameter S p hp := by
  have hbound_state := finiteModelBExpectedLpCost_le_LpDiameter_of_C1C2
    S hp hstate
  have hbound_target := finiteModelBExpectedLpCost_le_LpDiameter_of_C1C2
    S hp htarget
  have hnonneg_state := finiteModelBExpectedLpCost_nonneg D p state
  have hnonneg_target := finiteModelBExpectedLpCost_nonneg D p target
  rw [abs_le]
  constructor <;> linarith

/--
The population `Lp` direction is a subgradient of the C3 expected `Lp` cost.
This is the expected-subgradient interchange applied to the already-proved
almost-everywhere finite-coordinate Lemma 3 subgradient.
-/
theorem finiteModelBPopulationLpGradient_subgradientOn_expectedLpCost
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) {p : ℝ} (hp : 1 < p)
    (solutionSpace : Set (Coord → ℝ)) (state : Coord → ℝ)
    (hcost_integrable : ∀ y : Coord → ℝ,
      Integrable (fun ideal => AppliedModelingLib.FiniteDimensionalNorms.lp p
        (fun j => y j - ideal j)) D.idealMeasure)
    (hgradient_integrable : ∀ i,
      Integrable (fun ideal => lpCostGradientCandidate p
        (fun j => state j - ideal j) i) D.idealMeasure) :
    AppliedModelingLib.Optimization.FiniteSubgradientOn
      (finiteModelBExpectedLpCost D p) solutionSpace state
      (finiteModelBPopulationLpGradient D p state) := by
  have hfull := AppliedModelingLib.Optimization.finiteSubgradientAt_integral
    (FiniteCoordinateIdealDistributionData.finiteSubgradientAt_lpCostGradientCandidate_ae
      D hp state)
    hcost_integrable hgradient_integrable
  intro y _hy
  simpa only [finiteModelBExpectedLpCost, finiteModelBPopulationLpGradient] using hfull y

/--
At an actual Model B iterate, the conditional mean of one sampled gradient
coordinate is the corresponding coordinate of its population `Lp` direction.
The only analytic input is integrability of that coordinate on the explicit
past-prefix/fresh-sample product law.
-/
theorem finiteModelBOutcomeTrajectory_lpCostGradientCandidate_condExp_ae_eq_population
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (i : Coord)
    (hintegrable : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
        lpCostGradientCandidate p
          (fun j =>
            finiteModelBOutcomePrefixTrajectory D p r0 project initial n z.1 j - z.2 j) i)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D))) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega => lpCostGradientCandidate p
        (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
          finiteModelBIdealSample n omega j) i |
        finiteModelBIdealNaturalFiltration (Coord := Coord) n] =ᵐ[
          finiteModelBIdealSequenceMeasure D]
      fun omega => finiteModelBPopulationLpGradient D p
        (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i := by
  simpa only [finiteModelBPopulationLpGradient] using
    (finiteModelBOutcomeTrajectory_condExp_ae_eq_integral D p r0 project initial n
      (fun state ideal =>
        lpCostGradientCandidate p (fun j => state j - ideal j) i)
      hintegrable)

/--
Prefix-product integrability of a sampled gradient coordinate transfers to its
realization along the outcome-indexed Model B recursion.
-/
theorem finiteModelBOutcomeTrajectory_lpCostGradientCandidate_integrable_of_prefix
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (i : Coord)
    (hintegrable : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
        lpCostGradientCandidate p
          (fun j =>
            finiteModelBOutcomePrefixTrajectory D p r0 project initial n z.1 j - z.2 j) i)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D))) :
    Integrable (fun omega => lpCostGradientCandidate p
      (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
        finiteModelBIdealSample n omega j) i)
      (finiteModelBIdealSequenceMeasure D) := by
  let pair : (ℕ → Coord → ℝ) →
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) :=
    fun omega =>
      (finiteModelBIdealPastPrefix n omega, finiteModelBIdealSample n omega)
  have hpair_measurable : Measurable pair :=
    (measurable_finiteModelBIdealPastPrefix n).prodMk
      (measurable_finiteModelBIdealSample n)
  have hcomposed : Integrable (fun omega =>
      lpCostGradientCandidate p
        (fun j =>
          finiteModelBOutcomePrefixTrajectory D p r0 project initial n
            (finiteModelBIdealPastPrefix n omega) j -
          finiteModelBIdealSample n omega j) i)
      (finiteModelBIdealSequenceMeasure D) := by
    exact (integrable_map_measure hintegrable.1 hpair_measurable.aemeasurable).mp hintegrable
  apply hcomposed.congr
  filter_upwards [] with omega
  rw [finiteModelBOutcomePrefixTrajectory_pastPrefix_eq]

/--
Prefix-product integrability also makes the population gradient coordinate
integrable along the actual Model B state process.
-/
theorem finiteModelBPopulationLpGradient_integrable_of_prefix
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (i : Coord)
    (hintegrable : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
        lpCostGradientCandidate p
          (fun j =>
            finiteModelBOutcomePrefixTrajectory D p r0 project initial n z.1 j - z.2 j) i)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D))) :
    Integrable (fun omega => finiteModelBPopulationLpGradient D p
      (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i)
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let mu := Measure.map (finiteModelBIdealPastPrefix (Coord := Coord) n)
    (finiteModelBIdealSequenceMeasure D)
  let test : (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) → ℝ :=
    fun z => lpCostGradientCandidate p
      (fun j => finiteModelBOutcomePrefixTrajectory D p r0 project initial n z.1 j - z.2 j) i
  have hproduct : Integrable test (mu.prod D.idealMeasure) := by
    rw [← finiteModelBIdealPastPrefix_idealSample_pair_law D n]
    simpa [mu, test] using hintegrable
  have hintegral : Integrable (fun past : Fin (n + 1) → Coord → ℝ =>
      ∫ ideal, test (past, ideal) ∂D.idealMeasure) mu :=
    hproduct.integral_prod_left
  have hpast : Integrable (fun omega =>
      ∫ ideal, test (finiteModelBIdealPastPrefix n omega, ideal) ∂D.idealMeasure)
      (finiteModelBIdealSequenceMeasure D) := by
    exact (integrable_map_measure hintegral.1
      (measurable_finiteModelBIdealPastPrefix n).aemeasurable).mp hintegral
  apply hpast.congr
  filter_upwards [] with omega
  simp only [test, finiteModelBPopulationLpGradient]
  rw [finiteModelBOutcomePrefixTrajectory_pastPrefix_eq]

/--
Centering a sampled Model B gradient coordinate by its population direction
gives a conditional mean-zero increment.  The measurability premise is the
remaining standard adaptedness condition required by conditional expectation.
-/
theorem finiteModelBOutcomeTrajectory_centeredLpGradient_condExp_ae_eq_zero
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (i : Coord)
    (hintegrable : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
        lpCostGradientCandidate p
          (fun j =>
            finiteModelBOutcomePrefixTrajectory D p r0 project initial n z.1 j - z.2 j) i)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D)))
    (hpopulation_measurable : StronglyMeasurable[
      finiteModelBIdealNaturalFiltration (Coord := Coord) n]
      (fun omega => finiteModelBPopulationLpGradient D p
        (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i)) :
    (finiteModelBIdealSequenceMeasure D)[
      (fun omega => lpCostGradientCandidate p
        (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
          finiteModelBIdealSample n omega j) i) -
        (fun omega => finiteModelBPopulationLpGradient D p
          (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i) |
        finiteModelBIdealNaturalFiltration (Coord := Coord) n] =ᵐ[
          finiteModelBIdealSequenceMeasure D] 0 := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have hsample_integrable :=
    finiteModelBOutcomeTrajectory_lpCostGradientCandidate_integrable_of_prefix
      D p r0 project initial n i hintegrable
  have hpopulation_integrable :=
    finiteModelBPopulationLpGradient_integrable_of_prefix
      D p r0 project initial n i hintegrable
  have hpopulation_conditional :
      (finiteModelBIdealSequenceMeasure D)[
        fun omega => finiteModelBPopulationLpGradient D p
          (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i |
          finiteModelBIdealNaturalFiltration (Coord := Coord) n] =ᵐ[
            finiteModelBIdealSequenceMeasure D]
        fun omega => finiteModelBPopulationLpGradient D p
          (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i := by
    rw [condExp_of_stronglyMeasurable
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n)
      hpopulation_measurable hpopulation_integrable]
  filter_upwards [
    condExp_sub hsample_integrable hpopulation_integrable
      (finiteModelBIdealNaturalFiltration (Coord := Coord) n),
    finiteModelBOutcomeTrajectory_lpCostGradientCandidate_condExp_ae_eq_population
      D p r0 project initial n i hintegrable,
    hpopulation_conditional] with omega hsub hsample hpopulation
  rw [hsub]
  simp only [Pi.sub_apply, Pi.zero_apply]
  rw [hsample, hpopulation]
  ring

/-- The canonical outcome trajectory starts from the designated initial point. -/
theorem finiteModelBOutcomeTrajectory_zero
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (omega : ℕ → Coord → ℝ) :
    finiteModelBOutcomeTrajectory D p r0 project initial 0 omega = initial :=
  rfl

/-- The canonical outcome trajectory satisfies the displayed Model B update. -/
theorem finiteModelBOutcomeTrajectory_succ
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelBOutcomeTrajectory D p r0 project initial (n + 1) omega =
      project (fun i =>
        finiteModelBOutcomeTrajectory D p r0 project initial n omega i -
          ilvRadius r0 (n + 1) *
            lpCostGradientCandidate p
              (fun j =>
                finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
                  finiteModelBIdealSample n omega j) i) :=
  rfl

/-- The canonical recursive update is projection of its unprojected response. -/
theorem finiteModelBOutcomeTrajectory_succ_rawResponse
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelBOutcomeTrajectory D p r0 project initial (n + 1) omega =
      project (finiteModelBOutcomeRawResponse p r0
        (finiteModelBOutcomeTrajectory D p r0 project initial)
        finiteModelBIdealSample n omega) :=
  rfl

/-- Projection keeps every outcome-indexed Model B iterate feasible. -/
theorem finiteModelBOutcomeTrajectory_mem_solutionSpace
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) {solutionSpace : Set (Coord → ℝ)}
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hinitial : initial ∈ solutionSpace)
    (hproject : ∀ y, project y ∈ solutionSpace) :
    ∀ n omega,
      finiteModelBOutcomeTrajectory D p r0 project initial n omega ∈ solutionSpace := by
  intro n omega
  induction n with
  | zero => simpa [finiteModelBOutcomeTrajectory] using hinitial
  | succ n ih =>
      rw [finiteModelBOutcomeTrajectory_succ]
      exact hproject _

/--
The canonical Model B state at time `n` is measurable with respect to the
past raw ideal coordinates through `n`.  Thus the update uses no information
from its fresh step-`n` ideal draw.
-/
theorem stronglyMeasurable_finiteModelBOutcomeTrajectory_natural
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) :
    ∀ n, StronglyMeasurable[
      finiteModelBIdealNaturalFiltration (Coord := Coord) n]
