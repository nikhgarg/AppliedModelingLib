    (n : ℕ) (i : Coord) :
    Integrable (fun omega =>
      (finiteModelBOutcomeTrajectory D p r0 project initial n omega i - target i) *
        finiteModelBOutcomeLpGradientNoise D p r0 project initial n omega i)
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have htrajectory := stronglyMeasurable_finiteModelBOutcomeTrajectory_natural
    D p r0 project initial S.project_measurable n
  have htrajectory_meas : Measurable
      (finiteModelBOutcomeTrajectory D p r0 project initial n) :=
    htrajectory.measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl
  have hstate : Measurable (fun omega : ℕ → Coord → ℝ =>
      finiteModelBOutcomeTrajectory D p r0 project initial n omega i - target i) :=
    ((measurable_pi_apply i).comp htrajectory_meas).sub measurable_const
  have hnoise := measurable_finiteModelBOutcomeLpGradientNoise
    D p r0 project initial S.project_measurable n
  have hmeas : Measurable (fun omega : ℕ → Coord → ℝ =>
      (finiteModelBOutcomeTrajectory D p r0 project initial n omega i - target i) *
        finiteModelBOutcomeLpGradientNoise D p r0 project initial n omega i) :=
    hstate.mul ((measurable_pi_apply i).comp hnoise)
  refine Integrable.mono' (integrable_const (2 * finiteModelBC1C2L2Diameter S))
    hmeas.aestronglyMeasurable ?_
  filter_upwards [finiteModelBOutcomeLpGradientNoise_coord_abs_le_two_ae
    D hdual project initial S.project_measurable n i] with omega hnoise_bound
  have hfeasible := finiteModelBOutcomeTrajectory_mem_solutionSpace_of_C1C2
    S p r0 initial hinitial n omega
