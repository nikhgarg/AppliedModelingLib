    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) :
    Integrable (fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (fun i => finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega i - target i))
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  have htrajectory := stronglyMeasurable_finiteModelALinfL1OutcomeTrajectory_natural
    D r0 project initial S.project_measurable n
  have htrajectory_meas : Measurable
      (finiteModelALinfL1OutcomeTrajectory D r0 project initial n) :=
    htrajectory.measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl
  have hmeas : Measurable (fun omega : ℕ → Coord → ℝ =>
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (fun i => finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega i - target i)) := by
    apply hl2sq.comp
    apply measurable_pi_lambda _
    intro i
    exact ((measurable_pi_apply i).comp htrajectory_meas).sub measurable_const
  refine Integrable.mono' (integrable_const (finiteModelBC1C2L2Diameter S ^ 2))
    hmeas.aestronglyMeasurable ?_
  filter_upwards [] with omega
  have hfeasible := finiteModelALinfL1OutcomeTrajectory_mem_solutionSpace_of_C1C2
    S r0 initial hinitial n omega
  have hdistance := finiteModelBC1C2L2Diameter_bound S hfeasible htarget
  have hsq := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_sq_of_normL2_le
    (finiteModelBC1C2L2Diameter_nonneg S) hdistance
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hsq

/-- C1/C2 bounds make every expected finite-`L∞` gap along Model A integrable. -/
theorem integrable_finiteModelALinfL1ExpectedLinfCost_gap_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) :
    Integrable (fun omega => finiteModelBExpectedLinfCost D
      (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega) -
        finiteModelBExpectedLinfCost D target)
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have hadapted := stronglyAdapted_finiteModelALinfL1ExpectedLinfCost_gap_natural
    D r0 project initial target S.project_measurable
  refine Integrable.mono' (integrable_const (finiteModelBC1C2L2Diameter S))
    ((hadapted n).mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n)).aestronglyMeasurable ?_
  filter_upwards [] with omega
  have hfeasible := finiteModelALinfL1OutcomeTrajectory_mem_solutionSpace_of_C1C2
    S r0 initial hinitial n omega
  simpa only [Real.norm_eq_abs] using
    finiteModelBExpectedLinfCost_gap_abs_le_l2Diameter_of_C1C2 S hfeasible htarget

/-- Compact C1 geometry and bounded symmetric noise make Model A target-noise products integrable. -/
theorem integrable_finiteModelALinfL1OutcomeTrajectory_target_noise_product_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) (i : Coord) :
    Integrable (fun omega =>
      (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega i - target i) *
        finiteModelALinfL1OutcomeGradientNoise D r0 project initial n omega i)
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have htrajectory := stronglyMeasurable_finiteModelALinfL1OutcomeTrajectory_natural
    D r0 project initial S.project_measurable n
  have htrajectory_meas : Measurable
      (finiteModelALinfL1OutcomeTrajectory D r0 project initial n) :=
    htrajectory.measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl
  have hstate : Measurable (fun omega : ℕ → Coord → ℝ =>
      finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega i - target i) :=
    ((measurable_pi_apply i).comp htrajectory_meas).sub measurable_const
  have hnoise := measurable_finiteModelALinfL1OutcomeGradientNoise
    D r0 project initial S.project_measurable n
  have hmeas : Measurable (fun omega : ℕ → Coord → ℝ =>
      (finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega i - target i) *
        finiteModelALinfL1OutcomeGradientNoise D r0 project initial n omega i) :=
    hstate.mul ((measurable_pi_apply i).comp hnoise)
  refine Integrable.mono' (integrable_const (2 * finiteModelBC1C2L2Diameter S))
    hmeas.aestronglyMeasurable ?_
  filter_upwards [] with omega
  have hnoise_bound := finiteModelALinfL1OutcomeGradientNoise_coord_abs_le_two
    D r0 project initial n omega i
  have hfeasible := finiteModelALinfL1OutcomeTrajectory_mem_solutionSpace_of_C1C2
    S r0 initial hinitial n omega
  have hdistance := finiteModelBC1C2L2Diameter_bound S hfeasible htarget
  have hcoordinate := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
    (fun j => finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega j - target j) i
  have hcoordinate_bound :
      |finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega i - target i| ≤
        finiteModelBC1C2L2Diameter S :=
    hcoordinate.trans hdistance
  rw [Real.norm_eq_abs, abs_mul]
  calc
    |finiteModelALinfL1OutcomeTrajectory D r0 project initial n omega i - target i| *
        |finiteModelALinfL1OutcomeGradientNoise D r0 project initial n omega i| ≤
        finiteModelBC1C2L2Diameter S * 2 :=
      mul_le_mul hcoordinate_bound hnoise_bound (abs_nonneg _)
        (finiteModelBC1C2L2Diameter_nonneg S)
    _ = 2 * finiteModelBC1C2L2Diameter S := by ring

/--
The exact source Model A `(∞,1)` water-filled recursion as a reusable
perturbed projected stochastic-subgradient minimizer-set execution.
-/
noncomputable def finiteModelALinfL1CanonicalPerturbedMinimizerSetExecution
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (C3 : FiniteCoordinateC3Carrier E)
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E C3.data project)
    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (hinitial : initial ∈ E.solutionSpace) :
    AppliedModelingLib.Optimization.PerturbedProjectedStochasticSubgradientMinimizerSetExecution
      Coord where
  Ω := ℕ → Coord → ℝ
  measurableSpace := inferInstance
  μ := finiteModelBIdealSequenceMeasure C3.data
  probability := finiteModelBIdealSequenceMeasure_isProbabilityMeasure C3.data
  filtration := finiteModelBIdealNaturalFiltration
  trajectory := finiteModelALinfL1OutcomeTrajectory C3.data r0 project initial
  meanSubgradient := fun n omega => finiteModelBPopulationLinfGradient C3.data
    (finiteModelALinfL1OutcomeTrajectory C3.data r0 project initial n omega)
  noise := finiteModelALinfL1OutcomeGradientNoise C3.data r0 project initial
  perturbation := finiteModelALinfL1OutcomeSubgradientPerturbation C3.data r0 project initial
  radius := ilvRadius r0
  solutionSpace := E.solutionSpace
  objective := finiteModelBExpectedLinfCost C3.data
  project := project
  targetSet := finiteModelBExpectedLinfMinimizerSet C3.data E.solutionSpace
  reference := finiteModelBExpectedLinfReference S
  reference_mem_targetSet := finiteModelBExpectedLinfReference_mem_minimizerSet S
  targetSet_subset_solutionSpace := by
    intro target htarget
    exact htarget.1
  targetSet_minimizes := by
    intro target htarget
    exact htarget.2
  minimizer_mem_targetSet := by
    intro target htarget hmin
    exact ⟨htarget, hmin⟩
  project_nonexpansive := S.squaredDistance_nonexpansive
  trajectory_adapted := by
    intro i n
    exact ((measurable_pi_apply i).comp
      (stronglyMeasurable_finiteModelALinfL1OutcomeTrajectory_natural C3.data r0
        project initial S.project_measurable n).measurable).stronglyMeasurable
  target_objective_gap_adapted := by
    intro target _htarget
    exact stronglyAdapted_finiteModelALinfL1ExpectedLinfCost_gap_natural C3.data
      r0 project initial target S.project_measurable
  target_potential_integrable := by
    intro target htarget n
    exact integrable_finiteModelALinfL1OutcomeTrajectory_target_l2Sq_of_C1C2
      S r0 initial target hinitial htarget.1 n
  target_objective_gap_integrable := by
    intro target htarget n
    exact integrable_finiteModelALinfL1ExpectedLinfCost_gap_of_C1C2
      S r0 initial target hinitial htarget.1 n
  target_noise_product_integrable := by
    intro target htarget n i
    exact integrable_finiteModelALinfL1OutcomeTrajectory_target_noise_product_of_C1C2
      S r0 initial target hinitial htarget.1 n i
  noise_coordinate_integrable := by
    intro n i
    exact integrable_finiteModelALinfL1OutcomeGradientNoise_coordinate
      C3.data r0 project initial S.project_measurable n i
  noise_mean_zero := by
    intro n i
    exact finiteModelALinfL1OutcomeGradientNoise_condExp_ae_eq_zero
      C3.data r0 project initial S.project_measurable n i
  noise_energy_integrable := by
    intro n
    exact integrable_finiteModelALinfL1OutcomeGradientNoise_l2Sq
      C3.data r0 project initial S.project_measurable n
  perturbation_norm_integrable := by
    intro n
    exact integrable_finiteModelALinfL1OutcomeSubgradientPerturbation_l2
      C3.data hr0 project initial S.project_measurable n
  perturbation_energy_integrable := by
    intro n
    exact integrable_finiteModelALinfL1OutcomeSubgradientPerturbation_l2Sq
      C3.data hr0 project initial S.project_measurable n
  C := Fintype.card Coord
  noiseBound := 4 * Fintype.card Coord
  target_distanceBound := fun _ => finiteModelBC1C2L2Diameter S
  C_nonneg := by positivity
  noiseBound_nonneg := by positivity
  target_distanceBound_nonneg := by
    intro _ _
    exact finiteModelBC1C2L2Diameter_nonneg S
  noise_energy_bound := by
    intro n
    exact finiteModelALinfL1OutcomeGradientNoise_condExp_l2Sq_le_four_card
      C3.data r0 project initial S.project_measurable n
  perturbation_error := fun _ n =>
    (4 * finiteModelBC1C2L2Diameter S * Real.sqrt (Fintype.card Coord) *
        (finiteModelBC1C2CoordinateSlabRealConstant S +
          finiteModelBC1C2LinearTieSlabRealConstant S) +
      12 * Fintype.card Coord *
        (finiteModelBC1C2CoordinateSlabRealConstant S +
          finiteModelBC1C2LinearTieSlabRealConstant S) * r0) *
      ilvRadius r0 (n + 1) ^ 2
  perturbation_error_nonneg := by
    intro _ _ n
    apply mul_nonneg
    · apply add_nonneg
      · exact mul_nonneg
          (mul_nonneg
            (mul_nonneg (by norm_num) (finiteModelBC1C2L2Diameter_nonneg S))
            (Real.sqrt_nonneg _))
          (add_nonneg (finiteModelBC1C2CoordinateSlabRealConstant_nonneg S)
            (finiteModelBC1C2LinearTieSlabRealConstant_nonneg S))
      · exact mul_nonneg
          (mul_nonneg
            (mul_nonneg (by norm_num) (by positivity))
            (add_nonneg (finiteModelBC1C2CoordinateSlabRealConstant_nonneg S)
              (finiteModelBC1C2LinearTieSlabRealConstant_nonneg S)))
          (le_of_lt hr0)
    · exact sq_nonneg _
  perturbation_error_summable := by
    intro _ _
    have hsum := (ilvRadius_sq_summable r0).mul_left
      (4 * finiteModelBC1C2L2Diameter S * Real.sqrt (Fintype.card Coord) *
          (finiteModelBC1C2CoordinateSlabRealConstant S +
            finiteModelBC1C2LinearTieSlabRealConstant S) +
        12 * Fintype.card Coord *
          (finiteModelBC1C2CoordinateSlabRealConstant S +
            finiteModelBC1C2LinearTieSlabRealConstant S) * r0)
    convert hsum using 1
  perturbation_error_bound := by
    intro target htarget n
    have hbound := finiteModelALinfL1OutcomeSubgradientPerturbation_condExp_descentError_le
      S hr0 initial n (finiteModelBC1C2L2Diameter_nonneg S)
    filter_upwards [hbound] with omega hbound
    have hradius_nonneg : 0 ≤ ilvRadius r0 (n + 1) :=
      ilvRadius_nonneg (le_of_lt hr0) (n + 1)
    have hcard_nonneg : (0 : ℝ) ≤ Fintype.card Coord := by positivity
    have henvelope_nonneg : 0 ≤
        finiteModelBC1C2CoordinateSlabRealConstant S +
          finiteModelBC1C2LinearTieSlabRealConstant S :=
      add_nonneg (finiteModelBC1C2CoordinateSlabRealConstant_nonneg S)
        (finiteModelBC1C2LinearTieSlabRealConstant_nonneg S)
    have hradius_le : ilvRadius r0 (n + 1) ≤ r0 :=
      ilvRadius_succ_le_initial (le_of_lt hr0) n
    have hcube : ilvRadius r0 (n + 1) ^ 3 ≤
        r0 * ilvRadius r0 (n + 1) ^ 2 := by
      calc
        ilvRadius r0 (n + 1) ^ 3 =
            ilvRadius r0 (n + 1) * ilvRadius r0 (n + 1) ^ 2 := by ring
        _ ≤ r0 * ilvRadius r0 (n + 1) ^ 2 :=
          mul_le_mul_of_nonneg_right hradius_le (sq_nonneg _)
    have hsecond :
        12 * Fintype.card Coord *
            (finiteModelBC1C2CoordinateSlabRealConstant S +
              finiteModelBC1C2LinearTieSlabRealConstant S) *
            ilvRadius r0 (n + 1) ^ 3 ≤
          12 * Fintype.card Coord *
            (finiteModelBC1C2CoordinateSlabRealConstant S +
              finiteModelBC1C2LinearTieSlabRealConstant S) * r0 *
            ilvRadius r0 (n + 1) ^ 2 := by
      have hcoefficient : 0 ≤ (12 : ℝ) * Fintype.card Coord *
          (finiteModelBC1C2CoordinateSlabRealConstant S +
            finiteModelBC1C2LinearTieSlabRealConstant S) :=
        mul_nonneg (mul_nonneg (by norm_num) hcard_nonneg) henvelope_nonneg
      calc
        _ = ((12 : ℝ) * Fintype.card Coord *
            (finiteModelBC1C2CoordinateSlabRealConstant S +
              finiteModelBC1C2LinearTieSlabRealConstant S)) *
              ilvRadius r0 (n + 1) ^ 3 := by ring
        _ ≤ ((12 : ℝ) * Fintype.card Coord *
            (finiteModelBC1C2CoordinateSlabRealConstant S +
              finiteModelBC1C2LinearTieSlabRealConstant S)) *
              (r0 * ilvRadius r0 (n + 1) ^ 2) :=
            mul_le_mul_of_nonneg_left hcube hcoefficient
        _ = _ := by ring
    calc
      _ ≤ 2 * ilvRadius r0 (n + 1) * finiteModelBC1C2L2Diameter S *
          (2 * Real.sqrt (Fintype.card Coord) *
            (ilvRadius r0 (n + 1) *
              (finiteModelBC1C2CoordinateSlabRealConstant S +
                finiteModelBC1C2LinearTieSlabRealConstant S))) +
        3 * ilvRadius r0 (n + 1) ^ 2 *
          (4 * Fintype.card Coord *
            (ilvRadius r0 (n + 1) *
              (finiteModelBC1C2CoordinateSlabRealConstant S +
                finiteModelBC1C2LinearTieSlabRealConstant S))) := hbound
      _ = 4 * finiteModelBC1C2L2Diameter S * Real.sqrt (Fintype.card Coord) *
          (finiteModelBC1C2CoordinateSlabRealConstant S +
            finiteModelBC1C2LinearTieSlabRealConstant S) *
            ilvRadius r0 (n + 1) ^ 2 +
        12 * Fintype.card Coord *
          (finiteModelBC1C2CoordinateSlabRealConstant S +
            finiteModelBC1C2LinearTieSlabRealConstant S) *
            ilvRadius r0 (n + 1) ^ 3 := by ring
      _ ≤ 4 * finiteModelBC1C2L2Diameter S * Real.sqrt (Fintype.card Coord) *
          (finiteModelBC1C2CoordinateSlabRealConstant S +
            finiteModelBC1C2LinearTieSlabRealConstant S) *
            ilvRadius r0 (n + 1) ^ 2 +
        12 * Fintype.card Coord *
          (finiteModelBC1C2CoordinateSlabRealConstant S +
            finiteModelBC1C2LinearTieSlabRealConstant S) * r0 *
            ilvRadius r0 (n + 1) ^ 2 := by
              exact add_le_add_right hsecond _
      _ = _ := by ring
  update := by
    intro n
    filter_upwards [] with omega
    exact finiteModelALinfL1OutcomeTrajectory_projected_populationNoisePerturbation_update
      C3.data hr0 project initial n omega
  subgradient := by
    intro n
    filter_upwards [] with omega
    exact finiteModelBPopulationLinfGradient_subgradientOn_expectedLinfCost
      C3.data E.solutionSpace
      (finiteModelALinfL1OutcomeTrajectory C3.data r0 project initial n omega)
      (fun state => integrable_finiteModelBLinfCost_of_C1C2 S state)
  gradient_bound := by
    intro n
    filter_upwards [] with omega
    exact finiteModelBPopulationLinfGradient_l2_le_card C3.data
      (finiteModelALinfL1OutcomeTrajectory C3.data r0 project initial n omega)
  target_distance_bound := by
    intro target htarget n
    filter_upwards [] with omega
    exact finiteModelBC1C2L2Diameter_bound S
      (finiteModelALinfL1OutcomeTrajectory_mem_solutionSpace_of_C1C2
        S r0 initial hinitial n omega) htarget.1
  radius_nonneg := by
    intro n
    exact ilvRadius_nonneg (le_of_lt hr0) (n + 1)
  radius_sq_summable := ilvRadius_sq_summable r0
  radius_diverges := ilvRadius_sum_tendsto_atTop hr0
  trajectory_mem_solutionSpace := by
    filter_upwards [] with omega
    intro n
    exact finiteModelALinfL1OutcomeTrajectory_mem_solutionSpace_of_C1C2
      S r0 initial hinitial n omega
  compact_solutionSpace := S.compact_solutionSpace
  objective_continuous :=
    (continuous_finiteModelBExpectedLinfCost_of_C1C2 S).continuousOn

