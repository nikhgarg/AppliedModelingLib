/--
The population `Lp` gradient coordinate is adapted to the natural filtration
of the canonical Model B process whenever the projection is Borel measurable.
-/
theorem stronglyMeasurable_finiteModelBPopulationLpGradient_coordinate_natural
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project)
    (n : ℕ) (i : Coord) :
    StronglyMeasurable[finiteModelBIdealNaturalFiltration (Coord := Coord) n]
      (fun omega => finiteModelBPopulationLpGradient D p
        (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  have hdiff : Measurable
      (fun z : (Coord → ℝ) × (Coord → ℝ) => fun j => z.1 j - z.2 j) := by
    apply measurable_pi_lambda _
    intro j
    exact ((measurable_pi_apply j).comp measurable_fst).sub
      ((measurable_pi_apply j).comp measurable_snd)
  have hgradient : Measurable
      (fun z : (Coord → ℝ) × (Coord → ℝ) =>
        lpCostGradientCandidate p (fun j => z.1 j - z.2 j)) :=
    (measurable_lpCostGradientCandidate p).comp hdiff
  have hcoordinate : StronglyMeasurable
      (fun z : (Coord → ℝ) × (Coord → ℝ) =>
        lpCostGradientCandidate p (fun j => z.1 j - z.2 j) i) :=
    ((measurable_pi_apply i).comp hgradient).stronglyMeasurable
  have hpopulation : StronglyMeasurable
      (fun state : Coord → ℝ => ∫ ideal,
        lpCostGradientCandidate p (fun j => state j - ideal j) i ∂D.idealMeasure) :=
    hcoordinate.integral_prod_right
  simpa only [finiteModelBPopulationLpGradient] using
    hpopulation.comp_measurable
      (stronglyMeasurable_finiteModelBOutcomeTrajectory_natural D p r0 project
        initial hproject n).measurable

/--
With a Borel projection, the actual sampled-gradient fluctuation around its
population direction is conditionally mean zero at every Model B step.
-/
theorem finiteModelBOutcomeTrajectory_centeredLpGradient_condExp_ae_eq_zero_of_measurable_project
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project)
    (n : ℕ) (i : Coord)
    (hintegrable : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
        lpCostGradientCandidate p
          (fun j =>
            finiteModelBOutcomePrefixTrajectory D p r0 project initial n z.1 j - z.2 j) i)
      (Measure.map (fun omega =>
        (finiteModelBIdealPastPrefix (Coord := Coord) n omega,
          finiteModelBIdealSample (Coord := Coord) n omega))
        (finiteModelBIdealSequenceMeasure D))) :
    (finiteModelBIdealSequenceMeasure D)[
      (fun omega => lpCostGradientCandidate p
        (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
          finiteModelBIdealSample n omega j) i) -
        (fun omega => finiteModelBPopulationLpGradient D p
          (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i) |
        finiteModelBIdealNaturalFiltration (Coord := Coord) n] =ᵐ[
          finiteModelBIdealSequenceMeasure D] 0 := by
  exact finiteModelBOutcomeTrajectory_centeredLpGradient_condExp_ae_eq_zero
    D p r0 project initial n i hintegrable
    (stronglyMeasurable_finiteModelBPopulationLpGradient_coordinate_natural
      D p r0 project initial hproject n i)

/--
The actual Model B state at time `n` is independent of the ideal point drawn
for its next update.  This is derived from the canonical iid sequence and the
past-measurability result above.
