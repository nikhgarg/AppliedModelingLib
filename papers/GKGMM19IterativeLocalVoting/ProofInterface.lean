/-- A canonical expected finite `L1` minimizer from C1 compactness. -/
noncomputable def finiteModelBExpectedLpOneReference
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) : Coord → ℝ :=
  Classical.choose (finiteModelBExpectedLpMinimizerSet_one_nonempty_of_C1C2 S)

theorem finiteModelBExpectedLpReference_mem_minimizerSet
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {p q : ℝ} (hdual : HolderDualFinite p q) :
    finiteModelBExpectedLpReference S hdual ∈
      finiteModelBExpectedLpMinimizerSet D p E.solutionSpace :=
  Classical.choose_spec (finiteModelBExpectedLpMinimizerSet_nonempty_of_C1C2 S hdual)

theorem finiteModelBExpectedLpOneReference_mem_minimizerSet
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    finiteModelBExpectedLpOneReference S ∈
      finiteModelBExpectedLpMinimizerSet D 1 E.solutionSpace :=
  Classical.choose_spec (finiteModelBExpectedLpMinimizerSet_one_nonempty_of_C1C2 S)

/-- Members of the canonical target set are feasible minimizers. -/
theorem finiteModelBExpectedLpMinimizerSet_mem
    {Coord : Type*} [Fintype Coord]
    {D : FiniteCoordinateIdealDistributionData Coord} {p : ℝ}
    {solutionSpace : Set (Coord → ℝ)} {target : Coord → ℝ}
    (htarget : target ∈ finiteModelBExpectedLpMinimizerSet D p solutionSpace) :
    target ∈ solutionSpace ∧
      IsMinOn (finiteModelBExpectedLpCost D p) solutionSpace target :=
  htarget

/--
Source-level identification of the canonical expected `Lp` objective with the
paper's social-welfare target.  The abstract environment intentionally leaves
societal utility and its named optimum set opaque, so this records their exact
finite-coordinate source semantics rather than assuming a convergence result.
-/
structure FiniteModelBLpSocialObjectiveSource
    {Voter Coord : Type*} [Fintype Coord]
    (E : ILVEnvironment Voter (Coord → ℝ))
    (D : FiniteCoordinateIdealDistributionData Coord) (p : ℝ) : Prop where
  societalUtility_eq_neg_expectedLpCost : ∀ x,
    E.societalUtility x = -finiteModelBExpectedLpCost D p x
  mem_socialOptimal_iff_societalUtility_isMaxOn : ∀ x,
    x ∈ E.socialOptimal ↔ x ∈ E.solutionSpace ∧
      IsMaxOn E.societalUtility E.solutionSpace x

/-- The source objective identity turns expected-cost minimizers into social optima. -/
theorem FiniteModelBLpSocialObjectiveSource.minimizerSet_eq_socialOptimal
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord} {p : ℝ}
    (T : FiniteModelBLpSocialObjectiveSource E D p) :
    finiteModelBExpectedLpMinimizerSet D p E.solutionSpace = E.socialOptimal := by
  have hcost : socialCostObjective E = finiteModelBExpectedLpCost D p := by
    funext x
    rw [socialCostObjective, T.societalUtility_eq_neg_expectedLpCost]
    ring
  ext x
  constructor
  · rintro ⟨hx, hmin⟩
    apply (T.mem_socialOptimal_iff_societalUtility_isMaxOn x).mpr
    refine ⟨hx, ?_⟩
    apply (socialCostObjective_isMinOn_iff_societalUtility_isMaxOn E x).mp
    simpa only [hcost] using hmin
  · intro hx
    rcases (T.mem_socialOptimal_iff_societalUtility_isMaxOn x).mp hx with
      ⟨hxmem, hmax⟩
    refine ⟨hxmem, ?_⟩
    have hmin := (socialCostObjective_isMinOn_iff_societalUtility_isMaxOn E x).mpr hmax
    simpa only [hcost] using hmin

/-- The source social-objective identification for the finite-coordinate `L∞` endpoint. -/
structure FiniteModelBLinfSocialObjectiveSource
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (E : ILVEnvironment Voter (Coord → ℝ))
    (D : FiniteCoordinateIdealDistributionData Coord) : Prop where
  societalUtility_eq_neg_expectedLinfCost : ∀ x,
    E.societalUtility x = -finiteModelBExpectedLinfCost D x
  mem_socialOptimal_iff_societalUtility_isMaxOn : ∀ x,
    x ∈ E.socialOptimal ↔ x ∈ E.solutionSpace ∧
      IsMaxOn E.societalUtility E.solutionSpace x

/-- The finite `L∞` expected-cost minimizers are exactly the source social optima. -/
theorem FiniteModelBLinfSocialObjectiveSource.minimizerSet_eq_socialOptimal
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    (T : FiniteModelBLinfSocialObjectiveSource E D) :
    finiteModelBExpectedLinfMinimizerSet D E.solutionSpace = E.socialOptimal := by
  have hcost : socialCostObjective E = finiteModelBExpectedLinfCost D := by
    funext x
    rw [socialCostObjective, T.societalUtility_eq_neg_expectedLinfCost]
    ring
  ext x
  constructor
  · rintro ⟨hx, hmin⟩
    apply (T.mem_socialOptimal_iff_societalUtility_isMaxOn x).mpr
    refine ⟨hx, ?_⟩
    apply (socialCostObjective_isMinOn_iff_societalUtility_isMaxOn E x).mp
    simpa only [hcost] using hmin
  · intro hx
    rcases (T.mem_socialOptimal_iff_societalUtility_isMaxOn x).mp hx with
      ⟨hxmem, hmax⟩
    refine ⟨hxmem, ?_⟩
    have hmin := (socialCostObjective_isMinOn_iff_societalUtility_isMaxOn E x).mpr hmax
    simpa only [hcost] using hmin

/--
Almost surely, the realized Model B candidate direction is a subgradient of
the sampled finite `Lp` cost at the actual current state.  Restricting this
whole-space statement to a feasible solution set supplies the sampled
subgradient field of a projected SSGM execution.
-/
theorem finiteModelBOutcomeTrajectory_sampledLpDirection_subgradient_ae
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) {p r0 : ℝ}
    (hp : 1 < p) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project)
    (solutionSpace : Set (Coord → ℝ)) (n : ℕ) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D,
      AppliedModelingLib.Optimization.FiniteSubgradientOn
        (fun state => AppliedModelingLib.FiniteDimensionalNorms.lp p
          (fun j => state j - finiteModelBIdealSample n omega j))
        solutionSpace
        (finiteModelBOutcomeTrajectory D p r0 project initial n omega)
        (lpCostGradientCandidate p
          (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j -
            finiteModelBIdealSample n omega j)) := by
  filter_upwards [finiteModelBOutcomeTrajectory_ae_coordinate_noncollision
    D p r0 project initial hproject n] with omega hcoord
  intro y _hy
  exact finiteSubgradientAt_lpCostGradientCandidate hp hcoord y

/--
Whenever the population cost and gradient coordinates are integrable, the
actual Model B population direction is a subgradient of the expected `Lp`
objective at every iterate (hence almost surely at every fixed time).
-/
theorem finiteModelBOutcomeTrajectory_populationLpGradient_subgradient_ae
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) {p r0 : ℝ}
    (hp : 1 < p) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (solutionSpace : Set (Coord → ℝ)) (n : ℕ)
    (hcost_integrable : ∀ state : Coord → ℝ,
      Integrable (fun ideal => AppliedModelingLib.FiniteDimensionalNorms.lp p
        (fun j => state j - ideal j)) D.idealMeasure)
    (hgradient_integrable : ∀ state : Coord → ℝ, ∀ i,
      Integrable (fun ideal => lpCostGradientCandidate p
        (fun j => state j - ideal j) i) D.idealMeasure) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure D,
      AppliedModelingLib.Optimization.FiniteSubgradientOn
        (finiteModelBExpectedLpCost D p) solutionSpace
        (finiteModelBOutcomeTrajectory D p r0 project initial n omega)
        (finiteModelBPopulationLpGradient D p
          (finiteModelBOutcomeTrajectory D p r0 project initial n omega)) := by
  filter_upwards [] with omega
  exact finiteModelBPopulationLpGradient_subgradientOn_expectedLpCost
    D hp solutionSpace
    (finiteModelBOutcomeTrajectory D p r0 project initial n omega)
    hcost_integrable
    (hgradient_integrable
      (finiteModelBOutcomeTrajectory D p r0 project initial n omega))

