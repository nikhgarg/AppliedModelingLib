  have hcoordinate := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
    (fun j => finiteModelBOutcomeTrajectory D p r0 project initial n omega j - target j) i
  have hcoordinate_bound :
      |finiteModelBOutcomeTrajectory D p r0 project initial n omega i - target i| ≤
        finiteModelBC1C2L2Diameter S :=
