/--
The random perturbation contribution in one projected-subgradient descent
step has the conditional bound obtained by combining its C3 first and second
moment estimates.
-/
theorem finiteModelAL1LinfOutcomeSubgradientPerturbation_condExp_descentError_le
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (n : ℕ) {distanceBound : ℝ} (hdistanceBound : 0 ≤ distanceBound) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega =>
        2 * ilvRadius r0 (n + 1) * distanceBound *
          AppliedModelingLib.FiniteDimensionalNorms.l2
            (finiteModelAL1LinfOutcomeSubgradientPerturbation D r0 project initial n omega) +
        3 * ilvRadius r0 (n + 1) ^ 2 *
          AppliedModelingLib.FiniteDimensionalNorms.l2Sq
            (finiteModelAL1LinfOutcomeSubgradientPerturbation D r0 project initial n omega) |
      finiteModelBIdealNaturalFiltration (Coord := Coord) n] ≤ᵐ[
        finiteModelBIdealSequenceMeasure D]
      fun _ =>
        (2 * ilvRadius r0 (n + 1) * distanceBound) *
          ((2 * Real.sqrt (Fintype.card Coord)) *
            (ilvRadius r0 (n + 1) * finiteModelBC1C2CoordinateSlabRealConstant S)) +
        (3 * ilvRadius r0 (n + 1) ^ 2) *
          ((4 * Fintype.card Coord) *
            (ilvRadius r0 (n + 1) * finiteModelBC1C2CoordinateSlabRealConstant S)) := by
  apply AppliedModelingLib.Optimization.condExp_linear_combination_le_of_bounds
  · exact integrable_finiteModelAL1LinfOutcomeSubgradientPerturbation_l2
      D hr0 project initial S.project_measurable n
  · exact integrable_finiteModelAL1LinfOutcomeSubgradientPerturbation_l2Sq
      D hr0 project initial S.project_measurable n
  · exact mul_nonneg
      (mul_nonneg (by norm_num) (ilvRadius_nonneg (le_of_lt hr0) (n + 1)))
      hdistanceBound
  · exact mul_nonneg (by norm_num) (sq_nonneg _)
  · exact finiteModelAL1LinfOutcomeSubgradientPerturbation_condExp_l2_le
      S hr0 initial n
  · exact finiteModelAL1LinfOutcomeSubgradientPerturbation_condExp_l2Sq_le
      S hr0 initial n

/-- The exact radial perturbation has C3 conditional squared moment `O(r_t)`. -/
theorem finiteModelAL2OutcomeSubgradientPerturbation_condExp_l2Sq_le
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (n : ℕ) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (finiteModelAL2OutcomeSubgradientPerturbation D r0 project initial n omega) |
      finiteModelBIdealNaturalFiltration (Coord := Coord) n] ≤ᵐ[
        finiteModelBIdealSequenceMeasure D]
      fun _ => 4 *
        (ilvRadius r0 (n + 1) * finiteModelBC1C2CoordinateSlabRealConstant S) := by
  classical
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  let radius : ℝ := ilvRadius r0 (n + 1)
  let test : (Coord → ℝ) → (Coord → ℝ) → ℝ := fun state ideal =>
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (l2BallDirectionSubgradientPerturbation state ideal radius)
  let pair : (ℕ → Coord → ℝ) →
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) := fun omega =>
    (finiteModelBIdealPastPrefix n omega, finiteModelBIdealSample n omega)
  have hpair_measurable : Measurable pair :=
    (measurable_finiteModelBIdealPastPrefix n).prodMk
      (measurable_finiteModelBIdealSample n)
  letI : IsProbabilityMeasure (Measure.map pair (finiteModelBIdealSequenceMeasure D)) :=
    Measure.isProbabilityMeasure_map hpair_measurable.aemeasurable
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  have hstate_ideal : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      (finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1, z.2)) :=
    ((measurable_finiteModelAL2OutcomePrefixTrajectory D r0 project initial
      S.project_measurable n).comp measurable_fst).prodMk measurable_snd
  have htest_measurable : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      test (finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1) z.2) := by
    exact hl2sq.comp ((measurable_l2BallDirectionSubgradientPerturbation radius).comp
      hstate_ideal)
  have htest : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      test (finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1) z.2)
      (Measure.map pair (finiteModelBIdealSequenceMeasure D)) := by
    refine Integrable.mono' (integrable_const 4)
      htest_measurable.aestronglyMeasurable ?_
    filter_upwards [] with z
    have hbound := l2BallDirectionSubgradientPerturbation_l2Sq_le_four
      (center := finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1)
      (ideal := z.2) (ilvRadius_succ_pos hr0 n)
    simpa only [test, radius, Real.norm_eq_abs,
      abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hbound
  have hconditional := finiteModelAL2OutcomeTrajectory_condExp_ae_eq_integral
    D r0 project initial n test (by simpa only [pair] using htest)
  have hintegral : ∀ state : Coord → ℝ,
      (∫ ideal, test state ideal ∂D.idealMeasure) ≤
        4 * (radius * finiteModelBC1C2CoordinateSlabRealConstant S) := by
    intro state
    calc
      (∫ ideal, test state ideal ∂D.idealMeasure) ≤
          4 * (D.idealMeasure (l2BallBadEvent state radius)).toReal := by
        simpa only [test] using
          integral_l2BallDirectionSubgradientPerturbation_l2Sq_le D state
            (ilvRadius_succ_pos hr0 n)
      _ ≤ 4 * (radius * finiteModelBC1C2CoordinateSlabRealConstant S) := by
        apply mul_le_mul_of_nonneg_left
        · exact finiteModelBC1C2_l2BallBadEvent_measureReal_le S state
            (ilvRadius_nonneg (le_of_lt hr0) (n + 1))
        · norm_num
  filter_upwards [hconditional] with omega hconditional
  change (finiteModelBIdealSequenceMeasure D)[
      fun omega => test (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) |
      finiteModelBIdealNaturalFiltration (Coord := Coord) n] omega ≤ _
  rw [hconditional]
  simpa only [radius] using
    hintegral (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)

/--
Along the exact iid `(2,2)` Model A execution, the Borel exceptional envelope
for a non-subgradient response has the source's conditional `O(r_t)` rate.
The immediately following good-event theorem identifies this envelope as a
superset of the actual subgradient-failure event.
-/
theorem finiteModelAL2Outcome_l2BallBadEvent_condExp_le
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (n : ℕ) :
    (finiteModelBIdealSequenceMeasure D)[
      fun omega =>
        (l2BallBadEvent
          (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
          (ilvRadius r0 (n + 1))).indicator (fun _ => (1 : ℝ))
          (finiteModelBIdealSample n omega) |
      finiteModelBIdealNaturalFiltration (Coord := Coord) n] ≤ᵐ[
        finiteModelBIdealSequenceMeasure D]
      fun _ => ilvRadius r0 (n + 1) *
        finiteModelBC1C2CoordinateSlabRealConstant S := by
  classical
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  let radius : ℝ := ilvRadius r0 (n + 1)
  let test : (Coord → ℝ) → (Coord → ℝ) → ℝ := fun state ideal =>
    (l2BallBadEvent state radius).indicator (fun _ => (1 : ℝ)) ideal
  let pair : (ℕ → Coord → ℝ) →
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) := fun omega =>
    (finiteModelBIdealPastPrefix n omega, finiteModelBIdealSample n omega)
  have hpair_measurable : Measurable pair :=
    (measurable_finiteModelBIdealPastPrefix n).prodMk
      (measurable_finiteModelBIdealSample n)
  letI : IsProbabilityMeasure
      (Measure.map pair (finiteModelBIdealSequenceMeasure D)) :=
    Measure.isProbabilityMeasure_map hpair_measurable.aemeasurable
  have hstate_ideal : Measurable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      (finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1, z.2)) :=
    ((measurable_finiteModelAL2OutcomePrefixTrajectory D r0 project initial
      S.project_measurable n).comp measurable_fst).prodMk measurable_snd
  have htest : Integrable (fun z :
      (Fin (n + 1) → Coord → ℝ) × (Coord → ℝ) =>
      test (finiteModelAL2OutcomePrefixTrajectory D r0 project initial n z.1) z.2)
      (Measure.map pair (finiteModelBIdealSequenceMeasure D)) := by
    let event : Set ((Coord → ℝ) × (Coord → ℝ)) :=
      {z | z.2 ∈ l2BallBadEvent z.1 radius}
    have hevent : MeasurableSet event :=
      measurableSet_l2BallBadEvent_state_ideal radius
    simpa only [test, event] using
      ((integrable_const (1 : ℝ)).indicator (hevent.preimage hstate_ideal))
  have hconditional := finiteModelAL2OutcomeTrajectory_condExp_ae_eq_integral
    D r0 project initial n test (by simpa only [pair] using htest)
  have hintegral : ∀ state : Coord → ℝ,
      (∫ ideal, test state ideal ∂D.idealMeasure) ≤
        radius * finiteModelBC1C2CoordinateSlabRealConstant S := by
    intro state
    calc
      (∫ ideal, test state ideal ∂D.idealMeasure) =
          (D.idealMeasure (l2BallBadEvent state radius)).toReal := by
        simpa only [test, Measure.real] using
          (MeasureTheory.integral_indicator_one (μ := D.idealMeasure)
            (measurableSet_l2BallBadEvent state radius))
      _ ≤ radius * finiteModelBC1C2CoordinateSlabRealConstant S :=
        finiteModelBC1C2_l2BallBadEvent_measureReal_le S state
          (ilvRadius_nonneg (le_of_lt hr0) (n + 1))
  filter_upwards [hconditional] with omega hconditional
  change (finiteModelBIdealSequenceMeasure D)[
      fun omega => test (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) |
      finiteModelBIdealNaturalFiltration (Coord := Coord) n] omega ≤ _
  rw [hconditional]
  simpa only [radius] using
    hintegral (finiteModelAL2OutcomeTrajectory D r0 project initial n omega)

