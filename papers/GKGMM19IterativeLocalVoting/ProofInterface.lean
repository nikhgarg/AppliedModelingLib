        h_adapted h0 n (h_subG n)
  exact
    proof_theorem3_finiteDot_eventual_fluctuation_of_condExp_zero_L1_bdd
      (μ := μ) (Y := Y) (ℱ := ℱ) (R := R)
      (expected := expected) (realized := realized) (base := base)
      hadapted_sum hintegrable hcond_zero h_L1 hcentered

