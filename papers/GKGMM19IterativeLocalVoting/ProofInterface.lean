      exact (S.geometry.closest_point_projection _).1

/-- The canonical joint-sample trajectory satisfies its displayed projected update. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_succ
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → (Component → ℝ) × (Coord → ℝ)) :
    weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial (n + 1) omega =
      project (fun i =>
        weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega i -
          ilvRadius r0 (n + 1) *
        weightedEuclideanJointSampleDirection D
              (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
              (AppliedModelingLib.iidSequenceSample n omega) i) := by
  rfl

/-- The unprojected canonical joint-sample point at one Model B step. -/
noncomputable def weightedEuclideanJointSampleOutcomeRawResponse
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (n : ℕ) (omega : ℕ → (Component → ℝ) × (Coord → ℝ)) : Coord → ℝ :=
  fun i => weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega i -
    ilvRadius r0 (n + 1) *
      weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) i

/--
Outside the C3 null noncollision event, the canonical raw point is exactly the
source Model B response in the negative sample-cost subgradient direction.
-/
theorem weightedEuclideanJointSampleOutcomeRawResponse_is_modelBResponse_ae
    {Coord Component : Type*} [Fintype Coord] [Nonempty Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure,
      ModelBFiniteResponseAt SourceNorm.l2
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
        (ilvRadius r0 (n + 1))
        (fun i => -weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega) i)
        (weightedEuclideanJointSampleOutcomeRawResponse D r0 project initial n omega) := by
  filter_upwards [
    weightedEuclideanJointSampleOutcomeTrajectory_sampledDirection_l2_eq_one_ae
      D r0 project initial hproject n] with omega hunit
  let direction : Coord → ℝ := weightedEuclideanJointSampleDirection D
    (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
    (AppliedModelingLib.iidSequenceSample n omega)
  change finiteCoordinateNorm SourceNorm.l2 direction = 1 at hunit
  have hnorm_neg : finiteCoordinateNorm SourceNorm.l2 (fun i => -direction i) = 1 := by
    calc
      finiteCoordinateNorm SourceNorm.l2 (fun i => -direction i) =
          finiteCoordinateNorm SourceNorm.l2 direction := by
        rw [finiteCoordinateNorm_l2]
        unfold AppliedModelingLib.FiniteDimensionalNorms.l2
          AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        congr 1
        apply Finset.sum_congr rfl
        intro i _hi
        ring
      _ = 1 := hunit
  have hneg_ne_zero : (fun i => -direction i) ≠ 0 := by
    intro hzero
    rw [hzero] at hnorm_neg
    have hzeroNorm :
        finiteCoordinateNorm SourceNorm.l2 (fun _ : Coord => (0 : ℝ)) = 0 := by
      simpa [finiteCoordinateNorm] using
        (AppliedModelingLib.FiniteDimensionalNorms.normL2_zero (ι := Coord))
    exact zero_ne_one (hzeroNorm.symm.trans hnorm_neg)
  rw [modelBFiniteResponseAt_formula,
    modelBFiniteNormalizedDirection_of_ne_zero _ _ hneg_ne_zero]
  funext i
  simp only [weightedEuclideanJointSampleOutcomeRawResponse,
    hnorm_neg, div_one, direction]
  ring

/-- Algorithm 1 projects the canonical raw Model B response back to C1's feasible set. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_eq_project_rawResponse
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
