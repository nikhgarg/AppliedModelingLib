theorem
    proof_theorem3_finiteDot_exists_sampledVoter_of_iid_weightedVoter_modelB_ilvRadius_shifted
    {Voter Coord : Type*} [Fintype Voter] [DecidableEq Voter]
    [MeasurableSpace Voter] [MeasurableSingletonClass Voter]
