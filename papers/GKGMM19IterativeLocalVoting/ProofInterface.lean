/-- The selected Model A update is projected SGD plus its centered noise and rare perturbation. -/
theorem weightedEuclideanJointSampleModelAOutcomeTrajectory_projected_populationNoisePerturbation_update
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {D : WeightedEuclideanJointSampleData Coord Component}
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    {r0 : ℝ} (hr0 : 0 < r0)
    (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (noise : ℕ → (ℕ → (Component → ℝ) × (Coord → ℝ)) → Coord → ℝ)
    (hnoise : ∀ n omega i,
      noise n omega i = weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) i -
          weightedEuclideanJointSamplePopulationDirection D
            (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega) i)
    (n : ℕ) (omega : ℕ → (Component → ℝ) × (Coord → ℝ)) :
    weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial (n + 1) omega =
      project (fun i =>
        weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega i -
          ilvRadius r0 (n + 1) *
            (weightedEuclideanJointSamplePopulationDirection D
                (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega) i +
              noise n omega i +
              weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation
                A r0 project initial n omega i)) := by
  rw [weightedEuclideanJointSampleModelAOutcomeTrajectory_succ]
  apply congrArg project
  funext i
  rw [hnoise]
  unfold weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation
  unfold weightedEuclideanJointSampleModelASubgradientPerturbation
    weightedEuclideanJointSampleModelARawDirection
  field_simp [ilvRadius_succ_pos hr0 n |>.ne']
  ring

