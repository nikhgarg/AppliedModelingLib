/--
Outcome-indexed Model B Algorithm 1 data for the finite `Lp` route.  Unlike
the legacy sampled-trace record, its trajectory is genuinely indexed by the
probability-space outcome.  The parent record supplies all stochastic
subgradient hypotheses; these fields identify the paper's radius, selected
voter ideals, norm projection, and displayed Model B direction.
-/
structure FiniteModelBILVOutcomeIndexedSSGMSource
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (E : ILVEnvironment Voter (Coord → ℝ)) (p q r0 : ℝ)
    (C : FiniteCoordinateC3Carrier E) extends
    FiniteCoordinateILVRandomSSGMExecution E where
  r0_pos : 0 < r0
  radius_eq : ∀ n, toFiniteCoordinateILVRandomSSGMExecution.radius (n + 1) =
    ilvRadius r0 (n + 1)
  project_norm : IsNormProjectionOnto E (SourceNorm.lp q)
    toFiniteCoordinateILVRandomSSGMExecution.project
  ideal_aemeasurable : ∀ n,
    AEMeasurable
      (fun omega => E.ideal
        (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega))
      toFiniteCoordinateILVRandomSSGMExecution.μ
  ideal_marginal_law : ∀ n,
    Measure.map
      (fun omega => E.ideal
        (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega))
      toFiniteCoordinateILVRandomSSGMExecution.μ = C.data.idealMeasure
  sampled_direction_eq : ∀ n, ∀ᵐ omega ∂toFiniteCoordinateILVRandomSSGMExecution.μ,
    toFiniteCoordinateILVRandomSSGMExecution.sampledDirection n omega =
      lpCostGradientCandidate p
        (fun i => toFiniteCoordinateILVRandomSSGMExecution.trajectory n omega i -
          E.ideal
            (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega) i)

/-- The source data give the displayed outcome-indexed projected Algorithm 1 update. -/
theorem FiniteModelBILVOutcomeIndexedSSGMSource.algorithm1_projected_update
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)} {p q r0 : ℝ}
    {C : FiniteCoordinateC3Carrier E}
    (S : FiniteModelBILVOutcomeIndexedSSGMSource E p q r0 C) (n : ℕ) :
    ∀ᵐ omega ∂S.μ,
      S.trajectory (n + 1) omega = S.project (fun i => S.trajectory n omega i -
        ilvRadius r0 (n + 1) * lpCostGradientCandidate p
          (fun j => S.trajectory n omega j -
            E.ideal (S.selectedVoter n omega) j) i) := by
  filter_upwards [S.toFiniteCoordinateILVRandomSSGMExecution.algorithm2_update n,
    S.sampled_direction_eq n] with omega hupdate hdirection
  simpa [S.radius_eq n, hdirection] using hupdate

/-- The concrete outcome-indexed Model B source run converges a.s. to a social optimum. -/
theorem FiniteModelBILVOutcomeIndexedSSGMSource.outcomeIndexed_convergesToSocialOptimal
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)} {p q r0 : ℝ}
    {C : FiniteCoordinateC3Carrier E}
    (S : FiniteModelBILVOutcomeIndexedSSGMSource E p q r0 C) :
    @OutcomeIndexedILVConvergesToSocietalOptimal
      Voter S.Ω (Coord → ℝ) S.measurableSpace inferInstance E S.μ S.trajectory :=
  S.toFiniteCoordinateILVRandomSSGMExecution.outcomeIndexed_convergesToSocialOptimal

/--
Model B's sampled Algorithm 2 source route with a set-valued social optimum.
This is the corrected replacement for the unique-target version above: it
retains the paper-radius, norm-projection, selected-ideal, and displayed
`Lp` direction formulas, while its parent carries no uniqueness premise.
-/
structure FiniteModelBILVOutcomeIndexedMinimizerSetSource
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (E : ILVEnvironment Voter (Coord → ℝ)) (p q r0 : ℝ)
    (carrier : FiniteCoordinateC3Carrier E) extends
    FiniteCoordinateILVRandomSampledMinimizerSetExecution E E.socialOptimal where
  r0_pos : 0 < r0
  radius_eq : ∀ n,
    toFiniteCoordinateILVRandomSampledMinimizerSetExecution.radius (n + 1) =
      ilvRadius r0 (n + 1)
  project_norm : IsNormProjectionOnto E (SourceNorm.lp q)
    toFiniteCoordinateILVRandomSampledMinimizerSetExecution.project
  ideal_aemeasurable : ∀ n,
    AEMeasurable
      (fun omega => E.ideal
        (toFiniteCoordinateILVRandomSampledMinimizerSetExecution.selectedVoter n omega))
      toFiniteCoordinateILVRandomSampledMinimizerSetExecution.μ
  ideal_marginal_law : ∀ n,
    Measure.map
      (fun omega => E.ideal
        (toFiniteCoordinateILVRandomSampledMinimizerSetExecution.selectedVoter n omega))
      toFiniteCoordinateILVRandomSampledMinimizerSetExecution.μ = carrier.data.idealMeasure
  sampled_direction_eq : ∀ n,
    ∀ᵐ omega ∂toFiniteCoordinateILVRandomSampledMinimizerSetExecution.μ,
      toFiniteCoordinateILVRandomSampledMinimizerSetExecution.sampledDirection n omega =
        lpCostGradientCandidate p
          (fun i =>
            toFiniteCoordinateILVRandomSampledMinimizerSetExecution.trajectory n omega i -
              E.ideal
                (toFiniteCoordinateILVRandomSampledMinimizerSetExecution.selectedVoter n omega) i)

/-- The corrected Model B source data yield the displayed projected update. -/
theorem FiniteModelBILVOutcomeIndexedMinimizerSetSource.algorithm1_projected_update
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)} {p q r0 : ℝ}
    {carrier : FiniteCoordinateC3Carrier E}
    (S : FiniteModelBILVOutcomeIndexedMinimizerSetSource E p q r0 carrier) (n : ℕ) :
    ∀ᵐ omega ∂S.μ,
      S.trajectory (n + 1) omega = S.project (fun i => S.trajectory n omega i -
        ilvRadius r0 (n + 1) * lpCostGradientCandidate p
          (fun j => S.trajectory n omega j - E.ideal (S.selectedVoter n omega) j) i) := by
  filter_upwards [
    S.toFiniteCoordinateILVRandomSampledMinimizerSetExecution.algorithm2_update n,
    S.sampled_direction_eq n] with omega hupdate hdirection
  simpa [S.radius_eq n, hdirection] using hupdate

/-- The corrected Model B source run converges almost surely to a social optimum. -/
theorem FiniteModelBILVOutcomeIndexedMinimizerSetSource.outcomeIndexed_convergesToSocialOptimal
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)} {p q r0 : ℝ}
    {carrier : FiniteCoordinateC3Carrier E}
    (S : FiniteModelBILVOutcomeIndexedMinimizerSetSource E p q r0 carrier) :
    @OutcomeIndexedILVConvergesToSocietalOptimal
      Voter S.Ω (Coord → ℝ) S.measurableSpace inferInstance E S.μ S.trajectory :=
  FiniteCoordinateILVRandomSampledMinimizerSetExecution.outcomeIndexed_convergesToSocialOptimal
    S.toFiniteCoordinateILVRandomSampledMinimizerSetExecution

/--
Outcome-indexed weighted-Euclidean ILV data for Proposition 1.  This is the
random-trajectory replacement for the older component sampled trace: it keeps
the component ideal laws and the displayed normalized weighted direction while
the parent execution supplies the complete stochastic-convergence hypotheses.
-/
structure WeightedEuclideanL2OutcomeIndexedSSGMSource
    {Voter Coord Component : Type*} [Fintype Coord] [Nonempty Coord]
    (E : ILVEnvironment Voter (Coord → ℝ))
    (W : WeightedEuclideanStructure Voter (Coord → ℝ) Component)
    (model : VoterResponseModel) (r0 : ℝ) extends
    FiniteCoordinateILVRandomSSGMExecution E where
  r0_pos : 0 < r0
  radius_eq : ∀ n, toFiniteCoordinateILVRandomSSGMExecution.radius (n + 1) =
    ilvRadius r0 (n + 1)
  project_norm : IsNormProjectionOnto E SourceNorm.l2
    toFiniteCoordinateILVRandomSSGMExecution.project
  componentIdeal : Component → Voter → Coord → ℝ
  componentDistribution : Component → FiniteCoordinateIdealDistributionData Coord
  coefficient_nonneg :
    ∀ n omega k, k ∈ W.components →
      0 ≤ W.weight
        (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega) k /
        W.weightNorm2
          (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega)
  component_distance_eq_l2 :
    ∀ n omega k, k ∈ W.components → ∀ x : Coord → ℝ,
      W.componentDistance k x
        (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega) =
        finiteCoordinateDistance SourceNorm.l2 x
          (componentIdeal k
            (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega))
  component_ideal_aemeasurable :
    ∀ n k, k ∈ W.components →
      AEMeasurable
        (fun omega => componentIdeal k
          (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega))
        toFiniteCoordinateILVRandomSSGMExecution.μ
  component_ideal_marginal_law :
    ∀ n k, k ∈ W.components →
      Measure.map
        (fun omega => componentIdeal k
          (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega))
        toFiniteCoordinateILVRandomSSGMExecution.μ =
        (componentDistribution k).idealMeasure
  sampled_direction_eq : ∀ n,
    ∀ᵐ omega ∂toFiniteCoordinateILVRandomSSGMExecution.μ,
      toFiniteCoordinateILVRandomSSGMExecution.sampledDirection n omega =
        fun i => W.components.sum (fun k =>
          (W.weight
              (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega) k /
            W.weightNorm2
              (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega)) *
            lpCostGradientCandidate 2
              (fun j =>
                toFiniteCoordinateILVRandomSSGMExecution.trajectory n omega j -
                  componentIdeal k
                    (toFiniteCoordinateILVRandomSSGMExecution.selectedVoter n omega) j) i)

/-- The weighted source data give the displayed outcome-indexed projected update. -/
theorem WeightedEuclideanL2OutcomeIndexedSSGMSource.algorithm1_projected_update
    {Voter Coord Component : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {W : WeightedEuclideanStructure Voter (Coord → ℝ) Component}
    {model : VoterResponseModel} {r0 : ℝ}
    (S : WeightedEuclideanL2OutcomeIndexedSSGMSource E W model r0) (n : ℕ) :
    ∀ᵐ omega ∂S.μ,
      S.trajectory (n + 1) omega = S.project (fun i => S.trajectory n omega i -
        ilvRadius r0 (n + 1) * W.components.sum (fun k =>
          (W.weight (S.selectedVoter n omega) k /
            W.weightNorm2 (S.selectedVoter n omega)) *
            lpCostGradientCandidate 2
              (fun j => S.trajectory n omega j -
                S.componentIdeal k (S.selectedVoter n omega) j) i)) := by
  filter_upwards [S.toFiniteCoordinateILVRandomSSGMExecution.algorithm2_update n,
    S.sampled_direction_eq n] with omega hupdate hdirection
  simpa [S.radius_eq n, hdirection] using hupdate

/-- The concrete weighted-Euclidean source run converges a.s. to a social optimum. -/
theorem WeightedEuclideanL2OutcomeIndexedSSGMSource.outcomeIndexed_convergesToSocialOptimal
    {Voter Coord Component : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {W : WeightedEuclideanStructure Voter (Coord → ℝ) Component}
    {model : VoterResponseModel} {r0 : ℝ}
    (S : WeightedEuclideanL2OutcomeIndexedSSGMSource E W model r0) :
    @OutcomeIndexedILVConvergesToSocietalOptimal
      Voter S.Ω (Coord → ℝ) S.measurableSpace inferInstance E S.μ S.trajectory :=
  S.toFiniteCoordinateILVRandomSSGMExecution.outcomeIndexed_convergesToSocialOptimal

/--
Set-valued outcome-indexed weighted-Euclidean ILV data for Proposition 1.
The model retains the sampled component formula, while convergence follows from
the generic minimizer-set theorem and therefore does not impose a hidden
