with population direction, canonical centered noise, and zero deterministic
bias.
-/
theorem finiteModelBOutcomeTrajectory_projected_populationNoise_update
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (p r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (n : ℕ) (omega : ℕ → Coord → ℝ) :
    finiteModelBOutcomeTrajectory D p r0 project initial (n + 1) omega =
      project (fun i => finiteModelBOutcomeTrajectory D p r0 project initial n omega i -
        ilvRadius r0 (n + 1) *
          (finiteModelBPopulationLpGradient D p
            (finiteModelBOutcomeTrajectory D p r0 project initial n omega) i +
            finiteModelBOutcomeLpGradientNoise D p r0 project initial n omega i + 0)) := by
  rw [finiteModelBOutcomeTrajectory_succ]
  apply congrArg project
  funext i
  simp only [finiteModelBOutcomeLpGradientNoise]
  ring

