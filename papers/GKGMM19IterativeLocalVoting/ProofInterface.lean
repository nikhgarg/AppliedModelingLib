    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) : Coord → ℝ :=
  Classical.choose (finiteModelBExpectedLinfMinimizerSet_nonempty_of_C1C2 S)

theorem finiteModelBExpectedLinfReference_mem_minimizerSet
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
