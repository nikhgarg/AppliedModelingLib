        (weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega)) = 1 := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  let pair : (ℕ → (Component → ℝ) × (Coord → ℝ)) →
      (Fin (n + 1) → (Component → ℝ) × (Coord → ℝ)) ×
        ((Component → ℝ) × (Coord → ℝ)) := fun omega =>
    (AppliedModelingLib.iidSequencePastPrefix n omega, AppliedModelingLib.iidSequenceSample n omega)
  let test : (Fin (n + 1) → (Component → ℝ) × (Coord → ℝ)) ×
      ((Component → ℝ) × (Coord → ℝ)) → ℝ := fun z =>
    AppliedModelingLib.FiniteDimensionalNorms.l2
      (weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleModelAOutcomePrefixTrajectory A r0 project initial n z.1)
        z.2)
  have hpair : Measurable pair :=
    (AppliedModelingLib.measurable_iidSequencePastPrefix n).prodMk
      (AppliedModelingLib.measurable_iidSequenceSample n)
  have htest : Measurable test := by
    exact AppliedModelingLib.FiniteDimensionalNorms.continuous_l2.measurable.comp
      ((measurable_weightedEuclideanL2BlockSampleDirection Finset.univ
        D.componentBlock D.sampleWeight D.sampleWeightNorm2 D.sampleIdeal
        D.measurable_sampleWeight D.measurable_sampleWeightNorm2
          D.measurable_sampleIdeal).comp
        ((measurable_weightedEuclideanJointSampleModelAOutcomePrefixTrajectory
          A r0 project initial hproject n).comp measurable_fst |>.prodMk measurable_snd))
  have hmeasSet : MeasurableSet {z | test z = 1} := by
    simpa only [test, Set.preimage_setOf_eq] using htest (measurableSet_singleton (1 : ℝ))
  have hproduct : ∀ᵐ z ∂(Measure.map (AppliedModelingLib.iidSequencePastPrefix n)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)).prod D.jointMeasure, test z = 1 := by
    rw [Measure.ae_prod_iff_ae_ae hmeasSet]
    exact Filter.Eventually.of_forall fun past => by
      simpa only [test, finiteCoordinateNorm_l2] using
        weightedEuclideanJointSampleDirection_l2_eq_one_ae D
          (weightedEuclideanJointSampleModelAOutcomePrefixTrajectory A r0 project initial n past)
  have hpair_law : ∀ᵐ z ∂Measure.map pair
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure), test z = 1 := by
    rw [AppliedModelingLib.iidSequencePastPrefix_sample_pair_law D.jointMeasure n]
    exact hproduct
  have hactual : ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure,
      test (pair omega) = 1 :=
    MeasureTheory.ae_of_ae_map hpair.aemeasurable hpair_law
  filter_upwards [hactual] with omega hunit
  simpa only [test, pair, finiteCoordinateNorm_l2,
    weightedEuclideanJointSampleModelAOutcomePrefixTrajectory_pastPrefix_eq] using hunit

/-- Each selected Model A noise coordinate is bounded by two almost surely. -/
theorem weightedEuclideanJointSampleModelAOutcomeGradientNoise_coord_abs_le_two_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure,
      |weightedEuclideanJointSampleModelAOutcomeGradientNoise
        D A r0 project initial n omega i| ≤ 2 := by
  filter_upwards [
    weightedEuclideanJointSampleModelAOutcomeTrajectory_sampledDirection_l2_eq_one_ae
      D A r0 project initial hproject n] with omega hunit
  unfold weightedEuclideanJointSampleModelAOutcomeGradientNoise
  have hsample_coordinate := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
    (weightedEuclideanJointSampleDirection D
      (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
      (AppliedModelingLib.iidSequenceSample n omega)) i
  have hsample : |weightedEuclideanJointSampleDirection D
      (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
      (AppliedModelingLib.iidSequenceSample n omega) i| ≤ 1 := by
    calc
      _ ≤ AppliedModelingLib.FiniteDimensionalNorms.l2
        (weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega)) := hsample_coordinate
      _ = 1 := by simpa only [finiteCoordinateNorm_l2] using hunit
  have hpopulation := weightedEuclideanJointSamplePopulationDirection_coord_abs_le_one
    D (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega) i
  calc
    |weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) i -
      weightedEuclideanJointSamplePopulationDirection D
        (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega) i| ≤
        |weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega) i| +
          |weightedEuclideanJointSamplePopulationDirection D
            (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega) i| := by
      simpa using abs_sub_le
        (weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega) i)
        0
        (weightedEuclideanJointSamplePopulationDirection D
          (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega) i)
    _ ≤ 2 := by linarith

/-- Every selected Model A noise coordinate is integrable. -/
theorem integrable_weightedEuclideanJointSampleModelAOutcomeGradientNoise_coordinate
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) (i : Coord) :
    Integrable (fun omega =>
      weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial n omega i)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  refine Integrable.mono' (integrable_const (2 : ℝ))
    ((measurable_pi_apply i).comp
      (measurable_weightedEuclideanJointSampleModelAOutcomeGradientNoise
        D A r0 project initial hproject n)).aestronglyMeasurable ?_
  filter_upwards [
    weightedEuclideanJointSampleModelAOutcomeGradientNoise_coord_abs_le_two_ae
      D A r0 project initial hproject n i] with omega hbound
  simpa only [Real.norm_eq_abs] using hbound

/-- The selected Model A centered-noise energy is bounded by four times dimension. -/
theorem weightedEuclideanJointSampleModelAOutcomeGradientNoise_l2Sq_le_four_card_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure,
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial n omega) ≤
          4 * Fintype.card Coord := by
  filter_upwards [
    weightedEuclideanJointSampleModelAOutcomeTrajectory_sampledDirection_l2_eq_one_ae
      D A r0 project initial hproject n] with omega hunit
  have hsample_coordinate : ∀ i,
      |weightedEuclideanJointSampleDirection D
        (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
        (AppliedModelingLib.iidSequenceSample n omega) i| ≤ 1 := by
    intro i
    calc
      _ ≤ AppliedModelingLib.FiniteDimensionalNorms.l2
        (weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega)) :=
        AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le _ i
      _ = 1 := by simpa only [finiteCoordinateNorm_l2] using hunit
  have hnoise_coordinate : ∀ i,
      |weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial n omega i| ≤ 2 := by
    intro i
    unfold weightedEuclideanJointSampleModelAOutcomeGradientNoise
    have hpopulation := weightedEuclideanJointSamplePopulationDirection_coord_abs_le_one
      D (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega) i
    calc
      |weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega) i -
        weightedEuclideanJointSamplePopulationDirection D
          (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega) i| ≤
          |weightedEuclideanJointSampleDirection D
            (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
            (AppliedModelingLib.iidSequenceSample n omega) i| +
            |weightedEuclideanJointSamplePopulationDirection D
              (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega) i| := by
        simpa using abs_sub_le
          (weightedEuclideanJointSampleDirection D
            (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
            (AppliedModelingLib.iidSequenceSample n omega) i)
          0
          (weightedEuclideanJointSamplePopulationDirection D
            (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega) i)
      _ ≤ 2 := by linarith [hsample_coordinate i]
  have hbound := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_card_mul_sq_of_abs_le
    (weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial n omega)
    (by norm_num : (0 : ℝ) ≤ 2) hnoise_coordinate
  norm_num at hbound ⊢
  simpa [mul_comm] using hbound

/-- The selected Model A centered-noise energy is integrable. -/
theorem integrable_weightedEuclideanJointSampleModelAOutcomeGradientNoise_l2Sq
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    Integrable (fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial n omega))
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  refine Integrable.mono' (integrable_const (4 * (Fintype.card Coord : ℝ)))
    (hl2sq.comp (measurable_weightedEuclideanJointSampleModelAOutcomeGradientNoise
      D A r0 project initial hproject n)).aestronglyMeasurable ?_
  filter_upwards [
    weightedEuclideanJointSampleModelAOutcomeGradientNoise_l2Sq_le_four_card_ae
      D A r0 project initial hproject n] with omega hbound
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hbound

/-- The selected Model A conditional noise energy has the same dimension bound. -/
theorem weightedEuclideanJointSampleModelAOutcomeGradientNoise_condExp_l2Sq_le_four_card
    {Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)[
      fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial n omega) |
      AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ)) n] ≤ᵐ[
          AppliedModelingLib.iidSequenceMeasure D.jointMeasure] fun _ => 4 * Fintype.card Coord := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  have henergy := integrable_weightedEuclideanJointSampleModelAOutcomeGradientNoise_l2Sq
    D A r0 project initial hproject n
  have hbound := weightedEuclideanJointSampleModelAOutcomeGradientNoise_l2Sq_le_four_card_ae
    D A r0 project initial hproject n
  have hcond := condExp_mono
    (m := AppliedModelingLib.iidSequenceNaturalFiltration
      (α := (Component → ℝ) × (Coord → ℝ)) n)
    henergy (integrable_const (4 * (Fintype.card Coord : ℝ))) hbound
  rw [condExp_const
    ((AppliedModelingLib.iidSequenceNaturalFiltration
      (α := (Component → ℝ) × (Coord → ℝ))).le n)
    (4 * (Fintype.card Coord : ℝ))] at hcond
  exact hcond

/-- Compact C1 geometry and selected Model A noise make each target product integrable. -/
theorem integrable_weightedEuclideanJointSampleModelAOutcomeTrajectory_target_noise_product_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) (i : Coord) :
    Integrable (fun omega =>
      (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega i - target i) *
        weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial n omega i)
      (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  have htrajectory := stronglyMeasurable_weightedEuclideanJointSampleModelAOutcomeTrajectory_natural
    A r0 project initial S.project_measurable n
  have htrajectory_meas : Measurable
      (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n) :=
    htrajectory.measurable.mono
      ((AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ))).le n) le_rfl
  have hstate : Measurable (fun omega : ℕ → (Component → ℝ) × (Coord → ℝ) =>
      weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega i - target i) :=
    ((measurable_pi_apply i).comp htrajectory_meas).sub measurable_const
  have hnoise := measurable_weightedEuclideanJointSampleModelAOutcomeGradientNoise
    D A r0 project initial S.project_measurable n
  have hmeas : Measurable (fun omega : ℕ → (Component → ℝ) × (Coord → ℝ) =>
      (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega i - target i) *
        weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial n omega i) :=
    hstate.mul ((measurable_pi_apply i).comp hnoise)
  refine Integrable.mono' (integrable_const (2 * finiteModelBC1C2L2Diameter S))
    hmeas.aestronglyMeasurable ?_
  filter_upwards [
    weightedEuclideanJointSampleModelAOutcomeGradientNoise_coord_abs_le_two_ae
      D A r0 project initial S.project_measurable n i] with omega hnoise_bound
  have hfeasible := weightedEuclideanJointSampleModelAOutcomeTrajectory_mem_solutionSpace_of_C1C2
    S A r0 initial hinitial n omega
  have hdistance := finiteModelBC1C2L2Diameter_bound S hfeasible htarget
  have hcoordinate := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
    (fun j => weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega j -
      target j) i
  have hcoordinate_bound :
      |weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega i - target i| ≤
        finiteModelBC1C2L2Diameter S := hcoordinate.trans hdistance
  rw [Real.norm_eq_abs, abs_mul]
  calc
    |weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega i - target i| *
        |weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial n omega i| ≤
        finiteModelBC1C2L2Diameter S * 2 :=
      mul_le_mul hcoordinate_bound hnoise_bound (abs_nonneg _)
        (finiteModelBC1C2L2Diameter_nonneg S)
    _ = 2 * finiteModelBC1C2L2Diameter S := by ring

/--
The actual iid weighted-Euclidean Model A recursion, instantiated as a
perturbed projected stochastic-subgradient minimizer-set execution.  Its
selection-specific term is controlled by the corrected block-crossing C3
estimate rather than by choosing values on a null or exceptional set.
-/
noncomputable def weightedEuclideanJointSampleModelACanonicalPerturbedMinimizerSetExecution
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (D : WeightedEuclideanJointSampleData Coord Component)
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (hinitial : initial ∈ E.solutionSpace) :
    AppliedModelingLib.Optimization.PerturbedProjectedStochasticSubgradientMinimizerSetExecution
      Coord where
  Ω := ℕ → (Component → ℝ) × (Coord → ℝ)
  measurableSpace := inferInstance
  μ := AppliedModelingLib.iidSequenceMeasure D.jointMeasure
  probability := by
    letI : IsProbabilityMeasure D.jointMeasure := D.probability
    exact AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  filtration := AppliedModelingLib.iidSequenceNaturalFiltration
  trajectory := weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial
  meanSubgradient := fun n omega => weightedEuclideanJointSamplePopulationDirection D
    (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega)
  noise := weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial
  perturbation := weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation
    A r0 project initial
  radius := ilvRadius r0
  solutionSpace := E.solutionSpace
  objective := weightedEuclideanJointSamplePopulationCost D
  project := project
  targetSet := weightedEuclideanJointSamplePopulationMinimizerSet D E.solutionSpace
  reference := weightedEuclideanJointSamplePopulationReference S
  reference_mem_targetSet :=
    weightedEuclideanJointSamplePopulationReference_mem_minimizerSet S
  targetSet_subset_solutionSpace := by
    intro target htarget
    exact htarget.1
  targetSet_minimizes := by
    intro target htarget
    exact htarget.2
  minimizer_mem_targetSet := by
    intro target htarget hmin
    exact ⟨htarget, hmin⟩
  project_nonexpansive := S.squaredDistance_nonexpansive
  trajectory_adapted := by
    intro i n
    exact ((measurable_pi_apply i).comp
      (stronglyMeasurable_weightedEuclideanJointSampleModelAOutcomeTrajectory_natural
        A r0 project initial S.project_measurable n).measurable).stronglyMeasurable
  target_objective_gap_adapted := by
    intro target _htarget
    exact stronglyAdapted_weightedEuclideanJointSampleModelAPopulationCost_gap_natural
      S A r0 initial target
  target_potential_integrable := by
    intro target htarget n
    exact integrable_weightedEuclideanJointSampleModelAOutcomeTrajectory_target_l2Sq_of_C1C2
      S A r0 initial target hinitial htarget.1 n
  target_objective_gap_integrable := by
    intro target htarget n
    exact integrable_weightedEuclideanJointSampleModelAPopulationCost_gap_of_C1C2
      S A r0 initial target hinitial htarget.1 n
  target_noise_product_integrable := by
    intro target htarget n i
    exact integrable_weightedEuclideanJointSampleModelAOutcomeTrajectory_target_noise_product_of_C1C2
      S A r0 initial target hinitial htarget.1 n i
  noise_coordinate_integrable := by
    intro n i
    exact integrable_weightedEuclideanJointSampleModelAOutcomeGradientNoise_coordinate
      D A r0 project initial S.project_measurable n i
  noise_mean_zero := by
    intro n i
    exact weightedEuclideanJointSampleModelAOutcomeGradientNoise_condExp_ae_eq_zero
      D A r0 project initial S.project_measurable n i
  noise_energy_integrable := by
    intro n
    exact integrable_weightedEuclideanJointSampleModelAOutcomeGradientNoise_l2Sq
      D A r0 project initial S.project_measurable n
  perturbation_norm_integrable := by
    intro n
    exact integrable_weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation_l2
      D A hr0 project initial S.project_measurable n
  perturbation_energy_integrable := by
    intro n
    exact integrable_weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation_l2Sq
      D A hr0 project initial S.project_measurable n
  C := Fintype.card Coord
  noiseBound := 4 * Fintype.card Coord
  target_distanceBound := fun _ => finiteModelBC1C2L2Diameter S
  C_nonneg := by positivity
  noiseBound_nonneg := by positivity
  target_distanceBound_nonneg := by
    intro _ _
    exact finiteModelBC1C2L2Diameter_nonneg S
  noise_energy_bound := by
    intro n
    exact weightedEuclideanJointSampleModelAOutcomeGradientNoise_condExp_l2Sq_le_four_card
      D A r0 project initial S.project_measurable n
  perturbation_error := fun _ n =>
    (4 * finiteModelBC1C2L2Diameter S *
        finiteModelBC1C2CoordinateSlabRealConstant S +
      12 * finiteModelBC1C2CoordinateSlabRealConstant S * r0) *
      ilvRadius r0 (n + 1) ^ 2
  perturbation_error_nonneg := by
    intro _ _ n
    apply mul_nonneg
    · apply add_nonneg
      · exact mul_nonneg
          (mul_nonneg (by norm_num) (finiteModelBC1C2L2Diameter_nonneg S))
          (finiteModelBC1C2CoordinateSlabRealConstant_nonneg S)
      · exact mul_nonneg
          (mul_nonneg (by norm_num)
            (finiteModelBC1C2CoordinateSlabRealConstant_nonneg S))
          (le_of_lt hr0)
    · exact sq_nonneg _
  perturbation_error_summable := by
    intro _ _
    have hsum := (ilvRadius_sq_summable r0).mul_left
      (4 * finiteModelBC1C2L2Diameter S *
          finiteModelBC1C2CoordinateSlabRealConstant S +
        12 * finiteModelBC1C2CoordinateSlabRealConstant S * r0)
    convert hsum using 1
  perturbation_error_bound := by
    intro target htarget n
    have hbound := weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation_condExp_descentError_le
      S A hr0 initial n (finiteModelBC1C2L2Diameter_nonneg S)
    filter_upwards [hbound] with omega hbound
    have hradius_le : ilvRadius r0 (n + 1) ≤ r0 :=
      ilvRadius_succ_le_initial (le_of_lt hr0) n
    have hslab_nonneg : 0 ≤ finiteModelBC1C2CoordinateSlabRealConstant S :=
      finiteModelBC1C2CoordinateSlabRealConstant_nonneg S
    have hcube : ilvRadius r0 (n + 1) ^ 3 ≤
        r0 * ilvRadius r0 (n + 1) ^ 2 := by
      calc
        ilvRadius r0 (n + 1) ^ 3 =
            ilvRadius r0 (n + 1) * ilvRadius r0 (n + 1) ^ 2 := by ring
        _ ≤ r0 * ilvRadius r0 (n + 1) ^ 2 :=
          mul_le_mul_of_nonneg_right hradius_le (sq_nonneg _)
    have hsecond :
        12 * finiteModelBC1C2CoordinateSlabRealConstant S *
            ilvRadius r0 (n + 1) ^ 3 ≤
          12 * finiteModelBC1C2CoordinateSlabRealConstant S * r0 *
            ilvRadius r0 (n + 1) ^ 2 := by
      have hcoefficient : 0 ≤ (12 : ℝ) * finiteModelBC1C2CoordinateSlabRealConstant S :=
        mul_nonneg (by norm_num) hslab_nonneg
      calc
        _ = ((12 : ℝ) * finiteModelBC1C2CoordinateSlabRealConstant S) *
              ilvRadius r0 (n + 1) ^ 3 := by ring
        _ ≤ ((12 : ℝ) * finiteModelBC1C2CoordinateSlabRealConstant S) *
              (r0 * ilvRadius r0 (n + 1) ^ 2) :=
            mul_le_mul_of_nonneg_left hcube hcoefficient
        _ = _ := by ring
    calc
      _ ≤ 2 * ilvRadius r0 (n + 1) * finiteModelBC1C2L2Diameter S *
          (2 * (ilvRadius r0 (n + 1) *
            finiteModelBC1C2CoordinateSlabRealConstant S)) +
        3 * ilvRadius r0 (n + 1) ^ 2 *
          (4 * (ilvRadius r0 (n + 1) *
            finiteModelBC1C2CoordinateSlabRealConstant S)) := hbound
      _ = 4 * finiteModelBC1C2L2Diameter S *
          finiteModelBC1C2CoordinateSlabRealConstant S *
            ilvRadius r0 (n + 1) ^ 2 +
          12 * finiteModelBC1C2CoordinateSlabRealConstant S *
            ilvRadius r0 (n + 1) ^ 3 := by ring
      _ ≤ 4 * finiteModelBC1C2L2Diameter S *
          finiteModelBC1C2CoordinateSlabRealConstant S *
            ilvRadius r0 (n + 1) ^ 2 +
          12 * finiteModelBC1C2CoordinateSlabRealConstant S * r0 *
            ilvRadius r0 (n + 1) ^ 2 := by
          simpa [add_comm] using
            (add_le_add_left hsecond
              (4 * finiteModelBC1C2L2Diameter S *
                finiteModelBC1C2CoordinateSlabRealConstant S *
                  ilvRadius r0 (n + 1) ^ 2))
      _ = _ := by ring
  update := by
    intro n
    filter_upwards [] with omega
    exact weightedEuclideanJointSampleModelAOutcomeTrajectory_projected_populationNoisePerturbation_update
      A hr0 project initial
      (weightedEuclideanJointSampleModelAOutcomeGradientNoise D A r0 project initial)
      (by intro m eta i; rfl) n omega
  subgradient := by
