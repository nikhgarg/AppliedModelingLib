            (weightedEuclideanJointSamplePopulationDirection D
                (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega) i +
              weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial n omega i)) := by
  rw [weightedEuclideanJointSampleOutcomeTrajectory_succ]
  apply congrArg project
  funext i
  unfold weightedEuclideanJointSampleOutcomeGradientNoise
  ring

/-- The realized joint voter direction is a sample-cost subgradient at every canonical step. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_sampledDirection_subgradient_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ) (initial : Coord → ℝ)
    (hproject : Measurable project) (n : ℕ) :
    ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure,
      FiniteSubgradientAt
        (weightedEuclideanJointSampleCost D (AppliedModelingLib.iidSequenceSample n omega))
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
        (weightedEuclideanJointSampleDirection D
          (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
          (AppliedModelingLib.iidSequenceSample n omega)) := by
  letI : Nonempty Coord := D.coordinate_nonempty
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  have hweight : ∀ᵐ omega ∂AppliedModelingLib.iidSequenceMeasure D.jointMeasure, ∀ k,
      0 ≤ D.sampleWeight (AppliedModelingLib.iidSequenceSample n omega) k /
        D.sampleWeightNorm2 (AppliedModelingLib.iidSequenceSample n omega) := by
    have hmap : ∀ᵐ sample ∂Measure.map (AppliedModelingLib.iidSequenceSample n)
        (AppliedModelingLib.iidSequenceMeasure D.jointMeasure), ∀ k,
        0 ≤ D.sampleWeight sample k / D.sampleWeightNorm2 sample := by
      rw [AppliedModelingLib.iidSequenceSample_law D.jointMeasure n]
      exact D.normalizedWeight_nonnegative_ae
    exact MeasureTheory.ae_of_ae_map
      (AppliedModelingLib.measurable_iidSequenceSample n).aemeasurable hmap
  filter_upwards [
    weightedEuclideanJointSampleOutcomeTrajectory_ae_coordinate_noncollision
      D r0 project initial hproject n,
    hweight]
      with omega hnoncollision hweight
  have hsub := finiteSubgradientAt_finset_nonneg_weighted_sum
    (Finset.univ : Finset Component)
    (fun k _ => hweight k)
    (fun k _ =>
      finiteSubgradientAt_blockL2DistanceNormalizedGradient
        (D.componentBlock k)
        (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
        (D.sampleIdeal (AppliedModelingLib.iidSequenceSample n omega) k) (by
          rcases D.componentBlocks_nonempty k with ⟨i, hi⟩
          exact ⟨i, hi, by
            simpa [WeightedEuclideanJointSampleData.sampleIdeal] using hnoncollision i⟩))
  simpa only [weightedEuclideanJointSampleCost,
    weightedEuclideanJointSampleDirection,
    weightedEuclideanL2BlockSampleDirection] using hsub

/-- The joint population direction is an objective subgradient along the canonical run. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_populationDirection_subgradientOn_ae_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component]
