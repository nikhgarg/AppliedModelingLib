/--
C1/C2 and full-dimensional bounded-density C3 make the event that a fresh
ideal lies within radius `r` of the current state in some coordinate at most
linear in the slab width.  This is the quantitative bad-region input for the
`L1`/`L∞` source cases; it contains no convergence conclusion.
-/
theorem finiteModelBC1C2_ideal_exists_coordinate_slab_measure_le
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (state : Coord → ℝ) (r : ℝ) :
    D.idealMeasure {ideal : Coord → ℝ |
        ∃ i, ideal i ∈ Set.Icc (state i - r) (state i + r)} ≤
      D.densityBound * (ENNReal.ofReal (2 * r) *
        finiteModelBC1C2CoordinateSlabVolumeCoefficient S) := by
  classical
  let box : Set (Coord → ℝ) :=
    Set.Icc (fun _ => -finiteModelBC1C2OriginL2Radius S)
      (fun _ => finiteModelBC1C2OriginL2Radius S)
  let bad : Set (Coord → ℝ) := {ideal |
    ∃ i, ideal i ∈ Set.Icc (state i - r) (state i + r)}
  let boundedBad : Set (Coord → ℝ) := {ideal |
    ideal ∈ box ∧ ∃ i, ideal i ∈ Set.Icc (state i - r) (state i + r)}
  have hsupported : ∀ᵐ ideal ∂D.idealMeasure, ideal ∈ box := by
    filter_upwards [S.ideal_mem_solutionSpace_ae] with ideal hideal
    exact finiteModelBC1C2_mem_symmetric_coordinateBox S hideal
  have hcongr : bad =ᵐ[D.idealMeasure] boundedBad := by
    filter_upwards [hsupported] with ideal hideal
    simp only [bad, boundedBad]
    apply propext
    constructor
    · intro hbad
      exact ⟨hideal, hbad⟩
    · exact fun hbad => hbad.2
  calc
    D.idealMeasure bad = D.idealMeasure boundedBad := measure_congr hcongr
    _ ≤ D.densityBound * (ENNReal.ofReal (2 * r) *
        finiteModelBC1C2CoordinateSlabVolumeCoefficient S) := by
      simpa only [boundedBad, box,
        finiteModelBC1C2CoordinateSlabVolumeCoefficient] using
        AppliedModelingLib.Probability.HasBoundedDensity.measure_exists_coordinate_slab_Icc_le_const_mul_twoRadius_mul_sum_volume_erase
          D.hasBoundedDensity
          (fun _ => -finiteModelBC1C2OriginL2Radius S)
          (fun _ => finiteModelBC1C2OriginL2Radius S) state r

/--
Real-valued form of the preceding C1/C2/C3 slab estimate.  It is the exact
`O(r)` rate used in the source proof's Lemma 2 `(p,q) = (1,∞)` case.
-/
theorem finiteModelBC1C2_ideal_exists_coordinate_slab_measureReal_le
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (state : Coord → ℝ) {r : ℝ} (hr : 0 ≤ r) :
    (D.idealMeasure {ideal : Coord → ℝ |
        ∃ i, ideal i ∈ Set.Icc (state i - r) (state i + r)}).toReal ≤
      r * finiteModelBC1C2CoordinateSlabRealConstant S := by
  classical
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  have hbound := finiteModelBC1C2_ideal_exists_coordinate_slab_measure_le S state r
  have hrhs_ne_top : D.densityBound *
      (ENNReal.ofReal (2 * r) *
        finiteModelBC1C2CoordinateSlabVolumeCoefficient S) ≠ ⊤ :=
    ENNReal.mul_ne_top D.densityBound_ne_top
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (finiteModelBC1C2CoordinateSlabVolumeCoefficient_ne_top S))
  have hreal := ENNReal.toReal_mono hrhs_ne_top hbound
  rw [ENNReal.toReal_mul, ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (by linarith)] at hreal
  rw [finiteModelBC1C2CoordinateSlabRealConstant]
  calc
    _ ≤ D.densityBound.toReal *
        (2 * r * (finiteModelBC1C2CoordinateSlabVolumeCoefficient S).toReal) := hreal
    _ = r * (2 * D.densityBound.toReal *
        (finiteModelBC1C2CoordinateSlabVolumeCoefficient S).toReal) := by ring

/--
The actual strict slab-bad event in the source's `L1/L∞` Model A argument has
