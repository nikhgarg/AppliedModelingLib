    {r0 : ℝ} (hr0 : 0 < r0)
    (initial : Coord → ℝ) (hinitial : initial ∈ E.solutionSpace) :
    AppliedModelingLib.Optimization.ProjectedStochasticSubgradientMinimizerSetExecution Coord where
  Ω := ℕ → (Component → ℝ) × (Coord → ℝ)
  measurableSpace := inferInstance
  μ := AppliedModelingLib.iidSequenceMeasure D.jointMeasure
  probability := by
    letI : IsProbabilityMeasure D.jointMeasure := D.probability
    exact AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  filtration := AppliedModelingLib.iidSequenceNaturalFiltration
  trajectory := weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial
  meanSubgradient := fun n omega => weightedEuclideanJointSamplePopulationDirection D
    (weightedEuclideanJointSampleOutcomeTrajectory D r0 project initial n omega)
  noise := weightedEuclideanJointSampleOutcomeGradientNoise D r0 project initial
  bias := fun _ _ => 0
  radius := ilvRadius r0
  solutionSpace := E.solutionSpace
  objective := weightedEuclideanJointSamplePopulationCost D
  project := project
  targetSet := weightedEuclideanJointSamplePopulationMinimizerSet D E.solutionSpace
  reference := weightedEuclideanJointSamplePopulationReference S
  reference_mem_targetSet :=
    weightedEuclideanJointSamplePopulationReference_mem_minimizerSet S
  targetSet_subset_solutionSpace := by
    intro target htarget
    exact htarget.1
  targetSet_minimizes := by
    intro target htarget
    exact htarget.2
  minimizer_mem_targetSet := by
    intro target htarget hmin
    exact ⟨htarget, hmin⟩
  project_nonexpansive := S.squaredDistance_nonexpansive
  trajectory_adapted := by
    intro i n
    exact ((measurable_pi_apply i).comp
      (stronglyMeasurable_weightedEuclideanJointSampleOutcomeTrajectory_natural
        D r0 project initial S.project_measurable n).measurable).stronglyMeasurable
  target_objective_gap_adapted := by
    intro target _htarget
    exact stronglyAdapted_weightedEuclideanJointSamplePopulationCost_gap_natural
      S r0 initial target
  target_potential_integrable := by
    intro target htarget n
    exact integrable_weightedEuclideanJointSampleOutcomeTrajectory_target_l2Sq_of_C1C2
      S r0 initial target hinitial htarget.1 n
  target_objective_gap_integrable := by
    intro target htarget n
    exact integrable_weightedEuclideanJointSamplePopulationCost_gap_of_C1C2
      S r0 initial target hinitial htarget.1 n
  target_noise_product_integrable := by
    intro target htarget n i
    exact integrable_weightedEuclideanJointSampleOutcomeTrajectory_target_noise_product_of_C1C2
      S r0 initial target hinitial htarget.1 n i
  noise_coordinate_integrable := by
    intro n i
    exact integrable_weightedEuclideanJointSampleOutcomeGradientNoise_coordinate
      D r0 project initial S.project_measurable n i
  noise_mean_zero := by
    intro n i
    exact weightedEuclideanJointSampleOutcomeGradientNoise_condExp_ae_eq_zero
      D r0 project initial S.project_measurable n i
  noise_energy_integrable := by
    intro n
    exact integrable_weightedEuclideanJointSampleOutcomeGradientNoise_l2Sq
      D r0 project initial S.project_measurable n
  C := Fintype.card Coord
  noiseBound := 4 * Fintype.card Coord
  target_distanceBound := fun _ => finiteModelBC1C2L2Diameter S
  C_nonneg := by positivity
  noiseBound_nonneg := by positivity
  target_distanceBound_nonneg := by
    intro _ _
    exact finiteModelBC1C2L2Diameter_nonneg S
  noise_energy_bound := by
    intro n
    exact weightedEuclideanJointSampleOutcomeGradientNoise_condExp_l2Sq_le_four_card
      D r0 project initial S.project_measurable n
  update := by
    intro n
    filter_upwards [] with omega
    simpa only [add_zero] using
      weightedEuclideanJointSampleOutcomeTrajectory_projected_populationNoise_update
        D r0 project initial n omega
  subgradient := by
    intro n
    exact weightedEuclideanJointSampleOutcomeTrajectory_populationDirection_subgradientOn_ae_of_C1C2
      S r0 initial n
  gradient_bound := by
    intro n
    exact weightedEuclideanJointSampleOutcomeTrajectory_populationDirection_l2_le_card_ae
      D r0 project initial n
  target_distance_bound := by
    intro target htarget n
    filter_upwards [] with omega
    exact finiteModelBC1C2L2Diameter_bound S
      (weightedEuclideanJointSampleOutcomeTrajectory_mem_solutionSpace_of_C1C2
        S r0 initial hinitial n omega) htarget.1
  radius_nonneg := by
    intro n
    exact ilvRadius_nonneg (le_of_lt hr0) (n + 1)
  biasBound := 0
  biasBound_nonneg := le_rfl
  bias_bound := by
    intro n
    rw [AppliedModelingLib.FiniteDimensionalNorms.normL2_zero]
  step_bias_summable := by
    simp [AppliedModelingLib.FiniteDimensionalNorms.normL2_zero]
  radius_sq_summable := ilvRadius_sq_summable r0
  radius_diverges := ilvRadius_sum_tendsto_atTop hr0
  trajectory_mem_solutionSpace := by
    filter_upwards [] with omega
    intro n
    exact weightedEuclideanJointSampleOutcomeTrajectory_mem_solutionSpace_of_C1C2
      S r0 initial hinitial n omega
  compact_solutionSpace := S.compact_solutionSpace
  objective_continuous :=
    (continuous_weightedEuclideanJointSamplePopulationCost_of_C1C2 S).continuousOn

