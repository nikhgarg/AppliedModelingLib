/-- The squared water-filled symmetric perturbation is controlled by its Borel bad envelope. -/
theorem integral_linfL1WaterfillSymmetricPerturbation_l2Sq_le
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (center : Coord → ℝ) {r : ℝ} (hr : 0 < r) :
    (∫ ideal, AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (linfL1RawDirectionSymmetricPerturbation center ideal
        (linfL1WaterfillRawResponse center ideal r) r) ∂D.idealMeasure) ≤
      (4 * Fintype.card Coord) *
        (D.idealMeasure (l1LinfSlabBadEvent center r ∪
          linfL1NearTieBadEvent center r)).toReal := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  let perturbation : (Coord → ℝ) → Coord → ℝ := fun ideal =>
    linfL1RawDirectionSymmetricPerturbation center ideal
      (linfL1WaterfillRawResponse center ideal r) r
  have hmeas : Measurable perturbation := by
    apply measurable_pi_lambda
    intro i
    apply Measurable.sub
    · exact (measurable_pi_apply i).comp
        ((measurable_linfL1RawDirection r).comp
          (measurable_const.prodMk
            ((measurable_linfL1WaterfillRawResponse r).comp
              (measurable_const.prodMk measurable_id))))
    · exact (measurable_pi_apply i).comp
        (measurable_linfL1SymmetricActiveDirection.comp
          (measurable_const.prodMk measurable_id))
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  have hintegrable : Integrable (fun ideal =>
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq (perturbation ideal)) D.idealMeasure := by
    refine Integrable.mono' (integrable_const (4 * (Fintype.card Coord : ℝ)))
      (hl2sq.comp hmeas).aestronglyMeasurable ?_
    filter_upwards [] with ideal
    have hbound := linfL1RawDirectionSymmetricPerturbation_l2Sq_le_four_card
      (center := center) (ideal := ideal)
      (raw := linfL1WaterfillRawResponse center ideal r) hr
      (linfL1WaterfillRawResponse_l1_distance_le center ideal hr.le)
    simpa only [Real.norm_eq_abs, perturbation,
      abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hbound
  simpa [Measure.real, perturbation] using
    AppliedModelingLib.integral_le_measureReal_mul_add_compl_of_le_on_of_le_on_compl
      D.idealMeasure
      ((measurableSet_l1LinfSlabBadEvent center r).union
        (measurableSet_linfL1NearTieBadEvent center r)) hintegrable
      (lowBound := 4 * (Fintype.card Coord : ℝ)) (highBound := 0)
      (fun ideal _ =>
        linfL1RawDirectionSymmetricPerturbation_l2Sq_le_four_card hr
          (linfL1WaterfillRawResponse_l1_distance_le center ideal hr.le))
      (fun ideal hideal => by
        have hgood : LinfL1CorrectedGood center ideal r := by
          by_contra hbad
          exact hideal (linfL1CorrectedBadEvent_subset_slab_union_nearTie
            center r hbad)
        change AppliedModelingLib.FiniteDimensionalNorms.l2Sq
          (linfL1RawDirectionSymmetricPerturbation center ideal
            (linfL1WaterfillRawResponse center ideal r) r) ≤ 0
        rw [linfL1WaterfillRawDirectionSymmetricPerturbation_eq_zero_of_good hr hgood]
        norm_num [AppliedModelingLib.FiniteDimensionalNorms.l2Sq])

