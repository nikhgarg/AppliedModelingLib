/-- The selected Model A exceptional term has summable conditional descent error. -/
theorem weightedEuclideanJointSampleModelAOutcomeSubgradientPerturbation_condExp_descentError_le
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
