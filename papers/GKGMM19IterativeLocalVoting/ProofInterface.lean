/-- C1 compactness makes each selected Model A target potential integrable. -/
theorem integrable_weightedEuclideanJointSampleModelAOutcomeTrajectory_target_l2Sq_of_C1C2
    {Voter Coord Component : Type*} [Fintype Coord] [Fintype Component] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : WeightedEuclideanJointSampleData Coord Component}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D.idealDistribution project)
    (A : WeightedEuclideanJointSampleModelAResponseSource D)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) :
    Integrable (fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (fun i => weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega i -
        target i)) (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) := by
  letI : IsProbabilityMeasure D.jointMeasure := D.probability
  letI : IsProbabilityMeasure (AppliedModelingLib.iidSequenceMeasure D.jointMeasure) :=
    AppliedModelingLib.iidSequenceMeasure_isProbabilityMeasure D.jointMeasure
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  have htrajectory := stronglyMeasurable_weightedEuclideanJointSampleModelAOutcomeTrajectory_natural
    A r0 project initial S.project_measurable n
  have htrajectory_meas : Measurable
      (weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n) :=
    htrajectory.measurable.mono
      ((AppliedModelingLib.iidSequenceNaturalFiltration
        (α := (Component → ℝ) × (Coord → ℝ))).le n) le_rfl
  have hmeas : Measurable (fun omega : ℕ → (Component → ℝ) × (Coord → ℝ) =>
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (fun i => weightedEuclideanJointSampleModelAOutcomeTrajectory A r0 project initial n omega i -
          target i)) := by
    apply hl2sq.comp
    apply measurable_pi_lambda _
    intro i
    exact ((measurable_pi_apply i).comp htrajectory_meas).sub measurable_const
  refine Integrable.mono' (integrable_const (finiteModelBC1C2L2Diameter S ^ 2))
    hmeas.aestronglyMeasurable ?_
  filter_upwards [] with omega
  have hfeasible := weightedEuclideanJointSampleModelAOutcomeTrajectory_mem_solutionSpace_of_C1C2
    S A r0 initial hinitial n omega
  have hdistance := finiteModelBC1C2L2Diameter_bound S hfeasible htarget
  have hsq := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_sq_of_normL2_le
    (finiteModelBC1C2L2Diameter_nonneg S) hdistance
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hsq

