        A r0 project initial n z.1) z.2)
      (Measure.map pair (AppliedModelingLib.iidSequenceMeasure D.jointMeasure)) := by
    let event : Set ((Coord → ℝ) × ((Component → ℝ) × (Coord → ℝ))) :=
