/-
The following execution infrastructure assembles the symmetric finite `(∞,1)`
Model B trace with the reusable projected stochastic-subgradient theorem.
-/

/-- The expected finite-`L∞` objective is adapted along the symmetric Model B trace. -/
theorem stronglyMeasurable_finiteModelBLinfExpectedLinfCost_natural
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial : Coord → ℝ) (hproject : Measurable project) (n : ℕ) :
    StronglyMeasurable[finiteModelBIdealNaturalFiltration (Coord := Coord) n]
      (fun omega => finiteModelBExpectedLinfCost D
        (finiteModelBLinfOutcomeTrajectory D r0 project initial n omega)) := by
  exact (measurable_finiteModelBExpectedLinfCost D).stronglyMeasurable.comp_measurable
    (stronglyMeasurable_finiteModelBLinfOutcomeTrajectory_natural D r0 project
      initial hproject n).measurable

/-- Expected finite-`L∞` objective gaps are adapted to the symmetric iid history. -/
theorem stronglyAdapted_finiteModelBLinfExpectedLinfCost_gap_natural
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (r0 : ℝ) (project : (Coord → ℝ) → Coord → ℝ)
    (initial target : Coord → ℝ) (hproject : Measurable project) :
    StronglyAdapted (finiteModelBIdealNaturalFiltration (Coord := Coord))
      (fun n omega => finiteModelBExpectedLinfCost D
        (finiteModelBLinfOutcomeTrajectory D r0 project initial n omega) -
          finiteModelBExpectedLinfCost D target) := by
  intro n
  exact (stronglyMeasurable_finiteModelBLinfExpectedLinfCost_natural D r0 project
    initial hproject n).sub stronglyMeasurable_const

/-- C1 projection geometry keeps every symmetric finite `(∞,1)` Model B iterate feasible. -/
theorem finiteModelBLinfOutcomeTrajectory_mem_solutionSpace_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (r0 : ℝ) (initial : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) :
    ∀ n omega,
      finiteModelBLinfOutcomeTrajectory D r0 project initial n omega ∈ E.solutionSpace := by
  intro n omega
  induction n with
  | zero => simpa [finiteModelBLinfOutcomeTrajectory] using hinitial
  | succ n ih =>
      rw [finiteModelBLinfOutcomeTrajectory_succ]
      exact (S.geometry.closest_point_projection _).1

/-- C1 compactness makes each squared target potential of the symmetric trace integrable. -/
theorem integrable_finiteModelBLinfOutcomeTrajectory_target_l2Sq_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) :
    Integrable (fun omega => AppliedModelingLib.FiniteDimensionalNorms.l2Sq
      (fun i => finiteModelBLinfOutcomeTrajectory D r0 project initial n omega i - target i))
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have hl2sq : Measurable (AppliedModelingLib.FiniteDimensionalNorms.l2Sq :
      (Coord → ℝ) → ℝ) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    exact (continuous_finset_sum Finset.univ fun i _ =>
      (continuous_apply i).pow 2).measurable
  have htrajectory := stronglyMeasurable_finiteModelBLinfOutcomeTrajectory_natural
    D r0 project initial S.project_measurable n
  have htrajectory_meas : Measurable
      (finiteModelBLinfOutcomeTrajectory D r0 project initial n) :=
    htrajectory.measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl
  have hmeas : Measurable (fun omega : ℕ → Coord → ℝ =>
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
        (fun i => finiteModelBLinfOutcomeTrajectory D r0 project initial n omega i - target i)) := by
    apply hl2sq.comp
    apply measurable_pi_lambda _
    intro i
    exact ((measurable_pi_apply i).comp htrajectory_meas).sub measurable_const
  refine Integrable.mono' (integrable_const (finiteModelBC1C2L2Diameter S ^ 2))
    hmeas.aestronglyMeasurable ?_
  filter_upwards [] with omega
  have hfeasible := finiteModelBLinfOutcomeTrajectory_mem_solutionSpace_of_C1C2
    S r0 initial hinitial n omega
  have hdistance := finiteModelBC1C2L2Diameter_bound S hfeasible htarget
  have hsq := AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_le_sq_of_normL2_le
    (finiteModelBC1C2L2Diameter_nonneg S) hdistance
  simpa only [Real.norm_eq_abs,
    abs_of_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL2Sq_nonneg _)] using hsq

/-- C1/C2 bounds make every symmetric expected finite-`L∞` objective gap integrable. -/
theorem integrable_finiteModelBLinfExpectedLinfCost_gap_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) :
    Integrable (fun omega => finiteModelBExpectedLinfCost D
      (finiteModelBLinfOutcomeTrajectory D r0 project initial n omega) -
        finiteModelBExpectedLinfCost D target)
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have hadapted := stronglyAdapted_finiteModelBLinfExpectedLinfCost_gap_natural
    D r0 project initial target S.project_measurable
  refine Integrable.mono' (integrable_const (finiteModelBC1C2L2Diameter S))
    ((hadapted n).mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n)).aestronglyMeasurable ?_
  filter_upwards [] with omega
  have hfeasible := finiteModelBLinfOutcomeTrajectory_mem_solutionSpace_of_C1C2
    S r0 initial hinitial n omega
  simpa only [Real.norm_eq_abs] using
    finiteModelBExpectedLinfCost_gap_abs_le_l2Diameter_of_C1C2 S hfeasible htarget

/-- Compact C1 geometry and bounded symmetric noise make every target-noise product integrable. -/
theorem integrable_finiteModelBLinfOutcomeTrajectory_target_noise_product_of_C1C2
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (r0 : ℝ) (initial target : Coord → ℝ)
    (hinitial : initial ∈ E.solutionSpace) (htarget : target ∈ E.solutionSpace)
    (n : ℕ) (i : Coord) :
    Integrable (fun omega =>
      (finiteModelBLinfOutcomeTrajectory D r0 project initial n omega i - target i) *
        finiteModelBLinfOutcomeGradientNoise D r0 project initial n omega i)
      (finiteModelBIdealSequenceMeasure D) := by
  letI : IsProbabilityMeasure (finiteModelBIdealSequenceMeasure D) :=
    finiteModelBIdealSequenceMeasure_isProbabilityMeasure D
  have htrajectory := stronglyMeasurable_finiteModelBLinfOutcomeTrajectory_natural
    D r0 project initial S.project_measurable n
  have htrajectory_meas : Measurable
      (finiteModelBLinfOutcomeTrajectory D r0 project initial n) :=
    htrajectory.measurable.mono
      ((finiteModelBIdealNaturalFiltration (Coord := Coord)).le n) le_rfl
  have hstate : Measurable (fun omega : ℕ → Coord → ℝ =>
      finiteModelBLinfOutcomeTrajectory D r0 project initial n omega i - target i) :=
    ((measurable_pi_apply i).comp htrajectory_meas).sub measurable_const
  have hnoise := measurable_finiteModelBLinfOutcomeGradientNoise
    D r0 project initial S.project_measurable n
  have hmeas : Measurable (fun omega : ℕ → Coord → ℝ =>
      (finiteModelBLinfOutcomeTrajectory D r0 project initial n omega i - target i) *
        finiteModelBLinfOutcomeGradientNoise D r0 project initial n omega i) :=
    hstate.mul ((measurable_pi_apply i).comp hnoise)
  refine Integrable.mono' (integrable_const (2 * finiteModelBC1C2L2Diameter S))
    hmeas.aestronglyMeasurable ?_
  filter_upwards [] with omega
  have hnoise_bound := finiteModelBLinfOutcomeGradientNoise_coord_abs_le_two
    D r0 project initial n omega i
  have hfeasible := finiteModelBLinfOutcomeTrajectory_mem_solutionSpace_of_C1C2
    S r0 initial hinitial n omega
  have hdistance := finiteModelBC1C2L2Diameter_bound S hfeasible htarget
  have hcoordinate := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
    (fun j => finiteModelBLinfOutcomeTrajectory D r0 project initial n omega j - target j) i
  have hcoordinate_bound :
      |finiteModelBLinfOutcomeTrajectory D r0 project initial n omega i - target i| ≤
        finiteModelBC1C2L2Diameter S :=
    hcoordinate.trans hdistance
  rw [Real.norm_eq_abs, abs_mul]
  calc
    |finiteModelBLinfOutcomeTrajectory D r0 project initial n omega i - target i| *
        |finiteModelBLinfOutcomeGradientNoise D r0 project initial n omega i| ≤
        finiteModelBC1C2L2Diameter S * 2 :=
      mul_le_mul hcoordinate_bound hnoise_bound (abs_nonneg _)
        (finiteModelBC1C2L2Diameter_nonneg S)
    _ = 2 * finiteModelBC1C2L2Diameter S := by ring

