/--
The sampled-cost refinement of the canonical Model B execution.  Its sample is
the fresh ideal point, its sampled cost is the finite `Lp` distance to that
ideal, and its sampled direction is the displayed normalized Model B
subgradient candidate.
-/
noncomputable def finiteModelBCanonicalSampledMinimizerSetExecution
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (C3 : FiniteCoordinateC3Carrier E)
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E C3.data project)
    {p q r0 : ℝ} (hdual : HolderDualFinite p q) (hr0 : 0 < r0)
    (initial : Coord → ℝ) (hinitial : initial ∈ E.solutionSpace) :
    AppliedModelingLib.Optimization.SampledProjectedStochasticSubgradientMinimizerSetExecution
      Coord where
  toProjectedStochasticSubgradientMinimizerSetExecution :=
    finiteModelBCanonicalMinimizerSetExecution C3 S hdual hr0 initial hinitial
  Sample := Coord → ℝ
  sample := finiteModelBIdealSample
  sampleCost := fun ideal state =>
    AppliedModelingLib.FiniteDimensionalNorms.lp p (fun i => state i - ideal i)
  sampledDirection := fun n omega => lpCostGradientCandidate p
    (fun i => finiteModelBOutcomeTrajectory C3.data p r0 project initial n omega i -
      finiteModelBIdealSample n omega i)
  sampled_direction_subgradient := by
    intro n
    exact finiteModelBOutcomeTrajectory_sampledLpDirection_subgradient_ae
      C3.data hdual.one_lt_left project initial S.project_measurable
        E.solutionSpace n
  sampled_direction_decomposition := by
    intro n
    filter_upwards [] with omega
    funext i
    simp only [finiteModelBCanonicalMinimizerSetExecution,
      finiteModelBOutcomeLpGradientNoise]
    ring

/-- The sampled refinement has exactly the projected Algorithm 1 update. -/
theorem finiteModelBCanonicalSampledMinimizerSetExecution_update
    {Voter Coord : Type*} [Fintype Coord] [Nonempty Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (C3 : FiniteCoordinateC3Carrier E)
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E C3.data project)
    {p q r0 : ℝ} (hdual : HolderDualFinite p q) (hr0 : 0 < r0)
    (initial : Coord → ℝ) (hinitial : initial ∈ E.solutionSpace) (n : ℕ) :
    ∀ᵐ omega ∂finiteModelBIdealSequenceMeasure C3.data,
      finiteModelBOutcomeTrajectory C3.data p r0 project initial (n + 1) omega =
        project (fun i => finiteModelBOutcomeTrajectory C3.data p r0 project initial n omega i -
          ilvRadius r0 (n + 1) * lpCostGradientCandidate p
            (fun j => finiteModelBOutcomeTrajectory C3.data p r0 project initial n omega j -
              finiteModelBIdealSample n omega j) i) := by
  exact AppliedModelingLib.Optimization.SampledProjectedStochasticSubgradientMinimizerSetExecution.update_eq_sampled_direction
    (finiteModelBCanonicalSampledMinimizerSetExecution C3 S hdual hr0 initial hinitial) n

