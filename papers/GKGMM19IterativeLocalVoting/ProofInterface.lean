  sampled_direction_eq : ∀ n,
    ∀ᵐ omega ∂toFiniteCoordinateILVRandomSampledMinimizerSetExecution.μ,
      toFiniteCoordinateILVRandomSampledMinimizerSetExecution.sampledDirection n omega =
        fun i => W.components.sum (fun k =>
          (W.weight
              (toFiniteCoordinateILVRandomSampledMinimizerSetExecution.selectedVoter n omega) k /
            W.weightNorm2
              (toFiniteCoordinateILVRandomSampledMinimizerSetExecution.selectedVoter n omega)) *
            lpCostGradientCandidate 2
              (fun j =>
                toFiniteCoordinateILVRandomSampledMinimizerSetExecution.trajectory n omega j -
                  componentIdeal k
                    (toFiniteCoordinateILVRandomSampledMinimizerSetExecution.selectedVoter n omega) j) i)

/-- The set-valued weighted source data give the displayed Algorithm 1 update. -/
