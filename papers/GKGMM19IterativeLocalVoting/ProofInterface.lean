      fun omega => test (finiteModelBLinfOutcomeTrajectory D r0 project initial n omega)
        (finiteModelBIdealSample n omega) |
        finiteModelBIdealNaturalFiltration (Coord := Coord) n] =ᵐ[
          finiteModelBIdealSequenceMeasure D]
      fun omega => ∫ ideal,
        test (finiteModelBLinfOutcomeTrajectory D r0 project initial n omega) ideal
          ∂D.idealMeasure := by
  have hcond := finiteModelBIdealPastPrefix_condExp_ae_eq_integral D n
    (fun past ideal =>
      test (finiteModelBLinfOutcomePrefixTrajectory D r0 project initial n past) ideal)
    htest
  simpa only [finiteModelBLinfOutcomePrefixTrajectory_pastPrefix_eq] using hcond

/--
The population `Lp` direction at a state is the coordinatewise C3 expectation
of the sampled cost-gradient candidate.
-/
noncomputable def finiteModelBPopulationLpGradient
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) (p : ℝ)
    (state : Coord → ℝ) : Coord → ℝ :=
  fun i => ∫ ideal,
    lpCostGradientCandidate p (fun j => state j - ideal j) i ∂D.idealMeasure

/-- The expected finite-coordinate `Lp` cost under the C3 ideal law. -/
noncomputable def finiteModelBExpectedLpCost
    {Coord : Type*} [Fintype Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) (p : ℝ)
    (state : Coord → ℝ) : ℝ :=
  ∫ ideal, AppliedModelingLib.FiniteDimensionalNorms.lp p
    (fun j => state j - ideal j) ∂D.idealMeasure

/-- The expected finite-coordinate `L∞` cost under the C3 ideal law. -/
noncomputable def finiteModelBExpectedLinfCost
    {Coord : Type*} [Fintype Coord] [Nonempty Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (state : Coord → ℝ) : ℝ :=
  ∫ ideal, AppliedModelingLib.FiniteDimensionalNorms.linf
    (fun j => state j - ideal j) ∂D.idealMeasure

/--
The population direction obtained by integrating the Borel symmetric active
`L∞` sample subgradient coordinatewise.
-/
noncomputable def finiteModelBPopulationLinfGradient
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord)
    (state : Coord → ℝ) : Coord → ℝ :=
  fun i => ∫ ideal, linfL1SymmetricActiveDirection state ideal i ∂D.idealMeasure

/-- The coordinatewise expected symmetric `L∞` direction is Borel measurable in its state. -/
theorem measurable_finiteModelBPopulationLinfGradient
    {Coord : Type*} [Fintype Coord] [Nonempty Coord] [DecidableEq Coord]
    (D : FiniteCoordinateIdealDistributionData Coord) :
    Measurable (finiteModelBPopulationLinfGradient D) := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  apply measurable_pi_lambda
  intro i
  have hcoordinate : StronglyMeasurable (fun z :
      (Coord → ℝ) × (Coord → ℝ) => linfL1SymmetricActiveDirection z.1 z.2 i) :=
    ((measurable_pi_apply i).comp measurable_linfL1SymmetricActiveDirection).stronglyMeasurable
  simpa only [finiteModelBPopulationLinfGradient] using
    hcoordinate.integral_prod_right.measurable

/--
Concrete finite-coordinate reading of source conditions C1 and C2 for a
canonical Model B run.  The original `ILVEnvironment` stores C1/C2 as source
propositions, so this structure records their mathematical content explicitly:
a nonempty closed bounded convex feasible set, a Borel realization of its
Euclidean projection, and C2 support of the ideal-point population in that
set.  It contains no optimization or convergence conclusion.
-/
structure FiniteModelBC1C2Source
    {Voter Coord : Type*} [Fintype Coord]
    (E : ILVEnvironment Voter (Coord → ℝ))
    (D : FiniteCoordinateIdealDistributionData Coord)
    (project : (Coord → ℝ) → Coord → ℝ) : Prop where
  solutionSpace_nonempty : E.solutionSpace.Nonempty
  geometry : AppliedModelingLib.Optimization.EuclideanProjectionSourceGeometry
    Coord E.solutionSpace project
  project_measurable : Measurable project
  /-- C2: each paper-designated ideal is the unique utility maximizer in `X`. -/
  ideal_is_unique_utility_maximizer : HasUniqueIdealSolution E
  ideal_mem_solutionSpace_ae : ∀ᵐ ideal ∂D.idealMeasure, ideal ∈ E.solutionSpace

/--
Transparent C1--C2 source view of `FiniteModelBC1C2Source`.  This is the
paper-facing presentation: it expands the compact-convex geometry, the exact
Euclidean projection property, and the unique feasible utility ideal instead
of asking a reviewer to infer them from structure names.
-/
def finiteModelBC1C2SourceFormula
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) : Prop :=
  E.solutionSpace.Nonempty ∧
    IsClosed E.solutionSpace ∧
      Bornology.IsBounded E.solutionSpace ∧
        Convex ℝ E.solutionSpace ∧
          AppliedModelingLib.Optimization.EuclideanProjectionOnto E.solutionSpace project ∧
            Measurable project ∧
              (∀ voter,
                E.ideal voter ∈ E.solutionSpace ∧
                  (∀ x, x ∈ E.solutionSpace →
                    E.utility voter x ≤ E.utility voter (E.ideal voter)) ∧
                  ∀ x, x ∈ E.solutionSpace →
                    E.utility voter x = E.utility voter (E.ideal voter) →
                      x = E.ideal voter) ∧
                ∀ᵐ ideal ∂D.idealMeasure, ideal ∈ E.solutionSpace

/-- The finite C1--C2 source package entails its expanded source-facing view. -/
theorem FiniteModelBC1C2Source.finiteModelBC1C2SourceFormula
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    finiteModelBC1C2SourceFormula S := by
  exact ⟨S.solutionSpace_nonempty, S.geometry.closed_solutionSpace,
    S.geometry.bounded_solutionSpace, S.geometry.convex_solutionSpace,
    S.geometry.closest_point_projection, S.project_measurable,
    S.ideal_is_unique_utility_maximizer, S.ideal_mem_solutionSpace_ae⟩

/--
The canonical Euclidean projection determined by concrete C1 geometry.  The
closed, bounded, and nonempty hypotheses make the pointwise choice available;
convexity later supplies its continuity and projection estimate.
-/
noncomputable def finiteModelBC1C2CanonicalProjection
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (hclosed : IsClosed E.solutionSpace)
    (hbounded : Bornology.IsBounded E.solutionSpace)
    (hnonempty : E.solutionSpace.Nonempty) :
    (Coord → ℝ) → Coord → ℝ :=
  AppliedModelingLib.Optimization.euclideanProjection E.solutionSpace
    (AppliedModelingLib.FiniteDimensionalNorms.isCompact_of_isClosed_of_bounded hclosed hbounded)
    hnonempty

/-- The canonical C1 projection is a pointwise Euclidean closest-point projection. -/
theorem finiteModelBC1C2CanonicalProjection_onto
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (hclosed : IsClosed E.solutionSpace)
    (hbounded : Bornology.IsBounded E.solutionSpace)
    (hnonempty : E.solutionSpace.Nonempty) :
    AppliedModelingLib.Optimization.EuclideanProjectionOnto E.solutionSpace
      (finiteModelBC1C2CanonicalProjection hclosed hbounded hnonempty) := by
  exact AppliedModelingLib.Optimization.euclideanProjection_onto E.solutionSpace
    (AppliedModelingLib.FiniteDimensionalNorms.isCompact_of_isClosed_of_bounded hclosed hbounded)
    hnonempty

/-- Concrete C1 convexity makes the canonical Euclidean projection Borel measurable. -/
theorem continuous_finiteModelBC1C2CanonicalProjection
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (hclosed : IsClosed E.solutionSpace)
    (hbounded : Bornology.IsBounded E.solutionSpace)
    (hconvex : Convex ℝ E.solutionSpace)
    (hnonempty : E.solutionSpace.Nonempty) :
    Continuous (finiteModelBC1C2CanonicalProjection hclosed hbounded hnonempty) := by
  apply AppliedModelingLib.Optimization.euclideanProjection_continuous hconvex
  exact finiteModelBC1C2CanonicalProjection_onto hclosed hbounded hnonempty

/--
Build the finite C1/C2 package using the canonical projection.  In particular,
applications need not add separate closest-point or measurability certificates
once their C1 geometry is stated concretely.
-/
noncomputable def FiniteModelBC1C2Source.canonical
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    (D : FiniteCoordinateIdealDistributionData Coord)
    (hnonempty : E.solutionSpace.Nonempty)
    (hclosed : IsClosed E.solutionSpace)
    (hbounded : Bornology.IsBounded E.solutionSpace)
    (hconvex : Convex ℝ E.solutionSpace)
    (hunique : HasUniqueIdealSolution E)
    (hideal : ∀ᵐ ideal ∂D.idealMeasure, ideal ∈ E.solutionSpace) :
    FiniteModelBC1C2Source E D
      (finiteModelBC1C2CanonicalProjection hclosed hbounded hnonempty) where
  solutionSpace_nonempty := hnonempty
  geometry := AppliedModelingLib.Optimization.canonicalEuclideanProjectionSourceGeometry
    E.solutionSpace hclosed hbounded hconvex hnonempty
  project_measurable :=
    (continuous_finiteModelBC1C2CanonicalProjection hclosed hbounded hconvex hnonempty).measurable
  ideal_is_unique_utility_maximizer := hunique
  ideal_mem_solutionSpace_ae := hideal

/-- C1 yields the compact feasible-set input for the reusable convergence theorem. -/
theorem FiniteModelBC1C2Source.compact_solutionSpace
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    IsCompact E.solutionSpace :=
  S.geometry.compact_solutionSpace

/-- C1 yields the Euclidean projection estimate used by projected descent. -/
theorem FiniteModelBC1C2Source.squaredDistance_nonexpansive
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    AppliedModelingLib.Optimization.SquaredDistanceNonexpansiveOn E.solutionSpace project :=
  S.geometry.squaredDistance_nonexpansive

/-- A fixed C1 Euclidean bound from the origin, chosen from compactness. -/
noncomputable def finiteModelBC1C2OriginL2Radius
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) : ℝ :=
  Classical.choose (AppliedModelingLib.FiniteDimensionalNorms.exists_l2_bound_on_isCompact
    S.compact_solutionSpace 0)

theorem finiteModelBC1C2OriginL2Radius_nonneg
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    0 ≤ finiteModelBC1C2OriginL2Radius S :=
  (Classical.choose_spec
    (AppliedModelingLib.FiniteDimensionalNorms.exists_l2_bound_on_isCompact
      S.compact_solutionSpace 0)).1

/-- C1 bounds every feasible coordinate inside the chosen symmetric box. -/
theorem finiteModelBC1C2_mem_symmetric_coordinateBox
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    {x : Coord → ℝ} (hx : x ∈ E.solutionSpace) :
    x ∈ Set.Icc (fun _ => -finiteModelBC1C2OriginL2Radius S)
      (fun _ => finiteModelBC1C2OriginL2Radius S) := by
  have hbound := (Classical.choose_spec
    (AppliedModelingLib.FiniteDimensionalNorms.exists_l2_bound_on_isCompact
      S.compact_solutionSpace 0)).2 x hx
  have hcoordinate_bound : ∀ i, |x i| ≤ finiteModelBC1C2OriginL2Radius S := by
    intro i
    have hcoordinate := AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le
      (fun j => x j - 0) i
    simpa only [finiteModelBC1C2OriginL2Radius, sub_zero] using
      hcoordinate.trans hbound
  rw [Set.mem_Icc]
  constructor
  · intro i
    exact (abs_le.mp (hcoordinate_bound i)).1
  · intro i
    exact (abs_le.mp (hcoordinate_bound i)).2

/--
The C1-dependent geometric coefficient in the finite union-of-coordinate-slabs
bound.  It is independent of the current state and the step radius.
-/
noncomputable def finiteModelBC1C2CoordinateSlabVolumeCoefficient
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) : ℝ≥0∞ := by
  classical
  exact ∑ i : Coord, ∏ j ∈ (Finset.univ.erase i), ENNReal.ofReal
    (finiteModelBC1C2OriginL2Radius S - -finiteModelBC1C2OriginL2Radius S)

theorem finiteModelBC1C2CoordinateSlabVolumeCoefficient_ne_top
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    finiteModelBC1C2CoordinateSlabVolumeCoefficient S ≠ ⊤ := by
  classical
  unfold finiteModelBC1C2CoordinateSlabVolumeCoefficient
  apply ENNReal.sum_ne_top.mpr
  intro i _
  apply ENNReal.prod_ne_top
  intro j _
  exact ENNReal.ofReal_ne_top

/--
The C1-dependent geometric coefficient for the corrected `L∞/L1` near-tie
envelope.  It counts the difference and sum slabs for each ordered pair of
distinct coordinates, while retaining the exact ambient-box volume factor.
-/
noncomputable def finiteModelBC1C2LinearTieSlabVolumeCoefficient
    {Voter Coord : Type*} [Fintype Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) : ℝ≥0∞ := by
  exact ∑ i : Coord, ∑ _j ∈ (Finset.univ.erase i),
    ((∏ k ∈ (Finset.univ.erase i), ENNReal.ofReal
      (finiteModelBC1C2OriginL2Radius S - -finiteModelBC1C2OriginL2Radius S)) +
      ∏ k ∈ (Finset.univ.erase i), ENNReal.ofReal
        (finiteModelBC1C2OriginL2Radius S - -finiteModelBC1C2OriginL2Radius S))

theorem finiteModelBC1C2LinearTieSlabVolumeCoefficient_ne_top
    {Voter Coord : Type*} [Fintype Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    finiteModelBC1C2LinearTieSlabVolumeCoefficient S ≠ ⊤ := by
  classical
  unfold finiteModelBC1C2LinearTieSlabVolumeCoefficient
  apply ENNReal.sum_ne_top.mpr
  intro i _
  apply ENNReal.sum_ne_top.mpr
  intro j _
  rw [ENNReal.add_ne_top]
  constructor <;> apply ENNReal.prod_ne_top <;>
    intro k _ <;> exact ENNReal.ofReal_ne_top

/--
C1/C2/C3 bound the closed linear-slab envelope for the corrected `(∞,1)`
near-tie event.  The two slabs for each ordered coordinate pair arise from
the elementary reduction of an absolute-value tie to a difference or sum.
-/
theorem finiteModelBC1C2_linearTieSlabBadRegion_measure_le
    {Voter Coord : Type*} [Fintype Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (state : Coord → ℝ) (r : ℝ) :
    D.idealMeasure (linfL1LinearTieSlabBadRegion
      (fun _ => -finiteModelBC1C2OriginL2Radius S)
      (fun _ => finiteModelBC1C2OriginL2Radius S) state r) ≤
      D.densityBound * (ENNReal.ofReal (2 * r) *
        finiteModelBC1C2LinearTieSlabVolumeCoefficient S) := by
  classical
  let boxLo : Coord → ℝ := fun _ => -finiteModelBC1C2OriginL2Radius S
  let boxHi : Coord → ℝ := fun _ => finiteModelBC1C2OriginL2Radius S
  let width : ℝ≥0∞ := ENNReal.ofReal (2 * r)
  let face : Coord → ℝ≥0∞ := fun i =>
    ∏ k ∈ (Finset.univ.erase i), ENNReal.ofReal (boxHi k - boxLo k)
  let diff : Coord → Coord → Set (Coord → ℝ) := fun i j =>
    {ideal | ideal ∈ Set.Icc boxLo boxHi ∧
      ideal i - ideal j ∈ Set.Icc (state i - state j - r)
        (state i - state j + r)}
  let sum : Coord → Coord → Set (Coord → ℝ) := fun i j =>
    {ideal | ideal ∈ Set.Icc boxLo boxHi ∧
      ideal i + ideal j ∈ Set.Icc (state i + state j - r)
        (state i + state j + r)}
  let pair : Coord → Coord → Set (Coord → ℝ) := fun i j => diff i j ∪ sum i j
  have hpair : ∀ i : Coord, ∀ j ∈ (Finset.univ.erase i),
      D.idealMeasure (pair i j) ≤
        D.densityBound * (width * face i) +
          D.densityBound * (width * face i) := by
    intro i j hj
    have hij : i ≠ j := (Finset.mem_erase.mp hj).1.symm
    have hdiff : D.idealMeasure (diff i j) ≤
        D.densityBound * (width * face i) := by
      simpa [diff, boxLo, boxHi, width, face, sub_eq_add_neg] using
        AppliedModelingLib.Probability.HasBoundedDensity.measure_linear_coordinate_slab_Icc_le_const_mul_twoRadius_mul_volume_erase
          D.hasBoundedDensity i j hij boxLo boxHi (-1 : ℝ)
          (state i - state j) r
    have hsum : D.idealMeasure (sum i j) ≤
        D.densityBound * (width * face i) := by
      simpa [sum, boxLo, boxHi, width, face] using
        AppliedModelingLib.Probability.HasBoundedDensity.measure_linear_coordinate_slab_Icc_le_const_mul_twoRadius_mul_volume_erase
          D.hasBoundedDensity i j hij boxLo boxHi (1 : ℝ)
          (state i + state j) r
    calc
      D.idealMeasure (pair i j) ≤ D.idealMeasure (diff i j) +
          D.idealMeasure (sum i j) := measure_union_le _ _
      _ ≤ D.densityBound * (width * face i) +
          D.densityBound * (width * face i) := add_le_add hdiff hsum
  change D.idealMeasure (linfL1LinearTieSlabBadRegion boxLo boxHi state r) ≤ _
  have hregion : linfL1LinearTieSlabBadRegion boxLo boxHi state r =
      ⋃ i ∈ (Finset.univ : Finset Coord), ⋃ j ∈ (Finset.univ.erase i), pair i j := by
    ext ideal
    simp only [linfL1LinearTieSlabBadRegion, Set.mem_iUnion, Finset.mem_univ,
      Finset.mem_erase, pair, diff, sum, Set.mem_union]
    aesop
  rw [hregion]
  calc
    D.idealMeasure (⋃ i ∈ (Finset.univ : Finset Coord),
        ⋃ j ∈ (Finset.univ.erase i), pair i j) ≤
        ∑ i ∈ (Finset.univ : Finset Coord),
          D.idealMeasure (⋃ j ∈ (Finset.univ.erase i), pair i j) := by
      exact measure_biUnion_finset_le Finset.univ
        (fun i => ⋃ j ∈ (Finset.univ.erase i), pair i j)
    _ ≤ ∑ i ∈ (Finset.univ : Finset Coord),
        ∑ j ∈ (Finset.univ.erase i), D.idealMeasure (pair i j) := by
      apply Finset.sum_le_sum
      intro i _hi
      exact measure_biUnion_finset_le (Finset.univ.erase i) (pair i)
    _ ≤ ∑ i ∈ (Finset.univ : Finset Coord),
        ∑ j ∈ (Finset.univ.erase i),
          (D.densityBound * (width * face i) +
            D.densityBound * (width * face i)) := by
      apply Finset.sum_le_sum
      intro i _hi
      apply Finset.sum_le_sum
      intro j hj
      exact hpair i j hj
    _ = D.densityBound * (width *
        finiteModelBC1C2LinearTieSlabVolumeCoefficient S) := by
      simp_rw [← mul_add]
      unfold finiteModelBC1C2LinearTieSlabVolumeCoefficient
      change (∑ i ∈ (Finset.univ : Finset Coord),
        ∑ _j ∈ (Finset.univ.erase i),
          D.densityBound * (width * (face i + face i))) = _
      symm
      rw [← mul_assoc, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _hi
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _hj
      ring

/-- The finite real C1/C2/C3 rate constant for the corrected near-tie envelope. -/
noncomputable def finiteModelBC1C2LinearTieSlabRealConstant
    {Voter Coord : Type*} [Fintype Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) : ℝ :=
  2 * D.densityBound.toReal *
    (finiteModelBC1C2LinearTieSlabVolumeCoefficient S).toReal

theorem finiteModelBC1C2LinearTieSlabRealConstant_nonneg
    {Voter Coord : Type*} [Fintype Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
    0 ≤ finiteModelBC1C2LinearTieSlabRealConstant S := by
  unfold finiteModelBC1C2LinearTieSlabRealConstant
  positivity

/-- The closed corrected near-tie envelope has probability at most linear in its width. -/
theorem finiteModelBC1C2_linearTieSlabBadRegion_measureReal_le
    {Voter Coord : Type*} [Fintype Coord] [DecidableEq Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project)
    (state : Coord → ℝ) {r : ℝ} (hr : 0 ≤ r) :
    (D.idealMeasure (linfL1LinearTieSlabBadRegion
      (fun _ => -finiteModelBC1C2OriginL2Radius S)
      (fun _ => finiteModelBC1C2OriginL2Radius S) state r)).toReal ≤
      r * finiteModelBC1C2LinearTieSlabRealConstant S := by
  letI : IsProbabilityMeasure D.idealMeasure := D.probability
  have hbound := finiteModelBC1C2_linearTieSlabBadRegion_measure_le S state r
  have hrhs_ne_top : D.densityBound *
      (ENNReal.ofReal (2 * r) *
        finiteModelBC1C2LinearTieSlabVolumeCoefficient S) ≠ ⊤ :=
    ENNReal.mul_ne_top D.densityBound_ne_top
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (finiteModelBC1C2LinearTieSlabVolumeCoefficient_ne_top S))
  have hreal := ENNReal.toReal_mono hrhs_ne_top hbound
  rw [ENNReal.toReal_mul, ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (by linarith)] at hreal
  rw [finiteModelBC1C2LinearTieSlabRealConstant]
  calc
    _ ≤ D.densityBound.toReal *
        (2 * r * (finiteModelBC1C2LinearTieSlabVolumeCoefficient S).toReal) := hreal
    _ = r * (2 * D.densityBound.toReal *
        (finiteModelBC1C2LinearTieSlabVolumeCoefficient S).toReal) := by ring

/-- The finite real constant in the C1/C2/C3 coordinate-slab probability rate. -/
noncomputable def finiteModelBC1C2CoordinateSlabRealConstant
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) : ℝ := by
  classical
  exact 2 * D.densityBound.toReal *
    (finiteModelBC1C2CoordinateSlabVolumeCoefficient S).toReal

/-- The C1/C2/C3 coordinate-slab rate constant is nonnegative. -/
theorem finiteModelBC1C2CoordinateSlabRealConstant_nonneg
    {Voter Coord : Type*} [Fintype Coord]
    {E : ILVEnvironment Voter (Coord → ℝ)}
    {D : FiniteCoordinateIdealDistributionData Coord}
    {project : (Coord → ℝ) → Coord → ℝ}
    (S : FiniteModelBC1C2Source E D project) :
