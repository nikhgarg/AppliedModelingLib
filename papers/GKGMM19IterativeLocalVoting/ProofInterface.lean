/-- The joint population gradient bound holds along the actual canonical trajectory. -/
theorem weightedEuclideanJointSampleOutcomeTrajectory_populationDirection_l2_le_card_ae
    {Coord Component : Type*} [Fintype Coord] [Fintype Component]
    (D : WeightedEuclideanJointSampleData Coord Component)
