        ilvRadius r0 (n + 1) *
          (finiteModelBPopulationLpGradient D 1
            (finiteModelAL1LinfOutcomeTrajectory D r0 project initial n omega) i +
            finiteModelAL1LinfOutcomeLpGradientNoise D r0 project initial n omega i +
            finiteModelAL1LinfOutcomeSubgradientPerturbation D r0 project initial n omega i)) := by
  have hupdate := finiteModelAL1LinfOutcomeTrajectory_projected_clamp_update
    D r0 project initial n omega
