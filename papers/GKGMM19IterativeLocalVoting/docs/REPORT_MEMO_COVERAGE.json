  "items": {
    "defect/GKGMM19-PROPOSITION2-C1-AMBIENT-MEDIAN-01": {
      "disposition": "memo",
      "memo": "docs/PROPOSITION2_C1_CORRECTION.md",
      "memo_sha256": "a55d9b5a8d07bf8fee31a1db8a96962a75026e9c897ff3ad79566cc4fbdf37a2",
      "memo_heading": "C1 corrected target",
      "memo_anchor": "c1-corrected-target",
      "source_reading": "Proposition 2 assumes C1--C3 and concludes convergence to the ambient vector of coordinatewise medians."
    },
    "convention/GKGMM19-RAW-UTILITY-QUERY-DOMAIN-01": {
      "disposition": "not_material",
      "reason": "This is the definition-level convention that makes the pre-projection query total; it leaves every reported theorem endpoint and its mathematical comparison unchanged."
    },
    "convention/GKGMM19-ALGORITHM1-EUCLIDEAN-PROJECTION-WINDOW-01": {
      "disposition": "not_material",
      "reason": "This fixes the ordinary ambient interpretation of unqualified projection and magnitude without changing the separately specified local Lq query, stopping rule, or any reported conclusion."
    },
    "convention/GKGMM19-PROPOSITION2-COORDINATEWISE-MODELB-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "fefb4e82e543716029c5a172f12cf419718c3d84c0201e54e9df986a7939c5fc",
      "memo_heading": "Proposition 2's coordinatewise Model B",
      "memo_anchor": "proposition-2s-coordinatewise-model-b",
      "source_reading": "For Proposition 2 with a Linfinity neighborhood, Model B moves every non-tied decomposition coordinate by the full current radius toward that coordinate of the sampled voter's ideal; tied coordinates do not move. Relative derivative magnitudes do not scale those coordinate steps. The proof's coordinatewise-median target is represented transparently by the feasible minimizers of expected coordinatewise absolute deviation."
    },
    "convention/GKGMM19-THEOREM3-FULL-SPACE-RESTRICTED-SPACE-01": {
      "disposition": "memo",
      "memo": "docs/THEOREM3_CONSTRAINED_SPACE_SOURCE_NOTE.md",
      "memo_sha256": "06089e222bb2a68575d5dc478ccc07f69b525333c94318482520341dbafdcfbf",
      "memo_heading": "The two formal results",
      "memo_anchor": "the-two-formal-results",
      "source_reading": "Theorem 3 is reviewed as an approved two-part clarification and expansion. For an arbitrary standard-Borel population sampled iid from the paper's population measure, the literal full-space Model B trace has zero aggregate directional field at every almost-sure convergent limit. For the separately represented finite-coordinate projected decision space, the proved alternative is that the aggregate directional field is zero or that no aggregate feasible direction exists at that limit."
    },
    "convention/GKGMM19-THEOREM3-IID-TRACE-WELLDEFINEDNESS-01": {
      "disposition": "not_material",
      "reason": "These are typed measurability, adaptation, and integrability conditions needed to state the source's stochastic expressions, not added convergence, equilibrium, or martingale conclusions."
    },
    "convention/GKGMM19-MODELB-ZERO-GRADIENT-STAY-PUT-01": {
      "disposition": "not_material",
      "reason": "The zero-gradient stay-put branch merely totalizes the displayed normalized response at its undefined denominator and leaves every nonzero-gradient formula and reported result endpoint unchanged."
    },
    "convention/GKGMM19-APPENDIX5-ADAPTED-BIAS-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "fefb4e82e543716029c5a172f12cf419718c3d84c0201e54e9df986a7939c5fc",
      "memo_heading": "Appendix Theorem 5: random bias",
      "memo_anchor": "appendix-theorem-5-random-bias",
      "source_reading": "Appendix Theorem 5's bias is a sample-path process: its uniform bound and the weighted summability condition are almost-sure statements, and its update is evaluated on those same paths. The finite-dimensional formalization supplies only the measurability and adaptedness needed to define the printed conditional-noise expressions and partial sums."
    },
    "convention/GKGMM19-NONNEGATIVE-WEIGHT-DOMAINS-01": {
      "disposition": "not_material",
      "reason": "The nonzero vector condition is forced by Definition 2's displayed denominator, while Definition 4's scalar boundary remains defined; this only states each formula's natural domain."
    },
    "source/proposition2_decomposable_linf_medians/corrected_target": {
      "disposition": "memo",
      "memo": "docs/PROPOSITION2_C1_CORRECTION.md",
      "memo_sha256": "a55d9b5a8d07bf8fee31a1db8a96962a75026e9c897ff3ad79566cc4fbdf37a2",
      "memo_heading": "C1 corrected target",
      "memo_anchor": "c1-corrected-target",
      "source_reading": "proposition2_decomposable_linf_medians"
    },
    "report/theorem3-constrained-alternative": {
      "disposition": "memo",
      "memo": "docs/THEOREM3_CONSTRAINED_SPACE_SOURCE_NOTE.md",
      "memo_sha256": "06089e222bb2a68575d5dc478ccc07f69b525333c94318482520341dbafdcfbf",
      "memo_heading": "The two formal results",
      "memo_anchor": "the-two-formal-results",
      "report_home": 9,
      "source_reading": "The combined Theorem 3 endpoint proves the conditional zero-field conclusion and a separate bounded-convex-domain alternative: zero limiting aggregate field or failure of the aggregate tail-feasibility condition. Sections 4 and 9 now report both; this does not establish a full boundary-equilibrium characterization."
    }
  },
