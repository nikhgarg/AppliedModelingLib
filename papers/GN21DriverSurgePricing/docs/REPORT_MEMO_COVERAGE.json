  "all_selected_semantic_review_sha256": "f206da6059b01f2c1016fd588d9b92460db03e3a97baa4d65c201dfe384ffd4a",
  "items": {
    "convention/GN21-FINITE-ENDPOINT-CALCULUS-REGULARITY-01": {
      "disposition": "not_material",
      "reason": "The finite derivative and sign facts are the source variation calculations, not a new economic restriction."
    },
    "convention/GN21-IID-RENEWAL-CYCLE-MODEL-01": {
      "disposition": "not_material",
      "reason": "Independent arrival/mark and switching streams are source primitives; the renewal cycles are derived from them."
    },
    "convention/GN21-L5-AE-NULL-SET-CONVENTION-01": {
      "disposition": "not_material",
      "reason": "Source reward integrals identify policies modulo trip-law null sets and already restrict derivative signs to positive density."
    },
    "convention/GN21-L5-ENDPOINT-COMPACTNESS-CONTINUITY-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "policy-domain-and-endpoint-regularity",
      "memo_heading": "Policy domain and endpoint regularity",
      "memo_sha256": "ffbabba9f92b392f673236dbe7b30127de41499351bd6b4543d9461bd8611306",
      "report_home": 4,
      "source_reading": "For the direct Lemma 5 route only, the source's continuity-in-policy assumption is used along each finite endpoint-coordinate family, including the compactified boundary representatives, so the corresponding finite endpoint reward map is continuous on the shape-specific compact domain. This is the precise source-model premise represented by the visible `hendpoint_continuous` binder; it supplies compact maximizer existence but no optimizer, policy form, dominance inequality, or strictness conclusion."
    },
    "convention/GN21-L5-GLOBAL-POLICY-CONTINUITY-REGULARITY-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "policy-domain-and-endpoint-regularity",
      "memo_heading": "Policy domain and endpoint regularity",
      "memo_sha256": "ffbabba9f92b392f673236dbe7b30127de41499351bd6b4543d9461bd8611306",
      "report_home": 4,
      "source_reading": "Lemma 5 explicitly assumes that Rhat is continuous in its open measurable policy argument. The current Lean interface totalizes Rhat to arbitrary `TripPolicy` values and expresses that continuity as `GN21SymmDiffContinuousAt` at every such value. The resulting global extension is a visible source-model regularity: it supplies only continuity at policy arguments, never a policy form, reward comparison, maximizer, or strictness conclusion."
    },
    "convention/GN21-L5-GLOBAL-POLICY-RESPONSE-SHAPE-REGULARITY-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "policy-domain-and-endpoint-regularity",
      "memo_heading": "Policy domain and endpoint regularity",
      "memo_sha256": "ffbabba9f92b392f673236dbe7b30127de41499351bd6b4543d9461bd8611306",
      "report_home": 4,
      "source_reading": "Lemma 5 states its response-shape property for every policy in the displayed near-optimal reward band after defining the policy domain to be open measurable subsets of positive trip lengths. The current Lean endpoint totalizes policies to arbitrary `TripPolicy` values and asks for the five response shapes at every such reward-admissible value. In the two quasi cases, its core predicates quantify strictly positive trip lengths and the two visible `hzero_*` binders supply the boundary-at-zero comparisons used by the finite endpoint-vector proof. Together these are a visible source-model regularity for the current direct variation engine, not a literal restatement of the printed domain wording."
    },
    "convention/GN21-P31-TRIP-LAW-FINITE-MOMENT-REGULARITY-01": {
      "disposition": "not_material",
      "reason": "The source renewal-reward expression uses finite real mean trip and cycle lengths. For its nonnegative trip lengths, finite mean is precisely the finite-first-moment domain, not an additional restriction on that reading."
    },
    "convention/GN21-T1-PAYOUT-NONNEGATIVITY-01": {
      "disposition": "not_material",
      "reason": "The source payout domain derives the hourly-rate sign inside the theorem interface and changes no source premise or conclusion."
    },
    "convention/GN21-T3-NONNEGATIVE-TARGET-RATE-CONVENTION-01": {
      "disposition": "not_material",
      "reason": "The source target-rate domain derives the sign inside the theorem interface and changes no source premise or conclusion."
    },
    "convention/GN21-T4-CANONICAL-PAIR-COMPACTNESS-CONTINUITY-REGULARITY-01": {
      "disposition": "not_material",
      "reason": "The product endpoint family combines the two source statewise finite families; its continuity/compactness bridge is proof organization for joint attainment and adds no economic condition."
    },
    "convention/GN21-T4-EMPTY-BASELINE-REGULARITY-01": {
      "disposition": "not_material",
      "reason": "The better-than-empty witness selects the nontrivial branch of the source Lemma 5 application; empty and degenerate branches remain available, so no Theorem 4 domain is removed."
    },
    "convention/GN21-T4-ENDPOINT-COMPACTNESS-CONTINUITY-REGULARITY-01": {
      "disposition": "not_material",
      "reason": "The endpoint family is the finite parameterization used by the source variation argument, and continuity on that represented compact family supplies attainment without restricting the paper’s feasible policies."
    },
    "convention/GN21-T4-GLOBAL-POLICY-CONTINUITY-REGULARITY-01": {
      "disposition": "not_material",
      "reason": "Theorem 4 applies the paper’s own continuity assumption on each source-feasible acceptance-set context; totalizing the ambient policy carrier changes no source policy premise or conclusion."
    },
    "convention/GN21-T4-LOCAL-REWARD-BAND-MARGIN-REGULARITY-01": {
      "disposition": "not_material",
      "reason": "The positive margin is a selected witness for the source’s local existential reward band at each nontrivial policy, with no uniform lower bound or extra policy restriction."
    },
    "convention/GN21-T4-UNIFORM-VARIATION-REGULARITY-01": {
      "disposition": "not_material",
      "reason": "The paper’s universal surge and response-shape conditions are reapplied at each source-feasible statewise replacement; exposing those repeated applications adds no theorem premise."
    },
    "report/theorem3-proof-route": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "theorem-3-proof-route",
      "memo_heading": "Theorem 3 proof route",
      "memo_sha256": "ffbabba9f92b392f673236dbe7b30127de41499351bd6b4543d9461bd8611306",
      "report_home": 7,
      "source_reading": "The Lemma 9 quantifier-scope gap and the direct two-case route that preserves Theorem 3."
    }
  },
