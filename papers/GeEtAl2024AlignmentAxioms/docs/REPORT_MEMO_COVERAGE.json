  "all_selected_semantic_review_sha256": "7074bfd950d7aa29b305ce31aaecd3370e7202141808de99080c09633b22653d",
  "items": {
    "convention/GE24-C5-LOCAL-WLOG-SELECTION-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "rule-level-tie-conventions",
      "memo_heading": "Rule-level tie conventions",
      "memo_sha256": "7c39d809159f5fd1a886e84b3f3458dabb8bf8dc27dd320e26eac1c5d08104dd",
      "report_home": 4,
      "source_reading": "For the finite C.5 construction, Lean assumes only the source proof's displayed local choice that the rule outputs v1 on the first profile. On every source-feasible profile it otherwise requires only Pareto-constrained Kemeny minimization; it does not assume a global tie key or a profile-independent tie-selection law."
    },
    "convention/GE24-C6-FIXED-TIE-CONVENTION-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "rule-level-tie-conventions",
      "memo_heading": "Rule-level tie conventions",
      "memo_sha256": "7c39d809159f5fd1a886e84b3f3458dabb8bf8dc27dd320e26eac1c5d08104dd",
      "report_home": 4,
      "source_reading": "Lean makes each sequential Leximax Plurality choice deterministic by using a fixed candidate-index order only when plurality scores tie. A strictly higher plurality score always wins, and the same fixed tie choice applies at every profile and prefix."
    },
    "defect/GE24-APPENDIX-A1-ONE-SIDED-DERIVATIVE-03": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "appendix-a1-one-sided-derivatives",
      "memo_heading": "Appendix A.1: one-sided derivatives",
      "memo_sha256": "7c39d809159f5fd1a886e84b3f3458dabb8bf8dc27dd320e26eac1c5d08104dd",
      "report_home": 7,
      "source_reading": "Appendix A.1 uses point-selection and derivative reasoning to obtain the four finite inequalities needed for Lemma 3.2, but later abbreviates the selected points at a different scale."
    },
    "defect/GE24-LEMMA32-INTERIOR-WEIGHT-05": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "appendix-a1-one-sided-derivatives",
      "memo_heading": "Appendix A.1: one-sided derivatives",
      "memo_sha256": "7c39d809159f5fd1a886e84b3f3458dabb8bf8dc27dd320e26eac1c5d08104dd",
      "report_home": 7,
      "source_reading": "Lemma 3.2 permits a rational weight in (1/2, 1], while its minimizer-existence proof uses two-sided coercivity of the weighted loss."
    },
    "defect/GE24-LEMMA34-WEAK-RELATION-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "lemmas-3435-the-perturbation-seam",
      "memo_heading": "Lemmas 3.4--3.5: the perturbation seam",
      "memo_sha256": "7c39d809159f5fd1a886e84b3f3458dabb8bf8dc27dd320e26eac1c5d08104dd",
      "report_home": 4,
      "source_reading": "The printed Lemma 3.4 uses the weak region R_{c-prime over c} at epsilon zero as the optimizer-containment premise for perturbation stability."
    },
    "defect/GE24-LEMMA35-WEAK-HALFSPACE-02": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "lemmas-3435-the-perturbation-seam",
      "memo_heading": "Lemmas 3.4--3.5: the perturbation seam",
      "memo_sha256": "7c39d809159f5fd1a886e84b3f3458dabb8bf8dc27dd320e26eac1c5d08104dd",
      "report_home": 4,
      "source_reading": "The printed Lemma 3.5 claims that the weak epsilon-zero optimizer containment suffices for a strict positive-epsilon infimum gap and argues through an open-set stability step."
    },
    "defect/GE24-RULE-LEVEL-TIE-CONVENTION-04": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "rule-level-tie-conventions",
      "memo_heading": "Rule-level tie conventions",
      "memo_sha256": "7c39d809159f5fd1a886e84b3f3458dabb8bf8dc27dd320e26eac1c5d08104dd",
      "report_home": 4,
      "source_reading": "The source permits arbitrary or consistent ties while stating winner-monotonicity and separability as properties of aggregation rules."
    },
    "defect/GE24-SIX-CANDIDATE-FORWARD-WITNESS-06": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
