    "convention/HT26-FINITE-ADDITIVE-CHORES-01": {
      "disposition": "not_material",
      "reason": "Finite bundles, additive costs, and removal from the envious own bundle are the source chore model and EFX definition."
    },
    "convention/HT26-POSITIVE-BIVALUED-NORMALIZATION-01": {
      "disposition": "not_material",
      "reason": "Positive scaling preserves EFX. Constant and zero-low-value cases are handled separately, so normalization does not narrow the source bi-valued theorem."
    },
    "convention/HT26-M2-EDGE-REPRESENTATION-01": {
      "disposition": "not_material",
      "reason": "Encoding an M2 chore by the pair of agents for whom it is small is exactly the source multigraph construction, including multiplicities."
    }
  },
