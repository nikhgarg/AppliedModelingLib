    dsimp [ν]
    rw [Measure.map_map measurable_snd hmeas]
    rfl
  have hac1 : Measure.map Prod.fst ν ≪ volume := by
    rw [hmapfst]
    simpa using hscore_ac (0 : Fin 2)
  have hac2 : Measure.map Prod.snd ν ≪ volume := by
    rw [hmapsnd]
    simpa using hscore_ac (1 : Fin 2)
  letI : NoAtoms (Measure.map Prod.fst ν) :=
    ⟨fun x => hac1 (by simpa using (volume_singleton x))⟩
  letI : NoAtoms (Measure.map Prod.snd ν) :=
    ⟨fun x => hac2 (by simpa using (volume_singleton x))⟩
  have hordered : ∀ p ∈ ν.support, ∀ q ∈ ν.support,
