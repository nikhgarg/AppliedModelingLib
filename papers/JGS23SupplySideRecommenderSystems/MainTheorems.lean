/--
Both realized-score projections are injective in the acute below-threshold
regime, with no strict-cone or pointwise FOC premise.  Ordered-support CDF
transport gives equal marginal rewards at every represented value; the closed
user cone and strict coordinatewise induced-cost monotonicity then rule out a
vertical or horizontal support fibre.
-/
theorem canonicalTwoUser_valueSupport_injOn_projections_of_scaledNormRpowCostNash_of_phase_of_cos_pos
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hα : 0 < α) (hβ : 1 ≤ β)
    (hsin : 0 < Real.sin θ) (hcos : 0 < Real.cos θ)
    (hden : 0 < 1 - Real.cos θ)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume) :
    (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.fst ∧
      (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.snd := by
  let μ1 : Measure ℝ :=
