      canonicalTwoUser_valueSupport_ordered_of_scaledNormRpowCostNash_of_phase_of_cos_zero
        hα hβ hsin hcos hβlt hnash hscore_ac
  have hcdf :=
    AppliedModelingLib.Probability.lowerCDFMass_map_fst_eq_map_snd_of_ordered_support
      hordered (z := z) (by simpa only [ν] using hz)
  simpa only [hmapfst, hmapsnd] using hcdf.symm

