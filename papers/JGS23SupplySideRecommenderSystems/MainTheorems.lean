/--
Nash-to-C1 transport for the nonsingular canonical two-user coordinates.

The premise `hpayoff` is the source's exact payoff reparameterization: for
every feasible content action, its uniform-tie payoff equals a value-space
objective.  Under that explicit equality, a symmetric Nash law makes every
point of the *actual realized-value support* a maximizer of that objective on
the canonical nonnegative feasible-value set.  The proof uses both directions
of the canonical support transport, so it does not treat a pushforward support
point as if it came from a support action without invertibility.
-/
theorem canonicalTwoUser_isMaxOn_valueObjective_of_sourceSymmetricMixedNash
    {P : ℕ} [Nonempty (Fin P)] {θ : ℝ} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ] {cost : Content 2 → ℝ}
    {H1 H2 : ℝ → ℝ} {inducedCost : ℝ → ℝ → ℝ}
    (hsin : Real.sin θ ≠ 0)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      cost μ)
    (hpayoff : ∀ (j : Fin P) (p : Content 2), NonnegativeContent p →
      SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed
          (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) j)
        cost p μ =
        H1 (canonicalTwoUserValueMap θ p).1 + H2 (canonicalTwoUserValueMap θ p).2 -
          inducedCost (canonicalTwoUserValueMap θ p).1
            (canonicalTwoUserValueMap θ p).2)
    (z : ℝ × ℝ)
    (hz : z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support) :
    IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - inducedCost w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θ) z := by
  let users : Fin 2 → Content 2 :=
    fun i => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ
  let p : Content 2 := canonicalTwoUserContentOfValues θ z.1 z.2
  have hp_support : p ∈ μ.support := by
    dsimp [p]
    exact canonicalTwoUserContentOfValues_mem_support_of_mem_valueMap_support hsin hz
  have hp_nonnegative : NonnegativeContent p := hnash.2.1 hp_support
  have hp_value : canonicalTwoUserValueMap θ p = z := by
    dsimp [p]
    exact canonicalTwoUserValueMap_contentOfValues hsin
  intro w hw
  let q : Content 2 := canonicalTwoUserContentOfValues θ w.1 w.2
  have hq_nonnegative : NonnegativeContent q := by
    exact hw
  let j : Fin P := Classical.choice inferInstance
  have hmax := hnash.2.2 j p hp_support q hq_nonnegative
  rw [hpayoff j q hq_nonnegative, hpayoff j p hp_nonnegative] at hmax
  have hq_value : canonicalTwoUserValueMap θ q = w := by
    dsimp [q]
    exact canonicalTwoUserValueMap_contentOfValues hsin
  simpa [users, hp_value, hq_value] using hmax

