/--
The source direction condition rules out every feasible pure deviation from
the concrete single-genre ray law.  The proof first normalizes a nonzero
deviation, applies the condition at its norm-to-the-`beta` radial scale, and
then identifies the resulting clipped sum with the actual uniform-tie payoff.
-/
theorem singleGenreContentLaw_sourceMixedPurePayoff_le_zero_of_directionCondition
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre q : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (hcondition :
      SingleGenreDirectionCondition
        {y' : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ ν.norm p = 1) β y'}
        (fun i => (score (users i) genre) ^ β))
    (j : Fin P) (hq : NonnegativeContent q) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β) q
      (singleGenreContentLaw N P β genre) ≤ 0 := by
  by_cases hq_zero : q = 0
  · subst q
    have hP_card : 1 < Fintype.card (Fin P) :=
      Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
    have hP_nat : 1 < P := by simpa using hP_card
    have hP_sub_ne : P - 1 ≠ 0 := Nat.sub_ne_zero_iff_lt.mpr hP_nat
    unfold SourceMixedPurePayoff
    rw [expectedUsersWonAgainstSymmetricMixed_singleGenreContentLaw_eq_cdfSum
      hβ husers zeroContent_nonnegative hscore j]
    simp [singleGenreCdf_zero hβ, hP_sub_ne, normRpowCost_zero ν hβ]
  · have hq_nonzero : NonzeroContent q := by
      by_contra hq_all_zero
      unfold NonzeroContent at hq_all_zero
      simp only [not_exists, not_not] at hq_all_zero
      apply hq_zero
      ext d
      exact hq_all_zero d
    let r : ℝ := ν.norm q
    let d : Content D := SourceNorm.normalizedContent ν q
    have hr_pos : 0 < r := by
      dsimp [r]
      exact ν.pos_of_nonzero hq_nonzero
    have hd_nonnegative : NonnegativeContent d := by
      dsimp [d]
      exact SourceNorm.normalizedContent_nonnegative ν hq
    have hd_unit : ν.norm d = 1 := by
      dsimp [d]
      exact SourceNorm.norm_normalizedContent_eq_one ν hq_nonzero
    let y : Fin N → ℝ := fun i => (score (users i) genre) ^ β
    let y' : Fin N → ℝ := fun i => (score (users i) d) ^ β
    have hy'_mem :
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ ν.norm p = 1) β y' := by
      refine ⟨fun i => score (users i) d, ?_, ?_⟩
      · exact ⟨d, ⟨hd_nonnegative, hd_unit⟩, rfl⟩
      · rfl
    have hradial_pos : 0 < r ^ β := Real.rpow_pos_of_pos hr_pos β
    have hsum_bound :
        (∑ i : Fin N, min 1 (r ^ β * ((y' i / y i) / (N : ℝ)))) ≤ r ^ β :=
      sum_min_one_mul_le_radius_of_singleGenreDirectionCondition
        hcondition hy'_mem hradial_pos
    have hpoint : ∀ i : Fin N,
        (singleGenreCdf N P β
          (score (users i) q / score (users i) genre)) ^ (P - 1) =
          min 1 (r ^ β * ((y' i / y i) / (N : ℝ))) := by
      intro i
      have hscore_q_nonnegative : 0 ≤ score (users i) q :=
        score_nonneg_of_nonnegative (husers i) hq
      rw [singleGenreCdf_natPow_eq_min_one_powerRatio
        (div_nonneg hscore_q_nonnegative (hscore i).le)]
      apply congrArg (min 1)
      have hscore_d_nonnegative : 0 ≤ score (users i) d :=
        score_nonneg_of_nonnegative (husers i) hd_nonnegative
      have hnorm_score :
          score (users i) q = r * score (users i) d := by
        dsimp [r, d]
        exact SourceNorm.score_eq_norm_mul_score_normalizedContent
          ν (users i) hq_nonzero
      rw [hnorm_score, mul_div_assoc,
        Real.mul_rpow hr_pos.le
          (div_nonneg hscore_d_nonnegative (hscore i).le),
        Real.div_rpow hscore_d_nonnegative (hscore i).le β]
      dsimp [y, y']
      ring
    have hsum_eq :
        (∑ i : Fin N,
          (singleGenreCdf N P β
            (score (users i) q / score (users i) genre)) ^ (P - 1)) =
          ∑ i : Fin N, min 1 (r ^ β * ((y' i / y i) / (N : ℝ))) := by
      exact Finset.sum_congr rfl (fun i _ => hpoint i)
    unfold SourceMixedPurePayoff
    rw [expectedUsersWonAgainstSymmetricMixed_singleGenreContentLaw_eq_cdfSum
      hβ husers hq hscore j, hsum_eq]
    change (∑ i : Fin N, min 1 (r ^ β * ((y' i / y i) / (N : ℝ)))) - r ^ β ≤ 0
    exact sub_nonpos.mpr hsum_bound

/--
Concrete direct form of the equilibrium conclusion in Theorem `singlegenre`.
For a nonnegative unit genre with positive user scores, the ray law generated
by Lemma `cdf` is a symmetric mixed Nash equilibrium whenever the source
direction condition holds on nonnegative unit-norm content directions.
-/
theorem singleGenreContentLaw_is_sourceSymmetricMixedNash_of_directionCondition
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (hcondition :
      SingleGenreDirectionCondition
        {y' : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ ν.norm p = 1) β y'}
        (fun i => (score (users i) genre) ^ β)) :
    SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β genre) := by
  refine ⟨singleGenreContentLaw_isProbabilityMeasure N P β genre,
    singleGenreContentLaw_support_subset_nonnegative hgenre_nonnegative, ?_⟩
  intro j p hp q hq
  rw [singleGenreContentLaw_support_action_sourceMixedPurePayoff_eq_zero
    ν hβ hgenre_norm hgenre_nonnegative husers hscore j hp]
  exact singleGenreContentLaw_sourceMixedPurePayoff_le_zero_of_directionCondition
    ν hβ hgenre_nonnegative husers hscore hcondition j hq

/--
The source ratio condition is preserved when a positive-score feasible point
of the nonnegative unit ball is normalized to a unit direction.  Each ratio is
multiplied by `||p||^beta`, which is at most one on that ball.
-/
theorem singleGenreDirectionCondition_normalizedContent_of_ball
    {D N : ℕ} [Nonempty (Fin N)]
    {β : ℝ} {users : Fin N → Content D} {p : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hp_nonnegative : NonnegativeContent p) (hp_norm_le_one : ν.norm p ≤ 1)
    (hscore : ∀ i : Fin N, 0 < score (users i) p)
    (hcondition :
      SingleGenreDirectionCondition
        {y' : Fin N → ℝ |
          InPoweredUnitImage users
            (fun q => NonnegativeContent q ∧ ν.norm q ≤ 1) β y'}
        (fun i => (score (users i) p) ^ β)) :
    SingleGenreDirectionCondition
      {y' : Fin N → ℝ |
        InPoweredUnitImage users
          (fun q => NonnegativeContent q ∧ ν.norm q ≤ 1) β y'}
      (fun i => (score (users i) (SourceNorm.normalizedContent ν p)) ^ β) := by
  have hp_nonzero : NonzeroContent p :=
    nonzeroContent_of_positive_score hscore
  let c : ℝ := ν.norm p
  let d : Content D := SourceNorm.normalizedContent ν p
  have hc_pos : 0 < c := by
    dsimp [c]
    exact ν.pos_of_nonzero hp_nonzero
  have hc_nonnegative : 0 ≤ c := hc_pos.le
  have hc_le_one : c ≤ 1 := by
    dsimp [c]
    exact hp_norm_le_one
  have hc_rpow_pos : 0 < c ^ β := Real.rpow_pos_of_pos hc_pos β
  have hc_rpow_le_one : c ^ β ≤ 1 :=
    Real.rpow_le_one hc_nonnegative hc_le_one hβ.le
  let y : Fin N → ℝ := fun i => (score (users i) p) ^ β
  let yd : Fin N → ℝ := fun i => (score (users i) d) ^ β
  have hscore_d : ∀ i : Fin N, 0 < score (users i) d := by
    intro i
    dsimp [d]
    exact SourceNorm.score_normalizedContent_pos_of_score_pos
      ν (users i) hp_nonzero (hscore i)
  have hyd_pos : ∀ i : Fin N, 0 < yd i := by
    intro i
    dsimp [yd]
    exact Real.rpow_pos_of_pos (hscore_d i) β
  have hy_eq : ∀ i : Fin N, y i = c ^ β * yd i := by
    intro i
    dsimp [y, yd, c, d]
    rw [SourceNorm.score_eq_norm_mul_score_normalizedContent
      ν (users i) hp_nonzero]
    exact Real.mul_rpow (ν.pos_of_nonzero hp_nonzero).le
      (score_nonneg_of_nonnegative (husers i)
        (SourceNorm.normalizedContent_nonnegative ν hp_nonnegative))
  intro y' hy'
  have hbase : ratioObjective y y' ≤ (N : ℝ) := by
    simpa [y] using hcondition y' hy'
  have hratio : ratioObjective yd y' = c ^ β * ratioObjective y y' := by
    unfold ratioObjective
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [hy_eq i]
    field_simp [ne_of_gt hc_rpow_pos, ne_of_gt (hyd_pos i)]
  rw [show (fun i =>
      (score (users i) (SourceNorm.normalizedContent ν p)) ^ β) = yd by
    rfl, hratio]
  have hN_nonnegative : 0 ≤ (N : ℝ) := by positivity
  calc
    c ^ β * ratioObjective y y' ≤ c ^ β * (N : ℝ) :=
      mul_le_mul_of_nonneg_left hbase hc_rpow_pos.le
    _ ≤ (N : ℝ) := by nlinarith

/--
Witness form of the sufficient direction of Lemma `conditiongen`: a
positive-score point in the nonnegative unit ball satisfying the source ratio
condition yields the concrete symmetric mixed-Nash ray law of its normalized
direction.
-/
theorem singleGenreContentLaw_is_sourceSymmetricMixedNash_of_positive_ball_condition
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {p : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hp_nonnegative : NonnegativeContent p) (hp_norm_le_one : ν.norm p ≤ 1)
    (hscore : ∀ i : Fin N, 0 < score (users i) p)
    (hcondition :
      SingleGenreDirectionCondition
        {y' : Fin N → ℝ |
          InPoweredUnitImage users
            (fun q => NonnegativeContent q ∧ ν.norm q ≤ 1) β y'}
        (fun i => (score (users i) p) ^ β)) :
    SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β (SourceNorm.normalizedContent ν p)) := by
  have hp_nonzero : NonzeroContent p :=
    nonzeroContent_of_positive_score hscore
  apply singleGenreContentLaw_is_sourceSymmetricMixedNash_of_directionCondition
    ν hβ
  · exact SourceNorm.norm_normalizedContent_eq_one ν hp_nonzero
  · exact SourceNorm.normalizedContent_nonnegative ν hp_nonnegative
  · exact husers
  · intro i
    exact SourceNorm.score_normalizedContent_pos_of_score_pos
      ν (users i) hp_nonzero (hscore i)
  · intro y' hy'
    apply (singleGenreDirectionCondition_normalizedContent_of_ball
      ν hβ husers hp_nonnegative hp_norm_le_one hscore hcondition) y'
    rcases hy' with ⟨base, ⟨q, hq, hbase⟩, hy'_eq⟩
    exact ⟨base, ⟨q, ⟨hq.1, le_of_eq hq.2⟩, hbase⟩, hy'_eq⟩

/--
Corrected attained-max form of the sufficient direction in Theorem
`singlegenre`.  The source product-sup equality, together with explicit
attainment, a positive source maximizer, and nonnegative hull rows, selects a
positive feasible content vector whose ray law is a symmetric mixed Nash
equilibrium.  This makes the finite max interpretation precise without using
the source's unstated noncompact minimax step.
-/
theorem exists_singleGenreContentLaw_sourceSymmetricMixedNash_of_productSupCondition_of_attained_maximizers_nonnegative
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {x y : Fin N → ℝ}
    (ν : SourceNorm D) (hβ : 0 < β)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hproduct : SingleGenreProductSupCondition
      {z : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z})
    (hmaxS : IsCoordinateProductMaximizer
      {z : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z} x)
    (hmaxHull : IsCoordinateProductMaximizer
      (convexHull ℝ {z : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z}) y)
    (hx_positive : ∀ i, 0 < x i)
    (hnonnegativeHull : ∀ z ∈ convexHull ℝ
      {z : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z},
      ∀ i, 0 ≤ z i) :
    ∃ p : Content D, NonnegativeContent p ∧ ν.norm p ≤ 1 ∧
      (∀ i : Fin N, 0 < score (users i) p) ∧
      SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
        (singleGenreContentLaw N P β (SourceNorm.normalizedContent ν p)) := by
  let S : Set (Fin N → ℝ) := {z : Fin N → ℝ |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z}
  have hproduct' : SingleGenreProductSupCondition S := by
    simpa [S] using hproduct
  have hmaxS' : IsCoordinateProductMaximizer S x := by
    simpa [S] using hmaxS
  have hmaxHull' : IsCoordinateProductMaximizer (convexHull ℝ S) y := by
    simpa [S] using hmaxHull
  have hnonnegativeHull' : ∀ z ∈ convexHull ℝ S, ∀ i, 0 ≤ z i := by
    intro z hz i
    simpa [S] using hnonnegativeHull z (by simpa [S] using hz) i
  have hvalue : coordinateProduct x = coordinateProduct y := by
    calc
      coordinateProduct x = coordinateProductSup S :=
        (coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxS').symm
      _ = coordinateProductSup (convexHull ℝ S) := hproduct'
      _ = coordinateProduct y :=
        coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxHull'
  have hxHull : x ∈ convexHull ℝ S := subset_convexHull ℝ S hmaxS'.1
  have hmaxXHull : IsCoordinateProductMaximizer (convexHull ℝ S) x := by
    refine ⟨hxHull, ?_⟩
    intro z hz
    exact (hmaxHull'.2 z hz).trans_eq hvalue.symm
  have hconditionHull : SingleGenreDirectionCondition (convexHull ℝ S) x :=
    singleGenreDirectionCondition_of_convex_coordinateProductMaximizer_nonnegative
      (convex_convexHull ℝ S) hmaxXHull hx_positive hnonnegativeHull'
  have hconditionS : SingleGenreDirectionCondition S x := by
    intro z hz
    exact hconditionHull z (subset_convexHull ℝ S hz)
  rcases hmaxS'.1 with ⟨base, ⟨p, hp, hbase⟩, hx_eq⟩
  have hscore : ∀ i : Fin N, 0 < score (users i) p := by
    intro i
    have h := hx_positive i
    rw [hx_eq, hbase] at h
    by_contra hnot
    have hscore_nonnegative : 0 ≤ score (users i) p :=
      score_nonneg_of_nonnegative (husers i) hp.1
    have hscore_zero : score (users i) p = 0 :=
      le_antisymm (le_of_not_gt hnot) hscore_nonnegative
    have hzero_lt : (0 : ℝ) < 0 := by
      simpa [hscore_zero, Real.zero_rpow hβ.ne'] using h
    exact (lt_irrefl (0 : ℝ)) hzero_lt
  have hconditionP :
      SingleGenreDirectionCondition
        {z : Fin N → ℝ | InPoweredUnitImage users
          (fun q => NonnegativeContent q ∧ ν.norm q ≤ 1) β z}
        (fun i => (score (users i) p) ^ β) := by
    simpa [S, hx_eq, hbase] using hconditionS
  refine ⟨p, hp.1, hp.2, hscore, ?_⟩
  exact singleGenreContentLaw_is_sourceSymmetricMixedNash_of_positive_ball_condition
    ν hβ husers hp.1 hp.2 hscore hconditionP

/--
The source-form condition over the nonnegative unit ball implies the preceding
unit-direction condition, hence gives the concrete single-genre equilibrium.
-/
theorem singleGenreContentLaw_is_sourceSymmetricMixedNash_of_ball_directionCondition
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (hcondition :
      SingleGenreDirectionCondition
        {y' : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y'}
        (fun i => (score (users i) genre) ^ β)) :
    SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β genre) := by
  apply singleGenreContentLaw_is_sourceSymmetricMixedNash_of_directionCondition
    ν hβ hgenre_norm hgenre_nonnegative husers hscore
  intro y' hy'
  apply hcondition y'
  rcases hy' with ⟨base, ⟨p, hp, hbase⟩, hy'_eq⟩
  exact ⟨base, ⟨p, ⟨hp.1, le_of_eq hp.2⟩, hbase⟩, hy'_eq⟩

/--
Corrected converse for the explicit single-genre ray law.  Nash comparison
with sufficiently small radial deviations from the zero support action makes
the clipped CDF formula linear, and hence recovers the source ratio-direction
condition.  This is a statement about the concrete ray law and the actual
uniform-tie payoff, not the source's undefined generic `Genre` display.
-/
theorem singleGenreDirectionCondition_of_singleGenreContentLaw_sourceSymmetricMixedNash
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β genre)) :
    SingleGenreDirectionCondition
      {y' : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y'}
      (fun i => (score (users i) genre) ^ β) := by
  let y : Fin N → ℝ := fun i => (score (users i) genre) ^ β
  change SingleGenreDirectionCondition
    {y' : Fin N → ℝ | InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y'} y
  intro y' hy'
  rcases hy' with ⟨base, ⟨q, hq, hbase⟩, hy'_eq⟩
  by_cases hq_zero : q = 0
  · subst q
    have hy'_zero : y' = 0 := by
      rw [hy'_eq, hbase]
      ext i
      simp [Real.zero_rpow hβ.ne']
    rw [hy'_zero]
    simp [ratioObjective]
  · have hq_nonzero : NonzeroContent q := by
      by_contra hq_all_zero
      unfold NonzeroContent at hq_all_zero
      simp only [not_exists, not_not] at hq_all_zero
      apply hq_zero
      ext d
      exact hq_all_zero d
    let a : Fin N → ℝ := fun i => (y' i / y i) / (N : ℝ)
    obtain ⟨t, ht_pos, hclip⟩ := exists_positive_unclipped_scale a
    let r : ℝ := t ^ β⁻¹
    have hr_pos : 0 < r := by
      dsimp [r]
      exact Real.rpow_pos_of_pos ht_pos β⁻¹
    have hr_pow : r ^ β = t := by
      dsimp [r]
      rw [← Real.rpow_mul ht_pos.le]
      have hmul : β⁻¹ * β = 1 := by field_simp [ne_of_gt hβ]
      rw [hmul, Real.rpow_one]
    let p : Content D := scaleContent r q
    have hp_nonnegative : NonnegativeContent p := by
      dsimp [p]
      exact scaleContent_nonnegative hr_pos.le hq.1
    rcases (inferInstance : Nonempty (Fin P)) with ⟨j⟩
    have hpayoff :
        SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β) p
          (singleGenreContentLaw N P β genre) ≤ 0 := by
      calc
        SourceMixedPurePayoff
            (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β) p
            (singleGenreContentLaw N P β genre) ≤
          SourceMixedPurePayoff
            (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β)
            (0 : Content D) (singleGenreContentLaw N P β genre) :=
          hnash.2.2 j (0 : Content D)
            (zero_mem_singleGenreContentLaw_support hβ genre) p hp_nonnegative
        _ = 0 := singleGenreContentLaw_zero_sourceMixedPurePayoff_eq_zero
          ν hβ hgenre_norm hgenre_nonnegative husers hscore j
    have hpoint : ∀ i : Fin N,
        (singleGenreCdf N P β
          (score (users i) p / score (users i) genre)) ^ (P - 1) =
          min 1 (t * a i) := by
      intro i
      have hscore_q_nonnegative : 0 ≤ score (users i) q :=
        score_nonneg_of_nonnegative (husers i) hq.1
      have hscore_p_nonnegative : 0 ≤ score (users i) p := by
        dsimp [p]
        rw [score_scaleContent]
        exact mul_nonneg hr_pos.le hscore_q_nonnegative
      rw [singleGenreCdf_natPow_eq_min_one_powerRatio
        (div_nonneg hscore_p_nonnegative (hscore i).le)]
      apply congrArg (min 1)
      dsimp [p]
      rw [score_scaleContent, mul_div_assoc,
        Real.mul_rpow hr_pos.le
          (div_nonneg hscore_q_nonnegative (hscore i).le),
        Real.div_rpow hscore_q_nonnegative (hscore i).le β, hr_pow]
      dsimp [a, y]
      rw [hy'_eq, hbase]
      ring
    have hsum_eq :
        ExpectedUsersWonAgainstSymmetricMixed users j p
            (singleGenreContentLaw N P β genre) =
          ∑ i : Fin N, min 1 (t * a i) := by
      rw [expectedUsersWonAgainstSymmetricMixed_singleGenreContentLaw_eq_cdfSum
        hβ husers hp_nonnegative hscore j]
      exact Finset.sum_congr rfl (fun i _hi => hpoint i)
    have hcost : normRpowCost ν β p = t * (ν.norm q) ^ β := by
      dsimp [p]
      unfold normRpowCost
      rw [ν.scale_nonneg hr_pos.le,
        Real.mul_rpow hr_pos.le (ν.nonneg q), hr_pow]
    have hsum_le_cost :
        (∑ i : Fin N, min 1 (t * a i)) ≤ t * (ν.norm q) ^ β := by
      have h := hpayoff
      unfold SourceMixedPurePayoff at h
      rw [hsum_eq, hcost] at h
      linarith
    have hnorm_rpow_le_one : (ν.norm q) ^ β ≤ 1 :=
      Real.rpow_le_one (ν.nonneg q) hq.2 hβ.le
    have hsum_le_t : (∑ i : Fin N, min 1 (t * a i)) ≤ t := by
      calc
        (∑ i : Fin N, min 1 (t * a i)) ≤ t * (ν.norm q) ^ β := hsum_le_cost
        _ ≤ t * 1 := mul_le_mul_of_nonneg_left hnorm_rpow_le_one ht_pos.le
        _ = t := mul_one t
    have hsum_linear :
        (∑ i : Fin N, min 1 (t * a i)) =
          t * (ratioObjective y y' / (N : ℝ)) := by
      calc
        (∑ i : Fin N, min 1 (t * a i)) = ∑ i : Fin N, t * a i := by
          exact Finset.sum_congr rfl (fun i _hi => min_eq_right (hclip i))
        _ = t * ∑ i : Fin N, a i := by rw [Finset.mul_sum]
        _ = t * (ratioObjective y y' / (N : ℝ)) := by
          simp [a, ratioObjective, Finset.sum_div]
    rw [hsum_linear] at hsum_le_t
    have hratio_div : ratioObjective y y' / (N : ℝ) ≤ 1 := by
      apply le_of_mul_le_mul_left _ ht_pos
      simpa using hsum_le_t
    have hN_card : 0 < Fintype.card (Fin N) :=
      Fintype.card_pos_iff.mpr inferInstance
    have hN_nat : 0 < N := by simpa using hN_card
    have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
    rw [div_le_one hN_pos] at hratio_div
    exact hratio_div

/--
Corrected iff form of Lemma `optsingledirection` for the explicit ray law.
The right side is the source ratio condition over the nonnegative norm ball;
the left side uses the formalized uniform-tie symmetric-Nash semantics.
-/
theorem singleGenreContentLaw_sourceSymmetricMixedNash_iff_ball_directionCondition
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre) :
    SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β genre) ↔
      SingleGenreDirectionCondition
        {y' : Fin N → ℝ | InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y'}
        (fun i => (score (users i) genre) ^ β) := by
  constructor
  · intro hnash
    exact singleGenreDirectionCondition_of_singleGenreContentLaw_sourceSymmetricMixedNash
      ν hβ hgenre_norm hgenre_nonnegative husers hscore hnash
  · intro hcondition
    exact singleGenreContentLaw_is_sourceSymmetricMixedNash_of_ball_directionCondition
      ν hβ hgenre_norm hgenre_nonnegative husers hscore hcondition

/--
An explicit single-genre ray equilibrium has equal source and convex-hull
coordinate-product suprema on its powered score image.
-/
theorem singleGenreContentLaw_productSupCondition_of_sourceSymmetricMixedNash
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β genre)) :
    SingleGenreProductSupCondition
      {y' : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y'} := by
  let S : Set (Fin N → ℝ) := {y' : Fin N → ℝ |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y'}
  let y : Fin N → ℝ := fun i => (score (users i) genre) ^ β
  have hcondition : SingleGenreDirectionCondition S y := by
    simpa [S, y] using
      (singleGenreContentLaw_sourceSymmetricMixedNash_iff_ball_directionCondition
        ν hβ hgenre_norm hgenre_nonnegative husers hscore).mp hnash
  have hyS : y ∈ S := by
    refine ⟨fun i => score (users i) genre,
      ⟨genre, ⟨hgenre_nonnegative, le_of_eq hgenre_norm⟩, rfl⟩, rfl⟩
  have hy : ∀ i, 0 < y i := by
    intro i
    exact Real.rpow_pos_of_pos (hscore i) β
  have hS_nonnegative : ∀ z ∈ S, ∀ i, 0 ≤ z i := by
    intro z hz i
    rcases hz with ⟨base, ⟨p, hp, hbase⟩, hz_eq⟩
    rw [hz_eq, hbase]
    exact Real.rpow_nonneg
      (score_nonneg_of_nonnegative (husers i) hp.1) β
  have hHull_nonnegative : ∀ z ∈ convexHull ℝ S, ∀ i, 0 ≤ z i := by
    have hsubset : convexHull ℝ S ⊆ {z : Fin N → ℝ | NonnegativeContent z} :=
      convexHull_min hS_nonnegative (convex_nonnegativeContentSet (D := N))
    intro z hz i
    exact hsubset hz i
  simpa [S] using
    (singleGenreProductSupCondition_of_directionCondition_nonnegative
      hcondition hyS hy hHull_nonnegative)

/--
A strict convex-hull coordinate-product improvement rules out the concrete
single-genre ray law as a symmetric mixed-Nash equilibrium.  The conclusion
uses the formalized ray law rather than the source's unspecified `Genre`
notation.
-/
theorem not_singleGenreContentLaw_sourceSymmetricMixedNash_of_strict_convexHull_product_gap
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    {w : Fin N → ℝ}
    (hw : w ∈ convexHull ℝ {z : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z})
    (hgap : ∀ z ∈ {z : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z},
      coordinateProduct z < coordinateProduct w) :
    ¬ SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β genre) := by
  intro hnash
  let S : Set (Fin N → ℝ) := {z : Fin N → ℝ |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z}
  let y : Fin N → ℝ := fun i => (score (users i) genre) ^ β
  have hcondition : SingleGenreDirectionCondition S y := by
    simpa [S, y] using
      (singleGenreContentLaw_sourceSymmetricMixedNash_iff_ball_directionCondition
        ν hβ hgenre_norm hgenre_nonnegative husers hscore).mp hnash
  have hyS : y ∈ S := by
    refine ⟨fun i => score (users i) genre,
      ⟨genre, ⟨hgenre_nonnegative, le_of_eq hgenre_norm⟩, rfl⟩, rfl⟩
  have hy : ∀ i, 0 < y i := by
    intro i
    exact Real.rpow_pos_of_pos (hscore i) β
  have hS_nonnegative : ∀ z ∈ S, ∀ i, 0 ≤ z i := by
    intro z hz i
    rcases hz with ⟨base, ⟨p, hp, hbase⟩, hz_eq⟩
    rw [hz_eq, hbase]
    exact Real.rpow_nonneg
      (score_nonneg_of_nonnegative (husers i) hp.1) β
  have hHull_nonnegative : ∀ z ∈ convexHull ℝ S, ∀ i, 0 ≤ z i := by
    have hsubset : convexHull ℝ S ⊆ {z : Fin N → ℝ | NonnegativeContent z} :=
      convexHull_min hS_nonnegative (convex_nonnegativeContentSet (D := N))
    intro z hz i
    exact hsubset hz i
  have hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) y :=
    coordinateProductMaximizer_of_directionCondition_nonnegative
      (singleGenreDirectionCondition_convexHull hcondition)
      (subset_convexHull ℝ S hyS) hy hHull_nonnegative
  have hgap_y : coordinateProduct y < coordinateProduct w := by
    apply hgap y
    simpa [S] using hyS
  have hmax_w : coordinateProduct w ≤ coordinateProduct y := by
    apply hmaxHull.2 w
    simpa [S] using hw
  exact (not_lt_of_ge hmax_w) hgap_y

/--
Corrected finite welfare conclusion for an explicit single-genre ray
equilibrium: its powered score row maximizes coordinate product over the
nonnegative source norm-ball image.  This avoids applying logarithms to the
zero row, while retaining the product form equivalent to Nash welfare on the
strictly positive score domain.
-/
theorem singleGenreContentLaw_coordinateProductMaximizer_of_sourceSymmetricMixedNash
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β genre)) :
    IsCoordinateProductMaximizer
      {y' : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y'}
      (fun i => (score (users i) genre) ^ β) := by
  let R : Set (Fin N → ℝ) := {y' : Fin N → ℝ |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y'}
  have hcondition : SingleGenreDirectionCondition R
      (fun i => (score (users i) genre) ^ β) := by
    simpa [R] using
      (singleGenreDirectionCondition_of_singleGenreContentLaw_sourceSymmetricMixedNash
        ν hβ hgenre_norm hgenre_nonnegative husers hscore hnash)
  have hgenre_mem : (fun i => (score (users i) genre) ^ β) ∈ R := by
    dsimp [R]
    refine ⟨fun i => score (users i) genre,
      ⟨genre, ⟨hgenre_nonnegative, le_of_eq hgenre_norm⟩, rfl⟩, rfl⟩
  have hy_positive : ∀ i, 0 < (score (users i) genre) ^ β := by
    intro i
    exact Real.rpow_pos_of_pos (hscore i) β
  have hR_nonnegative : ∀ z ∈ R, ∀ i, 0 ≤ z i := by
    intro z hz i
    rcases hz with ⟨base, ⟨p, hp, hbase⟩, hz_eq⟩
    rw [hz_eq, hbase]
    exact Real.rpow_nonneg
      (score_nonneg_of_nonnegative (husers i) hp.1) β
  simpa [R] using coordinateProductMaximizer_of_directionCondition_nonnegative
    hcondition hgenre_mem hy_positive hR_nonnegative

/--
For an explicit single-genre ray equilibrium, the selected direction maximizes
log Nash welfare on the positive-score nonnegative unit-sphere image.  The
positive domain is essential: the encompassing norm ball contains its zero
row, where the source log objective is not defined mathematically.
-/
theorem singleGenreContentLaw_nashLogMaximizerOn_unitSphere_of_sourceSymmetricMixedNash
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β genre)) :
    IsMaximizerOn
      (fun z => z ∈ {y' : Fin N → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ ν.norm p = 1) β y'} ∧
        ∀ i, 0 < z i)
      nashLogObjective
      (fun i => (score (users i) genre) ^ β) := by
  let Rball : Set (Fin N → ℝ) := {y' : Fin N → ℝ |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y'}
  let Rsphere : Set (Fin N → ℝ) := {y' : Fin N → ℝ |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p = 1) β y'}
  let y : Fin N → ℝ := fun i => (score (users i) genre) ^ β
  have hball : IsCoordinateProductMaximizer Rball y := by
    simpa [Rball, y] using
      (singleGenreContentLaw_coordinateProductMaximizer_of_sourceSymmetricMixedNash
        ν hβ hgenre_norm hgenre_nonnegative husers hscore hnash)
  have hy_positive : ∀ i, 0 < y i := by
    intro i
    dsimp [y]
    exact Real.rpow_pos_of_pos (hscore i) β
  have hy_sphere : y ∈ Rsphere := by
    dsimp [Rsphere, y]
    refine ⟨fun i => score (users i) genre,
      ⟨genre, ⟨hgenre_nonnegative, hgenre_norm⟩, rfl⟩, rfl⟩
  have hsphere_max : IsCoordinateProductMaximizer Rsphere y := by
    constructor
    · exact hy_sphere
    · intro z hz
      apply hball.2 z
      rcases hz with ⟨base, ⟨p, hp, hbase⟩, hz_eq⟩
      exact ⟨base, ⟨p, ⟨hp.1, le_of_eq hp.2⟩, hbase⟩, hz_eq⟩
  change IsMaximizerOn (fun z => z ∈ Rsphere ∧ ∀ i, 0 < z i)
    nashLogObjective y
  have hsphere_positive_max :
      IsCoordinateProductMaximizer
        {z : Fin N → ℝ | z ∈ Rsphere ∧ ∀ i, 0 < z i} y := by
    refine ⟨⟨hy_sphere, hy_positive⟩, ?_⟩
    intro z hz
    exact hsphere_max.2 z hz.1
  exact nashLogObjective_maximizer_of_coordinateProductMaximizer
    hsphere_positive_max (fun z hz i => hz.2 i)

/--
Corollary `betaone`, direct equilibrium form: an attained positive
coordinate-product maximizer of the convex unit-ball image supplies a
single-genre symmetric mixed-Nash ray law at `beta = 1`.
-/
theorem exists_singleGenreContentLaw_sourceSymmetricMixedNash_betaOne_of_productMaximizer
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {y : Fin N → ℝ}
    (ν : SourceNorm D)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hconv : Convex ℝ
      {p : Content D | NonnegativeContent p ∧ ν.norm p ≤ 1})
    (hmax : IsCoordinateProductMaximizer
      {z : Fin N → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) (1 : ℝ) z} y)
    (hpos :
      ∀ z ∈ {z : Fin N → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) (1 : ℝ) z},
        ∀ i, 0 < z i) :
    ∃ p : Content D, NonnegativeContent p ∧ ν.norm p ≤ 1 ∧
      (∀ i : Fin N, 0 < score (users i) p) ∧
      SourceSymmetricMixedNash (P := P) users (normRpowCost ν 1)
        (singleGenreContentLaw N P 1 (SourceNorm.normalizedContent ν p)) := by
  rcases existsSingleGenreDirectionCondition_poweredUnitImage_one_of_product_maximizer
      (users := users)
      (unitFeasible := fun p => NonnegativeContent p ∧ ν.norm p ≤ 1)
      hconv hmax hpos with ⟨y', hy', hcondition⟩
  rcases hy' with ⟨base, ⟨p, hp, hbase⟩, hy'_eq⟩
  have hy'_score : y' = fun i => score (users i) p := by
    rw [hy'_eq, hbase]
    ext i
    simp
  have hy'_mem : y' ∈ {z : Fin N → ℝ |
      InPoweredUnitImage users
        (fun q => NonnegativeContent q ∧ ν.norm q ≤ 1) (1 : ℝ) z} :=
    ⟨base, ⟨p, hp, hbase⟩, hy'_eq⟩
  have hscore : ∀ i : Fin N, 0 < score (users i) p := by
    intro i
    rw [← congrFun hy'_score i]
    exact hpos y' hy'_mem i
  have hcondition' :
      SingleGenreDirectionCondition
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun q => NonnegativeContent q ∧ ν.norm q ≤ 1) (1 : ℝ) z}
        (fun i => (score (users i) p) ^ (1 : ℝ)) := by
    simpa [hy'_score] using hcondition
  refine ⟨p, hp.1, hp.2, hscore, ?_⟩
  exact singleGenreContentLaw_is_sourceSymmetricMixedNash_of_positive_ball_condition
    ν zero_lt_one husers hp.1 hp.2 hscore hcondition'

/--
Corrected complete Corollary `betaone` route.  Compact and convex nonnegative
unit balls give an attained product maximizer; the intended every-user-nonzero
model condition provides a positive feasible direction, so the maximizer is
positive even though the ball itself contains the zero row.
-/
theorem exists_singleGenreContentLaw_sourceSymmetricMixedNash_betaOne_of_compact_convex_nonzero_users
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} (ν : SourceNorm D)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν)
    (hconvex : SourceNormConvexSublevels ν) :
    ∃ p : Content D, NonnegativeContent p ∧ ν.norm p ≤ 1 ∧
      (∀ i : Fin N, 0 < score (users i) p) ∧
      SourceSymmetricMixedNash (P := P) users (normRpowCost ν 1)
        (singleGenreContentLaw N P 1 (SourceNorm.normalizedContent ν p)) := by
  let S : Set (Fin N → ℝ) := {z : Fin N → ℝ |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) (1 : ℝ) z}
  have hball_compact : IsCompact {p : Content D |
      NonnegativeContent p ∧ ν.norm p ≤ 1} := by
    simpa [sourceTruncatedActionSet] using
      (isCompact_sourceTruncatedActionSet_of_compactSublevels ν 1 hcompact)
  have hball_convex : Convex ℝ {p : Content D |
      NonnegativeContent p ∧ ν.norm p ≤ 1} := by
    simpa [sourceTruncatedActionSet] using
      (convex_sourceTruncatedActionSet_of_convexSublevels ν 1 hconvex)
  have hS_compact : IsCompact S := by
    rw [show S = {z : Fin N → ℝ |
        InUnitImage users (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) z} by
      ext z
      exact inPoweredUnitImage_one_iff]
    exact isCompact_inUnitImage_of_isCompact users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) hball_compact
  obtain ⟨p0, hp0_nonnegative, hp0_norm, hp0_score⟩ :=
    SourceNorm.exists_nonnegative_unit_direction_positive_score_of_nonnegative_nonzero_users
      ν husers husers_nonzero
  let y0 : Fin N → ℝ := fun i => score (users i) p0
  have hy0 : y0 ∈ S := by
    dsimp [S]
    refine ⟨fun i => score (users i) p0,
      ⟨p0, ⟨hp0_nonnegative, hp0_norm.le⟩, rfl⟩, ?_⟩
    ext i
    simp [y0]
  obtain ⟨y, hy, hmax⟩ := hS_compact.exists_isMaxOn
    ⟨y0, hy0⟩
      (continuous_finset_prod Finset.univ fun i _ => continuous_apply i).continuousOn
  have hproduct_y0_pos : 0 < coordinateProduct y0 := by
    unfold coordinateProduct y0
    exact Finset.prod_pos fun i _hi => hp0_score i
  have hproduct_y_pos : 0 < coordinateProduct y :=
    lt_of_lt_of_le hproduct_y0_pos (hmax hy0)
  have hS_nonnegative : ∀ z ∈ S, ∀ i, 0 ≤ z i := by
    intro z hz i
    rcases hz with ⟨base, ⟨p, hp, hbase⟩, hz_eq⟩
    rw [hz_eq, hbase]
    simpa using score_nonneg_of_nonnegative (husers i) hp.1
  have hy_pos : ∀ i, 0 < y i := by
    intro i
    have hy_nonnegative : 0 ≤ y i := hS_nonnegative y hy i
    have hy_ne : y i ≠ 0 := by
      intro hy_zero
      have hproduct_zero : coordinateProduct y = 0 := by
        unfold coordinateProduct
        exact Finset.prod_eq_zero (Finset.mem_univ i) hy_zero
      rw [hproduct_zero] at hproduct_y_pos
      exact (lt_irrefl (0 : ℝ)) hproduct_y_pos
    exact lt_of_le_of_ne hy_nonnegative (Ne.symm hy_ne)
  have hcondition : SingleGenreDirectionCondition S y :=
    singleGenreDirectionCondition_of_convex_coordinateProductMaximizer_nonnegative
      (by
        dsimp [S]
        exact convex_inPoweredUnitImage_one_of_convex_unitFeasible hball_convex)
      ⟨hy, hmax⟩ hy_pos hS_nonnegative
  rcases hy with ⟨base, ⟨p, hp, hbase⟩, hy_eq⟩
  have hscore : ∀ i : Fin N, 0 < score (users i) p := by
    intro i
    have h := hy_pos i
    rw [hy_eq, hbase] at h
    simpa using h
  have hcondition_row :
      SingleGenreDirectionCondition
        {z : Fin N → ℝ | InPoweredUnitImage users
          (fun q => NonnegativeContent q ∧ ν.norm q ≤ 1) (1 : ℝ) z}
        (fun i => (score (users i) p) ^ (1 : ℝ)) := by
    simpa [S, hy_eq, hbase] using hcondition
  refine ⟨p, hp.1, hp.2, hscore, ?_⟩
  exact singleGenreContentLaw_is_sourceSymmetricMixedNash_of_positive_ball_condition
    ν zero_lt_one husers hp.1 hp.2 hscore hcondition_row

/--
Corollary `onepopulation`, direct equilibrium form: when every user has the
same nonnegative embedding, any positive-score maximizing unit direction
generates the concrete single-genre symmetric mixed-Nash ray law.
-/
theorem onePopulationSingleGenreContentLaw_is_sourceSymmetricMixedNash
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {u genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hu_nonnegative : NonnegativeContent u)
    (hgenre_nonnegative : NonnegativeContent genre)
    (hgenre_norm : ν.norm genre = 1)
    (hscore_pos : 0 < score u genre)
    (hunit_max : ∀ d : Content D, NonnegativeContent d → ν.norm d = 1 →
      score u d ≤ score u genre) :
    SourceSymmetricMixedNash (P := P) (fun _ : Fin N => u) (normRpowCost ν β)
      (singleGenreContentLaw N P β genre) := by
  apply singleGenreContentLaw_is_sourceSymmetricMixedNash_of_ball_directionCondition
    ν hβ hgenre_norm hgenre_nonnegative
    (fun _ => hu_nonnegative) (fun _ => hscore_pos)
  intro y' hy'
  rcases hy' with ⟨base, ⟨q, hq, hbase⟩, hy'_eq⟩
  have hq_score_nonnegative : 0 ≤ score u q :=
    score_nonneg_of_nonnegative hu_nonnegative hq.1
  have hq_score_le : score u q ≤ score u genre :=
    SourceNorm.score_le_of_nonnegative_unit_direction_maximizer
      ν hu_nonnegative hscore_pos hunit_max hq.1 hq.2
  have hpow_le : (score u q) ^ β ≤ (score u genre) ^ β :=
    Real.rpow_le_rpow hq_score_nonnegative hq_score_le (le_of_lt hβ)
  have hpow_pos : 0 < (score u genre) ^ β :=
    Real.rpow_pos_of_pos hscore_pos β
  have hratio_le_one : (score u q) ^ β / (score u genre) ^ β ≤ 1 :=
    (div_le_one hpow_pos).mpr hpow_le
  have hy'_point : ∀ i : Fin N, y' i = (score u q) ^ β := by
    intro i
    rw [hy'_eq, hbase]
  unfold ratioObjective
  simp_rw [hy'_point]
  change (∑ _i : Fin N, (score u q) ^ β / (score u genre) ^ β) ≤ (N : ℝ)
  rw [show (∑ _i : Fin N, (score u q) ^ β / (score u genre) ^ β) =
      (N : ℝ) * ((score u q) ^ β / (score u genre) ^ β) by
    simp [Finset.sum_const, nsmul_eq_mul]]
  have hN_nonnegative : 0 ≤ (N : ℝ) := by positivity
  calc
    (N : ℝ) * ((score u q) ^ β / (score u genre) ^ β) ≤ (N : ℝ) * 1 :=
      mul_le_mul_of_nonneg_left hratio_le_one hN_nonnegative
    _ = (N : ℝ) := mul_one _

/--
Concrete, fully assembled corrected form of Corollary `onepopulation`: the
ray law is an equilibrium, its support lies on the stated bounded genre
segment, and the measurable source norm has the scalar CDF from Lemma `cdf`.
The maximizer and positive-score hypotheses are explicit because the source's phrase
`p* ∈ argmax` does not itself supply them in degenerate cases.
-/
theorem onePopulationSingleGenreContentLaw_sourceNash_support_and_normCdf
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {u genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hu_nonnegative : NonnegativeContent u)
    (hgenre_nonnegative : NonnegativeContent genre)
    (hgenre_norm : ν.norm genre = 1)
    (hscore_pos : 0 < score u genre)
    (hunit_max : ∀ d : Content D, NonnegativeContent d → ν.norm d = 1 →
      score u d ≤ score u genre)
    (hnorm_meas : Measurable ν.norm) :
    SourceSymmetricMixedNash (P := P) (fun _ : Fin N => u) (normRpowCost ν β)
        (singleGenreContentLaw N P β genre) ∧
      (singleGenreContentLaw N P β genre).support ⊆
        {p : Content D | ∃ q : ℝ, q ∈ Set.Icc (0 : ℝ) ((N : ℝ) ^ β⁻¹) ∧
          p = scaleContent q genre} ∧
      ∀ z : ℝ, 0 ≤ z →
        Measure.map ν.norm (singleGenreContentLaw N P β genre) (Set.Iic z) =
          ENNReal.ofReal (singleGenreCdf N P β z) := by
  refine ⟨onePopulationSingleGenreContentLaw_is_sourceSymmetricMixedNash
    ν hβ hu_nonnegative hgenre_nonnegative hgenre_norm hscore_pos hunit_max,
    singleGenreContentLaw_support_subset_scaledGenre_segment genre hβ, ?_⟩
  intro z hz
  exact singleGenreContentLaw_sourceNorm_map_cdf_eq_singleGenreCdf_of_nonneg
    ν hnorm_meas hgenre_norm hβ hz

/--
Coordinatewise weighted `Lq` barycenter used in the first half of Corollary
`betap`: it converts a finite convex combination of powered user-value rows
back to a feasible nonnegative content direction.
-/
noncomputable def lpPowerBarycenter {D : ℕ} {K : Type*} [Fintype K]
    (q : ℝ) (w : K → ℝ) (contents : K → Content D) : Content D :=
  fun d => AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean q w
    (fun k => contents k d)

theorem lpPowerBarycenter_nonnegative {D : ℕ} {K : Type*} [Fintype K]
    {q : ℝ} {w : K → ℝ} {contents : K → Content D}
    (hw : ∀ k, 0 ≤ w k) (hcontents : ∀ k, NonnegativeContent (contents k)) :
    NonnegativeContent (lpPowerBarycenter q w contents) := by
  intro d
  exact AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean_nonneg hw
    (fun k => hcontents k d)

theorem lpPowerBarycenter_coordinate_rpow {D : ℕ} {K : Type*} [Fintype K]
    {q : ℝ} {w : K → ℝ} {contents : K → Content D}
    (hq : q ≠ 0) (hw : ∀ k, 0 ≤ w k)
    (hcontents : ∀ k, NonnegativeContent (contents k)) (d : Fin D) :
    (lpPowerBarycenter q w contents d) ^ q =
      ∑ k, w k * (contents k d) ^ q := by
  exact AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean_rpow hq hw
    (fun k => hcontents k d)

/-- The `q`-power sum of the barycenter is the weighted sum of the original
coordinate power sums. -/
theorem lpPowerBarycenter_powerSum_eq {D : ℕ} {K : Type*} [Fintype K]
    {q : ℝ} {w : K → ℝ} {contents : K → Content D}
    (hq : q ≠ 0) (hw : ∀ k, 0 ≤ w k)
    (hcontents : ∀ k, NonnegativeContent (contents k)) :
    ∑ d : Fin D, (lpPowerBarycenter q w contents d) ^ q =
      ∑ k, w k * ∑ d : Fin D, (contents k d) ^ q := by
  calc
    ∑ d : Fin D, (lpPowerBarycenter q w contents d) ^ q =
        ∑ d : Fin D, ∑ k, w k * (contents k d) ^ q := by
          refine Finset.sum_congr rfl ?_
          intro d _hd
          exact lpPowerBarycenter_coordinate_rpow hq hw hcontents d
    _ = ∑ k, w k * ∑ d : Fin D, (contents k d) ^ q := by
      rw [Finset.sum_comm]
      simp_rw [Finset.mul_sum]

/--
The coordinatewise weighted `Lq` barycenter remains in the `Lq` unit ball
when each original content vector is in that ball and the weights are a
probability vector.
-/
theorem lpPowerBarycenter_lp_le_one {D : ℕ} {K : Type*} [Fintype K]
    {q : ℝ} {w : K → ℝ} {contents : K → Content D}
    (hq : 1 ≤ q) (hw : ∀ k, 0 ≤ w k) (hweights : ∑ k, w k = 1)
    (hcontents : ∀ k, NonnegativeContent (contents k))
    (hcontents_ball : ∀ k,
      AppliedModelingLib.FiniteDimensionalNorms.lp q (contents k) ≤ 1) :
    AppliedModelingLib.FiniteDimensionalNorms.lp q
      (lpPowerBarycenter q w contents) ≤ 1 := by
  have hq_pos : 0 < q := lt_of_lt_of_le zero_lt_one hq
  have hq_ne : q ≠ 0 := ne_of_gt hq_pos
  have hcontents_power : ∀ k : K, ∑ d : Fin D, (contents k d) ^ q ≤ 1 := by
    intro k
    have hsum_nonnegative : 0 ≤ ∑ d : Fin D, (contents k d) ^ q :=
      Finset.sum_nonneg fun d _ => Real.rpow_nonneg (hcontents k d) q
    have habs_sum :
        (∑ d : Fin D, |contents k d| ^ q) =
          ∑ d : Fin D, (contents k d) ^ q := by
      refine Finset.sum_congr rfl ?_
      intro d _hd
      rw [abs_of_nonneg (hcontents k d)]
    have hball : (∑ d : Fin D, (contents k d) ^ q) ^ q⁻¹ ≤ 1 := by
      rw [← habs_sum]
      simpa [AppliedModelingLib.FiniteDimensionalNorms.lp,
        AppliedModelingLib.FiniteDimensionalNorms.lpPower, one_div] using hcontents_ball k
    have h := (Real.rpow_inv_le_iff_of_pos hsum_nonnegative zero_le_one hq_pos).mp hball
    simpa using h
  have hbary_nonnegative : NonnegativeContent (lpPowerBarycenter q w contents) :=
    lpPowerBarycenter_nonnegative hw hcontents
  have hpower_nonnegative :
      0 ≤ ∑ d : Fin D, (lpPowerBarycenter q w contents d) ^ q :=
    Finset.sum_nonneg fun d _ =>
      Real.rpow_nonneg (hbary_nonnegative d) q
  have hpower_le_one :
      ∑ d : Fin D, (lpPowerBarycenter q w contents d) ^ q ≤ 1 := by
    rw [lpPowerBarycenter_powerSum_eq hq_ne hw hcontents]
    calc
      (∑ k, w k * ∑ d : Fin D, (contents k d) ^ q) ≤ ∑ k, w k * 1 := by
        exact Finset.sum_le_sum fun k _ =>
          mul_le_mul_of_nonneg_left (hcontents_power k) (hw k)
      _ = 1 := by
        rw [← Finset.sum_mul]
        simpa using hweights
  have hball :
      (∑ d : Fin D, (lpPowerBarycenter q w contents d) ^ q) ^ q⁻¹ ≤ 1 :=
    (Real.rpow_inv_le_iff_of_pos hpower_nonnegative zero_le_one hq_pos).mpr
      (by simpa using hpower_le_one)
  have habs_sum :
      (∑ d : Fin D, |lpPowerBarycenter q w contents d| ^ q) =
        ∑ d : Fin D, (lpPowerBarycenter q w contents d) ^ q := by
    refine Finset.sum_congr rfl ?_
    intro d _hd
    rw [abs_of_nonneg (hbary_nonnegative d)]
  rw [AppliedModelingLib.FiniteDimensionalNorms.lp,
    AppliedModelingLib.FiniteDimensionalNorms.lpPower, one_div, habs_sum]
  exact hball

/--
Weighted Minkowski domination used in Corollary `betap`: for every
nonnegative user vector, the `q`th power of its value at the `Lq` barycenter
dominates the corresponding weighted average of `q`th powered values.
-/
theorem score_lpPowerBarycenter_rpow_ge_weighted {D : ℕ} {K : Type*} [Fintype K]
    {q : ℝ} {w : K → ℝ} {contents : K → Content D} {u : Content D}
    (hq : 1 ≤ q) (hw : ∀ k, 0 ≤ w k)
    (hu : NonnegativeContent u)
    (hcontents : ∀ k, NonnegativeContent (contents k)) :
    (score u (lpPowerBarycenter q w contents)) ^ q ≥
      ∑ k, w k * (score u (contents k)) ^ q := by
  let f : Fin D → K → ℝ := fun d k =>
    u d * ((w k) ^ q⁻¹ * contents k d)
  have hq_pos : 0 < q := lt_of_lt_of_le zero_lt_one hq
  have hq_ne : q ≠ 0 := ne_of_gt hq_pos
  have hscore_nonnegative : ∀ k, 0 ≤ score u (contents k) :=
    fun k => score_nonneg_of_nonnegative hu (hcontents k)
  have hbary_nonnegative : NonnegativeContent (lpPowerBarycenter q w contents) :=
    lpPowerBarycenter_nonnegative hw hcontents
  have hvalue_nonnegative : 0 ≤ score u (lpPowerBarycenter q w contents) :=
    score_nonneg_of_nonnegative hu hbary_nonnegative
  have hvector_eq :
      (fun k => ∑ d : Fin D, f d k) =
        fun k => (w k) ^ q⁻¹ * score u (contents k) := by
    ext k
    dsimp [f, score]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl ?_
    intro d _hd
    ring
  have hleft :
      AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean q w
          (fun k => score u (contents k)) =
        AppliedModelingLib.FiniteDimensionalNorms.lp q
          (fun k => ∑ d : Fin D, f d k) := by
    rw [hvector_eq]
    exact AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean_eq_lp_weighted
      hq_pos hw hscore_nonnegative
  have hterm : ∀ d : Fin D,
      AppliedModelingLib.FiniteDimensionalNorms.lp q (f d) =
        u d * lpPowerBarycenter q w contents d := by
    intro d
    calc
      AppliedModelingLib.FiniteDimensionalNorms.lp q (f d) = |u d| *
          AppliedModelingLib.FiniteDimensionalNorms.lp q
            (fun k => (w k) ^ q⁻¹ * contents k d) := by
        dsimp [f]
        exact AppliedModelingLib.FiniteDimensionalNorms.lp_smul_of_pos hq_pos _ _
      _ = u d * AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean q w
          (fun k => contents k d) := by
        rw [abs_of_nonneg (hu d)]
        congr 1
        exact (AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean_eq_lp_weighted
          hq_pos hw (fun k => hcontents k d)).symm
      _ = u d * lpPowerBarycenter q w contents d := rfl
  have hright : (∑ d : Fin D, AppliedModelingLib.FiniteDimensionalNorms.lp q (f d)) =
      score u (lpPowerBarycenter q w contents) := by
    unfold score
    exact Finset.sum_congr rfl fun d _hd => hterm d
  have hroot : AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean q w
      (fun k => score u (contents k)) ≤
      score u (lpPowerBarycenter q w contents) := by
    calc
      AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean q w
          (fun k => score u (contents k)) =
          AppliedModelingLib.FiniteDimensionalNorms.lp q
            (fun k => ∑ d : Fin D, f d k) := hleft
      _ ≤ ∑ d : Fin D, AppliedModelingLib.FiniteDimensionalNorms.lp q (f d) := by
        simpa using (AppliedModelingLib.FiniteDimensionalNorms.lp_finset_sum_le
          hq (Finset.univ : Finset (Fin D)) f)
      _ = score u (lpPowerBarycenter q w contents) := hright
  have hmean_nonnegative :
      0 ≤ AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean q w
        (fun k => score u (contents k)) :=
    AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean_nonneg hw hscore_nonnegative
  have hpow := Real.rpow_le_rpow hmean_nonnegative hroot (le_trans zero_le_one hq)
  rw [AppliedModelingLib.FiniteDimensionalNorms.weightedPowerMean_rpow
    hq_ne hw hscore_nonnegative] at hpow
  exact hpow

/--
Finite-mixture form of the first half of Corollary `betap`.  A convex
combination of `q`-powered user-value rows from nonnegative `Lq`-unit content
is coordinatewise dominated by the powered row of its `Lq` barycenter.
-/
theorem lpPowerBarycenter_dominates_weighted_powered_scores
    {D N : ℕ} {K : Type*} [Fintype K]
    {q : ℝ} {w : K → ℝ} {contents : K → Content D}
    {users : Fin N → Content D}
    (hq : 1 ≤ q) (hw : ∀ k, 0 ≤ w k) (hweights : ∑ k, w k = 1)
    (hcontents : ∀ k, NonnegativeContent (contents k))
    (hcontents_ball : ∀ k,
      AppliedModelingLib.FiniteDimensionalNorms.lp q (contents k) ≤ 1)
    (husers : ∀ i, NonnegativeContent (users i)) :
    NonnegativeContent (lpPowerBarycenter q w contents) ∧
      AppliedModelingLib.FiniteDimensionalNorms.lp q
        (lpPowerBarycenter q w contents) ≤ 1 ∧
      ∀ i : Fin N, ∑ k, w k * (score (users i) (contents k)) ^ q ≤
        (score (users i) (lpPowerBarycenter q w contents)) ^ q := by
  refine ⟨lpPowerBarycenter_nonnegative hw hcontents,
    lpPowerBarycenter_lp_le_one hq hw hweights hcontents hcontents_ball, ?_⟩
  intro i
  exact score_lpPowerBarycenter_rpow_ge_weighted hq hw (husers i) hcontents

/--
Convex-hull form of the `betap` barycenter argument.  Every point in the
convex hull of the `q`-powered nonnegative `Lq`-unit image is coordinatewise
dominated by a point already in that image.  This is the source proof's
finite-mixture construction, expressed using mathlib's convex-hull witness.
-/
theorem exists_poweredUnitImage_dominating_convexHull_lp
    {D N : ℕ} {q : ℝ} {users : Fin N → Content D}
    (hq : 1 ≤ q) (husers : ∀ i, NonnegativeContent (users i))
    {y : Fin N → ℝ}
    (hy : y ∈ convexHull ℝ
      {z : Fin N → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧
            AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z}) :
    ∃ z ∈ {z : Fin N → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧
            AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z},
      ∀ i, 0 ≤ y i ∧ y i ≤ z i := by
  obtain ⟨K, instK, w, rows, hw, hweights, hrows, hmix⟩ :=
    (mem_convexHull_iff_exists_fintype.mp hy)
  letI : Fintype K := instK
  choose base hbase hz_eq using hrows
  choose contents hcontents hbase_eq using hbase
  have hcontents_nonnegative : ∀ k, NonnegativeContent (contents k) :=
    fun k => (hcontents k).1
  have hcontents_ball : ∀ k,
      AppliedModelingLib.FiniteDimensionalNorms.lp q (contents k) ≤ 1 :=
    fun k => (hcontents k).2
  have hrows_nonnegative : ∀ k i, 0 ≤ rows k i := by
    intro k i
    rw [hz_eq k, hbase_eq k]
    exact Real.rpow_nonneg
      (score_nonneg_of_nonnegative (husers i) (hcontents_nonnegative k)) q
  obtain ⟨hbary_nonnegative, hbary_ball, hbary_scores⟩ :=
    lpPowerBarycenter_dominates_weighted_powered_scores
      hq hw hweights hcontents_nonnegative hcontents_ball husers
  let z : Fin N → ℝ := fun i =>
    (score (users i) (lpPowerBarycenter q w contents)) ^ q
  refine ⟨z, ?_, ?_⟩
  · refine ⟨fun i => score (users i) (lpPowerBarycenter q w contents),
      ⟨lpPowerBarycenter q w contents, ⟨hbary_nonnegative, hbary_ball⟩, rfl⟩, rfl⟩
  · intro i
    refine ⟨?_, ?_⟩
    · calc
        0 ≤ ∑ k, w k * rows k i :=
          Finset.sum_nonneg fun k _ => mul_nonneg (hw k) (hrows_nonnegative k i)
        _ = (∑ k, w k • rows k) i := by simp
        _ = y i := congrFun hmix i
    · calc
        y i = (∑ k, w k • rows k) i := congrFun hmix.symm i
        _ = ∑ k, w k * rows k i := by simp
        _ = ∑ k, w k * (score (users i) (contents k)) ^ q := by
          refine Finset.sum_congr rfl ?_
          intro k _hk
          rw [hz_eq k, hbase_eq k]
        _ ≤ (score (users i) (lpPowerBarycenter q w contents)) ^ q := hbary_scores i
        _ = z i := rfl

/-- Coordinatewise comparison of nonnegative rows compares their products. -/
theorem coordinateProduct_le_of_nonnegative_coordinatewise_le {N : ℕ}
    {x y : Fin N → ℝ}
    (hx : ∀ i, 0 ≤ x i) (hxy : ∀ i, x i ≤ y i) :
    coordinateProduct x ≤ coordinateProduct y := by
  unfold coordinateProduct
  exact Finset.prod_le_prod (fun i _ => hx i) (fun i _ => hxy i)

/--
Coordinate-product form of the `betap` convexification argument: every
convex-hull powered row has an original powered row with weakly larger Nash
product.  Together with source-set inclusion in its convex hull, this is the
mathematical equality of maxima proved in the first half of the corollary.
-/
theorem exists_poweredUnitImage_coordinateProduct_ge_convexHull_lp
    {D N : ℕ} {q : ℝ} {users : Fin N → Content D}
    (hq : 1 ≤ q) (husers : ∀ i, NonnegativeContent (users i))
    {y : Fin N → ℝ}
    (hy : y ∈ convexHull ℝ
      {z : Fin N → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧
            AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z}) :
    ∃ z ∈ {z : Fin N → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧
            AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z},
      coordinateProduct y ≤ coordinateProduct z := by
  obtain ⟨z, hz, hall⟩ :=
    exists_poweredUnitImage_dominating_convexHull_lp hq husers hy
  exact ⟨z, hz,
    coordinateProduct_le_of_nonnegative_coordinatewise_le
      (fun i => (hall i).1) (fun i => (hall i).2)⟩

/--
Compactness of the finite nonnegative `Lq` ball yields an attained
coordinate-product maximum for its powered score image.  This local form is
placed before the `betap` product-supremum theorem that first consumes it.
-/
theorem exists_coordinateProductMaximizer_inPoweredUnitImage_lp_early
    {D N : ℕ} (users : Fin N → Content D) {q β : ℝ}
    (hq : 0 < q) (hβ : 0 ≤ β) :
    ∃ y : Fin N → ℝ,
      IsCoordinateProductMaximizer
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧
              AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β z} y := by
  let K : Set (Content D) := {p |
    NonnegativeContent p ∧ AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1}
  let f : Content D → Fin N → ℝ := fun p i => (score (users i) p) ^ β
  have hK : IsCompact K := by
    simpa [K] using
      (AppliedModelingLib.FiniteDimensionalNorms.isCompact_nonnegative_lp_closedBall
        (ι := Fin D) hq)
  have hf : Continuous f := by
    apply continuous_pi
    intro i
    exact (Real.continuous_rpow_const hβ).comp
      (by
        unfold score
        exact continuous_finset_sum Finset.univ fun d _hd =>
          continuous_const.mul (continuous_apply d))
  have hset : {y : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧
          AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β y} = f '' K := by
    ext y
    constructor
    · rintro ⟨base, ⟨p, hp, hbase⟩, hy⟩
      refine ⟨p, hp, ?_⟩
      ext i
      rw [hy, hbase]
    · rintro ⟨p, hp, rfl⟩
      refine ⟨fun i => score (users i) p, ⟨p, hp, rfl⟩, rfl⟩
  let S : Set (Fin N → ℝ) := {z |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧
        AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β z}
  have hcompact : IsCompact S := by
    rw [show S = f '' K by simpa [S] using hset]
    exact hK.image hf
  have hzero : (0 : Content D) ∈ K := by
    refine ⟨fun _ => le_rfl, ?_⟩
    rw [show AppliedModelingLib.FiniteDimensionalNorms.lp q (0 : Content D) = 0 by
      simpa using
        (AppliedModelingLib.FiniteDimensionalNorms.lp_zero_of_pos (ι := Fin D) hq)]
    exact zero_le_one
  have hnonempty : S.Nonempty := by
    refine ⟨fun i => (score (users i) (0 : Content D)) ^ β, ?_⟩
    refine ⟨fun i => score (users i) (0 : Content D), ⟨0, hzero, rfl⟩, rfl⟩
  obtain ⟨y, hy, hymax⟩ := hcompact.exists_isMaxOn hnonempty
    (continuous_finset_prod Finset.univ fun i _ => continuous_apply i).continuousOn
  exact ⟨y, hy, hymax⟩

/--
Product-supremum form of the first half of Corollary `betap`.  The Lq
barycenter construction dominates every convexified q-powered row by an
original row, while compactness of the finite Lq image attains the source
product maximum.  Consequently convexification cannot improve that maximum.
-/
theorem singleGenreProductSupCondition_inPoweredUnitImage_lp_at_exponent
    {D N : ℕ} {q : ℝ} {users : Fin N → Content D}
    (hq : 1 ≤ q) (husers : ∀ i, NonnegativeContent (users i)) :
    SingleGenreProductSupCondition
      {y : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧
          AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q y} := by
  let S : Set (Fin N → ℝ) := {y |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧
        AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q y}
  have hq_pos : 0 < q := lt_of_lt_of_le zero_lt_one hq
  obtain ⟨x, hmaxS⟩ :=
    exists_coordinateProductMaximizer_inPoweredUnitImage_lp_early users hq_pos
      (le_trans zero_le_one hq)
  have hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) x := by
    refine ⟨subset_convexHull ℝ S hmaxS.1, ?_⟩
    intro y hy
    obtain ⟨z, hz, hproduct⟩ :=
      exists_poweredUnitImage_coordinateProduct_ge_convexHull_lp hq husers
        (by simpa [S] using hy)
    exact hproduct.trans (hmaxS.2 z (by simpa [S] using hz))
  unfold SingleGenreProductSupCondition
  change coordinateProductSup S = coordinateProductSup (convexHull ℝ S)
  exact (coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxS).trans
    (coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxHull).symm

/--
Corollary `betap`, direct equilibrium endpoint with explicit finite
attainment/positive-score hypotheses.  At `beta = q`, the `Lq` barycenter
argument returns a powered row in the original source image that attains the
convex-hull product maximum; the existing direct ray-law construction then
gives a symmetric mixed Nash equilibrium.
-/
theorem exists_singleGenreContentLaw_sourceSymmetricMixedNash_lp_beta_eq_q
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {q : ℝ} {users : Fin N → Content D} {y : Fin N → ℝ}
    (hq : 1 ≤ q) (husers : ∀ i, NonnegativeContent (users i))
    (hmax : IsCoordinateProductMaximizer
      (convexHull ℝ
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧
              AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z}) y)
    (hpos : ∀ z ∈ convexHull ℝ
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧
              AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z},
      ∀ i, 0 < z i) :
    ∃ p : Content D, NonnegativeContent p ∧
      AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1 ∧
      (∀ i : Fin N, 0 < score (users i) p) ∧
      SourceSymmetricMixedNash (P := P) users
        (normRpowCost (SourceNorm.lp D (lt_of_lt_of_le zero_lt_one hq)) q)
        (singleGenreContentLaw N P q
          (SourceNorm.normalizedContent
            (SourceNorm.lp D (lt_of_lt_of_le zero_lt_one hq)) p)) := by
  let S : Set (Fin N → ℝ) :=
    {z : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧
          AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z}
  have hy : y ∈ convexHull ℝ S := by
    simpa [S] using hmax.1
  obtain ⟨z, hzS, hprod⟩ :=
    exists_poweredUnitImage_coordinateProduct_ge_convexHull_lp hq husers hy
  have hzHull : z ∈ convexHull ℝ S := subset_convexHull ℝ S hzS
  have hmaxz : IsCoordinateProductMaximizer (convexHull ℝ S) z := by
    refine ⟨hzHull, ?_⟩
    intro z' hz'
    exact (hmax.2 z' (by simpa [S] using hz')).trans hprod
  have hposS : ∀ z ∈ convexHull ℝ S, ∀ i, 0 < z i := by
    intro z' hz' i
    simpa [S] using hpos z' (by simpa [S] using hz') i
  obtain ⟨row, hrowS, hcondition⟩ :=
    existsSingleGenreDirectionCondition_of_hull_coordinateProductMaximizer_mem
      hmaxz hzS hposS
  rcases hrowS with ⟨base, ⟨p, hp, hbase_eq⟩, hrow_eq⟩
  have hrowHull : row ∈ convexHull ℝ S :=
    subset_convexHull ℝ S (by
      refine ⟨base, ⟨p, hp, hbase_eq⟩, hrow_eq⟩)
  have hq_pos : 0 < q := lt_of_lt_of_le zero_lt_one hq
  have hscore : ∀ i : Fin N, 0 < score (users i) p := by
    intro i
    have h := hposS row hrowHull i
    rw [hrow_eq, hbase_eq] at h
    by_contra hnot
    have hnonnegative : 0 ≤ score (users i) p :=
      score_nonneg_of_nonnegative (husers i) hp.1
    have hzero : score (users i) p = 0 :=
      le_antisymm (le_of_not_gt hnot) hnonnegative
    change 0 < (score (users i) p) ^ q at h
    rw [hzero, Real.zero_rpow hq_pos.ne'] at h
    exact (lt_irrefl (0 : ℝ)) h
  have hcondition_row :
      SingleGenreDirectionCondition
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun x => NonnegativeContent x ∧
              AppliedModelingLib.FiniteDimensionalNorms.lp q x ≤ 1) q z}
        (fun i => (score (users i) p) ^ q) := by
    simpa [hrow_eq, hbase_eq] using hcondition
  have hcondition' :
      SingleGenreDirectionCondition
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun x => NonnegativeContent x ∧
              (SourceNorm.lp D hq_pos).norm x ≤ 1) q z}
        (fun i => (score (users i) p) ^ q) := by
    simpa [SourceNorm.lp] using hcondition_row
  refine ⟨p, hp.1, hp.2, hscore, ?_⟩
  exact singleGenreContentLaw_is_sourceSymmetricMixedNash_of_positive_ball_condition
    (SourceNorm.lp D hq_pos) hq_pos husers hp.1 hp.2 hscore hcondition'

/-- Standard coordinate basis content for the sharpness direction of Corollary `betap`. -/
def standardBasisContent (D : ℕ) (i : Fin D) : Content D :=
  fun d => if d = i then 1 else 0

/-- Standard-basis users are the coordinate basis content vectors. -/
abbrev standardBasisUsers (D : ℕ) (i : Fin D) : Content D :=
  standardBasisContent D i

theorem standardBasisContent_nonnegative (D : ℕ) (i : Fin D) :
    NonnegativeContent (standardBasisContent D i) := by
  intro d
  by_cases h : d = i <;> simp [standardBasisContent, h]

@[simp] theorem score_standardBasisContent {D : ℕ} (i : Fin D) (p : Content D) :
    score (standardBasisContent D i) p = p i := by
  unfold score standardBasisContent
  rw [Finset.sum_eq_single i]
  · simp
  · intro d _hd hdi
    simp [hdi]
  · simp

@[simp] theorem score_standardBasisContent_basis (D : ℕ)
    (i k : Fin D) :
    score (standardBasisUsers D i) (standardBasisContent D k) =
      if i = k then 1 else 0 := by
  rw [score_standardBasisContent]
  rfl

theorem lp_standardBasisContent_eq_one {D : ℕ} {q : ℝ} (hq : 0 < q)
    (i : Fin D) :
    AppliedModelingLib.FiniteDimensionalNorms.lp q (standardBasisContent D i) = 1 := by
  unfold AppliedModelingLib.FiniteDimensionalNorms.lp
    AppliedModelingLib.FiniteDimensionalNorms.lpPower standardBasisContent
  rw [Finset.sum_eq_single i]
  · simp
  · intro d _hd hdi
    simp [hdi, Real.zero_rpow hq.ne']
  · simp

/-- The coordinate-uniform row used in the standard-basis sharpness witness. -/
noncomputable def standardBasisUniformRow (D : ℕ) : Fin D → ℝ :=
  fun _ => 1 / (D : ℝ)

/--
For standard-basis users, a nonnegative `Lq`-unit-ball source vector has
strictly smaller powered coordinate product than the coordinate-uniform
benchmark whenever `β > q`.

This is the source-side half of Corollary `betap`'s standard-basis witness.
-/
theorem standardBasis_powered_coordinateProduct_lt_uniform
    {D : ℕ} [Nontrivial (Fin D)] {q β : ℝ}
    (hq : 0 < q) (hβ : q < β) {p : Content D}
    (hp_nonnegative : NonnegativeContent p)
    (hp_ball : AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) :
    coordinateProduct
      (fun i => (score (standardBasisUsers D i) p) ^ β) <
      (1 / (D : ℝ)) ^ (D : ℝ) := by
  simpa [coordinateProduct] using
    (AppliedModelingLib.FiniteDimensionalNorms.prod_rpow_lt_card_inv_rpow_card_of_lp_le_one
      (ι := Fin D) hq hβ hp_nonnegative hp_ball)

theorem coordinateProduct_standardBasisUniformRow (D : ℕ) :
    coordinateProduct (standardBasisUniformRow D) =
      (1 / (D : ℝ)) ^ (D : ℝ) := by
  unfold coordinateProduct standardBasisUniformRow
  rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin,
    ← Real.rpow_natCast]

/--
Diagonal one-rows yield the convexified lower product bound used in Corollary
`beta`: their equal-weight mixture has every coordinate at least `1 / N`.
-/
theorem exists_convexHull_coordinateProduct_ge_uniform_of_diagonal_one_rows
    {N : ℕ} [Nonempty (Fin N)] {S : Set (Fin N → ℝ)}
    {rows : Fin N → Fin N → ℝ}
    (hrows_mem : ∀ k, rows k ∈ S)
    (hrows_nonnegative : ∀ k i, 0 ≤ rows k i)
    (hdiagonal_one : ∀ i, rows i i = 1) :
    ∃ y ∈ convexHull ℝ S,
      (1 / (N : ℝ)) ^ (N : ℝ) ≤ coordinateProduct y := by
  classical
  let y : Fin N → ℝ := fun i => ∑ k : Fin N, (1 / (N : ℝ)) * rows k i
  have hNpos_nat : 0 < N := by
    simpa using (Fintype.card_pos_iff.mpr (inferInstance : Nonempty (Fin N)))
  have hNpos : 0 < (N : ℝ) := by
    exact_mod_cast hNpos_nat
  have hy_mem : y ∈ convexHull ℝ S := by
    dsimp [y]
    refine mem_convexHull_of_exists_fintype
      (fun _ : Fin N => 1 / (N : ℝ)) rows ?_ ?_ hrows_mem ?_
    · intro k
      exact (one_div_pos.mpr hNpos).le
    · rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      simpa [one_div] using mul_inv_cancel₀ (ne_of_gt hNpos)
    · ext i
      rw [Finset.sum_apply]
      simp only [Pi.smul_apply, smul_eq_mul]
  have hy_coordinate : ∀ i, (1 / (N : ℝ)) ≤ y i := by
    intro i
    dsimp [y]
    calc
      1 / (N : ℝ) = (1 / (N : ℝ)) * rows i i := by
        rw [hdiagonal_one i, mul_one]
      _ ≤ ∑ k : Fin N, (1 / (N : ℝ)) * rows k i :=
        Finset.single_le_sum
          (fun k _hk => mul_nonneg (one_div_pos.mpr hNpos).le
            (hrows_nonnegative k i))
          (Finset.mem_univ i)
  refine ⟨y, hy_mem, ?_⟩
  have huniform_nonnegative : ∀ i, 0 ≤ standardBasisUniformRow N i := by
    intro i
    dsimp [standardBasisUniformRow]
    exact (one_div_pos.mpr hNpos).le
  have hproduct := coordinateProduct_le_of_nonnegative_coordinatewise_le
    huniform_nonnegative hy_coordinate
  rw [coordinateProduct_standardBasisUniformRow N] at hproduct
  exact hproduct

/--
Corrected finite strict-gap core of Corollary `beta`.  Suppose each normalized
user has an attained nonnegative unit direction with own score one, and every
nonnegative unit-ball direction has total user score at most `Z`.  Whenever
the stated scalar comparison is strict, a concrete convexified powered row
strictly beats every original powered source row in coordinate product.

This proves the optimization comparison at a fixed exponent.  It deliberately
does not turn that comparison into the source's real-valued `beta*` threshold,
whose boundary `Z = N` needs a separate extended-real or case-split statement.
-/
theorem exists_convexHull_poweredUnitImage_coordinateProduct_strict_gap_of_normalized_dual_witnesses
    {D N : ℕ} [Nonempty (Fin N)] {β Z : ℝ}
    {users : Fin N → Content D} (ν : SourceNorm D)
    (hβ_nonnegative : 0 ≤ β)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (haggregate_bound : ∀ p : Content D, NonnegativeContent p → ν.norm p ≤ 1 →
      (∑ i : Fin N, score (users i) p) ≤ Z)
    (hdual_witness : ∀ i : Fin N, ∃ p : Content D,
      NonnegativeContent p ∧ ν.norm p = 1 ∧ score (users i) p = 1)
    (hstrict : (Z / (N : ℝ)) ^ ((N : ℝ) * β) <
      (1 / (N : ℝ)) ^ (N : ℝ)) :
    ∃ y ∈ convexHull ℝ
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z},
      ∀ z ∈ {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z},
        coordinateProduct z < coordinateProduct y := by
  classical
  choose p hp using hdual_witness
  let S : Set (Fin N → ℝ) := {z : Fin N → ℝ |
    InPoweredUnitImage users
      (fun q => NonnegativeContent q ∧ ν.norm q ≤ 1) β z}
  let rows : Fin N → Fin N → ℝ :=
    fun k i => (score (users i) (p k)) ^ β
  have hrows_mem : ∀ k, rows k ∈ S := by
    intro k
    refine ⟨fun i => score (users i) (p k), ?_, rfl⟩
    exact ⟨p k, ⟨(hp k).1, le_of_eq (hp k).2.1⟩, rfl⟩
  have hrows_nonnegative : ∀ k i, 0 ≤ rows k i := by
    intro k i
    dsimp [rows]
    exact Real.rpow_nonneg
      (score_nonneg_of_nonnegative (husers_nonnegative i) (hp k).1) β
  have hdiagonal_one : ∀ i, rows i i = 1 := by
    intro i
    dsimp [rows]
    rw [(hp i).2.2, Real.one_rpow]
  obtain ⟨y, hy_convex, hy_lower⟩ :=
    exists_convexHull_coordinateProduct_ge_uniform_of_diagonal_one_rows
      hrows_mem hrows_nonnegative hdiagonal_one
  refine ⟨y, by simpa [S] using hy_convex, ?_⟩
  intro z hz
  rcases hz with ⟨base, ⟨q, hq, hbase⟩, hz_eq⟩
  have ha_nonnegative : ∀ i, 0 ≤ score (users i) q := by
    intro i
    exact score_nonneg_of_nonnegative (husers_nonnegative i) hq.1
  have hsum : (∑ i : Fin N, score (users i) q) ≤ Z :=
    haggregate_bound q hq.1 hq.2
  have hupper := coordinateProduct_rpow_le_meanBound_rpow_card_mul
    ha_nonnegative hβ_nonnegative hsum
  calc
    coordinateProduct z =
        coordinateProduct (fun i => (score (users i) q) ^ β) := by
      rw [hz_eq, hbase]
    _ ≤ (Z / (N : ℝ)) ^ ((N : ℝ) * β) := hupper
    _ < (1 / (N : ℝ)) ^ (N : ℝ) := hstrict
    _ ≤ coordinateProduct y := hy_lower

/--
The corrected real-valued interior form of the Corollary `beta` scalar
calculation.  For `1 < Z < N`, an exponent strictly above the displayed log
ratio yields the strict product comparison used by the finite gap theorem.
The boundary `Z = N` is intentionally excluded rather than represented by
totalized division by zero.
-/
theorem generalThreshold_scalar_strict_gap_of_lt_log_bound
    {N : ℕ} [Nontrivial (Fin N)] {Z β : ℝ}
    (hZ_one_lt : 1 < Z) (hZ_lt_card : Z < (N : ℝ))
    (hβ : Real.log (N : ℝ) /
        (Real.log (N : ℝ) - Real.log Z) < β) :
    0 < β ∧
      (Z / (N : ℝ)) ^ ((N : ℝ) * β) <
        (1 / (N : ℝ)) ^ (N : ℝ) := by
  have hN_one_lt : 1 < (N : ℝ) := by
    have hcard : 1 < Fintype.card (Fin N) := by
      exact Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
    have hNnat : 1 < N := by simpa using hcard
    exact_mod_cast hNnat
  have hNpos : 0 < (N : ℝ) := zero_lt_one.trans hN_one_lt
  have hZpos : 0 < Z := zero_lt_one.trans hZ_one_lt
  have hlogZ_lt_logN : Real.log Z < Real.log (N : ℝ) :=
    Real.log_lt_log hZpos hZ_lt_card
  have hden_pos : 0 < Real.log (N : ℝ) - Real.log Z :=
    sub_pos.mpr hlogZ_lt_logN
  have hlogN_pos : 0 < Real.log (N : ℝ) :=
    Real.log_pos hN_one_lt
  have hthreshold_pos : 0 < Real.log (N : ℝ) /
      (Real.log (N : ℝ) - Real.log Z) :=
    div_pos hlogN_pos hden_pos
  refine ⟨lt_trans hthreshold_pos hβ, ?_⟩
  have hbound : Real.log (N : ℝ) <
      β * (Real.log (N : ℝ) - Real.log Z) :=
    (div_lt_iff₀ hden_pos).mp hβ
  have hscaled : (N : ℝ) * Real.log (N : ℝ) <
      (N : ℝ) * (β * (Real.log (N : ℝ) - Real.log Z)) :=
    mul_lt_mul_of_pos_left hbound hNpos
  have hlog_exponent :
      (Real.log Z - Real.log (N : ℝ)) * ((N : ℝ) * β) <
        (-Real.log (N : ℝ)) * (N : ℝ) := by
    calc
      (Real.log Z - Real.log (N : ℝ)) * ((N : ℝ) * β) =
          -((N : ℝ) * (β * (Real.log (N : ℝ) - Real.log Z))) := by ring
      _ < -((N : ℝ) * Real.log (N : ℝ)) := neg_lt_neg hscaled
      _ = (-Real.log (N : ℝ)) * (N : ℝ) := by ring
  have hZ_div_pos : 0 < Z / (N : ℝ) := div_pos hZpos hNpos
  have hone_div_pos : 0 < 1 / (N : ℝ) := one_div_pos.mpr hNpos
  rw [Real.rpow_def_of_pos hZ_div_pos,
    Real.rpow_def_of_pos hone_div_pos, Real.exp_lt_exp]
  rw [Real.log_div (ne_of_gt hZpos) (ne_of_gt hNpos),
    Real.log_div one_ne_zero (ne_of_gt hNpos), Real.log_one, zero_sub]
  exact hlog_exponent

/--
The `Z = 1` boundary of the corrected Corollary `beta` scalar calculation.
For a nontrivial finite population, every exponent strictly above one gives
the required strict product comparison.  This is separate from the interior
log formula, whose denominator is well-defined only away from `Z = N`.
-/
theorem generalThreshold_scalar_strict_gap_of_Z_eq_one
    {N : ℕ} [Nontrivial (Fin N)] {β : ℝ} (hβ_one_lt : 1 < β) :
    ((1 : ℝ) / (N : ℝ)) ^ ((N : ℝ) * β) <
      (1 / (N : ℝ)) ^ (N : ℝ) := by
  have hN_one_lt : 1 < (N : ℝ) := by
    have hcard : 1 < Fintype.card (Fin N) := by
      exact Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
    have hNnat : 1 < N := by simpa using hcard
    exact_mod_cast hNnat
  have hNpos : 0 < (N : ℝ) := zero_lt_one.trans hN_one_lt
  have hbase_pos : 0 < 1 / (N : ℝ) := one_div_pos.mpr hNpos
  have hbase_lt_one : 1 / (N : ℝ) < 1 := by
    simpa using (one_div_lt_one_div hNpos zero_lt_one).mpr hN_one_lt
  have hexponents : (N : ℝ) < (N : ℝ) * β := by
    simpa using mul_lt_mul_of_pos_left hβ_one_lt hNpos
  exact Real.rpow_lt_rpow_of_exponent_gt hbase_pos hbase_lt_one hexponents

/-- The exact finite case split for the normalized aggregate parameter. -/
theorem generalThreshold_normalizedZ_cases {N : ℕ} {Z : ℝ}
    (hZ_one_le : 1 ≤ Z) (hZ_le_card : Z ≤ (N : ℝ)) :
    Z = 1 ∨ (1 < Z ∧ Z < (N : ℝ)) ∨ Z = (N : ℝ) := by
  rcases eq_or_lt_of_le hZ_one_le with hZ_one | hZ_one
  · exact Or.inl hZ_one.symm
  by_cases hZ_card : Z = (N : ℝ)
  · exact Or.inr (Or.inr hZ_card)
  · exact Or.inr (Or.inl ⟨hZ_one, lt_of_le_of_ne hZ_le_card hZ_card⟩)

/--
Corrected finite `Z = 1` product-gap branch of Corollary `beta`.  With
score-one unit witnesses and aggregate score at most one, every exponent above
one produces a convexified powered row that strictly beats every source row.
-/
theorem exists_convexHull_poweredUnitImage_coordinateProduct_strict_gap_of_Z_eq_one
    {D N : ℕ} [Nontrivial (Fin N)] {β : ℝ}
    {users : Fin N → Content D} (ν : SourceNorm D)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (haggregate_bound : ∀ p : Content D, NonnegativeContent p → ν.norm p ≤ 1 →
      (∑ i : Fin N, score (users i) p) ≤ 1)
    (hdual_witness : ∀ i : Fin N, ∃ p : Content D,
      NonnegativeContent p ∧ ν.norm p = 1 ∧ score (users i) p = 1)
    (hβ_one_lt : 1 < β) :
    ∃ y ∈ convexHull ℝ
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z},
      ∀ z ∈ {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z},
        coordinateProduct z < coordinateProduct y := by
  exact
    exists_convexHull_poweredUnitImage_coordinateProduct_strict_gap_of_normalized_dual_witnesses
      ν (le_trans zero_le_one hβ_one_lt.le) husers_nonnegative haggregate_bound hdual_witness
      (by simpa using generalThreshold_scalar_strict_gap_of_Z_eq_one hβ_one_lt)

/--
Corrected finite interior Corollary `beta` product comparison.  In the regime
`1 < Z < N`, the displayed logarithmic bound implies a strict convex-hull
product gap at the chosen exponent, under explicit normalized dual witnesses
and the aggregate score bound.
-/
theorem exists_convexHull_poweredUnitImage_coordinateProduct_strict_gap_of_lt_general_threshold
    {D N : ℕ} [Nontrivial (Fin N)] {β Z : ℝ}
    {users : Fin N → Content D} (ν : SourceNorm D)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (haggregate_bound : ∀ p : Content D, NonnegativeContent p → ν.norm p ≤ 1 →
      (∑ i : Fin N, score (users i) p) ≤ Z)
    (hdual_witness : ∀ i : Fin N, ∃ p : Content D,
      NonnegativeContent p ∧ ν.norm p = 1 ∧ score (users i) p = 1)
    (hZ_one_lt : 1 < Z) (hZ_lt_card : Z < (N : ℝ))
    (hβ : Real.log (N : ℝ) /
        (Real.log (N : ℝ) - Real.log Z) < β) :
    ∃ y ∈ convexHull ℝ
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z},
      ∀ z ∈ {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z},
        coordinateProduct z < coordinateProduct y := by
  obtain ⟨hβ_pos, hstrict⟩ :=
    generalThreshold_scalar_strict_gap_of_lt_log_bound hZ_one_lt hZ_lt_card hβ
  exact
    exists_convexHull_poweredUnitImage_coordinateProduct_strict_gap_of_normalized_dual_witnesses
      ν hβ_pos.le husers_nonnegative haggregate_bound hdual_witness hstrict

/--
Corrected finite interior equilibrium-exclusion form of Corollary `beta`.
The explicit ray law cannot be a symmetric mixed equilibrium once the
strict convex-hull product improvement holds above the interior threshold.
-/
theorem not_singleGenreContentLaw_sourceSymmetricMixedNash_of_lt_general_threshold
    {D N P : ℕ} [Nontrivial (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β Z : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (haggregate_bound : ∀ p : Content D, NonnegativeContent p → ν.norm p ≤ 1 →
      (∑ i : Fin N, score (users i) p) ≤ Z)
    (hdual_witness : ∀ i : Fin N, ∃ p : Content D,
      NonnegativeContent p ∧ ν.norm p = 1 ∧ score (users i) p = 1)
    (hZ_one_lt : 1 < Z) (hZ_lt_card : Z < (N : ℝ))
    (hβ_bound : Real.log (N : ℝ) /
        (Real.log (N : ℝ) - Real.log Z) < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (hscore : ∀ i : Fin N, 0 < score (users i) genre) :
    ¬ SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β genre) := by
  obtain ⟨hβ_pos, _⟩ :=
    generalThreshold_scalar_strict_gap_of_lt_log_bound hZ_one_lt hZ_lt_card hβ_bound
  obtain ⟨w, hw, hgap⟩ :=
    exists_convexHull_poweredUnitImage_coordinateProduct_strict_gap_of_lt_general_threshold
      ν husers_nonnegative haggregate_bound hdual_witness hZ_one_lt hZ_lt_card hβ_bound
  exact not_singleGenreContentLaw_sourceSymmetricMixedNash_of_strict_convexHull_product_gap
    ν hβ_pos hgenre_norm hgenre_nonnegative husers_nonnegative hscore hw hgap

/--
Corrected `Z = 1` equilibrium-exclusion branch of Corollary `beta`.
Every exponent strictly above one yields a strict convex-hull product
improvement and therefore rules out the explicit single-genre ray law.
-/
theorem not_singleGenreContentLaw_sourceSymmetricMixedNash_of_Z_eq_one
    {D N P : ℕ} [Nontrivial (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (haggregate_bound : ∀ p : Content D, NonnegativeContent p → ν.norm p ≤ 1 →
      (∑ i : Fin N, score (users i) p) ≤ 1)
    (hdual_witness : ∀ i : Fin N, ∃ p : Content D,
      NonnegativeContent p ∧ ν.norm p = 1 ∧ score (users i) p = 1)
    (hβ_one_lt : 1 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (hscore : ∀ i : Fin N, 0 < score (users i) genre) :
    ¬ SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (singleGenreContentLaw N P β genre) := by
  obtain ⟨w, hw, hgap⟩ :=
    exists_convexHull_poweredUnitImage_coordinateProduct_strict_gap_of_Z_eq_one
      ν husers_nonnegative haggregate_bound hdual_witness hβ_one_lt
  exact not_singleGenreContentLaw_sourceSymmetricMixedNash_of_strict_convexHull_product_gap
    ν (zero_lt_one.trans hβ_one_lt) hgenre_norm hgenre_nonnegative
    husers_nonnegative hscore hw hgap

/--
The coordinate-uniform benchmark lies in the convex hull of the powered
standard-basis source rows.  It is the equal-weight mixture of the `D` basis
contents, each of which is on the `Lq` unit sphere.
-/
theorem standardBasisUniformRow_mem_convexHull_powered
    {D : ℕ} [Nontrivial (Fin D)] {q β : ℝ}
    (hq : 0 < q) (hβ : 0 < β) :
    standardBasisUniformRow D ∈ convexHull ℝ
      {y : Fin D → ℝ |
        InPoweredUnitImage (standardBasisUsers D)
          (fun p => NonnegativeContent p ∧
            AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β y} := by
  classical
  let row : Fin D → Fin D → ℝ :=
    fun k i => (score (standardBasisUsers D i) (standardBasisContent D k)) ^ β
  have hDpos : 0 < (D : ℝ) := by
    have hD_one_lt : 1 < D := by
      simpa using
        (Fintype.one_lt_card_iff_nontrivial (α := Fin D)).mpr inferInstance
    exact_mod_cast (lt_trans Nat.zero_lt_one hD_one_lt)
  have hDne : (D : ℝ) ≠ 0 := ne_of_gt hDpos
  refine mem_convexHull_of_exists_fintype
    (fun _ : Fin D => 1 / (D : ℝ)) row ?_ ?_ ?_ ?_
  · intro k
    exact (one_div_pos.mpr hDpos).le
  · rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    simpa [one_div] using mul_inv_cancel₀ hDne
  · intro k
    refine ⟨fun i => score (standardBasisUsers D i) (standardBasisContent D k), ?_, rfl⟩
    exact ⟨standardBasisContent D k,
      ⟨standardBasisContent_nonnegative D k,
        (lp_standardBasisContent_eq_one hq k).le⟩, rfl⟩
  · ext i
    rw [Finset.sum_apply]
    simp only [Pi.smul_apply, standardBasisUniformRow]
    change (∑ k, (1 / (D : ℝ)) * row k i) = 1 / (D : ℝ)
    rw [Finset.sum_eq_single i]
    · simp [row, standardBasisContent]
    · intro k _hk hki
      simp [row, standardBasisContent, Ne.symm hki, Real.zero_rpow hβ.ne']
    · simp

/--
Corrected standard-basis sharpness conclusion for Corollary `betap`: every
source row has strictly smaller coordinate product than a concrete row in its
convex hull when `β > q`.

The printed proof omits a factor of `D` in both displayed products.  This
theorem proves the literal product comparison, whose strictness is unchanged.
-/
theorem standardBasis_convexHull_coordinateProduct_strict_gap
    {D : ℕ} [Nontrivial (Fin D)] {q β : ℝ}
    (hq : 0 < q) (hβ : q < β) :
    ∃ y ∈ convexHull ℝ
        {z : Fin D → ℝ |
          InPoweredUnitImage (standardBasisUsers D)
            (fun p => NonnegativeContent p ∧
              AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β z},
      ∀ z ∈ {z : Fin D → ℝ |
          InPoweredUnitImage (standardBasisUsers D)
            (fun p => NonnegativeContent p ∧
              AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β z},
        coordinateProduct z < coordinateProduct y := by
  refine ⟨standardBasisUniformRow D,
    standardBasisUniformRow_mem_convexHull_powered hq (lt_trans hq hβ), ?_⟩
  intro z hz
  rcases hz with ⟨base, ⟨p, hp, hbase⟩, hz⟩
  calc
    coordinateProduct z =
        coordinateProduct
          (fun i => (score (standardBasisUsers D i) p) ^ β) := by
      rw [hz, hbase]
    _ < (1 / (D : ℝ)) ^ (D : ℝ) :=
      standardBasis_powered_coordinateProduct_lt_uniform hq hβ hp.1 hp.2
    _ = coordinateProduct (standardBasisUniformRow D) :=
      (coordinateProduct_standardBasisUniformRow D).symm

/-- Scores against a fixed user vary continuously with the content vector. -/
theorem continuous_score_right {D : ℕ} (u : Content D) :
    Continuous (fun p : Content D => score u p) := by
  unfold score
  exact continuous_finset_sum Finset.univ fun d _hd =>
    continuous_const.mul (continuous_apply d)

/--
If the score push-forward has no atoms, the strict probability of beating a
fixed user's score varies continuously with the focal content.  The strict
event is first identified with the push-forward CDF; continuity is then the
general nonatomic-CDF theorem from the probability library.
-/
theorem continuous_score_strictMass_of_score_level_null
    {D : ℕ} {u : Content D} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ]
    (hscore_null : ∀ z : ℝ, μ {q : Content D | score u q = z} = 0) :
    Continuous (fun p : Content D =>
      μ.real {q : Content D | score u q < score u p}) := by
  let scoreLaw : MeasureTheory.Measure ℝ :=
    MeasureTheory.Measure.map (fun q : Content D => score u q) μ
  have hmeas_score : Measurable (fun q : Content D => score u q) :=
    measurable_score_content u
  letI : MeasureTheory.IsProbabilityMeasure scoreLaw := by
    dsimp [scoreLaw]
    exact MeasureTheory.Measure.isProbabilityMeasure_map hmeas_score.aemeasurable
  letI : MeasureTheory.NoAtoms scoreLaw := by
    constructor
    intro z
    dsimp [scoreLaw]
    rw [MeasureTheory.Measure.map_apply hmeas_score (measurableSet_singleton z)]
    exact hscore_null z
  have hcdf : Continuous (ProbabilityTheory.cdf scoreLaw) :=
    AppliedModelingLib.Probability.continuous_cdf_of_noAtoms scoreLaw
  have hcomposition : Continuous (fun p : Content D =>
      ProbabilityTheory.cdf scoreLaw (score u p)) :=
    hcdf.comp (continuous_score_right u)
  have hrewrite :
      (fun p : Content D => μ.real {q : Content D | score u q < score u p}) =
        fun p => ProbabilityTheory.cdf scoreLaw (score u p) := by
    funext p
    rw [score_lt_measureReal_eq_lowerCDFMass_map_of_score_level_null
      hmeas_score hscore_null]
    dsimp [scoreLaw]
    exact AppliedModelingLib.Probability.lowerCDFMass_eq_cdf _ _
  rw [hrewrite]
  exact hcomposition

/--
With null score levels for every user, the actual uniform-tie expected
allocation is continuous in the focal content.  This uses the proved
strict-score payoff identity, rather than treating the discontinuous tie rule
as continuous directly.
-/
theorem continuous_expectedUsersWonAgainstSymmetricMixed_of_score_level_null
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {μ : MeasureTheory.Measure (Content D)} [MeasureTheory.IsProbabilityMeasure μ]
    (hscore_null : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0) :
    Continuous (fun p : Content D =>
      ExpectedUsersWonAgainstSymmetricMixed users j p μ) := by
  have hsum : Continuous (fun p : Content D =>
      ∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1)) := by
    apply continuous_finset_sum
    intro i _
    exact (continuous_score_strictMass_of_score_level_null
      (u := users i) (fun z => hscore_null i z)).pow (P - 1)
  have hrewrite :
      (fun p : Content D => ExpectedUsersWonAgainstSymmetricMixed users j p μ) =
        fun p => ∑ i : Fin N,
          (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1) := by
    funext p
    exact expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass p
      (fun i => measurable_score_content (users i)) hscore_null
  rw [hrewrite]
  exact hsum

/--
At a score-law-atomless mixed strategy, a continuous content cost makes the
source pure payoff continuous in the focal content.  This supplies the
support-regularity input that ordinary law-level equilibrium statements need
in order to recover equality at every topological-support action.
-/
theorem continuous_sourceMixedPurePayoff_of_score_level_null
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {cost : Content D → ℝ} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ]
    (hcost : Continuous cost)
    (hscore_null : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0) :
    Continuous (fun p : Content D =>
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ) := by
  unfold SourceMixedPurePayoff
  exact (continuous_expectedUsersWonAgainstSymmetricMixed_of_score_level_null
    (users := users) (j := j) hscore_null).sub hcost

/--
The support-regularity upgrade for a fixed focal producer.  A law-level
equilibrium supplies an a.e. payoff equality and a nonnegative-deviation upper
bound.  Once score-level nullness makes the actual uniform-tie payoff
continuous, the a.e. equality extends to each topological-support action.
-/
theorem sourceMixedPurePayoff_eq_equilibriumPayoff_of_mem_support_of_law_equilibrium
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {cost : Content D → ℝ} {μ : MixedContentStrategy D}
    [MeasureTheory.IsProbabilityMeasure μ]
    {equilibriumPayoff : ℝ} {p : Content D}
    (hsupport_nonnegative : μ.support ⊆ {q : Content D | NonnegativeContent q})
    (hno : SourceSymmetricMixedNoProfitableNonnegativeDeviation
      users cost j μ equilibriumPayoff)
    (hae_payoff : ∀ᵐ q ∂μ,
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost q μ =
        equilibriumPayoff)
    (hcost : Continuous cost)
    (hscore_null : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0)
    (hp : p ∈ μ.support) :
    SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ =
      equilibriumPayoff := by
  apply le_antisymm (hno p (hsupport_nonnegative hp))
  exact AppliedModelingLib.le_of_mem_support_of_ae_eq_of_upperSemicontinuous
    (measure := μ)
    (payoff := fun q : Content D =>
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost q μ)
    (value := equilibriumPayoff) hp hae_payoff
    (continuous_sourceMixedPurePayoff_of_score_level_null
      (users := users) (j := j) hcost hscore_null).upperSemicontinuous

/--
For the source model, the score-level perturbation argument discharges the
tie-null premise in the preceding support upgrade.  This is the full
fixed-focal bridge from ordinary law-level equilibrium facts on the unbounded
nonnegative action space to equality at every support action.
-/
theorem sourceMixedPurePayoff_eq_equilibriumPayoff_of_mem_support_of_law_equilibrium_of_nonzero_users
    {D N P : ℕ} [Nontrivial (Fin P)] {users : Fin N → Content D} {j : Fin P}
    {cost : Content D → ℝ} {μ : MixedContentStrategy D}
    [MeasureTheory.IsProbabilityMeasure μ]
    {equilibriumPayoff : ℝ} {p : Content D}
    (hsupport_nonnegative : μ.support ⊆ {q : Content D | NonnegativeContent q})
    (hno : SourceSymmetricMixedNoProfitableNonnegativeDeviation
      users cost j μ equilibriumPayoff)
    (hae_payoff : ∀ᵐ q ∂μ,
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost q μ =
        equilibriumPayoff)
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hperturb_cost : PerturbationCostContinuous cost)
    (hcost : Continuous cost)
    (hp : p ∈ μ.support) :
    SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ =
      equilibriumPayoff := by
  refine sourceMixedPurePayoff_eq_equilibriumPayoff_of_mem_support_of_law_equilibrium
    hsupport_nonnegative hno hae_payoff hcost ?_ hp
  intro i z
  exact (MeasureTheory.measureReal_eq_zero_iff (μ := μ)
    (s := {q : Content D | score (users i) q = z})).mp
      (score_level_measureReal_eq_zero_of_noProfitableNonnegativeDeviation_and_ae_equilibrium_payoff
        (i0 := i) hno hae_payoff
        (by
          filter_upwards [MeasureTheory.Measure.support_mem_ae] with q hq
          exact hsupport_nonnegative hq)
        husers_nonnegative (husers_nonzero i) hperturb_cost z)

/--
Full source-Nash reconstruction from ordinary law-level equilibrium data on the
unbounded nonnegative content action space.  The separate focal-producer
equilibrium values may be supplied independently; symmetry is not hidden in
this conversion.  The nonzero-user and cost regularity assumptions are used
only to derive score-level nullness and hence the support-action upgrade.
-/
theorem sourceSymmetricMixedNash_of_law_equilibrium_of_nonzero_users
    {D N P : ℕ} [Nontrivial (Fin P)] {users : Fin N → Content D}
    {cost : Content D → ℝ} {μ : MixedContentStrategy D}
    (hprobability : MeasureTheory.IsProbabilityMeasure μ)
    (hsupport_nonnegative : μ.support ⊆ {q : Content D | NonnegativeContent q})
    (hlaw_equilibrium : ∀ j : Fin P, ∃ equilibriumPayoff : ℝ,
      SourceSymmetricMixedNoProfitableNonnegativeDeviation
        users cost j μ equilibriumPayoff ∧
      ∀ᵐ q ∂μ,
        SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost q μ =
          equilibriumPayoff)
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hperturb_cost : PerturbationCostContinuous cost)
    (hcost : Continuous cost) :
    SourceSymmetricMixedNash (P := P) users cost μ := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hprobability
  refine ⟨hprobability, hsupport_nonnegative, ?_⟩
  intro j p hp q hq
  obtain ⟨equilibriumPayoff, hno, hae_payoff⟩ := hlaw_equilibrium j
  calc
    SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost q μ ≤
        equilibriumPayoff := hno q hq
    _ = SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ :=
      (sourceMixedPurePayoff_eq_equilibriumPayoff_of_mem_support_of_law_equilibrium_of_nonzero_users
        hsupport_nonnegative hno hae_payoff husers_nonnegative husers_nonzero hperturb_cost
        hcost hp).symm

/--
The compact diagonal mixed equilibrium used in the corrected Reny route
already induces a symmetric mixed Nash equilibrium of the full source game.
The doubled compact radius controls deviations within the action set directly;
outside it, the source payoff is negative while the zero action supplies a
nonnegative compact deviation.  The compact a.e. indifference identity is
transported through the subtype push-forward and then upgraded to the source's
support-action equilibrium convention by score-level atomlessness.
-/
theorem sourceSymmetricMixedNash_of_truncatedMixedExtension_diagonalNash_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D} {β : ℝ}
    {state : ProbabilityMeasure
      (sourceTruncatedActionSet ν (2 * ((N : ℝ) ^ β⁻¹)))}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν)
    (hνcont : Continuous ν.norm)
    (hνperturb : SourceNormPerturbationContinuous ν)
    (hβ : 1 ≤ β)
    (hdiagonal : ∀ j : Fin P,
      AppliedModelingLib.IsDiagonalNash
        (AppliedModelingLib.MixedExtensionPayoff
          (SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
            (normRpowCost ν β))) state) :
    SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
      (sourceTruncatedStrategyToMixedContent ν (2 * ((N : ℝ) ^ β⁻¹)) state).toMeasure := by
  let R : ℝ := 2 * ((N : ℝ) ^ β⁻¹)
  let μ : MixedContentStrategy D :=
    (sourceTruncatedStrategyToMixedContent ν R state).toMeasure
  let equilibriumPayoff : Fin P → ℝ := fun j =>
    AppliedModelingLib.MixedExtensionPayoff
      (SourceTruncatedMixedPurePayoff users ν R j (normRpowCost ν β)) state state
  have hβpos : 0 < β := lt_of_lt_of_le zero_lt_one hβ
  have hβnonneg : 0 ≤ β := zero_le_one.trans hβ
  have hcost : Continuous (normRpowCost ν β) :=
    continuous_normRpowCost_of_continuous_norm ν hβnonneg hνcont
  have hperturb_cost : PerturbationCostContinuous (normRpowCost ν β) :=
    perturbationCostContinuous_normRpowCost ν hβnonneg hνperturb
  have hprobability : MeasureTheory.IsProbabilityMeasure μ := by
    dsimp [μ]
    infer_instance
  letI : MeasureTheory.IsProbabilityMeasure μ := hprobability
  have hclosed : IsClosed (sourceTruncatedActionSet ν R) :=
    (isCompact_sourceTruncatedActionSet_of_compactSublevels ν R hcompact).isClosed
  have hae_action : ∀ᵐ p ∂μ, p ∈ sourceTruncatedActionSet ν R := by
    dsimp [μ]
    unfold sourceTruncatedStrategyToMixedContent
    rw [ProbabilityMeasure.toMeasure_map]
    apply (MeasureTheory.ae_map_iff continuous_subtype_val.measurable.aemeasurable
      hclosed.measurableSet).mpr
    exact Filter.Eventually.of_forall fun action => action.2
  have hsupport_action : μ.support ⊆ sourceTruncatedActionSet ν R :=
    Measure.support_subset_of_isClosed hclosed hae_action
  have hsupport_nonnegative : μ.support ⊆ {p : Content D | NonnegativeContent p} := by
    intro p hp
    exact (hsupport_action hp).1
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hcap_pos : 0 < (N : ℝ) ^ β⁻¹ :=
    Real.rpow_pos_of_pos hN_pos _
  have hzero_mem : (0 : Content D) ∈ sourceTruncatedActionSet ν R := by
    refine ⟨zeroContent_nonnegative, ?_⟩
    rw [SourceNorm.norm_zero]
    dsimp [R]
    positivity
  have hlaw_equilibrium : ∀ j : Fin P, ∃ value : ℝ,
      SourceSymmetricMixedNoProfitableNonnegativeDeviation
        users (normRpowCost ν β) j μ value ∧
      ∀ᵐ p ∂μ,
        SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
          (normRpowCost ν β) p μ = value := by
    intro j
    refine ⟨equilibriumPayoff j, ?_, ?_⟩
    · intro q hq_nonnegative
      by_cases hq_mem : ν.norm q ≤ R
      · let action : sourceTruncatedActionSet ν R := ⟨q, hq_nonnegative, hq_mem⟩
        have hcompact_bound :=
          sourceTruncatedMixedExtension_purePayoff_le_of_diagonalNash_normRpowCost
            (N := N) (users := users) (ν := ν) (β := β) hνcont hβnonneg
            (hdiagonal j) action
        simpa [action, μ, R, equilibriumPayoff,
          SourceTruncatedMixedPurePayoff, SourceMixedPurePayoffOnProbabilityMeasure] using
          hcompact_bound
      · have hdouble_cap_lt : R < ν.norm q := lt_of_not_ge hq_mem
        have hcap_lt_double : (N : ℝ) ^ β⁻¹ < R := by
          dsimp [R]
          nlinarith
        have hcap_lt : (N : ℝ) ^ β⁻¹ < ν.norm q :=
          hcap_lt_double.trans hdouble_cap_lt
        have hq_negative :
            SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
                (normRpowCost ν β) q μ < 0 :=
          sourceMixedPurePayoff_lt_zero_of_support_cap_lt_normRpowCost
            (users := users) (j := j) (μ := μ) ν hβpos hcap_lt
        have hzero_nonnegative :
            0 ≤ SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
                (normRpowCost ν β) (0 : Content D) μ :=
          sourceMixedPurePayoff_zero_nonneg_of_normRpowCost
            (users := users) (j := j) (μ := μ) ν hβpos
        let zeroAction : sourceTruncatedActionSet ν R := ⟨0, hzero_mem⟩
        have hzero_bound :=
          sourceTruncatedMixedExtension_purePayoff_le_of_diagonalNash_normRpowCost
            (N := N) (users := users) (ν := ν) (β := β) hνcont hβnonneg
            (hdiagonal j) zeroAction
        have hzero_le :
            SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
                (normRpowCost ν β) (0 : Content D) μ ≤ equilibriumPayoff j := by
          simpa [zeroAction, μ, R, equilibriumPayoff,
            SourceTruncatedMixedPurePayoff, SourceMixedPurePayoffOnProbabilityMeasure] using
            hzero_bound
        exact hq_negative.le.trans (hzero_nonnegative.trans hzero_le)
    · have hcompact_ae :=
        ae_sourceTruncatedMixedExtension_purePayoff_eq_of_diagonalNash_normRpowCost
          (N := N) (users := users) (ν := ν) (β := β) hcompact hνcont hβnonneg
          (hdiagonal j)
      have hmeas : MeasurableSet {p : Content D |
          SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
              (normRpowCost ν β) p μ = equilibriumPayoff j} := by
        change MeasurableSet
          ((fun p : Content D =>
            SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
              (normRpowCost ν β) p μ) ⁻¹' ({equilibriumPayoff j} : Set ℝ))
        apply MeasurableSet.preimage measurableSet_eq
        exact stronglyMeasurable_iff_measurable.mp
          (stronglyMeasurable_sourceMixedPurePayoff users j (normRpowCost ν β) hcost μ)
      dsimp [μ]
      unfold sourceTruncatedStrategyToMixedContent
      rw [ProbabilityMeasure.toMeasure_map]
      apply (MeasureTheory.ae_map_iff continuous_subtype_val.measurable.aemeasurable
        hmeas).mpr
      simpa [R, equilibriumPayoff, SourceTruncatedMixedPurePayoff,
        SourceMixedPurePayoffOnProbabilityMeasure, sourceTruncatedStrategyToMixedContent,
        ProbabilityMeasure.toMeasure_map] using hcompact_ae
  change SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ
  exact sourceSymmetricMixedNash_of_law_equilibrium_of_nonzero_users
    hprobability hsupport_nonnegative hlaw_equilibrium husers_nonnegative husers_nonzero
    hperturb_cost hcost

/--
Source-level existence conclusion for the non-empirical conditions of
Proposition `existence`.  The constructed law is first a compact truncated
mixed-extension diagonal Nash state from the proved KKM argument, then is
transported to the source's symmetric mixed Nash convention.
-/
theorem exists_sourceSymmetricMixedNash_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D} {β : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν)
    (hνcont : Continuous ν.norm)
    (hνperturb : SourceNormPerturbationContinuous ν)
    (hβ : 1 ≤ β) :
    ∃ μ : MixedContentStrategy D,
      SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ := by
  have hβ_nonnegative : 0 ≤ β := zero_le_one.trans hβ
  have hβ_positive : 0 < β := lt_of_lt_of_le zero_lt_one hβ
  obtain ⟨state, hdiagonal⟩ :=
    exists_diagonalNash_sourceTruncatedMixedExtension_normRpowCost
      (N := N) (P := P)
      husers_nonnegative husers_nonzero hcompact
      (perturbationCostContinuous_normRpowCost ν hβ_nonnegative hνperturb)
      hνcont hβ_positive
  refine ⟨sourceTruncatedStrategyToMixedContent ν (2 * ((N : ℝ) ^ β⁻¹)) state |>.toMeasure, ?_⟩
  exact sourceSymmetricMixedNash_of_truncatedMixedExtension_diagonalNash_normRpowCost
    husers_nonnegative husers_nonzero hcompact hνcont hνperturb hβ hdiagonal

/--
Proper source-norm sublevels give an attained nonnegative unit direction
maximizing a nonzero nonnegative user's score over the nonnegative unit ball.
This supplies the dual-attainment component used explicitly in the corrected
finite Corollary `beta` route.
-/
theorem exists_nonnegative_unit_score_maximizer_of_compactSublevels
    {D : ℕ} (ν : SourceNorm D) {u : Content D}
    (hu_nonnegative : NonnegativeContent u) (hu_nonzero : NonzeroContent u)
    (hcompact : SourceNormCompactSublevels ν) :
    ∃ p : Content D, NonnegativeContent p ∧ ν.norm p = 1 ∧
      0 < score u p ∧
      ∀ q : Content D, NonnegativeContent q → ν.norm q ≤ 1 →
        score u q ≤ score u p := by
  let K : Set (Content D) := sourceTruncatedActionSet ν 1
  have hK_compact : IsCompact K := by
    simpa [K] using
      (isCompact_sourceTruncatedActionSet_of_compactSublevels ν 1 hcompact)
  let p0 : Content D := SourceNorm.normalizedContent ν u
  have hp0_mem : p0 ∈ K := by
    dsimp [K, p0, sourceTruncatedActionSet]
    refine ⟨SourceNorm.normalizedContent_nonnegative ν hu_nonnegative, ?_⟩
    exact (SourceNorm.norm_normalizedContent_eq_one ν hu_nonzero).le
  have hp0_score_pos : 0 < score u p0 := by
    dsimp [p0]
    apply SourceNorm.score_normalizedContent_pos_of_score_pos ν u hu_nonzero
    exact score_self_pos_of_nonnegative_nonzero hu_nonnegative hu_nonzero
  obtain ⟨p, hp_mem, hp_max⟩ := hK_compact.exists_isMaxOn
    ⟨p0, hp0_mem⟩ (continuous_score_right u).continuousOn
  have hp_nonnegative : NonnegativeContent p := by
    simpa [K, sourceTruncatedActionSet] using hp_mem.1
  have hp_norm_le_one : ν.norm p ≤ 1 := by
    simpa [K, sourceTruncatedActionSet] using hp_mem.2
  have hp_score_pos : 0 < score u p :=
    lt_of_lt_of_le hp0_score_pos (hp_max hp0_mem)
  have hp_nonzero : NonzeroContent p := by
    by_contra hnot
    have hp_zero : p = 0 := content_eq_zero_of_not_nonzeroContent hnot
    rw [hp_zero, score_zero_right] at hp_score_pos
    exact (lt_irrefl (0 : ℝ)) hp_score_pos
  let d : Content D := SourceNorm.normalizedContent ν p
  have hd_nonnegative : NonnegativeContent d := by
    dsimp [d]
    exact SourceNorm.normalizedContent_nonnegative ν hp_nonnegative
  have hd_norm : ν.norm d = 1 := by
    dsimp [d]
    exact SourceNorm.norm_normalizedContent_eq_one ν hp_nonzero
  have hd_mem : d ∈ K := by
    dsimp [K, sourceTruncatedActionSet]
    exact ⟨hd_nonnegative, hd_norm.le⟩
  have hscore_d_nonnegative : 0 ≤ score u d :=
    score_nonneg_of_nonnegative hu_nonnegative hd_nonnegative
  have hp_le_d : score u p ≤ score u d := by
    calc
      score u p = ν.norm p * score u d := by
        dsimp [d]
        exact SourceNorm.score_eq_norm_mul_score_normalizedContent ν u hp_nonzero
      _ ≤ 1 * score u d :=
        mul_le_mul_of_nonneg_right hp_norm_le_one hscore_d_nonnegative
      _ = score u d := one_mul _
  have hd_le_p : score u d ≤ score u p := hp_max hd_mem
  have hscore_eq : score u p = score u d := le_antisymm hp_le_d hd_le_p
  have hd_score_pos : 0 < score u d := lt_of_lt_of_le hp_score_pos hp_le_d
  have hnorm_eq : ν.norm p = 1 := by
    have hmul_eq : ν.norm p * score u d = score u d := by
      rw [← SourceNorm.score_eq_norm_mul_score_normalizedContent ν u hp_nonzero]
      exact hscore_eq
    nlinarith
  refine ⟨p, hp_nonnegative, hnorm_eq, hp_score_pos, ?_⟩
  intro q hq_nonnegative hq_norm_le_one
  exact hp_max (by
    dsimp [K, sourceTruncatedActionSet]
    exact ⟨hq_nonnegative, hq_norm_le_one⟩)

/--
Compact source-norm sublevels also attain a positive aggregate score bound on
the nonnegative unit ball.  The bound is written as the actual finite sum of
user scores, matching the `Z` comparison in Corollary `beta`.
-/
theorem exists_aggregate_score_bound_of_compactSublevels
    {D N : ℕ} [Nonempty (Fin N)] (ν : SourceNorm D)
    {users : Fin N → Content D}
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (husers_nonzero : ∀ i, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν) :
    ∃ Z : ℝ, 0 < Z ∧
      ∀ q : Content D, NonnegativeContent q → ν.norm q ≤ 1 →
        (∑ i : Fin N, score (users i) q) ≤ Z := by
  let aggregate : Content D := aggregateUsersContent users
  have haggregate_nonnegative : NonnegativeContent aggregate := by
    dsimp [aggregate]
    exact aggregateUsersContent_nonnegative husers_nonnegative
  have haggregate_score : ∀ i : Fin N, 0 < score (users i) aggregate := by
    intro i
    dsimp [aggregate]
    exact score_aggregateUsersContent_pos husers_nonnegative husers_nonzero i
  have haggregate_nonzero : NonzeroContent aggregate :=
    nonzeroContent_of_positive_score haggregate_score
  obtain ⟨p, hp_nonnegative, hp_norm, hp_score, hp_max⟩ :=
    exists_nonnegative_unit_score_maximizer_of_compactSublevels
      ν haggregate_nonnegative haggregate_nonzero hcompact
  refine ⟨score aggregate p, hp_score, ?_⟩
  intro q hq_nonnegative hq_norm_le_one
  rw [← score_aggregateUsersContent_eq_sum_scores users q]
  simpa [aggregate] using hp_max q hq_nonnegative hq_norm_le_one

/--
Attained form of the aggregate score bound: the reported `Z` is the total
score of a maximizing nonnegative unit direction, not merely any upper bound.
-/
theorem exists_aggregate_score_maximizer_of_compactSublevels
    {D N : ℕ} [Nonempty (Fin N)] (ν : SourceNorm D)
    {users : Fin N → Content D}
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (husers_nonzero : ∀ i, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν) :
    ∃ Z : ℝ, ∃ p : Content D, 0 < Z ∧ NonnegativeContent p ∧ ν.norm p = 1 ∧
      Z = ∑ i : Fin N, score (users i) p ∧
      ∀ q : Content D, NonnegativeContent q → ν.norm q ≤ 1 →
        (∑ i : Fin N, score (users i) q) ≤ Z := by
  let aggregate : Content D := aggregateUsersContent users
  have haggregate_nonnegative : NonnegativeContent aggregate := by
    dsimp [aggregate]
    exact aggregateUsersContent_nonnegative husers_nonnegative
  have haggregate_score : ∀ i : Fin N, 0 < score (users i) aggregate := by
    intro i
    dsimp [aggregate]
    exact score_aggregateUsersContent_pos husers_nonnegative husers_nonzero i
  have haggregate_nonzero : NonzeroContent aggregate :=
    nonzeroContent_of_positive_score haggregate_score
  obtain ⟨p, hp_nonnegative, hp_norm, hp_score, hp_max⟩ :=
    exists_nonnegative_unit_score_maximizer_of_compactSublevels
      ν haggregate_nonnegative haggregate_nonzero hcompact
  refine ⟨score aggregate p, p, hp_score, hp_nonnegative, hp_norm, ?_, ?_⟩
  · exact score_aggregateUsersContent_eq_sum_scores users p
  · intro q hq_nonnegative hq_norm_le_one
    rw [← score_aggregateUsersContent_eq_sum_scores users q]
    exact hp_max q hq_nonnegative hq_norm_le_one

/--
The source proof's WLOG score normalization can be made explicit for a finite
nonzero nonnegative population.  Compact sublevels give each user's attained
positive dual score; rescaling the user by its reciprocal yields an own-score
one unit witness, and the normalized population has an attained aggregate
score bound on the same nonnegative unit ball.
-/
theorem exists_scoreNormalizedUsers_dualWitnesses_and_aggregateBound_of_compactSublevels
    {D N : ℕ} [Nonempty (Fin N)] (ν : SourceNorm D)
    {users : Fin N → Content D}
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (husers_nonzero : ∀ i, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν) :
    ∃ normalizedUsers : Fin N → Content D, ∃ Z : ℝ,
      (∀ i, NonnegativeContent (normalizedUsers i)) ∧
      (∀ i, NonzeroContent (normalizedUsers i)) ∧
      (∀ i, ∃ p : Content D, NonnegativeContent p ∧ ν.norm p = 1 ∧
        score (normalizedUsers i) p = 1 ∧
        ∀ q : Content D, NonnegativeContent q → ν.norm q ≤ 1 →
          score (normalizedUsers i) q ≤ score (normalizedUsers i) p) ∧
      0 < Z ∧ 1 ≤ Z ∧ Z ≤ (N : ℝ) ∧
      (∀ q : Content D, NonnegativeContent q → ν.norm q ≤ 1 →
        (∑ i : Fin N, score (normalizedUsers i) q) ≤ Z) := by
  have hmaximizers : ∀ i : Fin N, ∃ p : Content D,
      NonnegativeContent p ∧ ν.norm p = 1 ∧ 0 < score (users i) p ∧
      ∀ q : Content D, NonnegativeContent q → ν.norm q ≤ 1 →
        score (users i) q ≤ score (users i) p := by
    intro i
    exact exists_nonnegative_unit_score_maximizer_of_compactSublevels ν
      (husers_nonnegative i) (husers_nonzero i) hcompact
  choose p hp using hmaximizers
  let normalizedUsers : Fin N → Content D :=
    fun i => scaleContent (score (users i) (p i))⁻¹ (users i)
  have hnormalized_nonnegative : ∀ i, NonnegativeContent (normalizedUsers i) := by
    intro i
    dsimp [normalizedUsers]
    exact scaleContent_nonnegative
      (inv_nonneg.mpr (le_of_lt (hp i).2.2.1)) (husers_nonnegative i)
  have hnormalized_own_score : ∀ i, score (normalizedUsers i) (p i) = 1 := by
    intro i
    dsimp [normalizedUsers]
    rw [score_scaleUser, inv_mul_cancel₀ (ne_of_gt (hp i).2.2.1)]
  have hnormalized_nonzero : ∀ i, NonzeroContent (normalizedUsers i) := by
    intro i
    by_contra hnot
    have hzero : normalizedUsers i = 0 :=
      content_eq_zero_of_not_nonzeroContent hnot
    have hone := hnormalized_own_score i
    rw [hzero, score_zero_left] at hone
    norm_num at hone
  have hdual_witness : ∀ i, ∃ p' : Content D,
      NonnegativeContent p' ∧ ν.norm p' = 1 ∧
        score (normalizedUsers i) p' = 1 ∧
        ∀ q : Content D, NonnegativeContent q → ν.norm q ≤ 1 →
          score (normalizedUsers i) q ≤ score (normalizedUsers i) p' := by
    intro i
    refine ⟨p i, (hp i).1, (hp i).2.1, hnormalized_own_score i, ?_⟩
    intro q hq_nonnegative hq_norm_le_one
    calc
      score (normalizedUsers i) q =
          (score (users i) (p i))⁻¹ * score (users i) q := by
        dsimp [normalizedUsers]
        rw [score_scaleUser]
      _ ≤
          (score (users i) (p i))⁻¹ * score (users i) (p i) :=
        mul_le_mul_of_nonneg_left
          ((hp i).2.2.2 q hq_nonnegative hq_norm_le_one)
          (inv_nonneg.mpr (le_of_lt (hp i).2.2.1))
      _ = 1 := inv_mul_cancel₀ (ne_of_gt (hp i).2.2.1)
      _ = score (normalizedUsers i) (p i) :=
        (hnormalized_own_score i).symm
  obtain ⟨Z, zMax, hZ_pos, hzMax_nonnegative, hzMax_norm,
    hZ_eq, haggregate_bound⟩ :=
    exists_aggregate_score_maximizer_of_compactSublevels ν
      hnormalized_nonnegative hnormalized_nonzero hcompact
  let i0 : Fin N := Classical.choice (inferInstance : Nonempty (Fin N))
  have hZ_one_le : 1 ≤ Z := by
    obtain ⟨p0, hp0_nonnegative, hp0_norm, hp0_score, _⟩ :=
      hdual_witness i0
    calc
      1 = score (normalizedUsers i0) p0 := hp0_score.symm
      _ ≤ ∑ i : Fin N, score (normalizedUsers i) p0 :=
        Finset.single_le_sum
          (fun i _hi =>
            score_nonneg_of_nonnegative (hnormalized_nonnegative i)
              hp0_nonnegative)
          (Finset.mem_univ i0)
      _ ≤ Z := haggregate_bound p0 hp0_nonnegative hp0_norm.le
  have hZ_le_card : Z ≤ (N : ℝ) := by
    rw [hZ_eq]
    calc
      (∑ i : Fin N, score (normalizedUsers i) zMax) ≤
          ∑ _i : Fin N, (1 : ℝ) := by
        refine Finset.sum_le_sum ?_
        intro i _hi
        obtain ⟨pi, hpi_nonnegative, hpi_norm, hpi_score, hpi_max⟩ :=
          hdual_witness i
        exact (hpi_max zMax hzMax_nonnegative hzMax_norm.le).trans_eq hpi_score
      _ = (N : ℝ) := by simp
  exact ⟨normalizedUsers, Z, hnormalized_nonnegative, hnormalized_nonzero,
    hdual_witness, hZ_pos, hZ_one_le, hZ_le_card, haggregate_bound⟩

/-- The coordinatewise powered score row is continuous for nonnegative power. -/
theorem continuous_poweredScoreRow {D N : ℕ}
    (users : Fin N → Content D) {β : ℝ} (hβ : 0 ≤ β) :
    Continuous (fun p : Content D =>
      fun i => (score (users i) p) ^ β) := by
  apply continuous_pi
  intro i
  exact (Real.continuous_rpow_const hβ).comp
    (continuous_score_right (users i))

/--
Under compact source-norm sublevels, the powered score image of the
nonnegative source unit ball is compact.  This makes the source-side `max` in
Theorem `singlegenre` an attained maximum under an explicit properness
assumption; no compactness of its convex hull is asserted here.
-/
theorem isCompact_inPoweredUnitImage_of_compactSublevels
    {D N : ℕ} (users : Fin N → Content D) (ν : SourceNorm D)
    {β : ℝ} (hcompact : SourceNormCompactSublevels ν) (hβ : 0 ≤ β) :
    IsCompact {y : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y} := by
  let K : Set (Content D) := sourceTruncatedActionSet ν 1
  let f : Content D → Fin N → ℝ := fun p i => (score (users i) p) ^ β
  have hK : IsCompact K := by
    simpa [K] using
      (isCompact_sourceTruncatedActionSet_of_compactSublevels ν 1 hcompact)
  have hf : Continuous f := by
    simpa [f] using continuous_poweredScoreRow users hβ
  have hset : {y : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y} = f '' K := by
    ext y
    constructor
    · rintro ⟨base, ⟨p, hp, hbase⟩, hy⟩
      refine ⟨p, hp, ?_⟩
      ext i
      rw [hy, hbase]
    · rintro ⟨p, hp, rfl⟩
      refine ⟨fun i => score (users i) p, ⟨p, hp, rfl⟩, rfl⟩
  rw [hset]
  exact hK.image hf

/--
The compact powered source image has an attained coordinate-product maximizer.
This is the source-side attainment input for the corrected generic
single-genre route; convex-hull attainment is a distinct finite-dimensional
step.
-/
theorem exists_coordinateProductMaximizer_inPoweredUnitImage_of_compactSublevels
    {D N : ℕ} (users : Fin N → Content D) (ν : SourceNorm D)
    {β : ℝ} (hcompact : SourceNormCompactSublevels ν) (hβ : 0 ≤ β) :
    ∃ y : Fin N → ℝ,
      IsCoordinateProductMaximizer
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z} y := by
  let S : Set (Fin N → ℝ) := {z |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z}
  have hScompact : IsCompact S := by
    simpa [S] using
      isCompact_inPoweredUnitImage_of_compactSublevels users ν hcompact hβ
  have hzero : (0 : Content D) ∈ sourceTruncatedActionSet ν 1 := by
    exact ⟨fun _ => le_rfl, by simp [SourceNorm.norm_zero]⟩
  have hSnonempty : S.Nonempty := by
    refine ⟨fun i => (score (users i) (0 : Content D)) ^ β, ?_⟩
    refine ⟨fun i => score (users i) (0 : Content D), ?_, rfl⟩
    exact ⟨0, hzero, rfl⟩
  have hcoordinateProduct : Continuous (coordinateProduct : (Fin N → ℝ) → ℝ) := by
    unfold coordinateProduct
    exact continuous_finset_prod Finset.univ fun i _ => continuous_apply i
  obtain ⟨y, hyS, hymax⟩ := hScompact.exists_isMaxOn hSnonempty
    hcoordinateProduct.continuousOn
  exact ⟨y, hyS, hymax⟩

/--
Nonnegative user and content vectors give nonnegative coordinates throughout
the convex hull of the powered source image.  This is the zero-safe domain
fact used by the single-genre product objective.
-/
theorem nonnegative_coordinate_convexHull_inPoweredUnitImage_of_nonnegative
    {D N : ℕ} {users : Fin N → Content D} {ν : SourceNorm D} {β : ℝ}
    (husers : ∀ i : Fin N, NonnegativeContent (users i)) (hβ : 0 ≤ β) :
    ∀ z ∈ convexHull ℝ {y : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y},
      ∀ i : Fin N, 0 ≤ z i := by
  intro z hz i
  apply (convexHull_min ?_ ?_) hz
  · intro y hy
    rcases hy with ⟨base, ⟨p, hp, hbase⟩, hy_eq⟩
    rw [hy_eq, hbase]
    exact Real.rpow_nonneg
      (score_nonneg_of_nonnegative (husers i) hp.1) β
  · intro x hx y hy a b ha hb hab
    change 0 ≤ a * x i + b * y i
    exact add_nonneg (mul_nonneg ha hx) (mul_nonneg hb hy)

/--
Lowering the exponent of a powered nonnegative source image has a convex-hull
companion that dominates the corresponding coordinatewise power.  This is the
convexity step behind the threshold-monotonicity clause of Theorem
`singlegenre`.
-/
theorem exists_convexHull_inPoweredUnitImage_dominating_rpow_of_le_exponent
    {D N : ℕ} {users : Fin N → Content D} {ν : SourceNorm D}
    {β β' : ℝ} (hβ : 0 < β) (hβ_le : β ≤ β')
    (husers : ∀ i : Fin N, NonnegativeContent (users i)) :
    ∀ x ∈ convexHull ℝ {y : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y},
      ∃ z ∈ convexHull ℝ {y : Fin N → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β' y},
        ∀ i, x i ^ (β' / β) ≤ z i := by
  apply AppliedModelingLib.Optimization.exists_mem_convexHull_coordinatewise_rpow_le
  · calc
      1 = β / β := (div_self (ne_of_gt hβ)).symm
      _ ≤ β' / β := div_le_div_of_nonneg_right hβ_le hβ.le
  · intro x hx i
    rcases hx with ⟨base, ⟨p, hp, hbase⟩, hx_eq⟩
    rw [hx_eq, hbase]
    exact Real.rpow_nonneg
      (score_nonneg_of_nonnegative (husers i) hp.1) β
  · intro x hx
    rcases hx with ⟨base, ⟨p, hp, hbase⟩, hx_eq⟩
    refine ⟨fun i => base i ^ β', ?_, ?_⟩
    · refine ⟨base, ⟨p, hp, hbase⟩, rfl⟩
    · intro i
      rw [hx_eq, hbase]
      have hscore : 0 ≤ score (users i) p :=
        score_nonneg_of_nonnegative (husers i) hp.1
      have hscale : β * (β' / β) = β' := by
        field_simp [ne_of_gt hβ]
      rw [← Real.rpow_mul hscore, hscale]

/--
A coordinate-product maximizer of a nonnegative powered source image remains
a maximizer when the exponent is increased.  The companion row is generated
by the same feasible content vector.  This separates the source-side part of
the single-genre threshold monotonicity argument from its convex-hull part.
-/
theorem exists_coordinateProductMaximizer_inPoweredUnitImage_of_le_exponent
    {D N : ℕ} {users : Fin N → Content D} {ν : SourceNorm D}
    {β β' : ℝ} (hβ : 0 < β) (hβ_le : β ≤ β')
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    {x : Fin N → ℝ}
    (hx : IsCoordinateProductMaximizer
      {y : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y} x) :
    ∃ x' : Fin N → ℝ,
      IsCoordinateProductMaximizer
        {y : Fin N → ℝ | InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β' y} x' ∧
      ∀ i, x' i = x i ^ (β' / β) := by
  rcases hx.1 with ⟨base, ⟨p, hp, hbase⟩, hx_eq⟩
  let x' : Fin N → ℝ := fun i => base i ^ β'
  have hbase_nonnegative : ∀ i, 0 ≤ base i := by
    intro i
    rw [hbase]
    exact score_nonneg_of_nonnegative (husers i) hp.1
  have hx'_mem : x' ∈ {y : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β' y} := by
    refine ⟨base, ⟨p, hp, hbase⟩, rfl⟩
  refine ⟨x', ⟨hx'_mem, ?_⟩, ?_⟩
  · intro z hz
    rcases hz with ⟨basez, ⟨q, hq, hbasez⟩, hz_eq⟩
    have hbasez_nonnegative : ∀ i, 0 ≤ basez i := by
      intro i
      rw [hbasez]
      exact score_nonneg_of_nonnegative (husers i) hq.1
    let zβ : Fin N → ℝ := fun i => basez i ^ β
    have hzβ_mem : zβ ∈ {y : Fin N → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y} := by
      refine ⟨basez, ⟨q, hq, hbasez⟩, rfl⟩
    have hmaxβ : coordinateProduct zβ ≤ coordinateProduct x := hx.2 zβ hzβ_mem
    have hbase_product_nonnegative : 0 ≤ coordinateProduct base := by
      unfold coordinateProduct
      exact Finset.prod_nonneg fun i _ => hbase_nonnegative i
    have hbasez_product_nonnegative : 0 ≤ coordinateProduct basez := by
      unfold coordinateProduct
      exact Finset.prod_nonneg fun i _ => hbasez_nonnegative i
    have hbase_product_le : coordinateProduct basez ≤ coordinateProduct base := by
      rw [coordinateProduct_rpow basez β hbasez_nonnegative,
        hx_eq, coordinateProduct_rpow base β hbase_nonnegative] at hmaxβ
      exact (Real.rpow_le_rpow_iff hbasez_product_nonnegative
        hbase_product_nonnegative hβ).mp hmaxβ
    rw [hz_eq, show x' = fun i => base i ^ β' by rfl,
      coordinateProduct_rpow basez β' hbasez_nonnegative,
      coordinateProduct_rpow base β' hbase_nonnegative]
    exact Real.rpow_le_rpow hbasez_product_nonnegative hbase_product_le
      (hβ.trans_le hβ_le).le
  · intro i
    change base i ^ β' = x i ^ (β' / β)
    have hscale : β * (β' / β) = β' := by
      field_simp [ne_of_gt hβ]
    rw [hx_eq]
    calc
      base i ^ β' = base i ^ (β * (β' / β)) := by rw [hscale]
      _ = (base i ^ β) ^ (β' / β) :=
        Real.rpow_mul (hbase_nonnegative i) β (β' / β)

/--
The coordinate-product objective is bounded above on the convex hull of a
compact powered source image.  A compact source image supplies one upper bound
for each coordinate; convexity preserves those coordinate bounds, and
nonnegativity makes their product an upper bound.  No compactness or
attainment assumption for the convex hull is used.
-/
theorem bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
    {D N : ℕ} {users : Fin N → Content D} {ν : SourceNorm D} {β : ℝ}
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hcompact : SourceNormCompactSublevels ν) (hβ : 0 ≤ β) :
    BddAbove (coordinateProduct '' convexHull ℝ {y : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y}) := by
  let S : Set (Fin N → ℝ) := {y |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y}
  have hScompact : IsCompact S := by
    simpa [S] using
      isCompact_inPoweredUnitImage_of_compactSublevels users ν hcompact hβ
  have hzero : (0 : Content D) ∈ sourceTruncatedActionSet ν 1 := by
    exact ⟨fun _ => le_rfl, by simp [SourceNorm.norm_zero]⟩
  have hSnonempty : S.Nonempty := by
    refine ⟨fun i => (score (users i) (0 : Content D)) ^ β, ?_⟩
    refine ⟨fun i => score (users i) (0 : Content D), ?_, rfl⟩
    exact ⟨0, hzero, rfl⟩
  have hcoordinate_max : ∀ i : Fin N, ∃ y ∈ S,
      ∀ z ∈ S, z i ≤ y i := by
    intro i
    obtain ⟨y, hyS, hymax⟩ := hScompact.exists_isMaxOn hSnonempty
      (continuous_apply i).continuousOn
    exact ⟨y, hyS, hymax⟩
  choose upper hupperS hupper_max using hcoordinate_max
  have hupper_hull : ∀ i : Fin N, ∀ z ∈ convexHull ℝ S,
      z i ≤ upper i i := by
    intro i z hz
    apply (convexHull_min ?_ ?_) hz
    · intro y hy
      exact hupper_max i y hy
    · intro x hx y hy a b ha hb hab
      change a * x i + b * y i ≤ upper i i
      calc
        a * x i + b * y i ≤ a * upper i i + b * upper i i :=
          add_le_add (mul_le_mul_of_nonneg_left hx ha)
            (mul_le_mul_of_nonneg_left hy hb)
        _ = upper i i := by rw [← add_mul, hab, one_mul]
  have hnonnegative : ∀ z ∈ convexHull ℝ S, ∀ i : Fin N, 0 ≤ z i := by
    intro z hz i
    simpa [S] using
      nonnegative_coordinate_convexHull_inPoweredUnitImage_of_nonnegative
        (ν := ν) husers hβ z (by simpa [S] using hz) i
  refine ⟨coordinateProduct (fun i => upper i i), ?_⟩
  rintro value ⟨z, hz, rfl⟩
  unfold coordinateProduct
  apply Finset.prod_le_prod
  · intro i _
    exact hnonnegative z hz i
  · intro i _
    exact hupper_hull i z hz

/--
The product-supremum condition in Theorem `singlegenre` is monotone when the
power exponent is decreased.  More precisely, if the condition holds at
`β' >= β`, then it holds at `β`.  The proof uses compact source-norm sublevels
for source-image attainment and hull boundedness, and the reusable
coordinatewise convex-power transport for the exponent comparison.

The source proof has a duplicated, inconsistent inequality direction in this
paragraph; this theorem records its intended mathematically coherent
decreasing-exponent conclusion.
-/
theorem singleGenreProductSupCondition_inPoweredUnitImage_of_le_exponent_of_compactSublevels
    {D N : ℕ} {users : Fin N → Content D} {ν : SourceNorm D}
    {β β' : ℝ} (hβ : 0 < β) (hβ_le : β ≤ β')
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hcompact : SourceNormCompactSublevels ν)
    (hproduct' : SingleGenreProductSupCondition
      {y : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β' y}) :
    SingleGenreProductSupCondition
      {y : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y} := by
  let S : Set (Fin N → ℝ) := {y |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y}
  let S' : Set (Fin N → ℝ) := {y |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β' y}
  have hβ'_nonnegative : 0 ≤ β' := (hβ.trans_le hβ_le).le
  obtain ⟨x, hmaxS⟩ :=
    exists_coordinateProductMaximizer_inPoweredUnitImage_of_compactSublevels
      users ν hcompact hβ.le
  obtain ⟨x', hmaxS', hx'_power⟩ :=
    exists_coordinateProductMaximizer_inPoweredUnitImage_of_le_exponent
      hβ hβ_le husers hmaxS
  have hbounded' : BddAbove (coordinateProduct '' convexHull ℝ S') := by
    simpa [S'] using
      bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := ν) husers hcompact hβ'_nonnegative
  have hmaxHull' : IsCoordinateProductMaximizer (convexHull ℝ S') x' := by
    apply isCoordinateProductMaximizer_convexHull_of_productSupCondition_of_bddAbove
      (by simpa [S'] using hproduct') hmaxS' hbounded'
  have hnonnegativeHull : ∀ y ∈ convexHull ℝ S, ∀ i, 0 ≤ y i := by
    intro y hy i
    simpa [S] using
      nonnegative_coordinate_convexHull_inPoweredUnitImage_of_nonnegative
        (ν := ν) husers hβ.le y (by simpa [S] using hy) i
  have hx_nonnegative : ∀ i, 0 ≤ x i := by
    intro i
    exact hnonnegativeHull x (subset_convexHull ℝ S hmaxS.1) i
  have hratio : 1 ≤ β' / β := by
    calc
      1 = β / β := (div_self (ne_of_gt hβ)).symm
      _ ≤ β' / β := div_le_div_of_nonneg_right hβ_le hβ.le
  have hratio_positive : 0 < β' / β := lt_of_lt_of_le zero_lt_one hratio
  have hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) x := by
    refine ⟨subset_convexHull ℝ S hmaxS.1, ?_⟩
    intro y hy
    obtain ⟨z, hz, hyz⟩ :=
      exists_convexHull_inPoweredUnitImage_dominating_rpow_of_le_exponent
        hβ hβ_le husers y (by simpa [S] using hy)
    have hy_nonnegative : ∀ i, 0 ≤ y i := hnonnegativeHull y hy
    have hproduct_power : coordinateProduct y ^ (β' / β) ≤ coordinateProduct z := by
      rw [← coordinateProduct_rpow y (β' / β) hy_nonnegative]
      apply coordinateProduct_le_of_nonnegative_coordinatewise_le
      · intro i
        exact Real.rpow_nonneg (hy_nonnegative i) _
      · exact hyz
    have hproduct_z : coordinateProduct z ≤ coordinateProduct x' :=
      hmaxHull'.2 z (by simpa [S'] using hz)
    have hproduct_x' : coordinateProduct x' = coordinateProduct x ^ (β' / β) := by
      rw [show x' = fun i => x i ^ (β' / β) by
        ext i
        exact hx'_power i]
      exact coordinateProduct_rpow x (β' / β) hx_nonnegative
    apply (Real.rpow_le_rpow_iff
      (by
        unfold coordinateProduct
        exact Finset.prod_nonneg fun i _ => hy_nonnegative i)
      (by
        unfold coordinateProduct
        exact Finset.prod_nonneg fun i _ => hx_nonnegative i)
      hratio_positive).mp
    calc
      coordinateProduct y ^ (β' / β) ≤ coordinateProduct z := hproduct_power
      _ ≤ coordinateProduct x' := hproduct_z
      _ = coordinateProduct x ^ (β' / β) := hproduct_x'
  unfold SingleGenreProductSupCondition
  calc
    coordinateProductSup S = coordinateProduct x :=
      coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxS
    _ = coordinateProductSup (convexHull ℝ S) :=
      (coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxHull).symm

/--
Corrected compact-source form of Theorem `singlegenre`'s sufficient direction.
For nonnegative nonzero users, compact source-norm sublevels make the powered
source product maximum attained.  Equality with the convex-hull product
supremum then yields a positive source row satisfying the direction condition,
and hence the explicit source-Nash ray law.  Convex-hull compactness is not
assumed: boundedness of its product objective is proved from source-image
compactness.
-/
theorem exists_singleGenreContentLaw_sourceSymmetricMixedNash_of_productSupCondition_of_compactSublevels
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} (ν : SourceNorm D)
    (hβ : 0 < β) (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν)
    (hproduct : SingleGenreProductSupCondition
      {z : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z}) :
    ∃ p : Content D, NonnegativeContent p ∧ ν.norm p ≤ 1 ∧
      (∀ i : Fin N, 0 < score (users i) p) ∧
      SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
        (singleGenreContentLaw N P β (SourceNorm.normalizedContent ν p)) := by
  let S : Set (Fin N → ℝ) := {z |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z}
  have hβ_nonnegative : 0 ≤ β := hβ.le
  obtain ⟨x, hxS, hmaxS⟩ :=
    exists_coordinateProductMaximizer_inPoweredUnitImage_of_compactSublevels
      users ν hcompact hβ_nonnegative
  have hmaxSource : IsCoordinateProductMaximizer S x := by
    refine ⟨?_, ?_⟩
    · simpa [S] using hxS
    · intro z hz
      apply hmaxS z
      simpa [S] using hz
  obtain ⟨genre, hgenre_nonnegative, hgenre_norm, hgenre_score⟩ :=
    SourceNorm.exists_nonnegative_unit_direction_positive_score_of_nonnegative_nonzero_users
      ν husers husers_nonzero
  let positiveRow : Fin N → ℝ := fun i => (score (users i) genre) ^ β
  have hpositiveRowS : positiveRow ∈ S := by
    refine ⟨fun i => score (users i) genre, ?_, rfl⟩
    exact ⟨genre, ⟨hgenre_nonnegative, hgenre_norm.le⟩, rfl⟩
  have hpositiveRowProduct : 0 < coordinateProduct positiveRow := by
    unfold coordinateProduct positiveRow
    exact Finset.prod_pos fun i _ => Real.rpow_pos_of_pos (hgenre_score i) β
  have hxProductPositive : 0 < coordinateProduct x :=
    lt_of_lt_of_le hpositiveRowProduct
      (hmaxS positiveRow (by simpa [S] using hpositiveRowS))
  have hnonnegativeHull : ∀ z ∈ convexHull ℝ S, ∀ i : Fin N, 0 ≤ z i := by
    intro z hz i
    simpa [S] using
      nonnegative_coordinate_convexHull_inPoweredUnitImage_of_nonnegative
        (ν := ν) husers hβ_nonnegative z (by simpa [S] using hz) i
  have hbounded : BddAbove (coordinateProduct '' convexHull ℝ S) := by
    simpa [S] using
      bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := ν) husers hcompact hβ_nonnegative
  have hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) x := by
    apply isCoordinateProductMaximizer_convexHull_of_productSupCondition_of_bddAbove
      (by simpa [S] using hproduct) hmaxSource hbounded
  have hx_positive : ∀ i : Fin N, 0 < x i := by
    intro i
    have hxi_nonnegative : 0 ≤ x i :=
      hnonnegativeHull x (subset_convexHull ℝ S hxS) i
    have hxi_ne : x i ≠ 0 := by
      intro hxi_zero
      have hproduct_zero : coordinateProduct x = 0 := by
        unfold coordinateProduct
        exact Finset.prod_eq_zero (Finset.mem_univ i) hxi_zero
      rw [hproduct_zero] at hxProductPositive
      exact (lt_irrefl (0 : ℝ)) hxProductPositive
    exact lt_of_le_of_ne hxi_nonnegative (Ne.symm hxi_ne)
  have hconditionHull : SingleGenreDirectionCondition (convexHull ℝ S) x :=
    singleGenreDirectionCondition_of_convex_coordinateProductMaximizer_nonnegative
      (convex_convexHull ℝ S) hmaxHull hx_positive hnonnegativeHull
  have hconditionS : SingleGenreDirectionCondition S x := by
    intro z hz
    exact hconditionHull z (subset_convexHull ℝ S hz)
  rcases hxS with ⟨base, ⟨p, hp, hbase⟩, hx_eq⟩
  have hp_score : ∀ i : Fin N, 0 < score (users i) p := by
    intro i
    have hcoordinate_positive := hx_positive i
    rw [hx_eq, hbase] at hcoordinate_positive
    change 0 < (score (users i) p) ^ β at hcoordinate_positive
    have hscore_nonnegative : 0 ≤ score (users i) p :=
      score_nonneg_of_nonnegative (husers i) hp.1
    by_contra hnot
    have hscore_zero : score (users i) p = 0 :=
      le_antisymm (le_of_not_gt hnot) hscore_nonnegative
    have hcoordinate_zero : (score (users i) p) ^ β = 0 := by
      rw [hscore_zero, Real.zero_rpow (ne_of_gt hβ)]
    rw [hcoordinate_zero] at hcoordinate_positive
    exact (lt_irrefl (0 : ℝ)) hcoordinate_positive
  have hconditionP : SingleGenreDirectionCondition
      {z : Fin N → ℝ | InPoweredUnitImage users
        (fun q => NonnegativeContent q ∧ ν.norm q ≤ 1) β z}
      (fun i => (score (users i) p) ^ β) := by
    simpa [S, hx_eq, hbase] using hconditionS
  refine ⟨p, hp.1, hp.2, hp_score, ?_⟩
  exact singleGenreContentLaw_is_sourceSymmetricMixedNash_of_positive_ball_condition
    ν hβ husers hp.1 hp.2 hp_score hconditionP

/--
Corrected compact-source equivalence for the concrete ray-law interpretation
of Theorem `singlegenre`.  Compact source-norm sublevels supply the only
attainment and boundedness facts needed by the product-supremum direction;
the reverse direction is the already-checked ray-law necessity theorem.

The source's literal `Genre(mu) = {genre}` notation is not used here: the
left side is the explicit inverse-transform ray law, whose zero-support point
would otherwise make that literal support equality false.
-/
theorem exists_positive_ball_singleGenreContentLaw_sourceSymmetricMixedNash_iff_productSupCondition_of_compactSublevels
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} (ν : SourceNorm D)
    (hβ : 0 < β) (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν) :
    (∃ p : Content D, NonnegativeContent p ∧ ν.norm p ≤ 1 ∧
      (∀ i : Fin N, 0 < score (users i) p) ∧
      SourceSymmetricMixedNash (P := P) users (normRpowCost ν β)
        (singleGenreContentLaw N P β (SourceNorm.normalizedContent ν p))) ↔
      SingleGenreProductSupCondition
        {z : Fin N → ℝ | InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z} := by
  constructor
  · rintro ⟨p, hp_nonnegative, hp_norm, hp_score, hnash⟩
    have hp_nonzero : NonzeroContent p :=
      nonzeroContent_of_positive_score hp_score
    exact singleGenreContentLaw_productSupCondition_of_sourceSymmetricMixedNash
      ν hβ
      (SourceNorm.norm_normalizedContent_eq_one ν hp_nonzero)
      (SourceNorm.normalizedContent_nonnegative ν hp_nonnegative) husers
      (fun i => SourceNorm.score_normalizedContent_pos_of_score_pos
        ν (users i) hp_nonzero (hp_score i)) hnash
  · intro hproduct
    exact
      exists_singleGenreContentLaw_sourceSymmetricMixedNash_of_productSupCondition_of_compactSublevels
        ν hβ husers husers_nonzero hcompact hproduct

/--
The powered score image of the nonnegative finite-dimensional `Lq` unit ball
is compact.  This is the attainment fact underlying the source's use of
`max` in the `betap` optimization argument.
-/
theorem isCompact_inPoweredUnitImage_lp
    {D N : ℕ} (users : Fin N → Content D) {q β : ℝ}
    (hq : 0 < q) (hβ : 0 ≤ β) :
    IsCompact {y : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧
          AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β y} := by
  let K : Set (Content D) := {p |
    NonnegativeContent p ∧ AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1}
  let f : Content D → Fin N → ℝ := fun p i => (score (users i) p) ^ β
  have hK : IsCompact K := by
    simpa [K] using
      (AppliedModelingLib.FiniteDimensionalNorms.isCompact_nonnegative_lp_closedBall
        (ι := Fin D) hq)
  have hf : Continuous f := by
    simpa [f] using continuous_poweredScoreRow users hβ
  have hset : {y : Fin N → ℝ |
      InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧
          AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β y} = f '' K := by
    ext y
    constructor
    · rintro ⟨base, ⟨p, hp, hbase⟩, hy⟩
      refine ⟨p, hp, ?_⟩
      ext i
      rw [hy, hbase]
    · rintro ⟨p, hp, rfl⟩
      refine ⟨fun i => score (users i) p, ⟨p, hp, rfl⟩, rfl⟩
  rw [hset]
  exact hK.image hf

/-- The coordinate-product objective is continuous on a finite user row. -/
theorem continuous_coordinateProduct (N : ℕ) :
    Continuous (coordinateProduct : (Fin N → ℝ) → ℝ) := by
  unfold coordinateProduct
  exact continuous_finset_prod Finset.univ fun i _ => continuous_apply i

/--
The compact powered `Lq` image has an attained coordinate-product maximizer.
This is the source-side attainment statement used in Corollary `betap`.
-/
theorem exists_coordinateProductMaximizer_inPoweredUnitImage_lp
    {D N : ℕ} (users : Fin N → Content D) {q β : ℝ}
    (hq : 0 < q) (hβ : 0 ≤ β) :
    ∃ y : Fin N → ℝ,
      IsCoordinateProductMaximizer
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧
              AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β z} y := by
  let S : Set (Fin N → ℝ) := {z |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧
        AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β z}
  have hcompact : IsCompact S := by
    simpa [S] using isCompact_inPoweredUnitImage_lp users hq hβ
  have hzero : (0 : Content D) ∈
      {p : Content D | NonnegativeContent p ∧
        AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1} := by
    refine ⟨fun d => by simp, ?_⟩
    rw [show AppliedModelingLib.FiniteDimensionalNorms.lp q (0 : Content D) = 0 by
      simpa using
        (AppliedModelingLib.FiniteDimensionalNorms.lp_zero_of_pos (ι := Fin D) hq)]
    exact zero_le_one
  have hnonempty : S.Nonempty := by
    refine ⟨fun i => (score (users i) (0 : Content D)) ^ β, ?_⟩
    refine ⟨fun i => score (users i) (0 : Content D), ⟨0, hzero, rfl⟩, rfl⟩
  obtain ⟨y, hy, hymax⟩ := hcompact.exists_isMaxOn hnonempty
    (continuous_coordinateProduct N).continuousOn
  exact ⟨y, hy, hymax⟩

/--
The product-condition form of the strict upper-threshold argument in Corollary
`beta`.  A strict convex-hull product improvement contradicts the condition
once compact source attainment supplies a maximizing source row.  This is the
direct bridge from the fixed-exponent calculation to the source beta-star
supremum.
-/
theorem not_singleGenreProductSupCondition_inPoweredUnitImage_of_lt_general_threshold
    {D N : ℕ} [Nontrivial (Fin N)] {β Z : ℝ}
    {users : Fin N → Content D} (ν : SourceNorm D)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hcompact_sublevels : SourceNormCompactSublevels ν)
    (haggregate_bound : ∀ p : Content D, NonnegativeContent p → ν.norm p ≤ 1 →
      (∑ i : Fin N, score (users i) p) ≤ Z)
    (hdual_witness : ∀ i : Fin N, ∃ p : Content D,
      NonnegativeContent p ∧ ν.norm p = 1 ∧ score (users i) p = 1)
    (hZ_one_lt : 1 < Z) (hZ_lt_card : Z < (N : ℝ))
    (hβ_bound : Real.log (N : ℝ) /
        (Real.log (N : ℝ) - Real.log Z) < β) :
    ¬ SingleGenreProductSupCondition
      {z : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z} := by
  obtain ⟨hβ_pos, _⟩ :=
    generalThreshold_scalar_strict_gap_of_lt_log_bound hZ_one_lt hZ_lt_card hβ_bound
  let S : Set (Fin N → ℝ) :=
    {z | InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z}
  intro hproduct
  have hproductS : SingleGenreProductSupCondition S := by
    simpa [S] using hproduct
  obtain ⟨x, hx⟩ :=
    exists_coordinateProductMaximizer_inPoweredUnitImage_of_compactSublevels
      users ν hcompact_sublevels hβ_pos.le
  have hxS : IsCoordinateProductMaximizer S x := by
    simpa [S] using hx
  have hbounded : BddAbove (coordinateProduct '' convexHull ℝ S) := by
    simpa [S] using
      (bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := ν) husers_nonnegative hcompact_sublevels hβ_pos.le)
  have hxHull : IsCoordinateProductMaximizer (convexHull ℝ S) x :=
    isCoordinateProductMaximizer_convexHull_of_productSupCondition_of_bddAbove
      hproductS hxS hbounded
  obtain ⟨y, hy, hgap⟩ :=
    exists_convexHull_poweredUnitImage_coordinateProduct_strict_gap_of_lt_general_threshold
      ν husers_nonnegative haggregate_bound hdual_witness hZ_one_lt hZ_lt_card hβ_bound
  exact (not_lt_of_ge (hxHull.2 y (by simpa [S] using hy)))
    (hgap x (by simpa [S] using hxS.1))

/--
The product-condition version of the `Z = 1` endpoint in Corollary `beta`.
As in the finite interior branch, compact source attainment turns the strict
convex-hull improvement into a contradiction to the source beta-star
condition.
-/
theorem not_singleGenreProductSupCondition_inPoweredUnitImage_of_Z_eq_one
    {D N : ℕ} [Nontrivial (Fin N)] {β : ℝ}
    {users : Fin N → Content D} (ν : SourceNorm D)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hcompact_sublevels : SourceNormCompactSublevels ν)
    (haggregate_bound : ∀ p : Content D, NonnegativeContent p → ν.norm p ≤ 1 →
      (∑ i : Fin N, score (users i) p) ≤ 1)
    (hdual_witness : ∀ i : Fin N, ∃ p : Content D,
      NonnegativeContent p ∧ ν.norm p = 1 ∧ score (users i) p = 1)
    (hβ_one_lt : 1 < β) :
    ¬ SingleGenreProductSupCondition
      {z : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z} := by
  let S : Set (Fin N → ℝ) :=
    {z | InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β z}
  have hβ_nonnegative : 0 ≤ β := le_trans zero_le_one hβ_one_lt.le
  intro hproduct
  have hproductS : SingleGenreProductSupCondition S := by
    simpa [S] using hproduct
  obtain ⟨x, hx⟩ :=
    exists_coordinateProductMaximizer_inPoweredUnitImage_of_compactSublevels
      users ν hcompact_sublevels hβ_nonnegative
  have hxS : IsCoordinateProductMaximizer S x := by
    simpa [S] using hx
  have hbounded : BddAbove (coordinateProduct '' convexHull ℝ S) := by
    simpa [S] using
      (bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := ν) husers_nonnegative hcompact_sublevels hβ_nonnegative)
  have hxHull : IsCoordinateProductMaximizer (convexHull ℝ S) x :=
    isCoordinateProductMaximizer_convexHull_of_productSupCondition_of_bddAbove
      hproductS hxS hbounded
  obtain ⟨y, hy, hgap⟩ :=
    exists_convexHull_poweredUnitImage_coordinateProduct_strict_gap_of_Z_eq_one
      ν husers_nonnegative haggregate_bound hdual_witness hβ_one_lt
  exact (not_lt_of_ge (hxHull.2 y (by simpa [S] using hy)))
    (hgap x (by simpa [S] using hxS.1))

/--
The standard-basis sharpness half of Corollary `betap`: once the exponent
exceeds `q`, the displayed strict convex-hull product improvement rules out
the source product-supremum condition.  Compactness supplies the source
product maximizer used to turn that strict gap into a contradiction.
-/
theorem not_singleGenreProductSupCondition_inPoweredUnitImage_standardBasis_lp_of_lt
    {D : ℕ} [Nontrivial (Fin D)] {q β : ℝ}
    (hq : 1 ≤ q) (hβ : q < β) :
    ¬ SingleGenreProductSupCondition
      {z : Fin D → ℝ |
        InPoweredUnitImage (standardBasisUsers D)
          (fun p => NonnegativeContent p ∧
            AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β z} := by
  let S : Set (Fin D → ℝ) :=
    {z | InPoweredUnitImage (standardBasisUsers D)
      (fun p => NonnegativeContent p ∧
        AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) β z}
  let hq_pos : 0 < q := lt_of_lt_of_le zero_lt_one hq
  have hβ_nonnegative : 0 ≤ β := by linarith
  have husers_nonnegative : ∀ i : Fin D, NonnegativeContent (standardBasisUsers D i) := by
    intro i
    simpa [standardBasisUsers] using standardBasisContent_nonnegative D i
  intro hproduct
  have hproductS : SingleGenreProductSupCondition S := by
    simpa [S] using hproduct
  obtain ⟨x, hx⟩ :=
    exists_coordinateProductMaximizer_inPoweredUnitImage_lp
      (standardBasisUsers D) hq_pos hβ_nonnegative
  have hxS : IsCoordinateProductMaximizer S x := by
    simpa [S] using hx
  have hbounded : BddAbove (coordinateProduct '' convexHull ℝ S) := by
    simpa [S, SourceNorm.lp] using
      (bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := SourceNorm.lp D hq_pos) husers_nonnegative
        (SourceNorm.lp_compactSublevels hq_pos) hβ_nonnegative)
  have hxHull : IsCoordinateProductMaximizer (convexHull ℝ S) x :=
    isCoordinateProductMaximizer_convexHull_of_productSupCondition_of_bddAbove
      hproductS hxS hbounded
  obtain ⟨y, hy, hgap⟩ :=
    standardBasis_convexHull_coordinateProduct_strict_gap (D := D) hq_pos hβ
  exact (not_lt_of_ge (hxHull.2 y (by simpa [S] using hy)))
    (hgap x (by simpa [S] using hxS.1))

/--
At `β = q ≥ 1`, compact source-side attainment and the `Lq` barycenter
domination theorem together produce an attained coordinate-product maximizer
over the convex hull as well.  No independent compactness theorem for the
convex hull is needed: each hull row is dominated by a source row.
-/
theorem exists_coordinateProductMaximizer_convexHull_lp
    {D N : ℕ} {q : ℝ} {users : Fin N → Content D}
    (hq : 1 ≤ q) (husers : ∀ i, NonnegativeContent (users i)) :
    ∃ y : Fin N → ℝ,
      IsCoordinateProductMaximizer
        (convexHull ℝ
          {z : Fin N → ℝ |
            InPoweredUnitImage users
              (fun p => NonnegativeContent p ∧
                AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z}) y := by
  let S : Set (Fin N → ℝ) := {z |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧
        AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z}
  have hq_pos : 0 < q := lt_of_lt_of_le zero_lt_one hq
  obtain ⟨y, hyS, hymaxS⟩ :=
    exists_coordinateProductMaximizer_inPoweredUnitImage_lp users hq_pos
      (le_trans zero_le_one hq)
  have hyHull : y ∈ convexHull ℝ S := subset_convexHull ℝ S hyS
  refine ⟨y, hyHull, ?_⟩
  intro z hzHull
  obtain ⟨z', hz'S, hprod⟩ :=
    exists_poweredUnitImage_coordinateProduct_ge_convexHull_lp hq husers
      (by simpa [S] using hzHull)
  exact hprod.trans (hymaxS z' (by simpa [S] using hz'S))

/--
The preceding convex-hull maximizer can be chosen from the original powered
source image itself, not merely from its hull.
-/
theorem exists_source_coordinateProductMaximizer_convexHull_lp
    {D N : ℕ} {q : ℝ} {users : Fin N → Content D}
    (hq : 1 ≤ q) (husers : ∀ i, NonnegativeContent (users i)) :
    ∃ y : Fin N → ℝ,
      y ∈ {z : Fin N → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧
            AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z} ∧
      IsCoordinateProductMaximizer
        (convexHull ℝ
          {z : Fin N → ℝ |
            InPoweredUnitImage users
              (fun p => NonnegativeContent p ∧
                AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z}) y := by
  let S : Set (Fin N → ℝ) := {z |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧
        AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z}
  have hq_pos : 0 < q := lt_of_lt_of_le zero_lt_one hq
  obtain ⟨y, hyS, hymaxS⟩ :=
    exists_coordinateProductMaximizer_inPoweredUnitImage_lp users hq_pos
      (le_trans zero_le_one hq)
  have hyHull : y ∈ convexHull ℝ S := subset_convexHull ℝ S hyS
  refine ⟨y, (by simpa [S] using hyS), hyHull, ?_⟩
  intro z hzHull
  obtain ⟨z', hz'S, hprod⟩ :=
    exists_poweredUnitImage_coordinateProduct_ge_convexHull_lp hq husers
      (by simpa [S] using hzHull)
  exact hprod.trans (hymaxS z' (by simpa [S] using hz'S))

/--
Corrected direct `betap` endpoint.  The required positivity is a feasible
positive-score witness, not the impossible assertion that every row of a norm
ball (which includes zero) is positive.  Compact attainment and the `Lq`
barycenter argument select a positive source row satisfying the direction
condition, and the existing ray-law construction yields the Nash law.
-/
theorem exists_singleGenreContentLaw_sourceSymmetricMixedNash_lp_beta_eq_q_of_positive_feasible
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {q : ℝ} {users : Fin N → Content D}
    (hq : 1 ≤ q) (husers : ∀ i, NonnegativeContent (users i))
    (hpositive : ∃ p : Content D, NonnegativeContent p ∧
      AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1 ∧
      ∀ i : Fin N, 0 < score (users i) p) :
    ∃ p : Content D, NonnegativeContent p ∧
      AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1 ∧
      (∀ i : Fin N, 0 < score (users i) p) ∧
      SourceSymmetricMixedNash (P := P) users
        (normRpowCost (SourceNorm.lp D (lt_of_lt_of_le zero_lt_one hq)) q)
        (singleGenreContentLaw N P q
          (SourceNorm.normalizedContent
            (SourceNorm.lp D (lt_of_lt_of_le zero_lt_one hq)) p)) := by
  let S : Set (Fin N → ℝ) := {z |
    InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧
        AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z}
  have hq_pos : 0 < q := lt_of_lt_of_le zero_lt_one hq
  obtain ⟨y, hyS, hmax⟩ :=
    exists_source_coordinateProductMaximizer_convexHull_lp hq husers
  rcases hpositive with ⟨p0, hp0_nonnegative, hp0_ball, hp0_score⟩
  let x : Fin N → ℝ := fun i => (score (users i) p0) ^ q
  have hxS : x ∈ S := by
    refine ⟨fun i => score (users i) p0,
      ⟨p0, ⟨hp0_nonnegative, hp0_ball⟩, rfl⟩, rfl⟩
  have hxHull : x ∈ convexHull ℝ S := subset_convexHull ℝ S hxS
  have hproduct_x_pos : 0 < coordinateProduct x := by
    unfold coordinateProduct x
    exact Finset.prod_pos fun i _ =>
      Real.rpow_pos_of_pos (hp0_score i) q
  have hproduct_y_pos : 0 < coordinateProduct y :=
    lt_of_lt_of_le hproduct_x_pos (hmax.2 x (by simpa [S] using hxHull))
  have hnonnegativeHull :
      ∀ z ∈ convexHull ℝ S, ∀ i, 0 ≤ z i := by
    intro z hz i
    obtain ⟨z', hz'S, hdom⟩ :=
      exists_poweredUnitImage_dominating_convexHull_lp hq husers
        (by simpa [S] using hz)
    exact (hdom i).1
  have hy_pos : ∀ i, 0 < y i := by
    intro i
    have hy_nonnegative : 0 ≤ y i := hnonnegativeHull y hmax.1 i
    have hy_ne : y i ≠ 0 := by
      intro hy_zero
      have hproduct_zero : coordinateProduct y = 0 := by
        unfold coordinateProduct
        exact Finset.prod_eq_zero (Finset.mem_univ i) hy_zero
      rw [hproduct_zero] at hproduct_y_pos
      exact (lt_irrefl (0 : ℝ)) hproduct_y_pos
    exact lt_of_le_of_ne hy_nonnegative (Ne.symm hy_ne)
  have hconditionHull :
      SingleGenreDirectionCondition (convexHull ℝ S) y :=
    singleGenreDirectionCondition_of_convex_coordinateProductMaximizer_nonnegative
      (convex_convexHull ℝ S) hmax hy_pos hnonnegativeHull
  have hconditionS : SingleGenreDirectionCondition S y := by
    intro z hz
    exact hconditionHull z (subset_convexHull ℝ S hz)
  rcases hyS with ⟨base, ⟨p, hp, hbase⟩, hy⟩
  have hscore : ∀ i : Fin N, 0 < score (users i) p := by
    intro i
    have h := hy_pos i
    rw [hy, hbase] at h
    by_contra hnot
    have hnonnegative : 0 ≤ score (users i) p :=
      score_nonneg_of_nonnegative (husers i) hp.1
    have hzero : score (users i) p = 0 :=
      le_antisymm (le_of_not_gt hnot) hnonnegative
    change 0 < (score (users i) p) ^ q at h
    rw [hzero, Real.zero_rpow hq_pos.ne'] at h
    exact (lt_irrefl (0 : ℝ)) h
  have hconditionRow :
      SingleGenreDirectionCondition
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧
              AppliedModelingLib.FiniteDimensionalNorms.lp q p ≤ 1) q z}
        (fun i => (score (users i) p) ^ q) := by
    simpa [S, hy, hbase] using hconditionS
  have hcondition :
      SingleGenreDirectionCondition
        {z : Fin N → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧
              (SourceNorm.lp D hq_pos).norm p ≤ 1) q z}
        (fun i => (score (users i) p) ^ q) := by
    simpa [SourceNorm.lp] using hconditionRow
  refine ⟨p, hp.1, hp.2, hscore, ?_⟩
  exact singleGenreContentLaw_is_sourceSymmetricMixedNash_of_positive_ball_condition
    (SourceNorm.lp D hq_pos) hq_pos husers hp.1 hp.2 hscore hcondition

/--
The reparameterized objective actually induced by a symmetric content law when
all score levels are null: a producer earns the sum of strict-score masses of
all other producers, less its content cost.

This is the tie-aware replacement for the source proof's unqualified CDF
objective in Lemma `necessarysuff`.
-/
noncomputable def strictScoreMassReparamObjective {D N P : ℕ}
    (users : Fin N → Content D) (μ : MixedContentStrategy D)
    (cost : Content D → ℝ) (p : Content D) : ℝ :=
  (∑ i : Fin N,
    (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1)) -
      cost p

/-- The vector of realized scores of a content action across all users. -/
noncomputable def userValueMap {D N : ℕ}
    (users : Fin N → Content D) (p : Content D) : Fin N → ℝ :=
  fun i => score (users i) p

/-- The realized-value map is continuous in finite-dimensional content space. -/
theorem continuous_userValueMap {D N : ℕ}
    (users : Fin N → Content D) :
    Continuous (userValueMap users) := by
  apply continuous_pi
  intro i
  simpa [userValueMap] using continuous_score_right (users i)

/--
A support action maps into the topological support of its realized-value law.
This is the support component of C3 for the canonical pushforward law.
-/
theorem userValueMap_mem_support_map_of_mem_support
    {D N : ℕ} {users : Fin N → Content D}
    {μ : MeasureTheory.Measure (Content D)} {p : Content D}
    (hp : p ∈ μ.support) :
    userValueMap users p ∈
      (MeasureTheory.Measure.map (userValueMap users) μ).support := by
  rw [MeasureTheory.Measure.support_eq_forall_isOpen]
  intro U hpU hUopen
  rw [MeasureTheory.Measure.map_apply
    (continuous_userValueMap users).measurable hUopen.measurableSet]
  apply (MeasureTheory.Measure.mem_support_iff_forall p).mp hp
  apply (continuous_userValueMap users).continuousAt
  exact hUopen.mem_nhds hpU

/--
The value-space objective underlying the source's C1 reparameterization.

`inducedCost` is deliberately a supplied function rather than an unqualified
minimum: a fibre minimum must be proved to exist before it can be used as a
cost function on realized values.
-/
noncomputable def valueSpaceReparamObjective {N : ℕ}
    (H : Fin N → ℝ → ℝ) (inducedCost : (Fin N → ℝ) → ℝ)
    (z : Fin N → ℝ) : ℝ :=
  (∑ i : Fin N, H i (z i)) - inducedCost z

/--
Under the effective, tie-aware C2 identity, the source value objective at a
content action has the same reward term as the actual strict-score-mass
objective.  The two objectives differ only by their cost representatives.
-/
theorem strictScoreMassReparamObjective_eq_valueSpaceReparamObjective
    {D N P : ℕ} {users : Fin N → Content D} {μ : MixedContentStrategy D}
    {cost : Content D → ℝ} {H : Fin N → ℝ → ℝ}
    {inducedCost : (Fin N → ℝ) → ℝ} {p : Content D}
    (hH : ∀ (i : Fin N) (z : ℝ),
      H i z = (μ.real {q : Content D | score (users i) q < z}) ^ (P - 1))
    (hcost : inducedCost (userValueMap users p) = cost p) :
    strictScoreMassReparamObjective (P := P) users μ cost p =
      valueSpaceReparamObjective H inducedCost (userValueMap users p) := by
  unfold strictScoreMassReparamObjective valueSpaceReparamObjective
  change
    (∑ i : Fin N,
      (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1)) -
        cost p =
      (∑ i : Fin N, H i (score (users i) p)) -
        inducedCost (userValueMap users p)
  rw [hcost]
  congr 1
  apply Finset.sum_congr rfl
  intro i _hi
  exact (hH i (score (users i) p)).symm

/--
Tie-aware value-space sufficient direction for the source's C1--C3 route.

Here `S` is the supplied realized-value support (C3), `hC1` maximizes the
value objective over every feasible content image, and `hH` is the effective
tie-free form of C2.  The lower-bound and support-attainment conditions say
precisely what is needed of an induced cost: every content realization costs
at least its value cost, while each support realization attains that cost.

These assumptions are not cosmetic.  The source proof needs score-level
nullness to replace tie shares by CDF powers, and needs the support actions to
be minimum-cost representatives of their value fibres.
-/
theorem sourceSymmetricMixedNash_of_valueSpaceCertificate_strictScoreMass
    {D N P : ℕ} {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    {H : Fin N → ℝ → ℝ} {inducedCost : (Fin N → ℝ) → ℝ}
    {S : Set (Fin N → ℝ)}
    (hsupport : μ.support ⊆ {p : Content D | NonnegativeContent p})
    (hmeas_score : ∀ i : Fin N,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0)
    (hH : ∀ (i : Fin N) (z : ℝ),
      H i z = (μ.real {q : Content D | score (users i) q < z}) ^ (P - 1))
    (hC3_support : ∀ p : Content D, p ∈ μ.support → userValueMap users p ∈ S)
    (hC1 : ∀ z : Fin N → ℝ, z ∈ S → ∀ q : Content D,
      NonnegativeContent q →
        valueSpaceReparamObjective H inducedCost (userValueMap users q) ≤
          valueSpaceReparamObjective H inducedCost z)
    (hinduced_le_cost : ∀ q : Content D, NonnegativeContent q →
      inducedCost (userValueMap users q) ≤ cost q)
    (hsupport_cost : ∀ p : Content D, p ∈ μ.support →
      inducedCost (userValueMap users p) = cost p) :
    SourceSymmetricMixedNash (P := P) users cost μ := by
  refine ⟨inferInstance, hsupport, ?_⟩
  intro j p hp q hq
  have hq_value :
      strictScoreMassReparamObjective (P := P) users μ cost q ≤
        valueSpaceReparamObjective H inducedCost (userValueMap users q) := by
    have hreward :
        (∑ i : Fin N,
          (μ.real {r : Content D | score (users i) r < score (users i) q}) ^
            (P - 1)) =
          ∑ i : Fin N, H i (score (users i) q) := by
      apply Finset.sum_congr rfl
      intro i _hi
      exact (hH i (score (users i) q)).symm
    calc
      strictScoreMassReparamObjective (P := P) users μ cost q =
          (∑ i : Fin N,
            (μ.real {r : Content D | score (users i) r < score (users i) q}) ^
              (P - 1)) - cost q := rfl
      _ = (∑ i : Fin N, H i (score (users i) q)) - cost q := by rw [hreward]
      _ ≤ (∑ i : Fin N, H i (score (users i) q)) -
          inducedCost (userValueMap users q) :=
        sub_le_sub_left (hinduced_le_cost q hq) _
      _ = valueSpaceReparamObjective H inducedCost (userValueMap users q) := by
        rfl
  have hp_value :
      strictScoreMassReparamObjective (P := P) users μ cost p =
        valueSpaceReparamObjective H inducedCost (userValueMap users p) :=
    strictScoreMassReparamObjective_eq_valueSpaceReparamObjective hH
      (hsupport_cost p hp)
  have hmax :
      strictScoreMassReparamObjective (P := P) users μ cost q ≤
        strictScoreMassReparamObjective (P := P) users μ cost p := by
    calc
    strictScoreMassReparamObjective (P := P) users μ cost q ≤
        valueSpaceReparamObjective H inducedCost (userValueMap users q) := hq_value
    _ ≤ valueSpaceReparamObjective H inducedCost (userValueMap users p) :=
      hC1 (userValueMap users p) (hC3_support p hp) q hq
    _ = strictScoreMassReparamObjective (P := P) users μ cost p := hp_value.symm
  unfold SourceMixedPurePayoff
  rw [expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
    (j := j) q hmeas_score hno_atom,
    expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
      (j := j) p hmeas_score hno_atom]
  simpa [strictScoreMassReparamObjective] using hmax

/--
Mapped-support specialization of the tie-aware value-space certificate.  C3's
support-membership component follows from continuity of the realized-value
map, so only the value-space C1 condition over the actual pushforward support
remains as input.
-/
theorem sourceSymmetricMixedNash_of_mappedValueSupportCertificate_strictScoreMass
    {D N P : ℕ} {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    {H : Fin N → ℝ → ℝ} {inducedCost : (Fin N → ℝ) → ℝ}
    (hsupport : μ.support ⊆ {p : Content D | NonnegativeContent p})
    (hmeas_score : ∀ i : Fin N,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0)
    (hH : ∀ (i : Fin N) (z : ℝ),
      H i z = (μ.real {q : Content D | score (users i) q < z}) ^ (P - 1))
    (hC1 : ∀ z : Fin N → ℝ,
      z ∈ (MeasureTheory.Measure.map (userValueMap users) μ).support →
      ∀ q : Content D, NonnegativeContent q →
        valueSpaceReparamObjective H inducedCost (userValueMap users q) ≤
          valueSpaceReparamObjective H inducedCost z)
    (hinduced_le_cost : ∀ q : Content D, NonnegativeContent q →
      inducedCost (userValueMap users q) ≤ cost q)
    (hsupport_cost : ∀ p : Content D, p ∈ μ.support →
      inducedCost (userValueMap users p) = cost p) :
    SourceSymmetricMixedNash (P := P) users cost μ :=
  sourceSymmetricMixedNash_of_valueSpaceCertificate_strictScoreMass
    hsupport hmeas_score hno_atom hH
    (fun p hp => userValueMap_mem_support_map_of_mem_support hp)
    hC1 hinduced_le_cost hsupport_cost

/--
Corrected necessary C1 direction for the source's value-space formulation.

The printed converse of `necessarysuff` passes directly from a support action
to a maximizer of a value-space objective.  That passage needs two facts about
the induced cost which are implicit in the displayed fibrewise minimum: every
feasible value has a nonnegative minimum-cost representative, and every
declared support value is realized by an actual support action.  With those
facts and null score levels, a source symmetric Nash law proves the displayed
C1 maximization statement.
-/
theorem valueSpaceC1_of_sourceSymmetricMixedNash_strictScoreMass
    {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} {H : Fin N → ℝ → ℝ}
    {inducedCost : (Fin N → ℝ) → ℝ} {S : Set (Fin N → ℝ)}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (hmeas_score : ∀ i : Fin N,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0)
    (hH : ∀ (i : Fin N) (z : ℝ),
      H i z = (μ.real {q : Content D | score (users i) q < z}) ^ (P - 1))
    (hsupport_realizes : ∀ z : Fin N → ℝ, z ∈ S →
      ∃ p : Content D, p ∈ μ.support ∧ userValueMap users p = z)
    (hinduced_attained : ∀ q : Content D, NonnegativeContent q →
      ∃ qmin : Content D, NonnegativeContent qmin ∧
        userValueMap users qmin = userValueMap users q ∧
        cost qmin = inducedCost (userValueMap users q))
    (hsupport_cost : ∀ p : Content D, p ∈ μ.support →
      inducedCost (userValueMap users p) = cost p) :
    ∀ z : Fin N → ℝ, z ∈ S → ∀ q : Content D,
      NonnegativeContent q →
        valueSpaceReparamObjective H inducedCost (userValueMap users q) ≤
          valueSpaceReparamObjective H inducedCost z := by
  classical
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  intro z hz q hq
  obtain ⟨p, hp, hp_value⟩ := hsupport_realizes z hz
  obtain ⟨qmin, hqmin, hqmin_value, hqmin_cost⟩ := hinduced_attained q hq
  have hpay := hnash.2.2 (Classical.choice inferInstance) p hp qmin hqmin
  unfold SourceMixedPurePayoff at hpay
  rw [expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
    (j := Classical.choice inferInstance) qmin hmeas_score hno_atom,
    expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
      (j := Classical.choice inferInstance) p hmeas_score hno_atom] at hpay
  have hmax :
      strictScoreMassReparamObjective (P := P) users μ cost qmin ≤
        strictScoreMassReparamObjective (P := P) users μ cost p := by
    simpa [strictScoreMassReparamObjective] using hpay
  have hqmin_objective :
      strictScoreMassReparamObjective (P := P) users μ cost qmin =
        valueSpaceReparamObjective H inducedCost (userValueMap users qmin) :=
    strictScoreMassReparamObjective_eq_valueSpaceReparamObjective hH
      (by simpa [hqmin_value] using hqmin_cost.symm)
  have hp_objective :
      strictScoreMassReparamObjective (P := P) users μ cost p =
        valueSpaceReparamObjective H inducedCost (userValueMap users p) :=
    strictScoreMassReparamObjective_eq_valueSpaceReparamObjective hH
      (hsupport_cost p hp)
  calc
    valueSpaceReparamObjective H inducedCost (userValueMap users q) =
        valueSpaceReparamObjective H inducedCost (userValueMap users qmin) := by
          rw [hqmin_value]
    _ = strictScoreMassReparamObjective (P := P) users μ cost qmin :=
      hqmin_objective.symm
    _ ≤ strictScoreMassReparamObjective (P := P) users μ cost p := hmax
    _ = valueSpaceReparamObjective H inducedCost (userValueMap users p) := hp_objective
    _ = valueSpaceReparamObjective H inducedCost z := by rw [hp_value]

/--
Corrected value-space necessary-and-sufficient form of Lemma `necessarysuff`.
It has the source C1/C2/C3 shape, but keeps visible the null-tie condition,
the two support-realization directions, and the lower-bound/attainment facts
for the induced fibre cost.  These conditions are exactly what connect a
uniform-tie content-game Nash law to the value-space objective.
-/
theorem sourceSymmetricMixedNash_iff_valueSpaceCertificate_strictScoreMass
    {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    {H : Fin N → ℝ → ℝ} {inducedCost : (Fin N → ℝ) → ℝ}
    {S : Set (Fin N → ℝ)}
    (hmeas_score : ∀ i : Fin N,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0)
    (hH : ∀ (i : Fin N) (z : ℝ),
      H i z = (μ.real {q : Content D | score (users i) q < z}) ^ (P - 1))
    (hC3_support : ∀ p : Content D, p ∈ μ.support → userValueMap users p ∈ S)
    (hsupport_realizes : ∀ z : Fin N → ℝ, z ∈ S →
      ∃ p : Content D, p ∈ μ.support ∧ userValueMap users p = z)
    (hinduced_le_cost : ∀ q : Content D, NonnegativeContent q →
      inducedCost (userValueMap users q) ≤ cost q)
    (hinduced_attained : ∀ q : Content D, NonnegativeContent q →
      ∃ qmin : Content D, NonnegativeContent qmin ∧
        userValueMap users qmin = userValueMap users q ∧
        cost qmin = inducedCost (userValueMap users q))
    (hsupport_cost : ∀ p : Content D, p ∈ μ.support →
      inducedCost (userValueMap users p) = cost p) :
    SourceSymmetricMixedNash (P := P) users cost μ ↔
      μ.support ⊆ {p : Content D | NonnegativeContent p} ∧
      (∀ z : Fin N → ℝ, z ∈ S → ∀ q : Content D,
        NonnegativeContent q →
          valueSpaceReparamObjective H inducedCost (userValueMap users q) ≤
            valueSpaceReparamObjective H inducedCost z) := by
  constructor
  · intro hnash
    exact ⟨hnash.2.1,
      valueSpaceC1_of_sourceSymmetricMixedNash_strictScoreMass
        hnash hmeas_score hno_atom hH hsupport_realizes hinduced_attained hsupport_cost⟩
  · rintro ⟨hsupport, hC1⟩
    exact sourceSymmetricMixedNash_of_valueSpaceCertificate_strictScoreMass
      hsupport hmeas_score hno_atom hH hC3_support hC1 hinduced_le_cost hsupport_cost

/--
Corrected sufficient direction of Lemma `necessarysuff`.  If a probability
law is supported on nonnegative content, has no score-level atoms, and every
support action maximizes its induced strict-score-mass objective over the
source action domain, then it is a symmetric mixed Nash equilibrium for the
actual uniform-tie payoff.

The source's C1--C3 statement does not include the score-level-null premise;
without it its CDF payoff formula omits tie shares.  This theorem makes the
needed premise and the source-action maximization domain explicit.
-/
theorem sourceSymmetricMixedNash_of_supportMaximizer_strictScoreMass
    {D N P : ℕ} {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    (hsupport : μ.support ⊆ {p : Content D | NonnegativeContent p})
    (hmeas_score : ∀ i : Fin N,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0)
    (hmax : ∀ p : Content D, p ∈ μ.support → ∀ q : Content D,
      NonnegativeContent q →
        strictScoreMassReparamObjective (P := P) users μ cost q ≤
          strictScoreMassReparamObjective (P := P) users μ cost p) :
    SourceSymmetricMixedNash (P := P) users cost μ := by
  refine ⟨inferInstance, hsupport, ?_⟩
  intro j p hp q hq
  unfold SourceMixedPurePayoff
  rw [expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
    (j := j) q hmeas_score hno_atom,
    expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
      (j := j) p hmeas_score hno_atom]
  simpa [strictScoreMassReparamObjective] using hmax p hp q hq

/--
Corrected necessary direction of Lemma `necessarysuff` at the content-action
level.  A symmetric mixed Nash law with null score levels makes each support
action maximize the same strict-score-mass objective that appears in the
tie-aware sufficient direction.
-/
theorem supportMaximizer_strictScoreMass_of_sourceSymmetricMixedNash
    {D N P : ℕ} {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (hmeas_score : ∀ i : Fin N,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0) :
    ∀ (j : Fin P) (p : Content D), p ∈ μ.support → ∀ q : Content D,
      NonnegativeContent q →
        strictScoreMassReparamObjective (P := P) users μ cost q ≤
          strictScoreMassReparamObjective (P := P) users μ cost p := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  intro j p hp q hq
  have hpay := hnash.2.2 j p hp q hq
  unfold SourceMixedPurePayoff at hpay
  rw [expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
    (j := j) q hmeas_score hno_atom,
    expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
      (j := j) p hmeas_score hno_atom] at hpay
  simpa [strictScoreMassReparamObjective] using hpay

/--
Tie-aware content-level necessary-and-sufficient characterization.  Under
score-level nullness, the actual uniform-tie symmetric Nash condition is
equivalent to nonnegative support together with support maximization of the
strict-score-mass objective.  This is the valid replacement for the printed
generic C1--C3 conclusion; it intentionally does not assert the source's
unstated tie-free reduction.
-/
theorem sourceSymmetricMixedNash_iff_supportMaximizer_strictScoreMass
    {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    (hmeas_score : ∀ i : Fin N,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0) :
    SourceSymmetricMixedNash (P := P) users cost μ ↔
      μ.support ⊆ {p : Content D | NonnegativeContent p} ∧
      (∀ (j : Fin P) (p : Content D), p ∈ μ.support → ∀ q : Content D,
        NonnegativeContent q →
          strictScoreMassReparamObjective (P := P) users μ cost q ≤
            strictScoreMassReparamObjective (P := P) users μ cost p) := by
  constructor
  · intro hnash
    exact ⟨hnash.2.1,
      supportMaximizer_strictScoreMass_of_sourceSymmetricMixedNash
        hnash hmeas_score hno_atom⟩
  · rintro ⟨hsupport, hmax⟩
    exact sourceSymmetricMixedNash_of_supportMaximizer_strictScoreMass
      hsupport hmeas_score hno_atom
      (fun p hp q hq => hmax (Classical.choice inferInstance) p hp q hq)

/-- The actual two-user score map is continuous in original content coordinates. -/
theorem twoUserScoreMap_continuous (u v : Content 2) :
    Continuous (twoUserScoreMap u v) := by
  change Continuous (fun p : Content 2 => (score u p, score v p))
  exact (continuous_score_right u).prodMk (continuous_score_right v)

/--
For a compact original-content support, the support of the actual two-user
score law is exactly the image of that support.  This is the topological
transport used by the original-coordinate graph and no-gap arguments.
-/
theorem twoUserScoreMap_support_eq_image_support_of_isCompact
    {u v : Content 2} {μ : Measure (Content 2)}
    (hcompact : IsCompact μ.support) :
    (Measure.map (twoUserScoreMap u v) μ).support =
      twoUserScoreMap u v '' μ.support := by
  exact AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
    hcompact (twoUserScoreMap_continuous u v)

/--
An actual original-coordinate two-user Nash law with positive scaled
Euclidean norm-power cost has compact score support.  This follows from the
content-space payoff cap and the continuous, unrotated score map.
-/
theorem twoUserScoreMap_isCompact_support_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β : ℝ}
    {u v : Content 2} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 2) β q) μ)
    (hα : 0 < α) (hβ : 0 < β) :
    IsCompact (Measure.map (twoUserScoreMap u v) μ).support := by
  have hcompact_content : IsCompact μ.support :=
    sourceSymmetricMixedNash_isCompact_support_of_compactSublevels_of_scaledNormRpowCost
      (j := Classical.choice inferInstance) hnash hα hβ
      (SourceNorm.l2_compactSublevels 2)
  rw [twoUserScoreMap_support_eq_image_support_of_isCompact hcompact_content]
  exact hcompact_content.image (twoUserScoreMap_continuous u v)

/--
Cone-preserving Nash-to-C1 transport for an arbitrary original pair of
two-dimensional users.  Every support action maximizes the iid-score-CDF
objective on the image of the *original nonnegative content cone* under its
score map.  No rotation to canonical users is used.
-/
theorem twoUserScoreMap_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v p : Content 2} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ) (hsin : 0 < Real.sin θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 2) β q) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content 2 => score (if i = 0 then u else v) q) μ ≪
        volume)
    (hp : p ∈ μ.support) :
    IsMaxOn
      (fun z : ℝ × ℝ =>
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score u q) μ) z.1 +
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
            (Measure.map (fun q : Content 2 => score v q) μ) z.2 -
          twoUserInducedCost α β θ z.1 z.2)
      (twoUserScoreFeasibleSet u v) (twoUserScoreMap u v p) := by
  let users : Fin 2 → Content 2 := fun i => if i = 0 then u else v
  intro z hz
  rcases hz with ⟨q, hq, rfl⟩
  let j : Fin P := Classical.choice inferInstance
  have hmax := hnash.2.2 j p hp q hq
  rw [twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
    (users := users) q (fun _ => measurable_score_content _) hscore_ac,
    twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
      (users := users) p (fun _ => measurable_score_content _) hscore_ac,
    scaledNormRpowCost_l2_eq_twoUserInducedCost_of_unit_score_pair_dim_two
      (p := q) hu hv huv hsin,
    scaledNormRpowCost_l2_eq_twoUserInducedCost_of_unit_score_pair_dim_two
      (p := p) hu hv huv hsin] at hmax
  simpa [users, twoUserScoreMap] using hmax

/--
Original-coordinate boundary FOC for the second score.  This is the
cone-preserving version of the canonical lower-ray calculation: it only asks
for a sufficiently short feasible inward score segment in the *actual*
nonnegative-content score set.  The induced cost has zero derivative along
that segment at the user ray, so nonnegative reward marginal value must be
zero.
-/
theorem deriv_secondReward_eq_zero_of_isMaxOn_of_originalLowerBoundary
    {u v : Content 2} {α β θ r δ : ℝ} {H1 H2 : ℝ → ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      (twoUserScoreFeasibleSet u v) (r, r * Real.cos θ))
    (hsin : 0 < Real.sin θ) (hr : 0 < r) (hδ : 0 < δ)
    (hfeasible : ∀ ε : ℝ, 0 < ε → ε < δ →
      (r, r * Real.cos θ + ε * Real.sin θ) ∈ twoUserScoreFeasibleSet u v)
    (hH2 : HasDerivAt H2 (deriv H2 (r * Real.cos θ)) (r * Real.cos θ))
    (hH2_nonneg : 0 ≤ deriv H2 (r * Real.cos θ)) :
    deriv H2 (r * Real.cos θ) = 0 := by
  let f : ℝ → ℝ := fun t =>
    H1 r + H2 (r * Real.cos θ + t * Real.sin θ) -
      twoUserInducedCost α β θ r (r * Real.cos θ + t * Real.sin θ)
  have hline : HasDerivAt
      (fun t : ℝ => r * Real.cos θ + t * Real.sin θ) (Real.sin θ) 0 := by
    simpa using
      ((hasDerivAt_id (0 : ℝ)).mul_const (Real.sin θ)).const_add
        (r * Real.cos θ)
  have hbase : twoUserInducedCostNumerator θ r (r * Real.cos θ) ≠ 0 :=
    twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne' (Or.inl hr.ne')
  have hcost_base : HasDerivAt
      (fun y : ℝ => twoUserInducedCost α β θ r y)
      (β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ r (r * Real.cos θ)) ^ (β / 2 - 1) *
          (r * Real.cos θ - r * Real.cos θ))
      (r * Real.cos θ + 0 * Real.sin θ) := by
    simpa using
      hasDerivAt_twoUserInducedCost_z2 (α := α) (β := β) (θ := θ)
        (z1 := r) (z2 := r * Real.cos θ) (Or.inl hbase)
  have hcost_raw := hcost_base.comp 0 hline
  have hcost : HasDerivAt
      (fun t : ℝ => twoUserInducedCost α β θ r
        (r * Real.cos θ + t * Real.sin θ)) 0 0 := by
    convert hcost_raw using 1 <;> ring
  have hH2_base : HasDerivAt H2 (deriv H2 (r * Real.cos θ))
      (r * Real.cos θ + 0 * Real.sin θ) := by
    simpa using hH2
  have hH2line := hH2_base.comp 0 hline
  have hf : HasDerivAt f
      (deriv H2 (r * Real.cos θ) * Real.sin θ) 0 := by
    dsimp [f]
    convert ((hasDerivAt_const (0 : ℝ) (H1 r)).add hH2line).sub hcost using 1 <;> ring
  have hderiv_nonpos : deriv H2 (r * Real.cos θ) * Real.sin θ ≤ 0 := by
    by_contra hnot
    have hpos : 0 < deriv H2 (r * Real.cos θ) * Real.sin θ :=
      lt_of_not_ge hnot
    obtain ⟨ε, hε_pos, hε_lt, himprove⟩ :=
      exists_pos_right_improvement_of_hasDerivAt_pos_lt hf hpos hδ
    have hle : f ε ≤ f 0 := by
      simpa [f] using hmax (hfeasible ε hε_pos hε_lt)
    exact (not_lt_of_ge hle) (by simpa using himprove)
  have hderiv_nonneg : 0 ≤ deriv H2 (r * Real.cos θ) * Real.sin θ :=
    mul_nonneg hH2_nonneg hsin.le
  have hzero : deriv H2 (r * Real.cos θ) * Real.sin θ = 0 :=
    le_antisymm hderiv_nonpos hderiv_nonneg
  exact (mul_eq_zero.mp hzero).resolve_right hsin.ne'

/--
Coordinate-swapped original-cone boundary FOC at the second-user ray.  A
short feasible inward segment that raises only the first score makes the same
zero-cost-derivative argument force the first reward marginal value to zero.
-/
theorem deriv_firstReward_eq_zero_of_isMaxOn_of_originalUpperBoundary
    {u v : Content 2} {α β θ r δ : ℝ} {H1 H2 : ℝ → ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      (twoUserScoreFeasibleSet u v) (r * Real.cos θ, r))
    (hsin : 0 < Real.sin θ) (hr : 0 < r) (hδ : 0 < δ)
    (hfeasible : ∀ ε : ℝ, 0 < ε → ε < δ →
      (r * Real.cos θ + ε * Real.sin θ, r) ∈ twoUserScoreFeasibleSet u v)
    (hH1 : HasDerivAt H1 (deriv H1 (r * Real.cos θ)) (r * Real.cos θ))
    (hH1_nonneg : 0 ≤ deriv H1 (r * Real.cos θ)) :
    deriv H1 (r * Real.cos θ) = 0 := by
  let f : ℝ → ℝ := fun t =>
    H1 (r * Real.cos θ + t * Real.sin θ) + H2 r -
      twoUserInducedCost α β θ (r * Real.cos θ + t * Real.sin θ) r
  have hline : HasDerivAt
      (fun t : ℝ => r * Real.cos θ + t * Real.sin θ) (Real.sin θ) 0 := by
    simpa using
      ((hasDerivAt_id (0 : ℝ)).mul_const (Real.sin θ)).const_add
        (r * Real.cos θ)
  have hbase : twoUserInducedCostNumerator θ (r * Real.cos θ) r ≠ 0 :=
    twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne' (Or.inr hr.ne')
  have hcost_base : HasDerivAt
      (fun x : ℝ => twoUserInducedCost α β θ x r)
      (β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ (r * Real.cos θ) r) ^ (β / 2 - 1) *
          (r * Real.cos θ - r * Real.cos θ))
      (r * Real.cos θ + 0 * Real.sin θ) := by
    simpa using
      hasDerivAt_twoUserInducedCost_z1 (α := α) (β := β) (θ := θ)
        (z1 := r * Real.cos θ) (z2 := r) (Or.inl hbase)
  have hcost_raw := hcost_base.comp 0 hline
  have hcost : HasDerivAt
      (fun t : ℝ => twoUserInducedCost α β θ
        (r * Real.cos θ + t * Real.sin θ) r) 0 0 := by
    convert hcost_raw using 1 <;> ring
  have hH1_base : HasDerivAt H1 (deriv H1 (r * Real.cos θ))
      (r * Real.cos θ + 0 * Real.sin θ) := by
    simpa using hH1
  have hH1line := hH1_base.comp 0 hline
  have hf : HasDerivAt f
      (deriv H1 (r * Real.cos θ) * Real.sin θ) 0 := by
    dsimp [f]
    convert (hH1line.add (hasDerivAt_const (0 : ℝ) (H2 r))).sub hcost using 1 <;> ring
  have hderiv_nonpos : deriv H1 (r * Real.cos θ) * Real.sin θ ≤ 0 := by
    by_contra hnot
    have hpos : 0 < deriv H1 (r * Real.cos θ) * Real.sin θ :=
      lt_of_not_ge hnot
    obtain ⟨ε, hε_pos, hε_lt, himprove⟩ :=
      exists_pos_right_improvement_of_hasDerivAt_pos_lt hf hpos hδ
    have hle : f ε ≤ f 0 := by
      simpa [f] using hmax (hfeasible ε hε_pos hε_lt)
    exact (not_lt_of_ge hle) (by simpa using himprove)
  have hderiv_nonneg : 0 ≤ deriv H1 (r * Real.cos θ) * Real.sin θ :=
    mul_nonneg hH1_nonneg hsin.le
  have hzero : deriv H1 (r * Real.cos θ) * Real.sin θ = 0 :=
    le_antisymm hderiv_nonpos hderiv_nonneg
  exact (mul_eq_zero.mp hzero).resolve_right hsin.ne'

/--
At a polar first-user ray, rotating an infinitesimal amount toward the second
user produces the original score-space inward segment.  The displayed radius
is chosen so the first original content coordinate stays nonnegative; hence
this is a genuine source-model deviation, not a rotated-cone surrogate.
-/
theorem twoUserScore_originalLowerBoundary_inward_feasible_of_polarUsers
    {u v : Content 2} {phi theta r ε : ℝ}
    (hu : u = content2 (Real.cos phi) (Real.sin phi))
    (hv : v = content2 (Real.cos (phi + theta)) (Real.sin (phi + theta)))
    (hphi : 0 ≤ phi) (htheta : 0 ≤ theta)
    (hphi_theta : phi + theta ≤ Real.pi / 2)
    (hr : 0 < r) (hε : 0 ≤ ε) (hε_cap : ε < r * Real.cos phi) :
    (r, r * Real.cos theta + ε * Real.sin theta) ∈ twoUserScoreFeasibleSet u v := by
  let q : Content 2 := content2
    (r * Real.cos phi - ε * Real.sin phi)
    (r * Real.sin phi + ε * Real.cos phi)
  have hphi_le : phi ≤ Real.pi / 2 := by linarith
  have hcos_phi : 0 ≤ Real.cos phi :=
    Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], hphi_le⟩
  have hsin_phi : 0 ≤ Real.sin phi :=
    Real.sin_nonneg_of_nonneg_of_le_pi hphi (by linarith [Real.pi_pos])
  have hq_nonnegative : NonnegativeContent q := by
    intro d
    fin_cases d
    · change 0 ≤ r * Real.cos phi - ε * Real.sin phi
      have hsin_le_one : Real.sin phi ≤ 1 := Real.sin_le_one phi
      have hεsin_le : ε * Real.sin phi ≤ ε := by
        nlinarith
      linarith
    · change 0 ≤ r * Real.sin phi + ε * Real.cos phi
      exact add_nonneg (mul_nonneg hr.le hsin_phi) (mul_nonneg hε hcos_phi)
  refine ⟨q, hq_nonnegative, ?_⟩
  have hcos_sq : (Real.cos phi) ^ 2 + (Real.sin phi) ^ 2 = 1 :=
    Real.cos_sq_add_sin_sq phi
  simp only [twoUserScoreMap]
  rw [hu, hv]
  dsimp [q]
  apply Prod.ext
  · simp [score_content2]
    calc
      Real.cos phi * (r * Real.cos phi - ε * Real.sin phi) +
          Real.sin phi * (r * Real.sin phi + ε * Real.cos phi) =
          ((Real.cos phi) ^ 2 + (Real.sin phi) ^ 2) * r := by ring
      _ = r := by rw [hcos_sq]; ring
  · simp [score_content2, Real.cos_add, Real.sin_add, Real.cos_sub,
      Real.sin_sub]
    calc
      (Real.cos phi * Real.cos theta - Real.sin phi * Real.sin theta) *
            (r * Real.cos phi - ε * Real.sin phi) +
          (Real.sin phi * Real.cos theta + Real.cos phi * Real.sin theta) *
            (r * Real.sin phi + ε * Real.cos phi) =
          Real.cos phi ^ 2 * Real.cos theta * r +
            Real.cos phi ^ 2 * Real.sin theta * ε +
          Real.cos theta * Real.sin phi ^ 2 * r +
            Real.sin phi ^ 2 * Real.sin theta * ε := by ring
      _ =
          ((Real.cos phi) ^ 2 + (Real.sin phi) ^ 2) *
            (r * Real.cos theta + ε * Real.sin theta) := by ring
      _ = r * Real.cos theta + ε * Real.sin theta := by rw [hcos_sq]; ring

/--
At a polar second-user ray, an infinitesimal rotation back toward the first
user yields the original feasible segment that raises only the first score.
The radius cap keeps the second original content coordinate nonnegative.
-/
theorem twoUserScore_originalUpperBoundary_inward_feasible_of_polarUsers
    {u v : Content 2} {phi theta r ε : ℝ}
    (hu : u = content2 (Real.cos phi) (Real.sin phi))
    (hv : v = content2 (Real.cos (phi + theta)) (Real.sin (phi + theta)))
    (hphi : 0 ≤ phi) (htheta : 0 ≤ theta)
    (hphi_theta : phi + theta ≤ Real.pi / 2)
    (hr : 0 < r) (hε : 0 ≤ ε)
    (hε_cap : ε < r * Real.sin (phi + theta)) :
    (r * Real.cos theta + ε * Real.sin theta, r) ∈ twoUserScoreFeasibleSet u v := by
  let psi : ℝ := phi + theta
  let q : Content 2 := content2
    (r * Real.cos psi + ε * Real.sin psi)
    (r * Real.sin psi - ε * Real.cos psi)
  have hpsi_nonnegative : 0 ≤ psi := by dsimp [psi]; linarith
  have hcos_psi : 0 ≤ Real.cos psi := by
    apply Real.cos_nonneg_of_mem_Icc
    refine ⟨by linarith [Real.pi_pos], ?_⟩
    simpa [psi] using hphi_theta
  have hsin_psi : 0 ≤ Real.sin psi :=
    Real.sin_nonneg_of_nonneg_of_le_pi hpsi_nonnegative
      (by linarith [Real.pi_pos, hphi_theta])
  have hq_nonnegative : NonnegativeContent q := by
    intro d
    fin_cases d
    · change 0 ≤ r * Real.cos psi + ε * Real.sin psi
      exact add_nonneg (mul_nonneg hr.le hcos_psi) (mul_nonneg hε hsin_psi)
    · change 0 ≤ r * Real.sin psi - ε * Real.cos psi
      have hcos_le_one : Real.cos psi ≤ 1 := Real.cos_le_one psi
      have hεcos_le : ε * Real.cos psi ≤ ε := by nlinarith
      linarith
  refine ⟨q, hq_nonnegative, ?_⟩
  have hpsi_sq : (Real.cos psi) ^ 2 + (Real.sin psi) ^ 2 = 1 :=
    Real.cos_sq_add_sin_sq psi
  simp only [twoUserScoreMap]
  rw [hu, hv]
  dsimp [q]
  apply Prod.ext
  · simp [score_content2, psi, Real.cos_add, Real.sin_add]
    have hphi_sq : (Real.cos phi) ^ 2 + (Real.sin phi) ^ 2 = 1 :=
      Real.cos_sq_add_sin_sq phi
    have hcos_combo :
        Real.cos phi * (Real.cos phi * Real.cos theta -
          Real.sin phi * Real.sin theta) +
          Real.sin phi * (Real.sin phi * Real.cos theta +
            Real.cos phi * Real.sin theta) = Real.cos theta := by
      calc
        _ = ((Real.cos phi) ^ 2 + (Real.sin phi) ^ 2) * Real.cos theta := by ring
        _ = Real.cos theta := by rw [hphi_sq]; ring
    have hsin_combo :
        Real.cos phi * (Real.sin phi * Real.cos theta +
          Real.cos phi * Real.sin theta) -
          Real.sin phi * (Real.cos phi * Real.cos theta -
            Real.sin phi * Real.sin theta) = Real.sin theta := by
      calc
        _ = ((Real.cos phi) ^ 2 + (Real.sin phi) ^ 2) * Real.sin theta := by ring
        _ = Real.sin theta := by rw [hphi_sq]; ring
    calc
      Real.cos phi *
          (r * (Real.cos phi * Real.cos theta - Real.sin phi * Real.sin theta) +
            ε * (Real.sin phi * Real.cos theta + Real.cos phi * Real.sin theta)) +
          Real.sin phi *
          (r * (Real.sin phi * Real.cos theta + Real.cos phi * Real.sin theta) -
            ε * (Real.cos phi * Real.cos theta - Real.sin phi * Real.sin theta)) =
          r * (Real.cos phi * (Real.cos phi * Real.cos theta -
            Real.sin phi * Real.sin theta) + Real.sin phi *
            (Real.sin phi * Real.cos theta + Real.cos phi * Real.sin theta)) +
          ε * (Real.cos phi * (Real.sin phi * Real.cos theta +
            Real.cos phi * Real.sin theta) - Real.sin phi *
            (Real.cos phi * Real.cos theta - Real.sin phi * Real.sin theta)) := by ring
      _ = r * Real.cos theta + ε * Real.sin theta := by
        rw [hcos_combo, hsin_combo]
  · simp [score_content2]
    calc
      Real.cos psi * (r * Real.cos psi + ε * Real.sin psi) +
          Real.sin psi * (r * Real.sin psi - ε * Real.cos psi) =
          ((Real.cos psi) ^ 2 + (Real.sin psi) ^ 2) * r := by ring
      _ = r := by rw [hpsi_sq]; ring

/--
Original-coordinate realization of the source's local no-gap contradiction.
If aligned open gaps lie immediately below an actual score-support point, a
common positive radial scaling stays in the original nonnegative-content cone,
leaves both iid maximum-CDF rewards unchanged, and strictly lowers induced
cost.  No canonical rotation of the source action cone is used.
-/
theorem twoUserScore_not_sourceNash_of_two_aligned_marginal_open_gaps
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v : Content 2} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    {a b c d t : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hsin : 0 < Real.sin θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 2) β q) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content 2 => score (if i = 0 then u else v) q) μ ≪
        volume)
    (hbd : (b, d) ∈ (Measure.map (twoUserScoreMap u v) μ).support)
    (hα : 0 < α) (hβ : 0 < β)
    (ht : 0 < t) (ht_one : t < 1)
    (hpair : b ≠ 0 ∨ d ≠ 0)
    (hgap1 : Set.Ioo a b ⊆
      (Measure.map (fun q : Content 2 => score u q) μ).supportᶜ)
    (hgap2 : Set.Ioo c d ⊆
      (Measure.map (fun q : Content 2 => score v q) μ).supportᶜ)
    (htb : t * b ∈ Set.Ioo a b)
    (htd : t * d ∈ Set.Ioo c d) :
    False := by
  let μ1 : Measure ℝ := Measure.map (fun q : Content 2 => score u q) μ
  let μ2 : Measure ℝ := Measure.map (fun q : Content 2 => score v q) μ
  letI : IsProbabilityMeasure μ1 :=
    Measure.isProbabilityMeasure_map (measurable_score_content u).aemeasurable
  letI : IsProbabilityMeasure μ2 :=
    Measure.isProbabilityMeasure_map (measurable_score_content v).aemeasurable
  have hac1 : μ1 ≪ volume := by
    simpa [μ1] using hscore_ac (0 : Fin 2)
  have hac2 : μ2 ≪ volume := by
    simpa [μ2] using hscore_ac (1 : Fin 2)
  letI : NoAtoms μ1 := ⟨fun x => hac1 (by simpa using (volume_singleton x))⟩
  letI : NoAtoms μ2 := ⟨fun x => hac2 (by simpa using (volume_singleton x))⟩
  have hcompact_content : IsCompact μ.support :=
    sourceSymmetricMixedNash_isCompact_support_of_compactSublevels_of_scaledNormRpowCost
      (j := Classical.choice inferInstance) hnash hα hβ
      (SourceNorm.l2_compactSublevels 2)
  have hsupport :
      (Measure.map (twoUserScoreMap u v) μ).support =
        twoUserScoreMap u v '' μ.support :=
    twoUserScoreMap_support_eq_image_support_of_isCompact hcompact_content
  rw [hsupport] at hbd
  rcases hbd with ⟨p, hp, hpmap⟩
  have hp_nonnegative : NonnegativeContent p := hnash.2.1 hp
  have hfirst : score u p = b := by
    simpa [twoUserScoreMap] using congrArg Prod.fst hpmap
  have hsecond : score v p = d := by
    simpa [twoUserScoreMap] using congrArg Prod.snd hpmap
  have hscaled_feasible : (t * b, t * d) ∈ twoUserScoreFeasibleSet u v := by
    refine ⟨scaleContent t p, scaleContent_nonnegative ht.le hp_nonnegative, ?_⟩
    simp only [twoUserScoreMap]
    rw [score_scaleContent, score_scaleContent, hfirst, hsecond]
  have hmax :=
    twoUserScoreMap_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      hu hv huv hsin hnash hscore_ac hp
  rw [hpmap] at hmax
  apply twoUser_not_isMaxOn_of_strictScale_same_marginals
    (by simpa [μ1, μ2] using hmax) hscaled_feasible
  · apply AppliedModelingLib.Probability.iidMaximumCdf_eq_of_Ioo_subset_compl_support_of_noAtoms
      μ1 htb.2.le
    intro x hx
    exact hgap1 ⟨lt_trans htb.1 hx.1, hx.2⟩
  · apply AppliedModelingLib.Probability.iidMaximumCdf_eq_of_Ioo_subset_compl_support_of_noAtoms
      μ2 htd.2.le
    intro x hx
    exact hgap2 ⟨lt_trans htd.1 hx.1, hx.2⟩
  · exact twoUserInducedCost_strictScale_lt hα hβ hsin ht ht_one hpair

/--
Original-score version of the compact projection-to-aligned-gap bridge.  Weak
support ordering and two coordinate injections upgrade to strict graph order,
so any represented first-score gap yields an aligned second-score gap.  The
statement retains the actual raw score laws rather than a canonical chart.
-/
theorem twoUserScore_exists_secondScore_gap_of_compact_ordered_support_injOn_snd
    {u v : Content 2} {μ : Measure (Content 2)} {a b d : ℝ}
    (hcompact : IsCompact (Measure.map (twoUserScoreMap u v) μ).support)
    (hinjfst : (Measure.map (twoUserScoreMap u v) μ).support.InjOn Prod.fst)
    (hinjsnd : (Measure.map (twoUserScoreMap u v) μ).support.InjOn Prod.snd)
    (hordered : ∀ p ∈ (Measure.map (twoUserScoreMap u v) μ).support,
      ∀ q ∈ (Measure.map (twoUserScoreMap u v) μ).support,
        p.1 < q.1 → p.2 ≤ q.2)
    (hab : a < b)
    (hgap : Set.Ioo a b ⊆
      (Measure.map (fun q : Content 2 => score u q) μ).supportᶜ)
    (hleft : ∃ p ∈ (Measure.map (twoUserScoreMap u v) μ).support, p.1 ≤ a)
    (hbd : (b, d) ∈ (Measure.map (twoUserScoreMap u v) μ).support) :
    ∃ c : ℝ, c < d ∧ Set.Ioo c d ⊆
      (Measure.map (fun q : Content 2 => score v q) μ).supportᶜ := by
  let ν : Measure (ℝ × ℝ) := Measure.map (twoUserScoreMap u v) μ
  have hmeas : Measurable (twoUserScoreMap u v) :=
    (twoUserScoreMap_continuous u v).measurable
  have hmapfst : Measure.map Prod.fst ν =
      Measure.map (fun q : Content 2 => score u q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_fst hmeas]
    rfl
  have hmapsnd : Measure.map Prod.snd ν =
      Measure.map (fun q : Content 2 => score v q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_snd hmeas]
    rfl
  have hgapν : Set.Ioo a b ⊆ (Measure.map Prod.fst ν).supportᶜ := by
    simpa [hmapfst] using hgap
  obtain ⟨c, hcd, hgap2⟩ :=
    AppliedModelingLib.Probability.exists_snd_support_gap_of_isCompact_of_strict_order_of_fst_support_gap
      (ν := ν) (by simpa [ν] using hcompact) (by simpa [ν] using hinjfst)
      (by
        simpa [ν] using
          AppliedModelingLib.strict_snd_order_of_ordered_snd_of_injOn_snd hordered hinjsnd)
      hab hgapν (by simpa [ν] using hleft) (by simpa [ν] using hbd)
  exact ⟨c, hcd, by simpa [hmapsnd] using hgap2⟩

/--
If the first original raw-score support of a compact two-user score law is
not an interval, there is a witnessed first-coordinate gap with a joint
left witness and a represented joint upper endpoint.
-/
theorem twoUserScore_exists_firstScore_gap_data_of_compact_not_ordConnected_support
    {u v : Content 2} {μ : Measure (Content 2)}
    (hcompact : IsCompact (Measure.map (twoUserScoreMap u v) μ).support)
    (hnot : ¬ Set.OrdConnected
      (Measure.map (fun q : Content 2 => score u q) μ).support) :
    ∃ a b d : ℝ, a < b ∧ Set.Ioo a b ⊆
      (Measure.map (fun q : Content 2 => score u q) μ).supportᶜ ∧
      (∃ p ∈ (Measure.map (twoUserScoreMap u v) μ).support, p.1 ≤ a) ∧
      (b, d) ∈ (Measure.map (twoUserScoreMap u v) μ).support := by
  let ν : Measure (ℝ × ℝ) := Measure.map (twoUserScoreMap u v) μ
  have hmeas : Measurable (twoUserScoreMap u v) :=
    (twoUserScoreMap_continuous u v).measurable
  have hmapfst : Measure.map Prod.fst ν =
      Measure.map (fun q : Content 2 => score u q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_fst hmeas]
    rfl
  have hnotν : ¬ Set.OrdConnected (Measure.map Prod.fst ν).support := by
    simpa only [hmapfst] using hnot
  obtain ⟨a, b, d, hab, hgap, hleft, hbd⟩ :=
    AppliedModelingLib.Probability.exists_fst_support_gap_data_of_isCompact_of_not_ordConnected
      (ν := ν) (by simpa [ν] using hcompact) hnotν
  exact ⟨a, b, d, hab, by simpa [hmapfst] using hgap,
    by simpa [ν] using hleft, by simpa [ν] using hbd⟩

/--
Cone-preserving upper user-ray restriction in the original score coordinates.
If a score pair lies strictly above the ray generated by the second user, its
projection to that ray is implemented by the nonnegative content action
`z₂ • v`.  The first score increases weakly, the second score is unchanged,
and induced cost decreases strictly.  This proves the source cone inequality
without applying the source's non-cone-preserving rotation to canonical users.
-/
theorem twoUserScore_secondUserRay_le_of_isMaxOn_of_mono_firstReward
    {u v : Content 2} {α β θ z1 z2 : ℝ} {H1 H2 : ℝ → ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      (twoUserScoreFeasibleSet u v) (z1, z2))
    (hz2_nonneg : 0 ≤ z2)
    (hv_nonnegative : NonnegativeContent v)
    (hv : score v v = 1) (huv : score u v = Real.cos θ)
    (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hH1 : Monotone H1) :
    Real.cos θ * z2 ≤ z1 := by
  by_contra hnot
  have habove : z1 < Real.cos θ * z2 := lt_of_not_ge hnot
  have hq_feasible : (Real.cos θ * z2, z2) ∈ twoUserScoreFeasibleSet u v := by
    refine ⟨scaleContent z2 v, scaleContent_nonnegative hz2_nonneg hv_nonnegative, ?_⟩
    simp only [twoUserScoreMap]
    rw [score_scaleContent, score_scaleContent, huv, hv]
    ring
  have hdiff_ne : z1 - Real.cos θ * z2 ≠ 0 :=
    sub_ne_zero.mpr (ne_of_lt habove)
  have hdiff_sq_pos : 0 < (z1 - Real.cos θ * z2) ^ 2 :=
    sq_pos_of_ne_zero hdiff_ne
  have hnum_lt :
      twoUserInducedCostNumerator θ (Real.cos θ * z2) z2 <
        twoUserInducedCostNumerator θ z1 z2 := by
    unfold twoUserInducedCostNumerator
    nlinarith
  have hpow_lt :
      (twoUserInducedCostNumerator θ (Real.cos θ * z2) z2) ^ (β / 2) <
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2) :=
    Real.rpow_lt_rpow
      (twoUserInducedCostNumerator_nonneg θ (Real.cos θ * z2) z2)
      hnum_lt (by linarith)
  have hsinpow_pos : 0 < (Real.sin θ) ^ (-β) :=
    Real.rpow_pos_of_pos hsin _
  have hcost_lt :
      twoUserInducedCost α β θ (Real.cos θ * z2) z2 <
        twoUserInducedCost α β θ z1 z2 := by
    unfold twoUserInducedCost
    exact mul_lt_mul_of_pos_left hpow_lt (mul_pos hα hsinpow_pos)
  have hreward_le : H1 z1 ≤ H1 (Real.cos θ * z2) := hH1 habove.le
  have hobjective_lt :
      H1 z1 + H2 z2 - twoUserInducedCost α β θ z1 z2 <
        H1 (Real.cos θ * z2) + H2 z2 -
          twoUserInducedCost α β θ (Real.cos θ * z2) z2 := by
    linarith
  exact (not_lt_of_ge (hmax hq_feasible)) hobjective_lt

/--
Symmetric cone-preserving user-ray restriction in the original score
coordinates.  The feasible projection is the nonnegative action `z₁ • u`.
-/
theorem twoUserScore_firstUserRay_le_of_isMaxOn_of_mono_secondReward
    {u v : Content 2} {α β θ z1 z2 : ℝ} {H1 H2 : ℝ → ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      (twoUserScoreFeasibleSet u v) (z1, z2))
    (hz1_nonneg : 0 ≤ z1)
    (hu_nonnegative : NonnegativeContent u)
    (hu : score u u = 1) (huv : score u v = Real.cos θ)
    (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hH2 : Monotone H2) :
    Real.cos θ * z1 ≤ z2 := by
  by_contra hnot
  have habove : z2 < Real.cos θ * z1 := lt_of_not_ge hnot
  have hvu : score v u = Real.cos θ := by
    rw [score_comm]
    exact huv
  have hq_feasible : (z1, Real.cos θ * z1) ∈ twoUserScoreFeasibleSet u v := by
    refine ⟨scaleContent z1 u, scaleContent_nonnegative hz1_nonneg hu_nonnegative, ?_⟩
    simp only [twoUserScoreMap]
    rw [score_scaleContent, score_scaleContent, hu, hvu]
    ring
  have hdiff_ne : z2 - Real.cos θ * z1 ≠ 0 :=
    sub_ne_zero.mpr (ne_of_lt habove)
  have hdiff_sq_pos : 0 < (z2 - Real.cos θ * z1) ^ 2 :=
    sq_pos_of_ne_zero hdiff_ne
  have hnum_lt :
      twoUserInducedCostNumerator θ z1 (Real.cos θ * z1) <
        twoUserInducedCostNumerator θ z1 z2 := by
    unfold twoUserInducedCostNumerator
    nlinarith
  have hpow_lt :
      (twoUserInducedCostNumerator θ z1 (Real.cos θ * z1)) ^ (β / 2) <
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2) :=
    Real.rpow_lt_rpow
      (twoUserInducedCostNumerator_nonneg θ z1 (Real.cos θ * z1))
      hnum_lt (by linarith)
  have hsinpow_pos : 0 < (Real.sin θ) ^ (-β) :=
    Real.rpow_pos_of_pos hsin _
  have hcost_lt :
      twoUserInducedCost α β θ z1 (Real.cos θ * z1) <
        twoUserInducedCost α β θ z1 z2 := by
    unfold twoUserInducedCost
    exact mul_lt_mul_of_pos_left hpow_lt (mul_pos hα hsinpow_pos)
  have hreward_le : H2 z2 ≤ H2 (Real.cos θ * z1) := hH2 habove.le
  have hobjective_lt :
      H1 z1 + H2 z2 - twoUserInducedCost α β θ z1 z2 <
        H1 z1 + H2 (Real.cos θ * z1) -
          twoUserInducedCost α β θ z1 (Real.cos θ * z1) := by
    linarith
  exact (not_lt_of_ge (hmax hq_feasible)) hobjective_lt

/-- C1 itself supplies the closed user-cone condition used by `regionscolor`.
A support score outside either ray boundary can be improved by the corresponding
user ray, because the other marginal CDF is monotone and induced cost strictly
falls.  This is the source-to-cone bridge in the original score coordinates. -/
theorem twoUser_slope_crossPartial_nonpos_of_isMaxOn_graph
    {u v : Content 2} {H1 H2 g : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    {α β θ a b x g' : ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hH1_mono : Monotone H1) (hH2_mono : Monotone H2)
    (hSnonnegative : ∀ z : ℝ × ℝ, z ∈ S → 0 ≤ z.1 ∧ 0 ≤ z.2)
    (hxI : x ∈ Set.Ioo a b) (hx : 0 < x)
    (hderiv : HasDerivAt g g' x)
    (hgraph : ∀ w ∈ Set.Ioo a b, (w, g w) ∈ S)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) (twoUserScoreFeasibleSet u v) z) :
    g' * twoUserInducedCostCrossPartial α β θ x (g x) ≤ 0 := by
  have hcos : 0 ≤ Real.cos θ := by
    rw [← huv]
    exact score_nonneg_of_nonnegative hu_nonnegative hv_nonnegative
  have hScone : S ⊆ twoUserClosedUserCone θ := by
    intro z hz
    obtain ⟨hz1, hz2⟩ := hSnonnegative z hz
    constructor
    · exact twoUserScore_secondUserRay_le_of_isMaxOn_of_mono_firstReward
        (hmax z hz) hz2 hv_nonnegative hv huv hα hβ hsin hH1_mono
    · exact twoUserScore_firstUserRay_le_of_isMaxOn_of_mono_secondReward
        (hmax z hz) hz1 hu_nonnegative hu huv hα hβ hsin hH2_mono
  exact twoUser_slope_crossPartial_nonpos_of_isMaxOn_graph_of_cone
    hu_nonnegative hv_nonnegative hu hv huv hα hβ hsin hcos hxI hx hderiv hgraph hScone hmax

/-- Literal C1-graph form of `regionscolor`.  The support-score nonnegativity
and monotonicity of the two source CDFs derive the closed cone, rather than
being added as a separate geometric hypothesis. -/
theorem twoUser_regionscolor_param_bracket_nonpos_of_C1_graph
    {u v : Content 2} {H1 H2 g : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    {α β θ φ r a b x slope : ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hH1_mono : Monotone H1) (hH2_mono : Monotone H2)
    (hSnonnegative : ∀ z : ℝ × ℝ, z ∈ S → 0 ≤ z.1 ∧ 0 ≤ z.2)
    (hxI : x ∈ Set.Ioo a b)
    (hxparam : x = r * Real.cos φ)
    (hgparam : g x = r * Real.cos (θ - φ))
    (hderiv : HasDerivAt g slope x)
    (hgraph : ∀ w ∈ Set.Ioo a b, (w, g w) ∈ S)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) (twoUserScoreFeasibleSet u v) z) :
    slope * twoUserSecondDerivSignBracket β θ φ ≤ 0 := by
  have hx : 0 < x := by
    by_contra hnot
    have hxnonpos : x ≤ 0 := le_of_not_gt hnot
    let y : ℝ := (a + x) / 2
    have hyI : y ∈ Set.Ioo a b := by
      constructor <;> dsimp [y] <;> linarith [hxI.1, hxI.2]
    have hy_nonnegative := (hSnonnegative (y, g y) (hgraph y hyI)).1
    dsimp [y] at hy_nonnegative
    linarith [hxI.1]
  have hr : r ≠ 0 := by
    intro hr
    rw [hr, zero_mul] at hxparam
    linarith
  have hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2 :=
    mul_pos (sq_pos_of_ne_zero hr) (sq_pos_of_pos hsin)
  apply twoUser_regionscolor_param_bracket_nonpos_of_cross_nonpos
    hα hβ hsin hNpos
  have hcross := twoUser_slope_crossPartial_nonpos_of_isMaxOn_graph
    hu_nonnegative hv_nonnegative hu hv huv hα hβ hsin hH1_mono hH2_mono hSnonnegative
    hxI hx hderiv hgraph hmax
  rw [hgparam, hxparam] at hcross
  exact hcross

/--
Arbitrary-dimensional, cone-safe first score inequality at a support action.
If the second user ray would weakly preserve its own score and strictly raise
the first score, its Euclidean norm is strictly smaller unless the two score
points agree.  Thus it is a genuine profitable source-model deviation.  This
avoids the false arbitrary-dimensional equality between the Gram quadratic
and the constrained nonnegative-fibre cost.
-/
theorem twoUserScore_secondUserRay_le_of_scaledNormRpowCostNash_any_dim
    {D P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v p : Content D} {μ : Measure (Content D)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 D) β q) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) μ ≪ volume)
    (hp : p ∈ μ.support) :
    Real.cos θ * score v p ≤ score u p := by
  by_contra hnot
  have habove : score u p < Real.cos θ * score v p := lt_of_not_ge hnot
  have hp_nonnegative : NonnegativeContent p := hnash.2.1 hp
  have hz2_nonnegative : 0 ≤ score v p :=
    score_nonneg_of_nonnegative hv_nonnegative hp_nonnegative
  let q : Content D := scaleContent (score v p) v
  have hq_nonnegative : NonnegativeContent q := by
    exact scaleContent_nonnegative hz2_nonnegative hv_nonnegative
  have hscore_vq : score v q = score v p := by
    dsimp [q]
    rw [score_scaleContent, hv]
    ring
  have hscore_uq : score u q = Real.cos θ * score v p := by
    dsimp [q]
    rw [score_scaleContent, huv]
    ring
  have hpq_ne : p ≠ q := by
    intro hpq
    have hscore_eq : score u p = score u q := congrArg (fun r => score u r) hpq
    rw [hscore_uq] at hscore_eq
    linarith
  have hresidual_exists : ∃ d, (p - q) d ≠ 0 := by
    by_contra hzero
    push_neg at hzero
    apply hpq_ne
    ext d
    exact sub_eq_zero.mp (hzero d)
  have hresidual_norm_pos : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 (p - q) :=
    AppliedModelingLib.FiniteDimensionalNorms.normL2_pos_of_exists_ne_zero hresidual_exists
  have hresidual_pos : 0 < score (p - q) (p - q) := by
    rw [score_self_eq_l2_sq]
    positivity
  have hscore_pv : score p v = score v p := by rw [score_comm]
  have hresidual_eq :
      score (p - q) (p - q) = score p p - (score v p) ^ 2 := by
    dsimp [q]
    simp_rw [score_sub_left, score_sub, score_scaleContent, score_scaleUser]
    rw [hscore_pv, hv]
    ring
  have hself_lt : (score v p) ^ 2 < score p p := by
    rw [hresidual_eq] at hresidual_pos
    linarith
  have hnorm_p_gt : score v p < AppliedModelingLib.FiniteDimensionalNorms.l2 p := by
    rw [score_self_eq_l2_sq] at hself_lt
    nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p]
  have hv_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 v = 1 := by
    rw [score_self_eq_l2_sq] at hv
    nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg v]
  have hq_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 q = score v p := by
    dsimp [q]
    have hscale := AppliedModelingLib.FiniteDimensionalNorms.normL2_smul (a := score v p) v
    simpa [scaleContent, abs_of_nonneg hz2_nonnegative, hv_norm] using hscale
  have hpow_lt :
      AppliedModelingLib.FiniteDimensionalNorms.l2 q ^ β <
        AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ β := by
    rw [hq_norm]
    exact Real.rpow_lt_rpow hz2_nonnegative hnorm_p_gt hβ
  have hcost_lt :
      α * normRpowCost (SourceNorm.l2 D) β q <
        α * normRpowCost (SourceNorm.l2 D) β p := by
    simpa [normRpowCost, SourceNorm.l2] using
      (mul_lt_mul_of_pos_left hpow_lt hα)
  let j : Fin P := Classical.choice inferInstance
  have hmax := hnash.2.2 j p hp q hq_nonnegative
  rw [twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
    (users := fun i : Fin 2 => if i = 0 then u else v)
    q (fun _ => measurable_score_content _) hscore_ac,
    twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
      (users := fun i : Fin 2 => if i = 0 then u else v)
      p (fun _ => measurable_score_content _) hscore_ac] at hmax
  letI : IsProbabilityMeasure
      (Measure.map (fun r : Content D => score u r) μ) :=
    Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
  have hscore_u_le : score u p ≤ score u q := by
    rw [hscore_uq]
    exact habove.le
  have hreward_le :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score u r) μ) (score u p) ≤
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score u r) μ) (score u q) :=
    AppliedModelingLib.Probability.iidMaximumCdf_mono
      (n := P - 1) (Measure.map (fun r : Content D => score u r) μ) hscore_u_le
  have hobjective_lt :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score u r) μ) (score u p) +
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score v r) μ) (score v p) -
        α * normRpowCost (SourceNorm.l2 D) β p <
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score u r) μ) (score u q) +
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score v r) μ) (score v q) -
        α * normRpowCost (SourceNorm.l2 D) β q := by
    rw [hscore_vq]
    linarith
  simpa only [Fin.isValue, ↓reduceIte] using (not_lt_of_ge hmax hobjective_lt)

/--
Arbitrary-dimensional, cone-safe second score inequality at a support action.
This is the user-swapped companion of
`twoUserScore_secondUserRay_le_of_scaledNormRpowCostNash_any_dim`, proved in
the original population ordering so no user-label transport is hidden.
-/
theorem twoUserScore_firstUserRay_le_of_scaledNormRpowCostNash_any_dim
    {D P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v p : Content D} {μ : Measure (Content D)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 D) β q) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) μ ≪ volume)
    (hp : p ∈ μ.support) :
    Real.cos θ * score u p ≤ score v p := by
  by_contra hnot
  have habove : score v p < Real.cos θ * score u p := lt_of_not_ge hnot
  have hp_nonnegative : NonnegativeContent p := hnash.2.1 hp
  have hz1_nonnegative : 0 ≤ score u p :=
    score_nonneg_of_nonnegative hu_nonnegative hp_nonnegative
  let q : Content D := scaleContent (score u p) u
  have hq_nonnegative : NonnegativeContent q := by
    exact scaleContent_nonnegative hz1_nonnegative hu_nonnegative
  have hscore_uq : score u q = score u p := by
    dsimp [q]
    rw [score_scaleContent, hu]
    ring
  have hscore_vq : score v q = Real.cos θ * score u p := by
    dsimp [q]
    rw [score_scaleContent]
    have hvu : score v u = Real.cos θ := by
      rw [score_comm]
      exact huv
    rw [hvu]
    ring
  have hpq_ne : p ≠ q := by
    intro hpq
    have hscore_eq : score v p = score v q := congrArg (fun r => score v r) hpq
    rw [hscore_vq] at hscore_eq
    linarith
  have hresidual_exists : ∃ d, (p - q) d ≠ 0 := by
    by_contra hzero
    push_neg at hzero
    apply hpq_ne
    ext d
    exact sub_eq_zero.mp (hzero d)
  have hresidual_norm_pos : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 (p - q) :=
    AppliedModelingLib.FiniteDimensionalNorms.normL2_pos_of_exists_ne_zero hresidual_exists
  have hresidual_pos : 0 < score (p - q) (p - q) := by
    rw [score_self_eq_l2_sq]
    positivity
  have hscore_pu : score p u = score u p := by rw [score_comm]
  have hresidual_eq :
      score (p - q) (p - q) = score p p - (score u p) ^ 2 := by
    dsimp [q]
    simp_rw [score_sub_left, score_sub, score_scaleContent, score_scaleUser]
    rw [hscore_pu, hu]
    ring
  have hself_lt : (score u p) ^ 2 < score p p := by
    rw [hresidual_eq] at hresidual_pos
    linarith
  have hnorm_p_gt : score u p < AppliedModelingLib.FiniteDimensionalNorms.l2 p := by
    rw [score_self_eq_l2_sq] at hself_lt
    nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p]
  have hu_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 u = 1 := by
    rw [score_self_eq_l2_sq] at hu
    nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg u]
  have hq_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 q = score u p := by
    dsimp [q]
    have hscale := AppliedModelingLib.FiniteDimensionalNorms.normL2_smul (a := score u p) u
    simpa [scaleContent, abs_of_nonneg hz1_nonnegative, hu_norm] using hscale
  have hpow_lt :
      AppliedModelingLib.FiniteDimensionalNorms.l2 q ^ β <
        AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ β := by
    rw [hq_norm]
    exact Real.rpow_lt_rpow hz1_nonnegative hnorm_p_gt hβ
  have hcost_lt :
      α * normRpowCost (SourceNorm.l2 D) β q <
        α * normRpowCost (SourceNorm.l2 D) β p := by
    simpa [normRpowCost, SourceNorm.l2] using
      (mul_lt_mul_of_pos_left hpow_lt hα)
  let j : Fin P := Classical.choice inferInstance
  have hmax := hnash.2.2 j p hp q hq_nonnegative
  rw [twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
    (users := fun i : Fin 2 => if i = 0 then u else v)
    q (fun _ => measurable_score_content _) hscore_ac,
    twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
      (users := fun i : Fin 2 => if i = 0 then u else v)
      p (fun _ => measurable_score_content _) hscore_ac] at hmax
  letI : IsProbabilityMeasure
      (Measure.map (fun r : Content D => score v r) μ) :=
    Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
  have hscore_v_le : score v p ≤ score v q := by
    rw [hscore_vq]
    exact habove.le
  have hreward_le :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score v r) μ) (score v p) ≤
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score v r) μ) (score v q) :=
    AppliedModelingLib.Probability.iidMaximumCdf_mono
      (n := P - 1) (Measure.map (fun r : Content D => score v r) μ) hscore_v_le
  have hobjective_lt :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score u r) μ) (score u p) +
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score v r) μ) (score v p) -
        α * normRpowCost (SourceNorm.l2 D) β p <
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score u r) μ) (score u q) +
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content D => score v r) μ) (score v q) -
        α * normRpowCost (SourceNorm.l2 D) β q := by
    rw [hscore_uq]
    linarith
  simpa only [Fin.isValue, ↓reduceIte] using (not_lt_of_ge hmax hobjective_lt)

/--
The two original user-ray deviations give the full closed score cone in every
finite ambient dimension.  This is the valid arbitrary-dimensional C1
replacement for the paper's false nonnegative-fibre induced-cost identity.
-/
theorem twoUserScore_closedUserCone_of_scaledNormRpowCostNash_any_dim
    {D P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v p : Content D} {μ : Measure (Content D)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 D) β q) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) μ ≪ volume)
    (hp : p ∈ μ.support) :
    Real.cos θ * score v p ≤ score u p ∧
      Real.cos θ * score u p ≤ score v p := by
  exact ⟨twoUserScore_secondUserRay_le_of_scaledNormRpowCostNash_any_dim
      hu hv huv hu_nonnegative hv_nonnegative hα hβ hnash hscore_ac hp,
    twoUserScore_firstUserRay_le_of_scaledNormRpowCostNash_any_dim
      hu hv huv hu_nonnegative hv_nonnegative hα hβ hnash hscore_ac hp⟩

/--
The paper's Gram induced-cost formula is exact at every arbitrary-dimensional
Nash support action.  C1 first puts the score pair in the closed user cone,
where a nonnegative conic representative attains the Gram quadratic.  Nash
optimality rules out the original action having strictly larger norm because
the representative has exactly the same two rewards.  This repairs the false
printed fibre equality at precisely the equilibrium-support boundary used by
the phase-transition proof.
-/
theorem twoUserInducedCostQuadratic_eq_score_self_of_scaledNormRpowCostNash_support_any_dim
    {D P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v p : Content D} {μ : Measure (Content D)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β) (hsin : Real.sin θ ≠ 0)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 D) β q) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) μ ≪ volume)
    (hp : p ∈ μ.support) :
    twoUserInducedCostQuadratic θ (score u p) (score v p) = score p p := by
  have hcone := twoUserScore_closedUserCone_of_scaledNormRpowCostNash_any_dim
    hu hv huv hu_nonnegative hv_nonnegative hα hβ hnash hscore_ac hp
  obtain ⟨q, hq_nonnegative, hscore_uq, hscore_vq, hscore_qq⟩ :=
    exists_twoUserClosedUserCone_nonnegative_representative_any_dim
      hu_nonnegative hv_nonnegative hu hv huv hsin
      (z := (score u p, score v p)) (by
        simpa [twoUserClosedUserCone] using hcone)
  let j : Fin P := Classical.choice inferInstance
  have hmax := hnash.2.2 j p hp q hq_nonnegative
  rw [twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
    (users := fun i : Fin 2 => if i = 0 then u else v)
    q (fun _ => measurable_score_content _) hscore_ac,
    twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
      (users := fun i : Fin 2 => if i = 0 then u else v)
      p (fun _ => measurable_score_content _) hscore_ac] at hmax
  simp at hmax
  rw [hscore_uq, hscore_vq] at hmax
  simp only [Prod.fst, Prod.snd] at hmax
  have hcost_le :
      normRpowCost (SourceNorm.l2 D) β p ≤
        normRpowCost (SourceNorm.l2 D) β q := by
    nlinarith [hα]
  have hpow_le :
      AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ β ≤
        AppliedModelingLib.FiniteDimensionalNorms.l2 q ^ β := by
    simpa [normRpowCost, SourceNorm.l2] using hcost_le
  have hnorm_le :
      AppliedModelingLib.FiniteDimensionalNorms.l2 p ≤
        AppliedModelingLib.FiniteDimensionalNorms.l2 q := by
    by_contra hnot
    have hlt : AppliedModelingLib.FiniteDimensionalNorms.l2 q <
        AppliedModelingLib.FiniteDimensionalNorms.l2 p := lt_of_not_ge hnot
    have hrpow_lt := Real.rpow_lt_rpow
      (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg q) hlt hβ
    exact (not_lt_of_ge hpow_le) hrpow_lt
  have hself_le : score p p ≤ score q q := by
    rw [score_self_eq_l2_sq, score_self_eq_l2_sq]
    nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p,
      AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg q]
  have hquadratic_le :
      twoUserInducedCostQuadratic θ (score u p) (score v p) ≤ score p p :=
    twoUserInducedCostQuadratic_le_score_self_of_unit_score_pair
      hu hv huv hsin
  apply le_antisymm hquadratic_le
  rw [← hscore_qq]
  exact hself_le

/--
Every arbitrary-dimensional Nash support action actually lies in the
nonnegative conic hull of the two original users.  The closed-cone score
inequalities make the inverse-Gram coefficients nonnegative, and the exact
support cost identity rules out any orthogonal residual.  This is the
cone-preserving replacement for the paper's unsupported orthogonal rotation.
-/
theorem exists_twoUser_nonnegative_conic_representation_of_scaledNormRpowCostNash_support_any_dim
    {D P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v p : Content D} {μ : Measure (Content D)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β) (hsin : Real.sin θ ≠ 0)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 D) β q) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) μ ≪ volume)
    (hp : p ∈ μ.support) :
    ∃ a b : ℝ, 0 ≤ a ∧ 0 ≤ b ∧
      p = scaleContent a u + scaleContent b v := by
  have hcone := twoUserScore_closedUserCone_of_scaledNormRpowCostNash_any_dim
    hu hv huv hu_nonnegative hv_nonnegative hα hβ hnash hscore_ac hp
  have hsin_sq_pos : 0 < (Real.sin θ) ^ 2 := sq_pos_of_ne_zero hsin
  let a : ℝ := (score u p - Real.cos θ * score v p) / (Real.sin θ) ^ 2
  let b : ℝ := (score v p - Real.cos θ * score u p) / (Real.sin θ) ^ 2
  have ha_nonnegative : 0 ≤ a := by
    dsimp [a]
    exact div_nonneg (by linarith [hcone.1]) hsin_sq_pos.le
  have hb_nonnegative : 0 ≤ b := by
    dsimp [b]
    exact div_nonneg (by linarith [hcone.2]) hsin_sq_pos.le
  let q : Content D := scaleContent a u + scaleContent b v
  have hvu : score v u = Real.cos θ := by
    rw [score_comm]
    exact huv
  have hscore_uq : score u q = score u p := by
    dsimp [q]
    rw [score_add, score_scaleContent, score_scaleContent, hu, huv]
    dsimp [a, b]
    field_simp [hsin]
    linear_combination -(score u p) * (Real.sin_sq_add_cos_sq θ)
  have hscore_vq : score v q = score v p := by
    dsimp [q]
    rw [score_add, score_scaleContent, score_scaleContent, hvu, hv]
    dsimp [a, b]
    field_simp [hsin]
    linear_combination -(score v p) * (Real.sin_sq_add_cos_sq θ)
  have hscore_qq :
      score q q = twoUserInducedCostQuadratic θ (score u p) (score v p) := by
    have hspan : score q q = a * score u q + b * score v q := by
      rw [show q = scaleContent a u + scaleContent b v by rfl,
        score_add_left, score_scaleUser, score_scaleUser]
    rw [hspan, hscore_uq, hscore_vq]
    dsimp [a, b]
    unfold twoUserInducedCostQuadratic twoUserInducedCostNumerator
    field_simp [hsin]
    ring
  have hscore_pp :
      score p p = twoUserInducedCostQuadratic θ (score u p) (score v p) := by
    symm
    exact
      twoUserInducedCostQuadratic_eq_score_self_of_scaledNormRpowCostNash_support_any_dim
        hu hv huv hu_nonnegative hv_nonnegative hα hβ hsin hnash hscore_ac hp
  have hscore_pq : score p q = score q q := by
    calc
      score p q = a * score p u + b * score p v := by
        dsimp [q]
        rw [score_add, score_scaleContent, score_scaleContent]
      _ = a * score u p + b * score v p := by rw [score_comm p u, score_comm p v]
      _ = a * score u q + b * score v q := by rw [hscore_uq, hscore_vq]
      _ = score q q := by
        rw [show q = scaleContent a u + scaleContent b v by rfl,
          score_add_left, score_scaleUser, score_scaleUser]
  have hresidual_self : score (p - q) (p - q) = 0 := by
    simp_rw [score_sub_left, score_sub]
    rw [score_comm q p, hscore_pq, hscore_pp, hscore_qq]
    ring
  have hresidual_zero : p - q = 0 := by
    by_contra hne
    have hexists : ∃ d, (p - q) d ≠ 0 := by
      by_contra hnot
      push_neg at hnot
      exact hne (funext hnot)
    have hnorm_pos :=
      AppliedModelingLib.FiniteDimensionalNorms.normL2_pos_of_exists_ne_zero hexists
    have hself_pos : 0 < score (p - q) (p - q) := by
      rw [score_self_eq_l2_sq]
      positivity
    rw [hresidual_self] at hself_pos
    exact (lt_irrefl 0) hself_pos
  exact ⟨a, b, ha_nonnegative, hb_nonnegative,
    sub_eq_zero.mp hresidual_zero⟩

/--
Source-Nash consequence of the two original-coordinate user-ray projections.
Every support action has a score pair in the closed cone between the two user
rays.  This uses only the original nonnegative users and their actual
nonnegative-content feasible set; it does not rotate that cone to canonical
coordinates.
-/
theorem twoUserScore_closedUserCone_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v p : Content 2} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 2) β q) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content 2 => score (if i = 0 then u else v) q) μ ≪ volume)
    (hp : p ∈ μ.support) :
    Real.cos θ * score v p ≤ score u p ∧
      Real.cos θ * score u p ≤ score v p := by
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score u q) μ) :=
    Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score v q) μ) :=
    Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
  have hp_nonnegative : NonnegativeContent p := hnash.2.1 hp
  have hz1_nonneg : 0 ≤ score u p :=
    score_nonneg_of_nonnegative hu_nonnegative hp_nonnegative
  have hz2_nonneg : 0 ≤ score v p :=
    score_nonneg_of_nonnegative hv_nonnegative hp_nonnegative
  have hmax :=
    twoUserScoreMap_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      hu hv huv hsin hnash hscore_ac hp
  constructor
  · exact twoUserScore_secondUserRay_le_of_isMaxOn_of_mono_firstReward hmax
      hz2_nonneg hv_nonnegative hv huv hα hβ hsin
      (AppliedModelingLib.Probability.iidMaximumCdf_mono
        (n := P - 1) (Measure.map (fun q : Content 2 => score u q) μ))
  · exact twoUserScore_firstUserRay_le_of_isMaxOn_of_mono_secondReward hmax
      hz1_nonneg hu_nonnegative hu huv hα hβ hsin
      (AppliedModelingLib.Probability.iidMaximumCdf_mono
        (n := P - 1) (Measure.map (fun q : Content 2 => score v q) μ))

/--
The C1 score ordering in Proposition `uniqueness`, stated directly for two
actions in the equilibrium support of the original nonnegative-content model.
The ordering is proved through the closed cone generated by the original user
rays, whose coordinatewise meet and join are genuine feasible deviations.
-/
theorem twoUserScore_ordered_snd_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v p q : Content 2} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun r => α * normRpowCost (SourceNorm.l2 2) β r) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun r : Content 2 => score (if i = 0 then u else v) r) μ ≪ volume)
    (hp : p ∈ μ.support) (hq : q ∈ μ.support)
    (hpq : score u p < score u q) :
    score v p ≤ score v q := by
  let S : Set (ℝ × ℝ) := twoUserScoreMap u v '' μ.support
  have hScone : S ⊆ twoUserClosedUserCone θ := by
    rintro z ⟨r, hr, rfl⟩
    simpa [twoUserScoreMap, twoUserClosedUserCone] using
      (twoUserScore_closedUserCone_of_scaledNormRpowCostNash
        hu hv huv hu_nonnegative hv_nonnegative hα hβ hsin hnash hscore_ac hr)
  have hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn
        (fun w : ℝ × ℝ =>
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun r : Content 2 => score u r) μ) w.1 +
            AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun r : Content 2 => score v r) μ) w.2 -
            twoUserInducedCost α β θ w.1 w.2)
        (twoUserScoreFeasibleSet u v) z := by
    rintro z ⟨r, hr, rfl⟩
    exact twoUserScoreMap_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      hu hv huv hsin hnash hscore_ac hr
  have hordered := twoUserScore_ordered_snd_of_isMaxOn_of_crossPartial_neg
    (u := u) (v := v) (α := α) (β := β) (θ := θ)
    (H1 := fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
      (Measure.map (fun r : Content 2 => score u r) μ) z)
    (H2 := fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
      (Measure.map (fun r : Content 2 => score v r) μ) z)
    hu_nonnegative hv_nonnegative hu hv huv hsin hcos hScone hmax hbase hcross
  exact hordered (twoUserScoreMap u v p) ⟨p, hp, rfl⟩
    (twoUserScoreMap u v q) ⟨q, hq, rfl⟩ hpq

/--
Original-coordinate first C1 equation at a support action strictly between
the two user rays.  Strict user-cone membership supplies a genuine open
neighborhood of score-feasible deviations, so this is an ordinary Fermat
identity rather than a boundary condition.
-/
theorem twoUserScore_firstPartial_eq_iidMaximumCdf_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ h1 : ℝ}
    {u v p : Content 2} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hsin : 0 < Real.sin θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun r => α * normRpowCost (SourceNorm.l2 2) β r) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun r : Content 2 => score (if i = 0 then u else v) r) μ ≪ volume)
    (hp : p ∈ μ.support)
    (hstrict1 : Real.cos θ * score v p < score u p)
    (hstrict2 : Real.cos θ * score u p < score v p)
    (hderiv : HasDerivAt
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun r : Content 2 => score u r) μ) x)
      h1 (score u p))
    (hbase : twoUserInducedCostNumerator θ (score u p) (score v p) ≠ 0 ∨
      1 ≤ β / 2 - 1) :
    β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ (score u p) (score v p)) ^ (β / 2 - 1) *
        (score u p - score v p * Real.cos θ) = h1 := by
  have hmax := twoUserScoreMap_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
    hu hv huv hsin hnash hscore_ac hp
  exact twoUserInducedCostFirstPartial_eq_of_isMaxOn_of_mem_nhds hmax
    (twoUserScoreFeasibleSet_mem_nhds_of_closedUserCone_strict
      hu_nonnegative hv_nonnegative hu hv huv hsin hstrict1 hstrict2)
    hderiv hbase

/--
Original-coordinate second C1 equation at a support action strictly between
the two user rays.  This is the coordinate-swapped Fermat consequence of the
same actual score-feasible neighborhood.
-/
theorem twoUserScore_secondPartial_eq_iidMaximumCdf_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ h2 : ℝ}
    {u v p : Content 2} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hsin : 0 < Real.sin θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun r => α * normRpowCost (SourceNorm.l2 2) β r) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun r : Content 2 => score (if i = 0 then u else v) r) μ ≪ volume)
    (hp : p ∈ μ.support)
    (hstrict1 : Real.cos θ * score v p < score u p)
    (hstrict2 : Real.cos θ * score u p < score v p)
    (hderiv : HasDerivAt
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun r : Content 2 => score v r) μ) x)
      h2 (score v p))
    (hbase : twoUserInducedCostNumerator θ (score u p) (score v p) ≠ 0 ∨
      1 ≤ β / 2 - 1) :
    β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ (score u p) (score v p)) ^ (β / 2 - 1) *
        (score v p - score u p * Real.cos θ) = h2 := by
  have hmax := twoUserScoreMap_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
    hu hv huv hsin hnash hscore_ac hp
  exact twoUserInducedCostSecondPartial_eq_of_isMaxOn_of_mem_nhds hmax
    (twoUserScoreFeasibleSet_mem_nhds_of_closedUserCone_strict
      hu_nonnegative hv_nonnegative hu hv huv hsin hstrict1 hstrict2)
    hderiv hbase

/--
The original-score support has injective first and second projections once
every nonzero support action is strictly between the two user rays.  The proof
combines the original-coordinate C1 equations with the positive-score
cross-partial argument; it does not appeal to a cone-changing canonical map.
-/
theorem twoUserScoreSupport_injOn_projections_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v : Content 2} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun r => α * normRpowCost (SourceNorm.l2 2) β r) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun r : Content 2 => score (if i = 0 then u else v) r) μ ≪ volume)
    (hstrict : ∀ p : Content 2, p ∈ μ.support → p ≠ 0 →
      Real.cos θ * score v p < score u p ∧
        Real.cos θ * score u p < score v p)
    (hcross : ∀ z1 z2 : ℝ, 0 < z1 → 0 < z2 →
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hderiv1 : ∀ p : Content 2, p ∈ μ.support → p ≠ 0 →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content 2 => score u r) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content 2 => score u r) μ) x) (score u p))
        (score u p))
    (hderiv2 : ∀ p : Content 2, p ∈ μ.support → p ≠ 0 →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content 2 => score v r) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content 2 => score v r) μ) x) (score v p))
        (score v p)) :
    (twoUserScoreMap u v '' μ.support).InjOn Prod.fst ∧
      (twoUserScoreMap u v '' μ.support).InjOn Prod.snd := by
  let S : Set (ℝ × ℝ) := twoUserScoreMap u v '' μ.support
  have hpositive : ∀ z : ℝ × ℝ, z ∈ S → z ≠ (0, 0) →
      0 < z.1 ∧ 0 < z.2 := by
    rintro z ⟨p, hp, rfl⟩ hne
    have hpne : p ≠ 0 := by
      intro hpzero
      apply hne
      subst p
      simp [twoUserScoreMap, score]
    rcases hstrict p hp hpne with ⟨hstrict1, hstrict2⟩
    exact twoUserClosedUserCone_strict_pos (z := twoUserScoreMap u v p) hsin hcos
      (by simpa [twoUserScoreMap] using hstrict1)
      (by simpa [twoUserScoreMap] using hstrict2)
  have hzero_fst : ∀ z : ℝ × ℝ, z ∈ S → z.1 = 0 → z = (0, 0) := by
    rintro z ⟨p, hp, rfl⟩ hz1
    by_cases hpzero : p = 0
    · subst p
      simp [twoUserScoreMap, score]
    · rcases hstrict p hp hpzero with ⟨hstrict1, hstrict2⟩
      have hpos := twoUserClosedUserCone_strict_pos (z := twoUserScoreMap u v p)
        hsin hcos (by simpa [twoUserScoreMap] using hstrict1)
        (by simpa [twoUserScoreMap] using hstrict2)
      have hpos1 : 0 < score u p := by
        simpa [twoUserScoreMap] using hpos.1
      simp only [twoUserScoreMap] at hz1
      exact False.elim (by linarith [hpos1])
  have hzero_snd : ∀ z : ℝ × ℝ, z ∈ S → z.2 = 0 → z = (0, 0) := by
    rintro z ⟨p, hp, rfl⟩ hz2
    by_cases hpzero : p = 0
    · subst p
      simp [twoUserScoreMap, score]
    · rcases hstrict p hp hpzero with ⟨hstrict1, hstrict2⟩
      have hpos := twoUserClosedUserCone_strict_pos (z := twoUserScoreMap u v p)
        hsin hcos (by simpa [twoUserScoreMap] using hstrict1)
        (by simpa [twoUserScoreMap] using hstrict2)
      have hpos2 : 0 < score v p := by
        simpa [twoUserScoreMap] using hpos.2
      simp only [twoUserScoreMap] at hz2
      exact False.elim (by linarith [hpos2])
  constructor
  · apply twoUser_support_injOn_fst_of_common_firstPartial_of_crossPartial_neg_pos_awayOrigin
      hsin.ne' hcross hpositive hzero_fst
    rintro z ⟨p, hp, rfl⟩ hne
    have hpne : p ≠ 0 := by
      intro hpzero
      apply hne
      subst p
      simp [twoUserScoreMap, score]
    rcases hstrict p hp hpne with ⟨hstrict1, hstrict2⟩
    exact twoUserScore_firstPartial_eq_iidMaximumCdf_of_scaledNormRpowCostNash
      hu hv huv hu_nonnegative hv_nonnegative hsin hnash hscore_ac hp hstrict1 hstrict2
      (hderiv1 p hp hpne)
      (Or.inl (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne'
        (Or.inl (hpositive (twoUserScoreMap u v p) ⟨p, hp, rfl⟩ hne).1.ne')))
  · apply twoUser_support_injOn_snd_of_common_secondPartial_of_crossPartial_neg_pos_awayOrigin
      hsin.ne' hcross hpositive hzero_snd
    rintro z ⟨p, hp, rfl⟩ hne
    have hpne : p ≠ 0 := by
      intro hpzero
      apply hne
      subst p
      simp [twoUserScoreMap, score]
    rcases hstrict p hp hpne with ⟨hstrict1, hstrict2⟩
    exact twoUserScore_secondPartial_eq_iidMaximumCdf_of_scaledNormRpowCostNash
      hu hv huv hu_nonnegative hv_nonnegative hsin hnash hscore_ac hp hstrict1 hstrict2
      (hderiv2 p hp hpne)
      (Or.inl (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne'
        (Or.inr (hpositive (twoUserScoreMap u v p) ⟨p, hp, rfl⟩ hne).2.ne')))

/--
Original-coordinate no-gap conclusion for the first raw-score support.  Once
strict original-cone support gives the two projection injections and an
explicit global score ordering is available, compactness turns any first-score
gap into aligned marginal gaps.  Radial scaling of the represented original
content action then contradicts Nash.  The strict-cone and differentiability
hypotheses are deliberately explicit: this theorem does not derive boundary
regularity from the source's smooth-CDF prose.
-/
theorem twoUserScore_firstScoreSupport_ordConnected_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v : Content 2} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hα : 0 < α) (hβ : 0 < β)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun r => α * normRpowCost (SourceNorm.l2 2) β r) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun r : Content 2 => score (if i = 0 then u else v) r) μ ≪ volume)
    (hordered : ∀ p : Content 2, p ∈ μ.support →
      ∀ q : Content 2, q ∈ μ.support →
        score u p < score u q → score v p ≤ score v q)
    (hstrict : ∀ p : Content 2, p ∈ μ.support → p ≠ 0 →
      Real.cos θ * score v p < score u p ∧
        Real.cos θ * score u p < score v p)
    (hcross : ∀ z1 z2 : ℝ, 0 < z1 → 0 < z2 →
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hderiv1 : ∀ p : Content 2, p ∈ μ.support → p ≠ 0 →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content 2 => score u r) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content 2 => score u r) μ) x) (score u p))
        (score u p))
    (hderiv2 : ∀ p : Content 2, p ∈ μ.support → p ≠ 0 →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content 2 => score v r) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun r : Content 2 => score v r) μ) x) (score v p))
        (score v p)) :
    Set.OrdConnected
      (Measure.map (fun r : Content 2 => score u r) μ).support := by
  by_contra hnot
  have hcompact_content : IsCompact μ.support :=
    sourceSymmetricMixedNash_isCompact_support_of_compactSublevels_of_scaledNormRpowCost
      (j := Classical.choice inferInstance) hnash hα hβ
      (SourceNorm.l2_compactSublevels 2)
  have hsupport :
      (Measure.map (twoUserScoreMap u v) μ).support =
        twoUserScoreMap u v '' μ.support :=
    twoUserScoreMap_support_eq_image_support_of_isCompact hcompact_content
  have hcompact : IsCompact (Measure.map (twoUserScoreMap u v) μ).support :=
    twoUserScoreMap_isCompact_support_of_scaledNormRpowCostNash hnash hα hβ
  have hinj_image :=
    twoUserScoreSupport_injOn_projections_of_scaledNormRpowCostNash
      hu hv huv hu_nonnegative hv_nonnegative hsin hcos hnash hscore_ac hstrict hcross
      hderiv1 hderiv2
  have hinjfst : (Measure.map (twoUserScoreMap u v) μ).support.InjOn Prod.fst := by
    rw [hsupport]
    exact hinj_image.1
  have hinjsnd : (Measure.map (twoUserScoreMap u v) μ).support.InjOn Prod.snd := by
    rw [hsupport]
    exact hinj_image.2
  have hordered_score : ∀ z ∈ (Measure.map (twoUserScoreMap u v) μ).support,
      ∀ w ∈ (Measure.map (twoUserScoreMap u v) μ).support,
        z.1 < w.1 → z.2 ≤ w.2 := by
    rw [hsupport]
    rintro z ⟨p, hp, rfl⟩ w ⟨q, hq, rfl⟩ hlt
    simpa [twoUserScoreMap] using hordered p hp q hq hlt
  obtain ⟨a, b, d, hab, hgap1, hleft, hbd⟩ :=
    twoUserScore_exists_firstScore_gap_data_of_compact_not_ordConnected_support
      hcompact hnot
  obtain ⟨c, hcd, hgap2⟩ :=
    twoUserScore_exists_secondScore_gap_of_compact_ordered_support_injOn_snd
      hcompact hinjfst hinjsnd hordered_score hab hgap1 hleft hbd
  have ha_nonnegative : 0 ≤ a := by
    rcases hleft with ⟨z, hz, hza⟩
    have hzimage := hz
    rw [hsupport] at hzimage
    rcases hzimage with ⟨p, hp, hpmap⟩
    have hp_nonnegative : NonnegativeContent p := hnash.2.1 hp
    have hscore_nonnegative : 0 ≤ score u p :=
      score_nonneg_of_nonnegative hu_nonnegative hp_nonnegative
    have hfirst : score u p = z.1 := by
      simpa [twoUserScoreMap] using congrArg Prod.fst hpmap
    calc
      0 ≤ score u p := hscore_nonnegative
      _ = z.1 := hfirst
      _ ≤ a := hza
  have hb_pos : 0 < b := lt_of_le_of_lt ha_nonnegative hab
  have hbd_nonzero : (b, d) ≠ (0, 0) := by
    intro hzero
    have hb_zero : b = 0 := by simpa using congrArg Prod.fst hzero
    exact hb_pos.ne' hb_zero
  have hd_pos : 0 < d := by
    have hbdimage := hbd
    rw [hsupport] at hbdimage
    rcases hbdimage with ⟨p, hp, hpmap⟩
    have hpne : p ≠ 0 := by
      intro hpzero
      apply hbd_nonzero
      subst p
      simpa [twoUserScoreMap, score] using hpmap.symm
    rcases hstrict p hp hpne with ⟨hstrict1, hstrict2⟩
    have hpos := twoUserClosedUserCone_strict_pos
      (z := twoUserScoreMap u v p) hsin hcos
      (by simpa [twoUserScoreMap] using hstrict1)
      (by simpa [twoUserScoreMap] using hstrict2)
    have hsecond : score v p = d := by
      simpa [twoUserScoreMap] using congrArg Prod.snd hpmap
    have hpos_second : 0 < score v p := by
      simpa [twoUserScoreMap] using hpos.2
    exact hsecond ▸ hpos_second
  let c' : ℝ := max c 0
  have hc'_nonnegative : 0 ≤ c' := by
    dsimp [c']
    exact le_max_right _ _
  have hc'd : c' < d := by
    dsimp [c']
    exact max_lt hcd hd_pos
  have hgap2' : Set.Ioo c' d ⊆
      (Measure.map (fun r : Content 2 => score v r) μ).supportᶜ := by
    intro y hy
    apply hgap2
    exact ⟨lt_of_le_of_lt (le_max_left _ _) hy.1, hy.2⟩
  obtain ⟨t, ht, ht_one, htb_lower, htb_upper, htd_lower, htd_upper⟩ :=
    exists_unit_scaling_mem_two_open_intervals_of_nonneg
      ha_nonnegative hab hc'_nonnegative hc'd
  exact twoUserScore_not_sourceNash_of_two_aligned_marginal_open_gaps
    hu hv huv hsin hnash hscore_ac hbd hα hβ ht ht_one (Or.inl hb_pos.ne')
    hgap1 hgap2' ⟨htb_lower, htb_upper⟩ ⟨htd_lower, htd_upper⟩

/--
Proposition `supportrestriction` for an arbitrary original two-dimensional
user pair.  The proof works in the actual score coordinates of the original
nonnegative-content model: the score-map image of a punctured open support
ball is open and feasible, without rotating the action cone.  Absolute
continuity of the first raw score law supplies the required almost-everywhere
CDF derivative, and puncturing the ball removes the sole singular score pair
even when the given ball is centered at zero.
-/
theorem twoUser_no_l2Ball_contentSupport_of_sourceSymmetricMixedNash_of_source_nondegenerate
    {P : ℕ} [Nonempty (Fin P)] {α β θ ε : ℝ}
    {u v p0 : Content 2} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hε : 0 < ε)
    (hcontent_ball : ∀ p : Content 2,
      (p 0 - p0 0) ^ 2 + (p 1 - p0 1) ^ 2 < ε ^ 2 →
        p ∈ μ.support)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hθ_nonneg : 0 ≤ θ)
    (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 2) β q) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content 2 => score (if i = 0 then u else v) q) μ ≪
        volume) :
    False := by
  have hmetric_support : Metric.ball p0 (ε / 2) ⊆ μ.support :=
    contentMetricBall_subset_support_of_l2SqBall_subset_support hε hcontent_ball
  let T : Set (Content 2) :=
    Metric.ball p0 (ε / 2) ∩ ({0} : Set (Content 2))ᶜ
  have hTopen : IsOpen T := by
    dsimp [T]
    exact Metric.isOpen_ball.inter isOpen_compl_singleton
  have hTnonempty : T.Nonempty := by
    by_cases hp0 : p0 = 0
    · let q : Content 2 := content2 (ε / 4) 0
      refine ⟨q, ?_, ?_⟩
      · rw [Metric.mem_ball, hp0, dist_pi_lt_iff (by linarith)]
        intro i
        fin_cases i
        · rw [Real.dist_eq]
          have hquarter : ε / 4 < ε / 2 := by linarith
          have hquarter_pos : 0 < ε / 4 := by linarith
          have habs : |ε / 4| < ε / 2 := by
            rw [abs_of_pos hquarter_pos]
            exact hquarter
          simpa [q] using habs
        · rw [Real.dist_eq]
          have hhalf : 0 < ε / 2 := by linarith
          simpa [q] using hhalf
      · intro hq
        have hq0 : q 0 = 0 := by rw [hq]; rfl
        simp [q] at hq0
        linarith
    · exact ⟨p0, Metric.mem_ball_self (by linarith), hp0⟩
  have hTsupport : ∀ p : Content 2, p ∈ T → p ∈ μ.support := by
    intro p hp
    exact hmetric_support hp.1
  have hdet : u 0 * v 1 - u 1 * v 0 ≠ 0 :=
    twoUserScoreMatrix_det_ne_zero_of_unit_score_pair hu hv huv hsin.ne'
  let S : Set (ℝ × ℝ) := twoUserScoreMap u v '' T
  have hSopen : IsOpen S := by
    dsimp [S]
    exact isOpen_twoUserScoreMap_image hdet hTopen
  have hSnonempty : S.Nonempty := by
    rcases hTnonempty with ⟨p, hp⟩
    exact ⟨twoUserScoreMap u v p, ⟨p, hp, rfl⟩⟩
  have hscore_ne : ∀ p : Content 2, p ∈ T → twoUserScoreMap u v p ≠ (0, 0) := by
    intro p hp
    have hp_ne : p ≠ 0 := by
      simpa only [Set.mem_compl_iff, Set.mem_singleton_iff] using hp.2
    obtain ⟨e, he⟩ := exists_twoUserScoreMap_homeomorph (u := u) (v := v) hdet
    intro hzero
    apply hp_ne
    apply e.injective
    rw [he p, he 0, hzero]
    simp [twoUserScoreMap, score]
  have hbase : ∀ z : ℝ × ℝ, z ∈ S →
      twoUserInducedCostNumerator θ z.1 z.2 ≠ 0 := by
    intro z hz
    rcases hz with ⟨p, hp, hpmap⟩
    rw [← hpmap]
    exact twoUserInducedCostNumerator_ne_zero_of_ne_zero hsin.ne'
      (hscore_ne p hp)
  let R : ℝ :=
    |u 0| * (|p0 0| + ε / 2) + |u 1| * (|p0 1| + ε / 2) + 1
  have hRpos : 0 < R := by
    have hterm0 : 0 ≤ |u 0| * (|p0 0| + ε / 2) := by
      apply mul_nonneg (abs_nonneg _)
      nlinarith [abs_nonneg (p0 0)]
    have hterm1 : 0 ≤ |u 1| * (|p0 1| + ε / 2) := by
      apply mul_nonneg (abs_nonneg _)
      nlinarith [abs_nonneg (p0 1)]
    dsimp [R]
    linarith
  have habs_score : ∀ p : Content 2, p ∈ Metric.ball p0 (ε / 2) →
      |score u p| < R := by
    intro p hp
    have hp0 : |p 0| < |p0 0| + ε / 2 := by
      rw [Metric.mem_ball, dist_pi_lt_iff (by linarith)] at hp
      have hdiff : |p 0 - p0 0| < ε / 2 := by
        simpa [Real.dist_eq] using hp 0
      rw [abs_lt]
      constructor <;> nlinarith [le_abs_self (p0 0), neg_le_abs (p0 0),
        (abs_lt.mp hdiff).1, (abs_lt.mp hdiff).2]
    have hp1 : |p 1| < |p0 1| + ε / 2 := by
      rw [Metric.mem_ball, dist_pi_lt_iff (by linarith)] at hp
      have hdiff : |p 1 - p0 1| < ε / 2 := by
        simpa [Real.dist_eq] using hp 1
      rw [abs_lt]
      constructor <;> nlinarith [le_abs_self (p0 1), neg_le_abs (p0 1),
        (abs_lt.mp hdiff).1, (abs_lt.mp hdiff).2]
    dsimp [R]
    calc
      |score u p| = |u 0 * p 0 + u 1 * p 1| := by
        simp [score, Fin.sum_univ_two]
      _ ≤ |u 0 * p 0| + |u 1 * p 1| := abs_add_le _ _
      _ = |u 0| * |p 0| + |u 1| * |p 1| := by rw [abs_mul, abs_mul]
      _ < |u 0| * (|p0 0| + ε / 2) +
            |u 1| * (|p0 1| + ε / 2) + 1 := by
        nlinarith [mul_le_mul_of_nonneg_left hp0.le (abs_nonneg (u 0)),
          mul_le_mul_of_nonneg_left hp1.le (abs_nonneg (u 1))]
  have hSx_interval : ∀ z : ℝ × ℝ, z ∈ S → z.1 ∈ Set.Icc (-R) R := by
    intro z hz
    rcases hz with ⟨p, hp, hpmap⟩
    have hscore_bound := habs_score p hp.1
    have hzscore : z.1 = score u p := by
      simpa [twoUserScoreMap] using congrArg Prod.fst hpmap.symm
    rw [hzscore]
    exact ⟨(abs_lt.mp hscore_bound).1.le, (abs_lt.mp hscore_bound).2.le⟩
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score u q) μ) :=
    Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score v q) μ) :=
    Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
  have hH1_ae : ∀ᵐ x ∂volume,
      (∃ y : ℝ, (x, y) ∈ S) →
        HasDerivAt
          (fun t => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
            (Measure.map (fun q : Content 2 => score u q) μ) t)
          (deriv (fun t => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
            (Measure.map (fun q : Content 2 => score u q) μ) t) x) x := by
    have hF_ae :=
      AppliedModelingLib.RealAnalysis.ae_hasDerivAt_deriv_of_absolutelyContinuousOnInterval
        (AppliedModelingLib.Probability.lowerCDFMass_absolutelyContinuousOnInterval_of_absolutelyContinuous
          (Measure.map (fun q : Content 2 => score u q) μ) (by simpa using hscore_ac 0)
          (-R) R)
    filter_upwards [hF_ae] with x hx
    rintro ⟨y, hxy⟩
    have hRle : -R ≤ R := by linarith
    have hxrange : x ∈ Set.uIcc (-R) R := by
      simpa only [Set.uIcc_of_le hRle] using hSx_interval (x, y) hxy
    have hF := hx hxrange
    have hmax := AppliedModelingLib.Probability.hasDerivAt_iidMaximumCdf_of_hasDerivAt_lowerCDFMass
      (n := P - 1) (Measure.map (fun q : Content 2 => score u q) μ) hF
    rw [hmax.deriv]
    exact hmax
  have hfeasible : S ⊆ twoUserScoreFeasibleSet u v := by
    intro z hz
    rcases hz with ⟨p, hp, hpmap⟩
    rw [← hpmap]
    exact ⟨p, hnash.2.1 (hTsupport p hp), rfl⟩
  have hC1 : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn
        (fun z : ℝ × ℝ =>
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
            (Measure.map (fun q : Content 2 => score u q) μ) z.1 +
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
            (Measure.map (fun q : Content 2 => score v q) μ) z.2 -
          twoUserInducedCost α β θ z.1 z.2)
        (twoUserScoreFeasibleSet u v) z := by
    intro z hz
    rcases hz with ⟨p, hp, hpmap⟩
