/--
At a polar direction attaining the reciprocal angular-power bound, the capped
objective is zero provided neither reward cap has yet activated.  This is the
support-attainment half of the corrected infinite-producer verification.
-/
theorem infiniteGenreCappedObjective_eq_zero_of_polar_angle_eq
    {c beta theta phi r : ℝ}
    (hr : 0 ≤ r) (hsin : 0 < Real.sin theta)
    (hcos : 0 ≤ Real.cos phi)
    (hcos_other : 0 ≤ Real.cos (theta - phi))
    (hangle : c * ((Real.cos phi) ^ beta +
      (Real.cos (theta - phi)) ^ beta) = 1)
    (hcap : c * (r * Real.cos phi) ^ beta ≤ 1)
    (hcap_other : c * (r * Real.cos (theta - phi)) ^ beta ≤ 1) :
    infiniteGenreCappedObjective c beta theta
      (r * Real.cos phi) (r * Real.cos (theta - phi)) = 0 := by
  have hreward :
      c * (r * Real.cos phi) ^ beta +
        c * (r * Real.cos (theta - phi)) ^ beta = r ^ beta := by
    rw [Real.mul_rpow hr hcos, Real.mul_rpow hr hcos_other]
    calc
      c * (r ^ beta * (Real.cos phi) ^ beta) +
          c * (r ^ beta * (Real.cos (theta - phi)) ^ beta) =
        r ^ beta * (c * ((Real.cos phi) ^ beta +
          (Real.cos (theta - phi)) ^ beta)) := by ring
      _ = r ^ beta := by rw [hangle]; ring
  have hcost :
      twoUserInducedCost 1 beta theta
          (r * Real.cos phi) (r * Real.cos (theta - phi)) = r ^ beta := by
    simpa using
      (twoUserInducedCost_param_eq_alpha_mul_rpow (α := 1) (β := beta)
        (θ := theta) (φ := phi) hr hsin)
  unfold infiniteGenreCappedObjective
  rw [min_eq_right hcap, min_eq_right hcap_other, hreward, hcost]
  ring

/--
Every radius in the corrected cutoff interval gives zero profit on the first
two-genre support ray.  The geometric score identities are explicit so this
does not rely on the source's inconsistent trigonometric `C₁` expression.
