    1 - 2 / beta := by
  rw [pTwoSourceContentMeasure_sourceMixedPurePayoffAtFocal_eq_standardBasisObjective
    hbeta j p hp]
  exact standardBasisObjective_le_of_two_le hbeta

/--
For either focal producer, every literal source-circle action attains the P=2
payoff value `1 - 2 / beta`.
-/
theorem pTwoContentOfCoordinates_sourceMixedPurePayoffAtFocal_eq_equilibriumValue_on_sourceCircle
    {beta : ℝ} (hbeta : 2 ≤ beta) (j : Fin 2) (z : ℝ × ℝ)
    (hz : z ∈ pTwoSourceCircleSupportSet beta) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
      (normRpowCost (SourceNorm.l2 2) beta) (pTwoContentOfCoordinates z)
