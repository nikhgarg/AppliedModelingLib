  have hinjsnd : (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.snd := by
    apply twoUser_support_injOn_snd_of_common_secondPartial_of_crossPartial_neg_awayOrigin
      hbase hcross
    · intro z hz hz2
      by_contra hne
      have hinterior_z := hinterior z hz hne
