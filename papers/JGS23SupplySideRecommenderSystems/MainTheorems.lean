theorem twoUser_regionscolor_slope_nonneg_of_beta_lt_phaseThreshold_and_cos_range
    {α β θ φ r slope : ℝ}
    (hα : 0 < α)
    (hβ : 0 < β)
    (hsin : 0 < Real.sin θ)
    (hden : 0 < 1 - Real.cos θ)
    (hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hcosθ_pos : 0 < Real.cos θ)
    (hcos_lower : Real.cos θ ≤ Real.cos (θ - 2 * φ))
    (hcos_upper : Real.cos (θ - 2 * φ) ≤ 1)
    (hneg :
      NegativeSemidefiniteQuadratic2
        (slope *
          twoUserInducedCostCrossPartial α β θ
            (r * Real.cos φ) (r * Real.cos (θ - φ)))
        (-(twoUserInducedCostCrossPartial α β θ
            (r * Real.cos φ) (r * Real.cos (θ - φ))))
        (slope⁻¹ *
          twoUserInducedCostCrossPartial α β θ
            (r * Real.cos φ) (r * Real.cos (θ - φ)))) :
    0 ≤ slope := by
  have hmul :
      slope * twoUserSecondDerivSignBracket β θ φ ≤ 0 :=
    twoUser_regionscolor_param_bracket_nonpos_of_negativeSemidefinite
      hα hβ hsin hNpos hneg
  have hbracket :
      twoUserSecondDerivSignBracket β θ φ < 0 :=
    twoUserSecondDerivSignBracket_neg_of_beta_lt_phaseThreshold_and_cos_range
      hβ hden hβlt hcosθ_pos hcos_lower hcos_upper
  exact nonneg_of_mul_nonpos_left hmul hbracket

theorem twoUser_regionscolor_slope_nonneg_of_beta_lt_phaseThreshold_and_angle_mem_Icc_lt_half_pi
    {α β θ φ r slope : ℝ}
    (hα : 0 < α)
    (hβ : 0 < β)
    (hsin : 0 < Real.sin θ)
    (hden : 0 < 1 - Real.cos θ)
    (hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hθ_nonneg : 0 ≤ θ)
    (hθ_lt_half_pi : θ < Real.pi / 2)
    (hφ_nonneg : 0 ≤ φ)
    (hφ_leθ : φ ≤ θ)
    (hneg :
      NegativeSemidefiniteQuadratic2
        (slope *
          twoUserInducedCostCrossPartial α β θ
            (r * Real.cos φ) (r * Real.cos (θ - φ)))
        (-(twoUserInducedCostCrossPartial α β θ
            (r * Real.cos φ) (r * Real.cos (θ - φ))))
        (slope⁻¹ *
          twoUserInducedCostCrossPartial α β θ
            (r * Real.cos φ) (r * Real.cos (θ - φ)))) :
    0 ≤ slope := by
  have hθ_le_pi : θ ≤ Real.pi := by
    linarith [Real.pi_pos]
  have hcosθ_pos : 0 < Real.cos θ :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ_lt_half_pi⟩
  rcases twoUser_cos_range_of_angle_mem_Icc hθ_le_pi hφ_nonneg hφ_leθ with
    ⟨hcos_lower, hcos_upper⟩
  exact
    twoUser_regionscolor_slope_nonneg_of_beta_lt_phaseThreshold_and_cos_range
      hα hβ hsin hden hNpos hβlt hcosθ_pos hcos_lower hcos_upper hneg

/--
Young-inequality bound behind Lemma `standardbasismax`: for `p > 1`, the
one-dimensional expression `p^(1/p) x - x^p` is bounded by `1 - 1/p`.
-/
theorem young_scaled_rpow_bound
    {p x : ℝ} (hp : 1 < p) (hx : 0 ≤ x) :
    p ^ (1 / p) * x - x ^ p ≤ 1 - 1 / p := by
  let q : ℝ := Real.conjExponent p
  have hpq : p.HolderConjugate q := Real.HolderConjugate.conjExponent hp
  have hp_pos : 0 < p := lt_trans zero_lt_one hp
  have hp_nonneg : 0 ≤ p := hp_pos.le
  have hscale_nonneg : 0 ≤ p ^ (1 / p) := Real.rpow_nonneg hp_nonneg _
  have hy :=
    Real.young_inequality_of_nonneg
      (a := x * p ^ (1 / p)) (b := 1) (p := p) (q := q)
      (mul_nonneg hx hscale_nonneg) zero_le_one hpq
  have hpow_scale : (p ^ (1 / p)) ^ p = p := by
    rw [← Real.rpow_mul hp_nonneg]
    field_simp [ne_of_gt hp_pos]
    rw [Real.rpow_one]
  have ha_pow :
      (x * p ^ (1 / p)) ^ p / p = x ^ p := by
    rw [Real.mul_rpow hx hscale_nonneg]
    rw [hpow_scale]
    field_simp [ne_of_gt hp_pos]
  have ha_pow' :
      (x * p ^ p⁻¹) ^ p / p = x ^ p := by
    simpa [one_div] using ha_pow
  have hq_inv : q⁻¹ = 1 - p⁻¹ := by
    have hsum := hpq.inv_add_inv_eq_one
    linarith
  have hy_norm :
      x * p ^ p⁻¹ ≤ (x * p ^ p⁻¹) ^ p / p + (1 : ℝ) ^ q / q := by
    simpa [one_div, mul_comm, mul_left_comm, mul_assoc] using hy
  have hy' : x * p ^ (1 / p) ≤ x ^ p + (1 - 1 / p) := by
    simpa [one_div, ha_pow', hq_inv] using hy_norm
  linarith

theorem standardBasis_radial_bound
    {β c : ℝ} (hβ : 2 < β) (hc : 0 ≤ c) :
    (β / 2) ^ (2 / β) * c - c ^ (β / 2) ≤ 1 - 2 / β := by
  have hp : 1 < β / 2 := by linarith
  have h := young_scaled_rpow_bound (p := β / 2) (x := c) hp hc
  have hrecip : 1 / (β / 2) = 2 / β := by
    field_simp [ne_of_gt (by linarith : 0 < β)]
  simpa [hrecip] using h

theorem standardBasis_sourceCoeff_eq
    {β : ℝ} (hβ : 0 < β) :
    (2 / β) ^ (-(2 / β)) = (β / 2) ^ (2 / β) := by
  have hbase : 2 / β = (β / 2)⁻¹ := by
    field_simp [ne_of_gt hβ]
  rw [hbase]
  rw [Real.inv_rpow]
  · rw [inv_eq_one_div]
    rw [Real.rpow_neg]
    · rw [one_div, inv_inv]
    · positivity
  · positivity

theorem standardBasis_radial_bound_source_coeff
    {β c : ℝ} (hβ : 2 < β) (hc : 0 ≤ c) :
    (2 / β) ^ (-(2 / β)) * c - c ^ (β / 2) ≤ 1 - 2 / β := by
  have h := standardBasis_radial_bound (β := β) (c := c) hβ hc
  rw [standardBasis_sourceCoeff_eq (by linarith : 0 < β)]
  exact h

/-- Objective from Lemma `standardbasismax`, in the source's reciprocal coefficient form. -/
noncomputable def standardBasisObjective
    (β z1 z2 : ℝ) : ℝ :=
  (min ((2 / β) ^ (-(2 / β)) * z1 ^ 2) 1 +
      min ((2 / β) ^ (-(2 / β)) * z2 ^ 2) 1) -
    (z1 ^ 2 + z2 ^ 2) ^ (β / 2)

theorem standardBasisObjective_le
    {β z1 z2 : ℝ} (hβ : 2 < β) :
    standardBasisObjective β z1 z2 ≤ 1 - 2 / β := by
  set coeff : ℝ := (2 / β) ^ (-(2 / β))
  set c : ℝ := z1 ^ 2 + z2 ^ 2
  have hc : 0 ≤ c := by
    nlinarith [sq_nonneg z1, sq_nonneg z2]
  have hmin1 : min (coeff * z1 ^ 2) 1 ≤ coeff * z1 ^ 2 :=
    min_le_left _ _
  have hmin2 : min (coeff * z2 ^ 2) 1 ≤ coeff * z2 ^ 2 :=
    min_le_left _ _
  have hsum :
      min (coeff * z1 ^ 2) 1 + min (coeff * z2 ^ 2) 1 ≤ coeff * c := by
    nlinarith
  have hrad :
      coeff * c - c ^ (β / 2) ≤ 1 - 2 / β := by
    dsimp [coeff]
    exact standardBasis_radial_bound_source_coeff hβ hc
  unfold standardBasisObjective
  change min (coeff * z1 ^ 2) 1 + min (coeff * z2 ^ 2) 1 -
      c ^ (β / 2) ≤ 1 - 2 / β
  exact (sub_le_sub_right hsum _).trans hrad

theorem standardBasis_coeff_mul_radius_eq_one
    {β : ℝ} (hβ : 0 < β) :
    (2 / β) ^ (-(2 / β)) * (2 / β) ^ (2 / β) = 1 := by
  have hbase : 0 < 2 / β := div_pos two_pos hβ
  rw [Real.rpow_neg hbase.le]
  exact inv_mul_cancel₀ (ne_of_gt (Real.rpow_pos_of_pos hbase _))

theorem standardBasis_radius_rpow_eq_two_div_beta
    {β : ℝ} (hβ : 0 < β) :
    ((2 / β) ^ (2 / β)) ^ (β / 2) = 2 / β := by
  have hbase : 0 ≤ 2 / β := (div_pos two_pos hβ).le
  rw [← Real.rpow_mul hbase]
  have hmul : (2 / β) * (β / 2) = 1 := by
    field_simp [ne_of_gt hβ]
  rw [hmul, Real.rpow_one]

theorem standardBasisObjective_eq_of_radius
    {β z1 z2 : ℝ} (hβ : 2 < β)
    (hradius : z1 ^ 2 + z2 ^ 2 = (2 / β) ^ (2 / β)) :
    standardBasisObjective β z1 z2 = 1 - 2 / β := by
  set coeff : ℝ := (2 / β) ^ (-(2 / β))
  set radius : ℝ := (2 / β) ^ (2 / β)
  have hβpos : 0 < β := by linarith
  have hcoeff_nonneg : 0 ≤ coeff := by
    dsimp [coeff]
    exact Real.rpow_nonneg (div_pos two_pos hβpos).le _
  have hcoeff_radius : coeff * radius = 1 := by
    dsimp [coeff, radius]
    exact standardBasis_coeff_mul_radius_eq_one hβpos
  have hz1_le : coeff * z1 ^ 2 ≤ 1 := by
    have hz1sq_le : z1 ^ 2 ≤ radius := by
      dsimp [radius]
      nlinarith [sq_nonneg z2]
    exact (mul_le_mul_of_nonneg_left hz1sq_le hcoeff_nonneg).trans_eq hcoeff_radius
  have hz2_le : coeff * z2 ^ 2 ≤ 1 := by
    have hz2sq_le : z2 ^ 2 ≤ radius := by
      dsimp [radius]
      nlinarith [sq_nonneg z1]
    exact (mul_le_mul_of_nonneg_left hz2sq_le hcoeff_nonneg).trans_eq hcoeff_radius
  have hmins :
      min (coeff * z1 ^ 2) 1 + min (coeff * z2 ^ 2) 1 =
        coeff * (z1 ^ 2 + z2 ^ 2) := by
    rw [min_eq_left hz1_le, min_eq_left hz2_le]
    ring
  unfold standardBasisObjective
  change min (coeff * z1 ^ 2) 1 + min (coeff * z2 ^ 2) 1 -
      (z1 ^ 2 + z2 ^ 2) ^ (β / 2) = 1 - 2 / β
  rw [hmins, hradius]
  have hradpow : radius ^ (β / 2) = 2 / β := by
    dsimp [radius]
    exact standardBasis_radius_rpow_eq_two_div_beta hβpos
  rw [hradpow]
  rw [hcoeff_radius]

theorem standardBasisObjective_le_of_radius
    {β z1 z2 w1 w2 : ℝ} (hβ : 2 < β)
    (hradius : z1 ^ 2 + z2 ^ 2 = (2 / β) ^ (2 / β)) :
    standardBasisObjective β w1 w2 ≤ standardBasisObjective β z1 z2 := by
  rw [standardBasisObjective_eq_of_radius hβ hradius]
  exact standardBasisObjective_le hβ

theorem standardBasisObjective_le_beta_two (z1 z2 : ℝ) :
    standardBasisObjective 2 z1 z2 ≤ 0 := by
  have hmin1 : min (z1 ^ 2) 1 ≤ z1 ^ 2 := min_le_left _ _
  have hmin2 : min (z2 ^ 2) 1 ≤ z2 ^ 2 := min_le_left _ _
  unfold standardBasisObjective
  norm_num
  linarith

theorem standardBasisObjective_eq_beta_two_of_radius
    {z1 z2 : ℝ} (hradius : z1 ^ 2 + z2 ^ 2 = 1) :
    standardBasisObjective 2 z1 z2 = 0 := by
  have hz1_le : z1 ^ 2 ≤ 1 := by nlinarith [sq_nonneg z2]
  have hz2_le : z2 ^ 2 ≤ 1 := by nlinarith [sq_nonneg z1]
  unfold standardBasisObjective
  norm_num
  rw [min_eq_left hz1_le, min_eq_left hz2_le]
  linarith

theorem standardBasisObjective_eq_beta_two_of_unit_box
    {z1 z2 : ℝ} (hz1_nonneg : 0 ≤ z1) (hz1_le_one : z1 ≤ 1)
    (hz2_nonneg : 0 ≤ z2) (hz2_le_one : z2 ≤ 1) :
    standardBasisObjective 2 z1 z2 = 0 := by
  have hz1sq_le : z1 ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg hz1_nonneg (sub_nonneg.mpr hz1_le_one)]
  have hz2sq_le : z2 ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg hz2_nonneg (sub_nonneg.mpr hz2_le_one)]
  unfold standardBasisObjective
  norm_num
  rw [min_eq_left hz1sq_le, min_eq_left hz2sq_le]
  linarith

theorem standardBasisObjective_beta_two_le_of_radius
    {z1 z2 w1 w2 : ℝ} (hradius : z1 ^ 2 + z2 ^ 2 = 1) :
    standardBasisObjective 2 w1 w2 ≤ standardBasisObjective 2 z1 z2 := by
  rw [standardBasisObjective_eq_beta_two_of_radius hradius]
  exact standardBasisObjective_le_beta_two w1 w2

theorem standardBasisObjective_beta_two_le_of_unit_box
    {z1 z2 w1 w2 : ℝ}
    (hz1_nonneg : 0 ≤ z1) (hz1_le_one : z1 ≤ 1)
    (hz2_nonneg : 0 ≤ z2) (hz2_le_one : z2 ≤ 1) :
    standardBasisObjective 2 w1 w2 ≤ standardBasisObjective 2 z1 z2 := by
  rw [standardBasisObjective_eq_beta_two_of_unit_box
    hz1_nonneg hz1_le_one hz2_nonneg hz2_le_one]
  exact standardBasisObjective_le_beta_two w1 w2

/-- Lemma `standardbasismax`, source hypothesis form: upper bound for all `β ≥ 2`. -/
theorem standardBasisObjective_le_of_two_le
    {β z1 z2 : ℝ} (hβ : 2 ≤ β) :
    standardBasisObjective β z1 z2 ≤ 1 - 2 / β := by
  by_cases hβeq : β = 2
  · subst β
    simpa using standardBasisObjective_le_beta_two z1 z2
  · have hβgt : 2 < β :=
      lt_of_le_of_ne hβ (by
        intro h
        exact hβeq h.symm)
    exact standardBasisObjective_le hβgt

/--
Lemma `standardbasismax`, source hypothesis form: every point on the source
radius attains the upper-bound value for all `β ≥ 2`.
-/
theorem standardBasisObjective_eq_of_radius_two_le
    {β z1 z2 : ℝ} (hβ : 2 ≤ β)
    (hradius : z1 ^ 2 + z2 ^ 2 = (2 / β) ^ (2 / β)) :
    standardBasisObjective β z1 z2 = 1 - 2 / β := by
  by_cases hβeq : β = 2
  · subst β
    have hradius' : z1 ^ 2 + z2 ^ 2 = 1 := by
      simpa using hradius
    simpa using standardBasisObjective_eq_beta_two_of_radius hradius'
  · have hβgt : 2 < β :=
      lt_of_le_of_ne hβ (by
        intro h
        exact hβeq h.symm)
    exact standardBasisObjective_eq_of_radius hβgt hradius

/--
Lemma `standardbasismax`, source theorem form: for `β ≥ 2`, any point with
`z_1^2+z_2^2=(2/β)^(2/β)` maximizes the standard-basis objective.
-/
theorem standardBasisObjective_le_of_radius_two_le
    {β z1 z2 w1 w2 : ℝ} (hβ : 2 ≤ β)
    (hradius : z1 ^ 2 + z2 ^ 2 = (2 / β) ^ (2 / β)) :
    standardBasisObjective β w1 w2 ≤ standardBasisObjective β z1 z2 := by
  rw [standardBasisObjective_eq_of_radius_two_le hβ hradius]
  exact standardBasisObjective_le_of_two_le hβ

/--
Proposition `Ptwo`, C1 maximizer step for the literal quarter-circle support
displayed by the source. C3 and equilibrium verification are separate.
-/
theorem propositionPtwo_standardBasis_c1_maximizer_on_source_circle
    {β θ w1 w2 : ℝ} (hβ : 2 ≤ β)
    (hθ : θ ∈ Set.Icc (0 : ℝ) (Real.pi / 2)) :
    standardBasisObjective β w1 w2 ≤
      standardBasisObjective β
        ((2 / β) ^ (1 / β) * Real.cos θ)
        ((2 / β) ^ (1 / β) * Real.sin θ) := by
  have hβ_pos : 0 < β := by linarith
  have hbase_nonneg : 0 ≤ 2 / β := (div_pos (by norm_num) hβ_pos).le
  have hradius_sq : ((2 / β) ^ (1 / β)) ^ 2 = (2 / β) ^ (2 / β) := by
    rw [← Real.rpow_mul_natCast hbase_nonneg (1 / β) 2]
    congr 1
    ring
  have hsupport :
      ((2 / β) ^ (1 / β) * Real.cos θ) ^ 2 +
          ((2 / β) ^ (1 / β) * Real.sin θ) ^ 2 =
        (2 / β) ^ (2 / β) := by
    calc
      ((2 / β) ^ (1 / β) * Real.cos θ) ^ 2 +
          ((2 / β) ^ (1 / β) * Real.sin θ) ^ 2 =
          ((2 / β) ^ (1 / β)) ^ 2 *
            (Real.cos θ ^ 2 + Real.sin θ ^ 2) := by ring
      _ = ((2 / β) ^ (1 / β)) ^ 2 := by
        rw [Real.cos_sq_add_sin_sq, mul_one]
      _ = (2 / β) ^ (2 / β) := hradius_sq
  exact standardBasisObjective_le_of_radius_two_le hβ hsupport

/--
Proposition `Ptwo`, source angle-density sign: the displayed density is
nonnegative throughout its stated quarter-circle angle interval.
-/
theorem propositionPtwo_angleDensity_nonneg_on_source_interval
    {theta : ℝ} (htheta : theta ∈ Set.Icc (0 : ℝ) (Real.pi / 2)) :
    0 ≤ 2 * Real.cos theta * Real.sin theta := by
  have hcos : 0 ≤ Real.cos theta :=
    Real.cos_nonneg_of_mem_Icc
      ⟨(neg_nonpos.mpr (by positivity : 0 ≤ Real.pi / 2)).trans htheta.1, htheta.2⟩
  have hsin : 0 ≤ Real.sin theta :=
    Real.sin_nonneg_of_nonneg_of_le_pi htheta.1 (by linarith [Real.pi_pos, htheta.2])
  exact mul_nonneg (mul_nonneg (by norm_num) hcos) hsin

/--
Proposition `Ptwo`, source angle-density normalization: the displayed density
has total interval integral one. The exact source angle law is constructed
below; this theorem alone does not establish C3 or equilibrium.
-/
theorem propositionPtwo_angleDensity_intervalIntegral_eq_one :
    ∫ theta in (0 : ℝ)..Real.pi / 2, 2 * Real.cos theta * Real.sin theta = 1 := by
  calc
    ∫ theta in (0 : ℝ)..Real.pi / 2, 2 * Real.cos theta * Real.sin theta =
        ∫ theta in (0 : ℝ)..Real.pi / 2, 2 * (Real.sin theta * Real.cos theta) := by
          apply intervalIntegral.integral_congr
          intro theta _
          ring
    _ = 2 * ∫ theta in (0 : ℝ)..Real.pi / 2, Real.sin theta * Real.cos theta := by
      rw [intervalIntegral.integral_const_mul]
    _ = 2 * ((Real.sin (Real.pi / 2) ^ 2 - Real.sin (0 : ℝ) ^ 2) / 2) := by
      rw [integral_sin_mul_cos₁]
    _ = 1 := by norm_num [Real.sin_pi_div_two, Real.sin_zero]

/--
Proposition `Ptwo`, coordinate-density sign: the source candidate
`2 (2 / beta)^(-2 / beta) z` is nonnegative on its displayed support interval.
-/
theorem propositionPtwo_coordinateDensity_nonneg_on_source_interval
    {beta z : ℝ} (hbeta : 2 ≤ beta)
    (hz : z ∈ Set.Icc (0 : ℝ) ((2 / beta) ^ (1 / beta))) :
    0 ≤ 2 * (2 / beta) ^ (-(2 / beta)) * z := by
  have hbeta_pos : 0 < beta := by linarith
  have hbase_nonneg : 0 ≤ 2 / beta := (div_pos (by norm_num) hbeta_pos).le
  have hcoeff_nonneg : 0 ≤ (2 / beta) ^ (-(2 / beta)) :=
    Real.rpow_nonneg hbase_nonneg _
  exact mul_nonneg (mul_nonneg (by norm_num) hcoeff_nonneg) hz.1

/--
Proposition `Ptwo`, coordinate-density integration: on the source support,
integrating the candidate density gives the displayed quadratic CDF value,
which lies in `[0, 1]`. This does not identify a pushforward measure.
-/
theorem propositionPtwo_coordinateDensity_integral_eq_candidateCdf
    {beta z : ℝ} (hbeta : 2 ≤ beta)
    (hz : z ∈ Set.Icc (0 : ℝ) ((2 / beta) ^ (1 / beta))) :
    ∫ t in (0 : ℝ)..z, 2 * (2 / beta) ^ (-(2 / beta)) * t =
      (2 / beta) ^ (-(2 / beta)) * z ^ 2 ∧
        (2 / beta) ^ (-(2 / beta)) * z ^ 2 ∈ Set.Icc (0 : ℝ) 1 := by
  have hbeta_pos : 0 < beta := by linarith
  have hbase_nonneg : 0 ≤ 2 / beta := (div_pos (by norm_num) hbeta_pos).le
  have hcoeff_nonneg : 0 ≤ (2 / beta) ^ (-(2 / beta)) :=
    Real.rpow_nonneg hbase_nonneg _
  have hradius_nonneg : 0 ≤ (2 / beta) ^ (1 / beta) :=
    Real.rpow_nonneg hbase_nonneg _
  have hzsquare : z ^ 2 ≤ ((2 / beta) ^ (1 / beta)) ^ 2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hz.2) (add_nonneg hz.1 hradius_nonneg)]
  have hradius_sq : ((2 / beta) ^ (1 / beta)) ^ 2 = (2 / beta) ^ (2 / beta) := by
    rw [← Real.rpow_mul_natCast hbase_nonneg (1 / beta) 2]
    congr 1
    ring
  have hcoeff_radius :
      (2 / beta) ^ (-(2 / beta)) * ((2 / beta) ^ (1 / beta)) ^ 2 = 1 := by
    rw [hradius_sq]
    exact standardBasis_coeff_mul_radius_eq_one hbeta_pos
  refine ⟨?_, ⟨mul_nonneg hcoeff_nonneg (sq_nonneg z), ?_⟩⟩
  · calc
      ∫ t in (0 : ℝ)..z, 2 * (2 / beta) ^ (-(2 / beta)) * t =
          (2 * (2 / beta) ^ (-(2 / beta))) * ∫ t in (0 : ℝ)..z, t := by
            rw [intervalIntegral.integral_const_mul]
      _ = (2 * (2 / beta) ^ (-(2 / beta))) * (z ^ 2 / 2) := by
        rw [integral_id]
        ring
      _ = (2 / beta) ^ (-(2 / beta)) * z ^ 2 := by ring
  · calc
      (2 / beta) ^ (-(2 / beta)) * z ^ 2 ≤
          (2 / beta) ^ (-(2 / beta)) * ((2 / beta) ^ (1 / beta)) ^ 2 :=
        mul_le_mul_of_nonneg_left hzsquare hcoeff_nonneg
      _ = 1 := hcoeff_radius

/--
Proposition `Ptwo`, coordinate-density normalization: the candidate density
has interval integral one over its displayed support. This is not yet a
construction of the source coordinate marginal.
-/
theorem propositionPtwo_coordinateDensity_intervalIntegral_eq_one
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    ∫ z in (0 : ℝ)..((2 / beta) ^ (1 / beta)),
        2 * (2 / beta) ^ (-(2 / beta)) * z = 1 := by
  have hbeta_pos : 0 < beta := by linarith
  have hbase_nonneg : 0 ≤ 2 / beta := (div_pos (by norm_num) hbeta_pos).le
  have hradius_sq : ((2 / beta) ^ (1 / beta)) ^ 2 = (2 / beta) ^ (2 / beta) := by
    rw [← Real.rpow_mul_natCast hbase_nonneg (1 / beta) 2]
    congr 1
    ring
  have hcoeff_radius :
      (2 / beta) ^ (-(2 / beta)) * ((2 / beta) ^ (1 / beta)) ^ 2 = 1 := by
    rw [hradius_sq]
    exact standardBasis_coeff_mul_radius_eq_one hbeta_pos
  calc
    ∫ z in (0 : ℝ)..((2 / beta) ^ (1 / beta)),
        2 * (2 / beta) ^ (-(2 / beta)) * z =
        (2 * (2 / beta) ^ (-(2 / beta))) *
          ∫ z in (0 : ℝ)..((2 / beta) ^ (1 / beta)), z := by
          rw [intervalIntegral.integral_const_mul]
    _ = (2 * (2 / beta) ^ (-(2 / beta))) * (((2 / beta) ^ (1 / beta)) ^ 2 / 2) := by
      rw [integral_id]
      ring
    _ = (2 / beta) ^ (-(2 / beta)) * ((2 / beta) ^ (1 / beta)) ^ 2 := by ring
    _ = 1 := hcoeff_radius

/--
Proposition `Ptwo`, interior change-of-variables calculation: after the
quarter-circle parameterization, the source candidate coordinate density is
the angle density divided by the positive coordinate Jacobian.
-/
theorem propositionPtwo_coordinateDensity_jacobian_quotient_on_source_angle
    {beta theta : ℝ} (hbeta : 2 ≤ beta)
    (htheta : theta ∈ Set.Ioo (0 : ℝ) (Real.pi / 2)) :
    2 * (2 / beta) ^ (-(2 / beta)) *
        ((2 / beta) ^ (1 / beta) * Real.sin theta) =
      (2 * Real.sin theta * Real.cos theta) /
        ((2 / beta) ^ (1 / beta) * Real.cos theta) := by
  have hbeta_pos : 0 < beta := by linarith
  have hbase_pos : 0 < 2 / beta := div_pos (by norm_num) hbeta_pos
  have hbase_nonneg : 0 ≤ 2 / beta := (div_pos (by norm_num) hbeta_pos).le
  have hradius_pos : 0 < (2 / beta) ^ (1 / beta) :=
    Real.rpow_pos_of_pos hbase_pos _
  have hcos_pos : 0 < Real.cos theta :=
    Real.cos_pos_of_mem_Ioo
      ⟨(neg_lt_zero.mpr (by positivity : 0 < Real.pi / 2)).trans htheta.1, htheta.2⟩
  have hradius_sq : ((2 / beta) ^ (1 / beta)) ^ 2 = (2 / beta) ^ (2 / beta) := by
    rw [← Real.rpow_mul_natCast hbase_nonneg (1 / beta) 2]
    congr 1
    ring
  have hcoeff_radius :
      (2 / beta) ^ (-(2 / beta)) * ((2 / beta) ^ (1 / beta)) ^ 2 = 1 := by
    rw [hradius_sq]
    exact standardBasis_coeff_mul_radius_eq_one hbeta_pos
  refine (eq_div_iff (mul_ne_zero (ne_of_gt hradius_pos) (ne_of_gt hcos_pos))).2 ?_
  calc
    (2 * (2 / beta) ^ (-(2 / beta)) *
        ((2 / beta) ^ (1 / beta) * Real.sin theta)) *
      ((2 / beta) ^ (1 / beta) * Real.cos theta) =
        2 * ((2 / beta) ^ (-(2 / beta)) * ((2 / beta) ^ (1 / beta)) ^ 2) *
          (Real.sin theta * Real.cos theta) := by ring
    _ = 2 * Real.sin theta * Real.cos theta := by rw [hcoeff_radius]; ring

/--
Primitive P=2 quarter-circle sampler: unit-interval volume is sent to the
literal source circle. Its topological support, direct C2 marginal components,
and source angle law are verified below; C3 and equilibrium remain separate.
-/
noncomputable def pTwoSourceCircleSample (beta : ℝ) (u : I) : ℝ × ℝ :=
  let radius := (2 / beta) ^ (1 / beta)
  (radius * Real.sqrt (1 - (u : ℝ)), radius * Real.sqrt (u : ℝ))

/--
Primitive P=2 angle sampler. It sends uniform unit-interval mass through
`theta = arcsin(sqrt u)`, whose CDF on the source interval is `sin(theta)^2`.
-/
noncomputable def pTwoSourceAngleSample (u : I) : ℝ :=
  Real.arcsin (Real.sqrt (u : ℝ))

/-- The concrete source angle law induced by `pTwoSourceAngleSample`. -/
noncomputable def pTwoSourceAngleMeasure : Measure ℝ :=
  Measure.map pTwoSourceAngleSample (volume : Measure I)

/--
The full CDF of the source P=2 angle law: zero below the quarter-circle,
`sin(theta)^2` on it, and one above it.
-/
noncomputable def pTwoSourceAngleCdf (theta : ℝ) : ℝ :=
  if theta < 0 then 0
  else if theta ≤ Real.pi / 2 then Real.sin theta ^ 2 else 1

/-- The source's P=2 angle density, interpreted on its displayed interval. -/
noncomputable def pTwoSourceAngleDensity (theta : ℝ) : ℝ :=
  2 * Real.cos theta * Real.sin theta

/--
Lebesgue measure with the source P=2 angle density on `[0, pi / 2]` and zero
density outside that interval.
-/
noncomputable def pTwoSourceAngleDensityMeasure : Measure ℝ :=
  (volume : Measure ℝ).withDensity
    ((Set.Icc (0 : ℝ) (Real.pi / 2)).indicator
      fun theta => ENNReal.ofReal (pTwoSourceAngleDensity theta))

/-- The P=2 source quarter-circle parameterization by angle. -/
noncomputable def pTwoSourceCircleFromAngle (beta theta : ℝ) : ℝ × ℝ :=
  ((2 / beta) ^ (1 / beta) * Real.cos theta,
    (2 / beta) ^ (1 / beta) * Real.sin theta)

theorem pTwoSourceAngleSample_mem_source_interval (u : I) :
    pTwoSourceAngleSample u ∈ Set.Icc (0 : ℝ) (Real.pi / 2) := by
  constructor
  · exact Real.arcsin_nonneg.mpr (Real.sqrt_nonneg _)
  · exact Real.arcsin_le_pi_div_two _

theorem pTwoSourceAngleSample_sin (u : I) :
    Real.sin (pTwoSourceAngleSample u) = Real.sqrt (u : ℝ) := by
  unfold pTwoSourceAngleSample
  apply Real.sin_arcsin
  · linarith [Real.sqrt_nonneg (u : ℝ)]
  · exact Real.sqrt_le_one.mpr u.2.2

theorem pTwoSourceAngleSample_cos (u : I) :
    Real.cos (pTwoSourceAngleSample u) = Real.sqrt (1 - (u : ℝ)) := by
  unfold pTwoSourceAngleSample
  rw [Real.cos_arcsin]
  rw [Real.sq_sqrt u.2.1]

/-- The primitive circle sampler is the source radius-angle parameterization. -/
theorem pTwoSourceCircleSample_eq_radius_trig_angle (beta : ℝ) (u : I) :
    pTwoSourceCircleSample beta u =
      pTwoSourceCircleFromAngle beta (pTwoSourceAngleSample u) := by
  unfold pTwoSourceCircleSample
  dsimp
  simp only [pTwoSourceCircleFromAngle]
  rw [pTwoSourceAngleSample_cos, pTwoSourceAngleSample_sin]

theorem pTwoSourceAngleSample_measurable :
    Measurable pTwoSourceAngleSample := by
  unfold pTwoSourceAngleSample
  fun_prop

theorem pTwoSourceCircleFromAngle_measurable (beta : ℝ) :
    Measurable (pTwoSourceCircleFromAngle beta) := by
  unfold pTwoSourceCircleFromAngle
  fun_prop

private theorem pTwoSourceAngleSample_le_iff
    {u : I} {theta : ℝ} (htheta : theta ∈ Set.Icc (0 : ℝ) (Real.pi / 2)) :
    pTwoSourceAngleSample u ≤ theta ↔ (u : ℝ) ≤ Real.sin theta ^ 2 := by
  unfold pTwoSourceAngleSample
  have hsqrt : Real.sqrt (u : ℝ) ∈ Set.Icc (-1 : ℝ) 1 := by
    constructor
    · linarith [Real.sqrt_nonneg (u : ℝ)]
    · exact Real.sqrt_le_one.mpr u.2.2
  have htheta' : theta ∈ Set.Icc (-(Real.pi / 2)) (Real.pi / 2) := by
    constructor
    · linarith [htheta.1, Real.pi_pos]
    · exact htheta.2
  rw [Real.arcsin_le_iff_le_sin hsqrt htheta']
  have hsin_nonneg : 0 ≤ Real.sin theta := by
    exact Real.sin_nonneg_of_mem_Icc
      ⟨htheta.1, htheta.2.trans (by linarith [Real.pi_pos])⟩
  refine (sq_le_sq₀ (Real.sqrt_nonneg _) hsin_nonneg).symm.trans ?_
  rw [Real.sq_sqrt u.2.1]

private theorem pTwoSourceAngleMeasure_cdf_on_source_interval
    {theta : ℝ} (htheta : theta ∈ Set.Icc (0 : ℝ) (Real.pi / 2)) :
    pTwoSourceAngleMeasure (Set.Iic theta) =
      ENNReal.ofReal (Real.sin theta ^ 2) := by
  have hsin_nonneg : 0 ≤ Real.sin theta := by
    exact Real.sin_nonneg_of_mem_Icc
      ⟨htheta.1, htheta.2.trans (by linarith [Real.pi_pos])⟩
  have hsin_le_one : Real.sin theta ≤ 1 := Real.sin_le_one _
  let threshold : I := ⟨Real.sin theta ^ 2, by
    constructor
    · exact sq_nonneg _
    · nlinarith⟩
  have hpreimage :
      {u : I | pTwoSourceAngleSample u ≤ theta} = Set.Iic threshold := by
    ext u
    change pTwoSourceAngleSample u ≤ theta ↔ (u : ℝ) ≤ Real.sin theta ^ 2
    exact pTwoSourceAngleSample_le_iff htheta
  rw [pTwoSourceAngleMeasure,
    Measure.map_apply pTwoSourceAngleSample_measurable measurableSet_Iic]
  change (volume : Measure I) {u : I | pTwoSourceAngleSample u ≤ theta} = _
  rw [hpreimage, unitInterval.volume_Iic]

private theorem pTwoSourceAngleMeasure_cdf_of_lt_zero
    {theta : ℝ} (htheta : theta < 0) :
    pTwoSourceAngleMeasure (Set.Iic theta) = 0 := by
  have hpreimage : {u : I | pTwoSourceAngleSample u ≤ theta} = ∅ := by
    ext u
    change pTwoSourceAngleSample u ≤ theta ↔ False
    constructor
    · intro h
      have hnonneg := (pTwoSourceAngleSample_mem_source_interval u).1
      linarith
    · simp
  rw [pTwoSourceAngleMeasure,
    Measure.map_apply pTwoSourceAngleSample_measurable measurableSet_Iic]
  change (volume : Measure I) {u : I | pTwoSourceAngleSample u ≤ theta} = 0
  rw [hpreimage]
  exact measure_empty

private theorem pTwoSourceAngleMeasure_cdf_of_pi_div_two_le
    {theta : ℝ} (htheta : Real.pi / 2 ≤ theta) :
    pTwoSourceAngleMeasure (Set.Iic theta) = 1 := by
  have hpreimage : {u : I | pTwoSourceAngleSample u ≤ theta} = Set.univ := by
    ext u
    simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
    exact (pTwoSourceAngleSample_mem_source_interval u).2.trans htheta
  rw [pTwoSourceAngleMeasure,
    Measure.map_apply pTwoSourceAngleSample_measurable measurableSet_Iic]
  change (volume : Measure I) {u : I | pTwoSourceAngleSample u ≤ theta} = 1
  rw [hpreimage]
  exact measure_univ

/-- The primitive angle law has the stated full source CDF. -/
theorem pTwoSourceAngleMeasure_full_cdf (theta : ℝ) :
    pTwoSourceAngleMeasure (Set.Iic theta) =
      ENNReal.ofReal (pTwoSourceAngleCdf theta) := by
  by_cases hneg : theta < 0
  · rw [pTwoSourceAngleMeasure_cdf_of_lt_zero hneg]
    simp [pTwoSourceAngleCdf, hneg]
  by_cases hle : theta ≤ Real.pi / 2
  · have htheta : theta ∈ Set.Icc (0 : ℝ) (Real.pi / 2) :=
      ⟨le_of_not_gt hneg, hle⟩
    rw [pTwoSourceAngleMeasure_cdf_on_source_interval htheta]
    simp [pTwoSourceAngleCdf, hneg, hle]
  · have hpi_le : Real.pi / 2 ≤ theta := le_of_not_ge hle
    rw [pTwoSourceAngleMeasure_cdf_of_pi_div_two_le hpi_le]
    simp [pTwoSourceAngleCdf, hneg, hle]

/--
On the source interval, the primitive angle CDF is the interval integral of
the source density.
-/
theorem pTwoSourceAngleCdf_eq_density_intervalIntegral_on_source_interval
    {theta : ℝ} (htheta : theta ∈ Set.Icc (0 : ℝ) (Real.pi / 2)) :
    pTwoSourceAngleCdf theta =
      ∫ x in (0 : ℝ)..theta, pTwoSourceAngleDensity x := by
  rw [pTwoSourceAngleCdf, if_neg (not_lt.mpr htheta.1), if_pos htheta.2]
  calc
    Real.sin theta ^ 2 =
        2 * ((Real.sin theta ^ 2 - Real.sin (0 : ℝ) ^ 2) / 2) := by
          rw [Real.sin_zero]
          ring
    _ = 2 * ∫ x in (0 : ℝ)..theta, Real.sin x * Real.cos x := by
      rw [integral_sin_mul_cos₁]
    _ = ∫ x in (0 : ℝ)..theta, 2 * (Real.sin x * Real.cos x) := by
      rw [intervalIntegral.integral_const_mul]
    _ = ∫ x in (0 : ℝ)..theta, pTwoSourceAngleDensity x := by
      apply intervalIntegral.integral_congr_ae
      filter_upwards with x hx
      simp [pTwoSourceAngleDensity]
      ring

/--
On the source interval, the primitive angle measure's CDF is the integral of
the source density.
-/
theorem pTwoSourceAngleMeasure_cdf_eq_density_intervalIntegral_on_source_interval
    {theta : ℝ} (htheta : theta ∈ Set.Icc (0 : ℝ) (Real.pi / 2)) :
    pTwoSourceAngleMeasure (Set.Iic theta) =
      ENNReal.ofReal
        (∫ x in (0 : ℝ)..theta, pTwoSourceAngleDensity x) := by
  rw [pTwoSourceAngleMeasure_cdf_on_source_interval htheta]
  congr 1
  simpa [pTwoSourceAngleCdf, not_lt.mpr htheta.1, htheta.2] using
    pTwoSourceAngleCdf_eq_density_intervalIntegral_on_source_interval htheta

private theorem pTwoSourceAngleDensity_continuous :
    Continuous pTwoSourceAngleDensity := by
  unfold pTwoSourceAngleDensity
  fun_prop

private theorem pTwoSourceAngleDensity_lintegral_Icc_eq_intervalIntegral
    {theta : ℝ} (htheta : theta ∈ Set.Icc (0 : ℝ) (Real.pi / 2)) :
    ∫⁻ x in Set.Icc (0 : ℝ) theta,
      ENNReal.ofReal (pTwoSourceAngleDensity x) =
        ENNReal.ofReal
          (∫ x in (0 : ℝ)..theta, pTwoSourceAngleDensity x) := by
  have hfi : IntegrableOn pTwoSourceAngleDensity (Set.Icc (0 : ℝ) theta) :=
    pTwoSourceAngleDensity_continuous.integrableOn_Icc
  have hnn : ∀ᵐ x ∂((volume : Measure ℝ).restrict (Set.Icc (0 : ℝ) theta)),
      0 ≤ pTwoSourceAngleDensity x := by
    filter_upwards [ae_restrict_mem measurableSet_Icc] with x hx
    simpa [pTwoSourceAngleDensity] using
      propositionPtwo_angleDensity_nonneg_on_source_interval
        ⟨hx.1, hx.2.trans htheta.2⟩
  calc
    ∫⁻ x in Set.Icc (0 : ℝ) theta,
        ENNReal.ofReal (pTwoSourceAngleDensity x) =
          ENNReal.ofReal
            (∫ x in Set.Icc (0 : ℝ) theta, pTwoSourceAngleDensity x) := by
              exact (ofReal_integral_eq_lintegral_ofReal hfi hnn).symm
    _ = ENNReal.ofReal
          (∫ x in Set.Ioc (0 : ℝ) theta, pTwoSourceAngleDensity x) := by
            rw [integral_Icc_eq_integral_Ioc]
    _ = ENNReal.ofReal
          (∫ x in (0 : ℝ)..theta, pTwoSourceAngleDensity x) := by
            rw [intervalIntegral.integral_of_le htheta.1]

private theorem pTwoSourceAngleDensityMeasure_cdf_on_source_interval
    {theta : ℝ} (htheta : theta ∈ Set.Icc (0 : ℝ) (Real.pi / 2)) :
    pTwoSourceAngleDensityMeasure (Set.Iic theta) =
      ENNReal.ofReal
        (∫ x in (0 : ℝ)..theta, pTwoSourceAngleDensity x) := by
  have hinter :
      Set.Icc (0 : ℝ) (Real.pi / 2) ∩ Set.Iic theta = Set.Icc (0 : ℝ) theta := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_Icc, Set.mem_Iic]
    constructor
    · rintro ⟨⟨hxzero, _⟩, hxtheta⟩
      exact ⟨hxzero, hxtheta⟩
    · rintro ⟨hxzero, hxtheta⟩
      exact ⟨⟨hxzero, hxtheta.trans htheta.2⟩, hxtheta⟩
  rw [pTwoSourceAngleDensityMeasure,
    withDensity_apply _ measurableSet_Iic,
    setLIntegral_indicator measurableSet_Icc, hinter]
  exact pTwoSourceAngleDensity_lintegral_Icc_eq_intervalIntegral htheta

private theorem pTwoSourceAngleDensityMeasure_cdf_of_lt_zero
    {theta : ℝ} (htheta : theta < 0) :
    pTwoSourceAngleDensityMeasure (Set.Iic theta) = 0 := by
  have hinter :
      Set.Icc (0 : ℝ) (Real.pi / 2) ∩ Set.Iic theta = ∅ := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_Icc, Set.mem_Iic, Set.mem_empty_iff_false]
    constructor
    · rintro ⟨hx, hxtheta⟩
      linarith
    · simp
  rw [pTwoSourceAngleDensityMeasure,
    withDensity_apply _ measurableSet_Iic,
    setLIntegral_indicator measurableSet_Icc, hinter]
  simp

private theorem pTwoSourceAngleDensityMeasure_cdf_of_pi_div_two_le
    {theta : ℝ} (htheta : Real.pi / 2 ≤ theta) :
    pTwoSourceAngleDensityMeasure (Set.Iic theta) = 1 := by
  have hinter :
      Set.Icc (0 : ℝ) (Real.pi / 2) ∩ Set.Iic theta = Set.Icc (0 : ℝ) (Real.pi / 2) := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_Icc, Set.mem_Iic]
    constructor
    · rintro ⟨hx, _⟩
      exact hx
    · intro hx
      exact ⟨hx, hx.2.trans htheta⟩
  rw [pTwoSourceAngleDensityMeasure,
    withDensity_apply _ measurableSet_Iic,
    setLIntegral_indicator measurableSet_Icc, hinter]
  have hpi_nonneg : 0 ≤ Real.pi / 2 := by linarith [Real.pi_pos]
  rw [pTwoSourceAngleDensity_lintegral_Icc_eq_intervalIntegral
    ⟨hpi_nonneg, le_rfl⟩]
  simp only [pTwoSourceAngleDensity]
  rw [propositionPtwo_angleDensity_intervalIntegral_eq_one]
  norm_num

private theorem pTwoSourceAngleDensityMeasure_full_cdf (theta : ℝ) :
    pTwoSourceAngleDensityMeasure (Set.Iic theta) =
      ENNReal.ofReal (pTwoSourceAngleCdf theta) := by
  by_cases hneg : theta < 0
  · rw [pTwoSourceAngleDensityMeasure_cdf_of_lt_zero hneg]
    simp [pTwoSourceAngleCdf, hneg]
  by_cases hle : theta ≤ Real.pi / 2
  · have htheta : theta ∈ Set.Icc (0 : ℝ) (Real.pi / 2) :=
      ⟨le_of_not_gt hneg, hle⟩
    rw [pTwoSourceAngleDensityMeasure_cdf_on_source_interval htheta]
    rw [← pTwoSourceAngleCdf_eq_density_intervalIntegral_on_source_interval htheta]
  · have hpi_le : Real.pi / 2 ≤ theta := le_of_not_ge hle
    rw [pTwoSourceAngleDensityMeasure_cdf_of_pi_div_two_le hpi_le]
    simp [pTwoSourceAngleCdf, hneg, hle]

theorem pTwoSourceAngleMeasure_isProbabilityMeasure :
    IsProbabilityMeasure pTwoSourceAngleMeasure := by
  unfold pTwoSourceAngleMeasure
  exact Measure.isProbabilityMeasure_map pTwoSourceAngleSample_measurable.aemeasurable

/--
The primitive source angle law is exactly Lebesgue measure with density
`2 cos(theta) sin(theta)` on the source quarter-circle interval.
-/
theorem pTwoSourceAngleMeasure_eq_densityMeasure :
    pTwoSourceAngleMeasure = pTwoSourceAngleDensityMeasure := by
  letI : IsProbabilityMeasure pTwoSourceAngleMeasure :=
    pTwoSourceAngleMeasure_isProbabilityMeasure
  apply Measure.ext_of_Iic
  intro theta
  rw [pTwoSourceAngleMeasure_full_cdf,
    pTwoSourceAngleDensityMeasure_full_cdf]

/--
The probability measure induced by the primitive P=2 source-circle sampler.
Its exact support, coordinate CDF components, and source angle law are proved
below; this construction alone does not establish C3 or equilibrium.
-/
noncomputable def pTwoSourceCircleMeasure (beta : ℝ) : Measure (ℝ × ℝ) :=
  Measure.map (pTwoSourceCircleSample beta) (volume : Measure I)

/--
The primitive P=2 circle law is the source angle law pushed through the
quarter-circle parameterization.
-/
theorem pTwoSourceCircleMeasure_eq_angleMeasure_map (beta : ℝ) :
    pTwoSourceCircleMeasure beta =
      Measure.map (pTwoSourceCircleFromAngle beta) pTwoSourceAngleMeasure := by
  unfold pTwoSourceCircleMeasure pTwoSourceAngleMeasure
  rw [Measure.map_map (pTwoSourceCircleFromAngle_measurable beta)
    pTwoSourceAngleSample_measurable]
  apply Measure.map_congr
  filter_upwards with u
  exact pTwoSourceCircleSample_eq_radius_trig_angle beta u

/--
The primitive P=2 circle law is the quarter-circle parameterization of the
source angle density measure.
-/
theorem pTwoSourceCircleMeasure_eq_densityAngleMeasure_map (beta : ℝ) :
    pTwoSourceCircleMeasure beta =
      Measure.map (pTwoSourceCircleFromAngle beta) pTwoSourceAngleDensityMeasure := by
  rw [pTwoSourceCircleMeasure_eq_angleMeasure_map,
    pTwoSourceAngleMeasure_eq_densityMeasure]

/-- The literal nonnegative quarter-circle used as the source support in P=2. -/
def pTwoSourceCircleSupportSet (beta : ℝ) : Set (ℝ × ℝ) :=
  {z | 0 ≤ z.1 ∧ 0 ≤ z.2 ∧
    z.1 ^ 2 + z.2 ^ 2 = (2 / beta) ^ (2 / beta)}

/--
The P=2 source marginal CDF, extended from the source's nonnegative domain to
all real thresholds by the required zero branch below zero. On nonnegative
thresholds this is the `min` formula used in the source objective.
-/
noncomputable def pTwoSourceMarginalCdf (beta z : ℝ) : ℝ :=
  if z < 0 then 0
  else min ((2 / beta) ^ (-(2 / beta)) * z ^ 2) 1

/--
The full coordinate CDF induced by the concrete P=2 sampler. Its outer
branches are properties of this construction; the source only displays the
quadratic formula on the nonnegative support interval.
-/
noncomputable def pTwoSourceCircleFullCoordinateCdf (beta z : ℝ) : ℝ :=
  if z < 0 then 0
  else if z ≤ (2 / beta) ^ (1 / beta) then
    (2 / beta) ^ (-(2 / beta)) * z ^ 2
  else 1

theorem pTwoSourceCircleSample_measurable (beta : ℝ) :
    Measurable (pTwoSourceCircleSample beta) := by
  unfold pTwoSourceCircleSample
  fun_prop

theorem pTwoSourceCircleSample_continuous (beta : ℝ) :
    Continuous (pTwoSourceCircleSample beta) := by
  unfold pTwoSourceCircleSample
  fun_prop

theorem pTwoSourceCircleMeasure_isProbabilityMeasure (beta : ℝ) :
    IsProbabilityMeasure (pTwoSourceCircleMeasure beta) := by
  unfold pTwoSourceCircleMeasure
  exact Measure.isProbabilityMeasure_map
    (pTwoSourceCircleSample_measurable beta).aemeasurable

theorem pTwoSourceCircleSample_nonnegative
    {beta : ℝ} (hbeta : 2 ≤ beta) (u : I) :
    0 ≤ (pTwoSourceCircleSample beta u).1 ∧
      0 ≤ (pTwoSourceCircleSample beta u).2 := by
  have hbeta_pos : 0 < beta := by linarith
  have hradius_nonneg : 0 ≤ (2 / beta) ^ (1 / beta) :=
    Real.rpow_nonneg (div_pos (by norm_num) hbeta_pos).le _
  unfold pTwoSourceCircleSample
  dsimp
  exact ⟨mul_nonneg hradius_nonneg (Real.sqrt_nonneg _),
    mul_nonneg hradius_nonneg (Real.sqrt_nonneg _)⟩

theorem pTwoSourceCircleSample_coordinates_le_radius
    {beta : ℝ} (hbeta : 2 ≤ beta) (u : I) :
    (pTwoSourceCircleSample beta u).1 ≤ (2 / beta) ^ (1 / beta) ∧
      (pTwoSourceCircleSample beta u).2 ≤ (2 / beta) ^ (1 / beta) := by
  have hbeta_pos : 0 < beta := by linarith
  have hbase_pos : 0 < 2 / beta := div_pos (by norm_num) hbeta_pos
  have hradius_nonneg : 0 ≤ (2 / beta) ^ (1 / beta) :=
    (Real.rpow_pos_of_pos hbase_pos _).le
  have hfirst_sqrt_le_one : Real.sqrt (1 - (u : ℝ)) ≤ 1 := by
    exact Real.sqrt_le_one.mpr (sub_le_self _ u.2.1)
  have hsecond_sqrt_le_one : Real.sqrt (u : ℝ) ≤ 1 := by
    exact Real.sqrt_le_one.mpr u.2.2
  unfold pTwoSourceCircleSample
  dsimp
  constructor
  · calc
      (2 / beta) ^ (1 / beta) * Real.sqrt (1 - (u : ℝ)) ≤
          (2 / beta) ^ (1 / beta) * 1 :=
        mul_le_mul_of_nonneg_left hfirst_sqrt_le_one hradius_nonneg
      _ = (2 / beta) ^ (1 / beta) := mul_one _
  · calc
      (2 / beta) ^ (1 / beta) * Real.sqrt (u : ℝ) ≤
          (2 / beta) ^ (1 / beta) * 1 :=
        mul_le_mul_of_nonneg_left hsecond_sqrt_le_one hradius_nonneg
      _ = (2 / beta) ^ (1 / beta) := mul_one _

theorem pTwoSourceCircleSample_on_literal_circle
    {beta : ℝ} (hbeta : 2 ≤ beta) (u : I) :
    (pTwoSourceCircleSample beta u).1 ^ 2 +
      (pTwoSourceCircleSample beta u).2 ^ 2 =
        (2 / beta) ^ (2 / beta) := by
  have hbeta_pos : 0 < beta := by linarith
  have hbase_nonneg : 0 ≤ 2 / beta := (div_pos (by norm_num) hbeta_pos).le
  have hu_nonneg : 0 ≤ (u : ℝ) := u.2.1
  have hone_sub_u_nonneg : 0 ≤ 1 - (u : ℝ) := sub_nonneg.mpr u.2.2
  have hradius_sq : ((2 / beta) ^ (1 / beta)) ^ 2 = (2 / beta) ^ (2 / beta) := by
    rw [← Real.rpow_mul_natCast hbase_nonneg (1 / beta) 2]
    congr 1
    ring
  unfold pTwoSourceCircleSample
  dsimp
  rw [mul_pow, mul_pow, Real.sq_sqrt hone_sub_u_nonneg, Real.sq_sqrt hu_nonneg]
  rw [← mul_add]
  rw [sub_add_cancel]
  simpa using hradius_sq

/--
The constructed P=2 measure lies almost everywhere on the literal
nonnegative quarter-circle. This is deliberately weaker than a topological
support-equality claim.
-/
theorem pTwoSourceCircleMeasure_ae_on_literal_circle
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    ∀ᵐ z ∂pTwoSourceCircleMeasure beta,
      0 ≤ z.1 ∧ 0 ≤ z.2 ∧
        z.1 ^ 2 + z.2 ^ 2 = (2 / beta) ^ (2 / beta) := by
  have hmeas :
      MeasurableSet {z : ℝ × ℝ |
        0 ≤ z.1 ∧ 0 ≤ z.2 ∧
          z.1 ^ 2 + z.2 ^ 2 = (2 / beta) ^ (2 / beta)} := by
    have hfirst : MeasurableSet {z : ℝ × ℝ | 0 ≤ z.1} := by
      exact measurable_fst measurableSet_Ici
    have hsecond : MeasurableSet {z : ℝ × ℝ | 0 ≤ z.2} := by
      exact measurable_snd measurableSet_Ici
    have hsum : Measurable fun z : ℝ × ℝ => z.1 ^ 2 + z.2 ^ 2 := by
      fun_prop
    have heq : MeasurableSet {z : ℝ × ℝ |
        z.1 ^ 2 + z.2 ^ 2 = (2 / beta) ^ (2 / beta)} := by
      exact measurableSet_eq_fun hsum measurable_const
    exact hfirst.inter (hsecond.inter heq)
  rw [pTwoSourceCircleMeasure,
    ae_map_iff (pTwoSourceCircleSample_measurable beta).aemeasurable hmeas]
  filter_upwards with u
  exact ⟨(pTwoSourceCircleSample_nonnegative hbeta u).1,
    (pTwoSourceCircleSample_nonnegative hbeta u).2,
    pTwoSourceCircleSample_on_literal_circle hbeta u⟩

private theorem unitInterval_volume_mem_support (x : I) :
    x ∈ (volume : Measure I).support := by
  rw [Measure.mem_support_iff_forall]
  intro U hU
  rcases Metric.mem_nhds_iff.mp hU with ⟨epsilon, hepsilon_pos, hball⟩
  let delta : ℝ := min (epsilon / 4) (1 / 4)
  have hdelta_pos : 0 < delta := by
    dsimp [delta]
    exact lt_min (by linarith) (by norm_num)
  have hdelta_le_quarter : delta ≤ 1 / 4 := min_le_right _ _
  have hdelta_lt_epsilon : delta < epsilon :=
    lt_of_le_of_lt (min_le_left _ _) (by linarith)
  by_cases hx : (x : ℝ) ≤ 1 / 2
  · let a : I := ⟨x, x.2⟩
    let b : I := ⟨(x : ℝ) + delta, by
      constructor
      · linarith [x.2.1, hdelta_pos]
      · linarith [x.2.2, hx, hdelta_le_quarter]⟩
    have hab : a < b := by
      change (x : ℝ) < (x : ℝ) + delta
      linarith
    have hinterval_ball : Set.Ioo a b ⊆ Metric.ball x epsilon := by
      intro y hy
      rw [Metric.mem_ball]
      change |(y : ℝ) - x| < epsilon
      have hy_lower : (x : ℝ) < y := hy.1
      have hy_upper : (y : ℝ) < (x : ℝ) + delta := hy.2
      rw [abs_of_nonneg (by linarith)]
      linarith
    have hinterval_pos : 0 < (volume : Measure I) (Set.Ioo a b) := by
      rw [unitInterval.volume_Ioo]
      exact ENNReal.ofReal_pos.mpr (sub_pos.mpr hab)
    exact lt_of_lt_of_le hinterval_pos (measure_mono (hinterval_ball.trans hball))
  · let a : I := ⟨(x : ℝ) - delta, by
      constructor
      · linarith [x.2.1, hx, hdelta_le_quarter]
      · linarith [x.2.2, hdelta_pos]⟩
    let b : I := ⟨x, x.2⟩
    have hab : a < b := by
      change (x : ℝ) - delta < (x : ℝ)
      linarith
    have hinterval_ball : Set.Ioo a b ⊆ Metric.ball x epsilon := by
      intro y hy
      rw [Metric.mem_ball]
      change |(y : ℝ) - x| < epsilon
      have hy_lower : (x : ℝ) - delta < y := hy.1
      have hy_upper : (y : ℝ) < x := hy.2
      rw [abs_of_nonpos (by linarith)]
      linarith
    have hinterval_pos : 0 < (volume : Measure I) (Set.Ioo a b) := by
      rw [unitInterval.volume_Ioo]
      exact ENNReal.ofReal_pos.mpr (sub_pos.mpr hab)
    exact lt_of_lt_of_le hinterval_pos (measure_mono (hinterval_ball.trans hball))

theorem pTwoSourceCircleSample_range_eq_supportSet
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    Set.range (pTwoSourceCircleSample beta) = pTwoSourceCircleSupportSet beta := by
  ext z
  constructor
  · rintro ⟨u, rfl⟩
    exact ⟨(pTwoSourceCircleSample_nonnegative hbeta u).1,
      (pTwoSourceCircleSample_nonnegative hbeta u).2,
      pTwoSourceCircleSample_on_literal_circle hbeta u⟩
  · rintro ⟨hx_nonneg, hy_nonneg, hcircle⟩
    have hbeta_pos : 0 < beta := by linarith
    have hbase_pos : 0 < 2 / beta := div_pos (by norm_num) hbeta_pos
    let radius : ℝ := (2 / beta) ^ (1 / beta)
    have hradius_pos : 0 < radius := by
      dsimp [radius]
      exact Real.rpow_pos_of_pos hbase_pos _
    have hradius_nonneg : 0 ≤ radius := hradius_pos.le
    have hradius_ne : radius ≠ 0 := ne_of_gt hradius_pos
    have hbase_nonneg : 0 ≤ 2 / beta := hbase_pos.le
    have hradius_sq : radius ^ 2 = (2 / beta) ^ (2 / beta) := by
      dsimp [radius]
      rw [← Real.rpow_mul_natCast hbase_nonneg (1 / beta) 2]
      congr 1
      ring
    have hy_sq_le : z.2 ^ 2 ≤ radius ^ 2 := by
      rw [hradius_sq]
      nlinarith
    have hy_le_radius : z.2 ≤ radius :=
      (sq_le_sq₀ hy_nonneg hradius_nonneg).mp hy_sq_le
    have hy_div_nonneg : 0 ≤ z.2 / radius := div_nonneg hy_nonneg hradius_nonneg
    have hy_div_le_one : z.2 / radius ≤ 1 := by
      apply (div_le_iff₀ hradius_pos).mpr
      simpa using hy_le_radius
    have hu_le_one : (z.2 / radius) ^ 2 ≤ 1 := by
      nlinarith [mul_nonneg hy_div_nonneg (sub_nonneg.mpr hy_div_le_one)]
    let u : I := ⟨(z.2 / radius) ^ 2, ⟨sq_nonneg _, hu_le_one⟩⟩
    refine ⟨u, ?_⟩
    have hy_coordinate : radius * Real.sqrt (u : ℝ) = z.2 := by
      change radius * Real.sqrt ((z.2 / radius) ^ 2) = z.2
      rw [Real.sqrt_sq_eq_abs, abs_of_nonneg hy_div_nonneg]
      field_simp
    have hx_div_nonneg : 0 ≤ z.1 / radius := div_nonneg hx_nonneg hradius_nonneg
    have hfirst_inside : 1 - (u : ℝ) = (z.1 / radius) ^ 2 := by
      change 1 - (z.2 / radius) ^ 2 = (z.1 / radius) ^ 2
      field_simp
      rw [hradius_sq]
      linarith
    have hx_coordinate : radius * Real.sqrt (1 - (u : ℝ)) = z.1 := by
      rw [hfirst_inside, Real.sqrt_sq_eq_abs, abs_of_nonneg hx_div_nonneg]
      field_simp
    unfold pTwoSourceCircleSample
    dsimp
    exact Prod.ext hx_coordinate hy_coordinate

private theorem pTwoSourceCircleSupportSet_isClosed (beta : ℝ) :
    IsClosed (pTwoSourceCircleSupportSet beta) := by
  apply IsClosed.inter
  · exact isClosed_le continuous_const continuous_fst
  apply IsClosed.inter
  · exact isClosed_le continuous_const continuous_snd
  exact isClosed_eq (continuous_fst.pow 2 |>.add (continuous_snd.pow 2)) continuous_const

/--
The concrete P=2 measure has exactly the literal quarter-circle as its
topological support. This closes the support component of C2, but not C3 or
the mixed-equilibrium conclusion.
-/
theorem pTwoSourceCircleMeasure_support_eq_supportSet
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    (pTwoSourceCircleMeasure beta).support = pTwoSourceCircleSupportSet beta := by
  apply Set.Subset.antisymm
  · apply Measure.support_subset_of_isClosed (pTwoSourceCircleSupportSet_isClosed beta)
    change ∀ᵐ z ∂pTwoSourceCircleMeasure beta, z ∈ pTwoSourceCircleSupportSet beta
    exact pTwoSourceCircleMeasure_ae_on_literal_circle hbeta
  · intro z hz
    rw [Measure.support_eq_forall_isOpen]
    intro U hzU hUopen
    rw [pTwoSourceCircleMeasure,
      Measure.map_apply (pTwoSourceCircleSample_measurable beta) hUopen.measurableSet]
    rw [← pTwoSourceCircleSample_range_eq_supportSet hbeta] at hz
    rcases hz with ⟨u, rfl⟩
    apply (Measure.mem_support_iff_forall u).mp (unitInterval_volume_mem_support u)
    apply (pTwoSourceCircleSample_continuous beta).continuousAt
    exact hUopen.mem_nhds hzU

/--
For the second source coordinate, the constructed measure has the quadratic
candidate CDF on the literal source interval. The result does not state the
off-support CDF branches.
-/
theorem pTwoSourceCircleMeasure_second_cdf_on_source_interval
    {beta z : ℝ} (hbeta : 2 ≤ beta)
    (hz : z ∈ Set.Icc (0 : ℝ) ((2 / beta) ^ (1 / beta))) :
    pTwoSourceCircleMeasure beta {point : ℝ × ℝ | point.2 ≤ z} =
      ENNReal.ofReal ((2 / beta) ^ (-(2 / beta)) * z ^ 2) := by
  have hbeta_pos : 0 < beta := by linarith
  have hbase_pos : 0 < 2 / beta := div_pos (by norm_num) hbeta_pos
  have hbase_nonneg : 0 ≤ 2 / beta := hbase_pos.le
  let radius : ℝ := (2 / beta) ^ (1 / beta)
  have hradius_pos : 0 < radius := by
    dsimp [radius]
    exact Real.rpow_pos_of_pos hbase_pos _
  have hradius_ne : radius ≠ 0 := ne_of_gt hradius_pos
  have hradius_sq_ne : radius ^ 2 ≠ 0 := pow_ne_zero _ hradius_ne
  have hratio_nonneg : 0 ≤ z / radius := div_nonneg hz.1 hradius_pos.le
  have hratio_le_one : z / radius ≤ 1 := by
    apply (div_le_iff₀ hradius_pos).mpr
    simpa [radius] using hz.2
  have hthreshold_le_one : (z / radius) ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg hratio_nonneg (sub_nonneg.mpr hratio_le_one)]
  let threshold : I :=
    ⟨(z / radius) ^ 2, ⟨sq_nonneg _, hthreshold_le_one⟩⟩
  have hpreimage :
      {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} = Set.Iic threshold := by
    ext u
    change radius * Real.sqrt (u : ℝ) ≤ z ↔ (u : ℝ) ≤ (z / radius) ^ 2
    constructor
    · intro hle
      have hproduct_nonneg : 0 ≤ radius * Real.sqrt (u : ℝ) :=
        mul_nonneg hradius_pos.le (Real.sqrt_nonneg _)
      have hsquares : (radius * Real.sqrt (u : ℝ)) ^ 2 ≤ z ^ 2 :=
        (sq_le_sq₀ hproduct_nonneg hz.1).mpr hle
      rw [mul_pow, Real.sq_sqrt u.2.1] at hsquares
      rw [div_pow]
      exact (le_div_iff₀ (sq_pos_of_pos hradius_pos)).mpr (by
        simpa [mul_comm] using hsquares)
    · intro hu
      have hproduct_nonneg : 0 ≤ radius * Real.sqrt (u : ℝ) :=
        mul_nonneg hradius_pos.le (Real.sqrt_nonneg _)
      have hsquares : (radius * Real.sqrt (u : ℝ)) ^ 2 ≤ z ^ 2 := by
        rw [mul_pow, Real.sq_sqrt u.2.1]
        rw [div_pow] at hu
        have hmult := mul_le_mul_of_nonneg_right hu (sq_nonneg radius)
        calc
          radius ^ 2 * (u : ℝ) = (u : ℝ) * radius ^ 2 := by ring
          _ ≤ (z ^ 2 / radius ^ 2) * radius ^ 2 := hmult
          _ = z ^ 2 := div_mul_cancel₀ _ hradius_sq_ne
      exact (sq_le_sq₀ hproduct_nonneg hz.1).mp hsquares
  have hset_meas : MeasurableSet {point : ℝ × ℝ | point.2 ≤ z} := by
    exact measurable_snd measurableSet_Iic
  have hradius_sq : radius ^ 2 = (2 / beta) ^ (2 / beta) := by
    dsimp [radius]
    rw [← Real.rpow_mul_natCast hbase_nonneg (1 / beta) 2]
    congr 1
    ring
  have hcoeff_radius :
      (2 / beta) ^ (-(2 / beta)) * radius ^ 2 = 1 := by
    rw [hradius_sq]
    exact standardBasis_coeff_mul_radius_eq_one hbeta_pos
  have hratio_eq :
      (z / radius) ^ 2 = (2 / beta) ^ (-(2 / beta)) * z ^ 2 := by
    rw [div_pow]
    apply (div_eq_iff hradius_sq_ne).mpr
    calc
      z ^ 2 = 1 * z ^ 2 := by ring
      _ = ((2 / beta) ^ (-(2 / beta)) * radius ^ 2) * z ^ 2 := by
        rw [hcoeff_radius]
      _ = ((2 / beta) ^ (-(2 / beta)) * z ^ 2) * radius ^ 2 := by ring
  rw [pTwoSourceCircleMeasure,
    Measure.map_apply (pTwoSourceCircleSample_measurable beta) hset_meas]
  change (volume : Measure I) {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} = _
  rw [hpreimage, unitInterval.volume_Iic]
  change ENNReal.ofReal ((z / radius) ^ 2) = _
  rw [hratio_eq]

/--
The first source coordinate has the same CDF on the source interval, derived
from the measure-preserving unit-interval involution `u |-> 1 - u`.
-/
theorem pTwoSourceCircleMeasure_first_cdf_on_source_interval
    {beta z : ℝ} (hbeta : 2 ≤ beta)
    (hz : z ∈ Set.Icc (0 : ℝ) ((2 / beta) ^ (1 / beta))) :
    pTwoSourceCircleMeasure beta {point : ℝ × ℝ | point.1 ≤ z} =
      ENNReal.ofReal ((2 / beta) ^ (-(2 / beta)) * z ^ 2) := by
  have hfirst_meas : MeasurableSet {point : ℝ × ℝ | point.1 ≤ z} := by
    exact measurable_fst measurableSet_Iic
  have hsecond_meas : MeasurableSet {point : ℝ × ℝ | point.2 ≤ z} := by
    exact measurable_snd measurableSet_Iic
  have hsecond_preimage_meas :
      MeasurableSet {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} := by
    exact (measurable_snd.comp (pTwoSourceCircleSample_measurable beta)) measurableSet_Iic
  have hfirst_preimage :
      {u : I | (pTwoSourceCircleSample beta u).1 ≤ z} =
        unitInterval.symm ⁻¹' {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} := by
    ext u
    simp [pTwoSourceCircleSample, unitInterval.coe_symm_eq]
  have hsecond_cdf :=
    pTwoSourceCircleMeasure_second_cdf_on_source_interval hbeta hz
  rw [pTwoSourceCircleMeasure,
    Measure.map_apply (pTwoSourceCircleSample_measurable beta) hsecond_meas] at hsecond_cdf
  rw [pTwoSourceCircleMeasure,
    Measure.map_apply (pTwoSourceCircleSample_measurable beta) hfirst_meas]
  change (volume : Measure I) {u : I | (pTwoSourceCircleSample beta u).1 ≤ z} = _
  rw [hfirst_preimage]
  calc
    (volume : Measure I)
        (unitInterval.symm ⁻¹' {u : I | (pTwoSourceCircleSample beta u).2 ≤ z}) =
        volume {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} :=
      unitInterval.measurePreserving_symm.measure_preimage
        hsecond_preimage_meas.nullMeasurableSet
    _ = ENNReal.ofReal ((2 / beta) ^ (-(2 / beta)) * z ^ 2) := hsecond_cdf

theorem pTwoSourceCircleMeasure_second_cdf_of_lt_zero
    {beta z : ℝ} (hbeta : 2 ≤ beta) (hz : z < 0) :
    pTwoSourceCircleMeasure beta {point : ℝ × ℝ | point.2 ≤ z} = 0 := by
  have hset_meas : MeasurableSet {point : ℝ × ℝ | point.2 ≤ z} := by
    exact measurable_snd measurableSet_Iic
  have hpreimage :
      {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} = ∅ := by
    ext u
    change (pTwoSourceCircleSample beta u).2 ≤ z ↔ False
    constructor
    · intro hle
      have hnonneg := (pTwoSourceCircleSample_nonnegative hbeta u).2
      linarith
    · simp
  rw [pTwoSourceCircleMeasure,
    Measure.map_apply (pTwoSourceCircleSample_measurable beta) hset_meas]
  change (volume : Measure I) {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} = 0
  rw [hpreimage]
  exact measure_empty

theorem pTwoSourceCircleMeasure_second_cdf_of_radius_le
    {beta z : ℝ} (hbeta : 2 ≤ beta)
    (hz : (2 / beta) ^ (1 / beta) ≤ z) :
    pTwoSourceCircleMeasure beta {point : ℝ × ℝ | point.2 ≤ z} = 1 := by
  have hset_meas : MeasurableSet {point : ℝ × ℝ | point.2 ≤ z} := by
    exact measurable_snd measurableSet_Iic
  have hpreimage :
      {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} = Set.univ := by
    ext u
    simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
    exact (pTwoSourceCircleSample_coordinates_le_radius hbeta u).2.trans hz
  rw [pTwoSourceCircleMeasure,
    Measure.map_apply (pTwoSourceCircleSample_measurable beta) hset_meas]
  change (volume : Measure I) {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} = 1
  rw [hpreimage]
  exact measure_univ

/--
The concrete P=2 measure has the stated quadratic coordinate CDF on its
support and the correct zero/one branches outside it. This proves a full CDF
for the construction; the exact topological-support and source-CDF bridges are
proved separately.
-/
theorem pTwoSourceCircleMeasure_second_full_cdf
    {beta z : ℝ} (hbeta : 2 ≤ beta) :
    pTwoSourceCircleMeasure beta {point : ℝ × ℝ | point.2 ≤ z} =
      ENNReal.ofReal (pTwoSourceCircleFullCoordinateCdf beta z) := by
  by_cases hzneg : z < 0
  · rw [pTwoSourceCircleMeasure_second_cdf_of_lt_zero hbeta hzneg]
    simp [pTwoSourceCircleFullCoordinateCdf, hzneg]
  by_cases hzle : z ≤ (2 / beta) ^ (1 / beta)
  · have hzmem : z ∈ Set.Icc (0 : ℝ) ((2 / beta) ^ (1 / beta)) :=
      ⟨le_of_not_gt hzneg, hzle⟩
    have hzle' : z ≤ (2 / beta) ^ beta⁻¹ := by
      simpa [one_div] using hzle
    rw [pTwoSourceCircleMeasure_second_cdf_on_source_interval hbeta hzmem]
    simp [pTwoSourceCircleFullCoordinateCdf, hzneg, hzle']
  · have hradius_le : (2 / beta) ^ (1 / beta) ≤ z := le_of_not_ge hzle
    have hzle' : ¬ z ≤ (2 / beta) ^ beta⁻¹ := by
      simpa [one_div] using hzle
    rw [pTwoSourceCircleMeasure_second_cdf_of_radius_le hbeta hradius_le]
    simp [pTwoSourceCircleFullCoordinateCdf, hzneg, hzle']

theorem pTwoSourceCircleMeasure_first_full_cdf
    {beta z : ℝ} (hbeta : 2 ≤ beta) :
    pTwoSourceCircleMeasure beta {point : ℝ × ℝ | point.1 ≤ z} =
      ENNReal.ofReal (pTwoSourceCircleFullCoordinateCdf beta z) := by
  have hfirst_meas : MeasurableSet {point : ℝ × ℝ | point.1 ≤ z} := by
    exact measurable_fst measurableSet_Iic
  have hsecond_meas : MeasurableSet {point : ℝ × ℝ | point.2 ≤ z} := by
    exact measurable_snd measurableSet_Iic
  have hsecond_preimage_meas :
      MeasurableSet {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} := by
    exact (measurable_snd.comp (pTwoSourceCircleSample_measurable beta)) measurableSet_Iic
  have hfirst_preimage :
      {u : I | (pTwoSourceCircleSample beta u).1 ≤ z} =
        unitInterval.symm ⁻¹' {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} := by
    ext u
    simp [pTwoSourceCircleSample, unitInterval.coe_symm_eq]
  have hsecond_cdf := pTwoSourceCircleMeasure_second_full_cdf hbeta (z := z)
  rw [pTwoSourceCircleMeasure,
    Measure.map_apply (pTwoSourceCircleSample_measurable beta) hsecond_meas] at hsecond_cdf
  rw [pTwoSourceCircleMeasure,
    Measure.map_apply (pTwoSourceCircleSample_measurable beta) hfirst_meas]
  change (volume : Measure I) {u : I | (pTwoSourceCircleSample beta u).1 ≤ z} = _
  rw [hfirst_preimage]
  calc
    (volume : Measure I)
        (unitInterval.symm ⁻¹' {u : I | (pTwoSourceCircleSample beta u).2 ≤ z}) =
        volume {u : I | (pTwoSourceCircleSample beta u).2 ≤ z} :=
      unitInterval.measurePreserving_symm.measure_preimage
        hsecond_preimage_meas.nullMeasurableSet
    _ = ENNReal.ofReal (pTwoSourceCircleFullCoordinateCdf beta z) := hsecond_cdf

/--
For `beta >= 2`, the full CDF of the construction is exactly the source
marginal CDF, including its natural zero extension below the source's
nonnegative domain.
-/
theorem pTwoSourceCircleFullCoordinateCdf_eq_sourceMarginalCdf
    {beta z : ℝ} (hbeta : 2 ≤ beta) :
    pTwoSourceCircleFullCoordinateCdf beta z = pTwoSourceMarginalCdf beta z := by
  have hbeta_pos : 0 < beta := by linarith
  have hbase_pos : 0 < 2 / beta := div_pos (by norm_num) hbeta_pos
  have hbase_nonneg : 0 ≤ 2 / beta := hbase_pos.le
  let radius : ℝ := (2 / beta) ^ (1 / beta)
  let coeff : ℝ := (2 / beta) ^ (-(2 / beta))
  have hradius_nonneg : 0 ≤ radius := by
    dsimp [radius]
    exact Real.rpow_nonneg hbase_nonneg _
  have hcoeff_nonneg : 0 ≤ coeff := by
    dsimp [coeff]
    exact Real.rpow_nonneg hbase_nonneg _
  have hradius_sq : radius ^ 2 = (2 / beta) ^ (2 / beta) := by
    dsimp [radius]
    rw [← Real.rpow_mul_natCast hbase_nonneg (1 / beta) 2]
    congr 1
    ring
  have hcoeff_radius : coeff * radius ^ 2 = 1 := by
    rw [hradius_sq]
    dsimp [coeff]
    exact standardBasis_coeff_mul_radius_eq_one hbeta_pos
  by_cases hzneg : z < 0
  · simp [pTwoSourceCircleFullCoordinateCdf, pTwoSourceMarginalCdf, hzneg]
  by_cases hzle : z ≤ radius
  · have hz_nonneg : 0 ≤ z := le_of_not_gt hzneg
    have hzsquare_le : z ^ 2 ≤ radius ^ 2 := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hzle) (add_nonneg hz_nonneg hradius_nonneg)]
    have hvalue_le : coeff * z ^ 2 ≤ 1 := by
      calc
        coeff * z ^ 2 ≤ coeff * radius ^ 2 :=
          mul_le_mul_of_nonneg_left hzsquare_le hcoeff_nonneg
        _ = 1 := hcoeff_radius
    have hzle' : z ≤ (2 / beta) ^ (1 / beta) := by
      simpa [radius] using hzle
    have hvalue_le' : (2 / beta) ^ (-(2 / beta)) * z ^ 2 ≤ 1 := by
      simpa [coeff] using hvalue_le
    unfold pTwoSourceCircleFullCoordinateCdf
    rw [if_neg hzneg, if_pos hzle']
    unfold pTwoSourceMarginalCdf
    rw [if_neg hzneg, min_eq_left hvalue_le']
  · have hz_nonneg : 0 ≤ z := le_of_not_gt hzneg
    have hradius_lt : radius < z := lt_of_not_ge hzle
    have hzsquare_le : radius ^ 2 ≤ z ^ 2 := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hradius_lt.le) (add_nonneg hradius_nonneg hz_nonneg)]
    have hvalue_ge : 1 ≤ coeff * z ^ 2 := by
      calc
        1 = coeff * radius ^ 2 := hcoeff_radius.symm
        _ ≤ coeff * z ^ 2 := mul_le_mul_of_nonneg_left hzsquare_le hcoeff_nonneg
    have hzle' : ¬z ≤ (2 / beta) ^ (1 / beta) := by
      simpa [radius] using hzle
    have hvalue_ge' : 1 ≤ (2 / beta) ^ (-(2 / beta)) * z ^ 2 := by
      simpa [coeff] using hvalue_ge
    unfold pTwoSourceCircleFullCoordinateCdf
    rw [if_neg hzneg, if_neg hzle']
    unfold pTwoSourceMarginalCdf
    rw [if_neg hzneg, min_eq_right hvalue_ge']

/-- In the source's P=2 case, the C2 exponent `1 / (P - 1)` is exactly one. -/
theorem pTwoSourceMarginalCdf_rpow_twoProducerExponent
    (beta z : ℝ) :
    (pTwoSourceMarginalCdf beta z) ^ (1 / ((2 : ℝ) - 1)) =
      pTwoSourceMarginalCdf beta z := by
  norm_num

/--
The first coordinate of the constructed P=2 measure satisfies the literal C2
marginal-CDF equation with the source CDF and the explicit P=2 exponent.
-/
theorem pTwoSourceCircleMeasure_first_cdf_eq_sourceMarginalCdf
    {beta z : ℝ} (hbeta : 2 ≤ beta) :
    pTwoSourceCircleMeasure beta {point : ℝ × ℝ | point.1 ≤ z} =
      ENNReal.ofReal ((pTwoSourceMarginalCdf beta z) ^ (1 / ((2 : ℝ) - 1))) := by
  rw [pTwoSourceCircleMeasure_first_full_cdf hbeta,
    pTwoSourceCircleFullCoordinateCdf_eq_sourceMarginalCdf hbeta,
    pTwoSourceMarginalCdf_rpow_twoProducerExponent]

/--
The second coordinate of the constructed P=2 measure satisfies the literal C2
marginal-CDF equation with the source CDF and the explicit P=2 exponent.
-/
theorem pTwoSourceCircleMeasure_second_cdf_eq_sourceMarginalCdf
    {beta z : ℝ} (hbeta : 2 ≤ beta) :
    pTwoSourceCircleMeasure beta {point : ℝ × ℝ | point.2 ≤ z} =
      ENNReal.ofReal ((pTwoSourceMarginalCdf beta z) ^ (1 / ((2 : ℝ) - 1))) := by
  rw [pTwoSourceCircleMeasure_second_full_cdf hbeta,
    pTwoSourceCircleFullCoordinateCdf_eq_sourceMarginalCdf hbeta,
    pTwoSourceMarginalCdf_rpow_twoProducerExponent]

/--
Proposition `finiteP`, corrected C1 maximizer step: every point of the
printed support curve maximizes the standard-basis objective at `β = 2`.
Unlike the source proof, this uses the curve's coordinate bounds, not a
unit-radius assertion that fails for general `P`.
-/
theorem propositionFiniteP_standardBasis_c1_maximizer_on_source_curve
    {P : ℕ} (hP : 2 ≤ P) {x w1 w2 : ℝ}
    (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    standardBasisObjective 2 w1 w2 ≤
      standardBasisObjective 2 x
        ((1 - x ^ (2 / ((P : ℝ) - 1))) ^ (((P : ℝ) - 1) / 2)) := by
  have hP_gt_one : 1 < P := lt_of_lt_of_le (by norm_num) hP
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast hP_gt_one
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    exact sub_pos.mpr hP_real_gt_one
  have hleft_exp_nonneg : 0 ≤ 2 / ((P : ℝ) - 1) :=
    (div_pos (by norm_num) hP_sub_pos).le
  have hxpow_nonneg : 0 ≤ x ^ (2 / ((P : ℝ) - 1)) :=
    Real.rpow_nonneg hx.1 _
  have hxpow_le_one : x ^ (2 / ((P : ℝ) - 1)) ≤ 1 :=
    Real.rpow_le_one hx.1 hx.2 hleft_exp_nonneg
  have hbase_nonneg : 0 ≤ 1 - x ^ (2 / ((P : ℝ) - 1)) :=
    sub_nonneg.mpr hxpow_le_one
  have hbase_le_one : 1 - x ^ (2 / ((P : ℝ) - 1)) ≤ 1 :=
    sub_le_self _ hxpow_nonneg
  have hright_exp_nonneg : 0 ≤ ((P : ℝ) - 1) / 2 :=
    div_nonneg hP_sub_pos.le (by norm_num)
  have hy_nonneg :
      0 ≤ (1 - x ^ (2 / ((P : ℝ) - 1))) ^ (((P : ℝ) - 1) / 2) :=
    Real.rpow_nonneg hbase_nonneg _
  have hy_le_one :
      (1 - x ^ (2 / ((P : ℝ) - 1))) ^ (((P : ℝ) - 1) / 2) ≤ 1 :=
    Real.rpow_le_one hbase_nonneg hbase_le_one hright_exp_nonneg
  exact standardBasisObjective_beta_two_le_of_unit_box
    hx.1 hx.2 hy_nonneg hy_le_one

theorem cos_rpow_eq_mul_rpow_sub_one
    {β x : ℝ} (hx : 0 < Real.cos x) :
    (Real.cos x) ^ β = Real.cos x * (Real.cos x) ^ (β - 1) := by
  rw [show β = (β - 1) + 1 by ring]
  rw [Real.rpow_add hx]
  rw [Real.rpow_one]
  ring_nf

/--
The literal `infinitegenreformal` angle hypothesis is impossible: a real
arccosine takes values in the nonnegative interval `[0, pi]`.
-/
theorem infiniteGenre_false_of_arccos_angle_neg
    {x θstar : ℝ} (hangle : θstar = Real.arccos x) (hneg : θstar < 0) :
    False := by
  rw [hangle] at hneg
  exact (not_lt_of_ge (Real.arccos_nonneg x)) hneg

/--
The literal weights in `infinitegenreformal` cannot satisfy the preceding
finite-genre probability normalization: two weights both equal to two cannot
sum to one.
-/
theorem infiniteGenre_false_of_two_weights_eq_two_and_sum_one
    {α1 α2 : ℝ} (hα1 : α1 = 2) (hα2 : α2 = 2) (hsum : α1 + α2 = 1) :
    False := by
  norm_num [hα1, hα2] at hsum

/--
For comparison, normalized equal weights on exactly two genres must each be
one half. This is the normalization compatible with the square roots used in
the source's subsequent displayed CDF formulas.
-/
theorem infiniteGenre_equal_weight_eq_half_of_sum_one
    {α : ℝ} (hsum : α + α = 1) : α = 1 / 2 := by
  linarith

/--
Infinite-producer closed-form algebra: the first-order identity
`sin θ_G cos(θ_G)^(β-1) = sin(θ* - θ_G) cos(θ* - θ_G)^(β-1)`
implies the source equality used to show the candidate support attains zero
profit.
-/
theorem infiniteGenre_cosPower_sum_eq_of_betaPowers
    {β θstar θG : ℝ}
    (hsinG : Real.sin θG ≠ 0)
    (hcosG : 0 < Real.cos θG)
    (hcosO : 0 < Real.cos (θstar - θG))
    (hbetaPowers :
      Real.sin θG * (Real.cos θG) ^ (β - 1) =
        Real.sin (θstar - θG) * (Real.cos (θstar - θG)) ^ (β - 1)) :
    (Real.cos θG) ^ β + (Real.cos (θstar - θG)) ^ β =
      Real.sin θstar * (Real.cos (θstar - θG)) ^ (β - 1) / Real.sin θG := by
  have hcosGpow :
      (Real.cos θG) ^ β =
        Real.cos θG * (Real.cos θG) ^ (β - 1) :=
    cos_rpow_eq_mul_rpow_sub_one hcosG
  have hcosOpow :
      (Real.cos (θstar - θG)) ^ β =
        Real.cos (θstar - θG) *
          (Real.cos (θstar - θG)) ^ (β - 1) :=
    cos_rpow_eq_mul_rpow_sub_one hcosO
  have hcosGsub :
      (Real.cos θG) ^ (β - 1) =
        Real.sin (θstar - θG) *
          (Real.cos (θstar - θG)) ^ (β - 1) / Real.sin θG := by
    field_simp [hsinG]
    simpa [mul_comm, mul_left_comm, mul_assoc] using hbetaPowers
  have hsin :
      Real.sin θstar =
        Real.sin θG * Real.cos (θstar - θG) +
          Real.cos θG * Real.sin (θstar - θG) := by
    rw [show θstar = θG + (θstar - θG) by ring]
    rw [Real.sin_add]
    ring_nf
  rw [hcosGpow, hcosOpow, hcosGsub]
  field_simp [hsinG]
  rw [hsin]
  ring_nf

/--
The printed trigonometric `C₁` in `infinitegenreformal` differs from the
cutoff balance needed by its own support-payoff calculation by a factor of the
selected first score squared.  This exact identity makes the repair
mathematical rather than a merely syntactic parameter renaming.
-/
theorem infiniteGenre_source_C1_eq_scoreSquare_mul_balance
    {β θstar θG : ℝ}
    (hcosG : 0 < Real.cos θG)
    (hcosO : 0 < Real.cos (θstar - θG))
    (hsinO : Real.sin (θstar - θG) ≠ 0)
    (hbetaPowers :
      Real.sin θG * (Real.cos θG) ^ (β - 1) =
        Real.sin (θstar - θG) * (Real.cos (θstar - θG)) ^ (β - 1)) :
    Real.sin θstar * Real.cos θG / Real.sin (θstar - θG) =
      (Real.cos θG) ^ 2 *
        (1 + (Real.cos (θstar - θG) / Real.cos θG) ^ β) := by
  have hGpow_ne : (Real.cos θG) ^ (β - 1) ≠ 0 :=
    (Real.rpow_pos_of_pos hcosG _).ne'
  have hGpow : (Real.cos θG) ^ β =
      (Real.cos θG) ^ (β - 1) * Real.cos θG := by
    rw [show β = (β - 1) + 1 by ring, Real.rpow_add hcosG]
    simp
  have hOpow : (Real.cos (θstar - θG)) ^ β =
      (Real.cos (θstar - θG)) ^ (β - 1) *
        Real.cos (θstar - θG) := by
    rw [show β = (β - 1) + 1 by ring, Real.rpow_add hcosO]
    simp
  have hratio :
      Real.sin θG / Real.sin (θstar - θG) =
        (Real.cos (θstar - θG)) ^ (β - 1) /
          (Real.cos θG) ^ (β - 1) := by
    apply (div_eq_div_iff hsinO hGpow_ne).2
    simpa [mul_comm] using hbetaPowers
  have hsin :
      Real.sin θstar =
        Real.sin θG * Real.cos (θstar - θG) +
          Real.cos θG * Real.sin (θstar - θG) := by
    rw [show θstar = θG + (θstar - θG) by ring, Real.sin_add]
    ring
  calc
    Real.sin θstar * Real.cos θG / Real.sin (θstar - θG) =
        (Real.cos θG) ^ 2 +
          Real.cos θG * Real.cos (θstar - θG) *
            (Real.sin θG / Real.sin (θstar - θG)) := by
      rw [hsin]
      field_simp [hsinO]
      ring
    _ = (Real.cos θG) ^ 2 +
          Real.cos θG * Real.cos (θstar - θG) *
            ((Real.cos (θstar - θG)) ^ (β - 1) /
              (Real.cos θG) ^ (β - 1)) := by rw [hratio]
    _ = (Real.cos θG) ^ 2 *
        (1 + (Real.cos (θstar - θG) / Real.cos θG) ^ β) := by
      rw [Real.div_rpow hcosO.le hcosG.le, hGpow, hOpow]
      field_simp [hGpow_ne, hcosG.ne']

/--
For two unit directions with angle `θstar`, the product of their two scores
along an angular direction is maximized at the bisector.  This is the
elementary, source-independent calculation used in the first paragraph of the
proof of Corollary `2users`; it deliberately asserts maximization rather than
the source's stronger uniqueness claim.
-/
theorem twoUser_cos_product_le_bisector
    (θstar θ : ℝ) :
    Real.cos θ * Real.cos (θstar - θ) ≤ (Real.cos (θstar / 2)) ^ 2 := by
  let a : ℝ := θstar / 2
  let x : ℝ := θ - θstar / 2
  change Real.cos θ * Real.cos (θstar - θ) ≤ (Real.cos a) ^ 2
  have hθ : θ = a + x := by
    dsimp [a, x]
    ring
  have hother : θstar - θ = a - x := by
    dsimp [a, x]
    ring
  rw [hθ]
  have hother' : θstar - (a + x) = a - x := by
    dsimp [a, x]
    ring
  rw [hother', Real.cos_add a x, Real.cos_sub a x]
  have htrig_a : (Real.cos a) ^ 2 + (Real.sin a) ^ 2 = 1 :=
    Real.cos_sq_add_sin_sq a
  have htrig_x : (Real.cos x) ^ 2 + (Real.sin x) ^ 2 = 1 :=
    Real.cos_sq_add_sin_sq x
  have hsin_x_sq : 0 ≤ (Real.sin x) ^ 2 := sq_nonneg (Real.sin x)
  have htrig_a_mul :
      ((Real.cos a) ^ 2 + (Real.sin a) ^ 2) * (Real.sin x) ^ 2 =
        (Real.sin x) ^ 2 := by rw [htrig_a]; ring
  have htrig_x_mul :
      ((Real.cos x) ^ 2 + (Real.sin x) ^ 2) * (Real.cos a) ^ 2 =
        (Real.cos a) ^ 2 := by rw [htrig_x]; ring
  have hidentity :
      (Real.cos a * Real.cos x - Real.sin a * Real.sin x) *
          (Real.cos a * Real.cos x + Real.sin a * Real.sin x) =
        (Real.cos a) ^ 2 - (Real.sin x) ^ 2 := by
    nlinarith [htrig_a_mul, htrig_x_mul]
  nlinarith [hidentity]

theorem twoUser_cos_product_at_bisector
    (θstar : ℝ) :
    Real.cos (θstar / 2) * Real.cos (θstar - θstar / 2) =
      (Real.cos (θstar / 2)) ^ 2 := by
  have hhalf : θstar - θstar / 2 = θstar / 2 := by ring
  rw [hhalf]
  ring

theorem twoUser_cos_product_isMaxOn_bisector
    (θstar : ℝ) :
    IsMaxOn (fun θ : ℝ => Real.cos θ * Real.cos (θstar - θ)) Set.univ
      (θstar / 2) := by
  intro θ _
  change Real.cos θ * Real.cos (θstar - θ) ≤
    Real.cos (θstar / 2) * Real.cos (θstar - θstar / 2)
  calc
    Real.cos θ * Real.cos (θstar - θ) ≤ (Real.cos (θstar / 2)) ^ 2 :=
      twoUser_cos_product_le_bisector θstar θ
    _ = Real.cos (θstar / 2) * Real.cos (θstar - θstar / 2) :=
      (twoUser_cos_product_at_bisector θstar).symm

/-- Cosine-power objective whose first-order condition defines `θ_G`. -/
noncomputable def twoUserCosPowerSum
    (β θstar θ : ℝ) : ℝ :=
  (Real.cos θ) ^ β + (Real.cos (θstar - θ)) ^ β

/--
At exponent two, the corrected two-user angular-power objective is globally
maximized at the bisector whenever the angle between the two directions has
nonnegative cosine.  This is a direct trigonometric fact, independent of the
source's unresolved C1/Nash bridge.
-/
theorem twoUserCosPowerSum_two_le_bisector
    {θstar θ : ℝ}
    (hcosStar : 0 ≤ Real.cos θstar) :
    twoUserCosPowerSum 2 θstar θ ≤
      twoUserCosPowerSum 2 θstar (θstar / 2) := by
  unfold twoUserCosPowerSum
  have hhalf : θstar - θstar / 2 = θstar / 2 := by ring
  rw [hhalf]
  simp only [Real.rpow_two]
  let a : ℝ := θstar / 2
  let x : ℝ := θ - θstar / 2
  change (Real.cos θ) ^ 2 + (Real.cos (θstar - θ)) ^ 2 ≤
    (Real.cos a) ^ 2 + (Real.cos a) ^ 2
  have hθ : θ = a + x := by
    dsimp [a, x]
    ring
  have hother : θstar - θ = a - x := by
    dsimp [a, x]
    ring
  rw [hθ]
  have hother' : θstar - (a + x) = a - x := by
    dsimp [a, x]
    ring
  rw [hother', Real.cos_add a x, Real.cos_sub a x]
  have htrigA : (Real.cos a) ^ 2 + (Real.sin a) ^ 2 = 1 :=
    Real.cos_sq_add_sin_sq a
  have htrigX : (Real.cos x) ^ 2 + (Real.sin x) ^ 2 = 1 :=
    Real.cos_sq_add_sin_sq x
  have hcosDiff : 0 ≤ (Real.cos a) ^ 2 - (Real.sin a) ^ 2 := by
    have hangle : θstar = 2 * a := by
      dsimp [a]
      ring
    rw [hangle, Real.cos_two_mul] at hcosStar
    nlinarith
  have hsinXsq : 0 ≤ (Real.sin x) ^ 2 := sq_nonneg (Real.sin x)
  have htrigA_mul :
      ((Real.cos a) ^ 2 + (Real.sin a) ^ 2) * (Real.sin x) ^ 2 =
        (Real.sin x) ^ 2 := by rw [htrigA]; ring
  have htrigX_mul :
      ((Real.cos x) ^ 2 + (Real.sin x) ^ 2) * (Real.cos a) ^ 2 =
        (Real.cos a) ^ 2 := by rw [htrigX]; ring
  have hnonneg_product :
      0 ≤ ((Real.cos a) ^ 2 - (Real.sin a) ^ 2) * (Real.sin x) ^ 2 :=
    mul_nonneg hcosDiff hsinXsq
  have hsum_identity :
      (Real.cos a * Real.cos x - Real.sin a * Real.sin x) ^ 2 +
          (Real.cos a * Real.cos x + Real.sin a * Real.sin x) ^ 2 =
        2 * (Real.cos a) ^ 2 -
          2 * ((Real.cos a) ^ 2 - (Real.sin a) ^ 2) * (Real.sin x) ^ 2 := by
    nlinarith [htrigX_mul]
  nlinarith [hsum_identity, hnonneg_product]

/--
The corrected two-user angular-power comparison holds globally in the
low-exponent range `0 ≤ beta ≤ 2`, provided all three cosine scores are
nonnegative.  It lifts the beta-two square identity through the reusable
concavity-based power/square-sum comparison; it does not claim the paper's
larger, unresolved phase-threshold range.
-/
theorem twoUserCosPowerSum_le_bisector_of_nonnegative_cosines_of_le_two
    {β θstar θ : ℝ}
    (hβ_nonnegative : 0 ≤ β) (hβ_le_two : β ≤ 2)
    (hcosStar : 0 ≤ Real.cos θstar)
    (hcos : 0 ≤ Real.cos θ)
    (hcosOther : 0 ≤ Real.cos (θstar - θ))
    (hcosBisector : 0 ≤ Real.cos (θstar / 2)) :
    twoUserCosPowerSum β θstar θ ≤
      twoUserCosPowerSum β θstar (θstar / 2) := by
  have htwo := twoUserCosPowerSum_two_le_bisector (θ := θ) hcosStar
  have hhalf : θstar - θstar / 2 = θstar / 2 := by ring
  unfold twoUserCosPowerSum at htwo ⊢
  rw [hhalf]
  have hsquares : (Real.cos θ) ^ 2 +
      (Real.cos (θstar - θ)) ^ 2 ≤
      2 * (Real.cos (θstar / 2)) ^ 2 := by
    rw [hhalf] at htwo
    simpa only [Real.rpow_two, two_mul] using htwo
  simpa [two_mul] using
    AppliedModelingLib.Optimization.two_rpow_sum_le_two_rpow_of_square_sum_le
      hcos hcosOther hcosBisector hβ_nonnegative hβ_le_two hsquares

/--
On the source's nonnegative two-user angular domain, the cosine hypotheses of
`twoUserCosPowerSum_le_bisector_of_nonnegative_cosines_of_le_two` follow from
the visible interval bounds.  Thus the corrected C1 angular comparison is
fully global for `0 ≤ beta ≤ 2` on that domain.
-/
theorem twoUserCosPowerSum_le_bisector_of_angle_mem_Icc_of_le_two
    {β θstar θ : ℝ}
    (hβ_nonnegative : 0 ≤ β) (hβ_le_two : β ≤ 2)
    (hθstar_nonnegative : 0 ≤ θstar)
    (hθstar_le_half_pi : θstar ≤ Real.pi / 2)
    (hθ_nonnegative : 0 ≤ θ) (hθ_le : θ ≤ θstar) :
    twoUserCosPowerSum β θstar θ ≤
      twoUserCosPowerSum β θstar (θstar / 2) := by
  apply twoUserCosPowerSum_le_bisector_of_nonnegative_cosines_of_le_two
    hβ_nonnegative hβ_le_two
  · exact Real.cos_nonneg_of_mem_Icc ⟨by nlinarith [Real.pi_pos.le], hθstar_le_half_pi⟩
  · exact Real.cos_nonneg_of_mem_Icc
      ⟨by nlinarith [Real.pi_pos.le], hθ_le.trans hθstar_le_half_pi⟩
  · exact Real.cos_nonneg_of_mem_Icc
      ⟨by nlinarith [Real.pi_pos.le], by linarith⟩
  · exact Real.cos_nonneg_of_mem_Icc
      ⟨by nlinarith [Real.pi_pos.le], by linarith⟩

theorem hasDerivAt_twoUserCosPowerSum
    {β θstar θ : ℝ}
    (hcosG : Real.cos θ ≠ 0 ∨ 1 ≤ β)
    (hcosO : Real.cos (θstar - θ) ≠ 0 ∨ 1 ≤ β) :
    HasDerivAt
      (fun t : ℝ => twoUserCosPowerSum β θstar t)
      (β *
        (Real.sin (θstar - θ) * (Real.cos (θstar - θ)) ^ (β - 1) -
          Real.sin θ * (Real.cos θ) ^ (β - 1))) θ := by
  have hcos1 : HasDerivAt (fun t : ℝ => Real.cos t) (-Real.sin θ) θ :=
    Real.hasDerivAt_cos θ
  have hpow1 :=
    hcos1.rpow_const (p := β) hcosG
  have hinner : HasDerivAt (fun t : ℝ => θstar - t) (-1) θ := by
    simpa using (hasDerivAt_const θ θstar).sub (hasDerivAt_id θ)
  have hcos2 : HasDerivAt (fun t : ℝ => Real.cos (θstar - t))
      (Real.sin (θstar - θ)) θ := by
    have h := hinner.cos
    convert h using 1
    ring
  have hpow2 :=
    hcos2.rpow_const (p := β) hcosO
  have hsum := hpow1.add hpow2
  convert hsum using 1
  ring

/--
Derivative of the angular-power first derivative on the positive-cosine
domain.  This is the local curvature calculation needed for the corrected
two-user threshold proof; endpoint extensions require separate treatment when
the real-power derivative is singular.
-/
theorem hasDerivAt_twoUserCosPowerSum_derivative
    {β θstar θ : ℝ}
    (hcosG : 0 < Real.cos θ)
    (hcosO : 0 < Real.cos (θstar - θ)) :
    HasDerivAt
      (fun t : ℝ => β *
        (Real.sin (θstar - t) * (Real.cos (θstar - t)) ^ (β - 1) -
          Real.sin t * (Real.cos t) ^ (β - 1)))
      (β *
        (((-Real.cos (θstar - θ)) * (Real.cos (θstar - θ)) ^ (β - 1) +
            Real.sin (θstar - θ) *
              ((β - 1) * (Real.cos (θstar - θ)) ^ (β - 2) *
                Real.sin (θstar - θ))) -
          (Real.cos θ * (Real.cos θ) ^ (β - 1) +
            Real.sin θ *
              ((β - 1) * (Real.cos θ) ^ (β - 2) * (-Real.sin θ))))) θ := by
  have hsinG : HasDerivAt (fun t : ℝ => Real.sin t) (Real.cos θ) θ :=
    Real.hasDerivAt_sin θ
  have hcosG' : HasDerivAt (fun t : ℝ => Real.cos t) (-Real.sin θ) θ :=
    Real.hasDerivAt_cos θ
  have hpowG := hcosG'.rpow_const (p := β - 1) (Or.inl (ne_of_gt hcosG))
  have hprodG := hsinG.mul hpowG
  have hinner : HasDerivAt (fun t : ℝ => θstar - t) (-1) θ := by
    simpa using (hasDerivAt_const θ θstar).sub (hasDerivAt_id θ)
  have hsinO : HasDerivAt (fun t : ℝ => Real.sin (θstar - t))
      (-Real.cos (θstar - θ)) θ := by
    have h := (Real.hasDerivAt_sin (θstar - θ)).comp θ hinner
    convert h using 1
    ring
  have hcosO' : HasDerivAt (fun t : ℝ => Real.cos (θstar - t))
      (Real.sin (θstar - θ)) θ := by
    have h := (Real.hasDerivAt_cos (θstar - θ)).comp θ hinner
    convert h using 1
    ring
  have hpowO := hcosO'.rpow_const (p := β - 1) (Or.inl (ne_of_gt hcosO))
  have hprodO := hsinO.mul hpowO
  have hdiff := hprodO.sub hprodG
  have hmul := hdiff.const_mul β
  convert hmul using 1 <;> ring

/--
At the angular bisector, the derivative of the two-user angular-power first
derivative has the explicit curvature factor used by the corrected threshold
calculation.
-/
theorem hasDerivAt_twoUserCosPowerSum_derivative_at_bisector
    {β θstar : ℝ}
    (hcos : 0 < Real.cos (θstar / 2)) :
    HasDerivAt
      (fun t : ℝ => β *
        (Real.sin (θstar - t) * (Real.cos (θstar - t)) ^ (β - 1) -
          Real.sin t * (Real.cos t) ^ (β - 1)))
      (2 * β *
        ((β - 1) * (Real.sin (θstar / 2)) ^ 2 *
            (Real.cos (θstar / 2)) ^ (β - 2) -
          (Real.cos (θstar / 2)) ^ β)) (θstar / 2) := by
  have hhalf : θstar - θstar / 2 = θstar / 2 := by ring
  have h := hasDerivAt_twoUserCosPowerSum_derivative
    (β := β) (θstar := θstar) (θ := θstar / 2) hcos (by simpa [hhalf] using hcos)
  rw [hhalf] at h
  have hpow :
      Real.cos (θstar / 2) * (Real.cos (θstar / 2)) ^ (β - 1) =
        (Real.cos (θstar / 2)) ^ β := by
    calc
      Real.cos (θstar / 2) * (Real.cos (θstar / 2)) ^ (β - 1) =
          (Real.cos (θstar / 2)) ^ (1 : ℝ) *
            (Real.cos (θstar / 2)) ^ (β - 1) := by rw [Real.rpow_one]
      _ = (Real.cos (θstar / 2)) ^ ((1 : ℝ) + (β - 1)) := by
        rw [Real.rpow_add hcos]
      _ = (Real.cos (θstar / 2)) ^ β := by congr 1 <;> ring
  have hnegpow :
      (-Real.cos (θstar / 2)) * (Real.cos (θstar / 2)) ^ (β - 1) =
        -(Real.cos (θstar / 2)) ^ β := by
    rw [show (-Real.cos (θstar / 2)) * (Real.cos (θstar / 2)) ^ (β - 1) =
      -(Real.cos (θstar / 2) * (Real.cos (θstar / 2)) ^ (β - 1)) by ring,
      hpow]
  rw [hnegpow, hpow] at h
  convert h using 1 <;> ring

/--
The phase-threshold inequality is exactly the nonpositive-curvature condition
`beta * sin(theta / 2)^2 <= 1` at the two-user angular bisector.
-/
theorem twoUser_beta_mul_sin_sq_half_le_one_of_le_phaseThreshold
    {β θ : ℝ}
    (hden : 0 < 1 - Real.cos θ)
    (hβle : β ≤ twoUserPhaseThreshold θ) :
    β * (Real.sin (θ / 2)) ^ 2 ≤ 1 := by
  unfold twoUserPhaseThreshold at hβle
  have hmul := mul_le_mul_of_nonneg_right hβle hden.le
  have hbound : β * (1 - Real.cos θ) ≤ 2 := by
    calc
      β * (1 - Real.cos θ) ≤ (2 / (1 - Real.cos θ)) *
          (1 - Real.cos θ) := hmul
      _ = 2 := by field_simp [ne_of_gt hden]
  have htrig : 1 - Real.cos θ = 2 * (Real.sin (θ / 2)) ^ 2 := by
    rw [Real.sin_sq_eq_half_sub]
    have hdouble : 2 * (θ / 2) = θ := by ring
    rw [hdouble]
    ring
  rw [htrig] at hbound
  nlinarith

/--
Below (or at) the source phase threshold, the corrected angular-power
objective has nonpositive second derivative at its bisector.  This is the
local curvature consequence only; global maximality still requires the
separate interval argument absent from the source proof.
-/
theorem twoUserCosPowerSum_bisector_curvature_nonpos_of_le_phaseThreshold
    {β θ : ℝ}
    (hβ : 0 ≤ β) (hden : 0 < 1 - Real.cos θ)
    (hβle : β ≤ twoUserPhaseThreshold θ)
    (hcos : 0 < Real.cos (θ / 2)) :
    2 * β *
      ((β - 1) * (Real.sin (θ / 2)) ^ 2 *
          (Real.cos (θ / 2)) ^ (β - 2) -
        (Real.cos (θ / 2)) ^ β) ≤ 0 := by
  have hphase : β * (Real.sin (θ / 2)) ^ 2 ≤ 1 :=
    twoUser_beta_mul_sin_sq_half_le_one_of_le_phaseThreshold hden hβle
  have htrig : (Real.sin (θ / 2)) ^ 2 +
      (Real.cos (θ / 2)) ^ 2 = 1 :=
    Real.sin_sq_add_cos_sq (θ / 2)
  have hbracket :
      (β - 1) * (Real.sin (θ / 2)) ^ 2 -
        (Real.cos (θ / 2)) ^ 2 ≤ 0 := by
    nlinarith
  have hpow :
      (Real.cos (θ / 2)) ^ β =
        (Real.cos (θ / 2)) ^ (β - 2) *
          (Real.cos (θ / 2)) ^ 2 := by
    calc
      (Real.cos (θ / 2)) ^ β =
          (Real.cos (θ / 2)) ^ ((β - 2) + 2) := by congr 1 <;> ring
      _ = (Real.cos (θ / 2)) ^ (β - 2) *
          (Real.cos (θ / 2)) ^ (2 : ℝ) := by
        rw [Real.rpow_add hcos]
      _ = (Real.cos (θ / 2)) ^ (β - 2) *
          (Real.cos (θ / 2)) ^ 2 := by simp only [Real.rpow_two]
  rw [hpow]
  have hpower_nonneg : 0 ≤ (Real.cos (θ / 2)) ^ (β - 2) :=
    Real.rpow_nonneg hcos.le _
  have hinner :
      (β - 1) * (Real.sin (θ / 2)) ^ 2 *
          (Real.cos (θ / 2)) ^ (β - 2) -
        (Real.cos (θ / 2)) ^ (β - 2) *
          (Real.cos (θ / 2)) ^ 2 ≤ 0 := by
    rw [show
      (β - 1) * (Real.sin (θ / 2)) ^ 2 *
          (Real.cos (θ / 2)) ^ (β - 2) -
        (Real.cos (θ / 2)) ^ (β - 2) *
          (Real.cos (θ / 2)) ^ 2 =
      (Real.cos (θ / 2)) ^ (β - 2) *
        ((β - 1) * (Real.sin (θ / 2)) ^ 2 -
          (Real.cos (θ / 2)) ^ 2) by ring]
    exact mul_nonpos_of_nonneg_of_nonpos hpower_nonneg hbracket
  exact mul_nonpos_of_nonneg_of_nonpos (mul_nonneg (by norm_num) hβ) hinner

theorem betaPowers_of_cosPowerSum_derivative_zero
    {β θstar θ : ℝ}
    (hβ : β ≠ 0)
    (hzero :
      β *
        (Real.sin (θstar - θ) * (Real.cos (θstar - θ)) ^ (β - 1) -
          Real.sin θ * (Real.cos θ) ^ (β - 1)) = 0) :
    Real.sin θ * (Real.cos θ) ^ (β - 1) =
      Real.sin (θstar - θ) * (Real.cos (θstar - θ)) ^ (β - 1) := by
  have hdiff :
      Real.sin (θstar - θ) * (Real.cos (θstar - θ)) ^ (β - 1) -
          Real.sin θ * (Real.cos θ) ^ (β - 1) = 0 := by
    exact (mul_eq_zero.mp hzero).resolve_left hβ
  linarith

/--
The logarithm of the positive derivative factor `sin(t) cos(t)^(beta - 1)`.
It is used for the high-exponent part of the two-user angular comparison.
-/
noncomputable def twoUserLogSinCosPower (β t : ℝ) : ℝ :=
  Real.log (Real.sin t) + (β - 1) * Real.log (Real.cos t)

theorem hasDerivAt_twoUserLogSinCosPower
    {β t : ℝ} (hsin : 0 < Real.sin t) (hcos : 0 < Real.cos t) :
    HasDerivAt (fun x => twoUserLogSinCosPower β x)
      (Real.cos t / Real.sin t -
        (β - 1) * (Real.sin t / Real.cos t)) t := by
  unfold twoUserLogSinCosPower
  have hlogsin := (Real.hasDerivAt_log (ne_of_gt hsin)).comp t
    (Real.hasDerivAt_sin t)
  have hlogcos := (Real.hasDerivAt_log (ne_of_gt hcos)).comp t
    (Real.hasDerivAt_cos t)
  have hmul := hlogcos.const_mul (β - 1)
  have hsum := hlogsin.add hmul
  convert hsum using 1 <;> field_simp [hsin.ne', hcos.ne'] <;> ring

/-- The antisymmetric logarithmic derivative comparison around the bisector. -/
noncomputable def twoUserLogSinCosPowerSkew (β a t : ℝ) : ℝ :=
  twoUserLogSinCosPower β t - twoUserLogSinCosPower β (a - t)

theorem hasDerivAt_twoUserLogSinCosPowerSkew
    {β a t : ℝ} (hsin : 0 < Real.sin t) (hcos : 0 < Real.cos t)
    (hsinOther : 0 < Real.sin (a - t)) (hcosOther : 0 < Real.cos (a - t)) :
    HasDerivAt (fun x => twoUserLogSinCosPowerSkew β a x)
      ((Real.cos t / Real.sin t - (β - 1) * (Real.sin t / Real.cos t)) +
        (Real.cos (a - t) / Real.sin (a - t) -
          (β - 1) * (Real.sin (a - t) / Real.cos (a - t)))) t := by
  unfold twoUserLogSinCosPowerSkew
  have hthis := hasDerivAt_twoUserLogSinCosPower (β := β) hsin hcos
  have hinner : HasDerivAt (fun x : ℝ => a - x) (-1) t := by
    simpa using (hasDerivAt_const t a).sub (hasDerivAt_id t)
  have hother :=
    (hasDerivAt_twoUserLogSinCosPower (β := β) hsinOther hcosOther).comp t hinner
  convert hthis.sub hother using 1 <;> ring

/--
For exponents at least two, the source phase condition makes the derivative
of the skew logarithmic derivative factor nonnegative.
-/
theorem twoUserLogSinCosPowerSkew_derivative_nonnegative_of_phase
    {β a t : ℝ} (hβ_two : 2 ≤ β)
    (hphase : β * (1 - Real.cos a) ≤ 2)
    (hsinA : 0 < Real.sin a)
    (hsin : 0 < Real.sin t) (hcos : 0 < Real.cos t)
    (hsinOther : 0 < Real.sin (a - t))
    (hcosOther : 0 < Real.cos (a - t)) :
    0 ≤
      (Real.cos t / Real.sin t - (β - 1) * (Real.sin t / Real.cos t)) +
        (Real.cos (a - t) / Real.sin (a - t) -
          (β - 1) * (Real.sin (a - t) / Real.cos (a - t))) := by
  let x := Real.cos t
  let y := Real.sin t
  let u := Real.cos (a - t)
  let v := Real.sin (a - t)
  have hcoeff : 2 - β ≤ 0 := by linarith
  have hcosdiff : Real.cos (t - (a - t)) ≤ 1 := Real.cos_le_one _
  have hright : 0 ≤ β * Real.cos a + (2 - β) * Real.cos (t - (a - t)) := by
    have hbase : 0 ≤ β * Real.cos a + (2 - β) * 1 := by
      nlinarith
    have hmul : (2 - β) * 1 ≤
        (2 - β) * Real.cos (t - (a - t)) := by
      simpa using (mul_le_mul_of_nonpos_left hcosdiff hcoeff)
    apply hbase.trans
    calc
      β * Real.cos a + (2 - β) * 1 = (2 - β) * 1 + β * Real.cos a := by ring
      _ ≤ (2 - β) * Real.cos (t - (a - t)) + β * Real.cos a :=
        by simpa [add_comm] using add_le_add_left hmul (β * Real.cos a)
      _ = β * Real.cos a + (2 - β) * Real.cos (t - (a - t)) := by ring
  have hcosSum : Real.cos a = x * u - y * v := by
    have ha : a = t + (a - t) := by ring
    rw [ha, Real.cos_add]
  have hcosDiff : Real.cos (t - (a - t)) = x * u + y * v := by
    rw [Real.cos_sub]
  have hbracket : 0 ≤ x * u - (β - 1) * y * v := by
    have hidentity :
        2 * (x * u - (β - 1) * y * v) =
          β * Real.cos a + (2 - β) * Real.cos (t - (a - t)) := by
      rw [hcosSum, hcosDiff]
      ring
    nlinarith
  have hden : 0 < Real.sin t * Real.cos t * Real.sin (a - t) * Real.cos (a - t) :=
    mul_pos (mul_pos (mul_pos hsin hcos) hsinOther) hcosOther
  let d : ℝ :=
    (Real.cos t / Real.sin t - (β - 1) * (Real.sin t / Real.cos t)) +
      (Real.cos (a - t) / Real.sin (a - t) -
        (β - 1) * (Real.sin (a - t) / Real.cos (a - t)))
  change 0 ≤ d
  apply nonneg_of_mul_nonneg_right _ hden
  change 0 ≤
    (Real.sin t * Real.cos t * Real.sin (a - t) * Real.cos (a - t)) * d
  have hfactor :
      (Real.sin t * Real.cos t * Real.sin (a - t) * Real.cos (a - t)) * d =
      Real.sin a * (x * u - (β - 1) * y * v) := by
    dsimp [d]
    rw [show a = t + (a - t) by ring, Real.sin_add]
    dsimp [x, y, u, v]
    field_simp [hsin.ne', hcos.ne', hsinOther.ne', hcosOther.ne']
    ring
  rw [hfactor]
  exact mul_nonneg hsinA.le hbracket

theorem twoUserLogSinCosPowerSkew_nonnegative_of_midpoint_le_of_lt
    {β a x : ℝ} (hβ_two : 2 ≤ β)
    (hphase : β * (1 - Real.cos a) ≤ 2)
    (ha_pos : 0 < a) (ha_lt_half_pi : a < Real.pi / 2)
    (hmid_le : a / 2 ≤ x) (hx_lt : x < a) :
    0 ≤ twoUserLogSinCosPowerSkew β a x := by
  have ha_lt_pi : a < Real.pi := by linarith [Real.pi_pos]
  have hhalf_pos : 0 < a / 2 := by positivity
  have hx_pos : 0 < x := lt_of_lt_of_le hhalf_pos hmid_le
  have hsinA : 0 < Real.sin a :=
    Real.sin_pos_of_pos_of_lt_pi ha_pos ha_lt_pi
  let interval : Set ℝ := Set.Icc (a / 2) x
  have hmono : MonotoneOn (twoUserLogSinCosPowerSkew β a) interval := by
    apply monotoneOn_of_deriv_nonneg (convex_Icc (a / 2) x)
    · intro t ht
      have ht_lower : a / 2 ≤ t := ht.1
      have ht_upper : t ≤ x := ht.2
      have ht_pos : 0 < t := lt_of_lt_of_le hhalf_pos ht_lower
      have ht_lt_a : t < a := lt_of_le_of_lt ht_upper hx_lt
      have ht_lt_half_pi : t < Real.pi / 2 := ht_lt_a.trans ha_lt_half_pi
      have ht_sin : 0 < Real.sin t :=
        Real.sin_pos_of_pos_of_lt_pi ht_pos (ht_lt_a.trans ha_lt_pi)
      have ht_cos : 0 < Real.cos t :=
        Real.cos_pos_of_mem_Ioo ⟨by linarith, ht_lt_half_pi⟩
      have hother_pos : 0 < a - t := sub_pos.mpr ht_lt_a
      have hother_le_half : a - t ≤ a / 2 := by linarith
      have hother_lt_half_pi : a - t < Real.pi / 2 :=
        lt_of_le_of_lt hother_le_half (by linarith)
      have hother_sin : 0 < Real.sin (a - t) :=
        Real.sin_pos_of_pos_of_lt_pi hother_pos (by linarith [ha_lt_pi])
      have hother_cos : 0 < Real.cos (a - t) :=
        Real.cos_pos_of_mem_Ioo ⟨by linarith, hother_lt_half_pi⟩
      exact (hasDerivAt_twoUserLogSinCosPowerSkew (β := β)
        ht_sin ht_cos hother_sin hother_cos).continuousAt.continuousWithinAt
    · intro t ht
      rw [interior_Icc] at ht
      have ht_lower : a / 2 < t := ht.1
      have ht_upper : t < x := ht.2
      have ht_pos : 0 < t := lt_trans hhalf_pos ht_lower
      have ht_lt_a : t < a := ht_upper.trans hx_lt
      have ht_lt_half_pi : t < Real.pi / 2 := ht_lt_a.trans ha_lt_half_pi
      have ht_sin : 0 < Real.sin t :=
        Real.sin_pos_of_pos_of_lt_pi ht_pos (ht_lt_a.trans ha_lt_pi)
      have ht_cos : 0 < Real.cos t :=
        Real.cos_pos_of_mem_Ioo ⟨by linarith, ht_lt_half_pi⟩
      have hother_pos : 0 < a - t := sub_pos.mpr ht_lt_a
      have hother_le_half : a - t < a / 2 := by linarith
      have hother_lt_half_pi : a - t < Real.pi / 2 :=
        lt_trans hother_le_half (by linarith)
      have hother_sin : 0 < Real.sin (a - t) :=
        Real.sin_pos_of_pos_of_lt_pi hother_pos (by linarith [ha_lt_pi])
      have hother_cos : 0 < Real.cos (a - t) :=
        Real.cos_pos_of_mem_Ioo ⟨by linarith, hother_lt_half_pi⟩
      exact (hasDerivAt_twoUserLogSinCosPowerSkew (β := β)
        ht_sin ht_cos hother_sin hother_cos).differentiableAt.differentiableWithinAt
    · intro t ht
      rw [interior_Icc] at ht
      have ht_lower : a / 2 < t := ht.1
      have ht_upper : t < x := ht.2
      have ht_pos : 0 < t := lt_trans hhalf_pos ht_lower
      have ht_lt_a : t < a := ht_upper.trans hx_lt
      have ht_lt_half_pi : t < Real.pi / 2 := ht_lt_a.trans ha_lt_half_pi
      have ht_sin : 0 < Real.sin t :=
        Real.sin_pos_of_pos_of_lt_pi ht_pos (ht_lt_a.trans ha_lt_pi)
      have ht_cos : 0 < Real.cos t :=
        Real.cos_pos_of_mem_Ioo ⟨by linarith, ht_lt_half_pi⟩
      have hother_pos : 0 < a - t := sub_pos.mpr ht_lt_a
      have hother_le_half : a - t < a / 2 := by linarith
      have hother_lt_half_pi : a - t < Real.pi / 2 :=
        lt_trans hother_le_half (by linarith)
      have hother_sin : 0 < Real.sin (a - t) :=
        Real.sin_pos_of_pos_of_lt_pi hother_pos (by linarith [ha_lt_pi])
      have hother_cos : 0 < Real.cos (a - t) :=
        Real.cos_pos_of_mem_Ioo ⟨by linarith, hother_lt_half_pi⟩
      rw [(hasDerivAt_twoUserLogSinCosPowerSkew (β := β)
        ht_sin ht_cos hother_sin hother_cos).deriv]
      exact twoUserLogSinCosPowerSkew_derivative_nonnegative_of_phase
        hβ_two hphase hsinA ht_sin ht_cos hother_sin hother_cos
  have hmid_mem : a / 2 ∈ interval := ⟨le_rfl, hmid_le⟩
  have hx_mem : x ∈ interval := ⟨hmid_le, le_rfl⟩
  have hle := hmono hmid_mem hx_mem hmid_le
  have hzero : twoUserLogSinCosPowerSkew β a (a / 2) = 0 := by
    unfold twoUserLogSinCosPowerSkew
    have hhalf : a - a / 2 = a / 2 := by ring
    rw [hhalf, sub_self]
  rw [hzero] at hle
  exact hle

theorem twoUser_sin_mul_cos_rpow_le_reverse_of_le_half_of_phase
    {β a t : ℝ} (hβ_two : 2 ≤ β)
    (hphase : β * (1 - Real.cos a) ≤ 2)
    (ha_pos : 0 < a) (ha_lt_half_pi : a < Real.pi / 2)
    (ht_nonnegative : 0 ≤ t) (ht_le_half : t ≤ a / 2) :
    Real.sin t * (Real.cos t) ^ (β - 1) ≤
      Real.sin (a - t) * (Real.cos (a - t)) ^ (β - 1) := by
  have ha_lt_pi : a < Real.pi := by linarith [Real.pi_pos]
  have ht_lt_a : t < a := by linarith
  have hother_pos : 0 < a - t := sub_pos.mpr ht_lt_a
  have hother_le_a : a - t ≤ a := by linarith
  have hother_lt_half_pi : a - t < Real.pi / 2 :=
    lt_of_le_of_lt hother_le_a ha_lt_half_pi
  have hother_sin : 0 < Real.sin (a - t) :=
    Real.sin_pos_of_pos_of_lt_pi hother_pos (by linarith [ha_lt_pi])
  have hother_cos : 0 < Real.cos (a - t) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith, hother_lt_half_pi⟩
  rcases ht_nonnegative.eq_or_lt with rfl | ht_pos
  · simp only [Real.sin_zero, zero_mul]
    exact mul_nonneg hother_sin.le (Real.rpow_nonneg hother_cos.le _)
  · have ht_lt_half_pi : t < Real.pi / 2 := by
      calc
        t ≤ a / 2 := ht_le_half
        _ < Real.pi / 2 := by linarith
    have ht_sin : 0 < Real.sin t :=
      Real.sin_pos_of_pos_of_lt_pi ht_pos (by linarith [ha_lt_pi])
    have ht_cos : 0 < Real.cos t :=
      Real.cos_pos_of_mem_Ioo ⟨by linarith, ht_lt_half_pi⟩
    let x : ℝ := a - t
    have hx_mid : a / 2 ≤ x := by dsimp [x]; linarith
    have hx_lt : x < a := by dsimp [x]; linarith
    have hskew := twoUserLogSinCosPowerSkew_nonnegative_of_midpoint_le_of_lt
      hβ_two hphase ha_pos ha_lt_half_pi hx_mid hx_lt
    have hxt : a - x = t := by dsimp [x]; ring
    unfold twoUserLogSinCosPowerSkew at hskew
    rw [hxt] at hskew
    have hlog : twoUserLogSinCosPower β t ≤ twoUserLogSinCosPower β x := by
      linarith
    have hx_pos : 0 < x := by dsimp [x]; linarith
    have hx_le_a : x ≤ a := by dsimp [x]; linarith
    have hx_lt_half_pi : x < Real.pi / 2 :=
      lt_of_le_of_lt hx_le_a ha_lt_half_pi
    have hx_sin : 0 < Real.sin x :=
      Real.sin_pos_of_pos_of_lt_pi hx_pos (by linarith [ha_lt_pi])
    have hx_cos : 0 < Real.cos x :=
      Real.cos_pos_of_mem_Ioo ⟨by linarith, hx_lt_half_pi⟩
    have ht_term_pos : 0 < Real.sin t * (Real.cos t) ^ (β - 1) :=
      mul_pos ht_sin (Real.rpow_pos_of_pos ht_cos _)
    have hx_term_pos : 0 < Real.sin x * (Real.cos x) ^ (β - 1) :=
      mul_pos hx_sin (Real.rpow_pos_of_pos hx_cos _)
    apply (Real.log_le_log_iff ht_term_pos hx_term_pos).mp
    rw [Real.log_mul ht_sin.ne' (Real.rpow_pos_of_pos ht_cos _).ne',
      Real.log_rpow ht_cos (β - 1),
      Real.log_mul hx_sin.ne' (Real.rpow_pos_of_pos hx_cos _).ne',
      Real.log_rpow hx_cos (β - 1)]
    simpa [twoUserLogSinCosPower, x] using hlog

/--
Corrected full two-user C1 angular component.  On the intended source domain,
the source phase condition makes the bisector maximize the angular-power sum.
This is only the analytic angular comparison; it does not identify the paper's
full equilibrium threshold.
-/
theorem twoUserCosPowerSum_le_bisector_of_phase
    {β a θ : ℝ} (hβ_two : 2 ≤ β)
    (hphase : β * (1 - Real.cos a) ≤ 2)
    (ha_pos : 0 < a) (ha_lt_half_pi : a < Real.pi / 2)
    (hθ_nonnegative : 0 ≤ θ) (hθ_le_a : θ ≤ a) :
    twoUserCosPowerSum β a θ ≤ twoUserCosPowerSum β a (a / 2) := by
  have hβ_one : 1 ≤ β := by linarith
  have hhalf_nonnegative : 0 ≤ a / 2 := by positivity
  have hmono : MonotoneOn (twoUserCosPowerSum β a) (Set.Icc 0 (a / 2)) := by
    apply monotoneOn_of_deriv_nonneg (convex_Icc _ _)
    · intro t _ht
      exact (hasDerivAt_twoUserCosPowerSum (β := β) (θstar := a) (θ := t)
        (Or.inr hβ_one) (Or.inr hβ_one)).continuousAt.continuousWithinAt
    · intro t _ht
      rw [interior_Icc] at _ht
      exact (hasDerivAt_twoUserCosPowerSum (β := β) (θstar := a) (θ := t)
        (Or.inr hβ_one) (Or.inr hβ_one)).differentiableAt.differentiableWithinAt
    · intro t ht
      rw [interior_Icc] at ht
      rw [(hasDerivAt_twoUserCosPowerSum (β := β) (θstar := a) (θ := t)
        (Or.inr hβ_one) (Or.inr hβ_one)).deriv]
      have hterm := twoUser_sin_mul_cos_rpow_le_reverse_of_le_half_of_phase
        hβ_two hphase ha_pos ha_lt_half_pi ht.1.le ht.2.le
      exact mul_nonneg (by linarith) (sub_nonneg.mpr hterm)
  rcases le_total θ (a / 2) with hθ_le_half | hhalf_le_θ
  · exact hmono ⟨hθ_nonnegative, hθ_le_half⟩ ⟨hhalf_nonnegative, le_rfl⟩ hθ_le_half
  · let θ' : ℝ := a - θ
    have hθ'_nonnegative : 0 ≤ θ' := by dsimp [θ']; linarith
    have hθ'_le_half : θ' ≤ a / 2 := by dsimp [θ']; linarith
    have hbound := hmono ⟨hθ'_nonnegative, hθ'_le_half⟩
      ⟨hhalf_nonnegative, le_rfl⟩ hθ'_le_half
    have hsymm : twoUserCosPowerSum β a θ = twoUserCosPowerSum β a θ' := by
      unfold twoUserCosPowerSum
      have hback : a - θ' = θ := by dsimp [θ']; ring
      rw [hback]
      exact add_comm _ _
    rw [hsymm]
    exact hbound

theorem twoUserCosPowerSum_le_bisector_of_source_phase
    {β a θ : ℝ} (hβ_one : 1 ≤ β)
    (hphase : β * (1 - Real.cos a) ≤ 2)
    (ha_pos : 0 < a) (ha_le_half_pi : a ≤ Real.pi / 2)
    (hθ_nonnegative : 0 ≤ θ) (hθ_le_a : θ ≤ a) :
    twoUserCosPowerSum β a θ ≤ twoUserCosPowerSum β a (a / 2) := by
  rcases le_total β 2 with hβ_le_two | htwo_le_β
  · exact twoUserCosPowerSum_le_bisector_of_angle_mem_Icc_of_le_two
      (by linarith) hβ_le_two ha_pos.le ha_le_half_pi hθ_nonnegative hθ_le_a
  · rcases eq_or_lt_of_le htwo_le_β with rfl | hβ_gt_two
    · exact twoUserCosPowerSum_le_bisector_of_angle_mem_Icc_of_le_two
        (by linarith) le_rfl ha_pos.le ha_le_half_pi hθ_nonnegative hθ_le_a
    · apply twoUserCosPowerSum_le_bisector_of_phase htwo_le_β hphase
        ha_pos ?_ hθ_nonnegative hθ_le_a
      have ha_ne : a ≠ Real.pi / 2 := by
        intro ha_eq
        rw [ha_eq, Real.cos_pi_div_two] at hphase
        norm_num at hphase
        linarith
      exact lt_of_le_of_ne ha_le_half_pi ha_ne

/--
On the left portion of the positive-score cone, the corrected two-user
angular-power objective is monotone toward angle zero.  Together with the
bisector comparison on `[0,a]`, this extends that comparison to the full cone
where both score cosines are nonnegative.
-/
theorem twoUserCosPowerSum_monotoneOn_left_positiveScoreCone
    {β a : ℝ} (hβ_one : 1 ≤ β)
    (ha_nonnegative : 0 ≤ a) (ha_le_half_pi : a ≤ Real.pi / 2) :
    MonotoneOn (twoUserCosPowerSum β a) (Set.Icc (a - Real.pi / 2) 0) := by
  apply monotoneOn_of_deriv_nonneg (convex_Icc _ _)
  · intro t _ht
    exact (hasDerivAt_twoUserCosPowerSum (β := β) (θstar := a) (θ := t)
      (Or.inr hβ_one) (Or.inr hβ_one)).continuousAt.continuousWithinAt
  · intro t _ht
    rw [interior_Icc] at _ht
    exact (hasDerivAt_twoUserCosPowerSum (β := β) (θstar := a) (θ := t)
      (Or.inr hβ_one) (Or.inr hβ_one)).differentiableAt.differentiableWithinAt
  · intro t ht
    rw [interior_Icc] at ht
    rw [(hasDerivAt_twoUserCosPowerSum (β := β) (θstar := a) (θ := t)
      (Or.inr hβ_one) (Or.inr hβ_one)).deriv]
    have ht_lower : a - Real.pi / 2 < t := ht.1
    have ht_upper : t < 0 := ht.2
    have hcos_t : 0 < Real.cos t := by
      apply Real.cos_pos_of_mem_Ioo
      constructor <;> nlinarith [Real.pi_pos]
    have hother_pos : 0 < a - t := by linarith
    have hother_lt_half_pi : a - t < Real.pi / 2 := by linarith
    have hcos_other : 0 < Real.cos (a - t) := by
      apply Real.cos_pos_of_mem_Ioo
      constructor <;> linarith
    have hsin_t : Real.sin t ≤ 0 := by
      apply Real.sin_nonpos_of_nonpos_of_neg_pi_le ht_upper.le
      nlinarith [Real.pi_pos]
    have hsin_other : 0 ≤ Real.sin (a - t) := by
      exact (Real.sin_pos_of_mem_Ioo ⟨hother_pos, by
        nlinarith [Real.pi_pos]⟩).le
    have hpow_t : 0 ≤ (Real.cos t) ^ (β - 1) :=
      Real.rpow_nonneg hcos_t.le _
    have hpow_other : 0 ≤ (Real.cos (a - t)) ^ (β - 1) :=
      Real.rpow_nonneg hcos_other.le _
    have hleft : Real.sin t * (Real.cos t) ^ (β - 1) ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg hsin_t hpow_t
    have hright : 0 ≤ Real.sin (a - t) * (Real.cos (a - t)) ^ (β - 1) :=
      mul_nonneg hsin_other hpow_other
    exact mul_nonneg (by linarith) (sub_nonneg.mpr (hleft.trans hright))

/--
Corrected two-user angular-power comparison on the full positive-score cone.
The source proof only wrote the smaller interval `0 <= theta <= theta_star`.
For score pairs arising from an unrestricted value-space projection, both
cosines merely place the polar angle in
`[theta_star - pi / 2, pi / 2]`; the additional outer intervals are handled
by monotonicity and reflection, not assumed away.
-/
theorem twoUserCosPowerSum_le_bisector_of_source_phase_of_angle_mem_positiveScoreCone
    {β a θ : ℝ} (hβ_one : 1 ≤ β)
    (hphase : β * (1 - Real.cos a) ≤ 2)
    (ha_pos : 0 < a) (ha_le_half_pi : a ≤ Real.pi / 2)
    (hθ_lower : a - Real.pi / 2 ≤ θ) (hθ_upper : θ ≤ Real.pi / 2) :
    twoUserCosPowerSum β a θ ≤ twoUserCosPowerSum β a (a / 2) := by
  have ha_nonnegative : 0 ≤ a := ha_pos.le
  have hleft_mono := twoUserCosPowerSum_monotoneOn_left_positiveScoreCone
    hβ_one ha_nonnegative ha_le_half_pi
  have hzero : twoUserCosPowerSum β a 0 ≤ twoUserCosPowerSum β a (a / 2) :=
    twoUserCosPowerSum_le_bisector_of_source_phase hβ_one hphase ha_pos
      ha_le_half_pi le_rfl ha_nonnegative
  rcases le_total θ 0 with hθ_nonpos | hθ_nonnegative
  · have hzero_mem : 0 ∈ Set.Icc (a - Real.pi / 2) 0 := by
      constructor <;> linarith
    exact (hleft_mono ⟨hθ_lower, hθ_nonpos⟩ hzero_mem hθ_nonpos).trans hzero
  · rcases le_total θ a with hθ_le_a | ha_le_θ
    · exact twoUserCosPowerSum_le_bisector_of_source_phase hβ_one hphase
        ha_pos ha_le_half_pi hθ_nonnegative hθ_le_a
    · let θ' : ℝ := a - θ
      have hθ'_lower : a - Real.pi / 2 ≤ θ' := by
        dsimp [θ']
        linarith
      have hθ'_nonpos : θ' ≤ 0 := by
        dsimp [θ']
        linarith
      have hzero_mem : 0 ∈ Set.Icc (a - Real.pi / 2) 0 := by
        constructor <;> linarith
      have hbound : twoUserCosPowerSum β a θ' ≤ twoUserCosPowerSum β a 0 :=
        hleft_mono ⟨hθ'_lower, hθ'_nonpos⟩ hzero_mem hθ'_nonpos
      have hsymm : twoUserCosPowerSum β a θ = twoUserCosPowerSum β a θ' := by
        unfold twoUserCosPowerSum
        have hback : a - θ' = θ := by
          dsimp [θ']
          ring
        rw [hback]
        exact add_comm _ _
      rw [hsymm]
      exact hbound.trans hzero

/--
A maximizer of the two-user angular-power sum on the left half of the
positive-score wedge is also maximal on the whole positive-score wedge.  The
right half follows by reflection, while the two exterior pieces are bounded by
the endpoint angle zero using the monotonicity established above.
-/
theorem twoUserCosPowerSum_le_of_isMaxOn_leftHalf_of_angle_mem_positiveScoreCone
    {β a φ θ : ℝ} (hβ_one : 1 ≤ β)
    (ha_pos : 0 < a) (ha_le_half_pi : a ≤ Real.pi / 2)
    (hmax : IsMaxOn (twoUserCosPowerSum β a) (Set.Icc 0 (a / 2)) φ)
    (hθ_lower : a - Real.pi / 2 ≤ θ) (hθ_upper : θ ≤ Real.pi / 2) :
    twoUserCosPowerSum β a θ ≤ twoUserCosPowerSum β a φ := by
  have ha_nonnegative : 0 ≤ a := ha_pos.le
  have hzero_mem : (0 : ℝ) ∈ Set.Icc 0 (a / 2) := by
    constructor <;> linarith
  have hzero_le : twoUserCosPowerSum β a 0 ≤ twoUserCosPowerSum β a φ :=
    hmax hzero_mem
  have hleft_mono := twoUserCosPowerSum_monotoneOn_left_positiveScoreCone
    hβ_one ha_nonnegative ha_le_half_pi
  rcases le_total θ 0 with hθ_nonpos | hθ_nonnegative
  · have hzero_left_mem : (0 : ℝ) ∈ Set.Icc (a - Real.pi / 2) 0 := by
      constructor <;> linarith
    exact (hleft_mono ⟨hθ_lower, hθ_nonpos⟩ hzero_left_mem hθ_nonpos).trans
      hzero_le
  · rcases le_total θ a with hθ_le_a | ha_le_θ
    · rcases le_total θ (a / 2) with hθ_left | hθ_right
      · exact hmax ⟨hθ_nonnegative, hθ_left⟩
      · let θ' : ℝ := a - θ
        have hθ'_nonnegative : 0 ≤ θ' := by
          dsimp [θ']
          linarith
        have hθ'_le_half : θ' ≤ a / 2 := by
          dsimp [θ']
          linarith
        have hsymm : twoUserCosPowerSum β a θ = twoUserCosPowerSum β a θ' := by
          unfold twoUserCosPowerSum
          have hback : a - θ' = θ := by
            dsimp [θ']
            ring
          rw [hback]
          exact add_comm _ _
        rw [hsymm]
        exact hmax ⟨hθ'_nonnegative, hθ'_le_half⟩
    · let θ' : ℝ := a - θ
      have hθ'_lower : a - Real.pi / 2 ≤ θ' := by
        dsimp [θ']
        linarith
      have hθ'_nonpos : θ' ≤ 0 := by
        dsimp [θ']
        linarith
      have hzero_left_mem : (0 : ℝ) ∈ Set.Icc (a - Real.pi / 2) 0 := by
        constructor <;> linarith
      have hbound : twoUserCosPowerSum β a θ' ≤ twoUserCosPowerSum β a 0 :=
        hleft_mono ⟨hθ'_lower, hθ'_nonpos⟩ hzero_left_mem hθ'_nonpos
      have hsymm : twoUserCosPowerSum β a θ = twoUserCosPowerSum β a θ' := by
        unfold twoUserCosPowerSum
        have hback : a - θ' = θ := by
          dsimp [θ']
          ring
        rw [hback]
        exact add_comm _ _
      rw [hsymm]
      exact hbound.trans hzero_le

/--
The corrected compact angular domain always admits a maximizing direction when
the real-power objective is differentiable through its possible zero-cosine
endpoints.  This supplies the existence content missing from the source's
informal `argmax` notation.
-/
theorem exists_twoUserCosPowerSum_isMaxOn_leftHalf
    {β θ : ℝ} (hbeta_one : 1 ≤ β) (htheta_nonnegative : 0 ≤ θ) :
    ∃ phi ∈ Set.Icc 0 (θ / 2),
      IsMaxOn (twoUserCosPowerSum β θ) (Set.Icc 0 (θ / 2)) phi := by
  have hcontinuous : Continuous (twoUserCosPowerSum β θ) := by
    rw [continuous_iff_continuousAt]
    intro t
    exact (hasDerivAt_twoUserCosPowerSum (β := β) (θstar := θ) (θ := t)
      (Or.inr hbeta_one) (Or.inr hbeta_one)).continuousAt
  have hnonempty : (Set.Icc (0 : ℝ) (θ / 2)).Nonempty := by
    exact ⟨0, by constructor <;> linarith⟩
  exact isCompact_Icc.exists_isMaxOn hnonempty hcontinuous.continuousOn

/--
Conversely, on the intended positive two-user angular domain, a global
bisector maximum of the corrected angular-power objective forces the source
phase inequality.  Together with
`twoUserCosPowerSum_le_bisector_of_source_phase`, this gives the exact
analytic angular threshold; it does not by itself identify an equilibrium
threshold.
-/
theorem twoUser_phase_le_of_cosPowerSum_bisector_max
    {β a : ℝ} (hβ_one : 1 ≤ β)
    (ha_pos : 0 < a) (ha_le_half_pi : a ≤ Real.pi / 2)
    (hmax : ∀ θ, 0 ≤ θ → θ ≤ a →
      twoUserCosPowerSum β a θ ≤ twoUserCosPowerSum β a (a / 2)) :
    β * (1 - Real.cos a) ≤ 2 := by
  by_contra hphase
  have hphase_gt : 2 < β * (1 - Real.cos a) := lt_of_not_ge hphase
  let f : ℝ → ℝ := twoUserCosPowerSum β a
  let g : ℝ → ℝ := fun t => β *
    (Real.sin (a - t) * (Real.cos (a - t)) ^ (β - 1) -
      Real.sin t * (Real.cos t) ^ (β - 1))
  have hhalf_pos : 0 < a / 2 := by positivity
  have hhalf_lt_a : a / 2 < a := by linarith
  have hcos_half : 0 < Real.cos (a / 2) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith, by linarith⟩
  have hphase_sin : 1 < β * (Real.sin (a / 2)) ^ 2 := by
    have htrig : 1 - Real.cos a = 2 * (Real.sin (a / 2)) ^ 2 := by
      rw [Real.sin_sq_eq_half_sub]
      have hdouble : 2 * (a / 2) = a := by ring
      rw [hdouble]
      ring
    rw [htrig] at hphase_gt
    nlinarith
  have htrig_half : (Real.sin (a / 2)) ^ 2 + (Real.cos (a / 2)) ^ 2 = 1 :=
    Real.sin_sq_add_cos_sq (a / 2)
  have hbracket_pos :
      0 < (β - 1) * (Real.sin (a / 2)) ^ 2 -
        (Real.cos (a / 2)) ^ 2 := by
    nlinarith
  have hpow :
      (Real.cos (a / 2)) ^ β =
        (Real.cos (a / 2)) ^ (β - 2) *
          (Real.cos (a / 2)) ^ 2 := by
    calc
      (Real.cos (a / 2)) ^ β =
          (Real.cos (a / 2)) ^ ((β - 2) + 2) := by congr 1 <;> ring
      _ = (Real.cos (a / 2)) ^ (β - 2) *
          (Real.cos (a / 2)) ^ (2 : ℝ) := by
        rw [Real.rpow_add hcos_half]
      _ = (Real.cos (a / 2)) ^ (β - 2) *
          (Real.cos (a / 2)) ^ 2 := by simp only [Real.rpow_two]
  have hcurvature_pos :
      0 < 2 * β *
        ((β - 1) * (Real.sin (a / 2)) ^ 2 *
            (Real.cos (a / 2)) ^ (β - 2) -
          (Real.cos (a / 2)) ^ β) := by
    rw [hpow]
    have hpow_pos : 0 < (Real.cos (a / 2)) ^ (β - 2) :=
      Real.rpow_pos_of_pos hcos_half _
    have hinside :
        0 < (β - 1) * (Real.sin (a / 2)) ^ 2 *
            (Real.cos (a / 2)) ^ (β - 2) -
          (Real.cos (a / 2)) ^ (β - 2) *
            (Real.cos (a / 2)) ^ 2 := by
      rw [show
        (β - 1) * (Real.sin (a / 2)) ^ 2 *
            (Real.cos (a / 2)) ^ (β - 2) -
          (Real.cos (a / 2)) ^ (β - 2) *
            (Real.cos (a / 2)) ^ 2 =
          (Real.cos (a / 2)) ^ (β - 2) *
            ((β - 1) * (Real.sin (a / 2)) ^ 2 -
              (Real.cos (a / 2)) ^ 2) by ring]
      exact mul_pos hpow_pos hbracket_pos
    exact mul_pos (mul_pos (by norm_num) (by linarith)) hinside
  have hderiv_f : HasDerivAt f (g (a / 2)) (a / 2) := by
    exact hasDerivAt_twoUserCosPowerSum (β := β) (θstar := a) (θ := a / 2)
      (Or.inr hβ_one) (Or.inr hβ_one)
  have hderiv_function : ∀ t, deriv f t = g t := by
    intro t
    exact (hasDerivAt_twoUserCosPowerSum (β := β) (θstar := a) (θ := t)
      (Or.inr hβ_one) (Or.inr hβ_one)).deriv
  have hderiv_g : HasDerivAt g
      (2 * β *
        ((β - 1) * (Real.sin (a / 2)) ^ 2 *
            (Real.cos (a / 2)) ^ (β - 2) -
          (Real.cos (a / 2)) ^ β)) (a / 2) := by
    exact hasDerivAt_twoUserCosPowerSum_derivative_at_bisector hcos_half
  have hsecond_pos : 0 < deriv (deriv f) (a / 2) := by
    rw [show deriv f = g from funext hderiv_function, hderiv_g.deriv]
    exact hcurvature_pos
  have hmaxOn : IsMaxOn f (Set.Icc 0 a) (a / 2) := by
    intro θ hθ
    exact hmax θ hθ.1 hθ.2
  have hIcc_nhds : Set.Icc 0 a ∈ nhds (a / 2) :=
    Filter.mem_of_superset (Ioo_mem_nhds hhalf_pos hhalf_lt_a)
      Set.Ioo_subset_Icc_self
  have hlocalmax : IsLocalMax f (a / 2) := hmaxOn.isLocalMax hIcc_nhds
  have hfirst_zero : deriv f (a / 2) = 0 :=
    hlocalmax.hasDerivAt_eq_zero (by
      rw [hderiv_function (a / 2)]
      exact hderiv_f)
  have hlocalmin : IsLocalMin f (a / 2) :=
    isLocalMin_of_deriv_deriv_pos hsecond_pos hfirst_zero hderiv_f.continuousAt
  have hevent : ∀ᶠ x in nhds (a / 2), f x = f (a / 2) := by
    filter_upwards [hlocalmax, hlocalmin] with x hxmax hxmin
    exact le_antisymm hxmax hxmin
  rcases (Metric.mem_nhds_iff.mp hevent) with ⟨ε, hε_pos, hball⟩
  let left : ℝ := a / 2 - ε / 2
  let right : ℝ := a / 2 + ε / 2
  have hconstant : ∀ x, x ∈ Set.Ioo left right → f x = f (a / 2) := by
    intro x hx
    apply hball
    rw [Metric.mem_ball, Real.dist_eq]
    have habs : |x - a / 2| < ε := by
      rw [abs_lt]
      change a / 2 - ε / 2 < x ∧ x < a / 2 + ε / 2 at hx
      constructor <;> linarith
    simpa [abs_sub_comm] using habs
  have hcenter : a / 2 ∈ Set.Ioo left right := by
    dsimp [left, right]
    constructor <;> linarith
  have hzero_g : ∀ x, x ∈ Set.Ioo left right → g x = 0 := by
    intro x hx
    have hlocal : f =ᶠ[nhds x] (fun _ : ℝ => f (a / 2)) := by
      filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
      exact hconstant y hy
    have hzero_f : HasDerivAt f 0 x :=
      (hasDerivAt_const x (f (a / 2))).congr_of_eventuallyEq hlocal
    calc
      g x = deriv f x := (hderiv_function x).symm
      _ = 0 := hzero_f.deriv
  have hzero_deriv_g : HasDerivAt g 0 (a / 2) := by
    have hlocal : g =ᶠ[nhds (a / 2)] (fun _ : ℝ => 0) := by
      filter_upwards [Ioo_mem_nhds hcenter.1 hcenter.2] with x hx
      exact hzero_g x hx
    exact (hasDerivAt_const (a / 2) 0).congr_of_eventuallyEq hlocal
  have : (0 : ℝ) = 2 * β *
      ((β - 1) * (Real.sin (a / 2)) ^ 2 *
          (Real.cos (a / 2)) ^ (β - 2) -
        (Real.cos (a / 2)) ^ β) :=
    hzero_deriv_g.unique hderiv_g
  linarith

/--
Exact threshold characterization for the corrected two-user angular C1
comparison on the source's visible positive angular domain.
-/
theorem twoUserCosPowerSum_bisector_max_iff_source_phase
    {β a : ℝ} (hβ_one : 1 ≤ β)
    (ha_pos : 0 < a) (ha_le_half_pi : a ≤ Real.pi / 2) :
    (∀ θ, 0 ≤ θ → θ ≤ a →
      twoUserCosPowerSum β a θ ≤ twoUserCosPowerSum β a (a / 2)) ↔
      β * (1 - Real.cos a) ≤ 2 := by
  constructor
  · exact twoUser_phase_le_of_cosPowerSum_bisector_max hβ_one ha_pos ha_le_half_pi
  · intro hphase θ hθ_nonnegative hθ_le_a
    exact twoUserCosPowerSum_le_bisector_of_source_phase
      hβ_one hphase ha_pos ha_le_half_pi hθ_nonnegative hθ_le_a

/--
Above the corrected two-user phase threshold, a compact left-half maximizer is
strictly away from the bisector.  Otherwise the positive-score-wedge extension
would make the bisector globally maximal and force the opposite phase
inequality.
-/
theorem twoUserCosPowerSum_leftHalf_max_lt_half_of_phase_gt
    {β θ phi : ℝ} (hbeta_one : 1 ≤ β)
    (htheta_pos : 0 < θ) (htheta_le_half_pi : θ ≤ Real.pi / 2)
    (hphase_gt : 2 < β * (1 - Real.cos θ))
    (hphi : phi ∈ Set.Icc 0 (θ / 2))
    (hmax : IsMaxOn (twoUserCosPowerSum β θ) (Set.Icc 0 (θ / 2)) phi) :
    phi < θ / 2 := by
  rcases hphi.2.lt_or_eq with hlt | heq
  · exact hlt
  · subst phi
    have hbisector_max : ∀ psi : ℝ, 0 ≤ psi → psi ≤ θ →
        twoUserCosPowerSum β θ psi ≤ twoUserCosPowerSum β θ (θ / 2) := by
      intro psi hpsi_nonnegative hpsi_le_theta
      have hpsi_lower : θ - Real.pi / 2 ≤ psi := by
        linarith [Real.pi_pos]
      have hpsi_upper : psi ≤ Real.pi / 2 := hpsi_le_theta.trans htheta_le_half_pi
      exact twoUserCosPowerSum_le_of_isMaxOn_leftHalf_of_angle_mem_positiveScoreCone
        hbeta_one htheta_pos htheta_le_half_pi hmax hpsi_lower hpsi_upper
    have hphase_le := twoUser_phase_le_of_cosPowerSum_bisector_max
      hbeta_one htheta_pos htheta_le_half_pi hbisector_max
    linarith

/--
For a strictly acute user angle, the off-bisector compact maximizer above the
phase threshold produces the positive score ratio required by the alternating
candidate law.  The strict ratio is a theorem, not an unrecorded consequence
of the source's informal argmax notation.
-/
theorem twoUserCosRatio_pos_lt_one_of_leftHalf_max_of_phase_gt
    {β θ phi : ℝ} (hbeta_one : 1 ≤ β)
    (htheta_pos : 0 < θ) (htheta_lt_half_pi : θ < Real.pi / 2)
    (hphase_gt : 2 < β * (1 - Real.cos θ))
    (hphi : phi ∈ Set.Icc 0 (θ / 2))
    (hmax : IsMaxOn (twoUserCosPowerSum β θ) (Set.Icc 0 (θ / 2)) phi) :
    0 < Real.cos (θ - phi) / Real.cos phi ∧
      Real.cos (θ - phi) / Real.cos phi < 1 := by
  have hphi_lt : phi < θ / 2 :=
    twoUserCosPowerSum_leftHalf_max_lt_half_of_phase_gt
      hbeta_one htheta_pos htheta_lt_half_pi.le hphase_gt hphi hmax
  have hcos_phi_pos : 0 < Real.cos phi := by
    apply Real.cos_pos_of_mem_Ioo
    constructor
    · nlinarith [hphi.1, Real.pi_pos]
    · linarith [hphi.2, htheta_lt_half_pi]
  have hother_pos : 0 < θ - phi := by linarith
  have hother_lt_half_pi : θ - phi < Real.pi / 2 := by
    linarith [hphi.1, htheta_lt_half_pi]
  have hcos_other_pos : 0 < Real.cos (θ - phi) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hother_lt_half_pi⟩
  have hangle_lt : phi < θ - phi := by linarith
  have hcos_other_lt : Real.cos (θ - phi) < Real.cos phi :=
    Real.cos_lt_cos_of_nonneg_of_le_pi_div_two hphi.1 hother_lt_half_pi.le hangle_lt
  exact ⟨div_pos hcos_other_pos hcos_phi_pos,
    (div_lt_one₀ hcos_phi_pos).2 hcos_other_lt⟩

/-- Source scale `c` in the infinite-producer proof, using the second displayed form. -/
noncomputable def infiniteGenreScale
    (β θstar θG : ℝ) : ℝ :=
  Real.sin θG /
    (Real.sin θstar * (Real.cos (θstar - θG)) ^ (β - 1))

theorem inv_infiniteGenreScale
    {β θstar θG : ℝ}
    (hsinG : Real.sin θG ≠ 0)
    (hsinStar : Real.sin θstar ≠ 0)
    (hcosO : 0 < Real.cos (θstar - θG)) :
    (infiniteGenreScale β θstar θG)⁻¹ =
      Real.sin θstar * (Real.cos (θstar - θG)) ^ (β - 1) / Real.sin θG := by
  unfold infiniteGenreScale
  have hpow_ne :
      (Real.cos (θstar - θG)) ^ (β - 1) ≠ 0 :=
    ne_of_gt (Real.rpow_pos_of_pos hcosO _)
  field_simp [hsinG, hsinStar, hpow_ne]

theorem infiniteGenre_cosPower_sum_eq_inv_scale_of_betaPowers
    {β θstar θG : ℝ}
    (hsinG : Real.sin θG ≠ 0)
    (hsinStar : Real.sin θstar ≠ 0)
    (hcosG : 0 < Real.cos θG)
    (hcosO : 0 < Real.cos (θstar - θG))
    (hbetaPowers :
      Real.sin θG * (Real.cos θG) ^ (β - 1) =
        Real.sin (θstar - θG) * (Real.cos (θstar - θG)) ^ (β - 1)) :
    (Real.cos θG) ^ β + (Real.cos (θstar - θG)) ^ β =
      (infiniteGenreScale β θstar θG)⁻¹ := by
  rw [inv_infiniteGenreScale hsinG hsinStar hcosO]
  exact infiniteGenre_cosPower_sum_eq_of_betaPowers hsinG hcosG hcosO hbetaPowers

/--
The power-valued branch in the repaired version of the source's candidate
conditional-quality CDF.  On the geometric interval with index `n`, this is
the second branch displayed in `infinitegenreformal`, with the intended
genre-indexed exponents made explicit.
-/
noncomputable def infiniteGenreCdfPowerPiece
    (C1 C2 beta : ℝ) (n : ℕ) (q : ℝ) : ℝ :=
  C1 ^ (-2 : ℝ) * C2 ^ (-2 * (n : ℝ) * beta) * q ^ (2 * beta)

/--
The constant branch between successive power pieces in the repaired candidate
CDF.  It is the first displayed branch of the source formula.
-/
noncomputable def infiniteGenreCdfPlateauPiece
    (C2 beta : ℝ) (n : ℕ) : ℝ :=
  C2 ^ ((2 * (n : ℝ) + 2) * beta)

/--
The scale denoted `C_3` in the source proof, corrected so that it is defined
from the theorem's displayed constants.  The relation
`C_3 = C_1 C_2^{-β}` is exactly what makes the alternating CDF pieces obey
the functional equation.
-/
noncomputable def infiniteGenreCdfFunctionalScale
    (C1 C2 beta : ℝ) : ℝ :=
  C1 * C2 ^ (-beta)

/--
On a power branch and its immediately following plateau branch, the repaired
candidate CDF satisfies the squared functional equation in the source proof.
This is a local branch calculation; the later total-CDF construction must
still prove that the countable geometric branches cover the whole positive
half-line and glue monotonically at their endpoints.
-/
theorem infiniteGenreCdf_power_plateau_product
    {C1 C2 beta q : ℝ} {n : ℕ}
    (hC1 : 0 < C1) (hC2 : 0 < C2) (hq : 0 ≤ q) :
    infiniteGenreCdfPowerPiece C1 C2 beta n q *
        infiniteGenreCdfPlateauPiece C2 beta n =
      (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
        q ^ (2 * beta) := by
  unfold infiniteGenreCdfPowerPiece infiniteGenreCdfPlateauPiece
    infiniteGenreCdfFunctionalScale
  have hC1_nonneg : 0 ≤ C1 := hC1.le
  have hC2_nonneg : 0 ≤ C2 := hC2.le
  have hcoeff :
      C2 ^ (-2 * (n : ℝ) * beta) *
          C2 ^ ((2 * (n : ℝ) + 2) * beta) =
        (C2 ^ (-beta)) ^ (-2 : ℝ) := by
    calc
      C2 ^ (-2 * (n : ℝ) * beta) *
          C2 ^ ((2 * (n : ℝ) + 2) * beta) =
          C2 ^ ((-2 * (n : ℝ) * beta) +
            ((2 * (n : ℝ) + 2) * beta)) :=
        (Real.rpow_add hC2 _ _).symm
      _ = C2 ^ (2 * beta) := by congr 1 <;> ring
      _ = (C2 ^ (-beta)) ^ (-2 : ℝ) := by
        rw [← Real.rpow_mul hC2_nonneg]
        congr 1 <;> ring
  rw [Real.mul_rpow hC1_nonneg
    (Real.rpow_nonneg hC2_nonneg _)]
  calc
    C1 ^ (-2 : ℝ) * C2 ^ (-2 * (n : ℝ) * beta) * q ^ (2 * beta) *
        C2 ^ ((2 * (n : ℝ) + 2) * beta) =
        C1 ^ (-2 : ℝ) *
          (C2 ^ (-2 * (n : ℝ) * beta) *
            C2 ^ ((2 * (n : ℝ) + 2) * beta)) * q ^ (2 * beta) := by ring
    _ = C1 ^ (-2 : ℝ) * (C2 ^ (-beta)) ^ (-2 : ℝ) *
          q ^ (2 * beta) := by rw [hcoeff]

/--
On a plateau branch and the next power branch evaluated after multiplication
by `C₂`, the same squared functional equation holds.  This is the second
local case required by the source's alternating geometric construction.
-/
theorem infiniteGenreCdf_plateau_power_product
    {C1 C2 beta q : ℝ} {n : ℕ}
    (hC1 : 0 < C1) (hC2 : 0 < C2) (hq : 0 ≤ q) :
    infiniteGenreCdfPlateauPiece C2 beta n *
        infiniteGenreCdfPowerPiece C1 C2 beta (n + 1) (q * C2) =
      (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
        q ^ (2 * beta) := by
  unfold infiniteGenreCdfPowerPiece infiniteGenreCdfPlateauPiece
    infiniteGenreCdfFunctionalScale
  have hC1_nonneg : 0 ≤ C1 := hC1.le
  have hC2_nonneg : 0 ≤ C2 := hC2.le
  have hcoeff :
      C2 ^ ((2 * (n : ℝ) + 2) * beta) *
          C2 ^ (-2 * ((n + 1 : ℕ) : ℝ) * beta) * C2 ^ (2 * beta) =
        (C2 ^ (-beta)) ^ (-2 : ℝ) := by
    calc
      C2 ^ ((2 * (n : ℝ) + 2) * beta) *
          C2 ^ (-2 * ((n + 1 : ℕ) : ℝ) * beta) * C2 ^ (2 * beta) =
          C2 ^ (((2 * (n : ℝ) + 2) * beta) +
            (-2 * ((n + 1 : ℕ) : ℝ) * beta)) * C2 ^ (2 * beta) := by
        rw [← Real.rpow_add hC2]
      _ = C2 ^ (((2 * (n : ℝ) + 2) * beta +
            (-2 * ((n + 1 : ℕ) : ℝ) * beta)) + 2 * beta) :=
        (Real.rpow_add hC2 _ _).symm
      _ = C2 ^ (2 * beta) := by norm_num; congr 1 <;> ring
      _ = (C2 ^ (-beta)) ^ (-2 : ℝ) := by
        rw [← Real.rpow_mul hC2_nonneg]
        congr 1 <;> ring
  rw [Real.mul_rpow hq hC2_nonneg]
  rw [Real.mul_rpow hC1_nonneg
    (Real.rpow_nonneg hC2_nonneg _)]
  calc
    C2 ^ ((2 * (n : ℝ) + 2) * beta) *
        (C1 ^ (-2 : ℝ) * C2 ^ (-2 * ((n + 1 : ℕ) : ℝ) * beta) *
          (q ^ (2 * beta) * C2 ^ (2 * beta))) =
        C1 ^ (-2 : ℝ) *
          (C2 ^ ((2 * (n : ℝ) + 2) * beta) *
            C2 ^ (-2 * ((n + 1 : ℕ) : ℝ) * beta) * C2 ^ (2 * beta)) *
          q ^ (2 * beta) := by ring
    _ = C1 ^ (-2 : ℝ) * (C2 ^ (-beta)) ^ (-2 : ℝ) *
          q ^ (2 * beta) := by rw [hcoeff]

/--
The least geometric shell whose lower endpoint is no greater than `q`.
Outside the intended parameter range the fallback branch makes this a total
function; the subsequent existence theorem shows that the fallback is never
used for the corrected positive geometric regime.
-/
noncomputable def infiniteGenreCdfIndex (a C2 q : ℝ) : ℕ :=
  by
    classical
    exact if h : ∃ n : ℕ, a * C2 ^ n ≤ q then Nat.find h else 0

/--
A total, repaired version of the source's alternating candidate `FMax`.
Here `a` is the upper cutoff, intended to satisfy `a ^ beta = C1`, and `C2`
is the geometric ratio.  The least-index convention assigns every geometric
endpoint to its upper adjacent shell, where the two printed formulas agree.
The definition itself is total; its CDF and functional-equation properties
are proved only under the explicit positive parameter regime below.
-/
noncomputable def infiniteGenreCandidateCdf
    (a C1 C2 beta q : ℝ) : ℝ :=
  if q ≤ 0 then 0
  else if a ≤ q then 1
  else
    let k := infiniteGenreCdfIndex a C2 q
    if Even k then C2 ^ ((k : ℝ) * beta)
    else C1 ^ (-2 : ℝ) * C2 ^ (-2 * ((k / 2 : ℕ) : ℝ) * beta) *
      q ^ (2 * beta)

theorem infiniteGenreCdfIndex_eq_find
    {a C2 q : ℝ} (h : ∃ n : ℕ, a * C2 ^ n ≤ q) :
    infiniteGenreCdfIndex a C2 q = Nat.find h := by
  classical
  simp [infiniteGenreCdfIndex, h]

/--
Every strictly positive quality below a strictly positive upper cutoff has a
geometric shell when the ratio lies in `(0,1)`.  This is the missing interval
coverage fact needed to turn the source's countably many cases into a total
candidate CDF.
-/
theorem exists_infiniteGenreCdfIndex
    {a C2 q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1)
    (hq : 0 < q) (hqa : q < a) :
    ∃ n : ℕ, a * C2 ^ n ≤ q := by
  have hratio_pos : 0 < q / a := div_pos hq ha
  have hratio_le_one : q / a ≤ 1 := (div_le_one₀ ha).mpr hqa.le
  obtain ⟨n, hn_lt, _⟩ :=
    exists_nat_pow_near_of_lt_one hratio_pos hratio_le_one hC2 hC2_one
  refine ⟨n + 1, le_of_lt ?_⟩
  have hmul : C2 ^ (n + 1) * a < q :=
    (lt_div_iff₀ ha).mp hn_lt
  simpa [mul_comm] using hmul

/--
The repaired candidate takes the power branch precisely when its least shell
index is odd.  This exposes the formula used in the source's alternating
case calculation without assuming that formula as an opaque CDF identity.
-/
theorem infiniteGenreCandidateCdf_eq_power_of_index_odd
    {a C1 C2 beta q : ℝ}
    (hq : 0 < q) (hqa : q < a)
    (hodd : Odd (infiniteGenreCdfIndex a C2 q)) :
    infiniteGenreCandidateCdf a C1 C2 beta q =
      infiniteGenreCdfPowerPiece C1 C2 beta
        ((infiniteGenreCdfIndex a C2 q) / 2) q := by
  unfold infiniteGenreCandidateCdf
  rw [if_neg (not_le_of_gt hq), if_neg (not_le_of_gt hqa)]
  dsimp
  rw [if_neg (Nat.not_even_iff_odd.mpr hodd)]
  rfl

/--
The repaired candidate takes the plateau branch at a positive even least
shell index.  The separate positive-index premise rules out the upper cutoff
case, which is assigned directly to the value one.
-/
theorem infiniteGenreCandidateCdf_eq_even_shell
    {a C1 C2 beta q : ℝ}
    (hq : 0 < q) (hqa : q < a)
    (heven : Even (infiniteGenreCdfIndex a C2 q)) :
    infiniteGenreCandidateCdf a C1 C2 beta q =
      C2 ^ ((infiniteGenreCdfIndex a C2 q : ℝ) * beta) := by
  unfold infiniteGenreCandidateCdf
  rw [if_neg (not_le_of_gt hq), if_neg (not_le_of_gt hqa)]
  dsimp
  rw [if_pos heven]

/-- A point strictly below the upper cutoff has a strictly positive shell index. -/
theorem infiniteGenreCdfIndex_pos_of_lt
    {a C2 q : ℝ}
    (h : ∃ n : ℕ, a * C2 ^ n ≤ q) (hqa : q < a) :
    0 < infiniteGenreCdfIndex a C2 q := by
  classical
  rw [infiniteGenreCdfIndex_eq_find h]
  apply (Nat.find_pos h).mpr
  intro hzero
  exact (not_le_of_gt hqa) (by simpa using hzero)

/-- The least geometric-shell index is antitone in the quality value. -/
theorem infiniteGenreCdfIndex_antitone
    {a C2 q r : ℝ}
    (hq : ∃ n : ℕ, a * C2 ^ n ≤ q) (hqr : q ≤ r) :
    infiniteGenreCdfIndex a C2 r ≤ infiniteGenreCdfIndex a C2 q := by
  classical
  let hr : ∃ n : ℕ, a * C2 ^ n ≤ r :=
    ⟨Nat.find hq, (Nat.find_spec hq).trans hqr⟩
  rw [infiniteGenreCdfIndex_eq_find hr, infiniteGenreCdfIndex_eq_find hq]
  exact Nat.find_min' hr ((Nat.find_spec hq).trans hqr)

/-- The least shell's lower endpoint is attained below the quality value. -/
theorem infiniteGenreCdfIndex_spec
    {a C2 q : ℝ} (h : ∃ n : ℕ, a * C2 ^ n ≤ q) :
    a * C2 ^ (infiniteGenreCdfIndex a C2 q) ≤ q := by
  classical
  rw [infiniteGenreCdfIndex_eq_find h]
  exact Nat.find_spec h

/-- At a geometric endpoint, the least-shell convention returns its exponent. -/
theorem infiniteGenreCdfIndex_eq_geometric_endpoint
    {a C2 : ℝ} {n : ℕ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) :
    infiniteGenreCdfIndex a C2 (a * C2 ^ n) = n := by
  classical
  let h : ∃ m : ℕ, a * C2 ^ m ≤ a * C2 ^ n := ⟨n, le_rfl⟩
  rw [infiniteGenreCdfIndex_eq_find h]
  apply (Nat.find_eq_iff h).mpr
  constructor
  · exact le_rfl
  · intro m hm hbound
    have hpow : C2 ^ n < C2 ^ m :=
      pow_lt_pow_right_of_lt_one₀ hC2 hC2_one hm
    have hmul : a * C2 ^ n < a * C2 ^ m :=
      mul_lt_mul_of_pos_left hpow ha
    exact (not_le_of_gt hmul) hbound

/--
At a positive least shell index, the preceding (larger) geometric endpoint is
strictly above the quality value.
-/
theorem lt_infiniteGenreCdfIndex_predecessor_endpoint
    {a C2 q : ℝ} (h : ∃ n : ℕ, a * C2 ^ n ≤ q)
    (hindex_pos : 0 < infiniteGenreCdfIndex a C2 q) :
    q < a * C2 ^ (infiniteGenreCdfIndex a C2 q - 1) := by
  classical
  rw [infiniteGenreCdfIndex_eq_find h] at hindex_pos ⊢
  apply lt_of_not_ge
  intro hbound
  have hmin : Nat.find h ≤ Nat.find h - 1 := Nat.find_min' h hbound
  omega

/--
A point between a shell's lower endpoint and the preceding upper endpoint has
that shell as its least geometric index.  This is the local constancy fact
needed for analytic regularity of the total candidate CDF.
-/
theorem infiniteGenreCdfIndex_eq_of_ge_lower_lt_predecessor
    {a C2 q : ℝ} {k : ℕ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1)
    (hk_pos : 0 < k)
    (hlower : a * C2 ^ k ≤ q)
    (hupper : q < a * C2 ^ (k - 1)) :
    infiniteGenreCdfIndex a C2 q = k := by
  classical
  let h : ∃ n : ℕ, a * C2 ^ n ≤ q := ⟨k, hlower⟩
  rw [infiniteGenreCdfIndex_eq_find h]
  apply (Nat.find_eq_iff h).mpr
  constructor
  · exact hlower
  · intro m hm hbound
    have hm_le : m ≤ k - 1 := by omega
    have hpow : C2 ^ (k - 1) ≤ C2 ^ m :=
      pow_le_pow_of_le_one hC2.le hC2_one.le hm_le
    have hmul : a * C2 ^ (k - 1) ≤ a * C2 ^ m :=
      mul_le_mul_of_nonneg_left hpow ha.le
    exact (not_le_of_gt (hupper.trans_le hmul)) hbound

/-- A fixed power piece is monotone on nonnegative qualities. -/
theorem infiniteGenreCdfPowerPiece_mono
    {C1 C2 beta q r : ℝ} {n : ℕ}
    (hC1 : 0 ≤ C1) (hC2 : 0 ≤ C2) (hbeta : 0 ≤ beta)
    (hq : 0 ≤ q) (hqr : q ≤ r) :
    infiniteGenreCdfPowerPiece C1 C2 beta n q ≤
      infiniteGenreCdfPowerPiece C1 C2 beta n r := by
  unfold infiniteGenreCdfPowerPiece
  have hcoeff : 0 ≤ C1 ^ (-2 : ℝ) * C2 ^ (-2 * (n : ℝ) * beta) :=
    mul_nonneg (Real.rpow_nonneg hC1 _) (Real.rpow_nonneg hC2 _)
  apply mul_le_mul_of_nonneg_left _ hcoeff
  exact Real.rpow_le_rpow hq hqr (by nlinarith)

/-- The repaired candidate is monotone when two points lie in the same shell. -/
theorem infiniteGenreCandidateCdf_mono_of_index_eq
    {a C1 C2 beta q r : ℝ}
    (hC1 : 0 < C1) (hC2 : 0 < C2) (hbeta : 0 < beta)
    (hq : 0 < q) (hqa : q < a) (hr : 0 < r) (hra : r < a) (hqr : q ≤ r)
    (hindex : infiniteGenreCdfIndex a C2 q = infiniteGenreCdfIndex a C2 r) :
    infiniteGenreCandidateCdf a C1 C2 beta q ≤
      infiniteGenreCandidateCdf a C1 C2 beta r := by
  by_cases heven : Even (infiniteGenreCdfIndex a C2 q)
  · have heven_r : Even (infiniteGenreCdfIndex a C2 r) := by
      rw [← hindex]
      exact heven
    rw [infiniteGenreCandidateCdf_eq_even_shell hq hqa heven,
      infiniteGenreCandidateCdf_eq_even_shell hr hra heven_r, hindex]
  · have hodd : Odd (infiniteGenreCdfIndex a C2 q) :=
      Nat.not_even_iff_odd.mp heven
    have hodd_r : Odd (infiniteGenreCdfIndex a C2 r) := by
      rw [← hindex]
      exact hodd
    calc
      infiniteGenreCandidateCdf a C1 C2 beta q =
          infiniteGenreCdfPowerPiece C1 C2 beta
            ((infiniteGenreCdfIndex a C2 q) / 2) q :=
        infiniteGenreCandidateCdf_eq_power_of_index_odd hq hqa hodd
      _ ≤ infiniteGenreCdfPowerPiece C1 C2 beta
          ((infiniteGenreCdfIndex a C2 q) / 2) r :=
        infiniteGenreCdfPowerPiece_mono hC1.le hC2.le hbeta.le hq.le hqr
      _ = infiniteGenreCdfPowerPiece C1 C2 beta
          ((infiniteGenreCdfIndex a C2 r) / 2) r := by rw [hindex]
      _ = infiniteGenreCandidateCdf a C1 C2 beta r :=
        (infiniteGenreCandidateCdf_eq_power_of_index_odd hr hra hodd_r).symm

/-- Above its upper cutoff, the repaired candidate CDF is one. -/
theorem infiniteGenreCandidateCdf_eq_one_of_le
    {a C1 C2 beta q : ℝ}
    (hq : 0 < q) (haq : a ≤ q) :
    infiniteGenreCandidateCdf a C1 C2 beta q = 1 := by
  unfold infiniteGenreCandidateCdf
  rw [if_neg (not_le_of_gt hq), if_pos haq]

/--
If the first geometric lower endpoint is reached but the upper cutoff is not,
the least shell index is exactly one.
-/
theorem infiniteGenreCdfIndex_eq_one_of_first_shell
    {a C2 q : ℝ}
    (hbelow : q < a) (hfirst : a * C2 ≤ q) :
    infiniteGenreCdfIndex a C2 q = 1 := by
  classical
  let h : ∃ n : ℕ, a * C2 ^ n ≤ q := ⟨1, by simpa using hfirst⟩
  rw [infiniteGenreCdfIndex_eq_find h]
  apply (Nat.find_eq_iff h).mpr
  constructor
  · simpa using hfirst
  · intro n hn hbound
    have hn_zero : n = 0 := by omega
    subst n
    exact (not_le_of_gt hbelow) (by simpa using hbound)

/--
Multiplication by the geometric ratio advances the least shell by exactly one.
This is the indexing fact that the printed proof uses implicitly when it
matches a power piece at `q` with a plateau piece at `q C₂`, and conversely.
-/
theorem infiniteGenreCdfIndex_mul_eq_succ
    {a C2 q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1)
    (hq : 0 < q) (hqa : q < a) :
    infiniteGenreCdfIndex a C2 (q * C2) =
      infiniteGenreCdfIndex a C2 q + 1 := by
  classical
  have hqC2_pos : 0 < q * C2 := mul_pos hq hC2
  have hqC2_lt_q : q * C2 < q := by
    nlinarith [mul_pos hq (sub_pos.mpr hC2_one)]
  have hqC2_lt_a : q * C2 < a := hqC2_lt_q.trans hqa
  let hq_exists : ∃ n : ℕ, a * C2 ^ n ≤ q :=
    exists_infiniteGenreCdfIndex ha hC2 hC2_one hq hqa
  let hqC2_exists : ∃ n : ℕ, a * C2 ^ n ≤ q * C2 :=
    exists_infiniteGenreCdfIndex ha hC2 hC2_one hqC2_pos hqC2_lt_a
  let hsucc_exists : ∃ n : ℕ, a * C2 ^ (n + 1) ≤ q * C2 := by
    obtain ⟨n, hn⟩ := hq_exists
    refine ⟨n, ?_⟩
    have hmul := mul_le_mul_of_nonneg_right hn hC2.le
    simpa [pow_succ, mul_assoc] using hmul
  have hzero : ¬ a * C2 ^ 0 ≤ q * C2 := by
    intro h
    have ha_le : a ≤ q * C2 := by simpa using h
    exact (not_le_of_gt hqa) (ha_le.trans (le_of_lt hqC2_lt_q))
  have hsucc_iff : ∀ n : ℕ,
      a * C2 ^ (n + 1) ≤ q * C2 ↔ a * C2 ^ n ≤ q := by
    intro n
    constructor
    · intro h
      apply (mul_le_mul_iff_right₀ hC2).mp
      simpa [pow_succ, mul_assoc, mul_comm, mul_left_comm] using h
    · intro h
      have hmul := (mul_le_mul_iff_right₀ hC2).mpr h
      simpa [pow_succ, mul_assoc, mul_comm, mul_left_comm] using hmul
  have hfind_shift : Nat.find hqC2_exists = Nat.find hsucc_exists + 1 :=
    Nat.find_comp_succ hqC2_exists hsucc_exists hzero
  have hfind_succ : Nat.find hsucc_exists = Nat.find hq_exists :=
    Nat.find_congr' (fun {n} => hsucc_iff n)
  calc
    infiniteGenreCdfIndex a C2 (q * C2) = Nat.find hqC2_exists :=
      infiniteGenreCdfIndex_eq_find hqC2_exists
    _ = Nat.find hsucc_exists + 1 := hfind_shift
    _ = Nat.find hq_exists + 1 := by rw [hfind_succ]
    _ = infiniteGenreCdfIndex a C2 q + 1 := by
      rw [infiniteGenreCdfIndex_eq_find hq_exists]

/--
The repaired total candidate obeys the source's squared functional equation
throughout the nontrivial geometric interior.  Unlike the printed proof, the
case split is exhaustive: it follows from the least-shell construction and
the proven successor rule for multiplication by `C₂`.
-/
theorem infiniteGenreCandidateCdf_product_of_lt_cutoff
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC1 : 0 < C1) (hC2 : 0 < C2) (hC2_one : C2 < 1)
    (hq : 0 < q) (hqa : q < a) :
    infiniteGenreCandidateCdf a C1 C2 beta q *
        infiniteGenreCandidateCdf a C1 C2 beta (q * C2) =
      (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
        q ^ (2 * beta) := by
  classical
  have hqC2_pos : 0 < q * C2 := mul_pos hq hC2
  have hqC2_lt_q : q * C2 < q := by
    nlinarith [mul_pos hq (sub_pos.mpr hC2_one)]
  have hqC2_lt_a : q * C2 < a := hqC2_lt_q.trans hqa
  have hq_exists : ∃ n : ℕ, a * C2 ^ n ≤ q :=
    exists_infiniteGenreCdfIndex ha hC2 hC2_one hq hqa
  have hindex_pos : 0 < infiniteGenreCdfIndex a C2 q :=
    infiniteGenreCdfIndex_pos_of_lt hq_exists hqa
  let k := infiniteGenreCdfIndex a C2 q
  have hk_pos : 0 < k := by simpa [k] using hindex_pos
  have hk_shift : infiniteGenreCdfIndex a C2 (q * C2) = k + 1 := by
    simpa [k] using
      (infiniteGenreCdfIndex_mul_eq_succ ha hC2 hC2_one hq hqa)
  by_cases hk_even : Even k
  · rcases hk_even with ⟨n, hn⟩
    have hn_pos : 0 < n := by omega
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn_pos)
    have hindex_q_even : infiniteGenreCdfIndex a C2 q = (m + 1) + (m + 1) := by
      simpa [k] using hn
    have hindex_q : infiniteGenreCdfIndex a C2 q = 2 * (m + 1) := by omega
    have hindex_qC2 : infiniteGenreCdfIndex a C2 (q * C2) =
        2 * (m + 1) + 1 := by
      calc
        infiniteGenreCdfIndex a C2 (q * C2) = k + 1 := hk_shift
        _ = 2 * (m + 1) + 1 := by omega
    have hq_plateau :
        infiniteGenreCandidateCdf a C1 C2 beta q =
          infiniteGenreCdfPlateauPiece C2 beta m := by
      rw [infiniteGenreCandidateCdf_eq_even_shell hq hqa
        ⟨m + 1, hindex_q_even⟩, hindex_q_even]
      unfold infiniteGenreCdfPlateauPiece
      congr 1
      push_cast
      ring
    have hqC2_power :
        infiniteGenreCandidateCdf a C1 C2 beta (q * C2) =
          infiniteGenreCdfPowerPiece C1 C2 beta (m + 1) (q * C2) := by
      rw [infiniteGenreCandidateCdf_eq_power_of_index_odd
        hqC2_pos hqC2_lt_a ⟨m + 1, hindex_qC2⟩, hindex_qC2]
      have hhalf : (2 * (m + 1) + 1) / 2 = m + 1 := by omega
      rw [hhalf]
    rw [hq_plateau, hqC2_power]
    exact infiniteGenreCdf_plateau_power_product hC1 hC2 hq.le
  · have hk_odd : Odd k := Nat.not_even_iff_odd.mp hk_even
    rcases hk_odd with ⟨n, hn⟩
    have hindex_q : infiniteGenreCdfIndex a C2 q = 2 * n + 1 := by
      simpa [k] using hn
    have hindex_qC2 : infiniteGenreCdfIndex a C2 (q * C2) =
        2 * n + 2 := by
      calc
        infiniteGenreCdfIndex a C2 (q * C2) = k + 1 := hk_shift
        _ = 2 * n + 2 := by omega
    have hq_power :
        infiniteGenreCandidateCdf a C1 C2 beta q =
          infiniteGenreCdfPowerPiece C1 C2 beta n q := by
      rw [infiniteGenreCandidateCdf_eq_power_of_index_odd
        hq hqa ⟨n, hindex_q⟩, hindex_q]
      have hhalf : (2 * n + 1) / 2 = n := by omega
      rw [hhalf]
    have hqC2_plateau :
        infiniteGenreCandidateCdf a C1 C2 beta (q * C2) =
          infiniteGenreCdfPlateauPiece C2 beta n := by
      rw [infiniteGenreCandidateCdf_eq_even_shell hqC2_pos hqC2_lt_a
        ⟨n + 1, by omega⟩, hindex_qC2]
      unfold infiniteGenreCdfPlateauPiece
      congr 1
      push_cast
      ring
    rw [hq_power, hqC2_plateau]
    exact infiniteGenreCdf_power_plateau_product hC1 hC2 hq.le

/--
The functional equation also holds across the corrected upper transition:
`q` is already in the saturated branch, while `q C₂` is the first power
branch.  This is the omitted non-geometric case in the printed calculation.
-/
theorem infiniteGenreCandidateCdf_product_of_upper_transition
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC1 : 0 < C1) (hC2 : 0 < C2) (hC2_one : C2 < 1)
    (haq : a ≤ q) (hqC2_lt_a : q * C2 < a) :
    infiniteGenreCandidateCdf a C1 C2 beta q *
        infiniteGenreCandidateCdf a C1 C2 beta (q * C2) =
      (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
        q ^ (2 * beta) := by
  have hq_pos : 0 < q := ha.trans_le haq
  have hqC2_pos : 0 < q * C2 := mul_pos hq_pos hC2
  have hfirst : a * C2 ≤ q * C2 :=
    mul_le_mul_of_nonneg_right haq hC2.le
  have hindex : infiniteGenreCdfIndex a C2 (q * C2) = 1 :=
    infiniteGenreCdfIndex_eq_one_of_first_shell hqC2_lt_a hfirst
  have hq_one : infiniteGenreCandidateCdf a C1 C2 beta q = 1 :=
    infiniteGenreCandidateCdf_eq_one_of_le hq_pos haq
  have hqC2_power :
      infiniteGenreCandidateCdf a C1 C2 beta (q * C2) =
        C1 ^ (-2 : ℝ) * (q * C2) ^ (2 * beta) := by
    calc
      infiniteGenreCandidateCdf a C1 C2 beta (q * C2) =
          infiniteGenreCdfPowerPiece C1 C2 beta
            ((infiniteGenreCdfIndex a C2 (q * C2)) / 2) (q * C2) :=
        infiniteGenreCandidateCdf_eq_power_of_index_odd
          hqC2_pos hqC2_lt_a (by rw [hindex]; exact ⟨0, rfl⟩)
      _ = infiniteGenreCdfPowerPiece C1 C2 beta 0 (q * C2) := by simp [hindex]
      _ = C1 ^ (-2 : ℝ) * (q * C2) ^ (2 * beta) := by
        simp [infiniteGenreCdfPowerPiece]
  rw [hq_one, hqC2_power]
  unfold infiniteGenreCdfFunctionalScale
  rw [Real.mul_rpow hq_pos.le hC2.le]
  rw [Real.mul_rpow hC1.le (Real.rpow_nonneg hC2.le _)]
  have hC2pow : C2 ^ (2 * beta) = (C2 ^ (-beta)) ^ (-2 : ℝ) := by
    rw [← Real.rpow_mul hC2.le]
    congr 1 <;> ring
  rw [hC2pow]
  ring

/--
Under the displayed cutoff calibration `C₁ = a^β`, the coefficient in the
candidate-CDF product is exactly the positive power of the normalized score
`q C₂ / a`.  This is the bridge between the local branch calculation and its
capped form.
-/
theorem infiniteGenreCdfFunctionalCoefficient_eq_cutoffRatio_rpow
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hq : 0 ≤ q)
    (hC1 : C1 = a ^ beta) :
    (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
        q ^ (2 * beta) =
      (q * C2 / a) ^ (2 * beta) := by
  have ha_coeff : (a ^ beta) ^ (-2 : ℝ) = (a ^ (2 * beta))⁻¹ := by
    calc
      (a ^ beta) ^ (-2 : ℝ) = a ^ (beta * (-2 : ℝ)) :=
        (Real.rpow_mul ha.le beta (-2 : ℝ)).symm
      _ = a ^ (-(2 * beta)) := by congr 1 <;> ring
      _ = (a ^ (2 * beta))⁻¹ := Real.rpow_neg ha.le (2 * beta)
  have hC2_coeff : (C2 ^ (-beta)) ^ (-2 : ℝ) = C2 ^ (2 * beta) := by
    calc
      (C2 ^ (-beta)) ^ (-2 : ℝ) = C2 ^ ((-beta) * (-2 : ℝ)) :=
        (Real.rpow_mul hC2.le (-beta) (-2 : ℝ)).symm
      _ = C2 ^ (2 * beta) := by congr 1 <;> ring
  unfold infiniteGenreCdfFunctionalScale
  rw [hC1]
  rw [Real.mul_rpow (Real.rpow_nonneg ha.le _) (Real.rpow_nonneg hC2.le _)]
  rw [ha_coeff, hC2_coeff]
  calc
    (a ^ (2 * beta))⁻¹ * C2 ^ (2 * beta) * q ^ (2 * beta) =
        (q ^ (2 * beta) * C2 ^ (2 * beta)) / a ^ (2 * beta) := by
      rw [div_eq_mul_inv]
      ring
    _ = (q * C2) ^ (2 * beta) / a ^ (2 * beta) := by
      rw [Real.mul_rpow hq hC2.le]
    _ = (q * C2 / a) ^ (2 * beta) :=
      (Real.div_rpow (mul_nonneg hq hC2.le) ha.le (2 * beta)).symm

/-- Below the normalized cutoff, the calibrated product coefficient is capped. -/
theorem infiniteGenreCdfFunctionalCoefficient_le_one_of_mul_le_cutoff
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hbeta : 0 < beta) (hq : 0 ≤ q)
    (hqa : q * C2 ≤ a) (hC1 : C1 = a ^ beta) :
    (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
        q ^ (2 * beta) ≤ 1 := by
  rw [infiniteGenreCdfFunctionalCoefficient_eq_cutoffRatio_rpow ha hC2 hq hC1]
  have hratio_nonneg : 0 ≤ q * C2 / a := div_nonneg (mul_nonneg hq hC2.le) ha.le
  have hratio_le_one : q * C2 / a ≤ 1 := (div_le_one₀ ha).mpr hqa
  calc
    (q * C2 / a) ^ (2 * beta) ≤ 1 ^ (2 * beta) :=
      Real.rpow_le_rpow hratio_nonneg hratio_le_one (by nlinarith)
    _ = 1 := Real.one_rpow _

/-- Above the normalized cutoff, the calibrated product coefficient is saturated. -/
theorem one_le_infiniteGenreCdfFunctionalCoefficient_of_cutoff_le_mul
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hbeta : 0 < beta) (hq : 0 ≤ q)
    (haq : a ≤ q * C2) (hC1 : C1 = a ^ beta) :
    1 ≤ (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
        q ^ (2 * beta) := by
  rw [infiniteGenreCdfFunctionalCoefficient_eq_cutoffRatio_rpow ha hC2 hq hC1]
  have hratio_one_le : 1 ≤ q * C2 / a :=
    (le_div_iff₀ ha).mpr (by simpa using haq)
  calc
    1 = 1 ^ (2 * beta) := (Real.one_rpow _).symm
    _ ≤ (q * C2 / a) ^ (2 * beta) :=
      Real.rpow_le_rpow zero_le_one hratio_one_le (by nlinarith)

/--
The repaired, total candidate satisfies the capped functional equation used
for the two score laws in the source proof.  Its three cases are: geometric
interior, the saturated/power upper transition, and the saturated upper tail.
-/
theorem infiniteGenreCandidateCdf_product_eq_min_functional_coefficient
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hq : 0 ≤ q) :
    infiniteGenreCandidateCdf a C1 C2 beta q *
        infiniteGenreCandidateCdf a C1 C2 beta (q * C2) =
      min 1 ((infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
        q ^ (2 * beta)) := by
  have hC1_pos : 0 < C1 := by
    rw [hC1]
    exact Real.rpow_pos_of_pos ha _
  rcases hq.eq_or_lt with rfl | hq_pos
  · have htwobeta : 0 < 2 * beta := by nlinarith
    simp [infiniteGenreCandidateCdf, Real.zero_rpow (ne_of_gt htwobeta)]
  by_cases hqa : q < a
  · have hqC2_lt_q : q * C2 < q := by
      nlinarith [mul_pos hq_pos (sub_pos.mpr hC2_one)]
    have hqC2_lt_a : q * C2 < a := hqC2_lt_q.trans hqa
    have hcoeff :
        (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
            q ^ (2 * beta) ≤ 1 :=
      infiniteGenreCdfFunctionalCoefficient_le_one_of_mul_le_cutoff
        ha hC2 hbeta hq_pos.le hqC2_lt_a.le hC1
    rw [min_eq_right hcoeff]
    exact infiniteGenreCandidateCdf_product_of_lt_cutoff
      ha hC1_pos hC2 hC2_one hq_pos hqa
  · have haq : a ≤ q := le_of_not_gt hqa
    by_cases htail : a ≤ q * C2
    · have hqC2_pos : 0 < q * C2 := ha.trans_le htail
      have hq_one : infiniteGenreCandidateCdf a C1 C2 beta q = 1 :=
        infiniteGenreCandidateCdf_eq_one_of_le hq_pos haq
      have hqC2_one : infiniteGenreCandidateCdf a C1 C2 beta (q * C2) = 1 :=
        infiniteGenreCandidateCdf_eq_one_of_le hqC2_pos htail
      have hcoeff :
          1 ≤ (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
            q ^ (2 * beta) :=
        one_le_infiniteGenreCdfFunctionalCoefficient_of_cutoff_le_mul
          ha hC2 hbeta hq_pos.le htail hC1
      rw [hq_one, hqC2_one, min_eq_left hcoeff]
      norm_num
    · have hqC2_lt_a : q * C2 < a := lt_of_not_ge htail
      have hcoeff :
          (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
              q ^ (2 * beta) ≤ 1 :=
        infiniteGenreCdfFunctionalCoefficient_le_one_of_mul_le_cutoff
          ha hC2 hbeta hq_pos.le hqC2_lt_a.le hC1
      rw [min_eq_right hcoeff]
      exact infiniteGenreCandidateCdf_product_of_upper_transition
        ha hC1_pos hC2 hC2_one haq hqC2_lt_a

/--
Taking the nonnegative square root of the calibrated product identity gives
the capped reward formula used in the source's `H_1`/`H_2` calculation.
-/
theorem sqrt_infiniteGenreCandidateCdf_product_eq_min_reward
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hq : 0 ≤ q) :
    Real.sqrt
        (infiniteGenreCandidateCdf a C1 C2 beta q *
          infiniteGenreCandidateCdf a C1 C2 beta (q * C2)) =
      min 1 ((infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ * q ^ beta) := by
  have hC1_pos : 0 < C1 := by
    rw [hC1]
    exact Real.rpow_pos_of_pos ha _
  have hscale_pos : 0 < infiniteGenreCdfFunctionalScale C1 C2 beta := by
    unfold infiniteGenreCdfFunctionalScale
    exact mul_pos hC1_pos (Real.rpow_pos_of_pos hC2 _)
  let t : ℝ := (infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ * q ^ beta
  have ht : 0 ≤ t := by
    dsimp [t]
    exact mul_nonneg (inv_nonneg.mpr hscale_pos.le) (Real.rpow_nonneg hq _)
  have hscale_square :
      (infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ ^ 2 =
        (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) := by
    rw [Real.rpow_neg hscale_pos.le, Real.rpow_two]
    simp
  have hq_square : (q ^ beta) ^ 2 = q ^ (2 * beta) := by
    calc
      (q ^ beta) ^ 2 = (q ^ beta) ^ (2 : ℝ) := (Real.rpow_two _).symm
      _ = q ^ (beta * (2 : ℝ)) := (Real.rpow_mul hq beta (2 : ℝ)).symm
      _ = q ^ (2 * beta) := by congr 1 <;> ring
  have htsquare : t ^ 2 =
      (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
        q ^ (2 * beta) := by
    dsimp [t]
    calc
      ((infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ * q ^ beta) ^ 2 =
          (infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ ^ 2 *
            (q ^ beta) ^ 2 := by ring
      _ = (infiniteGenreCdfFunctionalScale C1 C2 beta) ^ (-2 : ℝ) *
            q ^ (2 * beta) := by rw [hscale_square, hq_square]
  change Real.sqrt
      (infiniteGenreCandidateCdf a C1 C2 beta q *
        infiniteGenreCandidateCdf a C1 C2 beta (q * C2)) = min 1 t
  rw [infiniteGenreCandidateCdf_product_eq_min_functional_coefficient
    ha hC2 hC2_one hbeta hC1 hq, ← htsquare]
  by_cases ht_one : t ≤ 1
  · have htsquare_le : t ^ 2 ≤ 1 := by
      nlinarith [mul_nonneg ht (sub_nonneg.mpr ht_one)]
    rw [min_eq_right htsquare_le, min_eq_right ht_one,
      Real.sqrt_sq_eq_abs, abs_of_nonneg ht]
  · have ht_one : 1 ≤ t := le_of_not_ge ht_one
    have hone_add_t : 0 ≤ 1 + t := by linarith
    have hone_le_tsquare : 1 ≤ t ^ 2 := by
      nlinarith [mul_nonneg (sub_nonneg.mpr ht_one) hone_add_t]
    rw [min_eq_left hone_le_tsquare, min_eq_left ht_one]
    norm_num

/--
The power and plateau formulas agree at their common upper endpoint.  This is
the first endpoint-gluing fact needed to show that the repaired candidate is
a CDF rather than only a shellwise formula.
-/
theorem infiniteGenreCdf_powerPiece_eq_plateauPiece_at_upper_endpoint
    {a C1 C2 beta : ℝ} {n : ℕ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC1 : C1 = a ^ beta) :
    infiniteGenreCdfPowerPiece C1 C2 beta n
        (a * C2 ^ (2 * (n : ℝ) + 1)) =
      infiniteGenreCdfPlateauPiece C2 beta n := by
  have ha_cancel : a ^ (beta * (-2 : ℝ)) * a ^ (2 * beta) = 1 := by
    rw [← Real.rpow_add ha]
    convert Real.rpow_zero a using 1 <;> ring
  have hC2_combine :
      C2 ^ (-2 * (n : ℝ) * beta) *
          C2 ^ ((2 * (n : ℝ) + 1) * (2 * beta)) =
        C2 ^ ((2 * (n : ℝ) + 2) * beta) := by
    rw [← Real.rpow_add hC2]
    congr 1
    ring
  unfold infiniteGenreCdfPowerPiece infiniteGenreCdfPlateauPiece
  rw [hC1]
  rw [← Real.rpow_mul ha.le beta (-2 : ℝ)]
  rw [Real.mul_rpow ha.le (Real.rpow_nonneg hC2.le _)]
  rw [← Real.rpow_mul hC2.le (2 * (n : ℝ) + 1) (2 * beta)]
  calc
    a ^ (beta * (-2 : ℝ)) * C2 ^ (-2 * (n : ℝ) * beta) *
        (a ^ (2 * beta) * C2 ^ ((2 * (n : ℝ) + 1) * (2 * beta))) =
        (a ^ (beta * (-2 : ℝ)) * a ^ (2 * beta)) *
          (C2 ^ (-2 * (n : ℝ) * beta) *
            C2 ^ ((2 * (n : ℝ) + 1) * (2 * beta))) := by ring
    _ = 1 * C2 ^ ((2 * (n : ℝ) + 2) * beta) := by
      rw [ha_cancel, hC2_combine]
    _ = C2 ^ ((2 * (n : ℝ) + 2) * beta) := by ring

/--
The same two formulas agree at the lower endpoint of a plateau, where the
next power piece begins.
-/
theorem infiniteGenreCdf_powerPiece_succ_eq_plateauPiece_at_lower_endpoint
    {a C1 C2 beta : ℝ} {n : ℕ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC1 : C1 = a ^ beta) :
    infiniteGenreCdfPowerPiece C1 C2 beta (n + 1)
        (a * C2 ^ (2 * (n : ℝ) + 2)) =
      infiniteGenreCdfPlateauPiece C2 beta n := by
  have ha_cancel : a ^ (beta * (-2 : ℝ)) * a ^ (2 * beta) = 1 := by
    rw [← Real.rpow_add ha]
    convert Real.rpow_zero a using 1 <;> ring
  have hC2_combine :
      C2 ^ (-2 * ((n + 1 : ℕ) : ℝ) * beta) *
          C2 ^ ((2 * (n : ℝ) + 2) * (2 * beta)) =
        C2 ^ ((2 * (n : ℝ) + 2) * beta) := by
    rw [← Real.rpow_add hC2]
    congr 1
    push_cast
    ring
  unfold infiniteGenreCdfPowerPiece infiniteGenreCdfPlateauPiece
  rw [hC1]
  rw [← Real.rpow_mul ha.le beta (-2 : ℝ)]
  rw [Real.mul_rpow ha.le (Real.rpow_nonneg hC2.le _)]
  rw [← Real.rpow_mul hC2.le (2 * (n : ℝ) + 2) (2 * beta)]
  calc
    a ^ (beta * (-2 : ℝ)) * C2 ^ (-2 * ((n + 1 : ℕ) : ℝ) * beta) *
        (a ^ (2 * beta) * C2 ^ ((2 * (n : ℝ) + 2) * (2 * beta))) =
        (a ^ (beta * (-2 : ℝ)) * a ^ (2 * beta)) *
          (C2 ^ (-2 * ((n + 1 : ℕ) : ℝ) * beta) *
            C2 ^ ((2 * (n : ℝ) + 2) * (2 * beta))) := by ring
    _ = 1 * C2 ^ ((2 * (n : ℝ) + 2) * beta) := by
      rw [ha_cancel, hC2_combine]
    _ = C2 ^ ((2 * (n : ℝ) + 2) * beta) := by ring

/--
At the upper endpoint of a power shell, its value is the preceding even-shell
value.  For the zeroth power shell this is the saturated value one.
-/
theorem infiniteGenreCdf_powerPiece_eq_even_value_at_upper_endpoint
    {a C1 C2 beta : ℝ} {n : ℕ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC1 : C1 = a ^ beta) :
    infiniteGenreCdfPowerPiece C1 C2 beta n
        (a * C2 ^ (2 * (n : ℝ))) =
      C2 ^ (2 * (n : ℝ) * beta) := by
  have ha_cancel : a ^ (beta * (-2 : ℝ)) * a ^ (2 * beta) = 1 := by
    rw [← Real.rpow_add ha]
    convert Real.rpow_zero a using 1 <;> ring
  have hC2_combine :
      C2 ^ (-2 * (n : ℝ) * beta) *
          C2 ^ ((2 * (n : ℝ)) * (2 * beta)) =
        C2 ^ (2 * (n : ℝ) * beta) := by
    rw [← Real.rpow_add hC2]
    congr 1
    ring
  unfold infiniteGenreCdfPowerPiece
  rw [hC1]
  rw [← Real.rpow_mul ha.le beta (-2 : ℝ)]
  rw [Real.mul_rpow ha.le (Real.rpow_nonneg hC2.le _)]
  rw [← Real.rpow_mul hC2.le (2 * (n : ℝ)) (2 * beta)]
  calc
    a ^ (beta * (-2 : ℝ)) * C2 ^ (-2 * (n : ℝ) * beta) *
        (a ^ (2 * beta) * C2 ^ ((2 * (n : ℝ)) * (2 * beta))) =
        (a ^ (beta * (-2 : ℝ)) * a ^ (2 * beta)) *
          (C2 ^ (-2 * (n : ℝ) * beta) *
            C2 ^ ((2 * (n : ℝ)) * (2 * beta))) := by ring
    _ = 1 * C2 ^ (2 * (n : ℝ) * beta) := by
      rw [ha_cancel, hC2_combine]
    _ = C2 ^ (2 * (n : ℝ) * beta) := by ring

/--
At an odd geometric endpoint, the total repaired candidate chooses the power
piece, whose glued value is the adjacent plateau value.
-/
theorem infiniteGenreCandidateCdf_eq_plateauPiece_at_odd_endpoint
    {a C1 C2 beta : ℝ} {n : ℕ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1)
    (hC1 : C1 = a ^ beta) :
    infiniteGenreCandidateCdf a C1 C2 beta
        (a * C2 ^ (2 * n + 1)) =
      infiniteGenreCdfPlateauPiece C2 beta n := by
  have hq_pos : 0 < a * C2 ^ (2 * n + 1) :=
    mul_pos ha (pow_pos hC2 _)
  have hexp_pos : 0 < 2 * n + 1 := by omega
  have hpow_lt_one : C2 ^ (2 * n + 1) < 1 :=
    pow_lt_one₀ hC2.le hC2_one (ne_of_gt hexp_pos)
  have hq_lt : a * C2 ^ (2 * n + 1) < a := by
    calc
      a * C2 ^ (2 * n + 1) < a * 1 :=
        mul_lt_mul_of_pos_left hpow_lt_one ha
      _ = a := mul_one a
  have hindex :
      infiniteGenreCdfIndex a C2 (a * C2 ^ (2 * n + 1)) = 2 * n + 1 :=
    infiniteGenreCdfIndex_eq_geometric_endpoint ha hC2 hC2_one
  have hodd : Odd (infiniteGenreCdfIndex a C2 (a * C2 ^ (2 * n + 1))) := by
    rw [hindex]
    exact ⟨n, by omega⟩
  have hhalf : (2 * n + 1) / 2 = n := by omega
  calc
    infiniteGenreCandidateCdf a C1 C2 beta (a * C2 ^ (2 * n + 1)) =
        infiniteGenreCdfPowerPiece C1 C2 beta
          ((infiniteGenreCdfIndex a C2 (a * C2 ^ (2 * n + 1))) / 2)
          (a * C2 ^ (2 * n + 1)) :=
      infiniteGenreCandidateCdf_eq_power_of_index_odd hq_pos hq_lt hodd
    _ = infiniteGenreCdfPowerPiece C1 C2 beta n
          (a * C2 ^ (2 * n + 1)) := by rw [hindex, hhalf]
    _ = infiniteGenreCdfPlateauPiece C2 beta n :=
      by
        have hpow_cast :
            C2 ^ (2 * n + 1) = C2 ^ (2 * (n : ℝ) + 1) := by
          rw [← Real.rpow_natCast]
          push_cast
          rfl
        rw [hpow_cast]
        exact infiniteGenreCdf_powerPiece_eq_plateauPiece_at_upper_endpoint
          (n := n) ha hC2 hC1

/--
At an even geometric endpoint, the total repaired candidate has the stated
even-shell value; the zeroth endpoint is the saturated upper cutoff.
-/
theorem infiniteGenreCandidateCdf_eq_even_value_at_even_endpoint
    {a C1 C2 beta : ℝ} {n : ℕ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) :
    infiniteGenreCandidateCdf a C1 C2 beta
        (a * C2 ^ (2 * n)) =
      C2 ^ (((2 * n : ℕ) : ℝ) * beta) := by
  by_cases hn : n = 0
  · subst n
    unfold infiniteGenreCandidateCdf
    simp [not_le_of_gt ha]
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
    have hexp_pos : 0 < 2 * (m + 1) := by omega
    have hq_pos : 0 < a * C2 ^ (2 * (m + 1)) :=
      mul_pos ha (pow_pos hC2 _)
    have hpow_lt_one : C2 ^ (2 * (m + 1)) < 1 :=
      pow_lt_one₀ hC2.le hC2_one (ne_of_gt hexp_pos)
    have hq_lt : a * C2 ^ (2 * (m + 1)) < a := by
      calc
        a * C2 ^ (2 * (m + 1)) < a * 1 :=
          mul_lt_mul_of_pos_left hpow_lt_one ha
        _ = a := mul_one a
    have hindex :
        infiniteGenreCdfIndex a C2 (a * C2 ^ (2 * (m + 1))) =
          2 * (m + 1) :=
      infiniteGenreCdfIndex_eq_geometric_endpoint ha hC2 hC2_one
    have heven :
        Even (infiniteGenreCdfIndex a C2 (a * C2 ^ (2 * (m + 1)))) := by
      rw [hindex]
      exact ⟨m + 1, by omega⟩
    rw [infiniteGenreCandidateCdf_eq_even_shell hq_pos hq_lt heven, hindex]

/--
Moving from a point in a nontrivial shell to the preceding (larger) geometric
endpoint cannot decrease the repaired candidate.  The two parity cases use
the endpoint-gluing identities rather than an implicit assertion that the
alternating display is monotone.
-/
theorem infiniteGenreCandidateCdf_le_predecessor_endpoint
    {a C1 C2 beta q : ℝ} {k : ℕ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta)
    (hq : 0 < q) (hqa : q < a)
    (hindex : infiniteGenreCdfIndex a C2 q = k + 1) :
    infiniteGenreCandidateCdf a C1 C2 beta q ≤
      infiniteGenreCandidateCdf a C1 C2 beta (a * C2 ^ k) := by
  have hC1_pos : 0 < C1 := by
    rw [hC1]
    exact Real.rpow_pos_of_pos ha _
  have hq_exists : ∃ n : ℕ, a * C2 ^ n ≤ q :=
    exists_infiniteGenreCdfIndex ha hC2 hC2_one hq hqa
  have hindex_pos : 0 < infiniteGenreCdfIndex a C2 q := by
    rw [hindex]
    omega
  have hq_lt_endpoint : q < a * C2 ^ k := by
    simpa [hindex] using
      (lt_infiniteGenreCdfIndex_predecessor_endpoint hq_exists hindex_pos)
  by_cases heven : Even (k + 1)
  · rcases heven with ⟨m, hm⟩
    have hm_pos : 0 < m := by omega
    obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hm_pos)
    have hk : k = 2 * n + 1 := by omega
    have hindex_eq : infiniteGenreCdfIndex a C2 q = 2 * (n + 1) := by
      rw [hindex]
      omega
    have hindex_even : Even (infiniteGenreCdfIndex a C2 q) := by
      rw [hindex_eq]
      exact ⟨n + 1, by omega⟩
    have hq_plateau :
        infiniteGenreCandidateCdf a C1 C2 beta q =
          infiniteGenreCdfPlateauPiece C2 beta n := by
      calc
        infiniteGenreCandidateCdf a C1 C2 beta q =
            C2 ^ ((infiniteGenreCdfIndex a C2 q : ℝ) * beta) :=
          infiniteGenreCandidateCdf_eq_even_shell hq hqa hindex_even
        _ = C2 ^ ((2 * (n : ℝ) + 2) * beta) := by
          rw [hindex_eq]
          push_cast
          ring
        _ = infiniteGenreCdfPlateauPiece C2 beta n := rfl
    calc
      infiniteGenreCandidateCdf a C1 C2 beta q =
          infiniteGenreCdfPlateauPiece C2 beta n := hq_plateau
      _ = infiniteGenreCandidateCdf a C1 C2 beta
          (a * C2 ^ (2 * n + 1)) :=
        (infiniteGenreCandidateCdf_eq_plateauPiece_at_odd_endpoint
          ha hC2 hC2_one hC1).symm
      _ ≤ infiniteGenreCandidateCdf a C1 C2 beta (a * C2 ^ k) := by rw [hk]
  · have hodd : Odd (k + 1) := Nat.not_even_iff_odd.mp heven
    rcases hodd with ⟨n, hn⟩
    have hk : k = 2 * n := by omega
    have hindex_odd : Odd (infiniteGenreCdfIndex a C2 q) := by
      rw [hindex, hn]
      exact ⟨n, rfl⟩
    have hhalf : (infiniteGenreCdfIndex a C2 q) / 2 = n := by
      rw [hindex]
      omega
    have hq_power :
        infiniteGenreCandidateCdf a C1 C2 beta q =
          infiniteGenreCdfPowerPiece C1 C2 beta n q := by
      rw [infiniteGenreCandidateCdf_eq_power_of_index_odd hq hqa hindex_odd,
        hhalf]
    have hq_le_endpoint : q ≤ a * C2 ^ (2 * n) := by
      rw [← hk]
      exact hq_lt_endpoint.le
    have hpow_cast : C2 ^ (2 * n) = C2 ^ (2 * (n : ℝ)) := by
      rw [← Real.rpow_natCast]
      push_cast
      rfl
    calc
      infiniteGenreCandidateCdf a C1 C2 beta q =
          infiniteGenreCdfPowerPiece C1 C2 beta n q := hq_power
      _ ≤ infiniteGenreCdfPowerPiece C1 C2 beta n (a * C2 ^ (2 * n)) :=
        infiniteGenreCdfPowerPiece_mono hC1_pos.le hC2.le hbeta.le hq.le
          hq_le_endpoint
      _ = C2 ^ (((2 * n : ℕ) : ℝ) * beta) := by
        rw [hpow_cast]
        simpa only [Nat.cast_mul, Nat.cast_ofNat] using
          (infiniteGenreCdf_powerPiece_eq_even_value_at_upper_endpoint
            (n := n) ha hC2 hC1)
      _ = infiniteGenreCandidateCdf a C1 C2 beta (a * C2 ^ (2 * n)) :=
        (infiniteGenreCandidateCdf_eq_even_value_at_even_endpoint
          (n := n) ha hC2 hC2_one).symm
      _ = infiniteGenreCandidateCdf a C1 C2 beta (a * C2 ^ k) := by rw [hk]

/--
The repaired candidate is monotone throughout its positive unsaturated
interior.  The proof reduces a cross-shell comparison to one boundary step
and then uses strong induction on the finite shell-index difference.
-/
theorem infiniteGenreCandidateCdf_mono_interior
    {a C1 C2 beta q r : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta)
    (hq : 0 < q) (hqa : q < a) (hr : 0 < r) (hra : r < a) (hqr : q ≤ r) :
    infiniteGenreCandidateCdf a C1 C2 beta q ≤
      infiniteGenreCandidateCdf a C1 C2 beta r := by
  let P : ℕ → Prop := fun k =>
    ∀ q r : ℝ, 0 < q → q < a → 0 < r → r < a → q ≤ r →
      infiniteGenreCdfIndex a C2 q = k →
      infiniteGenreCandidateCdf a C1 C2 beta q ≤
        infiniteGenreCandidateCdf a C1 C2 beta r
  have hP : ∀ k, P k := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
        dsimp [P]
        intro q r hq hqa hr hra hqr hqindex
        have hq_exists : ∃ n : ℕ, a * C2 ^ n ≤ q :=
          exists_infiniteGenreCdfIndex ha hC2 hC2_one hq hqa
        have hr_exists : ∃ n : ℕ, a * C2 ^ n ≤ r :=
          exists_infiniteGenreCdfIndex ha hC2 hC2_one hr hra
        have hr_index_le : infiniteGenreCdfIndex a C2 r ≤ k := by
          rw [← hqindex]
          exact infiniteGenreCdfIndex_antitone hq_exists hqr
        by_cases hsame : infiniteGenreCdfIndex a C2 r = k
        · apply infiniteGenreCandidateCdf_mono_of_index_eq
            (by rw [hC1]; exact Real.rpow_pos_of_pos ha _)
            hC2 hbeta hq hqa hr hra hqr
          exact hqindex.trans hsame.symm
        · have hr_index_lt : infiniteGenreCdfIndex a C2 r < k :=
            lt_of_le_of_ne hr_index_le hsame
          have hq_index_pos : 0 < infiniteGenreCdfIndex a C2 q :=
            infiniteGenreCdfIndex_pos_of_lt hq_exists hqa
          have hr_index_pos : 0 < infiniteGenreCdfIndex a C2 r :=
            infiniteGenreCdfIndex_pos_of_lt hr_exists hra
          have hk_pos : 0 < k := by simpa [hqindex] using hq_index_pos
          have hk_one_lt : 1 < k := by omega
          have hq_step_index :
              infiniteGenreCdfIndex a C2 q = (k - 1) + 1 := by
            rw [hqindex]
            omega
          have hq_step :
              infiniteGenreCandidateCdf a C1 C2 beta q ≤
                infiniteGenreCandidateCdf a C1 C2 beta
                  (a * C2 ^ (k - 1)) :=
            infiniteGenreCandidateCdf_le_predecessor_endpoint
              ha hC2 hC2_one hbeta hC1 hq hqa hq_step_index
          have hk_pred_pos : 0 < k - 1 := by omega
          have ht_pos : 0 < a * C2 ^ (k - 1) :=
            mul_pos ha (pow_pos hC2 _)
          have hpow_lt_one : C2 ^ (k - 1) < 1 :=
            pow_lt_one₀ hC2.le hC2_one (ne_of_gt hk_pred_pos)
          have ht_lt : a * C2 ^ (k - 1) < a := by
            calc
              a * C2 ^ (k - 1) < a * 1 :=
                mul_lt_mul_of_pos_left hpow_lt_one ha
              _ = a := mul_one a
          have ht_index :
              infiniteGenreCdfIndex a C2 (a * C2 ^ (k - 1)) = k - 1 :=
            infiniteGenreCdfIndex_eq_geometric_endpoint ha hC2 hC2_one
          have hr_index_le_pred : infiniteGenreCdfIndex a C2 r ≤ k - 1 := by
            omega
          have hpow_le : C2 ^ (k - 1) ≤ C2 ^ (infiniteGenreCdfIndex a C2 r) :=
            pow_le_pow_of_le_one hC2.le hC2_one.le hr_index_le_pred
          have ht_le_shell :
              a * C2 ^ (k - 1) ≤ a * C2 ^ (infiniteGenreCdfIndex a C2 r) :=
            mul_le_mul_of_nonneg_left hpow_le ha.le
          have ht_le_r : a * C2 ^ (k - 1) ≤ r :=
            ht_le_shell.trans (infiniteGenreCdfIndex_spec hr_exists)
          have hrec := ih (k - 1) (by omega)
            (a * C2 ^ (k - 1)) r ht_pos ht_lt hr hra ht_le_r ht_index
          exact hq_step.trans hrec
  exact hP (infiniteGenreCdfIndex a C2 q) q r hq hqa hr hra hqr rfl

/-- The repaired candidate is nonnegative under its positive-base regime. -/
theorem infiniteGenreCandidateCdf_nonneg
    {a C1 C2 beta q : ℝ} (hC1 : 0 ≤ C1) (hC2 : 0 ≤ C2) :
    0 ≤ infiniteGenreCandidateCdf a C1 C2 beta q := by
  by_cases hq : q ≤ 0
  · simp [infiniteGenreCandidateCdf, hq]
  have hq_pos : 0 < q := lt_of_not_ge hq
  rw [infiniteGenreCandidateCdf, if_neg hq]
  by_cases haq : a ≤ q
  · simp [haq]
  rw [if_neg haq]
  dsimp
  by_cases heven : Even (infiniteGenreCdfIndex a C2 q)
  · rw [if_pos heven]
    exact Real.rpow_nonneg hC2 _
  · rw [if_neg heven]
    exact mul_nonneg
      (mul_nonneg (Real.rpow_nonneg hC1 _) (Real.rpow_nonneg hC2 _))
      (Real.rpow_nonneg hq_pos.le _)

/-- The repaired candidate never exceeds its saturated value one. -/
theorem infiniteGenreCandidateCdf_le_one
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) :
    infiniteGenreCandidateCdf a C1 C2 beta q ≤ 1 := by
  by_cases hq_nonpos : q ≤ 0
  · simp [infiniteGenreCandidateCdf, hq_nonpos]
  have hq : 0 < q := lt_of_not_ge hq_nonpos
  by_cases haq : a ≤ q
  · rw [infiniteGenreCandidateCdf_eq_one_of_le hq haq]
  have hqa : q < a := lt_of_not_ge haq
  have hq_exists : ∃ n : ℕ, a * C2 ^ n ≤ q :=
    exists_infiniteGenreCdfIndex ha hC2 hC2_one hq hqa
  by_cases heven : Even (infiniteGenreCdfIndex a C2 q)
  · rw [infiniteGenreCandidateCdf_eq_even_shell hq hqa heven]
    exact Real.rpow_le_one hC2.le hC2_one.le (by positivity)
  · have hodd : Odd (infiniteGenreCdfIndex a C2 q) :=
      Nat.not_even_iff_odd.mp heven
    rcases hodd with ⟨n, hn⟩
    have hindex : infiniteGenreCdfIndex a C2 q = 2 * n + 1 := by
      simpa using hn
    have hindex_pos : 0 < infiniteGenreCdfIndex a C2 q := by
      rw [hindex]
      omega
    have hq_le_upper : q ≤ a * C2 ^ (2 * n) := by
      have hlt := lt_infiniteGenreCdfIndex_predecessor_endpoint
        hq_exists hindex_pos
      rw [hindex] at hlt
      simpa using hlt.le
    have hhalf : (infiniteGenreCdfIndex a C2 q) / 2 = n := by
      rw [hindex]
      omega
    have hpow_cast : C2 ^ (2 * n) = C2 ^ (2 * (n : ℝ)) := by
      rw [← Real.rpow_natCast]
      push_cast
      rfl
    calc
      infiniteGenreCandidateCdf a C1 C2 beta q =
          infiniteGenreCdfPowerPiece C1 C2 beta n q := by
        rw [infiniteGenreCandidateCdf_eq_power_of_index_odd hq hqa
          (by rw [hindex]; exact ⟨n, rfl⟩), hhalf]
      _ ≤ infiniteGenreCdfPowerPiece C1 C2 beta n (a * C2 ^ (2 * n)) :=
        infiniteGenreCdfPowerPiece_mono
          (by rw [hC1]; exact (Real.rpow_pos_of_pos ha _).le)
          hC2.le hbeta.le hq.le hq_le_upper
      _ = C2 ^ (2 * (n : ℝ) * beta) := by
        rw [hpow_cast]
        exact infiniteGenreCdf_powerPiece_eq_even_value_at_upper_endpoint
          (n := n) ha hC2 hC1
      _ ≤ 1 := Real.rpow_le_one hC2.le hC2_one.le (by positivity)

/-- The repaired candidate is globally monotone. -/
theorem infiniteGenreCandidateCdf_mono
    {a C1 C2 beta : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) :
    Monotone (infiniteGenreCandidateCdf a C1 C2 beta) := by
  intro q r hqr
  by_cases hq_nonpos : q ≤ 0
  · calc
      infiniteGenreCandidateCdf a C1 C2 beta q = 0 := by
        simp [infiniteGenreCandidateCdf, hq_nonpos]
      _ ≤ infiniteGenreCandidateCdf a C1 C2 beta r :=
        infiniteGenreCandidateCdf_nonneg
          (by rw [hC1]; exact (Real.rpow_pos_of_pos ha _).le) hC2.le
  have hq : 0 < q := lt_of_not_ge hq_nonpos
  by_cases hra_upper : a ≤ r
  · calc
      infiniteGenreCandidateCdf a C1 C2 beta q ≤ 1 :=
        infiniteGenreCandidateCdf_le_one ha hC2 hC2_one hbeta hC1
      _ = infiniteGenreCandidateCdf a C1 C2 beta r :=
        (infiniteGenreCandidateCdf_eq_one_of_le (ha.trans_le hra_upper)
          hra_upper).symm
  · have hra : r < a := lt_of_not_ge hra_upper
    have hqa : q < a := hqr.trans_lt hra
    exact infiniteGenreCandidateCdf_mono_interior
      ha hC2 hC2_one hbeta hC1 hq hqa (hq.trans_le hqr) hra hqr

/--
At every positive nonsaturated quality, the repaired candidate is continuous
from the right.  A right-neighborhood remains in the same least-index shell,
where the function is either constant or a continuous power piece.
-/
theorem infiniteGenreCandidateCdf_rightContinuousAt_of_pos_lt_cutoff
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta)
    (hq : 0 < q) (hqa : q < a) :
    ContinuousWithinAt (infiniteGenreCandidateCdf a C1 C2 beta) (Set.Ici q) q := by
  let k := infiniteGenreCdfIndex a C2 q
  have hq_exists : ∃ n : ℕ, a * C2 ^ n ≤ q :=
    exists_infiniteGenreCdfIndex ha hC2 hC2_one hq hqa
  have hk_pos : 0 < k := by
    simpa [k] using infiniteGenreCdfIndex_pos_of_lt hq_exists hqa
  have hq_lt_upper : q < a * C2 ^ (k - 1) := by
    simpa [k] using
      (lt_infiniteGenreCdfIndex_predecessor_endpoint hq_exists
        (by simpa [k] using hk_pos))
  have hupper_le_a : a * C2 ^ (k - 1) ≤ a := by
    calc
      a * C2 ^ (k - 1) ≤ a * 1 :=
        mul_le_mul_of_nonneg_left (pow_le_one₀ hC2.le hC2_one.le) ha.le
      _ = a := mul_one a
  have hupper_event : ∀ᶠ x in 𝓝[Set.Ici q] q, x < a * C2 ^ (k - 1) :=
    nhdsWithin_le_nhds (Iio_mem_nhds hq_lt_upper)
  by_cases heven : Even k
  · have hcont :
        ContinuousWithinAt (fun _ : ℝ => C2 ^ ((k : ℝ) * beta)) (Set.Ici q) q :=
      continuousAt_const.continuousWithinAt
    apply hcont.congr_of_eventuallyEq
    · filter_upwards [hupper_event, self_mem_nhdsWithin] with x hx_upper hx_ge
      have hx_pos : 0 < x := hq.trans_le hx_ge
      have hx_lt_a : x < a := hx_upper.trans_le hupper_le_a
      have hx_lower : a * C2 ^ k ≤ x := by
        calc
          a * C2 ^ k ≤ q := by
            simpa [k] using infiniteGenreCdfIndex_spec hq_exists
          _ ≤ x := hx_ge
      have hxindex : infiniteGenreCdfIndex a C2 x = k :=
        infiniteGenreCdfIndex_eq_of_ge_lower_lt_predecessor
          ha hC2 hC2_one hk_pos hx_lower hx_upper
      have hx_even : Even (infiniteGenreCdfIndex a C2 x) := by
        rw [hxindex]
        exact heven
      rw [infiniteGenreCandidateCdf_eq_even_shell hx_pos hx_lt_a hx_even, hxindex]
    · rw [infiniteGenreCandidateCdf_eq_even_shell hq hqa (by simpa [k] using heven)]
  · have hodd : Odd k := Nat.not_even_iff_odd.mp heven
    have hcont_at :
        ContinuousAt (infiniteGenreCdfPowerPiece C1 C2 beta (k / 2)) q := by
      unfold infiniteGenreCdfPowerPiece
      apply ContinuousAt.mul
      · fun_prop
      · exact Real.continuousAt_rpow_const q (2 * beta) (Or.inl (ne_of_gt hq))
    apply hcont_at.continuousWithinAt.congr_of_eventuallyEq
    · filter_upwards [hupper_event, self_mem_nhdsWithin] with x hx_upper hx_ge
      have hx_pos : 0 < x := hq.trans_le hx_ge
      have hx_lt_a : x < a := hx_upper.trans_le hupper_le_a
      have hx_lower : a * C2 ^ k ≤ x := by
        calc
          a * C2 ^ k ≤ q := by
            simpa [k] using infiniteGenreCdfIndex_spec hq_exists
          _ ≤ x := hx_ge
      have hxindex : infiniteGenreCdfIndex a C2 x = k :=
        infiniteGenreCdfIndex_eq_of_ge_lower_lt_predecessor
          ha hC2 hC2_one hk_pos hx_lower hx_upper
      have hx_odd : Odd (infiniteGenreCdfIndex a C2 x) := by
        rw [hxindex]
        exact hodd
      rw [infiniteGenreCandidateCdf_eq_power_of_index_odd hx_pos hx_lt_a hx_odd,
        hxindex]
    · rw [infiniteGenreCandidateCdf_eq_power_of_index_odd hq hqa
        (by simpa [k] using hodd)]

/--
The infinitely many geometric shells accumulate continuously at zero.  Their
even endpoint values form a geometric sequence tending to zero, and global
monotonicity bounds every sufficiently small nonnegative quality by one such
endpoint value.
-/
theorem infiniteGenreCandidateCdf_rightContinuousAt_zero
    {a C1 C2 beta : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) :
    ContinuousWithinAt (infiniteGenreCandidateCdf a C1 C2 beta) (Set.Ici 0) 0 := by
  let F := infiniteGenreCandidateCdf a C1 C2 beta
  have hF_zero : F 0 = 0 := by
    simp [F, infiniteGenreCandidateCdf]
  have hF_mono : Monotone F := by
    simpa [F] using infiniteGenreCandidateCdf_mono ha hC2 hC2_one hbeta hC1
  have hF_nonneg : ∀ x : ℝ, 0 ≤ F x := by
    intro x
    exact infiniteGenreCandidateCdf_nonneg
      (by rw [hC1]; exact (Real.rpow_pos_of_pos ha _).le) hC2.le
  have hbase_lt_one : C2 ^ (2 * beta) < 1 :=
    Real.rpow_lt_one hC2.le hC2_one (by nlinarith)
  have hgeom_tendsto :
      Filter.Tendsto (fun n : ℕ => C2 ^ (((2 * n : ℕ) : ℝ) * beta)) Filter.atTop (𝓝 0) := by
    have hpow_tendsto : Filter.Tendsto (fun n : ℕ => (C2 ^ (2 * beta)) ^ n)
        Filter.atTop (𝓝 0) :=
      tendsto_pow_atTop_nhds_zero_of_lt_one
        (Real.rpow_nonneg hC2.le _) hbase_lt_one
    refine hpow_tendsto.congr' ?_
    filter_upwards with n
    rw [← Real.rpow_natCast]
    rw [← Real.rpow_mul hC2.le]
    push_cast
    congr 1
    ring
  change Filter.Tendsto F (𝓝[Set.Ici 0] 0) (𝓝 (F 0))
  rw [hF_zero]
  refine tendsto_order.2 ⟨?_, ?_⟩
  · intro lower hlower
    filter_upwards with x
    exact lt_of_lt_of_le hlower (hF_nonneg x)
  · intro upper hupper
    have hendpoint_event : ∀ᶠ n : ℕ in Filter.atTop,
        C2 ^ (((2 * n : ℕ) : ℝ) * beta) < upper :=
      hgeom_tendsto.eventually (eventually_lt_nhds hupper)
    obtain ⟨n, hn⟩ := hendpoint_event.exists
    let delta : ℝ := a * C2 ^ (2 * n)
    have hdelta_pos : 0 < delta := by
      dsimp [delta]
      exact mul_pos ha (pow_pos hC2 _)
    have hdelta_event : ∀ᶠ x in 𝓝[Set.Ici 0] 0, x < delta :=
      nhdsWithin_le_nhds (Iio_mem_nhds hdelta_pos)
    filter_upwards [hdelta_event] with x hx_delta
    calc
      F x ≤ F delta := hF_mono hx_delta.le
      _ = C2 ^ (((2 * n : ℕ) : ℝ) * beta) := by
        dsimp [F, delta]
        exact infiniteGenreCandidateCdf_eq_even_value_at_even_endpoint
          (n := n) ha hC2 hC2_one
      _ < upper := hn

/-- Below zero the repaired candidate CDF is identically zero, hence right-continuous. -/
theorem infiniteGenreCandidateCdf_rightContinuousAt_of_lt_zero
    {a C1 C2 beta q : ℝ}
    (hq : q < 0) :
    ContinuousWithinAt (infiniteGenreCandidateCdf a C1 C2 beta) (Set.Ici q) q := by
  have hq_event : ∀ᶠ x in 𝓝[Set.Ici q] q, x < 0 :=
    nhdsWithin_le_nhds (Iio_mem_nhds hq)
  apply (continuousAt_const : ContinuousAt (fun _ : ℝ => (0 : ℝ)) q).continuousWithinAt.congr_of_eventuallyEq
  · filter_upwards [hq_event] with x hx
    simp [infiniteGenreCandidateCdf, hx.le]
  · simp [infiniteGenreCandidateCdf, hq.le]

/-- At and above the cutoff the repaired candidate CDF is identically one. -/
theorem infiniteGenreCandidateCdf_rightContinuousAt_of_cutoff_le
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (haq : a ≤ q) :
    ContinuousWithinAt (infiniteGenreCandidateCdf a C1 C2 beta) (Set.Ici q) q := by
  have hq_pos : 0 < q := ha.trans_le haq
  apply (continuousAt_const : ContinuousAt (fun _ : ℝ => (1 : ℝ)) q).continuousWithinAt.congr_of_eventuallyEq
  · filter_upwards [self_mem_nhdsWithin] with x hx
    have hax : a ≤ x := haq.trans hx
    have hx_pos : 0 < x := ha.trans_le hax
    simp [infiniteGenreCandidateCdf, not_le_of_gt hx_pos, hax]
  · simp [infiniteGenreCandidateCdf, not_le_of_gt hq_pos, haq]

/--
The repaired candidate is right-continuous everywhere: it is constant below
zero and above the cutoff, locally a power or plateau in every positive shell,
and has a separately verified geometric limit at zero.
-/
theorem infiniteGenreCandidateCdf_rightContinuous
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) :
    ContinuousWithinAt (infiniteGenreCandidateCdf a C1 C2 beta) (Set.Ici q) q := by
  rcases lt_trichotomy q 0 with hq | rfl | hq
  · exact infiniteGenreCandidateCdf_rightContinuousAt_of_lt_zero hq
  · exact infiniteGenreCandidateCdf_rightContinuousAt_zero ha hC2 hC2_one hbeta hC1
  · by_cases haq : a ≤ q
    · exact infiniteGenreCandidateCdf_rightContinuousAt_of_cutoff_le ha haq
    · exact infiniteGenreCandidateCdf_rightContinuousAt_of_pos_lt_cutoff
        ha hC2 hC2_one hbeta hC1 hq (lt_of_not_ge haq)

/-- The repaired candidate has zero mass in its lower tail. -/
theorem infiniteGenreCandidateCdf_tendsto_atBot
    (a C1 C2 beta : ℝ) :
    Filter.Tendsto (infiniteGenreCandidateCdf a C1 C2 beta) Filter.atBot (𝓝 0) := by
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [Filter.eventually_le_atBot (0 : ℝ)] with q hq
  simp [infiniteGenreCandidateCdf, hq]

/-- The repaired candidate has unit mass in its upper tail. -/
theorem infiniteGenreCandidateCdf_tendsto_atTop
    {a C1 C2 beta : ℝ} (ha : 0 < a) :
    Filter.Tendsto (infiniteGenreCandidateCdf a C1 C2 beta) Filter.atTop (𝓝 1) := by
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [Filter.eventually_ge_atTop a] with q hq
  have hq_pos : 0 < q := ha.trans_le hq
  simp [infiniteGenreCandidateCdf, not_le_of_gt hq_pos, hq]

/-- The Stieltjes function associated with the repaired infinite-genre candidate CDF. -/
noncomputable def infiniteGenreCandidateStieltjes
    (a C1 C2 beta : ℝ)
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) : StieltjesFunction ℝ where
  toFun := infiniteGenreCandidateCdf a C1 C2 beta
  mono' := infiniteGenreCandidateCdf_mono ha hC2 hC2_one hbeta hC1
  right_continuous' := fun q =>
    infiniteGenreCandidateCdf_rightContinuous (q := q) ha hC2 hC2_one hbeta hC1

/-- The probability law constructed from the repaired infinite-genre candidate CDF. -/
noncomputable def infiniteGenreCandidateMeasure
    (a C1 C2 beta : ℝ)
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) : Measure ℝ :=
  (infiniteGenreCandidateStieltjes a C1 C2 beta ha hC2 hC2_one hbeta hC1).measure

/-- The repaired candidate CDF therefore induces a probability measure. -/
theorem infiniteGenreCandidate_isProbabilityMeasure
    (a C1 C2 beta : ℝ)
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) :
    IsProbabilityMeasure
      (infiniteGenreCandidateMeasure a C1 C2 beta ha hC2 hC2_one hbeta hC1) := by
  exact (infiniteGenreCandidateStieltjes a C1 C2 beta ha hC2 hC2_one hbeta hC1).isProbabilityMeasure
    (infiniteGenreCandidateCdf_tendsto_atBot a C1 C2 beta)
    (infiniteGenreCandidateCdf_tendsto_atTop ha)

/-- The lower-interval CDF of the constructed measure is the repaired candidate itself. -/
theorem infiniteGenreCandidateMeasure_Iic
    (a C1 C2 beta q : ℝ)
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) :
    infiniteGenreCandidateMeasure a C1 C2 beta ha hC2 hC2_one hbeta hC1 (Set.Iic q) =
      ENNReal.ofReal (infiniteGenreCandidateCdf a C1 C2 beta q) := by
  change
    (infiniteGenreCandidateStieltjes a C1 C2 beta ha hC2 hC2_one hbeta hC1).measure
      (Set.Iic q) = ENNReal.ofReal (infiniteGenreCandidateCdf a C1 C2 beta q)
  simpa [infiniteGenreCandidateStieltjes] using
    (StieltjesFunction.measure_Iic
      (infiniteGenreCandidateStieltjes a C1 C2 beta ha hC2 hC2_one hbeta hC1)
      (infiniteGenreCandidateCdf_tendsto_atBot a C1 C2 beta) q)

/--
The scalar law used by the repaired construction is supported in its declared
nonnegative cutoff interval.  This ties the interval-wide support-ray payoff
calculation to the actual probability law, rather than to a surrogate range.
-/
theorem infiniteGenreCandidateMeasure_support_subset_cutoff
    (a C1 C2 beta : ℝ)
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) :
    (infiniteGenreCandidateMeasure a C1 C2 beta ha hC2 hC2_one hbeta hC1).support ⊆
      Set.Icc 0 a := by
  let μ := infiniteGenreCandidateMeasure a C1 C2 beta ha hC2 hC2_one hbeta hC1
  letI : IsProbabilityMeasure μ :=
    infiniteGenreCandidate_isProbabilityMeasure a C1 C2 beta ha hC2 hC2_one hbeta hC1
  have hmeasure_zero : μ (Set.Iic 0) = 0 := by
    rw [infiniteGenreCandidateMeasure_Iic a C1 C2 beta 0
      ha hC2 hC2_one hbeta hC1]
    simp [infiniteGenreCandidateCdf]
  have hmeasure_cutoff : μ (Set.Iic a) = 1 := by
    rw [infiniteGenreCandidateMeasure_Iic a C1 C2 beta a
      ha hC2 hC2_one hbeta hC1,
      infiniteGenreCandidateCdf_eq_one_of_le ha le_rfl]
    norm_num
  have hbelow : μ (Set.Iio 0) = 0 :=
    measure_mono_null Set.Iio_subset_Iic_self hmeasure_zero
  have habove : μ (Set.Iic a)ᶜ = 0 := by
    rw [measure_compl measurableSet_Iic (measure_ne_top μ (Set.Iic a)),
      measure_univ, hmeasure_cutoff]
    simp
  have hsubset : (Set.Icc 0 a)ᶜ ⊆ Set.Iio 0 ∪ (Set.Iic a)ᶜ := by
    intro x hx
    change ¬ (0 ≤ x ∧ x ≤ a) at hx
    change x < 0 ∨ ¬ x ≤ a
    by_cases hneg : x < 0
    · exact Or.inl hneg
    · exact Or.inr (fun hxa => hx ⟨le_of_not_gt hneg, hxa⟩)
  apply Measure.support_subset_of_isClosed isClosed_Icc
  apply mem_ae_iff.mpr
  exact measure_mono_null hsubset (measure_union_null hbelow habove)

/--
The square-root product of the two shifted conditional-quality CDF values.
This is the scalar reward which the source denotes by `H_i` after changing
from a user score to a quality coordinate.
-/
noncomputable def infiniteGenreCandidateReward
    (a C1 C2 beta q : ℝ) : ℝ :=
  Real.sqrt
    (infiniteGenreCandidateCdf a C1 C2 beta q *
      infiniteGenreCandidateCdf a C1 C2 beta (q * C2))

/-- The candidate reward is the capped power dictated by its functional equation. -/
theorem infiniteGenreCandidateReward_eq_min
    {a C1 C2 beta q : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hq : 0 ≤ q) :
    infiniteGenreCandidateReward a C1 C2 beta q =
      min 1 ((infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ * q ^ beta) := by
  unfold infiniteGenreCandidateReward
  exact sqrt_infiniteGenreCandidateCdf_product_eq_min_reward
    ha hC2 hC2_one hbeta hC1 hq

/--
The source's two-genre reward at a user score: the two CDF arguments divide
the score by the two positive genre-user inner products.
-/
noncomputable def infiniteGenreCandidateCrossReward
    (a C1 C2 beta A B z : ℝ) : ℝ :=
  Real.sqrt
    (infiniteGenreCandidateCdf a C1 C2 beta (z / B) *
      infiniteGenreCandidateCdf a C1 C2 beta (z / A))

/-- The capped-power coefficient induced by the smaller cross-genre score `B`. -/
noncomputable def infiniteGenreCandidateCrossCoefficient
    (C1 C2 beta B : ℝ) : ℝ :=
  (infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ * B ^ (-beta)

/--
The corrected CDF construction gives the source's intended `H_i` formula once
the ratio of the two positive genre-user inner products is `C₂ = B / A`.
-/
theorem infiniteGenreCandidateCrossReward_eq_min
    {a C1 C2 beta A B z : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hA : 0 < A) (hB : 0 < B)
    (hratio : C2 = B / A) (hz : 0 ≤ z) :
    infiniteGenreCandidateCrossReward a C1 C2 beta A B z =
      min 1 (infiniteGenreCandidateCrossCoefficient C1 C2 beta B * z ^ beta) := by
  have hshift : z / B * C2 = z / A := by
    rw [hratio]
    field_simp [hA.ne', hB.ne']
  calc
    infiniteGenreCandidateCrossReward a C1 C2 beta A B z =
        infiniteGenreCandidateReward a C1 C2 beta (z / B) := by
      unfold infiniteGenreCandidateCrossReward infiniteGenreCandidateReward
      rw [hshift]
    _ = min 1 ((infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ *
        (z / B) ^ beta) :=
      infiniteGenreCandidateReward_eq_min ha hC2 hC2_one hbeta hC1
        (div_nonneg hz hB.le)
    _ = min 1 (infiniteGenreCandidateCrossCoefficient C1 C2 beta B * z ^ beta) := by
      congr 1
      unfold infiniteGenreCandidateCrossCoefficient
      rw [Real.div_rpow hz hB.le, div_eq_mul_inv,
        Real.rpow_neg hB.le beta]
      ring

/--
The corrected cutoff balance and score ratio normalize the cross-reward
coefficient at the two support directions.  This is the algebraic equality
needed by the source's zero-profit computation; it is independent of the
unavailable printed trigonometric `C₁` display.
-/
theorem infiniteGenreCandidateCrossCoefficient_mul_scorePowers_eq_one
    {C1 C2 beta A B : ℝ}
    (hC1 : 0 < C1) (hC2 : 0 < C2) (hbeta : 0 < beta)
    (hA : 0 < A) (hB : 0 < B)
    (hratio : C2 = B / A) (hbalance : C1 = 1 + C2 ^ beta) :
    infiniteGenreCandidateCrossCoefficient C1 C2 beta B *
        (A ^ beta + B ^ beta) = 1 := by
  have hC2pow : 0 < C2 ^ beta := Real.rpow_pos_of_pos hC2 _
  have hApow : 0 < A ^ beta := Real.rpow_pos_of_pos hA _
  have hC1balance : 0 < 1 + C2 ^ beta := by linarith
  have hBpow : B ^ beta = C2 ^ beta * A ^ beta := by
    rw [hratio, Real.div_rpow hB.le hA.le]
    field_simp [hApow.ne']
  have hscale_inv : (infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ =
      C1⁻¹ * C2 ^ beta := by
    unfold infiniteGenreCdfFunctionalScale
    rw [Real.rpow_neg hC2.le beta, mul_inv_rev, inv_inv]
    ring
  unfold infiniteGenreCandidateCrossCoefficient
  rw [hscale_inv, Real.rpow_neg hB.le beta, hBpow, hbalance]
  field_simp [hC2pow.ne', hApow.ne', hC1balance.ne']

/-- Positivity of the corrected capped-reward coefficient. -/
theorem infiniteGenreCandidateCrossCoefficient_pos
    {C1 C2 beta B : ℝ}
    (hC1 : 0 < C1) (hC2 : 0 < C2) (hB : 0 < B) :
    0 < infiniteGenreCandidateCrossCoefficient C1 C2 beta B := by
  unfold infiniteGenreCandidateCrossCoefficient infiniteGenreCdfFunctionalScale
  exact mul_pos
    (inv_pos.mpr (mul_pos hC1 (Real.rpow_pos_of_pos hC2 _)))
    (Real.rpow_pos_of_pos hB _)

/--
Under the corrected calibration, the reciprocal capped-reward coefficient is
the angular power sum at the selected support direction.
-/
theorem infiniteGenreCandidateCrossCoefficient_inv_eq_scorePowers
    {C1 C2 beta A B : ℝ}
    (hC1 : 0 < C1) (hC2 : 0 < C2) (hbeta : 0 < beta)
    (hA : 0 < A) (hB : 0 < B)
    (hratio : C2 = B / A) (hbalance : C1 = 1 + C2 ^ beta) :
    (infiniteGenreCandidateCrossCoefficient C1 C2 beta B)⁻¹ =
      A ^ beta + B ^ beta := by
  let c := infiniteGenreCandidateCrossCoefficient C1 C2 beta B
  have hc : 0 < c :=
    infiniteGenreCandidateCrossCoefficient_pos hC1 hC2 hB
  have hnormalized : c * (A ^ beta + B ^ beta) = 1 :=
    infiniteGenreCandidateCrossCoefficient_mul_scorePowers_eq_one
      hC1 hC2 hbeta hA hB hratio hbalance
  calc
    c⁻¹ = c⁻¹ * 1 := (mul_one _).symm
    _ = c⁻¹ * (c * (A ^ beta + B ^ beta)) := by rw [hnormalized]
    _ = (c⁻¹ * c) * (A ^ beta + B ^ beta) := by ring
    _ = A ^ beta + B ^ beta := by
      rw [inv_mul_cancel₀ hc.ne', one_mul]

/--
On either corrected two-genre support ray, the two shifted candidate rewards
sum exactly to the radial power cost.  The balance `C₁ = 1 + C₂^β` is the
parameter relation that makes the source's intended zero-profit computation
valid; it is stated explicitly because the printed trigonometric definition
of `C₁` does not establish it.
-/
theorem infiniteGenreCandidateReward_sum_eq_rpow_of_balanced_cutoff
    {a C1 C2 beta r : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hbalance : C1 = 1 + C2 ^ beta)
    (hr : 0 ≤ r) (hra : r ≤ a) :
    infiniteGenreCandidateReward a C1 C2 beta (r / C2) +
        infiniteGenreCandidateReward a C1 C2 beta r = r ^ beta := by
  have hC1_pos : 0 < C1 := by
    rw [hC1]
    exact Real.rpow_pos_of_pos ha _
  have hC2pow_pos : 0 < C2 ^ beta :=
    Real.rpow_pos_of_pos hC2 _
  have hrpow_le : r ^ beta ≤ C1 := by
    rw [hC1]
    exact Real.rpow_le_rpow hr hra hbeta.le
  have hscale_inv : (infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ =
      C1⁻¹ * C2 ^ beta := by
    unfold infiniteGenreCdfFunctionalScale
    rw [Real.rpow_neg hC2.le beta, mul_inv_rev, inv_inv]
    ring
  have hfirst_coeff :
      (infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ * (r / C2) ^ beta =
        C1⁻¹ * r ^ beta := by
    rw [hscale_inv, Real.div_rpow hr hC2.le, div_eq_mul_inv]
    calc
      C1⁻¹ * C2 ^ beta * (r ^ beta * (C2 ^ beta)⁻¹) =
          C1⁻¹ * r ^ beta * (C2 ^ beta * (C2 ^ beta)⁻¹) := by ring
      _ = C1⁻¹ * r ^ beta := by
        rw [mul_inv_cancel₀ hC2pow_pos.ne', mul_one]
  have hsecond_coeff :
      (infiniteGenreCdfFunctionalScale C1 C2 beta)⁻¹ * r ^ beta =
        C1⁻¹ * C2 ^ beta * r ^ beta := by
    rw [hscale_inv]
  have hfirst_nonneg : 0 ≤ C1⁻¹ * r ^ beta :=
    mul_nonneg (inv_nonneg.mpr hC1_pos.le) (Real.rpow_nonneg hr _)
  have hfirst_le_one : C1⁻¹ * r ^ beta ≤ 1 := by
    calc
      C1⁻¹ * r ^ beta ≤ C1⁻¹ * C1 :=
        mul_le_mul_of_nonneg_left hrpow_le (inv_nonneg.mpr hC1_pos.le)
      _ = 1 := inv_mul_cancel₀ hC1_pos.ne'
  have hC2pow_le_one : C2 ^ beta ≤ 1 :=
    Real.rpow_le_one hC2.le hC2_one.le hbeta.le
  have hsecond_le_one : C1⁻¹ * C2 ^ beta * r ^ beta ≤ 1 := by
    calc
      C1⁻¹ * C2 ^ beta * r ^ beta = C2 ^ beta * (C1⁻¹ * r ^ beta) := by ring
      _ ≤ 1 * (C1⁻¹ * r ^ beta) :=
        mul_le_mul_of_nonneg_right hC2pow_le_one hfirst_nonneg
      _ ≤ 1 * 1 := mul_le_mul_of_nonneg_left hfirst_le_one zero_le_one
      _ = 1 := one_mul 1
  rw [infiniteGenreCandidateReward_eq_min ha hC2 hC2_one hbeta hC1
      (div_nonneg hr hC2.le),
    infiniteGenreCandidateReward_eq_min ha hC2 hC2_one hbeta hC1 hr,
    hfirst_coeff, hsecond_coeff, min_eq_right hfirst_le_one,
    min_eq_right hsecond_le_one]
  calc
    C1⁻¹ * r ^ beta + C1⁻¹ * C2 ^ beta * r ^ beta =
        C1⁻¹ * (1 + C2 ^ beta) * r ^ beta := by ring
    _ = C1⁻¹ * C1 * r ^ beta := by rw [← hbalance]
    _ = r ^ beta := by rw [inv_mul_cancel₀ hC1_pos.ne', one_mul]

/--
At the two corrected support score coordinates, the source's cross-genre
rewards reduce to the two scalar rewards used in the functional equation.
-/
theorem infiniteGenreCandidateCrossReward_sum_eq_rpow_on_support_ray
    {a C1 C2 beta A B r : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hbalance : C1 = 1 + C2 ^ beta)
    (hA : 0 < A) (hB : 0 < B) (hratio : C2 = B / A)
    (hr : 0 ≤ r) (hra : r ≤ a) :
    infiniteGenreCandidateCrossReward a C1 C2 beta A B (r * A) +
        infiniteGenreCandidateCrossReward a C1 C2 beta A B (r * B) = r ^ beta := by
  have hfirst : r * A / B = r / C2 := by
    rw [hratio]
    field_simp [hA.ne', hB.ne']
  have hfirst_shift : r * A / A = (r / C2) * C2 := by
    field_simp [hA.ne', hC2.ne']
  have hsecond : r * B / B = r := by
    field_simp [hB.ne']
  have hsecond_shift : r * B / A = r * C2 := by
    rw [hratio]
    field_simp [hA.ne']
  have hfirst_reward :
      infiniteGenreCandidateCrossReward a C1 C2 beta A B (r * A) =
        infiniteGenreCandidateReward a C1 C2 beta (r / C2) := by
    unfold infiniteGenreCandidateCrossReward infiniteGenreCandidateReward
    rw [hfirst, hfirst_shift]
  have hsecond_reward :
      infiniteGenreCandidateCrossReward a C1 C2 beta A B (r * B) =
        infiniteGenreCandidateReward a C1 C2 beta r := by
    unfold infiniteGenreCandidateCrossReward infiniteGenreCandidateReward
    rw [hsecond, hsecond_shift]
  rw [hfirst_reward, hsecond_reward]
  exact infiniteGenreCandidateReward_sum_eq_rpow_of_balanced_cutoff
    ha hC2 hC2_one hbeta hC1 hbalance hr hra

/--
The actual two-user objective induced by the repaired candidate law.  The
cross reward is written once for each user because the square-root product is
symmetric in its two genre arguments.
-/
noncomputable def infiniteGenreCandidateCrossObjective
    (a C1 C2 beta A B theta z1 z2 : ℝ) : ℝ :=
  infiniteGenreCandidateCrossReward a C1 C2 beta A B z1 +
    infiniteGenreCandidateCrossReward a C1 C2 beta A B z2 -
    twoUserInducedCost 1 beta theta z1 z2

/--
The capped two-user objective used in the corrected verification layer for the
infinite-producer construction.  It is deliberately an objective, rather than
a claimed CDF: the printed theorem does not give a coherent total definition
of its conditional-quality distribution.
-/
noncomputable def infiniteGenreCappedObjective
    (c beta theta z1 z2 : ℝ) : ℝ :=
  min 1 (c * z1 ^ beta) + min 1 (c * z2 ^ beta) -
    twoUserInducedCost 1 beta theta z1 z2

/--
The repaired candidate's genuine cross-reward objective is exactly the capped
objective once the two positive score ratios are supplied.
-/
theorem infiniteGenreCandidateCrossObjective_eq_cappedObjective
    {a C1 C2 beta A B theta z1 z2 : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hA : 0 < A) (hB : 0 < B)
    (hratio : C2 = B / A) (hz1 : 0 ≤ z1) (hz2 : 0 ≤ z2) :
    infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta z1 z2 =
      infiniteGenreCappedObjective
        (infiniteGenreCandidateCrossCoefficient C1 C2 beta B) beta theta z1 z2 := by
  unfold infiniteGenreCandidateCrossObjective infiniteGenreCappedObjective
  rw [infiniteGenreCandidateCrossReward_eq_min
      ha hC2 hC2_one hbeta hC1 hA hB hratio hz1,
    infiniteGenreCandidateCrossReward_eq_min
      ha hC2 hC2_one hbeta hC1 hA hB hratio hz2]

/--
The corrected infinite-producer objective is nonpositive on a canonical polar
value whenever its angular power sum is bounded by the reciprocal reward
scale.  This is the global-maximization half of the source verification; the
separate candidate-CDF construction must establish the capped reward formula.
-/
theorem infiniteGenreCappedObjective_nonpos_of_polar_angle_bound
    {c beta theta phi r : ℝ}
    (hr : 0 ≤ r) (hc : 0 < c) (hsin : 0 < Real.sin theta)
    (hcos : 0 ≤ Real.cos phi)
    (hcos_other : 0 ≤ Real.cos (theta - phi))
    (hangle : (Real.cos phi) ^ beta +
      (Real.cos (theta - phi)) ^ beta ≤ c⁻¹) :
    infiniteGenreCappedObjective c beta theta
      (r * Real.cos phi) (r * Real.cos (theta - phi)) ≤ 0 := by
  have hrpow_nonneg : 0 ≤ r ^ beta := Real.rpow_nonneg hr _
  have htarget : c * ((Real.cos phi) ^ beta +
      (Real.cos (theta - phi)) ^ beta) ≤ 1 := by
    calc
      c * ((Real.cos phi) ^ beta + (Real.cos (theta - phi)) ^ beta) ≤
          c * c⁻¹ :=
        mul_le_mul_of_nonneg_left hangle hc.le
      _ = 1 := mul_inv_cancel₀ (ne_of_gt hc)
  have hmin :
      min 1 (c * (r * Real.cos phi) ^ beta) +
        min 1 (c * (r * Real.cos (theta - phi)) ^ beta) ≤
      c * (r * Real.cos phi) ^ beta +
        c * (r * Real.cos (theta - phi)) ^ beta := by
    exact add_le_add (min_le_right _ _) (min_le_right _ _)
  have hreward :
      c * (r * Real.cos phi) ^ beta +
        c * (r * Real.cos (theta - phi)) ^ beta =
      r ^ beta * (c * ((Real.cos phi) ^ beta +
        (Real.cos (theta - phi)) ^ beta)) := by
    rw [Real.mul_rpow hr hcos, Real.mul_rpow hr hcos_other]
    ring
  have hcost :
      twoUserInducedCost 1 beta theta
          (r * Real.cos phi) (r * Real.cos (theta - phi)) = r ^ beta := by
    simpa using
      (twoUserInducedCost_param_eq_alpha_mul_rpow (α := 1) (β := beta)
        (θ := theta) (φ := phi) hr hsin)
  unfold infiniteGenreCappedObjective
  rw [hcost]
  calc
    min 1 (c * (r * Real.cos phi) ^ beta) +
          min 1 (c * (r * Real.cos (theta - phi)) ^ beta) - r ^ beta ≤
        c * (r * Real.cos phi) ^ beta +
          c * (r * Real.cos (theta - phi)) ^ beta - r ^ beta :=
      sub_le_sub_right hmin _
    _ = r ^ beta * (c * ((Real.cos phi) ^ beta +
          (Real.cos (theta - phi)) ^ beta)) - r ^ beta := by rw [hreward]
    _ = r ^ beta * (c * ((Real.cos phi) ^ beta +
          (Real.cos (theta - phi)) ^ beta) - 1) := by ring
    _ ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hrpow_nonneg
      (sub_nonpos.mpr htarget)

/--
The repaired cross-reward objective has no positive deviation at any
nonnegative polar score pair when the selected score direction globally
maximizes the corresponding angular power sum.  This is the source's final
global-comparison argument with its maximization domain made explicit.
-/
theorem infiniteGenreCandidateCrossObjective_nonpos_of_global_angle_max
    {a C1 C2 beta A B theta phi r : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hbalance : C1 = 1 + C2 ^ beta)
    (hA : 0 < A) (hB : 0 < B) (hratio : C2 = B / A)
    (hr : 0 ≤ r) (hsin : 0 < Real.sin theta)
    (hcos : 0 ≤ Real.cos phi) (hcos_other : 0 ≤ Real.cos (theta - phi))
    (hglobal : ∀ psi : ℝ, 0 ≤ Real.cos psi →
      0 ≤ Real.cos (theta - psi) →
      (Real.cos psi) ^ beta + (Real.cos (theta - psi)) ^ beta ≤
        A ^ beta + B ^ beta) :
    infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta
      (r * Real.cos phi) (r * Real.cos (theta - phi)) ≤ 0 := by
  have hC1_pos : 0 < C1 := by
    rw [hC1]
    exact Real.rpow_pos_of_pos ha _
  have hcoefficient :
      0 < infiniteGenreCandidateCrossCoefficient C1 C2 beta B :=
    infiniteGenreCandidateCrossCoefficient_pos hC1_pos hC2 hB
  have hinv :
      (infiniteGenreCandidateCrossCoefficient C1 C2 beta B)⁻¹ =
        A ^ beta + B ^ beta :=
    infiniteGenreCandidateCrossCoefficient_inv_eq_scorePowers
      hC1_pos hC2 hbeta hA hB hratio hbalance
  have hangle : (Real.cos phi) ^ beta +
      (Real.cos (theta - phi)) ^ beta ≤
        (infiniteGenreCandidateCrossCoefficient C1 C2 beta B)⁻¹ := by
    calc
      (Real.cos phi) ^ beta + (Real.cos (theta - phi)) ^ beta ≤
          A ^ beta + B ^ beta := hglobal phi hcos hcos_other
      _ = (infiniteGenreCandidateCrossCoefficient C1 C2 beta B)⁻¹ := hinv.symm
  rw [infiniteGenreCandidateCrossObjective_eq_cappedObjective
      ha hC2 hC2_one hbeta hC1 hA hB hratio
      (mul_nonneg hr hcos) (mul_nonneg hr hcos_other)]
  exact infiniteGenreCappedObjective_nonpos_of_polar_angle_bound
    hr hcoefficient hsin hcos hcos_other hangle

/--
The polar verification covers every nonnegative two-user score pair, including
the origin.  The nonzero branch obtains polar coordinates from the canonical
two-user inversion, and nonnegative scores force both displayed cosines to be
nonnegative; no artificial restriction to the source's drawn angular interval
is imposed.
-/
theorem infiniteGenreCandidateCrossObjective_nonpos_of_nonnegative_scores
    {a C1 C2 beta A B theta z1 z2 : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hbalance : C1 = 1 + C2 ^ beta)
    (hA : 0 < A) (hB : 0 < B) (hratio : C2 = B / A)
    (hsin : 0 < Real.sin theta) (hz1 : 0 ≤ z1) (hz2 : 0 ≤ z2)
    (hglobal : ∀ psi : ℝ, 0 ≤ Real.cos psi →
      0 ≤ Real.cos (theta - psi) →
      (Real.cos psi) ^ beta + (Real.cos (theta - psi)) ^ beta ≤
        A ^ beta + B ^ beta) :
    infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta z1 z2 ≤ 0 := by
  by_cases hzero : (z1, z2) = (0, 0)
  · have hz1_zero : z1 = 0 := by
      have h := congrArg Prod.fst hzero
      simpa using h
    have hz2_zero : z2 = 0 := by
      have h := congrArg Prod.snd hzero
      simpa using h
    subst z1
    subst z2
    unfold infiniteGenreCandidateCrossObjective infiniteGenreCandidateCrossReward
    rw [twoUserInducedCost_zero hbeta]
    simp [infiniteGenreCandidateCdf]
  · obtain ⟨r, phi, hr, hz1_param, hz2_param⟩ :=
      exists_twoUserParam_of_sin_ne_zero hsin.ne' hzero
    have hcos : 0 ≤ Real.cos phi := by
      by_contra hcos
      have hneg : Real.cos phi < 0 := lt_of_not_ge hcos
      have hmul : r * Real.cos phi < 0 := mul_neg_of_pos_of_neg hr hneg
      rw [← hz1_param] at hmul
      exact (not_lt_of_ge hz1) hmul
    have hcos_other : 0 ≤ Real.cos (theta - phi) := by
      by_contra hcos
      have hneg : Real.cos (theta - phi) < 0 := lt_of_not_ge hcos
      have hmul : r * Real.cos (theta - phi) < 0 :=
        mul_neg_of_pos_of_neg hr hneg
      rw [← hz2_param] at hmul
      exact (not_lt_of_ge hz2) hmul
    rw [hz1_param, hz2_param]
    exact infiniteGenreCandidateCrossObjective_nonpos_of_global_angle_max
      ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio hr.le hsin
      hcos hcos_other hglobal

