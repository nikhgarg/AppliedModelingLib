    hmax hfeasible hcone hreward hα (lt_of_lt_of_le zero_lt_one hβ) hsin

/--
The compact graph-geometry package for the below-threshold uniqueness proof.
It derives both coordinate-fibre injections and weak support order from the
paper's phase inequality, using C1 only at non-origin strict-cone support
values.  In particular, no impossible global strict sign or real-power base
premise remains.
-/
theorem canonicalTwoUser_valueSupport_geometry_of_scaledNormRpowCostNash_of_phase
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hα : 0 < α) (hβ : 1 ≤ β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hden : 0 < 1 - Real.cos θ)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hderiv1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) z.1) z.1)
    (hderiv2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 =>
            score (canonicalTwoUserSecond θ) q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 =>
            score (canonicalTwoUserSecond θ) q) μ) x) z.2) z.2) :
    IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support ∧
      (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.fst ∧
      (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.snd ∧
      (∀ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
        ∀ q ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
          p.1 < q.1 → p.2 ≤ q.2) := by
  let H1 : ℝ → ℝ := fun x =>
    AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x
  let H2 : ℝ → ℝ := fun x =>
    AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) x
  have hmax : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
          twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z := by
    intro z hz
    exact canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      hsin hnash hscore_ac z hz
  have hpositive : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ 0 < z.2 := by
    intro z hz hne
    have hzint := hinterior z hz hne
    exact ⟨hzint.1, lt_of_le_of_lt (mul_nonneg hzint.1.le hcos) hzint.2⟩
  have hcross : ∀ z1 z2 : ℝ, 0 < z1 → 0 < z2 →
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0 := by
    intro z1 z2 hz1 hz2
    exact twoUserInducedCostCrossPartial_neg_of_beta_lt_phaseThreshold_of_pos_scores
      hα hβ hsin hden hβlt hcos hz1 hz2
  have hinjfst :
      (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.fst := by
    apply twoUser_support_injOn_fst_of_common_firstPartial_of_crossPartial_neg_pos_awayOrigin
      hsin.ne' hcross hpositive
    · intro z hz hz1
      by_contra hne
      have hpos := (hinterior z hz hne).1
      rw [hz1] at hpos
      linarith
    · intro z hz hne
      exact twoUserInducedCostFirstPartial_eq_of_isMaxOn_of_feasibleInterior
        (hmax z hz) hsin (hinterior z hz hne).1 (hinterior z hz hne).2
        (hderiv1 z hz hne)
        (Or.inl (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne'
          (by
            have hzpos := (hinterior z hz hne).1
            exact Or.inl hzpos.ne')))
  have hinjsnd :
      (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.snd := by
    apply twoUser_support_injOn_snd_of_common_secondPartial_of_crossPartial_neg_pos_awayOrigin
      hsin.ne' hcross hpositive
    · intro z hz hz2
      by_contra hne
      have hzint := hinterior z hz hne
      have hprod : 0 ≤ z.1 * Real.cos θ := mul_nonneg hzint.1.le hcos
      rw [hz2] at hzint
      linarith
    · intro z hz hne
      exact twoUserInducedCostSecondPartial_eq_of_isMaxOn_of_feasibleInterior
        (hmax z hz) hsin (hinterior z hz hne).1 (hinterior z hz hne).2
        (hderiv2 z hz hne)
        (Or.inl (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne'
          (by
            have hzpos := (hinterior z hz hne).1
            exact Or.inl hzpos.ne')))
  exact ⟨canonicalTwoUser_isCompact_valueSupport_of_scaledNormRpowCostNash
      hnash hα (lt_of_lt_of_le zero_lt_one hβ), hinjfst, hinjsnd,
    canonicalTwoUser_valueSupport_ordered_of_scaledNormRpowCostNash_of_phase
      hα hβ hsin hcos hden hβlt hnash hscore_ac hinterior⟩

/--
Equilibrium-facing completion of the source's *local* no-gap deviation.  The
two supplied intervals are gaps in the actual raw-score marginal supports,
so score-law absolute continuity supplies the atomlessness needed to keep the
iid-maximum CDF rewards fixed through their upper endpoints.  This theorem
does not assert the missing global claim that every first-coordinate gap of
the joint value support yields an aligned second-coordinate gap.
-/
theorem canonicalTwoUser_not_sourceNash_of_two_aligned_marginal_open_gaps
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    {a b c d t : ℝ}
    (hsin : 0 < Real.sin θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hbd : (b, d) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hα : 0 < α) (hβ : 0 < β)
    (ht : 0 < t) (ht_one : t < 1)
    (hpair : b ≠ 0 ∨ d ≠ 0)
    (hgap1 : Set.Ioo a b ⊆
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).supportᶜ)
    (hgap2 : Set.Ioo c d ⊆
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).supportᶜ)
    (htb : t * b ∈ Set.Ioo a b)
    (htd : t * d ∈ Set.Ioo c d) :
    False := by
  let μ1 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ
  let μ2 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ
  letI : IsProbabilityMeasure μ1 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  letI : IsProbabilityMeasure μ2 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond θ)).aemeasurable
  have hac1 : μ1 ≪ volume := by
    simpa [μ1] using hscore_ac (0 : Fin 2)
  have hac2 : μ2 ≪ volume := by
    simpa [μ2] using hscore_ac (1 : Fin 2)
  letI : NoAtoms μ1 := ⟨fun x => hac1 (by simpa using (volume_singleton x))⟩
  letI : NoAtoms μ2 := ⟨fun x => hac2 (by simpa using (volume_singleton x))⟩
  have hbd_feasible : (b, d) ∈ canonicalTwoUserFeasibleValueSet θ := by
    change NonnegativeContent (canonicalTwoUserContentOfValues θ b d)
    exact hnash.2.1
      (canonicalTwoUserContentOfValues_mem_support_of_mem_valueMap_support
        hsin.ne' hbd)
  have hmax :=
    canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      hsin hnash hscore_ac (b, d) hbd
  exact canonicalTwoUser_not_isMaxOn_iidMaximumCdf_of_two_marginal_open_gaps
    (μ1 := μ1) (μ2 := μ2) (α := α) (β := β) (θ := θ)
    (a := a) (b := b) (c := c) (d := d) (t := t)
    (by simpa [μ1, μ2] using hmax) hbd_feasible hα hβ hsin ht ht_one hpair
    (by simpa [μ1] using hgap1) (by simpa [μ2] using hgap2) htb htd

/--
The C2 graph transport in canonical two-user coordinates.  If the realized
value law is supported on a measurable, strictly increasing graph over its
first score marginal, its two iid maximum-CDF objectives agree along the
graph.  This formalizes the measure-theoretic part of the source's C2 step;
regularity sufficient to supply the graph and its strict monotonicity remains
an explicit premise.
-/
theorem canonicalTwoUser_iidMaximumCdf_second_eq_first_of_valueSupport_graph_strictMonoOn
    {P : ℕ} {θ : ℝ} {μ : Measure (Content 2)} [IsProbabilityMeasure μ]
    {g : ℝ → ℝ} (hg : Measurable g)
    (hgraph : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z.2 = g z.1)
    (hstrict : ∀ x ∈
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support,
      ∀ y ∈
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support,
        x < y → g x < g y)
    {x : ℝ}
    (hx : x ∈
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support) :
    AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ)
        (g x) =
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x := by
  let ν : Measure (ℝ × ℝ) := Measure.map (canonicalTwoUserValueMap θ) μ
  have hmeas : Measurable (canonicalTwoUserValueMap θ) :=
    (canonicalTwoUserValueMap_continuous θ).measurable
  letI : IsProbabilityMeasure ν :=
    Measure.isProbabilityMeasure_map hmeas.aemeasurable
  have hmapfst : Measure.map Prod.fst ν =
      Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_fst hmeas]
    rfl
  have hmapsnd : Measure.map Prod.snd ν =
      Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_snd hmeas]
    rfl
  have hstrictν : ∀ x ∈ (Measure.map Prod.fst ν).support,
      ∀ y ∈ (Measure.map Prod.fst ν).support, x < y → g x < g y := by
    simpa only [hmapfst] using hstrict
  have hxν : x ∈ (Measure.map Prod.fst ν).support := by
    simpa only [hmapfst] using hx
  have htransport :=
    AppliedModelingLib.Probability.iidMaximumCdf_snd_eq_fst_of_support_graph_strictMonoOn
      (n := P - 1) ν hg (by simpa only [ν] using hgraph) hstrictν hxν
  simpa only [hmapsnd, hmapfst] using htransport

/--
A compact canonical value support with injective first projection becomes a
continuous graph once its first raw-score support is identified with a closed
interval.  This is the topological part of the source's graph step; no
differentiability is inferred here.
-/
theorem canonicalTwoUser_exists_continuous_valueSupport_graph_of_compact_of_injOn_fst_of_firstScoreSupport_eq_Icc
    {θ B : ℝ} {μ : Measure (Content 2)}
    (hB : 0 ≤ B)
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hinjfst : (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.fst)
    (hfirst_support :
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support =
        Set.Icc 0 B) :
    ∃ g : ℝ → ℝ, Continuous g ∧
      (∀ x ∈ Set.Icc 0 B,
        (x, g x) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support) ∧
      (∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support, z.2 = g z.1) := by
  let ν : Measure (ℝ × ℝ) := Measure.map (canonicalTwoUserValueMap θ) μ
  have hraw_map :
      Measure.map Prod.fst ν =
        Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_fst (canonicalTwoUserValueMap_continuous θ).measurable]
    rfl
  have hraw_support :
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support =
        Prod.fst '' ν.support := by
    rw [← hraw_map]
    exact AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      hcompact continuous_fst
  apply AppliedModelingLib.exists_continuous_graph_of_isCompact_of_injOn_fst_of_fst_image_eq_Icc
    hB hcompact hinjfst
  rw [← hraw_support]
  exact hfirst_support

/--
Topological and measure-transport form of the C2 graph step.  Compactness,
two projection injections, weak support order, and the first-support interval
produce a continuous strictly increasing graph.  Along it the two iid
maximum-CDF rewards agree.  This does not supply pointwise graph derivatives.
-/
theorem canonicalTwoUser_exists_continuous_strictGraph_c2_of_compact_of_ordered_of_firstScoreSupport_eq_Icc
    {P : ℕ} {θ B : ℝ} {μ : Measure (Content 2)} [IsProbabilityMeasure μ]
    (hB : 0 ≤ B)
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hinjfst : (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.fst)
    (hinjsnd : (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.snd)
    (hordered : ∀ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      ∀ q ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
        p.1 < q.1 → p.2 ≤ q.2)
    (hfirst_support :
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support =
        Set.Icc 0 B) :
    ∃ g : ℝ → ℝ, Continuous g ∧
      (∀ x ∈ Set.Icc 0 B,
        (x, g x) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support) ∧
      (∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support, z.2 = g z.1) ∧
      (∀ x ∈ Set.Icc 0 B, ∀ y ∈ Set.Icc 0 B, x < y → g x < g y) ∧
      (∀ x ∈ Set.Icc 0 B,
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
            (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ)
            (g x) =
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
            (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) := by
  obtain ⟨g, hg, hmem, hgraph⟩ :=
    canonicalTwoUser_exists_continuous_valueSupport_graph_of_compact_of_injOn_fst_of_firstScoreSupport_eq_Icc
      hB hcompact hinjfst hfirst_support
  have hstrict : ∀ x ∈ Set.Icc 0 B, ∀ y ∈ Set.Icc 0 B, x < y → g x < g y := by
    intro x hx y hy hxy
    have hxmem := hmem x hx
    have hymem := hmem y hy
    have hle := hordered (x, g x) hxmem (y, g y) hymem hxy
    have hne : g x ≠ g y := by
      intro hEq
      have hpairEq : (x, g x) = (y, g y) := hinjsnd hxmem hymem hEq
      exact hxy.ne (congrArg Prod.fst hpairEq)
    exact lt_of_le_of_ne hle hne
  refine ⟨g, hg, hmem, hgraph, hstrict, ?_⟩
  intro x hx
  apply canonicalTwoUser_iidMaximumCdf_second_eq_first_of_valueSupport_graph_strictMonoOn
    hg.measurable hgraph
  · intro u hu v hv huv
    have huI : u ∈ Set.Icc 0 B := by rw [← hfirst_support]; exact hu
    have hvI : v ∈ Set.Icc 0 B := by rw [← hfirst_support]; exact hv
    exact hstrict u huI v hvI huv
  · rw [hfirst_support]
    exact hx

/--
Projection-to-aligned-gap bridge for Proposition `uniqueness`.  A compact
strictly ordered canonical value support turns an open gap in the first raw
score marginal ending at a represented value into an aligned open gap in the
second raw score marginal.  The ordering, endpoint, and compactness premises
are explicit: this theorem does not infer them from mixed-Nash semantics.
-/
theorem canonicalTwoUser_exists_secondScore_gap_of_compact_strict_valueSupport_firstScore_gap
    {θ : ℝ} {μ : Measure (Content 2)} {a b d : ℝ}
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hinj : (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.fst)
    (hstrict : ∀ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      ∀ q ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
        p.1 < q.1 → p.2 < q.2)
    (hab : a < b)
    (hgap : Set.Ioo a b ⊆
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).supportᶜ)
    (hleft : ∃ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support, p.1 ≤ a)
    (hbd : (b, d) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support) :
    ∃ c : ℝ, c < d ∧ Set.Ioo c d ⊆
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).supportᶜ := by
  let ν : Measure (ℝ × ℝ) := Measure.map (canonicalTwoUserValueMap θ) μ
  have hmeas : Measurable (canonicalTwoUserValueMap θ) :=
    (canonicalTwoUserValueMap_continuous θ).measurable
  have hmapfst : Measure.map Prod.fst ν =
      Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_fst hmeas]
    rfl
  have hmapsnd : Measure.map Prod.snd ν =
      Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_snd hmeas]
    rfl
  have hgapν : Set.Ioo a b ⊆ (Measure.map Prod.fst ν).supportᶜ := by
    simpa [hmapfst] using hgap
  obtain ⟨c, hcd, hgap2⟩ :=
    AppliedModelingLib.Probability.exists_snd_support_gap_of_isCompact_of_strict_order_of_fst_support_gap
      (ν := ν) (by simpa [ν] using hcompact) (by simpa [ν] using hinj)
      (by simpa [ν] using hstrict) hab hgapν (by simpa [ν] using hleft)
      (by simpa [ν] using hbd)
  exact ⟨c, hcd, by simpa [hmapsnd] using hgap2⟩

/--
For a compact canonical value support, any failure of interval-connectedness of
the first raw-score support supplies the first-gap, joint-left-witness, and
represented joint-endpoint data needed by the aligned-gap argument.  This is a
topological consequence of compactness, independent of the equilibrium FOCs.
-/
theorem canonicalTwoUser_exists_firstScore_gap_data_of_compact_not_ordConnected_valueSupport
    {θ : ℝ} {μ : Measure (Content 2)}
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hnot : ¬ Set.OrdConnected
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support) :
    ∃ a b d : ℝ, a < b ∧ Set.Ioo a b ⊆
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).supportᶜ ∧
      (∃ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support, p.1 ≤ a) ∧
      (b, d) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support := by
  let ν : Measure (ℝ × ℝ) := Measure.map (canonicalTwoUserValueMap θ) μ
  have hmeas : Measurable (canonicalTwoUserValueMap θ) :=
    (canonicalTwoUserValueMap_continuous θ).measurable
  have hmapfst : Measure.map Prod.fst ν =
      Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_fst hmeas]
    rfl
  have hnotν : ¬ Set.OrdConnected (Measure.map Prod.fst ν).support := by
    simpa only [hmapfst] using hnot
  obtain ⟨a, b, d, hab, hgap, hleft, hbd⟩ :=
    AppliedModelingLib.Probability.exists_fst_support_gap_data_of_isCompact_of_not_ordConnected
      (ν := ν) (by simpa [ν] using hcompact) hnotν
  exact ⟨a, b, d, hab, by simpa [hmapfst] using hgap,
    by simpa [ν] using hleft, by simpa [ν] using hbd⟩

/--
Weak canonical value-support ordering is sufficient for the projection-to-gap
bridge when both coordinate projections are injective on the support.  The
second injectivity premise is precisely what upgrades weak ordering to the
strict order used by the compact-support argument.
-/
theorem canonicalTwoUser_exists_secondScore_gap_of_compact_ordered_valueSupport_injOn_snd
    {θ : ℝ} {μ : Measure (Content 2)} {a b d : ℝ}
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hinjfst : (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.fst)
    (hinjsnd : (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.snd)
    (hordered : ∀ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      ∀ q ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
        p.1 < q.1 → p.2 ≤ q.2)
    (hab : a < b)
    (hgap : Set.Ioo a b ⊆
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).supportᶜ)
    (hleft : ∃ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support, p.1 ≤ a)
    (hbd : (b, d) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support) :
    ∃ c : ℝ, c < d ∧ Set.Ioo c d ⊆
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).supportᶜ := by
  exact canonicalTwoUser_exists_secondScore_gap_of_compact_strict_valueSupport_firstScore_gap
    hcompact hinjfst
    (AppliedModelingLib.strict_snd_order_of_ordered_snd_of_injOn_snd hordered hinjsnd)
    hab hgap hleft hbd

/--
The compact projection-to-aligned-gap bridge with both coordinate injections
derived from the two common induced-cost partial identities.  The remaining
premises are the global support order, compactness, and the actual first-gap
and endpoint data; no coordinate injectivity is assumed separately.
-/
theorem canonicalTwoUser_exists_secondScore_gap_of_compact_ordered_valueSupport_common_partials
    {α β θ : ℝ} {μ : Measure (Content 2)} {H1 H2 : ℝ → ℝ} {a b d : ℝ}
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hfirst : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
            (z.1 - z.2 * Real.cos θ) = H1 z.1)
    (hsecond : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
            (z.2 - z.1 * Real.cos θ) = H2 z.2)
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hordered : ∀ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      ∀ q ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
        p.1 < q.1 → p.2 ≤ q.2)
    (hab : a < b)
    (hgap : Set.Ioo a b ⊆
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).supportᶜ)
    (hleft : ∃ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support, p.1 ≤ a)
    (hbd : (b, d) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support) :
    ∃ c : ℝ, c < d ∧ Set.Ioo c d ⊆
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).supportᶜ := by
  apply canonicalTwoUser_exists_secondScore_gap_of_compact_ordered_valueSupport_injOn_snd
    hcompact
  · exact twoUser_support_injOn_fst_of_common_firstPartial_of_crossPartial_neg
      hbase hcross hfirst
  · exact twoUser_support_injOn_snd_of_common_secondPartial_of_crossPartial_neg
      hbase hcross hsecond
  · exact hordered
  · exact hab
  · exact hgap
  · exact hleft
  · exact hbd

/--
Proposition `uniqueness`, FOC-derived form of the compact support-gap bridge.
At each value-support point, strict interior feasibility and differentiability
of both marginal reward functions turn C1 into the two common partial
identities.  This theorem makes those regularity premises explicit rather than
silently reading them into the source's support argument.
-/
theorem canonicalTwoUser_exists_secondScore_gap_of_compact_ordered_valueSupport_isMaxOn
    {α β θ : ℝ} {μ : Measure (Content 2)} {H1 H2 : ℝ → ℝ} {a b d : ℝ}
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hsin : 0 < Real.sin θ)
    (hmax : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support →
      IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
