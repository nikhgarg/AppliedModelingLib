theorem nonnegative_eq_singleGenreCdfRaw_of_natPow_eq_powerRatio
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β r x : ℝ} (hx : 0 ≤ x) (hr : 0 ≤ r)
    (hpower : x ^ (P - 1) = (r ^ β) / (N : ℝ)) :
    x = singleGenreCdfRaw N P β r := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_ne : (P : ℝ) - 1 ≠ 0 := by
    have hP_real : (1 : ℝ) < (P : ℝ) := by exact_mod_cast hP_nat
    linarith
  have hraw_nonneg : 0 ≤ singleGenreCdfRaw N P β r := by
    unfold singleGenreCdfRaw
    exact Real.rpow_nonneg
      (div_nonneg (Real.rpow_nonneg hr β) hN_pos.le) _
  apply (Real.rpow_left_inj hx hraw_nonneg hP_ne).mp
  have hx_rpow : x ^ ((P : ℝ) - 1) = (r ^ β) / (N : ℝ) := by
    rw [← natPow_card_sub_one_eq_rpow_card_sub_one]
    exact hpower
  rw [hx_rpow, singleGenreCdfRaw_power_eq_ratio hr]

