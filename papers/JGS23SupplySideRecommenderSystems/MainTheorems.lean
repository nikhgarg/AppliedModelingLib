  exact usersWon_eq_deviate_scale_of_preserved_winners_unique huniq husers_nonneg
    hprofile_nonneg (le_of_lt ha_lt) hpreserve

/-- Source profit formula: users won minus the one-time production cost. -/
noncomputable def pureProfit {D N P : ℕ}
    (users : Fin N → Content D) (cost : Content D → ℝ)
    (profile : Fin P → Content D) (j : Fin P) : ℝ :=
  usersWon users profile j - cost (profile j)

theorem pureProfit_le_card_of_cost_nonneg {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D} {j : Fin P}
    (hcost_nonneg : 0 ≤ cost (profile j)) :
    pureProfit users cost profile j ≤ (N : ℝ) := by
  unfold pureProfit
  have husers : usersWon users profile j ≤ (N : ℝ) :=
    usersWon_le_card users profile j
  linarith

theorem pureProfit_lt_zero_of_cost_gt_card {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D} {j : Fin P}
    (hcost_gt : (N : ℝ) < cost (profile j)) :
    pureProfit users cost profile j < 0 := by
  unfold pureProfit
  have husers : usersWon users profile j ≤ (N : ℝ) :=
    usersWon_le_card users profile j
  linarith

/--
Algebraic deviation step for Proposition `pure`: if a deviation preserves the
number of users won and strictly lowers cost, then it strictly improves profit.
-/
theorem pureProfit_lt_of_same_usersWon_and_cost_lt {D N P : ℕ}
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile profile' : Fin P → Content D} {j : Fin P}
    (husers : usersWon users profile j = usersWon users profile' j)
    (hcost : cost (profile' j) < cost (profile j)) :
    pureProfit users cost profile j < pureProfit users cost profile' j := by
  unfold pureProfit
  rw [husers]
  linarith

/--
Algebraic deviation step for Proposition `pure`: if the gain in recommendation
mass is larger than the cost increase, then the deviation strictly improves
profit.
-/
theorem pureProfit_lt_of_userGain_gt_costIncrease {D N P : ℕ}
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile profile' : Fin P → Content D} {j : Fin P}
    (hgain :
      cost (profile' j) - cost (profile j) <
        usersWon users profile' j - usersWon users profile j) :
    pureProfit users cost profile j < pureProfit users cost profile' j := by
  unfold pureProfit
  linarith

/--
Profit accounting used in the paper's saturation discussion: total realized
pure-profile producer profit is at most the number of users, because total
recommendation mass is exactly `N` and production costs are nonnegative.
-/
theorem sum_pureProfit_le_card_of_cost_nonneg {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D}
    (hcost_nonneg : ∀ j : Fin P, 0 ≤ cost (profile j)) :
    (∑ j : Fin P, pureProfit users cost profile j) ≤ (N : ℝ) := by
  have hcost_sum_nonneg : 0 ≤ ∑ j : Fin P, cost (profile j) :=
    Finset.sum_nonneg fun j _hj => hcost_nonneg j
  calc
    (∑ j : Fin P, pureProfit users cost profile j)
        = (∑ j : Fin P, usersWon users profile j) -
            (∑ j : Fin P, cost (profile j)) := by
          simp [pureProfit, Finset.sum_sub_distrib]
    _ = (N : ℝ) - (∑ j : Fin P, cost (profile j)) := by
          rw [sum_usersWon_eq_card]
    _ ≤ (N : ℝ) := by linarith

theorem common_profit_le_card_div_of_sum_le {N P : ℕ} [Nonempty (Fin P)]
    {profit : Fin P → ℝ} {π : ℝ}
    (hsum_le : (∑ j : Fin P, profit j) ≤ (N : ℝ))
    (hcommon : ∀ j : Fin P, profit j = π) :
    π ≤ (N : ℝ) / (P : ℝ) := by
  have hsum_common : (∑ j : Fin P, profit j) = (P : ℝ) * π := by
    calc
      (∑ j : Fin P, profit j) = ∑ _j : Fin P, π := by
        refine Finset.sum_congr rfl ?_
        intro j _hj
        exact hcommon j
      _ = (P : ℝ) * π := by simp [mul_comm]
  have hP_pos_nat : 0 < P := by
    simpa using (Fintype.card_pos_iff.mpr inferInstance : 0 < Fintype.card (Fin P))
  have hP_pos : 0 < (P : ℝ) := by exact_mod_cast hP_pos_nat
  rw [hsum_common] at hsum_le
  rw [le_div_iff₀ hP_pos]
  simpa [mul_comm] using hsum_le

/--
Symmetric/common-profit form of the saturation accounting: if all producers
receive the same pure-profile profit, that common profit is at most `N / P`.
-/
theorem common_pureProfit_le_card_div_of_cost_nonneg {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D} {π : ℝ}
    (hcost_nonneg : ∀ j : Fin P, 0 ≤ cost (profile j))
    (hcommon : ∀ j : Fin P, pureProfit users cost profile j = π) :
    π ≤ (N : ℝ) / (P : ℝ) := by
  have hsum_le : (∑ j : Fin P, pureProfit users cost profile j) ≤ (N : ℝ) :=
    sum_pureProfit_le_card_of_cost_nonneg hcost_nonneg
  exact common_profit_le_card_div_of_sum_le hsum_le hcommon

theorem top_tie_share_jump_pos {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P}
    (hwin : j ∈ winningProducers u profile)
    (hcard : 1 < (winningProducers u profile).card) :
    0 < 1 - tieShare u profile j := by
  have hlt : tieShare u profile j < 1 :=
    tieShare_lt_one_of_mem_card_one_lt hwin hcard
  linarith

theorem pureProfit_lt_of_top_tie_perturb_cost_lt_share_jump {D N P : ℕ}
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D} {i0 : Fin N} {j : Fin P} {ε : ℝ}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0))
    (hwin : j ∈ winningProducers (users i0) profile)
    (hε : 0 < ε)
    (hcost :
      cost (fun d => profile j d + ε * users i0 d) - cost (profile j) <
        1 - tieShare (users i0) profile j) :
    pureProfit users cost profile j <
      pureProfit users cost
        (deviateProfile profile j (fun d => profile j d + ε * users i0 d)) j := by
  let profile' := deviateProfile profile j (fun d => profile j d + ε * users i0 d)
  have hgain_bound :
      1 - tieShare (users i0) profile j ≤
        usersWon users profile' j - usersWon users profile j :=
    top_tie_share_jump_le_usersWon_gain husers_nonneg hzero hwin hε
  have hcost' :
      cost (profile' j) - cost (profile j) <
        1 - tieShare (users i0) profile j := by
    simpa [profile'] using hcost
  have hgain :
      cost (profile' j) - cost (profile j) <
        usersWon users profile' j - usersWon users profile j :=
    lt_of_lt_of_le hcost' hgain_bound
  exact pureProfit_lt_of_userGain_gt_costIncrease hgain

/--
On the all-at-atom realization, the pure-profile profit gain from perturbing
producer `j` is at least the source tie-share jump `1 - 1/P` minus the
production-cost increase.
-/
theorem pureProfit_gain_constantProfile_perturb_ge_one_sub_one_div_sub_cost
    {D N P : ℕ} {users : Fin N → Content D} {cost : Content D → ℝ}
    {p : Content D} {i0 : Fin N} {j : Fin P} {ε : ℝ}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0)) (hε : 0 < ε) :
    1 - 1 / (P : ℝ) -
        (cost (fun d => p d + ε * users i0 d) - cost p) ≤
      pureProfit users cost
          (deviateProfile (fun _ : Fin P => p) j
            (fun d => p d + ε * users i0 d)) j -
        pureProfit users cost (fun _ : Fin P => p) j := by
  let profile : Fin P → Content D := fun _ => p
  let profile' : Fin P → Content D :=
    deviateProfile profile j (fun d => p d + ε * users i0 d)
  have hwin : j ∈ winningProducers (users i0) profile := by
    rw [show profile = (fun _ : Fin P => p) by rfl, winningProducers_constantProfile]
    simp
  have hgain :
      1 - 1 / (P : ℝ) ≤ usersWon users profile' j - usersWon users profile j := by
    have h :=
      top_tie_share_jump_le_usersWon_gain
        (profile := profile) husers_nonneg hzero hwin hε
    simpa [profile, profile', tieShare_constantProfile_eq_one_div] using h
  change
    1 - 1 / (P : ℝ) -
        (cost (fun d => p d + ε * users i0 d) - cost p) ≤
      (usersWon users profile' j - cost (profile' j)) -
        (usersWon users profile j - cost (profile j))
  have hprofile'_j : profile' j = fun d => p d + ε * users i0 d := by
    simp [profile']
  have hprofile_j : profile j = p := rfl
  rw [hprofile'_j, hprofile_j]
  linarith

/--
Full-profile version of the source atom event: all producers other than `j`
draw the atom content `p`.  The coordinate `j` is ignored because the deviating
producer's pure action is inserted separately.
-/
def AllOtherProducersDrawContent {D P : ℕ} (j : Fin P) (p : Content D) :
    Set (Fin P → Content D) :=
  {profile | ∀ k : Fin P, k ≠ j → profile k = p}

/--
Full-profile product event: all producers other than `j` draw content in a
set `A`.  This is the non-atomic analogue of
`AllOtherProducersDrawContent`, used for score-level and direction-group
events.
-/
def AllOtherProducersInSet {D P : ℕ} (j : Fin P) (A : Set (Content D)) :
    Set (Fin P → Content D) :=
  {profile | ∀ k : Fin P, k ≠ j → profile k ∈ A}

theorem deviateProfile_eq_constant_of_allOtherProducersDrawContent
    {D P : ℕ} {profile : Fin P → Content D} {j : Fin P} {p : Content D}
    (hprofile : profile ∈ AllOtherProducersDrawContent j p) :
    deviateProfile profile j p = fun _ : Fin P => p := by
  ext k d
  by_cases hk : k = j
  · subst k
    simp [deviateProfile]
  · rw [deviateProfile_of_ne profile p hk]
    exact congrFun (hprofile k hk) d

theorem deviateProfile_perturb_eq_constantProfile_perturb_of_allOtherProducersDrawContent
    {D P : ℕ} {profile : Fin P → Content D} {j : Fin P} {p u : Content D}
    {ε : ℝ}
    (hprofile : profile ∈ AllOtherProducersDrawContent j p) :
    deviateProfile profile j (fun d => p d + ε * u d) =
      deviateProfile (fun _ : Fin P => p) j (fun d => p d + ε * u d) := by
  ext k d
  by_cases hk : k = j
  · subst k
    simp [deviateProfile]
  · rw [deviateProfile_of_ne profile (fun d => p d + ε * u d) hk,
      deviateProfile_of_ne (fun _ : Fin P => p) (fun d => p d + ε * u d) hk]
    exact congrFun (hprofile k hk) d

theorem usersWon_le_deviate_replace_by_nonnegative_perturb
    {D N P : ℕ} {users : Fin N → Content D}
    {profile : Fin P → Content D} {p u : Content D} {j : Fin P} {ε : ℝ}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hu : NonnegativeContent u) (hε : 0 ≤ ε) :
    usersWon users (deviateProfile profile j p) j ≤
      usersWon users (deviateProfile profile j (fun d => p d + ε * u d)) j := by
  let baseProfile : Fin P → Content D := deviateProfile profile j p
  have hpert :
      deviateProfile baseProfile j (fun d => baseProfile j d + ε * u d) =
        deviateProfile profile j (fun d => p d + ε * u d) := by
    ext k d
    by_cases hk : k = j
    · subst k
      simp [baseProfile, deviateProfile]
    · rw [deviateProfile_of_ne baseProfile (fun d => baseProfile j d + ε * u d) hk,
        deviateProfile_of_ne profile (fun d => p d + ε * u d) hk]
      simp [baseProfile, deviateProfile, hk]
  have hle :
      usersWon users baseProfile j ≤
        usersWon users
          (deviateProfile baseProfile j (fun d => baseProfile j d + ε * u d)) j := by
    unfold usersWon
    exact Finset.sum_le_sum
      (fun i _hi =>
        tieShare_le_deviate_perturb (husers_nonneg i) hu hε)
  rw [hpert] at hle
  simpa [baseProfile] using hle

/--
Pointwise source atom-event gain: on any realized opponent profile where all
other producers draw atom `p`, perturbing to `p + ε u_i` increases the assigned
user mass by at least `1 - 1/P`.
-/
theorem usersWon_gain_allOtherProducersDrawContent_perturb_ge_one_sub_one_div
    {D N P : ℕ} {users : Fin N → Content D}
    {profile : Fin P → Content D} {p : Content D}
    {i0 : Fin N} {j : Fin P} {ε : ℝ}
    (hprofile : profile ∈ AllOtherProducersDrawContent j p)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0)) (hε : 0 < ε) :
    1 - 1 / (P : ℝ) ≤
      usersWon users (deviateProfile profile j (fun d => p d + ε * users i0 d)) j -
        usersWon users (deviateProfile profile j p) j := by
  let profile0 : Fin P → Content D := fun _ => p
  let profile1 : Fin P → Content D :=
    deviateProfile profile0 j (fun d => p d + ε * users i0 d)
  have hprofile0 :
      deviateProfile profile j p = profile0 :=
    deviateProfile_eq_constant_of_allOtherProducersDrawContent hprofile
  have hprofile1 :
      deviateProfile profile j (fun d => p d + ε * users i0 d) = profile1 :=
    deviateProfile_perturb_eq_constantProfile_perturb_of_allOtherProducersDrawContent
      hprofile
  have hwin : j ∈ winningProducers (users i0) profile0 := by
    rw [show profile0 = (fun _ : Fin P => p) by rfl, winningProducers_constantProfile]
    simp
  have hgain :
      1 - tieShare (users i0) profile0 j ≤
        usersWon users profile1 j - usersWon users profile0 j :=
    top_tie_share_jump_le_usersWon_gain
      (profile := profile0) husers_nonneg hzero hwin hε
  simpa [profile0, profile1, hprofile0, hprofile1,
    tieShare_constantProfile_eq_one_div] using hgain

/--
Score-level version of the source atom-event gain.  If every opponent has the
same score as a focal action `p` for user `i0`, then a positive perturbation in
that user's direction turns the focal producer's `1 / P` tie share into a
strict win.  Other users' shares cannot fall under nonnegative perturbation.

Unlike `usersWon_gain_allOtherProducersDrawContent_perturb_ge_one_sub_one_div`,
this does not require opponents to draw the same *content* vector.  It is the
local mechanism needed to rule out score-law atoms, which are distinct from
content point masses.
-/
theorem usersWon_gain_allOtherProducersInScoreLevel_perturb_ge_one_sub_one_div
    {D N P : ℕ} {users : Fin N → Content D}
    {profile : Fin P → Content D} {p : Content D}
    {i0 : Fin N} {j : Fin P} {ε : ℝ}
    (hprofile : profile ∈ AllOtherProducersInSet j
      {q : Content D | score (users i0) q = score (users i0) p})
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0)) (hε : 0 < ε) :
    1 - 1 / (P : ℝ) ≤
      usersWon users (deviateProfile profile j (fun d => p d + ε * users i0 d)) j -
        usersWon users (deviateProfile profile j p) j := by
  have hwin : j ∈ winningProducers (users i0) (deviateProfile profile j p) := by
    rw [mem_winningProducers]
    intro k
    by_cases hkj : k = j
    · subst k
      simp [deviateProfile]
    · rw [deviateProfile_of_ne profile p hkj]
      rw [deviateProfile_self]
      have hscore : score (users i0) (profile k) = score (users i0) p := hprofile k hkj
      exact le_of_eq hscore
  have hwinning_all : winningProducers (users i0) (deviateProfile profile j p) = Finset.univ := by
    apply Finset.eq_univ_of_forall
    intro k
    rw [mem_winningProducers]
    intro l
    by_cases hkj : k = j
    · subst k
      by_cases hlj : l = j
      · subst l
        simp [deviateProfile]
      · rw [deviateProfile_of_ne profile p hlj]
        rw [deviateProfile_self]
        exact le_of_eq (hprofile l hlj)
    · rw [deviateProfile_of_ne profile p hkj]
      by_cases hlj : l = j
      · subst l
        rw [deviateProfile_self]
        exact le_of_eq (hprofile k hkj).symm
      · rw [deviateProfile_of_ne profile p hlj]
        exact le_of_eq ((hprofile l hlj).trans (hprofile k hkj).symm)
  have hshare : tieShare (users i0) (deviateProfile profile j p) j = 1 / (P : ℝ) := by
    rw [tieShare_eq_inv_card_of_mem hwin, hwinning_all]
    simp
  have hgain := top_tie_share_jump_le_usersWon_gain
    (profile := deviateProfile profile j p) husers_nonneg hzero hwin hε
  rw [hshare] at hgain
  simpa [deviateProfile] using hgain

theorem allOtherProducersDrawContent_eq_pi_erase {D P : ℕ}
    (j : Fin P) (p : Content D) :
    AllOtherProducersDrawContent j p =
      ((Finset.univ.erase j : Finset (Fin P)) : Set (Fin P)).pi
        (fun _ : Fin P => ({p} : Set (Content D))) := by
  ext profile
  simp [AllOtherProducersDrawContent]

theorem measure_allOtherProducersDrawContent_eq_pow
    {D P : ℕ} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ] (j : Fin P) (p : Content D) :
    MeasureTheory.Measure.pi (fun _ : Fin P => μ)
        (AllOtherProducersDrawContent j p) =
      μ ({p} : Set (Content D)) ^ (P - 1) := by
  classical
  rw [allOtherProducersDrawContent_eq_pi_erase]
  rw [MeasureTheory.Measure.pi_pi_finset]
  simp

theorem measureReal_allOtherProducersDrawContent_eq_pow
    {D P : ℕ} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ] (j : Fin P) (p : Content D) :
    (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
        (AllOtherProducersDrawContent j p) =
      (μ.real ({p} : Set (Content D))) ^ (P - 1) := by
  rw [MeasureTheory.Measure.real,
    measure_allOtherProducersDrawContent_eq_pow (μ := μ) j p]
  simp [MeasureTheory.Measure.real]

theorem measurableSet_allOtherProducersDrawContent
    {D P : ℕ} [MeasurableSingletonClass (Content D)]
    (j : Fin P) (p : Content D) :
    MeasurableSet (AllOtherProducersDrawContent j p) := by
  rw [allOtherProducersDrawContent_eq_pi_erase]
  exact MeasurableSet.pi (Finset.countable_toSet _)
    (fun _ _ => measurableSet_singleton p)

theorem allOtherProducersInSet_eq_pi_erase {D P : ℕ}
    (j : Fin P) (A : Set (Content D)) :
    AllOtherProducersInSet j A =
      ((Finset.univ.erase j : Finset (Fin P)) : Set (Fin P)).pi
        (fun _ : Fin P => A) := by
  ext profile
  simp [AllOtherProducersInSet]

theorem measure_allOtherProducersInSet_eq_pow
    {D P : ℕ} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ] (j : Fin P) (A : Set (Content D)) :
    MeasureTheory.Measure.pi (fun _ : Fin P => μ)
        (AllOtherProducersInSet j A) =
      μ A ^ (P - 1) := by
  classical
  rw [allOtherProducersInSet_eq_pi_erase]
  rw [MeasureTheory.Measure.pi_pi_finset]
  simp

theorem measureReal_allOtherProducersInSet_eq_pow
    {D P : ℕ} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ] (j : Fin P) (A : Set (Content D)) :
    (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
        (AllOtherProducersInSet j A) =
      (μ.real A) ^ (P - 1) := by
  rw [MeasureTheory.Measure.real,
    measure_allOtherProducersInSet_eq_pow (μ := μ) j A]
  simp [MeasureTheory.Measure.real]

theorem natPow_card_sub_one_eq_rpow_card_sub_one
    {P : ℕ} [Nontrivial (Fin P)] (x : ℝ) :
    x ^ (P - 1) = x ^ ((P : ℝ) - 1) := by
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_pos : 0 < P := lt_trans Nat.zero_lt_one hP_nat
  rw [← Real.rpow_natCast, Nat.cast_pred hP_pos]

theorem measureReal_allOtherProducersInSet_eq_rpow
    {D P : ℕ} [Nontrivial (Fin P)]
    {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ] (j : Fin P) (A : Set (Content D)) :
    (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
        (AllOtherProducersInSet j A) =
      (μ.real A) ^ ((P : ℝ) - 1) := by
  rw [measureReal_allOtherProducersInSet_eq_pow (μ := μ) j A]
  exact natPow_card_sub_one_eq_rpow_card_sub_one (μ.real A)

theorem measurableSet_allOtherProducersInSet
    {D P : ℕ} {A : Set (Content D)}
    (hA : MeasurableSet A) (j : Fin P) :
    MeasurableSet (AllOtherProducersInSet j A) := by
  rw [allOtherProducersInSet_eq_pi_erase]
  exact MeasurableSet.pi (Finset.countable_toSet _) (fun _ _ => hA)

theorem integral_gain_lower_bound_of_pointwise_event
    {Ω : Type*} [MeasurableSpace Ω]
    {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure μ]
    {f g : Ω → ℝ} {E : Set Ω} {c : ℝ}
    (hE : MeasurableSet E)
    (hf : MeasureTheory.Integrable f μ) (hg : MeasureTheory.Integrable g μ)
    (hmono : f ≤ᵐ[μ] g)
    (hevent : ∀ᵐ ω ∂μ, ω ∈ E → c ≤ g ω - f ω)
    (hc : 0 ≤ c) :
    c * μ.real E ≤ (∫ ω, g ω ∂μ) - ∫ ω, f ω ∂μ := by
  have hindicator_int :
      MeasureTheory.Integrable (E.indicator (fun _ : Ω => c)) μ :=
    (MeasureTheory.integrable_const c).indicator hE
  have hdiff_int : MeasureTheory.Integrable (fun ω => g ω - f ω) μ := hg.sub hf
  have hle_ae :
      E.indicator (fun _ : Ω => c) ≤ᵐ[μ] fun ω => g ω - f ω := by
    filter_upwards [hmono, hevent] with ω hfg he
    by_cases hω : ω ∈ E
    · simpa [Set.indicator_of_mem hω] using he hω
    · have hdiff_nonneg : 0 ≤ g ω - f ω := by linarith
      simpa [Set.indicator_of_notMem hω] using hdiff_nonneg
  have hle :
      (∫ ω, E.indicator (fun _ : Ω => c) ω ∂μ) ≤
        ∫ ω, g ω - f ω ∂μ :=
    MeasureTheory.integral_mono_ae hindicator_int hdiff_int hle_ae
  rw [MeasureTheory.integral_indicator_const c hE,
    MeasureTheory.integral_sub hg hf] at hle
  simpa [smul_eq_mul, mul_comm, mul_left_comm, mul_assoc] using hle

/--
Expected assigned-user mass for a pure content vector against independent
symmetric mixed draws from `μ`, represented as a full-profile product integral
where producer `j`'s coordinate is overwritten by the pure action.
-/
noncomputable def ExpectedUsersWonAgainstSymmetricMixed {D N P : ℕ}
    (users : Fin N → Content D) (j : Fin P)
    (p : Content D) (μ : MeasureTheory.Measure (Content D)) : ℝ :=
  ∫ profile : Fin P → Content D,
    usersWon users (deviateProfile profile j p) j ∂
      MeasureTheory.Measure.pi (fun _ : Fin P => μ)

/--
Replacing one coordinate of an iid finite profile by an independent draw from
the same law leaves its expected value unchanged.  The proof uses the actual
finite-coordinate product-measure equivalence, rather than an informal iid
identification.  A uniform norm bound keeps every Fubini step integrable.
-/
theorem integral_iid_deviateProfile_eq_diagonal
    {D P : ℕ} (μ : MeasureTheory.Measure (Content D)) [MeasureTheory.IsProbabilityMeasure μ]
    (j : Fin (P + 1)) (f : (Fin (P + 1) → Content D) → ℝ)
    (hmeasurable : MeasureTheory.StronglyMeasurable f) (C : ℝ)
    (hbound : ∀ profile, ‖f profile‖ ≤ C) :
    ∫ p, (∫ profile, f (deviateProfile profile j p) ∂
      MeasureTheory.Measure.pi (fun _ : Fin (P + 1) => μ)) ∂μ =
      ∫ profile, f profile ∂MeasureTheory.Measure.pi (fun _ : Fin (P + 1) => μ) := by
  let π : MeasureTheory.Measure (Fin (P + 1) → Content D) :=
    MeasureTheory.Measure.pi (fun _ : Fin (P + 1) => μ)
  let πrest : MeasureTheory.Measure (Fin P → Content D) :=
    MeasureTheory.Measure.pi (fun _ : Fin P => μ)
  let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (P + 1) => Content D) j
  have hpres : MeasureTheory.MeasurePreserving e π (μ.prod πrest) := by
    simpa [π, πrest, e] using
      (MeasureTheory.measurePreserving_piFinSuccAbove (fun _ : Fin (P + 1) => μ) j)
  have hintegrable : MeasureTheory.Integrable (fun z => f (e.symm z)) (μ.prod πrest) := by
    apply MeasureTheory.Integrable.of_bound
      (hmeasurable.comp_measurable e.symm.measurable).aestronglyMeasurable C
    filter_upwards with z
    exact hbound (e.symm z)
  have hreplace : ∀ p q rest,
      deviateProfile (e.symm (q, rest)) j p = e.symm (p, rest) := by
    intro p q rest
    dsimp [e]
    ext k
    by_cases hk : k = j
    · subst k
      simp [deviateProfile]
    · obtain ⟨l, rfl⟩ := Fin.exists_succAbove_eq hk
      simp [deviateProfile, Fin.insertNth_apply_succAbove]
  have hinner : ∀ p,
      (∫ profile, f (deviateProfile profile j p) ∂π) =
        ∫ rest, f (e.symm (p, rest)) ∂πrest := by
    intro p
    have hproduct_integrable : MeasureTheory.Integrable
        (fun z : Content D × (Fin P → Content D) =>
          f (deviateProfile (e.symm z) j p)) (μ.prod πrest) := by
      have heq : (fun z : Content D × (Fin P → Content D) =>
          f (deviateProfile (e.symm z) j p)) =
          fun z => f (e.symm (p, z.2)) := by
        funext z
        exact congrArg f (hreplace p z.1 z.2)
      rw [heq]
      apply MeasureTheory.Integrable.of_bound
        (hmeasurable.comp_measurable
          (e.symm.measurable.comp (measurable_const.prodMk measurable_snd))).aestronglyMeasurable C
      filter_upwards with z
      exact hbound (e.symm (p, z.2))
    calc
      (∫ profile, f (deviateProfile profile j p) ∂π) =
          ∫ z, f (deviateProfile (e.symm z) j p) ∂(μ.prod πrest) := by
            rw [← hpres.integral_comp' (fun z => f (deviateProfile (e.symm z) j p))]
            apply MeasureTheory.integral_congr_ae
            filter_upwards with profile
            simp
      _ = ∫ q, ∫ rest, f (deviateProfile (e.symm (q, rest)) j p) ∂πrest ∂μ :=
        MeasureTheory.integral_prod _ hproduct_integrable
      _ = ∫ rest, f (e.symm (p, rest)) ∂πrest := by
        simp_rw [hreplace]
        simp
  calc
    (∫ p, (∫ profile, f (deviateProfile profile j p) ∂π) ∂μ) =
        ∫ p, (∫ rest, f (e.symm (p, rest)) ∂πrest) ∂μ := by
          apply MeasureTheory.integral_congr_ae
          filter_upwards with p
          exact hinner p
    _ = ∫ z, f (e.symm z) ∂(μ.prod πrest) :=
      (MeasureTheory.integral_prod _ hintegrable).symm
    _ = ∫ profile, f profile ∂π := by
      rw [← hpres.integral_comp' (fun z => f (e.symm z))]
      apply MeasureTheory.integral_congr_ae
      filter_upwards with profile
      simp

/-- The finite-coordinate score map is measurable in the content argument. -/
theorem measurable_score_content {D : ℕ} (u : Content D) :
    Measurable (fun p : Content D => score u p) := by
  unfold score
  exact Finset.measurable_sum Finset.univ fun d _hd =>
    measurable_const.mul (measurable_pi_apply d)

/--
One-sided continuity of a production cost along every positive content
perturbation ray.
-/
def PerturbationCostContinuous {D : ℕ} (cost : Content D → ℝ) : Prop :=
  ∀ p u : Content D,
    Filter.Tendsto (fun ε : ℝ => cost (fun d => p d + ε * u d))
      (nhdsWithin (0 : ℝ) (Set.Ioi 0)) (nhds (cost p))

/-- A positive perturbation can make its cost increase smaller than any slack. -/
theorem exists_positive_perturb_cost_increase_lt {D : ℕ}
    {cost : Content D → ℝ} (hcont : PerturbationCostContinuous cost)
    {p u : Content D} {δ : ℝ} (hδ : 0 < δ) :
    ∃ ε : ℝ, 0 < ε ∧
      cost (fun d => p d + ε * u d) - cost p < δ := by
  have hevent :
      ∀ᶠ ε in nhdsWithin (0 : ℝ) (Set.Ioi 0),
        cost (fun d => p d + ε * u d) < cost p + δ :=
    (hcont p u).eventually (Iio_mem_nhds (lt_add_of_pos_right (cost p) hδ))
  have hpos_event :
      ∀ᶠ ε in nhdsWithin (0 : ℝ) (Set.Ioi 0), ε ∈ Set.Ioi (0 : ℝ) :=
    self_mem_nhdsWithin
  rcases (hevent.and hpos_event).exists with ⟨ε, hlt, hεpos⟩
  exact ⟨ε, hεpos, by linarith⟩

/--
Mixed-equilibrium best-response surface: no pure content vector earns more
than the equilibrium payoff against the symmetric mixed strategy.
-/
def SymmetricMixedNoProfitablePureDeviation {D : ℕ}
    (payoff : Content D → MixedContentStrategy D → ℝ)
    (μ : MixedContentStrategy D) (equilibriumPayoff : ℝ) : Prop :=
  ∀ p : Content D, payoff p μ ≤ equilibriumPayoff

/--
The source mixed-payoff decomposition: a pure content payoff is expected
assigned-user mass minus production cost.
-/
noncomputable def SourceMixedPurePayoff {D : ℕ}
    (expectedUsersWon : Content D → MixedContentStrategy D → ℝ)
    (cost : Content D → ℝ) (p : Content D) (μ : MixedContentStrategy D) : ℝ :=
  expectedUsersWon p μ - cost p

/--
Positive score-level mass gives a strictly positive all-opponents tie-event
gain for at least two producers.
-/
theorem atomTieEventGain_positive {P : ℕ} [Nontrivial (Fin P)]
    {α : ℝ} (hα : 0 < α) :
    0 < α ^ (P - 1) * (1 - 1 / (P : ℝ)) := by
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_pos : 0 < (P : ℝ) := by exact_mod_cast (lt_trans Nat.zero_lt_one hP_nat)
  have hP_gt_one : 1 < (P : ℝ) := by exact_mod_cast hP_nat
  have hshare : 0 < 1 - 1 / (P : ℝ) := by
    have hinv_lt : 1 / (P : ℝ) < 1 := by
      rw [div_lt_one hP_pos]
      exact hP_gt_one
    linarith
  exact mul_pos (pow_pos hα _) hshare

/--
Increasing a focal content action in a nonnegative direction cannot reduce its
expected uniform-tie allocation against a symmetric mixed profile.  This is
the monotonicity input used when the source perturbs a profitable action away
from finitely many score atoms.
-/
theorem expectedUsersWonAgainstSymmetricMixed_le_nonnegative_perturb
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D}
    {μ : MeasureTheory.Measure (Content D)} [MeasureTheory.IsProbabilityMeasure μ]
    {p u : Content D} {j : Fin P} {ε : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (hu : NonnegativeContent u) (hε : 0 ≤ ε) :
    ExpectedUsersWonAgainstSymmetricMixed users j p μ ≤
      ExpectedUsersWonAgainstSymmetricMixed users j (p + ε • u) μ := by
  unfold ExpectedUsersWonAgainstSymmetricMixed
  apply MeasureTheory.integral_mono_ae
  · exact integrable_usersWon_deviateProfile_const users j p
  · simpa [Pi.add_apply, Pi.smul_apply] using
      (integrable_usersWon_deviateProfile_const users j (p + ε • u))
  · exact Filter.Eventually.of_forall fun profile => by
      simpa [Pi.add_apply, Pi.smul_apply] using
        (usersWon_le_deviate_replace_by_nonnegative_perturb
          (profile := profile) (p := p) (u := u) (j := j)
          husers_nonnegative hu hε)

/--
A positive mass at the score level of `p` for user `i0` creates a quantified
strict gain from an arbitrarily small positive perturbation in that user's
direction.  The event is a score-level event, so this result applies even to
an atomless content law whose score push-forward has an atom.
-/
theorem expectedUsersWonAgainstSymmetricMixed_scoreLevel_perturb_gain_lower_bound
    {D N P : ℕ} [Nontrivial (Fin P)] {users : Fin N → Content D}
    {μ : MeasureTheory.Measure (Content D)} [MeasureTheory.IsProbabilityMeasure μ]
    {p : Content D} {i0 : Fin N} {j : Fin P} {ε : ℝ}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0)) (hε : 0 < ε) :
    (1 - 1 / (P : ℝ)) *
        (μ.real {q : Content D | score (users i0) q = score (users i0) p}) ^ (P - 1) ≤
      ExpectedUsersWonAgainstSymmetricMixed users j
          (fun d => p d + ε * users i0 d) μ -
        ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  let productMeasure : MeasureTheory.Measure (Fin P → Content D) :=
    MeasureTheory.Measure.pi (fun _ : Fin P => μ)
  let level : Set (Content D) :=
    {q : Content D | score (users i0) q = score (users i0) p}
  let event : Set (Fin P → Content D) := AllOtherProducersInSet j level
  have hlevel : MeasurableSet level := by
    change MeasurableSet ((fun q : Content D => score (users i0) q) ⁻¹'
      ({score (users i0) p} : Set ℝ))
    exact MeasurableSet.preimage measurableSet_eq
      (measurable_score_content (users i0))
  have hevent : MeasurableSet event :=
    measurableSet_allOtherProducersInSet hlevel j
  have hbase : MeasureTheory.Integrable
      (fun profile : Fin P → Content D =>
        usersWon users (deviateProfile profile j p) j) productMeasure := by
    simpa [productMeasure] using
      (integrable_usersWon_deviateProfile_const users j p (μ := μ))
  have hpert : MeasureTheory.Integrable
      (fun profile : Fin P → Content D =>
        usersWon users (deviateProfile profile j (fun d => p d + ε * users i0 d)) j)
      productMeasure := by
    simpa [productMeasure] using
      (integrable_usersWon_deviateProfile_const users j
        (fun d => p d + ε * users i0 d) (μ := μ))
  have hmono :
      (fun profile : Fin P → Content D => usersWon users (deviateProfile profile j p) j)
        ≤ᵐ[productMeasure]
      fun profile =>
        usersWon users (deviateProfile profile j (fun d => p d + ε * users i0 d)) j :=
    Filter.Eventually.of_forall fun profile =>
      usersWon_le_deviate_replace_by_nonnegative_perturb
        (profile := profile) (p := p) (u := users i0) (j := j)
        husers_nonneg (husers_nonneg i0) hε.le
  have hpointwise : ∀ᵐ profile ∂productMeasure, profile ∈ event →
      1 - 1 / (P : ℝ) ≤
        usersWon users (deviateProfile profile j (fun d => p d + ε * users i0 d)) j -
          usersWon users (deviateProfile profile j p) j :=
    Filter.Eventually.of_forall fun profile hprofile =>
      usersWon_gain_allOtherProducersInScoreLevel_perturb_ge_one_sub_one_div
        (by simpa [event, level] using hprofile) husers_nonneg hzero hε
  have hcoefficient_nonnegative : 0 ≤ 1 - 1 / (P : ℝ) := by
    have hP_card : 1 < Fintype.card (Fin P) :=
      Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
    have hP_nat : 1 < P := by simpa using hP_card
    have hP_pos : 0 < (P : ℝ) := by exact_mod_cast (lt_trans Nat.zero_lt_one hP_nat)
    have hP_ge_one : 1 ≤ (P : ℝ) := by exact_mod_cast (Nat.le_of_lt hP_nat)
    have hinv_le : 1 / (P : ℝ) ≤ 1 := (div_le_one hP_pos).mpr hP_ge_one
    linarith
  have hgain := integral_gain_lower_bound_of_pointwise_event hevent hbase hpert hmono
    hpointwise hcoefficient_nonnegative
  change (1 - 1 / (P : ℝ)) * productMeasure.real event ≤
      ExpectedUsersWonAgainstSymmetricMixed users j
          (fun d => p d + ε * users i0 d) μ -
        ExpectedUsersWonAgainstSymmetricMixed users j p μ at hgain
  rw [show productMeasure.real event = (μ.real level) ^ (P - 1) by
    simpa [productMeasure, event] using
      (measureReal_allOtherProducersInSet_eq_pow (μ := μ) j level)] at hgain
  simpa [level] using hgain

/--
A positive score-level atom makes every action at that score level vulnerable
to a small profitable nonnegative perturbation.  The gain comes from the
positive product-probability event that all opponents share that score, while
one-sided cost continuity makes its cost loss arbitrarily small.
-/
theorem exists_nonnegative_profitable_scoreLevel_perturbation
    {D N P : ℕ} [Nontrivial (Fin P)] {users : Fin N → Content D}
    {μ : MeasureTheory.Measure (Content D)} [MeasureTheory.IsProbabilityMeasure μ]
    {p : Content D} {i0 : Fin N} {j : Fin P} {cost : Content D → ℝ}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hp : NonnegativeContent p) (hzero : NonzeroContent (users i0))
    (hcont : PerturbationCostContinuous cost)
    (hlevel_pos : 0 < μ.real {q : Content D | score (users i0) q = score (users i0) p}) :
    ∃ ε : ℝ, 0 < ε ∧
      NonnegativeContent (fun d => p d + ε * users i0 d) ∧
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ <
        SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost
          (fun d => p d + ε * users i0 d) μ := by
  let gain : ℝ :=
    (1 - 1 / (P : ℝ)) *
      (μ.real {q : Content D | score (users i0) q = score (users i0) p}) ^ (P - 1)
  have hgain_pos : 0 < gain := by
    dsimp [gain]
    rw [mul_comm]
    exact atomTieEventGain_positive hlevel_pos
  obtain ⟨ε, hε, hcost⟩ :=
    exists_positive_perturb_cost_increase_lt hcont hgain_pos
  refine ⟨ε, hε, perturbContent_nonnegative hp (husers_nonneg i0) hε.le, ?_⟩
  have hallocation :=
    expectedUsersWonAgainstSymmetricMixed_scoreLevel_perturb_gain_lower_bound
      (μ := μ) (p := p) (i0 := i0) (j := j) husers_nonneg hzero hε
  change gain ≤
      ExpectedUsersWonAgainstSymmetricMixed users j
          (fun d => p d + ε * users i0 d) μ -
        ExpectedUsersWonAgainstSymmetricMixed users j p μ at hallocation
  unfold SourceMixedPurePayoff
  linarith

/--
Under the ordinary law-level mixed-equilibrium consequences (no profitable
pure deviation and almost-everywhere payoff indifference), every user's score
push-forward is atomless.  This is stronger than content-law atomlessness: a
content law may have no point masses while a score map collapses a
positive-mass level set.  The proof selects an a.e.-equilibrium nonnegative
action from a hypothetical positive score level and applies the local
score-level perturbation lemma above.

The no-deviation premise ranges over the ambient nonnegative source action
space.  A compact-truncation application must separately show that the
selected perturbation remains in that compact action set; that boundary is not
suppressed by this ambient theorem.
-/
theorem score_level_measureReal_eq_zero_of_noProfitablePureDeviation_and_ae_equilibrium_payoff
    {D N P : ℕ} [Nontrivial (Fin P)] {users : Fin N → Content D}
    {μ : MeasureTheory.Measure (Content D)} [MeasureTheory.IsProbabilityMeasure μ]
    {cost : Content D → ℝ} {equilibriumPayoff : ℝ} {i0 : Fin N} {j : Fin P}
    (hno :
      SymmetricMixedNoProfitablePureDeviation
        (SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost)
        μ equilibriumPayoff)
    (hae_payoff : ∀ᵐ p ∂μ,
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ =
        equilibriumPayoff)
    (hae_nonnegative : ∀ᵐ p ∂μ, NonnegativeContent p)
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0))
    (hcont : PerturbationCostContinuous cost)
    (z : ℝ) :
    μ.real {q : Content D | score (users i0) q = z} = 0 := by
  let level : Set (Content D) := {q : Content D | score (users i0) q = z}
  have hlevel_meas : MeasurableSet level := by
    change MeasurableSet ((fun q : Content D => score (users i0) q) ⁻¹'
      ({z} : Set ℝ))
    exact MeasurableSet.preimage measurableSet_eq
      (measurable_score_content (users i0))
  by_contra hlevel_zero
  have hlevel_pos : 0 < μ.real level :=
    lt_of_le_of_ne MeasureTheory.measureReal_nonneg (Ne.symm hlevel_zero)
  have hlevel_measure_ne : μ level ≠ 0 := by
    intro hlevel_measure_zero
    rw [MeasureTheory.Measure.real, hlevel_measure_zero] at hlevel_pos
    norm_num at hlevel_pos
  have hgood : ∀ᵐ p ∂μ.restrict level,
      NonnegativeContent p ∧
        SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ =
          equilibriumPayoff :=
    (ae_restrict_of_ae hae_nonnegative).and (ae_restrict_of_ae hae_payoff)
  obtain ⟨p, hp_level, hp_nonnegative, hp_payoff⟩ :=
    MeasureTheory.Measure.exists_mem_of_measure_ne_zero_of_ae hlevel_measure_ne hgood
  have hp_score : score (users i0) p = z := hp_level
  have hp_level_pos :
      0 < μ.real {q : Content D | score (users i0) q = score (users i0) p} := by
    simpa only [hp_score] using hlevel_pos
  obtain ⟨ε, hε, hq_nonnegative, hprofitable⟩ :=
    exists_nonnegative_profitable_scoreLevel_perturbation
      (p := p) (i0 := i0) (j := j) husers_nonnegative hp_nonnegative hzero hcont
      hp_level_pos
  have hq_le :
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost
          (fun d => p d + ε * users i0 d) μ ≤ equilibriumPayoff :=
    hno _
  rw [hp_payoff] at hprofitable
  linarith

/--
The score levels carrying positive one-producer mass.  Proposition `existence`
perturbs a candidate action away from these atoms before applying its strict
score-event payoff formula.
-/
noncomputable def SourceScoreAtomValues {D : ℕ}
    (u : Content D) (μ : MeasureTheory.Measure (Content D)) : Set ℝ :=
  {z : ℝ | 0 < μ {q : Content D | score u q = z}}

/-- A measurable score law has only countably many positive-mass score levels. -/
theorem countable_sourceScoreAtomValues {D : ℕ}
    (u : Content D) (μ : MeasureTheory.Measure (Content D))
    [MeasureTheory.SFinite μ] :
    (SourceScoreAtomValues u μ).Countable := by
  exact MeasureTheory.Measure.countable_meas_level_set_pos
    (by
      unfold score
      fun_prop)

/--
For finitely many user scores whose values strictly increase along a
nonnegative direction, every positive radius contains a smaller positive
perturbation that avoids every one-producer score atom while remaining in the
source nonnegative action space.  This is the finite countability component of
the perturbation in Proposition `existence`; it does not itself establish the
separate strict payoff or weak-topology security comparison.
-/
theorem exists_small_score_atom_avoiding_perturbation
    {D N : ℕ} {users : Fin N → Content D}
    {μ : MeasureTheory.Measure (Content D)}
    {p direction : Content D} {ε : ℝ}
    [MeasureTheory.IsProbabilityMeasure μ]
    (hp : NonnegativeContent p) (hdirection : NonnegativeContent direction)
    (hdirection_score : ∀ i : Fin N, 0 < score (users i) direction)
    (hε : 0 < ε) :
    ∃ t : ℝ, 0 < t ∧ t < ε ∧ NonnegativeContent (p + t • direction) ∧
      ∀ i : Fin N,
        μ {q : Content D | score (users i) q = score (users i) (p + t • direction)} = 0 := by
  let atoms : Fin N → Set ℝ := fun i => SourceScoreAtomValues (users i) μ
  let scoreLine : Fin N → ℝ → ℝ := fun i t =>
    score (users i) p + t * score (users i) direction
  have hatoms_countable : ∀ i : Fin N, (atoms i).Countable := by
    intro i
    exact countable_sourceScoreAtomValues (users i) μ
  have hline_injective : ∀ i : Fin N, Function.Injective (scoreLine i) := by
    intro i x y hxy
    dsimp [scoreLine] at hxy
    nlinarith [hdirection_score i]
  let bad : Set ℝ := {t | ∃ i : Fin N, scoreLine i t ∈ atoms i}
  have hbad_countable : bad.Countable := by
    have hbad_eq : bad = ⋃ i : Fin N, scoreLine i ⁻¹' atoms i := by
      ext t
      simp [bad]
    rw [hbad_eq]
    exact Set.countable_iUnion fun i =>
      (hatoms_countable i).preimage (hline_injective i)
  have hexists : ∃ t : ℝ, t ∈ Set.Ioo (0 : ℝ) ε ∧ t ∉ bad := by
    by_contra hnone
    push Not at hnone
    have hsubset : Set.Ioo (0 : ℝ) ε ⊆ bad := by
      intro t ht
      exact hnone t ht
    have hinterval_countable : (Set.Ioo (0 : ℝ) ε).Countable :=
      hbad_countable.mono hsubset
    exact (not_le_of_gt hε)
      (Cardinal.Real.Ioo_countable_iff.mp hinterval_countable)
  rcases hexists with ⟨t, ht, ht_not_bad⟩
  refine ⟨t, ht.1, ht.2, ?_, ?_⟩
  · intro d
    change 0 ≤ p d + t * direction d
    exact add_nonneg (hp d) (mul_nonneg ht.1.le (hdirection d))
  · intro i
    have hscore_line : score (users i) (p + t • direction) = scoreLine i t := by
      dsimp [scoreLine]
      rw [score_add, score_smul]
    have hnot_pos : ¬ 0 <
        μ {q : Content D | score (users i) q = score (users i) (p + t • direction)} := by
      intro hpos
      apply ht_not_bad
      refine ⟨i, ?_⟩
      change 0 < μ {q : Content D | score (users i) q = scoreLine i t}
      rwa [← hscore_line]
    exact nonpos_iff_eq_zero.mp (le_of_not_gt hnot_pos)

/--
Source-model specialization of atom avoidance.  When every user embedding is
nonnegative and nonzero, the aggregate user direction has strictly positive
score for every user, so it supplies one common feasible perturbation
direction.
-/
theorem exists_small_score_atom_avoiding_aggregatePerturbation
    {D N : ℕ} {users : Fin N → Content D}
    {μ : MeasureTheory.Measure (Content D)} {p : Content D} {ε : ℝ}
    [MeasureTheory.IsProbabilityMeasure μ]
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hp : NonnegativeContent p) (hε : 0 < ε) :
    ∃ t : ℝ, 0 < t ∧ t < ε ∧
      NonnegativeContent (p + t • aggregateUsersContent users) ∧
      ∀ i : Fin N,
        μ {q : Content D |
          score (users i) q = score (users i) (p + t • aggregateUsersContent users)} = 0 := by
  exact exists_small_score_atom_avoiding_perturbation hp
    (aggregateUsersContent_nonnegative husers_nonnegative)
    (fun i => score_aggregateUsersContent_pos husers_nonnegative husers_nonzero i) hε

/--
Reindexing producer labels merely reindexes the set of score maximizers.  This
finite identity is the pointwise symmetry input for the diagonal mixed-payoff
calculation below; it retains the source's uniform tie rule exactly.
-/
theorem winningProducers_reindex {D P : ℕ}
    (u : Content D) (profile : Fin P → Content D) (e : Fin P ≃ Fin P) :
    winningProducers u (fun k => profile (e.symm k)) =
      (winningProducers u profile).map e.toEmbedding := by
  classical
  ext k
  constructor
  · intro hk
    rw [Finset.mem_map]
    refine ⟨e.symm k, ?_, ?_⟩
    · rw [mem_winningProducers] at hk ⊢
      intro l
      simpa using hk (e l)
    · simp
  · intro hk
    rw [Finset.mem_map] at hk
    rcases hk with ⟨l, hl, hEq⟩
    subst k
    rw [mem_winningProducers] at hl ⊢
    intro k
    obtain ⟨k', rfl⟩ := e.surjective k
    simpa using hl k'

/-- Uniform tie shares are invariant under a consistent reindexing of producer labels. -/
theorem tieShare_reindex {D P : ℕ}
    (u : Content D) (profile : Fin P → Content D) (e : Fin P ≃ Fin P) (j : Fin P) :
    tieShare u (fun k => profile (e.symm k)) (e j) = tieShare u profile j := by
  classical
  unfold tieShare
  rw [winningProducers_reindex]
  simp

/-- Expected user assignment reindexes together with the producer labels. -/
theorem usersWon_reindex {D N P : ℕ}
    (users : Fin N → Content D) (profile : Fin P → Content D)
    (e : Fin P ≃ Fin P) (j : Fin P) :
    usersWon users (fun k => profile (e.symm k)) (e j) =
      usersWon users profile j := by
  classical
  unfold usersWon
  apply Finset.sum_congr rfl
  intro i _
  exact tieShare_reindex (users i) profile e j

/--
With one fixed pure deviation and iid opponents, expected assigned-user mass
is independent of the focal producer label.  This is the off-diagonal
label-invariance fact needed for mixed-quasi-symmetry, strengthening the
diagonal-only reindexing calculation below.
-/
theorem expectedUsersWonAgainstSymmetricMixed_eq_of_focalProducer
    {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (μ : MeasureTheory.Measure (Content D))
    [MeasureTheory.IsProbabilityMeasure μ] (j k : Fin P) (p : Content D) :
    ExpectedUsersWonAgainstSymmetricMixed users j p μ =
      ExpectedUsersWonAgainstSymmetricMixed users k p μ := by
  classical
  let e : Fin P ≃ Fin P := Equiv.swap j k
  let E : (Fin P → Content D) ≃ᵐ (Fin P → Content D) :=
    MeasurableEquiv.piCongrLeft (fun _ : Fin P => Content D) e
  have hE : ∀ profile : Fin P → Content D,
      E profile = fun l => profile (e.symm l) := by
    intro profile
    funext l
    obtain ⟨l', rfl⟩ := e.surjective l
    simpa [E] using
      (MeasurableEquiv.piCongrLeft_apply_apply
        (β := fun _ : Fin P => Content D) e profile l')
  have hpres : MeasureTheory.MeasurePreserving E
      (MeasureTheory.Measure.pi (fun _ : Fin P => μ))
      (MeasureTheory.Measure.pi (fun _ : Fin P => μ)) := by
    simpa [E] using
      (MeasureTheory.measurePreserving_piCongrLeft
        (fun _ : Fin P => μ) e)
  have htransport := hpres.integral_comp'
    (fun profile : Fin P → Content D =>
      usersWon users (deviateProfile profile (e j) p) (e j))
  unfold ExpectedUsersWonAgainstSymmetricMixed
  change (∫ profile : Fin P → Content D,
      usersWon users (deviateProfile profile j p) j ∂
        MeasureTheory.Measure.pi (fun _ : Fin P => μ)) =
    ∫ profile : Fin P → Content D,
      usersWon users (deviateProfile profile k p) k ∂
        MeasureTheory.Measure.pi (fun _ : Fin P => μ)
  have hej : e j = k := by simp [e]
  rw [← hej]
  rw [← htransport]
  apply MeasureTheory.integral_congr_ae
  exact Filter.Eventually.of_forall fun profile => by
    have hdeviate :
        deviateProfile (E profile) (e j) p =
          fun l => (deviateProfile profile j p) (e.symm l) := by
      ext l
      rw [hE profile]
      by_cases hl : l = e j
      · subst l
        simp [deviateProfile]
      · have hsymm : e.symm l ≠ j := by
          intro h
          apply hl
          simpa using congrArg e h
        simp [deviateProfile, hl, hsymm]
    change usersWon users (deviateProfile profile j p) j =
      usersWon users (deviateProfile (E profile) (e j) p) (e j)
    rw [hdeviate]
    exact (usersWon_reindex users (deviateProfile profile j p) e j).symm

/--
Expected assigned-user mass when every producer independently draws from the
same mixed strategy.  This is the diagonal mixed extension of the source's
uniform-tie payoff, represented directly by its iid full-profile law.
-/
noncomputable def SymmetricMixedDiagonalExpectedUsersWon {D N P : ℕ}
    (users : Fin N → Content D) (j : Fin P)
    (μ : MeasureTheory.Measure (Content D)) : ℝ :=
  ∫ profile : Fin P → Content D, usersWon users profile j ∂
    MeasureTheory.Measure.pi (fun _ : Fin P => μ)

/--
The expected user mass of a producer whose own action is drawn from the same
law as every opponent is exactly the iid diagonal expected-user functional.
This is the missing source-to-mixed-extension bridge for the existence proof.
-/
theorem integral_expectedUsersWonAgainstSymmetricMixed_eq_symmetricMixedDiagonal
    {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (j : Fin P) (μ : MeasureTheory.Measure (Content D))
    [MeasureTheory.IsProbabilityMeasure μ] :
    ∫ p, ExpectedUsersWonAgainstSymmetricMixed users j p μ ∂μ =
      SymmetricMixedDiagonalExpectedUsersWon users j μ := by
  cases P with
  | zero => exact Fin.elim0 j
  | succ P =>
      simpa [ExpectedUsersWonAgainstSymmetricMixed, SymmetricMixedDiagonalExpectedUsersWon] using
        (integral_iid_deviateProfile_eq_diagonal (D := D) (P := P) μ j
          (fun profile => usersWon users profile j)
          (measurable_usersWon users j).stronglyMeasurable (N : ℝ) (by
            intro profile
            rw [Real.norm_eq_abs, abs_of_nonneg (usersWon_nonneg users profile j)]
            exact usersWon_le_card users profile j))

/--
At an iid symmetric mixed profile, expected assigned-user mass is the same
for every producer.  The proof uses an explicit permutation of the product
measure, rather than silently treating the uniform-tie payoff as continuous.
-/
theorem symmetricMixedDiagonalExpectedUsersWon_eq {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (μ : MeasureTheory.Measure (Content D))
    [MeasureTheory.IsProbabilityMeasure μ] (j k : Fin P) :
    SymmetricMixedDiagonalExpectedUsersWon users j μ =
      SymmetricMixedDiagonalExpectedUsersWon users k μ := by
  classical
  let e : Fin P ≃ Fin P := Equiv.swap j k
  let E : (Fin P → Content D) ≃ᵐ (Fin P → Content D) :=
    MeasurableEquiv.piCongrLeft (fun _ : Fin P => Content D) e
  have hE : ∀ profile : Fin P → Content D,
      E profile = fun l => profile (e.symm l) := by
    intro profile
    funext l
    obtain ⟨l', rfl⟩ := e.surjective l
    simpa [E] using
      (MeasurableEquiv.piCongrLeft_apply_apply
        (β := fun _ : Fin P => Content D) e profile l')
  have hpres : MeasureTheory.MeasurePreserving E
      (MeasureTheory.Measure.pi (fun _ : Fin P => μ))
      (MeasureTheory.Measure.pi (fun _ : Fin P => μ)) := by
    simpa [E] using
      (MeasureTheory.measurePreserving_piCongrLeft
        (fun _ : Fin P => μ) e)
  have htransport := hpres.integral_comp'
    (fun profile : Fin P → Content D => usersWon users profile (e j))
  unfold SymmetricMixedDiagonalExpectedUsersWon
  change (∫ profile : Fin P → Content D, usersWon users profile j ∂
      MeasureTheory.Measure.pi (fun _ : Fin P => μ)) =
    ∫ profile : Fin P → Content D, usersWon users profile k ∂
      MeasureTheory.Measure.pi (fun _ : Fin P => μ)
  have hej : e j = k := by simp [e]
  rw [← hej]
  rw [← htransport]
  apply MeasureTheory.integral_congr_ae
  exact Filter.Eventually.of_forall fun profile => by
    change usersWon users profile j = usersWon users (E profile) (e j)
    rw [hE profile]
    exact (usersWon_reindex users profile e j).symm

/--
The source's diagonal expected-user identity: under the iid symmetric mixed
profile and uniform tie breaking, the producer masses sum to the number of
users.
-/
theorem sum_symmetricMixedDiagonalExpectedUsersWon_eq_card {D N P : ℕ}
    [Nonempty (Fin P)] (users : Fin N → Content D)
    (μ : MeasureTheory.Measure (Content D))
    [MeasureTheory.IsProbabilityMeasure μ] :
    ∑ j : Fin P, SymmetricMixedDiagonalExpectedUsersWon users j μ = (N : ℝ) := by
  unfold SymmetricMixedDiagonalExpectedUsersWon
  rw [← MeasureTheory.integral_finset_sum]
  · calc
      (∫ profile : Fin P → Content D, ∑ j : Fin P, usersWon users profile j ∂
          MeasureTheory.Measure.pi (fun _ : Fin P => μ)) =
        ∫ _profile : Fin P → Content D, (N : ℝ) ∂
          MeasureTheory.Measure.pi (fun _ : Fin P => μ) := by
            apply MeasureTheory.integral_congr_ae
            exact Filter.Eventually.of_forall fun profile =>
              sum_usersWon_eq_card users profile
      _ = (N : ℝ) := by simp
  · intro j _
    exact integrable_usersWon_of_measurable
      (MeasureTheory.Measure.pi (fun _ : Fin P => μ))
      (measurable_usersWon users j)

/--
Every producer receives exactly `N / P` expected users at an iid symmetric
mixed profile.  This is the formally checked version of the diagonal-payoff
identity used in Proposition `existence` (`arxiv-update.tex:858-862`).
-/
theorem symmetricMixedDiagonalExpectedUsersWon_eq_card_div {D N P : ℕ}
    [Nonempty (Fin P)] (users : Fin N → Content D)
    (μ : MeasureTheory.Measure (Content D))
    [MeasureTheory.IsProbabilityMeasure μ] (j : Fin P) :
    SymmetricMixedDiagonalExpectedUsersWon users j μ = (N : ℝ) / (P : ℝ) := by
  have hsum : ∑ k : Fin P,
      SymmetricMixedDiagonalExpectedUsersWon users k μ = (N : ℝ) :=
    sum_symmetricMixedDiagonalExpectedUsersWon_eq_card users μ
  have hP_pos : 0 < (P : ℝ) := by
    have hP_nat : 0 < P := by
      simpa using
        (Fintype.card_pos_iff.mpr inferInstance : 0 < Fintype.card (Fin P))
    exact_mod_cast hP_nat
  apply (eq_div_iff hP_pos.ne').mpr
  calc
    SymmetricMixedDiagonalExpectedUsersWon users j μ * (P : ℝ) =
        ∑ _k : Fin P, SymmetricMixedDiagonalExpectedUsersWon users j μ := by
          simp [Finset.sum_const, nsmul_eq_mul, mul_comm]
    _ = ∑ k : Fin P, SymmetricMixedDiagonalExpectedUsersWon users k μ := by
      apply Finset.sum_congr rfl
      intro k _
      exact symmetricMixedDiagonalExpectedUsersWon_eq users μ j k
    _ = (N : ℝ) := hsum

/--
The diagonal mixed payoff in the source game.  When the cost is integrable,
this is exactly a producer's expected profit under iid play from `μ`.
-/
noncomputable def SourceSymmetricMixedDiagonalPayoff {D N P : ℕ}
    (users : Fin N → Content D) (cost : Content D → ℝ) (j : Fin P)
    (μ : MeasureTheory.Measure (Content D)) : ℝ :=
  SymmetricMixedDiagonalExpectedUsersWon users j μ - ∫ p, cost p ∂μ

/--
The expectation of the source pure-deviation payoff under the same iid law
equals the source symmetric mixed diagonal payoff.  The two integrability
premises make the subtraction rule explicit; they are supplied by compactness
in the truncated mixed-extension application below.
-/
theorem integral_sourceMixedPurePayoff_eq_sourceSymmetricMixedDiagonalPayoff
    {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (cost : Content D → ℝ) (j : Fin P)
    (μ : MeasureTheory.Measure (Content D)) [MeasureTheory.IsProbabilityMeasure μ]
    (hcost : MeasureTheory.Integrable cost μ)
    (hsource : MeasureTheory.Integrable
      (fun p => SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ) μ) :
    ∫ p, SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ ∂μ =
      SourceSymmetricMixedDiagonalPayoff users cost j μ := by
  have halloc : MeasureTheory.Integrable
      (fun p => ExpectedUsersWonAgainstSymmetricMixed users j p μ) μ := by
    convert hsource.add hcost using 1
    ext p
    simp [SourceMixedPurePayoff]
  unfold SourceMixedPurePayoff SourceSymmetricMixedDiagonalPayoff
  rw [MeasureTheory.integral_sub halloc hcost,
    integral_expectedUsersWonAgainstSymmetricMixed_eq_symmetricMixedDiagonal]

/--
The full diagonal payoff formula used by the source existence proof.  The
integrability premise gives the cost integral its expected-cost meaning; the
uniform-tie user-allocation equality itself needs no continuity hypothesis.
-/
theorem sourceSymmetricMixedDiagonalPayoff_eq_card_div_sub_integral
    {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (cost : Content D → ℝ)
    (μ : MeasureTheory.Measure (Content D))
    [MeasureTheory.IsProbabilityMeasure μ] (j : Fin P)
    (_hcost : MeasureTheory.Integrable cost μ) :
    SourceSymmetricMixedDiagonalPayoff users cost j μ =
      (N : ℝ) / (P : ℝ) - ∫ p, cost p ∂μ := by
  unfold SourceSymmetricMixedDiagonalPayoff
  rw [symmetricMixedDiagonalExpectedUsersWon_eq_card_div users μ j]

/--
If every user embedding is zero, every pure action receives the same expected
uniform-tie user mass against any symmetric probability law.  This isolates
the degenerate configuration excluded by the corrected atomlessness theorem.
-/
theorem expectedUsersWonAgainstSymmetricMixed_zeroUsers_eq_card_mul_inv
    {D N P : ℕ} [Nonempty (Fin P)]
    {j : Fin P} {p : Content D} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ] :
    ExpectedUsersWonAgainstSymmetricMixed (fun _ : Fin N => (0 : Content D)) j p μ =
      (N : ℝ) * (P : ℝ)⁻¹ := by
  unfold ExpectedUsersWonAgainstSymmetricMixed
  have hpointwise :
      ∀ profile : Fin P → Content D,
        usersWon (fun _ : Fin N => (0 : Content D))
          (deviateProfile profile j p) j = (N : ℝ) * (P : ℝ)⁻¹ := by
    intro profile
    exact usersWon_zeroUsers_eq_card_mul_inv
      (deviateProfile profile j p) j
  rw [MeasureTheory.integral_congr_ae
    (Filter.Eventually.of_forall hpointwise), MeasureTheory.integral_const]
  simp

theorem expectedUsersWonAgainstSymmetricMixed_scaleUsers_pos
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {p : Content D} {μ : MeasureTheory.Measure (Content D)}
    {scale : Fin N → ℝ} (hscale : ∀ i : Fin N, 0 < scale i) :
    ExpectedUsersWonAgainstSymmetricMixed
        (fun i => scaleContent (scale i) (users i)) j p μ =
      ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  unfold ExpectedUsersWonAgainstSymmetricMixed
  apply MeasureTheory.integral_congr_ae
  exact Filter.Eventually.of_forall fun profile =>
    usersWon_scaleUsers_pos (users := users)
      (profile := deviateProfile profile j p) (j := j) hscale

/-- Pushing an iid content law through a common positive content scale and
scaling the focal action by the same factor leaves the actual uniform-tie
allocation unchanged.  The product-measure step is explicit: this is not an
informal identification of scaled iid profiles. -/
theorem expectedUsersWonAgainstSymmetricMixed_scaleContent_map
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {p : Content D} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ] {a : ℝ} (ha : 0 < a) :
    ExpectedUsersWonAgainstSymmetricMixed users j (scaleContent a p)
      (MeasureTheory.Measure.map (scaleContent a) μ) =
      ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  let profileScale : (Fin P → Content D) → Fin P → Content D :=
    fun profile k => scaleContent a (profile k)
  have hprofileScale_meas : Measurable profileScale := by
    simpa [profileScale] using (measurable_scaleProfile (D := D) (P := P) a)
  have hpi : MeasureTheory.Measure.map profileScale
      (MeasureTheory.Measure.pi (fun _ : Fin P => μ)) =
      MeasureTheory.Measure.pi (fun _ : Fin P =>
        MeasureTheory.Measure.map (scaleContent a) μ) := by
    simpa [profileScale] using
      (MeasureTheory.Measure.pi_map_pi (μ := fun _ : Fin P => μ)
        (fun _ => (measurable_scaleContent a).aemeasurable))
  unfold ExpectedUsersWonAgainstSymmetricMixed
  rw [← hpi]
  rw [MeasureTheory.integral_map hprofileScale_meas.aemeasurable
    (measurable_usersWon_deviateProfile_const users j
      (scaleContent a p)).aestronglyMeasurable]
  apply MeasureTheory.integral_congr_ae
  exact Filter.Eventually.of_forall fun profile => by
    change usersWon users
        (deviateProfile (profileScale profile) j (scaleContent a p)) j =
      usersWon users (deviateProfile profile j p) j
    rw [← scaleProfile_deviateProfile profile j p a]
    exact usersWon_scaleProfile_pos ha

/-- Repeating each of two user types `K` times scales the symmetric mixed
assigned-user payoff by `K`. -/
theorem expectedUsersWonAgainstSymmetricMixed_twoPopulationUsers
    {D K P : ℕ} (users : Fin 2 → Content D) {j : Fin P}
    {p : Content D} {μ : MeasureTheory.Measure (Content D)} :
    ExpectedUsersWonAgainstSymmetricMixed (twoPopulationUsers K users) j p μ =
      (K : ℝ) * ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  unfold ExpectedUsersWonAgainstSymmetricMixed
  simp_rw [usersWon_twoPopulationUsers]
  rw [MeasureTheory.integral_const_mul]

/-- The two-population payoff is a positive scalar multiple of the
corresponding two-user payoff after the source cost rescaling. -/
theorem sourceMixedPurePayoff_twoPopulationUsers_eq_mul
    {D K P : ℕ} (users : Fin 2 → Content D) {j : Fin P}
    {p : Content D} {μ : MeasureTheory.Measure (Content D)}
    {cost : Content D → ℝ} (hK : 0 < K) :
    SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed (twoPopulationUsers K users) j)
        cost p μ =
      (K : ℝ) *
        SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
          (fun q => (K : ℝ)⁻¹ * cost q) p μ := by
  unfold SourceMixedPurePayoff
  rw [expectedUsersWonAgainstSymmetricMixed_twoPopulationUsers]
  have hK_real : (K : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt hK)
  field_simp [hK_real]

/--
The expected assigned-user mass against a symmetric mixed profile is
nonnegative.  This is the mixed-strategy version of the source fact that the
zero action gives a nonnegative outside option.
-/
theorem expectedUsersWonAgainstSymmetricMixed_nonneg
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {p : Content D} {μ : MeasureTheory.Measure (Content D)} :
    0 ≤ ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  unfold ExpectedUsersWonAgainstSymmetricMixed
  exact MeasureTheory.integral_nonneg_of_ae
    (Filter.Eventually.of_forall fun profile =>
      usersWon_nonneg users (deviateProfile profile j p) j)

/--
The expected assigned-user mass against a symmetric mixed profile is at most
the number of users.  This formalizes the source proof's upper bound on the
payoff of a support-radius action.
-/
theorem expectedUsersWonAgainstSymmetricMixed_le_card
    {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P}
    {p : Content D} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ]
    (hint :
      MeasureTheory.Integrable
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j p) j)
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ))) :
    ExpectedUsersWonAgainstSymmetricMixed users j p μ ≤ (N : ℝ) := by
  unfold ExpectedUsersWonAgainstSymmetricMixed
  have hle_ae :
      (fun profile : Fin P → Content D =>
        usersWon users (deviateProfile profile j p) j) ≤ᵐ[
          MeasureTheory.Measure.pi (fun _ : Fin P => μ)]
        fun _profile : Fin P → Content D => (N : ℝ) :=
    Filter.Eventually.of_forall fun profile =>
      usersWon_le_card users (deviateProfile profile j p) j
  have hconst_int :
      MeasureTheory.Integrable
        (fun _profile : Fin P → Content D => (N : ℝ))
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)) :=
    MeasureTheory.integrable_const (N : ℝ)
  have hle :=
    MeasureTheory.integral_mono_ae hint hconst_int hle_ae
  simpa [MeasureTheory.integral_const] using hle

/--
With a fixed focal action, level-null score laws turn the source's uniform
tie-sharing rule into a strict-score event.  This is deliberately stated for
one user and one realized full profile; the product-measure reduction below
keeps both the score-null premise and the independence calculation visible.
-/
private theorem tieShare_deviate_eq_indicator_of_no_score_ties
    {D P : ℕ} {u p : Content D} {profile : Fin P → Content D} {j : Fin P}
    (hne : ∀ k : Fin P, k ≠ j → score u (profile k) ≠ score u p) :
    tieShare u (deviateProfile profile j p) j =
      (AllOtherProducersInSet j {q : Content D | score u q < score u p}).indicator
        (fun _ : Fin P → Content D => (1 : ℝ)) profile := by
  classical
  by_cases hstrict : profile ∈
      AllOtherProducersInSet j {q : Content D | score u q < score u p}
  · rw [Set.indicator_of_mem hstrict]
    apply tieShare_eq_one_of_strictWinner
    intro k hk
    simpa [deviateProfile, hk] using hstrict k hk
  · rw [Set.indicator_of_notMem hstrict]
    apply tieShare_eq_zero_of_not_mem
    rw [mem_winningProducers]
    intro hwin
    apply hstrict
    intro k hk
    have hle : score u (profile k) ≤ score u p := by
      simpa [deviateProfile, hk] using hwin k
    exact lt_of_le_of_ne hle (hne k hk)

/--
If every score level has zero one-producer mass, then almost every full
product-profile has no opponent tied with a fixed focal score.
-/
private theorem allOtherProducers_score_ne_ae
    {D P : ℕ} {u p : Content D} {j : Fin P}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ]
    (hno_atom : ∀ z : ℝ, μ {q : Content D | score u q = z} = 0) :
    ∀ᵐ profile ∂Measure.pi (fun _ : Fin P => μ),
      ∀ k : Fin P, k ≠ j → score u (profile k) ≠ score u p := by
  rw [Filter.eventually_all]
  intro k
  by_cases hkj : k = j
  · subst k
    exact Filter.Eventually.of_forall fun _ hk => False.elim (hk rfl)
  · have hne : ∀ᵐ profile ∂Measure.pi (fun _ : Fin P => μ),
        score u (profile k) ≠ score u p := by
      rw [ae_iff]
      simp only [not_not]
      change Measure.pi (fun _ : Fin P => μ)
        (Function.eval k ⁻¹' {q : Content D | score u q = score u p}) = 0
      exact Measure.pi_eval_preimage_null _ (hno_atom _)
    exact hne.mono fun _ h _ => h

/--
Tie-aware strict-score lower bound.  Regardless of score atoms, if every
opponent scores strictly below the focal action for a user, the focal producer
wins that user outright.  Independence therefore gives the corresponding
strict-score probability power as a lower bound on the actual uniform-tie
expected allocation.  Equality needs the separate score-level-null premise.
-/
theorem expectedUsersWonAgainstSymmetricMixed_ge_sum_strictScoreMass
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D} {j : Fin P}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ] (p : Content D)
    (hmeas_score : ∀ i : Fin N, Measurable (fun q : Content D => score (users i) q)) :
    ∑ i : Fin N,
      (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1) ≤
      ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  classical
  let productMeasure : Measure (Fin P → Content D) :=
    Measure.pi (fun _ : Fin P => μ)
  let E : Fin N → Set (Content D) := fun i =>
    {q : Content D | score (users i) q < score (users i) p}
  let A : Fin N → Set (Fin P → Content D) := fun i =>
    AllOtherProducersInSet j (E i)
  have hE : ∀ i : Fin N, MeasurableSet (E i) := by
    intro i
    exact measurableSet_lt (hmeas_score i) measurable_const
  have hA : ∀ i : Fin N, MeasurableSet (A i) := by
    intro i
    exact measurableSet_allOtherProducersInSet (hE i) j
  have hint : ∀ i : Fin N,
      Integrable ((A i).indicator (fun _ : Fin P → Content D => (1 : ℝ))) productMeasure := by
    intro i
    exact (integrable_const (1 : ℝ)).indicator (hA i)
  have hpointwise : ∀ profile : Fin P → Content D,
      (∑ i : Fin N,
          (A i).indicator (fun _ : Fin P → Content D => (1 : ℝ)) profile) ≤
        usersWon users (deviateProfile profile j p) j := by
    intro profile
    rw [usersWon]
    apply Finset.sum_le_sum
    intro i _
    by_cases hmem : profile ∈ A i
    · rw [Set.indicator_of_mem hmem]
      have hstrict : StrictWinner (users i) (deviateProfile profile j p) j := by
        intro k hk
        simpa [A, E, deviateProfile, hk] using hmem k hk
      rw [tieShare_eq_one_of_strictWinner hstrict]
    · rw [Set.indicator_of_notMem hmem]
      exact tieShare_nonneg (users i) (deviateProfile profile j p) j
  have hsum_int :
      Integrable
        (fun profile : Fin P → Content D =>
          ∑ i : Fin N,
            (A i).indicator (fun _ : Fin P → Content D => (1 : ℝ)) profile)
        productMeasure := by
    apply integrable_finset_sum
    intro i _
    exact hint i
  have hright_int :
      Integrable
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j p) j)
        productMeasure := by
    simpa [productMeasure] using
      integrable_usersWon_deviateProfile_const (users := users) (j := j) (p := p) (μ := μ)
  have hint_le :
      (∫ profile, ∑ i : Fin N,
          (A i).indicator (fun _ : Fin P → Content D => (1 : ℝ)) profile ∂productMeasure) ≤
        ∫ profile, usersWon users (deviateProfile profile j p) j ∂productMeasure :=
    integral_mono_ae hsum_int hright_int (Filter.Eventually.of_forall hpointwise)
  calc
    ∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1) =
        ∑ i : Fin N, productMeasure.real (A i) := by
      apply Finset.sum_congr rfl
      intro i _
      symm
      simpa [productMeasure, A] using
        measureReal_allOtherProducersInSet_eq_pow (μ := μ) j (E i)
    _ = ∑ i : Fin N,
        ∫ profile, (A i).indicator (fun _ : Fin P → Content D => (1 : ℝ)) profile
          ∂productMeasure := by
      apply Finset.sum_congr rfl
      intro i _
      symm
      simpa using (integral_indicator_one (μ := productMeasure) (hA i))
    _ = ∫ profile, ∑ i : Fin N,
        (A i).indicator (fun _ : Fin P → Content D => (1 : ℝ)) profile ∂productMeasure := by
      rw [integral_finset_sum]
      intro i _
      exact hint i
    _ ≤ ∫ profile, usersWon users (deviateProfile profile j p) j ∂productMeasure := hint_le
    _ = ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
      rfl

/--
Monotone composition of the tie-aware strict-score lower bound with arbitrary
nonnegative lower bounds on the individual strict-score masses.  The natural
power is monotone only on nonnegative inputs, which is why a Prokhorov error
term must be clipped at zero before this lemma is used.
-/
theorem expectedUsersWonAgainstSymmetricMixed_ge_sum_pow_of_strictScoreMass_lowerBounds
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D} {j : Fin P}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ] (p : Content D)
    (hmeas_score : ∀ i : Fin N, Measurable (fun q : Content D => score (users i) q))
    (lower : Fin N → ℝ)
    (hlower_nonnegative : ∀ i : Fin N, 0 ≤ lower i)
    (hlower_score : ∀ i : Fin N,
      lower i ≤ μ.real {q : Content D | score (users i) q < score (users i) p}) :
    (∑ i : Fin N, (lower i) ^ (P - 1)) ≤
      ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  calc
    (∑ i : Fin N, (lower i) ^ (P - 1)) ≤
        ∑ i : Fin N,
          (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1) := by
      apply Finset.sum_le_sum
      intro i _
      exact pow_le_pow_left₀ (hlower_nonnegative i) (hlower_score i) _
    _ ≤ ExpectedUsersWonAgainstSymmetricMixed users j p μ :=
      expectedUsersWonAgainstSymmetricMixed_ge_sum_strictScoreMass p hmeas_score

/--
Prokhorov-neighborhood version of the tie-aware strict-score lower bound.
If an `ε`-thickening of each baseline strict-score event lies within the
candidate strict-score event, every nearby law retains the baseline mass less
the usual `ε` error.  The error is clipped at zero before taking a natural
power; without this clip the paper's displayed power inequality is not valid
for a zero-probability user event.
-/
theorem expectedUsersWonAgainstSymmetricMixed_ge_sum_prokhorov_lowerBound
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D} {j : Fin P}
    {μ ν : Measure (Content D)} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    {ε : ENNReal} (hε : ε ≠ ⊤)
    (hdist : levyProkhorovEDist μ ν < ε)
    (p : Content D)
    (threshold : Fin N → ℝ)
    (hmeas_score : ∀ i : Fin N, Measurable (fun q : Content D => score (users i) q))
    (hthickening : ∀ i : Fin N,
      Metric.thickening ε.toReal {q : Content D | score (users i) q < threshold i} ⊆
        {q : Content D | score (users i) q < score (users i) p}) :
    (∑ i : Fin N,
      (max 0 (μ.real {q : Content D | score (users i) q < threshold i} - ε.toReal)) ^
        (P - 1)) ≤
      ExpectedUsersWonAgainstSymmetricMixed users j p ν := by
  apply expectedUsersWonAgainstSymmetricMixed_ge_sum_pow_of_strictScoreMass_lowerBounds
    p hmeas_score
  · intro i
    exact le_max_left _ _
  · intro i
    apply max_le
    · positivity
    · have htransfer :=
        AppliedModelingLib.measureProb_sub_le_measureProb_of_levyProkhorovEDist_lt_of_thickening_subset
          hε hdist
          (measurableSet_lt (hmeas_score i) measurable_const)
          (hthickening i)
      simpa [AppliedModelingLib.measureProb] using htransfer

/--
The source score map is Lipschitz for the ambient finite product metric.  The
explicit `L1` constant provides a finite-dimensional metric route for the
Prokhorov neighborhood argument.
-/
theorem score_le_score_add_l1_mul_dist {D : ℕ}
    (u q r : Content D) :
    score u q ≤ score u r + AppliedModelingLib.FiniteDimensionalNorms.l1 u * dist q r := by
  simpa [score, AppliedModelingLib.FiniteDimensionalNorms.dot] using
    AppliedModelingLib.FiniteDimensionalNorms.dot_le_dot_add_l1_mul_dist u q r

/-- The source's literal Euclidean distance between two content vectors. -/
noncomputable def sourceL2Distance {D : ℕ} (q r : Content D) : ℝ :=
  AppliedModelingLib.FiniteDimensionalNorms.l2 (fun d => q d - r d)

/--
The Euclidean thickening specified in the source proof, stated on the
coordinate content model without replacing it by Lean's default product
metric.
-/
def sourceL2Thickening {D : ℕ} (δ : ℝ) (E : Set (Content D)) : Set (Content D) :=
  {q | ∃ r ∈ E, sourceL2Distance q r < δ}

/-- The source score is `L2`-Lipschitz for its literal Euclidean metric. -/
theorem score_le_score_add_l2_mul_sourceL2Distance {D : ℕ}
    (u q r : Content D) :
    score u q ≤ score u r +
      AppliedModelingLib.FiniteDimensionalNorms.l2 u * sourceL2Distance q r := by
  simpa [score, sourceL2Distance, AppliedModelingLib.FiniteDimensionalNorms.dot] using
    AppliedModelingLib.FiniteDimensionalNorms.dot_le_dot_add_l2_mul_l2_sub u q r

/--
Exact `L2` score-event geometry from Proposition `existence`: an Euclidean
thickening of the event with score margin `δ * ||u||_2` lies in the candidate
strict-score event.  This is the source's displayed `A_i^δ` calculation.
-/
theorem sourceL2Thickening_strict_score_event_subset {D : ℕ}
    (u p : Content D) (δ : ℝ) :
    sourceL2Thickening δ
        {q : Content D |
          score u q < score u p - δ * AppliedModelingLib.FiniteDimensionalNorms.l2 u} ⊆
      {q : Content D | score u q < score u p} := by
  intro q hq
  rcases hq with ⟨r, hr, hdist⟩
  change score u r < score u p - δ * AppliedModelingLib.FiniteDimensionalNorms.l2 u at hr
  rw [mul_comm δ] at hr
  have hscore := score_le_score_add_l2_mul_sourceL2Distance u q r
  have hscale :
      AppliedModelingLib.FiniteDimensionalNorms.l2 u * sourceL2Distance q r ≤
        AppliedModelingLib.FiniteDimensionalNorms.l2 u * δ :=
    mul_le_mul_of_nonneg_left hdist.le
      (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg u)
  have hupper : score u q ≤
      score u r + AppliedModelingLib.FiniteDimensionalNorms.l2 u * δ :=
    hscore.trans (add_le_add (le_refl _) hscale)
  exact lt_of_le_of_lt hupper (by linarith)

/--
Finite-dimensional score-event geometry for the ambient product metric: an
action within radius `δ` of an action whose score lies below the candidate by
the `L1`-Lipschitz margin still has strictly lower score than the candidate.
-/
theorem metric_thickening_strict_score_event_subset {D : ℕ}
    (u p : Content D) (δ : ℝ) :
    Metric.thickening δ
        {q : Content D |
          score u q < score u p - δ * AppliedModelingLib.FiniteDimensionalNorms.l1 u} ⊆
      {q : Content D | score u q < score u p} := by
  intro q hq
  rcases Metric.mem_thickening_iff.mp hq with ⟨r, hr, hdist⟩
  change score u r < score u p - δ * AppliedModelingLib.FiniteDimensionalNorms.l1 u at hr
  rw [mul_comm δ] at hr
  have hscore :
      score u q ≤ score u r + AppliedModelingLib.FiniteDimensionalNorms.l1 u * dist q r :=
    score_le_score_add_l1_mul_dist u q r
  have hscale :
      AppliedModelingLib.FiniteDimensionalNorms.l1 u * dist q r ≤
        AppliedModelingLib.FiniteDimensionalNorms.l1 u * δ :=
    mul_le_mul_of_nonneg_left hdist.le
      (AppliedModelingLib.FiniteDimensionalNorms.normL1_nonneg u)
  have hupper : score u q ≤
      score u r + AppliedModelingLib.FiniteDimensionalNorms.l1 u * δ :=
    hscore.trans (add_le_add (le_refl _) hscale)
  exact lt_of_le_of_lt hupper (by linarith)

/--
Concrete ambient-product-metric Prokhorov lower bound for the source score
game.  It discharges the metric-thickening premise by the finite-dimensional
`L1` score Lipschitz estimate; no score-atom or tie-free assumption is used.
-/
theorem expectedUsersWonAgainstSymmetricMixed_ge_sum_prokhorov_l1ScoreMargin
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D} {j : Fin P}
    {μ ν : Measure (Content D)} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    {ε : ENNReal} (hε : ε ≠ ⊤)
    (hdist : levyProkhorovEDist μ ν < ε)
    (p : Content D) :
    (∑ i : Fin N,
      (max 0 (μ.real
        {q : Content D |
          score (users i) q < score (users i) p -
            ε.toReal * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)} - ε.toReal)) ^
        (P - 1)) ≤
      ExpectedUsersWonAgainstSymmetricMixed users j p ν := by
  exact expectedUsersWonAgainstSymmetricMixed_ge_sum_prokhorov_lowerBound
    hε hdist p
    (fun i => score (users i) p - ε.toReal * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i))
    (fun i => by
      unfold score
      fun_prop)
    (fun i => metric_thickening_strict_score_event_subset
      (users i) p ε.toReal)

/--
Local payoff-security conclusion for the finite product-metric route.  A pure
action whose strict-score masses have a positive `L1` score margin and strict
payoff slack remains strictly profitable throughout one Lévy--Prokhorov
neighborhood of the baseline mixed law.  The finite clipped-power continuity
argument is supplied by the reusable probability library.
-/
theorem exists_prokhorovEDist_neighborhood_payoff_gt_of_l1ScoreMarginSlack
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D} {j : Fin P}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ]
    {p : Content D} {cost : Content D → ℝ} {α margin : ℝ}
    (hmargin : 0 < margin)
    (hprofit : α <
      (∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q < score (users i) p -
          margin * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)}) ^ (P - 1)) - cost p) :
    ∃ ε : ENNReal, ε ≠ ⊤ ∧ 0 < ε ∧
      ∀ ν : Measure (Content D), IsProbabilityMeasure ν →
        levyProkhorovEDist μ ν < ε →
          α < ExpectedUsersWonAgainstSymmetricMixed users j p ν - cost p := by
  let m : Fin N → ℝ := fun i =>
    μ.real {q : Content D | score (users i) q < score (users i) p -
      margin * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)}
  have hm : ∀ i : Fin N, 0 ≤ m i := fun i => MeasureTheory.measureReal_nonneg
  obtain ⟨r, hrpos, hrmargin, hrprofit⟩ :=
    AppliedModelingLib.exists_pos_lt_sum_clippedSub_pow_sub_gt m (P - 1) (cost p) α margin
      hm hmargin (by simpa [m] using hprofit)
  refine ⟨ENNReal.ofReal r, ENNReal.ofReal_ne_top, ENNReal.ofReal_pos.mpr hrpos, ?_⟩
  intro ν hνprob hdist
  letI : IsProbabilityMeasure ν := hνprob
  have hrnonneg : 0 ≤ r := hrpos.le
  have hreal : (ENNReal.ofReal r).toReal = r := ENNReal.toReal_ofReal hrnonneg
  have hprok := expectedUsersWonAgainstSymmetricMixed_ge_sum_prokhorov_l1ScoreMargin
    (users := users) (j := j) (μ := μ) (ν := ν) ENNReal.ofReal_ne_top hdist p
  have hsum :
      (∑ i : Fin N, (max 0 (m i - r)) ^ (P - 1)) ≤
        ∑ i : Fin N,
          (max 0 (μ.real {q : Content D |
            score (users i) q < score (users i) p -
              (ENNReal.ofReal r).toReal * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)} -
              (ENNReal.ofReal r).toReal)) ^ (P - 1) := by
    apply Finset.sum_le_sum
    intro i _
    apply pow_le_pow_left₀
    · exact le_max_left _ _
    apply max_le_max_left
    rw [hreal]
    change μ.real {q : Content D | score (users i) q < score (users i) p -
      margin * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)} - r ≤
      μ.real {q : Content D | score (users i) q < score (users i) p -
        r * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)} - r
    apply sub_le_sub_right
    refine MeasureTheory.measureReal_mono ?_ (measure_ne_top μ _)
    intro q hq
    change score (users i) q < score (users i) p -
      margin * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i) at hq
    change score (users i) q < score (users i) p -
      r * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)
    apply lt_of_lt_of_le hq
    apply sub_le_sub_left
    exact mul_le_mul_of_nonneg_right hrmargin.le
      (AppliedModelingLib.FiniteDimensionalNorms.normL1_nonneg (users i))
  have halloc : (∑ i : Fin N, (max 0 (m i - r)) ^ (P - 1)) ≤
      ExpectedUsersWonAgainstSymmetricMixed users j p ν := by
    exact hsum.trans (by simpa [hreal] using hprok)
  linarith

/--
Tie-aware normal-form payoff reduction.  Under an explicit zero-mass premise
for every fixed score level, each user's uniform tie share agrees almost
everywhere with the event that every other producer has strictly smaller
score.  Independence then yields the `(P - 1)` power of that strict-score
mass.  Without `hno_atom`, the paper's CDF reduction omits positive tie-share
terms and is not valid in general.
-/
theorem expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ] (p : Content D)
    (hmeas_score : ∀ i : Fin N, Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0) :
    ExpectedUsersWonAgainstSymmetricMixed users j p μ =
      ∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1) := by
  classical
  let productMeasure : Measure (Fin P → Content D) :=
    Measure.pi (fun _ : Fin P => μ)
  let E : Fin N → Set (Content D) := fun i =>
    {q : Content D | score (users i) q < score (users i) p}
  let A : Fin N → Set (Fin P → Content D) := fun i =>
    AllOtherProducersInSet j (E i)
  have hE : ∀ i : Fin N, MeasurableSet (E i) := by
    intro i
    exact measurableSet_lt (hmeas_score i) measurable_const
  have hA : ∀ i : Fin N, MeasurableSet (A i) := by
    intro i
    exact measurableSet_allOtherProducersInSet (hE i) j
  have hne : ∀ i : Fin N, ∀ᵐ profile ∂productMeasure,
      ∀ k : Fin P, k ≠ j → score (users i) (profile k) ≠ score (users i) p := by
    intro i
    simpa [productMeasure] using
      allOtherProducers_score_ne_ae (u := users i) (p := p) (j := j)
        (μ := μ) (hno_atom i)
  have hint : ∀ i : Fin N,
      Integrable ((A i).indicator (fun _ : Fin P → Content D => (1 : ℝ))) productMeasure := by
    intro i
    exact (integrable_const (1 : ℝ)).indicator (hA i)
  unfold ExpectedUsersWonAgainstSymmetricMixed
  change (∫ profile, usersWon users (deviateProfile profile j p) j ∂productMeasure) = _
  calc
    (∫ profile, usersWon users (deviateProfile profile j p) j ∂productMeasure) =
        ∫ profile, ∑ i : Fin N,
          (A i).indicator (fun _ : Fin P → Content D => (1 : ℝ)) profile ∂productMeasure := by
      apply integral_congr_ae
      have hall : ∀ᵐ profile ∂productMeasure,
          ∀ i : Fin N, ∀ k : Fin P, k ≠ j →
            score (users i) (profile k) ≠ score (users i) p := by
        rw [Filter.eventually_all]
        exact hne
      filter_upwards [hall] with profile hprofile
      rw [usersWon]
      apply Finset.sum_congr rfl
      intro i _
      simpa [A, E] using
        tieShare_deviate_eq_indicator_of_no_score_ties
          (u := users i) (p := p) (profile := profile) (j := j) (hprofile i)
    _ = ∑ i : Fin N,
        ∫ profile, (A i).indicator (fun _ : Fin P → Content D => (1 : ℝ)) profile
          ∂productMeasure := by
      rw [integral_finset_sum]
      intro i _
      exact hint i
    _ = ∑ i : Fin N, productMeasure.real (A i) := by
      apply Finset.sum_congr rfl
      intro i _
      simpa using (integral_indicator_one (μ := productMeasure) (hA i))
    _ = ∑ i : Fin N, (μ.real (E i)) ^ (P - 1) := by
      apply Finset.sum_congr rfl
      intro i _
      simpa [productMeasure, A] using
        measureReal_allOtherProducersInSet_eq_pow (μ := μ) j (E i)
    _ = _ := by rfl

/--
Tie-aware strict-score payoff identity at one fixed focal action.  Unlike the
global score-law version, this needs nullness only at that action's finitely
many user-score levels; this is exactly the conclusion of the source's
atom-avoiding perturbation.
-/
theorem expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass_of_scoreLevel_null_at
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ] (p : Content D)
    (hmeas_score : ∀ i : Fin N, Measurable (fun q : Content D => score (users i) q))
    (hno_atom_at : ∀ i : Fin N,
      μ {q : Content D | score (users i) q = score (users i) p} = 0) :
    ExpectedUsersWonAgainstSymmetricMixed users j p μ =
      ∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1) := by
  classical
  let productMeasure : Measure (Fin P → Content D) :=
    Measure.pi (fun _ : Fin P => μ)
  let E : Fin N → Set (Content D) := fun i =>
    {q : Content D | score (users i) q < score (users i) p}
  let A : Fin N → Set (Fin P → Content D) := fun i =>
    AllOtherProducersInSet j (E i)
  have hE : ∀ i : Fin N, MeasurableSet (E i) := by
    intro i
    exact measurableSet_lt (hmeas_score i) measurable_const
  have hA : ∀ i : Fin N, MeasurableSet (A i) := by
    intro i
    exact measurableSet_allOtherProducersInSet (hE i) j
  have hne : ∀ i : Fin N, ∀ᵐ profile ∂productMeasure,
      ∀ k : Fin P, k ≠ j → score (users i) (profile k) ≠ score (users i) p := by
    intro i
    rw [Filter.eventually_all]
    intro k
    by_cases hkj : k = j
    · exact Filter.Eventually.of_forall fun _ hk => (hk hkj).elim
    · have hne : ∀ᵐ profile ∂productMeasure,
          score (users i) (profile k) ≠ score (users i) p := by
        rw [ae_iff]
        simp only [not_not]
        change Measure.pi (fun _ : Fin P => μ)
          (Function.eval k ⁻¹' {q : Content D | score (users i) q = score (users i) p}) = 0
        exact Measure.pi_eval_preimage_null _ (hno_atom_at i)
      exact hne.mono fun _ h _ => h
  have hint : ∀ i : Fin N,
      Integrable ((A i).indicator (fun _ : Fin P → Content D => (1 : ℝ))) productMeasure := by
    intro i
    exact (integrable_const (1 : ℝ)).indicator (hA i)
  unfold ExpectedUsersWonAgainstSymmetricMixed
  change (∫ profile, usersWon users (deviateProfile profile j p) j ∂productMeasure) = _
  calc
    (∫ profile, usersWon users (deviateProfile profile j p) j ∂productMeasure) =
        ∫ profile, ∑ i : Fin N,
          (A i).indicator (fun _ : Fin P → Content D => (1 : ℝ)) profile ∂productMeasure := by
      apply integral_congr_ae
      have hall : ∀ᵐ profile ∂productMeasure,
          ∀ i : Fin N, ∀ k : Fin P, k ≠ j →
            score (users i) (profile k) ≠ score (users i) p := by
        rw [Filter.eventually_all]
        exact hne
      filter_upwards [hall] with profile hprofile
      rw [usersWon]
      apply Finset.sum_congr rfl
      intro i _
      simpa [A, E] using
        tieShare_deviate_eq_indicator_of_no_score_ties
          (u := users i) (p := p) (profile := profile) (j := j) (hprofile i)
    _ = ∑ i : Fin N,
        ∫ profile, (A i).indicator (fun _ : Fin P → Content D => (1 : ℝ)) profile
          ∂productMeasure := by
      rw [integral_finset_sum]
      intro i _
      exact hint i
    _ = ∑ i : Fin N, productMeasure.real (A i) := by
      apply Finset.sum_congr rfl
      intro i _
      simpa using (integral_indicator_one (μ := productMeasure) (hA i))
    _ = ∑ i : Fin N, (μ.real (E i)) ^ (P - 1) := by
      apply Finset.sum_congr rfl
      intro i _
      simpa [productMeasure, A] using
        measureReal_allOtherProducersInSet_eq_pow (μ := μ) j (E i)
    _ = _ := by rfl

/--
An absolutely continuous score pushforward assigns zero mass to every fixed
score level.  The measurability premise is retained because it is needed to
identify the pushforward singleton with the corresponding content-score fiber.
-/
theorem score_level_measure_eq_zero_of_score_law_absolutelyContinuous
    {D : ℕ} {u : Content D} {μ : Measure (Content D)}
    (hmeas_score : Measurable (fun q : Content D => score u q))
    (hscore_ac : Measure.map (fun q : Content D => score u q) μ ≪ volume)
    (z : ℝ) :
    μ {q : Content D | score u q = z} = 0 := by
  have hmap :
      (Measure.map (fun q : Content D => score u q) μ) ({z} : Set ℝ) = 0 :=
    hscore_ac Real.volume_singleton
  rw [Measure.map_apply hmeas_score (measurableSet_singleton z)] at hmap
  simpa using hmap

/--
Score-level nullness alone is enough to identify strict and weak score-event
masses.  This is the exact tie-aware bridge needed by the source payoff
reduction, without imposing absolute continuity when atomlessness is available
by another argument.
-/
theorem score_lt_measure_eq_score_le_measure_of_score_level_null
    {D : ℕ} {u : Content D} {μ : Measure (Content D)}
    (hmeas_score : Measurable (fun q : Content D => score u q))
    (hscore_null : ∀ z : ℝ, μ {q : Content D | score u q = z} = 0)
    (z : ℝ) :
    μ {q : Content D | score u q < z} =
      μ {q : Content D | score u q ≤ z} := by
  let ν : Measure ℝ := Measure.map (fun q : Content D => score u q) μ
  letI : NoAtoms ν := by
    constructor
    intro x
    dsimp [ν]
    rw [Measure.map_apply hmeas_score (measurableSet_singleton x)]
    exact hscore_null x
  have hstrict_eq_le : ν (Set.Iio z) = ν (Set.Iic z) :=
    measure_congr (Iio_ae_eq_Iic (μ := ν))
  calc
    μ {q : Content D | score u q < z} = ν (Set.Iio z) := by
      dsimp [ν]
      rw [Measure.map_apply hmeas_score measurableSet_Iio]
      rfl
    _ = ν (Set.Iic z) := hstrict_eq_le
    _ = μ {q : Content D | score u q ≤ z} := by
      dsimp [ν]
      rw [Measure.map_apply hmeas_score measurableSet_Iic]
      rfl

/--
Under score-level nullness, strict score mass is the real lower-CDF mass of
the score push-forward.  This does not require absolute continuity: a
nonatomic score law is sufficient.
-/
theorem score_lt_measureReal_eq_lowerCDFMass_map_of_score_level_null
    {D : ℕ} {u : Content D} {μ : Measure (Content D)}
    (hmeas_score : Measurable (fun q : Content D => score u q))
    (hscore_null : ∀ z : ℝ, μ {q : Content D | score u q = z} = 0)
    (z : ℝ) :
    μ.real {q : Content D | score u q < z} =
      AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun q : Content D => score u q) μ) z := by
  rw [show μ.real {q : Content D | score u q < z} =
      μ.real {q : Content D | score u q ≤ z} by
    exact congrArg ENNReal.toReal
      (score_lt_measure_eq_score_le_measure_of_score_level_null
        hmeas_score hscore_null z)]
  unfold AppliedModelingLib.Probability.lowerCDFMass
  change (μ {q : Content D | score u q ≤ z}).toReal =
    ((Measure.map (fun q : Content D => score u q) μ) (Set.Iic z)).toReal
  congr 1
  rw [Measure.map_apply hmeas_score measurableSet_Iic]
  rfl

/--
Under an absolutely continuous score law, strict and weak score events have
the same mass.  This is the CDF-facing form of score-level nullness.
-/
theorem score_lt_measure_eq_score_le_measure_of_score_law_absolutelyContinuous
    {D : ℕ} {u : Content D} {μ : Measure (Content D)}
    (hmeas_score : Measurable (fun q : Content D => score u q))
    (hscore_ac : Measure.map (fun q : Content D => score u q) μ ≪ volume)
    (z : ℝ) :
    μ {q : Content D | score u q < z} =
      μ {q : Content D | score u q ≤ z} := by
  apply score_lt_measure_eq_score_le_measure_of_score_level_null hmeas_score
  intro x
  exact score_level_measure_eq_zero_of_score_law_absolutelyContinuous
    hmeas_score hscore_ac x

/-- Under a Lebesgue-absolutely-continuous score law, the strict score mass is
the real lower CDF mass of the score pushforward. -/
theorem score_lt_measureReal_eq_lowerCDFMass_map_of_score_law_absolutelyContinuous
    {D : ℕ} {u : Content D} {μ : Measure (Content D)}
    (hmeas_score : Measurable (fun q : Content D => score u q))
    (hscore_ac : Measure.map (fun q : Content D => score u q) μ ≪ volume)
    (z : ℝ) :
    μ.real {q : Content D | score u q < z} =
      AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun q : Content D => score u q) μ) z := by
  rw [show μ.real {q : Content D | score u q < z} =
      μ.real {q : Content D | score u q ≤ z} by
    exact congrArg ENNReal.toReal
      (score_lt_measure_eq_score_le_measure_of_score_law_absolutelyContinuous
        hmeas_score hscore_ac z)]
  unfold AppliedModelingLib.Probability.lowerCDFMass
  change (μ {q : Content D | score u q ≤ z}).toReal =
    ((Measure.map (fun q : Content D => score u q) μ) (Set.Iic z)).toReal
  congr 1
  rw [Measure.map_apply hmeas_score measurableSet_Iic]
  rfl

/--
Tie-aware normal-form payoff reduction under explicitly absolutely continuous
score laws.  This derives the score-level-null premise needed by
`expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass`; it does not
assert C1/C2/C3 or a mixed equilibrium.
-/
theorem expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass_of_scoreLaw_absolutelyContinuous
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ] (p : Content D)
    (hmeas_score : ∀ i : Fin N, Measurable (fun q : Content D => score (users i) q))
    (hscore_ac : ∀ i : Fin N,
      Measure.map (fun q : Content D => score (users i) q) μ ≪ volume) :
    ExpectedUsersWonAgainstSymmetricMixed users j p μ =
      ∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1) := by
  apply expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass p hmeas_score
  intro i z
  exact score_level_measure_eq_zero_of_score_law_absolutelyContinuous
    (hmeas_score i) (hscore_ac i) z

/--
CDF-facing tie-aware normal-form payoff reduction under explicitly absolutely
continuous score laws.  The weak-score mass agrees with the strict-score mass
by the preceding theorem, so this retains the actual uniform tie semantics.
-/
theorem expectedUsersWonAgainstSymmetricMixed_eq_sum_weakScoreMass_of_scoreLaw_absolutelyContinuous
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ] (p : Content D)
    (hmeas_score : ∀ i : Fin N, Measurable (fun q : Content D => score (users i) q))
    (hscore_ac : ∀ i : Fin N,
      Measure.map (fun q : Content D => score (users i) q) μ ≪ volume) :
    ExpectedUsersWonAgainstSymmetricMixed users j p μ =
      ∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q ≤ score (users i) p}) ^ (P - 1) := by
  rw [expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass_of_scoreLaw_absolutelyContinuous
    p hmeas_score hscore_ac]
  apply Finset.sum_congr rfl
  intro i _
  rw [show μ.real {q : Content D | score (users i) q < score (users i) p} =
      μ.real {q : Content D | score (users i) q ≤ score (users i) p} by
    exact congrArg ENNReal.toReal
      (score_lt_measure_eq_score_le_measure_of_score_law_absolutelyContinuous
        (hmeas_score i) (hscore_ac i) _)]

/--
Pure-strategy Nash equilibrium predicate for the source game: no producer has a
nonnegative content deviation that strictly improves profit.
-/
def PureNashEquilibrium {D N P : ℕ}
    (users : Fin N → Content D) (cost : Content D → ℝ)
    (profile : Fin P → Content D) : Prop :=
  (∀ j : Fin P, NonnegativeContent (profile j)) ∧
    ∀ (j : Fin P) (p : Content D), NonnegativeContent p →
      pureProfit users cost (deviateProfile profile j p) j ≤
        pureProfit users cost profile j

theorem pureProfit_zero_deviation_nonneg_of_cost_zero {D N P : ℕ}
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D} {j : Fin P}
    (hcost_zero : cost (0 : Content D) = 0) :
    0 ≤ pureProfit users cost (deviateProfile profile j (0 : Content D)) j := by
  unfold pureProfit
  have husers_nonneg :
      0 ≤ usersWon users (deviateProfile profile j (0 : Content D)) j :=
    usersWon_nonneg users (deviateProfile profile j (0 : Content D)) j
  simpa [hcost_zero] using husers_nonneg

theorem pureNash_profit_nonneg_of_zero_cost {D N P : ℕ}
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D} {j : Fin P}
    (hne : PureNashEquilibrium users cost profile)
    (hcost_zero : cost (0 : Content D) = 0) :
    0 ≤ pureProfit users cost profile j := by
  have hdev_nonneg :
      0 ≤ pureProfit users cost
        (deviateProfile profile j (0 : Content D)) j :=
    pureProfit_zero_deviation_nonneg_of_cost_zero (users := users)
      (profile := profile) (j := j) hcost_zero
  have hdev_le :
      pureProfit users cost
          (deviateProfile profile j (0 : Content D)) j ≤
        pureProfit users cost profile j :=
    hne.2 j (0 : Content D) zeroContent_nonnegative
  exact le_trans hdev_nonneg hdev_le

/--
Source-shaped radial cost condition: scaling any nonzero content vector down
by a factor strictly between zero and one strictly lowers production cost.  The
paper's costs `||p||^β` with `β >= 1` satisfy this; this predicate isolates the
exact cost fact used in the no-tie half of Proposition `pure`.
-/
def RadialStrictCost {D : ℕ} (cost : Content D → ℝ) : Prop :=
  ∀ {a : ℝ} {p : Content D}, 0 ≤ a → a < 1 → NonzeroContent p →
    cost (scaleContent a p) < cost p

/--
The one-sided perturbation continuity used in the paper supplies a whole
positive interval on which the cost increase is below any prescribed positive
slack.  Stating the interval explicitly permits its intersection with the
countable-score-atom avoidance set in Proposition `existence`.
-/
theorem exists_positive_radius_forall_perturb_cost_increase_lt {D : ℕ}
    {cost : Content D → ℝ} (hcont : PerturbationCostContinuous cost)
    {p u : Content D} {δ : ℝ} (hδ : 0 < δ) :
    ∃ ρ : ℝ, 0 < ρ ∧ ∀ t : ℝ, 0 < t → t < ρ →
      cost (fun d => p d + t * u d) - cost p < δ := by
  have hevent :
      {t : ℝ | cost (fun d => p d + t * u d) < cost p + δ} ∈
        nhdsWithin (0 : ℝ) (Set.Ioi 0) :=
    (hcont p u).eventually (Iio_mem_nhds (lt_add_of_pos_right (cost p) hδ))
  rcases mem_nhdsWithin_iff_exists_mem_nhds_inter.mp hevent with ⟨s, hs, hsub⟩
  rcases Metric.mem_nhds_iff.mp hs with ⟨ρ, hρ, hball⟩
  refine ⟨ρ, hρ, ?_⟩
  intro t ht0 htρ
  have htball : t ∈ Metric.ball (0 : ℝ) ρ := by
    rw [Metric.mem_ball, Real.dist_eq]
    simpa [abs_of_pos ht0] using htρ
  have hlt : cost (fun d => p d + t * u d) < cost p + δ :=
    hsub ⟨hball htball, ht0⟩
  linarith

/--
A continuous real-valued action bound remains strictly below its threshold
along every sufficiently small positive perturbation ray.  This packages the
``choose the perturbation sufficiently small to remain in the compact ball''
step that is used twice in source Proposition `existence`.
-/
theorem exists_positive_radius_forall_continuous_ray_lt {D : ℕ}
    {bound : Content D → ℝ} (hbound : Continuous bound)
    {p u : Content D} {R : ℝ} (hpR : bound p < R) :
    ∃ ρ : ℝ, 0 < ρ ∧ ∀ t : ℝ, 0 ≤ t → t < ρ →
      bound (p + t • u) < R := by
  have hray : Continuous (fun t : ℝ => (p + t • u : Content D)) := by
    exact continuous_pi fun d =>
      continuous_const.add (continuous_id.mul continuous_const)
  have hbound_zero : (bound ∘ fun t : ℝ => p + t • u) 0 < R := by
    simpa [Function.comp_def] using hpR
  have hevent : {t : ℝ | bound (p + t • u) < R} ∈ nhds (0 : ℝ) :=
    (hbound.comp hray).continuousAt.eventually (Iio_mem_nhds hbound_zero)
  rcases Metric.mem_nhds_iff.mp hevent with ⟨ρ, hρ, hball⟩
  refine ⟨ρ, hρ, ?_⟩
  intro t ht0 htρ
  apply hball
  rw [Metric.mem_ball, Real.dist_eq]
  simpa [abs_of_nonneg ht0] using htρ

/--
Source Proposition `existence`, profitable atom-avoiding perturbation.  If a
nonnegative action has strict payoff slack over `α`, cost continuity gives an
interval of still-profitable nonnegative aggregate-user perturbations.  The
countability argument then chooses a point in that interval at which every
user score law has zero mass.  The expected allocation is preserved
monotonically under the nonnegative score increase.
-/
theorem exists_small_score_atom_avoiding_profitable_aggregatePerturbation
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D}
    {μ : MeasureTheory.Measure (Content D)} [MeasureTheory.IsProbabilityMeasure μ]
    {p : Content D} {j : Fin P} {cost : Content D → ℝ} {α : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hp : NonnegativeContent p) (hcont : PerturbationCostContinuous cost)
    (hprofit : α < ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p) :
    ∃ t : ℝ, 0 < t ∧
      NonnegativeContent (p + t • aggregateUsersContent users) ∧
      (∀ i : Fin N,
        μ {q : Content D |
          score (users i) q = score (users i) (p + t • aggregateUsersContent users)} = 0) ∧
      α < ExpectedUsersWonAgainstSymmetricMixed users j
        (p + t • aggregateUsersContent users) μ -
          cost (p + t • aggregateUsersContent users) := by
  have hslack : 0 <
      (ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p) - α := by
    linarith
  obtain ⟨ρ, hρ, hcost⟩ :=
    exists_positive_radius_forall_perturb_cost_increase_lt
      (p := p) (u := aggregateUsersContent users)
      (δ := (ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p) - α)
      hcont hslack
  obtain ⟨t, htpos, htlt, ht_nonnegative, ht_atom⟩ :=
    exists_small_score_atom_avoiding_aggregatePerturbation (μ := μ)
      husers_nonnegative husers_nonzero hp hρ
  refine ⟨t, htpos, ht_nonnegative, ht_atom, ?_⟩
  have halloc : ExpectedUsersWonAgainstSymmetricMixed users j p μ ≤
      ExpectedUsersWonAgainstSymmetricMixed users j
        (p + t • aggregateUsersContent users) μ :=
    expectedUsersWonAgainstSymmetricMixed_le_nonnegative_perturb husers_nonnegative
      (aggregateUsersContent_nonnegative husers_nonnegative) htpos.le
  have hcost_lt : cost (p + t • aggregateUsersContent users) - cost p <
      (ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p) - α := by
    simpa [Pi.add_apply, Pi.smul_apply] using hcost t htpos htlt
  linarith

/--
From a strictly profitable atom-avoiding action, construct the source proof's
securing action with one explicit ambient-`L1` score margin for every user.
The direction is a positive finite combination of normalized user embeddings,
so a scale `t` raises user `i`'s score by at least `t * ||u_i||₁`.  Cost
continuity preserves the strict payoff slack.
-/
theorem exists_l1ScoreMargin_securingAction_of_profitable_scoreLevelAtomAvoidingAction
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ]
    {p : Content D} {j : Fin P} {cost : Content D → ℝ} {α : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hp : NonnegativeContent p) (hcont : PerturbationCostContinuous cost)
    (hatom : ∀ i : Fin N,
      μ {q : Content D | score (users i) q = score (users i) p} = 0)
    (hprofit : α < ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p) :
    ∃ t : ℝ, 0 < t ∧
      NonnegativeContent (p + t • sourceL1ScoreMarginDirection users) ∧
      α < (∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q <
          score (users i) (p + t • sourceL1ScoreMarginDirection users) -
            t * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)}) ^ (P - 1)) -
          cost (p + t • sourceL1ScoreMarginDirection users) := by
  have hslack : 0 < ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p - α := by
    linarith
  obtain ⟨t, htpos, hcost⟩ :=
    exists_positive_perturb_cost_increase_lt (p := p)
      (u := sourceL1ScoreMarginDirection users) hcont hslack
  have ht : 0 ≤ t := htpos.le
  have hpsec_nonnegative : NonnegativeContent
      (p + t • sourceL1ScoreMarginDirection users) := by
    intro d
    exact add_nonneg (hp d)
      (mul_nonneg ht (sourceL1ScoreMarginDirection_nonnegative
        husers_nonnegative husers_nonzero d))
  refine ⟨t, htpos, hpsec_nonnegative, ?_⟩
  have hsum_at_p :
      ExpectedUsersWonAgainstSymmetricMixed users j p μ =
        ∑ i : Fin N,
          (μ.real {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1) :=
    expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass_of_scoreLevel_null_at
      p (fun i => by
        unfold score
        exact Finset.measurable_sum Finset.univ fun d _ =>
          measurable_const.mul (measurable_pi_apply d)) hatom
  have hsum_le : ExpectedUsersWonAgainstSymmetricMixed users j p μ ≤
      ∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q <
          score (users i) (p + t • sourceL1ScoreMarginDirection users) -
            t * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)}) ^ (P - 1) := by
    rw [hsum_at_p]
    apply Finset.sum_le_sum
    intro i _
    apply pow_le_pow_left₀
    · exact MeasureTheory.measureReal_nonneg
    apply MeasureTheory.measureReal_mono
    · intro q hq
      change score (users i) q < score (users i) p at hq
      have hmargin := score_add_smul_sourceL1ScoreMarginDirection_ge
        (p := p) husers_nonnegative husers_nonzero ht i
      exact lt_of_lt_of_le hq (by linarith)
    · exact measure_ne_top μ _
  have hcost_lt : cost (p + t • sourceL1ScoreMarginDirection users) - cost p <
      ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p - α := by
    simpa [Pi.add_apply, Pi.smul_apply] using hcost
  linarith

/--
Source Proposition `existence`, executable better-reply-security construction.
Starting from a strictly profitable nonnegative deviation against a baseline
law, select an atom-avoiding perturbation, then a uniformly score-margin
securing action.  That single action remains strictly profitable throughout a
positive Lévy--Prokhorov neighborhood of the baseline law.  This is the
finite-product-metric, tie-aware realization of `arxiv-update.tex:859-896`.
-/
theorem exists_l1ScoreMargin_secure_payoff_neighborhood_of_profitable_deviation
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ]
    {p : Content D} {j : Fin P} {cost : Content D → ℝ} {α : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hp : NonnegativeContent p) (hcont : PerturbationCostContinuous cost)
    (hprofit : α < ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p) :
    ∃ psec : Content D, NonnegativeContent psec ∧
      ∃ ε : ENNReal, ε ≠ ⊤ ∧ 0 < ε ∧
        ∀ ν : Measure (Content D), IsProbabilityMeasure ν →
          levyProkhorovEDist μ ν < ε →
            α < ExpectedUsersWonAgainstSymmetricMixed users j psec ν - cost psec := by
  obtain ⟨tPerturb, htPerturb_pos, hpPerturb_nonnegative, hpPerturb_atom, hpPerturb_profit⟩ :=
    exists_small_score_atom_avoiding_profitable_aggregatePerturbation
      husers_nonnegative husers_nonzero hp hcont hprofit
  let pPerturb : Content D := p + tPerturb • aggregateUsersContent users
  have hpPerturb_nonnegative' : NonnegativeContent pPerturb := by
    simpa [pPerturb] using hpPerturb_nonnegative
  have hpPerturb_atom' : ∀ i : Fin N,
      μ {q : Content D | score (users i) q = score (users i) pPerturb} = 0 := by
    simpa [pPerturb] using hpPerturb_atom
  have hpPerturb_profit' : α < ExpectedUsersWonAgainstSymmetricMixed users j pPerturb μ - cost pPerturb := by
    simpa [pPerturb] using hpPerturb_profit
  obtain ⟨t, htpos, hpsec_nonnegative, hmargin_profit⟩ :=
    exists_l1ScoreMargin_securingAction_of_profitable_scoreLevelAtomAvoidingAction
      husers_nonnegative husers_nonzero hpPerturb_nonnegative' hcont hpPerturb_atom' hpPerturb_profit'
  let psec : Content D := pPerturb + t • sourceL1ScoreMarginDirection users
  have hpsec_nonnegative' : NonnegativeContent psec := by
    simpa [psec] using hpsec_nonnegative
  have hmargin_profit' : α < (∑ i : Fin N,
      (μ.real {q : Content D | score (users i) q < score (users i) psec -
        t * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)}) ^ (P - 1)) - cost psec := by
    simpa [psec] using hmargin_profit
  obtain ⟨ε, hεtop, hεpos, hsecure⟩ :=
    exists_prokhorovEDist_neighborhood_payoff_gt_of_l1ScoreMarginSlack
      (users := users) (j := j) (μ := μ) (p := psec) (cost := cost)
      (α := α) (margin := t) htpos hmargin_profit'
  exact ⟨psec, hpsec_nonnegative', ε, hεtop, hεpos, hsecure⟩

/-- Minimal source-norm API needed for the radial-cost step. -/
structure SourceNorm (D : ℕ) where
  norm : Content D → ℝ
  nonneg : ∀ p, 0 ≤ norm p
  pos_of_nonzero : ∀ {p}, NonzeroContent p → 0 < norm p
  scale_nonneg : ∀ {a : ℝ} {p : Content D}, 0 ≤ a →
    norm (scaleContent a p) = a * norm p

def SourceNormPerturbationContinuous {D : ℕ} (ν : SourceNorm D) : Prop :=
  ∀ p u : Content D,
    Filter.Tendsto (fun ε : ℝ => ν.norm (fun d => p d + ε * u d))
      (nhdsWithin (0 : ℝ) (Set.Ioi 0)) (nhds (ν.norm p))

namespace SourceNorm

@[simp] theorem norm_zero {D : ℕ} (ν : SourceNorm D) :
    ν.norm (0 : Content D) = 0 := by
  have hscale :
      ν.norm (scaleContent (0 : ℝ) (0 : Content D)) =
        0 * ν.norm (0 : Content D) :=
    ν.scale_nonneg (by norm_num)
  have hzero : scaleContent (0 : ℝ) (0 : Content D) = 0 := by
    ext d
    simp [scaleContent]
  rw [hzero] at hscale
  simpa using hscale

/--
Normalize a nonzero content vector by a source norm. This is the source
proof's direction map `p / ||p||`.
-/
noncomputable def normalizedContent {D : ℕ} (ν : SourceNorm D) (p : Content D) :
    Content D :=
  scaleContent (ν.norm p)⁻¹ p

/-- Normalization by a source norm preserves the source nonnegative action domain. -/
theorem normalizedContent_nonnegative {D : ℕ} (ν : SourceNorm D)
    {p : Content D} (hp : NonnegativeContent p) :
    NonnegativeContent (normalizedContent ν p) := by
  intro d
  dsimp [normalizedContent, scaleContent]
  exact mul_nonneg (inv_nonneg.mpr (ν.nonneg p)) (hp d)

theorem norm_normalizedContent_eq_one {D : ℕ} (ν : SourceNorm D)
    {p : Content D} (hp : NonzeroContent p) :
    ν.norm (normalizedContent ν p) = 1 := by
  have hpos : 0 < ν.norm p := ν.pos_of_nonzero hp
  have hinv_nonneg : 0 ≤ (ν.norm p)⁻¹ := inv_nonneg.mpr hpos.le
  rw [normalizedContent, ν.scale_nonneg hinv_nonneg]
  exact inv_mul_cancel₀ (ne_of_gt hpos)

/-- Rescaling a nonzero vector's normalized source direction recovers that vector. -/
theorem scale_norm_normalizedContent_eq_self {D : ℕ} (ν : SourceNorm D)
    {p : Content D} (hp : NonzeroContent p) :
    scaleContent (ν.norm p) (normalizedContent ν p) = p := by
  have hnorm_ne : ν.norm p ≠ 0 := ne_of_gt (ν.pos_of_nonzero hp)
  ext d
  change ν.norm p * ((ν.norm p)⁻¹ * p d) = p d
  rw [← mul_assoc, mul_inv_cancel₀ hnorm_ne, one_mul]

/-- Normalizing a nonzero nonnegative scaling of a unit direction recovers that direction. -/
theorem normalizedContent_scale_of_norm_eq_one {D : ℕ} (ν : SourceNorm D)
    {a : ℝ} {genre : Content D} (ha : 0 ≤ a) (ha_ne : a ≠ 0)
    (hgenre_norm : ν.norm genre = 1) :
    normalizedContent ν (scaleContent a genre) = genre := by
  rw [normalizedContent, ν.scale_nonneg ha, hgenre_norm, mul_one]
  ext d
  simp [scaleContent]
  field_simp [ha_ne]

/-- Positive scaling preserves the normalized source direction of every
nonzero content vector. -/
theorem normalizedContent_scaleContent_pos {D : ℕ} (ν : SourceNorm D)
    {a : ℝ} {p : Content D} (ha : 0 < a) (hp : NonzeroContent p) :
    normalizedContent ν (scaleContent a p) = normalizedContent ν p := by
  have hp_norm_pos : 0 < ν.norm p := ν.pos_of_nonzero hp
  have hfactor_pos : 0 < a * ν.norm p := mul_pos ha hp_norm_pos
  have hscale : scaleContent a p =
      scaleContent (a * ν.norm p) (normalizedContent ν p) := by
    calc
      scaleContent a p =
          scaleContent a (scaleContent (ν.norm p) (normalizedContent ν p)) :=
        (congrArg (scaleContent a) (scale_norm_normalizedContent_eq_self ν hp)).symm
      _ = scaleContent (a * ν.norm p) (normalizedContent ν p) := by
        rw [scaleContent_scaleContent]
  rw [hscale]
  exact normalizedContent_scale_of_norm_eq_one ν hfactor_pos.le hfactor_pos.ne'
    (norm_normalizedContent_eq_one ν hp)

theorem score_eq_norm_mul_score_normalizedContent {D : ℕ}
    (ν : SourceNorm D) (u : Content D) {p : Content D}
    (hp : NonzeroContent p) :
    score u p = ν.norm p * score u (normalizedContent ν p) := by
  have hpos : 0 < ν.norm p := ν.pos_of_nonzero hp
  have hne : ν.norm p ≠ 0 := ne_of_gt hpos
  calc
    score u p = (ν.norm p * (ν.norm p)⁻¹) * score u p := by
      rw [mul_inv_cancel₀ hne, one_mul]
    _ = ν.norm p * ((ν.norm p)⁻¹ * score u p) := by ring
    _ = ν.norm p * score u (normalizedContent ν p) := by
      rw [normalizedContent, score_scaleContent]

/-- Positive score is preserved when a nonzero content vector is normalized. -/
theorem score_normalizedContent_pos_of_score_pos {D : ℕ}
    (ν : SourceNorm D) (u : Content D) {p : Content D}
    (hp : NonzeroContent p) (hscore : 0 < score u p) :
    0 < score u (normalizedContent ν p) := by
  have hnorm_pos : 0 < ν.norm p := ν.pos_of_nonzero hp
  have hmul : 0 < ν.norm p * score u (normalizedContent ν p) := by
    rw [← score_eq_norm_mul_score_normalizedContent ν u hp]
    exact hscore
  rcases (mul_pos_iff.mp hmul) with hpositive | hnegative
  · exact hpositive.2
  · exact False.elim ((not_lt_of_ge hnorm_pos.le) hnegative.1)

/--
Nonnegative nonzero users admit a nonnegative source-norm unit direction with
strictly positive score for every user: normalize their aggregate embedding.
This supplies the feasible positive-score witness required by the corrected
single-genre optimization domain.
-/
theorem exists_nonnegative_unit_direction_positive_score_of_nonnegative_nonzero_users
    {D N : ℕ} [Nonempty (Fin N)] (ν : SourceNorm D)
    {users : Fin N → Content D}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i)) :
    ∃ genre : Content D, NonnegativeContent genre ∧ ν.norm genre = 1 ∧
      ∀ i : Fin N, 0 < score (users i) genre := by
  let aggregate : Content D := aggregateUsersContent users
  have haggregate_nonnegative : NonnegativeContent aggregate := by
    dsimp [aggregate]
    exact aggregateUsersContent_nonnegative husers_nonnegative
  have haggregate_score : ∀ i : Fin N, 0 < score (users i) aggregate := by
    intro i
    dsimp [aggregate]
    exact score_aggregateUsersContent_pos husers_nonnegative husers_nonzero i
  have haggregate_nonzero : NonzeroContent aggregate :=
    nonzeroContent_of_positive_score haggregate_score
  refine ⟨normalizedContent ν aggregate,
    normalizedContent_nonnegative ν haggregate_nonnegative,
    norm_normalizedContent_eq_one ν haggregate_nonzero, ?_⟩
  intro i
  exact score_normalizedContent_pos_of_score_pos ν (users i)
    haggregate_nonzero (haggregate_score i)

/--
A positive-score maximizer over nonnegative unit directions also maximizes the
score over the nonnegative unit ball.  This is the radial reduction used in
the homogeneous-user single-genre construction.
-/
theorem score_le_of_nonnegative_unit_direction_maximizer {D : ℕ}
    (ν : SourceNorm D) {u p q : Content D}
    (hu_nonnegative : NonnegativeContent u)
    (hp_score_pos : 0 < score u p)
    (hunit_max : ∀ d : Content D, NonnegativeContent d → ν.norm d = 1 →
      score u d ≤ score u p)
    (hq_nonnegative : NonnegativeContent q) (hq_norm_le_one : ν.norm q ≤ 1) :
    score u q ≤ score u p := by
  by_cases hq_nonzero : NonzeroContent q
  · let d : Content D := normalizedContent ν q
    have hd_nonnegative : NonnegativeContent d := by
      dsimp [d]
      exact normalizedContent_nonnegative ν hq_nonnegative
    have hd_unit : ν.norm d = 1 := by
      dsimp [d]
      exact norm_normalizedContent_eq_one ν hq_nonzero
    have hd_score_nonnegative : 0 ≤ score u d :=
      score_nonneg_of_nonnegative hu_nonnegative hd_nonnegative
    have hq_score : score u q = ν.norm q * score u d := by
      dsimp [d]
      exact score_eq_norm_mul_score_normalizedContent ν u hq_nonzero
    calc
      score u q = ν.norm q * score u d := hq_score
      _ ≤ 1 * score u d :=
        mul_le_mul_of_nonneg_right hq_norm_le_one hd_score_nonnegative
      _ = score u d := one_mul _
      _ ≤ score u p := hunit_max d hd_nonnegative hd_unit
  · have hq_zero : q = 0 := content_eq_zero_of_not_nonzeroContent hq_nonzero
    rw [hq_zero, score_zero_right]
    exact hp_score_pos.le

open AppliedModelingLib.FiniteDimensionalNorms

/--
Finite-coordinate `Lq` source norm. This covers the paper's concrete
`||p||_q` examples for any positive finite exponent `q`.
-/
noncomputable def lp (D : ℕ) {q : ℝ} (hq : 0 < q) : SourceNorm D where
  norm := fun p => AppliedModelingLib.FiniteDimensionalNorms.lp q p
  nonneg := by
    intro p
    exact AppliedModelingLib.FiniteDimensionalNorms.lp_nonneg q p
  pos_of_nonzero := by
    intro p hp
    exact AppliedModelingLib.FiniteDimensionalNorms.lp_pos_of_exists_ne_zero hq hp
  scale_nonneg := by
    intro a p ha
    have hscale :=
      AppliedModelingLib.FiniteDimensionalNorms.lp_smul_of_pos (ι := Fin D) hq a p
    simpa [scaleContent, abs_of_nonneg ha] using hscale

/-- The finite-coordinate `Lq` norm is continuous along the paper's perturbation rays. -/
theorem lp_perturbationContinuous {D : ℕ} {q : ℝ} (hq : 0 < q) :
    SourceNormPerturbationContinuous (lp D hq) := by
  intro p u
  have hcont :
      Continuous (fun x : Fin D → ℝ => AppliedModelingLib.FiniteDimensionalNorms.lp q x) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.lp
      AppliedModelingLib.FiniteDimensionalNorms.lpPower
    apply (continuous_finset_sum Finset.univ fun d _hd =>
      (continuous_apply d).abs.rpow_const fun _ => Or.inr hq.le).rpow_const
    intro _x
    right
    exact one_div_nonneg.mpr hq.le
  have hpert :
      Continuous (fun ε : ℝ =>
        AppliedModelingLib.FiniteDimensionalNorms.lp q
          (fun d : Fin D => p d + ε * u d)) :=
    hcont.comp (continuous_pi fun d =>
      continuous_const.add (continuous_id.mul continuous_const))
  have htend :
      Filter.Tendsto
        (fun ε : ℝ =>
          AppliedModelingLib.FiniteDimensionalNorms.lp q (fun d : Fin D => p d + ε * u d))
        (nhdsWithin (0 : ℝ) (Set.Ioi 0))
        (nhds (AppliedModelingLib.FiniteDimensionalNorms.lp q (fun d : Fin D => p d + 0 * u d))) :=
    hpert.continuousAt.continuousWithinAt.tendsto
  simpa [lp] using htend

/-- Positive finite-coordinate `Lq` source norms are continuous. -/
theorem lp_continuous {D : ℕ} {q : ℝ} (hq : 0 < q) :
    Continuous (SourceNorm.lp D hq).norm := by
  change Continuous (fun p : Content D => AppliedModelingLib.FiniteDimensionalNorms.lp q p)
  exact AppliedModelingLib.FiniteDimensionalNorms.continuous_lp hq.le

/--
Finite-coordinate Euclidean source norm. This covers the paper's main
`||p||_2` concrete examples.
-/
noncomputable def l2 (D : ℕ) : SourceNorm D where
  norm := fun p => AppliedModelingLib.FiniteDimensionalNorms.l2 p
  nonneg := by
    intro p
    exact AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p
  pos_of_nonzero := by
    intro p hp
    exact AppliedModelingLib.FiniteDimensionalNorms.normL2_pos_of_exists_ne_zero hp
  scale_nonneg := by
    intro a p ha
    have hscale := AppliedModelingLib.FiniteDimensionalNorms.normL2_smul (a := a) p
    simpa [scaleContent, abs_of_nonneg ha] using hscale

theorem l2_measurable (D : ℕ) :
    Measurable (SourceNorm.l2 D).norm := by
  dsimp [SourceNorm.l2, AppliedModelingLib.FiniteDimensionalNorms.l2,
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq]
  fun_prop

/-- The concrete finite-coordinate Euclidean source norm is continuous. -/
theorem l2_continuous (D : ℕ) :
    Continuous (SourceNorm.l2 D).norm := by
  change Continuous (fun p : Content D => AppliedModelingLib.FiniteDimensionalNorms.l2 p)
  exact AppliedModelingLib.FiniteDimensionalNorms.continuous_l2

theorem score_self_eq_one_of_l2_norm_eq_one {D : ℕ} {u : Content D}
    (hunit : (SourceNorm.l2 D).norm u = 1) :
    score u u = 1 := by
  exact JGS23SupplySideRecommenderSystems.score_self_eq_one_of_l2_norm_eq_one
    (D := D) (u := u) (by simpa [SourceNorm.l2] using hunit)

/-- The finite-coordinate Euclidean norm is continuous along the paper's perturbation rays. -/
theorem l2_perturbationContinuous {D : ℕ} :
    SourceNormPerturbationContinuous (l2 D) := by
  intro p u
  have hcont :
      Continuous (fun x : Fin D → ℝ => AppliedModelingLib.FiniteDimensionalNorms.l2 x) := by
    unfold AppliedModelingLib.FiniteDimensionalNorms.l2
      AppliedModelingLib.FiniteDimensionalNorms.l2Sq
    fun_prop
  have hpert :
      Continuous (fun ε : ℝ =>
        AppliedModelingLib.FiniteDimensionalNorms.l2
          (fun d : Fin D => p d + ε * u d)) :=
    hcont.comp (continuous_pi fun d =>
      continuous_const.add (continuous_id.mul continuous_const))
  have htend :
      Filter.Tendsto
        (fun ε : ℝ =>
          AppliedModelingLib.FiniteDimensionalNorms.l2 (fun d : Fin D => p d + ε * u d))
        (nhdsWithin (0 : ℝ) (Set.Ioi 0))
        (nhds (AppliedModelingLib.FiniteDimensionalNorms.l2 (fun d : Fin D => p d + 0 * u d))) :=
    hpert.continuousAt.continuousWithinAt.tendsto
  simpa [l2] using htend

end SourceNorm

/--
Topological compatibility needed to transport a zero-support statement for a
scalar source-norm law back to the finite-dimensional content law.  The
minimal `SourceNorm` API deliberately records only the algebra needed for
radial costs, so this is an additional, visible hypothesis rather than an
implicit use of a norm topology.
-/
def SourceNormZeroReflectsNeighborhood {D : ℕ} (ν : SourceNorm D) : Prop :=
  ∀ U : Set (Content D), U ∈ nhds (0 : Content D) →
    ∃ ε : ℝ, 0 < ε ∧ ∀ p : Content D, ν.norm p < ε → p ∈ U

/--
Explicit properness condition for a source norm: every closed radius sublevel
is compact in the finite-coordinate content topology.  The paper writes an
unqualified norm; this condition records the compactness needed when its CDF
proof takes extrema of support radii.
-/
def SourceNormCompactSublevels {D : ℕ} (ν : SourceNorm D) : Prop :=
  ∀ R : ℝ, IsCompact {p : Content D | ν.norm p ≤ R}

/-- Convexity of all source-norm sublevels, needed by the Reny action-space step. -/
def SourceNormConvexSublevels {D : ℕ} (ν : SourceNorm D) : Prop :=
  ∀ R : ℝ, Convex ℝ {p : Content D | ν.norm p ≤ R}

/-- A triangle inequality supplies the convex norm-sublevel condition. -/
theorem sourceNormConvexSublevels_of_triangle {D : ℕ} (ν : SourceNorm D)
    (htriangle : ∀ p q : Content D, ν.norm (p + q) ≤ ν.norm p + ν.norm q) :
    SourceNormConvexSublevels ν := by
  intro R
  rw [convex_iff_add_mem]
  intro x hx y hy a b ha hb hab
  have hrewrite : a • x + b • y = scaleContent a x + scaleContent b y := by
    ext d
    simp [scaleContent]
  rw [hrewrite]
  calc
    ν.norm (scaleContent a x + scaleContent b y) ≤
        ν.norm (scaleContent a x) + ν.norm (scaleContent b y) :=
      htriangle _ _
    _ = a * ν.norm x + b * ν.norm y := by
      rw [ν.scale_nonneg ha, ν.scale_nonneg hb]
    _ ≤ a * R + b * R := by
      exact add_le_add (mul_le_mul_of_nonneg_left hx ha)
        (mul_le_mul_of_nonneg_left hy hb)
    _ = R := by rw [← add_mul, hab, one_mul]

/-- Euclidean source-norm balls are convex. -/
theorem SourceNorm.l2_convexSublevels (D : ℕ) :
    SourceNormConvexSublevels (SourceNorm.l2 D) :=
  sourceNormConvexSublevels_of_triangle (SourceNorm.l2 D) (by
    intro p q
    simpa [SourceNorm.l2] using
      (AppliedModelingLib.FiniteDimensionalNorms.normL2_add_le p q))

/-- Finite `Lq` source-norm balls are convex at the source range `q >= 1`. -/
theorem SourceNorm.lp_convexSublevels {D : ℕ} {q : ℝ} (hq : 1 ≤ q) :
    SourceNormConvexSublevels (SourceNorm.lp D (lt_of_lt_of_le zero_lt_one hq)) :=
  sourceNormConvexSublevels_of_triangle
    (SourceNorm.lp D (lt_of_lt_of_le zero_lt_one hq)) (by
      intro p q
      simpa [SourceNorm.lp] using
        (AppliedModelingLib.FiniteDimensionalNorms.lp_add_le hq p q))

/-- The compact nonnegative action set used in the source existence proof. -/
def sourceTruncatedActionSet {D : ℕ} (ν : SourceNorm D) (R : ℝ) : Set (Content D) :=
  {p | NonnegativeContent p ∧ ν.norm p ≤ R}

/-- Proper source norms make the truncated source action set compact. -/
theorem isCompact_sourceTruncatedActionSet_of_compactSublevels {D : ℕ}
    (ν : SourceNorm D) (R : ℝ) (hcompact : SourceNormCompactSublevels ν) :
    IsCompact (sourceTruncatedActionSet ν R) := by
  convert (hcompact R).inter_right (isClosed_nonnegativeContentSet (D := D)) using 1
  ext p
  simp [sourceTruncatedActionSet, and_comm]

/--
The diagonal-payoff expression on the compact truncated action set used by
the source existence proof.  A mixed strategy is a probability measure on the
subtype, so its cost integral is genuinely over feasible actions.
-/
noncomputable def SourceTruncatedDiagonalPayoff {D N P : ℕ}
    (ν : SourceNorm D) (R : ℝ) (cost : Content D → ℝ)
    (μ : ProbabilityMeasure (sourceTruncatedActionSet ν R)) : ℝ :=
  (N : ℝ) / (P : ℝ) - ∫ p : sourceTruncatedActionSet ν R, cost p.1 ∂μ.toMeasure

/--
Forget the compact-subtype witness of a source-truncated mixed strategy.  The
resulting probability measure on the ambient content space is the strategy
law used by the source game's diagonal payoff.
-/
noncomputable def sourceTruncatedStrategyToMixedContent {D : ℕ}
    (ν : SourceNorm D) (R : ℝ)
    (μ : ProbabilityMeasure (sourceTruncatedActionSet ν R)) :
    ProbabilityMeasure (Content D) :=
  μ.map continuous_subtype_val.measurable.aemeasurable

/-- The ambient cost integral of a truncated strategy is its subtype integral. -/
theorem integral_sourceTruncatedStrategyToMixedContent
    {D : ℕ} (ν : SourceNorm D) (R : ℝ)
    (hcompact : SourceNormCompactSublevels ν) (cost : Content D → ℝ)
    (μ : ProbabilityMeasure (sourceTruncatedActionSet ν R)) :
    ∫ p, cost p ∂(sourceTruncatedStrategyToMixedContent ν R μ).toMeasure =
      ∫ p : sourceTruncatedActionSet ν R, cost p.1 ∂μ.toMeasure := by
  unfold sourceTruncatedStrategyToMixedContent
  rw [ProbabilityMeasure.toMeasure_map]
  exact (MeasurableEmbedding.subtype_coe
    (isCompact_sourceTruncatedActionSet_of_compactSublevels ν R hcompact).isClosed.measurableSet).integral_map cost

/--
The original source diagonal payoff of the pushed-forward compact strategy is
exactly its compact-subtype diagonal-payoff expression.  Thus the latter is
not merely an auxiliary functional: it is the source game's diagonal payoff
on the truncated mixed-strategy domain.
-/
theorem sourceSymmetricMixedDiagonalPayoff_sourceTruncatedStrategy
    {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (ν : SourceNorm D) (R : ℝ)
    (hcompact : SourceNormCompactSublevels ν) (cost : Content D → ℝ)
    (μ : ProbabilityMeasure (sourceTruncatedActionSet ν R)) (j : Fin P) :
    SourceSymmetricMixedDiagonalPayoff users cost j
      (sourceTruncatedStrategyToMixedContent ν R μ).toMeasure =
      SourceTruncatedDiagonalPayoff (N := N) (P := P) ν R cost μ := by
  unfold SourceSymmetricMixedDiagonalPayoff SourceTruncatedDiagonalPayoff
  rw [symmetricMixedDiagonalExpectedUsersWon_eq_card_div users
    (sourceTruncatedStrategyToMixedContent ν R μ).toMeasure j]
  rw [integral_sourceTruncatedStrategyToMixedContent ν R hcompact cost μ]

/--
A continuous cost is integrable under every compact-truncated mixed strategy.
The bound is taken on the actual closed source action set, not on an ambient
ball with unconstrained negative-content points.
-/
theorem integrable_sourceTruncatedCost
    {D : ℕ} (ν : SourceNorm D) (R : ℝ)
    (hcompact : SourceNormCompactSublevels ν) (cost : Content D → ℝ)
    (hcost : Continuous cost)
    (strategy : ProbabilityMeasure (sourceTruncatedActionSet ν R)) :
    Integrable (fun p : sourceTruncatedActionSet ν R => cost p.1) strategy.toMeasure := by
  obtain ⟨C, hC⟩ := IsCompact.exists_bound_of_continuousOn
    (isCompact_sourceTruncatedActionSet_of_compactSublevels ν R hcompact) hcost.continuousOn
  refine Integrable.of_bound
    (hcost.comp continuous_subtype_val).stronglyMeasurable.aestronglyMeasurable C ?_
  filter_upwards with p
  exact hC p.1 p.2

/--
On a compact source-truncated action set, the cost term in the diagonal
formula is weakly continuous whenever the source cost is continuous.  This
is the precise compact-subtype version of the continuity assertion made at
`arxiv-update.tex:858-862`.
-/
theorem continuous_sourceTruncatedDiagonalPayoff_of_compactSublevels
    {D N P : ℕ} (ν : SourceNorm D) (R : ℝ)
    (hcompact : SourceNormCompactSublevels ν) (cost : Content D → ℝ)
    (hcost : Continuous cost) :
    Continuous fun μ : ProbabilityMeasure (sourceTruncatedActionSet ν R) =>
      SourceTruncatedDiagonalPayoff (N := N) (P := P) ν R cost μ := by
  letI : CompactSpace (sourceTruncatedActionSet ν R) :=
    isCompact_iff_compactSpace.mp
      (isCompact_sourceTruncatedActionSet_of_compactSublevels ν R hcompact)
  unfold SourceTruncatedDiagonalPayoff
  apply continuous_const.sub
  exact ProbabilityMeasure.continuous_integral_continuousMap
    (⟨fun p : sourceTruncatedActionSet ν R => cost p.1,
      hcost.comp continuous_subtype_val⟩ : C(sourceTruncatedActionSet ν R, ℝ))

/-- Convex norm sublevels make the truncated source action set convex. -/
theorem convex_sourceTruncatedActionSet_of_convexSublevels {D : ℕ}
    (ν : SourceNorm D) (R : ℝ) (hconvex : SourceNormConvexSublevels ν) :
    Convex ℝ (sourceTruncatedActionSet ν R) := by
  simpa [sourceTruncatedActionSet, and_comm] using
    (convex_nonnegativeContentSet (D := D)).inter (hconvex R)

/--
Compact-action version of the source's finite better-reply-security
construction.  In addition to the cost-continuity radii, it explicitly
intersects the two perturbation radii supplied by a continuous action bound.
Consequently both the score-atom-avoiding action and the fixed securing action
are strictly inside the same truncated ball.  This is the compact-feasibility
content of the source's two occurrences of ``sufficiently small'' in
`arxiv-update.tex:859-896`.
-/
theorem exists_l1ScoreMargin_secure_payoff_neighborhood_of_profitable_deviation_within_continuous_bound
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ]
    {p : Content D} {j : Fin P} {cost bound : Content D → ℝ} {α R : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hp : NonnegativeContent p) (hcont : PerturbationCostContinuous cost)
    (hbound : Continuous bound) (hpR : bound p < R)
    (hprofit : α < ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p) :
    ∃ psec : Content D, NonnegativeContent psec ∧ bound psec < R ∧
      ∃ ε : ENNReal, ε ≠ ⊤ ∧ 0 < ε ∧
        ∀ ν : Measure (Content D), IsProbabilityMeasure ν →
          levyProkhorovEDist μ ν < ε →
            α < ExpectedUsersWonAgainstSymmetricMixed users j psec ν - cost psec := by
  have hslack : 0 < ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p - α := by
    linarith
  obtain ⟨ρcost, hρcost, hcost⟩ :=
    exists_positive_radius_forall_perturb_cost_increase_lt
      (p := p) (u := aggregateUsersContent users) hcont hslack
  obtain ⟨ρbound, hρbound, hboundray⟩ :=
    exists_positive_radius_forall_continuous_ray_lt
      (p := p) (u := aggregateUsersContent users) hbound hpR
  have hρ : 0 < min ρcost ρbound := lt_min hρcost hρbound
  obtain ⟨tPerturb, htPerturb_pos, htPerturb_lt, hpPerturb_nonneg, hpPerturb_atom⟩ :=
    exists_small_score_atom_avoiding_aggregatePerturbation
      (μ := μ) husers_nonnegative husers_nonzero hp hρ
  let pPerturb : Content D := p + tPerturb • aggregateUsersContent users
  have hpPerturb_nonneg' : NonnegativeContent pPerturb := by
    simpa [pPerturb] using hpPerturb_nonneg
  have hpPerturb_atom' : ∀ i : Fin N,
      μ {q : Content D | score (users i) q = score (users i) pPerturb} = 0 := by
    simpa [pPerturb] using hpPerturb_atom
  have hpPerturb_profit' : α < ExpectedUsersWonAgainstSymmetricMixed users j pPerturb μ - cost pPerturb := by
    have halloc : ExpectedUsersWonAgainstSymmetricMixed users j p μ ≤
        ExpectedUsersWonAgainstSymmetricMixed users j pPerturb μ := by
      simpa [pPerturb] using
        (expectedUsersWonAgainstSymmetricMixed_le_nonnegative_perturb
          husers_nonnegative (aggregateUsersContent_nonnegative husers_nonnegative) htPerturb_pos.le)
    have hcostlt : cost pPerturb - cost p <
        ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p - α := by
      simpa [pPerturb, Pi.add_apply, Pi.smul_apply] using
        hcost tPerturb htPerturb_pos (lt_of_lt_of_le htPerturb_lt (min_le_left _ _))
    linarith
  have hpPerturb_bound : bound pPerturb < R := by
    simpa [pPerturb] using
      hboundray tPerturb htPerturb_pos.le (lt_of_lt_of_le htPerturb_lt (min_le_right _ _))
  have hsecslack : 0 < ExpectedUsersWonAgainstSymmetricMixed users j pPerturb μ - cost pPerturb - α := by
    linarith
  obtain ⟨ρseccost, hρseccost, hseccost⟩ :=
    exists_positive_radius_forall_perturb_cost_increase_lt
      (p := pPerturb) (u := sourceL1ScoreMarginDirection users) hcont hsecslack
  obtain ⟨ρsecbound, hρsecbound, hsecbound⟩ :=
    exists_positive_radius_forall_continuous_ray_lt
      (p := pPerturb) (u := sourceL1ScoreMarginDirection users) hbound hpPerturb_bound
  let tsec : ℝ := min ρseccost ρsecbound / 2
  have htsecpos : 0 < tsec := by
    dsimp [tsec]
    exact div_pos (lt_min hρseccost hρsecbound) (by norm_num)
  have htsecmin : tsec < min ρseccost ρsecbound := by
    dsimp [tsec]
    nlinarith [lt_min hρseccost hρsecbound]
  have hpsecnonneg : NonnegativeContent (pPerturb + tsec • sourceL1ScoreMarginDirection users) := by
    intro d
    exact add_nonneg (hpPerturb_nonneg' d)
      (mul_nonneg htsecpos.le
        (sourceL1ScoreMarginDirection_nonnegative husers_nonnegative husers_nonzero d))
  have hpsecbound : bound (pPerturb + tsec • sourceL1ScoreMarginDirection users) < R :=
    hsecbound tsec htsecpos.le
      (lt_of_lt_of_le htsecmin (min_le_right _ _))
  let psec : Content D := pPerturb + tsec • sourceL1ScoreMarginDirection users
  have hpsecnonneg' : NonnegativeContent psec := by
    simpa [psec] using hpsecnonneg
  have hpsecbound' : bound psec < R := by
    simpa [psec] using hpsecbound
  have hsum_at_pPerturb :
      ExpectedUsersWonAgainstSymmetricMixed users j pPerturb μ =
        ∑ i : Fin N,
          (μ.real {q : Content D | score (users i) q < score (users i) pPerturb}) ^ (P - 1) :=
    expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass_of_scoreLevel_null_at
      pPerturb (fun i => by
        unfold score
        exact Finset.measurable_sum Finset.univ fun d _ =>
          measurable_const.mul (measurable_pi_apply d)) hpPerturb_atom'
  have hsummargin : ExpectedUsersWonAgainstSymmetricMixed users j pPerturb μ ≤
      ∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q <
          score (users i) psec - tsec * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)}) ^
            (P - 1) := by
    rw [hsum_at_pPerturb]
    apply Finset.sum_le_sum
    intro i _
    apply pow_le_pow_left₀
    · exact MeasureTheory.measureReal_nonneg
    apply MeasureTheory.measureReal_mono
    · intro q hq
      change score (users i) q < score (users i) pPerturb at hq
      have hmargin := score_add_smul_sourceL1ScoreMarginDirection_ge
        (p := pPerturb) husers_nonnegative husers_nonzero htsecpos.le i
      change score (users i) q < score (users i) psec -
        tsec * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)
      simpa [psec] using lt_of_lt_of_le hq (by linarith)
    · exact measure_ne_top μ _
  have hseccostlt : cost psec - cost pPerturb <
      ExpectedUsersWonAgainstSymmetricMixed users j pPerturb μ - cost pPerturb - α := by
    simpa [psec, Pi.add_apply, Pi.smul_apply] using
      hseccost tsec htsecpos
        (lt_of_lt_of_le htsecmin (min_le_left _ _))
  have hmarginprofit : α <
      (∑ i : Fin N,
        (μ.real {q : Content D | score (users i) q < score (users i) psec -
          tsec * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)}) ^ (P - 1)) - cost psec := by
    linarith
  obtain ⟨ε, hεtop, hεpos, hsecure⟩ :=
    exists_prokhorovEDist_neighborhood_payoff_gt_of_l1ScoreMarginSlack
      (users := users) (j := j) (μ := μ) (p := psec) (cost := cost)
      (α := α) (margin := tsec) htsecpos hmarginprofit
  exact ⟨psec, hpsecnonneg', hpsecbound', ε, hεtop, hεpos, hsecure⟩

/--
The preceding joint-radius construction stated directly on the source compact
action set.  A strictly interior starting deviation produces a securing action
in that same set, rather than merely in the ambient nonnegative orthant.
-/
theorem exists_l1ScoreMargin_secure_payoff_neighborhood_of_profitable_deviation_within_sourceTruncatedActionSet
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ]
    {p : Content D} {j : Fin P} {cost : Content D → ℝ}
    {ν : SourceNorm D} {R α : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hp : NonnegativeContent p) (hcont : PerturbationCostContinuous cost)
    (hνcont : Continuous ν.norm) (hpR : ν.norm p < R)
    (hprofit : α < ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p) :
    ∃ psec : Content D, psec ∈ sourceTruncatedActionSet ν R ∧
      ∃ ε : ENNReal, ε ≠ ⊤ ∧ 0 < ε ∧
        ∀ μ' : Measure (Content D), IsProbabilityMeasure μ' →
          levyProkhorovEDist μ μ' < ε →
            α < ExpectedUsersWonAgainstSymmetricMixed users j psec μ' - cost psec := by
  obtain ⟨psec, hpsecnonneg, hpsecbound, ε, hεtop, hεpos, hsecure⟩ :=
    exists_l1ScoreMargin_secure_payoff_neighborhood_of_profitable_deviation_within_continuous_bound
      husers_nonnegative husers_nonzero hp hcont hνcont hpR hprofit
  exact ⟨psec, ⟨hpsecnonneg, hpsecbound.le⟩, ε, hεtop, hεpos, hsecure⟩

/--
The source's inner norm cap lies strictly inside its doubled compact cap
whenever the user population is nonempty.  This is the explicit quantitative
slack used to start the compact better-reply-security construction.
-/
theorem norm_lt_double_support_cap_of_norm_le_support_cap
    {D N : ℕ} [Nonempty (Fin N)] {ν : SourceNorm D}
    {p : Content D} {β : ℝ}
    (hp : ν.norm p ≤ (N : ℝ) ^ β⁻¹) :
    ν.norm p < 2 * ((N : ℝ) ^ β⁻¹) := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hcap_pos : 0 < (N : ℝ) ^ β⁻¹ :=
    Real.rpow_pos_of_pos hN_pos _
  linarith

/-- Finite-coordinate Euclidean source norms have compact radius sublevels. -/
theorem SourceNorm.l2_compactSublevels (D : ℕ) :
    SourceNormCompactSublevels (SourceNorm.l2 D) := by
  intro R
  by_cases hR : R < 0
  · have hempty : {p : Content D | (SourceNorm.l2 D).norm p ≤ R} = ∅ := by
      apply Set.not_nonempty_iff_eq_empty.mp
      rintro ⟨p, hp⟩
      exact (not_lt_of_ge ((SourceNorm.l2 D).nonneg p)) (lt_of_le_of_lt hp hR)
    rw [hempty]
    exact isCompact_empty
  · apply AppliedModelingLib.FiniteDimensionalNorms.isCompact_of_isClosed_of_bounded
      (isClosed_le (SourceNorm.l2_continuous D) continuous_const)
    rw [Metric.isBounded_iff_subset_closedBall (0 : Content D)]
    refine ⟨R, ?_⟩
    intro p hp
    rw [Metric.mem_closedBall, dist_zero_right]
    apply (pi_norm_le_iff_of_nonneg (le_of_not_gt hR)).mpr
    intro d
    rw [Real.norm_eq_abs]
    exact (AppliedModelingLib.FiniteDimensionalNorms.abs_le_l2 p d).trans hp

/-- Positive finite-coordinate `Lq` source norms have compact radius sublevels. -/
theorem SourceNorm.lp_compactSublevels {D : ℕ} {q : ℝ} (hq : 0 < q) :
    SourceNormCompactSublevels (SourceNorm.lp D hq) := by
  intro R
  by_cases hR : R < 0
  · have hempty : {p : Content D | (SourceNorm.lp D hq).norm p ≤ R} = ∅ := by
      apply Set.not_nonempty_iff_eq_empty.mp
      rintro ⟨p, hp⟩
      exact (not_lt_of_ge ((SourceNorm.lp D hq).nonneg p)) (lt_of_le_of_lt hp hR)
    rw [hempty]
    exact isCompact_empty
  · apply AppliedModelingLib.FiniteDimensionalNorms.isCompact_of_isClosed_of_bounded
      (isClosed_le (SourceNorm.lp_continuous hq) continuous_const)
    rw [Metric.isBounded_iff_subset_closedBall (0 : Content D)]
    refine ⟨R, ?_⟩
    intro p hp
    rw [Metric.mem_closedBall, dist_zero_right]
    apply (pi_norm_le_iff_of_nonneg (le_of_not_gt hR)).mpr
    intro d
    rw [Real.norm_eq_abs]
    exact (AppliedModelingLib.FiniteDimensionalNorms.abs_le_lp hq p d).trans hp

/--
If arbitrarily small source-norm values occur with positive probability and
small source norm detects every content neighborhood of zero, then zero lies
in the topological support of the content law.  This is the exact
scalar-to-content support transport used by the corrected single-genre route.
-/
theorem zero_mem_support_of_zero_mem_support_sourceNormLaw
    {D : ℕ} {μ : MeasureTheory.Measure (Content D)} (ν : SourceNorm D)
    (hmeas : Measurable ν.norm)
    (hzero_detect : SourceNormZeroReflectsNeighborhood ν)
    (hzero : (0 : ℝ) ∈ (MeasureTheory.Measure.map ν.norm μ).support) :
    (0 : Content D) ∈ μ.support := by
  rw [MeasureTheory.Measure.mem_support_iff_forall] at hzero ⊢
  intro U hU
  rcases hzero_detect U hU with ⟨ε, hε_pos, hε_subset⟩
  have hmap_pos : 0 < (MeasureTheory.Measure.map ν.norm μ) (Set.Iio ε) :=
    hzero (Set.Iio ε) (Iio_mem_nhds hε_pos)
  rw [MeasureTheory.Measure.map_apply hmeas measurableSet_Iio] at hmap_pos
  refine lt_of_lt_of_le hmap_pos (MeasureTheory.measure_mono ?_)
  intro p hp
  exact hε_subset p hp

/-- Positive finite-coordinate `Lq` norms detect every product neighborhood of zero. -/
theorem SourceNorm.lp_zeroReflectsNeighborhood {D : ℕ} {q : ℝ} (hq : 0 < q) :
    SourceNormZeroReflectsNeighborhood (SourceNorm.lp D hq) := by
  intro U hU
  rcases Metric.mem_nhds_iff.mp hU with ⟨ε, hε_pos, hball⟩
  refine ⟨ε, hε_pos, ?_⟩
  intro p hp
  apply hball
  rw [Metric.mem_ball, dist_pi_lt_iff hε_pos]
  intro d
  have hp' : AppliedModelingLib.FiniteDimensionalNorms.lp q p < ε := by
    simpa [SourceNorm.lp] using hp
  rw [Real.dist_eq]
  simpa only [Pi.zero_apply, sub_zero] using
    lt_of_le_of_lt (AppliedModelingLib.FiniteDimensionalNorms.abs_le_lp hq p d) hp'

/-- The finite-coordinate Euclidean source norm detects every product neighborhood of zero. -/
theorem SourceNorm.l2_zeroReflectsNeighborhood (D : ℕ) :
    SourceNormZeroReflectsNeighborhood (SourceNorm.l2 D) := by
  intro U hU
  rcases Metric.mem_nhds_iff.mp hU with ⟨ε, hε_pos, hball⟩
  refine ⟨ε, hε_pos, ?_⟩
  intro p hp
  apply hball
  rw [Metric.mem_ball, dist_pi_lt_iff hε_pos]
  intro d
  have hp' : AppliedModelingLib.FiniteDimensionalNorms.l2 p < ε := by
    simpa [SourceNorm.l2] using hp
  rw [Real.dist_eq]
  simpa only [Pi.zero_apply, sub_zero] using
    lt_of_le_of_lt (AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le p d) hp'

/-- Positive finite-coordinate `Lq` source norms are Borel measurable. -/
theorem SourceNorm.lp_measurable {D : ℕ} {q : ℝ} (hq : 0 < q) :
    Measurable (SourceNorm.lp D hq).norm := by
  change Measurable (fun p : Content D => AppliedModelingLib.FiniteDimensionalNorms.lp q p)
  exact (AppliedModelingLib.FiniteDimensionalNorms.continuous_lp hq.le).measurable

/-- The source utility condition compares directions against normalized users. -/
noncomputable def l2NormalizedUsers {D N : ℕ} (users : Fin N → Content D) :
    Fin N → Content D :=
  fun i => SourceNorm.normalizedContent (SourceNorm.l2 D) (users i)

theorem l2NormalizedUsers_norm_eq_one {D N : ℕ}
    {users : Fin N → Content D}
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (i : Fin N) :
    (SourceNorm.l2 D).norm (l2NormalizedUsers users i) = 1 :=
  SourceNorm.norm_normalizedContent_eq_one (SourceNorm.l2 D) (husers_nonzero i)

theorem expectedUsersWonAgainstSymmetricMixed_l2NormalizedUsers_eq
    {D N P : ℕ} {users : Fin N → Content D}
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (j : Fin P) (p : Content D) (μ : MeasureTheory.Measure (Content D)) :
    ExpectedUsersWonAgainstSymmetricMixed (l2NormalizedUsers users) j p μ =
      ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  have hscale :
      ∀ i : Fin N, 0 < ((SourceNorm.l2 D).norm (users i))⁻¹ := by
    intro i
    exact inv_pos.mpr ((SourceNorm.l2 D).pos_of_nonzero (husers_nonzero i))
  simpa [l2NormalizedUsers, SourceNorm.normalizedContent] using
    (expectedUsersWonAgainstSymmetricMixed_scaleUsers_pos
      (users := users) (j := j) (p := p) (μ := μ) (scale := fun i : Fin N =>
        ((SourceNorm.l2 D).norm (users i))⁻¹) hscale)

/--
Negative-semidefinite condition for a symmetric two-dimensional quadratic
form `a11 x^2 + 2 a12 x y + a22 y^2`.
-/
def NegativeSemidefiniteQuadratic2 (a11 a12 a22 : ℝ) : Prop :=
  ∀ x y : ℝ, a11 * x ^ 2 + 2 * a12 * x * y + a22 * y ^ 2 ≤ 0

/--
Lemma `regionscolor`, Hessian-sign core: the source proof obtains a graph
Hessian difference with entries
`cross * [[slope, -1], [-1, 1 / slope]]`.  Negative semidefiniteness of this
quadratic form already implies `slope * cross <= 0` by testing the first
coordinate direction.
-/
theorem graphHessian_cross_sign_of_negativeSemidefinite
    {slope cross : ℝ}
    (hneg :
      NegativeSemidefiniteQuadratic2
        (slope * cross) (-cross) (slope⁻¹ * cross)) :
    slope * cross ≤ 0 := by
  have h := hneg 1 0
  simpa [NegativeSemidefiniteQuadratic2] using h

/--
Algebraic core of Lemma `regionscolor`. Substituting the two FOC derivatives
along a differentiable support graph into the objective second-order condition
gives the source's graph-Hessian form. Establishing the SOC and the two
derivative identities from C1 and a genuine graph remains separate.
-/
theorem graphHessian_negativeSemidefinite_of_objectiveSOC_and_graphFOCDerivatives
    {a11 a12 a22 slope h1prime h2prime : ℝ}
    (hsoc :
      NegativeSemidefiniteQuadratic2
        (h1prime - a11) (-a12) (h2prime - a22))
    (hfirst : h1prime = a11 + slope * a12)
    (hsecond : h2prime = a22 + slope⁻¹ * a12) :
    NegativeSemidefiniteQuadratic2
      (slope * a12) (-a12) (slope⁻¹ * a12) := by
  rw [hfirst, hsecond] at hsoc
  convert hsoc using 1 <;> ring

/-- Numerator of the canonical two-user induced-cost quadratic. -/
noncomputable def twoUserInducedCostNumerator
    (θ z1 z2 : ℝ) : ℝ :=
  z1 ^ 2 + z2 ^ 2 - 2 * z1 * z2 * Real.cos θ

/-- In nonsingular canonical coordinates, the induced-cost numerator vanishes
only at the zero realized-value pair.  This is the elementary positive-definite
quadratic fact needed to make the local derivative formula available after a
support ball is shrunk away from the origin. -/
theorem twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero
    {θ z1 z2 : ℝ} (hsin : Real.sin θ ≠ 0)
    (hpair : z1 ≠ 0 ∨ z2 ≠ 0) :
    twoUserInducedCostNumerator θ z1 z2 ≠ 0 := by
  intro hzero
  have htrig : Real.sin θ ^ 2 + Real.cos θ ^ 2 = 1 :=
    Real.sin_sq_add_cos_sq θ
  have hquadratic : twoUserInducedCostNumerator θ z1 z2 =
      (z2 - z1 * Real.cos θ) ^ 2 + (z1 * Real.sin θ) ^ 2 := by
    unfold twoUserInducedCostNumerator
    nlinarith
  rw [hquadratic] at hzero
  have hfirst_zero : z2 - z1 * Real.cos θ = 0 := by
    nlinarith [sq_nonneg (z2 - z1 * Real.cos θ),
      sq_nonneg (z1 * Real.sin θ)]
  have hsecond_zero : z1 * Real.sin θ = 0 := by
    nlinarith [sq_nonneg (z2 - z1 * Real.cos θ),
      sq_nonneg (z1 * Real.sin θ)]
  have hz1 : z1 = 0 := by
    rcases mul_eq_zero.mp hsecond_zero with hz1 | hsin_zero
    · exact hz1
    · exact (hsin hsin_zero).elim
  have hz2 : z2 = 0 := by
    rw [hz1] at hfirst_zero
    simpa using hfirst_zero
  exact hpair.elim (fun h => h hz1) (fun h => h hz2)

/-- Product-form wrapper for the positive-definite induced-cost numerator.
It lets support arguments discharge differentiability locally at every
nonorigin realized-value pair, without imposing a spurious global condition
at the origin. -/
theorem twoUserInducedCostNumerator_ne_zero_of_ne_zero
    {θ : ℝ} {z : ℝ × ℝ} (hsin : Real.sin θ ≠ 0)
    (hz : z ≠ (0, 0)) :
    twoUserInducedCostNumerator θ z.1 z.2 ≠ 0 := by
  apply twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin
  by_cases hfirst : z.1 = 0
  · right
    intro hsecond
    apply hz
    ext <;> simp [hfirst, hsecond]
  · exact Or.inl hfirst

/-- The canonical two-user induced-cost numerator is nonnegative. -/
theorem twoUserInducedCostNumerator_nonneg
    (θ z1 z2 : ℝ) :
    0 ≤ twoUserInducedCostNumerator θ z1 z2 := by
  have htrig : Real.sin θ ^ 2 + Real.cos θ ^ 2 = 1 :=
    Real.sin_sq_add_cos_sq θ
  have hquadratic : twoUserInducedCostNumerator θ z1 z2 =
      (z2 - z1 * Real.cos θ) ^ 2 + (z1 * Real.sin θ) ^ 2 := by
    unfold twoUserInducedCostNumerator
    nlinarith
  rw [hquadratic]
  positivity

/--
Two-user induced-cost quadratic from Lemma `inducedcost`: after rotating so
`u_1=e_1` and `u_2=(cos θ, sin θ)`, realized values `(z_1,z_2)` correspond to
content coordinates `(z_1, (z_2 - z_1 cos θ) / sin θ)`.  The Euclidean norm
squared is the source quadratic divided by `sin^2 θ`.
-/
noncomputable def twoUserInducedCostQuadratic
    (θ z1 z2 : ℝ) : ℝ :=
  twoUserInducedCostNumerator θ z1 z2 / (Real.sin θ) ^ 2

theorem twoUserCanonicalNormSq_eq_inducedCostQuadratic
    {θ z1 z2 : ℝ} (hsin : Real.sin θ ≠ 0) :
    z1 ^ 2 + ((z2 - z1 * Real.cos θ) / Real.sin θ) ^ 2 =
      twoUserInducedCostQuadratic θ z1 z2 := by
  unfold twoUserInducedCostQuadratic twoUserInducedCostNumerator
  field_simp [hsin]
  have htrig : Real.sin θ ^ 2 + Real.cos θ ^ 2 = 1 :=
    Real.sin_sq_add_cos_sq θ
  nlinarith

/--
The induced Gram quadratic is exact for every pair of linearly independent
unit users when the *ambient* content space itself is two-dimensional.  This
does not rotate the nonnegative action cone: it is the coordinate-free
two-by-two Gram identity, and is therefore the valid replacement for the
source's blanket arbitrary-dimensional equality.
-/
theorem twoUserInducedCostQuadratic_eq_score_self_of_unit_score_pair_dim_two
    {u v p : Content 2} {θ : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ) (hsin : Real.sin θ ≠ 0) :
    twoUserInducedCostQuadratic θ (score u p) (score v p) = score p p := by
  have hu' : u 0 ^ 2 + u 1 ^ 2 = 1 := by
    simpa [score, Fin.sum_univ_two, pow_two] using hu
  have hv' : v 0 ^ 2 + v 1 ^ 2 = 1 := by
    simpa [score, Fin.sum_univ_two, pow_two] using hv
  have huv' : u 0 * v 0 + u 1 * v 1 = Real.cos θ := by
    simpa [score, Fin.sum_univ_two] using huv
  have hdet : (u 0 * v 1 - u 1 * v 0) ^ 2 = (Real.sin θ) ^ 2 := by
    calc
      (u 0 * v 1 - u 1 * v 0) ^ 2 =
          (u 0 ^ 2 + u 1 ^ 2) * (v 0 ^ 2 + v 1 ^ 2) -
            (u 0 * v 0 + u 1 * v 1) ^ 2 := by ring
      _ = (Real.sin θ) ^ 2 := by
        rw [hu', hv', huv']
        nlinarith [Real.sin_sq_add_cos_sq θ]
  have hnum_error : twoUserInducedCostNumerator θ (score u p) (score v p) -
      (u 0 * v 1 - u 1 * v 0) ^ 2 * score p p =
        (1 - score v v) * (score u p) ^ 2 +
          (1 - score u u) * (score v p) ^ 2 := by
    unfold twoUserInducedCostNumerator
    rw [← huv]
    simp [score, Fin.sum_univ_two]
    ring
  have hnum : twoUserInducedCostNumerator θ (score u p) (score v p) =
      (u 0 * v 1 - u 1 * v 0) ^ 2 * score p p := by
    rw [hu, hv] at hnum_error
    norm_num at hnum_error
    linarith
  unfold twoUserInducedCostQuadratic
  rw [hnum, hdet]
  field_simp [hsin]

/-- The original score map of two ambient-dimension-two users, written in the
fixed user order of the source model.  Its image of the nonnegative content
cone is the relevant feasible set; it is not identified with the canonical
cone by a rotation. -/
noncomputable def twoUserScoreMap (u v p : Content 2) : ℝ × ℝ :=
  (score u p, score v p)

/-- The actual score-space feasible region induced by nonnegative content for
an original user pair.  This preserves the source action cone instead of
replacing it by the canonical cone. -/
noncomputable def twoUserScoreFeasibleSet (u v : Content 2) : Set (ℝ × ℝ) :=
  twoUserScoreMap u v '' {p : Content 2 | NonnegativeContent p}

/--
The closed score cone generated by the two user rays.  This is a subcone of
the actual score-feasible region whenever the original users are nonnegative;
unlike the source's canonical rotation, it never changes the content action
cone.
-/
def twoUserClosedUserCone (θ : ℝ) : Set (ℝ × ℝ) :=
  {z | Real.cos θ * z.2 ≤ z.1 ∧ Real.cos θ * z.1 ≤ z.2}

/--
Every score pair in the closed user cone has a nonnegative representative in
the conic hull of the two original users, in every finite ambient dimension.
The representative realizes the two scores and attains the unconstrained Gram
quadratic exactly.  Thus the paper's induced-cost formula is valid on this
cone even though it is false on arbitrary nonnegative score fibres.
-/
theorem exists_twoUserClosedUserCone_nonnegative_representative_any_dim
    {D : ℕ} {u v : Content D} {θ : ℝ} {z : ℝ × ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hsin : Real.sin θ ≠ 0)
    (hz : z ∈ twoUserClosedUserCone θ) :
    ∃ q : Content D,
      NonnegativeContent q ∧
      score u q = z.1 ∧
      score v q = z.2 ∧
      score q q = twoUserInducedCostQuadratic θ z.1 z.2 := by
  have hsin_sq_pos : 0 < (Real.sin θ) ^ 2 := sq_pos_of_ne_zero hsin
  let a : ℝ := (z.1 - Real.cos θ * z.2) / (Real.sin θ) ^ 2
  let b : ℝ := (z.2 - Real.cos θ * z.1) / (Real.sin θ) ^ 2
  have ha_nonnegative : 0 ≤ a := by
    dsimp [a]
    exact div_nonneg (by linarith [hz.1]) hsin_sq_pos.le
  have hb_nonnegative : 0 ≤ b := by
    dsimp [b]
    exact div_nonneg (by linarith [hz.2]) hsin_sq_pos.le
  let q : Content D := scaleContent a u + scaleContent b v
  have hq_nonnegative : NonnegativeContent q := by
    intro d
    exact add_nonneg
      (scaleContent_nonnegative ha_nonnegative hu_nonnegative d)
      (scaleContent_nonnegative hb_nonnegative hv_nonnegative d)
  have hvu : score v u = Real.cos θ := by
    rw [score_comm]
    exact huv
  have hscore_u : score u q = z.1 := by
    dsimp [q]
    rw [score_add, score_scaleContent, score_scaleContent, hu, huv]
    dsimp [a, b]
    field_simp [hsin]
    linear_combination -z.1 * (Real.sin_sq_add_cos_sq θ)
  have hscore_v : score v q = z.2 := by
    dsimp [q]
    rw [score_add, score_scaleContent, score_scaleContent, hvu, hv]
    dsimp [a, b]
    field_simp [hsin]
    linear_combination -z.2 * (Real.sin_sq_add_cos_sq θ)
  have hscore_self :
      score q q = twoUserInducedCostQuadratic θ z.1 z.2 := by
    have hspan : score q q = a * z.1 + b * z.2 := by
      rw [show q = scaleContent a u + scaleContent b v by rfl,
        score_add_left, score_scaleUser, score_scaleUser, hscore_u, hscore_v]
    rw [hspan]
    dsimp [a, b]
    unfold twoUserInducedCostQuadratic twoUserInducedCostNumerator
    field_simp [hsin]
    ring
  exact ⟨q, hq_nonnegative, hscore_u, hscore_v, hscore_self⟩

/--
Every score pair between the original user rays is realized by a nonnegative
combination of those users.  The displayed coefficients are the inverse Gram
coordinates, and their nonnegativity is exactly the two cone inequalities.
-/
theorem twoUserClosedUserCone_subset_scoreFeasible
    {u v : Content 2} {θ : ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hsin : Real.sin θ ≠ 0) :
    twoUserClosedUserCone θ ⊆ twoUserScoreFeasibleSet u v := by
  intro z hz
  have hsin_sq_pos : 0 < (Real.sin θ) ^ 2 :=
    sq_pos_of_ne_zero hsin
  let a : ℝ := (z.1 - Real.cos θ * z.2) / (Real.sin θ) ^ 2
  let b : ℝ := (z.2 - Real.cos θ * z.1) / (Real.sin θ) ^ 2
  have ha_nonnegative : 0 ≤ a := by
    dsimp [a]
    exact div_nonneg (by linarith [hz.1]) hsin_sq_pos.le
  have hb_nonnegative : 0 ≤ b := by
    dsimp [b]
    exact div_nonneg (by linarith [hz.2]) hsin_sq_pos.le
  let p : Content 2 := scaleContent a u + scaleContent b v
  have hp_nonnegative : NonnegativeContent p := by
    intro d
    exact add_nonneg
      (scaleContent_nonnegative ha_nonnegative hu_nonnegative d)
      (scaleContent_nonnegative hb_nonnegative hv_nonnegative d)
  refine ⟨p, hp_nonnegative, ?_⟩
  have hvu : score v u = Real.cos θ := by
    rw [score_comm]
    exact huv
  apply Prod.ext
  · dsimp [twoUserScoreMap, p]
    rw [score_add, score_scaleContent, score_scaleContent, hu, huv]
    dsimp [a, b]
    field_simp [hsin]
    linear_combination -z.1 * (Real.sin_sq_add_cos_sq θ)
  · dsimp [twoUserScoreMap, p]
    rw [score_add, score_scaleContent, score_scaleContent, hvu, hv]
    dsimp [a, b]
    field_simp [hsin]
    linear_combination -z.2 * (Real.sin_sq_add_cos_sq θ)

/-- The original closed user-ray score cone is closed under coordinatewise
meet in the source's nonnegative-angle regime. -/
theorem twoUserClosedUserCone_min_mem {θ : ℝ} (hcos : 0 ≤ Real.cos θ)
    {x y : ℝ × ℝ}
    (hx : x ∈ twoUserClosedUserCone θ)
    (hy : y ∈ twoUserClosedUserCone θ) :
    (min x.1 y.1, min x.2 y.2) ∈ twoUserClosedUserCone θ := by
  constructor
  · apply le_min
    · calc
        Real.cos θ * min x.2 y.2 ≤ Real.cos θ * x.2 :=
          mul_le_mul_of_nonneg_left (min_le_left _ _) hcos
        _ ≤ x.1 := hx.1
    · calc
        Real.cos θ * min x.2 y.2 ≤ Real.cos θ * y.2 :=
          mul_le_mul_of_nonneg_left (min_le_right _ _) hcos
        _ ≤ y.1 := hy.1
  · apply le_min
    · calc
        Real.cos θ * min x.1 y.1 ≤ Real.cos θ * x.1 :=
          mul_le_mul_of_nonneg_left (min_le_left _ _) hcos
        _ ≤ x.2 := hx.2
    · calc
        Real.cos θ * min x.1 y.1 ≤ Real.cos θ * y.1 :=
          mul_le_mul_of_nonneg_left (min_le_right _ _) hcos
        _ ≤ y.2 := hy.2

/-- The original closed user-ray score cone is closed under coordinatewise
join. -/
theorem twoUserClosedUserCone_max_mem {θ : ℝ} {x y : ℝ × ℝ}
    (hx : x ∈ twoUserClosedUserCone θ)
    (hy : y ∈ twoUserClosedUserCone θ) :
    (max x.1 y.1, max x.2 y.2) ∈ twoUserClosedUserCone θ := by
  constructor
  · rcases le_total x.2 y.2 with hxy | hyx
    · rw [max_eq_right hxy]
      exact le_trans hy.1 (le_max_right _ _)
    · rw [max_eq_left hyx]
      exact le_trans hx.1 (le_max_left _ _)
  · rcases le_total x.1 y.1 with hxy | hyx
    · rw [max_eq_right hxy]
      exact le_trans hy.2 (le_max_right _ _)
    · rw [max_eq_left hyx]
      exact le_trans hx.2 (le_max_left _ _)

/--
Strict membership between nonobtuse user rays forces both score coordinates to
be positive.  This is the positivity bridge from strict user-cone geometry to
the induced-cost and C1 derivative formulas.
-/
theorem twoUserClosedUserCone_strict_pos
    {θ : ℝ} {z : ℝ × ℝ}
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hz1 : Real.cos θ * z.2 < z.1)
    (hz2 : Real.cos θ * z.1 < z.2) :
    0 < z.1 ∧ 0 < z.2 := by
  by_cases hcos_zero : Real.cos θ = 0
  · constructor
    · simpa [hcos_zero] using hz1
    · simpa [hcos_zero] using hz2
  have hcos_pos : 0 < Real.cos θ := lt_of_le_of_ne hcos (Ne.symm hcos_zero)
  have hcos_sq_lt_one : (Real.cos θ) ^ 2 < 1 := by
    nlinarith [Real.sin_sq_add_cos_sq θ, sq_pos_of_pos hsin]
  have hz1_sq : (Real.cos θ) ^ 2 * z.1 < z.1 := by
    calc
      (Real.cos θ) ^ 2 * z.1 = Real.cos θ * (Real.cos θ * z.1) := by ring
      _ < Real.cos θ * z.2 :=
        mul_lt_mul_of_pos_left hz2 hcos_pos
      _ < z.1 := hz1
  have hz2_sq : (Real.cos θ) ^ 2 * z.2 < z.2 := by
    calc
      (Real.cos θ) ^ 2 * z.2 = Real.cos θ * (Real.cos θ * z.2) := by ring
      _ < Real.cos θ * z.1 :=
        mul_lt_mul_of_pos_left hz1 hcos_pos
      _ < z.2 := hz2
  constructor <;> nlinarith

/-- Matrix of `twoUserScoreMap` in the standard content coordinates. -/
def twoUserScoreMatrix (u v : Content 2) : Matrix (Fin 2) (Fin 2) ℝ :=
  fun i j => if i = 0 then u j else v j

/--
Linearly independent unit users with the stated angular cosine have an
invertible original score map.  This is the determinant calculation needed
for the source's two-dimensional structural statements; it does not rotate
the nonnegative content cone.
-/
theorem twoUserScoreMatrix_det_ne_zero_of_unit_score_pair
    {u v : Content 2} {θ : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ) (hsin : Real.sin θ ≠ 0) :
    u 0 * v 1 - u 1 * v 0 ≠ 0 := by
  have hu' : u 0 ^ 2 + u 1 ^ 2 = 1 := by
    simpa [score, Fin.sum_univ_two, pow_two] using hu
  have hv' : v 0 ^ 2 + v 1 ^ 2 = 1 := by
    simpa [score, Fin.sum_univ_two, pow_two] using hv
  have huv' : u 0 * v 0 + u 1 * v 1 = Real.cos θ := by
    simpa [score, Fin.sum_univ_two] using huv
  have hdet_sq : (u 0 * v 1 - u 1 * v 0) ^ 2 = (Real.sin θ) ^ 2 := by
    calc
      (u 0 * v 1 - u 1 * v 0) ^ 2 =
          (u 0 ^ 2 + u 1 ^ 2) * (v 0 ^ 2 + v 1 ^ 2) -
            (u 0 * v 0 + u 1 * v 1) ^ 2 := by ring
      _ = (Real.sin θ) ^ 2 := by
        rw [hu', hv', huv']
        nlinarith [Real.sin_sq_add_cos_sq θ]
  intro hzero
  apply hsin
  apply sq_eq_zero_iff.mp
  rw [← hdet_sq, hzero]
  norm_num

/--
An invertible two-user score matrix gives a homeomorphism from the original
content plane to score space.  The equality records that this is the actual
score map, so open content support regions transport to open score regions
without changing the nonnegative action domain.
-/
theorem exists_twoUserScoreMap_homeomorph
    {u v : Content 2}
    (hdet : u 0 * v 1 - u 1 * v 0 ≠ 0) :
    ∃ e : Content 2 ≃ₜ ℝ × ℝ, ∀ p : Content 2,
      e p = twoUserScoreMap u v p := by
  classical
  let M := twoUserScoreMatrix u v
  have hMdet : M.det ≠ 0 := by
    simpa [M, twoUserScoreMatrix, Matrix.det_fin_two] using hdet
  have hunitdet : IsUnit M.det := isUnit_iff_ne_zero.mpr hMdet
  have hunit : IsUnit M := (Matrix.isUnit_iff_isUnit_det M).mpr hunitdet
  letI : Invertible M := hunit.invertible
  let e : Content 2 ≃ₜ ℝ × ℝ :=
    ((M.toLinearEquiv' inferInstance).toContinuousLinearEquiv.trans
      (ContinuousLinearEquiv.finTwoArrow ℝ ℝ)).toHomeomorph
  refine ⟨e, ?_⟩
  intro p
  change (M.mulVec p 0, M.mulVec p 1) = twoUserScoreMap u v p
  constructor <;>
    simp [M, twoUserScoreMatrix, twoUserScoreMap, score, Fin.sum_univ_two]

/--
The image of an open original-content set under an invertible two-user score
map is open.  This is the cone-preserving topology transport required by the
two-user support-restriction proof.
-/
theorem isOpen_twoUserScoreMap_image
    {u v : Content 2} {S : Set (Content 2)}
    (hdet : u 0 * v 1 - u 1 * v 0 ≠ 0) (hopen : IsOpen S) :
    IsOpen (twoUserScoreMap u v '' S) := by
  obtain ⟨e, he⟩ := exists_twoUserScoreMap_homeomorph (u := u) (v := v) hdet
  have himage : e '' S = twoUserScoreMap u v '' S := by
    ext z
    constructor
    · rintro ⟨p, hp, rfl⟩
      exact ⟨p, hp, (he p).symm⟩
    · rintro ⟨p, hp, rfl⟩
      exact ⟨p, hp, he p⟩
  rw [← himage]
  exact e.isOpen_image.mpr hopen

/--
A score pair strictly between the two original user rays is an interior point
of the actual score-feasible region.  Inverse-Gram coordinates make its
content representative a strictly positive combination of the nonnegative
users; in dimension two, linear independence then makes both content
coordinates strictly positive.  The invertible score map transports that open
content neighborhood without rotating the action cone.
-/
theorem twoUserScoreFeasibleSet_mem_nhds_of_closedUserCone_strict
    {u v : Content 2} {θ : ℝ} {z : ℝ × ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hsin : 0 < Real.sin θ)
    (hz1 : Real.cos θ * z.2 < z.1)
    (hz2 : Real.cos θ * z.1 < z.2) :
    twoUserScoreFeasibleSet u v ∈ 𝓝 z := by
  have hsin_sq_pos : 0 < (Real.sin θ) ^ 2 :=
    sq_pos_of_pos hsin
  let a : ℝ := (z.1 - Real.cos θ * z.2) / (Real.sin θ) ^ 2
  let b : ℝ := (z.2 - Real.cos θ * z.1) / (Real.sin θ) ^ 2
  have ha_pos : 0 < a := by
    dsimp [a]
    exact div_pos (by linarith) hsin_sq_pos
  have hb_pos : 0 < b := by
    dsimp [b]
    exact div_pos (by linarith) hsin_sq_pos
  let p : Content 2 := scaleContent a u + scaleContent b v
  have hp_pos : ∀ d : Fin 2, 0 < p d := by
    intro d
    have hp_nonneg : 0 ≤ p d := by
      dsimp [p]
      exact add_nonneg (mul_nonneg ha_pos.le (hu_nonnegative d))
        (mul_nonneg hb_pos.le (hv_nonnegative d))
    apply lt_of_le_of_ne hp_nonneg
    intro hp_zero
    change 0 = a * u d + b * v d at hp_zero
    have hau_zero : a * u d = 0 := by
      have hau_nonneg : 0 ≤ a * u d := mul_nonneg ha_pos.le (hu_nonnegative d)
      have hbv_nonneg : 0 ≤ b * v d := mul_nonneg hb_pos.le (hv_nonnegative d)
      linarith
    have hbv_zero : b * v d = 0 := by
      have hau_nonneg : 0 ≤ a * u d := mul_nonneg ha_pos.le (hu_nonnegative d)
      have hbv_nonneg : 0 ≤ b * v d := mul_nonneg hb_pos.le (hv_nonnegative d)
      linarith
    have hu_zero : u d = 0 := (mul_eq_zero.mp hau_zero).resolve_left ha_pos.ne'
    have hv_zero : v d = 0 := (mul_eq_zero.mp hbv_zero).resolve_left hb_pos.ne'
    have hdet := twoUserScoreMatrix_det_ne_zero_of_unit_score_pair
      hu hv huv hsin.ne'
    fin_cases d
    · have hu0 : u 0 = 0 := by simpa using hu_zero
      have hv0 : v 0 = 0 := by simpa using hv_zero
      exact hdet (by rw [hu0, hv0]; ring)
    · have hu1 : u 1 = 0 := by simpa using hu_zero
      have hv1 : v 1 = 0 := by simpa using hv_zero
      exact hdet (by rw [hu1, hv1]; ring)
  have hp_scores : twoUserScoreMap u v p = z := by
    have hvu : score v u = Real.cos θ := by
      rw [score_comm]
      exact huv
    apply Prod.ext
    · dsimp [twoUserScoreMap, p]
      rw [score_add, score_scaleContent, score_scaleContent, hu, huv]
      dsimp [a, b]
      field_simp [hsin.ne']
      linear_combination -z.1 * (Real.sin_sq_add_cos_sq θ)
    · dsimp [twoUserScoreMap, p]
      rw [score_add, score_scaleContent, score_scaleContent, hvu, hv]
      dsimp [a, b]
      field_simp [hsin.ne']
      linear_combination -z.2 * (Real.sin_sq_add_cos_sq θ)
  let U : Set (Content 2) := {q | ∀ d, 0 < q d}
  have hU_open : IsOpen U := by
    have hset : U = {q : Content 2 | 0 < q 0} ∩ {q : Content 2 | 0 < q 1} := by
      ext q
      constructor
      · intro h
        exact ⟨h 0, h 1⟩
      · rintro ⟨h0, h1⟩ d
        fin_cases d
        · exact h0
        · exact h1
    rw [hset]
    exact (isOpen_Ioi.preimage (continuous_apply 0)).inter
      (isOpen_Ioi.preimage (continuous_apply 1))
  have hpU : p ∈ U := hp_pos
  have hdet := twoUserScoreMatrix_det_ne_zero_of_unit_score_pair
    hu hv huv hsin.ne'
  obtain ⟨e, he⟩ := exists_twoUserScoreMap_homeomorph (u := u) (v := v) hdet
  have himage_open : IsOpen (e '' U) := e.isOpen_image.mpr hU_open
  have hez : e p = z := by rw [he, hp_scores]
  have himage_nhds : e '' U ∈ 𝓝 z := by
    rw [← hez]
    exact himage_open.mem_nhds ⟨p, hpU, rfl⟩
  apply Filter.mem_of_superset himage_nhds
  rintro w ⟨q, hqU, hw⟩
  refine ⟨q, ?_, ?_⟩
  · intro d
    exact (hqU d).le
  · rw [← hw, he]

/--
The two realized scores of a content vector lie in the Gram ellipse of two
unit source users.  This is the source-faithful replacement for the paper's
informal coordinate rotation: it uses only the finite-coordinate score and
therefore does not carry the nonnegative-content cone to a different domain.
-/
theorem twoUserInducedCostQuadratic_le_score_self_of_unit_score_pair
    {D : ℕ} {u v p : Content D} {θ : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ) (hsin : Real.sin θ ≠ 0) :
    twoUserInducedCostQuadratic θ (score u p) (score v p) ≤ score p p := by
  let c : ℝ := Real.cos θ
  let s : ℝ := Real.sin θ
  let w : Content D := scaleContent s⁻¹ (v - scaleContent c u)
  have hvu : score v u = c := by
    rw [score_comm]
    simpa [c] using huv
  have hscore_uw : score u w = 0 := by
    rw [show w = scaleContent s⁻¹ (v - scaleContent c u) by rfl,
      score_scaleContent, score_sub, score_scaleContent]
    rw [hu, huv]
    dsimp [c, s]
    field_simp [hsin]
    ring
  have hscore_wu : score w u = 0 := by
    rw [score_comm]
    exact hscore_uw
  have hbase : score (v - scaleContent c u) (v - scaleContent c u) = s ^ 2 := by
    simp_rw [score_sub_left, score_sub, score_scaleUser, score_scaleContent]
    rw [hv, hu, hvu, huv]
    dsimp [c, s]
    have htrig : Real.sin θ ^ 2 + Real.cos θ ^ 2 = 1 :=
      Real.sin_sq_add_cos_sq θ
    nlinarith
  have hscore_ww : score w w = 1 := by
    rw [show w = scaleContent s⁻¹ (v - scaleContent c u) by rfl,
      score_scaleUser, score_scaleContent, hbase]
    dsimp [s]
    field_simp [hsin]
  have hscore_wp : score w p = (score v p - c * score u p) / s := by
    rw [show w = scaleContent s⁻¹ (v - scaleContent c u) by rfl,
      score_scaleUser, score_sub_left, score_scaleUser]
    dsimp [s]
    field_simp [hsin]
  let a : ℝ := score u p
  let b : ℝ := score w p
  let r : Content D := p - scaleContent a u - scaleContent b w
  have hpu : score p u = a := by
    rw [score_comm]
  have hpw : score p w = b := by
    rw [score_comm]
  have hresidual : score r r = score p p - a ^ 2 - b ^ 2 := by
    dsimp only [r]
    simp_rw [score_sub_left, score_sub, score_scaleContent, score_scaleUser]
    rw [hpu, hpw, hu, hscore_uw, hscore_wu, hscore_ww]
    dsimp only [a, b]
    ring
  have hresidual_nonneg : 0 ≤ score r r := score_self_nonnegative r
  have hcoordinates : a ^ 2 + b ^ 2 =
      twoUserInducedCostQuadratic θ (score u p) (score v p) := by
    dsimp only [a, b]
    rw [hscore_wp]
    dsimp only [c, s]
    simpa [mul_comm] using
      (twoUserCanonicalNormSq_eq_inducedCostQuadratic
        (z1 := score u p) (z2 := score v p) hsin)
  calc
    twoUserInducedCostQuadratic θ (score u p) (score v p) = a ^ 2 + b ^ 2 :=
      hcoordinates.symm
    _ ≤ score p p := by nlinarith

/--
Polar coordinates for the nonnegative part of the two-user Gram ellipse.
The angle interval is the full cone on which both user scores are
nonnegative, rather than the smaller central interval drawn in the paper.
This closes the domain issue in the printed rotation argument: every
nonnegative score pair in the ellipse has such a representation.
-/
theorem exists_twoUser_polar_of_nonnegative_pair_of_inducedCostQuadratic_le_one
    {theta z1 z2 : ℝ}
    (htheta_nonnegative : 0 ≤ theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2)
    (hsin : Real.sin theta ≠ 0)
    (hz1 : 0 ≤ z1) (hz2 : 0 ≤ z2)
    (hquadratic : twoUserInducedCostQuadratic theta z1 z2 ≤ 1) :
    ∃ r phi : ℝ,
      r ∈ Set.Icc 0 1 ∧
      phi ∈ Set.Icc (theta - Real.pi / 2) (Real.pi / 2) ∧
      z1 = r * Real.cos phi ∧
      z2 = r * Real.cos (theta - phi) := by
  by_cases hzero : z1 = 0 ∧ z2 = 0
  · refine ⟨0, theta / 2, by simp, ?_, ?_, ?_⟩
    · constructor <;> linarith [Real.pi_pos]
    · simp [hzero.1]
    · simp [hzero.2]
  · let y : ℝ := (z2 - z1 * Real.cos theta) / Real.sin theta
    let zeta : ℂ := z1 + y * Complex.I
    let r : ℝ := ‖zeta‖
    let phi : ℝ := Complex.arg zeta
    have hzeta_ne : zeta ≠ 0 := by
      intro hzeta
      have hz1_zero : z1 = 0 := by
        have hre := congrArg Complex.re hzeta
        simpa [zeta] using hre
      have hy_zero : y = 0 := by
        have him := congrArg Complex.im hzeta
        simpa [zeta] using him
      have hz2_zero : z2 = 0 := by
        have hy_identity : Real.sin theta * y = z2 - z1 * Real.cos theta := by
          dsimp [y]
          field_simp [hsin]
        rw [hy_zero, hz1_zero] at hy_identity
        linarith
      exact hzero ⟨hz1_zero, hz2_zero⟩
    have hr_positive : 0 < r := by
      dsimp [r]
      exact norm_pos_iff.mpr hzeta_ne
    have hr_nonnegative : 0 ≤ r := hr_positive.le
    have hpolar_first : r * Real.cos phi = z1 := by
      dsimp [r, phi]
      simpa [zeta] using Complex.norm_mul_cos_arg zeta
    have hpolar_second_coordinate : r * Real.sin phi = y := by
      dsimp [r, phi]
      simpa [zeta] using Complex.norm_mul_sin_arg zeta
    have hr_sq : r ^ 2 = twoUserInducedCostQuadratic theta z1 z2 := by
      calc
        r ^ 2 = Complex.normSq zeta := by
          simpa [r] using Complex.sq_norm zeta
        _ = z1 ^ 2 + y ^ 2 := by simp [zeta, Complex.normSq_add_mul_I]
        _ = twoUserInducedCostQuadratic theta z1 z2 := by
          simpa [y] using
            (twoUserCanonicalNormSq_eq_inducedCostQuadratic
              (θ := theta) (z1 := z1) (z2 := z2) hsin)
    have hr_le_one : r ≤ 1 := by
      nlinarith
    have hphi_abs : |phi| ≤ Real.pi / 2 := by
      dsimp [phi]
      rw [Complex.abs_arg_le_pi_div_two_iff]
      simpa [zeta] using hz1
    have hphi_lower : -Real.pi / 2 ≤ phi := by
      have := (abs_le.mp hphi_abs).1
      convert this using 1 <;> ring
    have hphi_upper : phi ≤ Real.pi / 2 := (abs_le.mp hphi_abs).2
    have hy_identity : Real.sin theta * y = z2 - z1 * Real.cos theta := by
      dsimp [y]
      field_simp [hsin]
    have hpolar_second : z2 = r * Real.cos (theta - phi) := by
      calc
        z2 = z1 * Real.cos theta + Real.sin theta * y := by
          rw [hy_identity]
          ring
        _ = (r * Real.cos phi) * Real.cos theta +
            Real.sin theta * (r * Real.sin phi) := by
          rw [hpolar_first, hpolar_second_coordinate]
        _ = r * Real.cos (theta - phi) := by
          rw [Real.cos_sub]
          ring
    have hcos_second_nonnegative : 0 ≤ Real.cos (theta - phi) := by
      have hproduct : 0 ≤ r * Real.cos (theta - phi) := by
        simpa [hpolar_second] using hz2
      exact nonneg_of_mul_nonneg_left (by simpa [mul_comm] using hproduct) hr_positive
    have hphi_cone_lower : theta - Real.pi / 2 ≤ phi := by
      by_contra hnot
      have hangle_left : Real.pi / 2 < theta - phi := by linarith
      have hangle_le_pi : theta - phi ≤ Real.pi := by
        linarith
      have hangle_right : theta - phi < Real.pi + Real.pi / 2 := by
        linarith [Real.pi_pos]
      have hcos_negative : Real.cos (theta - phi) < 0 :=
        Real.cos_neg_of_pi_div_two_lt_of_lt hangle_left hangle_right
      linarith
    exact ⟨r, phi, ⟨hr_nonnegative, hr_le_one⟩,
      ⟨hphi_cone_lower, hphi_upper⟩, hpolar_first.symm, hpolar_second⟩

theorem hasDerivAt_twoUserInducedCostNumerator_z1
    {θ z1 z2 : ℝ} :
    HasDerivAt (fun x : ℝ => twoUserInducedCostNumerator θ x z2)
      (2 * (z1 - z2 * Real.cos θ)) z1 := by
  have hsq : HasDerivAt (fun x : ℝ => x ^ 2) (2 * z1) z1 := by
    simpa using hasDerivAt_pow 2 z1
  have hconst : HasDerivAt (fun _x : ℝ => z2 ^ 2) 0 z1 :=
    hasDerivAt_const z1 (z2 ^ 2)
  have hlin :
      HasDerivAt (fun x : ℝ => 2 * x * z2 * Real.cos θ)
        (2 * z2 * Real.cos θ) z1 := by
    have h := (hasDerivAt_id z1).const_mul (2 * z2 * Real.cos θ)
    convert h using 1
    · ext x
      simp [id]
      ring_nf
    · ring_nf
  have h := (hsq.add hconst).sub hlin
  convert h using 1
  all_goals ring_nf

theorem hasDerivAt_twoUserInducedCostNumerator_z2
    {θ z1 z2 : ℝ} :
    HasDerivAt (fun y : ℝ => twoUserInducedCostNumerator θ z1 y)
      (2 * (z2 - z1 * Real.cos θ)) z2 := by
  have hsq : HasDerivAt (fun y : ℝ => y ^ 2) (2 * z2) z2 := by
    simpa using hasDerivAt_pow 2 z2
  have hconst : HasDerivAt (fun _y : ℝ => z1 ^ 2) 0 z2 :=
    hasDerivAt_const z2 (z1 ^ 2)
  have hlin :
      HasDerivAt (fun y : ℝ => 2 * z1 * y * Real.cos θ)
        (2 * z1 * Real.cos θ) z2 := by
    have h := (hasDerivAt_id z2).const_mul (2 * z1 * Real.cos θ)
    convert h using 1
    · ext y
      simp [id]
      ring_nf
    · ring_nf
  have h := (hconst.add hsq).sub hlin
  convert h using 1
  all_goals ring_nf

/-- Source induced-cost formula from Lemma `inducedcost` in canonical coordinates. -/
noncomputable def twoUserInducedCost
    (α β θ z1 z2 : ℝ) : ℝ :=
  α * (Real.sin θ) ^ (-β) *
    (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2)

/-- The induced norm-power cost is the `β / 2` power of the Gram-ellipse
quadratic.  This rewrites the source formula without choosing coordinates. -/
theorem twoUserInducedCost_eq_inducedCostQuadratic_rpow
    {beta theta z1 z2 : ℝ} (hsin : 0 < Real.sin theta) :
    twoUserInducedCost 1 beta theta z1 z2 =
      (twoUserInducedCostQuadratic theta z1 z2) ^ (beta / 2) := by
  unfold twoUserInducedCost twoUserInducedCostQuadratic
  rw [one_mul, Real.div_rpow (twoUserInducedCostNumerator_nonneg theta z1 z2)
    (sq_nonneg (Real.sin theta))]
  have hsin_sq : ((Real.sin theta) ^ 2) ^ (-(beta / 2)) =
      (Real.sin theta) ^ (-beta) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hsin.le]
    congr 1
    ring
  rw [div_eq_mul_inv, mul_comm]
  congr 1
  rw [← Real.rpow_neg (sq_nonneg (Real.sin theta))]
  exact hsin_sq.symm

/--
In ambient dimension two, the source induced cost is the actual L2 power cost
at every content action for any unit user pair with the stated angle.  The
proof is the Gram identity above and does not apply a cone-changing rotation.
-/
theorem twoUserInducedCost_eq_l2_rpow_of_unit_score_pair_dim_two
    {u v p : Content 2} {beta theta : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta) (hsin : 0 < Real.sin theta) :
    twoUserInducedCost 1 beta theta (score u p) (score v p) =
      AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ beta := by
  rw [twoUserInducedCost_eq_inducedCostQuadratic_rpow hsin]
  rw [twoUserInducedCostQuadratic_eq_score_self_of_unit_score_pair_dim_two
    hu hv huv hsin.ne']
  rw [score_self_eq_l2_sq]
  rw [← Real.rpow_natCast, ← Real.rpow_mul
    (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p)]
  congr 1
  ring

/-- For arbitrary-dimensional unit users with the stated Gram angle, the
two-score induced cost is no larger than the original Euclidean norm-power
cost.  This is the cone-safe form of the source's coordinate reduction. -/
theorem twoUserInducedCost_le_l2_rpow_of_unit_score_pair
    {D : ℕ} {u v p : Content D} {beta theta : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta) (hsin : 0 < Real.sin theta)
    (hbeta : 0 ≤ beta) :
    twoUserInducedCost 1 beta theta (score u p) (score v p) ≤
      AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ beta := by
  rw [twoUserInducedCost_eq_inducedCostQuadratic_rpow hsin]
  have hquad : twoUserInducedCostQuadratic theta (score u p) (score v p) ≤
      score p p :=
    twoUserInducedCostQuadratic_le_score_self_of_unit_score_pair hu hv huv hsin.ne'
  have hself : score p p = AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ 2 :=
    score_self_eq_l2_sq p
  calc
    (twoUserInducedCostQuadratic theta (score u p) (score v p)) ^ (beta / 2) ≤
        (score p p) ^ (beta / 2) :=
      Real.rpow_le_rpow (by
        exact div_nonneg (twoUserInducedCostNumerator_nonneg theta (score u p) (score v p))
          (sq_nonneg (Real.sin theta))) hquad (by positivity)
    _ = AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ beta := by
      rw [hself]
      rw [← Real.rpow_natCast, ← Real.rpow_mul
        (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p)]
      congr 1
      change 2 * (beta / 2) = beta
      ring

/-- The squared Euclidean cost induced by a two-user score fibre, with the
source's nonnegative-content action constraint kept explicit.  This is the
`beta = 2`, unit-cost specialization of the fibre minimization in Lemma
`inducedcost`; it is intentionally totalized by `sInf` outside nonempty
fibres, as required by Lean's real infimum. -/
noncomputable def twoUserNonnegativeFiberNormSq {D : ℕ}
    (u v : Content D) (z1 z2 : ℝ) : ℝ :=
  sInf {t : ℝ | ∃ p : Content D,
    NonnegativeContent p ∧ score u p = z1 ∧ score v p = z2 ∧ t = score p p}

/-- The exact constrained nonnegative-fibre cost in the paper's `L2^beta`
convention.  As for the squared-cost definition, it is totalized outside a
nonempty fibre by Lean's `sInf` convention. -/
noncomputable def twoUserNonnegativeFiberL2Rpow {D : ℕ}
    (beta : ℝ) (u v : Content D) (z1 z2 : ℝ) : ℝ :=
  (twoUserNonnegativeFiberNormSq u v z1 z2) ^ (beta / 2)

/-- The exact constrained fibre power cost is no larger than the L2 power cost
of any nonnegative realization of the same two scores. -/
theorem twoUserNonnegativeFiberL2Rpow_le_l2_rpow
    {D : ℕ} {u v p : Content D} {beta : ℝ}
    (hbeta : 0 ≤ beta) (hp : NonnegativeContent p) :
    twoUserNonnegativeFiberL2Rpow beta u v (score u p) (score v p) ≤
      AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ beta := by
  unfold twoUserNonnegativeFiberL2Rpow
  rw [l2_rpow_eq_score_self_rpow_div_two]
  have hfiber_le : twoUserNonnegativeFiberNormSq u v (score u p) (score v p) ≤
      score p p := by
    unfold twoUserNonnegativeFiberNormSq
    apply csInf_le
    · refine ⟨0, ?_⟩
      rintro t ⟨q, hq, hqfirst, hqsecond, rfl⟩
      exact score_self_nonnegative q
    · exact ⟨p, hp, rfl, rfl, rfl⟩
  apply Real.rpow_le_rpow
  · unfold twoUserNonnegativeFiberNormSq
    refine le_csInf ?_ ?_
    · exact ⟨score p p, ⟨p, hp, rfl, rfl, rfl⟩⟩
    · intro t ht
      obtain ⟨q, hq, hqfirst, hqsecond, ht⟩ := ht
      rw [ht]
      exact score_self_nonnegative q
  · exact hfiber_le
  · exact div_nonneg hbeta (by norm_num)

/-- The unconstrained Gram quadratic is a lower bound on the exact
nonnegative-fibre squared cost whenever the score fibre is nonempty.  This is
the valid arbitrary-dimensional direction of the source's `inducedcost`
calculation; equality is a separate cone-geometry question. -/
theorem twoUserInducedCostQuadratic_le_nonnegativeFiberNormSq
    {D : ℕ} {u v : Content D} {theta z1 z2 : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta) (hsin : Real.sin theta ≠ 0)
    (hfiber : ∃ p : Content D,
      NonnegativeContent p ∧ score u p = z1 ∧ score v p = z2) :
    twoUserInducedCostQuadratic theta z1 z2 ≤
      twoUserNonnegativeFiberNormSq u v z1 z2 := by
  unfold twoUserNonnegativeFiberNormSq
  refine le_csInf ?_ ?_
  · obtain ⟨p, hp, hpfirst, hpsecond⟩ := hfiber
    exact ⟨score p p, ⟨p, hp, hpfirst, hpsecond, rfl⟩⟩
  · intro t ht
    obtain ⟨p, hp, hpfirst, hpsecond, ht⟩ := ht
    rw [ht]
    have hquadratic :=
      twoUserInducedCostQuadratic_le_score_self_of_unit_score_pair hu hv huv hsin (p := p)
    simpa [hpfirst, hpsecond] using hquadratic

/-- An explicit three-coordinate pair used to audit the dimension claim in
Lemma `inducedcost` of the source.  These are nonnegative unit users with
inner product `9 / 25`. -/
noncomputable def threeCoordinateInducedCostFirstUser : Content 3 :=
  fun d => if d = (0 : Fin 3) then (3 / 5 : ℝ) else
    if d = (1 : Fin 3) then (4 / 5 : ℝ) else 0

/-- The second user in the three-coordinate induced-cost audit example. -/
noncomputable def threeCoordinateInducedCostSecondUser : Content 3 :=
  fun d => if d = (0 : Fin 3) then (3 / 5 : ℝ) else
    if d = (2 : Fin 3) then (4 / 5 : ℝ) else 0

/-- A concrete nonnegative content point in the audited score fibre. -/
noncomputable def threeCoordinateInducedCostContent : Content 3 :=
  fun d => if d = (1 : Fin 3) then 1 else 0

theorem threeCoordinateInducedCostFirstUser_nonnegative :
    NonnegativeContent threeCoordinateInducedCostFirstUser := by
  intro d
  fin_cases d <;> norm_num [threeCoordinateInducedCostFirstUser, Fin.ext_iff]

theorem threeCoordinateInducedCostSecondUser_nonnegative :
    NonnegativeContent threeCoordinateInducedCostSecondUser := by
  intro d
  fin_cases d <;> norm_num [threeCoordinateInducedCostSecondUser, Fin.ext_iff]

theorem score_threeCoordinateInducedCostFirstUser (q : Content 3) :
    score threeCoordinateInducedCostFirstUser q =
      (3 / 5 : ℝ) * q 0 + (4 / 5 : ℝ) * q 1 := by
  simp [score, threeCoordinateInducedCostFirstUser, Fin.sum_univ_succ]

theorem score_threeCoordinateInducedCostSecondUser (q : Content 3) :
    score threeCoordinateInducedCostSecondUser q =
      (3 / 5 : ℝ) * q 0 + (4 / 5 : ℝ) * q 2 := by
  simp [score, threeCoordinateInducedCostSecondUser, Fin.sum_univ_succ]

theorem score_threeCoordinateInducedCostFirstUser_self :
    score threeCoordinateInducedCostFirstUser threeCoordinateInducedCostFirstUser = 1 := by
  rw [score_threeCoordinateInducedCostFirstUser]
  norm_num [threeCoordinateInducedCostFirstUser, Fin.ext_iff]

theorem score_threeCoordinateInducedCostSecondUser_self :
    score threeCoordinateInducedCostSecondUser threeCoordinateInducedCostSecondUser = 1 := by
  rw [score_threeCoordinateInducedCostSecondUser]
  norm_num [threeCoordinateInducedCostSecondUser, Fin.ext_iff]

theorem score_threeCoordinateInducedCost_users :
    score threeCoordinateInducedCostFirstUser threeCoordinateInducedCostSecondUser = 9 / 25 := by
  rw [score_threeCoordinateInducedCostFirstUser]
  norm_num [threeCoordinateInducedCostSecondUser, Fin.ext_iff]

theorem threeCoordinateInducedCostContent_nonnegative :
    NonnegativeContent threeCoordinateInducedCostContent := by
  intro d
  by_cases hd : d = (1 : Fin 3)
  · simp [threeCoordinateInducedCostContent, hd]
  · simp [threeCoordinateInducedCostContent, hd]

theorem score_threeCoordinateInducedCostContent_first :
    score threeCoordinateInducedCostFirstUser threeCoordinateInducedCostContent = 4 / 5 := by
  rw [score_threeCoordinateInducedCostFirstUser]
  norm_num [threeCoordinateInducedCostContent, Fin.ext_iff]

theorem score_threeCoordinateInducedCostContent_second :
    score threeCoordinateInducedCostSecondUser threeCoordinateInducedCostContent = 0 := by
  rw [score_threeCoordinateInducedCostSecondUser]
  norm_num [threeCoordinateInducedCostContent, Fin.ext_iff]

theorem score_threeCoordinateInducedCostContent_self :
    score threeCoordinateInducedCostContent threeCoordinateInducedCostContent = 1 := by
  norm_num [score, Fin.sum_univ_succ, threeCoordinateInducedCostContent]

/-- The nonnegative fibre at the audited score pair is a singleton. -/
theorem threeCoordinateInducedCost_nonnegative_fiber_components
    {q : Content 3} (hq : NonnegativeContent q)
    (hfirst : score threeCoordinateInducedCostFirstUser q = 4 / 5)
    (hsecond : score threeCoordinateInducedCostSecondUser q = 0) :
    q 0 = 0 ∧ q 1 = 1 ∧ q 2 = 0 := by
  rw [score_threeCoordinateInducedCostFirstUser] at hfirst
  rw [score_threeCoordinateInducedCostSecondUser] at hsecond
  have hq0 : 0 ≤ q 0 := hq 0
  have hq1 : 0 ≤ q 1 := hq 1
  have hq2 : 0 ≤ q 2 := hq 2
  norm_num at hfirst hsecond
  constructor
  · nlinarith
  constructor <;> nlinarith

/-- In the audited example, the source's nonnegative score fibre has exact
squared cost one. -/
theorem threeCoordinateInducedCost_nonnegativeFiberNormSq_eq_one :
    twoUserNonnegativeFiberNormSq
      threeCoordinateInducedCostFirstUser threeCoordinateInducedCostSecondUser (4 / 5) 0 = 1 := by
  unfold twoUserNonnegativeFiberNormSq
  have hset : {t : ℝ | ∃ p : Content 3,
      NonnegativeContent p ∧
        score threeCoordinateInducedCostFirstUser p = 4 / 5 ∧
        score threeCoordinateInducedCostSecondUser p = 0 ∧ t = score p p} = {1} := by
    ext t
    constructor
    · rintro ⟨p, hp, hpfirst, hpsecond, rfl⟩
      obtain ⟨hp0, hp1, hp2⟩ :=
        threeCoordinateInducedCost_nonnegative_fiber_components hp hpfirst hpsecond
      simp [score, Fin.sum_univ_succ, hp0, hp1, hp2]
    · intro ht
      rw [Set.mem_singleton_iff] at ht
      subst t
      exact ⟨threeCoordinateInducedCostContent,
        threeCoordinateInducedCostContent_nonnegative,
        score_threeCoordinateInducedCostContent_first,
        score_threeCoordinateInducedCostContent_second,
        score_threeCoordinateInducedCostContent_self.symm⟩
  rw [hset]
  simp

/-- The source's unconstrained Gram quadratic has value `25 / 34` at the
audited score pair. -/
theorem threeCoordinateInducedCost_source_quadratic_eq :
    twoUserInducedCostQuadratic (Real.arccos (9 / 25 : ℝ)) (4 / 5) 0 = 25 / 34 := by
  have hcos : Real.cos (Real.arccos (9 / 25 : ℝ)) = 9 / 25 := by
    exact Real.cos_arccos (by norm_num) (by norm_num)
  have hsin_sq : Real.sin (Real.arccos (9 / 25 : ℝ)) ^ 2 = 544 / 625 := by
    have htrig := Real.sin_sq_add_cos_sq (Real.arccos (9 / 25 : ℝ))
    rw [hcos] at htrig
    norm_num at htrig ⊢
    linarith
  unfold twoUserInducedCostQuadratic twoUserInducedCostNumerator
  rw [hcos, hsin_sq]
  norm_num

/-- The source's displayed quadratic is strictly below the actual induced
nonnegative-fibre squared cost in the audited three-coordinate configuration. -/
theorem threeCoordinateInducedCost_source_quadratic_lt_nonnegativeFiberNormSq :
    twoUserInducedCostQuadratic (Real.arccos (9 / 25 : ℝ)) (4 / 5) 0 <
      twoUserNonnegativeFiberNormSq
        threeCoordinateInducedCostFirstUser threeCoordinateInducedCostSecondUser (4 / 5) 0 := by
  rw [threeCoordinateInducedCost_source_quadratic_eq,
    threeCoordinateInducedCost_nonnegativeFiberNormSq_eq_one]
  norm_num

/--
The equality claimed in Lemma `inducedcost` cannot hold for an arbitrary
number of nonnegative content coordinates: in this nonempty three-coordinate
score fibre its Gram quadratic is strictly below every feasible squared norm.

Thus the source formula is valid as a canonical two-coordinate identity (or
as the unconstrained span minimum), but not as the stated nonnegative-fibre
cost identity in general dimension.  The valid arbitrary-dimensional relation
is the lower bound `twoUserInducedCostQuadratic_le_score_self_of_unit_score_pair`.
-/
theorem threeCoordinateInducedCost_source_quadratic_lt_nonnegative_fiber_normSq
    {q : Content 3} (hq : NonnegativeContent q)
    (hfirst : score threeCoordinateInducedCostFirstUser q = 4 / 5)
    (hsecond : score threeCoordinateInducedCostSecondUser q = 0) :
    twoUserInducedCostQuadratic (Real.arccos (9 / 25 : ℝ)) (4 / 5) 0 < score q q := by
  obtain ⟨hq0, hq1, hq2⟩ :=
    threeCoordinateInducedCost_nonnegative_fiber_components hq hfirst hsecond
  rw [threeCoordinateInducedCost_source_quadratic_eq]
  have hscore : score q q = 1 := by
    simp [score, Fin.sum_univ_succ, hq0, hq1, hq2]
  rw [hscore]
  norm_num

/-- The angular score pair of a radius-`r` content vector has Gram quadratic
exactly `r²`. -/
theorem twoUserInducedCostQuadratic_scale_pair
    (r theta z1 z2 : ℝ) :
    twoUserInducedCostQuadratic theta (r * z1) (r * z2) =
      r ^ 2 * twoUserInducedCostQuadratic theta z1 z2 := by
  unfold twoUserInducedCostQuadratic twoUserInducedCostNumerator
  ring

/-- The angular score pair of a radius-`r` content vector has Gram quadratic
exactly `r²`. -/
theorem twoUserInducedCostQuadratic_cos_pair_scale_eq_sq
    {r theta phi : ℝ} (hsin : 0 < Real.sin theta) :
    twoUserInducedCostQuadratic theta
      (r * Real.cos phi) (r * Real.cos (theta - phi)) = r ^ 2 := by
  have htheta : 1 - Real.cos theta ^ 2 = Real.sin theta ^ 2 := by
    nlinarith [Real.sin_sq_add_cos_sq theta]
  have hcore : Real.cos phi ^ 2 - Real.cos phi ^ 2 * Real.cos theta ^ 2 +
      Real.sin theta ^ 2 * Real.sin phi ^ 2 = Real.sin theta ^ 2 := by
    calc
      Real.cos phi ^ 2 - Real.cos phi ^ 2 * Real.cos theta ^ 2 +
          Real.sin theta ^ 2 * Real.sin phi ^ 2 =
          Real.cos phi ^ 2 * (1 - Real.cos theta ^ 2) +
            Real.sin theta ^ 2 * Real.sin phi ^ 2 := by ring
      _ = Real.cos phi ^ 2 * Real.sin theta ^ 2 +
            Real.sin theta ^ 2 * Real.sin phi ^ 2 := by rw [htheta]
      _ = Real.sin theta ^ 2 * (Real.cos phi ^ 2 + Real.sin phi ^ 2) := by ring
      _ = Real.sin theta ^ 2 := by rw [Real.cos_sq_add_sin_sq]; simp
  unfold twoUserInducedCostQuadratic twoUserInducedCostNumerator
  rw [Real.cos_sub]
  field_simp [hsin.ne']
  ring_nf
  calc
    r ^ 2 * Real.cos phi ^ 2 - r ^ 2 * Real.cos phi ^ 2 * Real.cos theta ^ 2 +
        r ^ 2 * Real.sin theta ^ 2 * Real.sin phi ^ 2 =
        r ^ 2 * (Real.cos phi ^ 2 - Real.cos phi ^ 2 * Real.cos theta ^ 2 +
          Real.sin theta ^ 2 * Real.sin phi ^ 2) := by ring
    _ = r ^ 2 * Real.sin theta ^ 2 := by rw [hcore]

/-- A nonnegative scale of an angular unit direction attains its induced
cost exactly, even in an ambient dimension larger than two. -/
theorem l2_rpow_eq_twoUserInducedCost_of_cos_pair_scale
    {D : ℕ} {d : Content D} {r beta theta phi : ℝ}
    (hr : 0 ≤ r) (hd : AppliedModelingLib.FiniteDimensionalNorms.l2 d = 1)
    (hsin : 0 < Real.sin theta) :
    AppliedModelingLib.FiniteDimensionalNorms.l2 (scaleContent r d) ^ beta =
      twoUserInducedCost 1 beta theta
        (r * Real.cos phi) (r * Real.cos (theta - phi)) := by
  have hquad : twoUserInducedCostQuadratic theta
      (r * Real.cos phi) (r * Real.cos (theta - phi)) = r ^ 2 :=
    twoUserInducedCostQuadratic_cos_pair_scale_eq_sq hsin
  calc
    AppliedModelingLib.FiniteDimensionalNorms.l2 (scaleContent r d) ^ beta = r ^ beta := by
      have hscale := AppliedModelingLib.FiniteDimensionalNorms.normL2_smul r d
      rw [show AppliedModelingLib.FiniteDimensionalNorms.l2 (scaleContent r d) =
        r * AppliedModelingLib.FiniteDimensionalNorms.l2 d by
        simpa [scaleContent, abs_of_nonneg hr] using hscale]
      change (r * AppliedModelingLib.FiniteDimensionalNorms.l2 d) ^ beta = r ^ beta
      rw [hd, mul_one]
    _ = (r ^ 2) ^ (beta / 2) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hr]
      congr 1
      ring
    _ = twoUserInducedCost 1 beta theta
        (r * Real.cos phi) (r * Real.cos (theta - phi)) := by
      rw [twoUserInducedCost_eq_inducedCostQuadratic_rpow hsin, hquad]

/--
Away from the origin, the canonical two-user induced norm-power cost is
strictly positive under the source's positive cost parameters and nonsingular
angle.  This is the cost-side fact needed when a zero-reward support endpoint
is compared with the feasible zero action.
-/
theorem twoUserInducedCost_pos_of_pair_ne_zero
    {α β θ z1 z2 : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hpair : z1 ≠ 0 ∨ z2 ≠ 0) :
    0 < twoUserInducedCost α β θ z1 z2 := by
  have hnum : 0 < twoUserInducedCostNumerator θ z1 z2 := by
    exact (twoUserInducedCostNumerator_nonneg θ z1 z2).lt_of_ne'
      (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne' hpair)
  have hsinpow : 0 < (Real.sin θ) ^ (-β) :=
    Real.rpow_pos_of_pos hsin _
  have hpow : 0 < (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2) :=
    Real.rpow_pos_of_pos hnum _
  exact mul_pos (mul_pos hα hsinpow) hpow

/-- The positive-exponent canonical induced norm-power cost vanishes at the origin. -/
theorem twoUserInducedCost_zero
    {α β θ : ℝ} (hβ : 0 < β) :
    twoUserInducedCost α β θ 0 0 = 0 := by
  have hβhalf : β / 2 ≠ 0 := by linarith
  simp [twoUserInducedCost, twoUserInducedCostNumerator,
    Real.zero_rpow hβhalf]

/--
A C1 maximizer with zero marginal rewards must be the origin when the feasible
zero action also has zero reward and zero cost.  This is the endpoint bridge
that turns a justified joint lower-CDF endpoint into the boundary condition for
the two-user graph ODE; the CDF-zero hypotheses are deliberately explicit.
-/
theorem canonicalTwoUser_eq_zero_of_isMaxOn_of_zero_marginal_rewards
    {H1 H2 : ℝ → ℝ} {α β θ z1 z2 : ℝ} {feasible : Set (ℝ × ℝ)}
    (hmax : IsMaxOn
      (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
        twoUserInducedCost α β θ z.1 z.2) feasible (z1, z2))
    (hzero_feasible : (0, 0) ∈ feasible)
    (hzero_cost : twoUserInducedCost α β θ 0 0 = 0)
    (hzero_rewards : H1 0 = 0 ∧ H2 0 = 0)
    (hz_rewards : H1 z1 = 0 ∧ H2 z2 = 0)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ) :
    z1 = 0 ∧ z2 = 0 := by
  have hnot_pair : ¬ (z1 ≠ 0 ∨ z2 ≠ 0) := by
    intro hpair
    have hcost_pos : 0 < twoUserInducedCost α β θ z1 z2 :=
      twoUserInducedCost_pos_of_pair_ne_zero hα hβ hsin hpair
    have hle :
        H1 0 + H2 0 - twoUserInducedCost α β θ 0 0 ≤
          H1 z1 + H2 z2 - twoUserInducedCost α β θ z1 z2 :=
      hmax hzero_feasible
    rw [hzero_cost, hzero_rewards.1, hzero_rewards.2,
      hz_rewards.1, hz_rewards.2] at hle
    linarith
  exact ⟨not_not.mp (not_or.mp hnot_pair).1,
    not_not.mp (not_or.mp hnot_pair).2⟩

/-- The induced norm-power cost is strictly increasing in the second score
once the score pair is on or above the first-user ray. -/
theorem twoUserInducedCost_strictMono_snd_of_lowerUserRay
    {α β θ x y y' : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hlower : x * Real.cos θ ≤ y) (hyy' : y < y') :
    twoUserInducedCost α β θ x y < twoUserInducedCost α β θ x y' := by
  have hnum_lt : twoUserInducedCostNumerator θ x y <
      twoUserInducedCostNumerator θ x y' := by
    unfold twoUserInducedCostNumerator
    nlinarith
  have hpow_lt :
      (twoUserInducedCostNumerator θ x y) ^ (β / 2) <
        (twoUserInducedCostNumerator θ x y') ^ (β / 2) :=
    Real.rpow_lt_rpow (twoUserInducedCostNumerator_nonneg θ x y) hnum_lt (by linarith)
  unfold twoUserInducedCost
  exact mul_lt_mul_of_pos_left hpow_lt
    (mul_pos hα (Real.rpow_pos_of_pos hsin _))

/-- The coordinate-swapped cost monotonicity inside the closed user cone. -/
theorem twoUserInducedCost_strictMono_fst_of_upperUserRay
    {α β θ x x' y : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hupper : Real.cos θ * y ≤ x) (hxx' : x < x') :
    twoUserInducedCost α β θ x y < twoUserInducedCost α β θ x' y := by
  have hnum_lt : twoUserInducedCostNumerator θ x y <
      twoUserInducedCostNumerator θ x' y := by
    unfold twoUserInducedCostNumerator
    nlinarith
  have hpow_lt :
      (twoUserInducedCostNumerator θ x y) ^ (β / 2) <
        (twoUserInducedCostNumerator θ x' y) ^ (β / 2) :=
    Real.rpow_lt_rpow (twoUserInducedCostNumerator_nonneg θ x y) hnum_lt (by linarith)
  unfold twoUserInducedCost
  exact mul_lt_mul_of_pos_left hpow_lt
    (mul_pos hα (Real.rpow_pos_of_pos hsin _))

/--
Equal marginal rewards along a closed-cone maximizer support make both score
projections injective.  Two support points sharing one coordinate have the
same reward in the other coordinate; equal maximal objective values then force
equal cost, contradicting strict coordinatewise cost monotonicity unless the
points coincide.
-/
theorem twoUser_support_injOn_projections_of_isMaxOn_of_equal_rewards_of_closedCone
    {H1 H2 : ℝ → ℝ} {costFeasible S : Set (ℝ × ℝ)}
    {α β θ : ℝ}
    (hmax : ∀ z ∈ S, IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) costFeasible z)
    (hfeasible : S ⊆ costFeasible)
    (hcone : ∀ z ∈ S,
      Real.cos θ * z.2 ≤ z.1 ∧ z.1 * Real.cos θ ≤ z.2)
    (hreward : ∀ z ∈ S, H1 z.1 = H2 z.2)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ) :
    S.InjOn Prod.fst ∧ S.InjOn Prod.snd := by
  constructor
  · intro p hp q hq hpq
    have hreward2 : H2 p.2 = H2 q.2 := by
      calc
        H2 p.2 = H1 p.1 := (hreward p hp).symm
        _ = H1 q.1 := by rw [hpq]
        _ = H2 q.2 := hreward q hq
    have hobj_eq :
        H1 p.1 + H2 p.2 - twoUserInducedCost α β θ p.1 p.2 =
          H1 q.1 + H2 q.2 - twoUserInducedCost α β θ q.1 q.2 := by
      apply le_antisymm
      · exact hmax q hq (hfeasible hp)
      · exact hmax p hp (hfeasible hq)
    have hsecond : p.2 = q.2 := by
      by_contra hne
      rcases lt_or_gt_of_ne hne with hpq2 | hqp2
      · have hcost_lt := twoUserInducedCost_strictMono_snd_of_lowerUserRay
          hα hβ hsin (hcone p hp).2 hpq2
        rw [hpq] at hcost_lt
        rw [hpq, hreward2] at hobj_eq
        linarith
      · have hcost_lt := twoUserInducedCost_strictMono_snd_of_lowerUserRay
          hα hβ hsin (hcone q hq).2 hqp2
        have hcost_lt' :
            twoUserInducedCost α β θ q.1 q.2 <
              twoUserInducedCost α β θ q.1 p.2 := by
          simpa [hpq] using hcost_lt
        rw [hpq, hreward2] at hobj_eq
        linarith
    exact Prod.ext hpq hsecond
  · intro p hp q hq hpq
    have hreward1 : H1 p.1 = H1 q.1 := by
      calc
        H1 p.1 = H2 p.2 := hreward p hp
        _ = H2 q.2 := by rw [hpq]
        _ = H1 q.1 := (hreward q hq).symm
    have hobj_eq :
        H1 p.1 + H2 p.2 - twoUserInducedCost α β θ p.1 p.2 =
          H1 q.1 + H2 q.2 - twoUserInducedCost α β θ q.1 q.2 := by
      apply le_antisymm
      · exact hmax q hq (hfeasible hp)
      · exact hmax p hp (hfeasible hq)
    have hfirst : p.1 = q.1 := by
      by_contra hne
      rcases lt_or_gt_of_ne hne with hpq1 | hqp1
      · have hcost_lt := twoUserInducedCost_strictMono_fst_of_upperUserRay
          hα hβ hsin (hcone p hp).1 hpq1
        rw [hpq] at hcost_lt
        rw [hpq, hreward1] at hobj_eq
        linarith
      · have hcost_lt := twoUserInducedCost_strictMono_fst_of_upperUserRay
          hα hβ hsin (hcone q hq).1 hqp1
        have hcost_lt' :
            twoUserInducedCost α β θ q.1 q.2 <
              twoUserInducedCost α β θ p.1 q.2 := by
          simpa [hpq] using hcost_lt
        rw [hpq, hreward1] at hobj_eq
        linarith
    exact Prod.ext hfirst hpq

theorem hasDerivAt_twoUserInducedCost_z1
    {α β θ z1 z2 : ℝ}
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2) :
    HasDerivAt (fun x : ℝ => twoUserInducedCost α β θ x z2)
      (β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
          (z1 - z2 * Real.cos θ)) z1 := by
  have hnum := hasDerivAt_twoUserInducedCostNumerator_z1
    (θ := θ) (z1 := z1) (z2 := z2)
  have hpow := hnum.rpow_const (p := β / 2) hbase
  have hmul := hpow.const_mul (α * (Real.sin θ) ^ (-β))
  convert hmul using 1
  ring_nf

theorem hasDerivAt_twoUserInducedCost_z2
    {α β θ z1 z2 : ℝ}
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2) :
    HasDerivAt (fun y : ℝ => twoUserInducedCost α β θ z1 y)
      (β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
          (z2 - z1 * Real.cos θ)) z2 := by
  have hnum := hasDerivAt_twoUserInducedCostNumerator_z2
    (θ := θ) (z1 := z1) (z2 := z2)
  have hpow := hnum.rpow_const (p := β / 2) hbase
  have hmul := hpow.const_mul (α * (Real.sin θ) ^ (-β))
  convert hmul using 1
  ring_nf

/-- The induced norm-power cost is continuous at the origin as well as away
from it whenever the power exponent is nonnegative.  Unlike its displayed
partial derivatives, continuity needs no nonzero-quadratic side condition. -/
theorem continuous_twoUserInducedCost_of_nonneg
    {α β θ : ℝ} (hβ : 0 ≤ β) :
    Continuous (fun z : ℝ × ℝ =>
      twoUserInducedCost α β θ z.1 z.2) := by
  have hnum : Continuous (fun z : ℝ × ℝ =>
      twoUserInducedCostNumerator θ z.1 z.2) := by
    unfold twoUserInducedCostNumerator
    fun_prop
  unfold twoUserInducedCost
  exact (continuous_const.mul continuous_const).mul
    (hnum.rpow_const (fun _ => Or.inr (by linarith)))

/--
Cross-partial formula for Lemma `secondderiv`, written in the paper's
source-shaped bracket.  This is the derivative, with respect to `z_2`, of the
first-order expression from Lemma `FOC`.
-/
noncomputable def twoUserInducedCostCrossPartial
    (α β θ z1 z2 : ℝ) : ℝ :=
  β * α * (Real.sin θ) ^ (-β) *
    (((β - 2) *
      (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 2) *
        (z2 - z1 * Real.cos θ) *
        (z1 - z2 * Real.cos θ)) -
      Real.cos θ *
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1))

/-- Away from the zero induced-cost numerator, the explicit mixed partial is
continuous.  This is the local regularity used by the C1 four-point proof of
`regionscolor`; it follows from real-power continuity and does not assume
smoothness of either marginal reward. -/
theorem continuousAt_twoUserInducedCostCrossPartial_of_numerator_ne_zero
    {α β θ z1 z2 : ℝ}
    (hnum_ne : twoUserInducedCostNumerator θ z1 z2 ≠ 0) :
    ContinuousAt
      (fun z : ℝ × ℝ => twoUserInducedCostCrossPartial α β θ z.1 z.2)
      (z1, z2) := by
  have hnum : Continuous
      (fun z : ℝ × ℝ => twoUserInducedCostNumerator θ z.1 z.2) := by
    unfold twoUserInducedCostNumerator
    fun_prop
  have hpow_high : ContinuousAt
      (fun z : ℝ × ℝ =>
        (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1))
      (z1, z2) := by
    simpa using hnum.continuousAt.rpow_const (p := β / 2 - 1) (Or.inl hnum_ne)
  have hpow_low : ContinuousAt
      (fun z : ℝ × ℝ =>
        (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 2))
      (z1, z2) := by
    simpa using hnum.continuousAt.rpow_const (p := β / 2 - 2) (Or.inl hnum_ne)
  have hlin_left : ContinuousAt
      (fun z : ℝ × ℝ => z.2 - z.1 * Real.cos θ) (z1, z2) :=
    continuous_snd.continuousAt.sub
      (continuous_fst.continuousAt.mul continuousAt_const)
  have hlin_right : ContinuousAt
      (fun z : ℝ × ℝ => z.1 - z.2 * Real.cos θ) (z1, z2) :=
    continuous_fst.continuousAt.sub
      (continuous_snd.continuousAt.mul continuousAt_const)
  have hleft : ContinuousAt
      (fun z : ℝ × ℝ =>
        (β - 2) *
          (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 2) *
            (z.2 - z.1 * Real.cos θ) * (z.1 - z.2 * Real.cos θ))
      (z1, z2) :=
    ((continuousAt_const.mul hpow_low).mul hlin_left).mul hlin_right
  have hright : ContinuousAt
      (fun z : ℝ × ℝ => Real.cos θ *
        (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1))
      (z1, z2) :=
    continuousAt_const.mul hpow_high
  simpa only [twoUserInducedCostCrossPartial] using
    (continuousAt_const.mul (hleft.sub hright))

/-- A strict positive value of a continuous two-variable function persists on
an explicit open coordinate rectangle.  This small topological bridge is used
to turn the pointwise `secondderiv` sign into the local C1 rectangle required
by the four-point argument. -/
theorem exists_openRectangle_of_continuousAt_pos
    {f : ℝ × ℝ → ℝ} {x y : ℝ}
    (hcont : ContinuousAt f (x, y)) (hpos : 0 < f (x, y)) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ u v : ℝ,
      u ∈ Set.Ioo (x - ε / 2) (x + ε / 2) →
      v ∈ Set.Ioo (y - ε / 2) (y + ε / 2) →
        0 < f (u, v) := by
  have hevent : {z : ℝ × ℝ | 0 < f z} ∈ nhds (x, y) :=
    hcont.eventually (Ioi_mem_nhds hpos)
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp hevent
  refine ⟨ε, hε, ?_⟩
  intro u v hu hv
  apply hball
  rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
  constructor
  · rw [Real.dist_eq, abs_lt]
    constructor <;> linarith [hu.1, hu.2, hε]
  · rw [Real.dist_eq, abs_lt]
    constructor <;> linarith [hv.1, hv.2, hε]

/-- The negative-sign companion of
`exists_openRectangle_of_continuousAt_pos`. -/
theorem exists_openRectangle_of_continuousAt_neg
    {f : ℝ × ℝ → ℝ} {x y : ℝ}
    (hcont : ContinuousAt f (x, y)) (hneg : f (x, y) < 0) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ u v : ℝ,
      u ∈ Set.Ioo (x - ε / 2) (x + ε / 2) →
      v ∈ Set.Ioo (y - ε / 2) (y + ε / 2) →
        f (u, v) < 0 := by
  obtain ⟨ε, hε, hrect⟩ := exists_openRectangle_of_continuousAt_pos
    (f := fun z : ℝ × ℝ => -f z) hcont.neg (by simpa using neg_pos.mpr hneg)
  refine ⟨ε, hε, ?_⟩
  intro u v hu hv
  have h := hrect u v hu hv
  linarith

/-- If a continuous graph passes through a point where a continuous
two-variable function is positive, then every sufficiently short increasing
graph chord spans a rectangle on which that function remains positive. -/
theorem exists_local_increasingGraphRectangles_of_continuousAt_pos
    {f : ℝ × ℝ → ℝ} {g : ℝ → ℝ} {x : ℝ}
    (hcontg : ContinuousAt g x) (hcontf : ContinuousAt f (x, g x))
    (hpos : 0 < f (x, g x)) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ, x < y → y < x + δ → g x < g y →
      ∀ u v : ℝ, u ∈ Set.Ioo x y → v ∈ Set.Ioo (g x) (g y) →
        0 < f (u, v) := by
  obtain ⟨ε, hε, hrect⟩ :=
    exists_openRectangle_of_continuousAt_pos hcontf hpos
  obtain ⟨η, hη, hgη⟩ :=
    (Metric.continuousAt_iff.mp hcontg) (ε / 2) (half_pos hε)
  let δ : ℝ := min (ε / 2) η
  have hδ : 0 < δ := lt_min (half_pos hε) hη
  refine ⟨δ, hδ, ?_⟩
  intro y hxy hyδ hgy u v hu hv
  have hyε : y - x < ε / 2 := by
    have hδle : δ ≤ ε / 2 := min_le_left _ _
    linarith
  have hyη : y - x < η := by
    have hδle : δ ≤ η := min_le_right _ _
    linarith
  have hdist_y : dist y x < η := by
    rw [Real.dist_eq, abs_of_nonneg (by linarith)]
    exact hyη
  have hdist_gy : dist (g y) (g x) < ε / 2 := hgη hdist_y
  have hgyε : g y - g x < ε / 2 := by
    rw [Real.dist_eq, abs_of_nonneg (by linarith)] at hdist_gy
    exact hdist_gy
  apply hrect u v
  · constructor <;> linarith [hu.1, hu.2, hε]
  · constructor <;> linarith [hv.1, hv.2, hε]

/-- The decreasing-graph analogue of
`exists_local_increasingGraphRectangles_of_continuousAt_pos`. -/
theorem exists_local_decreasingGraphRectangles_of_continuousAt_neg
    {f : ℝ × ℝ → ℝ} {g : ℝ → ℝ} {x : ℝ}
    (hcontg : ContinuousAt g x) (hcontf : ContinuousAt f (x, g x))
    (hneg : f (x, g x) < 0) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ, x < y → y < x + δ → g y < g x →
      ∀ u v : ℝ, u ∈ Set.Ioo x y → v ∈ Set.Ioo (g y) (g x) →
        f (u, v) < 0 := by
  have hmap : ContinuousAt (fun z : ℝ × ℝ => (z.1, -z.2)) (x, -g x) :=
    continuousAt_fst.prodMk continuousAt_snd.neg
  have hcont_transformed : ContinuousAt
      (fun z : ℝ × ℝ => -f (z.1, -z.2)) (x, -g x) := by
    simpa [Function.comp_def] using hcontf.neg.comp_of_eq hmap (by simp)
  obtain ⟨δ, hδ, hlocal⟩ :=
    exists_local_increasingGraphRectangles_of_continuousAt_pos
      (f := fun z : ℝ × ℝ => -f (z.1, -z.2)) hcontg.neg hcont_transformed
      (by simpa using neg_pos.mpr hneg)
  refine ⟨δ, hδ, ?_⟩
  intro y hxy hyδ hgy u v hu hv
  have hgy' : -g x < -g y := by linarith
  have hv' : -v ∈ Set.Ioo (-g x) (-g y) := by
    constructor <;> linarith [hv.1, hv.2]
  have h := hlocal y hxy hyδ hgy' u (-v) hu hv'
  simpa using h

/-- At a positive first score and nonzero two-user sine, a positive induced
cost mixed partial supplies the complete local rectangle package used by the
C1 increasing-graph contradiction: the real-power base is nonzero throughout
the rectangle and the mixed partial stays positive there. -/
theorem exists_local_increasingGraphRectangles_of_crossPartial_pos
    {α β θ x : ℝ} {g : ℝ → ℝ}
    (hsin : Real.sin θ ≠ 0) (hx : 0 < x)
    (hcontg : ContinuousAt g x)
    (hcross : 0 < twoUserInducedCostCrossPartial α β θ x (g x)) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ, x < y → y < x + δ → g x < g y →
      (∀ u v : ℝ, u ∈ Set.Icc x y → v ∈ Set.Icc (g x) (g y) →
        twoUserInducedCostNumerator θ u v ≠ 0 ∨ 1 ≤ β / 2 - 1) ∧
      (∀ u v : ℝ, u ∈ Set.Ioo x y → v ∈ Set.Ioo (g x) (g y) →
        0 < twoUserInducedCostCrossPartial α β θ u v) := by
  have hnum_ne : twoUserInducedCostNumerator θ x (g x) ≠ 0 :=
    twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin (Or.inl hx.ne')
  obtain ⟨δ, hδ, hlocal⟩ :=
    exists_local_increasingGraphRectangles_of_continuousAt_pos hcontg
      (continuousAt_twoUserInducedCostCrossPartial_of_numerator_ne_zero hnum_ne)
      hcross
  refine ⟨δ, hδ, ?_⟩
  intro y hxy hyδ hgy
  refine ⟨?_, hlocal y hxy hyδ hgy⟩
  intro u v hu _hv
  left
  apply twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin
  left
  exact (lt_of_lt_of_le hx hu.1).ne'

/-- The negative mixed-partial counterpart of
`exists_local_increasingGraphRectangles_of_crossPartial_pos`. -/
theorem exists_local_decreasingGraphRectangles_of_crossPartial_neg
    {α β θ x : ℝ} {g : ℝ → ℝ}
    (hsin : Real.sin θ ≠ 0) (hx : 0 < x)
    (hcontg : ContinuousAt g x)
    (hcross : twoUserInducedCostCrossPartial α β θ x (g x) < 0) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ, x < y → y < x + δ → g y < g x →
      (∀ u v : ℝ, u ∈ Set.Icc x y → v ∈ Set.Icc (g y) (g x) →
        twoUserInducedCostNumerator θ u v ≠ 0 ∨ 1 ≤ β / 2 - 1) ∧
      (∀ u v : ℝ, u ∈ Set.Ioo x y → v ∈ Set.Ioo (g y) (g x) →
        twoUserInducedCostCrossPartial α β θ u v < 0) := by
  have hnum_ne : twoUserInducedCostNumerator θ x (g x) ≠ 0 :=
    twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin (Or.inl hx.ne')
  obtain ⟨δ, hδ, hlocal⟩ :=
    exists_local_decreasingGraphRectangles_of_continuousAt_neg hcontg
      (continuousAt_twoUserInducedCostCrossPartial_of_numerator_ne_zero hnum_ne)
      hcross
  refine ⟨δ, hδ, ?_⟩
  intro y hxy hyδ hgy
  refine ⟨?_, hlocal y hxy hyδ hgy⟩
  intro u v hu _hv
  left
  apply twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin
  left
  exact (lt_of_lt_of_le hx hu.1).ne'

/-- On either boundary ray of the original nonnegative-content score cone,
the explicit two-user mixed partial is nonpositive.  Thus the positive-sign
branch of the C1 four-point argument automatically occurs in the interior of
the actual feasible cone; this is geometry of the displayed source formula,
not an additional regularity hypothesis. -/
theorem twoUserInducedCostCrossPartial_nonpos_of_leftConeBoundary
    {α β θ z1 z2 : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hcos : 0 ≤ Real.cos θ)
    (hboundary : z1 = Real.cos θ * z2) :
    twoUserInducedCostCrossPartial α β θ z1 z2 ≤ 0 := by
  have hscale : 0 ≤ β * α * (Real.sin θ) ^ (-β) :=
    (mul_pos (mul_pos hβ hα) (Real.rpow_pos_of_pos hsin _)).le
  have hpow : 0 ≤
      (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) :=
    Real.rpow_nonneg (twoUserInducedCostNumerator_nonneg θ z1 z2) _
  have hzero : z1 - z2 * Real.cos θ = 0 := by
    rw [hboundary]
    ring
  unfold twoUserInducedCostCrossPartial
  apply mul_nonpos_of_nonneg_of_nonpos hscale
  rw [hzero]
  simpa only [mul_zero, zero_mul, zero_sub] using
    (neg_nonpos.mpr (mul_nonneg hcos hpow))

/-- The symmetric boundary-ray form of
`twoUserInducedCostCrossPartial_nonpos_of_leftConeBoundary`. -/
theorem twoUserInducedCostCrossPartial_nonpos_of_rightConeBoundary
    {α β θ z1 z2 : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hcos : 0 ≤ Real.cos θ)
    (hboundary : z2 = Real.cos θ * z1) :
    twoUserInducedCostCrossPartial α β θ z1 z2 ≤ 0 := by
  have hscale : 0 ≤ β * α * (Real.sin θ) ^ (-β) :=
    (mul_pos (mul_pos hβ hα) (Real.rpow_pos_of_pos hsin _)).le
  have hpow : 0 ≤
      (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) :=
    Real.rpow_nonneg (twoUserInducedCostNumerator_nonneg θ z1 z2) _
  have hzero : z2 - z1 * Real.cos θ = 0 := by
    rw [hboundary]
    ring
  unfold twoUserInducedCostCrossPartial
  apply mul_nonpos_of_nonneg_of_nonpos hscale
  rw [hzero]
  simpa only [mul_zero, zero_mul, zero_sub] using
    (neg_nonpos.mpr (mul_nonneg hcos hpow))

/-- A positive explicit mixed partial cannot occur on the boundary of the
closed original score cone. -/
theorem twoUserClosedUserCone_strict_of_crossPartial_pos
    {α β θ : ℝ} {z : ℝ × ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hcos : 0 ≤ Real.cos θ)
    (hz : z ∈ twoUserClosedUserCone θ)
    (hcross : 0 < twoUserInducedCostCrossPartial α β θ z.1 z.2) :
    Real.cos θ * z.2 < z.1 ∧ Real.cos θ * z.1 < z.2 := by
  constructor
  · apply lt_of_le_of_ne hz.1
    intro heq
    have hnonpos := twoUserInducedCostCrossPartial_nonpos_of_leftConeBoundary
      hα hβ hsin hcos heq.symm
    exact (not_le_of_gt hcross) hnonpos
  · apply lt_of_le_of_ne hz.2
    intro heq
    have hnonpos := twoUserInducedCostCrossPartial_nonpos_of_rightConeBoundary
      hα hβ hsin hcos heq.symm
    exact (not_le_of_gt hcross) hnonpos

/-- At a positive-mixed-partial score-cone point, the actual nonnegative
content feasible set is a neighborhood. -/
theorem twoUserScoreFeasibleSet_mem_nhds_of_crossPartial_pos
    {u v : Content 2} {α β θ : ℝ} {z : ℝ × ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hcos : 0 ≤ Real.cos θ)
    (hz : z ∈ twoUserClosedUserCone θ)
    (hcross : 0 < twoUserInducedCostCrossPartial α β θ z.1 z.2) :
    twoUserScoreFeasibleSet u v ∈ 𝓝 z := by
  obtain ⟨hz1, hz2⟩ := twoUserClosedUserCone_strict_of_crossPartial_pos
    hα hβ hsin hcos hz hcross
  exact twoUserScoreFeasibleSet_mem_nhds_of_closedUserCone_strict
    hu_nonnegative hv_nonnegative hu hv huv hsin hz1 hz2

/-- The source first-partial expression is continuous whenever the exact
derivative-side base condition holds pointwise.  At a zero numerator that
condition forces its rpow exponent to be nonnegative; away from zero,
Mathlib's real-rpow continuity applies directly. -/
theorem continuous_twoUserInducedCostFirstPartial
    {α β θ : ℝ}
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1) :
    Continuous
      (fun z : ℝ × ℝ => β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
          (z.1 - z.2 * Real.cos θ)) := by
  have hnum : Continuous
      (fun z : ℝ × ℝ => twoUserInducedCostNumerator θ z.1 z.2) := by
    unfold twoUserInducedCostNumerator
    fun_prop
  have hpow : Continuous
      (fun z : ℝ × ℝ =>
        (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1)) :=
    hnum.rpow_const fun z =>
      (hbase z.1 z.2).imp id (fun h => by linarith)
  have hlin : Continuous
      (fun z : ℝ × ℝ => z.1 - z.2 * Real.cos θ) :=
    continuous_fst.sub (continuous_snd.mul continuous_const)
  exact (continuous_const.mul hpow).mul hlin

/-- Setwise version of continuity of the source first-partial expression. -/
theorem continuousOn_twoUserInducedCostFirstPartial
    {α β θ : ℝ} {S : Set (ℝ × ℝ)}
    (hbase : ∀ z : ℝ × ℝ, z ∈ S →
      twoUserInducedCostNumerator θ z.1 z.2 ≠ 0 ∨ 1 ≤ β / 2 - 1) :
    ContinuousOn
      (fun z : ℝ × ℝ => β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
          (z.1 - z.2 * Real.cos θ)) S := by
  have hnum : Continuous
      (fun z : ℝ × ℝ => twoUserInducedCostNumerator θ z.1 z.2) := by
    unfold twoUserInducedCostNumerator
    fun_prop
  have hpow : ContinuousOn
      (fun z : ℝ × ℝ =>
        (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1)) S :=
    hnum.continuousOn.rpow_const fun z hz =>
      (hbase z hz).imp id (fun h => by linarith)
  have hlin : Continuous
      (fun z : ℝ × ℝ => z.1 - z.2 * Real.cos θ) :=
    continuous_fst.sub (continuous_snd.mul continuous_const)
  exact (continuous_const.continuousOn.mul hpow).mul hlin.continuousOn

theorem hasDerivAt_twoUserInducedCost_z1_derivative_z2
    {α β θ z1 z2 : ℝ}
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1) :
    HasDerivAt
      (fun y : ℝ =>
        β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z1 y) ^ (β / 2 - 1) *
            (z1 - y * Real.cos θ))
      (twoUserInducedCostCrossPartial α β θ z1 z2) z2 := by
  let K : ℝ := β * α * (Real.sin θ) ^ (-β)
  let A : ℝ := β / 2 - 1
  let N : ℝ → ℝ := fun y => twoUserInducedCostNumerator θ z1 y
  let L : ℝ → ℝ := fun y => z1 - y * Real.cos θ
  have hN : HasDerivAt N (2 * (z2 - z1 * Real.cos θ)) z2 := by
    simpa [N] using hasDerivAt_twoUserInducedCostNumerator_z2
      (θ := θ) (z1 := z1) (z2 := z2)
  have hpow := hN.rpow_const (p := A) hbase
  have hL : HasDerivAt L (-Real.cos θ) z2 := by
    simpa [L] using
      (hasDerivAt_const z2 z1).sub
        ((hasDerivAt_id z2).mul_const (Real.cos θ))
  have hK := (hpow.mul hL).const_mul K
  convert hK using 1
  · ext y
    simp [K, A, N, L]
    ring
  · simp [twoUserInducedCostCrossPartial, K, A, N, L]
    left
    have hexp : β / 2 - 1 - 1 = β / 2 - 2 := by ring
    rw [hexp]
    ring

/--
The derivative of the second induced-cost partial along a horizontal slice is
the same cross partial.  This is the coordinate-swapped calculus fact needed
to extract injectivity of the second support projection from a common second
first-order condition.
-/
theorem hasDerivAt_twoUserInducedCost_z2_derivative_z1
    {α β θ z1 z2 : ℝ}
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1) :
    HasDerivAt
      (fun x : ℝ =>
        β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ x z2) ^ (β / 2 - 1) *
            (z2 - x * Real.cos θ))
      (twoUserInducedCostCrossPartial α β θ z1 z2) z1 := by
  let K : ℝ := β * α * (Real.sin θ) ^ (-β)
  let A : ℝ := β / 2 - 1
  let N : ℝ → ℝ := fun x => twoUserInducedCostNumerator θ x z2
  let L : ℝ → ℝ := fun x => z2 - x * Real.cos θ
  have hN : HasDerivAt N (2 * (z1 - z2 * Real.cos θ)) z1 := by
    simpa [N] using hasDerivAt_twoUserInducedCostNumerator_z1
      (θ := θ) (z1 := z1) (z2 := z2)
  have hpow := hN.rpow_const (p := A) hbase
  have hL : HasDerivAt L (-Real.cos θ) z1 := by
    simpa [L] using
      (hasDerivAt_const z1 z2).sub
        ((hasDerivAt_id z1).mul_const (Real.cos θ))
  have hK := (hpow.mul hL).const_mul K
  convert hK using 1
  · ext x
    simp [K, A, N, L]
    ring
  · simp [twoUserInducedCostCrossPartial, K, A, N, L]
    left
    have hexp : β / 2 - 1 - 1 = β / 2 - 2 := by ring
    rw [hexp]
    ring

/--
Vertical strict-antitonicity bridge for the two-user first induced-cost
partial.  It isolates the valid calculus implication used in Step 1 of the
source `uniqueness` proof: a strictly negative cross-partial on an interval
makes the first partial strictly decrease along that vertical slice.
-/
theorem twoUserInducedCostFirstPartial_strictAntiOn_vertical_of_crossPartial_neg
    {α β θ z1 a b : ℝ}
    (hbase : ∀ z2, z2 ∈ Set.Icc a b →
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z2, z2 ∈ Set.Ioo a b →
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0) :
    StrictAntiOn
      (fun z2 : ℝ => β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
          (z1 - z2 * Real.cos θ))
      (Set.Icc a b) := by
  apply strictAntiOn_of_deriv_neg (convex_Icc _ _)
  · have hnum : Continuous (fun z2 : ℝ =>
        twoUserInducedCostNumerator θ z1 z2) := by
      unfold twoUserInducedCostNumerator
      fun_prop
    have hpow : ContinuousOn (fun z2 : ℝ =>
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1))
        (Set.Icc a b) :=
      hnum.continuousOn.rpow_const fun z2 hz =>
        (hbase z2 hz).imp id (fun h => by linarith)
    have hlin : Continuous (fun z2 : ℝ => z1 - z2 * Real.cos θ) := by
      fun_prop
    exact (continuous_const.continuousOn.mul hpow).mul hlin.continuousOn
  · intro z2 hz
    rw [interior_Icc] at hz
    rw [(hasDerivAt_twoUserInducedCost_z1_derivative_z2
      (hbase z2 ⟨hz.1.le, hz.2.le⟩)).deriv]
    exact hcross z2 hz

/--
Conditional support-fibre uniqueness for the two-user first-order equation.
If two vertical coordinates lie in an interval with strictly negative
cross-partial and have the same first partial, they coincide.  This is the
pointwise consequence used in the source `uniqueness` proof; it does not
derive the common first-order equality or the interval from equilibrium.
-/
theorem twoUser_eq_verticalCoordinate_of_firstPartial_eq_of_crossPartial_neg
    {α β θ z1 z2 z2' a b h : ℝ}
    (hbase : ∀ z, z ∈ Set.Icc a b →
      twoUserInducedCostNumerator θ z1 z ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z, z ∈ Set.Ioo a b →
      twoUserInducedCostCrossPartial α β θ z1 z < 0)
    (hz2 : z2 ∈ Set.Icc a b)
    (hz2' : z2' ∈ Set.Icc a b)
    (hfirst : β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
        (z1 - z2 * Real.cos θ) = h)
    (hfirst' : β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ z1 z2') ^ (β / 2 - 1) *
        (z1 - z2' * Real.cos θ) = h) :
    z2 = z2' := by
  exact (twoUserInducedCostFirstPartial_strictAntiOn_vertical_of_crossPartial_neg
    hbase hcross).injOn hz2 hz2' (hfirst.trans hfirst'.symm)

/--
Horizontal strict-antitonicity bridge for the two-user second induced-cost
partial.  A strictly negative cross partial makes this second partial strictly
decrease along a horizontal slice.
-/
theorem twoUserInducedCostSecondPartial_strictAntiOn_horizontal_of_crossPartial_neg
    {α β θ z2 a b : ℝ}
    (hbase : ∀ z1, z1 ∈ Set.Icc a b →
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1, z1 ∈ Set.Ioo a b →
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0) :
    StrictAntiOn
      (fun z1 : ℝ => β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
          (z2 - z1 * Real.cos θ))
      (Set.Icc a b) := by
  apply strictAntiOn_of_deriv_neg (convex_Icc _ _)
  · have hnum : Continuous (fun z1 : ℝ =>
        twoUserInducedCostNumerator θ z1 z2) := by
      unfold twoUserInducedCostNumerator
      fun_prop
    have hpow : ContinuousOn (fun z1 : ℝ =>
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1))
        (Set.Icc a b) :=
      hnum.continuousOn.rpow_const fun z1 hz =>
        (hbase z1 hz).imp id (fun h => by linarith)
    have hlin : Continuous (fun z1 : ℝ => z2 - z1 * Real.cos θ) := by
      fun_prop
    exact (continuous_const.continuousOn.mul hpow).mul hlin.continuousOn
  · intro z1 hz
    rw [interior_Icc] at hz
    rw [(hasDerivAt_twoUserInducedCost_z2_derivative_z1
      (hbase z1 ⟨hz.1.le, hz.2.le⟩)).deriv]
    exact hcross z1 hz

/--
Conditional support-fibre uniqueness for the second two-user first-order
equation.  On a horizontal interval with strictly negative cross partial,
two equal second partial values have the same first coordinate.
-/
theorem twoUser_eq_horizontalCoordinate_of_secondPartial_eq_of_crossPartial_neg
    {α β θ z1 z1' z2 a b h : ℝ}
    (hbase : ∀ z, z ∈ Set.Icc a b →
      twoUserInducedCostNumerator θ z z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z, z ∈ Set.Ioo a b →
      twoUserInducedCostCrossPartial α β θ z z2 < 0)
    (hz1 : z1 ∈ Set.Icc a b)
    (hz1' : z1' ∈ Set.Icc a b)
    (hsecond : β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
        (z2 - z1 * Real.cos θ) = h)
    (hsecond' : β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ z1' z2) ^ (β / 2 - 1) *
        (z2 - z1' * Real.cos θ) = h) :
    z1 = z1' := by
  exact (twoUserInducedCostSecondPartial_strictAntiOn_horizontal_of_crossPartial_neg
    hbase hcross).injOn hz1 hz1' (hsecond.trans hsecond'.symm)

/--
A strict negative cross partial makes the induced cost strictly submodular on
a closed coordinate rectangle. This is the comparative-statics fact needed
to rule out oppositely ordered C1 maximizers.
-/
theorem twoUserInducedCost_strictSubmodular_of_crossPartial_neg_on_rectangle
    {α β θ a b c d : ℝ}
    (hab : a < b) (hcd : c < d)
    (hbase : ∀ x y : ℝ, x ∈ Set.Icc a b → y ∈ Set.Icc c d →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ x y : ℝ, x ∈ Set.Ioo a b → y ∈ Set.Ioo c d →
      twoUserInducedCostCrossPartial α β θ x y < 0) :
    twoUserInducedCost α β θ a c + twoUserInducedCost α β θ b d <
      twoUserInducedCost α β θ a d + twoUserInducedCost α β θ b c := by
  let F : ℝ → ℝ := fun x =>
    twoUserInducedCost α β θ x c - twoUserInducedCost α β θ x d
  have hcont : ContinuousOn F (Set.Icc a b) := by
    intro x hx
    have hbase_c : twoUserInducedCostNumerator θ x c ≠ 0 ∨ 1 ≤ β / 2 := by
      exact (hbase x c hx ⟨le_rfl, hcd.le⟩).imp id (fun h => by linarith)
    have hbase_d : twoUserInducedCostNumerator θ x d ≠ 0 ∨ 1 ≤ β / 2 := by
      exact (hbase x d hx ⟨hcd.le, le_rfl⟩).imp id (fun h => by linarith)
    exact ((hasDerivAt_twoUserInducedCost_z1 (α := α) hbase_c).continuousAt.sub
      (hasDerivAt_twoUserInducedCost_z1 (α := α) hbase_d).continuousAt).continuousWithinAt
  have hderiv : ∀ x ∈ interior (Set.Icc a b),
      HasDerivWithinAt F
        (β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x c) ^ (β / 2 - 1) *
              (x - c * Real.cos θ) -
          β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x d) ^ (β / 2 - 1) *
              (x - d * Real.cos θ))
        (interior (Set.Icc a b)) x := by
    intro x hx
    have hxIcc : x ∈ Set.Icc a b := interior_subset hx
    have hbase_c : twoUserInducedCostNumerator θ x c ≠ 0 ∨ 1 ≤ β / 2 := by
      exact (hbase x c hxIcc ⟨le_rfl, hcd.le⟩).imp id (fun h => by linarith)
    have hbase_d : twoUserInducedCostNumerator θ x d ≠ 0 ∨ 1 ≤ β / 2 := by
      exact (hbase x d hxIcc ⟨hcd.le, le_rfl⟩).imp id (fun h => by linarith)
    exact (hasDerivAt_twoUserInducedCost_z1 (α := α) hbase_c).sub
      (hasDerivAt_twoUserInducedCost_z1 (α := α) hbase_d) |>.hasDerivWithinAt
  have hpos : ∀ x ∈ interior (Set.Icc a b),
      0 < β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x c) ^ (β / 2 - 1) *
              (x - c * Real.cos θ) -
          β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x d) ^ (β / 2 - 1) *
              (x - d * Real.cos θ) := by
    intro x hx
    have hxopen : x ∈ Set.Ioo a b := by
      simpa only [interior_Icc] using hx
    have hanti := twoUserInducedCostFirstPartial_strictAntiOn_vertical_of_crossPartial_neg
      (z1 := x) (a := c) (b := d)
      (fun y hy => hbase x y (interior_subset hx) hy)
      (fun y hy => hcross x y hxopen hy)
    exact sub_pos.mpr (hanti ⟨le_rfl, hcd.le⟩ ⟨hcd.le, le_rfl⟩ hcd)
  have hmono := strictMonoOn_of_hasDerivWithinAt_pos (convex_Icc a b)
    hcont hderiv hpos
  have hF : F a < F b := hmono ⟨le_rfl, hab.le⟩ ⟨hab.le, le_rfl⟩ hab
  dsimp [F] at hF
  linarith

/-- Negating the positive cost scale negates the induced cost pointwise.  This
elementary symmetry lets the positive-cross-partial comparative statics reuse
the already verified negative-cross-partial calculus. -/
theorem twoUserInducedCost_neg_scale
    (α β θ z1 z2 : ℝ) :
    twoUserInducedCost (-α) β θ z1 z2 =
      -twoUserInducedCost α β θ z1 z2 := by
  simp only [twoUserInducedCost]
  ring

/-- The mixed cross partial is likewise linear in the cost scale. -/
theorem twoUserInducedCostCrossPartial_neg_scale
    (α β θ z1 z2 : ℝ) :
    twoUserInducedCostCrossPartial (-α) β θ z1 z2 =
      -twoUserInducedCostCrossPartial α β θ z1 z2 := by
  simp only [twoUserInducedCostCrossPartial]
  ring

/-- A strictly positive mixed cross partial makes the induced cost strictly
supermodular on a rectangle.  This is the sign-reversed companion of the
negative-cross-partial result above, obtained without duplicating its
one-dimensional real-power calculus. -/
theorem twoUserInducedCost_strictSupermodular_of_crossPartial_pos_on_rectangle
    {α β θ a b c d : ℝ}
    (hab : a < b) (hcd : c < d)
    (hbase : ∀ x y : ℝ, x ∈ Set.Icc a b → y ∈ Set.Icc c d →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ x y : ℝ, x ∈ Set.Ioo a b → y ∈ Set.Ioo c d →
      0 < twoUserInducedCostCrossPartial α β θ x y) :
    twoUserInducedCost α β θ a c + twoUserInducedCost α β θ b d >
      twoUserInducedCost α β θ a d + twoUserInducedCost α β θ b c := by
  have hneg := twoUserInducedCost_strictSubmodular_of_crossPartial_neg_on_rectangle
    (α := -α) hab hcd hbase (by
      intro x y hx hy
      rw [twoUserInducedCostCrossPartial_neg_scale]
      simpa using neg_lt_neg (hcross x y hx hy))
  rw [twoUserInducedCost_neg_scale, twoUserInducedCost_neg_scale,
    twoUserInducedCost_neg_scale, twoUserInducedCost_neg_scale] at hneg
  linarith

/-- Boundary-safe strict submodularity on a nonnegative rectangle in the
below-phase regime.  The rectangle may contain the origin: continuity handles
its boundary, while every point of the open rectangle has two positive scores,
so the source cross-partial sign and ordinary derivatives apply there. -/
theorem twoUserInducedCost_strictSubmodular_of_orthogonal_on_nonnegative_rectangle
    {α β θ a b c d : ℝ}
    (hα : 0 < α) (hβ : 1 ≤ β)
    (hsin : 0 < Real.sin θ) (hcos : Real.cos θ = 0)
    (hβtwo : β < 2)
    (ha : 0 ≤ a) (hc : 0 ≤ c) (hab : a < b) (hcd : c < d) :
    twoUserInducedCost α β θ a c + twoUserInducedCost α β θ b d <
      twoUserInducedCost α β θ a d + twoUserInducedCost α β θ b c := by
  let F : ℝ → ℝ := fun x =>
    twoUserInducedCost α β θ x c - twoUserInducedCost α β θ x d
  have hcost_cont : Continuous (fun z : ℝ × ℝ =>
      twoUserInducedCost α β θ z.1 z.2) :=
    continuous_twoUserInducedCost_of_nonneg (le_trans zero_le_one hβ)
  have hcont : ContinuousOn F (Set.Icc a b) := by
    have hc_line : Continuous (fun x : ℝ =>
        twoUserInducedCost α β θ x c) :=
      hcost_cont.comp (continuous_id.prodMk continuous_const)
    have hd_line : Continuous (fun x : ℝ =>
        twoUserInducedCost α β θ x d) :=
      hcost_cont.comp (continuous_id.prodMk continuous_const)
    exact (hc_line.sub hd_line).continuousOn
  have hderiv : ∀ x ∈ interior (Set.Icc a b),
      HasDerivWithinAt F
        (β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x c) ^ (β / 2 - 1) *
              (x - c * Real.cos θ) -
          β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x d) ^ (β / 2 - 1) *
              (x - d * Real.cos θ))
        (interior (Set.Icc a b)) x := by
    intro x hx
    have hxopen : x ∈ Set.Ioo a b := by
      simpa only [interior_Icc] using hx
    have hxpos : 0 < x := lt_of_le_of_lt ha hxopen.1
    have hbase_c : twoUserInducedCostNumerator θ x c ≠ 0 ∨ 1 ≤ β / 2 :=
      Or.inl (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero
        hsin.ne' (Or.inl hxpos.ne'))
    have hbase_d : twoUserInducedCostNumerator θ x d ≠ 0 ∨ 1 ≤ β / 2 :=
      Or.inl (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero
        hsin.ne' (Or.inl hxpos.ne'))
    exact (hasDerivAt_twoUserInducedCost_z1 (α := α) hbase_c).sub
      (hasDerivAt_twoUserInducedCost_z1 (α := α) hbase_d) |>.hasDerivWithinAt
  have hpos : ∀ x ∈ interior (Set.Icc a b),
      0 < β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x c) ^ (β / 2 - 1) *
              (x - c * Real.cos θ) -
          β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x d) ^ (β / 2 - 1) *
              (x - d * Real.cos θ) := by
    intro x hx
    have hxopen : x ∈ Set.Ioo a b := by
      simpa only [interior_Icc] using hx
    have hxpos : 0 < x := lt_of_le_of_lt ha hxopen.1
    have hanti := twoUserInducedCostFirstPartial_strictAntiOn_vertical_of_crossPartial_neg
      (α := α) (β := β) (θ := θ) (z1 := x) (a := c) (b := d)
      (fun y _ => Or.inl
        (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero
          hsin.ne' (Or.inl hxpos.ne')))
      (fun y hy => by
        have hypos : 0 < y := lt_of_le_of_lt hc hy.1
        have hβpos : 0 < β := lt_of_lt_of_le zero_lt_one hβ
        have hnumpos : 0 < twoUserInducedCostNumerator θ x y :=
          (twoUserInducedCostNumerator_nonneg θ x y).lt_of_ne'
            (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero
              hsin.ne' (Or.inl hxpos.ne'))
        have hpowpos : 0 <
            (twoUserInducedCostNumerator θ x y) ^ (β / 2 - 2) :=
          Real.rpow_pos_of_pos hnumpos _
        have houter : 0 < β * α * (Real.sin θ) ^ (-β) :=
          mul_pos (mul_pos hβpos hα) (Real.rpow_pos_of_pos hsin _)
        have hinner1 : (β - 2) *
            (twoUserInducedCostNumerator θ x y) ^ (β / 2 - 2) < 0 :=
          mul_neg_of_neg_of_pos (sub_neg.mpr hβtwo) hpowpos
        have hinner2 : (β - 2) *
            (twoUserInducedCostNumerator θ x y) ^ (β / 2 - 2) * y < 0 :=
          mul_neg_of_neg_of_pos hinner1 hypos
        have hinner3 : (β - 2) *
            (twoUserInducedCostNumerator θ x y) ^ (β / 2 - 2) * y * x < 0 :=
          mul_neg_of_neg_of_pos hinner2 hxpos
        simpa [twoUserInducedCostCrossPartial, hcos] using
          mul_neg_of_pos_of_neg houter hinner3)
    exact sub_pos.mpr (hanti ⟨le_rfl, hcd.le⟩ ⟨hcd.le, le_rfl⟩ hcd)
  have hmono := strictMonoOn_of_hasDerivWithinAt_pos (convex_Icc a b)
    hcont hderiv hpos
  have hF : F a < F b := hmono ⟨le_rfl, hab.le⟩ ⟨hab.le, le_rfl⟩ hab
  dsimp [F] at hF
  linarith

/--
Strict submodularity of cost orders all C1 maximizers: two support values
cannot reverse their coordinate order when the coordinatewise meet and join
are feasible deviations.
-/
theorem ordered_snd_of_isMaxOn_and_strictSubmodular
    {H1 H2 : ℝ → ℝ} {cost : ℝ × ℝ → ℝ} {feasible S : Set (ℝ × ℝ)}
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - cost w) feasible z)
    (hrectangle : ∀ p q : ℝ × ℝ, p ∈ S → q ∈ S →
      p.1 < q.1 → q.2 < p.2 →
        (p.1, q.2) ∈ feasible ∧ (q.1, p.2) ∈ feasible)
    (hsub : ∀ x1 x2 y1 y2 : ℝ, x1 < x2 → y1 < y2 →
      cost (x1, y1) + cost (x2, y2) <
        cost (x1, y2) + cost (x2, y1)) :
    ∀ p ∈ S, ∀ q ∈ S, p.1 < q.1 → p.2 ≤ q.2 := by
  intro p hp q hq hpq
  by_contra hnot
  have hqp : q.2 < p.2 := lt_of_not_ge hnot
  obtain ⟨hmeet, hjoin⟩ := hrectangle p q hp hq hpq hqp
  have hmeet_le := hmax p hp hmeet
  have hjoin_le := hmax q hq hjoin
  change H1 p.1 + H2 q.2 - cost (p.1, q.2) ≤
    H1 p.1 + H2 p.2 - cost p at hmeet_le
  change H1 q.1 + H2 p.2 - cost (q.1, p.2) ≤
    H1 q.1 + H2 q.2 - cost q at hjoin_le
  have hle := add_le_add hmeet_le hjoin_le
  have hcost := hsub p.1 q.1 q.2 p.2 hpq hqp
  have hlt :
      (H1 p.1 + H2 p.2 - cost p) + (H1 q.1 + H2 q.2 - cost q) <
        (H1 p.1 + H2 q.2 - cost (p.1, q.2)) +
          (H1 q.1 + H2 p.2 - cost (q.1, p.2)) := by
    linarith
  exact (not_lt_of_ge hle) (by simpa using hlt)

/-- Strict supermodularity of cost reverses the C1 ordering conclusion: two
maximizers cannot have both coordinates strictly increasing when their crossed
coordinate deviations are feasible.  This is the four-point form of the C1
argument and requires no derivatives of the marginal-value functions. -/
theorem antiOrdered_snd_of_isMaxOn_and_strictSupermodular
    {H1 H2 : ℝ → ℝ} {cost : ℝ × ℝ → ℝ} {feasible S : Set (ℝ × ℝ)}
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - cost w) feasible z)
    (hrectangle : ∀ p q : ℝ × ℝ, p ∈ S → q ∈ S →
      p.1 < q.1 → p.2 < q.2 →
        (p.1, q.2) ∈ feasible ∧ (q.1, p.2) ∈ feasible)
    (hsuper : ∀ x1 x2 y1 y2 : ℝ, x1 < x2 → y1 < y2 →
      cost (x1, y1) + cost (x2, y2) >
        cost (x1, y2) + cost (x2, y1)) :
    ∀ p ∈ S, ∀ q ∈ S, p.1 < q.1 → q.2 ≤ p.2 := by
  intro p hp q hq hpq
  by_contra hnot
  have hpq_snd : p.2 < q.2 := lt_of_not_ge hnot
  obtain ⟨hcross_left, hcross_right⟩ := hrectangle p q hp hq hpq hpq_snd
  have hcross_left_le := hmax p hp hcross_left
  have hcross_right_le := hmax q hq hcross_right
  change H1 p.1 + H2 q.2 - cost (p.1, q.2) ≤
    H1 p.1 + H2 p.2 - cost p at hcross_left_le
  change H1 q.1 + H2 p.2 - cost (q.1, p.2) ≤
    H1 q.1 + H2 q.2 - cost q at hcross_right_le
  have hle := add_le_add hcross_left_le hcross_right_le
  have hcost := hsuper p.1 q.1 p.2 q.2 hpq hpq_snd
  have hlt :
      (H1 p.1 + H2 p.2 - cost p) + (H1 q.1 + H2 q.2 - cost q) <
        (H1 p.1 + H2 q.2 - cost (p.1, q.2)) +
          (H1 q.1 + H2 p.2 - cost (q.1, p.2)) := by
    linarith
  exact (not_lt_of_ge hle) (by simpa using hlt)

/-- A differentiable graph that is locally antitone on an open interval has
nonpositive derivative at every interior point.  Written in this explicit
one-sided form so the C1 four-point argument can use only a local support
order, rather than assuming global regularity of the graph. -/
theorem deriv_nonpos_of_antitoneOn_Ioo
    {g : ℝ → ℝ} {a b x g' : ℝ}
    (hx : x ∈ Set.Ioo a b)
    (hderiv : HasDerivAt g g' x)
    (hanti : ∀ y ∈ Set.Ioo a b, x < y → g y ≤ g x) :
    g' ≤ 0 := by
  by_contra hnot
  have hgpos : 0 < g' := lt_of_not_ge hnot
  have hright : 0 < b - x := sub_pos.mpr hx.2
  obtain ⟨ε, hε_pos, hε_lt, himprove⟩ :=
    exists_pos_right_improvement_of_hasDerivAt_pos_lt hderiv hgpos hright
  have hy : x + ε ∈ Set.Ioo a b := by
    constructor
    · exact lt_of_lt_of_le hx.1 (le_add_of_nonneg_right hε_pos.le)
    · linarith
  have hle := hanti (x + ε) hy (by linarith)
  exact (not_lt_of_ge hle) (by simpa using himprove)

/-- The monotone counterpart of `deriv_nonpos_of_antitoneOn_Ioo`.  Negating
the graph turns a negative derivative into a positive right-side improvement,
so this proof uses the same local argument. -/
theorem deriv_nonneg_of_monotoneOn_Ioo
    {g : ℝ → ℝ} {a b x g' : ℝ}
    (hx : x ∈ Set.Ioo a b)
    (hderiv : HasDerivAt g g' x)
    (hmono : ∀ y ∈ Set.Ioo a b, x < y → g x ≤ g y) :
    0 ≤ g' := by
  by_contra hnot
  have hgneg : g' < 0 := lt_of_not_ge hnot
  have hright : 0 < b - x := sub_pos.mpr hx.2
  obtain ⟨ε, hε_pos, hε_lt, himprove⟩ :=
    exists_pos_right_improvement_of_hasDerivAt_pos_lt hderiv.neg
      (by linarith : 0 < -g') hright
  have hy : x + ε ∈ Set.Ioo a b := by
    constructor
    · exact lt_of_lt_of_le hx.1 (le_add_of_nonneg_right hε_pos.le)
    · linarith
  have hle := hmono (x + ε) hy (by linarith)
  have hlt : g (x + ε) < g x := by
    have himprove' : -(g x) < -(g (x + ε)) := by
      simpa using himprove
    exact neg_lt_neg_iff.mp himprove'
  exact (not_lt_of_ge hle) hlt

/-- Local positive-cross-partial C1 graph bridge.  At a differentiable graph
point, if the induced cost is strictly supermodular on every sufficiently
small increasing graph rectangle, C1 maximization rules out a positive graph
derivative.  The marginal rewards are never differentiated. -/
theorem deriv_nonpos_of_isMaxOn_graph_of_crossPartial_pos_local
    {H1 H2 g : ℝ → ℝ} {feasible S : Set (ℝ × ℝ)}
    {α β θ a b x g' : ℝ}
    (hx : x ∈ Set.Ioo a b)
    (hderiv : HasDerivAt g g' x)
    (hgraph : ∀ w ∈ Set.Ioo a b, (w, g w) ∈ S)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) feasible z)
    (hrectangle : ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ,
      x < y → y < x + δ → g x < g y →
        (x, g y) ∈ feasible ∧ (y, g x) ∈ feasible)
    (hlocal : ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ, x < y → y < x + δ → g x < g y →
      (∀ u v : ℝ, u ∈ Set.Icc x y → v ∈ Set.Icc (g x) (g y) →
        twoUserInducedCostNumerator θ u v ≠ 0 ∨ 1 ≤ β / 2 - 1) ∧
      (∀ u v : ℝ, u ∈ Set.Ioo x y → v ∈ Set.Ioo (g x) (g y) →
        0 < twoUserInducedCostCrossPartial α β θ u v)) :
    g' ≤ 0 := by
  obtain ⟨δrect, hδrect, hrectangle⟩ := hrectangle
  obtain ⟨δ, hδ, hlocal⟩ := hlocal
  by_contra hnot
  have hgpos : 0 < g' := lt_of_not_ge hnot
  have hbound : 0 < min (min (b - x) δrect) δ :=
    lt_min (lt_min (sub_pos.mpr hx.2) hδrect) hδ
  obtain ⟨ε, hε_pos, hε_lt, himprove⟩ :=
    exists_pos_right_improvement_of_hasDerivAt_pos_lt hderiv hgpos hbound
  have hε_b : ε < b - x :=
    lt_of_lt_of_le hε_lt (le_trans (min_le_left _ _) (min_le_left _ _))
  have hε_rect : ε < δrect :=
    lt_of_lt_of_le hε_lt (le_trans (min_le_left _ _) (min_le_right _ _))
  have hε_local : ε < δ := lt_of_lt_of_le hε_lt (min_le_right _ _)
  have hy : x + ε ∈ Set.Ioo a b := by
    constructor
    · exact lt_of_lt_of_le hx.1 (le_add_of_nonneg_right hε_pos.le)
    · linarith
  have hxy : x < x + ε := by linarith
  have hgxy : g x < g (x + ε) := by simpa using himprove
  obtain ⟨hcross_left, hcross_right⟩ := hrectangle (x + ε) hxy
    (by linarith) hgxy
  obtain ⟨hbase, hcross⟩ := hlocal (x + ε) hxy
    (by linarith) hgxy
  have hsuper := twoUserInducedCost_strictSupermodular_of_crossPartial_pos_on_rectangle
    (α := α) (β := β) (θ := θ) hxy hgxy hbase hcross
  have hleft_le := hmax (x, g x) (hgraph x hx) hcross_left
  have hright_le := hmax (x + ε, g (x + ε)) (hgraph (x + ε) hy) hcross_right
  change H1 x + H2 (g (x + ε)) - twoUserInducedCost α β θ x (g (x + ε)) ≤
    H1 x + H2 (g x) - twoUserInducedCost α β θ x (g x) at hleft_le
  change H1 (x + ε) + H2 (g x) - twoUserInducedCost α β θ (x + ε) (g x) ≤
    H1 (x + ε) + H2 (g (x + ε)) -
      twoUserInducedCost α β θ (x + ε) (g (x + ε)) at hright_le
  have hle := add_le_add hleft_le hright_le
  have hlt :
      (H1 x + H2 (g x) - twoUserInducedCost α β θ x (g x)) +
        (H1 (x + ε) + H2 (g (x + ε)) -
          twoUserInducedCost α β θ (x + ε) (g (x + ε))) <
      (H1 x + H2 (g (x + ε)) - twoUserInducedCost α β θ x (g (x + ε))) +
        (H1 (x + ε) + H2 (g x) - twoUserInducedCost α β θ (x + ε) (g x)) := by
    linarith
  exact (not_lt_of_ge hle) hlt

/-- Local negative-cross-partial C1 graph bridge.  This is the complementary
four-point argument: strict submodularity rules out a negative graph derivative
without differentiating either marginal reward. -/
theorem deriv_nonneg_of_isMaxOn_graph_of_crossPartial_neg_local
    {H1 H2 g : ℝ → ℝ} {feasible S : Set (ℝ × ℝ)}
    {α β θ a b x g' : ℝ}
    (hx : x ∈ Set.Ioo a b)
    (hderiv : HasDerivAt g g' x)
    (hgraph : ∀ w ∈ Set.Ioo a b, (w, g w) ∈ S)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) feasible z)
    (hrectangle : ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ,
      x < y → y < x + δ → g y < g x →
        (x, g y) ∈ feasible ∧ (y, g x) ∈ feasible)
    (hlocal : ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ, x < y → y < x + δ → g y < g x →
      (∀ u v : ℝ, u ∈ Set.Icc x y → v ∈ Set.Icc (g y) (g x) →
        twoUserInducedCostNumerator θ u v ≠ 0 ∨ 1 ≤ β / 2 - 1) ∧
      (∀ u v : ℝ, u ∈ Set.Ioo x y → v ∈ Set.Ioo (g y) (g x) →
        twoUserInducedCostCrossPartial α β θ u v < 0)) :
    0 ≤ g' := by
  obtain ⟨δrect, hδrect, hrectangle⟩ := hrectangle
  obtain ⟨δ, hδ, hlocal⟩ := hlocal
  by_contra hnot
  have hgneg : g' < 0 := lt_of_not_ge hnot
  have hbound : 0 < min (min (b - x) δrect) δ :=
    lt_min (lt_min (sub_pos.mpr hx.2) hδrect) hδ
  obtain ⟨ε, hε_pos, hε_lt, himprove⟩ :=
    exists_pos_right_improvement_of_hasDerivAt_pos_lt hderiv.neg
      (by linarith : 0 < -g') hbound
  have hε_b : ε < b - x :=
    lt_of_lt_of_le hε_lt (le_trans (min_le_left _ _) (min_le_left _ _))
  have hε_rect : ε < δrect :=
    lt_of_lt_of_le hε_lt (le_trans (min_le_left _ _) (min_le_right _ _))
  have hε_local : ε < δ := lt_of_lt_of_le hε_lt (min_le_right _ _)
  have hy : x + ε ∈ Set.Ioo a b := by
    constructor
    · exact lt_of_lt_of_le hx.1 (le_add_of_nonneg_right hε_pos.le)
    · linarith
  have hxy : x < x + ε := by linarith
  have hgxy : g (x + ε) < g x := by
    have himprove' : -(g x) < -(g (x + ε)) := by
      simpa using himprove
    exact neg_lt_neg_iff.mp himprove'
  obtain ⟨hcross_left, hcross_right⟩ := hrectangle (x + ε) hxy
    (by linarith) hgxy
  obtain ⟨hbase, hcross⟩ := hlocal (x + ε) hxy
    (by linarith) hgxy
  have hsub := twoUserInducedCost_strictSubmodular_of_crossPartial_neg_on_rectangle
    (α := α) (β := β) (θ := θ) hxy hgxy hbase hcross
  have hleft_le := hmax (x, g x) (hgraph x hx) hcross_left
  have hright_le := hmax (x + ε, g (x + ε)) (hgraph (x + ε) hy) hcross_right
  change H1 x + H2 (g (x + ε)) - twoUserInducedCost α β θ x (g (x + ε)) ≤
    H1 x + H2 (g x) - twoUserInducedCost α β θ x (g x) at hleft_le
  change H1 (x + ε) + H2 (g x) - twoUserInducedCost α β θ (x + ε) (g x) ≤
    H1 (x + ε) + H2 (g (x + ε)) -
      twoUserInducedCost α β θ (x + ε) (g (x + ε)) at hright_le
  have hle := add_le_add hleft_le hright_le
  have hlt :
      (H1 x + H2 (g x) - twoUserInducedCost α β θ x (g x)) +
        (H1 (x + ε) + H2 (g (x + ε)) -
          twoUserInducedCost α β θ (x + ε) (g (x + ε))) <
      (H1 x + H2 (g (x + ε)) - twoUserInducedCost α β θ x (g (x + ε))) +
        (H1 (x + ε) + H2 (g x) - twoUserInducedCost α β θ (x + ε) (g x)) := by
    linarith
  exact (not_lt_of_ge hle) hlt

/-- C1 four-point recovery for a positive mixed partial.  The local sign
rectangle is derived from the explicit induced-cost formula and continuity of
the differentiable graph, so no marginal-density or SOC hypothesis appears. -/
theorem deriv_nonpos_of_isMaxOn_graph_of_crossPartial_pos
    {H1 H2 g : ℝ → ℝ} {feasible S : Set (ℝ × ℝ)}
    {α β θ a b x g' : ℝ}
    (hxI : x ∈ Set.Ioo a b) (hx : 0 < x) (hsin : Real.sin θ ≠ 0)
    (hderiv : HasDerivAt g g' x)
    (hgraph : ∀ w ∈ Set.Ioo a b, (w, g w) ∈ S)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) feasible z)
    (hrectangle : ∀ y : ℝ, y ∈ Set.Ioo a b → x < y → g x < g y →
      (x, g y) ∈ feasible ∧ (y, g x) ∈ feasible)
    (hcross : 0 < twoUserInducedCostCrossPartial α β θ x (g x)) :
    g' ≤ 0 := by
  apply deriv_nonpos_of_isMaxOn_graph_of_crossPartial_pos_local
    hxI hderiv hgraph hmax
  · refine ⟨b - x, sub_pos.mpr hxI.2, ?_⟩
    intro y hxy hy hgy
    apply hrectangle y
    · constructor
      · exact lt_trans hxI.1 hxy
      · linarith
    · exact hxy
    · exact hgy
  · exact exists_local_increasingGraphRectangles_of_crossPartial_pos
      hsin hx hderiv.continuousAt hcross

/-- C1 four-point recovery for a negative mixed partial, dual to the positive
branch above. -/
theorem deriv_nonneg_of_isMaxOn_graph_of_crossPartial_neg
    {H1 H2 g : ℝ → ℝ} {feasible S : Set (ℝ × ℝ)}
    {α β θ a b x g' : ℝ}
    (hxI : x ∈ Set.Ioo a b) (hx : 0 < x) (hsin : Real.sin θ ≠ 0)
    (hderiv : HasDerivAt g g' x)
    (hgraph : ∀ w ∈ Set.Ioo a b, (w, g w) ∈ S)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) feasible z)
    (hrectangle : ∀ y : ℝ, y ∈ Set.Ioo a b → x < y → g y < g x →
      (x, g y) ∈ feasible ∧ (y, g x) ∈ feasible)
    (hcross : twoUserInducedCostCrossPartial α β θ x (g x) < 0) :
    0 ≤ g' := by
  apply deriv_nonneg_of_isMaxOn_graph_of_crossPartial_neg_local
    hxI hderiv hgraph hmax
  · refine ⟨b - x, sub_pos.mpr hxI.2, ?_⟩
    intro y hxy hy hgy
    apply hrectangle y
    · constructor
      · exact lt_trans hxI.1 hxy
      · linarith
    · exact hxy
    · exact hgy
  · exact exists_local_decreasingGraphRectangles_of_crossPartial_neg
      hsin hx hderiv.continuousAt hcross

/-- A feasible neighborhood of a differentiable graph point supplies the
small crossed-coordinate deviations used by the C1 four-point proof. -/
theorem exists_local_graphCrosses_feasible_of_mem_nhds
    {feasible : Set (ℝ × ℝ)} {g : ℝ → ℝ} {x : ℝ}
    (hfeasible : feasible ∈ 𝓝 (x, g x))
    (hcontg : ContinuousAt g x) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ, x < y → y < x + δ →
      (x, g y) ∈ feasible ∧ (y, g x) ∈ feasible := by
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp hfeasible
  obtain ⟨η, hη, hgη⟩ :=
    (Metric.continuousAt_iff.mp hcontg) (ε / 2) (half_pos hε)
  let δ : ℝ := min (ε / 2) η
  have hδ : 0 < δ := lt_min (half_pos hε) hη
  refine ⟨δ, hδ, ?_⟩
  intro y hxy hy
  have hyε : y - x < ε / 2 := by
    have hδle : δ ≤ ε / 2 := min_le_left _ _
    linarith
  have hyη : y - x < η := by
    have hδle : δ ≤ η := min_le_right _ _
    linarith
  have hdist : dist y x < η := by
    rw [Real.dist_eq, abs_of_nonneg (by linarith)]
    exact hyη
  have hdistg : dist (g y) (g x) < ε / 2 := hgη hdist
  constructor
  · apply hball
    rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
    constructor
    · simp [hε]
    · exact lt_trans hdistg (half_lt_self hε)
  · apply hball
    rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
    constructor
    · rw [Real.dist_eq, abs_of_nonneg (by linarith)]
      exact lt_trans hyε (half_lt_self hε)
    · simp [hε]

/-- Source-faithful positive-cross-partial branch of `regionscolor`: a
positive cross partial forces the graph point into the interior of the actual
nonnegative-content score region, where C1 supplies local deviations. -/
theorem twoUser_deriv_nonpos_of_isMaxOn_graph_of_crossPartial_pos_of_cone
    {u v : Content 2} {H1 H2 g : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    {α β θ a b x g' : ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hcos : 0 ≤ Real.cos θ)
    (hxI : x ∈ Set.Ioo a b) (hx : 0 < x)
    (hderiv : HasDerivAt g g' x)
    (hgraph : ∀ w ∈ Set.Ioo a b, (w, g w) ∈ S)
    (hScone : S ⊆ twoUserClosedUserCone θ)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) (twoUserScoreFeasibleSet u v) z)
    (hcross : 0 < twoUserInducedCostCrossPartial α β θ x (g x)) :
    g' ≤ 0 := by
  have hpointcone : (x, g x) ∈ twoUserClosedUserCone θ :=
    hScone (hgraph x hxI)
  have hfeasible : twoUserScoreFeasibleSet u v ∈ 𝓝 (x, g x) :=
    twoUserScoreFeasibleSet_mem_nhds_of_crossPartial_pos
      hu_nonnegative hv_nonnegative hu hv huv hα hβ hsin hcos hpointcone hcross
  apply deriv_nonpos_of_isMaxOn_graph_of_crossPartial_pos_local
    hxI hderiv hgraph hmax
  · obtain ⟨δ, hδ, hcrosses⟩ :=
      exists_local_graphCrosses_feasible_of_mem_nhds hfeasible hderiv.continuousAt
    refine ⟨δ, hδ, ?_⟩
    intro y hxy hy _
    exact hcrosses y hxy hy
  · exact exists_local_increasingGraphRectangles_of_crossPartial_pos
      hsin.ne' hx hderiv.continuousAt hcross

/-- Source-faithful negative-cross-partial branch of `regionscolor`: the
closed score cone is min/max closed, so every required crossed deviation is
realized by nonnegative content even at a boundary support point. -/
theorem twoUser_deriv_nonneg_of_isMaxOn_graph_of_crossPartial_neg_of_cone
    {u v : Content 2} {H1 H2 g : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    {α β θ a b x g' : ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hxI : x ∈ Set.Ioo a b) (hx : 0 < x)
    (hderiv : HasDerivAt g g' x)
    (hgraph : ∀ w ∈ Set.Ioo a b, (w, g w) ∈ S)
    (hScone : S ⊆ twoUserClosedUserCone θ)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) (twoUserScoreFeasibleSet u v) z)
    (hcross : twoUserInducedCostCrossPartial α β θ x (g x) < 0) :
    0 ≤ g' := by
  apply deriv_nonneg_of_isMaxOn_graph_of_crossPartial_neg_local
    hxI hderiv hgraph hmax
  · refine ⟨b - x, sub_pos.mpr hxI.2, ?_⟩
    intro y hxy hy hgy
    have hyI : y ∈ Set.Ioo a b := by
      constructor
      · exact lt_trans hxI.1 hxy
      · linarith
    have hpcone := hScone (hgraph x hxI)
    have hqcone := hScone (hgraph y hyI)
    refine ⟨?_, ?_⟩
    · have hmincone := twoUserClosedUserCone_min_mem hcos hpcone hqcone
      have hminfeasible := twoUserClosedUserCone_subset_scoreFeasible
        hu_nonnegative hv_nonnegative hu hv huv hsin.ne' hmincone
      simpa [min_eq_left hxy.le, min_eq_right hgy.le] using hminfeasible
    · have hmaxcone := twoUserClosedUserCone_max_mem hpcone hqcone
      have hmaxfeasible := twoUserClosedUserCone_subset_scoreFeasible
        hu_nonnegative hv_nonnegative hu hv huv hsin.ne' hmaxcone
      simpa [max_eq_right hxy.le, max_eq_left hgy.le] using hmaxfeasible
  · exact exists_local_decreasingGraphRectangles_of_crossPartial_neg
      hsin.ne' hx hderiv.continuousAt hcross

/-- Complete C1 graph sign theorem behind the source's `regionscolor` lemma.
It uses no marginal-density differentiation and no objective Hessian premise:
the two signs of the mixed partial are handled by cone geometry and the C1
four-point comparison. -/
theorem twoUser_slope_crossPartial_nonpos_of_isMaxOn_graph_of_cone
    {u v : Content 2} {H1 H2 g : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    {α β θ a b x g' : ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hcos : 0 ≤ Real.cos θ)
    (hxI : x ∈ Set.Ioo a b) (hx : 0 < x)
    (hderiv : HasDerivAt g g' x)
    (hgraph : ∀ w ∈ Set.Ioo a b, (w, g w) ∈ S)
    (hScone : S ⊆ twoUserClosedUserCone θ)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) (twoUserScoreFeasibleSet u v) z) :
    g' * twoUserInducedCostCrossPartial α β θ x (g x) ≤ 0 := by
  rcases lt_trichotomy (twoUserInducedCostCrossPartial α β θ x (g x)) 0 with
    hneg | hzero | hpos
  · exact mul_nonpos_of_nonneg_of_nonpos
      (twoUser_deriv_nonneg_of_isMaxOn_graph_of_crossPartial_neg_of_cone
        hu_nonnegative hv_nonnegative hu hv huv hsin hcos hxI hx hderiv hgraph hScone hmax
        hneg) hneg.le
  · simp [hzero]
  · exact mul_nonpos_of_nonpos_of_nonneg
      (twoUser_deriv_nonpos_of_isMaxOn_graph_of_crossPartial_pos_of_cone
        hu_nonnegative hv_nonnegative hu hv huv hα hβ hsin hcos hxI hx hderiv hgraph hScone
        hmax hpos) hpos.le

/--
Global score-support ordering without canonicalizing the original action cone.
The closed user-ray cone is a feasible sublattice of the actual score domain,
so strict cost submodularity gives the usual C1 ordering contradiction using
only original nonnegative-content deviations.
-/
theorem twoUserScore_ordered_snd_of_isMaxOn_of_crossPartial_neg
    {u v : Content 2} {α β θ : ℝ} {H1 H2 : ℝ → ℝ}
    {S : Set (ℝ × ℝ)}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hScone : S ⊆ twoUserClosedUserCone θ)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2)
        (twoUserScoreFeasibleSet u v) z)
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0) :
    ∀ p ∈ S, ∀ q ∈ S, p.1 < q.1 → p.2 ≤ q.2 := by
  apply ordered_snd_of_isMaxOn_and_strictSubmodular hmax
  · intro p q hp hq hpq hqp
    have hpcone := hScone hp
    have hqcone := hScone hq
    refine ⟨?_, ?_⟩
    · have hmincone := twoUserClosedUserCone_min_mem hcos hpcone hqcone
      have hminfeasible := twoUserClosedUserCone_subset_scoreFeasible
        hu_nonnegative hv_nonnegative hu hv huv hsin.ne' hmincone
      simpa [min_eq_left hpq.le, min_eq_right hqp.le] using hminfeasible
    · have hmaxcone := twoUserClosedUserCone_max_mem hpcone hqcone
      have hmaxfeasible := twoUserClosedUserCone_subset_scoreFeasible
        hu_nonnegative hv_nonnegative hu hv huv hsin.ne' hmaxcone
      simpa [max_eq_right hpq.le, max_eq_left hqp.le] using hmaxfeasible
  · intro x1 x2 y1 y2 hx hy
    exact twoUserInducedCost_strictSubmodular_of_crossPartial_neg_on_rectangle
      hx hy
      (fun x y _ _ => hbase x y)
      (fun x y _ _ => hcross x y)

/--
Global graph extraction from the valid fibre calculation in Proposition
`uniqueness`.  If the first induced-cost partial equals one common marginal
function at every point of a value-support set and the cross partial is
strictly negative on every vertical slice, the first projection is injective
on that support.  Hence the support is the graph of a function over its first
projection.  This is intentionally a setwise graph result: it does not claim
that the projection is an interval, that the graph is differentiable, or that
it reaches a boundary point.
-/
theorem twoUser_support_injOn_fst_of_common_firstPartial_of_crossPartial_neg
    {α β θ : ℝ} {H : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hfirst : ∀ z : ℝ × ℝ, z ∈ S →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
            (z.1 - z.2 * Real.cos θ) = H z.1) :
    S.InjOn Prod.fst := by
  rintro ⟨z1, z2⟩ hz ⟨z1', z2'⟩ hz' hfst
  change z1 = z1' at hfst
  subst z1'
  have hz2_eq : z2 = z2' :=
    twoUser_eq_verticalCoordinate_of_firstPartial_eq_of_crossPartial_neg
      (a := min z2 z2') (b := max z2 z2') (h := H z1)
      (fun z hz => hbase z1 z)
      (fun z hz => hcross z1 z)
      ⟨min_le_left _ _, le_max_left _ _⟩
      ⟨min_le_right _ _, le_max_right _ _⟩
      (hfirst (z1, z2) hz)
      (hfirst (z1, z2') hz')
  subst z2'
  rfl

/--
The coordinate-swapped support-fibre consequence.  When the second induced
cost partial equals one common marginal function on the support and the cross
partial is strictly negative on each horizontal slice, the second projection
is injective on that support.
-/
theorem twoUser_support_injOn_snd_of_common_secondPartial_of_crossPartial_neg
    {α β θ : ℝ} {H : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hsecond : ∀ z : ℝ × ℝ, z ∈ S →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
            (z.2 - z.1 * Real.cos θ) = H z.2) :
    S.InjOn Prod.snd := by
  rintro ⟨z1, z2⟩ hz ⟨z1', z2'⟩ hz' hsnd
  change z2 = z2' at hsnd
  subst z2'
  have hz1_eq : z1 = z1' :=
    twoUser_eq_horizontalCoordinate_of_secondPartial_eq_of_crossPartial_neg
      (a := min z1 z1') (b := max z1 z1') (h := H z2)
      (fun z hz => hbase z z2)
      (fun z hz => hcross z z2)
      ⟨min_le_left _ _, le_max_left _ _⟩
      ⟨min_le_right _ _, le_max_right _ _⟩
      (hsecond (z1, z2) hz)
      (hsecond (z1', z2) hz')
  subst z1'
  rfl

/--
Origin-aware first-coordinate support-fibre uniqueness.  The C1 first-order
identity is needed only away from the origin: a separate zero-first-coordinate
condition identifies the boundary fibre with the origin itself.  This is the
correct form when a compact value support is known to contain the zero action.
-/
theorem twoUser_support_injOn_fst_of_common_firstPartial_of_crossPartial_neg_awayOrigin
    {α β θ : ℝ} {H : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hzero_fst : ∀ z : ℝ × ℝ, z ∈ S → z.1 = 0 → z = (0, 0))
    (hfirst : ∀ z : ℝ × ℝ, z ∈ S → z ≠ (0, 0) →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
            (z.1 - z.2 * Real.cos θ) = H z.1) :
    S.InjOn Prod.fst := by
  rintro ⟨z1, z2⟩ hz ⟨z1', z2'⟩ hz' hfst
  change z1 = z1' at hfst
  subst z1'
  by_cases hz1 : z1 = 0
  · exact (hzero_fst (z1, z2) hz hz1).trans (hzero_fst (z1, z2') hz' hz1).symm
  · have hpair : (z1, z2) ≠ (0, 0) := by
      intro h
      have : z1 = 0 := by simpa using congrArg Prod.fst h
      exact hz1 this
    have hpair' : (z1, z2') ≠ (0, 0) := by
      intro h
      have : z1 = 0 := by simpa using congrArg Prod.fst h
      exact hz1 this
    have hz2_eq : z2 = z2' :=
      twoUser_eq_verticalCoordinate_of_firstPartial_eq_of_crossPartial_neg
        (a := min z2 z2') (b := max z2 z2') (h := H z1)
        (fun z _ => hbase z1 z)
        (fun z _ => hcross z1 z)
        ⟨min_le_left _ _, le_max_left _ _⟩
        ⟨min_le_right _ _, le_max_right _ _⟩
        (hfirst (z1, z2) hz hpair)
        (hfirst (z1, z2') hz' hpair')
    exact Prod.ext rfl hz2_eq

/--
Origin-aware second-coordinate support-fibre uniqueness.  It is the symmetric
boundary-safe counterpart of the first-coordinate lemma and avoids invoking a
pointwise C1 first-order condition at the zero support endpoint.
-/
theorem twoUser_support_injOn_snd_of_common_secondPartial_of_crossPartial_neg_awayOrigin
    {α β θ : ℝ} {H : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hzero_snd : ∀ z : ℝ × ℝ, z ∈ S → z.2 = 0 → z = (0, 0))
    (hsecond : ∀ z : ℝ × ℝ, z ∈ S → z ≠ (0, 0) →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
            (z.2 - z.1 * Real.cos θ) = H z.2) :
    S.InjOn Prod.snd := by
  rintro ⟨z1, z2⟩ hz ⟨z1', z2'⟩ hz' hsnd
  change z2 = z2' at hsnd
  subst z2'
  by_cases hz2 : z2 = 0
  · exact (hzero_snd (z1, z2) hz hz2).trans (hzero_snd (z1', z2) hz' hz2).symm
  · have hpair : (z1, z2) ≠ (0, 0) := by
      intro h
      have : z2 = 0 := by simpa using congrArg Prod.snd h
      exact hz2 this
    have hpair' : (z1', z2) ≠ (0, 0) := by
      intro h
      have : z2 = 0 := by simpa using congrArg Prod.snd h
      exact hz2 this
    have hz1_eq : z1 = z1' :=
      twoUser_eq_horizontalCoordinate_of_secondPartial_eq_of_crossPartial_neg
        (a := min z1 z1') (b := max z1 z1') (h := H z2)
        (fun z _ => hbase z z2)
        (fun z _ => hcross z z2)
        ⟨min_le_left _ _, le_max_left _ _⟩
        ⟨min_le_right _ _, le_max_right _ _⟩
        (hsecond (z1, z2) hz hpair)
        (hsecond (z1', z2) hz' hpair')
    exact Prod.ext hz1_eq rfl

/--
Origin-aware first-coordinate fibre uniqueness using only the strict
cross-partial sign on the positive score cone.  The closed vertical interval
between two non-origin support values stays positive, so the induced-cost
numerator never vanishes there.  This is the source-shaped replacement for a
global sign/base assumption, which cannot hold at the origin.
-/
theorem twoUser_support_injOn_fst_of_common_firstPartial_of_crossPartial_neg_pos_awayOrigin
    {α β θ : ℝ} {H : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hsin : Real.sin θ ≠ 0)
    (hcross : ∀ z1 z2 : ℝ, 0 < z1 → 0 < z2 →
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hpositive : ∀ z : ℝ × ℝ, z ∈ S → z ≠ (0, 0) →
      0 < z.1 ∧ 0 < z.2)
    (hzero_fst : ∀ z : ℝ × ℝ, z ∈ S → z.1 = 0 → z = (0, 0))
    (hfirst : ∀ z : ℝ × ℝ, z ∈ S → z ≠ (0, 0) →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
            (z.1 - z.2 * Real.cos θ) = H z.1) :
    S.InjOn Prod.fst := by
  rintro ⟨z1, z2⟩ hz ⟨z1', z2'⟩ hz' hfst
  change z1 = z1' at hfst
  subst z1'
  by_cases hz1 : z1 = 0
  · exact (hzero_fst (z1, z2) hz hz1).trans
      (hzero_fst (z1, z2') hz' hz1).symm
  · have hpair : (z1, z2) ≠ (0, 0) := by
      intro h
      exact hz1 (by simpa using congrArg Prod.fst h)
    have hpair' : (z1, z2') ≠ (0, 0) := by
      intro h
      exact hz1 (by simpa using congrArg Prod.fst h)
    have hpos := hpositive (z1, z2) hz hpair
    have hpos' := hpositive (z1, z2') hz' hpair'
    have hz2_eq : z2 = z2' :=
      twoUser_eq_verticalCoordinate_of_firstPartial_eq_of_crossPartial_neg
        (a := min z2 z2') (b := max z2 z2') (h := H z1)
        (fun z _ => Or.inl
          (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin
            (Or.inl hpos.1.ne')))
        (fun z hzIoo => hcross z1 z hpos.1
          (lt_of_lt_of_le (lt_min hpos.2 hpos'.2) hzIoo.1.le))
        ⟨min_le_left _ _, le_max_left _ _⟩
        ⟨min_le_right _ _, le_max_right _ _⟩
        (hfirst (z1, z2) hz hpair)
        (hfirst (z1, z2') hz' hpair')
    exact Prod.ext rfl hz2_eq

/-- The positive-score-cone counterpart of
`twoUser_support_injOn_fst_of_common_firstPartial_of_crossPartial_neg_pos_awayOrigin`
for the second coordinate. -/
theorem twoUser_support_injOn_snd_of_common_secondPartial_of_crossPartial_neg_pos_awayOrigin
    {α β θ : ℝ} {H : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hsin : Real.sin θ ≠ 0)
    (hcross : ∀ z1 z2 : ℝ, 0 < z1 → 0 < z2 →
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hpositive : ∀ z : ℝ × ℝ, z ∈ S → z ≠ (0, 0) →
      0 < z.1 ∧ 0 < z.2)
    (hzero_snd : ∀ z : ℝ × ℝ, z ∈ S → z.2 = 0 → z = (0, 0))
    (hsecond : ∀ z : ℝ × ℝ, z ∈ S → z ≠ (0, 0) →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
            (z.2 - z.1 * Real.cos θ) = H z.2) :
    S.InjOn Prod.snd := by
  rintro ⟨z1, z2⟩ hz ⟨z1', z2'⟩ hz' hsnd
  change z2 = z2' at hsnd
  subst z2'
  by_cases hz2 : z2 = 0
  · exact (hzero_snd (z1, z2) hz hz2).trans
      (hzero_snd (z1', z2) hz' hz2).symm
  · have hpair : (z1, z2) ≠ (0, 0) := by
      intro h
      exact hz2 (by simpa using congrArg Prod.snd h)
    have hpair' : (z1', z2) ≠ (0, 0) := by
      intro h
      exact hz2 (by simpa using congrArg Prod.snd h)
    have hpos := hpositive (z1, z2) hz hpair
    have hpos' := hpositive (z1', z2) hz' hpair'
    have hz1_eq : z1 = z1' :=
      twoUser_eq_horizontalCoordinate_of_secondPartial_eq_of_crossPartial_neg
        (a := min z1 z1') (b := max z1 z1') (h := H z2)
        (fun z _ => Or.inl
          (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin
            (Or.inr hpos.2.ne')))
        (fun z hzIoo => hcross z z2
          (lt_of_lt_of_le (lt_min hpos.1 hpos'.1) hzIoo.1.le) hpos.2)
        ⟨min_le_left _ _, le_max_left _ _⟩
        ⟨min_le_right _ _, le_max_right _ _⟩
        (hsecond (z1, z2) hz hpair)
        (hsecond (z1', z2) hz' hpair')
    exact Prod.ext hz1_eq rfl

/--
The support-graph form of `twoUser_support_injOn_fst_of_common_firstPartial_of_crossPartial_neg`.
The graph is defined only up to values outside the first projection of the
support, which is exactly the source proof's relevant domain.
-/
theorem twoUser_exists_graphOn_support_of_common_firstPartial_of_crossPartial_neg
    {α β θ : ℝ} {H : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hfirst : ∀ z : ℝ × ℝ, z ∈ S →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
            (z.1 - z.2 * Real.cos θ) = H z.1) :
    ∃ g : ℝ → ℝ, S = (Prod.fst '' S).graphOn g :=
  Set.exists_eq_graphOn_image_fst.mpr
    (twoUser_support_injOn_fst_of_common_firstPartial_of_crossPartial_neg
      hbase hcross hfirst)

/--
The elementary scaling choice needed by the no-gap argument in Proposition
`uniqueness`.  Two positive-coordinate gaps can be entered simultaneously
by scaling their upper endpoints by one common factor strictly between zero
and one.  This is the valid geometric part of the source's proposed
cost-reducing deviation; CDF flatness and feasibility of that deviation are
separate hypotheses.
-/
theorem exists_unit_scaling_mem_two_open_intervals_of_nonneg
    {a b c d : ℝ}
    (ha : 0 ≤ a) (hab : a < b) (hc : 0 ≤ c) (hcd : c < d) :
    ∃ t : ℝ, 0 < t ∧ t < 1 ∧
      a < t * b ∧ t * b < b ∧ c < t * d ∧ t * d < d := by
  have hb : 0 < b := lt_of_le_of_lt ha hab
  have hd : 0 < d := lt_of_le_of_lt hc hcd
  let r : ℝ := max (a / b) (c / d)
  have har : a / b ≤ r := le_max_left _ _
  have hcr : c / d ≤ r := le_max_right _ _
  have hr_nonneg : 0 ≤ r := by
    exact le_max_of_le_left (div_nonneg ha hb.le)
  have hr_lt_one : r < 1 := by
    exact max_lt ((div_lt_one hb).mpr hab) ((div_lt_one hd).mpr hcd)
  obtain ⟨t, hrt, ht_one⟩ := exists_between hr_lt_one
  refine ⟨t, hr_nonneg.trans_lt hrt, ht_one, ?_, ?_, ?_, ?_⟩
  · exact (div_lt_iff₀ hb).mp (har.trans_lt hrt)
  · simpa using mul_lt_mul_of_pos_right ht_one hb
  · exact (div_lt_iff₀ hd).mp (hcr.trans_lt hrt)
  · simpa using mul_lt_mul_of_pos_right ht_one hd

/--
The exact C1 contradiction behind the source no-gap scaling deviation. It is
stated with CDF-flatness equalities and scaled feasibility visible because
those are the nonlocal facts needed before applying it to a support gap.
-/
theorem twoUser_not_isMaxOn_of_strictScale_same_marginals
    {H1 H2 : ℝ → ℝ} {α β θ z1 z2 t : ℝ} {feasible : Set (ℝ × ℝ)}
    (hmax : IsMaxOn
      (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
        twoUserInducedCost α β θ z.1 z.2)
      feasible (z1, z2))
    (hscaled_feasible : (t * z1, t * z2) ∈ feasible)
    (hH1 : H1 (t * z1) = H1 z1)
    (hH2 : H2 (t * z2) = H2 z2)
    (hcost : twoUserInducedCost α β θ (t * z1) (t * z2) <
      twoUserInducedCost α β θ z1 z2) :
    False := by
  have hscaled_le := hmax hscaled_feasible
  have hscaled_lt :
      H1 z1 + H2 z2 - twoUserInducedCost α β θ z1 z2 <
        H1 (t * z1) + H2 (t * z2) -
          twoUserInducedCost α β θ (t * z1) (t * z2) := by
    rw [hH1, hH2]
    exact sub_lt_sub_left hcost _
  exact (not_lt_of_ge hscaled_le) (by simpa using hscaled_lt)

/--
Conditional graph-monotonicity conclusion from Step 1 of the source
`uniqueness` proof.  If an explicitly supplied support graph is continuous,
has nonnegative slope, and is injective on a closed interval, it is strictly
increasing there.  The preceding source argument still has to establish those
graph and interval hypotheses from equilibrium.
-/
theorem twoUser_graph_strictMonoOn_of_continuousOn_hasDerivAt_nonneg_injOn
    {g g' : ℝ → ℝ} {a b : ℝ}
    (hcont : ContinuousOn g (Set.Icc a b))
    (hderiv : ∀ w, w ∈ Set.Ioo a b → HasDerivAt g (g' w) w)
    (hnonneg : ∀ w, w ∈ Set.Ioo a b → 0 ≤ g' w)
    (hinj : (Set.Icc a b).InjOn g) :
    StrictMonoOn g (Set.Icc a b) :=
  AppliedModelingLib.strictMonoOn_Icc_of_continuousOn_hasDerivAt_nonneg_injOn
    hcont hderiv hnonneg hinj

/--
Source-shaped first-order step: at a local maximum of the two-user objective,
an explicit derivative of the first marginal term and the induced-cost
derivative give the first-partial identity.  The local maximum and both
differentiability facts remain visible rather than being inferred from C1 or
equilibrium semantics.
-/
theorem twoUserInducedCostFirstPartial_eq_marginalDerivative_of_isLocalMax
    {H1 H2 h1 : ℝ → ℝ} {α β θ z1 z2 : ℝ}
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : HasDerivAt H1 (h1 z1) z1)
    (hmax : IsLocalMax
      (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
        twoUserInducedCost α β θ z.1 z.2) (z1, z2)) :
    β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
          (z1 - z2 * Real.cos θ) = h1 z1 := by
  have hslice : IsLocalMax
      (fun x : ℝ => H1 x + H2 z2 - twoUserInducedCost α β θ x z2) z1 := by
    have hcomp := hmax.comp_continuous (g := fun x : ℝ => (x, z2))
      (continuousAt_id.prodMk continuousAt_const)
    simpa [Function.comp_def] using hcomp
  have hcost := hasDerivAt_twoUserInducedCost_z1 (α := α) hbase
  have hobjective : HasDerivAt
      (fun x : ℝ => H1 x + H2 z2 - twoUserInducedCost α β θ x z2)
      (h1 z1 -
        (β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
            (z1 - z2 * Real.cos θ))) z1 := by
    simpa using ((hH1.add (hasDerivAt_const z1 (H2 z2))).sub hcost)
  have hzero := hslice.hasDerivAt_eq_zero hobjective
  exact (sub_eq_zero.mp hzero).symm

/--
Ball-wide source FOC bridge.  At every point of a displayed Euclidean ball,
local maximality of the reparameterized objective and explicit first-marginal
and induced-cost derivatives give the first-partial identity used in the
support-restriction argument.
-/
theorem twoUserInducedCostFirstPartial_eq_marginalDerivative_on_l2Ball_of_isLocalMax
    {H1 H2 h1 : ℝ → ℝ} {α β θ z1 z2 ε : ℝ}
    (hbase : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        HasDerivAt H1 (h1 x) x)
    (hmax : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        IsLocalMax
          (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
            twoUserInducedCost α β θ z.1 z.2) (x, y)) :
    ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x y) ^ (β / 2 - 1) *
              (x - y * Real.cos θ) = h1 x := by
  intro x y hxy
  exact twoUserInducedCostFirstPartial_eq_marginalDerivative_of_isLocalMax
    (hbase x y hxy) (hH1 x y hxy) (hmax x y hxy)

/-- Source sign bracket from Lemma `secondderiv`. -/
noncomputable def twoUserSecondDerivSignBracket
    (β θ φ : ℝ) : ℝ :=
  ((β - 2) / β) * Real.cos (θ - 2 * φ) - Real.cos θ

private theorem hasDerivAt_zero_of_eq_const_on_Ioo
    {f : ℝ → ℝ} {a b x c : ℝ}
    (hx : x ∈ Set.Ioo a b)
    (hconstant : ∀ y, y ∈ Set.Ioo a b → f y = c) :
    HasDerivAt f 0 x := by
  have hlocal : (fun _ : ℝ => c) =ᶠ[nhds x] f := by
    filter_upwards [isOpen_Ioo.mem_nhds hx] with y hy
    exact (hconstant y hy).symm
  exact (hasDerivAt_const x c).congr_of_eventuallyEq hlocal.symm

private theorem eq_on_l2Ball_implies_eq_on_vertical_Ioo
    {f : ℝ → ℝ → ℝ} {g : ℝ → ℝ}
    {z1 z2 ε : ℝ}
    (hball : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → f x y = g x) :
    ∀ y, y ∈ Set.Ioo (z2 - ε) (z2 + ε) → f z1 y = g z1 := by
  intro y hy
  have hleft : 0 < ε - (y - z2) := by linarith [hy.2]
  have hright : 0 < ε + (y - z2) := by linarith [hy.1]
  have hsq : (y - z2) ^ 2 < ε ^ 2 := by
    have hprod : 0 < (ε - (y - z2)) * (ε + (y - z2)) :=
      mul_pos hleft hright
    nlinarith
  apply hball z1 y
  simpa using hsq

/--
An ambient-set maximizer is an unrestricted local maximizer at any point of an
open Euclidean ball contained in that ambient set.  This keeps the support-ball
and feasible-domain hypotheses separate in the source structural argument.
-/
private theorem isLocalMax_of_isMaxOn_of_l2Ball_subset
    {f : ℝ × ℝ → ℝ} {s : Set (ℝ × ℝ)}
    {z1 z2 ε x y : ℝ}
    (hball_subset : ∀ a b : ℝ,
      (a - z1) ^ 2 + (b - z2) ^ 2 < ε ^ 2 → (a, b) ∈ s)
    (hmax : IsMaxOn f s (x, y))
    (hxy : (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2) :
    IsLocalMax f (x, y) := by
  let B : Set (ℝ × ℝ) :=
    {z | (z.1 - z1) ^ 2 + (z.2 - z2) ^ 2 < ε ^ 2}
  have hB_subset : B ⊆ s := by
    intro z hz
    exact hball_subset z.1 z.2 hz
  have hmax_B : IsMaxOn f B (x, y) := hmax.on_subset hB_subset
  have hcontinuous : Continuous
      (fun z : ℝ × ℝ => (z.1 - z1) ^ 2 + (z.2 - z2) ^ 2) :=
    ((continuous_fst.sub continuous_const).pow 2).add
      ((continuous_snd.sub continuous_const).pow 2)
  have hopen : IsOpen B := by
    exact isOpen_lt hcontinuous continuous_const
  apply hmax_B.isLocalMax
  apply hopen.mem_nhds
  simpa [B] using hxy

/--
C1-style ball-to-FOC bridge.  If each point of a displayed support ball is a
maximizer of the reparameterized objective over an ambient feasible set and
that ball lies in the feasible set, the source first-partial identity follows
throughout the ball from visible derivative premises.
-/
theorem twoUserInducedCostFirstPartial_eq_marginalDerivative_on_l2Ball_of_supportMaximizers
    {H1 H2 h1 : ℝ → ℝ} {α β θ z1 z2 ε : ℝ}
    {S feasible : Set (ℝ × ℝ)}
    (hbase : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        HasDerivAt H1 (h1 x) x)
    (hball_support : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → (x, y) ∈ S)
    (hC1 : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn
        (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
          twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hball_feasible : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → (x, y) ∈ feasible) :
    ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x y) ^ (β / 2 - 1) *
              (x - y * Real.cos θ) = h1 x := by
  intro x y hxy
  apply twoUserInducedCostFirstPartial_eq_marginalDerivative_of_isLocalMax
    (hbase x y hxy) (hH1 x y hxy)
  exact isLocalMax_of_isMaxOn_of_l2Ball_subset hball_feasible
    (hC1 (x, y) (hball_support x y hxy)) hxy

/--
Local calculus step from Proposition `supportrestriction`: if the source FOC
first-partial expression is constant on a vertical open interval, then its
cross-partial vanishes at the interior point. The FOC constancy and
differentiability conditions remain explicit premises.
-/
theorem twoUserInducedCostCrossPartial_eq_zero_of_firstPartial_eq_on_Ioo
    {α β θ z1 z2 a b h : ℝ}
    (hz2 : z2 ∈ Set.Ioo a b)
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hconstant : ∀ y, y ∈ Set.Ioo a b →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ z1 y) ^ (β / 2 - 1) *
            (z1 - y * Real.cos θ) = h) :
    twoUserInducedCostCrossPartial α β θ z1 z2 = 0 := by
  have hzero := hasDerivAt_zero_of_eq_const_on_Ioo hz2 hconstant
  have hderiv :=
    hasDerivAt_twoUserInducedCost_z1_derivative_z2 (α := α) hbase
  exact (hzero.unique hderiv).symm

/--
Almost-everywhere repair of the source FOC step.  If the source first-partial
expression agrees almost everywhere with one common marginal function, then
continuity in the first coordinate upgrades the comparison between any two
vertical slices to pointwise equality on an open rectangle.  The
cross-partial therefore vanishes there.  This is the precise replacement for
the source proof's unjustified use of an a.e. derivative at every point.
-/
theorem twoUserInducedCostCrossPartial_eq_zero_of_ae_firstPartial_eq_on_rectangle
    {α β θ a b c d x y : ℝ} {h1 : ℝ → ℝ}
    (hab : a < b) (hcd : c < d)
    (hx : x ∈ Set.Ioo a b) (hy : y ∈ Set.Ioo c d)
    (hbase : ∀ u v : ℝ, u ∈ Set.Ioo a b → v ∈ Set.Ioo c d →
      twoUserInducedCostNumerator θ u v ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hpartial_cont : ∀ v : ℝ, v ∈ Set.Ioo c d →
      ContinuousOn
        (fun u : ℝ => β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ u v) ^ (β / 2 - 1) *
            (u - v * Real.cos θ))
        (Set.Ioo a b))
    (hfirst_ae : ∀ᵐ u ∂volume, u ∈ Set.Ioo a b → ∀ v : ℝ,
      v ∈ Set.Ioo c d → β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ u v) ^ (β / 2 - 1) *
          (u - v * Real.cos θ) = h1 u) :
    twoUserInducedCostCrossPartial α β θ x y = 0 := by
  let y0 : ℝ := (c + d) / 2
  have hy0 : y0 ∈ Set.Ioo c d := by
    dsimp [y0]
    constructor <;> linarith
  refine twoUserInducedCostCrossPartial_eq_zero_of_firstPartial_eq_on_Ioo
    (a := c) (b := d)
    (h := β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ x y0) ^ (β / 2 - 1) *
        (x - y0 * Real.cos θ))
    hy (hbase x y hx hy) ?_
  intro v hv
  have hae_slices :
      (fun u : ℝ => β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ u v) ^ (β / 2 - 1) *
          (u - v * Real.cos θ)) =ᵐ[volume.restrict (Set.Ioo a b)]
        (fun u : ℝ => β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ u y0) ^ (β / 2 - 1) *
            (u - y0 * Real.cos θ)) := by
    rw [Filter.EventuallyEq, ae_restrict_iff' measurableSet_Ioo]
    filter_upwards [hfirst_ae] with u hu hu_rect
    exact (hu hu_rect v hv).trans (hu hu_rect y0 hy0).symm
  have heq_slices := Measure.eqOn_open_of_ae_eq hae_slices isOpen_Ioo
    (hpartial_cont v hv) (hpartial_cont y0 hy0)
  exact heq_slices hx

/--
Open-set form of the local FOC-to-cross-partial step.  If the first induced
cost partial depends only on the first value coordinate throughout an open
set, then its cross-partial vanishes at every point of that set.  This is the
local-topology bridge required to apply the support-restriction argument away
from the center of a displayed support ball.
-/
theorem twoUserInducedCostCrossPartial_eq_zero_of_firstPartial_eq_on_isOpen
    {α β θ z1 z2 : ℝ} {h : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hopen : IsOpen S) (hpoint : (z1, z2) ∈ S)
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hfoc : ∀ x y : ℝ, (x, y) ∈ S →
      β * α * (Real.sin θ) ^ (-β) *
          (twoUserInducedCostNumerator θ x y) ^ (β / 2 - 1) *
            (x - y * Real.cos θ) = h x) :
    twoUserInducedCostCrossPartial α β θ z1 z2 = 0 := by
  let T : Set ℝ := (fun y : ℝ => (z1, y)) ⁻¹' S
  have hTopen : IsOpen T := by
    exact hopen.preimage (continuous_const.prodMk continuous_id)
  have hz2T : z2 ∈ T := by
    simpa [T] using hpoint
  rcases Metric.mem_nhds_iff.mp (hTopen.mem_nhds hz2T) with
    ⟨ε, hε_pos, hε_subset⟩
  apply twoUserInducedCostCrossPartial_eq_zero_of_firstPartial_eq_on_Ioo
    (a := z2 - ε / 2) (b := z2 + ε / 2)
  · constructor <;> linarith
  · exact hbase
  · intro y hy
    apply hfoc z1 y
    change y ∈ T
    apply hε_subset
    rw [Metric.mem_ball]
    change |y - z2| < ε
    rw [abs_lt]
    constructor <;> nlinarith [hy.1, hy.2, hε_pos]

/--
C1-style open-support bridge for Proposition `supportrestriction`.  On an
open subset of the source value support which lies in the feasible domain,
ambient value-objective maximization gives local maxima pointwise. Together
with the visible derivative hypotheses, the cross-partial must vanish at each
specified interior support point.
-/
theorem twoUserInducedCostCrossPartial_eq_zero_of_supportMaximizers_on_isOpen
    {H1 H2 h1 : ℝ → ℝ} {α β θ z1 z2 : ℝ}
    {S feasible : Set (ℝ × ℝ)}
    (hopen : IsOpen S) (hpoint : (z1, z2) ∈ S)
    (hS_feasible : S ⊆ feasible)
    (hbase_cross : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ, (x, y) ∈ S →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : ∀ x y : ℝ, (x, y) ∈ S → HasDerivAt H1 (h1 x) x)
    (hC1 : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn
        (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
          twoUserInducedCost α β θ z.1 z.2) feasible z) :
    twoUserInducedCostCrossPartial α β θ z1 z2 = 0 := by
  apply twoUserInducedCostCrossPartial_eq_zero_of_firstPartial_eq_on_isOpen
    (h := h1) hopen hpoint hbase_cross
  intro x y hxy
  exact twoUserInducedCostFirstPartial_eq_marginalDerivative_of_isLocalMax
    (hbase_first x y hxy) (hH1 x y hxy) (by
      have hmaxS : IsMaxOn
          (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
            twoUserInducedCost α β θ z.1 z.2) S (x, y) :=
        (hC1 (x, y) hxy).on_subset hS_feasible
      exact hmaxS.isLocalMax (hopen.mem_nhds hxy))

/-- A.e. version of the C1/open-support FOC bridge.  A single
almost-everywhere differentiability statement for the first marginal is enough
to obtain the common first-partial identity simultaneously for every vertical
slice through each differentiability point. -/
theorem twoUserInducedCostFirstPartial_eq_marginalDerivative_ae_of_supportMaximizers_on_isOpen
    {H1 H2 h1 : ℝ → ℝ} {α β θ : ℝ}
    {S feasible : Set (ℝ × ℝ)}
    (hopen : IsOpen S) (hS_feasible : S ⊆ feasible)
    (hbase_first : ∀ x y : ℝ, (x, y) ∈ S →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1_ae : ∀ᵐ x ∂volume, (∃ y : ℝ, (x, y) ∈ S) →
      HasDerivAt H1 (h1 x) x)
    (hC1 : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn
        (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
          twoUserInducedCost α β θ z.1 z.2) feasible z) :
    ∀ᵐ x ∂volume, ∀ y : ℝ, (x, y) ∈ S →
      β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ x y) ^ (β / 2 - 1) *
          (x - y * Real.cos θ) = h1 x := by
  filter_upwards [hH1_ae] with x hx
  intro y hxy
  exact twoUserInducedCostFirstPartial_eq_marginalDerivative_of_isLocalMax
    (hbase_first x y hxy) (hx ⟨y, hxy⟩) (by
      have hmaxS : IsMaxOn
          (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
            twoUserInducedCost α β θ z.1 z.2) S (x, y) :=
        (hC1 (x, y) hxy).on_subset hS_feasible
      exact hmaxS.isLocalMax (hopen.mem_nhds hxy))

/-- Open-set a.e. FOC upgrade.  The prior rectangle theorem is localized at
an arbitrary point of the open support, so an a.e. common first partial and
continuity of that partial yield pointwise cross-partial zero throughout the
open set. -/
theorem twoUserInducedCostCrossPartial_eq_zero_of_ae_firstPartial_eq_on_isOpen
    {α β θ x y : ℝ} {h1 : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hopen : IsOpen S) (hpoint : (x, y) ∈ S)
    (hbase : ∀ u v : ℝ, (u, v) ∈ S →
      twoUserInducedCostNumerator θ u v ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hpartial_cont : ContinuousOn
      (fun z : ℝ × ℝ => β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
          (z.1 - z.2 * Real.cos θ)) S)
    (hfirst_ae : ∀ᵐ u ∂volume, ∀ v : ℝ, (u, v) ∈ S →
      β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ u v) ^ (β / 2 - 1) *
          (u - v * Real.cos θ) = h1 u) :
    twoUserInducedCostCrossPartial α β θ x y = 0 := by
  obtain ⟨ε, hε_pos, hball⟩ :=
    Metric.mem_nhds_iff.mp (hopen.mem_nhds hpoint)
  let a : ℝ := x - ε / 2
  let b : ℝ := x + ε / 2
  let c : ℝ := y - ε / 2
  let d : ℝ := y + ε / 2
  have hab : a < b := by dsimp [a, b]; linarith
  have hcd : c < d := by dsimp [c, d]; linarith
  have hx : x ∈ Set.Ioo a b := by
    dsimp [a, b]
    constructor <;> linarith
  have hy : y ∈ Set.Ioo c d := by
    dsimp [c, d]
    constructor <;> linarith
  have hrect : ∀ u v : ℝ, u ∈ Set.Ioo a b → v ∈ Set.Ioo c d → (u, v) ∈ S := by
    intro u v hu hv
    have hu' : x - ε / 2 < u ∧ u < x + ε / 2 := by simpa [a, b] using hu
    have hv' : y - ε / 2 < v ∧ v < y + ε / 2 := by simpa [c, d] using hv
    apply hball
    rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
    constructor
    · rw [Real.dist_eq, abs_lt]
      constructor <;> linarith [hu'.1, hu'.2, hε_pos]
    · rw [Real.dist_eq, abs_lt]
      constructor <;> linarith [hv'.1, hv'.2, hε_pos]
  refine twoUserInducedCostCrossPartial_eq_zero_of_ae_firstPartial_eq_on_rectangle
    (h1 := h1) hab hcd hx hy ?_ ?_ ?_
  · intro u v hu hv
    exact hbase u v (hrect u v hu hv)
  · intro v hv u hu
    have huv : (u, v) ∈ S := hrect u v hu hv
    have hmap : ContinuousAt (fun w : ℝ => (w, v)) u :=
      continuousAt_id.prodMk continuousAt_const
    simpa [Function.comp_def] using
      (hpartial_cont.continuousAt (hopen.mem_nhds huv)).comp_continuousWithinAt_of_eq
        hmap.continuousWithinAt rfl
  · filter_upwards [hfirst_ae] with u hu
    intro hu_rect v hv
    exact hu v (hrect u v hu_rect hv)

/--
Pointwise l2-ball form of the C1-style support bridge.  Every interior point
of a displayed support ball has zero canonical cross-partial, not merely the
ball center. This is the precise local statement needed before the source
parametrizes the ball by an interval of angles.
-/
theorem twoUserInducedCostCrossPartial_eq_zero_at_l2BallPoint_of_supportMaximizers
    {H1 H2 h1 : ℝ → ℝ} {α β θ z1 z2 ε x y : ℝ}
    {support feasible : Set (ℝ × ℝ)}
    (hbase_cross : twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ a b : ℝ,
      (a - z1) ^ 2 + (b - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ a b ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : ∀ a b : ℝ,
      (a - z1) ^ 2 + (b - z2) ^ 2 < ε ^ 2 →
        HasDerivAt H1 (h1 a) a)
    (hpoint : (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2)
    (hball_support : ∀ a b : ℝ,
      (a - z1) ^ 2 + (b - z2) ^ 2 < ε ^ 2 → (a, b) ∈ support)
    (hC1 : ∀ z : ℝ × ℝ, z ∈ support →
      IsMaxOn
        (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
          twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hball_feasible : ∀ a b : ℝ,
      (a - z1) ^ 2 + (b - z2) ^ 2 < ε ^ 2 → (a, b) ∈ feasible) :
    twoUserInducedCostCrossPartial α β θ x y = 0 := by
  let B : Set (ℝ × ℝ) := {z |
    (z.1 - z1) ^ 2 + (z.2 - z2) ^ 2 < ε ^ 2}
  have hBopen : IsOpen B := by
    exact isOpen_lt
      (((continuous_fst.sub continuous_const).pow 2).add
        ((continuous_snd.sub continuous_const).pow 2))
      continuous_const
  refine twoUserInducedCostCrossPartial_eq_zero_of_supportMaximizers_on_isOpen
    (H1 := H1) (H2 := H2) (h1 := h1) (S := B) (feasible := feasible)
    hBopen (by simpa [B] using hpoint) ?_ hbase_cross ?_ ?_ ?_
  · intro z hz
    exact hball_feasible z.1 z.2 (by simpa [B] using hz)
  · intro a b hab
    exact hbase_first a b (by simpa [B] using hab)
  · intro a b hab
    exact hH1 a b (by simpa [B] using hab)
  · intro z hz
    exact hC1 z (hball_support z.1 z.2 (by simpa [B] using hz))

/--
Source-shaped local bridge from a two-dimensional Euclidean ball to the
vertical FOC interval used in Proposition `supportrestriction`. The ball-wide
FOC identity, positive radius, and differentiability condition are visible;
this theorem makes no support or equilibrium assertion.
-/
theorem twoUserInducedCostCrossPartial_eq_zero_of_firstPartial_eq_on_l2Ball
    {α β θ z1 z2 ε : ℝ} (hε : 0 < ε)
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    {h1 : ℝ → ℝ}
    (hfoc : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        β * α * (Real.sin θ) ^ (-β) *
            (twoUserInducedCostNumerator θ x y) ^ (β / 2 - 1) *
              (x - y * Real.cos θ) = h1 x) :
    twoUserInducedCostCrossPartial α β θ z1 z2 = 0 := by
  apply twoUserInducedCostCrossPartial_eq_zero_of_firstPartial_eq_on_Ioo
    (a := z2 - ε) (b := z2 + ε)
  · constructor <;> linarith
  · exact hbase
  · exact eq_on_l2Ball_implies_eq_on_vertical_Ioo hfoc

/--
Source-shaped local-max-to-cross-partial bridge.  A positive-radius ball of
local maxima for the displayed reparameterized objective yields the FOC
identity internally, then the existing local calculus forces the canonical
cross-partial to vanish at the center.  No equilibrium, support, or C1 package
is introduced.
-/
theorem twoUserInducedCostCrossPartial_eq_zero_of_isLocalMax_on_l2Ball
    {H1 H2 h1 : ℝ → ℝ} {α β θ z1 z2 ε : ℝ}
    (hε : 0 < ε)
    (hbase_cross : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        HasDerivAt H1 (h1 x) x)
    (hmax : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        IsLocalMax
          (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
            twoUserInducedCost α β θ z.1 z.2) (x, y)) :
    twoUserInducedCostCrossPartial α β θ z1 z2 = 0 := by
  apply twoUserInducedCostCrossPartial_eq_zero_of_firstPartial_eq_on_l2Ball
    hε hbase_cross
  exact twoUserInducedCostFirstPartial_eq_marginalDerivative_on_l2Ball_of_isLocalMax
    hbase_first hH1 hmax

/--
C1-style support-ball-to-cross-partial bridge.  The visible support-ball,
ambient-feasible-set, C1-style maximizer, and derivative premises derive the
local maxima and FOC internally before applying the existing cross-partial
calculus.  This is not an equilibrium or support-restriction conclusion.
-/
theorem twoUserInducedCostCrossPartial_eq_zero_of_supportMaximizers_on_l2Ball
    {H1 H2 h1 : ℝ → ℝ} {α β θ z1 z2 ε : ℝ}
    {S feasible : Set (ℝ × ℝ)}
    (hε : 0 < ε)
    (hbase_cross : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        HasDerivAt H1 (h1 x) x)
    (hball_support : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → (x, y) ∈ S)
    (hC1 : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn
        (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
          twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hball_feasible : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → (x, y) ∈ feasible) :
    twoUserInducedCostCrossPartial α β θ z1 z2 = 0 := by
  apply twoUserInducedCostCrossPartial_eq_zero_of_firstPartial_eq_on_l2Ball
    hε hbase_cross
  exact twoUserInducedCostFirstPartial_eq_marginalDerivative_on_l2Ball_of_supportMaximizers
    hbase_first hH1 hball_support hC1 hball_feasible

private theorem hasDerivAt_twoUserSecondDerivSignBracket
    (β θ φ : ℝ) :
    HasDerivAt
      (fun x : ℝ => twoUserSecondDerivSignBracket β θ x)
      (2 * ((β - 2) / β) * Real.sin (θ - 2 * φ)) φ := by
  have hinner : HasDerivAt (fun x : ℝ => θ - 2 * x) (-2) φ := by
    simpa using (hasDerivAt_const φ θ).sub ((hasDerivAt_id φ).const_mul 2)
  have hcos := (Real.hasDerivAt_cos (θ - 2 * φ)).comp φ hinner
  have h := hcos.const_mul ((β - 2) / β)
  have hconst : HasDerivAt (fun _ : ℝ => Real.cos θ) 0 φ :=
    hasDerivAt_const φ (Real.cos θ)
  have hsub := h.sub hconst
  convert hsub using 1
  ring

private theorem hasDerivAt_sin_theta_sub_two_mul
    (θ φ : ℝ) :
    HasDerivAt (fun x : ℝ => Real.sin (θ - 2 * x))
      (-2 * Real.cos (θ - 2 * φ)) φ := by
  have hinner : HasDerivAt (fun x : ℝ => θ - 2 * x) (-2) φ := by
    simpa using (hasDerivAt_const φ θ).sub ((hasDerivAt_id φ).const_mul 2)
  have h := (Real.hasDerivAt_sin (θ - 2 * φ)).comp φ hinner
  convert h using 1
  ring

/--
Analytic substep from Proposition `supportrestriction`: if the source
`secondderiv` sign bracket vanishes throughout a nonempty open angle interval,
then the parameters are in the degenerate beta-two/right-angle case. This does
not supply the source proof's preceding equilibrium-to-interval reduction.
-/
theorem twoUserSecondDerivSignBracket_eq_zero_on_Ioo_implies_degenerate
    {β θ a b : ℝ} (hβ : 0 < β) (hab : a < b)
    (hzero : ∀ φ, φ ∈ Set.Ioo a b →
      twoUserSecondDerivSignBracket β θ φ = 0) :
    β = 2 ∧ Real.cos θ = 0 := by
  let c : ℝ := (β - 2) / β
  let x : ℝ := (a + b) / 2
  have hx : x ∈ Set.Ioo a b := by
    dsimp [x]
    constructor <;> linarith
  by_cases hc : c = 0
  · have hβ_ne : β ≠ 0 := ne_of_gt hβ
    have hβ_eq : β = 2 := by
      dsimp [c] at hc
      field_simp [hβ_ne] at hc
      linarith
    refine ⟨hβ_eq, ?_⟩
    have hz := hzero x hx
    rw [hβ_eq] at hz
    simpa [twoUserSecondDerivSignBracket] using hz
  · have hsin_zero : ∀ y, y ∈ Set.Ioo a b → Real.sin (θ - 2 * y) = 0 := by
      intro y hy
      have hderiv_zero_y :=
        hasDerivAt_zero_of_eq_const_on_Ioo (c := 0) hy hzero
      have hderiv_bracket_y := hasDerivAt_twoUserSecondDerivSignBracket β θ y
      have heq : 0 = 2 * ((β - 2) / β) * Real.sin (θ - 2 * y) :=
        hderiv_zero_y.unique hderiv_bracket_y
      have hprod : c * Real.sin (θ - 2 * y) = 0 := by
        rw [show 2 * ((β - 2) / β) * Real.sin (θ - 2 * y) =
          2 * (c * Real.sin (θ - 2 * y)) by simp [c]; ring] at heq
        nlinarith
      exact (mul_eq_zero.mp hprod).resolve_left hc
    have hsin_deriv_zero :=
      hasDerivAt_zero_of_eq_const_on_Ioo (c := 0) hx hsin_zero
    have hsin_deriv := hasDerivAt_sin_theta_sub_two_mul θ x
    have hcos_zero : Real.cos (θ - 2 * x) = 0 := by
      have heq : 0 = -2 * Real.cos (θ - 2 * x) :=
        hsin_deriv_zero.unique hsin_deriv
      linarith
    have htrig := Real.sin_sq_add_cos_sq (θ - 2 * x)
    rw [hsin_zero x hx, hcos_zero] at htrig
    norm_num at htrig

/--
The source angle range converts the paper's stated nondegeneracy condition
into a concrete nonvanishing point for the `secondderiv` bracket on every
nonempty open interval. This is only the analytic final step of Proposition
`supportrestriction`, not its equilibrium or support conclusion.
-/
theorem twoUserSecondDerivSignBracket_exists_ne_zero_on_Ioo_of_source_nondegenerate
    {β θ a b : ℝ} (hβ : 0 < β) (hab : a < b)
    (hθ_nonneg : 0 ≤ θ) (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2) :
    ∃ φ, φ ∈ Set.Ioo a b ∧
      twoUserSecondDerivSignBracket β θ φ ≠ 0 := by
  by_contra h
  push Not at h
  rcases twoUserSecondDerivSignBracket_eq_zero_on_Ioo_implies_degenerate
    hβ hab h with ⟨hβ_eq, hcos_eq⟩
  rcases hnondegenerate with hβ_ne | hθ_ne
  · exact hβ_ne hβ_eq
  · have hθ_lt_half_pi : θ < Real.pi / 2 :=
      lt_of_le_of_ne hθ_le_half_pi hθ_ne
    have hcos_pos : 0 < Real.cos θ :=
      Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ_lt_half_pi⟩
    exact (ne_of_gt hcos_pos) hcos_eq

/--
For an exponent above two, the source `secondderiv` bracket is strictly
increasing on the left half of an angle interval below `pi`.  This is genuine
one-dimensional bracket geometry; it does not use a support graph or infer
the global finite-genre fiber classification claimed in the source.
-/
theorem twoUserSecondDerivSignBracket_strictMonoOn_left_of_two_lt_beta
    {β θ : ℝ} (hβ : 2 < β) (hθ_lt_pi : θ < Real.pi) :
    StrictMonoOn (fun φ => twoUserSecondDerivSignBracket β θ φ)
      (Set.Icc 0 (θ / 2)) := by
  apply strictMonoOn_of_deriv_pos (convex_Icc 0 (θ / 2))
  · intro φ _
    exact (hasDerivAt_twoUserSecondDerivSignBracket β θ φ).continuousAt.continuousWithinAt
  · intro φ hφ
    rw [interior_Icc] at hφ
    rcases hφ with ⟨hφ_pos, hφ_lt⟩
    rw [(hasDerivAt_twoUserSecondDerivSignBracket β θ φ).deriv]
    have hcoeff : 0 < (β - 2) / β := div_pos (by linarith) (by linarith)
    have harg_pos : 0 < θ - 2 * φ := by linarith
    have harg_lt_pi : θ - 2 * φ < Real.pi := by linarith
    exact mul_pos (mul_pos (by norm_num) hcoeff)
      (Real.sin_pos_of_pos_of_lt_pi harg_pos harg_lt_pi)

/--
For an exponent above two, the source `secondderiv` bracket is strictly
decreasing on the right half of an angle interval below `pi`.  Together with
the left-half theorem, this isolates the unimodal bracket fact that a genuine
fiber argument would have to use; no support-graph exclusion is supplied.
-/
theorem twoUserSecondDerivSignBracket_strictAntiOn_right_of_two_lt_beta
    {β θ : ℝ} (hβ : 2 < β) (hθ_lt_pi : θ < Real.pi) :
    StrictAntiOn (fun φ => twoUserSecondDerivSignBracket β θ φ)
      (Set.Icc (θ / 2) θ) := by
  apply strictAntiOn_of_deriv_neg (convex_Icc (θ / 2) θ)
  · intro φ _
    exact (hasDerivAt_twoUserSecondDerivSignBracket β θ φ).continuousAt.continuousWithinAt
  · intro φ hφ
    rw [interior_Icc] at hφ
    rcases hφ with ⟨hφ_gt, hφ_lt⟩
    rw [(hasDerivAt_twoUserSecondDerivSignBracket β θ φ).deriv]
    have hcoeff : 0 < (β - 2) / β := div_pos (by linarith) (by linarith)
    have harg_pos : 0 < 2 * φ - θ := by linarith
    have harg_lt_pi : 2 * φ - θ < Real.pi := by linarith
    rw [show θ - 2 * φ = -(2 * φ - θ) by ring, Real.sin_neg]
    exact mul_neg_of_pos_of_neg (mul_pos (by norm_num) hcoeff)
      (neg_neg_of_pos (Real.sin_pos_of_pos_of_lt_pi harg_pos harg_lt_pi))

theorem twoUser_secondDeriv_source_bracket_identity
    {β θ φ : ℝ} (hβ : β ≠ 0) :
    (β - 2) * Real.sin φ * Real.sin (θ - φ) - Real.cos θ =
      (β / 2) * twoUserSecondDerivSignBracket β θ φ := by
  have htrig :
      2 * Real.sin φ * Real.sin (θ - φ) =
        Real.cos (θ - 2 * φ) - Real.cos θ := by
    rw [Real.two_mul_sin_mul_sin]
    rw [show φ - (θ - φ) = -(θ - 2 * φ) by ring]
    rw [show φ + (θ - φ) = θ by ring]
    rw [Real.cos_neg]
  have hsin :
      Real.sin φ * Real.sin (θ - φ) =
        (Real.cos (θ - 2 * φ) - Real.cos θ) / 2 := by
    linarith
  rw [mul_assoc]
  rw [hsin]
  unfold twoUserSecondDerivSignBracket
  field_simp [hβ]
  ring

/-- Critical two-user phase-transition value `2 / (1 - cos θ*)`. -/
noncomputable def twoUserPhaseThreshold (θ : ℝ) : ℝ :=
  2 / (1 - Real.cos θ)

theorem twoUser_phase_inequality_iff_le_phaseThreshold
    {β θ : ℝ} (hden : 0 < 1 - Real.cos θ) :
    β * (1 - Real.cos θ) ≤ 2 ↔ β ≤ twoUserPhaseThreshold θ := by
  unfold twoUserPhaseThreshold
  exact (le_div_iff₀ hden).symm

/--
Above the source phase threshold, a positive user-angle cosine forces the
exponent to exceed two. This is the scalar bridge from the paper's phase
regime to the bracket-unimodality theorems.
-/
theorem twoUser_two_lt_beta_of_phaseThreshold_lt_beta
    {β θ : ℝ} (hden : 0 < 1 - Real.cos θ)
    (hcos : 0 < Real.cos θ) (hphase : twoUserPhaseThreshold θ < β) :
    2 < β := by
  have hthreshold : 2 < twoUserPhaseThreshold θ := by
    unfold twoUserPhaseThreshold
    rw [lt_div_iff₀ hden]
    nlinarith
  exact hthreshold.trans hphase

/--
In the source's above-threshold regime, the `secondderiv` bracket is strictly
increasing on the left angle half. The result is purely analytic and does not
turn the source's C1/C3 prose into a support-graph or fiber theorem.
-/
theorem twoUserSecondDerivSignBracket_strictMonoOn_left_of_phaseThreshold_lt_beta
    {β θ : ℝ} (hden : 0 < 1 - Real.cos θ)
    (hcos : 0 < Real.cos θ) (hphase : twoUserPhaseThreshold θ < β)
    (hθ_lt_pi : θ < Real.pi) :
    StrictMonoOn (fun φ => twoUserSecondDerivSignBracket β θ φ)
      (Set.Icc 0 (θ / 2)) :=
  twoUserSecondDerivSignBracket_strictMonoOn_left_of_two_lt_beta
    (twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcos hphase) hθ_lt_pi

/--
In the source's above-threshold regime, the `secondderiv` bracket is strictly
decreasing on the right angle half. It gives the other half of the valid
unimodal-bracket calculation, not a global simultaneous-label-fiber bound.
-/
theorem twoUserSecondDerivSignBracket_strictAntiOn_right_of_phaseThreshold_lt_beta
    {β θ : ℝ} (hden : 0 < 1 - Real.cos θ)
    (hcos : 0 < Real.cos θ) (hphase : twoUserPhaseThreshold θ < β)
    (hθ_lt_pi : θ < Real.pi) :
    StrictAntiOn (fun φ => twoUserSecondDerivSignBracket β θ φ)
      (Set.Icc (θ / 2) θ) :=
  twoUserSecondDerivSignBracket_strictAntiOn_right_of_two_lt_beta
    (twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcos hphase) hθ_lt_pi

theorem twoUser_coeff_lt_cos_of_beta_lt_phaseThreshold
    {β θ : ℝ}
    (hβ : 0 < β)
    (hden : 0 < 1 - Real.cos θ)
    (hβlt : β < twoUserPhaseThreshold θ) :
    (β - 2) / β < Real.cos θ := by
  unfold twoUserPhaseThreshold at hβlt
  have hmul := mul_lt_mul_of_pos_right hβlt hden
  have hden_ne : 1 - Real.cos θ ≠ 0 := ne_of_gt hden
  have hmul' : β * (1 - Real.cos θ) < 2 := by
    simpa [hden_ne] using hmul
  field_simp [ne_of_gt hβ]
  linarith

theorem twoUser_cos_lt_coeff_of_phaseThreshold_lt_beta
    {β θ : ℝ}
    (hβ : 0 < β)
    (hden : 0 < 1 - Real.cos θ)
    (hβgt : twoUserPhaseThreshold θ < β) :
    Real.cos θ < (β - 2) / β := by
  unfold twoUserPhaseThreshold at hβgt
  have hmul := mul_lt_mul_of_pos_right hβgt hden
  have hden_ne : 1 - Real.cos θ ≠ 0 := ne_of_gt hden
  have hmul' : 2 < β * (1 - Real.cos θ) := by
    simpa [hden_ne] using hmul
  field_simp [ne_of_gt hβ]
  linarith

theorem twoUserSecondDerivSignBracket_midpoint_pos_of_phaseThreshold_lt_beta
    {β θ : ℝ}
    (hβ : 0 < β)
    (hden : 0 < 1 - Real.cos θ)
    (hβgt : twoUserPhaseThreshold θ < β) :
    0 < twoUserSecondDerivSignBracket β θ (θ / 2) := by
  have hcoeff :=
    twoUser_cos_lt_coeff_of_phaseThreshold_lt_beta hβ hden hβgt
  unfold twoUserSecondDerivSignBracket
  have harg : θ - 2 * (θ / 2) = 0 := by ring
  rw [harg, Real.cos_zero]
  linarith

/--
At either endpoint of a positive-cosine source angle interval, the
`secondderiv` bracket is strictly negative for a positive exponent. This is
the endpoint sign needed for the explicit high-phase bracket-root analysis.
-/
theorem twoUserSecondDerivSignBracket_zero_neg_of_pos
    {β θ : ℝ} (hβ : 0 < β) (hcos : 0 < Real.cos θ) :
    twoUserSecondDerivSignBracket β θ 0 < 0 := by
  unfold twoUserSecondDerivSignBracket
  rw [show θ - 2 * 0 = θ by ring]
  field_simp [hβ.ne']
  nlinarith

/--
The symmetric right-endpoint counterpart of
`twoUserSecondDerivSignBracket_zero_neg_of_pos`.
-/
theorem twoUserSecondDerivSignBracket_theta_neg_of_pos
    {β θ : ℝ} (hβ : 0 < β) (hcos : 0 < Real.cos θ) :
    twoUserSecondDerivSignBracket β θ θ < 0 := by
  unfold twoUserSecondDerivSignBracket
  rw [show θ - 2 * θ = -θ by ring, Real.cos_neg]
  field_simp [hβ.ne']
  nlinarith

/--
Complete root geometry of the source `secondderiv` bracket in its acute,
above-threshold regime: it has exactly one root on each side of the angle
bisector. This is a theorem about the bracket alone. In particular, it does
not classify simultaneous fibers of the two finite-genre FOC labels or supply
the support graph required by the source's `regionscolor` invocation.
-/
theorem twoUserSecondDerivSignBracket_existsUnique_zero_on_each_half_of_phaseThreshold_lt_beta
    {β θ : ℝ} (hθ_pos : 0 < θ) (hθ_lt_pi : θ < Real.pi)
    (hden : 0 < 1 - Real.cos θ) (hcos : 0 < Real.cos θ)
    (hphase : twoUserPhaseThreshold θ < β) :
    (∃! φ, φ ∈ Set.Ioo 0 (θ / 2) ∧
      twoUserSecondDerivSignBracket β θ φ = 0) ∧
    (∃! φ, φ ∈ Set.Ioo (θ / 2) θ ∧
      twoUserSecondDerivSignBracket β θ φ = 0) := by
  have hβ_two : 2 < β :=
    twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcos hphase
  have hβ : 0 < β := by linarith
  have hleft_end : twoUserSecondDerivSignBracket β θ 0 < 0 :=
    twoUserSecondDerivSignBracket_zero_neg_of_pos hβ hcos
  have hright_end : twoUserSecondDerivSignBracket β θ θ < 0 :=
    twoUserSecondDerivSignBracket_theta_neg_of_pos hβ hcos
  have hmid : 0 < twoUserSecondDerivSignBracket β θ (θ / 2) :=
    twoUserSecondDerivSignBracket_midpoint_pos_of_phaseThreshold_lt_beta
      hβ hden hphase
  have hcont : Continuous (fun φ => twoUserSecondDerivSignBracket β θ φ) := by
    unfold twoUserSecondDerivSignBracket
    fun_prop
  constructor
  · have hzero_mem : (0 : ℝ) ∈ Set.Icc
        (twoUserSecondDerivSignBracket β θ 0)
        (twoUserSecondDerivSignBracket β θ (θ / 2)) :=
      ⟨hleft_end.le, hmid.le⟩
    rcases intermediate_value_Icc (show 0 ≤ θ / 2 by linarith)
      hcont.continuousOn hzero_mem with ⟨φ, hφ_mem, hφ_zero⟩
    have hφ_pos : 0 < φ := by
      apply lt_of_le_of_ne hφ_mem.1
      intro h
      subst φ
      linarith
    have hφ_lt : φ < θ / 2 := by
      apply lt_of_le_of_ne hφ_mem.2
      intro h
      subst φ
      linarith
    refine ⟨φ, ⟨⟨hφ_pos, hφ_lt⟩, hφ_zero⟩, ?_⟩
    intro ψ hψ
    have heq :=
      (twoUserSecondDerivSignBracket_strictMonoOn_left_of_phaseThreshold_lt_beta
        hden hcos hphase hθ_lt_pi).injOn hφ_mem
          ⟨hψ.1.1.le, hψ.1.2.le⟩ (hφ_zero.trans hψ.2.symm)
    exact heq.symm
  · have hzero_mem : (0 : ℝ) ∈ Set.Icc
        (twoUserSecondDerivSignBracket β θ θ)
        (twoUserSecondDerivSignBracket β θ (θ / 2)) :=
      ⟨hright_end.le, hmid.le⟩
    rcases intermediate_value_Icc' (show θ / 2 ≤ θ by linarith)
      hcont.continuousOn hzero_mem with ⟨φ, hφ_mem, hφ_zero⟩
    have hφ_gt : θ / 2 < φ := by
      apply lt_of_le_of_ne hφ_mem.1
      intro h
      subst φ
      linarith
    have hφ_lt : φ < θ := by
      apply lt_of_le_of_ne hφ_mem.2
      intro h
      subst φ
      linarith
    refine ⟨φ, ⟨⟨hφ_gt, hφ_lt⟩, hφ_zero⟩, ?_⟩
    intro ψ hψ
    have heq :=
      (twoUserSecondDerivSignBracket_strictAntiOn_right_of_phaseThreshold_lt_beta
        hden hcos hphase hθ_lt_pi).injOn hφ_mem
          ⟨hψ.1.1.le, hψ.1.2.le⟩ (hφ_zero.trans hψ.2.symm)
    exact heq.symm

/--
Phase-transition sign algebra used in Proposition `uniqueness`: below
`β* = 2/(1 - cos θ*)`, the `secondderiv` bracket is nonpositive throughout the
source angle range.  The angle-range facts are kept explicit so the theorem can
be reused with either analytic trigonometric bounds or paper-local support
geometry.
-/
theorem twoUserSecondDerivSignBracket_nonpos_of_beta_lt_phaseThreshold_and_cos_range
    {β θ φ : ℝ}
    (hβ : 0 < β)
    (hden : 0 < 1 - Real.cos θ)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hcosθ_nonneg : 0 ≤ Real.cos θ)
    (hcos_lower : Real.cos θ ≤ Real.cos (θ - 2 * φ))
    (hcos_upper : Real.cos (θ - 2 * φ) ≤ 1) :
    twoUserSecondDerivSignBracket β θ φ ≤ 0 := by
  have hcoeff_lt :=
    twoUser_coeff_lt_cos_of_beta_lt_phaseThreshold hβ hden hβlt
  set coeff : ℝ := (β - 2) / β
  set carg : ℝ := Real.cos (θ - 2 * φ)
  have hcoeff_lt' : coeff < Real.cos θ := by
    simpa [coeff] using hcoeff_lt
  unfold twoUserSecondDerivSignBracket
  change coeff * carg - Real.cos θ ≤ 0
  by_cases hcoeff_nonneg : 0 ≤ coeff
  · have hmul_le : coeff * carg ≤ coeff * 1 :=
      mul_le_mul_of_nonneg_left (by simpa [carg] using hcos_upper) hcoeff_nonneg
    have hmul_lt : coeff * carg < Real.cos θ :=
      lt_of_le_of_lt (by simpa using hmul_le) (by simpa using hcoeff_lt')
    linarith
  · have hcoeff_nonpos : coeff ≤ 0 := le_of_not_ge hcoeff_nonneg
    have hcarg_nonneg : 0 ≤ carg :=
      le_trans hcosθ_nonneg (by simpa [carg] using hcos_lower)
    have hmul_nonpos : coeff * carg ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg hcoeff_nonpos hcarg_nonneg
    linarith

theorem twoUserSecondDerivSignBracket_neg_of_beta_lt_phaseThreshold_and_cos_range
    {β θ φ : ℝ}
    (hβ : 0 < β)
    (hden : 0 < 1 - Real.cos θ)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hcosθ_pos : 0 < Real.cos θ)
    (hcos_lower : Real.cos θ ≤ Real.cos (θ - 2 * φ))
    (hcos_upper : Real.cos (θ - 2 * φ) ≤ 1) :
    twoUserSecondDerivSignBracket β θ φ < 0 := by
  have hcoeff_lt :=
    twoUser_coeff_lt_cos_of_beta_lt_phaseThreshold hβ hden hβlt
  set coeff : ℝ := (β - 2) / β
  set carg : ℝ := Real.cos (θ - 2 * φ)
  have hcoeff_lt' : coeff < Real.cos θ := by
    simpa [coeff] using hcoeff_lt
  unfold twoUserSecondDerivSignBracket
  change coeff * carg - Real.cos θ < 0
  by_cases hcoeff_nonneg : 0 ≤ coeff
  · have hmul_le : coeff * carg ≤ coeff * 1 :=
      mul_le_mul_of_nonneg_left (by simpa [carg] using hcos_upper) hcoeff_nonneg
    have hmul_lt : coeff * carg < Real.cos θ :=
      lt_of_le_of_lt (by simpa using hmul_le) (by simpa using hcoeff_lt')
    linarith
  · have hcoeff_neg : coeff < 0 := lt_of_not_ge hcoeff_nonneg
    have hcarg_pos : 0 < carg :=
      lt_of_lt_of_le hcosθ_pos (by simpa [carg] using hcos_lower)
    have hmul_neg : coeff * carg < 0 :=
      mul_neg_of_neg_of_pos hcoeff_neg hcarg_pos
    linarith

theorem twoUser_cos_range_of_angle_mem_Icc
    {θ φ : ℝ}
    (hθ_le_pi : θ ≤ Real.pi)
    (hφ_nonneg : 0 ≤ φ)
    (hφ_leθ : φ ≤ θ) :
    Real.cos θ ≤ Real.cos (θ - 2 * φ) ∧
      Real.cos (θ - 2 * φ) ≤ 1 := by
  constructor
  · have habs_le : |θ - 2 * φ| ≤ θ := by
      rw [abs_le]
      constructor <;> linarith
    have hcos :=
      Real.cos_le_cos_of_nonneg_of_le_pi
        (x := |θ - 2 * φ|) (y := θ)
        (abs_nonneg _) hθ_le_pi habs_le
    simpa [Real.cos_abs] using hcos
  · exact Real.cos_le_one _

theorem twoUserSecondDerivSignBracket_nonpos_of_beta_lt_phaseThreshold_and_angle_mem_Icc
    {β θ φ : ℝ}
    (hβ : 0 < β)
    (hden : 0 < 1 - Real.cos θ)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hθ_nonneg : 0 ≤ θ)
    (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hφ_nonneg : 0 ≤ φ)
    (hφ_leθ : φ ≤ θ) :
    twoUserSecondDerivSignBracket β θ φ ≤ 0 := by
  have hθ_le_pi : θ ≤ Real.pi := by
    linarith [Real.pi_pos]
  have hcosθ_nonneg : 0 ≤ Real.cos θ :=
    Real.cos_nonneg_of_neg_pi_div_two_le_of_le
      (by linarith [Real.pi_pos]) hθ_le_half_pi
  rcases twoUser_cos_range_of_angle_mem_Icc hθ_le_pi hφ_nonneg hφ_leθ with
    ⟨hcos_lower, hcos_upper⟩
  exact
    twoUserSecondDerivSignBracket_nonpos_of_beta_lt_phaseThreshold_and_cos_range
      hβ hden hβlt hcosθ_nonneg hcos_lower hcos_upper

theorem twoUserSecondDerivSignBracket_neg_of_beta_lt_phaseThreshold_and_angle_mem_Icc_lt_half_pi
    {β θ φ : ℝ}
    (hβ : 0 < β)
    (hden : 0 < 1 - Real.cos θ)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hθ_nonneg : 0 ≤ θ)
    (hθ_lt_half_pi : θ < Real.pi / 2)
    (hφ_nonneg : 0 ≤ φ)
    (hφ_leθ : φ ≤ θ) :
    twoUserSecondDerivSignBracket β θ φ < 0 := by
  have hθ_le_pi : θ ≤ Real.pi := by
    linarith [Real.pi_pos]
  have hcosθ_pos : 0 < Real.cos θ :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ_lt_half_pi⟩
  rcases twoUser_cos_range_of_angle_mem_Icc hθ_le_pi hφ_nonneg hφ_leθ with
    ⟨hcos_lower, hcos_upper⟩
  exact
    twoUserSecondDerivSignBracket_neg_of_beta_lt_phaseThreshold_and_cos_range
      hβ hden hβlt hcosθ_pos hcos_lower hcos_upper

/--
Algebraic normalization of the graph differential equation used in the
printed proof of Proposition `uniqueness`. If `g(w) = w f` and its graph slope
has the product-rule form `g' = f + w f'`, then the source equation rewrites
exactly as `w f' (f - cos θ) = 1 - f²`. This records the valid algebraic
content before any global ODE/uniqueness claim is made.
-/
theorem twoUser_normalizedGraphOde_iff
    {θ w f f' g g' : ℝ} (hw : w ≠ 0)
    (hg : g = w * f) (hg' : g' = f + w * f') :
    g' * g - g' * w * Real.cos θ = w - g * Real.cos θ ↔
      w * f' * (f - Real.cos θ) = 1 - f ^ 2 := by
  constructor
  · intro h
    have hmul :
        w * (w * f' * (f - Real.cos θ) - (1 - f ^ 2)) = 0 := by
      calc
        w * (w * f' * (f - Real.cos θ) - (1 - f ^ 2)) =
            g' * g - g' * w * Real.cos θ - (w - g * Real.cos θ) := by
              rw [hg, hg']
              ring
        _ = 0 := by linarith
    have hzero : w * f' * (f - Real.cos θ) - (1 - f ^ 2) = 0 :=
      (mul_eq_zero.mp hmul).resolve_left hw
    linarith
  · intro h
    have hdiff :
        g' * g - g' * w * Real.cos θ - (w - g * Real.cos θ) = 0 := by
      calc
        g' * g - g' * w * Real.cos θ - (w - g * Real.cos θ) =
            w * (w * f' * (f - Real.cos θ) - (1 - f ^ 2)) := by
              rw [hg, hg']
              ring
        _ = 0 := by rw [h]; ring
    linarith

/-- The order-theoretic closure of the source's inverse-graph argument.
If a graph and a left inverse both lie weakly below the diagonal on their
respective domains, then the graph is the diagonal on its domain.  This is
the valid final implication that the phase-transition proof would use after
separately proving the two one-sided estimates. -/
theorem eq_idOn_of_leftInverse_of_mapsTo_of_le_self_of_inverse_le_self
    {I₁ I₂ : Set ℝ} {g gInv : ℝ → ℝ}
    (hmap : Set.MapsTo g I₁ I₂)
    (hleft : Set.EqOn (gInv ∘ g) id I₁)
    (hbelow : ∀ w ∈ I₁, g w ≤ w)
    (hinv_below : ∀ z ∈ I₂, gInv z ≤ z) :
    Set.EqOn g id I₁ := by
  intro w hw
  apply le_antisymm (hbelow w hw)
  have hInv : gInv (g w) ≤ g w := hinv_below (g w) (hmap hw)
  calc
    w = gInv (g w) := by simpa only [Function.comp_apply, id_eq] using (hleft hw).symm
    _ ≤ g w := hInv

/--
Corrected local Step-2 graph-ODE bridge.  A local CDF-composition identity
gives the required density transport by the chain rule.  If the two displayed
first-order expressions have a common nonzero scale, that transport yields
the source graph differential equation.  The CDF composition and derivative
premises are explicit; this does not infer them from C2 or equilibrium.
-/
theorem twoUser_graphOde_of_eventuallyEq_cdfComposition_and_firstPartialForms
    {H1 H2 g : ℝ → ℝ} {w h1 h2 g' scale θ : ℝ}
    (hH1 : HasDerivAt H1 h1 w)
    (hH2 : HasDerivAt H2 h2 (g w))
    (hg : HasDerivAt g g' w)
    (htransport : H1 =ᶠ[𝓝 w] fun x => H2 (g x))
    (hscale : scale ≠ 0)
    (hfirst1 : h1 = scale * (w - g w * Real.cos θ))
    (hfirst2 : h2 = scale * (g w - w * Real.cos θ)) :
    g' * g w - g' * w * Real.cos θ = w - g w * Real.cos θ := by
  have hdensity : h1 = h2 * g' :=
    AppliedModelingLib.RealAnalysis.hasDerivAt_eq_mul_of_eventuallyEq_comp
      hH1 hH2 hg htransport
  have hscaled :
      scale * (w - g w * Real.cos θ) =
        scale * ((g w - w * Real.cos θ) * g') := by
    calc
      scale * (w - g w * Real.cos θ) = h1 := hfirst1.symm
      _ = h2 * g' := hdensity
      _ = (scale * (g w - w * Real.cos θ)) * g' := by rw [hfirst2]
      _ = scale * ((g w - w * Real.cos θ) * g') := by ring
  have hratio :
      w - g w * Real.cos θ = (g w - w * Real.cos θ) * g' :=
    mul_left_cancel₀ hscale hscaled
  calc
    g' * g w - g' * w * Real.cos θ =
        (g w - w * Real.cos θ) * g' := by ring
    _ = w - g w * Real.cos θ := hratio.symm

/--
Away from the origin, the common scalar multiplying the two induced-cost
first partials is nonzero under the source's positive cost parameters.  This
is the cancellation fact required by the C1/C2 graph-ODE bridge.
-/
theorem twoUserInducedCostFirstPartial_scale_ne_zero_of_pair_ne_zero
    {α β θ z1 z2 : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hpair : z1 ≠ 0 ∨ z2 ≠ 0) :
    β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) ≠ 0 := by
  have hnum_nonneg : 0 ≤ twoUserInducedCostNumerator θ z1 z2 :=
    twoUserInducedCostNumerator_nonneg θ z1 z2
  have hnum_ne : twoUserInducedCostNumerator θ z1 z2 ≠ 0 :=
    twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne' hpair
  have hnum_pos : 0 < twoUserInducedCostNumerator θ z1 z2 :=
    lt_of_le_of_ne hnum_nonneg (Ne.symm hnum_ne)
  have hsinpow : 0 < (Real.sin θ) ^ (-β) :=
    Real.rpow_pos_of_pos hsin _
  have hnumpow : 0 < (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) :=
    Real.rpow_pos_of_pos hnum_pos _
  exact (mul_pos (mul_pos (mul_pos hβ hα) hsinpow) hnumpow).ne'

/--
Corrected local first integral for the normalized graph ODE.  On the domain
`w > 0` and `-1 < f(w) < 1`, the logarithmic expression below has zero
derivative whenever `w f' (f - cos(theta)) = 1 - f^2`.  This is the valid
separation calculation underlying Step 3 of the source proof; it is not a
global solution or a uniqueness theorem.
-/
theorem twoUser_hasDerivAt_normalizedGraphFirstIntegral_zero
    {θ w f' : ℝ} {f : ℝ → ℝ}
    (hw : 0 < w)
    (hf_lower : -1 < f w)
    (hf_upper : f w < 1)
    (hderiv : HasDerivAt f f' w)
    (hode : w * f' * (f w - Real.cos θ) = 1 - f w ^ 2) :
    HasDerivAt
      (fun x =>
        -((1 : ℝ) / 2) * Real.log (1 - f x * f x) -
          (Real.cos θ / 2) * (Real.log (1 + f x) - Real.log (1 - f x)) -
            Real.log x)
      0 w := by
  have hp_pos : 0 < 1 + f w := by linarith
  have hm_pos : 0 < 1 - f w := by linarith
  have hq_pos : 0 < 1 - f w * f w := by
    nlinarith [mul_pos hm_pos hp_pos]
  have hq : HasDerivAt (fun x => 1 - f x * f x)
      (-(f' * f w + f w * f')) w := by
    convert (hasDerivAt_const w (1 : ℝ)).sub (hderiv.mul hderiv) using 1 <;> ring
  have hp : HasDerivAt (fun x => 1 + f x) f' w := by
    convert (hasDerivAt_const w (1 : ℝ)).add hderiv using 1 <;> ring
  have hm : HasDerivAt (fun x => 1 - f x) (-f') w := by
    convert (hasDerivAt_const w (1 : ℝ)).sub hderiv using 1 <;> ring
  have hlogq := hq.log hq_pos.ne'
  have hlogp := hp.log hp_pos.ne'
  have hlogm := hm.log hm_pos.ne'
  have hlogw := Real.hasDerivAt_log hw.ne'
  have hraw :=
    ((hlogq.const_mul (-((1 : ℝ) / 2))).sub
      ((hlogp.sub hlogm).const_mul (Real.cos θ / 2))).sub hlogw
  have hderiv_zero :
      (-((1 : ℝ) / 2)) * (-(f' * f w + f w * f') / (1 - f w * f w)) -
          (Real.cos θ / 2) *
            (f' / (1 + f w) - (-f') / (1 - f w)) - w⁻¹ = 0 := by
    have hq_sq_ne : 1 - f w ^ 2 ≠ 0 := by
      convert hq_pos.ne' using 1 <;> ring
    have hode' :
        w * f' * (f w - Real.cos θ) = 1 - f w * f w := by
      convert hode using 1 <;> ring
    field_simp [hw.ne', hp_pos.ne', hm_pos.ne', hq_pos.ne', hq_sq_ne]
    ring_nf at hode' ⊢
    nlinarith [hode']
  simpa using hraw.congr_deriv hderiv_zero

/--
Corrected global uniqueness theorem for the two-user graph ODE with the
missing origin boundary condition.  Write `h(w) = g(w)^2 - w^2`.  The graph
ODE implies `(g(w) - c*w) h'(w) = -2*c*h(w)`.  On the strict feasible cone and
for nonnegative `c`, this makes `h^2` nonincreasing.  Since continuity and the
origin boundary give `h(0)=0`, it follows that `h=0` throughout the interval,
and nonnegative feasibility selects `g(w)=w` rather than the negative square
root.  This is a conditional analytic repair: deriving its global graph,
strict-cone, pointwise ODE, and origin premises from C1--C3 remains separate.
-/
theorem twoUser_graph_eq_idOn_of_origin_of_strictCone_ode
    {B c : ℝ} {g g' : ℝ → ℝ}
    (hc : 0 ≤ c) (hzero : g 0 = 0)
    (hcont : ContinuousOn g (Set.Icc 0 B))
    (hnonneg : ∀ w ∈ Set.Icc 0 B, 0 ≤ g w)
    (hcone : ∀ w ∈ Set.Ioo 0 B, w * c < g w)
    (hderiv : ∀ w ∈ Set.Ioo 0 B, HasDerivAt g (g' w) w)
    (hode : ∀ w ∈ Set.Ioo 0 B,
      g' w * g w - g' w * w * c = w - g w * c) :
    ∀ w ∈ Set.Icc 0 B, g w = w := by
  let h : ℝ → ℝ := fun w => g w ^ 2 - w ^ 2
  have hcont_h : ContinuousOn h (Set.Icc 0 B) := by
    dsimp [h]
    exact (hcont.pow 2).sub (continuous_id.continuousOn.pow 2)
  have hzero_h : h 0 = 0 := by
    dsimp [h]
    rw [hzero]
    norm_num
  have hsq_deriv_nonpos : ∀ x ∈ Set.Ioo 0 B,
      HasDerivAt (fun w => h w ^ 2) (deriv (fun w => h w ^ 2) x) x ∧
        deriv (fun w => h w ^ 2) x ≤ 0 := by
    intro x hx
    let dh : ℝ :=
      (g' x * g x + g x * g' x) - ((1 : ℝ) * x + x * (1 : ℝ))
    have hhderiv : HasDerivAt h dh x := by
      simpa [h, dh, pow_two] using
        ((hderiv x hx).mul (hderiv x hx)).sub
          ((hasDerivAt_id x).mul (hasDerivAt_id x))
    have hrel : (g x - x * c) * dh = -2 * c * h x := by
      calc
        (g x - x * c) * dh =
            -2 * c * h x + 2 * g x *
              (g' x * g x - g' x * x * c - (x - g x * c)) := by
              dsimp [h, dh]
              ring
        _ = -2 * c * h x := by rw [hode x hx]; ring
    have hprod : (g x - x * c) * (dh * h x) = -2 * c * h x ^ 2 := by
      calc
        (g x - x * c) * (dh * h x) = ((g x - x * c) * dh) * h x := by ring
        _ = (-2 * c * h x) * h x := by rw [hrel]
        _ = -2 * c * h x ^ 2 := by ring
    have hdh_nonpos : dh * h x ≤ 0 := by
      by_contra hnot
      have hdh_pos : 0 < dh * h x := lt_of_not_ge hnot
      have hden_pos : 0 < g x - x * c := by linarith [hcone x hx]
      have hleft_pos : 0 < (g x - x * c) * (dh * h x) :=
        mul_pos hden_pos hdh_pos
      have hright_nonpos : -2 * c * h x ^ 2 ≤ 0 := by
        exact mul_nonpos_of_nonpos_of_nonneg (by linarith) (sq_nonneg _)
      rw [hprod] at hleft_pos
      linarith
    have hsq_deriv : HasDerivAt (fun w => h w ^ 2)
        (dh * h x + h x * dh) x := by
      convert hhderiv.mul hhderiv using 1
      ext w
      simp [pow_two]
    have hsq_nonpos : dh * h x + h x * dh ≤ 0 := by
      nlinarith
    constructor
    · simpa only [hsq_deriv.deriv] using hsq_deriv
    · simpa only [hsq_deriv.deriv] using hsq_nonpos
  intro w hw
  have hdecrease : h w ^ 2 ≤ h 0 ^ 2 := by
    apply endpoint_path_ge_of_hasDerivAt_nonpos_on_Icc hw.1
    · exact (hcont_h.pow 2).mono (Set.Icc_subset_Icc_right hw.2)
    · intro x hx
      exact (hsq_deriv_nonpos x ⟨hx.1, hx.2.trans_le hw.2⟩).1
    · intro x hx
      exact (hsq_deriv_nonpos x ⟨hx.1, hx.2.trans_le hw.2⟩).2
  have hsq_nonpos : h w ^ 2 ≤ 0 := by simpa [hzero_h] using hdecrease
  have hw_h : h w = 0 := by nlinarith [sq_nonneg (h w)]
  have hsq : g w ^ 2 = w ^ 2 := by
    dsimp [h] at hw_h
    linarith
  rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsq with hgw | hgw
  · exact hgw
  · have hw_nonneg : 0 ≤ w := hw.1
    linarith [hnonneg w hw]

/--
The graph ODE alone has non-diagonal local solutions at the orthogonal angle.
For every `w > 1`, the graph `sqrt(w^2 - 1)` satisfies the displayed graph
ODE at `theta = pi / 2` but is not equal to the diagonal.  Thus a global
uniqueness conclusion requires additional domain or boundary conditions.
-/
theorem twoUser_orthogonal_sqrtGraph_satisfies_graphOde_nonDiagonal
    {w : ℝ} (hw : 1 < w) :
    let g : ℝ := Real.sqrt (w ^ 2 - 1)
    HasDerivAt (fun x => Real.sqrt (x ^ 2 - 1)) (w / g) w ∧
      (w / g) * g - (w / g) * w * Real.cos (Real.pi / 2) =
        w - g * Real.cos (Real.pi / 2) ∧ g ≠ w := by
  dsimp
  have harg_pos : 0 < w ^ 2 - 1 := by nlinarith
  have hsqrt_pos : 0 < Real.sqrt (w ^ 2 - 1) := Real.sqrt_pos.2 harg_pos
  have hcos : Real.cos (Real.pi / 2) = 0 := Real.cos_pi_div_two
  have hquad : HasDerivAt (fun x : ℝ => x ^ 2 - 1) (2 * w) w := by
    convert ((hasDerivAt_id w).pow 2).sub (hasDerivAt_const w (1 : ℝ)) using 1 <;> simp
  have hsqrt := (Real.hasDerivAt_sqrt harg_pos.ne').comp w hquad
  have hderiv : HasDerivAt (fun x : ℝ => Real.sqrt (x ^ 2 - 1))
      (w / Real.sqrt (w ^ 2 - 1)) w := by
    convert hsqrt using 1 <;> field_simp [hsqrt_pos.ne']
  constructor
  · exact hderiv
  · constructor
    · rw [hcos]
      field_simp [hsqrt_pos.ne']
      ring
    · intro hdiag
      have hsq := congrArg (fun x : ℝ => x ^ 2) hdiag
      have hsq' : Real.sqrt (w ^ 2 - 1) ^ 2 = w ^ 2 := by
        simpa using hsq
      rw [Real.sq_sqrt harg_pos.le] at hsq'
      nlinarith [hsq']

theorem twoUserParam_z2_sub_z1_cos
    (θ φ r : ℝ) :
    r * Real.cos (θ - φ) - (r * Real.cos φ) * Real.cos θ =
      r * Real.sin θ * Real.sin φ := by
  rw [Real.cos_sub]
  ring

theorem twoUserParam_z1_sub_z2_cos
    (θ φ r : ℝ) :
    r * Real.cos φ - (r * Real.cos (θ - φ)) * Real.cos θ =
      r * Real.sin θ * Real.sin (θ - φ) := by
  have hsin_sq : 1 - Real.cos θ ^ 2 = Real.sin θ ^ 2 := by
    nlinarith [Real.sin_sq_add_cos_sq θ]
  rw [Real.cos_sub, Real.sin_sub]
  calc
    r * Real.cos φ - r *
        (Real.cos θ * Real.cos φ + Real.sin θ * Real.sin φ) * Real.cos θ
        = r * Real.cos φ * (1 - Real.cos θ ^ 2) -
            r * Real.cos θ * Real.sin θ * Real.sin φ := by ring
    _ = r * Real.cos φ * Real.sin θ ^ 2 -
            r * Real.cos θ * Real.sin θ * Real.sin φ := by rw [hsin_sq]
    _ = r * Real.sin θ *
          (Real.sin θ * Real.cos φ - Real.cos θ * Real.sin φ) := by ring

/-- Every nonzero realized-value pair has the source's polar parametrization
when the two canonical user coordinates are linearly independent.  Here the
underlying content coordinates are recovered through the inverse matrix and
Mathlib's complex argument supplies the polar angle. -/
theorem exists_twoUserParam_of_sin_ne_zero
    {θ x y : ℝ}
    (hsin : Real.sin θ ≠ 0)
    (hxy : (x, y) ≠ (0, 0)) :
    ∃ r φ : ℝ, 0 < r ∧
      x = r * Real.cos φ ∧ y = r * Real.cos (θ - φ) := by
  let z : ℂ := (x : ℂ) +
    (((y - x * Real.cos θ) / Real.sin θ : ℝ) : ℂ) * Complex.I
  have hzre : z.re = x := by
    dsimp [z]
    simp only [Complex.ofReal_re, Complex.mul_re,
      Complex.I_re, Complex.I_im, Complex.ofReal_im, mul_zero, zero_mul,
      sub_zero, add_zero]
  have hzim : z.im = (y - x * Real.cos θ) / Real.sin θ := by
    dsimp [z]
    simp only [Complex.ofReal_im, zero_add, Complex.mul_im,
      Complex.ofReal_re, Complex.I_im, Complex.I_re, mul_one, zero_mul,
      add_zero]
  have hz : z ≠ 0 := by
    intro hz
    have hx : x = 0 := by
      have hre := congrArg Complex.re hz
      rw [hzre] at hre
      simpa using hre
    have him : (y - x * Real.cos θ) / Real.sin θ = 0 := by
      have him := congrArg Complex.im hz
      rw [hzim] at him
      simpa using him
    have hnum : y - x * Real.cos θ = 0 := by
      rcases (div_eq_zero_iff.mp him) with hnum | hden
      · exact hnum
      · exact (hsin hden).elim
    have hy : y = 0 := by
      rw [hx] at hnum
      simpa using hnum
    exact hxy (Prod.ext hx hy)
  have hr : 0 < ‖z‖ := norm_pos_iff.mpr hz
  have hcos : ‖z‖ * Real.cos (Complex.arg z) = x := by
    calc
      ‖z‖ * Real.cos (Complex.arg z) = ‖z‖ * (z.re / ‖z‖) := by
        rw [Complex.cos_arg hz]
      _ = z.re := by field_simp [ne_of_gt hr]
      _ = x := hzre
  have hsin' : ‖z‖ * Real.sin (Complex.arg z) =
      (y - x * Real.cos θ) / Real.sin θ := by
    calc
      ‖z‖ * Real.sin (Complex.arg z) = ‖z‖ * (z.im / ‖z‖) := by
        rw [Complex.sin_arg]
      _ = z.im := by field_simp [ne_of_gt hr]
      _ = (y - x * Real.cos θ) / Real.sin θ := hzim
  refine ⟨‖z‖, Complex.arg z, hr, hcos.symm, ?_⟩
  calc
    y = x * Real.cos θ +
        ((y - x * Real.cos θ) / Real.sin θ) * Real.sin θ := by
      field_simp [hsin]
      ring
    _ = (‖z‖ * Real.cos (Complex.arg z)) * Real.cos θ +
        (‖z‖ * Real.sin (Complex.arg z)) * Real.sin θ := by rw [hcos, hsin']
    _ = ‖z‖ * (Real.cos θ * Real.cos (Complex.arg z) +
        Real.sin θ * Real.sin (Complex.arg z)) := by ring
    _ = ‖z‖ * Real.cos (θ - Complex.arg z) := by
      rw [Real.cos_sub]

/--
For nonnegative two-user scores, the polar witness can be chosen in the
canonical positive-score wedge.  This removes the artificial all-real-angle
maximum premise from the infinite-genre verification: only angles that can
actually arise from a nonnegative score pair need be compared.
-/
theorem exists_twoUserParam_of_sin_ne_zero_of_nonnegative
    {θ x y : ℝ} (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hsin : Real.sin θ ≠ 0)
    (hxy : (x, y) ≠ (0, 0)) (hx : 0 ≤ x) (hy : 0 ≤ y) :
    ∃ r φ : ℝ, 0 < r ∧
      x = r * Real.cos φ ∧ y = r * Real.cos (θ - φ) ∧
      θ - Real.pi / 2 ≤ φ ∧ φ ≤ Real.pi / 2 := by
  let z : ℂ := (x : ℂ) +
    (((y - x * Real.cos θ) / Real.sin θ : ℝ) : ℂ) * Complex.I
  have hzre : z.re = x := by
    dsimp [z]
    simp only [Complex.ofReal_re, Complex.mul_re,
      Complex.I_re, Complex.I_im, Complex.ofReal_im, mul_zero, zero_mul,
      sub_zero, add_zero]
  have hzim : z.im = (y - x * Real.cos θ) / Real.sin θ := by
    dsimp [z]
    simp only [Complex.ofReal_im, zero_add, Complex.mul_im,
      Complex.ofReal_re, Complex.I_im, Complex.I_re, mul_one, zero_mul,
      add_zero]
  have hz : z ≠ 0 := by
    intro hz
    have hx_zero : x = 0 := by
      have hre := congrArg Complex.re hz
      rw [hzre] at hre
      simpa using hre
    have him : (y - x * Real.cos θ) / Real.sin θ = 0 := by
      have him := congrArg Complex.im hz
      rw [hzim] at him
      simpa using him
    have hnum : y - x * Real.cos θ = 0 := by
      rcases (div_eq_zero_iff.mp him) with hnum | hden
      · exact hnum
      · exact (hsin hden).elim
    have hy_zero : y = 0 := by
      rw [hx_zero] at hnum
      simpa using hnum
    exact hxy (Prod.ext hx_zero hy_zero)
  have hr : 0 < ‖z‖ := norm_pos_iff.mpr hz
  have hcos : ‖z‖ * Real.cos (Complex.arg z) = x := by
    calc
      ‖z‖ * Real.cos (Complex.arg z) = ‖z‖ * (z.re / ‖z‖) := by
        rw [Complex.cos_arg hz]
      _ = z.re := by field_simp [ne_of_gt hr]
      _ = x := hzre
  have hsin' : ‖z‖ * Real.sin (Complex.arg z) =
      (y - x * Real.cos θ) / Real.sin θ := by
    calc
      ‖z‖ * Real.sin (Complex.arg z) = ‖z‖ * (z.im / ‖z‖) := by
        rw [Complex.sin_arg]
      _ = z.im := by field_simp [ne_of_gt hr]
      _ = (y - x * Real.cos θ) / Real.sin θ := hzim
  have hy_param : y = ‖z‖ * Real.cos (θ - Complex.arg z) := by
    calc
      y = x * Real.cos θ +
          ((y - x * Real.cos θ) / Real.sin θ) * Real.sin θ := by
        field_simp [hsin]
        ring
      _ = (‖z‖ * Real.cos (Complex.arg z)) * Real.cos θ +
          (‖z‖ * Real.sin (Complex.arg z)) * Real.sin θ := by rw [hcos, hsin']
      _ = ‖z‖ * (Real.cos θ * Real.cos (Complex.arg z) +
          Real.sin θ * Real.sin (Complex.arg z)) := by ring
      _ = ‖z‖ * Real.cos (θ - Complex.arg z) := by
        rw [Real.cos_sub]
  have harg_abs : |Complex.arg z| ≤ Real.pi / 2 := by
    rw [Complex.abs_arg_le_pi_div_two_iff]
    simpa [hzre] using hx
  have harg_lower : -(Real.pi / 2) ≤ Complex.arg z := (abs_le.mp harg_abs).1
  have harg_upper : Complex.arg z ≤ Real.pi / 2 := (abs_le.mp harg_abs).2
  have harg_lower' : θ - Real.pi / 2 ≤ Complex.arg z := by
    by_contra hnot
    have hlt : Complex.arg z < θ - Real.pi / 2 := lt_of_not_ge hnot
    have ht_gt : Real.pi / 2 < θ - Complex.arg z := by linarith
    have ht_lt : θ - Complex.arg z < Real.pi + Real.pi / 2 := by
      linarith [Real.pi_pos]
    have hcos_neg : Real.cos (θ - Complex.arg z) < 0 :=
      Real.cos_neg_of_pi_div_two_lt_of_lt ht_gt ht_lt
    have hy_neg : y < 0 := by
      rw [hy_param]
      exact mul_neg_of_pos_of_neg hr hcos_neg
    exact (not_lt_of_ge hy) hy_neg
  exact ⟨‖z‖, Complex.arg z, hr, hcos.symm, hy_param, harg_lower', harg_upper⟩

/-- A nonempty open subset of the two-user value plane contains a nonzero
point.  This elementary bridge lets the source's polar parametrization avoid
the singular radius-zero point. -/
theorem exists_nonzero_mem_of_isOpen_of_nonempty
    {S : Set (ℝ × ℝ)}
    (hopen : IsOpen S) (hS : S.Nonempty) :
    ∃ z : ℝ × ℝ, z ∈ S ∧ z ≠ (0, 0) := by
  obtain ⟨z, hz⟩ := hS
  by_cases hz_zero : z = (0, 0)
  · obtain ⟨ε, hε_pos, hball⟩ :=
      Metric.mem_nhds_iff.mp (hopen.mem_nhds hz)
    have hhalf_pos : 0 < ε / 2 := by linarith
    refine ⟨(ε / 2, 0), hball ?_, ?_⟩
    · rw [Metric.mem_ball, hz_zero, Prod.dist_eq]
      change max (dist (ε / 2 : ℝ) 0) (dist (0 : ℝ) 0) < ε
      rw [max_lt_iff]
      constructor
      · rw [Real.dist_eq, sub_zero, abs_of_pos hhalf_pos]
        linarith
      · simpa using hε_pos
    · intro heq
      have hfirst : ε / 2 = 0 := congrArg Prod.fst heq
      linarith
  · exact ⟨z, hz, hz_zero⟩

/-- Combining nonempty openness with the nonsingular canonical coordinate map:
every nonempty open realized-value region contains a positive-radius point in
the source's polar chart. -/
theorem exists_twoUserParam_mem_of_isOpen_of_nonempty
    {θ : ℝ} {S : Set (ℝ × ℝ)}
    (hsin : Real.sin θ ≠ 0)
    (hopen : IsOpen S) (hS : S.Nonempty) :
    ∃ r φ : ℝ, 0 < r ∧
      (r * Real.cos φ, r * Real.cos (θ - φ)) ∈ S := by
  obtain ⟨⟨x, y⟩, hmem, hxy⟩ :=
    exists_nonzero_mem_of_isOpen_of_nonempty hopen hS
  obtain ⟨r, φ, hr, hx, hy⟩ :=
    exists_twoUserParam_of_sin_ne_zero hsin hxy
  refine ⟨r, φ, hr, ?_⟩
  simpa [hx, hy] using hmem

theorem twoUserInducedCostNumerator_param
    (θ φ r : ℝ) :
    twoUserInducedCostNumerator θ
        (r * Real.cos φ) (r * Real.cos (θ - φ)) =
      r ^ 2 * (Real.sin θ) ^ 2 := by
  unfold twoUserInducedCostNumerator
  rw [Real.cos_sub]
  have hcosθ : Real.cos θ ^ 2 = 1 - Real.sin θ ^ 2 := by
    nlinarith [Real.sin_sq_add_cos_sq θ]
  have hcosφ : Real.cos φ ^ 2 = 1 - Real.sin φ ^ 2 := by
    nlinarith [Real.sin_sq_add_cos_sq φ]
  ring_nf
  rw [hcosθ, hcosφ]
  ring

/--
Correct radial simplification of the source induced cost in its two-user polar
coordinates.  The `beta / 2` exponent in `twoUserInducedCost` is essential:
it is precisely what makes the resulting cost homogeneous of degree `beta`.
-/
theorem twoUserInducedCost_param_eq_alpha_mul_rpow
    {α β θ φ r : ℝ}
    (hr : 0 ≤ r) (hsin : 0 < Real.sin θ) :
    twoUserInducedCost α β θ
        (r * Real.cos φ) (r * Real.cos (θ - φ)) = α * r ^ β := by
  have hr_sq : 0 ≤ r ^ 2 := sq_nonneg r
  have hsin_sq : 0 ≤ (Real.sin θ) ^ 2 := sq_nonneg (Real.sin θ)
  have hrpow : (r ^ 2) ^ (β / 2) = r ^ β := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hr]
    congr 1
    ring
  have hsinpow : ((Real.sin θ) ^ 2) ^ (β / 2) = (Real.sin θ) ^ β := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hsin.le]
    congr 1
    ring
  unfold twoUserInducedCost
  rw [twoUserInducedCostNumerator_param,
    Real.mul_rpow hr_sq hsin_sq, hrpow, hsinpow,
    Real.rpow_neg hsin.le]
  field_simp [ne_of_gt (Real.rpow_pos_of_pos hsin β)]

/-- Fixing the first score, the first-user ray is the least-cost point of the
canonical feasible half-line.  This is the weak form of strict second-score
cost monotonicity, with its endpoint value evaluated in polar coordinates. -/
theorem alpha_mul_rpow_le_twoUserInducedCost_of_lowerUserRay
    {α β θ x y : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hx : 0 ≤ x) (hlower : x * Real.cos θ ≤ y) :
    α * x ^ β ≤ twoUserInducedCost α β θ x y := by
  have hboundary :
      twoUserInducedCost α β θ x (x * Real.cos θ) = α * x ^ β := by
    simpa using
      (twoUserInducedCost_param_eq_alpha_mul_rpow
        (α := α) (β := β) (θ := θ) (φ := 0) (r := x) hx hsin)
  rcases hlower.eq_or_lt with hEq | hlt
  · rw [← hEq, hboundary]
  · rw [← hboundary]
    exact (twoUserInducedCost_strictMono_snd_of_lowerUserRay
      hα hβ hsin le_rfl hlt).le

/--
The induced cost has the degree-beta homogeneity used by the source scaling
deviation. The scalar is nonnegative so real powers respect the quadratic
scaling identity.
-/
theorem twoUserInducedCost_scale_of_nonneg
    {α β θ t z1 z2 : ℝ} (ht : 0 ≤ t) :
    twoUserInducedCost α β θ (t * z1) (t * z2) =
      t ^ β * twoUserInducedCost α β θ z1 z2 := by
  have hnum : twoUserInducedCostNumerator θ (t * z1) (t * z2) =
      t ^ 2 * twoUserInducedCostNumerator θ z1 z2 := by
    unfold twoUserInducedCostNumerator
    ring
  have hnum_nonneg : 0 ≤ twoUserInducedCostNumerator θ z1 z2 :=
    twoUserInducedCostNumerator_nonneg θ z1 z2
  have htsq_nonneg : 0 ≤ t ^ 2 := sq_nonneg t
  have htpow : (t ^ 2) ^ (β / 2) = t ^ β := by
    rw [← Real.rpow_natCast t 2, ← Real.rpow_mul ht]
    congr 1
    ring
  unfold twoUserInducedCost
  rw [hnum, Real.mul_rpow htsq_nonneg hnum_nonneg, htpow]
  ring

/--
A nonzero canonical value pair has strictly lower induced cost after a
positive scale reduction when the source coefficient, exponent, and sine are
positive.
-/
theorem twoUserInducedCost_strictScale_lt
    {α β θ t z1 z2 : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (ht : 0 < t) (ht_one : t < 1)
    (hpair : z1 ≠ 0 ∨ z2 ≠ 0) :
    twoUserInducedCost α β θ (t * z1) (t * z2) <
      twoUserInducedCost α β θ z1 z2 := by
  rw [twoUserInducedCost_scale_of_nonneg ht.le]
  have hnum_nonneg : 0 ≤ twoUserInducedCostNumerator θ z1 z2 :=
    twoUserInducedCostNumerator_nonneg θ z1 z2
  have hnum_ne : twoUserInducedCostNumerator θ z1 z2 ≠ 0 :=
    twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne' hpair
  have hnum_pos : 0 < twoUserInducedCostNumerator θ z1 z2 :=
    lt_of_le_of_ne hnum_nonneg (Ne.symm hnum_ne)
  have hcost_pos : 0 < twoUserInducedCost α β θ z1 z2 := by
    unfold twoUserInducedCost
    exact mul_pos
      (mul_pos hα (Real.rpow_pos_of_pos hsin (-β)))
      (Real.rpow_pos_of_pos hnum_pos (β / 2))
  have htpow : t ^ β < 1 := Real.rpow_lt_one ht.le ht_one hβ
  simpa [mul_comm] using mul_lt_of_lt_one_right hcost_pos htpow

theorem twoUserInducedCostCrossPartial_param_factor
    {α β θ φ r : ℝ}
    (hβ : β ≠ 0)
    (hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2) :
    twoUserInducedCostCrossPartial α β θ
        (r * Real.cos φ) (r * Real.cos (θ - φ)) =
      β * α * (Real.sin θ) ^ (-β) *
        ((r ^ 2 * (Real.sin θ) ^ 2) ^ (β / 2 - 1) *
          ((β / 2) * twoUserSecondDerivSignBracket β θ φ)) := by
  have hpow :
      (r ^ 2 * (Real.sin θ) ^ 2) ^ (β / 2 - 1) =
        (r ^ 2 * (Real.sin θ) ^ 2) ^ (β / 2 - 2) *
          (r ^ 2 * (Real.sin θ) ^ 2) := by
    rw [show β / 2 - 1 = (β / 2 - 2) + 1 by ring]
    rw [Real.rpow_add hNpos]
    rw [Real.rpow_one]
  have hbracket :=
    twoUser_secondDeriv_source_bracket_identity (β := β) (θ := θ) (φ := φ) hβ
  unfold twoUserInducedCostCrossPartial
  rw [twoUserInducedCostNumerator_param]
  rw [twoUserParam_z2_sub_z1_cos]
  rw [twoUserParam_z1_sub_z2_cos]
  rw [hpow]
  unfold twoUserSecondDerivSignBracket
  unfold twoUserSecondDerivSignBracket at hbracket
  rw [← hbracket]
  ring

/--
Positive scalar factor relating the canonical cross-partial to the source
bracket in Lemma `secondderiv`.
-/
noncomputable def twoUserSecondDerivPositiveScale
    (α β θ r : ℝ) : ℝ :=
  β * α * (Real.sin θ) ^ (-β) *
    ((r ^ 2 * (Real.sin θ) ^ 2) ^ (β / 2 - 1) * (β / 2))

theorem twoUserSecondDerivPositiveScale_pos
    {α β θ r : ℝ}
    (hα : 0 < α)
    (hβ : 0 < β)
    (hsin : 0 < Real.sin θ)
    (hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2) :
    0 < twoUserSecondDerivPositiveScale α β θ r := by
  unfold twoUserSecondDerivPositiveScale
  exact
    mul_pos
      (mul_pos
        (mul_pos hβ hα)
        (Real.rpow_pos_of_pos hsin (-β)))
      (mul_pos
        (Real.rpow_pos_of_pos hNpos (β / 2 - 1))
        (by linarith))

/--
At the source parametrization, a zero canonical cross-partial gives a zero
`secondderiv` bracket once the scalar factor is positive. This is a direct
calculus transfer and does not assert a support or equilibrium property.
-/
theorem twoUserSecondDerivSignBracket_eq_zero_of_crossPartial_eq_zero_param
    {α β θ φ r : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2)
    (hcross : twoUserInducedCostCrossPartial α β θ
      (r * Real.cos φ) (r * Real.cos (θ - φ)) = 0) :
    twoUserSecondDerivSignBracket β θ φ = 0 := by
  have hfactor :=
    twoUserInducedCostCrossPartial_param_factor
      (α := α) (β := β) (θ := θ) (φ := φ) (r := r) hβ.ne' hNpos
  have hscale_pos : 0 < twoUserSecondDerivPositiveScale α β θ r :=
    twoUserSecondDerivPositiveScale_pos hα hβ hsin hNpos
  have hrewrite :
      twoUserInducedCostCrossPartial α β θ
          (r * Real.cos φ) (r * Real.cos (θ - φ)) =
        twoUserSecondDerivPositiveScale α β θ r *
          twoUserSecondDerivSignBracket β θ φ := by
    rw [hfactor]
    unfold twoUserSecondDerivPositiveScale
    ring
  rw [hrewrite] at hcross
  exact (mul_eq_zero.mp hcross).resolve_left (ne_of_gt hscale_pos)

/--
Corrected strict-sign component of Step 1 in the source proof of Proposition
`uniqueness`: below the two-user phase threshold, the canonical induced-cost
cross-partial is strictly negative on the stated positive angular domain.
The support-graph and equilibrium consequences require additional, separately
visible hypotheses and are not asserted here.
-/
theorem twoUserInducedCostCrossPartial_neg_of_beta_lt_phaseThreshold_and_angle_mem_Icc_lt_half_pi
    {α β θ φ r : ℝ}
    (hα : 0 < α)
    (hβ : 0 < β)
    (hsin : 0 < Real.sin θ)
    (hden : 0 < 1 - Real.cos θ)
    (hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hθ_nonneg : 0 ≤ θ)
    (hθ_lt_half_pi : θ < Real.pi / 2)
    (hφ_nonneg : 0 ≤ φ)
    (hφ_leθ : φ ≤ θ) :
    twoUserInducedCostCrossPartial α β θ
      (r * Real.cos φ) (r * Real.cos (θ - φ)) < 0 := by
  have hfactor :=
    twoUserInducedCostCrossPartial_param_factor
      (α := α) (β := β) (θ := θ) (φ := φ) (r := r) hβ.ne' hNpos
  have hscale_pos : 0 < twoUserSecondDerivPositiveScale α β θ r :=
    twoUserSecondDerivPositiveScale_pos hα hβ hsin hNpos
  have hbracket : twoUserSecondDerivSignBracket β θ φ < 0 :=
    twoUserSecondDerivSignBracket_neg_of_beta_lt_phaseThreshold_and_angle_mem_Icc_lt_half_pi
      hβ hden hβlt hθ_nonneg hθ_lt_half_pi hφ_nonneg hφ_leθ
  have hrewrite :
      twoUserInducedCostCrossPartial α β θ
          (r * Real.cos φ) (r * Real.cos (θ - φ)) =
        twoUserSecondDerivPositiveScale α β θ r *
          twoUserSecondDerivSignBracket β θ φ := by
    rw [hfactor]
    unfold twoUserSecondDerivPositiveScale
    ring
  rw [hrewrite]
  exact mul_neg_of_pos_of_neg hscale_pos hbracket

/-- The elementary cosine identity that controls the entire positive-score
cone, not just the central angular interval drawn in the source. -/
theorem twoUser_cos_shift_add_cos_eq_two_mul
    (θ φ : ℝ) :
    Real.cos (θ - 2 * φ) + Real.cos θ =
      2 * Real.cos φ * Real.cos (θ - φ) := by
  rw [show θ - 2 * φ = (θ - φ) - φ by ring,
    show θ = (θ - φ) + φ by ring,
    Real.cos_sub, Real.cos_add]
  ring

/--
Corrected global sign calculation for Step 1 of Proposition `uniqueness`.
For the paper's standing exponent range `1 ≤ β`, the below-threshold
bracket is strictly negative whenever both canonical user scores are positive.
The second case in the proof is the one omitted by the printed contradictory
sign chain: when `β < 2`, positivity of both cosines gives the strict lower
bound `-cos θ < cos (θ - 2φ)`.
-/
theorem twoUserSecondDerivSignBracket_neg_of_beta_lt_phaseThreshold_of_pos_cosines
    {β θ φ : ℝ}
    (hβ : 1 ≤ β)
    (hden : 0 < 1 - Real.cos θ)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hcosθ : 0 ≤ Real.cos θ)
    (hcosφ : 0 < Real.cos φ)
    (hcosθφ : 0 < Real.cos (θ - φ)) :
    twoUserSecondDerivSignBracket β θ φ < 0 := by
  have hβpos : 0 < β := lt_of_lt_of_le zero_lt_one hβ
  have hcoeff_lt :=
    twoUser_coeff_lt_cos_of_beta_lt_phaseThreshold hβpos hden hβlt
  set coeff : ℝ := (β - 2) / β
  set carg : ℝ := Real.cos (θ - 2 * φ)
  have hcoeff_lt' : coeff < Real.cos θ := by
    simpa [coeff] using hcoeff_lt
  have hcarg_lower : -Real.cos θ < carg := by
    have hsum : 0 < Real.cos (θ - 2 * φ) + Real.cos θ := by
      rw [twoUser_cos_shift_add_cos_eq_two_mul]
      positivity
    dsimp [carg]
    linarith
  have hcarg_upper : carg ≤ 1 := by
    dsimp [carg]
    exact Real.cos_le_one _
  have hcoeff_ge : -1 ≤ coeff := by
    dsimp [coeff]
    rw [le_div_iff₀ hβpos]
    linarith
  unfold twoUserSecondDerivSignBracket
  change coeff * carg - Real.cos θ < 0
  by_cases hcoeff_nonneg : 0 ≤ coeff
  · have hmul_le : coeff * carg ≤ coeff * 1 :=
      mul_le_mul_of_nonneg_left hcarg_upper hcoeff_nonneg
    linarith
  · have hcoeff_neg : coeff < 0 := lt_of_not_ge hcoeff_nonneg
    have hmul_lt : coeff * carg < coeff * (-Real.cos θ) :=
      mul_lt_mul_of_neg_left hcarg_lower hcoeff_neg
    have hmul_bound : coeff * (-Real.cos θ) ≤ Real.cos θ := by
      have h := mul_le_mul_of_nonpos_right hcoeff_ge
        (by linarith : -Real.cos θ ≤ 0)
      nlinarith
    linarith

/-- Below the source phase threshold, the canonical induced-cost cross partial
is strictly negative at every pair of strictly positive user scores.  This is
the domain needed by the support-order and fibre arguments; unlike a global
strict-sign premise, it remains true in the presence of the origin endpoint. -/
theorem twoUserInducedCostCrossPartial_neg_of_beta_lt_phaseThreshold_of_pos_scores
    {α β θ z1 z2 : ℝ}
    (hα : 0 < α)
    (hβ : 1 ≤ β)
    (hsin : 0 < Real.sin θ)
    (hden : 0 < 1 - Real.cos θ)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hcosθ : 0 ≤ Real.cos θ)
    (hz1 : 0 < z1) (hz2 : 0 < z2) :
    twoUserInducedCostCrossPartial α β θ z1 z2 < 0 := by
  obtain ⟨r, φ, hr, hz1eq, hz2eq⟩ :=
    exists_twoUserParam_of_sin_ne_zero hsin.ne' (by
      intro h
      have : z1 = 0 := by simpa using congrArg Prod.fst h
      linarith)
  have hcosφ : 0 < Real.cos φ := by
    rw [hz1eq] at hz1
    by_contra hnot
    have hnonpos : Real.cos φ ≤ 0 := le_of_not_gt hnot
    have : r * Real.cos φ ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos hr.le hnonpos
    linarith
  have hcosθφ : 0 < Real.cos (θ - φ) := by
    rw [hz2eq] at hz2
    by_contra hnot
    have hnonpos : Real.cos (θ - φ) ≤ 0 := le_of_not_gt hnot
    have : r * Real.cos (θ - φ) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos hr.le hnonpos
    linarith
  have hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2 := by positivity
  have hfactor :=
    twoUserInducedCostCrossPartial_param_factor
      (α := α) (β := β) (θ := θ) (φ := φ) (r := r)
      (lt_of_lt_of_le zero_lt_one hβ).ne' hNpos
  have hscale_pos : 0 < twoUserSecondDerivPositiveScale α β θ r :=
    twoUserSecondDerivPositiveScale_pos hα
      (lt_of_lt_of_le zero_lt_one hβ) hsin hNpos
  have hbracket : twoUserSecondDerivSignBracket β θ φ < 0 :=
    twoUserSecondDerivSignBracket_neg_of_beta_lt_phaseThreshold_of_pos_cosines
      hβ hden hβlt hcosθ hcosφ hcosθφ
  have hrewrite :
      twoUserInducedCostCrossPartial α β θ
          (r * Real.cos φ) (r * Real.cos (θ - φ)) =
        twoUserSecondDerivPositiveScale α β θ r *
          twoUserSecondDerivSignBracket β θ φ := by
    rw [hfactor]
    unfold twoUserSecondDerivPositiveScale
    ring
  rw [hz1eq, hz2eq, hrewrite]
  exact mul_neg_of_pos_of_neg hscale_pos hbracket

/-- The completed analytic contradiction in Proposition `supportrestriction`:
the canonical cross-partial cannot vanish along a nonempty source-parametrized
angle interval outside the beta-two/right-angle degeneracy.  The interval is
left as a visible premise here; the separate support-geometry bridge must
construct it from an actual support ball. -/
theorem twoUser_no_parametric_angleInterval_crossPartial_zero_of_source_nondegenerate
    {α β θ r a b : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hθ_nonneg : 0 ≤ θ) (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2)
    (hr : 0 < r) (hab : a < b)
    (hcross : ∀ φ, φ ∈ Set.Ioo a b →
      twoUserInducedCostCrossPartial α β θ
        (r * Real.cos φ) (r * Real.cos (θ - φ)) = 0) :
    False := by
  have hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2 :=
    mul_pos (sq_pos_of_pos hr) (sq_pos_of_pos hsin)
  obtain ⟨φ, hφ, hbracket⟩ :=
    twoUserSecondDerivSignBracket_exists_ne_zero_on_Ioo_of_source_nondegenerate
      hβ hab hθ_nonneg hθ_le_half_pi hnondegenerate
  apply hbracket
  exact twoUserSecondDerivSignBracket_eq_zero_of_crossPartial_eq_zero_param
    hα hβ hsin hNpos (hcross φ hφ)

/-- An open support set containing one canonical source-parametrized point
contains all such points for a nonempty interval of angle parameters.  This is
the topology bridge needed by `supportrestriction`; it does not assert that a
given support ball contains a canonical point. -/
theorem exists_angleInterval_param_mem_of_isOpen
    {θ r φ : ℝ} {S : Set (ℝ × ℝ)}
    (hopen : IsOpen S)
    (hpoint : (r * Real.cos φ, r * Real.cos (θ - φ)) ∈ S) :
    ∃ a b : ℝ, a < b ∧
      ∀ ψ, ψ ∈ Set.Ioo a b →
        (r * Real.cos ψ, r * Real.cos (θ - ψ)) ∈ S := by
  let f : ℝ → ℝ × ℝ := fun ψ =>
    (r * Real.cos ψ, r * Real.cos (θ - ψ))
  have hf_cont : Continuous f := by
    dsimp [f]
    exact (continuous_const.mul Real.continuous_cos).prodMk
      (continuous_const.mul
        (Real.continuous_cos.comp (continuous_const.sub continuous_id)))
  let T : Set ℝ := f ⁻¹' S
  have hTopen : IsOpen T := hopen.preimage hf_cont
  have hφT : φ ∈ T := by simpa [T, f] using hpoint
  rcases Metric.mem_nhds_iff.mp (hTopen.mem_nhds hφT) with
    ⟨ε, hε_pos, hε_subset⟩
  refine ⟨φ - ε / 2, φ + ε / 2, by linarith, ?_⟩
  intro ψ hψ
  change ψ ∈ T
  apply hε_subset
  rw [Metric.mem_ball]
  change |ψ - φ| < ε
  rw [abs_lt]
  constructor <;> nlinarith [hψ.1, hψ.2, hε_pos]

/-- C1/open-support form of the angle-interval contradiction in Proposition
`supportrestriction`.  Every source-parametrized point in the displayed
interval is an interior support maximizer, so the local FOC theorem produces
the required cross-partial zeros before the analytic contradiction applies.
This is not yet a Nash-to-C1 or support-ball-to-angle-chart theorem. -/
theorem twoUser_no_parametric_angleInterval_supportMaximizers_of_source_nondegenerate
    {H1 H2 h1 : ℝ → ℝ} {α β θ r a b : ℝ}
    {S feasible : Set (ℝ × ℝ)}
    (hopen : IsOpen S) (hS_feasible : S ⊆ feasible)
    (hbase_cross : ∀ x y : ℝ, (x, y) ∈ S →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ, (x, y) ∈ S →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : ∀ x y : ℝ, (x, y) ∈ S → HasDerivAt H1 (h1 x) x)
    (hC1 : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn
        (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
          twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hθ_nonneg : 0 ≤ θ) (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2)
    (hr : 0 < r) (hab : a < b)
    (hparam_support : ∀ φ, φ ∈ Set.Ioo a b →
      (r * Real.cos φ, r * Real.cos (θ - φ)) ∈ S) :
    False := by
  apply twoUser_no_parametric_angleInterval_crossPartial_zero_of_source_nondegenerate
    hα hβ hsin hθ_nonneg hθ_le_half_pi hnondegenerate hr hab
  intro φ hφ
  exact twoUserInducedCostCrossPartial_eq_zero_of_supportMaximizers_on_isOpen
    hopen (hparam_support φ hφ) hS_feasible
    (hbase_cross _ _ (hparam_support φ hφ)) hbase_first hH1 hC1

/-- Pointwise open-support endpoint for the angle-chart part of Proposition
`supportrestriction`.  The local C1/FOC hypotheses and nondegeneracy rule out
even one canonical source-parametrized point in the open support, because
openness automatically supplies the forbidden interval.  The source's prior
support-ball-to-canonical-point and Nash-to-C1 bridges remain explicit
obligations. -/
theorem twoUser_no_open_supportMaximizer_at_paramPoint_of_source_nondegenerate
    {H1 H2 h1 : ℝ → ℝ} {α β θ r φ : ℝ}
    {S feasible : Set (ℝ × ℝ)}
    (hopen : IsOpen S) (hS_feasible : S ⊆ feasible)
    (hbase_cross : ∀ x y : ℝ, (x, y) ∈ S →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ, (x, y) ∈ S →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : ∀ x y : ℝ, (x, y) ∈ S → HasDerivAt H1 (h1 x) x)
    (hC1 : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn
        (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
          twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hθ_nonneg : 0 ≤ θ) (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2)
    (hr : 0 < r)
    (hpoint : (r * Real.cos φ, r * Real.cos (θ - φ)) ∈ S) :
    False := by
  obtain ⟨a, b, hab, hparam_support⟩ :=
    exists_angleInterval_param_mem_of_isOpen hopen hpoint
  exact twoUser_no_parametric_angleInterval_supportMaximizers_of_source_nondegenerate
    hopen hS_feasible hbase_cross hbase_first hH1 hC1 hα hβ hsin
    hθ_nonneg hθ_le_half_pi hnondegenerate hr hab hparam_support

/-- Open-set endpoint of Proposition `supportrestriction`.  In a nonsingular
two-user system, the source's C1/local-FOC premises cannot hold throughout a
nonempty open support region outside the beta-two/right-angle degeneracy.  The
polar chart and the needed angle interval are derived here rather than left as
extra premises.  Nash-to-C1 and pointwise differentiability remain separate
source-assumption bridges. -/
theorem twoUser_no_nonempty_open_supportMaximizers_of_source_nondegenerate
    {H1 H2 h1 : ℝ → ℝ} {α β θ : ℝ}
    {S feasible : Set (ℝ × ℝ)}
    (hopen : IsOpen S) (hS_nonempty : S.Nonempty) (hS_feasible : S ⊆ feasible)
    (hbase_cross : ∀ x y : ℝ, (x, y) ∈ S →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ, (x, y) ∈ S →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : ∀ x y : ℝ, (x, y) ∈ S → HasDerivAt H1 (h1 x) x)
    (hC1 : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn
        (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
          twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hθ_nonneg : 0 ≤ θ) (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2) :
    False := by
  obtain ⟨r, φ, hr, hpoint⟩ :=
    exists_twoUserParam_mem_of_isOpen_of_nonempty (ne_of_gt hsin) hopen hS_nonempty
  exact twoUser_no_open_supportMaximizer_at_paramPoint_of_source_nondegenerate
    hopen hS_feasible hbase_cross hbase_first hH1 hC1 hα hβ hsin
    hθ_nonneg hθ_le_half_pi hnondegenerate hr hpoint

/-- A.e.-differentiability endpoint for Proposition `supportrestriction`.
This follows the source's intended regularity level: the first marginal need
only be differentiable almost everywhere.  The a.e. FOC is upgraded by
continuity of the first induced-cost partial on the open support, after which
the completed polar/angle contradiction applies. -/
theorem twoUser_no_nonempty_open_supportMaximizers_ae_of_source_nondegenerate
    {H1 H2 h1 : ℝ → ℝ} {α β θ : ℝ}
    {S feasible : Set (ℝ × ℝ)}
    (hopen : IsOpen S) (hS_nonempty : S.Nonempty) (hS_feasible : S ⊆ feasible)
    (hbase_cross : ∀ x y : ℝ, (x, y) ∈ S →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ, (x, y) ∈ S →
      twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1_ae : ∀ᵐ x ∂volume, (∃ y : ℝ, (x, y) ∈ S) →
      HasDerivAt H1 (h1 x) x)
    (hC1 : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn
        (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
          twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hθ_nonneg : 0 ≤ θ) (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2) :
    False := by
  have hfirst_ae :=
    twoUserInducedCostFirstPartial_eq_marginalDerivative_ae_of_supportMaximizers_on_isOpen
      hopen hS_feasible hbase_first hH1_ae hC1
  have hpartial_cont : ContinuousOn
      (fun z : ℝ × ℝ => β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ z.1 z.2) ^ (β / 2 - 1) *
          (z.1 - z.2 * Real.cos θ)) S :=
    continuousOn_twoUserInducedCostFirstPartial fun z hz => hbase_cross z.1 z.2 hz
  obtain ⟨r, φ, hr, hpoint⟩ :=
    exists_twoUserParam_mem_of_isOpen_of_nonempty (ne_of_gt hsin) hopen hS_nonempty
  obtain ⟨a, b, hab, hparam_support⟩ :=
    exists_angleInterval_param_mem_of_isOpen hopen hpoint
  apply twoUser_no_parametric_angleInterval_crossPartial_zero_of_source_nondegenerate
    hα hβ hsin hθ_nonneg hθ_le_half_pi hnondegenerate hr hab
  intro ψ hψ
  exact twoUserInducedCostCrossPartial_eq_zero_of_ae_firstPartial_eq_on_isOpen
    hopen (hparam_support ψ hψ) hbase_cross hpartial_cont hfirst_ae

/-- L2-ball endpoint of Proposition `supportrestriction`.  This packages the
source proof's final geometric step: a positive-radius value-support ball is a
nonempty open region, so the canonical polar chart and angle interval need no
additional hypothesis.  The C1/FOC, derivative, feasible-domain, and
base-cost conditions are deliberately still explicit. -/
theorem twoUser_no_l2Ball_supportMaximizers_of_source_nondegenerate
    {H1 H2 h1 : ℝ → ℝ} {α β θ z1 z2 ε : ℝ}
    {feasible : Set (ℝ × ℝ)}
    (hε : 0 < ε)
    (hball_feasible : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → (x, y) ∈ feasible)
    (hbase_cross : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1 : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → HasDerivAt H1 (h1 x) x)
    (hC1 : ∀ z : ℝ × ℝ,
      (z.1 - z1) ^ 2 + (z.2 - z2) ^ 2 < ε ^ 2 →
        IsMaxOn
          (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
            twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hθ_nonneg : 0 ≤ θ) (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2) :
    False := by
  let B : Set (ℝ × ℝ) := {z |
    (z.1 - z1) ^ 2 + (z.2 - z2) ^ 2 < ε ^ 2}
  apply twoUser_no_nonempty_open_supportMaximizers_of_source_nondegenerate
    (H1 := H1) (H2 := H2) (h1 := h1) (S := B) (feasible := feasible)
  · exact isOpen_lt
      (((continuous_fst.sub continuous_const).pow 2).add
        ((continuous_snd.sub continuous_const).pow 2))
      continuous_const
  · refine ⟨(z1, z2), ?_⟩
    dsimp [B]
    simpa using (sq_pos_of_pos hε)
  · intro z hz
    exact hball_feasible z.1 z.2 (by simpa [B] using hz)
  · intro x y hxy
    exact hbase_cross x y (by simpa [B] using hxy)
  · intro x y hxy
    exact hbase_first x y (by simpa [B] using hxy)
  · intro x y hxy
    exact hH1 x y (by simpa [B] using hxy)
  · intro z hz
    exact hC1 z (by simpa [B] using hz)
  · exact hα
  · exact hβ
  · exact hsin
  · exact hθ_nonneg
  · exact hθ_le_half_pi
  · exact hnondegenerate

/-- A.e.-differentiability l2-ball endpoint for Proposition
`supportrestriction`.  This is the source-facing form of the completed
argument: the ball supplies the open set, while continuity repairs the
paper's a.e.-to-pointwise FOC transition. -/
theorem twoUser_no_l2Ball_supportMaximizers_ae_of_source_nondegenerate
    {H1 H2 h1 : ℝ → ℝ} {α β θ z1 z2 ε : ℝ}
    {feasible : Set (ℝ × ℝ)}
    (hε : 0 < ε)
    (hball_feasible : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → (x, y) ∈ feasible)
    (hbase_cross : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1_ae : ∀ᵐ x ∂volume, HasDerivAt H1 (h1 x) x)
    (hC1 : ∀ z : ℝ × ℝ,
      (z.1 - z1) ^ 2 + (z.2 - z2) ^ 2 < ε ^ 2 →
        IsMaxOn
          (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
            twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hθ_nonneg : 0 ≤ θ) (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2) :
    False := by
  let B : Set (ℝ × ℝ) := {z |
    (z.1 - z1) ^ 2 + (z.2 - z2) ^ 2 < ε ^ 2}
  apply twoUser_no_nonempty_open_supportMaximizers_ae_of_source_nondegenerate
    (H1 := H1) (H2 := H2) (h1 := h1) (S := B) (feasible := feasible)
  · exact isOpen_lt
      (((continuous_fst.sub continuous_const).pow 2).add
        ((continuous_snd.sub continuous_const).pow 2))
      continuous_const
  · refine ⟨(z1, z2), ?_⟩
    dsimp [B]
    simpa using (sq_pos_of_pos hε)
  · intro z hz
    exact hball_feasible z.1 z.2 (by simpa [B] using hz)
  · intro x y hxy
    exact hbase_cross x y (by simpa [B] using hxy)
  · intro x y hxy
    exact hbase_first x y (by simpa [B] using hxy)
  · filter_upwards [hH1_ae] with x hx
    intro _
    exact hx
  · intro z hz
    exact hC1 z (by simpa [B] using hz)
  · exact hα
  · exact hβ
  · exact hsin
  · exact hθ_nonneg
  · exact hθ_le_half_pi
  · exact hnondegenerate

/-- Local a.e. differentiability is sufficient when it is stated on the
horizontal projection of the support ball. -/
theorem twoUser_no_l2Ball_supportMaximizers_ae_on_ball_of_source_nondegenerate
    {H1 H2 h1 : ℝ → ℝ} {α β θ z1 z2 ε : ℝ}
    {feasible : Set (ℝ × ℝ)}
    (hε : 0 < ε)
    (hball_feasible : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → (x, y) ∈ feasible)
    (hbase_cross : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1_ae : ∀ᵐ x ∂volume,
      (∃ y : ℝ, (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2) →
        HasDerivAt H1 (h1 x) x)
    (hC1 : ∀ z : ℝ × ℝ,
      (z.1 - z1) ^ 2 + (z.2 - z2) ^ 2 < ε ^ 2 →
        IsMaxOn
          (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
            twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hθ_nonneg : 0 ≤ θ) (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2) :
    False := by
  let B : Set (ℝ × ℝ) := {z |
    (z.1 - z1) ^ 2 + (z.2 - z2) ^ 2 < ε ^ 2}
  apply twoUser_no_nonempty_open_supportMaximizers_ae_of_source_nondegenerate
    (H1 := H1) (H2 := H2) (h1 := h1) (S := B) (feasible := feasible)
  · exact isOpen_lt
      (((continuous_fst.sub continuous_const).pow 2).add
        ((continuous_snd.sub continuous_const).pow 2))
      continuous_const
  · refine ⟨(z1, z2), ?_⟩
    dsimp [B]
    simpa using (sq_pos_of_pos hε)
  · intro z hz
    exact hball_feasible z.1 z.2 (by simpa [B] using hz)
  · intro x y hxy
    exact hbase_cross x y (by simpa [B] using hxy)
  · intro x y hxy
    exact hbase_first x y (by simpa [B] using hxy)
  · filter_upwards [hH1_ae] with x hx
    rintro ⟨y, hxy⟩
    exact hx ⟨y, by simpa [B] using hxy⟩
  · intro z hz
    exact hC1 z (by simpa [B] using hz)
  · exact hα
  · exact hβ
  · exact hsin
  · exact hθ_nonneg
  · exact hθ_le_half_pi
  · exact hnondegenerate

/-- Local absolute continuity of the first marginal supplies exactly the
almost-everywhere derivative information needed on a support ball.  The
interval-containment premise makes the localization explicit rather than
silently extending an a.e. conclusion outside its source interval. -/
theorem twoUser_no_l2Ball_supportMaximizers_of_source_nondegenerate_of_H1_AC
    {H1 H2 : ℝ → ℝ} {α β θ z1 z2 ε a b : ℝ}
    {feasible : Set (ℝ × ℝ)}
    (hε : 0 < ε)
    (hball_feasible : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → (x, y) ∈ feasible)
    (hbase_cross : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hbase_first : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
        twoUserInducedCostNumerator θ x y ≠ 0 ∨ 1 ≤ β / 2)
    (hH1_AC : AbsolutelyContinuousOnInterval H1 a b)
    (hball_x_interval : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 → x ∈ Set.uIcc a b)
    (hC1 : ∀ z : ℝ × ℝ,
      (z.1 - z1) ^ 2 + (z.2 - z2) ^ 2 < ε ^ 2 →
        IsMaxOn
          (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
            twoUserInducedCost α β θ z.1 z.2) feasible z)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hθ_nonneg : 0 ≤ θ) (hθ_le_half_pi : θ ≤ Real.pi / 2)
    (hnondegenerate : β ≠ 2 ∨ θ ≠ Real.pi / 2) :
    False := by
  apply twoUser_no_l2Ball_supportMaximizers_ae_on_ball_of_source_nondegenerate
    (H1 := H1) (H2 := H2) (h1 := deriv H1)
    hε hball_feasible hbase_cross hbase_first ?_ hC1
    hα hβ hsin hθ_nonneg hθ_le_half_pi hnondegenerate
  filter_upwards [AppliedModelingLib.RealAnalysis.ae_hasDerivAt_deriv_of_absolutelyContinuousOnInterval
    hH1_AC] with x hx
  rintro ⟨y, hxy⟩
  exact hx (hball_x_interval x y hxy)

/-- If the first maximum-value CDF is the natural power of a marginal CDF,
local absolute continuity of that marginal supplies the source regularity used
by the support-ball contradiction.  The maximum-CDF identity itself remains a
separate probabilistic bridge. -/
