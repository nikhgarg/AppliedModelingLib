    0 < equilibriumPayoff := by
  rcases hdev with ⟨p, hp⟩
  exact lt_of_lt_of_le hp (hno p)

/-! ## Source symmetric mixed-Nash conclusions -/

/--
The paper's symmetric mixed-Nash condition, expressed directly for the
formalized uniform-tie payoff.  The strategy is a probability measure on the
nonnegative content space, and every action in its topological support is a
best response to the common strategy for every focal producer.

This deliberately uses the source's support-action formulation rather than
the incomplete generic C1--C3 characterization: score-level nullness is then
proved where it is actually needed by a concrete construction.
-/
def SourceSymmetricMixedNash {D N P : ℕ}
    (users : Fin N → Content D) (cost : Content D → ℝ)
    (μ : MixedContentStrategy D) : Prop :=
  MeasureTheory.IsProbabilityMeasure μ ∧
    μ.support ⊆ {p : Content D | NonnegativeContent p} ∧
      ∀ (j : Fin P) (p : Content D), p ∈ μ.support →
        ∀ q : Content D, NonnegativeContent q →
          SourceMixedPurePayoff
              (ExpectedUsersWonAgainstSymmetricMixed users j) cost q μ ≤
          SourceMixedPurePayoff
              (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ

/-- A positive content dilation converts a symmetric mixed Nash law with the
cost multiplier `a ^ beta` into the coefficient-one law on the pushed-forward
strategy.  Both the iid-profile allocation and the support-action best-response
condition are transported explicitly. -/
theorem sourceSymmetricMixedNash_scaleContent_map_of_rpow_eq
    {D N P : ℕ} {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {alpha beta a : ℝ}
    (ha : 0 < a) (hscale_cost : a ^ beta = alpha)
    (hnash : SourceSymmetricMixedNash (P := P) users
      (fun p => alpha * normRpowCost ν beta p) μ) :
    SourceSymmetricMixedNash (P := P) users
      (normRpowCost ν beta) (Measure.map (scaleContent a) μ) := by
  letI : IsProbabilityMeasure μ := hnash.1
  letI : IsProbabilityMeasure (Measure.map (scaleContent a) μ) :=
    Measure.isProbabilityMeasure_map (measurable_scaleContent a).aemeasurable
  have ha_ne : a ≠ 0 := ha.ne'
  have hinverseMap :
      Measure.map (scaleContent a⁻¹) (Measure.map (scaleContent a) μ) = μ := by
    calc
      Measure.map (scaleContent a⁻¹) (Measure.map (scaleContent a) μ) =
          Measure.map ((scaleContent a⁻¹) ∘ (scaleContent a)) μ :=
        Measure.map_map (measurable_scaleContent a⁻¹) (measurable_scaleContent a)
      _ = Measure.map id μ := by
        apply Measure.map_congr
        filter_upwards [] with p
        simpa only [Function.comp_apply] using scaleContent_inv_scaleContent ha_ne p
      _ = μ := Measure.map_id
  refine ⟨inferInstance, ?_, ?_⟩
  · intro p hp
    have hp_back : scaleContent a⁻¹ p ∈ μ.support := by
      have hmap := AppliedModelingLib.Probability.mem_support_map_of_continuous
        (continuous_scaleContent a⁻¹) hp
      rwa [hinverseMap] at hmap
    rw [← scaleContent_scaleContent_inv ha_ne p]
    exact scaleContent_nonnegative ha.le (hnash.2.1 hp_back)
  · intro j p hp q hq
    have hp_back : scaleContent a⁻¹ p ∈ μ.support := by
      have hmap := AppliedModelingLib.Probability.mem_support_map_of_continuous
        (continuous_scaleContent a⁻¹) hp
      rwa [hinverseMap] at hmap
    have hq_back : NonnegativeContent (scaleContent a⁻¹ q) :=
      scaleContent_nonnegative (inv_nonneg.mpr ha.le) hq
    have hbest := hnash.2.2 j (scaleContent a⁻¹ p) hp_back
      (scaleContent a⁻¹ q) hq_back
    unfold SourceMixedPurePayoff at hbest ⊢
    rw [← scaleContent_scaleContent_inv ha_ne q,
      ← scaleContent_scaleContent_inv ha_ne p,
      expectedUsersWonAgainstSymmetricMixed_scaleContent_map ha,
      expectedUsersWonAgainstSymmetricMixed_scaleContent_map ha,
      normRpowCost_scaleContent ν beta ha.le,
      normRpowCost_scaleContent ν beta ha.le,
      hscale_cost]
    exact hbest

/-- Positive independent rescaling of user vectors leaves the source
uniform-tie symmetric mixed-Nash predicate unchanged. -/
theorem sourceSymmetricMixedNash_scaleUsers_pos_iff
    {D N P : ℕ} (users : Fin N → Content D) {scale : Fin N → ℝ}
    {cost : Content D → ℝ} {μ : MixedContentStrategy D}
    (hscale : ∀ i : Fin N, 0 < scale i) :
    SourceSymmetricMixedNash (P := P)
        (fun i => scaleContent (scale i) (users i)) cost μ ↔
      SourceSymmetricMixedNash (P := P) users cost μ := by
  constructor <;> rintro ⟨hprob, hsupp, hbest⟩ <;>
    refine ⟨hprob, hsupp, ?_⟩
  · intro j p hp q hq
    have hineq := hbest j p hp q hq
    simpa only [SourceMixedPurePayoff,
      expectedUsersWonAgainstSymmetricMixed_scaleUsers_pos hscale] using hineq
  · intro j p hp q hq
    have hineq := hbest j p hp q hq
    simpa only [SourceMixedPurePayoff,
      expectedUsersWonAgainstSymmetricMixed_scaleUsers_pos hscale] using hineq

/-- In particular, L2-normalizing nonzero user vectors leaves the source
uniform-tie symmetric mixed-Nash predicate unchanged. -/
theorem sourceSymmetricMixedNash_l2NormalizedUsers_iff
    {D N P : ℕ} (users : Fin N → Content D) {cost : Content D → ℝ}
    {μ : MixedContentStrategy D}
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i)) :
    SourceSymmetricMixedNash (P := P) (l2NormalizedUsers users) cost μ ↔
      SourceSymmetricMixedNash (P := P) users cost μ := by
  constructor <;> rintro ⟨hprob, hsupp, hbest⟩ <;>
    refine ⟨hprob, hsupp, ?_⟩
  · intro j p hp q hq
    have hineq := hbest j p hp q hq
    simpa only [SourceMixedPurePayoff,
      expectedUsersWonAgainstSymmetricMixed_l2NormalizedUsers_eq husers_nonzero]
      using hineq
  · intro j p hp q hq
    have hineq := hbest j p hp q hq
    simpa only [SourceMixedPurePayoff,
      expectedUsersWonAgainstSymmetricMixed_l2NormalizedUsers_eq husers_nonzero]
      using hineq

/-- The numerical cost factor in the source's two-equally-sized-populations
Claim `equivalence`. -/
theorem two_div_natCast_two_mul_eq_inv (K : ℕ) (hK : 0 < K) :
    (2 : ℝ) / ((2 * K : ℕ) : ℝ) = (K : ℝ)⁻¹ := by
  have hK_real : (K : ℝ) ≠ 0 := by
    exact_mod_cast Nat.ne_of_gt hK
  rw [Nat.cast_mul]
  field_simp [hK_real]
  norm_num

/--
Source Claim `equivalence`, equal-population component.  A market with `K`
copies of each of two user types has exactly the same source symmetric mixed
Nash laws as the two-user market after its cost is multiplied by `1 / K`.
This is an exact uniform-tie payoff identity, not a heuristic population
normalization.  It intentionally does not perform the source's subsequent
coordinate rotation, which need not preserve the nonnegative content cone.
-/
theorem sourceSymmetricMixedNash_twoPopulationUsers_iff
    {D K P : ℕ} (users : Fin 2 → Content D) {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} (hK : 0 < K) :
    SourceSymmetricMixedNash (P := P) (twoPopulationUsers K users) cost μ ↔
      SourceSymmetricMixedNash (P := P) users
        (fun q => (K : ℝ)⁻¹ * cost q) μ := by
  have hK_real : 0 < (K : ℝ) := by exact_mod_cast hK
  constructor
  · rintro ⟨hprob, hsupp, hbest⟩
    refine ⟨hprob, hsupp, ?_⟩
    intro j p hp q hq
    have hineq := hbest j p hp q hq
    rw [sourceMixedPurePayoff_twoPopulationUsers_eq_mul users hK,
      sourceMixedPurePayoff_twoPopulationUsers_eq_mul users hK] at hineq
    exact le_of_mul_le_mul_left hineq hK_real
  · rintro ⟨hprob, hsupp, hbest⟩
    refine ⟨hprob, hsupp, ?_⟩
    intro j p hp q hq
    have hineq := hbest j p hp q hq
    rw [sourceMixedPurePayoff_twoPopulationUsers_eq_mul users hK,
      sourceMixedPurePayoff_twoPopulationUsers_eq_mul users hK]
    exact mul_le_mul_of_nonneg_left hineq hK_real.le

/--
Symmetric mixed Nash condition with a supplied compact action set.  This is
the exact restricted-game notion needed in the source's existence route:
support actions are best responses only against deviations in `actionSet`.
The subsequent transport theorem proves when this restricted conclusion is
already a Nash condition on the full nonnegative content domain.
-/
def SourceSymmetricMixedNashOnActionSet {D N P : ℕ}
    (actionSet : Set (Content D)) (users : Fin N → Content D)
    (cost : Content D → ℝ) (μ : MixedContentStrategy D) : Prop :=
  MeasureTheory.IsProbabilityMeasure μ ∧
    μ.support ⊆ actionSet ∧
      ∀ (j : Fin P) (p : Content D), p ∈ μ.support →
        ∀ q : Content D, q ∈ actionSet →
          SourceMixedPurePayoff
              (ExpectedUsersWonAgainstSymmetricMixed users j) cost q μ ≤
            SourceMixedPurePayoff
              (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ

/--
The truncated compact game used in Proposition `existence` has no additional
equilibria: a symmetric mixed Nash law for the nonnegative ball of radius
`2 N^(1 / beta)` is already a source symmetric mixed Nash law on the full
nonnegative content domain.  The zero action gives nonnegative payoff at every
restricted support action, while a deviation outside the smaller payoff cap
has strictly negative payoff.  Thus the slack in the source's truncation is
used only to make the compact action set suitable for the external existence
theorem, not to alter its equilibrium conclusion.
-/
theorem sourceSymmetricMixedNash_of_truncatedActionSet_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {β : ℝ}
    (htruncated :
      SourceSymmetricMixedNashOnActionSet (P := P)
        (sourceTruncatedActionSet ν (2 * ((N : ℝ) ^ β⁻¹)))
        users (normRpowCost ν β) μ)
    (hβ : 0 < β) :
    SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ := by
  letI : MeasureTheory.IsProbabilityMeasure μ := htruncated.1
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hcap_pos : 0 < (N : ℝ) ^ β⁻¹ :=
    Real.rpow_pos_of_pos hN_pos _
  have hdouble_cap_nonneg : 0 ≤ 2 * ((N : ℝ) ^ β⁻¹) := by
    positivity
  have hzero_mem : (0 : Content D) ∈
      sourceTruncatedActionSet ν (2 * ((N : ℝ) ^ β⁻¹)) := by
    refine ⟨zeroContent_nonnegative, ?_⟩
    rw [SourceNorm.norm_zero]
    exact hdouble_cap_nonneg
  refine ⟨htruncated.1, ?_, ?_⟩
  · intro p hp
    exact (htruncated.2.1 hp).1
  · intro j p hp q hq_nonnegative
    by_cases hq_in : ν.norm q ≤ 2 * ((N : ℝ) ^ β⁻¹)
    · exact htruncated.2.2 j p hp q ⟨hq_nonnegative, hq_in⟩
    · have hdouble_cap_lt : 2 * ((N : ℝ) ^ β⁻¹) < ν.norm q :=
        lt_of_not_ge hq_in
      have hcap_lt_double_cap : (N : ℝ) ^ β⁻¹ <
          2 * ((N : ℝ) ^ β⁻¹) := by
        nlinarith
      have hcap_lt : (N : ℝ) ^ β⁻¹ < ν.norm q :=
        hcap_lt_double_cap.trans hdouble_cap_lt
      have hcost_gt_card : (N : ℝ) < normRpowCost ν β q :=
        normRpowCost_gt_card_of_support_cap_lt_norm ν hβ hcap_lt
      have hq_upper :
          SourceMixedPurePayoff
              (ExpectedUsersWonAgainstSymmetricMixed users j)
              (normRpowCost ν β) q μ ≤
            (N : ℝ) - normRpowCost ν β q :=
        sourceMixedPurePayoff_le_card_sub_normRpowCost
          (users := users) (j := j) (μ := μ) ν (β := β) (p := q)
          (integrable_usersWon_deviateProfile_const users j q)
      have hq_negative :
          SourceMixedPurePayoff
              (ExpectedUsersWonAgainstSymmetricMixed users j)
              (normRpowCost ν β) q μ < 0 := by
        linarith
      have hzero_nonnegative :
          0 ≤ SourceMixedPurePayoff
              (ExpectedUsersWonAgainstSymmetricMixed users j)
              (normRpowCost ν β) (0 : Content D) μ :=
        sourceMixedPurePayoff_zero_nonneg_of_normRpowCost ν hβ
      have hzero_le_support :
          SourceMixedPurePayoff
              (ExpectedUsersWonAgainstSymmetricMixed users j)
              (normRpowCost ν β) (0 : Content D) μ ≤
            SourceMixedPurePayoff
              (ExpectedUsersWonAgainstSymmetricMixed users j)
              (normRpowCost ν β) p μ :=
        htruncated.2.2 j p hp (0 : Content D) hzero_mem
      exact hq_negative.le.trans (hzero_nonnegative.trans hzero_le_support)

/--
The all-zero user system has an atomic source symmetric mixed equilibrium: the
point mass at zero content.  Every action gets the same uniform-tie user mass,
and nonnegative norm-power cost makes zero a best response.  This checks the
degenerate population excluded by the source-model active-user clarification.
-/
theorem zeroUsers_dirac_zero_is_sourceSymmetricMixedNash_normRpowCost
    {D N P : ℕ} [Nonempty (Fin P)]
    (ν : SourceNorm D) {β : ℝ} (hβ : 0 < β) :
    SourceSymmetricMixedNash (P := P) (fun _ : Fin N => (0 : Content D))
      (normRpowCost ν β) (MeasureTheory.Measure.dirac (0 : Content D)) := by
  let μ : MixedContentStrategy D := MeasureTheory.Measure.dirac (0 : Content D)
  have hsupport_zero : μ.support ⊆ ({(0 : Content D)} : Set (Content D)) := by
    apply MeasureTheory.Measure.support_subset_of_isClosed isClosed_singleton
    simp [μ]
  refine ⟨inferInstance, ?_, ?_⟩
  · intro p hp
    have hpzero : p = 0 := by
      simpa using hsupport_zero hp
    rw [hpzero]
    exact zeroContent_nonnegative
  · intro j p hp q _hq
    have hpzero : p = 0 := by
      simpa using hsupport_zero hp
    subst p
    unfold SourceMixedPurePayoff
    rw [expectedUsersWonAgainstSymmetricMixed_zeroUsers_eq_card_mul_inv
      (j := j) (p := q) (μ := μ),
      expectedUsersWonAgainstSymmetricMixed_zeroUsers_eq_card_mul_inv
        (j := j) (p := (0 : Content D)) (μ := μ),
      normRpowCost_zero ν hβ]
    simpa using sub_le_self ((N : ℝ) * (P : ℝ)⁻¹)
      (normRpowCost_nonneg ν β q)

/--
Source-action-space version of the no-profitable-pure-deviation condition.
Unlike `SymmetricMixedNoProfitablePureDeviation`, this predicate quantifies
only over the nonnegative content actions that the paper permits producers to
choose.
-/
def SourceSymmetricMixedNoProfitableNonnegativeDeviation {D N : ℕ}
    (users : Fin N → Content D) (cost : Content D → ℝ)
    (j : Fin P) (μ : MixedContentStrategy D) (equilibriumPayoff : ℝ) : Prop :=
  ∀ p : Content D, NonnegativeContent p →
    SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ ≤
      equilibriumPayoff

/--
Source-action-space version of the score-law atomlessness bridge.  It needs
only the paper's nonnegative pure deviations, unlike the ambient-action
version above.  Thus it is the exact statement to use after a construction
has established the ordinary law-level equilibrium inequalities on the full
nonnegative source action space.
-/
theorem score_level_measureReal_eq_zero_of_noProfitableNonnegativeDeviation_and_ae_equilibrium_payoff
    {D N P : ℕ} [Nontrivial (Fin P)] {users : Fin N → Content D}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    {cost : Content D → ℝ} {equilibriumPayoff : ℝ} {i0 : Fin N} {j : Fin P}
    (hno :
      SourceSymmetricMixedNoProfitableNonnegativeDeviation
        users cost j μ equilibriumPayoff)
    (hae_payoff : ∀ᵐ p ∂μ,
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ =
        equilibriumPayoff)
    (hae_nonnegative : ∀ᵐ p ∂μ, NonnegativeContent p)
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0))
    (hcont : PerturbationCostContinuous cost)
    (z : ℝ) :
    μ.real {q : Content D | score (users i0) q = z} = 0 := by
  let level : Set (Content D) := {q : Content D | score (users i0) q = z}
  by_contra hlevel_zero
  have hlevel_pos : 0 < μ.real level :=
    lt_of_le_of_ne MeasureTheory.measureReal_nonneg (Ne.symm hlevel_zero)
  have hlevel_measure_ne : μ level ≠ 0 := by
    intro hlevel_measure_zero
    have hlevel_real_zero : μ.real level = 0 :=
      (MeasureTheory.measureReal_eq_zero_iff (μ := μ) (s := level)).mpr hlevel_measure_zero
    linarith
  have hgood : ∀ᵐ p ∂μ.restrict level,
      NonnegativeContent p ∧
        SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ =
          equilibriumPayoff :=
    (ae_restrict_of_ae hae_nonnegative).and (ae_restrict_of_ae hae_payoff)
  obtain ⟨p, hp_level, hp_nonnegative, hp_payoff⟩ :=
    MeasureTheory.Measure.exists_mem_of_measure_ne_zero_of_ae hlevel_measure_ne hgood
  have hp_score : score (users i0) p = z := hp_level
  have hp_level_pos :
      0 < μ.real {q : Content D | score (users i0) q = score (users i0) p} := by
    simpa only [hp_score] using hlevel_pos
  obtain ⟨ε, hε, hq_nonnegative, hprofitable⟩ :=
    exists_nonnegative_profitable_scoreLevel_perturbation
      (p := p) (i0 := i0) (j := j) husers_nonnegative hp_nonnegative hzero hcont
      hp_level_pos
  have hq_le :
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost
          (fun d => p d + ε * users i0 d) μ ≤ equilibriumPayoff :=
    hno _ hq_nonnegative
  rw [hp_payoff] at hprofitable
  linarith

/--
At any support action, the source symmetric-Nash condition directly yields the
no-profitable-deviation condition on the paper's nonnegative action space.
-/
theorem sourceSymmetricMixedNash_noProfitableNonnegativeDeviation_of_mem_support
    {D N P : ℕ} {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} {j : Fin P} {p0 : Content D}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (hp0 : p0 ∈ μ.support) :
    SourceSymmetricMixedNoProfitableNonnegativeDeviation users cost j μ
      (SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j) cost p0 μ) := by
  intro p hp
  exact hnash.2.2 j p0 hp0 p hp

/--
Support-action indifference under the source symmetric-Nash definition is an
almost-everywhere statement for the mixed law.  The full-measure support fact
uses the finite-dimensional content space's Lindelöf topology; no continuity
of the mixed payoff is assumed.
-/
theorem ae_sourceMixedPurePayoff_eq_of_sourceSymmetricMixedNash_of_mem_support
    {D N P : ℕ} {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} {j : Fin P} {p0 : Content D}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (hp0 : p0 ∈ μ.support) :
    ∀ᵐ p ∂μ,
      SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ =
        SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j) cost p0 μ := by
  filter_upwards [Measure.support_mem_ae] with p hp
  apply le_antisymm
  · exact hnash.2.2 j p0 hp0 p (hnash.2.1 hp)
  · exact hnash.2.2 j p hp p0 (hnash.2.1 hp0)

/--
The actual source mixed-Nash definition rules out atoms in every user's score
law, not merely atoms of the content law.  If a score level had positive mass,
it would contain a support action.  Perturbing that action in the corresponding
nonzero user direction yields a feasible nonnegative action with strictly
higher payoff, contradicting support optimality.

This is an endogenous tie-nullness theorem for the source model; it does not
replace the separate task of obtaining the source mixed-Nash definition from a
law-level fixed-point theorem for the compact truncation.
-/
theorem sourceSymmetricMixedNash_score_level_measure_eq_zero
    {D N P : ℕ} [Nontrivial (Fin P)] {users : Fin N → Content D}
    {cost : Content D → ℝ} {μ : MixedContentStrategy D} {i0 : Fin N} {j : Fin P}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0))
    (hcont : PerturbationCostContinuous cost)
    (z : ℝ) :
    μ {q : Content D | score (users i0) q = z} = 0 := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  let level : Set (Content D) := {q : Content D | score (users i0) q = z}
  by_contra hlevel_ne
  have hsupport : ∀ᵐ p ∂μ.restrict level, p ∈ μ.support :=
    ae_restrict_of_ae Measure.support_mem_ae
  obtain ⟨p, hp_level, hp_support⟩ :=
    MeasureTheory.Measure.exists_mem_of_measure_ne_zero_of_ae (by simpa [level] using hlevel_ne) hsupport
  have hp_score : score (users i0) p = z := hp_level
  have hp_level_pos :
      0 < μ.real {q : Content D | score (users i0) q = score (users i0) p} := by
    have hlevel_real_ne : μ.real level ≠ 0 := by
      intro hlevel_real_zero
      apply hlevel_ne
      exact (MeasureTheory.measureReal_eq_zero_iff (μ := μ) (s := level)).mp hlevel_real_zero
    have hlevel_real_pos : 0 < μ.real level :=
      lt_of_le_of_ne MeasureTheory.measureReal_nonneg (Ne.symm hlevel_real_ne)
    simpa only [hp_score] using hlevel_real_pos
  obtain ⟨ε, hε, hq_nonnegative, hprofitable⟩ :=
    exists_nonnegative_profitable_scoreLevel_perturbation
      (p := p) (i0 := i0) (j := j) husers_nonnegative (hnash.2.1 hp_support)
      hzero hcont hp_level_pos
  exact (not_lt_of_ge (hnash.2.2 j p hp_support _ hq_nonnegative)) hprofitable

/--
At the zero action, nonnegative users and a nonnegative-support law make every
strict opponent score event null.  Score-level nullness then turns the actual
uniform-tie product payoff into zero when there are at least two producers.
-/
theorem expectedUsersWonAgainstSymmetricMixed_zero_eq_zero_of_nonnegative_support
    {D N P : ℕ} [Nontrivial (Fin P)]
    {users : Fin N → Content D} {j : Fin P} {μ : MixedContentStrategy D}
    [MeasureTheory.IsProbabilityMeasure μ]
    (hsupport : μ.support ⊆ {p : Content D | NonnegativeContent p})
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hmeas_score : ∀ i : Fin N,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0) :
    ExpectedUsersWonAgainstSymmetricMixed users j (0 : Content D) μ = 0 := by
  rw [expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
    (users := users) (j := j) (μ := μ) (0 : Content D) hmeas_score hno_atom]
  apply Finset.sum_eq_zero
  intro i _
  have hstrict_ae : ∀ᵐ q ∂μ,
      ¬ score (users i) q < score (users i) (0 : Content D) := by
    filter_upwards [Measure.support_mem_ae] with q hq
    rw [score_zero_right]
    exact not_lt_of_ge (score_nonneg_of_nonnegative (husers i) (hsupport hq))
  have hstrict : μ.real {q : Content D |
      score (users i) q < score (users i) (0 : Content D)} = 0 := by
    apply (MeasureTheory.measureReal_eq_zero_iff
      (μ := μ) (s := {q : Content D |
        score (users i) q < score (users i) (0 : Content D)})).mpr
    simpa only [not_not] using (ae_iff.mp hstrict_ae)
  rw [hstrict]
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  exact zero_pow (Nat.sub_ne_zero_iff_lt.mpr hP_nat)

/--
Corrected Proposition `zeroutilitysinglegenre` endpoint.  Once a source
mixed-Nash law has zero in its topological support and has tie-null score
laws, its actual uniform-tie payoff is zero at every support action.  The
single-genre-to-these-premises bridge is deliberately not hidden here.
-/
theorem sourceSymmetricMixedNash_supportPayoff_eq_zero_of_zero_mem_support
    {D N P : ℕ} [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} {j : Fin P} {p : Content D}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (hzero : (0 : Content D) ∈ μ.support)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hmeas_score : ∀ i : Fin N,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin N) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0)
    (hcost_zero : cost (0 : Content D) = 0)
    (hp : p ∈ μ.support) :
    SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
      cost p μ = 0 := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  have hzero_expected :
      ExpectedUsersWonAgainstSymmetricMixed users j (0 : Content D) μ = 0 :=
    expectedUsersWonAgainstSymmetricMixed_zero_eq_zero_of_nonnegative_support
      hnash.2.1 husers hmeas_score hno_atom
  have hzero_payoff :
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
        cost (0 : Content D) μ = 0 := by
    unfold SourceMixedPurePayoff
    rw [hzero_expected, hcost_zero]
    norm_num
  have hzero_le :
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
          cost (0 : Content D) μ ≤
        SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
          cost p μ :=
    hnash.2.2 j p hp (0 : Content D) zeroContent_nonnegative
  have hle_zero :
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
          cost p μ ≤
        SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
          cost (0 : Content D) μ :=
    hnash.2.2 j (0 : Content D) hzero p (hnash.2.1 hp)
  rw [hzero_payoff] at hzero_le hle_zero
  linarith

/--
Corrected Proposition `zeroutilitysinglegenre` payoff endpoint with the
score-law tie-nullness premise discharged internally.  Under the paper's
source mixed-Nash definition, positive score-level mass would permit the
profitable perturbation formalized above, so nonzero users make all score laws
tie-null automatically.
-/
theorem sourceSymmetricMixedNash_supportPayoff_eq_zero_of_zero_mem_support_of_nonzero_users
    {D N P : ℕ} [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} {j : Fin P} {p : Content D}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (hzero_support : (0 : Content D) ∈ μ.support)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcont : PerturbationCostContinuous cost)
    (hcost_zero : cost (0 : Content D) = 0)
    (hp : p ∈ μ.support) :
    SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
      cost p μ = 0 := by
  apply sourceSymmetricMixedNash_supportPayoff_eq_zero_of_zero_mem_support
    hnash hzero_support husers
    (fun i => measurable_score_content (users i))
    (fun i z =>
      sourceSymmetricMixedNash_score_level_measure_eq_zero
        (i0 := i) (j := j) hnash husers (husers_nonzero i) hcont z)
    hcost_zero hp

/--
At every support radius of an atomless corrected singleton-genre equilibrium
whose zero action is supported, the scalar source-norm CDF satisfies the exact
payoff equation.  This is the valid support-radius precursor to the source's
claimed closed CDF: proving its extension across gaps remains a separate
topological/distributional obligation.
-/
theorem sourceSymmetricMixedNash_support_normCdf_payoff_equation_of_singleton_nonzeroSupportGenres
    {D N P : ℕ} [Nontrivial (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {j : Fin P} {p genre : Content D} {β : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ)
    (hzero : (0 : Content D) ∈ μ.support)
    (hno_atoms : MeasureTheory.NoAtoms μ)
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hgenre_score : ∀ i : Fin N, 0 < score (users i) genre)
    (hmeas_norm : Measurable ν.norm)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hβ : 0 < β)
    (hp : p ∈ μ.support) :
    (∑ i : Fin N,
      ((Measure.map ν.norm μ).real (Set.Iic (ν.norm p))) ^ (P - 1)) =
        (ν.norm p) ^ β := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  letI : MeasureTheory.NoAtoms μ := hno_atoms
  have hpayoff_zero :
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j)
        (normRpowCost ν β) p μ = 0 :=
    sourceSymmetricMixedNash_supportPayoff_eq_zero_of_zero_mem_support
      hnash hzero husers
      (fun i => measurable_score_content (users i))
      (fun i z =>
        score_level_measure_eq_zero_of_noAtoms_of_singleton_nonzeroSupportGenres
          hgenres (hgenre_score i) z)
      (normRpowCost_zero ν hβ) hp
  have hexpected :=
    expectedUsersWonAgainstSymmetricMixed_eq_sum_sourceNormLowerCdfMass_of_mem_support_of_singleton_nonzeroSupportGenres
      (users := users) (j := j) (ν := ν) hgenres hmeas_norm hgenre_score hp
  unfold SourceMixedPurePayoff normRpowCost at hpayoff_zero
  rw [hexpected] at hpayoff_zero
  linarith

/--
The preceding support-radius equation written in the paper's scalar form:
the same source-norm lower-CDF mass appears once for each of the `N` users.
This still holds only at represented support radii until a no-gap argument is
provided.
-/
theorem sourceSymmetricMixedNash_support_normCdf_power_equation_of_singleton_nonzeroSupportGenres
    {D N P : ℕ} [Nontrivial (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {j : Fin P} {p genre : Content D} {β : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ)
    (hzero : (0 : Content D) ∈ μ.support)
    (hno_atoms : MeasureTheory.NoAtoms μ)
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hgenre_score : ∀ i : Fin N, 0 < score (users i) genre)
    (hmeas_norm : Measurable ν.norm)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hβ : 0 < β)
    (hp : p ∈ μ.support) :
    (N : ℝ) * ((Measure.map ν.norm μ).real (Set.Iic (ν.norm p))) ^ (P - 1) =
      (ν.norm p) ^ β := by
  rw [← sourceSymmetricMixedNash_support_normCdf_payoff_equation_of_singleton_nonzeroSupportGenres
    (j := j) hnash hzero hno_atoms hgenres hgenre_score hmeas_norm husers hβ hp]
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, Fintype.card_fin]

/--
A content-law support whose finite-coordinate Euclidean norm is uniformly
bounded is compact.  This is a topological fact about the concrete `L2`
source norm, not an implicit property of an arbitrary `SourceNorm`.
-/
theorem isCompact_content_support_of_l2_bound
    {D : ℕ} (μ : MeasureTheory.Measure (Content D)) {R : ℝ}
    (hR : 0 ≤ R)
    (hbound : ∀ p : Content D, p ∈ μ.support → (SourceNorm.l2 D).norm p ≤ R) :
    IsCompact μ.support := by
  apply AppliedModelingLib.FiniteDimensionalNorms.isCompact_of_isClosed_of_bounded
    μ.isClosed_support
  rw [Metric.isBounded_iff_subset_closedBall (0 : Content D)]
  refine ⟨R, ?_⟩
  intro p hp
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg hR).mpr
  intro d
  rw [Real.norm_eq_abs]
  exact (AppliedModelingLib.FiniteDimensionalNorms.abs_le_l2 p d).trans (hbound p hp)

/--
Every represented source-Nash action is below the elementary payoff cap
`N^(1 / beta)`.  Unlike the scalar-CDF cap used later in the paper's
single-genre route, this argument is direct: zero is a feasible outside
option with nonnegative payoff, while an action above the cap costs more than
the total possible user mass.  Thus it neither presupposes zero support nor
any atomlessness or singleton-genre geometry.
-/
theorem sourceSymmetricMixedNash_support_norm_le_supportCap_of_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {j : Fin P} {p : Content D} {β : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ)
    (hβ : 0 < β)
    (hp : p ∈ μ.support) :
    ν.norm p ≤ (N : ℝ) ^ β⁻¹ := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  have hpayoff_nonneg :
      0 ≤ SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β) p μ := by
    exact le_trans
      (sourceMixedPurePayoff_zero_nonneg_of_normRpowCost ν hβ)
      (hnash.2.2 j p hp (0 : Content D) zeroContent_nonnegative)
  by_contra hnot
  have hcap : (N : ℝ) ^ β⁻¹ < ν.norm p := lt_of_not_ge hnot
  have hcost : (N : ℝ) < normRpowCost ν β p :=
    normRpowCost_gt_card_of_support_cap_lt_norm ν hβ hcap
  have hupper :
      SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β) p μ ≤
        (N : ℝ) - normRpowCost ν β p :=
    sourceMixedPurePayoff_le_card_sub_normRpowCost
      (users := users) (j := j) (μ := μ) ν (β := β) (p := p)
      (integrable_usersWon_deviateProfile_const users j p)
  linarith

/--
For a source norm with compact sublevels, the direct Nash payoff cap already
makes the whole topological support compact.  This is intentionally stated
without any singleton-genre, no-atom, or zero-support premise, since none is
needed for the boundedness argument.
-/
theorem sourceSymmetricMixedNash_isCompact_support_of_compactSublevels_of_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {j : Fin P} {β : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ)
    (hβ : 0 < β)
    (hcompact_sublevels : SourceNormCompactSublevels ν) :
    IsCompact μ.support := by
  apply (hcompact_sublevels ((N : ℝ) ^ β⁻¹)).of_isClosed_subset
    μ.isClosed_support
  intro p hp
  exact sourceSymmetricMixedNash_support_norm_le_supportCap_of_normRpowCost
    (j := j) hnash hβ hp

/--
The direct source-Nash payoff cap also applies to a positive multiplicative
cost scale.  This is stated separately rather than absorbing `α` into the
norm: the induced-cost calculation for the canonical two-user model retains
that scale explicitly.
-/
theorem sourceSymmetricMixedNash_support_norm_le_scaled_supportCap_of_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {j : Fin P} {p : Content D} {α β : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users
      (fun q => α * normRpowCost ν β q) μ)
    (hα : 0 < α) (hβ : 0 < β)
    (hp : p ∈ μ.support) :
    ν.norm p ≤ ((N : ℝ) / α) ^ β⁻¹ := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  have hpayoff_nonneg :
      0 ≤ SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j)
        (fun q => α * normRpowCost ν β q) p μ := by
    apply le_trans ?_ (hnash.2.2 j p hp (0 : Content D) zeroContent_nonnegative)
    unfold SourceMixedPurePayoff
    have husers :
        0 ≤ ExpectedUsersWonAgainstSymmetricMixed users j (0 : Content D) μ :=
      expectedUsersWonAgainstSymmetricMixed_nonneg
    simp [normRpowCost_zero ν hβ, husers]
  by_contra hnot
  have hcap : ((N : ℝ) / α) ^ β⁻¹ < ν.norm p := lt_of_not_ge hnot
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hbase_pos : 0 < (N : ℝ) / α := div_pos hN_pos hα
  have hβ_ne : β ≠ 0 := ne_of_gt hβ
  have hcap_nonneg : 0 ≤ ((N : ℝ) / α) ^ β⁻¹ :=
    Real.rpow_nonneg hbase_pos.le _
  have hcap_pow : (((N : ℝ) / α) ^ β⁻¹) ^ β = (N : ℝ) / α := by
    rw [← Real.rpow_mul hbase_pos.le]
    have hmul : β⁻¹ * β = 1 := by field_simp [hβ_ne]
    rw [hmul, Real.rpow_one]
  have hpow_lt : (((N : ℝ) / α) ^ β⁻¹) ^ β < (ν.norm p) ^ β :=
    Real.rpow_lt_rpow hcap_nonneg hcap hβ
  have hcost : (N : ℝ) / α < normRpowCost ν β p := by
    simpa [normRpowCost, hcap_pow] using hpow_lt
  have hscaledcost : (N : ℝ) < α * normRpowCost ν β p := by
    calc
      (N : ℝ) = α * ((N : ℝ) / α) := by field_simp [ne_of_gt hα]
      _ < α * normRpowCost ν β p := mul_lt_mul_of_pos_left hcost hα
  have hupper :
      SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j)
          (fun q => α * normRpowCost ν β q) p μ ≤
        (N : ℝ) - α * normRpowCost ν β p := by
    unfold SourceMixedPurePayoff
    have husers :
        ExpectedUsersWonAgainstSymmetricMixed users j p μ ≤ (N : ℝ) :=
      expectedUsersWonAgainstSymmetricMixed_le_card (users := users)
        (j := j) (p := p) (μ := μ)
        (integrable_usersWon_deviateProfile_const users j p)
    linarith
  linarith

/--
Positive scaled norm-power source Nash laws have compact support whenever the
underlying source norm has compact sublevels.  The cap above is global and so
does not require singleton-genre, no-atom, or interior-support assumptions.
-/
theorem sourceSymmetricMixedNash_isCompact_support_of_compactSublevels_of_scaledNormRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {j : Fin P} {α β : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users
      (fun q => α * normRpowCost ν β q) μ)
    (hα : 0 < α) (hβ : 0 < β)
    (hcompact_sublevels : SourceNormCompactSublevels ν) :
    IsCompact μ.support := by
  apply (hcompact_sublevels (((N : ℝ) / α) ^ β⁻¹)).of_isClosed_subset
    μ.isClosed_support
  intro p hp
  exact sourceSymmetricMixedNash_support_norm_le_scaled_supportCap_of_normRpowCost
    (j := j) hnash hα hβ hp

/--
The zero action is genuinely forced into support in the corrected singleton
nonzero-genre model once the source norm is continuous with compact sublevels.
The proof is separate from the source's asserted CDF: minimize the norm on the
now-compact support, use content atomlessness to show that the minimum radius
has zero lower-CDF mass, and compare its negative cost with the feasible zero
outside option.  This discharges rather than assumes the source's omitted
zero-support step.
-/
theorem sourceSymmetricMixedNash_zero_mem_support_of_compactSublevels_of_singleton_nonzeroSupportGenres
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {j : Fin P} {genre : Content D} {β : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ)
    (hno_atoms : MeasureTheory.NoAtoms μ)
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hgenre_score : ∀ i : Fin N, 0 < score (users i) genre)
    (hmeas_norm : Measurable ν.norm)
    (hβ : 0 < β)
    (hcompact_sublevels : SourceNormCompactSublevels ν)
    (hcontinuous : Continuous ν.norm) :
    (0 : Content D) ∈ μ.support := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  letI : MeasureTheory.NoAtoms μ := hno_atoms
  have hcompact : IsCompact μ.support :=
    sourceSymmetricMixedNash_isCompact_support_of_compactSublevels_of_normRpowCost
      (j := j) hnash hβ hcompact_sublevels
  obtain ⟨pmin, hpmin, hmin⟩ := hcompact.exists_isMinOn
    (MeasureTheory.Measure.nonempty_support
      (MeasureTheory.IsProbabilityMeasure.ne_zero μ))
    hcontinuous.continuousOn
  have hcdf_zero :
      (Measure.map ν.norm μ).real (Set.Iic (ν.norm pmin)) = 0 := by
    rw [MeasureTheory.Measure.real, Measure.map_apply hmeas_norm measurableSet_Iic]
    have hlevel : μ {q : Content D | ν.norm q = ν.norm pmin} = 0 :=
      sourceNorm_level_measure_eq_zero_of_noAtoms_of_singleton_nonzeroSupportGenres
        hgenres (ν.norm pmin)
    have hcomplement : μ μ.supportᶜ = 0 :=
      MeasureTheory.Measure.measure_compl_support
    have hmeasure : μ {q : Content D | ν.norm q ≤ ν.norm pmin} = 0 := by
      refine MeasureTheory.measure_mono_null ?_
        (MeasureTheory.measure_union_null hlevel hcomplement)
      intro q hq
      by_cases hq_support : q ∈ μ.support
      · left
        change ν.norm q = ν.norm pmin
        exact le_antisymm hq (hmin hq_support)
      · right
        exact hq_support
    change (μ {q : Content D | ν.norm q ≤ ν.norm pmin}).toReal = 0
    rw [hmeasure]
    norm_num
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hpower_zero :
      ((Measure.map ν.norm μ).real (Set.Iic (ν.norm pmin))) ^ (P - 1) = 0 := by
    rw [hcdf_zero]
    exact zero_pow (Nat.sub_ne_zero_iff_lt.mpr hP_nat)
  have hexpected : ExpectedUsersWonAgainstSymmetricMixed users j pmin μ = 0 := by
    rw [expectedUsersWonAgainstSymmetricMixed_eq_sum_sourceNormLowerCdfMass_of_mem_support_of_singleton_nonzeroSupportGenres
      (users := users) (j := j) (ν := ν) hgenres hmeas_norm hgenre_score hpmin]
    simp [hpower_zero]
  have hpayoff_nonneg :
      0 ≤ SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β) pmin μ := by
    exact le_trans
      (sourceMixedPurePayoff_zero_nonneg_of_normRpowCost ν hβ)
      (hnash.2.2 j pmin hpmin (0 : Content D) zeroContent_nonnegative)
  have hcost_zero : normRpowCost ν β pmin = 0 := by
    unfold SourceMixedPurePayoff at hpayoff_nonneg
    rw [hexpected] at hpayoff_nonneg
    have hcost_nonneg : 0 ≤ normRpowCost ν β pmin := by
      unfold normRpowCost
      exact Real.rpow_nonneg (ν.nonneg pmin) β
    linarith
  have hnorm_zero : ν.norm pmin = 0 := by
    apply (Real.rpow_eq_zero (ν.nonneg pmin) (ne_of_gt hβ)).mp
    simpa [normRpowCost] using hcost_zero
  have hpmin_eq_zero : pmin = 0 := by
    apply content_eq_zero_of_not_nonzeroContent
    intro hpmin_nonzero
    exact (ne_of_gt (ν.pos_of_nonzero hpmin_nonzero)) hnorm_zero
  simpa [hpmin_eq_zero] using hpmin

/--
Every represented support action of the corrected singleton-genre equilibrium
lies below the source radius cap `N^(1 / beta)`.  The proof uses the exact
support-radius equation and the probability bound on the scalar norm CDF; it
does not assume compactness of the content support.
-/
theorem sourceSymmetricMixedNash_support_norm_le_supportCap_of_singleton_nonzeroSupportGenres
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {j : Fin P} {p genre : Content D} {β : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ)
    (hzero : (0 : Content D) ∈ μ.support)
    (hno_atoms : MeasureTheory.NoAtoms μ)
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hgenre_score : ∀ i : Fin N, 0 < score (users i) genre)
    (hmeas_norm : Measurable ν.norm)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hβ : 0 < β)
    (hp : p ∈ μ.support) :
    ν.norm p ≤ (N : ℝ) ^ β⁻¹ := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  letI : MeasureTheory.IsProbabilityMeasure (Measure.map ν.norm μ) :=
    MeasureTheory.Measure.isProbabilityMeasure_map hmeas_norm.aemeasurable
  have hequation :=
    sourceSymmetricMixedNash_support_normCdf_power_equation_of_singleton_nonzeroSupportGenres
      (j := j) hnash hzero hno_atoms hgenres hgenre_score hmeas_norm husers hβ hp
  by_contra hnot
  have hcap : (N : ℝ) ^ β⁻¹ < ν.norm p := lt_of_not_ge hnot
  have hcost : (N : ℝ) < (ν.norm p) ^ β := by
    simpa [normRpowCost] using
      (normRpowCost_gt_card_of_support_cap_lt_norm ν hβ hcap)
  have hcdf_nonneg : 0 ≤
      AppliedModelingLib.Probability.lowerCDFMass (Measure.map ν.norm μ) (ν.norm p) :=
    MeasureTheory.measureReal_nonneg
  have hcdf_le_one :
      AppliedModelingLib.Probability.lowerCDFMass (Measure.map ν.norm μ) (ν.norm p) ≤ 1 :=
    AppliedModelingLib.Probability.lowerCDFMass_le_one (Measure.map ν.norm μ) _
  have hpower_le_one :
      (AppliedModelingLib.Probability.lowerCDFMass (Measure.map ν.norm μ) (ν.norm p)) ^
          (P - 1) ≤ 1 :=
    pow_le_one₀ hcdf_nonneg hcdf_le_one
  have hleft_le :
      (N : ℝ) *
          (AppliedModelingLib.Probability.lowerCDFMass (Measure.map ν.norm μ) (ν.norm p)) ^
            (P - 1) ≤ (N : ℝ) := by
    calc
      (N : ℝ) *
          (AppliedModelingLib.Probability.lowerCDFMass (Measure.map ν.norm μ) (ν.norm p)) ^
            (P - 1) ≤ (N : ℝ) * 1 :=
        mul_le_mul_of_nonneg_left hpower_le_one (Nat.cast_nonneg N)
      _ = (N : ℝ) := mul_one _
  change (N : ℝ) *
