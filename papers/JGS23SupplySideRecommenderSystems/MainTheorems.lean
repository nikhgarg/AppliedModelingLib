-/
theorem twoGenre_caseTwo_contradiction_of_ordered_angle_density_equations
    {F1 f2 : ℝ → ℝ} {μ1 : MeasureTheory.Measure ℝ}
    [MeasureTheory.IsProbabilityMeasure μ1]
    {α1 α2 C1 C2 q r1 r2 θ1 θ2 θstar : ℝ}
    (hr1 : 0 < r1) (hθ1_pos : 0 < θ1) (hθ1_lt : θ1 < θstar / 2)
    (hθ2_lt_star : θ2 < θstar) (hhalf_lt_θ2 : θstar / 2 < θ2)
    (hθstar_le : θstar ≤ Real.pi / 2)
    (hsecond_cap : r1 * Real.cos (θstar - θ1) <
      r2 * Real.cos (θstar - θ2))
    (hα1 : 0 ≤ α1)
    (hdensity2 : ∀ z : ℝ,
      0 < z / Real.cos (θstar - θ2) → z / Real.cos (θstar - θ2) < r2 →
        α1 / Real.cos (θstar - θ1) * deriv F1 (z / Real.cos (θstar - θ1)) +
          α2 / Real.cos (θstar - θ2) * f2 (z / Real.cos (θstar - θ2)) =
            C2 * q * z ^ (q - 1))
    (hF1 : F1 = AppliedModelingLib.Probability.lowerCDFMass μ1)
    (hsupp1 : μ1.support ⊆ Set.Iic r1)
    (hdensity1 : ∀ z : ℝ,
      0 < z / Real.cos θ1 → z / Real.cos θ1 < r1 →
        α1 / Real.cos θ1 * deriv F1 (z / Real.cos θ1) +
          α2 / Real.cos θ2 * f2 (z / Real.cos θ2) =
            C1 * q * z ^ (q - 1))
    (hq : 0 < q)
    (hcoeff : C1 < C2 *
      (Real.cos (θstar - θ2) / Real.cos θ2) ^ q) :
    False := by
  obtain ⟨hfirst, hsecond⟩ := twoGenre_caseTwo_cos_ratio_bounds_of_angles
    hθ1_pos hθ1_lt hθ2_lt_star hhalf_lt_θ2 hθstar_le
  have hθ1_lt_half_pi : θ1 < Real.pi / 2 := by
    linarith [Real.pi_pos]
  have hθ2_pos : 0 < θ2 := by
    linarith [Real.pi_pos]
  have hθ2_lt_half_pi : θ2 < Real.pi / 2 := by
    linarith [Real.pi_pos]
  have hdelta1_pos : 0 < θstar - θ1 := by
    linarith [Real.pi_pos]
  have hdelta1_lt_half_pi : θstar - θ1 < Real.pi / 2 := by
    linarith [Real.pi_pos]
  have hdelta2_pos : 0 < θstar - θ2 := sub_pos.mpr hθ2_lt_star
  have hdelta2_lt_half_pi : θstar - θ2 < Real.pi / 2 := by
    linarith [Real.pi_pos]
  have hc1 : 0 < Real.cos θ1 :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ1_lt_half_pi⟩
  have hc2 : 0 < Real.cos θ2 :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ2_lt_half_pi⟩
  have hd1 : 0 < Real.cos (θstar - θ1) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdelta1_lt_half_pi⟩
  have hd2 : 0 < Real.cos (θstar - θ2) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdelta2_lt_half_pi⟩
  exact twoGenre_caseTwo_contradiction_of_interior_density_equations
    hr1.le hc1 hc2 hd1 hd2 hα1 hsecond_cap
    (twoGenre_caseTwo_lower_lt_first_cap_scaled hr1 hc1 hfirst hsecond)
    hdensity2 hF1 hsupp1 hdensity1 hq hcoeff

/--
The ordered reward coefficients force the second user's support maximum to be
attained on the second genre.  Otherwise that endpoint is strictly smaller
than the first user's endpoint, while both reward power laws equal one at
their endpoints; `C₂ ≤ C₁` and `β > 0` then give the impossible strict
inequality `1 < 1`.  This formalizes the source's displayed `r1max` argument.
-/
theorem twoGenre_second_cap_strict_of_reward_coefficient_order
    {P : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta theta1 theta2 β C1 C2 B1 B2 r1 r2 : ℝ}
    (hβ : 0 < β) (hC2 : 0 < C2) (hC : C2 ≤ C1)
    (hr1 : 0 < r1)
    (hθ1_pos : 0 < theta1) (hθ1_lt : theta1 < theta / 2)
    (hθ_le : theta ≤ Real.pi / 2)
    (hc1 : 0 < Real.cos theta1)
    (hd1 : 0 < Real.cos (theta - theta1))
    (hfirst_support :
      (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu).support =
        Set.Icc 0 B1)
    (hsecond_support :
      (Measure.map
        (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu).support =
        Set.Icc 0 B2)
    (hB1 : B1 = max (r1 * Real.cos theta1) (r2 * Real.cos theta2))
    (hB2 : B2 = max (r1 * Real.cos (theta - theta1))
      (r2 * Real.cos (theta - theta2)))
    (hreward1 : Set.EqOn
      (fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) z)
      (fun z => C1 * z ^ β) (Set.Icc 0 B1))
    (hreward2 : Set.EqOn
      (fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map
          (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) z)
      (fun z => C2 * z ^ β) (Set.Icc 0 B2)) :
    r1 * Real.cos (theta - theta1) <
      r2 * Real.cos (theta - theta2) := by
  let mu1 : Measure ℝ :=
    Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu
  let mu2 : Measure ℝ :=
    Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu
  letI : IsProbabilityMeasure mu1 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  letI : IsProbabilityMeasure mu2 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond theta)).aemeasurable
  have hB1pos : 0 < B1 := by
    rw [hB1]
    exact (mul_pos hr1 hc1).trans_le (le_max_left _ _)
  have hB2pos : 0 < B2 := by
    rw [hB2]
    exact (mul_pos hr1 hd1).trans_le (le_max_left _ _)
  have hH1one :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) mu1 B1 = 1 := by
    rw [AppliedModelingLib.Probability.iidMaximumCdf_eq_lowerCDFMass_pow,
      AppliedModelingLib.Probability.lowerCDFMass_eq_one_of_support_subset_Iic mu1, one_pow]
    · intro x hx
      rw [show mu1.support = Set.Icc 0 B1 by
        simpa [mu1] using hfirst_support] at hx
      exact hx.2
    · exact le_rfl
  have hH2one :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) mu2 B2 = 1 := by
    rw [AppliedModelingLib.Probability.iidMaximumCdf_eq_lowerCDFMass_pow,
      AppliedModelingLib.Probability.lowerCDFMass_eq_one_of_support_subset_Iic mu2, one_pow]
    · intro x hx
      rw [show mu2.support = Set.Icc 0 B2 by
        simpa [mu2] using hsecond_support] at hx
      exact hx.2
    · exact le_rfl
  have hC1B : C1 * B1 ^ β = 1 := by
    calc
      C1 * B1 ^ β =
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) mu1 B1 := by
        simpa [mu1] using (hreward1 ⟨hB1pos.le, le_rfl⟩).symm
      _ = 1 := hH1one
  have hC2B : C2 * B2 ^ β = 1 := by
    calc
      C2 * B2 ^ β =
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) mu2 B2 := by
        simpa [mu2] using (hreward2 ⟨hB2pos.le, le_rfl⟩).symm
      _ = 1 := hH2one
  by_contra hcap
  have hcap_le : r2 * Real.cos (theta - theta2) ≤
      r1 * Real.cos (theta - theta1) := le_of_not_gt hcap
  have hd1_lt_c1 : Real.cos (theta - theta1) < Real.cos theta1 := by
    have hratio := cos_div_cos_sub_gt_one_of_lt_half
      hθ1_pos.le hθ1_pos hθ1_lt hθ_le
    exact (one_lt_div₀ hd1).mp hratio
  have hB2eq : B2 = r1 * Real.cos (theta - theta1) := by
    rw [hB2, max_eq_left hcap_le]
  have hB1lower : r1 * Real.cos theta1 ≤ B1 := by
    rw [hB1]
    exact le_max_left _ _
  have hBlt : B2 < B1 := by
    rw [hB2eq]
    exact (mul_lt_mul_of_pos_left hd1_lt_c1 hr1).trans_le hB1lower
  have hpow_lt : B2 ^ β < B1 ^ β :=
    Real.rpow_lt_rpow hB2pos.le hBlt hβ
  have hprod_lt : C2 * B2 ^ β < C1 * B1 ^ β :=
    (mul_lt_mul_of_pos_left hpow_lt hC2).trans_le
      (mul_le_mul_of_nonneg_right hC (Real.rpow_nonneg hB1pos.le β))
  rw [hC2B, hC1B] at hprod_lt
  exact (lt_irrefl 1 hprod_lt).elim

/--
Complete two-genre Step 2 of Proposition `finitegenre` under the source's
ordered-angle normalization and WLOG reward-coefficient order.  Starting from
the actual conditional radial laws and the two maximum-reward power laws, the
proof derives compact radial caps, exact score endpoints, both CDF-mixture
identities, both density equations, the strict second-cap comparison, and the
corrected Case-2 score selection before obtaining the source coefficient
contradiction.  No displayed density equation or support cap is assumed.
-/
theorem twoGenre_contradiction_of_ordered_rewardPowerLaws
    {P : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta theta1 theta2 β C1 C2 B1 B2 : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hP : 1 < P) (hβ : 0 < β)
    (hC1 : 0 < C1) (hC2 : 0 < C2) (hC : C2 ≤ C1)
    (hθ1_pos : 0 < theta1) (hθ1_lt : theta1 < theta / 2)
    (hθ2_lt : theta2 < theta) (hhalf_lt_θ2 : theta / 2 < theta2)
    (hθ_le : theta ≤ Real.pi / 2)
    (hcompact : IsCompact mu.support)
    (hfirst_support :
      (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu).support =
        Set.Icc 0 B1)
    (hsecond_support :
      (Measure.map
        (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu).support =
        Set.Icc 0 B2)
    (hreward1 : Set.EqOn
      (fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) z)
      (fun z => C1 * z ^ β) (Set.Icc 0 B1))
    (hreward2 : Set.EqOn
      (fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map
          (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) z)
      (fun z => C2 * z ^ β) (Set.Icc 0 B2))
    (hformula : C1 / C2 =
      Real.sin (theta - theta2) / Real.sin theta2 *
        (Real.cos (theta - theta2)) ^ (β - 1) /
          (Real.cos theta2) ^ (β - 1)) :
    False := by
  have htheta_pos : 0 < theta := by linarith
  have hθ1_lt_half_pi : theta1 < Real.pi / 2 := by linarith
  have hθ2_pos : 0 < theta2 := by linarith
  have hθ2_lt_half_pi : theta2 < Real.pi / 2 := by linarith
  have hdelta1_pos : 0 < theta - theta1 := by linarith
  have hdelta1_lt_half_pi : theta - theta1 < Real.pi / 2 := by linarith
  have hdelta2_pos : 0 < theta - theta2 := sub_pos.mpr hθ2_lt
  have hdelta2_lt_half_pi : theta - theta2 < Real.pi / 2 := by linarith
  have hc1 : 0 < Real.cos theta1 :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ1_lt_half_pi⟩
  have hc2 : 0 < Real.cos theta2 :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ2_lt_half_pi⟩
  have hd1 : 0 < Real.cos (theta - theta1) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdelta1_lt_half_pi⟩
  have hd2 : 0 < Real.cos (theta - theta2) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdelta2_lt_half_pi⟩
  obtain ⟨r1, r2, hr1, _hr2, hsupp1, _hsupp2, _hr1mem, _hr2mem, hB1, hB2⟩ :=
    law.exists_caps_and_score_endpoints hcompact hc1 hc2 hd1 hd2
      hfirst_support hsecond_support
  have hsecond_cap : r1 * Real.cos (theta - theta1) <
      r2 * Real.cos (theta - theta2) :=
    twoGenre_second_cap_strict_of_reward_coefficient_order
      hβ hC2 hC hr1 hθ1_pos hθ1_lt hθ_le hc1 hd1
      hfirst_support hsecond_support hB1 hB2 hreward1 hreward2
  let p : ℝ := ((P - 1 : ℕ) : ℝ)
  let q : ℝ := β / p
  let A1 : ℝ := C1 ^ p⁻¹
  let A2 : ℝ := C2 ^ p⁻¹
  have hp_nat : 0 < P - 1 := Nat.sub_pos_of_lt hP
  have hp : 0 < p := by
    dsimp [p]
    exact_mod_cast hp_nat
  have hq : 0 < q := div_pos hβ hp
  have hcoeff : A1 < A2 *
      (Real.cos (theta - theta2) / Real.cos theta2) ^ q := by
    have hraw := twoGenre_caseTwo_root_coefficient_lt_of_source_formula
      hC1 hC2 hp hθ2_pos hdelta2_pos (by linarith) hθ2_lt_half_pi hformula
    simpa [A1, A2, q, one_div] using hraw
  let F1 := AppliedModelingLib.Probability.lowerCDFMass law.radial1
  let f2 := deriv (AppliedModelingLib.Probability.lowerCDFMass law.radial2)
  letI : IsProbabilityMeasure law.radial1 := law.radial1_probability
  letI : IsProbabilityMeasure law.radial2 := law.radial2_probability
  apply twoGenre_caseTwo_contradiction_of_ordered_angle_density_equations
    (F1 := F1) (f2 := f2) (μ1 := law.radial1)
    (α1 := law.weight1) (α2 := law.weight2)
    (C1 := A1) (C2 := A2) (q := q) (r1 := r1) (r2 := r2)
    hr1 hθ1_pos hθ1_lt hθ2_lt hhalf_lt_θ2 hθ_le hsecond_cap
    law.weight1_pos.le
  · intro z hzpos hzcap
    have hzpos' : 0 < z := by
      calc
        0 < (z / Real.cos (theta - theta2)) *
            Real.cos (theta - theta2) := mul_pos hzpos hd2
        _ = z := by field_simp [hd2.ne']
    have hzlt : z < B2 := by
      have hzscaled : z < r2 * Real.cos (theta - theta2) :=
        (div_lt_iff₀ hd2).mp hzcap
      exact hzscaled.trans_le (by rw [hB2]; exact le_max_right _ _)
    simpa [F1, f2, A2, q, p, mul_assoc] using
      (twoGenre_secondDensity_eq_of_rewardPowerLaw law hP hC2.le hd1 hd2
        ⟨hzpos', hzlt⟩ hreward2)
  · rfl
  · intro r hr
    exact (hsupp1 hr).2
  · intro z hzpos hzcap
    have hzpos' : 0 < z := by
      calc
        0 < (z / Real.cos theta1) * Real.cos theta1 := mul_pos hzpos hc1
        _ = z := by field_simp [hc1.ne']
    have hzlt : z < B1 := by
      have hzscaled : z < r1 * Real.cos theta1 :=
        (div_lt_iff₀ hc1).mp hzcap
      exact hzscaled.trans_le (by rw [hB1]; exact le_max_left _ _)
    simpa [F1, f2, A1, q, p, mul_assoc] using
      (twoGenre_firstDensity_eq_of_rewardPowerLaw law hP hC1.le hc1 hc2
        ⟨hzpos', hzlt⟩ hreward1)
  · exact hq
  · exact hcoeff

/--
Symmetric endpoint comparison for the reverse reward-coefficient order.  If
`C₁ ≤ C₂`, the first user's score maximum must be attained on the first genre;
otherwise its endpoint is strictly below the second user's endpoint and the
two endpoint-normalized reward power laws again imply `1 < 1`.
-/
theorem twoGenre_first_cap_strict_of_reward_coefficient_order
    {P : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta theta1 theta2 β C1 C2 B1 B2 r1 r2 : ℝ}
    (hβ : 0 < β) (hC1 : 0 < C1) (hC : C1 ≤ C2)
    (hr2 : 0 < r2)
    (hhalf_lt_θ2 : theta / 2 < theta2) (hθ2_lt : theta2 < theta)
    (hθ_le : theta ≤ Real.pi / 2)
    (hc2 : 0 < Real.cos theta2)
    (hd2 : 0 < Real.cos (theta - theta2))
    (hfirst_support :
      (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu).support =
        Set.Icc 0 B1)
    (hsecond_support :
      (Measure.map
        (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu).support =
        Set.Icc 0 B2)
    (hB1 : B1 = max (r1 * Real.cos theta1) (r2 * Real.cos theta2))
    (hB2 : B2 = max (r1 * Real.cos (theta - theta1))
      (r2 * Real.cos (theta - theta2)))
    (hreward1 : Set.EqOn
      (fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) z)
      (fun z => C1 * z ^ β) (Set.Icc 0 B1))
    (hreward2 : Set.EqOn
      (fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map
          (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) z)
      (fun z => C2 * z ^ β) (Set.Icc 0 B2)) :
    r2 * Real.cos theta2 < r1 * Real.cos theta1 := by
  let mu1 : Measure ℝ :=
    Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu
  let mu2 : Measure ℝ :=
    Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu
  letI : IsProbabilityMeasure mu1 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  letI : IsProbabilityMeasure mu2 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond theta)).aemeasurable
  have hB1pos : 0 < B1 := by
    rw [hB1]
    exact (mul_pos hr2 hc2).trans_le (le_max_right _ _)
  have hB2pos : 0 < B2 := by
    rw [hB2]
    exact (mul_pos hr2 hd2).trans_le (le_max_right _ _)
  have hH1one :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) mu1 B1 = 1 := by
    rw [AppliedModelingLib.Probability.iidMaximumCdf_eq_lowerCDFMass_pow,
      AppliedModelingLib.Probability.lowerCDFMass_eq_one_of_support_subset_Iic mu1, one_pow]
    · intro x hx
      rw [show mu1.support = Set.Icc 0 B1 by
        simpa [mu1] using hfirst_support] at hx
      exact hx.2
    · exact le_rfl
  have hH2one :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) mu2 B2 = 1 := by
    rw [AppliedModelingLib.Probability.iidMaximumCdf_eq_lowerCDFMass_pow,
      AppliedModelingLib.Probability.lowerCDFMass_eq_one_of_support_subset_Iic mu2, one_pow]
    · intro x hx
      rw [show mu2.support = Set.Icc 0 B2 by
        simpa [mu2] using hsecond_support] at hx
      exact hx.2
    · exact le_rfl
  have hC1B : C1 * B1 ^ β = 1 := by
    calc
      C1 * B1 ^ β =
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) mu1 B1 := by
        simpa [mu1] using (hreward1 ⟨hB1pos.le, le_rfl⟩).symm
      _ = 1 := hH1one
  have hC2B : C2 * B2 ^ β = 1 := by
    calc
      C2 * B2 ^ β =
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) mu2 B2 := by
        simpa [mu2] using (hreward2 ⟨hB2pos.le, le_rfl⟩).symm
      _ = 1 := hH2one
  by_contra hcap
  have hcap_le : r1 * Real.cos theta1 ≤ r2 * Real.cos theta2 :=
    le_of_not_gt hcap
  have hc2_lt_d2 : Real.cos theta2 < Real.cos (theta - theta2) := by
    have hθ2_pos : 0 < theta2 := by linarith
    have hdelta_pos : 0 < theta - theta2 := by linarith
    have hθ2_le_pi : theta2 ≤ Real.pi := by linarith [Real.pi_pos]
    exact Real.cos_lt_cos_of_nonneg_of_le_pi
      hdelta_pos.le hθ2_le_pi (by linarith)
  have hB1eq : B1 = r2 * Real.cos theta2 := by
    rw [hB1, max_eq_right hcap_le]
  have hB2lower : r2 * Real.cos (theta - theta2) ≤ B2 := by
    rw [hB2]
    exact le_max_right _ _
  have hBlt : B1 < B2 := by
    rw [hB1eq]
    exact (mul_lt_mul_of_pos_left hc2_lt_d2 hr2).trans_le hB2lower
  have hpow_lt : B1 ^ β < B2 ^ β :=
    Real.rpow_lt_rpow hB1pos.le hBlt hβ
  have hprod_lt : C1 * B1 ^ β < C2 * B2 ^ β :=
    (mul_lt_mul_of_pos_left hpow_lt hC1).trans_le
      (mul_le_mul_of_nonneg_right hC (Real.rpow_nonneg hB2pos.le β))
  rw [hC1B, hC2B] at hprod_lt
  exact (lt_irrefl 1 hprod_lt).elim

/--
The reverse-coefficient counterpart of
`twoGenre_contradiction_of_ordered_rewardPowerLaws`.  It reflects the two
users and swaps the radial roles inside the already verified Case-2
contradiction, while deriving the reflected first-cap comparison and density
equations from the original laws.  Thus the two coefficient orders together
cover the source's WLOG step without an unformalized symmetry claim.
-/
theorem twoGenre_contradiction_of_reverseOrdered_rewardPowerLaws
    {P : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta theta1 theta2 β C1 C2 B1 B2 : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hP : 1 < P) (hβ : 0 < β)
    (hC1 : 0 < C1) (hC2 : 0 < C2) (hC : C1 ≤ C2)
    (hθ1_pos : 0 < theta1) (hθ1_lt : theta1 < theta / 2)
    (hθ2_lt : theta2 < theta) (hhalf_lt_θ2 : theta / 2 < theta2)
    (hθ_le : theta ≤ Real.pi / 2)
    (hcompact : IsCompact mu.support)
    (hfirst_support :
      (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu).support =
        Set.Icc 0 B1)
    (hsecond_support :
      (Measure.map
        (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu).support =
        Set.Icc 0 B2)
    (hreward1 : Set.EqOn
      (fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) z)
      (fun z => C1 * z ^ β) (Set.Icc 0 B1))
    (hreward2 : Set.EqOn
      (fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map
          (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) z)
      (fun z => C2 * z ^ β) (Set.Icc 0 B2))
    (hformula : C2 / C1 =
      Real.sin theta1 / Real.sin (theta - theta1) *
        (Real.cos theta1) ^ (β - 1) /
          (Real.cos (theta - theta1)) ^ (β - 1)) :
    False := by
  have hθ1_lt_half_pi : theta1 < Real.pi / 2 := by linarith
  have hθ2_pos : 0 < theta2 := by linarith
  have hθ2_lt_half_pi : theta2 < Real.pi / 2 := by linarith
  have hdelta1_pos : 0 < theta - theta1 := by linarith
  have hdelta1_lt_half_pi : theta - theta1 < Real.pi / 2 := by linarith
  have hdelta2_pos : 0 < theta - theta2 := by linarith
  have hdelta2_lt_half_pi : theta - theta2 < Real.pi / 2 := by linarith
  have hc1 : 0 < Real.cos theta1 :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ1_lt_half_pi⟩
  have hc2 : 0 < Real.cos theta2 :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ2_lt_half_pi⟩
  have hd1 : 0 < Real.cos (theta - theta1) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdelta1_lt_half_pi⟩
  have hd2 : 0 < Real.cos (theta - theta2) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdelta2_lt_half_pi⟩
  obtain ⟨r1, r2, _hr1, hr2, _hsupp1, hsupp2, _hr1mem, _hr2mem, hB1, hB2⟩ :=
    law.exists_caps_and_score_endpoints hcompact hc1 hc2 hd1 hd2
      hfirst_support hsecond_support
  have hfirst_cap : r2 * Real.cos theta2 < r1 * Real.cos theta1 :=
    twoGenre_first_cap_strict_of_reward_coefficient_order
      hβ hC1 hC hr2 hhalf_lt_θ2 hθ2_lt hθ_le hc2 hd2
      hfirst_support hsecond_support hB1 hB2 hreward1 hreward2
  let p : ℝ := ((P - 1 : ℕ) : ℝ)
  let q : ℝ := β / p
  let A1 : ℝ := C2 ^ p⁻¹
  let A2 : ℝ := C1 ^ p⁻¹
  have hp_nat : 0 < P - 1 := Nat.sub_pos_of_lt hP
  have hp : 0 < p := by
    dsimp [p]
    exact_mod_cast hp_nat
  have hq : 0 < q := div_pos hβ hp
  have hcoeff : A1 < A2 *
      (Real.cos theta1 / Real.cos (theta - theta1)) ^ q := by
    have hformula' : C2 / C1 =
        Real.sin (theta - (theta - theta1)) / Real.sin (theta - theta1) *
          (Real.cos (theta - (theta - theta1))) ^ (β - 1) /
            (Real.cos (theta - theta1)) ^ (β - 1) := by
      simpa only [sub_sub_cancel] using hformula
    have hraw := twoGenre_caseTwo_root_coefficient_lt_of_source_formula
      (c1 := C2) (c2 := C1) (β := β) (p := p)
      (θ := theta - theta1) (θstar := theta)
      hC2 hC1 hp hdelta1_pos (by simpa only [sub_sub_cancel] using hθ1_pos)
        (by
          simp only [sub_sub_cancel]
          linarith)
        hdelta1_lt_half_pi hformula'
    simpa [A1, A2, q, one_div] using hraw
  let F1 := AppliedModelingLib.Probability.lowerCDFMass law.radial2
  let f2 := deriv (AppliedModelingLib.Probability.lowerCDFMass law.radial1)
  letI : IsProbabilityMeasure law.radial1 := law.radial1_probability
  letI : IsProbabilityMeasure law.radial2 := law.radial2_probability
  apply twoGenre_caseTwo_contradiction_of_ordered_angle_density_equations
    (F1 := F1) (f2 := f2) (μ1 := law.radial2)
    (α1 := law.weight2) (α2 := law.weight1)
    (C1 := A1) (C2 := A2) (q := q) (r1 := r2) (r2 := r1)
    (θ1 := theta - theta2) (θ2 := theta - theta1) (θstar := theta)
    hr2 hdelta2_pos (by linarith) (by linarith) (by linarith) hθ_le
    (by simpa only [sub_sub_cancel] using hfirst_cap) law.weight2_pos.le
  · intro z hzpos hzcap
    simp only [sub_sub_cancel] at hzpos hzcap
    have hzpos' : 0 < z := by
      calc
        0 < (z / Real.cos theta1) * Real.cos theta1 := mul_pos hzpos hc1
        _ = z := by field_simp [hc1.ne']
    have hzlt : z < B1 := by
      have hzscaled : z < r1 * Real.cos theta1 :=
        (div_lt_iff₀ hc1).mp hzcap
      exact hzscaled.trans_le (by rw [hB1]; exact le_max_left _ _)
    simpa [F1, f2, A2, q, p, add_comm, mul_assoc] using
      (twoGenre_firstDensity_eq_of_rewardPowerLaw law hP hC1.le hc1 hc2
        ⟨hzpos', hzlt⟩ hreward1)
  · rfl
  · intro r hr
    exact (hsupp2 hr).2
  · intro z hzpos hzcap
    have hzpos' : 0 < z := by
      calc
        0 < (z / Real.cos (theta - theta2)) *
            Real.cos (theta - theta2) := mul_pos hzpos hd2
        _ = z := by field_simp [hd2.ne']
    have hzlt : z < B2 := by
      have hzscaled : z < r2 * Real.cos (theta - theta2) :=
        (div_lt_iff₀ hd2).mp hzcap
      exact hzscaled.trans_le (by rw [hB2]; exact le_max_right _ _)
    simpa [F1, f2, A1, q, p, add_comm, mul_assoc] using
      (twoGenre_secondDensity_eq_of_rewardPowerLaw law hP hC2.le hd1 hd2
        ⟨hzpos', hzlt⟩ hreward2)
  · exact hq
  · simpa only [sub_sub_cancel] using hcoeff

/-- The ratio of the two reward coefficients obtained from the finite-genre
FOCs at a common ray is the trigonometric coefficient used in Step 2. -/
theorem finiteGenre_rewardCoefficient_ratio_eq_at_angle
    {alpha beta theta phi : ℝ}
    (halpha : 0 < alpha) (hsin : 0 < Real.sin theta)
    (hsinphi : 0 < Real.sin phi)
    (hsindelta : 0 < Real.sin (theta - phi))
    (hcosphi : 0 < Real.cos phi)
    (hcosdelta : 0 < Real.cos (theta - phi)) :
    (alpha / Real.sin theta * finiteGenreFirstAngleLabel beta theta phi) /
        (alpha / Real.sin theta * finiteGenreSecondAngleLabel beta theta phi) =
      Real.sin (theta - phi) / Real.sin phi *
        (Real.cos (theta - phi)) ^ (beta - 1) /
          (Real.cos phi) ^ (beta - 1) := by
  have hcpow : (Real.cos phi) ^ (beta - 1) ≠ 0 :=
    (Real.rpow_pos_of_pos hcosphi _).ne'
  have hdpow : (Real.cos (theta - phi)) ^ (beta - 1) ≠ 0 :=
    (Real.rpow_pos_of_pos hcosdelta _).ne'
  unfold finiteGenreFirstAngleLabel finiteGenreSecondAngleLabel
  field_simp [halpha.ne', hsin.ne', hsinphi.ne', hsindelta.ne', hcpow, hdpow]

/-- The user-reflected form of the finite-genre reward-coefficient ratio. -/
theorem finiteGenre_reverseRewardCoefficient_ratio_eq_at_angle
    {alpha beta theta phi : ℝ}
    (halpha : 0 < alpha) (hsin : 0 < Real.sin theta)
    (hsinphi : 0 < Real.sin phi)
    (hsindelta : 0 < Real.sin (theta - phi))
    (hcosphi : 0 < Real.cos phi)
    (hcosdelta : 0 < Real.cos (theta - phi)) :
    (alpha / Real.sin theta * finiteGenreSecondAngleLabel beta theta phi) /
        (alpha / Real.sin theta * finiteGenreFirstAngleLabel beta theta phi) =
      Real.sin phi / Real.sin (theta - phi) *
        (Real.cos phi) ^ (beta - 1) /
          (Real.cos (theta - phi)) ^ (beta - 1) := by
  have hcpow : (Real.cos phi) ^ (beta - 1) ≠ 0 :=
    (Real.rpow_pos_of_pos hcosphi _).ne'
  have hdpow : (Real.cos (theta - phi)) ^ (beta - 1) ≠ 0 :=
    (Real.rpow_pos_of_pos hcosdelta _).ne'
  unfold finiteGenreFirstAngleLabel finiteGenreSecondAngleLabel
  field_simp [halpha.ne', hsin.ne', hsinphi.ne', hsindelta.ne', hcpow, hdpow]

/--
The complete two-genre branch of Proposition `finitegenre`.  The actual Nash
law first supplies both score intervals, the common FOC labels, and hence the
two reward power laws.  Compactness supplies the radial endpoints.  A total
order split on the two reward coefficients then invokes the direct or
user-reflected analytic contradiction, so the source's informal WLOG step is
not retained as an assumption.
-/
theorem no_twoGenreConditionalNormLaw_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {alpha beta theta theta1 theta2 : ℝ}
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hP : 1 < P) (halpha : 0 < alpha) (hbeta : 0 < beta)
    (htheta1_pos : 0 < theta1) (htheta1_lt : theta1 < theta / 2)
    (hhalf_lt_theta2 : theta / 2 < theta2) (htheta2_lt : theta2 < theta)
    (htheta_le : theta ≤ Real.pi / 2)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta) q) mu ≪
        volume)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos theta < z.2)
    (hderiv1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x) z.1) z.1)
    (hderiv2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x) z.2) z.2)
    (hgenres : SourceNonzeroSupportGenres (SourceNorm.l2 2) mu =
      Set.range (fun i : Fin 2 =>
        if i = 0 then content2 (Real.cos theta1) (Real.sin theta1)
        else content2 (Real.cos theta2) (Real.sin theta2))) :
    False := by
  let angle : Fin 2 → ℝ := fun i => if i = 0 then theta1 else theta2
  have htheta_pos : 0 < theta := by linarith
  have htheta_lt_pi : theta < Real.pi := by linarith [Real.pi_pos]
  have hsin : 0 < Real.sin theta :=
    Real.sin_pos_of_pos_of_lt_pi htheta_pos htheta_lt_pi
  have hcosstar : 0 ≤ Real.cos theta := by
    exact Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], htheta_le⟩
  have hangle_pos : ∀ i, 0 < angle i := by
    intro i
    fin_cases i <;> simp [angle] <;> linarith
  have hangle_lt : ∀ i, angle i < theta := by
    intro i
    fin_cases i <;> simp [angle] <;> linarith
  have hcos_first : ∀ i, 0 < Real.cos (angle i) := by
    intro i
    apply Real.cos_pos_of_mem_Ioo
    constructor <;> fin_cases i <;> simp [angle] <;> linarith [Real.pi_pos]
  have hcos_second : ∀ i, 0 < Real.cos (theta - angle i) := by
    intro i
    apply Real.cos_pos_of_mem_Ioo
    constructor <;> fin_cases i <;> simp [angle] <;> linarith [Real.pi_pos]
  have hgenres' : SourceNonzeroSupportGenres (SourceNorm.l2 2) mu =
      Set.range (fun i : Fin 2 =>
        content2 (Real.cos (angle i)) (Real.sin (angle i))) := by
    rw [hgenres]
    congr 1
    funext i
    fin_cases i <;> simp [angle]
  obtain ⟨B1, B2, _epsilon1, _epsilon2, _hB1, _hB2,
      _hepsilon1, _hepsilon2, hfirst_support, hsecond_support, hlabels⟩ :=
    finiteGenre_exists_scoreIntervals_and_angleLabel_eq_of_finiteGenres
      (ν := SourceNorm.l2 2) angle halpha hbeta hsin hcosstar htheta_lt_pi
      hnash hscore_ac hinterior hderiv1 hderiv2 hangle_pos hangle_lt
      hcos_first hcos_second hgenres'
  let C1 : ℝ := alpha / Real.sin theta *
    finiteGenreFirstAngleLabel beta theta (angle (1 : Fin 2))
  let C2 : ℝ := alpha / Real.sin theta *
    finiteGenreSecondAngleLabel beta theta (angle (1 : Fin 2))
  have hsin_theta2 : 0 < Real.sin theta2 :=
    Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith [Real.pi_pos])
  have hsin_delta2 : 0 < Real.sin (theta - theta2) :=
    Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith [Real.pi_pos])
  have hC1 : 0 < C1 := by
    dsimp [C1]
    apply mul_pos (div_pos halpha hsin)
    unfold finiteGenreFirstAngleLabel
    exact div_pos hsin_delta2 (Real.rpow_pos_of_pos (hcos_first 1) _)
  have hC2 : 0 < C2 := by
    dsimp [C2]
    apply mul_pos (div_pos halpha hsin)
    unfold finiteGenreSecondAngleLabel
    exact div_pos hsin_theta2 (Real.rpow_pos_of_pos (hcos_second 1) _)
  have hreward1 : Set.EqOn
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x)
      (fun x => C1 * x ^ beta) (Set.Icc 0 B1) := by
    simpa [C1] using
      (finiteGenre_firstReward_eq_const_mul_rpow_of_finiteGenres
        (ν := SourceNorm.l2 2) angle (1 : Fin 2) hP halpha hbeta hsin hnash
        hscore_ac hinterior hderiv1 hcos_first hgenres' hfirst_support
        (fun i => (hlabels i 1).1))
  have hreward2 : Set.EqOn
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map
          (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x)
      (fun x => C2 * x ^ beta) (Set.Icc 0 B2) := by
    simpa [C2] using
      (finiteGenre_secondReward_eq_const_mul_rpow_of_finiteGenres
        (ν := SourceNorm.l2 2) angle (1 : Fin 2) hP halpha hbeta hsin hnash
        hscore_ac hinterior hderiv2 hcos_first hcos_second hgenres'
        hsecond_support (fun i => (hlabels i 1).2))
  have hcompact : IsCompact mu.support :=
    sourceSymmetricMixedNash_isCompact_support_of_compactSublevels_of_scaledNormRpowCost
      (j := Classical.choice (inferInstance : Nonempty (Fin P)))
      hnash halpha hbeta (SourceNorm.l2_compactSublevels 2)
  rcases le_total C2 C1 with hC | hC
  · apply twoGenre_contradiction_of_ordered_rewardPowerLaws law hP hbeta
      hC1 hC2 hC htheta1_pos htheta1_lt htheta2_lt hhalf_lt_theta2
      htheta_le hcompact hfirst_support hsecond_support hreward1 hreward2
    simpa [C1, C2, angle] using
      (finiteGenre_rewardCoefficient_ratio_eq_at_angle
        (alpha := alpha) (beta := beta) (theta := theta) (phi := theta2)
        halpha hsin hsin_theta2 hsin_delta2 (hcos_first 1) (hcos_second 1))
  · apply twoGenre_contradiction_of_reverseOrdered_rewardPowerLaws law hP hbeta
      hC1 hC2 hC htheta1_pos htheta1_lt htheta2_lt hhalf_lt_theta2
      htheta_le hcompact hfirst_support hsecond_support hreward1 hreward2
    have hfirst_eq : finiteGenreFirstAngleLabel beta theta theta1 =
        finiteGenreFirstAngleLabel beta theta theta2 := by
      simpa [angle] using (hlabels (0 : Fin 2) (1 : Fin 2)).1
    have hsecond_eq : finiteGenreSecondAngleLabel beta theta theta1 =
        finiteGenreSecondAngleLabel beta theta theta2 := by
      simpa [angle] using (hlabels (0 : Fin 2) (1 : Fin 2)).2
    have hsin_theta1 : 0 < Real.sin theta1 :=
      Real.sin_pos_of_pos_of_lt_pi htheta1_pos (by linarith [Real.pi_pos])
    have hsin_delta1 : 0 < Real.sin (theta - theta1) :=
      Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith [Real.pi_pos])
    calc
      C2 / C1 =
          (alpha / Real.sin theta * finiteGenreSecondAngleLabel beta theta theta1) /
            (alpha / Real.sin theta * finiteGenreFirstAngleLabel beta theta theta1) := by
        dsimp [C1, C2]
        have hangle_one : angle (1 : Fin 2) = theta2 := by simp [angle]
        rw [hangle_one, ← hfirst_eq, ← hsecond_eq]
      _ = Real.sin theta1 / Real.sin (theta - theta1) *
          (Real.cos theta1) ^ (beta - 1) /
            (Real.cos (theta - theta1)) ^ (beta - 1) :=
        finiteGenre_reverseRewardCoefficient_ratio_eq_at_angle
          halpha hsin hsin_theta1 hsin_delta1 (hcos_first 0) (hcos_second 0)

/--
On a corrected singleton nonzero-support ray, the entire content law is the
pushforward of its source-norm law along the selected ray.  This is a genuine
measure identity: it uses the topological-support fact only through the
standard almost-everywhere support theorem, and includes the zero action.
-/
theorem measure_eq_scaleContent_map_sourceNorm_of_singleton_nonzeroSupportGenres
    {D : ℕ} {ν : SourceNorm D} {μ : MixedContentStrategy D}
    {genre : Content D}
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hmeas_norm : Measurable ν.norm) :
    μ = Measure.map (fun r : ℝ => scaleContent r genre) (Measure.map ν.norm μ) := by
  have hscale_meas : Measurable (fun r : ℝ => scaleContent r genre) := by
    rw [measurable_pi_iff]
    intro d
    change Measurable (fun r : ℝ => r * genre d)
    exact measurable_id.mul measurable_const
  calc
    μ = Measure.map id μ := Measure.map_id.symm
    _ = Measure.map (fun p : Content D => scaleContent (ν.norm p) genre) μ := by
      apply Measure.map_congr
      filter_upwards [MeasureTheory.Measure.support_mem_ae] with p hp
      change p = scaleContent (ν.norm p) genre
      by_cases hp_nonzero : NonzeroContent p
      · have hnormalized_mem : SourceNorm.normalizedContent ν p ∈
          SourceNonzeroSupportGenres ν μ :=
        ⟨p, hp, hp_nonzero, rfl⟩
        have hnormalized : SourceNorm.normalizedContent ν p = genre :=
          Set.mem_singleton_iff.mp (hgenres hnormalized_mem)
        calc
          p = scaleContent (ν.norm p) (SourceNorm.normalizedContent ν p) :=
            (SourceNorm.scale_norm_normalizedContent_eq_self ν hp_nonzero).symm
          _ = scaleContent (ν.norm p) genre := by rw [hnormalized]
      · have hp_zero : p = 0 := content_eq_zero_of_not_nonzeroContent hp_nonzero
        subst p
        ext d
        simp [scaleContent]
    _ = Measure.map (fun r : ℝ => scaleContent r genre) (Measure.map ν.norm μ) :=
      (Measure.map_map hscale_meas hmeas_norm).symm

/--
If a nonnegative source-norm law has the corrected all-radii single-genre CDF,
then it is exactly the inverse-transform quality law.  The negative-threshold
case is proved from nonnegativity rather than omitted from CDF extensionality.
-/
theorem sourceNorm_map_eq_singleGenreQualityLaw_of_lowerCDFMass_eq_singleGenreCdf
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {ν : SourceNorm D} {μ : MixedContentStrategy D} {β : ℝ}
    (hprob : MeasureTheory.IsProbabilityMeasure μ)
    (hmeas_norm : Measurable ν.norm)
    (hβ : 0 < β)
    (hcdf : ∀ r : ℝ, 0 ≤ r →
      AppliedModelingLib.Probability.lowerCDFMass (Measure.map ν.norm μ) r =
        singleGenreCdf N P β r) :
    Measure.map ν.norm μ = singleGenreQualityLaw N P β := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hprob
  letI : MeasureTheory.IsProbabilityMeasure (Measure.map ν.norm μ) :=
    MeasureTheory.Measure.isProbabilityMeasure_map hmeas_norm.aemeasurable
  letI : MeasureTheory.IsProbabilityMeasure (singleGenreQualityLaw N P β) :=
    singleGenreQualityLaw_isProbabilityMeasure N P β
  apply Measure.ext_of_Iic
  intro r
  apply (ENNReal.toReal_eq_toReal_iff'
    (MeasureTheory.measure_ne_top _ _) (MeasureTheory.measure_ne_top _ _)).mp
  change AppliedModelingLib.Probability.lowerCDFMass (Measure.map ν.norm μ) r =
    (singleGenreQualityLaw N P β).real (Set.Iic r)
  by_cases hr : 0 ≤ r
  · rw [hcdf r hr,
      ← ENNReal.toReal_ofReal (singleGenreCdf_nonneg hr),
      ← singleGenreQualityLaw_cdf_eq_singleGenreCdf_of_nonneg hβ hr]
    rfl
  · have hr_neg : r < 0 := lt_of_not_ge hr
    have hnorm_empty : {p : Content D | ν.norm p ≤ r} = ∅ := by
      ext p
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
      exact not_le_of_gt (lt_of_lt_of_le hr_neg (ν.nonneg p))
    have hquality_empty :
        {u : I | singleGenreQualitySample N P β u ≤ r} = ∅ := by
      ext u
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
      exact not_le_of_gt (lt_of_lt_of_le hr_neg
        (singleGenreQualitySample_nonnegative N P β u))
    change ((Measure.map ν.norm μ) (Set.Iic r)).toReal =
      ((singleGenreQualityLaw N P β) (Set.Iic r)).toReal
    rw [Measure.map_apply hmeas_norm measurableSet_Iic]
    change (μ {p : Content D | ν.norm p ≤ r}).toReal = _
    rw [hnorm_empty]
    simp only [MeasureTheory.measure_empty, ENNReal.toReal_zero]
    rw [singleGenreQualityLaw,
      Measure.map_apply (singleGenreQualitySample_measurable N P β) measurableSet_Iic,
      show singleGenreQualitySample N P β ⁻¹' Set.Iic r =
        {u : I | singleGenreQualitySample N P β u ≤ r} by rfl,
      hquality_empty, MeasureTheory.measure_empty, ENNReal.toReal_zero]

/--
Corrected single-genre characterization: under the compact/proper norm bridge
needed to derive the paper's CDF, every source symmetric mixed equilibrium
whose nonzero support has one genre is precisely the explicit ray law.  The
statement deliberately uses the corrected nonzero-support genre set and does
not normalize the zero support action.
-/
theorem sourceSymmetricMixedNash_eq_singleGenreContentLaw_of_compactSublevels_of_singleton_nonzeroSupportGenres
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {j : Fin P} {genre : Content D} {β : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ)
    (hno_atoms : MeasureTheory.NoAtoms μ)
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hgenre_score : ∀ i : Fin N, 0 < score (users i) genre)
    (hmeas_norm : Measurable ν.norm)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hβ : 0 < β)
    (hcompact_sublevels : SourceNormCompactSublevels ν)
    (hcontinuous : Continuous ν.norm)
    (hgenre_norm : ν.norm genre = 1) :
    μ = singleGenreContentLaw N P β genre := by
  calc
    μ = Measure.map (fun r : ℝ => scaleContent r genre) (Measure.map ν.norm μ) :=
      measure_eq_scaleContent_map_sourceNorm_of_singleton_nonzeroSupportGenres
        hgenres hmeas_norm
    _ = Measure.map (fun r : ℝ => scaleContent r genre)
        (singleGenreQualityLaw N P β) := by
      rw [sourceNorm_map_eq_singleGenreQualityLaw_of_lowerCDFMass_eq_singleGenreCdf
        hnash.1 hmeas_norm hβ (fun r hr =>
          sourceSymmetricMixedNash_normLaw_lowerCDFMass_eq_singleGenreCdf_of_compactSublevels_of_singleton_nonzeroSupportGenres_without_zeroSupportPremise
            (j := j) hnash hno_atoms hgenres hgenre_score hmeas_norm husers hβ
            hcompact_sublevels hcontinuous hr)]
    _ = singleGenreContentLaw N P β genre := by
      have hscale_meas : Measurable (fun r : ℝ => scaleContent r genre) := by
        rw [measurable_pi_iff]
        intro d
        change Measurable (fun r : ℝ => r * genre d)
        exact measurable_id.mul measurable_const
      unfold singleGenreContentLaw singleGenreQualityLaw
      rw [Measure.map_map hscale_meas (singleGenreQualitySample_measurable N P β)]
      rfl

/--
For the paper's nonzero-user model, a source symmetric mixed Nash law has a
nonzero support action.  Otherwise every sampled score is zero for a selected
nonzero user, contradicting the internally proved score-level atom exclusion.
-/
theorem sourceSymmetricMixedNash_exists_nonzero_support_of_nonzero_users
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcont : PerturbationCostContinuous cost) :
    ∃ p : Content D, p ∈ μ.support ∧ NonzeroContent p := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  obtain ⟨i0⟩ := (inferInstance : Nonempty (Fin N))
  by_contra hnonzero
  push_neg at hnonzero
  have hscore_zero_ae : ∀ᵐ p ∂μ, score (users i0) p = 0 := by
    filter_upwards [MeasureTheory.Measure.support_mem_ae] with p hp
    have hp_zero : p = 0 :=
      content_eq_zero_of_not_nonzeroContent (hnonzero p hp)
    rw [hp_zero, score_zero_right]
  have hscore_level_one :
      μ {p : Content D | score (users i0) p = 0} = 1 :=
    (MeasureTheory.mem_ae_iff_prob_eq_one
      (MeasurableSet.preimage measurableSet_eq
        (measurable_score_content (users i0)))).mp hscore_zero_ae
  have hscore_level_zero :
      μ {p : Content D | score (users i0) p = 0} = 0 :=
    sourceSymmetricMixedNash_score_level_measure_eq_zero
      (i0 := i0) (j := Classical.choice (inferInstance : Nonempty (Fin P)))
      hnash husers (husers_nonzero i0) hcont 0
  rw [hscore_level_one] at hscore_level_zero
  norm_num at hscore_level_zero

/--
Proposition `uniqueness` in the canonical actual-Nash model, including its
advertised one-genre conclusion.  The result identifies the corrected
nonzero-support genre set exactly with the normalized content direction whose
canonical values are `(1,1)`.
-/
theorem canonicalTwoUser_nonzeroSupportGenres_eq_singleton_of_scaledNormRpowCostNash_contDiffAt
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hP : 1 < P) (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hcontDiff1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      ContDiffAt ℝ 1
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) z.1)
    (hcontDiff2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      ContDiffAt ℝ 1
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 =>
            score (canonicalTwoUserSecond θ) q) μ) x) z.2) :
    SourceNonzeroSupportGenres (SourceNorm.l2 2) μ =
      ({SourceNorm.normalizedContent (SourceNorm.l2 2)
        (canonicalTwoUserContentOfValues θ 1 1)} : Set (Content 2)) := by
  obtain ⟨-, -, -, hdiag⟩ :=
    canonicalTwoUser_exists_diagonal_valueSupport_of_scaledNormRpowCostNash_contDiffAt
      hP hα hβ hsin hcos hnash hscore_ac hbase hcross hinterior
      hcontDiff1 hcontDiff2
  letI : Nontrivial (Fin P) := Fin.nontrivial_iff_two_le.mpr (by omega)
  have hexists : ∃ p : Content 2, p ∈ μ.support ∧ NonzeroContent p :=
    sourceSymmetricMixedNash_exists_nonzero_support_of_nonzero_users
      hnash (canonicalTwoUser_users_nonnegative hsin hcos)
      (canonicalTwoUser_users_nonzero hsin)
      (perturbationCostContinuous_scaled_l2_normRpowCost α hβ.le)
  exact canonicalTwoUser_nonzeroSupportGenres_eq_singleton_of_valueSupport_diagonal
    hsin.ne' hnash.2.1 hdiag hexists

