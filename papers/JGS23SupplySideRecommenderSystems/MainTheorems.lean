/-!
# Paper-Facing Theorems: Supply-Side Equilibria in Recommender Systems

This file starts the source-faithful Lean ledger for Jagadeesan, Garg, and
Steinhardt, "Supply-Side Equilibria in Recommender Systems" (arXiv:2206.13489v3,
NeurIPS 2023 full version).

The current layer formalizes the finite algebraic model primitives from
Section 2: content/user vectors, dot-product recommendation scores, tie-sharing
among maximizers, producer profit, pure-deviation equilibrium, and
single-genre/collinearity predicates.  The discontinuous-game existence theorem
and the continuous mixed-equilibrium analysis are intentionally not hidden
behind these definitions.
-/

namespace JGS23SupplySideRecommenderSystems

/-- A user or content embedding in `D` dimensions. -/
abbrev Content (D : ℕ) := Fin D → ℝ

/-- A source mixed strategy: a probability measure over content embeddings. -/
abbrev MixedContentStrategy (D : ℕ) := MeasureTheory.Measure (Content D)

/--
The source proof's explicitly Euclidean presentation of the content space.
This is a type synonym for the finite-coordinate `L2` space, kept separate
from Lean's default product metric on `Content D` so that the two metrics are
never conflated.
-/
abbrev SourceL2Content (D : ℕ) : Type := EuclideanSpace ℝ (Fin D)

/--
Finite-dimensional `L2` content and the coordinate-product content model have
the same topology.  This homeomorphism is the explicit source-to-model bridge
for the paper's printed Euclidean topology.
-/
noncomputable def sourceL2ContentHomeomorph (D : ℕ) :
    SourceL2Content D ≃ₜ Content D :=
  PiLp.homeomorph 2 (fun _ : Fin D => ℝ)

/-- The metric on `SourceL2Content` is exactly the source's finite `L2` distance. -/
theorem sourceL2Content_dist_toLp_eq_l2_difference {D : ℕ}
    (p q : Content D) :
    dist (WithLp.toLp 2 p : SourceL2Content D) (WithLp.toLp 2 q) =
      AppliedModelingLib.FiniteDimensionalNorms.l2 (fun d => p d - q d) := by
  simp [PiLp.dist_eq_of_L2, AppliedModelingLib.FiniteDimensionalNorms.l2,
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq, Real.dist_eq, sq_abs]

/--
For the literal source Euclidean action space, every positive
Lévy--Prokhorov ball is open in Mathlib's weak/convergence-in-distribution
topology on probability measures.  Finite-dimensional separability is
discharged by the `EuclideanSpace` instance.
-/
theorem isOpen_sourceL2_levyProkhorovBall {D : ℕ}
    (μ : ProbabilityMeasure (SourceL2Content D)) (ε : ℝ) :
    IsOpen {ν : ProbabilityMeasure (SourceL2Content D) |
      dist (LevyProkhorov.ofMeasure ν) (LevyProkhorov.ofMeasure μ) < ε} := by
  exact Continuous.isOpen_preimage
    (LevyProkhorov.probabilityMeasureHomeomorph (Ω := SourceL2Content D)).continuous_toFun
    _ Metric.isOpen_ball

/-- A positive source Euclidean Lévy--Prokhorov ball contains its center. -/
theorem mem_sourceL2_levyProkhorovBall {D : ℕ}
    (μ : ProbabilityMeasure (SourceL2Content D)) {ε : ℝ} (hε : 0 < ε) :
    μ ∈ {ν : ProbabilityMeasure (SourceL2Content D) |
      dist (LevyProkhorov.ofMeasure ν) (LevyProkhorov.ofMeasure μ) < ε} := by
  simpa using hε

/--
The ambient-product Lévy--Prokhorov ball used by the executable content-game
lower bound is likewise weak-open.  This is the topology statement directly
applicable to `MixedContentStrategy D` after bundling it as a probability
measure.
-/
theorem isOpen_content_levyProkhorovBall {D : ℕ}
    (μ : ProbabilityMeasure (Content D)) (ε : ℝ) :
    IsOpen {ν : ProbabilityMeasure (Content D) |
      dist (LevyProkhorov.ofMeasure ν) (LevyProkhorov.ofMeasure μ) < ε} := by
  exact Continuous.isOpen_preimage
    (LevyProkhorov.probabilityMeasureHomeomorph (Ω := Content D)).continuous_toFun
    _ Metric.isOpen_ball

/-- Source model condition: vectors live in the nonnegative orthant. -/
def NonnegativeContent {D : ℕ} (p : Content D) : Prop :=
  ∀ d, 0 ≤ p d

/-- The source nonnegative-content action domain is closed. -/
theorem isClosed_nonnegativeContentSet {D : ℕ} :
    IsClosed {p : Content D | NonnegativeContent p} := by
  have hset : {p : Content D | NonnegativeContent p} =
      ⋂ d : Fin D, {p : Content D | 0 ≤ p d} := by
    ext p
    simp only [Set.mem_setOf_eq, Set.mem_iInter, NonnegativeContent]
  rw [hset]
  exact isClosed_iInter (fun d =>
    isClosed_Ici.preimage (continuous_apply d))

/-- The source's nonnegative-content action domain is convex. -/
theorem convex_nonnegativeContentSet {D : ℕ} :
    Convex ℝ {p : Content D | NonnegativeContent p} := by
  rw [convex_iff_add_mem]
  intro x hx y hy a b ha hb hab d
  change 0 ≤ a * x d + b * y d
  exact add_nonneg (mul_nonneg ha (hx d)) (mul_nonneg hb (hy d))

@[simp] theorem zeroContent_nonnegative {D : ℕ} :
    NonnegativeContent (0 : Content D) := by
  intro d
  simp

/-- Source model condition: a vector is nonzero. -/
def NonzeroContent {D : ℕ} (p : Content D) : Prop :=
  ∃ d, p d ≠ 0

/-- Dot-product inferred user value `⟨u, p⟩`. -/
noncomputable def score {D : ℕ} (u p : Content D) : ℝ :=
  ∑ d : Fin D, u d * p d

/-- Scale a content vector along its ray. -/
def scaleContent {D : ℕ} (a : ℝ) (p : Content D) : Content D :=
  fun d => a * p d

/-- Coordinatewise content scaling is measurable in the finite source action
space. -/
theorem measurable_scaleContent {D : ℕ} (a : ℝ) :
    Measurable (scaleContent a : Content D → Content D) := by
  rw [measurable_pi_iff]
  intro d
  change Measurable (fun p : Content D => a * p d)
  exact measurable_const.mul (measurable_pi_apply d)

/-- Coordinatewise content scaling is continuous in the finite source action
space. -/
theorem continuous_scaleContent {D : ℕ} (a : ℝ) :
    Continuous (scaleContent a : Content D → Content D) := by
  apply continuous_pi
  intro d
  change Continuous (fun p : Content D => a * p d)
  exact continuous_const.mul (continuous_apply d)

@[simp] theorem scaleContent_scaleContent {D : ℕ} (a b : ℝ) (p : Content D) :
    scaleContent a (scaleContent b p) = scaleContent (a * b) p := by
  ext d
  simp [scaleContent, mul_assoc]

@[simp] theorem scaleContent_inv_scaleContent {D : ℕ} {a : ℝ} (ha : a ≠ 0)
    (p : Content D) :
    scaleContent a⁻¹ (scaleContent a p) = p := by
  ext d
  simp [scaleContent, ha]

@[simp] theorem scaleContent_scaleContent_inv {D : ℕ} {a : ℝ} (ha : a ≠ 0)
    (p : Content D) :
    scaleContent a (scaleContent a⁻¹ p) = p := by
  ext d
  simp [scaleContent, ha]

@[simp] theorem scaleContent_one {D : ℕ} (p : Content D) :
    scaleContent 1 p = p := by
  ext d
  simp [scaleContent]

theorem scaleContent_nonnegative {D : ℕ} {a : ℝ} {p : Content D}
    (ha : 0 ≤ a) (hp : NonnegativeContent p) :
    NonnegativeContent (scaleContent a p) := by
  intro d
  exact mul_nonneg ha (hp d)

theorem score_nonneg_of_nonnegative {D : ℕ} {u p : Content D}
    (hu : NonnegativeContent u) (hp : NonnegativeContent p) :
    0 ≤ score u p := by
  unfold score
  exact Finset.sum_nonneg fun d _hd => mul_nonneg (hu d) (hp d)

theorem score_scaleContent {D : ℕ} (a : ℝ) (u p : Content D) :
    score u (scaleContent a p) = a * score u p := by
  unfold score scaleContent
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl ?_
  intro d _hd
  ring

theorem score_scaleUser {D : ℕ} (a : ℝ) (u p : Content D) :
    score (scaleContent a u) p = a * score u p := by
  unfold score scaleContent
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl ?_
  intro d _hd
  ring

theorem score_add {D : ℕ} (u p q : Content D) :
    score u (p + q) = score u p + score u q := by
  unfold score
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl ?_
  intro d _hd
  simp
  ring

/-- The finite-coordinate source score is symmetric. -/
theorem score_comm {D : ℕ} (u p : Content D) :
    score u p = score p u := by
  unfold score
  apply Finset.sum_congr rfl
  intro d _hd
  ring

theorem score_add_left {D : ℕ} (u v p : Content D) :
    score (u + v) p = score u p + score v p := by
  rw [score_comm, score_add, score_comm p u, score_comm p v]

/-- Source score is additive with respect to subtraction in its content argument. -/
theorem score_sub {D : ℕ} (u p q : Content D) :
    score u (p - q) = score u p - score u q := by
  unfold score
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro d _hd
  simp
  ring

/-- Source score is additive with respect to subtraction in its user argument. -/
theorem score_sub_left {D : ℕ} (u v p : Content D) :
    score (u - v) p = score u p - score v p := by
  calc
    score (u - v) p = score p (u - v) := score_comm _ _
    _ = score p u - score p v := score_sub _ _ _
    _ = score u p - score v p := by
      rw [score_comm p u, score_comm p v]

/-- Squared Euclidean source score is nonnegative. -/
theorem score_self_nonnegative {D : ℕ} (p : Content D) :
    0 ≤ score p p := by
  unfold score
  exact Finset.sum_nonneg fun d _hd => mul_self_nonneg (p d)

/-- The aggregate content direction obtained by summing all user embeddings. -/
noncomputable def aggregateUsersContent {D N : ℕ}
    (users : Fin N → Content D) : Content D :=
  fun d => ∑ i : Fin N, users i d

/-- Scoring the aggregate user direction is the sum of individual scores. -/
theorem score_aggregateUsersContent_eq_sum_scores {D N : ℕ}
    (users : Fin N → Content D) (p : Content D) :
    score (aggregateUsersContent users) p =
      ∑ i : Fin N, score (users i) p := by
  unfold score aggregateUsersContent
  calc
    (∑ d : Fin D, (∑ i : Fin N, users i d) * p d) =
        ∑ d : Fin D, ∑ i : Fin N, users i d * p d := by
      refine Finset.sum_congr rfl ?_
      intro d _hd
      rw [Finset.sum_mul]
    _ = ∑ i : Fin N, ∑ d : Fin D, users i d * p d := Finset.sum_comm
    _ = ∑ i : Fin N, score (users i) p := by rfl

/-- A nonnegative user scores weakly higher against coordinatewise larger content. -/
theorem score_le_of_nonnegativeContent_le {D : ℕ} {u p q : Content D}
    (hu : NonnegativeContent u) (hpq : ∀ d, p d ≤ q d) :
    score u p ≤ score u q := by
  unfold score
  apply Finset.sum_le_sum
  intro d _hd
  exact mul_le_mul_of_nonneg_left (hpq d) (hu d)

/-- The coordinatewise positive part of an ambient content vector. -/
def nonnegativePart {D : ℕ} (p : Content D) : Content D :=
  fun d => max 0 (p d)

/-- Coordinatewise positive part lies in the source's nonnegative action domain. -/
theorem nonnegativePart_nonnegative {D : ℕ} (p : Content D) :
    NonnegativeContent (nonnegativePart p) := by
  intro d
  exact le_max_left _ _

/-- Every content vector is coordinatewise below its positive part. -/
theorem le_nonnegativePart {D : ℕ} (p : Content D) (d : Fin D) :
    p d ≤ nonnegativePart p d := by
  exact le_max_right _ _

/-- Positive-part projection weakly raises the score of every nonnegative user. -/
theorem score_le_score_nonnegativePart {D : ℕ} {u p : Content D}
    (hu : NonnegativeContent u) :
    score u p ≤ score u (nonnegativePart p) := by
  exact score_le_of_nonnegativeContent_le hu (le_nonnegativePart p)

/-- Coordinatewise positive-part projection does not increase finite Euclidean norm. -/
theorem l2_nonnegativePart_le {D : ℕ} (p : Content D) :
    AppliedModelingLib.FiniteDimensionalNorms.l2 (nonnegativePart p) ≤
      AppliedModelingLib.FiniteDimensionalNorms.l2 p := by
  refine AppliedModelingLib.FiniteDimensionalNorms.normL2_le_of_normL2Sq_le
    (nonnegativePart p) (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p) ?_
  rw [AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq]
  unfold AppliedModelingLib.FiniteDimensionalNorms.l2Sq nonnegativePart
  apply Finset.sum_le_sum
  intro d _hd
  by_cases hp : 0 ≤ p d
  · rw [max_eq_right hp]
  · have hp_le : p d ≤ 0 := le_of_lt (lt_of_not_ge hp)
    rw [max_eq_left hp_le]
    simpa using (sq_nonneg (p d))

/-- The aggregate of nonnegative user embeddings remains in the source action domain. -/
theorem aggregateUsersContent_nonnegative {D N : ℕ}
    {users : Fin N → Content D}
    (husers : ∀ i : Fin N, NonnegativeContent (users i)) :
    NonnegativeContent (aggregateUsersContent users) := by
  intro d
  unfold aggregateUsersContent
  exact Finset.sum_nonneg fun i _hi => husers i d

theorem score_smul {D : ℕ} (a : ℝ) (u p : Content D) :
    score u (a • p) = a * score u p := by
  simpa [scaleContent, Pi.smul_apply] using score_scaleContent a u p

@[simp] theorem score_zero_right {D : ℕ} (u : Content D) :
    score u (0 : Content D) = 0 := by
  simp [score]

/-- The zero user assigns zero score to every content vector. -/
@[simp] theorem score_zero_left {D : ℕ} (p : Content D) :
    score (0 : Content D) p = 0 := by
  simp [score]

/-- A positive score against some nonempty user population certifies nonzero content. -/
theorem nonzeroContent_of_positive_score {D N : ℕ} [Nonempty (Fin N)]
    {users : Fin N → Content D} {p : Content D}
    (hscore : ∀ i : Fin N, 0 < score (users i) p) :
    NonzeroContent p := by
  by_contra hp_all_zero
  unfold NonzeroContent at hp_all_zero
  simp only [not_exists, not_not] at hp_all_zero
  have hp_eq_zero : p = 0 := by
    ext d
    exact hp_all_zero d
  rw [hp_eq_zero] at hscore
  rcases (inferInstance : Nonempty (Fin N)) with ⟨i⟩
  have hzero_lt : (0 : ℝ) < 0 := by simpa using hscore i
  exact (lt_irrefl 0 hzero_lt).elim

theorem content_eq_zero_of_not_nonzeroContent {D : ℕ} {p : Content D}
    (h : ¬ NonzeroContent p) :
    p = 0 := by
  ext d
  by_contra hd
  exact h ⟨d, hd⟩

theorem score_eq_zero_of_not_nonzeroContent {D : ℕ} (u : Content D)
    {p : Content D} (h : ¬ NonzeroContent p) :
    score u p = 0 := by
  rw [content_eq_zero_of_not_nonzeroContent h]
  simp

theorem score_self_eq_l2Sq {D : ℕ} (u : Content D) :
    score u u = AppliedModelingLib.FiniteDimensionalNorms.l2Sq u := by
  unfold score AppliedModelingLib.FiniteDimensionalNorms.l2Sq
  refine Finset.sum_congr rfl ?_
  intro d _hd
  ring

theorem score_self_eq_l2_sq {D : ℕ} (u : Content D) :
    score u u = AppliedModelingLib.FiniteDimensionalNorms.l2 u ^ 2 := by
  rw [score_self_eq_l2Sq,
    ← AppliedModelingLib.FiniteDimensionalNorms.normL2_sq_eq_normL2Sq]

/-- The paper's real-power L2 cost is exactly the corresponding real power of
the self-score.  This lets constrained fibre minimization be stated in either
the squared-norm or the source cost convention without changing its exponent.
-/
theorem l2_rpow_eq_score_self_rpow_div_two {D : ℕ} (p : Content D) (beta : ℝ) :
    AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ beta =
      (score p p) ^ (beta / 2) := by
  rw [score_self_eq_l2_sq]
  rw [← Real.rpow_natCast, ← Real.rpow_mul
    (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p)]
  congr 1
  ring

theorem score_self_le_one_of_l2_norm_le_one {D : ℕ} {u : Content D}
    (hunit : AppliedModelingLib.FiniteDimensionalNorms.l2 u ≤ 1) :
    score u u ≤ 1 := by
  rw [score_self_eq_l2_sq]
  nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg u]

theorem score_self_eq_one_of_l2_norm_eq_one {D : ℕ} {u : Content D}
    (hunit : AppliedModelingLib.FiniteDimensionalNorms.l2 u = 1) :
    score u u = 1 := by
  rw [score_self_eq_l2Sq]
  have hsqrt :
      Real.sqrt (AppliedModelingLib.FiniteDimensionalNorms.l2Sq u) = 1 := by
    simpa [AppliedModelingLib.FiniteDimensionalNorms.l2] using hunit
  exact Real.sqrt_eq_one.mp hsqrt

/--
Section 2 quality monotonicity: along a nonnegative content direction, a larger
scale weakly increases every nonnegative user's inferred value.
-/
theorem score_scaleContent_mono_of_nonnegative {D : ℕ} {a b : ℝ}
    {u p : Content D}
    (hu : NonnegativeContent u) (hp : NonnegativeContent p) (hab : a ≤ b) :
    score u (scaleContent a p) ≤ score u (scaleContent b p) := by
  rw [score_scaleContent, score_scaleContent]
  exact mul_le_mul_of_nonneg_right hab (score_nonneg_of_nonnegative hu hp)

theorem score_scaleContent_le_self_of_nonnegative {D : ℕ} {a : ℝ}
    {u p : Content D}
    (hu : NonnegativeContent u) (hp : NonnegativeContent p) (ha : a ≤ 1) :
    score u (scaleContent a p) ≤ score u p := by
  simpa using score_scaleContent_mono_of_nonnegative hu hp ha

theorem exists_scale_between_finset {α : Type*} (s : Finset α) (t : α → ℝ)
    (ht : ∀ x ∈ s, t x < 1) :
    ∃ a : ℝ, 0 ≤ a ∧ a < 1 ∧ ∀ x ∈ s, t x < a := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      refine ⟨(1 : ℝ) / 2, by norm_num, by norm_num, ?_⟩
      intro x hx
      simp at hx
  | insert x s hx_not_mem ih =>
      have ht_s : ∀ y ∈ s, t y < 1 := by
        intro y hy
        exact ht y (Finset.mem_insert_of_mem hy)
      rcases ih ht_s with ⟨b, hb_nonneg, hb_lt, hb_bound⟩
      let M : ℝ := max (max (t x) b) 0
      let a : ℝ := (M + 1) / 2
      have hx_lt : t x < 1 := ht x (Finset.mem_insert_self x s)
      have hmax_lt : max (t x) b < 1 := max_lt hx_lt hb_lt
      have hM_lt : M < 1 := by
        dsimp [M]
        exact max_lt hmax_lt zero_lt_one
      have hM_nonneg : 0 ≤ M := by
        dsimp [M]
        exact le_max_right (max (t x) b) 0
      have hM_lt_a : M < a := by
        dsimp [a]
        linarith
      have ha_nonneg : 0 ≤ a := by
        dsimp [a]
        linarith
      have ha_lt : a < 1 := by
        dsimp [a]
        linarith
      refine ⟨a, ha_nonneg, ha_lt, ?_⟩
      intro y hy
      rw [Finset.mem_insert] at hy
      rcases hy with hy | hy
      · subst y
        exact lt_of_le_of_lt (le_trans (le_max_left (t x) b)
          (le_max_left (max (t x) b) 0)) hM_lt_a
      · exact lt_trans (hb_bound y hy)
          (lt_of_le_of_lt (le_trans (le_max_right (t x) b)
            (le_max_left (max (t x) b) 0)) hM_lt_a)

theorem exists_scale_between_fintype {α : Type*} [Fintype α] (t : α → ℝ)
    (ht : ∀ x, t x < 1) :
    ∃ a : ℝ, 0 ≤ a ∧ a < 1 ∧ ∀ x, t x < a := by
  classical
  rcases exists_scale_between_finset (Finset.univ : Finset α) t
      (by intro x _; exact ht x) with ⟨a, ha0, ha1, ha⟩
  exact ⟨a, ha0, ha1, fun x => ha x (Finset.mem_univ x)⟩

theorem score_self_pos_of_nonnegative_nonzero {D : ℕ} {u : Content D}
    (hu : NonnegativeContent u) (hzero : NonzeroContent u) :
    0 < score u u := by
  rcases hzero with ⟨d0, hd0⟩
  have hd0_pos : 0 < u d0 := lt_of_le_of_ne (hu d0) (Ne.symm hd0)
  unfold score
  refine Finset.sum_pos' (fun d _hd => mul_nonneg (hu d) (hu d)) ?_
  exact ⟨d0, Finset.mem_univ d0, mul_pos hd0_pos hd0_pos⟩

/--
If every source-model user is nonzero, the aggregate user direction has
strictly positive score for every user.  This is the positive-denominator
bridge needed by the corrected single-genre optimization domain.
-/
theorem score_aggregateUsersContent_pos {D N : ℕ}
    {users : Fin N → Content D}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (i : Fin N) :
    0 < score (users i) (aggregateUsersContent users) := by
  classical
  have hle : ∀ d : Fin D, users i d ≤ aggregateUsersContent users d := by
    intro d
    unfold aggregateUsersContent
    exact Finset.single_le_sum (fun j _hj => husers_nonnegative j d)
      (Finset.mem_univ i)
  have hself : 0 < score (users i) (users i) :=
    score_self_pos_of_nonnegative_nonzero (husers_nonnegative i)
      (husers_nonzero i)
  exact lt_of_lt_of_le hself
    (score_le_of_nonnegativeContent_le (husers_nonnegative i) hle)

/--
A feasible direction that raises user `i`'s score by at least the ambient
`L1` norm of that user per unit scale.  It is a finite positive combination of
the individual user directions, normalized by their positive self-scores.
-/
noncomputable def sourceL1ScoreMarginDirection {D N : ℕ}
    (users : Fin N → Content D) : Content D :=
  fun d => ∑ k : Fin N,
    (AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) / score (users k) (users k)) * users k d

/-- Scoring the uniform score-margin direction distributes over its finite sum. -/
theorem score_sourceL1ScoreMarginDirection_eq_sum {D N : ℕ}
    (users : Fin N → Content D) (i : Fin N) :
    score (users i) (sourceL1ScoreMarginDirection users) =
      ∑ k : Fin N,
        (AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) / score (users k) (users k)) *
          score (users i) (users k) := by
  unfold score sourceL1ScoreMarginDirection
  calc
    (∑ d : Fin D, users i d *
        (∑ k : Fin N,
          (AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) /
            (∑ d : Fin D, users k d * users k d)) * users k d)) =
      ∑ k : Fin N,
        (AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) /
          (∑ d : Fin D, users k d * users k d)) *
          (∑ d : Fin D, users i d * users k d) := by
            calc
              (∑ d : Fin D, users i d *
                  (∑ k : Fin N,
                    (AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) /
                      (∑ d : Fin D, users k d * users k d)) * users k d)) =
                  ∑ d : Fin D, ∑ k : Fin N,
                    users i d *
                      ((AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) /
                        (∑ d : Fin D, users k d * users k d)) * users k d) := by
                        apply Finset.sum_congr rfl
                        intro d _
                        rw [Finset.mul_sum]
              _ = ∑ k : Fin N, ∑ d : Fin D,
                    (AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) /
                      (∑ d : Fin D, users k d * users k d)) *
                      (users i d * users k d) := by
                        rw [Finset.sum_comm]
                        apply Finset.sum_congr rfl
                        intro k _
                        apply Finset.sum_congr rfl
                        intro d _
                        ring
              _ = ∑ k : Fin N,
                    (AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) /
                      (∑ d : Fin D, users k d * users k d)) *
                      (∑ d : Fin D, users i d * users k d) := by
                        symm
                        apply Finset.sum_congr rfl
                        intro k _
                        rw [Finset.mul_sum]
    _ = ∑ k : Fin N,
        (AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) / score (users k) (users k)) *
          score (users i) (users k) := by
            rfl

/-- The score-margin direction stays in the nonnegative content action domain. -/
theorem sourceL1ScoreMarginDirection_nonnegative {D N : ℕ}
    {users : Fin N → Content D}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i)) :
    NonnegativeContent (sourceL1ScoreMarginDirection users) := by
  intro d
  unfold sourceL1ScoreMarginDirection
  apply Finset.sum_nonneg
  intro k _
  exact mul_nonneg
    (div_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL1_nonneg (users k))
      (score_self_pos_of_nonnegative_nonzero (husers_nonnegative k)
        (husers_nonzero k)).le)
    (husers_nonnegative k d)

/--
Every source-model user gains at least its ambient `L1` norm in score along
the score-margin direction.  This gives one common metric margin for the
finite family of user score events.
-/
theorem sourceL1ScoreMarginDirection_score_ge_l1 {D N : ℕ}
    {users : Fin N → Content D}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (i : Fin N) :
    AppliedModelingLib.FiniteDimensionalNorms.l1 (users i) ≤
      score (users i) (sourceL1ScoreMarginDirection users) := by
  rw [score_sourceL1ScoreMarginDirection_eq_sum]
  have hself_pos : 0 < score (users i) (users i) :=
    score_self_pos_of_nonnegative_nonzero (husers_nonnegative i) (husers_nonzero i)
  have hterm_nonnegative : ∀ k : Fin N,
      0 ≤ (AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) / score (users k) (users k)) *
        score (users i) (users k) := by
    intro k
    exact mul_nonneg
      (div_nonneg (AppliedModelingLib.FiniteDimensionalNorms.normL1_nonneg (users k))
        (score_self_pos_of_nonnegative_nonzero (husers_nonnegative k)
          (husers_nonzero k)).le)
      (score_nonneg_of_nonnegative (husers_nonnegative i) (husers_nonnegative k))
  calc
    AppliedModelingLib.FiniteDimensionalNorms.l1 (users i) =
        (AppliedModelingLib.FiniteDimensionalNorms.l1 (users i) / score (users i) (users i)) *
          score (users i) (users i) := by
            exact (div_mul_cancel₀ _ hself_pos.ne').symm
    _ ≤ ∑ k : Fin N,
        (AppliedModelingLib.FiniteDimensionalNorms.l1 (users k) / score (users k) (users k)) *
          score (users i) (users k) :=
        Finset.single_le_sum (fun k _ => hterm_nonnegative k) (Finset.mem_univ i)

/-- The score gain from a nonnegative scale of the margin direction is uniform. -/
theorem score_add_smul_sourceL1ScoreMarginDirection_ge {D N : ℕ}
    {users : Fin N → Content D} {p : Content D} {t : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (ht : 0 ≤ t) (i : Fin N) :
    score (users i) p + t * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i) ≤
      score (users i) (p + t • sourceL1ScoreMarginDirection users) := by
  rw [score_add, score_smul]
  simpa [add_comm] using add_le_add_left
    (mul_le_mul_of_nonneg_left
      (sourceL1ScoreMarginDirection_score_ge_l1 husers_nonnegative husers_nonzero i) ht)
    (score (users i) p)

/--
Tie-perturbation score step for Proposition `pure`: moving a content vector by
`epsilon * u` strictly raises user `u`'s own score when `epsilon > 0`.
-/
theorem score_perturb_self_strict {D : ℕ} {u p : Content D} {ε : ℝ}
    (hu : NonnegativeContent u) (hzero : NonzeroContent u) (hε : 0 < ε) :
    score u p < score u (fun d => p d + ε * u d) := by
  have hself_pos : 0 < score u u :=
    score_self_pos_of_nonnegative_nonzero hu hzero
  have hsum_mul :
      (∑ d : Fin D, u d * (ε * u d)) = ε * ∑ d : Fin D, u d * u d := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl ?_
    intro d _hd
    ring
  have hincrement_pos : 0 < ∑ d : Fin D, u d * (ε * u d) := by
    rw [hsum_mul]
    simpa [score] using mul_pos hε hself_pos
  unfold score
  calc
    (∑ d : Fin D, u d * p d)
        < ∑ d : Fin D, (u d * p d + u d * (ε * u d)) := by
          rw [Finset.sum_add_distrib]
          linarith
    _ = ∑ d : Fin D, u d * (p d + ε * u d) := by
          refine Finset.sum_congr rfl ?_
          intro d _hd
          ring

/--
Perturbing content by a nonnegative vector cannot decrease the inferred value
of any nonnegative user.
-/
theorem score_perturb_nonnegative_mono {D : ℕ} {v u p : Content D} {ε : ℝ}
    (hv : NonnegativeContent v) (hu : NonnegativeContent u) (hε : 0 ≤ ε) :
    score v p ≤ score v (fun d => p d + ε * u d) := by
  have hincrement_nonneg : 0 ≤ ∑ d : Fin D, v d * (ε * u d) := by
    refine Finset.sum_nonneg ?_
    intro d _hd
    exact mul_nonneg (hv d) (mul_nonneg hε (hu d))
  unfold score
  calc
    (∑ d : Fin D, v d * p d)
        ≤ ∑ d : Fin D, (v d * p d + v d * (ε * u d)) := by
          rw [Finset.sum_add_distrib]
          linarith
    _ = ∑ d : Fin D, v d * (p d + ε * u d) := by
          refine Finset.sum_congr rfl ?_
          intro d _hd
          ring

theorem perturbContent_nonnegative {D : ℕ} {p u : Content D} {ε : ℝ}
    (hp : NonnegativeContent p) (hu : NonnegativeContent u) (hε : 0 ≤ ε) :
    NonnegativeContent (fun d => p d + ε * u d) := by
  intro d
  exact add_nonneg (hp d) (mul_nonneg hε (hu d))

/-- The producers whose content maximizes the inferred value for user `u`. -/
noncomputable def winningProducers {D P : ℕ}
    (u : Content D) (profile : Fin P → Content D) : Finset (Fin P) :=
  Finset.univ.filter fun j => ∀ k : Fin P, score u (profile k) ≤ score u (profile j)

/-- Producer `j` is the strict score maximizer for user `u`. -/
def StrictWinner {D P : ℕ}
    (u : Content D) (profile : Fin P → Content D) (j : Fin P) : Prop :=
  ∀ k : Fin P, k ≠ j → score u (profile k) < score u (profile j)

/-- No score ties between distinct producers for any user in a finite profile. -/
def NoScoreTies {D N P : ℕ}
    (users : Fin N → Content D) (profile : Fin P → Content D) : Prop :=
  ∀ (i : Fin N) (j k : Fin P), j ≠ k →
    score (users i) (profile j) ≠ score (users i) (profile k)

/-- Top recommendations are unique for every user.  Lower-score ties are allowed. -/
def UniqueWinningProducers {D N P : ℕ}
    (users : Fin N → Content D) (profile : Fin P → Content D) : Prop :=
  ∀ i : Fin N, ∃ j : Fin P, winningProducers (users i) profile = {j}

@[simp] theorem mem_winningProducers {D P : ℕ}
    (u : Content D) (profile : Fin P → Content D) (j : Fin P) :
    j ∈ winningProducers u profile ↔
      ∀ k : Fin P, score u (profile k) ≤ score u (profile j) := by
  simp [winningProducers]

theorem winningProducers_scaleUser_pos {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {a : ℝ}
    (ha : 0 < a) :
    winningProducers (scaleContent a u) profile = winningProducers u profile := by
  ext j
  rw [mem_winningProducers, mem_winningProducers]
  constructor
  · intro h k
    have hk := h k
    rw [score_scaleUser, score_scaleUser] at hk
    exact le_of_mul_le_mul_left hk ha
  · intro h k
    have hk := h k
    rw [score_scaleUser, score_scaleUser]
    exact mul_le_mul_of_nonneg_left hk (le_of_lt ha)

theorem winningProducers_nonempty {D P : ℕ} [Nonempty (Fin P)]
    (u : Content D) (profile : Fin P → Content D) :
    (winningProducers u profile).Nonempty := by
  classical
  obtain ⟨j, _hj_univ, hj_max⟩ :=
    Finset.exists_max_image (Finset.univ : Finset (Fin P))
      (fun j => score u (profile j)) (Finset.univ_nonempty)
  refine ⟨j, ?_⟩
  simp [winningProducers, hj_max]

theorem winningProducers_eq_singleton_of_strictWinner {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P}
    (h : StrictWinner u profile j) :
    winningProducers u profile = {j} := by
  classical
  ext k
  constructor
  · intro hk
    by_cases hkj : k = j
    · simp [hkj]
    · have hj_le_k : score u (profile j) ≤ score u (profile k) := by
        exact (mem_winningProducers u profile k).mp hk j
      have hk_lt_j : score u (profile k) < score u (profile j) := h k hkj
      exact False.elim ((not_le_of_gt hk_lt_j) hj_le_k)
  · intro hk
    have hkj : k = j := by
      simpa using hk
    subst k
    rw [mem_winningProducers]
    intro l
    by_cases hlj : l = j
    · subst l
      exact le_rfl
    · exact le_of_lt (h l hlj)

/--
Tie-breaking share for producer `j`: zero if `j` is not a maximizer for `u`,
and otherwise the reciprocal of the number of maximizers.
-/
noncomputable def tieShare {D P : ℕ}
    (u : Content D) (profile : Fin P → Content D) (j : Fin P) : ℝ :=
  if j ∈ winningProducers u profile then
    ((winningProducers u profile).card : ℝ)⁻¹
  else
    0

@[simp] theorem tieShare_eq_zero_of_not_mem {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P}
    (h : j ∉ winningProducers u profile) :
    tieShare u profile j = 0 := by
  simp [tieShare, h]

theorem tieShare_eq_inv_card_of_mem {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P}
    (h : j ∈ winningProducers u profile) :
    tieShare u profile j = ((winningProducers u profile).card : ℝ)⁻¹ := by
  simp [tieShare, h]

/-- With a zero user, every producer ties at score zero. -/
theorem winningProducers_zeroContent_eq_univ {D P : ℕ}
    (profile : Fin P → Content D) :
    winningProducers (0 : Content D) profile = Finset.univ := by
  ext j
  rw [mem_winningProducers]
  simp

/-- A zero user splits its recommendation uniformly among all producers. -/
theorem tieShare_zeroContent_eq_inv_card {D P : ℕ} [Nonempty (Fin P)]
    (profile : Fin P → Content D) (j : Fin P) :
    tieShare (0 : Content D) profile j = ((P : ℝ)⁻¹) := by
  rw [tieShare_eq_inv_card_of_mem]
  · simp [winningProducers_zeroContent_eq_univ]
  · rw [winningProducers_zeroContent_eq_univ]
    simp

theorem tieShare_nonneg {D P : ℕ}
    (u : Content D) (profile : Fin P → Content D) (j : Fin P) :
    0 ≤ tieShare u profile j := by
  by_cases h : j ∈ winningProducers u profile
  · rw [tieShare_eq_inv_card_of_mem h]
    positivity
  · simp [tieShare_eq_zero_of_not_mem h]

theorem tieShare_pos_of_mem {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P}
    (h : j ∈ winningProducers u profile) :
    0 < tieShare u profile j := by
  rw [tieShare_eq_inv_card_of_mem h]
  have hcard_pos : 0 < (winningProducers u profile).card :=
    Finset.card_pos.mpr ⟨j, h⟩
  exact inv_pos.mpr (by exact_mod_cast hcard_pos)

theorem mem_winningProducers_of_tieShare_pos {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P}
    (h : 0 < tieShare u profile j) :
    j ∈ winningProducers u profile := by
  by_contra hnot
  have hz : tieShare u profile j = 0 := tieShare_eq_zero_of_not_mem hnot
  linarith

theorem tieShare_eq_one_of_strictWinner {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P}
    (h : StrictWinner u profile j) :
    tieShare u profile j = 1 := by
  classical
  have hW : winningProducers u profile = {j} :=
    winningProducers_eq_singleton_of_strictWinner h
  have hj_mem : j ∈ winningProducers u profile := by
    rw [hW]
    simp
  rw [tieShare_eq_inv_card_of_mem hj_mem, hW]
  simp

theorem tieShare_scaleUser_pos {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P} {a : ℝ}
    (ha : 0 < a) :
    tieShare (scaleContent a u) profile j = tieShare u profile j := by
  have hW :
      winningProducers (scaleContent a u) profile =
        winningProducers u profile :=
    winningProducers_scaleUser_pos ha
  unfold tieShare
  rw [hW]

/-- A common positive rescaling of every content action preserves all score
comparisons, including ties.  This is the profile-level ranking component of
the positive cost/content scale transport used by the two-population phase
theorem. -/
theorem winningProducers_scaleProfile_pos {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {a : ℝ}
    (ha : 0 < a) :
    winningProducers u (fun j => scaleContent a (profile j)) =
      winningProducers u profile := by
  ext j
  rw [mem_winningProducers, mem_winningProducers]
  constructor
  · intro h k
    have hk := h k
    rw [score_scaleContent, score_scaleContent] at hk
    exact le_of_mul_le_mul_left hk ha
  · intro h k
    have hk := h k
    rw [score_scaleContent, score_scaleContent]
    exact mul_le_mul_of_nonneg_left hk (le_of_lt ha)

/-- Uniform-tie shares are invariant under a common positive rescaling of a
full producer profile. -/
theorem tieShare_scaleProfile_pos {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P} {a : ℝ}
    (ha : 0 < a) :
    tieShare u (fun k => scaleContent a (profile k)) j =
      tieShare u profile j := by
  have hW : winningProducers u (fun k => scaleContent a (profile k)) =
      winningProducers u profile :=
    winningProducers_scaleProfile_pos ha
  unfold tieShare
  rw [hW]

/--
If all producers choose the same content vector, every producer is a maximizer
for every user.
-/
theorem winningProducers_constantProfile {D P : ℕ}
    (u p : Content D) :
    winningProducers u (fun _ : Fin P => p) = Finset.univ := by
  ext j
  simp [winningProducers]

/--
If all `P` producers choose the same content vector, the source tie-breaking
rule gives each producer probability `1/P` for every user.
-/
theorem tieShare_constantProfile_eq_one_div {D P : ℕ}
    (u p : Content D) (j : Fin P) :
    tieShare u (fun _ : Fin P => p) j = 1 / (P : ℝ) := by
  have hwin : j ∈ winningProducers u (fun _ : Fin P => p) := by
    rw [winningProducers_constantProfile]
    simp
  rw [tieShare_eq_inv_card_of_mem hwin, winningProducers_constantProfile]
  simp [one_div]

theorem tieShare_lt_one_of_mem_card_one_lt {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P}
    (hmem : j ∈ winningProducers u profile)
    (hcard : 1 < (winningProducers u profile).card) :
    tieShare u profile j < 1 := by
  rw [tieShare_eq_inv_card_of_mem hmem]
  have hcard_real : (1 : ℝ) < ((winningProducers u profile).card : ℝ) := by
    exact_mod_cast hcard
  exact inv_lt_one_of_one_lt₀ hcard_real

theorem sum_tieShare_eq_one {D P : ℕ} [Nonempty (Fin P)]
    (u : Content D) (profile : Fin P → Content D) :
    (∑ j : Fin P, tieShare u profile j) = 1 := by
  classical
  let W := winningProducers u profile
  have hW_nonempty : W.Nonempty := winningProducers_nonempty u profile
  have hcard_ne : ((W.card : ℕ) : ℝ) ≠ 0 := by
    exact_mod_cast (ne_of_gt (Finset.card_pos.mpr hW_nonempty))
  let c : ℝ := ((W.card : ℕ) : ℝ)⁻¹
  have hsum_filter : (∑ j : Fin P, (if j ∈ W then c else 0)) = ∑ j ∈ W, c := by
    rw [← Finset.sum_filter]
    simp
  calc
    (∑ j : Fin P, tieShare u profile j)
        = ∑ j ∈ W, ((W.card : ℕ) : ℝ)⁻¹ := by
          simpa [tieShare, W, c] using hsum_filter
    _ = ((W.card : ℕ) : ℝ) * ((W.card : ℕ) : ℝ)⁻¹ := by
          simp
    _ = 1 := by
          exact mul_inv_cancel₀ hcard_ne

/-- Expected number of users assigned to producer `j` under source tie-breaking. -/
noncomputable def usersWon {D N P : ℕ}
    (users : Fin N → Content D) (profile : Fin P → Content D) (j : Fin P) : ℝ :=
  ∑ i : Fin N, tieShare (users i) profile j

/-- With all user embeddings zero, every producer receives the uniform user share. -/
theorem usersWon_zeroUsers_eq_card_mul_inv {D N P : ℕ} [Nonempty (Fin P)]
    (profile : Fin P → Content D) (j : Fin P) :
    usersWon (fun _ : Fin N => (0 : Content D)) profile j =
      (N : ℝ) * (P : ℝ)⁻¹ := by
  unfold usersWon
  simp_rw [tieShare_zeroContent_eq_inv_card]
  simp [Finset.sum_const, nsmul_eq_mul]

theorem usersWon_scaleUsers_pos {D N P : ℕ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    {scale : Fin N → ℝ} (hscale : ∀ i : Fin N, 0 < scale i) :
    usersWon (fun i => scaleContent (scale i) (users i)) profile j =
      usersWon users profile j := by
  unfold usersWon
  refine Finset.sum_congr rfl ?_
  intro i _hi
  exact tieShare_scaleUser_pos (hscale i)

/-- Total recommendation mass is invariant when every producer action in a
realized profile is multiplied by the same positive scalar. -/
theorem usersWon_scaleProfile_pos {D N P : ℕ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    {a : ℝ} (ha : 0 < a) :
    usersWon users (fun k => scaleContent a (profile k)) j =
      usersWon users profile j := by
  unfold usersWon
  refine Finset.sum_congr rfl ?_
  intro i _hi
  exact tieShare_scaleProfile_pos ha

/-- A two-population user market with exactly `K` copies of each type. -/
def twoPopulationUsers {D : ℕ} (K : ℕ) (users : Fin 2 → Content D) :
    Fin (2 * K) → Content D :=
  fun i => users (finProdFinEquiv.symm i).1

/-- Linear replication of a two-type row into `K` copies of each type. -/
def replicateTwoPopulationRowLinear (K : ℕ) :
    (Fin 2 → ℝ) →ₗ[ℝ] (Fin (2 * K) → ℝ) where
  toFun z := fun i => z (finProdFinEquiv.symm i).1
  map_add' := by
    intro x y
    ext i
    rfl
  map_smul' := by
    intro a x
    ext i
    rfl

@[simp] theorem replicateTwoPopulationRowLinear_apply
    (K : ℕ) (z : Fin 2 → ℝ) (i : Fin (2 * K)) :
    replicateTwoPopulationRowLinear K z i = z (finProdFinEquiv.symm i).1 :=
  rfl

/-- Repeating each of two user types `K` times scales assigned-user mass by
`K`, without changing which content actions are best responses after the
corresponding positive payoff rescaling. -/
theorem usersWon_twoPopulationUsers
    {D K P : ℕ} (users : Fin 2 → Content D)
    (profile : Fin P → Content D) (j : Fin P) :
    usersWon (twoPopulationUsers K users) profile j =
      (K : ℝ) * usersWon users profile j := by
  classical
  unfold usersWon
  calc
    (∑ i : Fin (2 * K), tieShare (twoPopulationUsers K users i) profile j) =
        ∑ x : Fin 2 × Fin K, tieShare (users x.1) profile j := by
          rw [← Equiv.sum_comp (finProdFinEquiv (m := 2) (n := K))
            (fun i : Fin (2 * K) =>
              tieShare (twoPopulationUsers K users i) profile j)]
          simp [twoPopulationUsers]
    _ = ∑ x : Fin 2, ∑ _ : Fin K, tieShare (users x) profile j := by
      exact Fintype.sum_prod_type _
    _ = ∑ x : Fin 2, (K : ℝ) * tieShare (users x) profile j := by
      simp [Finset.sum_const, nsmul_eq_mul]
    _ = (K : ℝ) * ∑ x : Fin 2, tieShare (users x) profile j := by
      rw [Finset.mul_sum]

theorem usersWon_nonneg {D N P : ℕ}
    (users : Fin N → Content D) (profile : Fin P → Content D) (j : Fin P) :
    0 ≤ usersWon users profile j := by
  exact Finset.sum_nonneg fun i _ => tieShare_nonneg (users i) profile j

theorem sum_usersWon_eq_card {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (profile : Fin P → Content D) :
    (∑ j : Fin P, usersWon users profile j) = (N : ℝ) := by
  classical
  unfold usersWon
  rw [Finset.sum_comm]
  calc
    (∑ i : Fin N, ∑ j : Fin P, tieShare (users i) profile j)
        = ∑ _i : Fin N, (1 : ℝ) := by
          refine Finset.sum_congr rfl ?_
          intro i _
          exact sum_tieShare_eq_one (users i) profile
    _ = (N : ℝ) := by
          simp

theorem usersWon_le_card {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (profile : Fin P → Content D) (j : Fin P) :
    usersWon users profile j ≤ (N : ℝ) := by
  have hsingle :
      usersWon users profile j ≤ ∑ k : Fin P, usersWon users profile k := by
    simpa using
      (Finset.single_le_sum
        (s := (Finset.univ : Finset (Fin P)))
        (f := fun k : Fin P => usersWon users profile k)
        (fun k _hk => usersWon_nonneg users profile k)
        (Finset.mem_univ j))
  simpa [sum_usersWon_eq_card users profile] using hsingle

/-- The dot-product score of a fixed user against one producer coordinate is measurable. -/
theorem measurable_score_profile {D P : ℕ} (u : Content D) (j : Fin P) :
    Measurable (fun profile : Fin P → Content D => score u (profile j)) := by
  unfold score
  exact Finset.measurable_sum Finset.univ fun d _hd =>
    measurable_const.mul ((measurable_pi_apply d).comp (measurable_pi_apply j))

/-- The event that a fixed producer belongs to the winning set is measurable. -/
theorem measurableSet_mem_winningProducers {D P : ℕ}
    (u : Content D) (j : Fin P) :
    MeasurableSet
      {profile : Fin P → Content D | j ∈ winningProducers u profile} := by
  classical
  have hsets :
      ∀ k : Fin P,
        MeasurableSet
          {profile : Fin P → Content D |
            score u (profile k) ≤ score u (profile j)} := by
    intro k
    exact measurableSet_le (measurable_score_profile u k)
      (measurable_score_profile u j)
  convert (MeasurableSet.iInter hsets) using 1
  ext profile
  simp [mem_winningProducers]

/-- The cardinality of the winning set as a real-valued function is measurable. -/
theorem measurable_winningProducers_card_cast {D P : ℕ} (u : Content D) :
    Measurable
      (fun profile : Fin P → Content D =>
        ((winningProducers u profile).card : ℝ)) := by
  classical
  have hsum :
      Measurable
        (fun profile : Fin P → Content D =>
          ∑ k : Fin P,
            if k ∈ winningProducers u profile then (1 : ℝ) else 0) := by
    exact Finset.measurable_sum Finset.univ fun k _hk =>
      Measurable.ite (measurableSet_mem_winningProducers u k)
        measurable_const measurable_const
  convert hsum using 1
  ext profile
  rw [← Finset.sum_filter]
  simp [winningProducers]

/-- Tie-breaking shares are measurable finite piecewise-constant functions. -/
theorem measurable_tieShare {D P : ℕ} (u : Content D) (j : Fin P) :
    Measurable (fun profile : Fin P → Content D => tieShare u profile j) := by
  classical
  have hmem := measurableSet_mem_winningProducers u j
  have hcard : Measurable
      (fun profile : Fin P → Content D =>
        ((winningProducers u profile).card : ℝ)) :=
    measurable_winningProducers_card_cast u
  exact Measurable.ite hmem hcard.inv measurable_const

/-- Total assigned-user mass for a producer is measurable. -/
theorem measurable_usersWon {D N P : ℕ}
    (users : Fin N → Content D) (j : Fin P) :
    Measurable (fun profile : Fin P → Content D => usersWon users profile j) := by
  unfold usersWon
  exact Finset.measurable_sum Finset.univ fun i _hi =>
    measurable_tieShare (users i) j

/--
Bounded-integrability helper for the mixed-strategy layer: the assigned-user
mass is always between `0` and the finite user count, so measurability implies
integrability under any finite measure.
-/
theorem integrable_usersWon_of_aestronglyMeasurable {D N P : ℕ} [Nonempty (Fin P)]
    {Ω : Type*} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
    [MeasureTheory.IsFiniteMeasure μ]
    {users : Fin N → Content D} {profile : Ω → Fin P → Content D} {j : Fin P}
    (hmeas :
      MeasureTheory.AEStronglyMeasurable
        (fun ω : Ω => usersWon users (profile ω) j) μ) :
    MeasureTheory.Integrable (fun ω : Ω => usersWon users (profile ω) j) μ := by
  refine MeasureTheory.Integrable.of_bound hmeas (N : ℝ) ?_
  filter_upwards with ω
  have hnonneg : 0 ≤ usersWon users (profile ω) j :=
    usersWon_nonneg users (profile ω) j
  have hle : usersWon users (profile ω) j ≤ (N : ℝ) :=
    usersWon_le_card users (profile ω) j
  rw [Real.norm_eq_abs, abs_of_nonneg hnonneg]
  exact hle

/--
Measurable version of `integrable_usersWon_of_aestronglyMeasurable`.
-/
theorem integrable_usersWon_of_measurable {D N P : ℕ} [Nonempty (Fin P)]
    {Ω : Type*} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
    [MeasureTheory.IsFiniteMeasure μ]
    {users : Fin N → Content D} {profile : Ω → Fin P → Content D} {j : Fin P}
    (hmeas : Measurable (fun ω : Ω => usersWon users (profile ω) j)) :
    MeasureTheory.Integrable (fun ω : Ω => usersWon users (profile ω) j) μ :=
  integrable_usersWon_of_aestronglyMeasurable μ hmeas.aestronglyMeasurable

/--
Finite pigeonhole step in Proposition `pure`: when there is at least one user
and at least one producer, some producer receives positive recommendation mass.
-/
theorem exists_producer_usersWon_pos {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    (users : Fin N → Content D) (profile : Fin P → Content D) :
    ∃ j : Fin P, 0 < usersWon users profile j := by
  classical
  have hNpos_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hNpos_nat : 0 < N := by
    simpa using hNpos_card
  have hsum_pos : 0 < ∑ j : Fin P, usersWon users profile j := by
    rw [sum_usersWon_eq_card users profile]
    exact_mod_cast hNpos_nat
  by_contra hnone
  have hall_nonpos : ∀ j : Fin P, usersWon users profile j ≤ 0 := by
    intro j
    exact le_of_not_gt (by intro hj; exact hnone ⟨j, hj⟩)
  have hsum_nonpos : (∑ j : Fin P, usersWon users profile j) ≤ 0 := by
    exact Finset.sum_nonpos fun j _hj => hall_nonpos j
  exact not_lt_of_ge hsum_nonpos hsum_pos

theorem exists_user_tieShare_pos_of_usersWon_pos {D N P : ℕ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    (h : 0 < usersWon users profile j) :
    ∃ i : Fin N, 0 < tieShare (users i) profile j := by
  classical
  unfold usersWon at h
  by_contra hnone
  have hall_nonpos : ∀ i : Fin N, tieShare (users i) profile j ≤ 0 := by
    intro i
    exact le_of_not_gt (by intro hi; exact hnone ⟨i, hi⟩)
  have hsum_nonpos : (∑ i : Fin N, tieShare (users i) profile j) ≤ 0 := by
    exact Finset.sum_nonpos fun i _hi => hall_nonpos i
  exact not_lt_of_ge hsum_nonpos h

theorem strictWinner_of_winning_noScoreTies {D N P : ℕ}
    {users : Fin N → Content D} {profile : Fin P → Content D}
    {i : Fin N} {j : Fin P}
    (hno : NoScoreTies users profile)
    (hwin : j ∈ winningProducers (users i) profile) :
    StrictWinner (users i) profile j := by
  intro k hk
  have hle : score (users i) (profile k) ≤ score (users i) (profile j) :=
    (mem_winningProducers (users i) profile j).mp hwin k
  have hne : score (users i) (profile k) ≠ score (users i) (profile j) := by
    exact hno i k j hk
  exact lt_of_le_of_ne hle hne

theorem uniqueWinningProducers_of_noScoreTies {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    (hno : NoScoreTies users profile) :
    UniqueWinningProducers users profile := by
  intro i
  rcases winningProducers_nonempty (users i) profile with ⟨j, hj⟩
  exact ⟨j, winningProducers_eq_singleton_of_strictWinner
    (strictWinner_of_winning_noScoreTies hno hj)⟩

theorem strictWinner_of_winning_uniqueWinningProducers {D N P : ℕ}
    {users : Fin N → Content D} {profile : Fin P → Content D}
    {i : Fin N} {j : Fin P}
    (huniq : UniqueWinningProducers users profile)
    (hwin : j ∈ winningProducers (users i) profile) :
    StrictWinner (users i) profile j := by
  classical
  rcases huniq i with ⟨w, hw⟩
  have hjw : j = w := by
    have : j ∈ ({w} : Finset (Fin P)) := by
      simpa [hw] using hwin
    simpa using this
  have hWj : winningProducers (users i) profile = {j} := by
    simpa [hjw] using hw
  intro k hk
  have hj_max :
      ∀ l : Fin P, score (users i) (profile l) ≤ score (users i) (profile j) :=
    (mem_winningProducers (users i) profile j).mp hwin
  by_contra hnot
  have hj_le_k : score (users i) (profile j) ≤ score (users i) (profile k) :=
    le_of_not_gt hnot
  have hkj_eq : score (users i) (profile k) = score (users i) (profile j) :=
    le_antisymm (hj_max k) hj_le_k
  have hkwin : k ∈ winningProducers (users i) profile := by
    rw [mem_winningProducers]
    intro l
    calc
      score (users i) (profile l) ≤ score (users i) (profile j) := hj_max l
      _ = score (users i) (profile k) := hkj_eq.symm
  have hkj : k = j := by
    have : k ∈ ({j} : Finset (Fin P)) := by
      simpa [hWj] using hkwin
    simpa using this
  exact hk hkj

theorem score_pos_of_strictWinner_nonnegative {D P : ℕ} [Nontrivial (Fin P)]
    {u : Content D} {profile : Fin P → Content D} {j : Fin P}
    (hu : NonnegativeContent u)
    (hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k))
    (hstrict : StrictWinner u profile j) :
    0 < score u (profile j) := by
  classical
  obtain ⟨k, hkj⟩ := exists_ne j
  have hk_nonneg : 0 ≤ score u (profile k) :=
    score_nonneg_of_nonnegative hu (hprofile_nonneg k)
  have hk_lt : score u (profile k) < score u (profile j) := hstrict k hkj
  exact lt_of_le_of_lt hk_nonneg hk_lt

theorem profile_nonzero_of_strictWinner_nonnegative {D P : ℕ} [Nontrivial (Fin P)]
    {u : Content D} {profile : Fin P → Content D} {j : Fin P}
    (hu : NonnegativeContent u)
    (hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k))
    (hstrict : StrictWinner u profile j) :
    NonzeroContent (profile j) := by
  classical
  by_contra hzero
  rw [NonzeroContent] at hzero
  push Not at hzero
  obtain ⟨k, hkj⟩ := exists_ne j
  have hk_nonneg : 0 ≤ score u (profile k) :=
    score_nonneg_of_nonnegative hu (hprofile_nonneg k)
  have hj_zero : score u (profile j) = 0 := by
    unfold score
    simp [hzero]
  have hk_lt : score u (profile k) < score u (profile j) := hstrict k hkj
  linarith

theorem exists_user_strictWinner_of_usersWon_pos_noScoreTies {D N P : ℕ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    (hno : NoScoreTies users profile)
    (hpos : 0 < usersWon users profile j) :
    ∃ i : Fin N, StrictWinner (users i) profile j := by
  rcases exists_user_tieShare_pos_of_usersWon_pos hpos with ⟨i, hi_pos⟩
  have hwin : j ∈ winningProducers (users i) profile :=
    mem_winningProducers_of_tieShare_pos hi_pos
  exact ⟨i, strictWinner_of_winning_noScoreTies hno hwin⟩

theorem exists_producer_user_strictWinner_of_noScoreTies {D N P : ℕ}
    [Nonempty (Fin N)] [Nonempty (Fin P)]
    (users : Fin N → Content D) (profile : Fin P → Content D)
    (hno : NoScoreTies users profile) :
    ∃ (j : Fin P) (i : Fin N), StrictWinner (users i) profile j := by
  rcases exists_producer_usersWon_pos users profile with ⟨j, hj_pos⟩
  rcases exists_user_strictWinner_of_usersWon_pos_noScoreTies hno hj_pos with ⟨i, hi⟩
  exact ⟨j, i, hi⟩

theorem exists_top_tie_of_not_uniqueWinningProducers {D N P : ℕ}
    [Nonempty (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    (hnot : ¬ UniqueWinningProducers users profile) :
    ∃ (i : Fin N) (j : Fin P),
      j ∈ winningProducers (users i) profile ∧
        1 < (winningProducers (users i) profile).card := by
  classical
  by_contra hnone
  have hnot_card :
      ∀ (i : Fin N) (j : Fin P),
        j ∈ winningProducers (users i) profile →
          ¬ 1 < (winningProducers (users i) profile).card := by
    intro i j hj hcard
    exact hnone ⟨i, j, hj, hcard⟩
  have huniq : UniqueWinningProducers users profile := by
    intro i
    rcases winningProducers_nonempty (users i) profile with ⟨j, hj⟩
    have hcard_le :
        (winningProducers (users i) profile).card ≤ 1 :=
      le_of_not_gt (hnot_card i j hj)
    refine ⟨j, ?_⟩
    rw [Finset.eq_singleton_iff_unique_mem]
    exact ⟨hj, fun k hk => (Finset.card_le_one.mp hcard_le) k hk j hj⟩
  exact hnot huniq

/-- Replace producer `j`'s content vector by a deviation `p`. -/
def deviateProfile {D P : ℕ}
    (profile : Fin P → Content D) (j : Fin P) (p : Content D) :
    Fin P → Content D :=
  Function.update profile j p

@[simp] theorem deviateProfile_self {D P : ℕ}
    (profile : Fin P → Content D) (j : Fin P) (p : Content D) :
    deviateProfile profile j p j = p := by
  simp [deviateProfile]

theorem deviateProfile_of_ne {D P : ℕ}
    (profile : Fin P → Content D) {j k : Fin P} (p : Content D) (h : k ≠ j) :
    deviateProfile profile j p k = profile k := by
  simp [deviateProfile, h]

/-- Scaling commutes with overwriting one coordinate of a finite producer
profile. -/
theorem scaleProfile_deviateProfile {D P : ℕ}
    (profile : Fin P → Content D) (j : Fin P) (p : Content D) (a : ℝ) :
    (fun k => scaleContent a (deviateProfile profile j p k)) =
      deviateProfile (fun k => scaleContent a (profile k)) j (scaleContent a p) := by
  ext k
  by_cases hkj : k = j
  · subst k
    simp
  · rw [deviateProfile_of_ne profile p hkj,
      deviateProfile_of_ne (fun k => scaleContent a (profile k)) (scaleContent a p) hkj]

/-- A coordinatewise positive content rescaling is measurable on finite
producer profiles. -/
theorem measurable_scaleProfile {D P : ℕ} (a : ℝ) :
    Measurable (fun profile : Fin P → Content D =>
      fun k => scaleContent a (profile k)) := by
  rw [measurable_pi_iff]
  intro k
  exact (measurable_scaleContent a).comp (measurable_pi_apply k)

/-- Overwriting one producer coordinate by a fixed content vector is measurable. -/
theorem measurable_deviateProfile_const {D P : ℕ} (j : Fin P) (p : Content D) :
    Measurable
      (fun profile : Fin P → Content D => deviateProfile profile j p) := by
  rw [measurable_pi_iff]
  intro k
  by_cases hk : k = j
  · subst k
    simpa [deviateProfile] using
      (measurable_const : Measurable fun _profile : Fin P → Content D => p)
  · simpa [deviateProfile, hk] using (measurable_pi_apply k)

/--
Replacing one producer coordinate by a variable pure action is jointly
measurable in that action and the original profile.  This is the
measure-theoretic bridge needed when a mixed deviation is averaged over its
pure-action components.
-/
theorem measurable_deviateProfile_variable {D P : ℕ} (j : Fin P) :
    Measurable
      (fun z : Content D × (Fin P → Content D) =>
        deviateProfile z.2 j z.1) := by
  rw [measurable_pi_iff]
  intro k
  by_cases hk : k = j
  · subst k
    simpa [deviateProfile] using
      (measurable_fst : Measurable fun z : Content D × (Fin P → Content D) => z.1)
  · simpa [deviateProfile, hk] using
      ((measurable_pi_apply k).comp
        (measurable_snd : Measurable fun z : Content D × (Fin P → Content D) => z.2))

/--
Assigned-user mass remains measurable after replacing one producer coordinate
by a fixed content vector.
-/
theorem measurable_usersWon_deviateProfile_const {D N P : ℕ}
    (users : Fin N → Content D) (j : Fin P) (p : Content D) :
    Measurable
      (fun profile : Fin P → Content D =>
        usersWon users (deviateProfile profile j p) j) :=
  (measurable_usersWon users j).comp (measurable_deviateProfile_const j p)

/-- Joint measurability of assigned-user mass after a variable pure deviation. -/
theorem measurable_usersWon_deviateProfile_variable {D N P : ℕ}
    (users : Fin N → Content D) (j : Fin P) :
    Measurable
      (fun z : Content D × (Fin P → Content D) =>
        usersWon users (deviateProfile z.2 j z.1) j) :=
  (measurable_usersWon users j).comp (measurable_deviateProfile_variable j)

theorem integrable_usersWon_deviateProfile_const {D N P : ℕ}
    [Nonempty (Fin P)]
    {μ : MeasureTheory.Measure (Content D)} [MeasureTheory.IsProbabilityMeasure μ]
    (users : Fin N → Content D) (j : Fin P) (p : Content D) :
    MeasureTheory.Integrable
      (fun profile : Fin P → Content D =>
        usersWon users (deviateProfile profile j p) j)
      (MeasureTheory.Measure.pi (fun _ : Fin P => μ)) :=
  integrable_usersWon_of_measurable
    (MeasureTheory.Measure.pi (fun _ : Fin P => μ))
    (measurable_usersWon_deviateProfile_const users j p)

theorem strictWinner_deviate_perturb_of_winner {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P} {ε : ℝ}
    (hu : NonnegativeContent u) (hzero : NonzeroContent u) (hwin : j ∈ winningProducers u profile)
    (hε : 0 < ε) :
    StrictWinner u (deviateProfile profile j (fun d => profile j d + ε * u d)) j := by
  intro k hk
  have hold_le : score u (profile k) ≤ score u (profile j) :=
    (mem_winningProducers u profile j).mp hwin k
  have hj_lt_new : score u (profile j) < score u (fun d => profile j d + ε * u d) :=
    score_perturb_self_strict hu hzero hε
  rw [deviateProfile_of_ne profile (fun d => profile j d + ε * u d) hk,
    deviateProfile_self]
  exact lt_of_le_of_lt hold_le hj_lt_new

/--
On the source atom event where every producer would otherwise choose the same
content vector `p`, perturbing producer `j` in user `u`'s direction makes `j`
the strict winner for that user.
-/
theorem tieShare_constantProfile_perturb_self_eq_one {D P : ℕ}
    {u p : Content D} {j : Fin P} {ε : ℝ}
    (hu : NonnegativeContent u) (hzero : NonzeroContent u) (hε : 0 < ε) :
    tieShare u
        (deviateProfile (fun _ : Fin P => p) j (fun d => p d + ε * u d)) j =
      1 := by
  have hwin : j ∈ winningProducers u (fun _ : Fin P => p) := by
    rw [winningProducers_constantProfile]
    simp
  exact tieShare_eq_one_of_strictWinner
    (strictWinner_deviate_perturb_of_winner hu hzero hwin hε)

/--
Exact tie-share gain on the source atom event: before perturbing, producer `j`
wins user `u` with probability `1/P`; after perturbing in `u`'s direction, `j`
wins with probability one.
-/
theorem tieShare_gain_constantProfile_perturb_eq_one_sub_one_div {D P : ℕ}
    {u p : Content D} {j : Fin P} {ε : ℝ}
    (hu : NonnegativeContent u) (hzero : NonzeroContent u) (hε : 0 < ε) :
    tieShare u
        (deviateProfile (fun _ : Fin P => p) j (fun d => p d + ε * u d)) j -
      tieShare u (fun _ : Fin P => p) j =
        1 - 1 / (P : ℝ) := by
  rw [tieShare_constantProfile_perturb_self_eq_one hu hzero hε,
    tieShare_constantProfile_eq_one_div]

theorem tieShare_strictly_increases_for_top_tie_perturb {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P} {ε : ℝ}
    (hu : NonnegativeContent u) (hzero : NonzeroContent u)
    (hwin : j ∈ winningProducers u profile)
    (hcard : 1 < (winningProducers u profile).card)
    (hε : 0 < ε) :
    tieShare u profile j <
      tieShare u (deviateProfile profile j (fun d => profile j d + ε * u d)) j := by
  have hnew_strict :
      StrictWinner u (deviateProfile profile j (fun d => profile j d + ε * u d)) j :=
    strictWinner_deviate_perturb_of_winner hu hzero hwin hε
  rw [tieShare_eq_one_of_strictWinner hnew_strict]
  exact tieShare_lt_one_of_mem_card_one_lt hwin hcard

theorem mem_winningProducers_deviate_perturb_of_winner {D P : ℕ}
    {v u : Content D} {profile : Fin P → Content D} {j : Fin P} {ε : ℝ}
    (hv : NonnegativeContent v) (hu : NonnegativeContent u) (hε : 0 ≤ ε)
    (hwin : j ∈ winningProducers v profile) :
    j ∈ winningProducers v
      (deviateProfile profile j (fun d => profile j d + ε * u d)) := by
  rw [mem_winningProducers]
  intro k
  by_cases hk : k = j
  · subst k
    exact le_rfl
  · rw [deviateProfile_of_ne profile (fun d => profile j d + ε * u d) hk,
      deviateProfile_self]
    exact le_trans ((mem_winningProducers v profile j).mp hwin k)
      (score_perturb_nonnegative_mono hv hu hε)

theorem winningProducers_deviate_perturb_subset_of_winner {D P : ℕ}
    {v u : Content D} {profile : Fin P → Content D} {j : Fin P} {ε : ℝ}
    (hv : NonnegativeContent v) (hu : NonnegativeContent u) (hε : 0 ≤ ε)
    (hwin : j ∈ winningProducers v profile) :
    winningProducers v
        (deviateProfile profile j (fun d => profile j d + ε * u d)) ⊆
      winningProducers v profile := by
  intro k hknew
  by_cases hkj : k = j
  · subst k
    exact hwin
  · rw [mem_winningProducers]
    intro l
    have hold_l : score v (profile l) ≤ score v (profile j) :=
      (mem_winningProducers v profile j).mp hwin l
    have hmono : score v (profile j) ≤
        score v (fun d => profile j d + ε * u d) :=
      score_perturb_nonnegative_mono hv hu hε
    have hnew_j_le_k : score v
        ((deviateProfile profile j (fun d => profile j d + ε * u d)) j) ≤
        score v
          ((deviateProfile profile j (fun d => profile j d + ε * u d)) k) :=
      (mem_winningProducers v
        (deviateProfile profile j (fun d => profile j d + ε * u d)) k).mp
          hknew j
    rw [deviateProfile_self,
      deviateProfile_of_ne profile (fun d => profile j d + ε * u d) hkj]
      at hnew_j_le_k
    exact le_trans hold_l (le_trans hmono hnew_j_le_k)

theorem tieShare_le_deviate_perturb_of_winner {D P : ℕ}
    {v u : Content D} {profile : Fin P → Content D} {j : Fin P} {ε : ℝ}
    (hv : NonnegativeContent v) (hu : NonnegativeContent u) (hε : 0 ≤ ε)
    (hwin : j ∈ winningProducers v profile) :
    tieShare v profile j ≤
      tieShare v (deviateProfile profile j (fun d => profile j d + ε * u d)) j := by
  let profile' := deviateProfile profile j (fun d => profile j d + ε * u d)
  have hnew : j ∈ winningProducers v profile' :=
    mem_winningProducers_deviate_perturb_of_winner hv hu hε hwin
  have hsubset : winningProducers v profile' ⊆ winningProducers v profile :=
    winningProducers_deviate_perturb_subset_of_winner hv hu hε hwin
  have hcard_le :
      (winningProducers v profile').card ≤ (winningProducers v profile).card :=
    Finset.card_le_card hsubset
  have hcard_new_pos_nat : 0 < (winningProducers v profile').card :=
    Finset.card_pos.mpr ⟨j, hnew⟩
  have hcard_new_pos :
      0 < ((winningProducers v profile').card : ℝ) := by
    exact_mod_cast hcard_new_pos_nat
  have hcard_le_real :
      ((winningProducers v profile').card : ℝ) ≤
        ((winningProducers v profile).card : ℝ) := by
    exact_mod_cast hcard_le
  rw [tieShare_eq_inv_card_of_mem hwin, tieShare_eq_inv_card_of_mem hnew]
  simpa [one_div] using
    one_div_le_one_div_of_le hcard_new_pos hcard_le_real

theorem tieShare_le_deviate_perturb {D P : ℕ}
    {v u : Content D} {profile : Fin P → Content D} {j : Fin P} {ε : ℝ}
    (hv : NonnegativeContent v) (hu : NonnegativeContent u) (hε : 0 ≤ ε) :
    tieShare v profile j ≤
      tieShare v (deviateProfile profile j (fun d => profile j d + ε * u d)) j := by
  by_cases hwin : j ∈ winningProducers v profile
  · exact tieShare_le_deviate_perturb_of_winner hv hu hε hwin
  · rw [tieShare_eq_zero_of_not_mem hwin]
    exact tieShare_nonneg v
      (deviateProfile profile j (fun d => profile j d + ε * u d)) j

theorem usersWon_lt_deviate_perturb_of_top_tie {D N P : ℕ}
    {users : Fin N → Content D} {profile : Fin P → Content D}
    {i0 : Fin N} {j : Fin P} {ε : ℝ}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0))
    (hwin : j ∈ winningProducers (users i0) profile)
    (hcard : 1 < (winningProducers (users i0) profile).card)
    (hε : 0 < ε) :
    usersWon users profile j <
      usersWon users
        (deviateProfile profile j (fun d => profile j d + ε * users i0 d)) j := by
  unfold usersWon
  refine Finset.sum_lt_sum ?_ ?_
  · intro i _hi
    exact tieShare_le_deviate_perturb (husers_nonneg i) (husers_nonneg i0) hε.le
  · exact ⟨i0, Finset.mem_univ i0,
      tieShare_strictly_increases_for_top_tie_perturb (husers_nonneg i0)
        hzero hwin hcard hε⟩

theorem top_tie_share_jump_le_usersWon_gain {D N P : ℕ}
    {users : Fin N → Content D} {profile : Fin P → Content D}
    {i0 : Fin N} {j : Fin P} {ε : ℝ}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0))
    (hwin : j ∈ winningProducers (users i0) profile)
    (hε : 0 < ε) :
    1 - tieShare (users i0) profile j ≤
      usersWon users
          (deviateProfile profile j (fun d => profile j d + ε * users i0 d)) j -
        usersWon users profile j := by
  let profile' := deviateProfile profile j (fun d => profile j d + ε * users i0 d)
  let f : Fin N → ℝ := fun i => tieShare (users i) profile j
  let g : Fin N → ℝ := fun i => tieShare (users i) profile' j
  have hle : ∀ i : Fin N, f i ≤ g i := by
    intro i
    exact tieShare_le_deviate_perturb (husers_nonneg i) (husers_nonneg i0) hε.le
  have hi0_new : g i0 = 1 := by
    have hstrict : StrictWinner (users i0) profile' j :=
      strictWinner_deviate_perturb_of_winner (husers_nonneg i0) hzero hwin hε
    exact tieShare_eq_one_of_strictWinner hstrict
  have hdiff_nonneg : ∀ i : Fin N, 0 ≤ g i - f i := by
    intro i
    linarith [hle i]
  have htail_nonneg : 0 ≤ ∑ i ∈ (Finset.univ.erase i0), (g i - f i) := by
    exact Finset.sum_nonneg fun i _hi => hdiff_nonneg i
  have hdiff_le_sum : g i0 - f i0 ≤ ∑ i : Fin N, (g i - f i) := by
    rw [← Finset.add_sum_erase Finset.univ (fun i : Fin N => g i - f i)
      (Finset.mem_univ i0)]
    linarith
  have hsum_sub :
      (∑ i : Fin N, (g i - f i)) =
        (∑ i : Fin N, g i) - (∑ i : Fin N, f i) := by
    rw [Finset.sum_sub_distrib]
  unfold usersWon
  dsimp [f, g, profile'] at hdiff_le_sum hi0_new hsum_sub
  calc
    1 - tieShare (users i0) profile j
        = tieShare (users i0) profile' j - tieShare (users i0) profile j := by
          rw [hi0_new]
    _ ≤ ∑ i : Fin N,
          (tieShare (users i) profile' j - tieShare (users i) profile j) :=
          hdiff_le_sum
    _ = (∑ i : Fin N, tieShare (users i) profile' j) -
          (∑ i : Fin N, tieShare (users i) profile j) := by
          exact hsum_sub

theorem usersWon_eq_of_tieShare_eq {D N P : ℕ}
    {users : Fin N → Content D} {profile profile' : Fin P → Content D}
    {j : Fin P}
    (hshare : ∀ i : Fin N, tieShare (users i) profile j =
      tieShare (users i) profile' j) :
    usersWon users profile j = usersWon users profile' j := by
  unfold usersWon
  exact Finset.sum_congr rfl (fun i _hi => hshare i)

theorem not_mem_winningProducers_deviate_scale_of_not_mem {D P : ℕ}
    {u : Content D} {profile : Fin P → Content D} {j : Fin P} {a : ℝ}
    (hu : NonnegativeContent u) (hpj : NonnegativeContent (profile j))
    (ha : a ≤ 1)
    (hnot : j ∉ winningProducers u profile) :
    j ∉ winningProducers u (deviateProfile profile j (scaleContent a (profile j))) := by
  classical
  rw [mem_winningProducers] at hnot
  push Not at hnot
  rcases hnot with ⟨k, hk_lt⟩
  have hkj : k ≠ j := by
    intro h
    subst k
    exact (lt_irrefl (score u (profile j))) hk_lt
  have hscaled_le : score u (scaleContent a (profile j)) ≤ score u (profile j) :=
    score_scaleContent_le_self_of_nonnegative hu hpj ha
  have hnew_lt : score u
      ((deviateProfile profile j (scaleContent a (profile j))) j) <
      score u ((deviateProfile profile j (scaleContent a (profile j))) k) := by
    rw [deviateProfile_self, deviateProfile_of_ne profile (scaleContent a (profile j)) hkj]
    exact lt_of_le_of_lt hscaled_le hk_lt
  by_contra hmem
  have hle : score u
      ((deviateProfile profile j (scaleContent a (profile j))) k) ≤
      score u ((deviateProfile profile j (scaleContent a (profile j))) j) :=
    (mem_winningProducers u (deviateProfile profile j (scaleContent a (profile j))) j).mp
      hmem k
  exact not_lt_of_ge hle hnew_lt

theorem usersWon_eq_deviate_scale_of_preserved_winners {D N P : ℕ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P} {a : ℝ}
    (hno : NoScoreTies users profile)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k))
    (ha : a ≤ 1)
    (hpreserve : ∀ i : Fin N, j ∈ winningProducers (users i) profile →
      StrictWinner (users i)
        (deviateProfile profile j (scaleContent a (profile j))) j) :
    usersWon users profile j =
      usersWon users (deviateProfile profile j (scaleContent a (profile j))) j := by
  refine usersWon_eq_of_tieShare_eq ?_
  intro i
  by_cases hwin : j ∈ winningProducers (users i) profile
  · have hold_strict : StrictWinner (users i) profile j :=
      strictWinner_of_winning_noScoreTies hno hwin
    have hnew_strict :
        StrictWinner (users i)
          (deviateProfile profile j (scaleContent a (profile j))) j :=
      hpreserve i hwin
    rw [tieShare_eq_one_of_strictWinner hold_strict,
      tieShare_eq_one_of_strictWinner hnew_strict]
  · have hnew_not : j ∉ winningProducers (users i)
        (deviateProfile profile j (scaleContent a (profile j))) :=
      not_mem_winningProducers_deviate_scale_of_not_mem
        (husers_nonneg i) (hprofile_nonneg j) ha hwin
    rw [tieShare_eq_zero_of_not_mem hwin, tieShare_eq_zero_of_not_mem hnew_not]

theorem usersWon_eq_deviate_scale_of_preserved_winners_unique {D N P : ℕ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P} {a : ℝ}
    (huniq : UniqueWinningProducers users profile)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k))
    (ha : a ≤ 1)
    (hpreserve : ∀ i : Fin N, j ∈ winningProducers (users i) profile →
      StrictWinner (users i)
        (deviateProfile profile j (scaleContent a (profile j))) j) :
    usersWon users profile j =
      usersWon users (deviateProfile profile j (scaleContent a (profile j))) j := by
  refine usersWon_eq_of_tieShare_eq ?_
  intro i
  by_cases hwin : j ∈ winningProducers (users i) profile
  · have hold_strict : StrictWinner (users i) profile j :=
      strictWinner_of_winning_uniqueWinningProducers huniq hwin
    have hnew_strict :
        StrictWinner (users i)
          (deviateProfile profile j (scaleContent a (profile j))) j :=
      hpreserve i hwin
    rw [tieShare_eq_one_of_strictWinner hold_strict,
      tieShare_eq_one_of_strictWinner hnew_strict]
  · have hnew_not : j ∉ winningProducers (users i)
        (deviateProfile profile j (scaleContent a (profile j))) :=
      not_mem_winningProducers_deviate_scale_of_not_mem
        (husers_nonneg i) (hprofile_nonneg j) ha hwin
    rw [tieShare_eq_zero_of_not_mem hwin, tieShare_eq_zero_of_not_mem hnew_not]

/--
Scale-down preserves a producer's total recommendation mass when every active
(nonzero) user that the producer wins is a strict winner before and after the
deviation.  Zero-user rows remain ties before and after any content change,
so they do not need the false global `NoScoreTies` premise.
-/
theorem usersWon_eq_deviate_scale_of_preserved_active_strictWinners
    {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    {j : Fin P} {a : ℝ}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k))
    (ha : a ≤ 1)
    (hactive_old : ∀ i : Fin N, NonzeroContent (users i) →
      j ∈ winningProducers (users i) profile →
        StrictWinner (users i) profile j)
    (hactive_new : ∀ i : Fin N, NonzeroContent (users i) →
      j ∈ winningProducers (users i) profile →
        StrictWinner (users i)
          (deviateProfile profile j (scaleContent a (profile j))) j) :
    usersWon users profile j =
      usersWon users (deviateProfile profile j (scaleContent a (profile j))) j := by
  refine usersWon_eq_of_tieShare_eq ?_
  intro i
  by_cases hi_nonzero : NonzeroContent (users i)
  · by_cases hwin : j ∈ winningProducers (users i) profile
    · rw [tieShare_eq_one_of_strictWinner (hactive_old i hi_nonzero hwin),
        tieShare_eq_one_of_strictWinner (hactive_new i hi_nonzero hwin)]
    · have hnew_not : j ∉ winningProducers (users i)
          (deviateProfile profile j (scaleContent a (profile j))) :=
        not_mem_winningProducers_deviate_scale_of_not_mem
          (husers_nonneg i) (hprofile_nonneg j) ha hwin
      rw [tieShare_eq_zero_of_not_mem hwin, tieShare_eq_zero_of_not_mem hnew_not]
  · have hi_zero : users i = 0 :=
      content_eq_zero_of_not_nonzeroContent hi_nonzero
    rw [hi_zero, tieShare_zeroContent_eq_inv_card,
      tieShare_zeroContent_eq_inv_card]

/--
Finite active-score margins permit a common scale factor below one that keeps
every producer win strict for each nonzero user.  Unlike the older global
no-score-ties lemma, zero-user rows are deliberately excluded from the margin
calculation because their scores are identically zero and their tie shares are
unchanged by scaling.
-/
theorem exists_scale_down_preserving_active_strictWinners {D N P : ℕ}
    [Nontrivial (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    (hactive : ∀ i : Fin N, NonzeroContent (users i) →
      j ∈ winningProducers (users i) profile →
        StrictWinner (users i) profile j)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k)) :
    ∃ a : ℝ, 0 ≤ a ∧ a < 1 ∧
      ∀ i : Fin N, NonzeroContent (users i) →
        j ∈ winningProducers (users i) profile →
          StrictWinner (users i)
            (deviateProfile profile j (scaleContent a (profile j))) j := by
  classical
  let threshold : Fin N × Fin P → ℝ := fun pair =>
    if hrel : pair.2 ≠ j ∧ NonzeroContent (users pair.1) ∧
        (∀ k : Fin P, score (users pair.1) (profile k) ≤
          score (users pair.1) (profile j)) then
      score (users pair.1) (profile pair.2) / score (users pair.1) (profile j)
    else
      0
  have hthreshold_lt : ∀ pair : Fin N × Fin P, threshold pair < 1 := by
    intro pair
    dsimp [threshold]
    by_cases hrel : pair.2 ≠ j ∧ NonzeroContent (users pair.1) ∧
        (∀ k : Fin P, score (users pair.1) (profile k) ≤
          score (users pair.1) (profile j))
    · simp [hrel]
      have hwin : j ∈ winningProducers (users pair.1) profile :=
        (mem_winningProducers (users pair.1) profile j).mpr hrel.2.2
      have hstrict : StrictWinner (users pair.1) profile j :=
        hactive pair.1 hrel.2.1 hwin
      have hscore_pos : 0 < score (users pair.1) (profile j) :=
        score_pos_of_strictWinner_nonnegative (husers_nonneg pair.1)
          hprofile_nonneg hstrict
      have hlt : score (users pair.1) (profile pair.2) <
          score (users pair.1) (profile j) :=
        hstrict pair.2 hrel.1
      have hdiv_lt :
          score (users pair.1) (profile pair.2) /
              score (users pair.1) (profile j) <
            score (users pair.1) (profile j) /
              score (users pair.1) (profile j) :=
        div_lt_div_of_pos_right hlt hscore_pos
      simpa [div_self (ne_of_gt hscore_pos)] using hdiv_lt
    · simp [hrel]
  rcases exists_scale_between_fintype threshold hthreshold_lt with
    ⟨a, ha_nonneg, ha_lt, ha_bound⟩
  refine ⟨a, ha_nonneg, ha_lt, ?_⟩
  intro i hi_nonzero hwin k hk
  have hstrict_old : StrictWinner (users i) profile j :=
    hactive i hi_nonzero hwin
  have hscore_pos : 0 < score (users i) (profile j) :=
    score_pos_of_strictWinner_nonnegative (husers_nonneg i) hprofile_nonneg
      hstrict_old
  have hratio_lt :
      score (users i) (profile k) / score (users i) (profile j) < a := by
    have hbound := ha_bound (i, k)
    have hrel : k ≠ j ∧ NonzeroContent (users i) ∧
        (∀ l : Fin P, score (users i) (profile l) ≤
          score (users i) (profile j)) :=
      ⟨hk, hi_nonzero, (mem_winningProducers (users i) profile j).mp hwin⟩
    simpa [threshold, hrel] using hbound
  have hscaled_lt : score (users i) (profile k) <
      a * score (users i) (profile j) := by
    rw [div_lt_iff₀ hscore_pos] at hratio_lt
    simpa [mul_comm] using hratio_lt
  rw [deviateProfile_of_ne profile (scaleContent a (profile j)) hk,
    deviateProfile_self, score_scaleContent]
  exact hscaled_lt

theorem exists_scale_down_preserving_winners_of_noScoreTies {D N P : ℕ}
    [Nontrivial (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
