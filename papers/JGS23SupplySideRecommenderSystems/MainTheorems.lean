    (hd1 : 0 < d1) (hd2 : 0 < d2) (hα2 : 0 ≤ α2)
    (hfirst_cap : r2 * c2 < r1 * c1)
    (hsecond_cap : r1 * d1 < r2 * d2)
    (hdensity1 : ∀ z : ℝ, 0 < z / c1 → z / c1 < r1 →
