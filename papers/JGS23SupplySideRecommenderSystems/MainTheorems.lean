theorem canonicalTwoUser_valueSupport_strictInterior_of_scaledNormRpowCostNash_of_phase_of_cos_zero
    {P : ℕ} [Nonempty (Fin P)] {α β theta : ℝ} {mu : Measure (Content 2)}
    [IsProbabilityMeasure mu]
    (hP : 1 < P) (hα : 0 < α) (hβ : 1 ≤ β)
    (hsin : 0 < Real.sin theta) (hcos : Real.cos theta = 0)
    (hβlt : β < twoUserPhaseThreshold theta)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) mu)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta) q) mu ≪
        volume) :
    ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos theta < z.2 := by
  let μ1 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu
  let μ2 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu
  let H1 : ℝ → ℝ := fun x =>
    AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 x
  let H2 : ℝ → ℝ := fun x =>
    AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 x
  letI : IsProbabilityMeasure μ1 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  letI : IsProbabilityMeasure μ2 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond theta)).aemeasurable
  have hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap theta) mu).support :=
    canonicalTwoUser_isCompact_valueSupport_of_scaledNormRpowCostNash
      hnash hα (lt_of_lt_of_le zero_lt_one hβ)
  have hordered : ∀ p ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support,
      ∀ q ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support,
        p.1 < q.1 → p.2 ≤ q.2 :=
    canonicalTwoUser_valueSupport_ordered_of_scaledNormRpowCostNash_of_phase_of_cos_zero
      hα hβ hsin hcos hβlt hnash hscore_ac
  have hfeasible : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support,
      z ∈ canonicalTwoUserFeasibleValueSet theta := by
    intro z hz
    change NonnegativeContent (canonicalTwoUserContentOfValues theta z.1 z.2)
    exact hnash.2.1
      (canonicalTwoUserContentOfValues_mem_support_of_mem_valueMap_support hsin.ne' hz)
  have hmax : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support,
      IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
          twoUserInducedCost α β theta w.1 w.2)
        (canonicalTwoUserFeasibleValueSet theta) z := by
    intro z hz
    simpa [H1, H2, μ1, μ2] using
      canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
        hsin hnash hscore_ac z hz
  have hcos_nonneg : 0 ≤ Real.cos theta := by rw [hcos]
  have horigin : (0, 0) ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support :=
    canonicalTwoUser_zero_mem_valueSupport_of_compact_ordered_iidC1
      hP hcompact hordered hmax hscore_ac hfeasible hα
      (lt_of_lt_of_le zero_lt_one hβ) hsin hcos_nonneg
  have hcone : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support,
      Real.cos theta * z.2 ≤ z.1 ∧ z.1 * Real.cos theta ≤ z.2 := by
    intro z hz
    have hzfeasible := hfeasible z hz
    have hupper : Real.cos theta * z.2 ≤ z.1 :=
      canonicalTwoUser_secondUserSlope_le_of_isMaxOn_of_mono_rewards
        (hmax z hz) hzfeasible hα (lt_of_lt_of_le zero_lt_one hβ)
        hsin hcos_nonneg
        (AppliedModelingLib.Probability.iidMaximumCdf_mono (n := P - 1) μ1)
    exact ⟨hupper, (mem_canonicalTwoUserFeasibleValueSet_iff hsin).mp hzfeasible |>.2⟩
  have hreward : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support,
      H1 z.1 = H2 z.2 := by
    intro z hz
    have hcdf :=
      canonicalTwoUser_lowerCDFMass_second_eq_first_of_scaledNormRpowCostNash_of_phase_of_cos_zero
        hα hβ hsin hcos hβlt hnash hscore_ac hz
    dsimp [H1, H2]
    rw [AppliedModelingLib.Probability.iidMaximumCdf_eq_lowerCDFMass_pow,
      AppliedModelingLib.Probability.iidMaximumCdf_eq_lowerCDFMass_pow]
    simpa [μ1, μ2] using congrArg (fun t : ℝ => t ^ (P - 1)) hcdf.symm
  obtain ⟨hinjfst, hinjsnd⟩ :=
    twoUser_support_injOn_projections_of_isMaxOn_of_equal_rewards_of_closedCone
      hmax hfeasible hcone hreward hα (lt_of_lt_of_le zero_lt_one hβ) hsin
  intro z hz hne
  have hzcone := (mem_canonicalTwoUserFeasibleValueSet_iff hsin).mp (hfeasible z hz)
  have hz1_nonneg : 0 ≤ z.1 := hzcone.1
  have hz2_nonneg : 0 ≤ z.2 := by simpa [hcos] using hzcone.2
  have hz1_pos : 0 < z.1 := by
    by_contra hnot
    have hz1_zero : z.1 = 0 := le_antisymm (le_of_not_gt hnot) hz1_nonneg
    have hpair : (0, 0) = z :=
      hinjfst horigin hz (by simpa [hz1_zero])
    exact hne hpair.symm
  have hz2_pos : 0 < z.2 := by
    by_contra hnot
    have hz2_zero : z.2 = 0 := le_antisymm (le_of_not_gt hnot) hz2_nonneg
    have hpair : (0, 0) = z :=
      hinjsnd horigin hz (by simpa [hz2_zero])
    exact hne hpair.symm
  exact ⟨hz1_pos, by simpa [hcos] using hz2_pos⟩

