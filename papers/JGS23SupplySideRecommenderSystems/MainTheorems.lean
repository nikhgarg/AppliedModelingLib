            AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 w.2 -
              twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z := by
    intro z hz
    simpa [μ1, μ2] using
