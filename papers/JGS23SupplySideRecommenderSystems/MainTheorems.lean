/--
Lemma `regionscolor`, parametrized sign transfer: under the source positivity
assumptions, the nonpositive sign of the slope times the cross-partial is
equivalent to the nonpositive sign of the slope times the printed
`secondderiv` bracket.
-/
theorem twoUser_regionscolor_param_bracket_nonpos_of_cross_nonpos
    {α β θ φ r slope : ℝ}
    (hα : 0 < α)
    (hβ : 0 < β)
    (hsin : 0 < Real.sin θ)
    (hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2)
    (hcross :
      slope * twoUserInducedCostCrossPartial α β θ
        (r * Real.cos φ) (r * Real.cos (θ - φ)) ≤ 0) :
    slope * twoUserSecondDerivSignBracket β θ φ ≤ 0 := by
  have hfactor :=
    twoUserInducedCostCrossPartial_param_factor
      (α := α) (β := β) (θ := θ) (φ := φ) (r := r) hβ.ne' hNpos
  have hscale_pos : 0 < twoUserSecondDerivPositiveScale α β θ r :=
    twoUserSecondDerivPositiveScale_pos hα hβ hsin hNpos
  have hrewrite :
      slope * twoUserInducedCostCrossPartial α β θ
          (r * Real.cos φ) (r * Real.cos (θ - φ)) =
        twoUserSecondDerivPositiveScale α β θ r *
          (slope * twoUserSecondDerivSignBracket β θ φ) := by
    rw [hfactor]
    unfold twoUserSecondDerivPositiveScale
    ring
  rw [hrewrite] at hcross
  have hcross' :
      twoUserSecondDerivPositiveScale α β θ r *
          (slope * twoUserSecondDerivSignBracket β θ φ) ≤
        twoUserSecondDerivPositiveScale α β θ r * 0 := by
    simpa using hcross
  exact le_of_mul_le_mul_left hcross' hscale_pos

/-- Source-faithful `regionscolor` endpoint.  A differentiable support graph
of C1 maximizers in the original nonnegative-content score cone satisfies the
printed slope/bracket inequality.  This replaces the source proof's
unjustified density-derivative and Hessian-SOC steps with the C1 four-point
argument above. -/
theorem twoUser_regionscolor_param_bracket_nonpos_of_C1_graph_cone
    {u v : Content 2} {H1 H2 g : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    {α β θ φ r a b x slope : ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hcos : 0 ≤ Real.cos θ)
    (hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2)
    (hxI : x ∈ Set.Ioo a b) (hx : 0 < x)
    (hxparam : x = r * Real.cos φ)
    (hgparam : g x = r * Real.cos (θ - φ))
    (hderiv : HasDerivAt g slope x)
    (hgraph : ∀ w ∈ Set.Ioo a b, (w, g w) ∈ S)
    (hScone : S ⊆ twoUserClosedUserCone θ)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2) (twoUserScoreFeasibleSet u v) z) :
    slope * twoUserSecondDerivSignBracket β θ φ ≤ 0 := by
  apply twoUser_regionscolor_param_bracket_nonpos_of_cross_nonpos
    hα hβ hsin hNpos
  have hcross := twoUser_slope_crossPartial_nonpos_of_isMaxOn_graph_of_cone
    hu_nonnegative hv_nonnegative hu hv huv hα hβ hsin hcos hxI hx hderiv hgraph hScone hmax
  rw [hgparam, hxparam] at hcross
  exact hcross

/--
Lemma `regionscolor`, composed C1/Hessian endpoint: the negative-semidefinite
graph Hessian condition used in the source proof implies the printed
support-slope/bracket inequality after the canonical two-user parametrization.
-/
theorem twoUser_regionscolor_param_bracket_nonpos_of_negativeSemidefinite
    {α β θ φ r slope : ℝ}
    (hα : 0 < α)
    (hβ : 0 < β)
    (hsin : 0 < Real.sin θ)
    (hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2)
    (hneg :
      NegativeSemidefiniteQuadratic2
        (slope *
          twoUserInducedCostCrossPartial α β θ
            (r * Real.cos φ) (r * Real.cos (θ - φ)))
        (-(twoUserInducedCostCrossPartial α β θ
            (r * Real.cos φ) (r * Real.cos (θ - φ))))
        (slope⁻¹ *
          twoUserInducedCostCrossPartial α β θ
            (r * Real.cos φ) (r * Real.cos (θ - φ)))) :
    slope * twoUserSecondDerivSignBracket β θ φ ≤ 0 :=
  twoUser_regionscolor_param_bracket_nonpos_of_cross_nonpos
    hα hβ hsin hNpos
    (graphHessian_cross_sign_of_negativeSemidefinite hneg)

/--
Lemma `regionscolor`, source-shaped SOC bridge. The local second-order
condition and the two differentiated FOC identities along a support graph
imply the printed slope/bracket inequality. The graph, its FOC neighborhood,
and the differentiability that justify these premises are not inferred here.
-/
theorem twoUser_regionscolor_param_bracket_nonpos_of_objectiveSOC_and_graphFOCDerivatives
    {α β θ φ r slope c11 c22 h1prime h2prime : ℝ}
    (hα : 0 < α)
    (hβ : 0 < β)
    (hsin : 0 < Real.sin θ)
    (hNpos : 0 < r ^ 2 * (Real.sin θ) ^ 2)
    (hsoc :
      NegativeSemidefiniteQuadratic2
        (h1prime - c11)
        (-(twoUserInducedCostCrossPartial α β θ
          (r * Real.cos φ) (r * Real.cos (θ - φ))))
        (h2prime - c22))
    (hfirst : h1prime = c11 + slope *
      twoUserInducedCostCrossPartial α β θ
        (r * Real.cos φ) (r * Real.cos (θ - φ)))
    (hsecond : h2prime = c22 + slope⁻¹ *
      twoUserInducedCostCrossPartial α β θ
        (r * Real.cos φ) (r * Real.cos (θ - φ))) :
    slope * twoUserSecondDerivSignBracket β θ φ ≤ 0 := by
  apply twoUser_regionscolor_param_bracket_nonpos_of_negativeSemidefinite
    hα hβ hsin hNpos
  exact graphHessian_negativeSemidefinite_of_objectiveSOC_and_graphFOCDerivatives
    hsoc hfirst hsecond

