  have hderiv2 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support,
      z ≠ (0, 0) → HasDerivAt H2 (deriv H2 z.2) z.2 := by
    intro z hz hne
    exact ((hcontDiff2 z hz hne).differentiableAt one_ne_zero).hasDerivAt
  have hstrict_graph : ∀ x ∈ Set.Icc 0 B, 0 < x →
      x * Real.cos theta < g x :=
    twoUser_valueSupport_graph_strictLower_of_origin_of_equal_rewards
      hα (lt_of_lt_of_le zero_lt_one hβ) hsin hB horigin hgraph_zero hgraph_mem
      hfeasible hmax htransport
      (AppliedModelingLib.Probability.iidMaximumCdf_mono (n := P - 1) μ2)
      hderiv1 hderiv2
  intro z hz hne
  have hzfeasible := hfeasible z hz
  have hzcone := (mem_canonicalTwoUserFeasibleValueSet_iff hsin).mp hzfeasible
  have hz2_nonneg : 0 ≤ z.2 :=
    le_trans (mul_nonneg hzcone.1 hcos.le) hzcone.2
  have hzupper : Real.cos theta * z.2 ≤ z.1 :=
    canonicalTwoUser_secondUserSlope_le_of_isMaxOn_of_mono_rewards
      (hmax z hz) hzfeasible hα (lt_of_lt_of_le zero_lt_one hβ)
      hsin hcos.le
      (AppliedModelingLib.Probability.iidMaximumCdf_mono (n := P - 1) μ1)
  have hz1_pos : 0 < z.1 := by
    apply lt_of_le_of_ne hzcone.1
    intro hz1_zero
    have hz2_zero : z.2 = 0 := by
      have : Real.cos theta * z.2 = 0 := by
