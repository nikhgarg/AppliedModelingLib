/--
Corrected compact-source form of Theorem `singlegenre`.  In the paper's
nonzero-user finite-dimensional regime, existence of a source symmetric mixed
equilibrium with exactly one *nonzero-support* genre is equivalent to the
coordinate-product condition on the powered nonnegative unit-ball image.

The qualifier is necessary: the source's literal genre display normalizes the
zero support action of the ray law, which is undefined.  Compact sublevels,
norm continuity, and perturbation continuity are the explicit finite-norm
bridges used by the source CDF/atom argument.
-/
theorem exists_sourceSymmetricMixedNash_singleton_nonzeroSupportGenre_iff_productSupCondition_of_compactSublevels
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} (ν : SourceNorm D) {β : ℝ}
    (hβ : 0 < β) (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hperturb : SourceNormPerturbationContinuous ν)
    (hcompact_sublevels : SourceNormCompactSublevels ν)
    (hcontinuous : Continuous ν.norm) :
    (∃ (μ : MixedContentStrategy D) (genre : Content D),
      SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ ∧
      SourceNonzeroSupportGenres ν μ = ({genre} : Set (Content D))) ↔
      SingleGenreProductSupCondition
        {y : Fin N → ℝ | InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y} := by
  constructor
  · rintro ⟨μ, genre, hnash, hgenres⟩
    exact
      sourceSymmetricMixedNash_productSupCondition_of_compactSublevels_of_singleton_nonzeroSupportGenres_of_nonzero_users
        (j := Classical.choice (inferInstance : Nonempty (Fin P))) hnash hgenres.le
        husers husers_nonzero hperturb hβ hcompact_sublevels hcontinuous
  · intro hproduct
    obtain ⟨p, hp_nonnegative, hp_ball, hp_score, hnash⟩ :=
      exists_singleGenreContentLaw_sourceSymmetricMixedNash_of_productSupCondition_of_compactSublevels
        (P := P) ν hβ husers husers_nonzero hcompact_sublevels hproduct
    have hp_nonzero : NonzeroContent p := nonzeroContent_of_positive_score hp_score
    refine ⟨singleGenreContentLaw N P β (SourceNorm.normalizedContent ν p),
      SourceNorm.normalizedContent ν p, hnash, ?_⟩
    exact singleGenreContentLaw_nonzeroSupportGenres_eq_singleton
      ν hβ (SourceNorm.norm_normalizedContent_eq_one ν hp_nonzero)

/--
Corrected arbitrary-equilibrium exclusion in the interior branch of Corollary
`beta`.  The finite strict product gap first rules out the explicit ray law;
the corrected compact single-genre identification then transfers that
exclusion to every source equilibrium with one nonzero-support genre.
-/
theorem not_exists_sourceSymmetricMixedNash_singleton_nonzeroSupportGenre_of_lt_general_threshold
    {D N P : ℕ} [Nontrivial (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
