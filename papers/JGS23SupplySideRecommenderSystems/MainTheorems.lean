  have hscore := pTwoStandardBasisValueMap_contentOfCoordinates z
  have hscore_zero :
      score (pTwoStandardBasisUsers 0) (pTwoContentOfCoordinates z) = z.1 := by
    simpa [pTwoStandardBasisValueMap] using congrArg Prod.fst hscore
  have hscore_one :
      score (pTwoStandardBasisUsers 1) (pTwoContentOfCoordinates z) = z.2 := by
    simpa [pTwoStandardBasisValueMap] using congrArg Prod.snd hscore
  rw [pTwoSourceContentMeasure_sourceMixedPurePayoffAtFocal_eq_standardBasisObjective
    hbeta j (pTwoContentOfCoordinates z) hp, hscore_zero, hscore_one]
  exact standardBasisObjective_eq_of_radius_two_le hbeta hz.2.2

/--
Every content-support action attains the P=2 source value for either focal
producer. The support transport is shared, while the payoff calculation uses
the corresponding focal product-integral identity.
-/
theorem pTwoSourceContentMeasure_sourceMixedPurePayoffAtFocal_eq_equilibriumValue_of_mem_support
    {beta : ℝ} (hbeta : 2 ≤ beta) (j : Fin 2) (p : Content 2)
    (hp : p ∈ (pTwoSourceContentMeasure beta).support) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
      (normRpowCost (SourceNorm.l2 2) beta) p
      (pTwoSourceContentMeasure beta) =
    1 - 2 / beta := by
  rw [← pTwoContentOfCoordinates_standardBasisValueMap p]
  exact
    pTwoContentOfCoordinates_sourceMixedPurePayoffAtFocal_eq_equilibriumValue_on_sourceCircle
      hbeta j (pTwoStandardBasisValueMap p)
      (pTwoStandardBasisValueMap_mem_sourceCircle_of_mem_contentMeasure_support hbeta hp)

/--
Every support action of the P=2 content law is a payoff maximizer over the
source nonnegative action domain for either producer. This is a direct
two-focal support-action statement, not a packaged equilibrium certificate.
-/
theorem pTwoSourceContentMeasure_support_action_payoff_is_maximal_at_each_focal
    {beta : ℝ} (hbeta : 2 ≤ beta) (j : Fin 2) (p : Content 2)
    (hp : p ∈ (pTwoSourceContentMeasure beta).support) :
    ∀ q : Content 2, NonnegativeContent q →
      SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
        (normRpowCost (SourceNorm.l2 2) beta) q
        (pTwoSourceContentMeasure beta) ≤
      SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
        (normRpowCost (SourceNorm.l2 2) beta) p
        (pTwoSourceContentMeasure beta) := by
  intro q hq
  rw [pTwoSourceContentMeasure_sourceMixedPurePayoffAtFocal_eq_equilibriumValue_of_mem_support
    hbeta j p hp]
  exact pTwoSourceContentMeasure_sourceMixedPurePayoffAtFocal_le_equilibriumValue hbeta j q hq

/-- The literal coordinate curve displayed in Proposition `finiteP`. -/
def finitePSourceCurveSupportSet (P : ℕ) : Set (ℝ × ℝ) :=
  {z | z.1 ∈ Set.Icc (0 : ℝ) 1 ∧
    z.2 = (1 - z.1 ^ (2 / ((P : ℝ) - 1))) ^ (((P : ℝ) - 1) / 2)}

/--
Primitive finiteP sampler: unit-interval volume is sent to the curve displayed
in the source proposition. Its CDF and exact topological-support properties
are separate C2 obligations.
-/
noncomputable def finitePSourceCurveSample (P : ℕ) (u : I) : ℝ × ℝ :=
  let exponent := ((P : ℝ) - 1) / 2
  ((u : ℝ) ^ exponent, (1 - (u : ℝ)) ^ exponent)

theorem finitePSourceCurveSample_measurable (P : ℕ) :
    Measurable (finitePSourceCurveSample P) := by
  unfold finitePSourceCurveSample
  fun_prop

theorem finitePSourceCurveSample_nonnegative (P : ℕ) (u : I) :
    0 ≤ (finitePSourceCurveSample P u).1 ∧
      0 ≤ (finitePSourceCurveSample P u).2 := by
  unfold finitePSourceCurveSample
  dsimp
  exact ⟨Real.rpow_nonneg u.2.1 _,
    Real.rpow_nonneg (sub_nonneg.mpr u.2.2) _⟩

/--
The primitive finiteP sampler satisfies the literal source curve equation. The
proof uses the displayed exponents; it does not use the source proof's false
unit-radius assertion.
-/
theorem finitePSourceCurveSample_on_source_curve
    {P : ℕ} (hP : 2 ≤ P) (u : I) :
    (finitePSourceCurveSample P u).2 =
      (1 - (finitePSourceCurveSample P u).1 ^ (2 / ((P : ℝ) - 1))) ^
        (((P : ℝ) - 1) / 2) := by
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hP_sub_ne_zero : (P : ℝ) - 1 ≠ 0 := by
    linarith
  have hu_nonneg : 0 ≤ (u : ℝ) := u.2.1
  have hproduct : (((P : ℝ) - 1) / 2) * (2 / ((P : ℝ) - 1)) = 1 := by
    field_simp
  unfold finitePSourceCurveSample
  dsimp
  rw [← Real.rpow_mul hu_nonneg, hproduct, Real.rpow_one]

theorem finitePSourceCurveSample_mem_source_curve
    {P : ℕ} (hP : 2 ≤ P) (u : I) :
    finitePSourceCurveSample P u ∈ finitePSourceCurveSupportSet P := by
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hP_sub_nonneg : 0 ≤ (P : ℝ) - 1 := by
    linarith
  have hexponent_nonneg : 0 ≤ ((P : ℝ) - 1) / 2 := by positivity
  constructor
  · unfold finitePSourceCurveSample
    dsimp
    exact ⟨Real.rpow_nonneg u.2.1 _,
      Real.rpow_le_one u.2.1 u.2.2 hexponent_nonneg⟩
  · exact finitePSourceCurveSample_on_source_curve hP u

/-- The coordinate law induced by the finiteP source-curve sampler. -/
noncomputable def finitePSourceCurveMeasure (P : ℕ) : Measure (ℝ × ℝ) :=
  Measure.map (finitePSourceCurveSample P) (volume : Measure I)

theorem finitePSourceCurveMeasure_isProbabilityMeasure (P : ℕ) :
    IsProbabilityMeasure (finitePSourceCurveMeasure P) := by
  unfold finitePSourceCurveMeasure
  exact Measure.isProbabilityMeasure_map
    (finitePSourceCurveSample_measurable P).aemeasurable

/-- Every coordinate of the finiteP source sampler lies in the source interval. -/
theorem finitePSourceCurveSample_coordinates_le_one
    {P : ℕ} (hP : 2 ≤ P) (u : I) :
    (finitePSourceCurveSample P u).1 ≤ 1 ∧
      (finitePSourceCurveSample P u).2 ≤ 1 := by
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hsource_exponent_nonneg : 0 ≤ ((P : ℝ) - 1) / 2 := by
    exact div_nonneg (sub_nonneg.mpr hP_real_gt_one.le) (by norm_num)
  unfold finitePSourceCurveSample
  dsimp
  exact ⟨Real.rpow_le_one u.2.1 u.2.2 hsource_exponent_nonneg,
    Real.rpow_le_one (sub_nonneg.mpr u.2.2) (sub_le_self 1 u.2.1)
      hsource_exponent_nonneg⟩

/-- The first finiteP coordinate has the stated CDF on the source interval. -/
theorem finitePSourceCurveMeasure_first_cdf_on_source_interval
    {P : ℕ} (hP : 2 ≤ P) {z : ℝ} (hz : z ∈ Set.Icc (0 : ℝ) 1) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.1 ≤ z} =
      ENNReal.ofReal (z ^ (2 / ((P : ℝ) - 1))) := by
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    linarith
  have hP_sub_ne_zero : (P : ℝ) - 1 ≠ 0 := ne_of_gt hP_sub_pos
  have hcdf_exponent_pos : 0 < 2 / ((P : ℝ) - 1) := by
    positivity
  have hproduct : (((P : ℝ) - 1) / 2) * (2 / ((P : ℝ) - 1)) = 1 := by
    field_simp
  let threshold : I :=
    ⟨z ^ (2 / ((P : ℝ) - 1)),
      ⟨Real.rpow_nonneg hz.1 _,
        Real.rpow_le_one hz.1 hz.2 hcdf_exponent_pos.le⟩⟩
  have hpreimage :
      {u : I | (finitePSourceCurveSample P u).1 ≤ z} = Set.Iic threshold := by
    ext u
    change (u : ℝ) ^ (((P : ℝ) - 1) / 2) ≤ z ↔
      (u : ℝ) ≤ z ^ (2 / ((P : ℝ) - 1))
    calc
      (u : ℝ) ^ (((P : ℝ) - 1) / 2) ≤ z ↔
          ((u : ℝ) ^ (((P : ℝ) - 1) / 2)) ^ (2 / ((P : ℝ) - 1)) ≤
            z ^ (2 / ((P : ℝ) - 1)) :=
        (Real.rpow_le_rpow_iff (Real.rpow_nonneg u.2.1 _) hz.1 hcdf_exponent_pos).symm
      _ ↔ (u : ℝ) ≤ z ^ (2 / ((P : ℝ) - 1)) := by
        rw [← Real.rpow_mul u.2.1, hproduct, Real.rpow_one]
  have hset_meas : MeasurableSet {point : ℝ × ℝ | point.1 ≤ z} := by
    exact measurable_fst measurableSet_Iic
  rw [finitePSourceCurveMeasure,
    Measure.map_apply (finitePSourceCurveSample_measurable P) hset_meas]
  change (volume : Measure I) {u : I | (finitePSourceCurveSample P u).1 ≤ z} = _
  rw [hpreimage, unitInterval.volume_Iic]

/-- The second finiteP coordinate has the stated CDF on the source interval. -/
theorem finitePSourceCurveMeasure_second_cdf_on_source_interval
    {P : ℕ} (hP : 2 ≤ P) {z : ℝ} (hz : z ∈ Set.Icc (0 : ℝ) 1) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.2 ≤ z} =
      ENNReal.ofReal (z ^ (2 / ((P : ℝ) - 1))) := by
  have hfirst_meas : MeasurableSet {point : ℝ × ℝ | point.1 ≤ z} := by
    exact measurable_fst measurableSet_Iic
  have hsecond_meas : MeasurableSet {point : ℝ × ℝ | point.2 ≤ z} := by
    exact measurable_snd measurableSet_Iic
  have hfirst_preimage_meas :
      MeasurableSet {u : I | (finitePSourceCurveSample P u).1 ≤ z} := by
    exact (measurable_fst.comp (finitePSourceCurveSample_measurable P)) measurableSet_Iic
  have hsecond_preimage :
      {u : I | (finitePSourceCurveSample P u).2 ≤ z} =
        unitInterval.symm ⁻¹' {u : I | (finitePSourceCurveSample P u).1 ≤ z} := by
    ext u
    simp [finitePSourceCurveSample, unitInterval.coe_symm_eq]
  have hfirst_cdf := finitePSourceCurveMeasure_first_cdf_on_source_interval hP hz
  rw [finitePSourceCurveMeasure,
    Measure.map_apply (finitePSourceCurveSample_measurable P) hfirst_meas] at hfirst_cdf
  rw [finitePSourceCurveMeasure,
    Measure.map_apply (finitePSourceCurveSample_measurable P) hsecond_meas]
  change (volume : Measure I) {u : I | (finitePSourceCurveSample P u).2 ≤ z} = _
  rw [hsecond_preimage]
  calc
    (volume : Measure I)
        (unitInterval.symm ⁻¹' {u : I | (finitePSourceCurveSample P u).1 ≤ z}) =
        volume {u : I | (finitePSourceCurveSample P u).1 ≤ z} :=
      unitInterval.measurePreserving_symm.measure_preimage
        hfirst_preimage_meas.nullMeasurableSet
    _ = ENNReal.ofReal (z ^ (2 / ((P : ℝ) - 1))) := hfirst_cdf

theorem finitePSourceCurveMeasure_first_cdf_of_lt_zero
    {P : ℕ} {z : ℝ} (hz : z < 0) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.1 ≤ z} = 0 := by
  have hset_meas : MeasurableSet {point : ℝ × ℝ | point.1 ≤ z} := by
    exact measurable_fst measurableSet_Iic
  have hpreimage :
      {u : I | (finitePSourceCurveSample P u).1 ≤ z} = ∅ := by
    ext u
    change (finitePSourceCurveSample P u).1 ≤ z ↔ False
    constructor
    · intro hle
      have hnonneg := (finitePSourceCurveSample_nonnegative P u).1
      linarith
    · simp
  rw [finitePSourceCurveMeasure,
    Measure.map_apply (finitePSourceCurveSample_measurable P) hset_meas]
  change (volume : Measure I) {u : I | (finitePSourceCurveSample P u).1 ≤ z} = 0
  rw [hpreimage]
  exact measure_empty

theorem finitePSourceCurveMeasure_second_cdf_of_lt_zero
    {P : ℕ} {z : ℝ} (hz : z < 0) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.2 ≤ z} = 0 := by
  have hset_meas : MeasurableSet {point : ℝ × ℝ | point.2 ≤ z} := by
    exact measurable_snd measurableSet_Iic
  have hpreimage :
      {u : I | (finitePSourceCurveSample P u).2 ≤ z} = ∅ := by
    ext u
    change (finitePSourceCurveSample P u).2 ≤ z ↔ False
    constructor
    · intro hle
      have hnonneg := (finitePSourceCurveSample_nonnegative P u).2
      linarith
    · simp
  rw [finitePSourceCurveMeasure,
    Measure.map_apply (finitePSourceCurveSample_measurable P) hset_meas]
  change (volume : Measure I) {u : I | (finitePSourceCurveSample P u).2 ≤ z} = 0
  rw [hpreimage]
  exact measure_empty

theorem finitePSourceCurveMeasure_first_cdf_of_one_le
    {P : ℕ} (hP : 2 ≤ P) {z : ℝ} (hz : 1 ≤ z) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.1 ≤ z} = 1 := by
  have hset_meas : MeasurableSet {point : ℝ × ℝ | point.1 ≤ z} := by
    exact measurable_fst measurableSet_Iic
  have hpreimage :
      {u : I | (finitePSourceCurveSample P u).1 ≤ z} = Set.univ := by
    ext u
    simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
    exact (finitePSourceCurveSample_coordinates_le_one hP u).1.trans hz
  rw [finitePSourceCurveMeasure,
    Measure.map_apply (finitePSourceCurveSample_measurable P) hset_meas]
  change (volume : Measure I) {u : I | (finitePSourceCurveSample P u).1 ≤ z} = 1
  rw [hpreimage]
  exact measure_univ

theorem finitePSourceCurveMeasure_second_cdf_of_one_le
    {P : ℕ} (hP : 2 ≤ P) {z : ℝ} (hz : 1 ≤ z) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.2 ≤ z} = 1 := by
  have hset_meas : MeasurableSet {point : ℝ × ℝ | point.2 ≤ z} := by
    exact measurable_snd measurableSet_Iic
  have hpreimage :
      {u : I | (finitePSourceCurveSample P u).2 ≤ z} = Set.univ := by
    ext u
    simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
    exact (finitePSourceCurveSample_coordinates_le_one hP u).2.trans hz
  rw [finitePSourceCurveMeasure,
    Measure.map_apply (finitePSourceCurveSample_measurable P) hset_meas]
  change (volume : Measure I) {u : I | (finitePSourceCurveSample P u).2 ≤ z} = 1
  rw [hpreimage]
  exact measure_univ

/-- The full, zero-extended source CDF used for either finiteP coordinate. -/
noncomputable def finitePSourceCurveFullCoordinateCdf (P : ℕ) (z : ℝ) : ℝ :=
  if z < 0 then 0 else if z ≤ 1 then z ^ (2 / ((P : ℝ) - 1)) else 1

/-- The first finiteP coordinate satisfies the full zero/interior/one CDF. -/
theorem finitePSourceCurveMeasure_first_full_cdf
    {P : ℕ} (hP : 2 ≤ P) (z : ℝ) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.1 ≤ z} =
      ENNReal.ofReal (finitePSourceCurveFullCoordinateCdf P z) := by
  by_cases hzneg : z < 0
  · rw [finitePSourceCurveMeasure_first_cdf_of_lt_zero hzneg]
    simp [finitePSourceCurveFullCoordinateCdf, hzneg]
  by_cases hzle : z ≤ 1
  · have hzmem : z ∈ Set.Icc (0 : ℝ) 1 := ⟨le_of_not_gt hzneg, hzle⟩
    rw [finitePSourceCurveMeasure_first_cdf_on_source_interval hP hzmem]
    simp [finitePSourceCurveFullCoordinateCdf, hzneg, hzle]
  · have hone_le : 1 ≤ z := le_of_not_ge hzle
    rw [finitePSourceCurveMeasure_first_cdf_of_one_le hP hone_le]
    simp [finitePSourceCurveFullCoordinateCdf, hzneg, hzle]

/-- The second finiteP coordinate satisfies the full zero/interior/one CDF. -/
theorem finitePSourceCurveMeasure_second_full_cdf
    {P : ℕ} (hP : 2 ≤ P) (z : ℝ) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.2 ≤ z} =
      ENNReal.ofReal (finitePSourceCurveFullCoordinateCdf P z) := by
  by_cases hzneg : z < 0
  · rw [finitePSourceCurveMeasure_second_cdf_of_lt_zero hzneg]
    simp [finitePSourceCurveFullCoordinateCdf, hzneg]
  by_cases hzle : z ≤ 1
  · have hzmem : z ∈ Set.Icc (0 : ℝ) 1 := ⟨le_of_not_gt hzneg, hzle⟩
    rw [finitePSourceCurveMeasure_second_cdf_on_source_interval hP hzmem]
    simp [finitePSourceCurveFullCoordinateCdf, hzneg, hzle]
  · have hone_le : 1 ≤ z := le_of_not_ge hzle
    rw [finitePSourceCurveMeasure_second_cdf_of_one_le hP hone_le]
    simp [finitePSourceCurveFullCoordinateCdf, hzneg, hzle]

/-- The full CDF is the proposition's `min(1, ...)` expression above zero. -/
theorem finitePSourceCurveFullCoordinateCdf_eq_sourceMarginalCdf
    {P : ℕ} (hP : 2 ≤ P) (z : ℝ) :
    finitePSourceCurveFullCoordinateCdf P z =
      if z < 0 then 0 else min 1 (z ^ (2 / ((P : ℝ) - 1))) := by
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hsource_cdf_exponent_nonneg : 0 ≤ 2 / ((P : ℝ) - 1) := by
    exact div_nonneg (by norm_num) (sub_nonneg.mpr hP_real_gt_one.le)
  by_cases hzneg : z < 0
  · simp [finitePSourceCurveFullCoordinateCdf, hzneg]
  by_cases hzle : z ≤ 1
  · have hvalue_le : z ^ (2 / ((P : ℝ) - 1)) ≤ 1 :=
      Real.rpow_le_one (le_of_not_gt hzneg) hzle hsource_cdf_exponent_nonneg
    simp [finitePSourceCurveFullCoordinateCdf, hzneg, hzle, min_eq_right hvalue_le]
  · have hone_le : 1 ≤ z := le_of_not_ge hzle
    have hvalue_ge : 1 ≤ z ^ (2 / ((P : ℝ) - 1)) := by
      simpa using Real.rpow_le_rpow (show (0 : ℝ) ≤ 1 by norm_num)
        hone_le hsource_cdf_exponent_nonneg
    simp [finitePSourceCurveFullCoordinateCdf, hzneg, hzle, min_eq_left hvalue_ge]

/--
The beta-two base CDF used in finiteP's C2 clause, zero-extended below the
source's nonnegative action domain.
-/
noncomputable def finitePSourceBaseCdf (z : ℝ) : ℝ :=
  if z < 0 then 0 else min (z ^ 2) 1

/--
Taking the C2 `(P - 1)`-root of the beta-two base CDF gives the proposition's
literal finiteP coordinate CDF.
-/
theorem finitePSourceBaseCdf_root_eq_sourceMarginalCdf
    {P : ℕ} (hP : 2 ≤ P) (z : ℝ) :
    (finitePSourceBaseCdf z) ^ (1 / ((P : ℝ) - 1)) =
      if z < 0 then 0 else min 1 (z ^ (2 / ((P : ℝ) - 1))) := by
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    linarith
  have hP_sub_ne_zero : (P : ℝ) - 1 ≠ 0 := ne_of_gt hP_sub_pos
  have hcdf_exponent_pos : 0 < 2 / ((P : ℝ) - 1) := by
    positivity
  have hroot_exponent_pos : 0 < 1 / ((P : ℝ) - 1) := by
    positivity
  by_cases hzneg : z < 0
  · unfold finitePSourceBaseCdf
    rw [if_pos hzneg, Real.zero_rpow hroot_exponent_pos.ne', if_pos hzneg]
  by_cases hzle : z ≤ 1
  · have hznonneg : 0 ≤ z := le_of_not_gt hzneg
    have hsq_le_one : z ^ 2 ≤ 1 := by
      nlinarith [mul_nonneg hznonneg (sub_nonneg.mpr hzle)]
    have hrpow_le_one : z ^ (2 / ((P : ℝ) - 1)) ≤ 1 :=
      Real.rpow_le_one hznonneg hzle hcdf_exponent_pos.le
    unfold finitePSourceBaseCdf
    rw [if_neg hzneg, min_eq_left hsq_le_one, if_neg hzneg,
      min_eq_right hrpow_le_one]
    rw [← Real.rpow_natCast z 2, ← Real.rpow_mul hznonneg]
    congr 1
    norm_num
    ring
  · have hone_le : 1 ≤ z := le_of_not_ge hzle
    have hsq_ge_one : 1 ≤ z ^ 2 := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hone_le) (by linarith : 0 ≤ z + 1)]
    have hrpow_ge_one : 1 ≤ z ^ (2 / ((P : ℝ) - 1)) := by
      simpa using Real.rpow_le_rpow (show (0 : ℝ) ≤ 1 by norm_num)
        hone_le hcdf_exponent_pos.le
    simp [finitePSourceBaseCdf, hzneg, min_eq_right hsq_ge_one,
      min_eq_left hrpow_ge_one]

/-- The first finiteP coordinate has the literal proposition CDF on all reals. -/
theorem finitePSourceCurveMeasure_first_cdf_eq_sourceMarginalCdf
    {P : ℕ} (hP : 2 ≤ P) (z : ℝ) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.1 ≤ z} =
      ENNReal.ofReal (if z < 0 then 0 else min 1 (z ^ (2 / ((P : ℝ) - 1)))) := by
  rw [finitePSourceCurveMeasure_first_full_cdf hP,
    finitePSourceCurveFullCoordinateCdf_eq_sourceMarginalCdf hP]

/-- The second finiteP coordinate has the literal proposition CDF on all reals. -/
theorem finitePSourceCurveMeasure_second_cdf_eq_sourceMarginalCdf
    {P : ℕ} (hP : 2 ≤ P) (z : ℝ) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.2 ≤ z} =
      ENNReal.ofReal (if z < 0 then 0 else min 1 (z ^ (2 / ((P : ℝ) - 1)))) := by
  rw [finitePSourceCurveMeasure_second_full_cdf hP,
    finitePSourceCurveFullCoordinateCdf_eq_sourceMarginalCdf hP]

/-- The first finiteP coordinate satisfies the direct C2 root-CDF equality. -/
theorem finitePSourceCurveMeasure_first_cdf_eq_sourceC2Root
    {P : ℕ} (hP : 2 ≤ P) (z : ℝ) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.1 ≤ z} =
      ENNReal.ofReal ((finitePSourceBaseCdf z) ^ (1 / ((P : ℝ) - 1))) := by
  rw [finitePSourceCurveMeasure_first_cdf_eq_sourceMarginalCdf hP,
    finitePSourceBaseCdf_root_eq_sourceMarginalCdf hP]

/-- The second finiteP coordinate satisfies the direct C2 root-CDF equality. -/
theorem finitePSourceCurveMeasure_second_cdf_eq_sourceC2Root
    {P : ℕ} (hP : 2 ≤ P) (z : ℝ) :
    finitePSourceCurveMeasure P {point : ℝ × ℝ | point.2 ≤ z} =
      ENNReal.ofReal ((finitePSourceBaseCdf z) ^ (1 / ((P : ℝ) - 1))) := by
  rw [finitePSourceCurveMeasure_second_cdf_eq_sourceMarginalCdf hP,
    finitePSourceBaseCdf_root_eq_sourceMarginalCdf hP]

/-- The finiteP source-curve sampler is continuous in the source regime. -/
theorem finitePSourceCurveSample_continuous
    {P : ℕ} (hP : 2 ≤ P) :
    Continuous (finitePSourceCurveSample P) := by
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hsource_exponent_nonneg : 0 ≤ ((P : ℝ) - 1) / 2 := by
    exact div_nonneg (sub_nonneg.mpr hP_real_gt_one.le) (by norm_num)
  unfold finitePSourceCurveSample
  dsimp
  exact
    (continuous_subtype_val.rpow_const fun _ => Or.inr hsource_exponent_nonneg).prodMk
      ((continuous_const.sub continuous_subtype_val).rpow_const
        fun _ => Or.inr hsource_exponent_nonneg)

/-- The literal finiteP curve is exactly the range of the concrete sampler. -/
theorem finitePSourceCurveSample_range_eq_supportSet
    {P : ℕ} (hP : 2 ≤ P) :
    Set.range (finitePSourceCurveSample P) = finitePSourceCurveSupportSet P := by
  ext z
  constructor
  · rintro ⟨u, rfl⟩
    exact finitePSourceCurveSample_mem_source_curve hP u
  · rintro ⟨hzfirst, hzsecond⟩
    have hP_real_gt_one : (1 : ℝ) < P := by
      exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
    have hP_sub_pos : 0 < (P : ℝ) - 1 := by
      linarith
    have hP_sub_ne_zero : (P : ℝ) - 1 ≠ 0 := ne_of_gt hP_sub_pos
    have hcdf_exponent_pos : 0 < 2 / ((P : ℝ) - 1) := by
      positivity
    have hproduct : (2 / ((P : ℝ) - 1)) * (((P : ℝ) - 1) / 2) = 1 := by
      field_simp
    let u : I :=
      ⟨z.1 ^ (2 / ((P : ℝ) - 1)),
        ⟨Real.rpow_nonneg hzfirst.1 _,
          Real.rpow_le_one hzfirst.1 hzfirst.2 hcdf_exponent_pos.le⟩⟩
    refine ⟨u, ?_⟩
    unfold finitePSourceCurveSample
    dsimp
    apply Prod.ext
    · change
        (z.1 ^ (2 / ((P : ℝ) - 1))) ^ (((P : ℝ) - 1) / 2) = z.1
      rw [← Real.rpow_mul hzfirst.1, hproduct, Real.rpow_one]
    · change
        (1 - z.1 ^ (2 / ((P : ℝ) - 1))) ^ (((P : ℝ) - 1) / 2) = z.2
      exact hzsecond.symm

private theorem finitePSourceCurveSupportSet_isClosed
    {P : ℕ} (hP : 2 ≤ P) :
    IsClosed (finitePSourceCurveSupportSet P) := by
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hsource_exponent_nonneg : 0 ≤ ((P : ℝ) - 1) / 2 := by
    exact div_nonneg (sub_nonneg.mpr hP_real_gt_one.le) (by norm_num)
  have hcdf_exponent_nonneg : 0 ≤ 2 / ((P : ℝ) - 1) := by
    exact div_nonneg (by norm_num) (sub_nonneg.mpr hP_real_gt_one.le)
  unfold finitePSourceCurveSupportSet
  apply IsClosed.inter
  · exact isClosed_Icc.preimage continuous_fst
  · apply isClosed_eq continuous_snd
    exact (continuous_const.sub
      (continuous_fst.rpow_const fun _ => Or.inr hcdf_exponent_nonneg)).rpow_const
        fun _ => Or.inr hsource_exponent_nonneg

theorem finitePSourceCurveMeasure_ae_on_source_curve
    {P : ℕ} (hP : 2 ≤ P) :
    ∀ᵐ z ∂finitePSourceCurveMeasure P, z ∈ finitePSourceCurveSupportSet P := by
  have hset_meas : MeasurableSet (finitePSourceCurveSupportSet P) :=
    (finitePSourceCurveSupportSet_isClosed hP).measurableSet
  unfold finitePSourceCurveMeasure
  apply (ae_map_iff (finitePSourceCurveSample_measurable P).aemeasurable hset_meas).mpr
  filter_upwards with u
  exact finitePSourceCurveSample_mem_source_curve hP u

/--
The finiteP coordinate law has exactly the literal source curve as its
topological support. This is the support clause of C2 for the realized-value
variable, not a conclusion-bearing C2 or equilibrium package.
-/
theorem finitePSourceCurveMeasure_support_eq_source_curve
    {P : ℕ} (hP : 2 ≤ P) :
    (finitePSourceCurveMeasure P).support = finitePSourceCurveSupportSet P := by
  apply Set.Subset.antisymm
  · exact Measure.support_subset_of_isClosed (finitePSourceCurveSupportSet_isClosed hP)
      (finitePSourceCurveMeasure_ae_on_source_curve hP)
  · intro z hz
    rw [Measure.support_eq_forall_isOpen]
    intro U hzU hUopen
    rw [finitePSourceCurveMeasure,
      Measure.map_apply (finitePSourceCurveSample_measurable P) hUopen.measurableSet]
    rw [← finitePSourceCurveSample_range_eq_supportSet hP] at hz
    rcases hz with ⟨u, rfl⟩
    apply (Measure.mem_support_iff_forall u).mp (unitInterval_volume_mem_support u)
    apply (finitePSourceCurveSample_continuous hP).continuousAt
    exact hUopen.mem_nhds hzU

/--
The finiteP content law obtained by encoding the concrete coordinate law as a
distribution over the two-dimensional source content space.
-/
noncomputable def finitePSourceContentMeasure (P : ℕ) : Measure (Content 2) :=
  Measure.map pTwoContentOfCoordinates (finitePSourceCurveMeasure P)

theorem finitePSourceContentMeasure_isProbabilityMeasure (P : ℕ) :
    IsProbabilityMeasure (finitePSourceContentMeasure P) := by
  letI : IsProbabilityMeasure (finitePSourceCurveMeasure P) :=
    finitePSourceCurveMeasure_isProbabilityMeasure P
  unfold finitePSourceContentMeasure
  exact Measure.isProbabilityMeasure_map
    pTwoContentOfCoordinates_measurable.aemeasurable

/--
The finiteP coordinate law is exactly the standard-basis score-vector law of
the constructed content measure. This is the direct C3 transport component;
it does not package C2/C3 or assert an equilibrium.
-/
theorem finitePStandardBasisValueMap_map_contentMeasure (P : ℕ) :
    Measure.map pTwoStandardBasisValueMap (finitePSourceContentMeasure P) =
      finitePSourceCurveMeasure P := by
  unfold finitePSourceContentMeasure
  rw [Measure.map_map pTwoStandardBasisValueMap_measurable
    pTwoContentOfCoordinates_measurable]
  calc
    Measure.map
        (pTwoStandardBasisValueMap ∘ pTwoContentOfCoordinates)
        (finitePSourceCurveMeasure P) =
        Measure.map id (finitePSourceCurveMeasure P) := by
          apply Measure.map_congr
          filter_upwards with z
          exact pTwoStandardBasisValueMap_contentOfCoordinates z
    _ = finitePSourceCurveMeasure P := Measure.map_id

/--
The realized standard-basis value law of the finiteP content construction has
exactly the literal source curve as its support.
-/
theorem finitePStandardBasisValueMap_contentMeasure_support_eq_source_curve
    {P : ℕ} (hP : 2 ≤ P) :
    (Measure.map pTwoStandardBasisValueMap (finitePSourceContentMeasure P)).support =
      finitePSourceCurveSupportSet P := by
  rw [finitePStandardBasisValueMap_map_contentMeasure,
    finitePSourceCurveMeasure_support_eq_source_curve hP]

/-- The finiteP source content law is almost everywhere nonnegative. -/
theorem finitePSourceContentMeasure_ae_nonnegative (P : ℕ) :
    ∀ᵐ p ∂finitePSourceContentMeasure P, NonnegativeContent p := by
  have hcontent_meas : MeasurableSet {p : Content 2 | NonnegativeContent p} :=
    nonnegativeContent_content2_set_isClosed.measurableSet
  have hcurve_meas : MeasurableSet {z : ℝ × ℝ |
      NonnegativeContent (pTwoContentOfCoordinates z)} :=
    hcontent_meas.preimage pTwoContentOfCoordinates_measurable
  unfold finitePSourceContentMeasure finitePSourceCurveMeasure
  rw [ae_map_iff pTwoContentOfCoordinates_measurable.aemeasurable hcontent_meas]
  rw [ae_map_iff (finitePSourceCurveSample_measurable P).aemeasurable hcurve_meas]
  filter_upwards with u
  exact (nonnegativeContent_content2_iff _ _).mpr
    (finitePSourceCurveSample_nonnegative P u)

/--
Every topological-support action of the finiteP content law is source-feasible.
This upgrades the sampled-law fact through the closed nonnegative orthant; it
does not identify the content support with the source curve.
-/
theorem finitePSourceContentMeasure_support_subset_nonnegative (P : ℕ) :
    (finitePSourceContentMeasure P).support ⊆
      {p : Content 2 | NonnegativeContent p} := by
  exact Measure.support_subset_of_isClosed nonnegativeContent_content2_set_isClosed
    (finitePSourceContentMeasure_ae_nonnegative P)

/-- The first finiteP sampler coordinate is injective in the source regime. -/
private theorem finitePSourceCurveSample_first_injective
    {P : ℕ} (hP : 2 ≤ P) :
    Function.Injective (fun u : I => (finitePSourceCurveSample P u).1) := by
  intro u v huv
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hP_sub_ne_zero : (P : ℝ) - 1 ≠ 0 := by linarith
  have hproduct : (((P : ℝ) - 1) / 2) * (2 / ((P : ℝ) - 1)) = 1 := by
    field_simp
  apply Subtype.ext
  unfold finitePSourceCurveSample at huv
  dsimp at huv
  calc
    (u : ℝ) = (u : ℝ) ^ (1 : ℝ) := (Real.rpow_one _).symm
    _ = ((u : ℝ) ^ (((P : ℝ) - 1) / 2)) ^ (2 / ((P : ℝ) - 1)) := by
      rw [← Real.rpow_mul u.2.1, hproduct]
    _ = ((v : ℝ) ^ (((P : ℝ) - 1) / 2)) ^ (2 / ((P : ℝ) - 1)) := by
      rw [huv]
    _ = (v : ℝ) ^ (1 : ℝ) := by
      rw [← Real.rpow_mul v.2.1, hproduct]
    _ = (v : ℝ) := Real.rpow_one _

/-- The second finiteP sampler coordinate is injective in the source regime. -/
private theorem finitePSourceCurveSample_second_injective
    {P : ℕ} (hP : 2 ≤ P) :
    Function.Injective (fun u : I => (finitePSourceCurveSample P u).2) := by
  intro u v huv
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hP_sub_ne_zero : (P : ℝ) - 1 ≠ 0 := by linarith
  have hproduct : (((P : ℝ) - 1) / 2) * (2 / ((P : ℝ) - 1)) = 1 := by
    field_simp
  apply Subtype.ext
  unfold finitePSourceCurveSample at huv
  dsimp at huv
  have hbase : (1 - (u : ℝ)) = 1 - (v : ℝ) := by
    calc
      1 - (u : ℝ) = (1 - (u : ℝ)) ^ (1 : ℝ) := (Real.rpow_one _).symm
      _ = ((1 - (u : ℝ)) ^ (((P : ℝ) - 1) / 2)) ^ (2 / ((P : ℝ) - 1)) := by
        rw [← Real.rpow_mul (sub_nonneg.mpr u.2.2), hproduct]
      _ = ((1 - (v : ℝ)) ^ (((P : ℝ) - 1) / 2)) ^ (2 / ((P : ℝ) - 1)) := by
        rw [huv]
      _ = (1 - (v : ℝ)) ^ (1 : ℝ) := by
        rw [← Real.rpow_mul (sub_nonneg.mpr v.2.2), hproduct]
      _ = 1 - (v : ℝ) := Real.rpow_one _
  linarith

private theorem finitePSourceCurveMeasure_firstCoordinate_noAtoms
    {P : ℕ} (hP : 2 ≤ P) :
    NoAtoms (Measure.map (fun z : ℝ × ℝ => z.1) (finitePSourceCurveMeasure P)) := by
  rw [finitePSourceCurveMeasure]
  rw [Measure.map_map measurable_fst (finitePSourceCurveSample_measurable P)]
  apply noAtoms_map_of_injective (volume : Measure I)
  · exact measurable_fst.comp (finitePSourceCurveSample_measurable P)
  · simpa only [Function.comp_apply] using finitePSourceCurveSample_first_injective hP

private theorem finitePSourceCurveMeasure_secondCoordinate_noAtoms
    {P : ℕ} (hP : 2 ≤ P) :
    NoAtoms (Measure.map (fun z : ℝ × ℝ => z.2) (finitePSourceCurveMeasure P)) := by
  rw [finitePSourceCurveMeasure]
  rw [Measure.map_map measurable_snd (finitePSourceCurveSample_measurable P)]
  apply noAtoms_map_of_injective (volume : Measure I)
  · exact measurable_snd.comp (finitePSourceCurveSample_measurable P)
  · simpa only [Function.comp_apply] using finitePSourceCurveSample_second_injective hP

private theorem finitePSourceContentMeasure_score_zero_map
    (P : ℕ) :
    Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 0) q)
      (finitePSourceContentMeasure P) =
      Measure.map (fun z : ℝ × ℝ => z.1) (finitePSourceCurveMeasure P) := by
  calc
    Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 0) q)
        (finitePSourceContentMeasure P) =
        Measure.map ((fun z : ℝ × ℝ => z.1) ∘ pTwoStandardBasisValueMap)
          (finitePSourceContentMeasure P) := by
            apply Measure.map_congr
            filter_upwards with q
            rfl
    _ = Measure.map (fun z : ℝ × ℝ => z.1)
          (Measure.map pTwoStandardBasisValueMap (finitePSourceContentMeasure P)) := by
            rw [Measure.map_map measurable_fst pTwoStandardBasisValueMap_measurable]
    _ = Measure.map (fun z : ℝ × ℝ => z.1) (finitePSourceCurveMeasure P) := by
      rw [finitePStandardBasisValueMap_map_contentMeasure]

private theorem finitePSourceContentMeasure_score_one_map
    (P : ℕ) :
    Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 1) q)
      (finitePSourceContentMeasure P) =
      Measure.map (fun z : ℝ × ℝ => z.2) (finitePSourceCurveMeasure P) := by
  calc
    Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 1) q)
        (finitePSourceContentMeasure P) =
        Measure.map ((fun z : ℝ × ℝ => z.2) ∘ pTwoStandardBasisValueMap)
          (finitePSourceContentMeasure P) := by
            apply Measure.map_congr
            filter_upwards with q
            rfl
    _ = Measure.map (fun z : ℝ × ℝ => z.2)
          (Measure.map pTwoStandardBasisValueMap (finitePSourceContentMeasure P)) := by
            rw [Measure.map_map measurable_snd pTwoStandardBasisValueMap_measurable]
    _ = Measure.map (fun z : ℝ × ℝ => z.2) (finitePSourceCurveMeasure P) := by
      rw [finitePStandardBasisValueMap_map_contentMeasure]

private theorem finitePStandardBasisScore_measurable (i : Fin 2) :
    Measurable (fun q : Content 2 => score (pTwoStandardBasisUsers i) q) := by
  fin_cases i
  · simpa [pTwoStandardBasisValueMap] using
      (measurable_fst.comp pTwoStandardBasisValueMap_measurable)
  · simpa [pTwoStandardBasisValueMap] using
      (measurable_snd.comp pTwoStandardBasisValueMap_measurable)

private theorem finitePSourceContentMeasure_score_noAtoms
    {P : ℕ} (hP : 2 ≤ P) (i : Fin 2) :
    NoAtoms (Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers i) q)
      (finitePSourceContentMeasure P)) := by
  fin_cases i
  · change NoAtoms (Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 0) q)
      (finitePSourceContentMeasure P))
    rw [finitePSourceContentMeasure_score_zero_map]
    exact finitePSourceCurveMeasure_firstCoordinate_noAtoms hP
  · change NoAtoms (Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 1) q)
      (finitePSourceContentMeasure P))
    rw [finitePSourceContentMeasure_score_one_map]
    exact finitePSourceCurveMeasure_secondCoordinate_noAtoms hP

/--
Every fixed standard-basis score level has zero mass under the finiteP source
content law. This is the concrete tie-null fact required by the source's CDF
payoff reduction; it is not an equilibrium conclusion.
-/
theorem finitePSourceContentMeasure_score_level_eq_zero
    {P : ℕ} (hP : 2 ≤ P) (i : Fin 2) (z : ℝ) :
    finitePSourceContentMeasure P
      {q : Content 2 | score (pTwoStandardBasisUsers i) q = z} = 0 := by
  let scoreMap : Content 2 → ℝ := fun q => score (pTwoStandardBasisUsers i) q
  let μ := finitePSourceContentMeasure P
  let ν : Measure ℝ := Measure.map scoreMap μ
  have hmap : ν = if i = 0 then
      Measure.map (fun z : ℝ × ℝ => z.1) (finitePSourceCurveMeasure P)
    else Measure.map (fun z : ℝ × ℝ => z.2) (finitePSourceCurveMeasure P) := by
    fin_cases i
    · simpa [ν, scoreMap, μ] using finitePSourceContentMeasure_score_zero_map P
    · simpa [ν, scoreMap, μ] using finitePSourceContentMeasure_score_one_map P
  have hno : NoAtoms ν := by
    rw [hmap]
    split
    · exact finitePSourceCurveMeasure_firstCoordinate_noAtoms hP
    · exact finitePSourceCurveMeasure_secondCoordinate_noAtoms hP
  have hsingle := hno.measure_singleton z
  change (Measure.map scoreMap μ) ({z} : Set ℝ) = 0 at hsingle
  rw [Measure.map_apply (finitePStandardBasisScore_measurable i)
    (measurableSet_singleton z)] at hsingle
  simpa [scoreMap, μ] using hsingle

private theorem finitePSourceBaseCdf_nonneg (z : ℝ) :
    0 ≤ finitePSourceBaseCdf z := by
  unfold finitePSourceBaseCdf
  split
  · norm_num
  · exact le_min (sq_nonneg z) zero_le_one

/--
For the finiteP construction, a strict standard-basis score event has the C2
root-CDF mass. The equality from strict to non-strict mass uses the preceding
score-level-null theorem, so it does not suppress the source tie rule.
-/
theorem finitePSourceContentMeasure_score_lt_measureReal_eq_sourceC2Root
    {P : ℕ} (hP : 2 ≤ P) (i : Fin 2) (z : ℝ) :
    (finitePSourceContentMeasure P).real
      {q : Content 2 | score (pTwoStandardBasisUsers i) q < z} =
      (finitePSourceBaseCdf z) ^ (1 / ((P : ℝ) - 1)) := by
  let scoreMap : Content 2 → ℝ := fun q => score (pTwoStandardBasisUsers i) q
  let μ := finitePSourceContentMeasure P
  let ν : Measure ℝ := Measure.map scoreMap μ
  letI : NoAtoms ν := by
    dsimp [ν, scoreMap, μ]
    exact finitePSourceContentMeasure_score_noAtoms hP i
  have hstrict_eq_le : ν (Set.Iio z) = ν (Set.Iic z) :=
    measure_congr (Iio_ae_eq_Iic (μ := ν))
  have hstrict_eq_le' :
      μ {q : Content 2 | score (pTwoStandardBasisUsers i) q < z} =
        μ {q : Content 2 | score (pTwoStandardBasisUsers i) q ≤ z} := by
    change (Measure.map scoreMap μ) (Set.Iio z) =
      (Measure.map scoreMap μ) (Set.Iic z) at hstrict_eq_le
    rw [Measure.map_apply (finitePStandardBasisScore_measurable i)
      measurableSet_Iio] at hstrict_eq_le
    rw [Measure.map_apply (finitePStandardBasisScore_measurable i)
      measurableSet_Iic] at hstrict_eq_le
    simpa [scoreMap] using hstrict_eq_le
  have hle :
      μ {q : Content 2 | score (pTwoStandardBasisUsers i) q ≤ z} =
        ENNReal.ofReal ((finitePSourceBaseCdf z) ^ (1 / ((P : ℝ) - 1))) := by
    fin_cases i
    · calc
        μ {q : Content 2 | score (pTwoStandardBasisUsers 0) q ≤ z} =
            (Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 0) q) μ)
              (Set.Iic z) := by
                symm
                rw [Measure.map_apply (finitePStandardBasisScore_measurable 0)
                  measurableSet_Iic]
                congr 1
        _ = Measure.map (fun point : ℝ × ℝ => point.1)
              (finitePSourceCurveMeasure P) (Set.Iic z) := by
              dsimp [μ]
              rw [finitePSourceContentMeasure_score_zero_map]
        _ = finitePSourceCurveMeasure P {point : ℝ × ℝ | point.1 ≤ z} := by
              rw [Measure.map_apply measurable_fst measurableSet_Iic]
              congr 1
        _ = ENNReal.ofReal ((finitePSourceBaseCdf z) ^ (1 / ((P : ℝ) - 1))) := by
              exact finitePSourceCurveMeasure_first_cdf_eq_sourceC2Root hP z
    · calc
        μ {q : Content 2 | score (pTwoStandardBasisUsers 1) q ≤ z} =
            (Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 1) q) μ)
              (Set.Iic z) := by
                symm
                rw [Measure.map_apply (finitePStandardBasisScore_measurable 1)
                  measurableSet_Iic]
                congr 1
        _ = Measure.map (fun point : ℝ × ℝ => point.2)
              (finitePSourceCurveMeasure P) (Set.Iic z) := by
              dsimp [μ]
              rw [finitePSourceContentMeasure_score_one_map]
        _ = finitePSourceCurveMeasure P {point : ℝ × ℝ | point.2 ≤ z} := by
              rw [Measure.map_apply measurable_snd measurableSet_Iic]
              congr 1
        _ = ENNReal.ofReal ((finitePSourceBaseCdf z) ^ (1 / ((P : ℝ) - 1))) := by
              exact finitePSourceCurveMeasure_second_cdf_eq_sourceC2Root hP z
  change (μ {q : Content 2 | score (pTwoStandardBasisUsers i) q < z}).toReal = _
  rw [hstrict_eq_le', hle]
  exact ENNReal.toReal_ofReal
    (Real.rpow_nonneg (finitePSourceBaseCdf_nonneg z) _)

private theorem finitePSourceBaseCdf_root_pow_eq
    {P : ℕ} (hP : 2 ≤ P) (z : ℝ) :
    ((finitePSourceBaseCdf z) ^ (1 / ((P : ℝ) - 1))) ^ (P - 1) =
      finitePSourceBaseCdf z := by
  have hP_real_gt_one : (1 : ℝ) < P := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num) hP)
  have hP_sub_ne_zero : (P : ℝ) - 1 ≠ 0 := by linarith
  have hproduct : (1 / ((P : ℝ) - 1)) * ((P : ℝ) - 1) = 1 := by
    field_simp
  have hcast : ((P - 1 : ℕ) : ℝ) = (P : ℝ) - 1 := by
    rw [Nat.cast_sub (by omega)]
    norm_num
  rw [← Real.rpow_natCast]
  rw [hcast, ← Real.rpow_mul (finitePSourceBaseCdf_nonneg z), hproduct,
    Real.rpow_one]

/--
The actual finiteP product-integral assignment payoff is the source beta-two
base-CDF sum for every focal producer.  The proof uses the generic tie-aware
reduction and the concrete score-level-null facts above, not an assumed CDF
payoff formula.
-/
theorem finitePSourceContentMeasure_expectedUsersWon_eq_sourceBaseCdfSum
    {P : ℕ} (hP : 2 ≤ P) (j : Fin P) (p : Content 2) :
    ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j p
      (finitePSourceContentMeasure P) =
      ∑ i : Fin 2, finitePSourceBaseCdf (score (pTwoStandardBasisUsers i) p) := by
  letI : IsProbabilityMeasure (finitePSourceContentMeasure P) :=
    finitePSourceContentMeasure_isProbabilityMeasure P
  rw [expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
    (users := pTwoStandardBasisUsers) (j := j) (μ := finitePSourceContentMeasure P)
    p finitePStandardBasisScore_measurable]
  · apply Finset.sum_congr rfl
    intro i _
    rw [finitePSourceContentMeasure_score_lt_measureReal_eq_sourceC2Root hP,
      finitePSourceBaseCdf_root_pow_eq hP]
  · intro i z
    exact finitePSourceContentMeasure_score_level_eq_zero hP i z

/--
For a source-feasible finiteP action, the actual tie-aware pure payoff equals
the beta-two standard-basis objective used by the source C1 calculation.
-/
theorem finitePSourceContentMeasure_sourceMixedPurePayoff_eq_standardBasisObjective
    {P : ℕ} (hP : 2 ≤ P) (j : Fin P) (p : Content 2)
    (hp : NonnegativeContent p) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
      (normRpowCost (SourceNorm.l2 2) 2) p
      (finitePSourceContentMeasure P) =
    standardBasisObjective 2
      (score (pTwoStandardBasisUsers 0) p)
      (score (pTwoStandardBasisUsers 1) p) := by
  unfold SourceMixedPurePayoff
  rw [finitePSourceContentMeasure_expectedUsersWon_eq_sourceBaseCdfSum hP,
    pTwoL2RpowCost_eq_standardBasisCoordinateCost]
  have hzero : ¬ score (pTwoStandardBasisUsers 0) p < 0 :=
    not_lt.mpr (pTwoStandardBasisScore_nonneg_of_nonnegativeContent p hp 0)
  have hone : ¬ score (pTwoStandardBasisUsers 1) p < 0 :=
    not_lt.mpr (pTwoStandardBasisScore_nonneg_of_nonnegativeContent p hp 1)
  have hzero' : ¬ score (content2 1 0) p < 0 := by
    simpa [pTwoStandardBasisUsers] using hzero
  have hone' : ¬ score (content2 0 1) p < 0 := by
    simpa [pTwoStandardBasisUsers] using hone
  unfold standardBasisObjective
  norm_num
  simp [finitePSourceBaseCdf, hzero', hone']

private theorem pTwoStandardBasisValueMap_mem_support_of_mem_finiteP_content_support
    {P : ℕ} {p : Content 2}
    (hp : p ∈ (finitePSourceContentMeasure P).support) :
    pTwoStandardBasisValueMap p ∈
      (Measure.map pTwoStandardBasisValueMap (finitePSourceContentMeasure P)).support := by
  rw [Measure.support_eq_forall_isOpen]
  intro U hpU hUopen
  rw [Measure.map_apply pTwoStandardBasisValueMap_continuous.measurable
    hUopen.measurableSet]
  apply (Measure.mem_support_iff_forall p).mp hp
  apply pTwoStandardBasisValueMap_continuous.continuousAt
  exact hUopen.mem_nhds hpU

private theorem pTwoStandardBasisValueMap_mem_finiteP_sourceCurve_of_mem_contentMeasure_support
    {P : ℕ} (hP : 2 ≤ P) {p : Content 2}
    (hp : p ∈ (finitePSourceContentMeasure P).support) :
    pTwoStandardBasisValueMap p ∈ finitePSourceCurveSupportSet P := by
  have hmap := pTwoStandardBasisValueMap_mem_support_of_mem_finiteP_content_support hp
  rw [finitePStandardBasisValueMap_contentMeasure_support_eq_source_curve hP] at hmap
  exact hmap

private theorem finitePSourceCurveSupportSet_coordinate_bounds
    {P : ℕ} (hP : 2 ≤ P) {z : ℝ × ℝ}
    (hz : z ∈ finitePSourceCurveSupportSet P) :
    0 ≤ z.1 ∧ z.1 ≤ 1 ∧ 0 ≤ z.2 ∧ z.2 ≤ 1 := by
  rw [← finitePSourceCurveSample_range_eq_supportSet hP] at hz
  rcases hz with ⟨u, rfl⟩
  have hnonneg := finitePSourceCurveSample_nonnegative P u
  have hle := finitePSourceCurveSample_coordinates_le_one hP u
  exact ⟨hnonneg.1, hle.1, hnonneg.2, hle.2⟩

/--
Every source-feasible finiteP deviation has pure payoff at most zero, the
value attained by the source curve at beta two.
-/
theorem finitePSourceContentMeasure_sourceMixedPurePayoffAtFocal_le_equilibriumValue
    {P : ℕ} (hP : 2 ≤ P) (j : Fin P) (p : Content 2)
    (hp : NonnegativeContent p) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
      (normRpowCost (SourceNorm.l2 2) 2) p
      (finitePSourceContentMeasure P) ≤ 0 := by
  rw [finitePSourceContentMeasure_sourceMixedPurePayoff_eq_standardBasisObjective
    hP j p hp]
  exact standardBasisObjective_le_beta_two _ _

/--
Every topological-support action of the finiteP content law has pure payoff
zero for either focal producer. The source action-feasibility conclusion is
derived from the closed nonnegative orthant, not assumed for arbitrary
contents.
-/
theorem finitePSourceContentMeasure_sourceMixedPurePayoffAtFocal_eq_equilibriumValue_of_mem_support
    {P : ℕ} (hP : 2 ≤ P) (j : Fin P) (p : Content 2)
    (hp : p ∈ (finitePSourceContentMeasure P).support) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
      (normRpowCost (SourceNorm.l2 2) 2) p
      (finitePSourceContentMeasure P) = 0 := by
  have hp_nonnegative : NonnegativeContent p :=
    finitePSourceContentMeasure_support_subset_nonnegative P hp
  rw [finitePSourceContentMeasure_sourceMixedPurePayoff_eq_standardBasisObjective
    hP j p hp_nonnegative]
  have hz :=
    pTwoStandardBasisValueMap_mem_finiteP_sourceCurve_of_mem_contentMeasure_support hP hp
  have hbounds := finitePSourceCurveSupportSet_coordinate_bounds hP hz
  exact standardBasisObjective_eq_beta_two_of_unit_box
    hbounds.1 hbounds.2.1 hbounds.2.2.1 hbounds.2.2.2

/--
For every finiteP focal producer, each topological-support action weakly beats
every nonnegative pure deviation. This is the source mixed-Nash behavioral
clause stated directly, not a C1/C2/C3 or equilibrium package.
-/
theorem finitePSourceContentMeasure_support_action_payoff_is_maximal_at_each_focal
    {P : ℕ} (hP : 2 ≤ P) (j : Fin P) (p : Content 2)
    (hp : p ∈ (finitePSourceContentMeasure P).support) :
    ∀ q : Content 2, NonnegativeContent q →
      SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
        (normRpowCost (SourceNorm.l2 2) 2) q
        (finitePSourceContentMeasure P) ≤
      SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
        (normRpowCost (SourceNorm.l2 2) 2) p
        (finitePSourceContentMeasure P) := by
  intro q hq
  rw [finitePSourceContentMeasure_sourceMixedPurePayoffAtFocal_eq_equilibriumValue_of_mem_support
    hP j p hp]
  exact finitePSourceContentMeasure_sourceMixedPurePayoffAtFocal_le_equilibriumValue
    hP j q hq

/--
Proposition `utility`, zero-action outside option for the source norm-power
cost: the zero content vector has nonnegative mixed payoff.
-/
theorem sourceMixedPurePayoff_zero_nonneg_of_normRpowCost
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {μ : MixedContentStrategy D} (ν : SourceNorm D) {β : ℝ}
    (hβ : 0 < β) :
    0 ≤
      SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β)
        (0 : Content D) μ := by
  unfold SourceMixedPurePayoff
  have husers :
      0 ≤
        ExpectedUsersWonAgainstSymmetricMixed users j (0 : Content D) μ :=
    expectedUsersWonAgainstSymmetricMixed_nonneg
  simp [normRpowCost_zero ν hβ, husers]

/--
Proposition `utility`, mixed payoff upper bound for any pure content vector:
the expected assigned-user term is at most `N`, and the norm-power cost is
subtracted.
-/
theorem sourceMixedPurePayoff_le_card_sub_normRpowCost
    {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    (ν : SourceNorm D) {β : ℝ} {p : Content D}
    (hint :
      MeasureTheory.Integrable
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j p) j)
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ))) :
    SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β)
        p μ ≤
      (N : ℝ) - normRpowCost ν β p := by
  unfold SourceMixedPurePayoff
  have husers :
      ExpectedUsersWonAgainstSymmetricMixed users j p μ ≤ (N : ℝ) :=
    expectedUsersWonAgainstSymmetricMixed_le_card (users := users)
      (j := j) (p := p) (μ := μ) hint
  linarith

/--
Every pure action strictly outside the source inner support cap has negative
payoff against any symmetric mixed law.  This supplies the zero-action branch
when corrected diagonal payoff security is required for a low-payoff boundary
action of the doubled compact game.
-/
theorem sourceMixedPurePayoff_lt_zero_of_support_cap_lt_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P}
    {μ : MixedContentStrategy D} [IsProbabilityMeasure μ]
    (ν : SourceNorm D) {β : ℝ} {p : Content D}
    (hβ : 0 < β) (hcap : (N : ℝ) ^ β⁻¹ < ν.norm p) :
    SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β) p μ < 0 := by
  have hcost : (N : ℝ) < normRpowCost ν β p :=
    normRpowCost_gt_card_of_support_cap_lt_norm ν hβ hcap
  have hupper :
      SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β) p μ ≤
        (N : ℝ) - normRpowCost ν β p :=
    sourceMixedPurePayoff_le_card_sub_normRpowCost
      (users := users) (j := j) (μ := μ) ν
      (integrable_usersWon_deviateProfile_const users j p)
  linarith

/--
The source's doubled truncated game satisfies corrected diagonal payoff
security for **pure** deviations against a symmetric mixed baseline.  For an
inner-cap deviation, the compact atom-avoiding score-margin construction gives
the secure action.  For an action outside that inner cap, its payoff is
negative and the zero action secures the required payoff.  This theorem is the
pure-deviation component required before any separate lift to the full mixed
extension; it does not assert that the mixed extension is quasisymmetric.
-/
theorem pureDiagonalPayoffSecureOn_sourceTruncatedActionSet_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P} {ν : SourceNorm D} {β : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcostcont : PerturbationCostContinuous (normRpowCost ν β))
    (hνcont : Continuous ν.norm) (hβ : 0 < β) :
    AppliedModelingLib.PureDiagonalPayoffSecureOn
      (sourceTruncatedActionSet ν (2 * ((N : ℝ) ^ β⁻¹)))
      (SourceMixedPurePayoffOnProbabilityMeasure users j (normRpowCost ν β)) := by
  intro μ p hp ε hε
  rcases hp with ⟨hpnonneg, hpouter⟩
  by_cases hpinner : ν.norm p ≤ (N : ℝ) ^ β⁻¹
  · have hpinterior : ν.norm p < 2 * ((N : ℝ) ^ β⁻¹) :=
      norm_lt_double_support_cap_of_norm_le_support_cap hpinner
    obtain ⟨psec, hpsec, hsecure⟩ :=
      exists_securesPayoffAt_sourceMixedPurePayoffOnProbabilityMeasure_within_sourceTruncatedActionSet
        (users := users) (j := j) (μ := μ) (p := p) (cost := normRpowCost ν β)
        (ν := ν) (R := 2 * ((N : ℝ) ^ β⁻¹)) (α :=
          SourceMixedPurePayoffOnProbabilityMeasure users j (normRpowCost ν β) p μ - ε)
        husers_nonnegative husers_nonzero hpnonneg hcostcont hνcont hpinterior (by linarith)
    exact ⟨psec, hpsec, hsecure⟩
  · have hpinner_lt : (N : ℝ) ^ β⁻¹ < ν.norm p := lt_of_not_ge hpinner
    have hpnegative :
        SourceMixedPurePayoffOnProbabilityMeasure users j (normRpowCost ν β) p μ < 0 := by
      simpa [SourceMixedPurePayoffOnProbabilityMeasure] using
        (sourceMixedPurePayoff_lt_zero_of_support_cap_lt_normRpowCost
          (users := users) (j := j) (μ := μ.toMeasure) ν hβ hpinner_lt)
    have hN_card : 0 < Fintype.card (Fin N) :=
      Fintype.card_pos_iff.mpr inferInstance
    have hN_nat : 0 < N := by simpa using hN_card
    have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
    have hcap_pos : 0 < (N : ℝ) ^ β⁻¹ :=
      Real.rpow_pos_of_pos hN_pos _
    have hzero_mem : (0 : Content D) ∈
        sourceTruncatedActionSet ν (2 * ((N : ℝ) ^ β⁻¹)) := by
      refine ⟨zeroContent_nonnegative, ?_⟩
      rw [SourceNorm.norm_zero]
      positivity
    refine ⟨0, hzero_mem, Set.univ, Filter.univ_mem, ?_⟩
    intro μ' _
    have hzero_nonnegative : 0 ≤
      SourceMixedPurePayoffOnProbabilityMeasure users j (normRpowCost ν β) 0 μ' := by
      simpa [SourceMixedPurePayoffOnProbabilityMeasure] using
        (sourceMixedPurePayoff_zero_nonneg_of_normRpowCost
          (users := users) (j := j) (μ := μ'.toMeasure) ν hβ)
    linarith

/--
The corrected pure-deviation security statement transferred to the actual
compact subtype game.  A security neighborhood in ambient probability-measure
space is pulled back along the continuous push-forward of the subtype law.
-/
theorem pureDiagonalPayoffSecureOn_sourceTruncatedMixed_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P} {ν : SourceNorm D} {β : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcostcont : PerturbationCostContinuous (normRpowCost ν β))
    (hνcont : Continuous ν.norm) (hβ : 0 < β) :
    AppliedModelingLib.PureDiagonalPayoffSecureOn Set.univ
      (SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
        (normRpowCost ν β)) := by
  intro μ p _ ε hε
  obtain ⟨psec, hpsec, hsec⟩ :=
    pureDiagonalPayoffSecureOn_sourceTruncatedActionSet_normRpowCost
      (users := users) (j := j) (ν := ν) (β := β)
      husers_nonnegative husers_nonzero hcostcont hνcont hβ
      (sourceTruncatedStrategyToMixedContent ν (2 * ((N : ℝ) ^ β⁻¹)) μ)
      p.1 p.2 ε hε
  rcases hsec with ⟨U, hU, hpayoff⟩
  refine ⟨⟨psec, hpsec⟩, Set.mem_univ _, ?_⟩
  let stateMap :
      ProbabilityMeasure (sourceTruncatedActionSet ν (2 * ((N : ℝ) ^ β⁻¹))) →
        ProbabilityMeasure (Content D) :=
    sourceTruncatedStrategyToMixedContent ν (2 * ((N : ℝ) ^ β⁻¹))
  have hstateMapContinuous : Continuous stateMap :=
    continuous_sourceTruncatedStrategyToMixedContent ν (2 * ((N : ℝ) ^ β⁻¹))
  refine ⟨stateMap ⁻¹' U, hstateMapContinuous.continuousAt.preimage_mem_nhds hU, ?_⟩
  intro μ' hμ'
  change SourceMixedPurePayoffOnProbabilityMeasure users j (normRpowCost ν β) p.1
      (stateMap μ) - ε <
    SourceMixedPurePayoffOnProbabilityMeasure users j (normRpowCost ν β) psec
      (stateMap μ')
  exact hpayoff (stateMap μ') hμ'

/--
The compact source game satisfies the corrigendum's full diagonal payoff
security condition for arbitrary mixed deviations.  This combines the
pure-deviation construction with the verified measurability/integrability
lift: a mixed deviation has a pure component at least as profitable as its
average, and the securing pure action is represented by a Dirac law.
-/
theorem diagonallyPayoffSecure_sourceTruncatedMixedExtension_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P} {ν : SourceNorm D} {β : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν)
    (hcostcont : PerturbationCostContinuous (normRpowCost ν β))
    (hνcont : Continuous ν.norm) (hβ : 0 < β) :
    AppliedModelingLib.DiagonallyPayoffSecure
      (AppliedModelingLib.MixedExtensionPayoff
        (SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
          (normRpowCost ν β))) := by
  have hcost : Continuous (normRpowCost ν β) :=
    continuous_normRpowCost_of_continuous_norm ν hβ.le hνcont
  apply AppliedModelingLib.PureDiagonalPayoffSecureOn.mixedExtension_diagonallyPayoffSecure
  · exact pureDiagonalPayoffSecureOn_sourceTruncatedMixed_normRpowCost
      (users := users) (j := j) (ν := ν) (β := β)
      husers_nonnegative husers_nonzero hcostcont hνcont hβ
  · intro state
    exact stronglyMeasurable_sourceTruncatedMixedPurePayoff
      users ν (2 * ((N : ℝ) ^ β⁻¹)) j (normRpowCost ν β) hcost state
  · intro state strategy
    exact integrable_sourceTruncatedMixedPurePayoff
      users ν (2 * ((N : ℝ) ^ β⁻¹)) hcompact j (normRpowCost ν β) hcost
      strategy state

/--
The mixed extension of the compact source game is diagonally quasi-concave in
the probability-law action: its payoff is affine in the player's own law.
This is the convexity-side hypothesis in the corrected Reny route and is
proved from the actual integrable uniform-tie payoff, not presumed from pure
payoff continuity.
-/
theorem diagonallyProbabilityMeasureQuasiConcave_sourceTruncatedMixedExtension_normRpowCost
    {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P} {ν : SourceNorm D} {β : ℝ}
    (hcompact : SourceNormCompactSublevels ν)
    (hνcont : Continuous ν.norm) (hβ : 0 ≤ β) :
    AppliedModelingLib.DiagonallyProbabilityMeasureQuasiConcave
      (AppliedModelingLib.MixedExtensionPayoff
        (SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
          (normRpowCost ν β))) := by
  have hcost : Continuous (normRpowCost ν β) :=
    continuous_normRpowCost_of_continuous_norm ν hβ hνcont
  apply AppliedModelingLib.mixedExtensionPayoff_diagonallyProbabilityMeasureQuasiConcave
  intro state strategy
  exact integrable_sourceTruncatedMixedPurePayoff
    users ν (2 * ((N : ℝ) ^ β⁻¹)) hcompact j (normRpowCost ν β) hcost strategy state

/--
The mixed-law action space of the doubled compact source game is compact.  The
proof installs the compact subtype as a `CompactSpace` and uses Mathlib's
compactness theorem for probability measures on a compact space.
-/
theorem isCompact_univ_sourceTruncatedMixedActionSpace
    {D : ℕ} (ν : SourceNorm D) (R : ℝ)
    (hcompact : SourceNormCompactSublevels ν) :
    IsCompact (Set.univ : Set (ProbabilityMeasure (sourceTruncatedActionSet ν R))) := by
  letI : CompactSpace (sourceTruncatedActionSet ν R) :=
    isCompact_iff_compactSpace.mp
      (isCompact_sourceTruncatedActionSet_of_compactSublevels ν R hcompact)
  exact isCompact_univ

/--
The affine mixture operation on the compact source mixed-action space is weakly
continuous.  This is the topological, rather than merely algebraic, convexity
input for the fixed-point part of the corrected Reny route.
-/
theorem continuous_probabilityMeasureMix_sourceTruncatedMixedActionSpace
    {D : ℕ} (ν : SourceNorm D) (R : ℝ) :
    Continuous (fun strategies : I ×
      (ProbabilityMeasure (sourceTruncatedActionSet ν R) ×
        ProbabilityMeasure (sourceTruncatedActionSet ν R)) =>
      AppliedModelingLib.probabilityMeasureMix strategies.1 strategies.2.1 strategies.2.2) :=
  AppliedModelingLib.continuous_probabilityMeasureMix

/--
Full diagonal payoff security gives diagonal better-reply security for the
compact mixed extension, in the exact direction needed by Reny's theorem.
-/
theorem diagonallyBetterReplySecure_sourceTruncatedMixedExtension_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P} {ν : SourceNorm D} {β : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν)
    (hcostcont : PerturbationCostContinuous (normRpowCost ν β))
    (hνcont : Continuous ν.norm) (hβ : 0 < β) :
    AppliedModelingLib.DiagonallyBetterReplySecure
      (AppliedModelingLib.MixedExtensionPayoff
        (SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
          (normRpowCost ν β))) :=
  AppliedModelingLib.DiagonallyPayoffSecure.diagonallyBetterReplySecure
    (diagonallyPayoffSecure_sourceTruncatedMixedExtension_normRpowCost
      husers_nonnegative husers_nonzero hcompact hcostcont hνcont hβ)

/--
The compact truncated mixed extension has a diagonal Nash law.  The proof
instantiates the reusable finite-barycentric KKM theorem: finite affinity of
the mixed payoff supplies its cover condition, the proved iid diagonal
identity supplies continuity, and the corrected security construction supplies
the local better-reply premise.
-/
theorem exists_diagonalNash_sourceTruncatedMixedExtension_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D} {β : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcompact : SourceNormCompactSublevels ν)
    (hcostcont : PerturbationCostContinuous (normRpowCost ν β))
    (hνcont : Continuous ν.norm) (hβ : 0 < β) :
    ∃ state : ProbabilityMeasure (sourceTruncatedActionSet ν (2 * ((N : ℝ) ^ β⁻¹))),
      ∀ j : Fin P,
        AppliedModelingLib.IsDiagonalNash
          (AppliedModelingLib.MixedExtensionPayoff
            (SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
              (normRpowCost ν β))) state := by
  let R : ℝ := 2 * ((N : ℝ) ^ β⁻¹)
  have hN_card : 0 < Fintype.card (Fin N) := Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hR_pos : 0 < R := by
    dsimp [R]
    exact mul_pos (by norm_num) (Real.rpow_pos_of_pos hN_pos _)
  letI : Nonempty (sourceTruncatedActionSet ν R) :=
    ⟨⟨0, by
      refine ⟨zeroContent_nonnegative, ?_⟩
      rw [SourceNorm.norm_zero]
      exact hR_pos.le⟩⟩
  letI : CompactSpace (sourceTruncatedActionSet ν R) :=
    isCompact_iff_compactSpace.mp
      (isCompact_sourceTruncatedActionSet_of_compactSublevels ν R hcompact)
  letI : CompactSpace (ProbabilityMeasure (sourceTruncatedActionSet ν R)) := inferInstance
  letI : Nonempty (ProbabilityMeasure (sourceTruncatedActionSet ν R)) :=
    ⟨MeasureTheory.diracProba
      (Classical.choice (show Nonempty (sourceTruncatedActionSet ν R) from inferInstance))⟩
  have hcost : Continuous (normRpowCost ν β) :=
    continuous_normRpowCost_of_continuous_norm ν hβ.le hνcont
  let j0 : Fin P := Classical.choice (show Nonempty (Fin P) from inferInstance)
  let payoff : ProbabilityMeasure (sourceTruncatedActionSet ν R) →
      ProbabilityMeasure (sourceTruncatedActionSet ν R) → ℝ :=
    AppliedModelingLib.MixedExtensionPayoff
      (SourceTruncatedMixedPurePayoff users ν R j0 (normRpowCost ν β))
  have hdiagonal : Continuous fun state => payoff state state := by
    have hsource : Continuous fun state : ProbabilityMeasure (sourceTruncatedActionSet ν R) =>
        SourceTruncatedDiagonalPayoff (N := N) (P := P) ν R (normRpowCost ν β) state :=
      continuous_sourceTruncatedDiagonalPayoff_of_compactSublevels ν R hcompact _ hcost
    convert hsource using 1
    funext state
    exact mixedExtensionPayoff_sourceTruncatedMixedPurePayoff_diagonal_eq_sourceTruncatedDiagonalPayoff
      users ν R hcompact _ hcost state j0
  have hsecure : AppliedModelingLib.DiagonallyBetterReplySecure payoff := by
    dsimp [payoff, j0]
    exact diagonallyBetterReplySecure_sourceTruncatedMixedExtension_normRpowCost
      husers_nonnegative husers_nonzero hcompact hcostcont hνcont hβ
  obtain ⟨state, hstate⟩ := AppliedModelingLib.exists_isDiagonalNash_of_compact_barycentric
    payoff hdiagonal hsecure (by
      intro s hs
      obtain ⟨action, haction⟩ := hs
      letI : Nonempty s := ⟨⟨action, haction⟩⟩
      refine ⟨fun weights =>
        AppliedModelingLib.finiteProbabilityMeasureBarycenter weights (fun action : s => action.1),
        AppliedModelingLib.continuous_finiteProbabilityMeasureBarycenter (fun action : s => action.1), ?_⟩
      intro weights
      apply AppliedModelingLib.exists_le_diagonal_of_finiteBarycenter_affine payoff
        (fun action : s => action.1)
        (fun weights => AppliedModelingLib.finiteProbabilityMeasureBarycenter weights
          (fun action : s => action.1))
      · intro weights
        exact AppliedModelingLib.mixedExtensionPayoff_finiteProbabilityMeasureBarycenter
          (SourceTruncatedMixedPurePayoff users ν R j0 (normRpowCost ν β))
          (AppliedModelingLib.finiteProbabilityMeasureBarycenter weights (fun action : s => action.1))
          weights (fun action : s => action.1) (by
            intro action
            exact integrable_sourceTruncatedMixedPurePayoff users ν R hcompact j0
              (normRpowCost ν β) hcost action.1
              (AppliedModelingLib.finiteProbabilityMeasureBarycenter weights
                (fun action : s => action.1))))
  refine ⟨state, ?_⟩
  have hsymmetry : AppliedModelingLib.MixedQuasiSymmetric
      (fun j : Fin P => SourceTruncatedMixedPurePayoff users ν R j (normRpowCost ν β)) :=
    mixedQuasiSymmetric_sourceTruncatedMixedPurePayoff (P := P)
      users ν R (normRpowCost ν β)
  intro j action
  calc
    AppliedModelingLib.MixedExtensionPayoff
        (SourceTruncatedMixedPurePayoff users ν R j (normRpowCost ν β)) action state =
      AppliedModelingLib.MixedExtensionPayoff
        (SourceTruncatedMixedPurePayoff users ν R j0 (normRpowCost ν β)) action state := by
          unfold AppliedModelingLib.MixedExtensionPayoff
          apply MeasureTheory.integral_congr_ae
          filter_upwards with pureAction
          exact hsymmetry j j0 pureAction state
    _ ≤ AppliedModelingLib.MixedExtensionPayoff
        (SourceTruncatedMixedPurePayoff users ν R j0 (normRpowCost ν β)) state state := hstate action
    _ = AppliedModelingLib.MixedExtensionPayoff
        (SourceTruncatedMixedPurePayoff users ν R j (normRpowCost ν β)) state state := by
          unfold AppliedModelingLib.MixedExtensionPayoff
          apply MeasureTheory.integral_congr_ae
          filter_upwards with pureAction
          exact hsymmetry j0 j pureAction state

/--
The pure-deviation consequence of any diagonal Nash law of the compact JGS
mixed extension.  This is intentionally stated without a topological-support
upgrade: a discontinuous game's mixed equilibrium yields a pointwise
no-profitable-pure-deviation condition directly.
-/
theorem sourceTruncatedMixedExtension_purePayoff_le_of_diagonalNash_normRpowCost
    {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P} {ν : SourceNorm D} {β : ℝ}
    (hνcont : Continuous ν.norm) (hβ : 0 ≤ β)
    {state : ProbabilityMeasure (sourceTruncatedActionSet ν (2 * ((N : ℝ) ^ β⁻¹)))}
    (hnash : AppliedModelingLib.IsDiagonalNash
      (AppliedModelingLib.MixedExtensionPayoff
        (SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
          (normRpowCost ν β))) state) :
    ∀ action : sourceTruncatedActionSet ν (2 * ((N : ℝ) ^ β⁻¹)),
      SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
          (normRpowCost ν β) action state ≤
        AppliedModelingLib.MixedExtensionPayoff
          (SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
            (normRpowCost ν β)) state state := by
  have hcost : Continuous (normRpowCost ν β) :=
    continuous_normRpowCost_of_continuous_norm ν hβ hνcont
  intro action
  exact hnash.purePayoff_le_mixedPayoff
    (stronglyMeasurable_sourceTruncatedMixedPurePayoff
      users ν (2 * ((N : ℝ) ^ β⁻¹)) j (normRpowCost ν β) hcost state) action

/--
The exact a.e. pure-payoff consequence of a compact JGS mixed-extension
diagonal Nash law.  This does not claim the same equality at all topological
support points; that additional bridge remains a separately logged task.
-/
theorem ae_sourceTruncatedMixedExtension_purePayoff_eq_of_diagonalNash_normRpowCost
    {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P} {ν : SourceNorm D} {β : ℝ}
    (hcompact : SourceNormCompactSublevels ν)
    (hνcont : Continuous ν.norm) (hβ : 0 ≤ β)
    {state : ProbabilityMeasure (sourceTruncatedActionSet ν (2 * ((N : ℝ) ^ β⁻¹)))}
    (hnash : AppliedModelingLib.IsDiagonalNash
      (AppliedModelingLib.MixedExtensionPayoff
        (SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
          (normRpowCost ν β))) state) :
    ∀ᵐ action ∂state.toMeasure,
      SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
          (normRpowCost ν β) action state =
        AppliedModelingLib.MixedExtensionPayoff
          (SourceTruncatedMixedPurePayoff users ν (2 * ((N : ℝ) ^ β⁻¹)) j
            (normRpowCost ν β)) state state := by
  have hcost : Continuous (normRpowCost ν β) :=
    continuous_normRpowCost_of_continuous_norm ν hβ hνcont
  exact hnash.ae_purePayoff_eq_mixedPayoff
    (stronglyMeasurable_sourceTruncatedMixedPurePayoff
      users ν (2 * ((N : ℝ) ^ β⁻¹)) j (normRpowCost ν β) hcost state)
    (integrable_sourceTruncatedMixedPurePayoff
      users ν (2 * ((N : ℝ) ^ β⁻¹)) hcompact j (normRpowCost ν β) hcost state state)

/--
Proposition `utility`, an almost-everywhere support-indifference condition gives
the support radius needed by the source proof without assuming that a maximum
norm is attained in the support.  A support action above `N^(1/beta)` would have
negative payoff by the user-mass bound, contradicting its equilibrium payoff.
-/
theorem ae_norm_le_support_cap_of_ae_equilibrium_payoff_normRpowCost
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D} {j : Fin P}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    {equilibriumPayoff β : ℝ}
    (hno :
      SymmetricMixedNoProfitablePureDeviation
        (SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j)
          (normRpowCost ν β))
        μ equilibriumPayoff)
    (hae_support_payoff :
      ∀ᵐ p ∂μ,
        SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j)
          (normRpowCost ν β) p μ = equilibriumPayoff)
    (hint :
      ∀ p : Content D,
        MeasureTheory.Integrable
          (fun profile : Fin P → Content D =>
            usersWon users (deviateProfile profile j p) j)
          (MeasureTheory.Measure.pi (fun _ : Fin P => μ)))
    (hβ : 0 < β) :
    ∀ᵐ p ∂μ, ν.norm p ≤ (N : ℝ) ^ β⁻¹ := by
  have hpayoff_nonneg : 0 ≤ equilibriumPayoff :=
    le_trans
      (sourceMixedPurePayoff_zero_nonneg_of_normRpowCost ν hβ)
      (hno (0 : Content D))
  filter_upwards [hae_support_payoff] with p hp
  by_contra hnot
  have hcap : (N : ℝ) ^ β⁻¹ < ν.norm p := lt_of_not_ge hnot
  have hcost : (N : ℝ) < normRpowCost ν β p :=
    normRpowCost_gt_card_of_support_cap_lt_norm ν hβ hcap
  have hpayoff_nonneg_p :
      0 ≤ SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j)
        (normRpowCost ν β) p μ := by
    rw [hp]
    exact hpayoff_nonneg
  have hupper :
      SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j)
          (normRpowCost ν β) p μ ≤
        (N : ℝ) - normRpowCost ν β p :=
    sourceMixedPurePayoff_le_card_sub_normRpowCost
      (users := users) (j := j) (μ := μ) ν (β := β) (p := p) (hint p)
  linarith

/--
Proposition `utility`, source support-radius upper-bound step from an explicit
support-radius content vector: if a radius-attaining support point has the
equilibrium payoff, then that payoff is at most `N - R^β`.
-/
theorem equilibriumPayoff_le_card_sub_radius_rpow_of_support_radius_point
    {D N P : ℕ} [Nonempty (Fin P)]
    {users : Fin N → Content D} {j : Fin P}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    (ν : SourceNorm D) {β R equilibriumPayoff : ℝ} {pR : Content D}
    (hint :
      MeasureTheory.Integrable
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j pR) j)
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)))
    (hpayoff_eq :
      SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β)
        pR μ = equilibriumPayoff)
    (hnorm : ν.norm pR = R) :
    equilibriumPayoff ≤ (N : ℝ) - R ^ β := by
  have hupper :=
    sourceMixedPurePayoff_le_card_sub_normRpowCost
      (users := users) (j := j) (μ := μ) ν (β := β) (p := pR) hint
  rw [← hpayoff_eq]
  simpa [normRpowCost, hnorm] using hupper

/--
Source event-gain lower bound for the expected assigned-user component alone.
This isolates the measure-theoretic obligation in Proposition `atom`: after
perturbing an atom `p` in user direction `u`, the expected assigned-user gain is
at least the probability of the all-at-atom event times the realized tie-share
jump on that event.
-/
def AtomEventExpectedUsersWonGainLowerBound {D P : ℕ} [Nontrivial (Fin P)]
    (expectedUsersWon : Content D → MixedContentStrategy D → ℝ)
    (μ : MixedContentStrategy D)
    (p u : Content D) (j : Fin P) (ε : ℝ) : Prop :=
  (μ.real ({p} : Set (Content D))) ^ (P - 1) *
      (tieShare u
          (deviateProfile (fun _ : Fin P => p) j (fun d => p d + ε * u d)) j -
        tieShare u (fun _ : Fin P => p) j) ≤
    expectedUsersWon (fun d => p d + ε * u d) μ - expectedUsersWon p μ

theorem atomEventExpectedUsersWonGainLowerBound_of_integral_semantics
    {D N P : ℕ} [Nontrivial (Fin P)]
    {users : Fin N → Content D}
    {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ]
    {p : Content D} {i0 : Fin N} {j : Fin P} {ε : ℝ}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0)) (hε : 0 < ε)
    (hEmeas : MeasurableSet (AllOtherProducersDrawContent j p))
    (hint_base :
      MeasureTheory.Integrable
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j p) j)
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)))
    (hint_perturb :
      MeasureTheory.Integrable
        (fun profile : Fin P → Content D =>
          usersWon users
            (deviateProfile profile j (fun d => p d + ε * users i0 d)) j)
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ))) :
    AtomEventExpectedUsersWonGainLowerBound (D := D) (P := P)
      (ExpectedUsersWonAgainstSymmetricMixed users j) μ p (users i0) j ε := by
  let productMeasure : MeasureTheory.Measure (Fin P → Content D) :=
    MeasureTheory.Measure.pi (fun _ : Fin P => μ)
  let base : (Fin P → Content D) → ℝ := fun profile =>
    usersWon users (deviateProfile profile j p) j
  let perturb : (Fin P → Content D) → ℝ := fun profile =>
    usersWon users
      (deviateProfile profile j (fun d => p d + ε * users i0 d)) j
  let c : ℝ := 1 - 1 / (P : ℝ)
  have hc : 0 ≤ c := by
    have hP_card : 1 < Fintype.card (Fin P) :=
      Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
    have hP_nat : 1 < P := by simpa using hP_card
    have hP_pos : 0 < (P : ℝ) := by exact_mod_cast (lt_trans Nat.zero_lt_one hP_nat)
    have hP_gt_one : 1 < (P : ℝ) := by exact_mod_cast hP_nat
    have hinv_lt : 1 / (P : ℝ) < 1 := by
      rw [div_lt_one hP_pos]
      exact hP_gt_one
    dsimp [c]
    linarith
  have hmono : base ≤ᵐ[productMeasure] perturb := by
    exact Filter.Eventually.of_forall (fun profile =>
      usersWon_le_deviate_replace_by_nonnegative_perturb
        husers_nonneg (husers_nonneg i0) hε.le)
  have hevent :
      ∀ᵐ profile ∂productMeasure,
        profile ∈ AllOtherProducersDrawContent j p →
          c ≤ perturb profile - base profile := by
    exact Filter.Eventually.of_forall (fun profile hprofile =>
      usersWon_gain_allOtherProducersDrawContent_perturb_ge_one_sub_one_div
        hprofile husers_nonneg hzero hε)
  have hlower :=
    integral_gain_lower_bound_of_pointwise_event
      (μ := productMeasure)
      (f := base) (g := perturb)
      (E := AllOtherProducersDrawContent j p) (c := c)
      hEmeas
      (by simpa [base, productMeasure] using hint_base)
      (by simpa [perturb, productMeasure] using hint_perturb)
      hmono hevent hc
  unfold AtomEventExpectedUsersWonGainLowerBound
  rw [tieShare_gain_constantProfile_perturb_eq_one_sub_one_div
    (husers_nonneg i0) hzero hε]
  rw [← measureReal_allOtherProducersDrawContent_eq_pow (μ := μ) j p]
  simpa [ExpectedUsersWonAgainstSymmetricMixed, productMeasure, base, perturb,
    c, mul_comm, mul_left_comm, mul_assoc] using hlower

theorem atomEventPayoffGainLowerBound_of_expectedUsersWonGainLowerBound
    {D P : ℕ} [Nontrivial (Fin P)]
    {expectedUsersWon : Content D → MixedContentStrategy D → ℝ}
    {cost : Content D → ℝ} {μ : MixedContentStrategy D}
    {p u : Content D} {j : Fin P} {ε : ℝ}
    (hgain :
      AtomEventExpectedUsersWonGainLowerBound
        (D := D) (P := P) expectedUsersWon μ p u j ε) :
    AtomEventPayoffGainLowerBound
      (D := D) (P := P)
      (SourceMixedPurePayoff expectedUsersWon cost) cost μ p u j ε := by
  unfold AtomEventPayoffGainLowerBound SourceMixedPurePayoff
  dsimp [AtomEventExpectedUsersWonGainLowerBound] at hgain
  linarith

/--
For one atom, the source payoff lower bound plus continuity produces an
explicit profitable pure perturbation.
-/
theorem exists_profitable_atom_perturbation_of_event_gain_lower_bound
    {D P : ℕ} [Nontrivial (Fin P)]
    {payoff : Content D → MixedContentStrategy D → ℝ}
    {cost : Content D → ℝ} {μ : MixedContentStrategy D}
    [MeasureTheory.IsFiniteMeasure μ] {equilibriumPayoff : ℝ}
    (hcont : PerturbationCostContinuous cost)
    {p u : Content D} {j : Fin P}
    (hp : HasContentPointMass μ p)
    (hu : NonnegativeContent u) (hzero : NonzeroContent u)
    (hpayoff : payoff p μ = equilibriumPayoff)
    (hlower :
      ∀ {ε : ℝ}, 0 < ε →
        AtomEventPayoffGainLowerBound payoff cost μ p u j ε) :
    ∃ p' : Content D, equilibriumPayoff < payoff p' μ := by
  rcases exists_atom_perturb_cost_increase_lt_event_gain
      (P := P) hcont (p := p) (u := u) (j := j) hp hu hzero with
    ⟨ε, hε, hcost⟩
  let p' : Content D := fun d => p d + ε * u d
  have hgap_pos :
      0 <
        (μ.real ({p} : Set (Content D))) ^ (P - 1) *
            (tieShare u
                (deviateProfile (fun _ : Fin P => p) j
                  (fun d => p d + ε * u d)) j -
              tieShare u (fun _ : Fin P => p) j) -
          (cost (fun d => p d + ε * u d) - cost p) := by
    linarith
  have hdiff_pos : 0 < payoff p' μ - payoff p μ := by
    exact lt_of_lt_of_le hgap_pos (by simpa [p', AtomEventPayoffGainLowerBound] using hlower hε)
  refine ⟨p', ?_⟩
  rw [← hpayoff]
  linarith

/--
Strengthened one-atom perturbation step: when the atom itself and the source
user direction are nonnegative, the profitable perturbation remains in the
paper's nonnegative action space.  This is the form needed to contradict a
direct source mixed-Nash best-response condition.
-/
theorem exists_nonnegative_profitable_atom_perturbation_of_event_gain_lower_bound
    {D P : ℕ} [Nontrivial (Fin P)]
    {payoff : Content D → MixedContentStrategy D → ℝ}
    {cost : Content D → ℝ} {μ : MixedContentStrategy D}
    [MeasureTheory.IsFiniteMeasure μ] {equilibriumPayoff : ℝ}
    (hcont : PerturbationCostContinuous cost)
    {p u : Content D} {j : Fin P}
    (hp : HasContentPointMass μ p)
    (hp_nonnegative : NonnegativeContent p)
    (hu : NonnegativeContent u) (hzero : NonzeroContent u)
    (hpayoff : payoff p μ = equilibriumPayoff)
    (hlower :
      ∀ {ε : ℝ}, 0 < ε →
        AtomEventPayoffGainLowerBound payoff cost μ p u j ε) :
    ∃ p' : Content D, NonnegativeContent p' ∧ equilibriumPayoff < payoff p' μ := by
  rcases exists_atom_perturb_cost_increase_lt_event_gain
      (P := P) hcont (p := p) (u := u) (j := j) hp hu hzero with
    ⟨ε, hε, hcost⟩
  let p' : Content D := fun d => p d + ε * u d
  have hgap_pos :
      0 <
        (μ.real ({p} : Set (Content D))) ^ (P - 1) *
            (tieShare u
                (deviateProfile (fun _ : Fin P => p) j
                  (fun d => p d + ε * u d)) j -
              tieShare u (fun _ : Fin P => p) j) -
          (cost (fun d => p d + ε * u d) - cost p) := by
    linarith
  have hdiff_pos : 0 < payoff p' μ - payoff p μ := by
    exact lt_of_lt_of_le hgap_pos
      (by simpa [p', AtomEventPayoffGainLowerBound] using hlower hε)
  refine ⟨p', perturbContent_nonnegative hp_nonnegative hu hε.le, ?_⟩
  rw [← hpayoff]
  linarith

/--
All-atoms payoff lower-bound package: every point mass has a source user
direction and focal producer for which the event-gain lower bound applies.
-/
def AtomEventPayoffLowerBoundsForAtoms {D P : ℕ} [Nontrivial (Fin P)]
    (payoff : Content D → MixedContentStrategy D → ℝ)
    (cost : Content D → ℝ) (μ : MixedContentStrategy D)
    (equilibriumPayoff : ℝ) : Prop :=
  ∀ p : Content D, HasContentPointMass μ p →
    ∃ (u : Content D) (j : Fin P),
      NonnegativeContent u ∧ NonzeroContent u ∧
        payoff p μ = equilibriumPayoff ∧
        ∀ {ε : ℝ}, 0 < ε →
          AtomEventPayoffGainLowerBound payoff cost μ p u j ε

/--
Expected-users version of the all-atoms lower-bound package.  Compared with
`AtomEventPayoffLowerBoundsForAtoms`, this records only the source event-gain
claim for assigned users and lets the cost bookkeeping be derived in Lean.
-/
def AtomEventExpectedUsersWonLowerBoundsForAtoms {D P : ℕ} [Nontrivial (Fin P)]
    (expectedUsersWon : Content D → MixedContentStrategy D → ℝ)
    (cost : Content D → ℝ) (μ : MixedContentStrategy D)
    (equilibriumPayoff : ℝ) : Prop :=
  ∀ p : Content D, HasContentPointMass μ p →
    ∃ (u : Content D) (j : Fin P),
      NonnegativeContent u ∧ NonzeroContent u ∧
        SourceMixedPurePayoff expectedUsersWon cost p μ = equilibriumPayoff ∧
        ∀ {ε : ℝ}, 0 < ε →
          AtomEventExpectedUsersWonGainLowerBound
            (D := D) (P := P) expectedUsersWon μ p u j ε

theorem atomEventExpectedUsersWonLowerBoundsForAtoms_of_integral_semantics
    {D N P : ℕ} [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    {equilibriumPayoff : ℝ} {i0 : Fin N} {j : Fin P}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0))
    (hpayoff :
      ∀ p : Content D, HasContentPointMass μ p →
        SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ =
          equilibriumPayoff)
    (hint_base :
      ∀ p : Content D, HasContentPointMass μ p →
        MeasureTheory.Integrable
          (fun profile : Fin P → Content D =>
            usersWon users (deviateProfile profile j p) j)
          (MeasureTheory.Measure.pi (fun _ : Fin P => μ)))
    (hint_perturb :
      ∀ (p : Content D) {ε : ℝ}, HasContentPointMass μ p → 0 < ε →
        MeasureTheory.Integrable
          (fun profile : Fin P → Content D =>
            usersWon users
              (deviateProfile profile j (fun d => p d + ε * users i0 d)) j)
          (MeasureTheory.Measure.pi (fun _ : Fin P => μ))) :
    AtomEventExpectedUsersWonLowerBoundsForAtoms (D := D) (P := P)
      (ExpectedUsersWonAgainstSymmetricMixed users j) cost μ equilibriumPayoff := by
  intro p hp
  refine ⟨users i0, j, husers_nonneg i0, hzero, hpayoff p hp, ?_⟩
  intro ε hε
  exact atomEventExpectedUsersWonGainLowerBound_of_integral_semantics
    (D := D) (N := N) (P := P)
    husers_nonneg hzero hε
    (measurableSet_allOtherProducersDrawContent j p)
    (hint_base p hp)
    (hint_perturb p hp hε)

