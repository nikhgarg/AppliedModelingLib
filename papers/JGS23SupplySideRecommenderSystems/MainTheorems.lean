theorem canonicalTwoUser_nonzeroSupportGenres_eq_singleton_of_scaledNormRpowCostNash_belowPhase
    {P : ℕ} [Nonempty (Fin P)] {α β theta : ℝ} {mu : Measure (Content 2)}
