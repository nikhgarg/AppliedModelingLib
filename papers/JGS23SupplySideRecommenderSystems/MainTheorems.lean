  · intro z1 z2 hz1 hz2
    exact twoUserInducedCostCrossPartial_neg_of_beta_lt_phaseThreshold_of_pos_scores
      hα hβ hsin hden hβlt hcos.le hz1 hz2

/-- Orthogonal endpoint of the below-threshold support-order argument.  Even
though the cross partial vanishes on the coordinate axes, a reversed pair of
nonnegative support values spans an open rectangle with strictly positive
interior coordinates.  Boundary-safe strict submodularity on that rectangle
therefore gives the same C1 meet/join contradiction as in the acute case. -/
theorem canonicalTwoUser_valueSupport_ordered_of_scaledNormRpowCostNash_of_phase_of_cos_zero
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hα : 0 < α) (hβ : 1 ≤ β)
    (hsin : 0 < Real.sin θ) (hcos : Real.cos θ = 0)
    (hβlt : β < twoUserPhaseThreshold θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume) :
    ∀ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      ∀ q ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
        p.1 < q.1 → p.2 ≤ q.2 := by
  let H1 : ℝ → ℝ := fun x =>
    AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x
  let H2 : ℝ → ℝ := fun x =>
    AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) x
  have hmax : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
          twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z := by
    intro z hz
    simpa [H1, H2] using
      canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
        hsin hnash hscore_ac z hz
  have hfeasible : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ∈ canonicalTwoUserFeasibleValueSet θ := by
    intro z hz
    change NonnegativeContent (canonicalTwoUserContentOfValues θ z.1 z.2)
    exact hnash.2.1
      (canonicalTwoUserContentOfValues_mem_support_of_mem_valueMap_support
        hsin.ne' hz)
  have hcos_nonneg : 0 ≤ Real.cos θ := by rw [hcos]
  have hβtwo : β < 2 := by
    unfold twoUserPhaseThreshold at hβlt
    rw [hcos] at hβlt
    norm_num at hβlt ⊢
    exact hβlt
  intro p hp q hq hpq
  by_contra hnot
  have hqp : q.2 < p.2 := lt_of_not_ge hnot
  have hpfeasible := hfeasible p hp
  have hqfeasible := hfeasible q hq
  have hpcone := (mem_canonicalTwoUserFeasibleValueSet_iff hsin).mp hpfeasible
  have hqcone := (mem_canonicalTwoUserFeasibleValueSet_iff hsin).mp hqfeasible
  have hmeet : (p.1, q.2) ∈ canonicalTwoUserFeasibleValueSet θ := by
    have hmin := canonicalTwoUserFeasibleValueSet_min_mem
      hcos_nonneg hsin hpfeasible hqfeasible
    simpa [min_eq_left hpq.le, min_eq_right hqp.le] using hmin
  have hjoin : (q.1, p.2) ∈ canonicalTwoUserFeasibleValueSet θ := by
    have hmaxpair := canonicalTwoUserFeasibleValueSet_max_mem
      hcos_nonneg hsin hpfeasible hqfeasible
    simpa [max_eq_right hpq.le, max_eq_left hqp.le] using hmaxpair
  have hmeet_le := hmax p hp hmeet
  have hjoin_le := hmax q hq hjoin
  change H1 p.1 + H2 q.2 - twoUserInducedCost α β θ p.1 q.2 ≤
    H1 p.1 + H2 p.2 - twoUserInducedCost α β θ p.1 p.2 at hmeet_le
  change H1 q.1 + H2 p.2 - twoUserInducedCost α β θ q.1 p.2 ≤
    H1 q.1 + H2 q.2 - twoUserInducedCost α β θ q.1 q.2 at hjoin_le
  have hle := add_le_add hmeet_le hjoin_le
  have hq2_nonneg : 0 ≤ q.2 := by
    simpa [hcos] using hqcone.2
  have hcost :=
    twoUserInducedCost_strictSubmodular_of_orthogonal_on_nonnegative_rectangle
      hα hβ hsin hcos hβtwo hpcone.1 hq2_nonneg hpq hqp
  have hlt :
      (H1 p.1 + H2 p.2 - twoUserInducedCost α β θ p.1 p.2) +
          (H1 q.1 + H2 q.2 - twoUserInducedCost α β θ q.1 q.2) <
        (H1 p.1 + H2 q.2 - twoUserInducedCost α β θ p.1 q.2) +
          (H1 q.1 + H2 p.2 - twoUserInducedCost α β θ q.1 p.2) := by
    linarith
  exact (not_lt_of_ge hle) (by simpa using hlt)

/-- Orthogonal counterpart of the support-rank identity.  Boundary-safe
support ordering and atomless projected score laws imply that the two raw CDF
ranks agree at every represented value, including points initially lying on
an axis. -/
theorem canonicalTwoUser_lowerCDFMass_second_eq_first_of_scaledNormRpowCostNash_of_phase_of_cos_zero
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hα : 0 < α) (hβ : 1 ≤ β)
    (hsin : 0 < Real.sin θ) (hcos : Real.cos θ = 0)
