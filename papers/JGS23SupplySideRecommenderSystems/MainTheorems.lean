/--
Proposition `utility`, source-level normalized-Euclidean endpoint.  This is the
paper's positive-profit argument run on its actual nonnegative producer action
space: source mixed Nash supplies the support-action payoff and no-profitable
feasible deviation bound, while the source model's nonnegative users ensure
that the scaled normalized-user deviation is feasible.

As in the source statement, `Q` is an upper bound for the normalized
unit-direction minimum score.  The conclusion is stated for every fixed
support action, which represents the common equilibrium payoff by the
almost-everywhere support-payoff theorem above.
-/
theorem sourceSymmetricMixedNash_supportPayoff_pos_of_positive_profit_condition_l2_normalized_users
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {j : Fin P}
    {μ : MixedContentStrategy D} {p0 : Content D}
    {β Q : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users
      (normRpowCost (SourceNorm.l2 D) β) μ)
    (hp0 : p0 ∈ μ.support)
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hQupper :
      SourceUnitDirectionQUpperBound
        (l2NormalizedUsers users) (SourceNorm.l2 D) Q)
    (hβ : 0 < β) (hQ_nonneg : 0 ≤ Q)
    (hQ : Q < (1 / (N : ℝ)) ^ ((P : ℝ) / β)) :
    0 < SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed users j)
      (normRpowCost (SourceNorm.l2 D) β) p0 μ := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  have hno :=
    sourceSymmetricMixedNash_noProfitableNonnegativeDeviation_of_mem_support
      (j := j) hnash hp0
  have hae_support_payoff :=
    ae_sourceMixedPurePayoff_eq_of_sourceSymmetricMixedNash_of_mem_support
      (j := j) hnash hp0
  have hpayoff_nonneg :
      0 ≤ SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j)
        (normRpowCost (SourceNorm.l2 D) β) p0 μ := by
    exact le_trans
      (sourceMixedPurePayoff_zero_nonneg_of_normRpowCost (SourceNorm.l2 D) hβ)
      (hno (0 : Content D) zeroContent_nonnegative)
  have hae_norm : ∀ᵐ p ∂μ, (SourceNorm.l2 D).norm p ≤ (N : ℝ) ^ β⁻¹ := by
    filter_upwards [hae_support_payoff] with p hp
    by_contra hnot
    have hcap : (N : ℝ) ^ β⁻¹ < (SourceNorm.l2 D).norm p :=
      lt_of_not_ge hnot
    have hcost : (N : ℝ) < normRpowCost (SourceNorm.l2 D) β p :=
      normRpowCost_gt_card_of_support_cap_lt_norm (SourceNorm.l2 D) hβ hcap
    have hpayoff_nonneg_p :
        0 ≤ SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j)
          (normRpowCost (SourceNorm.l2 D) β) p μ := by
      rw [hp]
      exact hpayoff_nonneg
    have hupper :
        SourceMixedPurePayoff
            (ExpectedUsersWonAgainstSymmetricMixed users j)
            (normRpowCost (SourceNorm.l2 D) β) p μ ≤
          (N : ℝ) - normRpowCost (SourceNorm.l2 D) β p :=
      sourceMixedPurePayoff_le_card_sub_normRpowCost
        (users := users) (j := j) (μ := μ) (SourceNorm.l2 D)
        (β := β) (p := p)
        (integrable_usersWon_deviateProfile_const users j p)
    linarith
  let R : ℝ := (N : ℝ) ^ β⁻¹
  have hsupport : μ.real (SourceSupportBall (SourceNorm.l2 D) R) = 1 := by
    exact measureReal_sourceSupportBall_eq_one_of_ae_norm_le hae_norm
  obtain ⟨i, hmass⟩ :=
    exists_bounded_source_min_direction_set_mass_ge_one_div_card
      (l2NormalizedUsers users) (SourceNorm.l2 D) R hsupport
  have hR_nonneg : 0 ≤ R := by
    dsimp [R]
    have hN_card : 0 < Fintype.card (Fin N) :=
      Fintype.card_pos_iff.mpr inferInstance
    have hN_nat : 0 < N := by simpa using hN_card
    have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
    exact Real.rpow_nonneg hN_pos.le _
  have hR : R ^ β ≤ (N : ℝ) := by
    dsimp [R]
    have hN_card : 0 < Fintype.card (Fin N) :=
      Fintype.card_pos_iff.mpr inferInstance
    have hN_nat : 0 < N := by simpa using hN_card
    have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
    have hβ_ne : β ≠ 0 := ne_of_gt hβ
    rw [← Real.rpow_mul hN_pos.le]
    have hmul : β⁻¹ * β = 1 := by field_simp [hβ_ne]
    rw [hmul, Real.rpow_one]
  have hE :
      MeasurableSet
        (AllOtherProducersInBoundedSourceMinDirectionSet j
          (l2NormalizedUsers users) i (SourceNorm.l2 D) R) :=
    measurableSet_allOtherProducersInBoundedSourceMinDirectionSet
      (measurableSet_boundedSourceMinDirectionSet_of_measurable_norm i
        (SourceNorm.l2_measurable D)) j
  have hevent_lower :
      (1 / (N : ℝ)) ^ ((P : ℝ) - 1) ≤
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
          (AllOtherProducersInBoundedSourceMinDirectionSet j
            (l2NormalizedUsers users) i (SourceNorm.l2 D) R) := by
    exact selected_group_event_lower_bound_of_mass_power
      (N := N) (P := P) MeasureTheory.measureReal_nonneg hmass
      (measureReal_allOtherProducersInBoundedSourceMinDirectionSet_eq_rpow
        (μ := μ) j (l2NormalizedUsers users) i (SourceNorm.l2 D) R)
  have hgap : 0 < PositiveProfitGeometryGap N P β Q R :=
    positiveProfitGeometryGap_pos_of_positive_profit_condition_and_support_bound
      hβ hQ_nonneg hR_nonneg hR hQ
  have hprob_gap :
      (Q * R) ^ β <
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
          (AllOtherProducersInBoundedSourceMinDirectionSet j
            (l2NormalizedUsers users) i (SourceNorm.l2 D) R) := by
    unfold PositiveProfitGeometryGap at hgap
    linarith
  have hthreshold_nonneg : 0 ≤ Q * R := mul_nonneg hQ_nonneg hR_nonneg
  obtain ⟨a, ha_gt, ha_cost⟩ :=
    exists_scale_gt_with_rpow_lt hβ hthreshold_nonneg hprob_gap
  have ha_nonneg : 0 ≤ a := le_trans hthreshold_nonneg ha_gt.le
  let direction : Content D := l2NormalizedUsers users i
  have hdirection_nonnegative : NonnegativeContent direction := by
    dsimp [direction, l2NormalizedUsers]
    exact SourceNorm.normalizedContent_nonnegative (SourceNorm.l2 D)
      (husers_nonnegative i)
  have hdirection_score : score (l2NormalizedUsers users i) direction = 1 := by
    dsimp [direction]
    exact SourceNorm.score_self_eq_one_of_l2_norm_eq_one
      (l2NormalizedUsers_norm_eq_one husers_nonzero i)
  have hdirection_norm : (SourceNorm.l2 D).norm direction = 1 := by
    dsimp [direction]
    exact l2NormalizedUsers_norm_eq_one husers_nonzero i
  let p : Content D := scaleContent a direction
  have hp_nonnegative : NonnegativeContent p := by
    dsimp [p]
    exact scaleContent_nonnegative ha_nonneg hdirection_nonnegative
  have hdev_score : Q * R < score (l2NormalizedUsers users i) p := by
    dsimp [p]
    rw [score_scaleContent, hdirection_score, mul_one]
    exact ha_gt
  have hcost : normRpowCost (SourceNorm.l2 D) β p <
      (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
        (AllOtherProducersInBoundedSourceMinDirectionSet j
          (l2NormalizedUsers users) i (SourceNorm.l2 D) R) := by
    dsimp [p, normRpowCost]
    rw [(SourceNorm.l2 D).scale_nonneg ha_nonneg, hdirection_norm, mul_one]
    exact ha_cost
  have hexpected_normalized :
      (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
          (AllOtherProducersInBoundedSourceMinDirectionSet j
            (l2NormalizedUsers users) i (SourceNorm.l2 D) R) ≤
        ExpectedUsersWonAgainstSymmetricMixed (l2NormalizedUsers users) j p μ :=
    expectedUsersWonAgainstSymmetricMixed_lower_bound_of_bounded_source_min_direction_event
      (users := l2NormalizedUsers users) (ν := SourceNorm.l2 D) (i := i)
      (j := j) (μ := μ) (p := p) (Q := Q) (R := R)
      hE (integrable_usersWon_deviateProfile_const (l2NormalizedUsers users) j p)
      hQupper hQ_nonneg hdev_score
  have husers_eq :
      ExpectedUsersWonAgainstSymmetricMixed (l2NormalizedUsers users) j p μ =
        ExpectedUsersWonAgainstSymmetricMixed users j p μ :=
    expectedUsersWonAgainstSymmetricMixed_l2NormalizedUsers_eq
      husers_nonzero j p μ
  have hexpected :
      (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
          (AllOtherProducersInBoundedSourceMinDirectionSet j
            (l2NormalizedUsers users) i (SourceNorm.l2 D) R) ≤
        ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
    rw [← husers_eq]
    exact hexpected_normalized
  have hpayoff_pos :
      0 < SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed users j)
        (normRpowCost (SourceNorm.l2 D) β) p μ := by
    unfold SourceMixedPurePayoff
    linarith
  exact lt_of_lt_of_le hpayoff_pos (hno p hp_nonnegative)

