/--
The canonical two-user score objective for a common conditional-quality CDF
and two genres of equal weight.  Each user's reward is the square-root
geometric mean of its CDF values relative to the two genre scores.
-/
noncomputable def correctedInfiniteTwoGenreScoreObjective
    (F : ℝ → ℝ) (beta A B theta z1 z2 : ℝ) : ℝ :=
  Real.sqrt (F (z1 / B) * F (z1 / A)) +
    Real.sqrt (F (z2 / B) * F (z2 / A)) -
    twoUserInducedCost 1 beta theta z1 z2

/-- The corrected score objective specializes definitionally to the concrete
candidate objective already verified below.  Keeping this bridge opaque to
the simplifier avoids expanding the capped CDF under `IsMaxOn`. -/
theorem correctedInfiniteTwoGenreScoreObjective_candidate_eq
    (a C1 C2 beta A B theta z1 z2 : ℝ) :
    correctedInfiniteTwoGenreScoreObjective
      (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta z1 z2 =
      infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta z1 z2 := rfl

/--
Canonical two-genre equilibrium data in two-user score coordinates.  The
object contains a conditional probability law, its lower-interval CDF
identity, equal genre weights, and support-wide C1 optimality on both genre
rays.
-/
structure CorrectedInfiniteTwoGenreScoreEquilibrium
    (F : ℝ → ℝ) (beta A B theta : ℝ) where
  conditionalQuality : Measure ℝ
  conditionalQuality_probability : IsProbabilityMeasure conditionalQuality
  conditionalQuality_cdf : ∀ q : ℝ,
    conditionalQuality (Set.Iic q) = ENNReal.ofReal (F q)
  conditionalQuality_support_nonnegative :
    conditionalQuality.support ⊆ Set.Ici 0
  firstWeight : ℝ
  secondWeight : ℝ
  firstWeight_eq_half : firstWeight = 1 / 2
  secondWeight_eq_half : secondWeight = 1 / 2
  weights_sum : firstWeight + secondWeight = 1
  first_support_maximizes : ∀ ⦃r : ℝ⦄,
    r ∈ conditionalQuality.support →
      (r * A, r * B) ∈ Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ) ∧
        IsMaxOn
          (fun z : ℝ × ℝ =>
            correctedInfiniteTwoGenreScoreObjective F beta A B theta z.1 z.2)
          (Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ))
          (r * A, r * B)
  second_support_maximizes : ∀ ⦃r : ℝ⦄,
    r ∈ conditionalQuality.support →
      (r * B, r * A) ∈ Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ) ∧
        IsMaxOn
          (fun z : ℝ × ℝ =>
            correctedInfiniteTwoGenreScoreObjective F beta A B theta z.1 z.2)
          (Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ))
          (r * B, r * A)

/--
The geometric-shell CDF realizes the canonical two-genre score equilibrium
when the cutoff balance and full-cone angular maximum hold.  Those hypotheses
give C1 optimality at every radius in the conditional-law support.
-/
noncomputable def infiniteGenreCandidate_correctedInfiniteTwoGenreScoreEquilibrium
    {a C1 C2 beta A B theta phi : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hbalance : C1 = 1 + C2 ^ beta)
    (hA : 0 < A) (hB : 0 < B) (hratio : C2 = B / A)
    (hsin : 0 < Real.sin theta)
    (hA_angle : A = Real.cos phi)
    (hB_angle : B = Real.cos (theta - phi))
    (hglobal : ∀ psi : ℝ, 0 ≤ Real.cos psi →
      0 ≤ Real.cos (theta - psi) →
      (Real.cos psi) ^ beta + (Real.cos (theta - psi)) ^ beta ≤
        A ^ beta + B ^ beta) :
    CorrectedInfiniteTwoGenreScoreEquilibrium
      (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta := by
  refine
    { conditionalQuality :=
        infiniteGenreCandidateMeasure a C1 C2 beta ha hC2 hC2_one hbeta hC1
      conditionalQuality_probability :=
        infiniteGenreCandidate_isProbabilityMeasure
          a C1 C2 beta ha hC2 hC2_one hbeta hC1
      conditionalQuality_cdf := ?_
      conditionalQuality_support_nonnegative := ?_
      firstWeight := 1 / 2
      secondWeight := 1 / 2
      firstWeight_eq_half := rfl
      secondWeight_eq_half := rfl
      weights_sum := by norm_num
      first_support_maximizes := ?_
      second_support_maximizes := ?_ }
  · intro q
    exact infiniteGenreCandidateMeasure_Iic
      a C1 C2 beta q ha hC2 hC2_one hbeta hC1
  · intro r hr
    exact (infiniteGenreCandidateMeasure_support_subset_cutoff
      a C1 C2 beta ha hC2 hC2_one hbeta hC1 hr).1
  · intro r hr
    simpa only [correctedInfiniteTwoGenreScoreObjective_candidate_eq] using
      (infiniteGenreCandidateCrossObjective_isMaxOn_nonnegative_scores_of_mem_support
        ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio hsin hA_angle hB_angle
        hglobal hr)
  · intro r hr
    simpa only [correctedInfiniteTwoGenreScoreObjective_candidate_eq] using
      (infiniteGenreCandidateCrossObjective_isMaxOn_nonnegative_scores_of_mem_support_swapped
        ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio hsin hA_angle hB_angle
        hglobal hr)

/--
The geometric-shell CDF realizes the corrected score equilibrium from the
compact, source-meaningful angular argmax condition.  The theorem no longer
requires an all-real-angle maximum: the preceding positive-score-wedge lemma
proves exactly the comparison needed for nonnegative score deviations.
-/
noncomputable def infiniteGenreCandidate_correctedInfiniteTwoGenreScoreEquilibrium_of_leftHalf_angle_max
    {a C1 C2 beta A B theta phi : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hbalance : C1 = 1 + C2 ^ beta)
    (hA : 0 < A) (hB : 0 < B) (hratio : C2 = B / A)
    (hsin : 0 < Real.sin theta) (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) (hbeta_one : 1 ≤ beta)
    (hA_angle : A = Real.cos phi)
    (hB_angle : B = Real.cos (theta - phi))
    (hmax : IsMaxOn (twoUserCosPowerSum beta theta)
      (Set.Icc 0 (theta / 2)) phi) :
    CorrectedInfiniteTwoGenreScoreEquilibrium
      (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta := by
  refine
    { conditionalQuality :=
        infiniteGenreCandidateMeasure a C1 C2 beta ha hC2 hC2_one hbeta hC1
      conditionalQuality_probability :=
        infiniteGenreCandidate_isProbabilityMeasure
          a C1 C2 beta ha hC2 hC2_one hbeta hC1
      conditionalQuality_cdf := ?_
      conditionalQuality_support_nonnegative := ?_
      firstWeight := 1 / 2
      secondWeight := 1 / 2
      firstWeight_eq_half := rfl
      secondWeight_eq_half := rfl
      weights_sum := by norm_num
      first_support_maximizes := ?_
      second_support_maximizes := ?_ }
  · intro q
    exact infiniteGenreCandidateMeasure_Iic
      a C1 C2 beta q ha hC2 hC2_one hbeta hC1
  · intro r hr
    exact (infiniteGenreCandidateMeasure_support_subset_cutoff
      a C1 C2 beta ha hC2 hC2_one hbeta hC1 hr).1
  · intro r hr
    simpa only [correctedInfiniteTwoGenreScoreObjective_candidate_eq] using
      (infiniteGenreCandidateCrossObjective_isMaxOn_nonnegative_scores_of_mem_support_of_leftHalf_angle_max
        ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio hsin htheta_pos
        htheta_le_half_pi hbeta_one hA_angle hB_angle hmax hr)
  · intro r hr
    simpa only [correctedInfiniteTwoGenreScoreObjective_candidate_eq] using
      (infiniteGenreCandidateCrossObjective_isMaxOn_nonnegative_scores_of_mem_support_swapped_of_leftHalf_angle_max
        ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio hsin htheta_pos
        htheta_le_half_pi hbeta_one hA_angle hB_angle hmax hr)

/-- Two-coordinate content vector, used for the canonical two-user reduction. -/
def content2 (x y : ℝ) : Content 2 :=
  fun d => if d = (0 : Fin 2) then x else y

@[simp] theorem content2_zero (x y : ℝ) :
    content2 x y (0 : Fin 2) = x := by
  simp [content2]

@[simp] theorem content2_one (x y : ℝ) :
    content2 x y (1 : Fin 2) = y := by
  simp [content2]

theorem score_content2 (a b c d : ℝ) :
    score (content2 a b) (content2 c d) = a * c + b * d := by
  simp [score, content2, Fin.sum_univ_two]

/-- The angular vector `(cos θ, sin θ)` has Euclidean source norm one. -/
theorem l2_norm_content2_cos_sin (θ : ℝ) :
    (SourceNorm.l2 2).norm
      (content2 (Real.cos θ) (Real.sin θ)) = 1 := by
  simp [SourceNorm.l2, AppliedModelingLib.FiniteDimensionalNorms.l2,
    AppliedModelingLib.FiniteDimensionalNorms.l2Sq, content2, Fin.sum_univ_two,
    Real.cos_sq_add_sin_sq]

/-- The two standard-basis users in the source's P=2 specialization. -/
def pTwoStandardBasisUsers (i : Fin 2) : Content 2 :=
  content2 (if i = 0 then 1 else 0) (if i = 1 then 1 else 0)

@[simp] theorem pTwoStandardBasisUsers_zero :
    pTwoStandardBasisUsers 0 = content2 1 0 := by
  simp [pTwoStandardBasisUsers]

@[simp] theorem pTwoStandardBasisUsers_one :
    pTwoStandardBasisUsers 1 = content2 0 1 := by
  simp [pTwoStandardBasisUsers]

/-- The source `U`-matrix action for the two standard-basis users. -/
noncomputable def pTwoStandardBasisValueMap (p : Content 2) : ℝ × ℝ :=
  (score (pTwoStandardBasisUsers 0) p,
    score (pTwoStandardBasisUsers 1) p)

/-- Encode the P=2 coordinate plane as the source's two-coordinate content type. -/
def pTwoContentOfCoordinates (z : ℝ × ℝ) : Content 2 :=
  content2 z.1 z.2

theorem pTwoStandardBasisValueMap_contentOfCoordinates
    (z : ℝ × ℝ) :
    pTwoStandardBasisValueMap (pTwoContentOfCoordinates z) = z := by
  ext <;> simp [pTwoStandardBasisValueMap, pTwoContentOfCoordinates, score_content2]

private theorem pTwoStandardBasisValueMap_measurable :
    Measurable pTwoStandardBasisValueMap := by
  unfold pTwoStandardBasisValueMap score
  fun_prop

private theorem pTwoStandardBasisValueMap_continuous :
    Continuous pTwoStandardBasisValueMap := by
  unfold pTwoStandardBasisValueMap score
  fun_prop

private theorem pTwoContentOfCoordinates_measurable :
    Measurable pTwoContentOfCoordinates := by
  apply measurable_pi_lambda
  intro d
  fin_cases d
  · simpa [pTwoContentOfCoordinates] using
      (measurable_fst : Measurable (fun z : ℝ × ℝ => z.1))
  · simpa [pTwoContentOfCoordinates] using
      (measurable_snd : Measurable (fun z : ℝ × ℝ => z.2))

/--
The P=2 source content law obtained by encoding the concrete coordinate
measure as a distribution over `Content 2`.
-/
noncomputable def pTwoSourceContentMeasure (beta : ℝ) : Measure (Content 2) :=
  Measure.map pTwoContentOfCoordinates (pTwoSourceCircleMeasure beta)

theorem pTwoSourceContentMeasure_isProbabilityMeasure (beta : ℝ) :
    IsProbabilityMeasure (pTwoSourceContentMeasure beta) := by
  letI : IsProbabilityMeasure (pTwoSourceCircleMeasure beta) :=
    pTwoSourceCircleMeasure_isProbabilityMeasure beta
  unfold pTwoSourceContentMeasure
  exact Measure.isProbabilityMeasure_map
    pTwoContentOfCoordinates_measurable.aemeasurable

/--
The P=2 coordinate law is the standard-basis score-vector law of the concrete
source content measure. This is the direct distributional transport required
by C3, without a C3 record or equilibrium conclusion.
-/
theorem pTwoStandardBasisValueMap_map_contentMeasure (beta : ℝ) :
    Measure.map pTwoStandardBasisValueMap (pTwoSourceContentMeasure beta) =
      pTwoSourceCircleMeasure beta := by
  unfold pTwoSourceContentMeasure
  rw [Measure.map_map pTwoStandardBasisValueMap_measurable
    pTwoContentOfCoordinates_measurable]
  calc
    Measure.map
        (pTwoStandardBasisValueMap ∘ pTwoContentOfCoordinates)
        (pTwoSourceCircleMeasure beta) =
        Measure.map id (pTwoSourceCircleMeasure beta) := by
          apply Measure.map_congr
          filter_upwards with z
          exact pTwoStandardBasisValueMap_contentOfCoordinates z
    _ = pTwoSourceCircleMeasure beta := Measure.map_id

/--
The realized standard-basis value law of the P=2 content measure has exactly
the literal source quarter-circle as topological support. This is the C2
support statement for the value random variable, not a claim about the
topological support of the content measure itself.
-/
theorem pTwoStandardBasisValueMap_contentMeasure_support_eq_sourceCircle
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    (Measure.map pTwoStandardBasisValueMap (pTwoSourceContentMeasure beta)).support =
      pTwoSourceCircleSupportSet beta := by
  rw [pTwoStandardBasisValueMap_map_contentMeasure,
    pTwoSourceCircleMeasure_support_eq_supportSet hbeta]

private theorem pTwoStandardBasisValueMap_mem_support_of_mem_content_support
    {beta : ℝ} {p : Content 2}
    (hp : p ∈ (pTwoSourceContentMeasure beta).support) :
    pTwoStandardBasisValueMap p ∈
      (Measure.map pTwoStandardBasisValueMap (pTwoSourceContentMeasure beta)).support := by
  rw [Measure.support_eq_forall_isOpen]
  intro U hpU hUopen
  rw [Measure.map_apply pTwoStandardBasisValueMap_continuous.measurable
    hUopen.measurableSet]
  apply (Measure.mem_support_iff_forall p).mp hp
  apply pTwoStandardBasisValueMap_continuous.continuousAt
  exact hUopen.mem_nhds hpU

/--
Every topological-support action of the P=2 content law has its standard-basis
value vector on the literal source circle. This is the support transport needed
by the source mixed-Nash definition, not an equality claim for content support.
-/
theorem pTwoStandardBasisValueMap_mem_sourceCircle_of_mem_contentMeasure_support
    {beta : ℝ} (hbeta : 2 ≤ beta) {p : Content 2}
    (hp : p ∈ (pTwoSourceContentMeasure beta).support) :
    pTwoStandardBasisValueMap p ∈ pTwoSourceCircleSupportSet beta := by
  have hmap := pTwoStandardBasisValueMap_mem_support_of_mem_content_support hp
  rw [pTwoStandardBasisValueMap_contentMeasure_support_eq_sourceCircle hbeta] at hmap
  exact hmap

private theorem nonnegativeContent_content2_iff (x y : ℝ) :
    NonnegativeContent (content2 x y) ↔ 0 ≤ x ∧ 0 ≤ y := by
  constructor
  · intro h
    exact ⟨by simpa using h 0, by simpa using h 1⟩
  · rintro ⟨hx, hy⟩ d
    fin_cases d
    · simpa using hx
    · simpa using hy

/-- The P=2 source content measure is almost everywhere nonnegative. -/
theorem pTwoSourceContentMeasure_ae_nonnegative
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    ∀ᵐ p ∂pTwoSourceContentMeasure beta, NonnegativeContent p := by
  have hmeas : MeasurableSet {p : Content 2 | NonnegativeContent p} := by
    have hset : {p : Content 2 | NonnegativeContent p} =
        {p | 0 ≤ p (0 : Fin 2)} ∩ {p | 0 ≤ p (1 : Fin 2)} := by
      ext p
      constructor
      · intro hp
        exact ⟨hp 0, hp 1⟩
      · rintro ⟨hzero, hone⟩ d
        fin_cases d
        · exact hzero
        · exact hone
    rw [hset]
    exact (measurable_pi_apply 0 measurableSet_Ici).inter
      (measurable_pi_apply 1 measurableSet_Ici)
  unfold pTwoSourceContentMeasure
  rw [ae_map_iff pTwoContentOfCoordinates_measurable.aemeasurable hmeas]
  filter_upwards [pTwoSourceCircleMeasure_ae_on_literal_circle hbeta] with z hz
  exact (nonnegativeContent_content2_iff z.1 z.2).mpr ⟨hz.1, hz.2.1⟩

private theorem nonnegativeContent_content2_set_isClosed :
    IsClosed {p : Content 2 | NonnegativeContent p} := by
  have hset : {p : Content 2 | NonnegativeContent p} =
      {p | 0 ≤ p (0 : Fin 2)} ∩ {p | 0 ≤ p (1 : Fin 2)} := by
    ext p
    constructor
    · intro hp
      exact ⟨hp 0, hp 1⟩
    · rintro ⟨hzero, hone⟩ d
      fin_cases d
      · exact hzero
      · exact hone
  rw [hset]
  exact (isClosed_le continuous_const (continuous_apply 0)).inter
    (isClosed_le continuous_const (continuous_apply 1))

/--
Every topological-support action of the P=2 content law is source-feasible.
The proof upgrades the concrete a.e. nonnegativity fact using closedness of the
nonnegative orthant; it does not identify the whole content support.
-/
theorem pTwoSourceContentMeasure_support_subset_nonnegative
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    (pTwoSourceContentMeasure beta).support ⊆
      {p : Content 2 | NonnegativeContent p} := by
  exact Measure.support_subset_of_isClosed nonnegativeContent_content2_set_isClosed
    (pTwoSourceContentMeasure_ae_nonnegative hbeta)

/--
Almost every P=2 content draw has a standard-basis value vector on the literal
source quarter-circle. This follows from the concrete map construction and is
kept separate from the value law's exact topological-support equality.
-/
theorem pTwoSourceContentMeasure_ae_standardBasisValue_on_sourceCircle
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    ∀ᵐ p ∂pTwoSourceContentMeasure beta,
      pTwoStandardBasisValueMap p ∈ pTwoSourceCircleSupportSet beta := by
  have hmeas : MeasurableSet {p : Content 2 |
      pTwoStandardBasisValueMap p ∈ pTwoSourceCircleSupportSet beta} :=
    (pTwoSourceCircleSupportSet_isClosed beta).measurableSet.preimage
      pTwoStandardBasisValueMap_measurable
  unfold pTwoSourceContentMeasure
  rw [ae_map_iff pTwoContentOfCoordinates_measurable.aemeasurable hmeas]
  filter_upwards [pTwoSourceCircleMeasure_ae_on_literal_circle hbeta] with z hz
  simpa only [pTwoStandardBasisValueMap_contentOfCoordinates] using hz

private theorem noAtoms_map_of_injective
    {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [MeasurableSingletonClass β] (μ : Measure α) [NoAtoms μ] {f : α → β}
    (hf : Measurable f) (hinj : Function.Injective f) :
    NoAtoms (Measure.map f μ) := by
  constructor
  intro y
  rw [Measure.map_apply hf (measurableSet_singleton y)]
  apply Set.Subsingleton.measure_zero
  intro x hx z hz
  apply hinj
  simpa using hx.trans hz.symm

private theorem pTwoSourceCircleSample_first_injective
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    Function.Injective (fun u : I => (pTwoSourceCircleSample beta u).1) := by
  intro u v huv
  have hbeta_pos : 0 < beta := by linarith
  have hradius_pos : 0 < (2 / beta) ^ (1 / beta) := by
    exact Real.rpow_pos_of_pos (div_pos (by norm_num) hbeta_pos) _
  have hfst :
      (2 / beta) ^ (1 / beta) * Real.sqrt (1 - (u : ℝ)) =
        (2 / beta) ^ (1 / beta) * Real.sqrt (1 - (v : ℝ)) := by
    simpa [pTwoSourceCircleSample] using huv
  have hsqrt : Real.sqrt (1 - (u : ℝ)) = Real.sqrt (1 - (v : ℝ)) := by
    exact mul_left_cancel₀ (ne_of_gt hradius_pos) hfst
  apply Subtype.ext
  calc
    (u : ℝ) = 1 - (1 - (u : ℝ)) := by ring
    _ = 1 - Real.sqrt (1 - (u : ℝ)) ^ 2 := by
      rw [Real.sq_sqrt (sub_nonneg.mpr u.2.2)]
    _ = 1 - Real.sqrt (1 - (v : ℝ)) ^ 2 := by rw [hsqrt]
    _ = 1 - (1 - (v : ℝ)) := by
      rw [Real.sq_sqrt (sub_nonneg.mpr v.2.2)]
    _ = (v : ℝ) := by ring

private theorem pTwoSourceCircleSample_second_injective
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    Function.Injective (fun u : I => (pTwoSourceCircleSample beta u).2) := by
  intro u v huv
  have hbeta_pos : 0 < beta := by linarith
  have hradius_pos : 0 < (2 / beta) ^ (1 / beta) := by
    exact Real.rpow_pos_of_pos (div_pos (by norm_num) hbeta_pos) _
  have hsnd :
      (2 / beta) ^ (1 / beta) * Real.sqrt (u : ℝ) =
        (2 / beta) ^ (1 / beta) * Real.sqrt (v : ℝ) := by
    simpa [pTwoSourceCircleSample] using huv
  have hsqrt : Real.sqrt (u : ℝ) = Real.sqrt (v : ℝ) := by
    exact mul_left_cancel₀ (ne_of_gt hradius_pos) hsnd
  apply Subtype.ext
  calc
    (u : ℝ) = Real.sqrt (u : ℝ) ^ 2 := (Real.sq_sqrt u.2.1).symm
    _ = Real.sqrt (v : ℝ) ^ 2 := by rw [hsqrt]
    _ = (v : ℝ) := Real.sq_sqrt v.2.1

private theorem pTwoSourceCircleMeasure_firstCoordinate_noAtoms
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    NoAtoms
      (Measure.map (fun z : ℝ × ℝ => z.1) (pTwoSourceCircleMeasure beta)) := by
  rw [pTwoSourceCircleMeasure]
  rw [Measure.map_map measurable_fst (pTwoSourceCircleSample_measurable beta)]
  apply noAtoms_map_of_injective (volume : Measure I)
  · exact measurable_fst.comp (pTwoSourceCircleSample_measurable beta)
  · simpa only [Function.comp_apply] using pTwoSourceCircleSample_first_injective hbeta

private theorem pTwoSourceCircleMeasure_secondCoordinate_noAtoms
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    NoAtoms
      (Measure.map (fun z : ℝ × ℝ => z.2) (pTwoSourceCircleMeasure beta)) := by
  rw [pTwoSourceCircleMeasure]
  rw [Measure.map_map measurable_snd (pTwoSourceCircleSample_measurable beta)]
  apply noAtoms_map_of_injective (volume : Measure I)
  · exact measurable_snd.comp (pTwoSourceCircleSample_measurable beta)
  · simpa only [Function.comp_apply] using pTwoSourceCircleSample_second_injective hbeta

private theorem pTwoSourceContentMeasure_score_zero_map
    (beta : ℝ) :
    Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 0) q)
      (pTwoSourceContentMeasure beta) =
      Measure.map (fun z : ℝ × ℝ => z.1) (pTwoSourceCircleMeasure beta) := by
  calc
    Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 0) q)
        (pTwoSourceContentMeasure beta) =
        Measure.map ((fun z : ℝ × ℝ => z.1) ∘ pTwoStandardBasisValueMap)
          (pTwoSourceContentMeasure beta) := by
            apply Measure.map_congr
            filter_upwards with q
            rfl
    _ = Measure.map (fun z : ℝ × ℝ => z.1)
          (Measure.map pTwoStandardBasisValueMap (pTwoSourceContentMeasure beta)) := by
            rw [Measure.map_map measurable_fst pTwoStandardBasisValueMap_measurable]
    _ = Measure.map (fun z : ℝ × ℝ => z.1) (pTwoSourceCircleMeasure beta) := by
      rw [pTwoStandardBasisValueMap_map_contentMeasure]

private theorem pTwoSourceContentMeasure_score_one_map
    (beta : ℝ) :
    Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 1) q)
      (pTwoSourceContentMeasure beta) =
      Measure.map (fun z : ℝ × ℝ => z.2) (pTwoSourceCircleMeasure beta) := by
  calc
    Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers 1) q)
        (pTwoSourceContentMeasure beta) =
        Measure.map ((fun z : ℝ × ℝ => z.2) ∘ pTwoStandardBasisValueMap)
          (pTwoSourceContentMeasure beta) := by
            apply Measure.map_congr
            filter_upwards with q
            rfl
    _ = Measure.map (fun z : ℝ × ℝ => z.2)
          (Measure.map pTwoStandardBasisValueMap (pTwoSourceContentMeasure beta)) := by
            rw [Measure.map_map measurable_snd pTwoStandardBasisValueMap_measurable]
    _ = Measure.map (fun z : ℝ × ℝ => z.2) (pTwoSourceCircleMeasure beta) := by
      rw [pTwoStandardBasisValueMap_map_contentMeasure]

private theorem pTwoStandardBasisScore_measurable (i : Fin 2) :
    Measurable (fun q : Content 2 => score (pTwoStandardBasisUsers i) q) := by
  fin_cases i
  · simpa [pTwoStandardBasisValueMap] using
      (measurable_fst.comp pTwoStandardBasisValueMap_measurable)
  · simpa [pTwoStandardBasisValueMap] using
      (measurable_snd.comp pTwoStandardBasisValueMap_measurable)

/--
Every fixed score level has zero mass under the source P=2 content law. This
is the tie-null premise needed to turn the source's tie-sharing assignment
rule into strict-score probabilities; it does not assert an equilibrium.
-/
theorem pTwoSourceContentMeasure_score_level_eq_zero
    {beta : ℝ} (hbeta : 2 ≤ beta) (i : Fin 2) (z : ℝ) :
    pTwoSourceContentMeasure beta
      {q : Content 2 | score (pTwoStandardBasisUsers i) q = z} = 0 := by
  have hmap :
      Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers i) q)
          (pTwoSourceContentMeasure beta) =
        if i = 0 then
          Measure.map (fun z : ℝ × ℝ => z.1) (pTwoSourceCircleMeasure beta)
        else Measure.map (fun z : ℝ × ℝ => z.2) (pTwoSourceCircleMeasure beta) := by
    fin_cases i
    · simpa using pTwoSourceContentMeasure_score_zero_map beta
    · simpa using pTwoSourceContentMeasure_score_one_map beta
  have hno : NoAtoms
      (Measure.map (fun q : Content 2 => score (pTwoStandardBasisUsers i) q)
        (pTwoSourceContentMeasure beta)) := by
    rw [hmap]
    split
    · exact pTwoSourceCircleMeasure_firstCoordinate_noAtoms hbeta
    · exact pTwoSourceCircleMeasure_secondCoordinate_noAtoms hbeta
  have hsingle := hno.measure_singleton z
  rw [Measure.map_apply (pTwoStandardBasisScore_measurable i)
    (measurableSet_singleton z)] at hsingle
  simpa using hsingle

private theorem pTwoSourceMarginalCdf_nonneg
    {beta z : ℝ} (hbeta : 2 ≤ beta) :
    0 ≤ pTwoSourceMarginalCdf beta z := by
  unfold pTwoSourceMarginalCdf
  split
  · norm_num
  · apply le_min
    · have hbeta_pos : 0 < beta := by linarith
      exact mul_nonneg
        (Real.rpow_nonneg (div_nonneg (by norm_num) hbeta_pos.le) _)
        (sq_nonneg z)
    · norm_num

private theorem pTwoSourceContentMeasure_score_zero_lt_measureReal_eq_sourceMarginalCdf
    {beta z : ℝ} (hbeta : 2 ≤ beta) :
    (pTwoSourceContentMeasure beta).real
      {q : Content 2 | score (pTwoStandardBasisUsers 0) q < z} =
      pTwoSourceMarginalCdf beta z := by
  let scoreMap : Content 2 → ℝ := fun q => score (pTwoStandardBasisUsers 0) q
  let μ := pTwoSourceContentMeasure beta
  let ν : Measure ℝ := Measure.map scoreMap μ
  have hmap : ν = Measure.map (fun z : ℝ × ℝ => z.1)
      (pTwoSourceCircleMeasure beta) := by
    dsimp [ν, scoreMap, μ]
    exact pTwoSourceContentMeasure_score_zero_map beta
  letI : NoAtoms ν := by
    rw [hmap]
    exact pTwoSourceCircleMeasure_firstCoordinate_noAtoms hbeta
  have hstrict_eq_le : ν (Set.Iio z) = ν (Set.Iic z) :=
    measure_congr (Iio_ae_eq_Iic (μ := ν))
  have hstrict_eq_le' :
      μ {q : Content 2 | score (pTwoStandardBasisUsers 0) q < z} =
        μ {q : Content 2 | score (pTwoStandardBasisUsers 0) q ≤ z} := by
    change (Measure.map scoreMap μ) (Set.Iio z) =
      (Measure.map scoreMap μ) (Set.Iic z) at hstrict_eq_le
    rw [Measure.map_apply (pTwoStandardBasisScore_measurable 0)
      measurableSet_Iio] at hstrict_eq_le
    rw [Measure.map_apply (pTwoStandardBasisScore_measurable 0)
      measurableSet_Iic] at hstrict_eq_le
    simpa [scoreMap] using hstrict_eq_le
  have hle :
      μ {q : Content 2 | score (pTwoStandardBasisUsers 0) q ≤ z} =
        ENNReal.ofReal (pTwoSourceMarginalCdf beta z) := by
    calc
      μ {q : Content 2 | score (pTwoStandardBasisUsers 0) q ≤ z} =
          (Measure.map scoreMap μ) (Set.Iic z) := by
            symm
            rw [Measure.map_apply (pTwoStandardBasisScore_measurable 0)
              measurableSet_Iic]
            congr 1
      _ = Measure.map (fun z : ℝ × ℝ => z.1)
          (pTwoSourceCircleMeasure beta) (Set.Iic z) := by
            change ν (Set.Iic z) = _
            rw [hmap]
      _ = pTwoSourceCircleMeasure beta {point : ℝ × ℝ | point.1 ≤ z} := by
        rw [Measure.map_apply measurable_fst measurableSet_Iic]
        congr 1
      _ = ENNReal.ofReal (pTwoSourceMarginalCdf beta z) := by
        rw [pTwoSourceCircleMeasure_first_cdf_eq_sourceMarginalCdf hbeta,
          pTwoSourceMarginalCdf_rpow_twoProducerExponent]
  change (μ {q : Content 2 | score (pTwoStandardBasisUsers 0) q < z}).toReal = _
  rw [hstrict_eq_le', hle]
  exact ENNReal.toReal_ofReal (pTwoSourceMarginalCdf_nonneg hbeta)

private theorem pTwoSourceContentMeasure_score_one_lt_measureReal_eq_sourceMarginalCdf
    {beta z : ℝ} (hbeta : 2 ≤ beta) :
    (pTwoSourceContentMeasure beta).real
      {q : Content 2 | score (pTwoStandardBasisUsers 1) q < z} =
      pTwoSourceMarginalCdf beta z := by
  let scoreMap : Content 2 → ℝ := fun q => score (pTwoStandardBasisUsers 1) q
  let μ := pTwoSourceContentMeasure beta
  let ν : Measure ℝ := Measure.map scoreMap μ
  have hmap : ν = Measure.map (fun z : ℝ × ℝ => z.2)
      (pTwoSourceCircleMeasure beta) := by
    dsimp [ν, scoreMap, μ]
    exact pTwoSourceContentMeasure_score_one_map beta
  letI : NoAtoms ν := by
    rw [hmap]
    exact pTwoSourceCircleMeasure_secondCoordinate_noAtoms hbeta
  have hstrict_eq_le : ν (Set.Iio z) = ν (Set.Iic z) :=
    measure_congr (Iio_ae_eq_Iic (μ := ν))
  have hstrict_eq_le' :
      μ {q : Content 2 | score (pTwoStandardBasisUsers 1) q < z} =
        μ {q : Content 2 | score (pTwoStandardBasisUsers 1) q ≤ z} := by
    change (Measure.map scoreMap μ) (Set.Iio z) =
      (Measure.map scoreMap μ) (Set.Iic z) at hstrict_eq_le
    rw [Measure.map_apply (pTwoStandardBasisScore_measurable 1)
      measurableSet_Iio] at hstrict_eq_le
    rw [Measure.map_apply (pTwoStandardBasisScore_measurable 1)
      measurableSet_Iic] at hstrict_eq_le
    simpa [scoreMap] using hstrict_eq_le
  have hle :
      μ {q : Content 2 | score (pTwoStandardBasisUsers 1) q ≤ z} =
        ENNReal.ofReal (pTwoSourceMarginalCdf beta z) := by
    calc
      μ {q : Content 2 | score (pTwoStandardBasisUsers 1) q ≤ z} =
          (Measure.map scoreMap μ) (Set.Iic z) := by
            symm
            rw [Measure.map_apply (pTwoStandardBasisScore_measurable 1)
              measurableSet_Iic]
            congr 1
      _ = Measure.map (fun z : ℝ × ℝ => z.2)
          (pTwoSourceCircleMeasure beta) (Set.Iic z) := by
            change ν (Set.Iic z) = _
            rw [hmap]
      _ = pTwoSourceCircleMeasure beta {point : ℝ × ℝ | point.2 ≤ z} := by
        rw [Measure.map_apply measurable_snd measurableSet_Iic]
        congr 1
      _ = ENNReal.ofReal (pTwoSourceMarginalCdf beta z) := by
        rw [pTwoSourceCircleMeasure_second_cdf_eq_sourceMarginalCdf hbeta,
          pTwoSourceMarginalCdf_rpow_twoProducerExponent]
  change (μ {q : Content 2 | score (pTwoStandardBasisUsers 1) q < z}).toReal = _
  rw [hstrict_eq_le', hle]
  exact ENNReal.toReal_ofReal (pTwoSourceMarginalCdf_nonneg hbeta)

/--
The P=2 source content law has the source marginal CDF as each strict score
distribution. The strict form is valid because the preceding theorem proves
the score-level tie event has zero mass.
-/
theorem pTwoSourceContentMeasure_score_lt_measureReal_eq_sourceMarginalCdf
    {beta z : ℝ} (hbeta : 2 ≤ beta) (i : Fin 2) :
    (pTwoSourceContentMeasure beta).real
      {q : Content 2 | score (pTwoStandardBasisUsers i) q < z} =
      pTwoSourceMarginalCdf beta z := by
  fin_cases i
  · exact pTwoSourceContentMeasure_score_zero_lt_measureReal_eq_sourceMarginalCdf hbeta
  · exact pTwoSourceContentMeasure_score_one_lt_measureReal_eq_sourceMarginalCdf hbeta

private theorem tieShare_deviate_zero_two_eq_indicator
    {D : ℕ} (u p : Content D) (profile : Fin 2 → Content D)
    (hne : score u (profile 1) ≠ score u p) :
    tieShare u (deviateProfile profile 0 p) 0 =
      if score u (profile 1) < score u p then 1 else 0 := by
  classical
  by_cases hlt : score u (profile 1) < score u p
  · rw [if_pos hlt]
    apply tieShare_eq_one_of_strictWinner
    intro k hk
    fin_cases k
    · exact False.elim (hk rfl)
    · simpa [deviateProfile] using hlt
  · rw [if_neg hlt]
    apply tieShare_eq_zero_of_not_mem
    rw [mem_winningProducers]
    intro hwin
    have hle : score u (profile 1) ≤ score u p := by
      simpa [deviateProfile] using hwin 1
    exact hlt (lt_of_le_of_ne hle hne)

private theorem expectedUsersWonAgainstSymmetricMixed_two_eq_strictScoreMass
    {D : ℕ} (users : Fin 2 → Content D) (μ : Measure (Content D))
    [IsProbabilityMeasure μ] (p : Content D)
    (hmeas_score : ∀ i : Fin 2,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin 2) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0) :
    ExpectedUsersWonAgainstSymmetricMixed users (0 : Fin 2) p μ =
      μ.real {q : Content D | score (users 0) q < score (users 0) p} +
        μ.real {q : Content D | score (users 1) q < score (users 1) p} := by
  classical
  let productMeasure : Measure (Fin 2 → Content D) :=
    Measure.pi (fun _ : Fin 2 => μ)
  let E0 : Set (Content D) :=
    {q : Content D | score (users 0) q < score (users 0) p}
  let E1 : Set (Content D) :=
    {q : Content D | score (users 1) q < score (users 1) p}
  have hE0 : MeasurableSet E0 := by
    exact measurableSet_lt (hmeas_score 0) measurable_const
  have hE1 : MeasurableSet E1 := by
    exact measurableSet_lt (hmeas_score 1) measurable_const
  have hne0 : ∀ᵐ profile ∂productMeasure,
      score (users 0) (profile 1) ≠ score (users 0) p := by
    rw [ae_iff]
    simp only [not_not]
    change productMeasure {profile | score (users 0) (profile 1) = score (users 0) p} = 0
    change Measure.pi (fun _ : Fin 2 => μ)
      (Function.eval 1 ⁻¹' {q : Content D | score (users 0) q = score (users 0) p}) = 0
    exact Measure.pi_eval_preimage_null _ (hno_atom 0 _)
  have hne1 : ∀ᵐ profile ∂productMeasure,
      score (users 1) (profile 1) ≠ score (users 1) p := by
    rw [ae_iff]
    simp only [not_not]
    change productMeasure {profile | score (users 1) (profile 1) = score (users 1) p} = 0
    change Measure.pi (fun _ : Fin 2 => μ)
      (Function.eval 1 ⁻¹' {q : Content D | score (users 1) q = score (users 1) p}) = 0
    exact Measure.pi_eval_preimage_null _ (hno_atom 1 _)
  have hint0μ : Integrable (E0.indicator (fun _ : Content D => (1 : ℝ))) μ :=
    (integrable_const (1 : ℝ)).indicator hE0
  have hint1μ : Integrable (E1.indicator (fun _ : Content D => (1 : ℝ))) μ :=
    (integrable_const (1 : ℝ)).indicator hE1
  have hint0 : Integrable
      (fun profile : Fin 2 → Content D =>
        E0.indicator (fun _ : Content D => (1 : ℝ)) (profile 1)) productMeasure := by
    exact integrable_comp_eval hint0μ
  have hint1 : Integrable
      (fun profile : Fin 2 → Content D =>
        E1.indicator (fun _ : Content D => (1 : ℝ)) (profile 1)) productMeasure := by
    exact integrable_comp_eval hint1μ
  unfold ExpectedUsersWonAgainstSymmetricMixed
  change (∫ profile, usersWon users (deviateProfile profile 0 p) 0 ∂productMeasure) = _
  calc
    (∫ profile, usersWon users (deviateProfile profile 0 p) 0 ∂productMeasure) =
        ∫ profile, E0.indicator (fun _ : Content D => (1 : ℝ)) (profile 1) +
          E1.indicator (fun _ : Content D => (1 : ℝ)) (profile 1) ∂productMeasure := by
          apply integral_congr_ae
          filter_upwards [hne0, hne1] with profile h0 h1
          rw [usersWon, Fin.sum_univ_two]
          rw [tieShare_deviate_zero_two_eq_indicator (users 0) p profile h0,
            tieShare_deviate_zero_two_eq_indicator (users 1) p profile h1]
          simp [E0, E1, Set.indicator]
    _ = (∫ profile, E0.indicator (fun _ : Content D => (1 : ℝ)) (profile 1) ∂productMeasure) +
          ∫ profile, E1.indicator (fun _ : Content D => (1 : ℝ)) (profile 1) ∂productMeasure :=
        integral_add hint0 hint1
    _ = (∫ q, E0.indicator (fun _ : Content D => (1 : ℝ)) q ∂μ) +
          ∫ q, E1.indicator (fun _ : Content D => (1 : ℝ)) q ∂μ := by
      rw [show productMeasure = Measure.pi (fun _ : Fin 2 => μ) by rfl]
      rw [integral_comp_eval (i := (1 : Fin 2))
        ((measurable_const.indicator hE0).aestronglyMeasurable)]
      rw [integral_comp_eval (i := (1 : Fin 2))
        ((measurable_const.indicator hE1).aestronglyMeasurable)]
    _ = _ := by
      rw [show (∫ q, E0.indicator (fun _ : Content D => (1 : ℝ)) q ∂μ) = μ.real E0 by
        simpa using (integral_indicator_one (μ := μ) hE0)]
      rw [show (∫ q, E1.indicator (fun _ : Content D => (1 : ℝ)) q ∂μ) = μ.real E1 by
        simpa using (integral_indicator_one (μ := μ) hE1)]

private theorem tieShare_deviate_one_two_eq_indicator
    {D : ℕ} (u p : Content D) (profile : Fin 2 → Content D)
    (hne : score u (profile 0) ≠ score u p) :
    tieShare u (deviateProfile profile 1 p) 1 =
      if score u (profile 0) < score u p then 1 else 0 := by
  classical
  by_cases hlt : score u (profile 0) < score u p
  · rw [if_pos hlt]
    apply tieShare_eq_one_of_strictWinner
    intro k hk
    fin_cases k
    · simpa [deviateProfile] using hlt
    · exact False.elim (hk rfl)
  · rw [if_neg hlt]
    apply tieShare_eq_zero_of_not_mem
    rw [mem_winningProducers]
    intro hwin
    have hle : score u (profile 0) ≤ score u p := by
      simpa [deviateProfile] using hwin 0
    exact hlt (lt_of_le_of_ne hle hne)

private theorem expectedUsersWonAgainstSymmetricMixed_two_one_eq_strictScoreMass
    {D : ℕ} (users : Fin 2 → Content D) (μ : Measure (Content D))
    [IsProbabilityMeasure μ] (p : Content D)
    (hmeas_score : ∀ i : Fin 2,
      Measurable (fun q : Content D => score (users i) q))
    (hno_atom : ∀ (i : Fin 2) (z : ℝ),
      μ {q : Content D | score (users i) q = z} = 0) :
    ExpectedUsersWonAgainstSymmetricMixed users (1 : Fin 2) p μ =
      μ.real {q : Content D | score (users 0) q < score (users 0) p} +
        μ.real {q : Content D | score (users 1) q < score (users 1) p} := by
  classical
  let productMeasure : Measure (Fin 2 → Content D) :=
    Measure.pi (fun _ : Fin 2 => μ)
  let E0 : Set (Content D) :=
    {q : Content D | score (users 0) q < score (users 0) p}
  let E1 : Set (Content D) :=
    {q : Content D | score (users 1) q < score (users 1) p}
  have hE0 : MeasurableSet E0 := by
    exact measurableSet_lt (hmeas_score 0) measurable_const
  have hE1 : MeasurableSet E1 := by
    exact measurableSet_lt (hmeas_score 1) measurable_const
  have hne0 : ∀ᵐ profile ∂productMeasure,
      score (users 0) (profile 0) ≠ score (users 0) p := by
    rw [ae_iff]
    simp only [not_not]
    change productMeasure {profile | score (users 0) (profile 0) = score (users 0) p} = 0
    change Measure.pi (fun _ : Fin 2 => μ)
      (Function.eval 0 ⁻¹' {q : Content D | score (users 0) q = score (users 0) p}) = 0
    exact Measure.pi_eval_preimage_null _ (hno_atom 0 _)
  have hne1 : ∀ᵐ profile ∂productMeasure,
      score (users 1) (profile 0) ≠ score (users 1) p := by
    rw [ae_iff]
    simp only [not_not]
    change productMeasure {profile | score (users 1) (profile 0) = score (users 1) p} = 0
    change Measure.pi (fun _ : Fin 2 => μ)
      (Function.eval 0 ⁻¹' {q : Content D | score (users 1) q = score (users 1) p}) = 0
    exact Measure.pi_eval_preimage_null _ (hno_atom 1 _)
  have hint0μ : Integrable (E0.indicator (fun _ : Content D => (1 : ℝ))) μ :=
    (integrable_const (1 : ℝ)).indicator hE0
  have hint1μ : Integrable (E1.indicator (fun _ : Content D => (1 : ℝ))) μ :=
    (integrable_const (1 : ℝ)).indicator hE1
  have hint0 : Integrable
      (fun profile : Fin 2 → Content D =>
        E0.indicator (fun _ : Content D => (1 : ℝ)) (profile 0)) productMeasure := by
    exact integrable_comp_eval hint0μ
  have hint1 : Integrable
      (fun profile : Fin 2 → Content D =>
        E1.indicator (fun _ : Content D => (1 : ℝ)) (profile 0)) productMeasure := by
    exact integrable_comp_eval hint1μ
  unfold ExpectedUsersWonAgainstSymmetricMixed
  change (∫ profile, usersWon users (deviateProfile profile 1 p) 1 ∂productMeasure) = _
  calc
    (∫ profile, usersWon users (deviateProfile profile 1 p) 1 ∂productMeasure) =
        ∫ profile, E0.indicator (fun _ : Content D => (1 : ℝ)) (profile 0) +
          E1.indicator (fun _ : Content D => (1 : ℝ)) (profile 0) ∂productMeasure := by
          apply integral_congr_ae
          filter_upwards [hne0, hne1] with profile h0 h1
          rw [usersWon, Fin.sum_univ_two]
          rw [tieShare_deviate_one_two_eq_indicator (users 0) p profile h0,
            tieShare_deviate_one_two_eq_indicator (users 1) p profile h1]
          simp [E0, E1, Set.indicator]
    _ = (∫ profile, E0.indicator (fun _ : Content D => (1 : ℝ)) (profile 0) ∂productMeasure) +
          ∫ profile, E1.indicator (fun _ : Content D => (1 : ℝ)) (profile 0) ∂productMeasure :=
        integral_add hint0 hint1
    _ = (∫ q, E0.indicator (fun _ : Content D => (1 : ℝ)) q ∂μ) +
          ∫ q, E1.indicator (fun _ : Content D => (1 : ℝ)) q ∂μ := by
      rw [show productMeasure = Measure.pi (fun _ : Fin 2 => μ) by rfl]
      rw [integral_comp_eval (i := (0 : Fin 2))
        ((measurable_const.indicator hE0).aestronglyMeasurable)]
      rw [integral_comp_eval (i := (0 : Fin 2))
        ((measurable_const.indicator hE1).aestronglyMeasurable)]
    _ = _ := by
      rw [show (∫ q, E0.indicator (fun _ : Content D => (1 : ℝ)) q ∂μ) = μ.real E0 by
        simpa using (integral_indicator_one (μ := μ) hE0)]
      rw [show (∫ q, E1.indicator (fun _ : Content D => (1 : ℝ)) q ∂μ) = μ.real E1 by
        simpa using (integral_indicator_one (μ := μ) hE1)]

/--
For the concrete P=2 candidate, the tie-aware normal-form assignment payoff
is the source's sum of marginal CDF values. The result is an actual payoff
calculation and deliberately does not claim C1, C3, or equilibrium.
-/
theorem pTwoSourceContentMeasure_expectedUsersWon_eq_sourceMarginalCdfSum
    {beta : ℝ} (hbeta : 2 ≤ beta) (p : Content 2) :
    ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers (0 : Fin 2) p
        (pTwoSourceContentMeasure beta) =
      pTwoSourceMarginalCdf beta (score (pTwoStandardBasisUsers 0) p) +
        pTwoSourceMarginalCdf beta (score (pTwoStandardBasisUsers 1) p) := by
  letI : IsProbabilityMeasure (pTwoSourceContentMeasure beta) :=
    pTwoSourceContentMeasure_isProbabilityMeasure beta
  rw [expectedUsersWonAgainstSymmetricMixed_two_eq_strictScoreMass
    pTwoStandardBasisUsers (pTwoSourceContentMeasure beta) p
    pTwoStandardBasisScore_measurable]
  · rw [pTwoSourceContentMeasure_score_lt_measureReal_eq_sourceMarginalCdf hbeta,
      pTwoSourceContentMeasure_score_lt_measureReal_eq_sourceMarginalCdf hbeta]
  · intro i z
    exact pTwoSourceContentMeasure_score_level_eq_zero hbeta i z

/--
For either focal producer in the P=2 candidate, the actual tie-aware
assigned-user payoff is the source sum of marginal CDF values. The two cases
are separately derived from their respective opponent profile coordinates.
-/
theorem pTwoSourceContentMeasure_expectedUsersWonAtFocal_eq_sourceMarginalCdfSum
    {beta : ℝ} (hbeta : 2 ≤ beta) (j : Fin 2) (p : Content 2) :
    ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j p
        (pTwoSourceContentMeasure beta) =
      pTwoSourceMarginalCdf beta (score (pTwoStandardBasisUsers 0) p) +
        pTwoSourceMarginalCdf beta (score (pTwoStandardBasisUsers 1) p) := by
  fin_cases j
  · exact pTwoSourceContentMeasure_expectedUsersWon_eq_sourceMarginalCdfSum hbeta p
  · letI : IsProbabilityMeasure (pTwoSourceContentMeasure beta) :=
      pTwoSourceContentMeasure_isProbabilityMeasure beta
    change ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers (1 : Fin 2) p
        (pTwoSourceContentMeasure beta) = _
    rw [expectedUsersWonAgainstSymmetricMixed_two_one_eq_strictScoreMass
      pTwoStandardBasisUsers (pTwoSourceContentMeasure beta) p
      pTwoStandardBasisScore_measurable]
    · rw [pTwoSourceContentMeasure_score_lt_measureReal_eq_sourceMarginalCdf hbeta,
        pTwoSourceContentMeasure_score_lt_measureReal_eq_sourceMarginalCdf hbeta]
    · intro i z
      exact pTwoSourceContentMeasure_score_level_eq_zero hbeta i z

/-- Canonical users in the rotated two-user coordinate system. -/
def canonicalTwoUserFirst : Content 2 :=
  content2 1 0

noncomputable def canonicalTwoUserSecond (θ : ℝ) : Content 2 :=
  content2 (Real.cos θ) (Real.sin θ)

/-- The canonical two-user realized-value map induced by the source user matrix. -/
noncomputable def canonicalTwoUserValueMap
    (θ : ℝ) (p : Content 2) : ℝ × ℝ :=
  (score canonicalTwoUserFirst p, score (canonicalTwoUserSecond θ) p)

/-- Content vector realizing source values `(z1,z2)` in canonical coordinates. -/
noncomputable def canonicalTwoUserContentOfValues
    (θ z1 z2 : ℝ) : Content 2 :=
  content2 z1 ((z2 - z1 * Real.cos θ) / Real.sin θ)

/-- Embed a two-coordinate content vector in a larger nonnegative coordinate
space, retaining the first two coordinates and setting every extra coordinate
to zero. -/
noncomputable def canonicalTwoUserExtendedContent {m : ℕ}
    (p : Content 2) : Content (m + 2) :=
  fun d => if d = (0 : Fin (m + 2)) then p 0 else
    if d = (1 : Fin (m + 2)) then p 1 else 0

/-- Canonical first user with any number of unused ambient coordinates. -/
noncomputable def canonicalTwoUserExtendedFirst (m : ℕ) : Content (m + 2) :=
  canonicalTwoUserExtendedContent (content2 1 0)

/-- Canonical second user with any number of unused ambient coordinates. -/
noncomputable def canonicalTwoUserExtendedSecond (m : ℕ) (θ : ℝ) : Content (m + 2) :=
  canonicalTwoUserExtendedContent (content2 (Real.cos θ) (Real.sin θ))

theorem canonicalTwoUserExtendedContent_nonnegative {m : ℕ} {p : Content 2}
    (hp : NonnegativeContent p) :
    NonnegativeContent (canonicalTwoUserExtendedContent (m := m) p) := by
  intro d
  by_cases h0 : d = (0 : Fin (m + 2))
  · simpa [canonicalTwoUserExtendedContent, h0] using hp 0
  by_cases h1 : d = (1 : Fin (m + 2))
  · simpa [canonicalTwoUserExtendedContent, h0, h1] using hp 1
  · simp [canonicalTwoUserExtendedContent, h0, h1]

theorem score_canonicalTwoUserExtendedFirst {m : ℕ} (p : Content 2) :
    score (canonicalTwoUserExtendedFirst m)
      (canonicalTwoUserExtendedContent (m := m) p) = p 0 := by
  simp [score, canonicalTwoUserExtendedFirst, canonicalTwoUserExtendedContent, content2,
    Fin.sum_univ_succ]

theorem score_canonicalTwoUserExtendedSecond {m : ℕ} (θ : ℝ) (p : Content 2) :
    score (canonicalTwoUserExtendedSecond m θ)
      (canonicalTwoUserExtendedContent (m := m) p) =
        score (canonicalTwoUserSecond θ) p := by
  simp [score, canonicalTwoUserExtendedSecond, canonicalTwoUserExtendedContent,
    canonicalTwoUserSecond, content2, Fin.sum_univ_succ, Fin.succ_succ_ne_one]

theorem score_canonicalTwoUserExtendedContent_self {m : ℕ} (p : Content 2) :
    score (canonicalTwoUserExtendedContent (m := m) p)
      (canonicalTwoUserExtendedContent (m := m) p) = score p p := by
  simp [score, canonicalTwoUserExtendedContent, Fin.sum_univ_succ, Fin.succ_succ_ne_one]

theorem score_canonicalTwoUserFirst_contentOfValues
    (θ z1 z2 : ℝ) :
    score canonicalTwoUserFirst
      (canonicalTwoUserContentOfValues θ z1 z2) = z1 := by
  simp [canonicalTwoUserFirst, canonicalTwoUserContentOfValues, score_content2]

theorem score_canonicalTwoUserSecond_contentOfValues
    {θ z1 z2 : ℝ} (hsin : Real.sin θ ≠ 0) :
    score (canonicalTwoUserSecond θ)
      (canonicalTwoUserContentOfValues θ z1 z2) = z2 := by
  simp [canonicalTwoUserSecond, canonicalTwoUserContentOfValues, score_content2]
  field_simp [hsin]
  ring

theorem canonicalTwoUserValueMap_contentOfValues
    {θ z1 z2 : ℝ} (hsin : Real.sin θ ≠ 0) :
    canonicalTwoUserValueMap θ
      (canonicalTwoUserContentOfValues θ z1 z2) = (z1, z2) := by
  ext <;> simp [canonicalTwoUserValueMap,
    score_canonicalTwoUserFirst_contentOfValues,
    score_canonicalTwoUserSecond_contentOfValues hsin]

private theorem canonicalTwoUserContentOfValues_valueMap
    {θ : ℝ} (hsin : Real.sin θ ≠ 0) (p : Content 2) :
    canonicalTwoUserContentOfValues θ
      (canonicalTwoUserValueMap θ p).1
      (canonicalTwoUserValueMap θ p).2 = p := by
  have hp : p = content2 (p 0) (p 1) := by
    ext d
    fin_cases d <;> simp
  rw [hp]
  ext d
  fin_cases d
  · simp [canonicalTwoUserValueMap,
      canonicalTwoUserContentOfValues, canonicalTwoUserFirst,
      canonicalTwoUserSecond, score_content2]
  · simp [canonicalTwoUserValueMap,
      canonicalTwoUserContentOfValues, canonicalTwoUserFirst,
      canonicalTwoUserSecond, score_content2]
    field_simp [hsin]
    ring

private theorem canonicalTwoUserValueMap_continuous (θ : ℝ) :
    Continuous (canonicalTwoUserValueMap θ) := by
  unfold canonicalTwoUserValueMap score
  fun_prop

private theorem canonicalTwoUserContentOfValues_continuous (θ : ℝ) :
    Continuous (fun z : ℝ × ℝ =>
      canonicalTwoUserContentOfValues θ z.1 z.2) := by
  apply continuous_pi
  intro d
  fin_cases d
  · simp [canonicalTwoUserContentOfValues, content2]
    fun_prop
  · simp [canonicalTwoUserContentOfValues, content2]
    fun_prop

/--
The source-compatible feasible realized-value set for the canonical two-user
coordinates: values whose reconstructed content lies in the nonnegative
orthant. This is not the literal, dimensionally inconsistent generic C1
domain printed in the source.
-/
def canonicalTwoUserFeasibleValueSet (θ : ℝ) : Set (ℝ × ℝ) :=
  {z | NonnegativeContent (canonicalTwoUserContentOfValues θ z.1 z.2)}

/--
In the source's canonical coordinates, the nonnegative-content feasible set
is the cone `z₁ ≥ 0, z₁ cos θ ≤ z₂`.  Making this elementary description
explicit is what permits coordinatewise C1 deviations below.
-/
theorem mem_canonicalTwoUserFeasibleValueSet_iff
    {θ : ℝ} {z : ℝ × ℝ} (hsin : 0 < Real.sin θ) :
    z ∈ canonicalTwoUserFeasibleValueSet θ ↔
      0 ≤ z.1 ∧ z.1 * Real.cos θ ≤ z.2 := by
  change NonnegativeContent
    (content2 z.1 ((z.2 - z.1 * Real.cos θ) / Real.sin θ)) ↔ _
  rw [nonnegativeContent_content2_iff]
  constructor
  · rintro ⟨hz1, hz2⟩
    refine ⟨hz1, ?_⟩
    rcases (div_nonneg_iff.mp hz2) with hnum | hnum
    · linarith [hnum.1]
    · linarith [hnum.2, hsin]
  · rintro ⟨hz1, hz2⟩
    refine ⟨hz1, ?_⟩
    exact div_nonneg (by linarith) hsin.le

/--
The source `inducedcost` equality is exact in the genuinely cone-preserving
canonical two-coordinate model.  Unlike the printed arbitrary-dimensional
claim, this theorem minimizes over the actual nonnegative content fibre.
-/
theorem canonicalTwoUser_nonnegativeFiberNormSq_eq_inducedCostQuadratic
    {theta z1 z2 : ℝ} (hsin : 0 < Real.sin theta)
    (hfeasible : NonnegativeContent (canonicalTwoUserContentOfValues theta z1 z2)) :
    twoUserNonnegativeFiberNormSq
      canonicalTwoUserFirst (canonicalTwoUserSecond theta) z1 z2 =
      twoUserInducedCostQuadratic theta z1 z2 := by
  have hfirst_unit : score canonicalTwoUserFirst canonicalTwoUserFirst = 1 := by
    simp [canonicalTwoUserFirst, score_content2]
  have hsecond_unit : score (canonicalTwoUserSecond theta) (canonicalTwoUserSecond theta) = 1 := by
    rw [show canonicalTwoUserSecond theta =
      content2 (Real.cos theta) (Real.sin theta) by rfl, score_content2]
    nlinarith [Real.sin_sq_add_cos_sq theta]
  have husers : score canonicalTwoUserFirst (canonicalTwoUserSecond theta) = Real.cos theta := by
    simp [canonicalTwoUserFirst, canonicalTwoUserSecond, score_content2]
  let p : Content 2 := canonicalTwoUserContentOfValues theta z1 z2
  have hscore_first : score canonicalTwoUserFirst p = z1 := by
    exact score_canonicalTwoUserFirst_contentOfValues theta z1 z2
  have hscore_second : score (canonicalTwoUserSecond theta) p = z2 := by
    exact score_canonicalTwoUserSecond_contentOfValues hsin.ne'
  have hnorm : score p p = twoUserInducedCostQuadratic theta z1 z2 := by
    dsimp only [p]
    rw [show canonicalTwoUserContentOfValues theta z1 z2 =
      content2 z1 ((z2 - z1 * Real.cos theta) / Real.sin theta) by rfl,
      score_content2]
    convert twoUserCanonicalNormSq_eq_inducedCostQuadratic hsin.ne' using 1 <;> ring
  apply le_antisymm
  · unfold twoUserNonnegativeFiberNormSq
    apply csInf_le
    · refine ⟨0, ?_⟩
      rintro t ⟨q, hq, hqfirst, hqsecond, rfl⟩
      exact score_self_nonnegative q
    · exact ⟨p, hfeasible, hscore_first, hscore_second, hnorm.symm⟩
  · unfold twoUserNonnegativeFiberNormSq
    refine le_csInf ?_ ?_
    · exact ⟨score p p, ⟨p, hfeasible, hscore_first, hscore_second, rfl⟩⟩
    · intro t ht
      obtain ⟨q, hq, hqfirst, hqsecond, ht⟩ := ht
      rw [ht]
      have hquadratic :=
        twoUserInducedCostQuadratic_le_score_self_of_unit_score_pair
          hfirst_unit hsecond_unit husers hsin.ne' (p := q)
      simpa [hqfirst, hqsecond] using hquadratic

/--
The same cone-preserving induced-cost identity holds in an ambient space with
arbitrarily many unused coordinates when the source user rows are embedded
canonical rows.  Extra coordinates are available to content but cannot lower
the constrained fibre norm.
-/
theorem canonicalTwoUserExtended_nonnegativeFiberNormSq_eq_inducedCostQuadratic
    {m : ℕ} {theta z1 z2 : ℝ} (hsin : 0 < Real.sin theta)
    (hfeasible : NonnegativeContent (canonicalTwoUserContentOfValues theta z1 z2)) :
    twoUserNonnegativeFiberNormSq
      (canonicalTwoUserExtendedFirst m) (canonicalTwoUserExtendedSecond m theta) z1 z2 =
      twoUserInducedCostQuadratic theta z1 z2 := by
  have hfirst_unit : score (canonicalTwoUserExtendedFirst m)
      (canonicalTwoUserExtendedFirst m) = 1 := by
    change score (canonicalTwoUserExtendedFirst m)
      (canonicalTwoUserExtendedContent (m := m) (content2 1 0)) = 1
    rw [score_canonicalTwoUserExtendedFirst]
    simp
  have hsecond_unit : score (canonicalTwoUserExtendedSecond m theta)
      (canonicalTwoUserExtendedSecond m theta) = 1 := by
    change score (canonicalTwoUserExtendedSecond m theta)
      (canonicalTwoUserExtendedContent (m := m)
        (content2 (Real.cos theta) (Real.sin theta))) = 1
    rw [score_canonicalTwoUserExtendedSecond]
    rw [show canonicalTwoUserSecond theta =
      content2 (Real.cos theta) (Real.sin theta) by rfl, score_content2]
    nlinarith [Real.sin_sq_add_cos_sq theta]
  have husers : score (canonicalTwoUserExtendedFirst m)
      (canonicalTwoUserExtendedSecond m theta) = Real.cos theta := by
    change score (canonicalTwoUserExtendedFirst m)
      (canonicalTwoUserExtendedContent (m := m)
        (content2 (Real.cos theta) (Real.sin theta))) = _
    rw [score_canonicalTwoUserExtendedFirst]
    simp
  let p2 : Content 2 := canonicalTwoUserContentOfValues theta z1 z2
  let p : Content (m + 2) := canonicalTwoUserExtendedContent p2
  have hp : NonnegativeContent p := by
    exact canonicalTwoUserExtendedContent_nonnegative hfeasible
  have hscore_first : score (canonicalTwoUserExtendedFirst m) p = z1 := by
    rw [show p = canonicalTwoUserExtendedContent p2 by rfl,
      score_canonicalTwoUserExtendedFirst]
    simp [p2, canonicalTwoUserContentOfValues]
  have hscore_second : score (canonicalTwoUserExtendedSecond m theta) p = z2 := by
    rw [show p = canonicalTwoUserExtendedContent p2 by rfl,
      score_canonicalTwoUserExtendedSecond]
    exact score_canonicalTwoUserSecond_contentOfValues hsin.ne'
  have hnorm : score p p = twoUserInducedCostQuadratic theta z1 z2 := by
    rw [show p = canonicalTwoUserExtendedContent p2 by rfl,
      score_canonicalTwoUserExtendedContent_self]
    dsimp only [p2]
    rw [show canonicalTwoUserContentOfValues theta z1 z2 =
      content2 z1 ((z2 - z1 * Real.cos theta) / Real.sin theta) by rfl,
      score_content2]
    convert twoUserCanonicalNormSq_eq_inducedCostQuadratic hsin.ne' using 1 <;> ring
  apply le_antisymm
  · unfold twoUserNonnegativeFiberNormSq
    apply csInf_le
    · refine ⟨0, ?_⟩
      rintro t ⟨q, hq, hqfirst, hqsecond, rfl⟩
      exact score_self_nonnegative q
    · exact ⟨p, hp, hscore_first, hscore_second, hnorm.symm⟩
  · unfold twoUserNonnegativeFiberNormSq
    refine le_csInf ?_ ?_
    · exact ⟨score p p, ⟨p, hp, hscore_first, hscore_second, rfl⟩⟩
    · intro t ht
      obtain ⟨q, hq, hqfirst, hqsecond, ht⟩ := ht
      rw [ht]
      have hquadratic :=
        twoUserInducedCostQuadratic_le_score_self_of_unit_score_pair
          hfirst_unit hsecond_unit husers hsin.ne' (p := q)
      simpa [hqfirst, hqsecond] using hquadratic

/--
Every feasible score pair in the extended canonical model has an explicit
nonnegative content representative attaining its constrained fibre minimum.
This is the fibre-attainment premise needed by a value-space C1 argument.
-/
theorem canonicalTwoUserExtended_exists_nonnegativeFiberNormSq_minimizer
    {m : ℕ} {theta z1 z2 : ℝ} (hsin : 0 < Real.sin theta)
    (hfeasible : NonnegativeContent (canonicalTwoUserContentOfValues theta z1 z2)) :
    ∃ p : Content (m + 2), NonnegativeContent p ∧
      score (canonicalTwoUserExtendedFirst m) p = z1 ∧
      score (canonicalTwoUserExtendedSecond m theta) p = z2 ∧
      score p p = twoUserNonnegativeFiberNormSq
        (canonicalTwoUserExtendedFirst m) (canonicalTwoUserExtendedSecond m theta) z1 z2 := by
  let p2 : Content 2 := canonicalTwoUserContentOfValues theta z1 z2
  let p : Content (m + 2) := canonicalTwoUserExtendedContent p2
  refine ⟨p, canonicalTwoUserExtendedContent_nonnegative hfeasible, ?_, ?_, ?_⟩
  · rw [show p = canonicalTwoUserExtendedContent p2 by rfl,
      score_canonicalTwoUserExtendedFirst]
    simp [p2, canonicalTwoUserContentOfValues]
  · rw [show p = canonicalTwoUserExtendedContent p2 by rfl,
      score_canonicalTwoUserExtendedSecond]
    exact score_canonicalTwoUserSecond_contentOfValues hsin.ne'
  · rw [show p = canonicalTwoUserExtendedContent p2 by rfl,
      score_canonicalTwoUserExtendedContent_self]
    dsimp only [p2]
    rw [show canonicalTwoUserContentOfValues theta z1 z2 =
      content2 z1 ((z2 - z1 * Real.cos theta) / Real.sin theta) by rfl,
      score_content2]
    calc
      z1 * z1 + ((z2 - z1 * Real.cos theta) / Real.sin theta) *
          ((z2 - z1 * Real.cos theta) / Real.sin theta) =
          twoUserInducedCostQuadratic theta z1 z2 := by
            convert twoUserCanonicalNormSq_eq_inducedCostQuadratic hsin.ne' using 1 <;> ring
      _ = twoUserNonnegativeFiberNormSq
          (canonicalTwoUserExtendedFirst m) (canonicalTwoUserExtendedSecond m theta) z1 z2 :=
        (canonicalTwoUserExtended_nonnegativeFiberNormSq_eq_inducedCostQuadratic hsin hfeasible).symm

/-- The extended canonical fibre minimizer also attains the paper's actual
`L2^beta` cost, for every real exponent. -/
theorem canonicalTwoUserExtended_exists_nonnegativeFiberL2Rpow_minimizer
    {m : ℕ} {beta theta z1 z2 : ℝ} (hsin : 0 < Real.sin theta)
    (hfeasible : NonnegativeContent (canonicalTwoUserContentOfValues theta z1 z2)) :
    ∃ p : Content (m + 2), NonnegativeContent p ∧
      score (canonicalTwoUserExtendedFirst m) p = z1 ∧
      score (canonicalTwoUserExtendedSecond m theta) p = z2 ∧
      AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ beta =
        twoUserNonnegativeFiberL2Rpow beta
          (canonicalTwoUserExtendedFirst m) (canonicalTwoUserExtendedSecond m theta) z1 z2 := by
  obtain ⟨p, hp, hpfirst, hpsecond, hpmin⟩ :=
    canonicalTwoUserExtended_exists_nonnegativeFiberNormSq_minimizer hsin hfeasible
  refine ⟨p, hp, hpfirst, hpsecond, ?_⟩
  rw [l2_rpow_eq_score_self_rpow_div_two, hpmin]
  rfl

/--
A strictly positive, strictly slack canonical value lies in the interior of
the nonnegative-content feasible cone.  This is the exact feasibility fact
needed to apply Fermat's theorem to C1 at such a support value.
-/
theorem canonicalTwoUserFeasibleValueSet_mem_nhds_of_pos_of_strict
    {θ z1 z2 : ℝ} (hsin : 0 < Real.sin θ)
    (hz1 : 0 < z1) (hzslack : z1 * Real.cos θ < z2) :
    canonicalTwoUserFeasibleValueSet θ ∈ 𝓝 (z1, z2) := by
  let U : Set (ℝ × ℝ) := {z | 0 < z.1 ∧ z.1 * Real.cos θ < z.2}
  have hU_open : IsOpen U := by
    dsimp [U]
    exact (isOpen_lt continuous_const continuous_fst).and
      (isOpen_lt (continuous_fst.mul continuous_const) continuous_snd)
  have hzU : (z1, z2) ∈ U := ⟨hz1, hzslack⟩
  have hU_sub : U ⊆ canonicalTwoUserFeasibleValueSet θ := by
    intro z hz
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
    exact ⟨hz.1.le, hz.2.le⟩
  exact Filter.mem_of_superset (hU_open.mem_nhds hzU) hU_sub

/--
The first C1 first-order condition at an arbitrary local interior point of a
score-feasible set.  This separates Fermat's argument from any particular
coordinate chart for the nonnegative content cone.
-/
theorem twoUserInducedCostFirstPartial_eq_of_isMaxOn_of_mem_nhds
    {α β θ z1 z2 h1 : ℝ} {H1 H2 : ℝ → ℝ} {feasible : Set (ℝ × ℝ)}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      feasible (z1, z2))
    (hfeasible : feasible ∈ 𝓝 (z1, z2))
    (hH1 : HasDerivAt H1 h1 z1)
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1) :
    β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
        (z1 - z2 * Real.cos θ) = h1 := by
  have hlocal := hmax.isLocalMax hfeasible
  have hslice : IsLocalMax
      (fun x : ℝ => H1 x + H2 z2 - twoUserInducedCost α β θ x z2) z1 := by
    simpa [Function.comp_def] using
      (hlocal.comp_continuous (g := fun x : ℝ => (x, z2)) (b := z1) (by fun_prop))
  have hcost := hasDerivAt_twoUserInducedCost_z1
    (α := α) (β := β) (θ := θ) (z1 := z1) (z2 := z2)
    (hbase.imp id (fun h => by linarith))
  have hobj := (hH1.add (hasDerivAt_const z1 (H2 z2))).sub hcost
  have hzero := hslice.hasDerivAt_eq_zero hobj
  linarith

/--
The second C1 first-order condition at an arbitrary local interior point of a
score-feasible set.  It is the coordinate-swapped companion of the preceding
chart-independent Fermat lemma.
-/
theorem twoUserInducedCostSecondPartial_eq_of_isMaxOn_of_mem_nhds
    {α β θ z1 z2 h2 : ℝ} {H1 H2 : ℝ → ℝ} {feasible : Set (ℝ × ℝ)}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      feasible (z1, z2))
    (hfeasible : feasible ∈ 𝓝 (z1, z2))
    (hH2 : HasDerivAt H2 h2 z2)
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1) :
    β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
        (z2 - z1 * Real.cos θ) = h2 := by
  have hlocal := hmax.isLocalMax hfeasible
  have hslice : IsLocalMax
      (fun y : ℝ => H1 z1 + H2 y - twoUserInducedCost α β θ z1 y) z2 := by
    simpa [Function.comp_def] using
      (hlocal.comp_continuous (g := fun y : ℝ => (z1, y)) (b := z2) (by fun_prop))
  have hcost := hasDerivAt_twoUserInducedCost_z2
    (α := α) (β := β) (θ := θ) (z1 := z1) (z2 := z2)
    (hbase.imp id (fun h => by linarith))
  have hobj := ((hasDerivAt_const z2 (H1 z1)).add hH2).sub hcost
  have hzero := hslice.hasDerivAt_eq_zero hobj
  linarith

/--
The first displayed FOC follows from C1 maximization at a strictly interior
canonical feasible value, provided the first reward function is differentiable
there.  No derivative of the second reward is needed for this horizontal
variation.
-/
theorem twoUserInducedCostFirstPartial_eq_of_isMaxOn_of_feasibleInterior
    {α β θ z1 z2 h1 : ℝ} {H1 H2 : ℝ → ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θ) (z1, z2))
    (hsin : 0 < Real.sin θ)
    (hz1 : 0 < z1) (hzslack : z1 * Real.cos θ < z2)
    (hH1 : HasDerivAt H1 h1 z1)
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1) :
    β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
        (z1 - z2 * Real.cos θ) = h1 := by
  have hlocal := hmax.isLocalMax
    (canonicalTwoUserFeasibleValueSet_mem_nhds_of_pos_of_strict
      hsin hz1 hzslack)
  have hslice : IsLocalMax
      (fun x : ℝ => H1 x + H2 z2 - twoUserInducedCost α β θ x z2) z1 := by
    simpa [Function.comp_def] using
      (hlocal.comp_continuous (g := fun x : ℝ => (x, z2)) (b := z1) (by fun_prop))
  have hcost := hasDerivAt_twoUserInducedCost_z1
    (α := α) (β := β) (θ := θ) (z1 := z1) (z2 := z2)
    (hbase.imp id (fun h => by linarith))
  have hobj := (hH1.add (hasDerivAt_const z1 (H2 z2))).sub hcost
  have hzero := hslice.hasDerivAt_eq_zero hobj
  linarith

/--
The coordinate-swapped second displayed FOC from C1 maximization at a
strictly interior canonical feasible value.  It requires differentiability of
the second reward only.
-/
theorem twoUserInducedCostSecondPartial_eq_of_isMaxOn_of_feasibleInterior
    {α β θ z1 z2 h2 : ℝ} {H1 H2 : ℝ → ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θ) (z1, z2))
    (hsin : 0 < Real.sin θ)
    (hz1 : 0 < z1) (hzslack : z1 * Real.cos θ < z2)
    (hH2 : HasDerivAt H2 h2 z2)
    (hbase : twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1) :
    β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2 - 1) *
        (z2 - z1 * Real.cos θ) = h2 := by
  have hlocal := hmax.isLocalMax
    (canonicalTwoUserFeasibleValueSet_mem_nhds_of_pos_of_strict
      hsin hz1 hzslack)
  have hslice : IsLocalMax
      (fun y : ℝ => H1 z1 + H2 y - twoUserInducedCost α β θ z1 y) z2 := by
    simpa [Function.comp_def] using
      (hlocal.comp_continuous (g := fun y : ℝ => (z1, y)) (b := z2) (by fun_prop))
  have hcost := hasDerivAt_twoUserInducedCost_z2
    (α := α) (β := β) (θ := θ) (z1 := z1) (z2 := z2)
    (hbase.imp id (fun h => by linarith))
  have hobj := ((hasDerivAt_const z2 (H1 z1)).add hH2).sub hcost
  have hzero := hslice.hasDerivAt_eq_zero hobj
  linarith

/--
The missing boundary version of the source's second-coordinate FOC.  At a
positive point on the lower ray of the canonical nonnegative-content cone,
only the inward content-coordinate variation is feasible.  Its one-sided
optimality nevertheless forces the second marginal derivative to vanish,
because the induced norm-power cost has zero first derivative in that inward
direction at the ray.  This is deliberately not stated as an unrestricted
ambient gradient identity.
-/
theorem deriv_secondReward_eq_zero_of_isMaxOn_of_lowerBoundary
    {α β θ r : ℝ} {H1 H2 : ℝ → ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θ) (r, r * Real.cos θ))
    (hsin : 0 < Real.sin θ) (hr : 0 < r)
    (hH2 : HasDerivAt H2 (deriv H2 (r * Real.cos θ)) (r * Real.cos θ))
    (hH2_nonneg : 0 ≤ deriv H2 (r * Real.cos θ)) :
    deriv H2 (r * Real.cos θ) = 0 := by
  let f : ℝ → ℝ := fun t =>
    H1 r + H2 (r * Real.cos θ + t * Real.sin θ) -
      twoUserInducedCost α β θ r (r * Real.cos θ + t * Real.sin θ)
  have hline : HasDerivAt
      (fun t : ℝ => r * Real.cos θ + t * Real.sin θ) (Real.sin θ) 0 := by
    simpa using
      ((hasDerivAt_id (0 : ℝ)).mul_const (Real.sin θ)).const_add
        (r * Real.cos θ)
  have hbase : twoUserInducedCostNumerator θ r (r * Real.cos θ) ≠ 0 :=
    twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne' (Or.inl hr.ne')
  have hcost_base : HasDerivAt
      (fun y : ℝ => twoUserInducedCost α β θ r y)
      (β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ r (r * Real.cos θ)) ^ (β / 2 - 1) *
          (r * Real.cos θ - r * Real.cos θ))
      (r * Real.cos θ + 0 * Real.sin θ) := by
    simpa using
      hasDerivAt_twoUserInducedCost_z2 (α := α) (β := β) (θ := θ)
        (z1 := r) (z2 := r * Real.cos θ) (Or.inl hbase)
  have hcost_raw := hcost_base.comp 0 hline
  have hcost : HasDerivAt
      (fun t : ℝ => twoUserInducedCost α β θ r
        (r * Real.cos θ + t * Real.sin θ)) 0 0 := by
    convert hcost_raw using 1 <;> ring
  have hH2_base : HasDerivAt H2 (deriv H2 (r * Real.cos θ))
      (r * Real.cos θ + 0 * Real.sin θ) := by
    simpa using hH2
  have hH2line := hH2_base.comp 0 hline
  have hf : HasDerivAt f
      (deriv H2 (r * Real.cos θ) * Real.sin θ) 0 := by
    dsimp [f]
    convert ((hasDerivAt_const (0 : ℝ) (H1 r)).add hH2line).sub hcost using 1 <;> ring
  have hnonpos : ∀ ε : ℝ, 0 < ε → ε < 1 → f ε ≤ f 0 := by
    intro ε hε _
    have hfeasible : (r, r * Real.cos θ + ε * Real.sin θ) ∈
        canonicalTwoUserFeasibleValueSet θ := by
      rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
      constructor
      · exact hr.le
      · nlinarith [mul_pos hε hsin]
    simpa [f] using hmax hfeasible
  have hderiv_nonpos : deriv H2 (r * Real.cos θ) * Real.sin θ ≤ 0 := by
    by_contra hnot
    have hpos : 0 < deriv H2 (r * Real.cos θ) * Real.sin θ :=
      lt_of_not_ge hnot
    obtain ⟨ε, hε_pos, hε_lt, himprove⟩ :=
      exists_pos_right_improvement_of_hasDerivAt_pos_lt hf hpos zero_lt_one
    exact (not_lt_of_ge (hnonpos ε hε_pos hε_lt)) (by simpa using himprove)
  have hderiv_nonneg : 0 ≤ deriv H2 (r * Real.cos θ) * Real.sin θ :=
    mul_nonneg hH2_nonneg hsin.le
  have : deriv H2 (r * Real.cos θ) * Real.sin θ = 0 :=
    le_antisymm hderiv_nonpos hderiv_nonneg
  exact (mul_eq_zero.mp this).resolve_right hsin.ne'

/-- At a positive point on the first-user ray, the inward boundary FOC kills
the second reward derivative, while the unrestricted radial variation remains
available on both sides.  Differentiating that radial maximization therefore
identifies the first reward derivative with the derivative of the homogeneous
ray cost. -/
theorem deriv_firstReward_eq_alpha_mul_beta_mul_rpow_of_isMaxOn_of_lowerBoundary
    {α β θ r : ℝ} {H1 H2 : ℝ → ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θ) (r, r * Real.cos θ))
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ) (hr : 0 < r)
    (hH1 : HasDerivAt H1 (deriv H1 r) r)
    (hH2 : HasDerivAt H2 (deriv H2 (r * Real.cos θ))
      (r * Real.cos θ))
    (hH2_nonneg : 0 ≤ deriv H2 (r * Real.cos θ)) :
    deriv H1 r = α * (β * r ^ (β - 1)) := by
  have hH2_zero : deriv H2 (r * Real.cos θ) = 0 :=
    deriv_secondReward_eq_zero_of_isMaxOn_of_lowerBoundary
      hmax hsin hr hH2 hH2_nonneg
  let f : ℝ → ℝ := fun t =>
    H1 t + H2 (t * Real.cos θ) -
      twoUserInducedCost α β θ t (t * Real.cos θ)
  have hline_max : IsMaxOn f (Set.Ici 0) r := by
    intro t ht
    have ht_feasible : (t, t * Real.cos θ) ∈
        canonicalTwoUserFeasibleValueSet θ := by
      rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
      exact ⟨ht, le_rfl⟩
    simpa [f] using hmax ht_feasible
  have hline_local : IsLocalMax f r :=
    hline_max.isLocalMax (Ici_mem_nhds hr)
  have hline : HasDerivAt (fun t : ℝ => t * Real.cos θ) (Real.cos θ) r := by
    simpa using (hasDerivAt_id r).mul_const (Real.cos θ)
  have hH2_line : HasDerivAt (fun t : ℝ => H2 (t * Real.cos θ))
      (deriv H2 (r * Real.cos θ) * Real.cos θ) r :=
    hH2.comp r hline
  have hpower : HasDerivAt (fun t : ℝ => α * t ^ β)
      (α * (β * r ^ (β - 1))) r :=
    (Real.hasDerivAt_rpow_const (x := r) (p := β) (Or.inl hr.ne')).const_mul α
  have hcost_eq :
      (fun t : ℝ => twoUserInducedCost α β θ t (t * Real.cos θ)) =ᶠ[𝓝 r]
        (fun t : ℝ => α * t ^ β) := by
    filter_upwards [Ioi_mem_nhds hr] with t ht
    simpa using
      (twoUserInducedCost_param_eq_alpha_mul_rpow
        (α := α) (β := β) (θ := θ) (φ := 0) (r := t) ht.le hsin)
  have hcost : HasDerivAt
      (fun t : ℝ => twoUserInducedCost α β θ t (t * Real.cos θ))
      (α * (β * r ^ (β - 1))) r :=
    hpower.congr_of_eventuallyEq hcost_eq
  have hobj : HasDerivAt f
      (deriv H1 r + deriv H2 (r * Real.cos θ) * Real.cos θ -
        α * (β * r ^ (β - 1))) r := by
    dsimp [f]
    exact (hH1.add hH2_line).sub hcost
  have hzero := hline_local.hasDerivAt_eq_zero hobj
  rw [hH2_zero] at hzero
  linarith

/-- A support graph containing the origin cannot meet the first-user boundary
again at a positive score.  Equal marginal rewards and equal equilibrium
payoffs make `2 * H1 x - α * x ^ β` bounded below by its origin value along
the graph.  At a boundary contact equality holds, but the one-sided boundary
FOC and the radial FOC give this function a strictly positive derivative,
contradicting that left-sided minimum. -/
theorem twoUser_valueSupport_graph_strictLower_of_origin_of_equal_rewards
    {α β θ B : ℝ} {μ : Measure (Content 2)} {H1 H2 g : ℝ → ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ) (hB : 0 ≤ B)
    (horigin : (0, 0) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hgraph_zero : g 0 = 0)
    (hgraph_mem : ∀ x ∈ Set.Icc 0 B,
      (x, g x) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hfeasible : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ∈ canonicalTwoUserFeasibleValueSet θ)
    (hmax : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
          twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (htransport : ∀ x ∈ Set.Icc 0 B, H2 (g x) = H1 x)
    (hH2_mono : Monotone H2)
    (hderiv1 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → HasDerivAt H1 (deriv H1 z.1) z.1)
    (hderiv2 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → HasDerivAt H2 (deriv H2 z.2) z.2) :
    ∀ x ∈ Set.Icc 0 B, 0 < x → x * Real.cos θ < g x := by
  have hzero_feasible : (0, 0) ∈ canonicalTwoUserFeasibleValueSet θ := by
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
    norm_num
  have hcost_zero : twoUserInducedCost α β θ 0 0 = 0 :=
    twoUserInducedCost_zero hβ
  have hpayoff_eq : ∀ x ∈ Set.Icc 0 B,
      H1 x + H2 (g x) - twoUserInducedCost α β θ x (g x) =
        H1 0 + H2 0 := by
    intro x hx
    have hxmem := hgraph_mem x hx
    have hleft :
        H1 x + H2 (g x) - twoUserInducedCost α β θ x (g x) ≤
          H1 0 + H2 0 - twoUserInducedCost α β θ 0 0 :=
      (hmax (0, 0) horigin) (hfeasible (x, g x) hxmem)
    have hright :
        H1 0 + H2 0 - twoUserInducedCost α β θ 0 0 ≤
          H1 x + H2 (g x) - twoUserInducedCost α β θ x (g x) :=
      (hmax (x, g x) hxmem) hzero_feasible
    rw [hcost_zero] at hleft hright
    linarith
  have hlower : ∀ x ∈ Set.Icc 0 B,
      H1 0 + H2 0 ≤ 2 * H1 x - α * x ^ β := by
    intro x hx
    have hxmem := hgraph_mem x hx
    have hxfeasible := hfeasible (x, g x) hxmem
    have hxcone := (mem_canonicalTwoUserFeasibleValueSet_iff hsin).mp hxfeasible
    have hcost_lower := alpha_mul_rpow_le_twoUserInducedCost_of_lowerUserRay
      hα hβ hsin hxcone.1 hxcone.2
    have hpayoff := hpayoff_eq x hx
    rw [htransport x hx] at hpayoff
    linarith
  intro r hrI hr
  have hrmem := hgraph_mem r hrI
  have hrfeasible := hfeasible (r, g r) hrmem
  have hrcone := (mem_canonicalTwoUserFeasibleValueSet_iff hsin).mp hrfeasible
  by_contra hnot
  have hboundary : g r = r * Real.cos θ :=
    le_antisymm (le_of_not_gt hnot) hrcone.2
  have hpair_ne : (r, g r) ≠ (0, 0) := by
    intro hpair
    have : r = 0 := by simpa using congrArg Prod.fst hpair
    exact hr.ne' this
  have hmax_boundary : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θ) (r, r * Real.cos θ) := by
    simpa [hboundary] using hmax (r, g r) hrmem
  have hH1 : HasDerivAt H1 (deriv H1 r) r :=
    hderiv1 (r, g r) hrmem hpair_ne
  have hH2 : HasDerivAt H2 (deriv H2 (r * Real.cos θ))
      (r * Real.cos θ) := by
    simpa [hboundary] using hderiv2 (r, g r) hrmem hpair_ne
  have hH2_nonneg : 0 ≤ deriv H2 (r * Real.cos θ) :=
    hH2_mono.deriv_nonneg
  have hH1_value : deriv H1 r = α * (β * r ^ (β - 1)) :=
    deriv_firstReward_eq_alpha_mul_beta_mul_rpow_of_isMaxOn_of_lowerBoundary
      hmax_boundary hα hβ hsin hr hH1 hH2 hH2_nonneg
  have hcost_boundary :
      twoUserInducedCost α β θ r (g r) = α * r ^ β := by
    rw [hboundary]
    simpa using
      (twoUserInducedCost_param_eq_alpha_mul_rpow
        (α := α) (β := β) (θ := θ) (φ := 0) (r := r) hr.le hsin)
  have hcontact : 2 * H1 r - α * r ^ β = H1 0 + H2 0 := by
    have hpayoff := hpayoff_eq r hrI
    rw [htransport r hrI, hcost_boundary] at hpayoff
    linarith
  let F : ℝ → ℝ := fun x => 2 * H1 x - α * x ^ β
  have hpower : HasDerivAt (fun x : ℝ => α * x ^ β)
      (α * (β * r ^ (β - 1))) r :=
    (Real.hasDerivAt_rpow_const (x := r) (p := β) (Or.inl hr.ne')).const_mul α
  have hF : HasDerivAt F
      (2 * deriv H1 r - α * (β * r ^ (β - 1))) r := by
    dsimp [F]
    exact hH1.const_mul 2 |>.sub hpower
  have hF_deriv_pos : 0 < 2 * deriv H1 r - α * (β * r ^ (β - 1)) := by
    rw [hH1_value]
    have hrpow : 0 < r ^ (β - 1) := Real.rpow_pos_of_pos hr _
    have hprod : 0 < α * (β * r ^ (β - 1)) :=
      mul_pos hα (mul_pos hβ hrpow)
    linarith
  obtain ⟨ε, hε, hεr, hdecrease⟩ :=
    AppliedModelingLib.Optimization.exists_pos_left_decrease_of_hasDerivAt_pos_lt
      hF hF_deriv_pos hr
  have hrεI : r - ε ∈ Set.Icc 0 B := by
    constructor
    · linarith
    · linarith [hrI.2]
  have hminimum := hlower (r - ε) hrεI
  dsimp [F] at hdecrease
  linarith

/--
At the orthogonal canonical endpoint, a positive value on the zero-first-score
boundary admits only an inward first-coordinate variation.  As on the lower
user ray, one-sided optimality forces the corresponding reward derivative to
vanish because the induced norm-power cost has zero first derivative in that
inward direction.  This is a boundary calculation, not an unrestricted FOC.
-/
theorem deriv_firstReward_eq_zero_of_isMaxOn_of_leftBoundary_of_orthogonal
    {α β θ r : ℝ} {H1 H2 : ℝ → ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θ) (0, r))
    (hsin : 0 < Real.sin θ) (hcos : Real.cos θ = 0) (hr : 0 < r)
    (hH1 : HasDerivAt H1 (deriv H1 0) 0)
    (hH1_nonneg : 0 ≤ deriv H1 0) :
    deriv H1 0 = 0 := by
  let f : ℝ → ℝ := fun t =>
    H1 t + H2 r - twoUserInducedCost α β θ t r
  have hbase : twoUserInducedCostNumerator θ 0 r ≠ 0 :=
    twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne'
      (Or.inr hr.ne')
  have hcost_base : HasDerivAt
      (fun x : ℝ => twoUserInducedCost α β θ x r)
      (β * α * (Real.sin θ) ^ (-β) *
        (twoUserInducedCostNumerator θ 0 r) ^ (β / 2 - 1) *
          (0 - r * Real.cos θ)) 0 := by
    exact hasDerivAt_twoUserInducedCost_z1 (α := α) (β := β) (θ := θ)
      (z1 := 0) (z2 := r) (Or.inl hbase)
  have hcost : HasDerivAt
      (fun t : ℝ => twoUserInducedCost α β θ t r) 0 0 := by
    convert hcost_base using 1 <;> simp [hcos]
  have hf : HasDerivAt f (deriv H1 0) 0 := by
    dsimp [f]
    convert ((hH1.add (hasDerivAt_const 0 (H2 r))).sub hcost) using 1 <;> ring
  have hnonpos : ∀ ε : ℝ, 0 < ε → ε < 1 → f ε ≤ f 0 := by
    intro ε hε _
    have hfeasible : (ε, r) ∈ canonicalTwoUserFeasibleValueSet θ := by
      rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
      constructor
      · exact hε.le
      · simp [hcos, hr.le]
    simpa [f] using hmax hfeasible
  have hderiv_nonpos : deriv H1 0 ≤ 0 := by
    by_contra hnot
    have hpos : 0 < deriv H1 0 := lt_of_not_ge hnot
    obtain ⟨ε, hε_pos, hε_lt, himprove⟩ :=
      exists_pos_right_improvement_of_hasDerivAt_pos_lt hf hpos zero_lt_one
    exact (not_lt_of_ge (hnonpos ε hε_pos hε_lt)) (by simpa using himprove)
  exact le_antisymm hderiv_nonpos hH1_nonneg

/--
An orthogonal canonical C1 problem has strict interior support whenever both
marginal rewards have strictly positive derivative at zero.  The derivative
condition is intentionally explicit: smoothness of a CDF at a support point
does not by itself make that derivative positive.
-/
theorem canonicalTwoUser_strictInterior_of_isMaxOn_of_orthogonal_of_positiveRewardDerivAtZero
    {α β θ : ℝ} {H1 H2 : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hmax : ∀ z ∈ S,
      IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (hfeasible : ∀ z ∈ S, z ∈ canonicalTwoUserFeasibleValueSet θ)
    (hsin : 0 < Real.sin θ) (hcos : Real.cos θ = 0)
    (hH1 : HasDerivAt H1 (deriv H1 0) 0) (hH1_pos : 0 < deriv H1 0)
    (hH2 : HasDerivAt H2 (deriv H2 0) 0) (hH2_pos : 0 < deriv H2 0) :
    ∀ z ∈ S, z ≠ (0, 0) → 0 < z.1 ∧ z.1 * Real.cos θ < z.2 := by
  intro z hz hne
  have hzfeasible := hfeasible z hz
  rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hzfeasible
  have hz1_nonneg : 0 ≤ z.1 := hzfeasible.1
  have hz2_nonneg : 0 ≤ z.2 := by simpa [hcos] using hzfeasible.2
  have hz1_pos : 0 < z.1 := by
    apply lt_of_le_of_ne hz1_nonneg
    intro hzero1
    have hz1_zero : z.1 = 0 := hzero1.symm
    have hz2_pos : 0 < z.2 := by
      apply lt_of_le_of_ne hz2_nonneg
      intro hzero2
      have hz2_zero : z.2 = 0 := hzero2.symm
      apply hne
      exact Prod.ext hz1_zero hz2_zero
    have hz_eq_left : z = (0, z.2) := Prod.ext hz1_zero rfl
    have hmax_left : IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) (0, z.2) := by
      rw [← hz_eq_left]
      exact hmax z hz
    have hderiv_zero : deriv H1 0 = 0 :=
      deriv_firstReward_eq_zero_of_isMaxOn_of_leftBoundary_of_orthogonal
        hmax_left hsin hcos hz2_pos hH1 hH1_pos.le
    exact hH1_pos.ne' hderiv_zero
  have hz2_pos : 0 < z.2 := by
    apply lt_of_le_of_ne hz2_nonneg
    intro hzero2
    have hz2_zero : z.2 = 0 := hzero2.symm
    have hz_eq_lower : z = (z.1, z.1 * Real.cos θ) := by
      exact Prod.ext rfl (by
        calc
          z.2 = 0 := hz2_zero
          _ = z.1 * Real.cos θ := by rw [hcos]; ring)
    have hmax_lower : IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) (z.1, z.1 * Real.cos θ) := by
      rw [← hz_eq_lower]
      exact hmax z hz
    have hH2_lower : HasDerivAt H2
        (deriv H2 (z.1 * Real.cos θ)) (z.1 * Real.cos θ) := by
      simpa [hcos] using hH2
    have hH2_lower_nonneg : 0 ≤ deriv H2 (z.1 * Real.cos θ) := by
      simpa [hcos] using hH2_pos.le
    have hderiv_zero_lower : deriv H2 (z.1 * Real.cos θ) = 0 :=
      deriv_secondReward_eq_zero_of_isMaxOn_of_lowerBoundary
        hmax_lower hsin hz1_pos hH2_lower hH2_lower_nonneg
    have hderiv_zero : deriv H2 0 = 0 := by
      simpa [hcos] using hderiv_zero_lower
    exact hH2_pos.ne' hderiv_zero
  exact ⟨hz1_pos, by simpa [hcos] using hz2_pos⟩

/--
The source's closed upper user-cone restriction follows directly from C1 when
both reward functions are monotone.  A value strictly above the second-user
ray is dominated by its projection onto that ray: the second score is kept,
the first score increases, and the Euclidean induced cost strictly decreases.
-/
theorem canonicalTwoUser_secondUserSlope_le_of_isMaxOn_of_mono_rewards
    {α β θ z1 z2 : ℝ} {H1 H2 : ℝ → ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θ) (z1, z2))
    (hzfeasible : (z1, z2) ∈ canonicalTwoUserFeasibleValueSet θ)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hcos : 0 ≤ Real.cos θ) (hH1 : Monotone H1) :
    Real.cos θ * z2 ≤ z1 := by
  by_contra hnot
  have habove : z1 < Real.cos θ * z2 := lt_of_not_ge hnot
  have hz : 0 ≤ z1 ∧ z1 * Real.cos θ ≤ z2 :=
    (mem_canonicalTwoUserFeasibleValueSet_iff hsin).mp hzfeasible
  have hz2_nonneg : 0 ≤ z2 := by
    exact le_trans (mul_nonneg hz.1 hcos) hz.2
  have htrig : Real.sin θ ^ 2 + Real.cos θ ^ 2 = 1 :=
    Real.sin_sq_add_cos_sq θ
  have hcos_sq_le : (Real.cos θ) ^ 2 ≤ 1 := by
    nlinarith [sq_nonneg (Real.sin θ)]
  have hq_feasible : (Real.cos θ * z2, z2) ∈ canonicalTwoUserFeasibleValueSet θ := by
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
    constructor
    · exact mul_nonneg hcos hz2_nonneg
    · calc
        (Real.cos θ * z2) * Real.cos θ = (Real.cos θ) ^ 2 * z2 := by ring
        _ ≤ 1 * z2 := mul_le_mul_of_nonneg_right hcos_sq_le hz2_nonneg
        _ = z2 := by ring
  have hdiff_ne : z1 - Real.cos θ * z2 ≠ 0 :=
    sub_ne_zero.mpr (ne_of_lt habove)
  have hdiff_sq_pos : 0 < (z1 - Real.cos θ * z2) ^ 2 :=
    sq_pos_of_ne_zero hdiff_ne
  have hnum_lt :
      twoUserInducedCostNumerator θ (Real.cos θ * z2) z2 <
        twoUserInducedCostNumerator θ z1 z2 := by
    unfold twoUserInducedCostNumerator
    nlinarith
  have hpow_lt :
      (twoUserInducedCostNumerator θ (Real.cos θ * z2) z2) ^ (β / 2) <
        (twoUserInducedCostNumerator θ z1 z2) ^ (β / 2) :=
    Real.rpow_lt_rpow
      (twoUserInducedCostNumerator_nonneg θ (Real.cos θ * z2) z2)
      hnum_lt (by linarith)
  have hsinpow_pos : 0 < (Real.sin θ) ^ (-β) :=
    Real.rpow_pos_of_pos hsin _
  have hcost_lt :
      twoUserInducedCost α β θ (Real.cos θ * z2) z2 <
        twoUserInducedCost α β θ z1 z2 := by
    unfold twoUserInducedCost
    exact mul_lt_mul_of_pos_left hpow_lt (mul_pos hα hsinpow_pos)
  have hreward_le : H1 z1 ≤ H1 (Real.cos θ * z2) := hH1 habove.le
  have hobjective_lt :
      H1 z1 + H2 z2 - twoUserInducedCost α β θ z1 z2 <
        H1 (Real.cos θ * z2) + H2 z2 -
          twoUserInducedCost α β θ (Real.cos θ * z2) z2 := by
    linarith
  exact (not_lt_of_ge (hmax hq_feasible)) hobjective_lt

/--
Strict canonical cone interior from C1 under the precise non-flat boundary
condition required by the one-sided FOCs.  In an acute cone, C1 and reward
monotonicity already exclude zero first score by a cost-decreasing projection.
At the orthogonal endpoint, positive first reward derivative at zero replaces
that projection.  In either case, positive second reward derivative on the
lower user ray excludes the remaining boundary.
-/
theorem canonicalTwoUser_strictInterior_of_isMaxOn_of_positiveLowerBoundaryRewardDeriv
    {α β θ : ℝ} {H1 H2 : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hmax : ∀ z ∈ S,
      IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (hfeasible : ∀ z ∈ S, z ∈ canonicalTwoUserFeasibleValueSet θ)
    (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ) (hH1_mono : Monotone H1)
    (horthogonal_first : Real.cos θ = 0 →
      HasDerivAt H1 (deriv H1 0) 0 ∧ 0 < deriv H1 0)
    (hlower_second : ∀ z ∈ S, z ≠ (0, 0) → z.2 = z.1 * Real.cos θ →
      HasDerivAt H2 (deriv H2 z.2) z.2 ∧ 0 < deriv H2 z.2) :
    ∀ z ∈ S, z ≠ (0, 0) → 0 < z.1 ∧ z.1 * Real.cos θ < z.2 := by
  intro z hz hne
  have hzfeasible := hfeasible z hz
  rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hzfeasible
  have hz1_nonneg : 0 ≤ z.1 := hzfeasible.1
  have hz2_nonneg : 0 ≤ z.2 :=
    le_trans (mul_nonneg hz1_nonneg hcos) hzfeasible.2
  have hzcone : Real.cos θ * z.2 ≤ z.1 :=
    canonicalTwoUser_secondUserSlope_le_of_isMaxOn_of_mono_rewards
      (hmax z hz) (hfeasible z hz) hα hβ hsin hcos hH1_mono
  have hz1_pos : 0 < z.1 := by
    apply lt_of_le_of_ne hz1_nonneg
    intro hzero1
    have hz1_zero : z.1 = 0 := hzero1.symm
    by_cases horthogonal : Real.cos θ = 0
    · obtain ⟨hderiv1, hderiv1_pos⟩ := horthogonal_first horthogonal
      have hz2_pos : 0 < z.2 := by
        apply lt_of_le_of_ne hz2_nonneg
        intro hzero2
        have hz2_zero : z.2 = 0 := hzero2.symm
        apply hne
        exact Prod.ext hz1_zero hz2_zero
      have hz_eq_left : z = (0, z.2) := Prod.ext hz1_zero rfl
      have hmax_left : IsMaxOn
          (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
          (canonicalTwoUserFeasibleValueSet θ) (0, z.2) := by
        rw [← hz_eq_left]
        exact hmax z hz
      have hderiv_zero : deriv H1 0 = 0 :=
        deriv_firstReward_eq_zero_of_isMaxOn_of_leftBoundary_of_orthogonal
          hmax_left hsin horthogonal hz2_pos
          hderiv1 hderiv1_pos.le
      exact hderiv1_pos.ne' hderiv_zero
    · have hzero_ne : 0 ≠ Real.cos θ := by
        intro hzero
        exact horthogonal hzero.symm
      have hcos_pos : 0 < Real.cos θ := lt_of_le_of_ne hcos hzero_ne
      have hprod : Real.cos θ * z.2 ≤ 0 := by simpa [hz1_zero] using hzcone
      have hz2_zero : z.2 = 0 := by
        nlinarith [mul_nonneg hcos hz2_nonneg]
      apply hne
      ext <;> simp [hz1_zero, hz2_zero]
  have hzslack : z.1 * Real.cos θ < z.2 := by
    apply lt_of_le_of_ne hzfeasible.2
    intro hboundary
    obtain ⟨hderiv2, hderiv2_pos⟩ := hlower_second z hz hne hboundary.symm
    have hz_eq_lower : z = (z.1, z.1 * Real.cos θ) :=
      Prod.ext rfl hboundary.symm
    have hmax_lower : IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) (z.1, z.1 * Real.cos θ) := by
      rw [← hz_eq_lower]
      exact hmax z hz
    have hderiv2_lower : HasDerivAt H2
        (deriv H2 (z.1 * Real.cos θ)) (z.1 * Real.cos θ) := by
      rw [hboundary]
      exact hderiv2
    have hderiv2_lower_nonneg : 0 ≤ deriv H2 (z.1 * Real.cos θ) := by
      rw [hboundary]
      exact hderiv2_pos.le
    have hderiv_zero : deriv H2 (z.1 * Real.cos θ) = 0 :=
      deriv_secondReward_eq_zero_of_isMaxOn_of_lowerBoundary
        hmax_lower hsin hz1_pos hderiv2_lower hderiv2_lower_nonneg
    apply hderiv2_pos.ne'
    simpa [hboundary] using hderiv_zero
  exact ⟨hz1_pos, hzslack⟩

/--
Corrected source-facing two-user uniqueness composition.  A continuous graph
over `Icc 0 B` whose represented values satisfy C1's strict-interior FOCs and
C2's local CDF transport solves the graph ODE pointwise away from zero.  The
origin support point and cone geometry then force the graph to be diagonal.
The graph/CDF differentiability hypotheses are explicit: they are not
obtained from the source's a.e. density statement.
-/
theorem twoUser_graph_eq_idOn_of_valueSupport_graph_of_C1C2
    {α β θ B : ℝ} {μ : Measure (Content 2)} {H1 H2 g g' : ℝ → ℝ}
    (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ) (hB : 0 ≤ B)
    (hgraph_mem : ∀ w ∈ Set.Icc 0 B,
      (w, g w) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hcont : ContinuousOn g (Set.Icc 0 B))
    (hfeasible : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ∈ canonicalTwoUserFeasibleValueSet θ)
    (hmax : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (hinterior : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → 0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hderiv1 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → HasDerivAt H1 (deriv H1 z.1) z.1)
    (hderiv2 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → HasDerivAt H2 (deriv H2 z.2) z.2)
    (hgraph_deriv : ∀ w ∈ Set.Ioo 0 B, HasDerivAt g (g' w) w)
    (htransport : ∀ w ∈ Set.Icc 0 B, H2 (g w) = H1 w) :
    ∀ w ∈ Set.Icc 0 B, g w = w := by
  apply twoUser_graph_eq_idOn_of_origin_of_strictCone_ode hcos
  · by_contra hg_zero
    have hmem := hgraph_mem 0 ⟨le_rfl, hB⟩
    have hpair_ne : ((0 : ℝ), g 0) ≠ (0, 0) := by
      intro hpair
      exact hg_zero (congrArg Prod.snd hpair)
    have hpos := (hinterior (0, g 0) hmem hpair_ne).1
    norm_num at hpos
  · exact hcont
  · intro w hw
    have hmem := hgraph_mem w hw
    have hw_feasible := hfeasible (w, g w) hmem
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hw_feasible
    exact le_trans (mul_nonneg hw.1 hcos) hw_feasible.2
  · intro w hw
    have hmem := hgraph_mem w ⟨hw.1.le, hw.2.le⟩
    have hpair_ne : (w, g w) ≠ (0, 0) := by
      intro hpair
      have hw_zero : w = 0 := by simpa using congrArg Prod.fst hpair
      exact hw.1.ne' hw_zero
    exact (hinterior (w, g w) hmem hpair_ne).2
  · exact hgraph_deriv
  · intro w hw
    have hmem := hgraph_mem w ⟨hw.1.le, hw.2.le⟩
    have hpair_ne : (w, g w) ≠ (0, 0) := by
      intro hpair
      have hw_zero : w = 0 := by simpa using congrArg Prod.fst hpair
      exact hw.1.ne' hw_zero
    let scale : ℝ := β * α * (Real.sin θ) ^ (-β) *
      (twoUserInducedCostNumerator θ w (g w)) ^ (β / 2 - 1)
    have hscale : scale ≠ 0 := by
      dsimp [scale]
      apply twoUserInducedCostFirstPartial_scale_ne_zero_of_pair_ne_zero hα hβ hsin
      exact Or.inl hw.1.ne'
    have hfirst : deriv H1 w = scale * (w - g w * Real.cos θ) := by
      dsimp [scale]
      simpa using
        (twoUserInducedCostFirstPartial_eq_of_isMaxOn_of_feasibleInterior
          (hmax (w, g w) hmem) hsin (hinterior (w, g w) hmem hpair_ne).1
          (hinterior (w, g w) hmem hpair_ne).2
          (hderiv1 (w, g w) hmem hpair_ne) (by
            exact Or.inl
              (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne'
                (Or.inl hw.1.ne')))).symm
    have hsecond : deriv H2 (g w) = scale * (g w - w * Real.cos θ) := by
      dsimp [scale]
      simpa using
        (twoUserInducedCostSecondPartial_eq_of_isMaxOn_of_feasibleInterior
          (hmax (w, g w) hmem) hsin (hinterior (w, g w) hmem hpair_ne).1
          (hinterior (w, g w) hmem hpair_ne).2
          (hderiv2 (w, g w) hmem hpair_ne) (by
            exact Or.inl
              (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne'
                (Or.inl hw.1.ne')))).symm
    have hlocal_transport : H1 =ᶠ[𝓝 w] fun x => H2 (g x) :=
      Filter.eventuallyEq_of_mem (Icc_mem_nhds hw.1 hw.2)
        (fun x hx => (htransport x hx).symm)
    exact twoUser_graphOde_of_eventuallyEq_cdfComposition_and_firstPartialForms
      (hderiv1 (w, g w) hmem hpair_ne)
      (hderiv2 (w, g w) hmem hpair_ne)
      (hgraph_deriv w hw) hlocal_transport hscale hfirst hsecond

/--
The graph differentiability step that is implicit in Proposition `uniqueness`.
At a positive represented support point, C1 makes the derivative of the second
marginal reward nonzero.  C2 locally identifies `H2 ∘ g` with `H1`, so the
converse chain rule (equivalently, the one-dimensional implicit-function
theorem) differentiates the continuous support graph.  No derivative of `g`
is assumed.
-/
theorem twoUser_graph_hasDerivAt_of_valueSupport_C1C2_contDiffAt
    {α β θ B : ℝ} {μ : Measure (Content 2)} {H1 H2 g : ℝ → ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hgraph_mem : ∀ w ∈ Set.Icc 0 B,
      (w, g w) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hcont : ContinuousOn g (Set.Icc 0 B))
    (hmax : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (hinterior : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → 0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hcontDiff1 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → ContDiffAt ℝ 1 H1 z.1)
    (hcontDiff2 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → ContDiffAt ℝ 1 H2 z.2)
    (htransport : ∀ w ∈ Set.Icc 0 B, H2 (g w) = H1 w) :
    ∀ w ∈ Set.Ioo 0 B,
      HasDerivAt g ((deriv H2 (g w))⁻¹ * deriv H1 w) w := by
  intro w hw
  have hwI : w ∈ Set.Icc 0 B := ⟨hw.1.le, hw.2.le⟩
  have hmem := hgraph_mem w hwI
  have hpair_ne : (w, g w) ≠ (0, 0) := by
    intro hpair
    have hw_zero : w = 0 := by simpa using congrArg Prod.fst hpair
    exact hw.1.ne' hw_zero
  have hH1 : HasDerivAt H1 (deriv H1 w) w :=
    ((hcontDiff1 (w, g w) hmem hpair_ne).differentiableAt one_ne_zero).hasDerivAt
  have hH2 : HasDerivAt H2 (deriv H2 (g w)) (g w) :=
    ((hcontDiff2 (w, g w) hmem hpair_ne).differentiableAt one_ne_zero).hasDerivAt
  let scale : ℝ := β * α * (Real.sin θ) ^ (-β) *
    (twoUserInducedCostNumerator θ w (g w)) ^ (β / 2 - 1)
  have hscale : scale ≠ 0 := by
    dsimp [scale]
    exact twoUserInducedCostFirstPartial_scale_ne_zero_of_pair_ne_zero
      hα hβ hsin (Or.inl hw.1.ne')
  have hgap_ne : g w - w * Real.cos θ ≠ 0 := by
    have hgap := (hinterior (w, g w) hmem hpair_ne).2
    linarith
  have hsecond : deriv H2 (g w) = scale * (g w - w * Real.cos θ) := by
    dsimp [scale]
    simpa using
      (twoUserInducedCostSecondPartial_eq_of_isMaxOn_of_feasibleInterior
        (hmax (w, g w) hmem) hsin
        (hinterior (w, g w) hmem hpair_ne).1
        (hinterior (w, g w) hmem hpair_ne).2 hH2
        (Or.inl (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero
          hsin.ne' (Or.inl hw.1.ne')))).symm
  have hH2_ne : deriv H2 (g w) ≠ 0 := by
    rw [hsecond]
    exact mul_ne_zero hscale hgap_ne
  have hg_cont : ContinuousAt g w :=
    hcont.continuousAt (Icc_mem_nhds hw.1 hw.2)
  have hlocal_transport : (fun x => H2 (g x)) =ᶠ[nhds w] H1 :=
    Filter.eventuallyEq_of_mem (Icc_mem_nhds hw.1 hw.2)
      (fun x hx => htransport x hx)
  exact
    AppliedModelingLib.RealAnalysis.hasDerivAt_inner_of_contDiffAt_outer_of_eventuallyEq_comp
      hH1 hH2 (hcontDiff2 (w, g w) hmem hpair_ne) hH2_ne hg_cont
      hlocal_transport

/--
Completed C1/C2 uniqueness composition at the regularity level used by the
source.  Continuous differentiability of the two marginal reward functions
at every non-origin represented support value now supplies the graph
derivative internally; the previously explicit `hgraph_deriv` boundary is
absent.  The global origin argument then forces the support graph to be the
diagonal.
-/
theorem twoUser_graph_eq_idOn_of_valueSupport_graph_of_C1C2_contDiffAt
    {α β θ B : ℝ} {μ : Measure (Content 2)} {H1 H2 g : ℝ → ℝ}
    (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ) (hB : 0 ≤ B)
    (hgraph_mem : ∀ w ∈ Set.Icc 0 B,
      (w, g w) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hcont : ContinuousOn g (Set.Icc 0 B))
    (hfeasible : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ∈ canonicalTwoUserFeasibleValueSet θ)
    (hmax : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      IsMaxOn
        (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 - twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (hinterior : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → 0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hcontDiff1 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → ContDiffAt ℝ 1 H1 z.1)
    (hcontDiff2 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ≠ (0, 0) → ContDiffAt ℝ 1 H2 z.2)
    (htransport : ∀ w ∈ Set.Icc 0 B, H2 (g w) = H1 w) :
    ∀ w ∈ Set.Icc 0 B, g w = w := by
  apply twoUser_graph_eq_idOn_of_valueSupport_graph_of_C1C2
    (g' := fun w => (deriv H2 (g w))⁻¹ * deriv H1 w)
    hα hβ hsin hcos hB hgraph_mem hcont hfeasible hmax hinterior
  · intro z hz hne
    exact ((hcontDiff1 z hz hne).differentiableAt one_ne_zero).hasDerivAt
  · intro z hz hne
    exact ((hcontDiff2 z hz hne).differentiableAt one_ne_zero).hasDerivAt
  · exact twoUser_graph_hasDerivAt_of_valueSupport_C1C2_contDiffAt
      hα hβ hsin hgraph_mem hcont hmax hinterior hcontDiff1 hcontDiff2 htransport
  · exact htransport

/--
The canonical nonnegative feasible cone is closed under coordinatewise meet.
This supplies one of the two C1 deviations needed to rule out a reversal in
the ordering of two support values.
-/
theorem canonicalTwoUserFeasibleValueSet_min_mem
    {θ : ℝ} {p q : ℝ × ℝ}
    (hcos : 0 ≤ Real.cos θ) (hsin : 0 < Real.sin θ)
    (hp : p ∈ canonicalTwoUserFeasibleValueSet θ)
    (hq : q ∈ canonicalTwoUserFeasibleValueSet θ) :
    (min p.1 q.1, min p.2 q.2) ∈ canonicalTwoUserFeasibleValueSet θ := by
  rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hp hq ⊢
  refine ⟨le_min hp.1 hq.1, ?_⟩
  apply le_min
  · calc
      min p.1 q.1 * Real.cos θ ≤ p.1 * Real.cos θ := by
        exact mul_le_mul_of_nonneg_right (min_le_left _ _) hcos
      _ ≤ p.2 := hp.2
  · calc
      min p.1 q.1 * Real.cos θ ≤ q.1 * Real.cos θ := by
        exact mul_le_mul_of_nonneg_right (min_le_right _ _) hcos
      _ ≤ q.2 := hq.2

/--
The canonical nonnegative feasible cone is closed under coordinatewise join.
Together with the meet lemma, this makes it a sublattice of the value plane
in the nonobtuse-angle regime of the source theorem.
-/
theorem canonicalTwoUserFeasibleValueSet_max_mem
    {θ : ℝ} {p q : ℝ × ℝ}
    (hcos : 0 ≤ Real.cos θ) (hsin : 0 < Real.sin θ)
    (hp : p ∈ canonicalTwoUserFeasibleValueSet θ)
    (hq : q ∈ canonicalTwoUserFeasibleValueSet θ) :
    (max p.1 q.1, max p.2 q.2) ∈ canonicalTwoUserFeasibleValueSet θ := by
  rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hp hq ⊢
  refine ⟨le_trans hp.1 (le_max_left _ _), ?_⟩
  rcases le_total p.1 q.1 with hpq | hqp
  · rw [max_eq_right hpq]
    exact le_trans hq.2 (le_max_right _ _)
  · rw [max_eq_left hqp]
    exact le_trans hp.2 (le_max_left _ _)

/-- The canonical nonnegative feasible cone is closed under nonnegative scaling. -/
theorem canonicalTwoUserFeasibleValueSet_scale_mem
    {θ t : ℝ} {z : ℝ × ℝ}
    (hsin : 0 < Real.sin θ) (ht : 0 ≤ t)
    (hz : z ∈ canonicalTwoUserFeasibleValueSet θ) :
    (t * z.1, t * z.2) ∈ canonicalTwoUserFeasibleValueSet θ := by
  rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hz ⊢
  refine ⟨mul_nonneg ht hz.1, ?_⟩
  have hscaled := mul_le_mul_of_nonneg_left hz.2 ht
  convert hscaled using 1 <;> ring

/--
Concrete C1 lower-endpoint bridge for the two-user finite-producer objective.
If both atomless raw-score marginals attain their lower support bounds at a
realized value, and are nonnegative at zero, their iid maximum-CDF rewards
vanish both there and at the feasible zero action.  C1 then forces that
realized lower endpoint to be the origin.
-/
theorem canonicalTwoUser_eq_zero_of_iidMaximumCdf_isMaxOn_of_marginal_lowerBounds
    {P : ℕ} {μ1 μ2 : Measure ℝ} [IsProbabilityMeasure μ1]
    [IsProbabilityMeasure μ2] [NoAtoms μ1] [NoAtoms μ2]
    {α β θ z1 z2 : ℝ}
    (hP : 1 < P)
    (hmax : IsMaxOn
      (fun z : ℝ × ℝ =>
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 z.1 +
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 z.2 -
            twoUserInducedCost α β θ z.1 z.2)
      (canonicalTwoUserFeasibleValueSet θ) (z1, z2))
    (hmin1 : ∀ x ∈ μ1.support, z1 ≤ x)
    (hmin2 : ∀ x ∈ μ2.support, z2 ≤ x)
    (hnonneg1 : ∀ x ∈ μ1.support, 0 ≤ x)
    (hnonneg2 : ∀ x ∈ μ2.support, 0 ≤ x)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ) :
    z1 = 0 ∧ z2 = 0 := by
  have hn : P - 1 ≠ 0 := Nat.sub_ne_zero_iff_lt.mpr hP
  have hzero1 : AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 0 = 0 :=
    AppliedModelingLib.Probability.iidMaximumCdf_eq_zero_of_forall_mem_support_le
      μ1 hn hnonneg1
  have hzero2 : AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 0 = 0 :=
    AppliedModelingLib.Probability.iidMaximumCdf_eq_zero_of_forall_mem_support_le
      μ2 hn hnonneg2
  have hz1 : AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 z1 = 0 :=
    AppliedModelingLib.Probability.iidMaximumCdf_eq_zero_of_forall_mem_support_le
      μ1 hn hmin1
  have hz2 : AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 z2 = 0 :=
    AppliedModelingLib.Probability.iidMaximumCdf_eq_zero_of_forall_mem_support_le
      μ2 hn hmin2
  apply canonicalTwoUser_eq_zero_of_isMaxOn_of_zero_marginal_rewards hmax
  · rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
    norm_num
  · exact twoUserInducedCost_zero hβ
  · exact ⟨hzero1, hzero2⟩
  · exact ⟨hz1, hz2⟩
  · exact hα
  · exact hβ
  · exact hsin

/--
Source-facing origin-support bridge for the canonical two-user C1/C2 route.
Compactness and a strictly ordered injective value support produce a joint
coordinatewise lower endpoint.  Atomless nonnegative raw-score marginals make
both iid rewards zero there and at the zero action, so C1 forces that endpoint
to be `(0,0)`.  The strict order and C1 premises are intentionally visible:
this theorem does not infer them from a.e. CDF regularity.
-/
theorem canonicalTwoUser_zero_mem_valueSupport_of_compact_strict_ordered_iidC1
    {P : ℕ} {θ : ℝ} {μ : Measure (Content 2)} [IsProbabilityMeasure μ]
    {α β : ℝ}
    (hP : 1 < P)
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hinj : (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.fst)
    (hstrict : ∀ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      ∀ q ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
        p.1 < q.1 → p.2 < q.2)
    (hmax : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      IsMaxOn
        (fun w : ℝ × ℝ =>
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) w.1 +
            AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 =>
                score (canonicalTwoUserSecond θ) q) μ) w.2 -
              twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hfeasible : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ∈ canonicalTwoUserFeasibleValueSet θ)
    (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ) :
    (0, 0) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support := by
  let ν : Measure (ℝ × ℝ) := Measure.map (canonicalTwoUserValueMap θ) μ
  let μ1 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ
  let μ2 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ
  have hmeas : Measurable (canonicalTwoUserValueMap θ) :=
    (canonicalTwoUserValueMap_continuous θ).measurable
  letI : IsProbabilityMeasure ν :=
    Measure.isProbabilityMeasure_map hmeas.aemeasurable
  letI : IsProbabilityMeasure μ1 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  letI : IsProbabilityMeasure μ2 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond θ)).aemeasurable
  have hmapfst : Measure.map Prod.fst ν = μ1 := by
    dsimp [ν, μ1]
    rw [Measure.map_map measurable_fst hmeas]
    rfl
  have hmapsnd : Measure.map Prod.snd ν = μ2 := by
    dsimp [ν, μ2]
    rw [Measure.map_map measurable_snd hmeas]
    rfl
  have hac1 : μ1 ≪ volume := by
    simpa [μ1] using hscore_ac (0 : Fin 2)
  have hac2 : μ2 ≪ volume := by
    simpa [μ2] using hscore_ac (1 : Fin 2)
  letI : NoAtoms μ1 := ⟨fun x => hac1 (by simpa using (volume_singleton x))⟩
  letI : NoAtoms μ2 := ⟨fun x => hac2 (by simpa using (volume_singleton x))⟩
  obtain ⟨z, hz, hmin⟩ :=
    AppliedModelingLib.Probability.exists_mem_support_forall_coords_le_of_isCompact_of_strict_order
      (ν := ν) (by simpa [ν] using hcompact) (by simpa [ν] using hinj)
      (by simpa [ν] using hstrict)
  have hsuppfst : (Measure.map Prod.fst ν).support = Prod.fst '' ν.support :=
    AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      (f := Prod.fst) (by simpa [ν] using hcompact) continuous_fst
  have hsuppsnd : (Measure.map Prod.snd ν).support = Prod.snd '' ν.support :=
    AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      (f := Prod.snd) (by simpa [ν] using hcompact) continuous_snd
  have hmin1 : ∀ x ∈ μ1.support, z.1 ≤ x := by
    intro x hx
    rw [← hmapfst, hsuppfst] at hx
    rcases hx with ⟨w, hw, rfl⟩
    exact (hmin w hw).1
  have hmin2 : ∀ x ∈ μ2.support, z.2 ≤ x := by
    intro x hx
    rw [← hmapsnd, hsuppsnd] at hx
    rcases hx with ⟨w, hw, rfl⟩
    exact (hmin w hw).2
  have hnonneg1 : ∀ x ∈ μ1.support, 0 ≤ x := by
    intro x hx
    rw [← hmapfst, hsuppfst] at hx
    rcases hx with ⟨w, hw, rfl⟩
    have hwfeasible := hfeasible w (by simpa [ν] using hw)
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hwfeasible
    exact hwfeasible.1
  have hnonneg2 : ∀ x ∈ μ2.support, 0 ≤ x := by
    intro x hx
    rw [← hmapsnd, hsuppsnd] at hx
    rcases hx with ⟨w, hw, rfl⟩
    have hwfeasible := hfeasible w (by simpa [ν] using hw)
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hwfeasible
    exact le_trans (mul_nonneg hwfeasible.1 hcos) hwfeasible.2
  have hmaxz : IsMaxOn
      (fun w : ℝ × ℝ =>
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 w.1 +
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 w.2 -
            twoUserInducedCost α β θ w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θ) z := by
    simpa [μ1, μ2] using hmax z (by simpa [ν] using hz)
  have hzero : z.1 = 0 ∧ z.2 = 0 :=
    canonicalTwoUser_eq_zero_of_iidMaximumCdf_isMaxOn_of_marginal_lowerBounds
      (μ1 := μ1) (μ2 := μ2) hP hmaxz hmin1 hmin2 hnonneg1 hnonneg2 hα hβ hsin
  have hz_eq : z = (0, 0) := Prod.ext hzero.1 hzero.2
  simpa [ν, hz_eq] using hz

/--
Boundary-safe origin-support bridge.  Weak coordinate order is enough: the
compact joint support has a coordinatewise least point even if a marginal
projection jumps.  Atomlessness makes both marginal rewards vanish at that
point, and C1 comparison with the feasible zero action forces the point itself
to be the origin.
-/
theorem canonicalTwoUser_zero_mem_valueSupport_of_compact_ordered_iidC1
    {P : ℕ} {θ : ℝ} {μ : Measure (Content 2)} [IsProbabilityMeasure μ]
    {α β : ℝ}
    (hP : 1 < P)
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hordered : ∀ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      ∀ q ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
        p.1 < q.1 → p.2 ≤ q.2)
    (hmax : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      IsMaxOn
        (fun w : ℝ × ℝ =>
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) w.1 +
            AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 =>
                score (canonicalTwoUserSecond θ) q) μ) w.2 -
              twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hfeasible : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ∈ canonicalTwoUserFeasibleValueSet θ)
    (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ) :
    (0, 0) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support := by
  let ν : Measure (ℝ × ℝ) := Measure.map (canonicalTwoUserValueMap θ) μ
  let μ1 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ
  let μ2 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ
  have hmeas : Measurable (canonicalTwoUserValueMap θ) :=
    (canonicalTwoUserValueMap_continuous θ).measurable
  letI : IsProbabilityMeasure ν :=
    Measure.isProbabilityMeasure_map hmeas.aemeasurable
  letI : IsProbabilityMeasure μ1 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  letI : IsProbabilityMeasure μ2 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond θ)).aemeasurable
  have hmapfst : Measure.map Prod.fst ν = μ1 := by
    dsimp [ν, μ1]
    rw [Measure.map_map measurable_fst hmeas]
    rfl
  have hmapsnd : Measure.map Prod.snd ν = μ2 := by
    dsimp [ν, μ2]
    rw [Measure.map_map measurable_snd hmeas]
    rfl
  have hac1 : μ1 ≪ volume := by
    simpa [μ1] using hscore_ac (0 : Fin 2)
  have hac2 : μ2 ≪ volume := by
    simpa [μ2] using hscore_ac (1 : Fin 2)
  letI : NoAtoms μ1 := ⟨fun x => hac1 (by simpa using (volume_singleton x))⟩
  letI : NoAtoms μ2 := ⟨fun x => hac2 (by simpa using (volume_singleton x))⟩
  obtain ⟨z, hz, hmin⟩ :=
    AppliedModelingLib.Probability.exists_mem_support_forall_coords_le_of_isCompact_of_ordered
      (ν := ν) (by simpa [ν] using hcompact) (by simpa [ν] using hordered)
  have hsuppfst : (Measure.map Prod.fst ν).support = Prod.fst '' ν.support :=
    AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      (f := Prod.fst) (by simpa [ν] using hcompact) continuous_fst
  have hsuppsnd : (Measure.map Prod.snd ν).support = Prod.snd '' ν.support :=
    AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      (f := Prod.snd) (by simpa [ν] using hcompact) continuous_snd
  have hmin1 : ∀ x ∈ μ1.support, z.1 ≤ x := by
    intro x hx
    rw [← hmapfst, hsuppfst] at hx
    rcases hx with ⟨w, hw, rfl⟩
    exact (hmin w hw).1
  have hmin2 : ∀ x ∈ μ2.support, z.2 ≤ x := by
    intro x hx
    rw [← hmapsnd, hsuppsnd] at hx
    rcases hx with ⟨w, hw, rfl⟩
    exact (hmin w hw).2
  have hnonneg1 : ∀ x ∈ μ1.support, 0 ≤ x := by
    intro x hx
    rw [← hmapfst, hsuppfst] at hx
    rcases hx with ⟨w, hw, rfl⟩
    have hwfeasible := hfeasible w (by simpa [ν] using hw)
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hwfeasible
    exact hwfeasible.1
  have hnonneg2 : ∀ x ∈ μ2.support, 0 ≤ x := by
    intro x hx
    rw [← hmapsnd, hsuppsnd] at hx
    rcases hx with ⟨w, hw, rfl⟩
    have hwfeasible := hfeasible w (by simpa [ν] using hw)
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hwfeasible
    exact le_trans (mul_nonneg hwfeasible.1 hcos) hwfeasible.2
  have hmaxz : IsMaxOn
      (fun w : ℝ × ℝ =>
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 w.1 +
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 w.2 -
            twoUserInducedCost α β θ w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θ) z := by
    simpa [μ1, μ2] using hmax z (by simpa [ν] using hz)
  have hzero : z.1 = 0 ∧ z.2 = 0 :=
    canonicalTwoUser_eq_zero_of_iidMaximumCdf_isMaxOn_of_marginal_lowerBounds
      (μ1 := μ1) (μ2 := μ2) hP hmaxz hmin1 hmin2 hnonneg1 hnonneg2 hα hβ hsin
  have hz_eq : z = (0, 0) := Prod.ext hzero.1 hzero.2
  simpa [ν, hz_eq] using hz

/--
The source no-gap scaling deviation is automatically feasible in the actual
canonical cone.  Hence equal marginal rewards across the two proposed gaps
contradict C1 as soon as the value pair is nonzero and the induced cost has
positive homogeneous parameters.
-/
theorem canonicalTwoUser_not_isMaxOn_of_strictScale_same_marginals
    {H1 H2 : ℝ → ℝ} {α β θ z1 z2 t : ℝ}
    (hmax : IsMaxOn
      (fun z : ℝ × ℝ => H1 z.1 + H2 z.2 -
        twoUserInducedCost α β θ z.1 z.2)
      (canonicalTwoUserFeasibleValueSet θ) (z1, z2))
    (hz : (z1, z2) ∈ canonicalTwoUserFeasibleValueSet θ)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (ht : 0 < t) (ht_one : t < 1)
    (hpair : z1 ≠ 0 ∨ z2 ≠ 0)
    (hH1 : H1 (t * z1) = H1 z1)
    (hH2 : H2 (t * z2) = H2 z2) :
    False := by
  apply twoUser_not_isMaxOn_of_strictScale_same_marginals hmax
  · exact canonicalTwoUserFeasibleValueSet_scale_mem hsin ht.le hz
  · exact hH1
  · exact hH2
  · exact twoUserInducedCost_strictScale_lt hα hβ hsin ht ht_one hpair

/--
The fully measure-aware local no-gap contradiction for the source C1
objective.  If a support value `(b,d)` has two atomless marginal support gaps
immediately below its coordinates and one common scale enters both gaps, the
iid-maximum rewards are unchanged while the homogeneous cost falls.  The
remaining global source obligation is to produce those *aligned* gaps from a
gap in one projection of the joint support.
-/
theorem canonicalTwoUser_not_isMaxOn_iidMaximumCdf_of_two_marginal_open_gaps
    {P : ℕ} {μ1 μ2 : Measure ℝ} [IsProbabilityMeasure μ1]
    [IsProbabilityMeasure μ2] [NoAtoms μ1] [NoAtoms μ2]
    {α β θ a b c d t : ℝ}
    (hmax : IsMaxOn
      (fun z : ℝ × ℝ =>
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 z.1 +
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 z.2 -
            twoUserInducedCost α β θ z.1 z.2)
      (canonicalTwoUserFeasibleValueSet θ) (b, d))
    (hbd : (b, d) ∈ canonicalTwoUserFeasibleValueSet θ)
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (ht : 0 < t) (ht_one : t < 1)
    (hpair : b ≠ 0 ∨ d ≠ 0)
    (hgap1 : Set.Ioo a b ⊆ μ1.supportᶜ)
    (hgap2 : Set.Ioo c d ⊆ μ2.supportᶜ)
    (htb : t * b ∈ Set.Ioo a b)
    (htd : t * d ∈ Set.Ioo c d) :
    False := by
  apply canonicalTwoUser_not_isMaxOn_of_strictScale_same_marginals
    hmax hbd hα hβ hsin ht ht_one hpair
  · apply AppliedModelingLib.Probability.iidMaximumCdf_eq_of_Ioo_subset_compl_support_of_noAtoms
      μ1 htb.2.le
    intro x hx
    exact hgap1 ⟨lt_trans htb.1 hx.1, hx.2⟩
  · apply AppliedModelingLib.Probability.iidMaximumCdf_eq_of_Ioo_subset_compl_support_of_noAtoms
      μ2 htd.2.le
    intro x hx
    exact hgap2 ⟨lt_trans htd.1 hx.1, hx.2⟩

/--
Global support ordering from C1 in canonical two-user coordinates.  Strictly
negative cost cross-partials make the C1 objective strictly supermodular, and
the canonical feasible cone is a sublattice.  Thus support points cannot have
oppositely ordered user values.  This avoids assuming the global monotonicity
that the source's no-gap paragraph needs.
-/
theorem canonicalTwoUser_ordered_snd_of_isMaxOn_of_crossPartial_neg
    {α β θ : ℝ} {H1 H2 : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hSfeasible : S ⊆ canonicalTwoUserFeasibleValueSet θ)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0) :
    ∀ p ∈ S, ∀ q ∈ S, p.1 < q.1 → p.2 ≤ q.2 := by
  apply ordered_snd_of_isMaxOn_and_strictSubmodular hmax
  · intro p q hp hq hpq hqp
    have hp_feasible := hSfeasible hp
    have hq_feasible := hSfeasible hq
    refine ⟨?_, ?_⟩
    · have hmin := canonicalTwoUserFeasibleValueSet_min_mem hcos hsin
        hp_feasible hq_feasible
      simpa [min_eq_left hpq.le, min_eq_right hqp.le] using hmin
    · have hmax := canonicalTwoUserFeasibleValueSet_max_mem hcos hsin
        hp_feasible hq_feasible
      simpa [max_eq_right hpq.le, max_eq_left hqp.le] using hmax
  · intro x1 x2 y1 y2 hx hy
    exact twoUserInducedCost_strictSubmodular_of_crossPartial_neg_on_rectangle
      hx hy
      (fun x y _ _ => hbase x y)
      (fun x y _ _ => hcross x y)

/--
Boundary-safe global support ordering using the strict cross-partial only on
the positive score cone.  If either compared support point is the origin, the
order follows directly from feasibility/positivity.  Otherwise the rectangle
used by the strict-submodularity argument is bounded away from both axes, so
the real-power derivative base is automatically nonzero.
-/
theorem canonicalTwoUser_ordered_snd_of_isMaxOn_of_crossPartial_neg_pos_awayOrigin
    {α β θ : ℝ} {H1 H2 : ℝ → ℝ} {S : Set (ℝ × ℝ)}
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hSfeasible : S ⊆ canonicalTwoUserFeasibleValueSet θ)
    (hmax : ∀ z : ℝ × ℝ, z ∈ S →
      IsMaxOn (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z)
    (hpositive : ∀ z : ℝ × ℝ, z ∈ S → z ≠ (0, 0) →
      0 < z.1 ∧ 0 < z.2)
    (hcross : ∀ z1 z2 : ℝ, 0 < z1 → 0 < z2 →
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0) :
    ∀ p ∈ S, ∀ q ∈ S, p.1 < q.1 → p.2 ≤ q.2 := by
  intro p hp q hq hpq
  by_contra hnot
  have hqp : q.2 < p.2 := lt_of_not_ge hnot
  by_cases hpzero : p = (0, 0)
  · have hqne : q ≠ (0, 0) := by
      intro hqzero
      rw [hpzero, hqzero] at hpq
      simp at hpq
    have hqpos := hpositive q hq hqne
    rw [hpzero] at hqp
    simp at hqp
    linarith
  by_cases hqzero : q = (0, 0)
  · have hpfeasible := hSfeasible hp
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hpfeasible
    rw [hqzero] at hpq
    simp at hpq
    linarith
  have hppos := hpositive p hp hpzero
  have hqpos := hpositive q hq hqzero
  have hp_feasible := hSfeasible hp
  have hq_feasible := hSfeasible hq
  have hmeet : (p.1, q.2) ∈ canonicalTwoUserFeasibleValueSet θ := by
    have hmin := canonicalTwoUserFeasibleValueSet_min_mem hcos hsin
      hp_feasible hq_feasible
    simpa [min_eq_left hpq.le, min_eq_right hqp.le] using hmin
  have hjoin : (q.1, p.2) ∈ canonicalTwoUserFeasibleValueSet θ := by
    have hmaxmem := canonicalTwoUserFeasibleValueSet_max_mem hcos hsin
      hp_feasible hq_feasible
    simpa [max_eq_right hpq.le, max_eq_left hqp.le] using hmaxmem
  have hmeet_le := hmax p hp hmeet
  have hjoin_le := hmax q hq hjoin
  change H1 p.1 + H2 q.2 - twoUserInducedCost α β θ p.1 q.2 ≤
    H1 p.1 + H2 p.2 - twoUserInducedCost α β θ p.1 p.2 at hmeet_le
  change H1 q.1 + H2 p.2 - twoUserInducedCost α β θ q.1 p.2 ≤
    H1 q.1 + H2 q.2 - twoUserInducedCost α β θ q.1 q.2 at hjoin_le
  have hle := add_le_add hmeet_le hjoin_le
  have hcost := twoUserInducedCost_strictSubmodular_of_crossPartial_neg_on_rectangle
    hpq hqp
    (fun x y hx hy => Or.inl
      (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne'
        (Or.inl (lt_of_lt_of_le hppos.1 hx.1).ne')))
    (fun x y hx hy => hcross x y
      (lt_trans hppos.1 hx.1) (lt_trans hqpos.2 hy.1))
  have hlt :
      (H1 p.1 + H2 p.2 - twoUserInducedCost α β θ p.1 p.2) +
          (H1 q.1 + H2 q.2 - twoUserInducedCost α β θ q.1 q.2) <
        (H1 p.1 + H2 q.2 - twoUserInducedCost α β θ p.1 q.2) +
          (H1 q.1 + H2 p.2 - twoUserInducedCost α β θ q.1 p.2) := by
    linarith
  exact (not_lt_of_ge hle) hlt

private theorem canonicalTwoUserFeasibleValueSet_isClosed (θ : ℝ) :
    IsClosed (canonicalTwoUserFeasibleValueSet θ) := by
  change IsClosed ((fun z : ℝ × ℝ =>
    canonicalTwoUserContentOfValues θ z.1 z.2) ⁻¹'
      {p : Content 2 | NonnegativeContent p})
  exact nonnegativeContent_content2_set_isClosed.preimage
    (canonicalTwoUserContentOfValues_continuous θ)

private theorem canonicalTwoUserFeasibleValueSet_eq_valueMap_image_nonnegative
    {θ : ℝ} (hsin : Real.sin θ ≠ 0) :
    canonicalTwoUserFeasibleValueSet θ =
      canonicalTwoUserValueMap θ '' {p : Content 2 | NonnegativeContent p} := by
  ext z
  constructor
  · intro hz
    refine ⟨canonicalTwoUserContentOfValues θ z.1 z.2, hz, ?_⟩
    exact canonicalTwoUserValueMap_contentOfValues hsin
  · rintro ⟨p, hp, rfl⟩
    change NonnegativeContent (canonicalTwoUserContentOfValues θ
      (canonicalTwoUserValueMap θ p).1
      (canonicalTwoUserValueMap θ p).2)
    rw [canonicalTwoUserContentOfValues_valueMap hsin p]
    exact hp

private theorem canonicalTwoUserValueMap_ae_mem_feasibleValueSet_of_ae_nonnegative
    {θ : ℝ} {μ : Measure (Content 2)} (hsin : Real.sin θ ≠ 0)
    (hae_nonnegative : ∀ᵐ p ∂μ, NonnegativeContent p) :
    ∀ᵐ p ∂μ, canonicalTwoUserValueMap θ p ∈
      canonicalTwoUserFeasibleValueSet θ := by
  filter_upwards [hae_nonnegative] with p hp
  change NonnegativeContent (canonicalTwoUserContentOfValues θ
    (canonicalTwoUserValueMap θ p).1
    (canonicalTwoUserValueMap θ p).2)
  rw [canonicalTwoUserContentOfValues_valueMap hsin p]
  exact hp

private theorem canonicalTwoUserValueMap_mem_support_of_mem_content_support
    {θ : ℝ} {μ : Measure (Content 2)} {p : Content 2}
    (hp : p ∈ μ.support) :
    canonicalTwoUserValueMap θ p ∈
      (Measure.map (canonicalTwoUserValueMap θ) μ).support := by
  rw [Measure.support_eq_forall_isOpen]
  intro U hpU hUopen
  rw [Measure.map_apply
    (canonicalTwoUserValueMap_continuous θ).measurable
    hUopen.measurableSet]
  apply (Measure.mem_support_iff_forall p).mp hp
  apply (canonicalTwoUserValueMap_continuous θ).continuousAt
  exact hUopen.mem_nhds hpU

/-- In nonsingular canonical coordinates, the inverse value map also carries
support of the realized-value pushforward back to support of the content law.
Together with the forward support map, this gives the actual C3 support
transport needed when deriving C1 from a symmetric Nash condition. -/
private theorem canonicalTwoUserContentOfValues_mem_support_of_mem_valueMap_support
    {θ : ℝ} {μ : Measure (Content 2)} {z : ℝ × ℝ}
    (hsin : Real.sin θ ≠ 0)
    (hz : z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support) :
    canonicalTwoUserContentOfValues θ z.1 z.2 ∈ μ.support := by
  rw [Measure.support_eq_forall_isOpen]
  intro U hpU hUopen
  let V : Set (ℝ × ℝ) :=
    (fun w : ℝ × ℝ => canonicalTwoUserContentOfValues θ w.1 w.2) ⁻¹' U
  have hVopen : IsOpen V := by
    exact hUopen.preimage (canonicalTwoUserContentOfValues_continuous θ)
  have hzV : z ∈ V := by
    exact hpU
  have hmapV : 0 < (Measure.map (canonicalTwoUserValueMap θ) μ) V := by
    rw [Measure.support_eq_forall_isOpen] at hz
    exact hz V hzV hVopen
  rw [Measure.map_apply (canonicalTwoUserValueMap_continuous θ).measurable
    hVopen.measurableSet] at hmapV
  apply lt_of_lt_of_le hmapV
  apply measure_mono
  intro p hp
  change canonicalTwoUserContentOfValues θ
      (canonicalTwoUserValueMap θ p).1 (canonicalTwoUserValueMap θ p).2 ∈ U at hp
  rwa [canonicalTwoUserContentOfValues_valueMap hsin p] at hp

private theorem canonicalTwoUserValueMap_exists_metricBall_subset_map_support_of_contentBall_subset_support
    {θ ε : ℝ} {μ : Measure (Content 2)} {p0 : Content 2}
    (hε : 0 < ε) (hsin : Real.sin θ ≠ 0)
    (hcontent_ball : Metric.ball p0 ε ⊆ μ.support) :
    ∃ δ : ℝ, 0 < δ ∧
      ∀ z : ℝ × ℝ, z ∈ Metric.ball
        (canonicalTwoUserValueMap θ p0) δ →
        z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support := by
  let U : Set (ℝ × ℝ) :=
    (fun z : ℝ × ℝ => canonicalTwoUserContentOfValues θ z.1 z.2) ⁻¹'
      Metric.ball p0 ε
  have hUopen : IsOpen U := by
    exact Metric.isOpen_ball.preimage
      (canonicalTwoUserContentOfValues_continuous θ)
  have hz0U : canonicalTwoUserValueMap θ p0 ∈ U := by
    change canonicalTwoUserContentOfValues θ
      (canonicalTwoUserValueMap θ p0).1
      (canonicalTwoUserValueMap θ p0).2 ∈ Metric.ball p0 ε
    rw [canonicalTwoUserContentOfValues_valueMap hsin p0]
    exact Metric.mem_ball_self hε
  rcases Metric.mem_nhds_iff.mp (hUopen.mem_nhds hz0U) with
      ⟨δ, hδ_pos, hδ_subset⟩
  refine ⟨δ, hδ_pos, ?_⟩
  intro z hz
  have hinverse_ball :
      canonicalTwoUserContentOfValues θ z.1 z.2 ∈ Metric.ball p0 ε := by
    simpa [U] using hδ_subset hz
  have hinverse_support :
      canonicalTwoUserContentOfValues θ z.1 z.2 ∈ μ.support :=
    hcontent_ball hinverse_ball
  have hmap := canonicalTwoUserValueMap_mem_support_of_mem_content_support
    (θ := θ) hinverse_support
  rw [canonicalTwoUserValueMap_contentOfValues hsin] at hmap
  exact hmap

private theorem mem_metricBall_of_l2Sq_lt
    {x y z1 z2 δ : ℝ} (hδ : 0 < δ)
    (h : (x - z1) ^ 2 + (y - z2) ^ 2 < (δ / 2) ^ 2) :
    (x, y) ∈ Metric.ball (z1, z2) δ := by
  rw [Metric.mem_ball]
  change max (dist x z1) (dist y z2) < δ
  rw [Real.dist_eq, Real.dist_eq]
  have hx_sq : (x - z1) ^ 2 < (δ / 2) ^ 2 := by
    nlinarith [sq_nonneg (y - z2)]
  have hy_sq : (y - z2) ^ 2 < (δ / 2) ^ 2 := by
    nlinarith [sq_nonneg (x - z1)]
  have hhalf_pos : 0 < δ / 2 := by linarith
  have hx_abs : |x - z1| < δ / 2 := by
    exact (sq_lt_sq₀ (abs_nonneg _) (le_of_lt hhalf_pos)).mp
      (by simpa [sq_abs] using hx_sq)
  have hy_abs : |y - z2| < δ / 2 := by
    exact (sq_lt_sq₀ (abs_nonneg _) (le_of_lt hhalf_pos)).mp
      (by simpa [sq_abs] using hy_sq)
  apply max_lt
  · linarith
  · linarith

private theorem contentMetricBall_subset_support_of_l2SqBall_subset_support
    {ε : ℝ} {μ : Measure (Content 2)} {p0 : Content 2}
    (hε : 0 < ε)
    (hcontent_ball : ∀ p : Content 2,
      (p 0 - p0 0) ^ 2 + (p 1 - p0 1) ^ 2 < ε ^ 2 →
      p ∈ μ.support) :
    Metric.ball p0 (ε / 2) ⊆ μ.support := by
  intro p hp
  rw [Metric.mem_ball] at hp
  rw [dist_pi_lt_iff (by linarith)] at hp
  have hhalf_pos : 0 < ε / 2 := by linarith
  have hzero_abs : |p 0 - p0 0| < ε / 2 := by
    simpa [Real.dist_eq] using hp 0
  have hone_abs : |p 1 - p0 1| < ε / 2 := by
    simpa [Real.dist_eq] using hp 1
  have hzero_sq : (p 0 - p0 0) ^ 2 < (ε / 2) ^ 2 := by
    have habs_sq : |p 0 - p0 0| ^ 2 < (ε / 2) ^ 2 :=
      (sq_lt_sq₀ (abs_nonneg _) (le_of_lt hhalf_pos)).mpr hzero_abs
    simpa [sq_abs] using habs_sq
  have hone_sq : (p 1 - p0 1) ^ 2 < (ε / 2) ^ 2 := by
    have habs_sq : |p 1 - p0 1| ^ 2 < (ε / 2) ^ 2 :=
      (sq_lt_sq₀ (abs_nonneg _) (le_of_lt hhalf_pos)).mpr hone_abs
    simpa [sq_abs] using habs_sq
  apply hcontent_ball p
  nlinarith

/--
Source support-geometry transport for Proposition `supportrestriction`. An
explicit l2 ball in the topological support of the content law yields a
positive-radius l2 ball in the topological support of its canonical realized-
value pushforward. This does not derive the content ball, C1, or equilibrium
semantics.
-/
theorem canonicalTwoUserValueMap_exists_l2Ball_subset_map_support_of_content_l2Ball_subset_support
    {θ ε : ℝ} {μ : Measure (Content 2)} {p0 : Content 2}
    (hε : 0 < ε) (hsin : Real.sin θ ≠ 0)
    (hcontent_ball : ∀ p : Content 2,
      (p 0 - p0 0) ^ 2 + (p 1 - p0 1) ^ 2 < ε ^ 2 →
      p ∈ μ.support) :
    ∃ δ : ℝ, 0 < δ ∧
      ∀ x y : ℝ,
        (x - (canonicalTwoUserValueMap θ p0).1) ^ 2 +
            (y - (canonicalTwoUserValueMap θ p0).2) ^ 2 < δ ^ 2 →
        (x, y) ∈
          (Measure.map (canonicalTwoUserValueMap θ) μ).support := by
  have hmetric_ball : Metric.ball p0 (ε / 2) ⊆ μ.support :=
    contentMetricBall_subset_support_of_l2SqBall_subset_support hε hcontent_ball
  rcases canonicalTwoUserValueMap_exists_metricBall_subset_map_support_of_contentBall_subset_support
      (θ := θ) (ε := ε / 2) (μ := μ) (p0 := p0)
      (by linarith) hsin hmetric_ball with ⟨δ, hδ_pos, hδ_ball⟩
  refine ⟨δ / 2, by linarith, ?_⟩
  intro x y hxy
  apply hδ_ball (x, y)
  exact mem_metricBall_of_l2Sq_lt hδ_pos hxy

private theorem l2Ball_subset_feasible_of_l2Ball_subset_map_support_of_ae_map_mem_closed
    {A : Type*} [TopologicalSpace A] [MeasurableSpace A]
    {f : A → ℝ × ℝ} {μ : Measure A} {feasible : Set (ℝ × ℝ)}
    {z1 z2 ε : ℝ}
    (hmap : AEMeasurable f μ)
    (hfeasible_closed : IsClosed feasible)
    (hae_feasible : ∀ᵐ p ∂μ, f p ∈ feasible)
    (hball_support : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
      (x, y) ∈ (Measure.map f μ).support) :
    ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
      (x, y) ∈ feasible := by
  have hmap_ae : ∀ᵐ z ∂Measure.map f μ, z ∈ feasible := by
    change ∀ᵐ z ∂Measure.map f μ, feasible z
    rw [ae_map_iff hmap hfeasible_closed.measurableSet]
    simpa only using hae_feasible
  have hsupport : (Measure.map f μ).support ⊆ feasible :=
    Measure.support_subset_of_isClosed hfeasible_closed hmap_ae
  intro x y hxy
  exact hsupport (hball_support x y hxy)

/--
Feasible-domain bridge for Proposition `supportrestriction`. A realized-value
support ball lies in a closed feasible set when the canonical value law is
almost everywhere feasible. The closedness and almost-everywhere premises are
kept explicit; neither is inferred from C1 or an equilibrium.
-/
theorem canonicalTwoUserValueMap_l2Ball_subset_feasible_of_ae_feasible
    {θ : ℝ} {μ : Measure (Content 2)} {feasible : Set (ℝ × ℝ)}
    {z1 z2 ε : ℝ}
    (hfeasible_closed : IsClosed feasible)
    (hae_feasible : ∀ᵐ p ∂μ, canonicalTwoUserValueMap θ p ∈ feasible)
    (hball_support : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
      (x, y) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support) :
    ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
      (x, y) ∈ feasible := by
  exact l2Ball_subset_feasible_of_l2Ball_subset_map_support_of_ae_map_mem_closed
    (canonicalTwoUserValueMap_continuous θ).aemeasurable
    hfeasible_closed hae_feasible hball_support

/--
Canonical feasible-domain bridge for Proposition `supportrestriction`. Under a
nonzero canonical sine, an almost-everywhere nonnegative content law and a
realized-value support ball put the whole ball in the actual value-map image of
the nonnegative content orthant. This does not establish C1, equilibrium, or
the source's literal generic C1 domain.
-/
theorem canonicalTwoUserValueMap_l2Ball_subset_image_nonnegative_of_ae_nonnegative
    {θ : ℝ} {μ : Measure (Content 2)} {z1 z2 ε : ℝ}
    (hsin : Real.sin θ ≠ 0)
    (hae_nonnegative : ∀ᵐ p ∂μ, NonnegativeContent p)
    (hball_support : ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
      (x, y) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support) :
    ∀ x y : ℝ,
      (x - z1) ^ 2 + (y - z2) ^ 2 < ε ^ 2 →
      (x, y) ∈ canonicalTwoUserValueMap θ ''
        {p : Content 2 | NonnegativeContent p} := by
  intro x y hxy
  rw [← canonicalTwoUserFeasibleValueSet_eq_valueMap_image_nonnegative hsin]
  exact canonicalTwoUserValueMap_l2Ball_subset_feasible_of_ae_feasible
    (canonicalTwoUserFeasibleValueSet_isClosed θ)
    (canonicalTwoUserValueMap_ae_mem_feasibleValueSet_of_ae_nonnegative
      hsin hae_nonnegative)
    hball_support x y hxy

/--
Source grouping condition used in Proposition `utility`: the selector assigns
a nonzero direction to a user attaining the minimum normalized inferred value.
-/
def SourceDirectionGroupMin {D N : ℕ} (users : Fin N → Content D)
    (ν : SourceNorm D) (group : Content D → Fin N) : Prop :=
  ∀ (i : Fin N) (p : Content D), group p = i → NonzeroContent p →
    ∀ k : Fin N,
      score (users i) (SourceNorm.normalizedContent ν p) ≤
        score (users k) (SourceNorm.normalizedContent ν p)

/--
Source definition of `Q` for Proposition `utility`: every unit direction has
some user whose inferred value is at most `Q`.
-/
def SourceUnitDirectionQUpperBound {D N : ℕ} (users : Fin N → Content D)
    (ν : SourceNorm D) (Q : ℝ) : Prop :=
  ∀ p : Content D, ν.norm p = 1 →
    ∃ i : Fin N, score (users i) p ≤ Q

/-- Users attaining the minimum normalized score for a fixed direction. -/
noncomputable def sourceMinScoreCandidates {D N : ℕ} [Nonempty (Fin N)]
    (users : Fin N → Content D) (ν : SourceNorm D) (p : Content D) :
    Finset (Fin N) := by
  classical
  exact Finset.univ.filter fun i =>
    ∀ k : Fin N,
      score (users i) (SourceNorm.normalizedContent ν p) ≤
        score (users k) (SourceNorm.normalizedContent ν p)

theorem sourceMinScoreCandidates_nonempty {D N : ℕ} [Nonempty (Fin N)]
    (users : Fin N → Content D) (ν : SourceNorm D) (p : Content D) :
    (sourceMinScoreCandidates users ν p).Nonempty := by
  classical
  obtain ⟨i, _hi, hmin⟩ :=
    Finset.exists_min_image (Finset.univ : Finset (Fin N))
      (fun i : Fin N => score (users i) (SourceNorm.normalizedContent ν p))
      Finset.univ_nonempty
  refine ⟨i, ?_⟩
  rw [sourceMinScoreCandidates, Finset.mem_filter]
  exact ⟨Finset.mem_univ i, fun k => hmin k (Finset.mem_univ k)⟩

/--
Canonical finite tie-breaking for the source clustering rule in Proposition
`utility`: among the minimum-score users, choose the least finite index.  This
fixed tie-breaking reduces the direction-group fibers to finite
score-comparison sets.
-/
noncomputable def sourceMinScoreUser {D N : ℕ} [Nonempty (Fin N)]
    (users : Fin N → Content D) (ν : SourceNorm D) (p : Content D) : Fin N :=
  (sourceMinScoreCandidates users ν p).min'
    (sourceMinScoreCandidates_nonempty users ν p)

theorem sourceMinScoreUser_min {D N : ℕ} [Nonempty (Fin N)]
    (users : Fin N → Content D) (ν : SourceNorm D) (p : Content D)
    (k : Fin N) :
    score (users (sourceMinScoreUser users ν p))
        (SourceNorm.normalizedContent ν p) ≤
      score (users k) (SourceNorm.normalizedContent ν p) := by
  have hmem :
      sourceMinScoreUser users ν p ∈ sourceMinScoreCandidates users ν p := by
    unfold sourceMinScoreUser
    exact Finset.min'_mem _ _
  rw [sourceMinScoreCandidates, Finset.mem_filter] at hmem
  exact hmem.2 k

theorem sourceDirectionGroupMin_sourceMinScoreUser
    {D N : ℕ} [Nonempty (Fin N)]
    (users : Fin N → Content D) (ν : SourceNorm D) :
    SourceDirectionGroupMin users ν (sourceMinScoreUser users ν) := by
  intro i p hgroup _hp k
  rw [← hgroup]
  exact sourceMinScoreUser_min users ν p k

theorem source_direction_group_bound_of_min_and_QUpper
    {D N : ℕ} [Nonempty (Fin N)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {group : Content D → Fin N} {Q : ℝ}
    (hQ_nonneg : 0 ≤ Q)
    (hmin : SourceDirectionGroupMin users ν group)
    (hQupper : SourceUnitDirectionQUpperBound users ν Q) :
    ∀ (i : Fin N) (p : Content D), group p = i →
      score (users i) p ≤ Q * ν.norm p := by
  intro i p hgroup
  by_cases hp : NonzeroContent p
  · rcases hQupper (SourceNorm.normalizedContent ν p)
        (SourceNorm.norm_normalizedContent_eq_one ν hp) with ⟨k, hkQ⟩
    have hmin_i_k :
        score (users i) (SourceNorm.normalizedContent ν p) ≤
          score (users k) (SourceNorm.normalizedContent ν p) :=
      hmin i p hgroup hp k
    have hscore_norm_le :
        ν.norm p * score (users i) (SourceNorm.normalizedContent ν p) ≤
          ν.norm p * Q :=
      mul_le_mul_of_nonneg_left (le_trans hmin_i_k hkQ) (ν.nonneg p)
    have hscore_eq :
        score (users i) p =
          ν.norm p * score (users i) (SourceNorm.normalizedContent ν p) :=
      SourceNorm.score_eq_norm_mul_score_normalizedContent ν (users i) hp
    rw [hscore_eq]
    simpa [mul_comm] using hscore_norm_le
  · have hp_zero : p = 0 := content_eq_zero_of_not_nonzeroContent hp
    subst hp_zero
    simp

/--
Directions for which user `i` is one of the minimum-score users. Unlike a
tie-broken selector, these sets are measurability-friendly and may overlap on
ties.
-/
def SourceMinDirectionSet {D N : ℕ} (users : Fin N → Content D)
    (ν : SourceNorm D) (i : Fin N) : Set (Content D) :=
  {p | ∀ k : Fin N,
    score (users i) (SourceNorm.normalizedContent ν p) ≤
      score (users k) (SourceNorm.normalizedContent ν p)}

theorem sourceMinDirectionSet_bound_of_QUpper
    {D N : ℕ} [Nonempty (Fin N)]
    {users : Fin N → Content D} {ν : SourceNorm D} {Q : ℝ}
    (hQ_nonneg : 0 ≤ Q)
    (hQupper : SourceUnitDirectionQUpperBound users ν Q) :
    ∀ (i : Fin N) (p : Content D), p ∈ SourceMinDirectionSet users ν i →
      score (users i) p ≤ Q * ν.norm p := by
  intro i p hpmin
  by_cases hp : NonzeroContent p
  · rcases hQupper (SourceNorm.normalizedContent ν p)
        (SourceNorm.norm_normalizedContent_eq_one ν hp) with ⟨k, hkQ⟩
    have hmin_i_k :
        score (users i) (SourceNorm.normalizedContent ν p) ≤
          score (users k) (SourceNorm.normalizedContent ν p) :=
      hpmin k
    have hscore_norm_le :
        ν.norm p * score (users i) (SourceNorm.normalizedContent ν p) ≤
          ν.norm p * Q :=
      mul_le_mul_of_nonneg_left (le_trans hmin_i_k hkQ) (ν.nonneg p)
    have hscore_eq :
        score (users i) p =
          ν.norm p * score (users i) (SourceNorm.normalizedContent ν p) :=
      SourceNorm.score_eq_norm_mul_score_normalizedContent ν (users i) hp
    rw [hscore_eq]
    simpa [mul_comm] using hscore_norm_le
  · have hp_zero : p = 0 := content_eq_zero_of_not_nonzeroContent hp
    subst hp_zero
    simp

theorem measurable_normalizedContent_of_measurable_norm
    {D : ℕ} {ν : SourceNorm D}
    (hnorm_meas : Measurable ν.norm) :
    Measurable (fun p : Content D => SourceNorm.normalizedContent ν p) := by
  rw [measurable_pi_iff]
  intro d
  simp [SourceNorm.normalizedContent, scaleContent]
  exact hnorm_meas.inv.mul (measurable_pi_apply d)

theorem measurable_score_normalizedContent_of_measurable_norm
    {D N : ℕ} {users : Fin N → Content D} {ν : SourceNorm D}
    (hnorm_meas : Measurable ν.norm) (i : Fin N) :
    Measurable
      (fun p : Content D =>
        score (users i) (SourceNorm.normalizedContent ν p)) := by
  exact (measurable_score_content (users i)).comp
    (measurable_normalizedContent_of_measurable_norm hnorm_meas)

theorem measurableSet_sourceMinDirectionSet_of_measurable_norm
    {D N : ℕ} {users : Fin N → Content D} {ν : SourceNorm D}
    (hnorm_meas : Measurable ν.norm) (i : Fin N) :
    MeasurableSet (SourceMinDirectionSet users ν i) := by
  have hsets :
      ∀ k : Fin N,
        MeasurableSet
          {p : Content D |
            score (users i) (SourceNorm.normalizedContent ν p) ≤
              score (users k) (SourceNorm.normalizedContent ν p)} := by
    intro k
    exact measurableSet_le
      (measurable_score_normalizedContent_of_measurable_norm hnorm_meas i)
      (measurable_score_normalizedContent_of_measurable_norm hnorm_meas k)
  convert (MeasurableSet.iInter hsets) using 1
  ext p
  simp [SourceMinDirectionSet]

/-- The least-index finite minimum-score selector has measurable fibers. -/
theorem measurableSet_sourceMinScoreUser_fiber_of_measurable_norm
    {D N : ℕ} [Nonempty (Fin N)] {users : Fin N → Content D} {ν : SourceNorm D}
    (hnorm_meas : Measurable ν.norm) (i : Fin N) :
    MeasurableSet
      {p : Content D | sourceMinScoreUser users ν p = i} := by
  classical
  let candidates : Content D → Finset (Fin N) :=
    sourceMinScoreCandidates users ν
  have hcandidate : ∀ i : Fin N,
      MeasurableSet {p : Content D | i ∈ candidates p} := by
    intro i
    have hEq :
        {p : Content D | i ∈ candidates p} =
          SourceMinDirectionSet users ν i := by
      ext p
      simp [candidates, sourceMinScoreCandidates, SourceMinDirectionSet]
    rw [hEq]
    exact measurableSet_sourceMinDirectionSet_of_measurable_norm hnorm_meas i
  have hfiber :
      {p : Content D | sourceMinScoreUser users ν p = i} =
        {p : Content D | i ∈ candidates p} ∩
          ⋂ b : Fin N, {p : Content D | b ∈ candidates p → i ≤ b} := by
    ext p
    simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter]
    change (sourceMinScoreCandidates users ν p).min'
        (sourceMinScoreCandidates_nonempty users ν p) = i ↔
      i ∈ sourceMinScoreCandidates users ν p ∧
        ∀ b : Fin N, b ∈ sourceMinScoreCandidates users ν p → i ≤ b
    exact Finset.min'_eq_iff _ _ i
  have hsmallest : ∀ b : Fin N,
      MeasurableSet {p : Content D | b ∈ candidates p → i ≤ b} := by
    intro b
    by_cases hib : i ≤ b
    · simpa [hib] using
        (MeasurableSet.univ : MeasurableSet (Set.univ : Set (Content D)))
    · have hEq :
        {p : Content D | b ∈ candidates p → i ≤ b} =
          {p : Content D | b ∈ candidates p}ᶜ := by
        ext p
        simp [hib]
      rw [hEq]
      exact (hcandidate b).compl
  rw [hfiber]
  exact (hcandidate i).inter (MeasurableSet.iInter hsmallest)

/-- Paper cost family for integer exponents: `c(p) = ||p||^β`. -/
noncomputable def normPowerCost {D : ℕ} (ν : SourceNorm D) (β : ℕ)
    (p : Content D) : ℝ :=
  ν.norm p ^ β

theorem normPowerCost_nonneg {D : ℕ} (ν : SourceNorm D) (β : ℕ)
    (p : Content D) :
    0 ≤ normPowerCost ν β p := by
  unfold normPowerCost
  exact pow_nonneg (ν.nonneg p) β

theorem radialStrictCost_normPowerCost {D : ℕ} (ν : SourceNorm D) {β : ℕ}
    (hβ : 0 < β) :
    RadialStrictCost (normPowerCost ν β) := by
  intro a p ha_nonneg ha_lt hp_nonzero
  have hp_pos : 0 < ν.norm p := ν.pos_of_nonzero hp_nonzero
  have hscaled_nonneg : 0 ≤ a * ν.norm p := mul_nonneg ha_nonneg hp_pos.le
  have hscaled_lt : a * ν.norm p < ν.norm p := by
    nlinarith [mul_lt_mul_of_pos_right ha_lt hp_pos]
  unfold normPowerCost
  rw [ν.scale_nonneg ha_nonneg]
  exact pow_lt_pow_left₀ hscaled_lt hscaled_nonneg (Nat.ne_of_gt hβ)

theorem perturbationCostContinuous_normPowerCost {D : ℕ} (ν : SourceNorm D)
    {β : ℕ} (hcont : SourceNormPerturbationContinuous ν) :
    PerturbationCostContinuous (normPowerCost ν β) := by
  intro p u
  unfold normPowerCost
  exact (hcont p u).pow β

/-- Paper cost family for real exponents: `c(p) = ||p||^β`. -/
noncomputable def normRpowCost {D : ℕ} (ν : SourceNorm D) (β : ℝ)
    (p : Content D) : ℝ :=
  ν.norm p ^ β

theorem normRpowCost_nonneg {D : ℕ} (ν : SourceNorm D) (β : ℝ)
    (p : Content D) :
    0 ≤ normRpowCost ν β p := by
  unfold normRpowCost
  exact Real.rpow_nonneg (ν.nonneg p) β

/-- Positive content scaling transports a homogeneous norm-power cost by the
corresponding real power of the scale. -/
theorem normRpowCost_scaleContent {D : ℕ} (ν : SourceNorm D) (β : ℝ)
    {a : ℝ} (ha : 0 ≤ a) (p : Content D) :
    normRpowCost ν β (scaleContent a p) =
      a ^ β * normRpowCost ν β p := by
  unfold normRpowCost
  rw [ν.scale_nonneg ha, Real.mul_rpow ha (ν.nonneg p)]

/--
Scaled L2 cost identity for an arbitrary two-dimensional unit user pair.  It
is the source cost equality in the original score coordinates, and therefore
does not use a cone-changing rotation to canonical users.
-/
theorem scaledNormRpowCost_l2_eq_twoUserInducedCost_of_unit_score_pair_dim_two
    {u v p : Content 2} {α β θ : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ) (hsin : 0 < Real.sin θ) :
    α * normRpowCost (SourceNorm.l2 2) β p =
      twoUserInducedCost α β θ (score u p) (score v p) := by
  have hunit := twoUserInducedCost_eq_l2_rpow_of_unit_score_pair_dim_two
    (p := p) (beta := β) hu hv huv hsin
  calc
    α * normRpowCost (SourceNorm.l2 2) β p =
        α * AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ β := by rfl
    _ = α * twoUserInducedCost 1 β θ (score u p) (score v p) := by
      rw [hunit]
    _ = twoUserInducedCost α β θ (score u p) (score v p) := by
      unfold twoUserInducedCost
      ring

/-- A nonnegative real power of a continuous source norm is continuous. -/
theorem continuous_normRpowCost_of_continuous_norm {D : ℕ}
    (ν : SourceNorm D) {β : ℝ} (hβ : 0 ≤ β)
    (hcont : Continuous ν.norm) :
    Continuous (normRpowCost ν β) := by
  unfold normRpowCost
  exact (Real.continuous_rpow_const hβ).comp hcont

/--
For the source's finite-dimensional Euclidean norm-power cost, the right hand
side of the diagonal payoff formula is continuous in the weak topology on
mixed strategies over every compact truncated action set.
-/
theorem continuous_sourceTruncatedDiagonalPayoff_l2_normRpowCost
    {D N P : ℕ} {β R : ℝ} (hβ : 0 ≤ β) :
    Continuous fun μ : ProbabilityMeasure
      (sourceTruncatedActionSet (SourceNorm.l2 D) R) =>
      SourceTruncatedDiagonalPayoff (N := N) (P := P) (SourceNorm.l2 D) R
        (normRpowCost (SourceNorm.l2 D) β) μ := by
  apply continuous_sourceTruncatedDiagonalPayoff_of_compactSublevels
    (SourceNorm.l2 D) R (SourceNorm.l2_compactSublevels D)
  exact continuous_normRpowCost_of_continuous_norm (SourceNorm.l2 D) hβ
    (SourceNorm.l2_continuous D)

@[simp] theorem normRpowCost_zero {D : ℕ} (ν : SourceNorm D) {β : ℝ}
    (hβ : 0 < β) :
    normRpowCost ν β (0 : Content D) = 0 := by
  unfold normRpowCost
  rw [ν.norm_zero, Real.zero_rpow (ne_of_gt hβ)]

/--
The all-zero user system has a pure Nash equilibrium at the all-zero content
profile.  This checks the degenerate population excluded by the source-model
active-user clarification.
-/
theorem zeroUsers_zeroProfile_is_pureNash_normRpowCost
    {D N P : ℕ} [Nonempty (Fin P)]
    (ν : SourceNorm D) {β : ℝ} (hβ : 0 < β) :
    PureNashEquilibrium (fun _ : Fin N => (0 : Content D)) (normRpowCost ν β)
      (fun _ : Fin P => (0 : Content D)) := by
  constructor
  · intro j
    exact zeroContent_nonnegative
  · intro j p _hp
    unfold pureProfit
    rw [usersWon_zeroUsers_eq_card_mul_inv,
      usersWon_zeroUsers_eq_card_mul_inv]
    simp only [deviateProfile_self, Pi.zero_apply]
    rw [normRpowCost_zero ν hβ]
    simpa using sub_le_self ((N : ℝ) * (P : ℝ)⁻¹)
      (normRpowCost_nonneg ν β p)

theorem radialStrictCost_normRpowCost {D : ℕ} (ν : SourceNorm D) {β : ℝ}
    (hβ : 0 < β) :
    RadialStrictCost (normRpowCost ν β) := by
  intro a p ha_nonneg ha_lt hp_nonzero
  have hp_pos : 0 < ν.norm p := ν.pos_of_nonzero hp_nonzero
  have hscaled_nonneg : 0 ≤ a * ν.norm p := mul_nonneg ha_nonneg hp_pos.le
  have hscaled_lt : a * ν.norm p < ν.norm p := by
    nlinarith [mul_lt_mul_of_pos_right ha_lt hp_pos]
  unfold normRpowCost
  rw [ν.scale_nonneg ha_nonneg]
  exact Real.rpow_lt_rpow hscaled_nonneg hscaled_lt hβ

theorem perturbationCostContinuous_normRpowCost {D : ℕ} (ν : SourceNorm D)
    {β : ℝ} (hβ : 0 ≤ β) (hcont : SourceNormPerturbationContinuous ν) :
    PerturbationCostContinuous (normRpowCost ν β) := by
  intro p u
  unfold normRpowCost
  exact (Real.continuousAt_rpow_const (ν.norm p) β (Or.inr hβ)).tendsto.comp
    (hcont p u)

theorem normRpowCost_gt_card_of_support_cap_lt_norm {D N : ℕ} [Nonempty (Fin N)]
    (ν : SourceNorm D) {β : ℝ} {p : Content D}
    (hβ : 0 < β) (hcap : (N : ℝ) ^ β⁻¹ < ν.norm p) :
    (N : ℝ) < normRpowCost ν β p := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hβ_ne : β ≠ 0 := ne_of_gt hβ
  have hcap_nonneg : 0 ≤ (N : ℝ) ^ β⁻¹ :=
    Real.rpow_nonneg hN_pos.le _
  have hcap_pow : ((N : ℝ) ^ β⁻¹) ^ β = (N : ℝ) := by
    rw [← Real.rpow_mul hN_pos.le]
    have hmul : β⁻¹ * β = 1 := by field_simp [hβ_ne]
    rw [hmul, Real.rpow_one]
  have hpow_lt : ((N : ℝ) ^ β⁻¹) ^ β < (ν.norm p) ^ β :=
    Real.rpow_lt_rpow hcap_nonneg hcap hβ
  simpa [normRpowCost, hcap_pow] using hpow_lt

theorem pureProfit_lt_zero_of_support_cap_lt_normRpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nonempty (Fin P)]
    (ν : SourceNorm D) {β : ℝ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    (hβ : 0 < β) (hcap : (N : ℝ) ^ β⁻¹ < ν.norm (profile j)) :
    pureProfit users (normRpowCost ν β) profile j < 0 := by
  have hcost : (N : ℝ) < normRpowCost ν β (profile j) :=
    normRpowCost_gt_card_of_support_cap_lt_norm ν hβ hcap
  exact pureProfit_lt_zero_of_cost_gt_card hcost

theorem norm_le_support_cap_of_nonnegative_pureProfit_normRpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nonempty (Fin P)]
    (ν : SourceNorm D) {β : ℝ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    (hβ : 0 < β)
    (hprofit : 0 ≤ pureProfit users (normRpowCost ν β) profile j) :
    ν.norm (profile j) ≤ (N : ℝ) ^ β⁻¹ := by
  by_contra hnot
  have hcap : (N : ℝ) ^ β⁻¹ < ν.norm (profile j) := lt_of_not_ge hnot
  have hneg :
      pureProfit users (normRpowCost ν β) profile j < 0 :=
    pureProfit_lt_zero_of_support_cap_lt_normRpowCost ν hβ hcap
  exact not_lt_of_ge hprofit hneg

theorem pureProfit_le_card_normRpowCost {D N P : ℕ} [Nonempty (Fin P)]
    (ν : SourceNorm D) (β : ℝ)
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P} :
    pureProfit users (normRpowCost ν β) profile j ≤ (N : ℝ) :=
  pureProfit_le_card_of_cost_nonneg (normRpowCost_nonneg ν β (profile j))

theorem sum_pureProfit_normRpowCost_le_card {D N P : ℕ} [Nonempty (Fin P)]
    (ν : SourceNorm D) (β : ℝ)
    {users : Fin N → Content D} {profile : Fin P → Content D} :
    (∑ j : Fin P, pureProfit users (normRpowCost ν β) profile j) ≤ (N : ℝ) :=
  sum_pureProfit_le_card_of_cost_nonneg
    (fun j => normRpowCost_nonneg ν β (profile j))

theorem common_pureProfit_normRpowCost_le_card_div {D N P : ℕ}
    [Nonempty (Fin P)]
    (ν : SourceNorm D) (β : ℝ)
    {users : Fin N → Content D} {profile : Fin P → Content D} {π : ℝ}
    (hcommon : ∀ j : Fin P, pureProfit users (normRpowCost ν β) profile j = π) :
    π ≤ (N : ℝ) / (P : ℝ) :=
  common_pureProfit_le_card_div_of_cost_nonneg
    (fun j => normRpowCost_nonneg ν β (profile j)) hcommon

theorem pureProfit_zero_deviation_nonneg_normRpowCost {D N P : ℕ}
    (ν : SourceNorm D) {β : ℝ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    (hβ : 0 < β) :
    0 ≤ pureProfit users (normRpowCost ν β)
      (deviateProfile profile j (0 : Content D)) j :=
  pureProfit_zero_deviation_nonneg_of_cost_zero (users := users)
    (profile := profile) (j := j) (normRpowCost_zero ν hβ)

theorem pureNash_profit_nonneg_normRpowCost {D N P : ℕ}
    (ν : SourceNorm D) {β : ℝ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    (hβ : 0 < β)
    (hne : PureNashEquilibrium users (normRpowCost ν β) profile) :
    0 ≤ pureProfit users (normRpowCost ν β) profile j :=
  pureNash_profit_nonneg_of_zero_cost (users := users) (profile := profile)
    (j := j) hne (normRpowCost_zero ν hβ)

theorem pureNash_norm_le_support_cap_normRpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nonempty (Fin P)]
    (ν : SourceNorm D) {β : ℝ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    (hβ : 0 < β)
    (hne : PureNashEquilibrium users (normRpowCost ν β) profile) :
    ν.norm (profile j) ≤ (N : ℝ) ^ β⁻¹ :=
  norm_le_support_cap_of_nonnegative_pureProfit_normRpowCost ν hβ
    (pureNash_profit_nonneg_normRpowCost ν hβ hne)

theorem pureNash_norm_lt_double_support_cap_normRpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nonempty (Fin P)]
    (ν : SourceNorm D) {β : ℝ}
    {users : Fin N → Content D} {profile : Fin P → Content D} {j : Fin P}
    (hβ : 0 < β)
    (hne : PureNashEquilibrium users (normRpowCost ν β) profile) :
    ν.norm (profile j) < 2 * ((N : ℝ) ^ β⁻¹) := by
  have hcap :
      ν.norm (profile j) ≤ (N : ℝ) ^ β⁻¹ :=
    pureNash_norm_le_support_cap_normRpowCost ν hβ hne
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hcap_pos : 0 < (N : ℝ) ^ β⁻¹ :=
    Real.rpow_pos_of_pos hN_pos _
  linarith

theorem pureNash_l2_coord_abs_le_support_cap_normRpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nonempty (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {profile : Fin P → Content D}
    (hβ : 0 < β)
    (hne : PureNashEquilibrium users (normRpowCost (SourceNorm.l2 D) β) profile)
    (j : Fin P) (d : Fin D) :
    |profile j d| ≤ (N : ℝ) ^ β⁻¹ := by
  have hnorm :
      (SourceNorm.l2 D).norm (profile j) ≤ (N : ℝ) ^ β⁻¹ :=
    pureNash_norm_le_support_cap_normRpowCost (SourceNorm.l2 D) hβ hne
  have hcoord :
      |profile j d| ≤ AppliedModelingLib.FiniteDimensionalNorms.l2 (profile j) :=
    AppliedModelingLib.FiniteDimensionalNorms.normL2_coord_abs_le (profile j) d
  exact le_trans hcoord hnorm

theorem pureNash_l2_coord_mem_support_box_normRpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nonempty (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {profile : Fin P → Content D}
    (hβ : 0 < β)
    (hne : PureNashEquilibrium users (normRpowCost (SourceNorm.l2 D) β) profile)
    (j : Fin P) (d : Fin D) :
    0 ≤ profile j d ∧ profile j d ≤ (N : ℝ) ^ β⁻¹ := by
  have hnonneg : 0 ≤ profile j d := hne.1 j d
  have habs :
      |profile j d| ≤ (N : ℝ) ^ β⁻¹ :=
    pureNash_l2_coord_abs_le_support_cap_normRpowCost hβ hne j d
  exact ⟨hnonneg, le_trans (le_abs_self (profile j d)) habs⟩

theorem pureNash_lp_coord_abs_le_support_cap_normRpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nonempty (Fin P)]
    {q β : ℝ} {users : Fin N → Content D} {profile : Fin P → Content D}
    (hq : 0 < q) (hβ : 0 < β)
    (hne : PureNashEquilibrium users (normRpowCost (SourceNorm.lp D hq) β) profile)
    (j : Fin P) (d : Fin D) :
    |profile j d| ≤ (N : ℝ) ^ β⁻¹ := by
  have hnorm :
      (SourceNorm.lp D hq).norm (profile j) ≤ (N : ℝ) ^ β⁻¹ :=
    pureNash_norm_le_support_cap_normRpowCost (SourceNorm.lp D hq) hβ hne
  have hcoord :
      |profile j d| ≤ AppliedModelingLib.FiniteDimensionalNorms.lp q (profile j) := by
    rw [AppliedModelingLib.FiniteDimensionalNorms.lp]
    rw [show 1 / q = q⁻¹ by ring]
    apply (Real.le_rpow_inv_iff_of_pos (abs_nonneg (profile j d))
      (AppliedModelingLib.FiniteDimensionalNorms.lpPower_nonneg q (profile j)) hq).mpr
    rw [AppliedModelingLib.FiniteDimensionalNorms.lpPower]
    exact Finset.single_le_sum
      (fun i _hi => Real.rpow_nonneg (abs_nonneg (profile j i)) q)
      (Finset.mem_univ d)
  exact le_trans hcoord hnorm

theorem pureNash_lp_coord_mem_support_box_normRpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nonempty (Fin P)]
    {q β : ℝ} {users : Fin N → Content D} {profile : Fin P → Content D}
    (hq : 0 < q) (hβ : 0 < β)
    (hne : PureNashEquilibrium users (normRpowCost (SourceNorm.lp D hq) β) profile)
    (j : Fin P) (d : Fin D) :
    0 ≤ profile j d ∧ profile j d ≤ (N : ℝ) ^ β⁻¹ := by
  have hnonneg : 0 ≤ profile j d := hne.1 j d
  have habs :
      |profile j d| ≤ (N : ℝ) ^ β⁻¹ :=
    pureNash_lp_coord_abs_le_support_cap_normRpowCost hq hβ hne j d
  exact ⟨hnonneg, le_trans (le_abs_self (profile j d)) habs⟩

theorem not_pureNash_of_profitable_deviation {D N P : ℕ}
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D} {j : Fin P} {p : Content D}
    (hp : NonnegativeContent p)
    (hprofit :
      pureProfit users cost profile j <
        pureProfit users cost (deviateProfile profile j p) j) :
    ¬ PureNashEquilibrium users cost profile := by
  intro hne
  have hle :
      pureProfit users cost (deviateProfile profile j p) j ≤
        pureProfit users cost profile j :=
    hne.2 j p hp
  exact not_lt_of_ge hle hprofit

theorem not_pureNash_of_top_tie_perturb_cost_lt_share_jump {D N P : ℕ}
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D} {i0 : Fin N} {j : Fin P} {ε : ℝ}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k))
    (hzero : NonzeroContent (users i0))
    (hwin : j ∈ winningProducers (users i0) profile)
    (hε : 0 < ε)
    (hcost :
      cost (fun d => profile j d + ε * users i0 d) - cost (profile j) <
        1 - tieShare (users i0) profile j) :
    ¬ PureNashEquilibrium users cost profile := by
  have hprofit :
      pureProfit users cost profile j <
        pureProfit users cost
          (deviateProfile profile j (fun d => profile j d + ε * users i0 d)) j :=
    pureProfit_lt_of_top_tie_perturb_cost_lt_share_jump husers_nonneg hzero hwin hε hcost
  exact not_pureNash_of_profitable_deviation
    (perturbContent_nonnegative (hprofile_nonneg j) (husers_nonneg i0) hε.le)
    hprofit

theorem not_pureNash_of_top_tie_of_perturbationCostContinuous {D N P : ℕ}
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D} {i0 : Fin N} {j : Fin P}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k))
    (hcost_cont : PerturbationCostContinuous cost)
    (hzero : NonzeroContent (users i0))
    (hwin : j ∈ winningProducers (users i0) profile)
    (hcard : 1 < (winningProducers (users i0) profile).card) :
    ¬ PureNashEquilibrium users cost profile := by
  have hjump_pos : 0 < 1 - tieShare (users i0) profile j :=
    top_tie_share_jump_pos hwin hcard
  rcases exists_positive_perturb_cost_increase_lt hcost_cont
      (p := profile j) (u := users i0) hjump_pos with
    ⟨ε, hε, hcost⟩
  exact not_pureNash_of_top_tie_perturb_cost_lt_share_jump husers_nonneg
    hprofile_nonneg hzero hwin hε hcost

theorem not_pureNash_of_scaled_down_preserves_winners_lower_cost {D N P : ℕ}
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D} {j : Fin P} {a : ℝ}
    (hno : NoScoreTies users profile)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k))
    (ha_nonneg : 0 ≤ a) (ha_le : a ≤ 1)
    (hpreserve : ∀ i : Fin N, j ∈ winningProducers (users i) profile →
      StrictWinner (users i)
        (deviateProfile profile j (scaleContent a (profile j))) j)
    (hcost : cost (scaleContent a (profile j)) < cost (profile j)) :
    ¬ PureNashEquilibrium users cost profile := by
  have husers_eq :
      usersWon users profile j =
        usersWon users (deviateProfile profile j (scaleContent a (profile j))) j :=
    usersWon_eq_deviate_scale_of_preserved_winners hno husers_nonneg hprofile_nonneg
      ha_le hpreserve
  have hcost_dev :
      cost ((deviateProfile profile j (scaleContent a (profile j))) j) <
        cost (profile j) := by
    simpa using hcost
  have hprofit :
      pureProfit users cost profile j <
        pureProfit users cost (deviateProfile profile j (scaleContent a (profile j))) j :=
    pureProfit_lt_of_same_usersWon_and_cost_lt husers_eq hcost_dev
  exact not_pureNash_of_profitable_deviation
    (scaleContent_nonnegative ha_nonneg (hprofile_nonneg j)) hprofit

theorem not_pureNash_noScoreTies_of_radialStrictCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D}
    (hno : NoScoreTies users profile)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hcost : RadialStrictCost cost) :
    ¬ PureNashEquilibrium users cost profile := by
  intro hne
  have hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k) := hne.1
  rcases exists_producer_usersWon_pos users profile with ⟨j, hj_pos⟩
  rcases exists_user_strictWinner_of_usersWon_pos_noScoreTies hno hj_pos with
    ⟨i, hi_strict⟩
  have hpj_nonzero : NonzeroContent (profile j) :=
    profile_nonzero_of_strictWinner_nonnegative (husers_nonneg i)
      hprofile_nonneg hi_strict
  rcases exists_scale_down_preserving_winners_of_noScoreTies hno husers_nonneg
      hprofile_nonneg with ⟨a, ha_nonneg, ha_lt, hpreserve⟩
  have hnot :
      ¬ PureNashEquilibrium users cost profile :=
    not_pureNash_of_scaled_down_preserves_winners_lower_cost hno husers_nonneg
      hprofile_nonneg ha_nonneg (le_of_lt ha_lt) hpreserve
      (hcost ha_nonneg ha_lt hpj_nonzero)
  exact hnot hne

theorem not_pureNash_uniqueWinners_of_radialStrictCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D}
    (huniq : UniqueWinningProducers users profile)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hcost : RadialStrictCost cost) :
    ¬ PureNashEquilibrium users cost profile := by
  intro hne
  have hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k) := hne.1
  rcases exists_producer_usersWon_pos users profile with ⟨j, hj_pos⟩
  rcases exists_user_tieShare_pos_of_usersWon_pos hj_pos with ⟨i, hi_share⟩
  have hwin : j ∈ winningProducers (users i) profile :=
    mem_winningProducers_of_tieShare_pos hi_share
  have hi_strict : StrictWinner (users i) profile j :=
    strictWinner_of_winning_uniqueWinningProducers huniq hwin
  have hpj_nonzero : NonzeroContent (profile j) :=
    profile_nonzero_of_strictWinner_nonnegative (husers_nonneg i)
      hprofile_nonneg hi_strict
  rcases exists_scale_down_preserving_winners_of_uniqueWinners huniq husers_nonneg
      hprofile_nonneg with ⟨a, ha_nonneg, ha_lt, hpreserve⟩
  have husers_eq :
      usersWon users profile j =
        usersWon users (deviateProfile profile j (scaleContent a (profile j))) j :=
    usersWon_eq_deviate_scale_of_preserved_winners_unique huniq husers_nonneg
      hprofile_nonneg (le_of_lt ha_lt) hpreserve
  have hcost_dev :
      cost ((deviateProfile profile j (scaleContent a (profile j))) j) <
        cost (profile j) := by
    simpa using hcost ha_nonneg ha_lt hpj_nonzero
  have hprofit :
      pureProfit users cost profile j <
        pureProfit users cost (deviateProfile profile j (scaleContent a (profile j))) j :=
    pureProfit_lt_of_same_usersWon_and_cost_lt husers_eq hcost_dev
  exact not_pureNash_of_profitable_deviation
    (scaleContent_nonnegative ha_nonneg (hprofile_nonneg j)) hprofit hne

theorem not_pureNash_of_radialStrictCost_and_perturbationCostContinuous {D N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcost_radial : RadialStrictCost cost)
    (hcost_cont : PerturbationCostContinuous cost) :
    ¬ PureNashEquilibrium users cost profile := by
  intro hne
  by_cases huniq : UniqueWinningProducers users profile
  · exact not_pureNash_uniqueWinners_of_radialStrictCost huniq
      husers_nonneg hcost_radial hne
  · rcases exists_top_tie_of_not_uniqueWinningProducers huniq with
      ⟨i, j, hwin, hcard⟩
    exact not_pureNash_of_top_tie_of_perturbationCostContinuous husers_nonneg
      hne.1 hcost_cont (husers_nonzero i) hwin hcard hne

/--
Source-faithful Proposition `pure`: one nonzero user suffices for the
nonexistence argument.  At a putative equilibrium, any top tie involving an
active user has a profitable perturbation.  Thus a producer winning an active
user is a strict winner there; a finite-margin scale-down preserves all such
wins, while zero-user shares are unchanged by the deviation.
-/
theorem not_pureNash_of_exists_nonzeroUser_of_radialStrictCost_and_perturbationCostContinuous
    {D N P : ℕ} [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {profile : Fin P → Content D}
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hexists_nonzero : ∃ i : Fin N, NonzeroContent (users i))
    (hcost_radial : RadialStrictCost cost)
    (hcost_cont : PerturbationCostContinuous cost) :
    ¬ PureNashEquilibrium users cost profile := by
  intro hne
  have hprofile_nonneg : ∀ k : Fin P, NonnegativeContent (profile k) := hne.1
  rcases hexists_nonzero with ⟨i0, hi0_nonzero⟩
  rcases winningProducers_nonempty (users i0) profile with ⟨j, hj_win⟩
  have hactive_strict : ∀ i : Fin N, NonzeroContent (users i) →
      j ∈ winningProducers (users i) profile → StrictWinner (users i) profile j := by
    intro i hi_nonzero hwin
    intro k hkj
    by_contra hnot_lt
    have hle : score (users i) (profile k) ≤ score (users i) (profile j) :=
      (mem_winningProducers (users i) profile j).mp hwin k
    have heq : score (users i) (profile k) = score (users i) (profile j) :=
      le_antisymm hle (le_of_not_gt hnot_lt)
    have hk_win : k ∈ winningProducers (users i) profile := by
      rw [mem_winningProducers]
      intro l
      calc
        score (users i) (profile l) ≤ score (users i) (profile j) :=
          (mem_winningProducers (users i) profile j).mp hwin l
        _ = score (users i) (profile k) := heq.symm
    have hsubset : ({j, k} : Finset (Fin P)) ⊆
        winningProducers (users i) profile := by
      intro l hl
      simp only [Finset.mem_insert, Finset.mem_singleton] at hl
      rcases hl with rfl | rfl
      · exact hwin
      · exact hk_win
    have htwo : 1 < ({j, k} : Finset (Fin P)).card := by
      rw [Finset.pair_comm j k, Finset.card_pair hkj]
      norm_num
    have hcard : 1 < (winningProducers (users i) profile).card :=
      lt_of_lt_of_le htwo (Finset.card_le_card hsubset)
    exact (not_pureNash_of_top_tie_of_perturbationCostContinuous husers_nonneg
      hprofile_nonneg hcost_cont hi_nonzero hwin hcard) hne
  have hpj_nonzero : NonzeroContent (profile j) :=
    profile_nonzero_of_strictWinner_nonnegative (husers_nonneg i0)
      hprofile_nonneg (hactive_strict i0 hi0_nonzero hj_win)
  rcases exists_scale_down_preserving_active_strictWinners hactive_strict
      husers_nonneg hprofile_nonneg with ⟨a, ha_nonneg, ha_lt, hpreserve⟩
  have husers_eq :
      usersWon users profile j =
        usersWon users (deviateProfile profile j (scaleContent a (profile j))) j :=
    usersWon_eq_deviate_scale_of_preserved_active_strictWinners husers_nonneg
      hprofile_nonneg (le_of_lt ha_lt) hactive_strict hpreserve
  have hcost_dev :
      cost ((deviateProfile profile j (scaleContent a (profile j))) j) <
        cost (profile j) := by
    simpa using hcost_radial ha_nonneg ha_lt hpj_nonzero
  have hprofit :
      pureProfit users cost profile j <
        pureProfit users cost (deviateProfile profile j (scaleContent a (profile j))) j :=
    pureProfit_lt_of_same_usersWon_and_cost_lt husers_eq hcost_dev
  exact (not_pureNash_of_profitable_deviation
    (scaleContent_nonnegative ha_nonneg (hprofile_nonneg j)) hprofit) hne

theorem not_pureNash_normRpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    (ν : SourceNorm D) {β : ℝ} (hβ : 0 < β)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcont : SourceNormPerturbationContinuous ν) :
    ¬ PureNashEquilibrium users (normRpowCost ν β) profile :=
  not_pureNash_of_radialStrictCost_and_perturbationCostContinuous
    husers_nonneg husers_nonzero (radialStrictCost_normRpowCost ν hβ)
    (perturbationCostContinuous_normRpowCost ν hβ.le hcont)

/-- Norm-power specialization of the source-faithful active-user Proposition `pure`. -/
theorem not_pureNash_normRpowCost_of_exists_nonzeroUser {D N P : ℕ}
    [Nontrivial (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    (ν : SourceNorm D) {β : ℝ} (hβ : 0 < β)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hexists_nonzero : ∃ i : Fin N, NonzeroContent (users i))
    (hcont : SourceNormPerturbationContinuous ν) :
    ¬ PureNashEquilibrium users (normRpowCost ν β) profile :=
  not_pureNash_of_exists_nonzeroUser_of_radialStrictCost_and_perturbationCostContinuous
    husers_nonneg hexists_nonzero (radialStrictCost_normRpowCost ν hβ)
    (perturbationCostContinuous_normRpowCost ν hβ.le hcont)

/-- Source-exponent form of the active-user norm-power Proposition `pure`. -/
theorem not_pureNash_normRpowCost_of_exists_nonzeroUser_of_one_le {D N P : ℕ}
    [Nontrivial (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    (ν : SourceNorm D) {β : ℝ} (hβ : 1 ≤ β)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hexists_nonzero : ∃ i : Fin N, NonzeroContent (users i))
    (hcont : SourceNormPerturbationContinuous ν) :
    ¬ PureNashEquilibrium users (normRpowCost ν β) profile :=
  not_pureNash_normRpowCost_of_exists_nonzeroUser ν
    (lt_of_lt_of_le zero_lt_one hβ) husers_nonneg hexists_nonzero hcont

/-- Source-shaped `β >= 1` corollary of the norm-power Proposition `pure` theorem. -/
theorem not_pureNash_normRpowCost_of_one_le {D N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    (ν : SourceNorm D) {β : ℝ} (hβ : 1 ≤ β)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcont : SourceNormPerturbationContinuous ν) :
    ¬ PureNashEquilibrium users (normRpowCost ν β) profile :=
  not_pureNash_normRpowCost ν (lt_of_lt_of_le zero_lt_one hβ)
    husers_nonneg husers_nonzero hcont

/--
Proposition `pure` for the paper's finite-coordinate `Lq` cost family:
`c(p)=||p||_q^β` admits no finite pure-strategy Nash equilibrium when
`q > 0` and `β > 0`.
-/
theorem not_pureNash_lpRpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    {q β : ℝ} (hq : 0 < q) (hβ : 0 < β)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i)) :
    ¬ PureNashEquilibrium users
      (normRpowCost (SourceNorm.lp D hq) β) profile :=
  not_pureNash_normRpowCost (SourceNorm.lp D hq) hβ husers_nonneg
    husers_nonzero (SourceNorm.lp_perturbationContinuous hq)

/--
Proposition `pure` for the paper's finite-coordinate `Lq` cost family,
with the paper's printed exponent assumption `β >= 1`.
-/
theorem not_pureNash_lpRpowCost_of_one_le {D N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    {q β : ℝ} (hq : 0 < q) (hβ : 1 ≤ β)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i)) :
    ¬ PureNashEquilibrium users
      (normRpowCost (SourceNorm.lp D hq) β) profile :=
  not_pureNash_lpRpowCost hq (lt_of_lt_of_le zero_lt_one hβ)
    husers_nonneg husers_nonzero

/--
Proposition `pure` for the paper's finite-coordinate Euclidean cost family:
`c(p)=||p||_2^β` admits no finite pure-strategy Nash equilibrium when
`β > 0`.
-/
theorem not_pureNash_l2RpowCost {D N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    {β : ℝ} (hβ : 0 < β)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i)) :
    ¬ PureNashEquilibrium users
      (normRpowCost (SourceNorm.l2 D) β) profile :=
  not_pureNash_normRpowCost (SourceNorm.l2 D) hβ husers_nonneg
    husers_nonzero SourceNorm.l2_perturbationContinuous

/--
Proposition `pure` for the paper's finite-coordinate Euclidean cost family,
with the paper's printed exponent assumption `β >= 1`.
-/
theorem not_pureNash_l2RpowCost_of_one_le {D N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {profile : Fin P → Content D}
    {β : ℝ} (hβ : 1 ≤ β)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i)) :
    ¬ PureNashEquilibrium users
      (normRpowCost (SourceNorm.l2 D) β) profile :=
  not_pureNash_l2RpowCost (lt_of_lt_of_le zero_lt_one hβ)
    husers_nonneg husers_nonzero

/-- A content point has positive mass under a mixed producer strategy. -/
def HasContentPointMass {D : ℕ} (μ : MixedContentStrategy D) (p : Content D) : Prop :=
  μ ({p} : Set (Content D)) ≠ 0

/-- An almost-everywhere equality holds at every content point with positive mass. -/
theorem eq_of_ae_eq_of_hasContentPointMass
    {D : ℕ} {μ : MixedContentStrategy D} {f : Content D → ℝ}
    {value : ℝ} {p : Content D}
    (hae : ∀ᵐ x ∂μ, f x = value)
    (hp : HasContentPointMass μ p) :
    f p = value := by
  by_contra hneq
  have hnull : μ {x | f x ≠ value} = 0 :=
    MeasureTheory.ae_iff.mp hae
  have hsubset : ({p} : Set (Content D)) ⊆ {x | f x ≠ value} := by
    intro x hx
    have hxp : x = p := by
      simpa using hx
    subst x
    exact hneq
  exact hp (MeasureTheory.measure_mono_null hsubset hnull)

/-- Source-facing atomless predicate for mixed producer strategies. -/
def MixedContentStrategyAtomless {D : ℕ} (μ : MixedContentStrategy D) : Prop :=
  ∀ p : Content D, ¬ HasContentPointMass μ p

/--
The expected payoff of a probability mixed strategy can equal its upper bound
only when its pure-action payoff equals that bound almost everywhere.
-/
theorem ae_eq_equilibriumPayoff_of_noProfitablePureDeviation_and_integral_eq
    {D : ℕ} {payoff : Content D → MixedContentStrategy D → ℝ}
    {μ : MixedContentStrategy D} [MeasureTheory.IsProbabilityMeasure μ]
    {equilibriumPayoff : ℝ}
    (hno : SymmetricMixedNoProfitablePureDeviation payoff μ equilibriumPayoff)
    (hint : MeasureTheory.Integrable (fun p => payoff p μ) μ)
    (hmixed_payoff : ∫ p, payoff p μ ∂μ = equilibriumPayoff) :
    ∀ᵐ p ∂μ, payoff p μ = equilibriumPayoff := by
  have hconst : MeasureTheory.Integrable (fun _ : Content D => equilibriumPayoff) μ :=
    MeasureTheory.integrable_const _
  have hdiff : MeasureTheory.Integrable
      (fun p => equilibriumPayoff - payoff p μ) μ :=
    hconst.sub hint
  have hnonneg : ∀ᵐ p ∂μ, 0 ≤ equilibriumPayoff - payoff p μ :=
    Filter.Eventually.of_forall (fun p => sub_nonneg.mpr (hno p))
  have hmean_zero : ∫ p, equilibriumPayoff - payoff p μ ∂μ = 0 := by
    rw [MeasureTheory.integral_sub hconst hint]
    rw [MeasureTheory.integral_const]
    simp [hmixed_payoff]
  have hzero : (fun p => equilibriumPayoff - payoff p μ) =ᵐ[μ] 0 :=
    (MeasureTheory.integral_eq_zero_iff_of_nonneg_ae hnonneg hdiff).mp hmean_zero
  filter_upwards [hzero] with p hp
  have hpzero : equilibriumPayoff - payoff p μ = 0 := by
    simpa using hp
  linarith

/--
Source-facing symmetric mixed equilibrium conditions used by Proposition
`atom`: there is an equilibrium payoff, no pure content deviation earns more
than it, and every atom in the symmetric mixed strategy's support earns exactly
that payoff.  This packages the standard support-indifference consequence used
in the paper's mixed-equilibrium proof.
-/
def SourceSymmetricMixedEquilibriumConditions {D : ℕ}
    (payoff : Content D → MixedContentStrategy D → ℝ)
    (μ : MixedContentStrategy D) : Prop :=
  ∃ equilibriumPayoff : ℝ,
    SymmetricMixedNoProfitablePureDeviation payoff μ equilibriumPayoff ∧
      ∀ p : Content D, HasContentPointMass μ p →
        payoff p μ = equilibriumPayoff

/--
Source perturbation premise for Proposition `atom`: every point mass produces
some pure content deviation whose payoff is strictly above the equilibrium
payoff.  The remaining paper-specific work is to derive this premise from the
tie event, atom mass, and cost-continuity argument in the source proof.
-/
def AtomPerturbationProfitable {D : ℕ}
    (payoff : Content D → MixedContentStrategy D → ℝ)
    (μ : MixedContentStrategy D) (equilibriumPayoff : ℝ) : Prop :=
  ∀ p : Content D, HasContentPointMass μ p →
    ∃ p' : Content D, equilibriumPayoff < payoff p' μ

/--
Proposition `atom`, equilibrium-contradiction core: if the symmetric mixed
strategy has no profitable pure deviation, and every point mass would create a
profitable perturbation, then the strategy is atomless.
-/
theorem mixedContentStrategyAtomless_of_no_profitable_deviation
    {D : ℕ} {payoff : Content D → MixedContentStrategy D → ℝ}
    {μ : MixedContentStrategy D} {equilibriumPayoff : ℝ}
    (hno : SymmetricMixedNoProfitablePureDeviation payoff μ equilibriumPayoff)
    (hatom : AtomPerturbationProfitable payoff μ equilibriumPayoff) :
    MixedContentStrategyAtomless μ := by
  intro p hp
  rcases hatom p hp with ⟨p', hp'⟩
  exact not_lt_of_ge (hno p') hp'

/--
The same atomlessness conclusion in mathlib's `NoAtoms` form.  This is useful
for later CDF/support arguments, where mathlib supplies singleton-zero and
countable-set-zero consequences from `NoAtoms`.
-/
theorem noAtoms_of_no_profitable_deviation_and_atom_perturbation
    {D : ℕ} {payoff : Content D → MixedContentStrategy D → ℝ}
    {μ : MixedContentStrategy D} {equilibriumPayoff : ℝ}
    (hno : SymmetricMixedNoProfitablePureDeviation payoff μ equilibriumPayoff)
    (hatom : AtomPerturbationProfitable payoff μ equilibriumPayoff) :
    MeasureTheory.NoAtoms μ := by
  refine ⟨?_⟩
  intro p
  by_contra hp
  exact mixedContentStrategyAtomless_of_no_profitable_deviation hno hatom p hp

/--
Atomless mixed content strategies have zero real singleton probability at every
content vector.  This is the form used by later CDF/support calculations.
-/
theorem mixedContentStrategyAtomless_measureReal_singleton_eq_zero
    {D : ℕ} {μ : MixedContentStrategy D}
    (hatomless : MixedContentStrategyAtomless μ) (p : Content D) :
    μ.real ({p} : Set (Content D)) = 0 := by
  have hzero : μ ({p} : Set (Content D)) = 0 := by
    by_contra hp
    exact hatomless p hp
  simp [MeasureTheory.Measure.real, hzero]

/--
Proposition `atom`, real singleton-probability form: the no-profitable-
deviation and atom-perturbation premises force every point mass to have real
probability zero.
-/
theorem measureReal_singleton_eq_zero_of_no_profitable_deviation
    {D : ℕ} {payoff : Content D → MixedContentStrategy D → ℝ}
    {μ : MixedContentStrategy D} {equilibriumPayoff : ℝ}
    (hno : SymmetricMixedNoProfitablePureDeviation payoff μ equilibriumPayoff)
    (hatom : AtomPerturbationProfitable payoff μ equilibriumPayoff)
    (p : Content D) :
    μ.real ({p} : Set (Content D)) = 0 :=
  mixedContentStrategyAtomless_measureReal_singleton_eq_zero
    (mixedContentStrategyAtomless_of_no_profitable_deviation hno hatom) p

/--
Proposition `atom`, point-mass event-gain bridge: a genuine atom under a finite
mixed strategy has positive real mass, so the source tie-event gain term is
strictly positive for at least two producers.
-/
theorem atomTieEventGain_positive_of_content_point_mass
    {D P : ℕ} [Nontrivial (Fin P)]
    {μ : MixedContentStrategy D} [MeasureTheory.IsFiniteMeasure μ]
    {p : Content D} (hp : HasContentPointMass μ p) :
    0 < (μ.real ({p} : Set (Content D))) ^ (P - 1) *
      (1 - 1 / (P : ℝ)) := by
  have hmass_pos : 0 < μ.real ({p} : Set (Content D)) :=
    AppliedModelingLib.measureReal_pos_of_measure_ne_zero_ne_top μ
      ({p} : Set (Content D)) hp (MeasureTheory.measure_ne_top μ _)
  exact atomTieEventGain_positive hmass_pos

/--
Proposition `atom`, realized atom-event gain: if `p` is an atom and producer
`j` perturbs from the all-`p` tie profile in a nonzero user direction, the
probability of the all-opponents-at-`p` event times the exact tie-share gain is
strictly positive.
-/
theorem atomTieEventPerturbationGain_positive_of_content_point_mass
    {D P : ℕ} [Nontrivial (Fin P)]
    {μ : MixedContentStrategy D} [MeasureTheory.IsFiniteMeasure μ]
    {p u : Content D} {j : Fin P} {ε : ℝ}
    (hp : HasContentPointMass μ p)
    (hu : NonnegativeContent u) (hzero : NonzeroContent u) (hε : 0 < ε) :
    0 < (μ.real ({p} : Set (Content D))) ^ (P - 1) *
      (tieShare u
          (deviateProfile (fun _ : Fin P => p) j (fun d => p d + ε * u d)) j -
        tieShare u (fun _ : Fin P => p) j) := by
  rw [tieShare_gain_constantProfile_perturb_eq_one_sub_one_div hu hzero hε]
  exact atomTieEventGain_positive_of_content_point_mass hp

/--
Proposition `atom`, cost-continuity step: if `p` is an atom, then the positive
atom-event tie-share gain leaves room for a small perturbation whose production
cost increase is smaller than that gain.
-/
theorem exists_atom_perturb_cost_increase_lt_event_gain
    {D P : ℕ} [Nontrivial (Fin P)]
    {μ : MixedContentStrategy D} [MeasureTheory.IsFiniteMeasure μ]
    {cost : Content D → ℝ} (hcont : PerturbationCostContinuous cost)
    {p u : Content D} {j : Fin P}
    (hp : HasContentPointMass μ p)
    (hu : NonnegativeContent u) (hzero : NonzeroContent u) :
    ∃ ε : ℝ, 0 < ε ∧
      cost (fun d => p d + ε * u d) - cost p <
        (μ.real ({p} : Set (Content D))) ^ (P - 1) *
          (tieShare u
              (deviateProfile (fun _ : Fin P => p) j
                (fun d => p d + ε * u d)) j -
            tieShare u (fun _ : Fin P => p) j) := by
  have hgain_pos :
      0 < (μ.real ({p} : Set (Content D))) ^ (P - 1) *
        (1 - 1 / (P : ℝ)) :=
    atomTieEventGain_positive_of_content_point_mass hp
  rcases exists_positive_perturb_cost_increase_lt hcont
      (p := p) (u := u) hgain_pos with
    ⟨ε, hε, hcost⟩
  refine ⟨ε, hε, ?_⟩
  rwa [tieShare_gain_constantProfile_perturb_eq_one_sub_one_div hu hzero hε]

/--
Proposition `atom`, norm-power cost-continuity step for the paper's real
exponent cost family.
-/
theorem exists_atom_perturb_normRpowCost_increase_lt_event_gain
    {D P : ℕ} [Nontrivial (Fin P)]
    {μ : MixedContentStrategy D} [MeasureTheory.IsFiniteMeasure μ]
    (ν : SourceNorm D) {β : ℝ} (hβ : 0 ≤ β)
    (hcont : SourceNormPerturbationContinuous ν)
    {p u : Content D} {j : Fin P}
    (hp : HasContentPointMass μ p)
    (hu : NonnegativeContent u) (hzero : NonzeroContent u) :
    ∃ ε : ℝ, 0 < ε ∧
      normRpowCost ν β (fun d => p d + ε * u d) - normRpowCost ν β p <
        (μ.real ({p} : Set (Content D))) ^ (P - 1) *
          (tieShare u
              (deviateProfile (fun _ : Fin P => p) j
                (fun d => p d + ε * u d)) j -
            tieShare u (fun _ : Fin P => p) j) :=
  exists_atom_perturb_cost_increase_lt_event_gain
    (perturbationCostContinuous_normRpowCost ν hβ hcont) hp hu hzero

/--
Source payoff-semantics boundary for Proposition `atom`: the realized
all-opponents-at-the-atom event contributes at least its probability times the
tie-share gain, and the only subtraction is the production-cost increase.
-/
def AtomEventPayoffGainLowerBound {D P : ℕ} [Nontrivial (Fin P)]
    (payoff : Content D → MixedContentStrategy D → ℝ)
    (cost : Content D → ℝ) (μ : MixedContentStrategy D)
    (p u : Content D) (j : Fin P) (ε : ℝ) : Prop :=
  (μ.real ({p} : Set (Content D))) ^ (P - 1) *
      (tieShare u
          (deviateProfile (fun _ : Fin P => p) j (fun d => p d + ε * u d)) j -
        tieShare u (fun _ : Fin P => p) j) -
    (cost (fun d => p d + ε * u d) - cost p) ≤
      payoff (fun d => p d + ε * u d) μ - payoff p μ

/--
For a fixed ambient mixed strategy, the source pure payoff is strongly
measurable in the deviating content vector.  This is the ambient counterpart
of the compact-subtype measurability lemma: it is needed to transport an
almost-everywhere equilibrium identity through the subtype push-forward.
-/
theorem stronglyMeasurable_sourceMixedPurePayoff
    {D N P : ℕ} (users : Fin N → Content D)
    (j : Fin P) (cost : Content D → ℝ) (hcost : Continuous cost)
    (μ : MixedContentStrategy D) [IsProbabilityMeasure μ] :
    StronglyMeasurable
      (fun p : Content D =>
        SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ) := by
  letI : ∀ _ : Fin P, IsProbabilityMeasure μ := fun _ => inferInstance
  have hjoint : StronglyMeasurable
      (fun z : Content D × (Fin P → Content D) =>
        usersWon users (deviateProfile z.2 j z.1) j) := by
    apply Measurable.stronglyMeasurable
    apply (measurable_usersWon_deviateProfile_variable users j).comp
    exact continuous_fst.measurable.prodMk continuous_snd.measurable
  have hallocation : StronglyMeasurable
      (fun p : Content D =>
        ∫ profile : Fin P → Content D,
          usersWon users (deviateProfile profile j p) j ∂
            Measure.pi (fun _ : Fin P => μ)) := by
    exact hjoint.integral_prod_right
  change StronglyMeasurable
    (fun p : Content D =>
      ExpectedUsersWonAgainstSymmetricMixed users j p μ - cost p)
  exact hallocation.sub hcost.stronglyMeasurable

/--
The source pure-deviation payoff regarded as a function of a bundled
probability measure.  This form carries Mathlib's weak topology and is the
state space used by the corrected diagonal-security predicate.
-/
noncomputable def SourceMixedPurePayoffOnProbabilityMeasure {D N P : ℕ}
    (users : Fin N → Content D) (j : Fin P) (cost : Content D → ℝ)
    (p : Content D) (μ : ProbabilityMeasure (Content D)) : ℝ :=
  SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ.toMeasure

/--
The source pure-deviation payoff on the compact truncated mixed-action space.
Both the deviating pure action and the iid opponent law are constrained to the
same truncated source action set; the latter is pushed forward to the ambient
content law used by the original payoff semantics.
-/
noncomputable def SourceTruncatedMixedPurePayoff {D N P : ℕ}
    (users : Fin N → Content D) (ν : SourceNorm D) (R : ℝ)
    (j : Fin P) (cost : Content D → ℝ)
    (p : sourceTruncatedActionSet ν R)
    (μ : ProbabilityMeasure (sourceTruncatedActionSet ν R)) : ℝ :=
  SourceMixedPurePayoffOnProbabilityMeasure users j cost p.1
    (sourceTruncatedStrategyToMixedContent ν R μ)

/--
The compact-subtype-to-ambient mixed-strategy push-forward is weakly
continuous.  This makes ambient payoff-security neighborhoods available on
the compact action-space game by preimage.
-/
theorem continuous_sourceTruncatedStrategyToMixedContent {D : ℕ}
    (ν : SourceNorm D) (R : ℝ) :
    Continuous fun μ : ProbabilityMeasure (sourceTruncatedActionSet ν R) =>
      sourceTruncatedStrategyToMixedContent ν R μ := by
  unfold sourceTruncatedStrategyToMixedContent
  exact ProbabilityMeasure.continuous_map continuous_subtype_val

/--
For a fixed compact-subtype opponent law, the source payoff is strongly
measurable as a function of the pure action.  The expected allocation term is
obtained by Fubini from the jointly measurable variable-deviation payoff; no
continuity of uniform-tie allocation is assumed.
-/
theorem stronglyMeasurable_sourceTruncatedMixedPurePayoff
    {D N P : ℕ} (users : Fin N → Content D) (ν : SourceNorm D) (R : ℝ)
    (j : Fin P) (cost : Content D → ℝ) (hcost : Continuous cost)
    (μ : ProbabilityMeasure (sourceTruncatedActionSet ν R)) :
    StronglyMeasurable
      (fun p : sourceTruncatedActionSet ν R =>
        SourceTruncatedMixedPurePayoff users ν R j cost p μ) := by
  simpa [SourceTruncatedMixedPurePayoff] using
    (stronglyMeasurable_sourceMixedPurePayoff users j cost hcost
      (sourceTruncatedStrategyToMixedContent ν R μ).toMeasure).comp_measurable
        continuous_subtype_val.measurable

/--
Every compact-truncated source mixed payoff is integrable against every mixed
deviation law.  The allocation term is bounded between zero and the number of
users, while continuity makes the cost bounded on the compact action set.
-/
theorem integrable_sourceTruncatedMixedPurePayoff
    {D N P : ℕ} [Nonempty (Fin P)] (users : Fin N → Content D)
    (ν : SourceNorm D) (R : ℝ) (hcompact : SourceNormCompactSublevels ν)
    (j : Fin P) (cost : Content D → ℝ) (hcost : Continuous cost)
    (strategy state : ProbabilityMeasure (sourceTruncatedActionSet ν R)) :
    Integrable
      (fun p : sourceTruncatedActionSet ν R =>
        SourceTruncatedMixedPurePayoff users ν R j cost p state)
      strategy.toMeasure := by
  obtain ⟨C, hC⟩ := IsCompact.exists_bound_of_continuousOn
    (isCompact_sourceTruncatedActionSet_of_compactSublevels ν R hcompact) hcost.continuousOn
  refine Integrable.of_bound
    (stronglyMeasurable_sourceTruncatedMixedPurePayoff users ν R j cost hcost state).aestronglyMeasurable
      ((N : ℝ) + C) ?_
  filter_upwards with p
  have hallocation_nonneg : 0 ≤
      ExpectedUsersWonAgainstSymmetricMixed users j p.1
        (sourceTruncatedStrategyToMixedContent ν R state).toMeasure :=
    expectedUsersWonAgainstSymmetricMixed_nonneg
  have hallocation_le :
      ExpectedUsersWonAgainstSymmetricMixed users j p.1
        (sourceTruncatedStrategyToMixedContent ν R state).toMeasure ≤ (N : ℝ) :=
    expectedUsersWonAgainstSymmetricMixed_le_card
      (integrable_usersWon_deviateProfile_const users j p.1)
  have hallocation_norm : ‖ExpectedUsersWonAgainstSymmetricMixed users j p.1
        (sourceTruncatedStrategyToMixedContent ν R state).toMeasure‖ ≤ (N : ℝ) := by
    rw [Real.norm_eq_abs, abs_of_nonneg hallocation_nonneg]
    exact hallocation_le
  have hcost_bound : ‖cost p.1‖ ≤ C := hC p.1 p.2
  change ‖ExpectedUsersWonAgainstSymmetricMixed users j p.1
      (sourceTruncatedStrategyToMixedContent ν R state).toMeasure - cost p.1‖ ≤
    (N : ℝ) + C
  exact (norm_sub_le _ _).trans (add_le_add hallocation_norm hcost_bound)

/--
The diagonal payoff of the compact mixed extension is exactly the source
diagonal payoff of its pushed-forward iid law.  This supplies the continuity
bridge needed by the compact KKM existence theorem; it is proved by the
finite-coordinate iid identity and compact integrability, not assumed from a
formal similarity of the two expressions.
-/
theorem mixedExtensionPayoff_sourceTruncatedMixedPurePayoff_diagonal_eq_sourceTruncatedDiagonalPayoff
    {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (ν : SourceNorm D) (R : ℝ)
    (hcompact : SourceNormCompactSublevels ν) (cost : Content D → ℝ)
    (hcost : Continuous cost)
    (state : ProbabilityMeasure (sourceTruncatedActionSet ν R)) (j : Fin P) :
    AppliedModelingLib.MixedExtensionPayoff
      (SourceTruncatedMixedPurePayoff users ν R j cost) state state =
      SourceTruncatedDiagonalPayoff (N := N) (P := P) ν R cost state := by
  let μ : ProbabilityMeasure (Content D) :=
    sourceTruncatedStrategyToMixedContent ν R state
  have hcost_subtype : Integrable
      (fun p : sourceTruncatedActionSet ν R => cost p.1) state.toMeasure :=
    integrable_sourceTruncatedCost ν R hcompact cost hcost state
  have hsource_subtype : Integrable
      (fun p : sourceTruncatedActionSet ν R =>
        SourceTruncatedMixedPurePayoff users ν R j cost p state) state.toMeasure :=
    integrable_sourceTruncatedMixedPurePayoff users ν R hcompact j cost hcost state state
  have hcost_ambient : Integrable cost μ.toMeasure := by
    unfold μ sourceTruncatedStrategyToMixedContent
    rw [ProbabilityMeasure.toMeasure_map]
    apply (MeasureTheory.integrable_map_measure hcost.stronglyMeasurable.aestronglyMeasurable
      continuous_subtype_val.measurable.aemeasurable).mpr
    exact hcost_subtype
  have hsource_ambient : Integrable
      (fun p => SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ.toMeasure)
      μ.toMeasure := by
    unfold μ sourceTruncatedStrategyToMixedContent
    rw [ProbabilityMeasure.toMeasure_map]
    apply (MeasureTheory.integrable_map_measure
      (stronglyMeasurable_sourceMixedPurePayoff users j cost hcost
        (sourceTruncatedStrategyToMixedContent ν R state).toMeasure).aestronglyMeasurable
      continuous_subtype_val.measurable.aemeasurable).mpr
    simpa [SourceTruncatedMixedPurePayoff, SourceMixedPurePayoffOnProbabilityMeasure] using
      hsource_subtype
  have hmap_integral :
      (∫ p, SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ.toMeasure
        ∂μ.toMeasure) =
        ∫ p : sourceTruncatedActionSet ν R,
          SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p.1 μ.toMeasure
          ∂state.toMeasure := by
    unfold μ sourceTruncatedStrategyToMixedContent
    rw [ProbabilityMeasure.toMeasure_map]
    exact MeasureTheory.integral_map continuous_subtype_val.measurable.aemeasurable
      (stronglyMeasurable_sourceMixedPurePayoff users j cost hcost
        (sourceTruncatedStrategyToMixedContent ν R state).toMeasure).aestronglyMeasurable
  have hsource_diagonal :
      (∫ p, SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ.toMeasure
        ∂μ.toMeasure) = SourceSymmetricMixedDiagonalPayoff users cost j μ.toMeasure :=
    integral_sourceMixedPurePayoff_eq_sourceSymmetricMixedDiagonalPayoff
      users cost j μ.toMeasure hcost_ambient hsource_ambient
  change (∫ p : sourceTruncatedActionSet ν R,
      SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p.1 μ.toMeasure
      ∂state.toMeasure) = SourceTruncatedDiagonalPayoff (N := N) (P := P) ν R cost state
  calc
    (∫ p : sourceTruncatedActionSet ν R,
        SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p.1 μ.toMeasure
        ∂state.toMeasure) =
        ∫ p, SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ.toMeasure
          ∂μ.toMeasure := hmap_integral.symm
    _ = SourceSymmetricMixedDiagonalPayoff users cost j μ.toMeasure := hsource_diagonal
    _ = SourceTruncatedDiagonalPayoff (N := N) (P := P) ν R cost state :=
      sourceSymmetricMixedDiagonalPayoff_sourceTruncatedStrategy users ν R hcompact cost state j

/--
The source uniform-tie game is mixed-quasi-symmetric in Plan's precise sense:
for a fixed pure deviation and a common mixed law of all opponents, the payoff
does not depend on the focal producer label.  This verifies the corrected
Corollary 5.3 symmetry hypothesis at the payoff level; it is separate from the
remaining external existence theorem and security-lift obligations.
-/
theorem mixedQuasiSymmetric_sourceMixedPurePayoffOnProbabilityMeasure
    {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (cost : Content D → ℝ) :
    AppliedModelingLib.MixedQuasiSymmetric
      (fun j : Fin P => SourceMixedPurePayoffOnProbabilityMeasure users j cost) := by
  intro j k p μ
  change ExpectedUsersWonAgainstSymmetricMixed users j p μ.toMeasure - cost p =
    ExpectedUsersWonAgainstSymmetricMixed users k p μ.toMeasure - cost p
  rw [expectedUsersWonAgainstSymmetricMixed_eq_of_focalProducer users μ.toMeasure j k p]

/--
Plan's exact mixed-quasi-symmetry condition also holds on every compact
truncated source action space.  The opponent law is pushed forward to ambient
content before applying the focal-label invariance proof.
-/
theorem mixedQuasiSymmetric_sourceTruncatedMixedPurePayoff
    {D N P : ℕ} [Nonempty (Fin P)]
    (users : Fin N → Content D) (ν : SourceNorm D) (R : ℝ)
    (cost : Content D → ℝ) :
    AppliedModelingLib.MixedQuasiSymmetric
      (fun j : Fin P => SourceTruncatedMixedPurePayoff users ν R j cost) := by
  intro j k p μ
  exact mixedQuasiSymmetric_sourceMixedPurePayoffOnProbabilityMeasure users cost j k p
    (sourceTruncatedStrategyToMixedContent ν R μ)

/--
An executable Lévy--Prokhorov radius is a weak-topology payoff-security
neighborhood on the bundled probability-measure space.
-/
theorem securesPayoffAt_sourceMixedPurePayoffOnProbabilityMeasure_of_prokhorovEDistNeighborhood
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D} {j : Fin P}
    {μ : ProbabilityMeasure (Content D)}
    {p : Content D} {cost : Content D → ℝ} {α : ℝ}
    (hlocal : ∃ ε : ENNReal, ε ≠ ⊤ ∧ 0 < ε ∧
      ∀ ν : Measure (Content D), IsProbabilityMeasure ν →
        levyProkhorovEDist μ.toMeasure ν < ε →
          α < ExpectedUsersWonAgainstSymmetricMixed users j p ν - cost p) :
    AppliedModelingLib.SecuresPayoffAt
      (SourceMixedPurePayoffOnProbabilityMeasure users j cost) p α μ := by
  obtain ⟨ε, hεtop, hεpos, hsecure⟩ := hlocal
  let U : Set (ProbabilityMeasure (Content D)) :=
    {ν | dist (LevyProkhorov.ofMeasure ν) (LevyProkhorov.ofMeasure μ) < ε.toReal}
  have hεreal : 0 < ε.toReal := ENNReal.toReal_pos hεpos.ne' hεtop
  have hUopen : IsOpen U := by
    simpa [U] using isOpen_content_levyProkhorovBall μ ε.toReal
  have hμU : μ ∈ U := by
    simp [U, hεreal]
  refine ⟨U, hUopen.mem_nhds hμU, ?_⟩
  intro μ' hμ'
  have hdist_real :
      dist (LevyProkhorov.ofMeasure μ') (LevyProkhorov.ofMeasure μ) < ε.toReal := by
    simpa [U] using hμ'
  have hdist_edist :
      edist (LevyProkhorov.ofMeasure μ') (LevyProkhorov.ofMeasure μ) <
        ENNReal.ofReal ε.toReal :=
    (edist_lt_ofReal).mpr hdist_real
  have hdist : levyProkhorovEDist μ.toMeasure μ'.toMeasure < ε := by
    rw [LevyProkhorov.edist_probabilityMeasure_def, ENNReal.ofReal_toReal hεtop] at hdist_edist
    simpa [levyProkhorovEDist_comm] using hdist_edist
  change α < ExpectedUsersWonAgainstSymmetricMixed users j p μ'.toMeasure - cost p
  exact hsecure μ'.toMeasure inferInstance hdist

/--
The finite L1-score-margin calculation yields genuine local payoff security in
the weak topology on bundled probability measures.  This is a topological
security statement, not only an inequality indexed by an informal
``sufficiently small'' radius.
-/
theorem securesPayoffAt_sourceMixedPurePayoffOnProbabilityMeasure_of_l1ScoreMarginSlack
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D} {j : Fin P}
    {μ : ProbabilityMeasure (Content D)}
    {p : Content D} {cost : Content D → ℝ} {α margin : ℝ}
    (hmargin : 0 < margin)
    (hprofit : α <
      (∑ i : Fin N,
        (μ.toMeasure.real {q : Content D | score (users i) q < score (users i) p -
          margin * AppliedModelingLib.FiniteDimensionalNorms.l1 (users i)}) ^ (P - 1)) - cost p) :
    AppliedModelingLib.SecuresPayoffAt
      (SourceMixedPurePayoffOnProbabilityMeasure users j cost) p α μ := by
  apply securesPayoffAt_sourceMixedPurePayoffOnProbabilityMeasure_of_prokhorovEDistNeighborhood
  exact exists_prokhorovEDist_neighborhood_payoff_gt_of_l1ScoreMarginSlack
      (users := users) (j := j) (μ := μ.toMeasure) (p := p) (cost := cost)
      (α := α) (margin := margin) hmargin hprofit

/--
Compact-action topological security for a profitable pure deviation.  The
securing action is a member of the source truncated action set and secures its
payoff on a genuine weak neighborhood of the baseline probability measure.
-/
theorem exists_securesPayoffAt_sourceMixedPurePayoffOnProbabilityMeasure_within_sourceTruncatedActionSet
    {D N P : ℕ} [Nonempty (Fin P)] {users : Fin N → Content D} {j : Fin P}
    {μ : ProbabilityMeasure (Content D)}
    {p : Content D} {cost : Content D → ℝ} {ν : SourceNorm D} {R α : ℝ}
    (husers_nonnegative : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hp : NonnegativeContent p) (hcont : PerturbationCostContinuous cost)
    (hνcont : Continuous ν.norm) (hpR : ν.norm p < R)
    (hprofit : SourceMixedPurePayoffOnProbabilityMeasure users j cost p μ > α) :
    ∃ psec : Content D, psec ∈ sourceTruncatedActionSet ν R ∧
      AppliedModelingLib.SecuresPayoffAt
        (SourceMixedPurePayoffOnProbabilityMeasure users j cost) psec α μ := by
  obtain ⟨psec, hpsec, ε, hεtop, hεpos, hsecure⟩ :=
    exists_l1ScoreMargin_secure_payoff_neighborhood_of_profitable_deviation_within_sourceTruncatedActionSet
      (users := users) (μ := μ.toMeasure) (p := p) (j := j) (cost := cost)
      (ν := ν) (R := R) (α := α)
      husers_nonnegative husers_nonzero hp hcont hνcont hpR
      (by simpa [SourceMixedPurePayoffOnProbabilityMeasure, SourceMixedPurePayoff] using hprofit)
  refine ⟨psec, hpsec, ?_⟩
  apply securesPayoffAt_sourceMixedPurePayoffOnProbabilityMeasure_of_prokhorovEDistNeighborhood
  exact ⟨ε, hεtop, hεpos, hsecure⟩

/--
For two users, absolutely continuous raw score laws turn the actual
uniform-tie payoff into the sum of the two iid maximum-CDF values, minus the
given cost. This is the source payoff reparameterization used in
`supportrestriction`; it is proved from the product-law identity rather than
assumed as C1.
-/
theorem twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
    {D P : ℕ} {users : Fin 2 → Content D} {j : Fin P}
    {μ : Measure (Content D)} [IsProbabilityMeasure μ]
    {cost : Content D → ℝ} (p : Content D)
    (hmeas_score : ∀ i : Fin 2, Measurable (fun q : Content D => score (users i) q))
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (users i) q) μ ≪ volume) :
    SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ =
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content D => score (users 0) q) μ)
        (score (users 0) p) +
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content D => score (users 1) q) μ)
          (score (users 1) p) - cost p := by
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content D => score (users 0) q) μ) :=
    Measure.isProbabilityMeasure_map (hmeas_score 0).aemeasurable
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content D => score (users 1) q) μ) :=
    Measure.isProbabilityMeasure_map (hmeas_score 1).aemeasurable
  unfold SourceMixedPurePayoff
  rw [expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass_of_scoreLaw_absolutelyContinuous
    p hmeas_score hscore_ac, Fin.sum_univ_two]
  rw [score_lt_measureReal_eq_lowerCDFMass_map_of_score_law_absolutelyContinuous
    (hmeas_score 0) (hscore_ac 0),
    score_lt_measureReal_eq_lowerCDFMass_map_of_score_law_absolutelyContinuous
      (hmeas_score 1) (hscore_ac 1)]
  rw [← AppliedModelingLib.Probability.iidMaximumCdf_eq_lowerCDFMass_pow,
    ← AppliedModelingLib.Probability.iidMaximumCdf_eq_lowerCDFMass_pow]

private theorem pTwoStandardBasisScore_zero_eq_coordinate
    (p : Content 2) :
    score (pTwoStandardBasisUsers 0) p = p 0 := by
  simp [score, pTwoStandardBasisUsers, content2]

private theorem pTwoStandardBasisScore_one_eq_coordinate
    (p : Content 2) :
    score (pTwoStandardBasisUsers 1) p = p 1 := by
  simp [score, pTwoStandardBasisUsers, content2]

private theorem pTwoContentOfCoordinates_standardBasisValueMap
    (p : Content 2) :
    pTwoContentOfCoordinates (pTwoStandardBasisValueMap p) = p := by
  ext d
  fin_cases d <;>
    simp [pTwoContentOfCoordinates, pTwoStandardBasisValueMap, score,
      pTwoStandardBasisUsers, content2, Fin.sum_univ_two]

private theorem pTwoL2RpowCost_eq_standardBasisCoordinateCost
    (beta : ℝ) (p : Content 2) :
    normRpowCost (SourceNorm.l2 2) beta p =
      (score (pTwoStandardBasisUsers 0) p ^ 2 +
        score (pTwoStandardBasisUsers 1) p ^ 2) ^ (beta / 2) := by
  have hsum_nonneg : 0 ≤ p 0 ^ 2 + p 1 ^ 2 := by
    positivity
  unfold normRpowCost
  change AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ beta = _
  rw [AppliedModelingLib.FiniteDimensionalNorms.normL2_eq_sqrt_sum_sq,
    Fin.sum_univ_two]
  rw [← Real.rpow_div_two_eq_sqrt beta hsum_nonneg]
  rw [pTwoStandardBasisScore_zero_eq_coordinate,
    pTwoStandardBasisScore_one_eq_coordinate]

/--
The source Lemma `inducedcost` cost identity in canonical two-user
coordinates.  Unlike the printed generic C1 statement, this is an equality
for the original content-space cost `α ‖p‖₂^β`, obtained from the invertible
coordinate map rather than by defining a value-space cost in its place.
-/
theorem scaledNormRpowCost_l2_eq_twoUserInducedCost_of_canonicalValue
    {α β θ : ℝ} (hsin : 0 < Real.sin θ) (p : Content 2) :
    α * normRpowCost (SourceNorm.l2 2) β p =
      twoUserInducedCost α β θ
        (canonicalTwoUserValueMap θ p).1 (canonicalTwoUserValueMap θ p).2 := by
  have hsum_nonneg : 0 ≤ p 0 ^ 2 + p 1 ^ 2 := by
    positivity
  have hsin_ne : Real.sin θ ≠ 0 := ne_of_gt hsin
  have hnum :
      twoUserInducedCostNumerator θ
          (canonicalTwoUserValueMap θ p).1
          (canonicalTwoUserValueMap θ p).2 =
        (Real.sin θ) ^ 2 * (p 0 ^ 2 + p 1 ^ 2) := by
    have hp : p = content2 (p 0) (p 1) := by
      ext d
      fin_cases d <;> simp
    rw [hp]
    simp [twoUserInducedCostNumerator, canonicalTwoUserValueMap,
      canonicalTwoUserFirst, canonicalTwoUserSecond, score_content2]
    have htrig : Real.sin θ ^ 2 + Real.cos θ ^ 2 = 1 :=
      Real.sin_sq_add_cos_sq θ
    ring_nf
    nlinarith
  rw [pTwoL2RpowCost_eq_standardBasisCoordinateCost,
    pTwoStandardBasisScore_zero_eq_coordinate,
    pTwoStandardBasisScore_one_eq_coordinate]
  unfold twoUserInducedCost
  rw [hnum, Real.mul_rpow (sq_nonneg (Real.sin θ)) hsum_nonneg]
  have hsinpow : ((Real.sin θ) ^ 2) ^ (β / 2) = (Real.sin θ) ^ β := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hsin.le]
    congr 1
    ring
  rw [hsinpow, Real.rpow_neg hsin.le]
  field_simp [ne_of_gt (Real.rpow_pos_of_pos hsin β)]

/--
The canonical two-user content objective for a common conditional-quality CDF
and two equal-weight genres.  It is the C1 payoff from the finite-genre
infinite-producer definition, evaluated on a nonnegative content action.
-/
noncomputable def correctedInfiniteTwoGenreContentObjective
    (F : ℝ → ℝ) (beta theta : ℝ) (d1 d2 p : Content 2) : ℝ :=
  Real.sqrt (F (score canonicalTwoUserFirst p / score canonicalTwoUserFirst d1) *
      F (score canonicalTwoUserFirst p / score canonicalTwoUserFirst d2)) +
    Real.sqrt (F (score (canonicalTwoUserSecond theta) p /
      score (canonicalTwoUserSecond theta) d1) *
      F (score (canonicalTwoUserSecond theta) p /
        score (canonicalTwoUserSecond theta) d2)) -
    normRpowCost (SourceNorm.l2 2) beta p

/--
The canonical content objective equals its score-coordinate expression when
the two genre directions have cross scores `(A,B)` and `(B,A)`.  The equality
uses the original Euclidean content cost, rather than a separately defined
score-space cost.
-/
theorem correctedInfiniteTwoGenreContentObjective_eq_scoreObjective
    {F : ℝ → ℝ} {beta theta A B : ℝ} {d1 d2 p : Content 2}
    (hsin : 0 < Real.sin theta)
    (h11 : score canonicalTwoUserFirst d1 = A)
    (h12 : score canonicalTwoUserFirst d2 = B)
    (h21 : score (canonicalTwoUserSecond theta) d1 = B)
    (h22 : score (canonicalTwoUserSecond theta) d2 = A) :
    correctedInfiniteTwoGenreContentObjective F beta theta d1 d2 p =
      correctedInfiniteTwoGenreScoreObjective F beta A B theta
        (canonicalTwoUserValueMap theta p).1
        (canonicalTwoUserValueMap theta p).2 := by
  have hcost : normRpowCost (SourceNorm.l2 2) beta p =
      twoUserInducedCost 1 beta theta
        (canonicalTwoUserValueMap theta p).1
        (canonicalTwoUserValueMap theta p).2 := by
    simpa using
      (scaledNormRpowCost_l2_eq_twoUserInducedCost_of_canonicalValue
        (α := 1) (β := beta) hsin p)
  simp only [correctedInfiniteTwoGenreContentObjective,
    correctedInfiniteTwoGenreScoreObjective, h11, h12, h21, h22, hcost,
    canonicalTwoUserValueMap]
  rw [mul_comm (F (score canonicalTwoUserFirst p / A))]

/-- The first canonical two-genre content direction. -/
noncomputable def infiniteGenreFirstGenre (phi : ℝ) : Content 2 :=
  content2 (Real.cos phi) (Real.sin phi)

/-- The second canonical two-genre content direction. -/
noncomputable def infiniteGenreSecondGenre (theta phi : ℝ) : Content 2 :=
  content2 (Real.cos (theta - phi)) (Real.sin (theta - phi))

/--
Canonical two-genre equilibrium data in the source content space.  It records
nonnegative unit genre directions, probability-normalized conditional quality,
genre weights, and C1 optimality against every nonnegative content action.
-/
structure CorrectedInfiniteTwoGenreContentEquilibrium
    (F : ℝ → ℝ) (beta theta : ℝ) where
  firstGenre : Content 2
  secondGenre : Content 2
  firstGenre_nonnegative : NonnegativeContent firstGenre
  secondGenre_nonnegative : NonnegativeContent secondGenre
  firstGenre_l2_norm : (SourceNorm.l2 2).norm firstGenre = 1
  secondGenre_l2_norm : (SourceNorm.l2 2).norm secondGenre = 1
  conditionalQuality : Measure ℝ
  conditionalQuality_probability : IsProbabilityMeasure conditionalQuality
  conditionalQuality_cdf : ∀ q : ℝ,
    conditionalQuality (Set.Iic q) = ENNReal.ofReal (F q)
  conditionalQuality_support_nonnegative :
    conditionalQuality.support ⊆ Set.Ici 0
  firstWeight : ℝ
  secondWeight : ℝ
  firstWeight_nonnegative : 0 ≤ firstWeight
  secondWeight_nonnegative : 0 ≤ secondWeight
  firstWeight_eq_half : firstWeight = 1 / 2
  secondWeight_eq_half : secondWeight = 1 / 2
  weights_sum : firstWeight + secondWeight = 1
  first_support_maximizes : ∀ ⦃r : ℝ⦄,
    r ∈ conditionalQuality.support →
      scaleContent r firstGenre ∈ {p : Content 2 | NonnegativeContent p} ∧
        IsMaxOn
          (correctedInfiniteTwoGenreContentObjective F beta theta firstGenre secondGenre)
          {p : Content 2 | NonnegativeContent p}
          (scaleContent r firstGenre)
  second_support_maximizes : ∀ ⦃r : ℝ⦄,
    r ∈ conditionalQuality.support →
      scaleContent r secondGenre ∈ {p : Content 2 | NonnegativeContent p} ∧
        IsMaxOn
          (correctedInfiniteTwoGenreContentObjective F beta theta firstGenre secondGenre)
          {p : Content 2 | NonnegativeContent p}
          (scaleContent r secondGenre)

private theorem infiniteGenreFirstGenre_nonnegative
    {phi A : ℝ} (hA_nonneg : 0 ≤ A) (hA : A = Real.cos phi)
    (hsin : 0 ≤ Real.sin phi) :
    NonnegativeContent (infiniteGenreFirstGenre phi) := by
  intro d
  fin_cases d
  · simpa [infiniteGenreFirstGenre, hA] using hA_nonneg
  · simpa [infiniteGenreFirstGenre] using hsin

private theorem infiniteGenreSecondGenre_nonnegative
    {theta phi B : ℝ} (hB_nonneg : 0 ≤ B) (hB : B = Real.cos (theta - phi))
    (hsin : 0 ≤ Real.sin (theta - phi)) :
    NonnegativeContent (infiniteGenreSecondGenre theta phi) := by
  intro d
  fin_cases d
  · simpa [infiniteGenreSecondGenre, hB] using hB_nonneg
  · simpa [infiniteGenreSecondGenre] using hsin

private theorem canonicalTwoUserValueMap_nonnegative_of_nonnegativeContent
    {theta : ℝ} {p : Content 2}
    (hcos : 0 ≤ Real.cos theta) (hsin : 0 ≤ Real.sin theta)
    (hp : NonnegativeContent p) :
    canonicalTwoUserValueMap theta p ∈ Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ) := by
  constructor
  · simpa [canonicalTwoUserValueMap, canonicalTwoUserFirst, score,
      content2, Fin.sum_univ_two] using hp 0
  · have hsum := add_nonneg (mul_nonneg hcos (hp 0)) (mul_nonneg hsin (hp 1))
    simpa [canonicalTwoUserValueMap, canonicalTwoUserSecond, score,
      content2, Fin.sum_univ_two] using hsum

private theorem canonicalTwoUserValueMap_content2_angleRadius_early
    (theta phi r : ℝ) :
    canonicalTwoUserValueMap theta
      (content2 (r * Real.cos phi) (r * Real.sin phi)) =
        (r * Real.cos phi, r * Real.cos (theta - phi)) := by
  ext
  · simp [canonicalTwoUserValueMap, canonicalTwoUserFirst, score_content2]
  · simp [canonicalTwoUserValueMap, canonicalTwoUserSecond, score_content2]
    rw [Real.cos_sub]
    ring

private theorem canonicalTwoUserValueMap_scale_infiniteGenreFirstGenre
    {theta phi A B r : ℝ}
    (hA : A = Real.cos phi)
    (hB : B = Real.cos (theta - phi)) :
    canonicalTwoUserValueMap theta (scaleContent r (infiniteGenreFirstGenre phi)) =
      (r * A, r * B) := by
  have hscale : scaleContent r (infiniteGenreFirstGenre phi) =
      content2 (r * Real.cos phi) (r * Real.sin phi) := by
    ext d
    fin_cases d <;> simp [infiniteGenreFirstGenre, scaleContent, content2]
  rw [hscale, canonicalTwoUserValueMap_content2_angleRadius_early]
  simp only [hA, hB]

private theorem canonicalTwoUserValueMap_scale_infiniteGenreSecondGenre
    {theta phi A B r : ℝ}
    (hA : A = Real.cos phi)
    (hB : B = Real.cos (theta - phi)) :
    canonicalTwoUserValueMap theta
      (scaleContent r (infiniteGenreSecondGenre theta phi)) =
      (r * B, r * A) := by
  have hscale : scaleContent r (infiniteGenreSecondGenre theta phi) =
      content2 (r * Real.cos (theta - phi)) (r * Real.sin (theta - phi)) := by
    ext d
    fin_cases d <;> simp [infiniteGenreSecondGenre, scaleContent, content2]
  rw [hscale, canonicalTwoUserValueMap_content2_angleRadius_early]
  simp only [hB]
  have hangle : theta - (theta - phi) = phi := by ring
  rw [hangle, hA]

/--
The geometric-shell candidate realizes a corrected two-genre equilibrium in
the canonical nonnegative content model.  In addition to the candidate's
cutoff and angular hypotheses, the direction sine conditions make both genre
vectors source-feasible.
-/
noncomputable def infiniteGenreCandidate_correctedInfiniteTwoGenreContentEquilibrium
    {a C1 C2 beta A B theta phi : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hbalance : C1 = 1 + C2 ^ beta)
    (hA : 0 < A) (hB : 0 < B) (hratio : C2 = B / A)
    (hsin : 0 < Real.sin theta) (hcos : 0 ≤ Real.cos theta)
    (hphi_sin : 0 ≤ Real.sin phi)
    (hother_sin : 0 ≤ Real.sin (theta - phi))
    (hA_angle : A = Real.cos phi)
    (hB_angle : B = Real.cos (theta - phi))
    (hglobal : ∀ psi : ℝ, 0 ≤ Real.cos psi →
      0 ≤ Real.cos (theta - psi) →
      (Real.cos psi) ^ beta + (Real.cos (theta - psi)) ^ beta ≤
        A ^ beta + B ^ beta) :
    CorrectedInfiniteTwoGenreContentEquilibrium
      (infiniteGenreCandidateCdf a C1 C2 beta) beta theta := by
  let scoreEquilibrium :=
    infiniteGenreCandidate_correctedInfiniteTwoGenreScoreEquilibrium
      ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio hsin
      hA_angle hB_angle hglobal
  have hfirst_nonnegative : NonnegativeContent (infiniteGenreFirstGenre phi) :=
    infiniteGenreFirstGenre_nonnegative hA.le hA_angle hphi_sin
  have hsecond_nonnegative : NonnegativeContent (infiniteGenreSecondGenre theta phi) :=
    infiniteGenreSecondGenre_nonnegative hB.le hB_angle hother_sin
  have hfirst_values : canonicalTwoUserValueMap theta (infiniteGenreFirstGenre phi) =
      (A, B) := by
    simpa [infiniteGenreFirstGenre, scaleContent] using
      (canonicalTwoUserValueMap_scale_infiniteGenreFirstGenre
        (theta := theta) (phi := phi) (A := A) (B := B) (r := 1)
        hA_angle hB_angle)
  have hsecond_values : canonicalTwoUserValueMap theta
      (infiniteGenreSecondGenre theta phi) = (B, A) := by
    simpa [infiniteGenreSecondGenre, scaleContent] using
      (canonicalTwoUserValueMap_scale_infiniteGenreSecondGenre
        (theta := theta) (phi := phi) (A := A) (B := B) (r := 1)
        hA_angle hB_angle)
  have h11 : score canonicalTwoUserFirst (infiniteGenreFirstGenre phi) = A := by
    simpa [canonicalTwoUserValueMap] using congrArg Prod.fst hfirst_values
  have h12 : score canonicalTwoUserFirst (infiniteGenreSecondGenre theta phi) = B := by
    simpa [canonicalTwoUserValueMap] using congrArg Prod.fst hsecond_values
  have h21 : score (canonicalTwoUserSecond theta) (infiniteGenreFirstGenre phi) = B := by
    simpa [canonicalTwoUserValueMap] using congrArg Prod.snd hfirst_values
  have h22 : score (canonicalTwoUserSecond theta)
      (infiniteGenreSecondGenre theta phi) = A := by
    simpa [canonicalTwoUserValueMap] using congrArg Prod.snd hsecond_values
  refine
    { firstGenre := infiniteGenreFirstGenre phi
      secondGenre := infiniteGenreSecondGenre theta phi
      firstGenre_nonnegative := hfirst_nonnegative
      secondGenre_nonnegative := hsecond_nonnegative
      firstGenre_l2_norm := by
        simpa [infiniteGenreFirstGenre] using l2_norm_content2_cos_sin phi
      secondGenre_l2_norm := by
        simpa [infiniteGenreSecondGenre] using
          l2_norm_content2_cos_sin (theta - phi)
      conditionalQuality := scoreEquilibrium.conditionalQuality
      conditionalQuality_probability := scoreEquilibrium.conditionalQuality_probability
      conditionalQuality_cdf := scoreEquilibrium.conditionalQuality_cdf
      conditionalQuality_support_nonnegative :=
        scoreEquilibrium.conditionalQuality_support_nonnegative
      firstWeight := 1 / 2
      secondWeight := 1 / 2
      firstWeight_nonnegative := by norm_num
      secondWeight_nonnegative := by norm_num
      firstWeight_eq_half := rfl
      secondWeight_eq_half := rfl
      weights_sum := by norm_num
      first_support_maximizes := ?_
      second_support_maximizes := ?_ }
  · intro r hr
    constructor
    · exact scaleContent_nonnegative
        (scoreEquilibrium.conditionalQuality_support_nonnegative hr)
        hfirst_nonnegative
    · intro p hp
      have hp_values := canonicalTwoUserValueMap_nonnegative_of_nonnegativeContent
        hcos hsin.le hp
      have hscore_max := (scoreEquilibrium.first_support_maximizes hr).2
      change ∀ z ∈ Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ),
        correctedInfiniteTwoGenreScoreObjective
          (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta z.1 z.2 ≤
          correctedInfiniteTwoGenreScoreObjective
            (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta
              (r * A) (r * B) at hscore_max
      calc
        correctedInfiniteTwoGenreContentObjective
            (infiniteGenreCandidateCdf a C1 C2 beta) beta theta
            (infiniteGenreFirstGenre phi) (infiniteGenreSecondGenre theta phi) p =
            correctedInfiniteTwoGenreScoreObjective
              (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta
              (canonicalTwoUserValueMap theta p).1
              (canonicalTwoUserValueMap theta p).2 :=
          correctedInfiniteTwoGenreContentObjective_eq_scoreObjective
            hsin h11 h12 h21 h22
        _ ≤ correctedInfiniteTwoGenreScoreObjective
              (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta
              (r * A) (r * B) :=
          hscore_max _ hp_values
        _ = correctedInfiniteTwoGenreScoreObjective
              (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta
              (canonicalTwoUserValueMap theta
                (scaleContent r (infiniteGenreFirstGenre phi))).1
              (canonicalTwoUserValueMap theta
                (scaleContent r (infiniteGenreFirstGenre phi))).2 := by
          rw [canonicalTwoUserValueMap_scale_infiniteGenreFirstGenre
            hA_angle hB_angle]
        _ = correctedInfiniteTwoGenreContentObjective
              (infiniteGenreCandidateCdf a C1 C2 beta) beta theta
              (infiniteGenreFirstGenre phi) (infiniteGenreSecondGenre theta phi)
              (scaleContent r (infiniteGenreFirstGenre phi)) :=
          (correctedInfiniteTwoGenreContentObjective_eq_scoreObjective
            hsin h11 h12 h21 h22).symm
  · intro r hr
    constructor
    · exact scaleContent_nonnegative
        (scoreEquilibrium.conditionalQuality_support_nonnegative hr)
        hsecond_nonnegative
    · intro p hp
      have hp_values := canonicalTwoUserValueMap_nonnegative_of_nonnegativeContent
        hcos hsin.le hp
      have hscore_max := (scoreEquilibrium.second_support_maximizes hr).2
      change ∀ z ∈ Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ),
        correctedInfiniteTwoGenreScoreObjective
          (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta z.1 z.2 ≤
          correctedInfiniteTwoGenreScoreObjective
            (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta
              (r * B) (r * A) at hscore_max
      calc
        correctedInfiniteTwoGenreContentObjective
            (infiniteGenreCandidateCdf a C1 C2 beta) beta theta
            (infiniteGenreFirstGenre phi) (infiniteGenreSecondGenre theta phi) p =
            correctedInfiniteTwoGenreScoreObjective
              (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta
              (canonicalTwoUserValueMap theta p).1
              (canonicalTwoUserValueMap theta p).2 :=
          correctedInfiniteTwoGenreContentObjective_eq_scoreObjective
            hsin h11 h12 h21 h22
        _ ≤ correctedInfiniteTwoGenreScoreObjective
              (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta
              (r * B) (r * A) :=
          hscore_max _ hp_values
        _ = correctedInfiniteTwoGenreScoreObjective
              (infiniteGenreCandidateCdf a C1 C2 beta) beta A B theta
              (canonicalTwoUserValueMap theta
                (scaleContent r (infiniteGenreSecondGenre theta phi))).1
              (canonicalTwoUserValueMap theta
                (scaleContent r (infiniteGenreSecondGenre theta phi))).2 := by
          rw [canonicalTwoUserValueMap_scale_infiniteGenreSecondGenre
            hA_angle hB_angle]
        _ = correctedInfiniteTwoGenreContentObjective
              (infiniteGenreCandidateCdf a C1 C2 beta) beta theta
              (infiniteGenreFirstGenre phi) (infiniteGenreSecondGenre theta phi)
              (scaleContent r (infiniteGenreSecondGenre theta phi)) :=
          (correctedInfiniteTwoGenreContentObjective_eq_scoreObjective
            hsin h11 h12 h21 h22).symm

/--
Lift any canonical two-genre score equilibrium to the original nonnegative
two-coordinate content model when its two score directions have the displayed
angular realization.  This is a content-space C1 theorem: it uses the
Euclidean cost identity rather than replacing the source action space by score
coordinates.
-/
noncomputable def correctedInfiniteTwoGenreContentEquilibrium_of_scoreEquilibrium
    {F : ℝ → ℝ} {beta A B theta phi : ℝ}
    (scoreEquilibrium : CorrectedInfiniteTwoGenreScoreEquilibrium F beta A B theta)
    (hsin : 0 < Real.sin theta) (hcos : 0 ≤ Real.cos theta)
    (hA_nonnegative : 0 ≤ A) (hB_nonnegative : 0 ≤ B)
    (hphi_sin : 0 ≤ Real.sin phi)
    (hother_sin : 0 ≤ Real.sin (theta - phi))
    (hA_angle : A = Real.cos phi)
    (hB_angle : B = Real.cos (theta - phi)) :
    CorrectedInfiniteTwoGenreContentEquilibrium F beta theta := by
  have hfirst_nonnegative : NonnegativeContent (infiniteGenreFirstGenre phi) :=
    infiniteGenreFirstGenre_nonnegative hA_nonnegative hA_angle hphi_sin
  have hsecond_nonnegative : NonnegativeContent (infiniteGenreSecondGenre theta phi) :=
    infiniteGenreSecondGenre_nonnegative hB_nonnegative hB_angle hother_sin
  have hfirst_values : canonicalTwoUserValueMap theta (infiniteGenreFirstGenre phi) =
      (A, B) := by
    simpa [infiniteGenreFirstGenre, scaleContent] using
      (canonicalTwoUserValueMap_scale_infiniteGenreFirstGenre
        (theta := theta) (phi := phi) (A := A) (B := B) (r := 1)
        hA_angle hB_angle)
  have hsecond_values : canonicalTwoUserValueMap theta
      (infiniteGenreSecondGenre theta phi) = (B, A) := by
    simpa [infiniteGenreSecondGenre, scaleContent] using
      (canonicalTwoUserValueMap_scale_infiniteGenreSecondGenre
        (theta := theta) (phi := phi) (A := A) (B := B) (r := 1)
        hA_angle hB_angle)
  have h11 : score canonicalTwoUserFirst (infiniteGenreFirstGenre phi) = A := by
    simpa [canonicalTwoUserValueMap] using congrArg Prod.fst hfirst_values
  have h12 : score canonicalTwoUserFirst (infiniteGenreSecondGenre theta phi) = B := by
    simpa [canonicalTwoUserValueMap] using congrArg Prod.fst hsecond_values
  have h21 : score (canonicalTwoUserSecond theta) (infiniteGenreFirstGenre phi) = B := by
    simpa [canonicalTwoUserValueMap] using congrArg Prod.snd hfirst_values
  have h22 : score (canonicalTwoUserSecond theta)
      (infiniteGenreSecondGenre theta phi) = A := by
    simpa [canonicalTwoUserValueMap] using congrArg Prod.snd hsecond_values
  refine
    { firstGenre := infiniteGenreFirstGenre phi
      secondGenre := infiniteGenreSecondGenre theta phi
      firstGenre_nonnegative := hfirst_nonnegative
      secondGenre_nonnegative := hsecond_nonnegative
      firstGenre_l2_norm := by
        simpa [infiniteGenreFirstGenre] using l2_norm_content2_cos_sin phi
      secondGenre_l2_norm := by
        simpa [infiniteGenreSecondGenre] using
          l2_norm_content2_cos_sin (theta - phi)
      conditionalQuality := scoreEquilibrium.conditionalQuality
      conditionalQuality_probability := scoreEquilibrium.conditionalQuality_probability
      conditionalQuality_cdf := scoreEquilibrium.conditionalQuality_cdf
      conditionalQuality_support_nonnegative :=
        scoreEquilibrium.conditionalQuality_support_nonnegative
      firstWeight := 1 / 2
      secondWeight := 1 / 2
      firstWeight_nonnegative := by norm_num
      secondWeight_nonnegative := by norm_num
      firstWeight_eq_half := rfl
      secondWeight_eq_half := rfl
      weights_sum := by norm_num
      first_support_maximizes := ?_
      second_support_maximizes := ?_ }
  · intro r hr
    constructor
    · exact scaleContent_nonnegative
        (scoreEquilibrium.conditionalQuality_support_nonnegative hr)
        hfirst_nonnegative
    · intro p hp
      have hp_values := canonicalTwoUserValueMap_nonnegative_of_nonnegativeContent
        hcos hsin.le hp
      have hscore_max := (scoreEquilibrium.first_support_maximizes hr).2
      change ∀ z ∈ Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ),
        correctedInfiniteTwoGenreScoreObjective F beta A B theta z.1 z.2 ≤
          correctedInfiniteTwoGenreScoreObjective F beta A B theta
            (r * A) (r * B) at hscore_max
      calc
        correctedInfiniteTwoGenreContentObjective F beta theta
            (infiniteGenreFirstGenre phi) (infiniteGenreSecondGenre theta phi) p =
            correctedInfiniteTwoGenreScoreObjective F beta A B theta
              (canonicalTwoUserValueMap theta p).1
              (canonicalTwoUserValueMap theta p).2 :=
          correctedInfiniteTwoGenreContentObjective_eq_scoreObjective
            hsin h11 h12 h21 h22
        _ ≤ correctedInfiniteTwoGenreScoreObjective F beta A B theta
              (r * A) (r * B) :=
          hscore_max _ hp_values
        _ = correctedInfiniteTwoGenreScoreObjective F beta A B theta
              (canonicalTwoUserValueMap theta
                (scaleContent r (infiniteGenreFirstGenre phi))).1
              (canonicalTwoUserValueMap theta
                (scaleContent r (infiniteGenreFirstGenre phi))).2 := by
          rw [canonicalTwoUserValueMap_scale_infiniteGenreFirstGenre
            hA_angle hB_angle]
        _ = correctedInfiniteTwoGenreContentObjective F beta theta
              (infiniteGenreFirstGenre phi) (infiniteGenreSecondGenre theta phi)
              (scaleContent r (infiniteGenreFirstGenre phi)) :=
          (correctedInfiniteTwoGenreContentObjective_eq_scoreObjective
            hsin h11 h12 h21 h22).symm
  · intro r hr
    constructor
    · exact scaleContent_nonnegative
        (scoreEquilibrium.conditionalQuality_support_nonnegative hr)
        hsecond_nonnegative
    · intro p hp
      have hp_values := canonicalTwoUserValueMap_nonnegative_of_nonnegativeContent
        hcos hsin.le hp
      have hscore_max := (scoreEquilibrium.second_support_maximizes hr).2
      change ∀ z ∈ Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ),
        correctedInfiniteTwoGenreScoreObjective F beta A B theta z.1 z.2 ≤
          correctedInfiniteTwoGenreScoreObjective F beta A B theta
            (r * B) (r * A) at hscore_max
      calc
        correctedInfiniteTwoGenreContentObjective F beta theta
            (infiniteGenreFirstGenre phi) (infiniteGenreSecondGenre theta phi) p =
            correctedInfiniteTwoGenreScoreObjective F beta A B theta
              (canonicalTwoUserValueMap theta p).1
              (canonicalTwoUserValueMap theta p).2 :=
          correctedInfiniteTwoGenreContentObjective_eq_scoreObjective
            hsin h11 h12 h21 h22
        _ ≤ correctedInfiniteTwoGenreScoreObjective F beta A B theta
              (r * B) (r * A) :=
          hscore_max _ hp_values
        _ = correctedInfiniteTwoGenreScoreObjective F beta A B theta
              (canonicalTwoUserValueMap theta
                (scaleContent r (infiniteGenreSecondGenre theta phi))).1
              (canonicalTwoUserValueMap theta
                (scaleContent r (infiniteGenreSecondGenre theta phi))).2 := by
          rw [canonicalTwoUserValueMap_scale_infiniteGenreSecondGenre
            hA_angle hB_angle]
        _ = correctedInfiniteTwoGenreContentObjective F beta theta
              (infiniteGenreFirstGenre phi) (infiniteGenreSecondGenre theta phi)
              (scaleContent r (infiniteGenreSecondGenre theta phi)) :=
          (correctedInfiniteTwoGenreContentObjective_eq_scoreObjective
            hsin h11 h12 h21 h22).symm

/--
The corrected compact angular argmax theorem yields a genuine nonnegative
content-space equilibrium for the geometric-shell candidate.  Its explicit
angle hypotheses are exactly the conditions that make the canonical genre
vectors source-feasible.
-/
noncomputable def infiniteGenreCandidate_correctedInfiniteTwoGenreContentEquilibrium_of_leftHalf_angle_max
    {a C1 C2 beta A B theta phi : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hbalance : C1 = 1 + C2 ^ beta)
    (hA : 0 < A) (hB : 0 < B) (hratio : C2 = B / A)
    (hsin : 0 < Real.sin theta) (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) (hbeta_one : 1 ≤ beta)
    (hcos : 0 ≤ Real.cos theta)
    (hphi_sin : 0 ≤ Real.sin phi)
    (hother_sin : 0 ≤ Real.sin (theta - phi))
    (hA_angle : A = Real.cos phi)
    (hB_angle : B = Real.cos (theta - phi))
    (hmax : IsMaxOn (twoUserCosPowerSum beta theta)
      (Set.Icc 0 (theta / 2)) phi) :
    CorrectedInfiniteTwoGenreContentEquilibrium
      (infiniteGenreCandidateCdf a C1 C2 beta) beta theta :=
  correctedInfiniteTwoGenreContentEquilibrium_of_scoreEquilibrium
    (infiniteGenreCandidate_correctedInfiniteTwoGenreScoreEquilibrium_of_leftHalf_angle_max
      ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio hsin htheta_pos
      htheta_le_half_pi hbeta_one hA_angle hB_angle hmax)
    hsin hcos hA.le hB.le hphi_sin hother_sin hA_angle hB_angle

/--
In the strictly-above-threshold acute two-user regime, the repaired
two-genre infinite-producer candidate exists with an explicitly chosen compact
angular maximizer.  The result uses probability-normalized equal genre
weights and the total candidate CDF, rather than the inconsistent literal
display in the source.
-/
theorem exists_correctedInfiniteTwoGenreContentEquilibrium_of_phaseThreshold_lt
    {beta theta : ℝ}
    (htheta_pos : 0 < theta) (htheta_lt_half_pi : theta < Real.pi / 2)
    (hphase : twoUserPhaseThreshold theta < beta) :
    ∃ a C1 C2 A B phi : ℝ,
      ∃ model : CorrectedInfiniteTwoGenreContentEquilibrium
        (infiniteGenreCandidateCdf a C1 C2 beta) beta theta,
      model.firstGenre = infiniteGenreFirstGenre phi ∧
      model.secondGenre = infiniteGenreSecondGenre theta phi ∧
      model.firstGenre ≠ model.secondGenre ∧
      phi ∈ Set.Icc 0 (theta / 2) ∧
      IsMaxOn (twoUserCosPowerSum beta theta) (Set.Icc 0 (theta / 2)) phi ∧
      0 < a ∧ 0 < C2 ∧ C2 < 1 ∧
      C1 = a ^ beta ∧ C1 = 1 + C2 ^ beta ∧
      A = Real.cos phi ∧ B = Real.cos (theta - phi) ∧ C2 = B / A := by
  have htheta_lt_pi : theta < Real.pi := by
    linarith [Real.pi_pos]
  have hsin_theta : 0 < Real.sin theta :=
    Real.sin_pos_of_pos_of_lt_pi htheta_pos htheta_lt_pi
  have hcos_theta : 0 ≤ Real.cos theta :=
    Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], htheta_lt_half_pi.le⟩
  have hsin_half : 0 < Real.sin (theta / 2) :=
    Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith [Real.pi_pos])
  have htrig : 1 - Real.cos theta = 2 * (Real.sin (theta / 2)) ^ 2 := by
    rw [Real.sin_sq_eq_half_sub]
    have hdouble : 2 * (theta / 2) = theta := by ring
    rw [hdouble]
    ring
  have hden : 0 < 1 - Real.cos theta := by
    rw [htrig]
    positivity
  have hcos_theta_pos : 0 < Real.cos theta :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], htheta_lt_half_pi⟩
  have hbeta_two : 2 < beta :=
    twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcos_theta_pos hphase
  have hbeta_pos : 0 < beta := by linarith
  have hbeta_one : 1 ≤ beta := by linarith
  have hphase_gt : 2 < beta * (1 - Real.cos theta) := by
    by_contra hnot
    have hle : beta * (1 - Real.cos theta) ≤ 2 := le_of_not_gt hnot
    have hbeta_le : beta ≤ twoUserPhaseThreshold theta :=
      (twoUser_phase_inequality_iff_le_phaseThreshold hden).1 hle
    exact (not_lt_of_ge hbeta_le) hphase
  obtain ⟨phi, hphi, hmax⟩ :=
    exists_twoUserCosPowerSum_isMaxOn_leftHalf hbeta_one htheta_pos.le
  have hratio := twoUserCosRatio_pos_lt_one_of_leftHalf_max_of_phase_gt
    hbeta_one htheta_pos htheta_lt_half_pi hphase_gt hphi hmax
  have hphi_sin : 0 ≤ Real.sin phi :=
    Real.sin_nonneg_of_nonneg_of_le_pi hphi.1
      (by linarith [hphi.2, htheta_lt_half_pi, Real.pi_pos])
  have hother_nonneg : 0 ≤ theta - phi := by linarith [hphi.2, htheta_pos]
  have hother_sin : 0 ≤ Real.sin (theta - phi) :=
    Real.sin_nonneg_of_nonneg_of_le_pi hother_nonneg
      (by linarith [hphi.1, htheta_lt_half_pi, Real.pi_pos])
  let A : ℝ := Real.cos phi
  let B : ℝ := Real.cos (theta - phi)
  let C2 : ℝ := B / A
  let C1 : ℝ := 1 + C2 ^ beta
  let a : ℝ := C1 ^ beta⁻¹
  have hA : 0 < A := by
    dsimp [A]
    apply Real.cos_pos_of_mem_Ioo
    constructor
    · linarith [hphi.1, Real.pi_pos]
    · linarith [hphi.2, htheta_lt_half_pi]
  have hB : 0 < B := by
    dsimp [B]
    apply Real.cos_pos_of_mem_Ioo
    constructor
    · linarith [hphi.2, htheta_pos, Real.pi_pos]
    · linarith [hphi.1, htheta_lt_half_pi]
  have hC2 : 0 < C2 := by
    simpa only [C2, A, B] using hratio.1
  have hC2_one : C2 < 1 := by
    simpa only [C2, A, B] using hratio.2
  have hC1_pos : 0 < C1 := by
    dsimp [C1]
    have hpow_nonneg : 0 ≤ C2 ^ beta := Real.rpow_nonneg hC2.le beta
    linarith
  have ha : 0 < a := Real.rpow_pos_of_pos hC1_pos _
  have hC1 : C1 = a ^ beta := by
    dsimp [a]
    exact (Real.rpow_inv_rpow hC1_pos.le hbeta_pos.ne').symm
  have hbalance : C1 = 1 + C2 ^ beta := by rfl
  have hA_angle : A = Real.cos phi := by rfl
  have hB_angle : B = Real.cos (theta - phi) := by rfl
  have hratio_eq : C2 = B / A := by rfl
  let model :=
    infiniteGenreCandidate_correctedInfiniteTwoGenreContentEquilibrium_of_leftHalf_angle_max
    ha hC2 hC2_one hbeta_pos hC1 hbalance hA hB hratio_eq hsin_theta
    htheta_pos htheta_lt_half_pi.le hbeta_one hcos_theta hphi_sin hother_sin
    hA_angle hB_angle hmax
  have hfirst_eq : model.firstGenre = infiniteGenreFirstGenre phi := by rfl
  have hsecond_eq : model.secondGenre = infiniteGenreSecondGenre theta phi := by rfl
  have hgenres_ne : model.firstGenre ≠ model.secondGenre := by
    intro hgenres_eq
    have hcanonical : infiniteGenreFirstGenre phi =
        infiniteGenreSecondGenre theta phi :=
      hfirst_eq.symm.trans (hgenres_eq.trans hsecond_eq)
    have hcos_eq : Real.cos phi = Real.cos (theta - phi) := by
      have hcoordinate := congrArg (fun genre : Content 2 => genre (0 : Fin 2)) hcanonical
      simpa [infiniteGenreFirstGenre, infiniteGenreSecondGenre, content2] using hcoordinate
    have hB_eq_A : B = A := by
      calc
        B = Real.cos (theta - phi) := hB_angle
        _ = Real.cos phi := hcos_eq.symm
        _ = A := hA_angle.symm
    have hC2_eq_one : C2 = 1 := by
      calc
        C2 = B / A := hratio_eq
        _ = A / A := by rw [hB_eq_A]
        _ = 1 := div_self hA.ne'
    exact (ne_of_lt hC2_one) hC2_eq_one
  exact ⟨a, C1, C2, A, B, phi, model, hfirst_eq, hsecond_eq, hgenres_ne,
    hphi, hmax, ha, hC2, hC2_one, hC1, hbalance, hA_angle, hB_angle, hratio_eq⟩

/-- The corrected two-genre infinite-producer objective in the source's full
nonnegative ambient content space.  The users, genre directions, and deviation
all live in the same dimension; no rotation of the content orthant is used. -/
noncomputable def correctedInfiniteTwoGenreGeneralContentObjective
    {D : ℕ} (F : ℝ → ℝ) (beta : ℝ)
    (u v d1 d2 p : Content D) : ℝ :=
  Real.sqrt (F (score u p / score u d1) * F (score u p / score u d2)) +
    Real.sqrt (F (score v p / score v d1) * F (score v p / score v d2)) -
      normRpowCost (SourceNorm.l2 D) beta p

/-- Rescaling either nonzero user leaves the two-genre C1 objective unchanged:
each user occurs only through a ratio of two scores. -/
theorem correctedInfiniteTwoGenreGeneralContentObjective_eq_of_scale_users
    {D : ℕ} {F : ℝ → ℝ} {beta ku kv : ℝ}
    {u v d1 d2 p : Content D}
    (hku : ku ≠ 0) (hkv : kv ≠ 0) :
    correctedInfiniteTwoGenreGeneralContentObjective F beta
      (scaleContent ku u) (scaleContent kv v) d1 d2 p =
      correctedInfiniteTwoGenreGeneralContentObjective F beta u v d1 d2 p := by
  unfold correctedInfiniteTwoGenreGeneralContentObjective
  simp_rw [score_scaleUser]
  have hfirst : (ku * score u p) / (ku * score u d1) = score u p / score u d1 := by
    field_simp
  have hsecond : (ku * score u p) / (ku * score u d2) = score u p / score u d2 := by
    field_simp
  have hthird : (kv * score v p) / (kv * score v d1) = score v p / score v d1 := by
    field_simp
  have hfourth : (kv * score v p) / (kv * score v d2) = score v p / score v d2 := by
    field_simp
  rw [hfirst, hsecond, hthird, hfourth]

/-- Euclidean normalization of a nonzero user, used to justify the source's
without-loss-of-generality unit-user reduction. -/
noncomputable def twoUserNormalizedContent {D : ℕ} (u : Content D) : Content D :=
  scaleContent (AppliedModelingLib.FiniteDimensionalNorms.l2 u)⁻¹ u

theorem twoUserNormalizedContent_nonnegative
    {D : ℕ} {u : Content D} (hu : NonnegativeContent u) :
    NonnegativeContent (twoUserNormalizedContent u) := by
  unfold twoUserNormalizedContent
  exact scaleContent_nonnegative
    (inv_nonneg.mpr (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg u)) hu

theorem score_twoUserNormalizedContent_self
    {D : ℕ} {u : Content D}
    (hu : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 u) :
    score (twoUserNormalizedContent u) (twoUserNormalizedContent u) = 1 := by
  unfold twoUserNormalizedContent
  rw [score_scaleUser, score_scaleContent, score_self_eq_l2_sq]
  field_simp

theorem score_twoUserNormalizedContent_pair
    {D : ℕ} {u v : Content D} :
    score (twoUserNormalizedContent u) (twoUserNormalizedContent v) =
      (AppliedModelingLib.FiniteDimensionalNorms.l2 u)⁻¹ *
        (AppliedModelingLib.FiniteDimensionalNorms.l2 v)⁻¹ * score u v := by
  unfold twoUserNormalizedContent
  rw [score_scaleUser, score_scaleContent]
  ring

theorem scale_l2_twoUserNormalizedContent
    {D : ℕ} {u : Content D}
    (hu : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 u) :
    scaleContent (AppliedModelingLib.FiniteDimensionalNorms.l2 u)
      (twoUserNormalizedContent u) = u := by
  unfold twoUserNormalizedContent
  ext i
  simp only [scaleContent]
  field_simp

theorem score_twoUserNormalizedContent_pair_eq_cos
    {D : ℕ} {u v : Content D} {theta : ℝ}
    (hu : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 u)
    (hv : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 v)
    (hangle : score u v /
      (AppliedModelingLib.FiniteDimensionalNorms.l2 u *
        AppliedModelingLib.FiniteDimensionalNorms.l2 v) = Real.cos theta) :
    score (twoUserNormalizedContent u) (twoUserNormalizedContent v) =
      Real.cos theta := by
  rw [score_twoUserNormalizedContent_pair]
  rw [← hangle]
  field_simp

/-- Any content deviation is bounded by the two-score objective associated to
its Gram-ellipse values. -/
theorem correctedInfiniteTwoGenreGeneralContentObjective_le_scoreObjective
    {D : ℕ} {F : ℝ → ℝ} {beta A B theta : ℝ}
    {u v d1 d2 p : Content D}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta) (hsin : 0 < Real.sin theta)
    (hbeta : 0 ≤ beta)
    (h11 : score u d1 = A) (h12 : score u d2 = B)
    (h21 : score v d1 = B) (h22 : score v d2 = A) :
    correctedInfiniteTwoGenreGeneralContentObjective F beta u v d1 d2 p ≤
      correctedInfiniteTwoGenreScoreObjective F beta A B theta
        (score u p) (score v p) := by
  have hcost_raw := twoUserInducedCost_le_l2_rpow_of_unit_score_pair
    hu hv huv hsin hbeta (p := p)
  have hcost : twoUserInducedCost 1 beta theta (score u p) (score v p) ≤
      normRpowCost (SourceNorm.l2 D) beta p := by
    simpa [normRpowCost, SourceNorm.l2] using hcost_raw
  unfold correctedInfiniteTwoGenreGeneralContentObjective
  rw [correctedInfiniteTwoGenreScoreObjective, h11, h12, h21, h22]
  rw [mul_comm (F (score u p / A))]
  apply sub_le_sub_left hcost

/-- On the first sine-interpolated genre ray, the ambient objective agrees
exactly with the two-score objective. -/
theorem correctedInfiniteTwoGenreGeneralContentObjective_eq_scoreObjective_on_first_scale
    {D : ℕ} {F : ℝ → ℝ} {beta A B theta phi r : ℝ}
    {u v d1 d2 : Content D}
    (hr : 0 ≤ r) (hd1 : AppliedModelingLib.FiniteDimensionalNorms.l2 d1 = 1)
    (hsin : 0 < Real.sin theta)
    (h11 : score u d1 = A) (h12 : score u d2 = B)
    (h21 : score v d1 = B) (h22 : score v d2 = A)
    (hA : A = Real.cos phi) (hB : B = Real.cos (theta - phi)) :
    correctedInfiniteTwoGenreGeneralContentObjective F beta u v d1 d2
      (scaleContent r d1) =
      correctedInfiniteTwoGenreScoreObjective F beta A B theta (r * A) (r * B) := by
  have hcost : normRpowCost (SourceNorm.l2 D) beta (scaleContent r d1) =
      twoUserInducedCost 1 beta theta (r * A) (r * B) := by
    simpa [normRpowCost, SourceNorm.l2, hA, hB] using
      (l2_rpow_eq_twoUserInducedCost_of_cos_pair_scale
        (d := d1) (beta := beta) (phi := phi) hr hd1 hsin)
  have hfirst : score u (scaleContent r d1) = r * A := by
    rw [score_scaleContent, h11]
  have hsecond : score v (scaleContent r d1) = r * B := by
    rw [score_scaleContent, h21]
  unfold correctedInfiniteTwoGenreGeneralContentObjective
  rw [hfirst, hsecond, h11, h12, h21, h22, hcost,
    correctedInfiniteTwoGenreScoreObjective]
  rw [mul_comm (F (r * A / A))]

/-- The analogous ambient/score equality holds on the second genre ray. -/
theorem correctedInfiniteTwoGenreGeneralContentObjective_eq_scoreObjective_on_second_scale
    {D : ℕ} {F : ℝ → ℝ} {beta A B theta phi r : ℝ}
    {u v d1 d2 : Content D}
    (hr : 0 ≤ r) (hd2 : AppliedModelingLib.FiniteDimensionalNorms.l2 d2 = 1)
    (hsin : 0 < Real.sin theta)
    (h11 : score u d1 = A) (h12 : score u d2 = B)
    (h21 : score v d1 = B) (h22 : score v d2 = A)
    (hA : A = Real.cos phi) (hB : B = Real.cos (theta - phi)) :
    correctedInfiniteTwoGenreGeneralContentObjective F beta u v d1 d2
      (scaleContent r d2) =
      correctedInfiniteTwoGenreScoreObjective F beta A B theta (r * B) (r * A) := by
  have hangle : theta - (theta - phi) = phi := by ring
  have hcost : normRpowCost (SourceNorm.l2 D) beta (scaleContent r d2) =
      twoUserInducedCost 1 beta theta (r * B) (r * A) := by
    simpa [normRpowCost, SourceNorm.l2, hA, hB, hangle] using
      (l2_rpow_eq_twoUserInducedCost_of_cos_pair_scale
        (d := d2) (beta := beta) (phi := theta - phi) hr hd2 hsin)
  have hfirst : score u (scaleContent r d2) = r * B := by
    rw [score_scaleContent, h12]
  have hsecond : score v (scaleContent r d2) = r * A := by
    rw [score_scaleContent, h22]
  unfold correctedInfiniteTwoGenreGeneralContentObjective
  rw [hfirst, hsecond, h11, h12, h21, h22, hcost,
    correctedInfiniteTwoGenreScoreObjective]
  rw [mul_comm (F (r * B / A))]

/-- Corrected two-genre infinite-producer equilibrium data for arbitrary
nonnegative two-user Euclidean geometry. -/
structure CorrectedInfiniteTwoGenreGeneralContentEquilibrium
    {D : ℕ} (F : ℝ → ℝ) (beta : ℝ) (u v : Content D) where
  firstGenre : Content D
  secondGenre : Content D
  firstGenre_nonnegative : NonnegativeContent firstGenre
  secondGenre_nonnegative : NonnegativeContent secondGenre
  firstGenre_l2_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 firstGenre = 1
  secondGenre_l2_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 secondGenre = 1
  conditionalQuality : Measure ℝ
  conditionalQuality_probability : IsProbabilityMeasure conditionalQuality
  conditionalQuality_cdf : ∀ q : ℝ,
    conditionalQuality (Set.Iic q) = ENNReal.ofReal (F q)
  conditionalQuality_support_nonnegative :
    conditionalQuality.support ⊆ Set.Ici 0
  firstWeight : ℝ
  secondWeight : ℝ
  firstWeight_nonnegative : 0 ≤ firstWeight
  secondWeight_nonnegative : 0 ≤ secondWeight
  firstWeight_eq_half : firstWeight = 1 / 2
  secondWeight_eq_half : secondWeight = 1 / 2
  weights_sum : firstWeight + secondWeight = 1
  first_support_maximizes : ∀ ⦃r : ℝ⦄,
    r ∈ conditionalQuality.support →
      scaleContent r firstGenre ∈ {p : Content D | NonnegativeContent p} ∧
        IsMaxOn
          (correctedInfiniteTwoGenreGeneralContentObjective
            F beta u v firstGenre secondGenre)
          {p : Content D | NonnegativeContent p}
          (scaleContent r firstGenre)
  second_support_maximizes : ∀ ⦃r : ℝ⦄,
    r ∈ conditionalQuality.support →
      scaleContent r secondGenre ∈ {p : Content D | NonnegativeContent p} ∧
        IsMaxOn
          (correctedInfiniteTwoGenreGeneralContentObjective
            F beta u v firstGenre secondGenre)
          {p : Content D | NonnegativeContent p}
          (scaleContent r secondGenre)

/-- Transport a corrected two-genre equilibrium across nonzero rescalings of
the two users.  The content directions and probability law are unchanged. -/
noncomputable def correctedInfiniteTwoGenreGeneralContentEquilibrium_scale_users
    {D : ℕ} {F : ℝ → ℝ} {beta ku kv : ℝ}
    {u v : Content D}
    (equilibrium : CorrectedInfiniteTwoGenreGeneralContentEquilibrium F beta u v)
    (hku : ku ≠ 0) (hkv : kv ≠ 0) :
    CorrectedInfiniteTwoGenreGeneralContentEquilibrium F beta
      (scaleContent ku u) (scaleContent kv v) := by
  refine
    { firstGenre := equilibrium.firstGenre
      secondGenre := equilibrium.secondGenre
      firstGenre_nonnegative := equilibrium.firstGenre_nonnegative
      secondGenre_nonnegative := equilibrium.secondGenre_nonnegative
      firstGenre_l2_norm := equilibrium.firstGenre_l2_norm
      secondGenre_l2_norm := equilibrium.secondGenre_l2_norm
      conditionalQuality := equilibrium.conditionalQuality
      conditionalQuality_probability := equilibrium.conditionalQuality_probability
      conditionalQuality_cdf := equilibrium.conditionalQuality_cdf
      conditionalQuality_support_nonnegative := equilibrium.conditionalQuality_support_nonnegative
      firstWeight := equilibrium.firstWeight
      secondWeight := equilibrium.secondWeight
      firstWeight_nonnegative := equilibrium.firstWeight_nonnegative
      secondWeight_nonnegative := equilibrium.secondWeight_nonnegative
      firstWeight_eq_half := equilibrium.firstWeight_eq_half
      secondWeight_eq_half := equilibrium.secondWeight_eq_half
      weights_sum := equilibrium.weights_sum
      first_support_maximizes := ?_
      second_support_maximizes := ?_ }
  · intro r hr
    refine ⟨(equilibrium.first_support_maximizes hr).1, ?_⟩
    intro p hp
    change correctedInfiniteTwoGenreGeneralContentObjective F beta
      (scaleContent ku u) (scaleContent kv v)
      equilibrium.firstGenre equilibrium.secondGenre p ≤
      correctedInfiniteTwoGenreGeneralContentObjective F beta
        (scaleContent ku u) (scaleContent kv v)
        equilibrium.firstGenre equilibrium.secondGenre
        (scaleContent r equilibrium.firstGenre)
    rw [correctedInfiniteTwoGenreGeneralContentObjective_eq_of_scale_users
      (p := p) hku hkv,
      correctedInfiniteTwoGenreGeneralContentObjective_eq_of_scale_users
        (p := scaleContent r equilibrium.firstGenre) hku hkv]
    exact (equilibrium.first_support_maximizes hr).2 hp
  · intro r hr
    refine ⟨(equilibrium.second_support_maximizes hr).1, ?_⟩
    intro p hp
    change correctedInfiniteTwoGenreGeneralContentObjective F beta
      (scaleContent ku u) (scaleContent kv v)
      equilibrium.firstGenre equilibrium.secondGenre p ≤
      correctedInfiniteTwoGenreGeneralContentObjective F beta
        (scaleContent ku u) (scaleContent kv v)
        equilibrium.firstGenre equilibrium.secondGenre
        (scaleContent r equilibrium.secondGenre)
    rw [correctedInfiniteTwoGenreGeneralContentObjective_eq_of_scale_users
      (p := p) hku hkv,
      correctedInfiniteTwoGenreGeneralContentObjective_eq_of_scale_users
        (p := scaleContent r equilibrium.secondGenre) hku hkv]
    exact (equilibrium.second_support_maximizes hr).2 hp

/-- Lift a corrected two-score equilibrium to arbitrary-dimensional nonnegative
unit users.  The two genre directions are sine-interpolated conic combinations
of the users, and every ambient deviation is controlled by its Gram-ellipse
score pair. -/
noncomputable def correctedInfiniteTwoGenreGeneralContentEquilibrium_of_scoreEquilibrium_of_genres
    {D : ℕ} {F : ℝ → ℝ} {beta A B theta phi : ℝ}
    {u v d1 d2 : Content D}
    (scoreEquilibrium : CorrectedInfiniteTwoGenreScoreEquilibrium F beta A B theta)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (hbeta : 0 ≤ beta) (hsin : 0 < Real.sin theta)
    (hd1_nonnegative : NonnegativeContent d1)
    (hd2_nonnegative : NonnegativeContent d2)
    (hd1_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 d1 = 1)
    (hd2_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 d2 = 1)
    (h11 : score u d1 = A) (h12 : score u d2 = B)
    (h21 : score v d1 = B) (h22 : score v d2 = A)
    (hA : A = Real.cos phi) (hB : B = Real.cos (theta - phi)) :
    CorrectedInfiniteTwoGenreGeneralContentEquilibrium F beta u v := by
  refine
    { firstGenre := d1
      secondGenre := d2
      firstGenre_nonnegative := hd1_nonnegative
      secondGenre_nonnegative := hd2_nonnegative
      firstGenre_l2_norm := hd1_norm
      secondGenre_l2_norm := hd2_norm
      conditionalQuality := scoreEquilibrium.conditionalQuality
      conditionalQuality_probability := scoreEquilibrium.conditionalQuality_probability
      conditionalQuality_cdf := scoreEquilibrium.conditionalQuality_cdf
      conditionalQuality_support_nonnegative :=
        scoreEquilibrium.conditionalQuality_support_nonnegative
      firstWeight := 1 / 2
      secondWeight := 1 / 2
      firstWeight_nonnegative := by norm_num
      secondWeight_nonnegative := by norm_num
      firstWeight_eq_half := rfl
      secondWeight_eq_half := rfl
      weights_sum := by norm_num
      first_support_maximizes := ?_
      second_support_maximizes := ?_ }
  · intro r hr
    constructor
    · exact scaleContent_nonnegative
        (scoreEquilibrium.conditionalQuality_support_nonnegative hr) hd1_nonnegative
    · intro p hp
      have hp_values : (score u p, score v p) ∈
          Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ) :=
        ⟨score_nonneg_of_nonnegative hu_nonnegative hp,
          score_nonneg_of_nonnegative hv_nonnegative hp⟩
      have hmax := (scoreEquilibrium.first_support_maximizes hr).2
      calc
        correctedInfiniteTwoGenreGeneralContentObjective F beta u v d1 d2 p ≤
            correctedInfiniteTwoGenreScoreObjective F beta A B theta
              (score u p) (score v p) :=
          correctedInfiniteTwoGenreGeneralContentObjective_le_scoreObjective
            hu hv huv hsin hbeta h11 h12 h21 h22
        _ ≤ correctedInfiniteTwoGenreScoreObjective F beta A B theta
              (r * A) (r * B) :=
          hmax hp_values
        _ = correctedInfiniteTwoGenreGeneralContentObjective F beta u v d1 d2
              (scaleContent r d1) :=
          (correctedInfiniteTwoGenreGeneralContentObjective_eq_scoreObjective_on_first_scale
            (u := u) (v := v) (d1 := d1) (d2 := d2)
            (phi := phi)
            (scoreEquilibrium.conditionalQuality_support_nonnegative hr)
            hd1_norm hsin h11 h12 h21 h22 hA hB).symm
  · intro r hr
    constructor
    · exact scaleContent_nonnegative
        (scoreEquilibrium.conditionalQuality_support_nonnegative hr) hd2_nonnegative
    · intro p hp
      have hp_values : (score u p, score v p) ∈
          Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ) :=
        ⟨score_nonneg_of_nonnegative hu_nonnegative hp,
          score_nonneg_of_nonnegative hv_nonnegative hp⟩
      have hmax := (scoreEquilibrium.second_support_maximizes hr).2
      calc
        correctedInfiniteTwoGenreGeneralContentObjective F beta u v d1 d2 p ≤
            correctedInfiniteTwoGenreScoreObjective F beta A B theta
              (score u p) (score v p) :=
          correctedInfiniteTwoGenreGeneralContentObjective_le_scoreObjective
            hu hv huv hsin hbeta h11 h12 h21 h22
        _ ≤ correctedInfiniteTwoGenreScoreObjective F beta A B theta
              (r * B) (r * A) :=
          hmax hp_values
        _ = correctedInfiniteTwoGenreGeneralContentObjective F beta u v d1 d2
              (scaleContent r d2) :=
          (correctedInfiniteTwoGenreGeneralContentObjective_eq_scoreObjective_on_second_scale
            (u := u) (v := v) (d1 := d1) (d2 := d2)
            (phi := phi)
            (scoreEquilibrium.conditionalQuality_support_nonnegative hr)
            hd2_norm hsin h11 h12 h21 h22 hA hB).symm

private theorem pTwoStandardBasisScore_nonneg_of_nonnegativeContent
    (p : Content 2) (hp : NonnegativeContent p) (i : Fin 2) :
    0 ≤ score (pTwoStandardBasisUsers i) p := by
  fin_cases i
  · change 0 ≤ score (pTwoStandardBasisUsers 0) p
    rw [pTwoStandardBasisScore_zero_eq_coordinate]
    exact hp 0
  · change 0 ≤ score (pTwoStandardBasisUsers 1) p
    rw [pTwoStandardBasisScore_one_eq_coordinate]
    exact hp 1

/--
For a source-feasible P=2 pure action, the tie-aware mixed payoff is exactly
the source's reparameterized standard-basis objective. The nonnegative-content
premise is essential: it selects the source CDF's nonnegative branch.
-/
theorem pTwoSourceContentMeasure_sourceMixedPurePayoff_eq_standardBasisObjective
    {beta : ℝ} (hbeta : 2 ≤ beta) (p : Content 2)
    (hp : NonnegativeContent p) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers (0 : Fin 2))
      (normRpowCost (SourceNorm.l2 2) beta) p
      (pTwoSourceContentMeasure beta) =
    standardBasisObjective beta
      (score (pTwoStandardBasisUsers 0) p)
      (score (pTwoStandardBasisUsers 1) p) := by
  unfold SourceMixedPurePayoff
  rw [pTwoSourceContentMeasure_expectedUsersWon_eq_sourceMarginalCdfSum hbeta,
    pTwoL2RpowCost_eq_standardBasisCoordinateCost]
  have hzero : ¬ score (pTwoStandardBasisUsers 0) p < 0 :=
    not_lt.mpr (pTwoStandardBasisScore_nonneg_of_nonnegativeContent p hp 0)
  have hone : ¬ score (pTwoStandardBasisUsers 1) p < 0 :=
    not_lt.mpr (pTwoStandardBasisScore_nonneg_of_nonnegativeContent p hp 1)
  simp only [pTwoSourceMarginalCdf, if_neg hzero, if_neg hone]
  rfl

/--
Every source-feasible pure P=2 deviation has payoff at most the value attained
by the source quarter-circle objective. This is the no-deviation component of
the source argument, not an equilibrium or support-indifference package.
-/
theorem pTwoSourceContentMeasure_sourceMixedPurePayoff_le_equilibriumValue
    {beta : ℝ} (hbeta : 2 ≤ beta) (p : Content 2)
    (hp : NonnegativeContent p) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers (0 : Fin 2))
      (normRpowCost (SourceNorm.l2 2) beta) p
      (pTwoSourceContentMeasure beta) ≤
    1 - 2 / beta := by
  rw [pTwoSourceContentMeasure_sourceMixedPurePayoff_eq_standardBasisObjective
    hbeta p hp]
  exact standardBasisObjective_le_of_two_le hbeta

/--
Each explicitly parameterized action on the source quarter-circle attains the
P=2 payoff value `1 - 2 / beta`. Transporting this equality to every point of
the content measure's topological support is a separate support-map obligation.
-/
theorem pTwoContentOfCoordinates_sourceMixedPurePayoff_eq_equilibriumValue_on_sourceCircle
    {beta : ℝ} (hbeta : 2 ≤ beta) (z : ℝ × ℝ)
    (hz : z ∈ pTwoSourceCircleSupportSet beta) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers (0 : Fin 2))
      (normRpowCost (SourceNorm.l2 2) beta) (pTwoContentOfCoordinates z)
      (pTwoSourceContentMeasure beta) =
    1 - 2 / beta := by
  have hp : NonnegativeContent (pTwoContentOfCoordinates z) := by
    exact nonnegativeContent_content2_iff z.1 z.2 |>.mpr ⟨hz.1, hz.2.1⟩
  have hscore := pTwoStandardBasisValueMap_contentOfCoordinates z
  have hscore_zero :
      score (pTwoStandardBasisUsers 0) (pTwoContentOfCoordinates z) = z.1 := by
    simpa [pTwoStandardBasisValueMap] using congrArg Prod.fst hscore
  have hscore_one :
      score (pTwoStandardBasisUsers 1) (pTwoContentOfCoordinates z) = z.2 := by
    simpa [pTwoStandardBasisValueMap] using congrArg Prod.snd hscore
  rw [pTwoSourceContentMeasure_sourceMixedPurePayoff_eq_standardBasisObjective hbeta
    (pTwoContentOfCoordinates z) hp, hscore_zero, hscore_one]
  exact standardBasisObjective_eq_of_radius_two_le hbeta hz.2.2

/--
Almost every pure action sampled from the P=2 content law attains the source
value `1 - 2 / beta`. This uses the value-law circle event and the direct
literal-circle payoff equality; it is not an equilibrium package.
-/
theorem pTwoSourceContentMeasure_ae_sourceMixedPurePayoff_eq_equilibriumValue
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    ∀ᵐ p ∂pTwoSourceContentMeasure beta,
      SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers (0 : Fin 2))
        (normRpowCost (SourceNorm.l2 2) beta) p
        (pTwoSourceContentMeasure beta) =
      1 - 2 / beta := by
  filter_upwards [pTwoSourceContentMeasure_ae_standardBasisValue_on_sourceCircle hbeta]
    with p hp
  rw [← pTwoContentOfCoordinates_standardBasisValueMap p]
  exact pTwoContentOfCoordinates_sourceMixedPurePayoff_eq_equilibriumValue_on_sourceCircle
    hbeta (pTwoStandardBasisValueMap p) hp

/--
Corollary `2usersprofit`, expectation form: integrating the actual pure payoff
of the P=2 source law gives the displayed equilibrium profit.  This follows
from the already checked almost-everywhere payoff identity and the fact that
the candidate content law is a probability measure.
-/
theorem pTwoSourceContentMeasure_integral_sourceMixedPurePayoff_eq_equilibriumValue
    {beta : ℝ} (hbeta : 2 ≤ beta) :
    ∫ p, SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers (0 : Fin 2))
        (normRpowCost (SourceNorm.l2 2) beta) p
        (pTwoSourceContentMeasure beta) ∂pTwoSourceContentMeasure beta =
      1 - 2 / beta := by
  letI : IsProbabilityMeasure (pTwoSourceContentMeasure beta) :=
    pTwoSourceContentMeasure_isProbabilityMeasure beta
  rw [integral_congr_ae
    (pTwoSourceContentMeasure_ae_sourceMixedPurePayoff_eq_equilibriumValue hbeta)]
  simp [MeasureTheory.integral_const]

/--
Every topological-support action of the concrete P=2 content law attains the
source payoff value. This is the source support-action equality for the focal
producer, derived by transporting support through the continuous score map.
-/
theorem pTwoSourceContentMeasure_sourceMixedPurePayoff_eq_equilibriumValue_of_mem_support
    {beta : ℝ} (hbeta : 2 ≤ beta) (p : Content 2)
    (hp : p ∈ (pTwoSourceContentMeasure beta).support) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers (0 : Fin 2))
      (normRpowCost (SourceNorm.l2 2) beta) p
      (pTwoSourceContentMeasure beta) =
    1 - 2 / beta := by
  rw [← pTwoContentOfCoordinates_standardBasisValueMap p]
  exact pTwoContentOfCoordinates_sourceMixedPurePayoff_eq_equilibriumValue_on_sourceCircle
    hbeta (pTwoStandardBasisValueMap p)
    (pTwoStandardBasisValueMap_mem_sourceCircle_of_mem_contentMeasure_support hbeta hp)

/--
Every support action of the concrete P=2 content law is a payoff maximizer over
the source's nonnegative action space for the focal producer. The nonnegative
deviation premise remains explicit, and this theorem does not package a
full symmetric mixed Nash conclusion.
-/
theorem pTwoSourceContentMeasure_support_action_payoff_is_maximal
    {beta : ℝ} (hbeta : 2 ≤ beta) (p : Content 2)
    (hp : p ∈ (pTwoSourceContentMeasure beta).support) :
    ∀ q : Content 2, NonnegativeContent q →
      SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers (0 : Fin 2))
        (normRpowCost (SourceNorm.l2 2) beta) q
        (pTwoSourceContentMeasure beta) ≤
      SourceMixedPurePayoff
        (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers (0 : Fin 2))
        (normRpowCost (SourceNorm.l2 2) beta) p
        (pTwoSourceContentMeasure beta) := by
  intro q hq
  rw [pTwoSourceContentMeasure_sourceMixedPurePayoff_eq_equilibriumValue_of_mem_support
    hbeta p hp]
  exact pTwoSourceContentMeasure_sourceMixedPurePayoff_le_equilibriumValue hbeta q hq

/--
For either focal producer in the P=2 candidate, a source-feasible pure action
has the standard-basis objective as its actual tie-aware mixed payoff.
-/
theorem pTwoSourceContentMeasure_sourceMixedPurePayoffAtFocal_eq_standardBasisObjective
    {beta : ℝ} (hbeta : 2 ≤ beta) (j : Fin 2) (p : Content 2)
    (hp : NonnegativeContent p) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
      (normRpowCost (SourceNorm.l2 2) beta) p
      (pTwoSourceContentMeasure beta) =
    standardBasisObjective beta
      (score (pTwoStandardBasisUsers 0) p)
      (score (pTwoStandardBasisUsers 1) p) := by
  unfold SourceMixedPurePayoff
  rw [pTwoSourceContentMeasure_expectedUsersWonAtFocal_eq_sourceMarginalCdfSum hbeta,
    pTwoL2RpowCost_eq_standardBasisCoordinateCost]
  have hzero : ¬ score (pTwoStandardBasisUsers 0) p < 0 :=
    not_lt.mpr (pTwoStandardBasisScore_nonneg_of_nonnegativeContent p hp 0)
  have hone : ¬ score (pTwoStandardBasisUsers 1) p < 0 :=
    not_lt.mpr (pTwoStandardBasisScore_nonneg_of_nonnegativeContent p hp 1)
  simp only [pTwoSourceMarginalCdf, if_neg hzero, if_neg hone]
  rfl

/--
For either focal producer in the P=2 candidate, every source-feasible pure
deviation has payoff at most `1 - 2 / beta`.
-/
theorem pTwoSourceContentMeasure_sourceMixedPurePayoffAtFocal_le_equilibriumValue
    {beta : ℝ} (hbeta : 2 ≤ beta) (j : Fin 2) (p : Content 2)
    (hp : NonnegativeContent p) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed pTwoStandardBasisUsers j)
