        · simpa [hz1_zero] using hzupper
        · exact mul_nonneg hcos.le hz2_nonneg
      exact (mul_eq_zero.mp this).resolve_left hcos.ne'
    exact hne (Prod.ext hz1_zero.symm hz2_zero)
  have hz1I : z.1 ∈ Set.Icc 0 B := by
    rw [← hfirst_support]
    exact canonicalTwoUser_firstScore_mem_support_of_mem_valueSupport hz
  have hzgraph : z.2 = g z.1 := hgraph z hz
  exact ⟨hz1_pos, by simpa [hzgraph] using hstrict_graph z.1 hz1I hz1_pos⟩

/-- Acute source-facing Proposition `uniqueness` with no separately postulated
support-interiority or boundary-density premise.  All support geometry is
derived from the paper's Nash, phase, absolute-continuity, and score-CDF C2
hypotheses. -/
theorem canonicalTwoUser_nonzeroSupportGenres_eq_singleton_of_scaledNormRpowCostNash_belowPhase_of_cos_pos
    {P : ℕ} [Nonempty (Fin P)] {α β theta : ℝ} {mu : Measure (Content 2)}
