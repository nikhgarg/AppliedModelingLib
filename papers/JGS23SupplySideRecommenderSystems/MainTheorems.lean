/--
Derivative of the first finite-genre angle label on the positive-cosine
domain.  This supplies the missing direct analytic link between the FOC label
in equation (conditions) and the angle geometry used later in the source
argument.
-/
theorem hasDerivAt_finiteGenreFirstAngleLabel
    {β θstar θ : ℝ} (hcos : 0 < Real.cos θ) :
    HasDerivAt (fun x : ℝ => finiteGenreFirstAngleLabel β θstar x)
      ((-Real.cos (θstar - θ) * Real.cos θ +
        (β - 1) * Real.sin (θstar - θ) * Real.sin θ) /
        (Real.cos θ) ^ β) θ := by
  have hinner : HasDerivAt (fun x : ℝ => θstar - x) (-1) θ := by
    simpa using (hasDerivAt_const θ θstar).sub (hasDerivAt_id θ)
  have hsin : HasDerivAt (fun x : ℝ => Real.sin (θstar - x))
      (-Real.cos (θstar - θ)) θ := by
    have h := (Real.hasDerivAt_sin (θstar - θ)).comp θ hinner
    convert h using 1 ; ring
  have hcos_deriv : HasDerivAt (fun x : ℝ => Real.cos x) (-Real.sin θ) θ :=
    Real.hasDerivAt_cos θ
  have hpow := hcos_deriv.rpow_const (p := β - 1) (Or.inl hcos.ne')
  have hpow_ne : (Real.cos θ) ^ (β - 1) ≠ 0 :=
    ne_of_gt (Real.rpow_pos_of_pos hcos _)
  have hdiv := hsin.div hpow hpow_ne
  have hraw : HasDerivAt
      (fun x : ℝ => Real.sin (θstar - x) / (Real.cos x) ^ (β - 1))
      ((-Real.cos (θstar - θ) * (Real.cos θ) ^ (β - 1) +
          Real.sin (θstar - θ) * ((β - 1) * (Real.cos θ) ^ (β - 2) *
            Real.sin θ)) / ((Real.cos θ) ^ (β - 1)) ^ 2) θ := by
    convert hdiv using 1 ; ring
  have hpowβ : (Real.cos θ) ^ β ≠ 0 :=
    ne_of_gt (Real.rpow_pos_of_pos hcos _)
  have hraw' :
      ((-Real.cos (θstar - θ) * (Real.cos θ) ^ (β - 1) +
          Real.sin (θstar - θ) * ((β - 1) * (Real.cos θ) ^ (β - 2) *
            Real.sin θ)) / ((Real.cos θ) ^ (β - 1)) ^ 2) =
        (-Real.cos (θstar - θ) * Real.cos θ +
          (β - 1) * Real.sin (θstar - θ) * Real.sin θ) /
          (Real.cos θ) ^ β := by
    rw [Real.rpow_sub hcos β 1,
      Real.rpow_sub hcos β 2]
    simp only [Real.rpow_one]
    field_simp [hcos.ne', hpowβ]
    ring_nf
    rw [Real.rpow_two (Real.cos θ)]
  rw [← hraw']
  simpa [finiteGenreFirstAngleLabel] using hraw

/--
The preceding derivative is exactly a positive-cosine multiple of the source
`secondderiv` sign bracket when the source exponent is positive.  It makes
that bracket's relevance to finite-genre label fibers a proved calculus fact,
while leaving the unproved global fiber-count and support-graph arguments
separate.
-/
theorem hasDerivAt_finiteGenreFirstAngleLabel_signBracket
    {β θstar θ : ℝ} (hβ : 0 < β) (hcos : 0 < Real.cos θ) :
    HasDerivAt (fun x : ℝ => finiteGenreFirstAngleLabel β θstar x)
      ((β / 2) * twoUserSecondDerivSignBracket β θstar θ /
        (Real.cos θ) ^ β) θ := by
  have hfirst := hasDerivAt_finiteGenreFirstAngleLabel
    (β := β) (θstar := θstar) (θ := θ) hcos
  have hpowβ : (Real.cos θ) ^ β ≠ 0 :=
    ne_of_gt (Real.rpow_pos_of_pos hcos _)
  have hcos_sub : Real.cos (θstar - 2 * θ) =
      Real.cos (θstar - θ) * Real.cos θ +
        Real.sin (θstar - θ) * Real.sin θ := by
    calc
      Real.cos (θstar - 2 * θ) = Real.cos ((θstar - θ) - θ) := by
        congr 1
        ring
      _ = Real.cos (θstar - θ) * Real.cos θ +
          Real.sin (θstar - θ) * Real.sin θ := Real.cos_sub _ _
  have hcos_add : Real.cos θstar =
      Real.cos (θstar - θ) * Real.cos θ -
        Real.sin (θstar - θ) * Real.sin θ := by
    calc
      Real.cos θstar = Real.cos ((θstar - θ) + θ) := by
        congr 1
        ring
      _ = Real.cos (θstar - θ) * Real.cos θ -
          Real.sin (θstar - θ) * Real.sin θ := Real.cos_add _ _
  have hformula :
      (-Real.cos (θstar - θ) * Real.cos θ +
        (β - 1) * Real.sin (θstar - θ) * Real.sin θ) /
          (Real.cos θ) ^ β =
        (β / 2) * twoUserSecondDerivSignBracket β θstar θ /
          (Real.cos θ) ^ β := by
    unfold twoUserSecondDerivSignBracket
    rw [hcos_sub, hcos_add]
    field_simp [hpowβ, hβ.ne']
    ring
  rw [← hformula]
  exact hfirst

/--
On an interval where the source `secondderiv` bracket is strictly positive,
the first finite-genre FOC label is strictly increasing.  This is the precise
local label-fiber implication furnished by the bracket calculation; it does
not give the source's unproved global simultaneous-fiber classification.
-/
theorem finiteGenreFirstAngleLabel_strictMonoOn_of_signBracket_pos
    {β θstar a b : ℝ} (hβ : 0 < β)
    (hcos : ∀ θ, θ ∈ Set.Icc a b → 0 < Real.cos θ)
    (hbracket : ∀ θ, θ ∈ Set.Ioo a b →
      0 < twoUserSecondDerivSignBracket β θstar θ) :
    StrictMonoOn (finiteGenreFirstAngleLabel β θstar) (Set.Icc a b) := by
  apply strictMonoOn_of_deriv_pos (convex_Icc a b)
  · intro θ hθ
    exact (hasDerivAt_finiteGenreFirstAngleLabel_signBracket hβ
      (hcos θ hθ)).continuousAt.continuousWithinAt
  · intro θ hθ
    rw [interior_Icc] at hθ
    rw [(hasDerivAt_finiteGenreFirstAngleLabel_signBracket hβ
      (hcos θ ⟨hθ.1.le, hθ.2.le⟩)).deriv]
    exact div_pos (mul_pos (by linarith) (hbracket θ hθ))
      (Real.rpow_pos_of_pos (hcos θ ⟨hθ.1.le, hθ.2.le⟩) _)

/--
On an interval where the source `secondderiv` bracket is strictly negative,
the first finite-genre FOC label is strictly decreasing.  Together with the
positive-sign version this gives local one-point fibers on any supplied
strict-sign region, but not the source's asserted global two-angle bound.
-/
theorem finiteGenreFirstAngleLabel_strictAntiOn_of_signBracket_neg
    {β θstar a b : ℝ} (hβ : 0 < β)
    (hcos : ∀ θ, θ ∈ Set.Icc a b → 0 < Real.cos θ)
    (hbracket : ∀ θ, θ ∈ Set.Ioo a b →
      twoUserSecondDerivSignBracket β θstar θ < 0) :
    StrictAntiOn (finiteGenreFirstAngleLabel β θstar) (Set.Icc a b) := by
  apply strictAntiOn_of_deriv_neg (convex_Icc a b)
  · intro θ hθ
    exact (hasDerivAt_finiteGenreFirstAngleLabel_signBracket hβ
      (hcos θ hθ)).continuousAt.continuousWithinAt
  · intro θ hθ
    rw [interior_Icc] at hθ
    rw [(hasDerivAt_finiteGenreFirstAngleLabel_signBracket hβ
      (hcos θ ⟨hθ.1.le, hθ.2.le⟩)).deriv]
    exact div_neg_of_neg_of_pos (mul_neg_of_pos_of_neg (by linarith)
      (hbracket θ hθ))
      (Real.rpow_pos_of_pos (hcos θ ⟨hθ.1.le, hθ.2.le⟩) _)

/--
The second finite-genre FOC label is the reflected first label.  Its
derivative therefore has the opposite `secondderiv`-bracket sign on the
positive-cosine domain.  This supplies the corresponding local calculus fact
for both labels in equation `conditions`, without asserting a global fiber
classification.
-/
theorem hasDerivAt_finiteGenreSecondAngleLabel_signBracket
    {β θstar θ : ℝ} (hβ : 0 < β)
    (hcos : 0 < Real.cos (θstar - θ)) :
    HasDerivAt (fun x : ℝ => finiteGenreSecondAngleLabel β θstar x)
      (-(β / 2) * twoUserSecondDerivSignBracket β θstar θ /
        (Real.cos (θstar - θ)) ^ β) θ := by
  have hinner : HasDerivAt (fun x : ℝ => θstar - x) (-1) θ := by
    simpa using (hasDerivAt_const θ θstar).sub (hasDerivAt_id θ)
  have hfirst := hasDerivAt_finiteGenreFirstAngleLabel_signBracket
    (β := β) (θstar := θstar) (θ := θstar - θ) hβ hcos
  have hcomp := hfirst.comp θ hinner
  have hbracket :
      twoUserSecondDerivSignBracket β θstar (θstar - θ) =
        twoUserSecondDerivSignBracket β θstar θ := by
    unfold twoUserSecondDerivSignBracket
    rw [show θstar - 2 * (θstar - θ) = -(θstar - 2 * θ) by ring,
      Real.cos_neg]
  convert hcomp using 1
  · ext x
    simp [finiteGenreFirstAngleLabel, finiteGenreSecondAngleLabel]
  · rw [hbracket]
    ring

/--
If two distinct positive-cosine angles have the same first finite-genre FOC
label, then the source `secondderiv` bracket vanishes at an angle strictly
between them. This is the exact Rolle-theorem link missing from the source's
informal Step-1 invocation of `secondderiv`; it is not by itself a global
simultaneous-label fiber or support-graph theorem.
-/
theorem finiteGenreFirstAngleLabel_eq_of_lt_exists_secondDerivSignBracket_zero
    {β θstar a b : ℝ} (hβ : 0 < β) (hab : a < b)
    (hcos : ∀ θ, θ ∈ Set.Icc a b → 0 < Real.cos θ)
    (hlabel : finiteGenreFirstAngleLabel β θstar a =
      finiteGenreFirstAngleLabel β θstar b) :
    ∃ c, c ∈ Set.Ioo a b ∧
      twoUserSecondDerivSignBracket β θstar c = 0 := by
  have hcont : ContinuousOn (fun θ => finiteGenreFirstAngleLabel β θstar θ)
      (Set.Icc a b) := by
    intro θ hθ
    exact (hasDerivAt_finiteGenreFirstAngleLabel_signBracket hβ
      (hcos θ hθ)).continuousAt.continuousWithinAt
  rcases exists_hasDerivAt_eq_zero hab hcont hlabel
    (fun θ hθ => hasDerivAt_finiteGenreFirstAngleLabel_signBracket hβ
      (hcos θ ⟨hθ.1.le, hθ.2.le⟩)) with ⟨c, hc, hzero⟩
  refine ⟨c, hc, ?_⟩
  have hpow_ne : (Real.cos c) ^ β ≠ 0 :=
    ne_of_gt (Real.rpow_pos_of_pos (hcos c ⟨hc.1.le, hc.2.le⟩) _)
  have hmul_zero : (β / 2) * twoUserSecondDerivSignBracket β θstar c = 0 :=
    (div_eq_zero_iff).mp hzero |>.resolve_right hpow_ne
  have hβ_div_ne : β / 2 ≠ 0 := by linarith
  exact (mul_eq_zero.mp hmul_zero).resolve_left hβ_div_ne

/-- On the acute interior angle interval, the ratio of the cosine powers
appearing in the two finite-genre label derivatives is strictly decreasing. -/
theorem finiteGenreCosRpowRatio_strictAntiOn
    {β θstar : ℝ} (hβ : 0 < β) (hθstar_le : θstar ≤ Real.pi / 2) :
    StrictAntiOn
      (fun θ : ℝ =>
        (Real.cos θ) ^ β / (Real.cos (θstar - θ)) ^ β)
      (Set.Ioo 0 θstar) := by
  intro x hx y hy hxy
  change 0 < x ∧ x < θstar at hx
  change 0 < y ∧ y < θstar at hy
  have hx_mem : x ∈ Set.Icc (0 : ℝ) Real.pi := by
    constructor <;> linarith [Real.pi_pos]
  have hy_mem : y ∈ Set.Icc (0 : ℝ) Real.pi := by
    constructor <;> linarith [Real.pi_pos]
  have hdx_mem : θstar - x ∈ Set.Icc (0 : ℝ) Real.pi := by
    constructor <;> linarith [Real.pi_pos]
  have hdy_mem : θstar - y ∈ Set.Icc (0 : ℝ) Real.pi := by
    constructor <;> linarith [Real.pi_pos]
  have hcos_xy : Real.cos y < Real.cos x :=
    Real.strictAntiOn_cos hx_mem hy_mem hxy
  have hcos_delta : Real.cos (θstar - x) < Real.cos (θstar - y) :=
    Real.strictAntiOn_cos hdy_mem hdx_mem (by linarith)
  have hcx_pos : 0 < Real.cos x :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith⟩
  have hcy_pos : 0 < Real.cos y :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith⟩
  have hcdx_pos : 0 < Real.cos (θstar - x) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith⟩
  have hcdy_pos : 0 < Real.cos (θstar - y) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith⟩
  have hnum : (Real.cos y) ^ β < (Real.cos x) ^ β :=
    Real.strictMonoOn_rpow_Ici_of_exponent_pos hβ hcy_pos.le hcx_pos.le hcos_xy
  have hden : (Real.cos (θstar - x)) ^ β <
      (Real.cos (θstar - y)) ^ β :=
    Real.strictMonoOn_rpow_Ici_of_exponent_pos hβ hcdx_pos.le hcdy_pos.le hcos_delta
  rw [div_lt_div_iff₀ (Real.rpow_pos_of_pos hcdy_pos _)
    (Real.rpow_pos_of_pos hcdx_pos _)]
  exact mul_lt_mul hnum hden.le (Real.rpow_pos_of_pos hcdx_pos _)
    (Real.rpow_nonneg hcx_pos.le _)

/-- Two common finite-genre FOC labels force at least two bracket roots
between any two distinct interior angles.  This is the key repair to the
printed proof: Cauchy's mean-value theorem couples both label equations, so a
single intervening root would equate a strictly decreasing cosine ratio on
opposite sides of that root. -/
theorem finiteGenre_common_angleLabels_exists_two_secondDerivSignBracket_roots
    {β θstar a b : ℝ} (hβ : 0 < β)
    (hθstar_pos : 0 < θstar) (hθstar_le : θstar ≤ Real.pi / 2)
    (ha : 0 < a) (hab : a < b) (hb : b < θstar)
    (hcos : ∀ θ, θ ∈ Set.Icc a b → 0 < Real.cos θ)
    (hcos_reflected : ∀ θ, θ ∈ Set.Icc a b →
      0 < Real.cos (θstar - θ))
    (hfirst : finiteGenreFirstAngleLabel β θstar a =
      finiteGenreFirstAngleLabel β θstar b)
    (hsecond : finiteGenreSecondAngleLabel β θstar a =
      finiteGenreSecondAngleLabel β θstar b) :
    ∃ c d, c ∈ Set.Ioo a b ∧ d ∈ Set.Ioo a b ∧ c ≠ d ∧
      twoUserSecondDerivSignBracket β θstar c = 0 ∧
      twoUserSecondDerivSignBracket β θstar d = 0 := by
  let f : ℝ → ℝ := finiteGenreFirstAngleLabel β θstar
  let g : ℝ → ℝ := finiteGenreSecondAngleLabel β θstar
  let q : ℝ → ℝ := twoUserSecondDerivSignBracket β θstar
  let df : ℝ → ℝ := fun θ =>
    (β / 2) * q θ / (Real.cos θ) ^ β
  let dg : ℝ → ℝ := fun θ =>
    (-(β / 2)) * q θ / (Real.cos (θstar - θ)) ^ β
  obtain ⟨c, hc, hcroot⟩ :=
    finiteGenreFirstAngleLabel_eq_of_lt_exists_secondDerivSignBracket_zero
      hβ hab hcos hfirst
  suffices hex : ∃ d, d ∈ Set.Ioo a b ∧ c ≠ d ∧ q d = 0 by
    rcases hex with ⟨d, hd, hcd, hdroot⟩
    exact ⟨c, d, hc, hd, hcd, hcroot, by simpa only [q] using hdroot⟩
  by_contra hno_second
  push Not at hno_second
  have hroot_unique : ∀ x, x ∈ Set.Ioo a b → q x = 0 → x = c := by
    intro x hx hxroot
    by_contra hxc
    exact hno_second x hx (Ne.symm hxc) hxroot
  have hf_deriv : ∀ x, x ∈ Set.Ioo a b → HasDerivAt f (df x) x := by
    intro x hx
    simpa only [f, df, q] using
      hasDerivAt_finiteGenreFirstAngleLabel_signBracket hβ
        (hcos x ⟨hx.1.le, hx.2.le⟩)
  have hg_deriv : ∀ x, x ∈ Set.Ioo a b → HasDerivAt g (dg x) x := by
    intro x hx
    simpa only [g, dg, q, neg_mul] using
      hasDerivAt_finiteGenreSecondAngleLabel_signBracket hβ
        (hcos_reflected x ⟨hx.1.le, hx.2.le⟩)
  have hf_cont : ContinuousOn f (Set.Icc a b) := by
    intro x hx
    exact (hasDerivAt_finiteGenreFirstAngleLabel_signBracket hβ
      (hcos x hx)).continuousAt.continuousWithinAt
  have hg_cont : ContinuousOn g (Set.Icc a b) := by
    intro x hx
    exact (hasDerivAt_finiteGenreSecondAngleLabel_signBracket hβ
      (hcos_reflected x hx)).continuousAt.continuousWithinAt
  have hf_cont_left : ContinuousOn f (Set.Icc a c) :=
    hf_cont.mono (Set.Icc_subset_Icc_right hc.2.le)
  have hg_cont_left : ContinuousOn g (Set.Icc a c) :=
    hg_cont.mono (Set.Icc_subset_Icc_right hc.2.le)
  have hf_cont_right : ContinuousOn f (Set.Icc c b) :=
    hf_cont.mono (Set.Icc_subset_Icc_left hc.1.le)
  have hg_cont_right : ContinuousOn g (Set.Icc c b) :=
    hg_cont.mono (Set.Icc_subset_Icc_left hc.1.le)
  have hf_deriv_left : ∀ x, x ∈ Set.Ioo a c → HasDerivAt f (df x) x := by
    intro x hx
    exact hf_deriv x ⟨hx.1, hx.2.trans hc.2⟩
  have hg_deriv_left : ∀ x, x ∈ Set.Ioo a c → HasDerivAt g (dg x) x := by
    intro x hx
    exact hg_deriv x ⟨hx.1, hx.2.trans hc.2⟩
  have hf_deriv_right : ∀ x, x ∈ Set.Ioo c b → HasDerivAt f (df x) x := by
    intro x hx
    exact hf_deriv x ⟨hc.1.trans hx.1, hx.2⟩
  have hg_deriv_right : ∀ x, x ∈ Set.Ioo c b → HasDerivAt g (dg x) x := by
    intro x hx
    exact hg_deriv x ⟨hc.1.trans hx.1, hx.2⟩
  obtain ⟨x, hx, hx_cauchy⟩ :=
    exists_ratio_hasDerivAt_eq_ratio_slope f df hc.1 hf_cont_left hf_deriv_left
      g dg hg_cont_left hg_deriv_left
  obtain ⟨y, hy, hy_cauchy_raw⟩ :=
    exists_ratio_hasDerivAt_eq_ratio_slope f df hc.2 hf_cont_right hf_deriv_right
      g dg hg_cont_right hg_deriv_right
  have hy_cauchy : (g c - g a) * df y = (f c - f a) * dg y := by
    calc
      (g c - g a) * df y = -(g b - g c) * df y := by
        rw [show g a = g b by simpa only [g] using hsecond]
        ring
      _ = -(f b - f c) * dg y := by
        linear_combination -hy_cauchy_raw
      _ = (f c - f a) * dg y := by
        rw [show f a = f b by simpa only [f] using hfirst]
        ring
  have hxroot_ne : q x ≠ 0 := by
    intro hxzero
    have hxc : x = c := hroot_unique x
      ⟨hx.1, hx.2.trans hc.2⟩ hxzero
    exact (lt_irrefl c) (by simpa [hxc] using hx.2)
  have hyroot_ne : q y ≠ 0 := by
    intro hyzero
    have hyc : y = c := hroot_unique y
      ⟨hc.1.trans hy.1, hy.2⟩ hyzero
    exact (lt_irrefl c) (by simpa [hyc] using hy.1)
  have hfc_ne : f c - f a ≠ 0 := by
    intro hzero
    have hfa_fc : f a = f c := by linarith
    have hcos_ac : ∀ θ, θ ∈ Set.Icc a c → 0 < Real.cos θ := by
      intro θ hθ
      exact hcos θ ⟨hθ.1, hθ.2.trans hc.2.le⟩
    obtain ⟨d, hd, hdroot⟩ :=
      finiteGenreFirstAngleLabel_eq_of_lt_exists_secondDerivSignBracket_zero
        hβ hc.1 hcos_ac (by simpa only [f] using hfa_fc)
    have hdc : d = c := hroot_unique d
      ⟨hd.1, hd.2.trans hc.2⟩ (by simpa only [q] using hdroot)
    exact (lt_irrefl c) (by simpa [hdc] using hd.2)
  have hK_ne : β / 2 ≠ 0 := by linarith
  have hcx_pos : 0 < Real.cos x := hcos x
    ⟨hx.1.le, (hx.2.trans hc.2).le⟩
  have hcy_pos : 0 < Real.cos y := hcos y
    ⟨(hc.1.trans hy.1).le, hy.2.le⟩
  have hcdx_pos : 0 < Real.cos (θstar - x) := hcos_reflected x
    ⟨hx.1.le, (hx.2.trans hc.2).le⟩
  have hcdy_pos : 0 < Real.cos (θstar - y) := hcos_reflected y
    ⟨(hc.1.trans hy.1).le, hy.2.le⟩
  have hpx_ne : (Real.cos x) ^ β ≠ 0 :=
    (Real.rpow_pos_of_pos hcx_pos _).ne'
  have hpy_ne : (Real.cos y) ^ β ≠ 0 :=
    (Real.rpow_pos_of_pos hcy_pos _).ne'
  have hpdx_ne : (Real.cos (θstar - x)) ^ β ≠ 0 :=
    (Real.rpow_pos_of_pos hcdx_pos _).ne'
  have hpdy_ne : (Real.cos (θstar - y)) ^ β ≠ 0 :=
    (Real.rpow_pos_of_pos hcdy_pos _).ne'
  have hx_relation :
      (g c - g a) * (Real.cos (θstar - x)) ^ β =
        -(f c - f a) * (Real.cos x) ^ β := by
    dsimp only [df, dg] at hx_cauchy
    field_simp [hK_ne, hxroot_ne, hpx_ne, hpdx_ne] at hx_cauchy
    linear_combination hx_cauchy
  have hy_relation :
      (g c - g a) * (Real.cos (θstar - y)) ^ β =
        -(f c - f a) * (Real.cos y) ^ β := by
    dsimp only [df, dg] at hy_cauchy
    field_simp [hK_ne, hyroot_ne, hpy_ne, hpdy_ne] at hy_cauchy
    linear_combination hy_cauchy
  have hx_ratio : g c - g a =
      -(f c - f a) *
        ((Real.cos x) ^ β / (Real.cos (θstar - x)) ^ β) := by
    calc
      g c - g a = (-(f c - f a) * (Real.cos x) ^ β) /
          (Real.cos (θstar - x)) ^ β := (eq_div_iff hpdx_ne).2 hx_relation
      _ = -(f c - f a) *
          ((Real.cos x) ^ β / (Real.cos (θstar - x)) ^ β) := by ring
  have hy_ratio : g c - g a =
      -(f c - f a) *
        ((Real.cos y) ^ β / (Real.cos (θstar - y)) ^ β) := by
    calc
      g c - g a = (-(f c - f a) * (Real.cos y) ^ β) /
          (Real.cos (θstar - y)) ^ β := (eq_div_iff hpdy_ne).2 hy_relation
      _ = -(f c - f a) *
          ((Real.cos y) ^ β / (Real.cos (θstar - y)) ^ β) := by ring
  have hratio_eq :
      (Real.cos x) ^ β / (Real.cos (θstar - x)) ^ β =
        (Real.cos y) ^ β / (Real.cos (θstar - y)) ^ β := by
    apply mul_left_cancel₀ (neg_ne_zero.mpr hfc_ne)
    rw [← hx_ratio, ← hy_ratio]
  have hx_domain : x ∈ Set.Ioo 0 θstar := by
    exact ⟨ha.trans hx.1, hx.2.trans (hc.2.trans hb)⟩
  have hy_domain : y ∈ Set.Ioo 0 θstar := by
    exact ⟨ha.trans (hc.1.trans hy.1), hy.2.trans hb⟩
  have hstrict := finiteGenreCosRpowRatio_strictAntiOn hβ hθstar_le
    hx_domain hy_domain (hx.2.trans hy.1)
  exact (ne_of_gt hstrict) hratio_eq

/-- In the acute above-threshold regime, two distinct angles with both common
FOC labels must lie on opposite sides of the user-angle bisector. -/
theorem finiteGenre_common_angleLabels_straddle_bisector_of_phaseThreshold_lt_beta
    {β θstar a b : ℝ}
    (hθstar_pos : 0 < θstar) (hθstar_lt_pi : θstar < Real.pi)
    (hθstar_le : θstar ≤ Real.pi / 2)
    (hden : 0 < 1 - Real.cos θstar) (hcosstar : 0 < Real.cos θstar)
    (hphase : twoUserPhaseThreshold θstar < β)
    (ha : 0 < a) (hab : a < b) (hb : b < θstar)
    (hfirst : finiteGenreFirstAngleLabel β θstar a =
      finiteGenreFirstAngleLabel β θstar b)
    (hsecond : finiteGenreSecondAngleLabel β θstar a =
      finiteGenreSecondAngleLabel β θstar b) :
    a < θstar / 2 ∧ θstar / 2 < b := by
  have hβtwo : 2 < β :=
    twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcosstar hphase
  have hβ : 0 < β := by linarith
  have hcos_on : ∀ θ, θ ∈ Set.Icc a b → 0 < Real.cos θ := by
    intro θ hθ
    change a ≤ θ ∧ θ ≤ b at hθ
    exact Real.cos_pos_of_mem_Ioo
      ⟨by linarith [Real.pi_pos], by linarith⟩
  have hcos_reflected : ∀ θ, θ ∈ Set.Icc a b →
      0 < Real.cos (θstar - θ) := by
    intro θ hθ
    change a ≤ θ ∧ θ ≤ b at hθ
    exact Real.cos_pos_of_mem_Ioo
      ⟨by linarith [Real.pi_pos], by linarith⟩
  obtain ⟨c, d, hc, hd, hcd, hcroot, hdroot⟩ :=
    finiteGenre_common_angleLabels_exists_two_secondDerivSignBracket_roots
      hβ hθstar_pos hθstar_le ha hab hb hcos_on hcos_reflected hfirst hsecond
  rcases
    twoUserSecondDerivSignBracket_existsUnique_zero_on_each_half_of_phaseThreshold_lt_beta
      hθstar_pos hθstar_lt_pi hden hcosstar hphase with
    ⟨⟨leftRoot, hleftRoot, hleftUnique⟩,
      ⟨rightRoot, hrightRoot, hrightUnique⟩⟩
  have hmid_pos : 0 <
      twoUserSecondDerivSignBracket β θstar (θstar / 2) :=
    twoUserSecondDerivSignBracket_midpoint_pos_of_phaseThreshold_lt_beta
      hβ hden hphase
  have classify_root : ∀ x, x ∈ Set.Ioo a b →
      twoUserSecondDerivSignBracket β θstar x = 0 →
      x = leftRoot ∨ x = rightRoot := by
    intro x hx hxroot
    rcases lt_trichotomy x (θstar / 2) with hleft | hmid | hright
    · exact Or.inl (hleftUnique x ⟨⟨ha.trans hx.1, hleft⟩, hxroot⟩)
    · exfalso
      rw [hmid] at hxroot
      linarith
    · exact Or.inr (hrightUnique x ⟨⟨hright, hx.2.trans hb⟩, hxroot⟩)
  rcases classify_root c hc hcroot with hc_left | hc_right
  · have hd_right : d = rightRoot := by
      rcases classify_root d hd hdroot with hd_left | hd_right
      · exact (hcd (hc_left.trans hd_left.symm)).elim
      · exact hd_right
    constructor
    · linarith [hc.1, hleftRoot.1.2]
    · linarith [hd.2, hrightRoot.1.1]
  · have hd_left : d = leftRoot := by
      rcases classify_root d hd hdroot with hd_left | hd_right
      · exact hd_left
      · exact (hcd (hc_right.trans hd_right.symm)).elim
    constructor
    · linarith [hd.1, hleftRoot.1.2]
    · linarith [hc.2, hrightRoot.1.1]

/-- Three strictly ordered interior angles cannot share both finite-genre FOC
labels above the phase threshold. -/
theorem finiteGenre_common_angleLabels_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
    {β θstar θ1 θ2 θ3 : ℝ}
    (hθstar_pos : 0 < θstar) (hθstar_lt_pi : θstar < Real.pi)
    (hθstar_le : θstar ≤ Real.pi / 2)
    (hden : 0 < 1 - Real.cos θstar) (hcosstar : 0 < Real.cos θstar)
    (hphase : twoUserPhaseThreshold θstar < β)
    (hθ1_pos : 0 < θ1) (h12 : θ1 < θ2) (h23 : θ2 < θ3)
    (h3star : θ3 < θstar)
    (hfirst12 : finiteGenreFirstAngleLabel β θstar θ1 =
      finiteGenreFirstAngleLabel β θstar θ2)
    (hfirst23 : finiteGenreFirstAngleLabel β θstar θ2 =
      finiteGenreFirstAngleLabel β θstar θ3)
    (hsecond12 : finiteGenreSecondAngleLabel β θstar θ1 =
      finiteGenreSecondAngleLabel β θstar θ2)
    (hsecond23 : finiteGenreSecondAngleLabel β θstar θ2 =
      finiteGenreSecondAngleLabel β θstar θ3) : False := by
  have hleft :=
    finiteGenre_common_angleLabels_straddle_bisector_of_phaseThreshold_lt_beta
      hθstar_pos hθstar_lt_pi hθstar_le hden hcosstar hphase
      hθ1_pos h12 (h23.trans h3star) hfirst12 hsecond12
  have hright :=
    finiteGenre_common_angleLabels_straddle_bisector_of_phaseThreshold_lt_beta
      hθstar_pos hθstar_lt_pi hθstar_le hden hcosstar hphase
      (hθ1_pos.trans h12) h23 h3star hfirst23 hsecond23
  linarith

/-- Any three distinct finite genre indices with both globally propagated FOC
labels contradict the preceding ordered theorem. -/
theorem finiteGenre_common_angleLabels_not_eq_on_three_distinct_of_phaseThreshold_lt_beta
    {ι : Type*} {β θstar : ℝ} (angle : ι → ℝ)
    (hinjective : Function.Injective angle)
    (hθstar_pos : 0 < θstar) (hθstar_lt_pi : θstar < Real.pi)
    (hθstar_le : θstar ≤ Real.pi / 2)
    (hden : 0 < 1 - Real.cos θstar) (hcosstar : 0 < Real.cos θstar)
    (hphase : twoUserPhaseThreshold θstar < β)
    (hangle_pos : ∀ i, 0 < angle i) (hangle_lt : ∀ i, angle i < θstar)
    (hlabels : ∀ i j,
      finiteGenreFirstAngleLabel β θstar (angle i) =
          finiteGenreFirstAngleLabel β θstar (angle j) ∧
        finiteGenreSecondAngleLabel β θstar (angle i) =
          finiteGenreSecondAngleLabel β θstar (angle j))
    {i1 i2 i3 : ι} (h12 : i1 ≠ i2) (h13 : i1 ≠ i3) (h23 : i2 ≠ i3) :
    False := by
  have hangle12 : angle i1 ≠ angle i2 := fun h => h12 (hinjective h)
  have hangle13 : angle i1 ≠ angle i3 := fun h => h13 (hinjective h)
  have hangle23 : angle i2 ≠ angle i3 := fun h => h23 (hinjective h)
  rcases lt_or_gt_of_ne hangle12 with h12lt | h21lt
  · rcases lt_or_gt_of_ne hangle13 with h13lt | h31lt
    · rcases lt_or_gt_of_ne hangle23 with h23lt | h32lt
      · exact finiteGenre_common_angleLabels_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
          hθstar_pos hθstar_lt_pi hθstar_le hden hcosstar hphase
          (hangle_pos i1) h12lt h23lt (hangle_lt i3)
          (hlabels i1 i2).1 (hlabels i2 i3).1
          (hlabels i1 i2).2 (hlabels i2 i3).2
      · exact finiteGenre_common_angleLabels_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
          hθstar_pos hθstar_lt_pi hθstar_le hden hcosstar hphase
          (hangle_pos i1) h13lt h32lt (hangle_lt i2)
          (hlabels i1 i3).1 (hlabels i3 i2).1
          (hlabels i1 i3).2 (hlabels i3 i2).2
    · exact finiteGenre_common_angleLabels_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
        hθstar_pos hθstar_lt_pi hθstar_le hden hcosstar hphase
        (hangle_pos i3) h31lt h12lt (hangle_lt i2)
        (hlabels i3 i1).1 (hlabels i1 i2).1
        (hlabels i3 i1).2 (hlabels i1 i2).2
  · rcases lt_or_gt_of_ne hangle23 with h23lt | h32lt
    · rcases lt_or_gt_of_ne hangle13 with h13lt | h31lt
      · exact finiteGenre_common_angleLabels_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
          hθstar_pos hθstar_lt_pi hθstar_le hden hcosstar hphase
          (hangle_pos i2) h21lt h13lt (hangle_lt i3)
          (hlabels i2 i1).1 (hlabels i1 i3).1
          (hlabels i2 i1).2 (hlabels i1 i3).2
      · exact finiteGenre_common_angleLabels_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
          hθstar_pos hθstar_lt_pi hθstar_le hden hcosstar hphase
          (hangle_pos i2) h23lt h31lt (hangle_lt i1)
          (hlabels i2 i3).1 (hlabels i3 i1).1
          (hlabels i2 i3).2 (hlabels i3 i1).2
    · exact finiteGenre_common_angleLabels_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
        hθstar_pos hθstar_lt_pi hθstar_le hden hcosstar hphase
        (hangle_pos i3) h32lt h21lt (hangle_lt i1)
        (hlabels i3 i2).1 (hlabels i2 i1).1
        (hlabels i3 i2).2 (hlabels i2 i1).2

/-- The full finite-genre Step-1 cardinality conclusion follows from the two
propagated labels alone; no unsupported `regionscolor` premise is needed. -/
theorem finiteGenre_card_le_two_of_common_angleLabels_of_phaseThreshold_lt_beta
    {ι : Type*} [Fintype ι] {β θstar : ℝ} (angle : ι → ℝ)
    (hinjective : Function.Injective angle)
    (hθstar_pos : 0 < θstar) (hθstar_lt_pi : θstar < Real.pi)
    (hθstar_le : θstar ≤ Real.pi / 2)
    (hden : 0 < 1 - Real.cos θstar) (hcosstar : 0 < Real.cos θstar)
    (hphase : twoUserPhaseThreshold θstar < β)
    (hangle_pos : ∀ i, 0 < angle i) (hangle_lt : ∀ i, angle i < θstar)
    (hlabels : ∀ i j,
      finiteGenreFirstAngleLabel β θstar (angle i) =
          finiteGenreFirstAngleLabel β θstar (angle j) ∧
        finiteGenreSecondAngleLabel β θstar (angle i) =
          finiteGenreSecondAngleLabel β θstar (angle j)) :
    Fintype.card ι ≤ 2 := by
  classical
  by_contra hcard
  have hthree : 3 ≤ Fintype.card ι := by omega
  obtain ⟨t, -, htcard⟩ :=
    Finset.exists_subset_card_eq (s := (Finset.univ : Finset ι)) hthree
  obtain ⟨i1, i2, i3, h12, h13, h23, -⟩ := Finset.card_eq_three.mp htcard
  exact finiteGenre_common_angleLabels_not_eq_on_three_distinct_of_phaseThreshold_lt_beta
    angle hinjective hθstar_pos hθstar_lt_pi hθstar_le hden hcosstar hphase
    hangle_pos hangle_lt hlabels h12 h13 h23

/--
Finitegenre Step 1 derived from the actual finite-ray Nash law.  The score
intervals and both common FOC labels come from the one-coordinate no-gap
repair, and the simultaneous-label fiber theorem then gives the paper's
at-most-two conclusion without a `regionscolor` support-graph premise.
-/
theorem finiteGenre_card_le_two_of_scaledNormRpowCostNash_of_phaseThreshold_lt_beta
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {ν : SourceNorm 2}
    {μ : MixedContentStrategy 2} [IsProbabilityMeasure μ]
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hinjective : Function.Injective angle)
    (hα : 0 < α)
    (hθ_pos : 0 < θ) (hθ_lt_pi : θ < Real.pi)
    (hθ_le : θ ≤ Real.pi / 2)
    (hden : 0 < 1 - Real.cos θ) (hcosstar : 0 < Real.cos θ)
    (hphase : twoUserPhaseThreshold θ < β)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hderiv1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) z.1) z.1)
    (hderiv2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 =>
            score (canonicalTwoUserSecond θ) q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 =>
            score (canonicalTwoUserSecond θ) q) μ) x) z.2) z.2)
    (hangle_pos : ∀ i, 0 < angle i)
    (hangle_lt : ∀ i, angle i < θ)
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i)))) :
    Fintype.card ι ≤ 2 := by
  have hβtwo : 2 < β :=
    twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcosstar hphase
  have hβ : 0 < β := by linarith
  have hsin : 0 < Real.sin θ :=
    Real.sin_pos_of_pos_of_lt_pi hθ_pos hθ_lt_pi
  have hcos_first : ∀ i, 0 < Real.cos (angle i) := by
    intro i
    exact Real.cos_pos_of_mem_Ioo
      ⟨by linarith [Real.pi_pos, hangle_pos i], by linarith [hangle_lt i, hθ_le]⟩
  have hcos_second : ∀ i, 0 < Real.cos (θ - angle i) := by
    intro i
    exact Real.cos_pos_of_mem_Ioo
      ⟨by linarith [Real.pi_pos, hangle_lt i], by linarith [hangle_pos i, hθ_le]⟩
  obtain ⟨-, -, -, -, -, -, -, -, -, -, hlabels⟩ :=
    finiteGenre_exists_scoreIntervals_and_angleLabel_eq_of_finiteGenres
      (ν := ν) angle hα hβ hsin hcosstar.le hθ_lt_pi hnash hscore_ac
      hinterior hderiv1 hderiv2 hangle_pos hangle_lt hcos_first hcos_second hgenres
  exact finiteGenre_card_le_two_of_common_angleLabels_of_phaseThreshold_lt_beta
    angle hinjective hθ_pos hθ_lt_pi hθ_le hden hcosstar hphase
    hangle_pos hangle_lt hlabels

/--
The genuine first stage of the source's finite-genre root-count argument.
In the acute above-threshold regime, four strictly ordered positive-cosine
angles cannot all have the same first FOC label: the three intervening Rolle
roots would contradict the two checked bracket-root regions. This is an
ordered first-label fiber bound only; it does not supply the source's further
`regionscolor` exclusion or a global finite-index cardinality conclusion.
-/
theorem finiteGenreFirstAngleLabel_not_eq_on_four_strictly_ordered_of_phaseThreshold_lt_beta
    {β θstar theta1 theta2 theta3 theta4 : ℝ}
    (hθstar_pos : 0 < θstar) (hθstar_lt_pi : θstar < Real.pi)
    (hden : 0 < 1 - Real.cos θstar) (hcosstar : 0 < Real.cos θstar)
    (hphase : twoUserPhaseThreshold θstar < β)
    (hθ1_pos : 0 < theta1) (h12 : theta1 < theta2)
    (h23 : theta2 < theta3) (h34 : theta3 < theta4)
    (h4star : theta4 < θstar)
    (hcos : ∀ theta, theta ∈ Set.Icc theta1 theta4 → 0 < Real.cos theta)
    (hlabel12 : finiteGenreFirstAngleLabel β θstar theta1 =
      finiteGenreFirstAngleLabel β θstar theta2)
    (hlabel23 : finiteGenreFirstAngleLabel β θstar theta2 =
      finiteGenreFirstAngleLabel β θstar theta3)
    (hlabel34 : finiteGenreFirstAngleLabel β θstar theta3 =
      finiteGenreFirstAngleLabel β θstar theta4) : False := by
  have hβtwo : 2 < β :=
    twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcosstar hphase
  have hβ : 0 < β := by linarith
  rcases
    twoUserSecondDerivSignBracket_existsUnique_zero_on_each_half_of_phaseThreshold_lt_beta
      hθstar_pos hθstar_lt_pi hden hcosstar hphase with
    ⟨⟨leftRoot, hleftRoot, hleftUnique⟩,
      ⟨rightRoot, hrightRoot, hrightUnique⟩⟩
  have hmid_pos : 0 < twoUserSecondDerivSignBracket β θstar (θstar / 2) :=
    twoUserSecondDerivSignBracket_midpoint_pos_of_phaseThreshold_lt_beta
      hβ hden hphase
  have hcos12 : ∀ theta, theta ∈ Set.Icc theta1 theta2 → 0 < Real.cos theta := by
    intro theta htheta
    apply hcos theta
    exact ⟨htheta.1, htheta.2.trans (h23.trans h34).le⟩
  have hcos23 : ∀ theta, theta ∈ Set.Icc theta2 theta3 → 0 < Real.cos theta := by
    intro theta htheta
    apply hcos theta
    exact ⟨h12.le.trans htheta.1, htheta.2.trans h34.le⟩
  have hcos34 : ∀ theta, theta ∈ Set.Icc theta3 theta4 → 0 < Real.cos theta := by
    intro theta htheta
    apply hcos theta
    exact ⟨(h12.trans h23).le.trans htheta.1, htheta.2⟩
  rcases finiteGenreFirstAngleLabel_eq_of_lt_exists_secondDerivSignBracket_zero
    hβ h12 hcos12 hlabel12 with ⟨c12, hc12, hc12zero⟩
  rcases finiteGenreFirstAngleLabel_eq_of_lt_exists_secondDerivSignBracket_zero
    hβ h23 hcos23 hlabel23 with ⟨c23, hc23, hc23zero⟩
  rcases finiteGenreFirstAngleLabel_eq_of_lt_exists_secondDerivSignBracket_zero
    hβ h34 hcos34 hlabel34 with ⟨c34, hc34, hc34zero⟩
  have hc12pos : 0 < c12 := hθ1_pos.trans hc12.1
  have hc23pos : 0 < c23 := hθ1_pos.trans (h12.trans hc23.1)
  have hc34pos : 0 < c34 := hθ1_pos.trans (h12.trans (h23.trans hc34.1))
  have hc12star : c12 < θstar := hc12.2.trans (h23.trans (h34.trans h4star))
  have hc23star : c23 < θstar := hc23.2.trans (h34.trans h4star)
  have hc34star : c34 < θstar := hc34.2.trans h4star
  have hside12 : c12 < θstar / 2 ∨ θstar / 2 < c12 := by
    rcases lt_trichotomy c12 (θstar / 2) with hlt | heq | hgt
    · exact Or.inl hlt
    · exfalso
      rw [heq] at hc12zero
      linarith
    · exact Or.inr hgt
  have hside23 : c23 < θstar / 2 ∨ θstar / 2 < c23 := by
    rcases lt_trichotomy c23 (θstar / 2) with hlt | heq | hgt
    · exact Or.inl hlt
    · exfalso
      rw [heq] at hc23zero
      linarith
    · exact Or.inr hgt
  have hside34 : c34 < θstar / 2 ∨ θstar / 2 < c34 := by
    rcases lt_trichotomy c34 (θstar / 2) with hlt | heq | hgt
    · exact Or.inl hlt
    · exfalso
      rw [heq] at hc34zero
      linarith
    · exact Or.inr hgt
  rcases hside12 with h12left | h12right
  · rcases hside23 with h23left | h23right
    · have heq : c12 = c23 :=
        (hleftUnique c12 ⟨⟨hc12pos, h12left⟩, hc12zero⟩).trans
          (hleftUnique c23 ⟨⟨hc23pos, h23left⟩, hc23zero⟩).symm
      linarith [hc12.2, hc23.1]
    · rcases hside34 with h34left | h34right
      · have heq : c12 = c34 :=
          (hleftUnique c12 ⟨⟨hc12pos, h12left⟩, hc12zero⟩).trans
            (hleftUnique c34 ⟨⟨hc34pos, h34left⟩, hc34zero⟩).symm
        linarith [hc12.2, hc34.1, h23]
      · have heq : c23 = c34 :=
          (hrightUnique c23 ⟨⟨h23right, hc23star⟩, hc23zero⟩).trans
            (hrightUnique c34 ⟨⟨h34right, hc34star⟩, hc34zero⟩).symm
        linarith [hc23.2, hc34.1]
  · rcases hside23 with h23left | h23right
    · rcases hside34 with h34left | h34right
      · have heq : c23 = c34 :=
          (hleftUnique c23 ⟨⟨hc23pos, h23left⟩, hc23zero⟩).trans
            (hleftUnique c34 ⟨⟨hc34pos, h34left⟩, hc34zero⟩).symm
        linarith [hc23.2, hc34.1]
      · have heq : c12 = c34 :=
          (hrightUnique c12 ⟨⟨h12right, hc12star⟩, hc12zero⟩).trans
            (hrightUnique c34 ⟨⟨h34right, hc34star⟩, hc34zero⟩).symm
        linarith [hc12.2, hc34.1, h23]
    · have heq : c12 = c23 :=
        (hrightUnique c12 ⟨⟨h12right, hc12star⟩, hc12zero⟩).trans
          (hrightUnique c23 ⟨⟨h23right, hc23star⟩, hc23zero⟩).symm
      linarith [hc12.2, hc23.1]

/--
The source's claimed final two-angle exclusion, with its actual missing
`regionscolor` input made explicit. If the middle of three ordered common
first-label angles has a nonpositive bracket—as a valid differentiable
support-graph/second-order argument would show—then the two intervening Rolle
roots force that bracket to be strictly positive, a contradiction. This does
not construct that support graph from C1--C3.
-/
theorem finiteGenreFirstAngleLabel_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
    {β θstar theta1 theta2 theta3 : ℝ}
    (hθstar_pos : 0 < θstar) (hθstar_lt_pi : θstar < Real.pi)
    (hden : 0 < 1 - Real.cos θstar) (hcosstar : 0 < Real.cos θstar)
    (hphase : twoUserPhaseThreshold θstar < β)
    (hθ1_pos : 0 < theta1) (h12 : theta1 < theta2)
    (h23 : theta2 < theta3) (h3star : theta3 < θstar)
    (hcos : ∀ theta, theta ∈ Set.Icc theta1 theta3 → 0 < Real.cos theta)
    (hlabel12 : finiteGenreFirstAngleLabel β θstar theta1 =
      finiteGenreFirstAngleLabel β θstar theta2)
    (hlabel23 : finiteGenreFirstAngleLabel β θstar theta2 =
      finiteGenreFirstAngleLabel β θstar theta3)
    (hbracket2 : twoUserSecondDerivSignBracket β θstar theta2 ≤ 0) : False := by
  have hβtwo : 2 < β :=
    twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcosstar hphase
  have hβ : 0 < β := by linarith
  rcases
    twoUserSecondDerivSignBracket_existsUnique_zero_on_each_half_of_phaseThreshold_lt_beta
      hθstar_pos hθstar_lt_pi hden hcosstar hphase with
    ⟨⟨leftRoot, hleftRoot, hleftUnique⟩,
      ⟨rightRoot, hrightRoot, hrightUnique⟩⟩
  have hmid_pos : 0 < twoUserSecondDerivSignBracket β θstar (θstar / 2) :=
    twoUserSecondDerivSignBracket_midpoint_pos_of_phaseThreshold_lt_beta
      hβ hden hphase
  have hcos12 : ∀ theta, theta ∈ Set.Icc theta1 theta2 → 0 < Real.cos theta := by
    intro theta htheta
    exact hcos theta ⟨htheta.1, htheta.2.trans h23.le⟩
  have hcos23 : ∀ theta, theta ∈ Set.Icc theta2 theta3 → 0 < Real.cos theta := by
    intro theta htheta
    exact hcos theta ⟨h12.le.trans htheta.1, htheta.2⟩
  rcases finiteGenreFirstAngleLabel_eq_of_lt_exists_secondDerivSignBracket_zero
    hβ h12 hcos12 hlabel12 with ⟨c12, hc12, hc12zero⟩
  rcases finiteGenreFirstAngleLabel_eq_of_lt_exists_secondDerivSignBracket_zero
    hβ h23 hcos23 hlabel23 with ⟨c23, hc23, hc23zero⟩
  have hc12_lt_c23 : c12 < c23 := by linarith [hc12.2, hc23.1]
  have hc12pos : 0 < c12 := hθ1_pos.trans hc12.1
  have hc23pos : 0 < c23 := hθ1_pos.trans (h12.trans hc23.1)
  have hc12star : c12 < θstar := hc12.2.trans (h23.trans h3star)
  have hc23star : c23 < θstar := hc23.2.trans h3star
  have hside12 : c12 < θstar / 2 ∨ θstar / 2 < c12 := by
    rcases lt_trichotomy c12 (θstar / 2) with hlt | heq | hgt
    · exact Or.inl hlt
    · exfalso
      rw [heq] at hc12zero
      linarith
    · exact Or.inr hgt
  have hside23 : c23 < θstar / 2 ∨ θstar / 2 < c23 := by
    rcases lt_trichotomy c23 (θstar / 2) with hlt | heq | hgt
    · exact Or.inl hlt
    · exfalso
      rw [heq] at hc23zero
      linarith
    · exact Or.inr hgt
  have h12left : c12 < θstar / 2 := by
    rcases hside12 with hleft12 | hright12
    · exact hleft12
    · rcases hside23 with hleft23 | hright23
      · linarith
      · have heq : c12 = c23 :=
          (hrightUnique c12 ⟨⟨hright12, hc12star⟩, hc12zero⟩).trans
            (hrightUnique c23 ⟨⟨hright23, hc23star⟩, hc23zero⟩).symm
        linarith
  have h23right : θstar / 2 < c23 := by
    rcases hside23 with hleft | hright
    · have heq : c12 = c23 :=
        (hleftUnique c12 ⟨⟨hc12pos, h12left⟩, hc12zero⟩).trans
          (hleftUnique c23 ⟨⟨hc23pos, hleft⟩, hc23zero⟩).symm
      linarith
    · exact hright
  have hbracket2_pos : 0 < twoUserSecondDerivSignBracket β θstar theta2 := by
    rcases lt_trichotomy theta2 (θstar / 2) with hleft | heq | hright
    · have hstrict :=
        twoUserSecondDerivSignBracket_strictMonoOn_left_of_phaseThreshold_lt_beta
          hden hcosstar hphase hθstar_lt_pi
          ⟨hc12pos.le, h12left.le⟩
          ⟨(hθ1_pos.trans h12).le, hleft.le⟩
          (by linarith [hc12.2])
      linarith
    · rw [heq]
      exact hmid_pos
    · have hstrict :=
        twoUserSecondDerivSignBracket_strictAntiOn_right_of_phaseThreshold_lt_beta
          hden hcosstar hphase hθstar_lt_pi
          ⟨hright.le, (h23.trans h3star).le⟩
          ⟨h23right.le, hc23star.le⟩
          (by linarith [hc23.1])
      linarith
  linarith

/--
The source's finitegenre Step-1 contradiction after its missing `regionscolor`
premise is supplied for the middle support ray. Three ordered common
first-label angles are impossible when that ray has positive slope and the C1
negative-semidefinite graph-Hessian condition. This does not derive either
support condition from C1--C3.
-/
theorem finiteGenreFirstAngleLabel_not_eq_on_three_strictly_ordered_of_middle_regionscolor
    {α β θstar theta1 theta2 theta3 r slope : ℝ}
    (hθstar_pos : 0 < θstar) (hθstar_lt_pi : θstar < Real.pi)
    (hden : 0 < 1 - Real.cos θstar) (hcosstar : 0 < Real.cos θstar)
    (hphase : twoUserPhaseThreshold θstar < β)
    (hθ1_pos : 0 < theta1) (h12 : theta1 < theta2)
    (h23 : theta2 < theta3) (h3star : theta3 < θstar)
    (hcos : ∀ theta, theta ∈ Set.Icc theta1 theta3 → 0 < Real.cos theta)
    (hlabel12 : finiteGenreFirstAngleLabel β θstar theta1 =
      finiteGenreFirstAngleLabel β θstar theta2)
    (hlabel23 : finiteGenreFirstAngleLabel β θstar theta2 =
      finiteGenreFirstAngleLabel β θstar theta3)
    (hα : 0 < α) (hsin : 0 < Real.sin θstar)
    (hNpos : 0 < r ^ 2 * (Real.sin θstar) ^ 2)
    (hneg :
      NegativeSemidefiniteQuadratic2
        (slope *
          twoUserInducedCostCrossPartial α β θstar
            (r * Real.cos theta2) (r * Real.cos (θstar - theta2)))
        (-(twoUserInducedCostCrossPartial α β θstar
            (r * Real.cos theta2) (r * Real.cos (θstar - theta2))))
        (slope⁻¹ *
          twoUserInducedCostCrossPartial α β θstar
            (r * Real.cos theta2) (r * Real.cos (θstar - theta2))))
    (hslope : 0 < slope) : False := by
  have hβ : 0 < β := by
    have hβtwo : 2 < β :=
      twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcosstar hphase
    linarith
  have hbracket2 : twoUserSecondDerivSignBracket β θstar theta2 ≤ 0 :=
    twoUser_regionscolor_bracket_nonpos_of_negativeSemidefinite_of_slope_pos
      hα hβ hsin hNpos hneg hslope
  exact
    finiteGenreFirstAngleLabel_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
      hθstar_pos hθstar_lt_pi hden hcosstar hphase hθ1_pos h12 h23 h3star
      hcos hlabel12 hlabel23 hbracket2

/--
Finitegenre's ordered exclusion without a preselected ordering. Three distinct
candidate genre indices with a common first label contradict the nonpositive
bracket condition at every candidate angle. Positivity of cosine throughout
the needed interval follows from the source's acute user-angle hypotheses.
-/
theorem finiteGenreFirstAngleLabel_not_eq_on_three_distinct_of_bracket_nonpos
    {ι : Type*} {β θstar : ℝ} (angle : ι → ℝ)
    (hinjective : Function.Injective angle)
    (hθstar_pos : 0 < θstar) (hθstar_lt_pi : θstar < Real.pi)
    (hden : 0 < 1 - Real.cos θstar) (hcosstar : 0 < Real.cos θstar)
    (hphase : twoUserPhaseThreshold θstar < β)
    (hangle_pos : ∀ i, 0 < angle i) (hangle_lt : ∀ i, angle i < θstar)
    (hlabel : ∀ i j,
      finiteGenreFirstAngleLabel β θstar (angle i) =
        finiteGenreFirstAngleLabel β θstar (angle j))
    (hbracket : ∀ i, twoUserSecondDerivSignBracket β θstar (angle i) ≤ 0)
    {i1 i2 i3 : ι} (h12 : i1 ≠ i2) (h13 : i1 ≠ i3) (h23 : i2 ≠ i3) :
    False := by
  have hθstar_lt_half_pi : θstar < Real.pi / 2 := by
    by_contra hnot
    have hnonpos : Real.cos θstar ≤ 0 :=
      Real.cos_nonpos_of_pi_div_two_le_of_le (le_of_not_gt hnot) (by
        nlinarith [hθstar_lt_pi, Real.pi_pos])
    linarith
  have hcos_on : ∀ theta, theta ∈ Set.Icc 0 θstar → 0 < Real.cos theta := by
    intro theta htheta
    exact Real.cos_pos_of_mem_Ioo ⟨by linarith [htheta.1, Real.pi_pos],
      lt_of_le_of_lt htheta.2 hθstar_lt_half_pi⟩
  have hangle12 : angle i1 ≠ angle i2 := fun h => h12 (hinjective h)
  have hangle13 : angle i1 ≠ angle i3 := fun h => h13 (hinjective h)
  have hangle23 : angle i2 ≠ angle i3 := fun h => h23 (hinjective h)
  rcases lt_or_gt_of_ne hangle12 with h12lt | h21lt
  · rcases lt_or_gt_of_ne hangle13 with h13lt | h31lt
    · rcases lt_or_gt_of_ne hangle23 with h23lt | h32lt
      · exact finiteGenreFirstAngleLabel_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
          hθstar_pos hθstar_lt_pi hden hcosstar hphase (hangle_pos i1) h12lt h23lt
          (hangle_lt i3)
          (fun theta htheta => hcos_on theta
            ⟨(hangle_pos i1).le.trans htheta.1, htheta.2.trans (hangle_lt i3).le⟩)
          (hlabel i1 i2) (hlabel i2 i3) (hbracket i2)
      · exact finiteGenreFirstAngleLabel_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
          hθstar_pos hθstar_lt_pi hden hcosstar hphase (hangle_pos i1) h13lt h32lt
          (hangle_lt i2)
          (fun theta htheta => hcos_on theta
            ⟨(hangle_pos i1).le.trans htheta.1, htheta.2.trans (hangle_lt i2).le⟩)
          (hlabel i1 i3) (hlabel i3 i2) (hbracket i3)
    · exact finiteGenreFirstAngleLabel_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
        hθstar_pos hθstar_lt_pi hden hcosstar hphase (hangle_pos i3) h31lt h12lt
        (hangle_lt i2)
        (fun theta htheta => hcos_on theta
          ⟨(hangle_pos i3).le.trans htheta.1, htheta.2.trans (hangle_lt i2).le⟩)
        (hlabel i3 i1) (hlabel i1 i2) (hbracket i1)
  · rcases lt_or_gt_of_ne hangle23 with h23lt | h32lt
    · rcases lt_or_gt_of_ne hangle13 with h13lt | h31lt
      · exact finiteGenreFirstAngleLabel_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
          hθstar_pos hθstar_lt_pi hden hcosstar hphase (hangle_pos i2) h21lt h13lt
          (hangle_lt i3)
          (fun theta htheta => hcos_on theta
            ⟨(hangle_pos i2).le.trans htheta.1, htheta.2.trans (hangle_lt i3).le⟩)
          (hlabel i2 i1) (hlabel i1 i3) (hbracket i1)
      · exact finiteGenreFirstAngleLabel_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
          hθstar_pos hθstar_lt_pi hden hcosstar hphase (hangle_pos i2) h23lt h31lt
          (hangle_lt i1)
          (fun theta htheta => hcos_on theta
            ⟨(hangle_pos i2).le.trans htheta.1, htheta.2.trans (hangle_lt i1).le⟩)
          (hlabel i2 i3) (hlabel i3 i1) (hbracket i3)
    · exact finiteGenreFirstAngleLabel_not_eq_on_three_strictly_ordered_of_phaseThreshold_lt_beta
        hθstar_pos hθstar_lt_pi hden hcosstar hphase (hangle_pos i3) h32lt h21lt
        (hangle_lt i1)
        (fun theta htheta => hcos_on theta
          ⟨(hangle_pos i3).le.trans htheta.1, htheta.2.trans (hangle_lt i1).le⟩)
        (hlabel i3 i2) (hlabel i2 i1) (hbracket i2)

/--
Finitegenre's explicit finite-cardinality conclusion. Under the source's
actual common first-label equations and a nonpositive `secondderiv` bracket
for every finite support ray, there are at most two distinct angles.
-/
theorem finiteGenre_card_le_two_of_common_firstLabel_of_bracket_nonpos
    {ι : Type*} [Fintype ι] {β θstar : ℝ} (angle : ι → ℝ)
    (hinjective : Function.Injective angle)
    (hθstar_pos : 0 < θstar) (hθstar_lt_pi : θstar < Real.pi)
    (hden : 0 < 1 - Real.cos θstar) (hcosstar : 0 < Real.cos θstar)
    (hphase : twoUserPhaseThreshold θstar < β)
    (hangle_pos : ∀ i, 0 < angle i) (hangle_lt : ∀ i, angle i < θstar)
    (hlabel : ∀ i j,
      finiteGenreFirstAngleLabel β θstar (angle i) =
        finiteGenreFirstAngleLabel β θstar (angle j))
    (hbracket : ∀ i, twoUserSecondDerivSignBracket β θstar (angle i) ≤ 0) :
    Fintype.card ι ≤ 2 := by
  classical
  by_contra hcard
  have hthree : 3 ≤ Fintype.card ι := by omega
  obtain ⟨t, -, htcard⟩ :=
    Finset.exists_subset_card_eq (s := (Finset.univ : Finset ι)) hthree
  obtain ⟨i1, i2, i3, h12, h13, h23, -⟩ := Finset.card_eq_three.mp htcard
  exact finiteGenreFirstAngleLabel_not_eq_on_three_distinct_of_bracket_nonpos
    angle hinjective hθstar_pos hθstar_lt_pi hden hcosstar hphase hangle_pos hangle_lt
    hlabel hbracket h12 h13 h23

/--
Finitegenre Step 1 in the source's `regionscolor` form. If every finite
support ray has positive slope and satisfies the displayed negative-semidefinite
graph-Hessian condition, the propagated first label forces at most two genres.
The still-missing task is to obtain that raywise package from C1--C3 and the
conditional radial regularity hypothesis.
-/
theorem finiteGenre_card_le_two_of_common_firstLabel_of_regionscolor
    {ι : Type*} [Fintype ι] {α β θstar : ℝ} (angle : ι → ℝ)
    (hinjective : Function.Injective angle)
    (hθstar_pos : 0 < θstar) (hθstar_lt_pi : θstar < Real.pi)
    (hden : 0 < 1 - Real.cos θstar) (hcosstar : 0 < Real.cos θstar)
    (hphase : twoUserPhaseThreshold θstar < β)
    (hangle_pos : ∀ i, 0 < angle i) (hangle_lt : ∀ i, angle i < θstar)
    (hlabel : ∀ i j,
      finiteGenreFirstAngleLabel β θstar (angle i) =
        finiteGenreFirstAngleLabel β θstar (angle j))
    (hα : 0 < α) (hsin : 0 < Real.sin θstar)
    (hregionscolor : ∀ i, ∃ r slope : ℝ,
      0 < r ^ 2 * (Real.sin θstar) ^ 2 ∧
      NegativeSemidefiniteQuadratic2
        (slope *
          twoUserInducedCostCrossPartial α β θstar
            (r * Real.cos (angle i)) (r * Real.cos (θstar - angle i)))
        (-(twoUserInducedCostCrossPartial α β θstar
            (r * Real.cos (angle i)) (r * Real.cos (θstar - angle i))))
        (slope⁻¹ *
          twoUserInducedCostCrossPartial α β θstar
            (r * Real.cos (angle i)) (r * Real.cos (θstar - angle i))) ∧
      0 < slope) :
    Fintype.card ι ≤ 2 := by
  have hβ : 0 < β := by
    have hβtwo : 2 < β :=
      twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcosstar hphase
    linarith
  apply finiteGenre_card_le_two_of_common_firstLabel_of_bracket_nonpos
    angle hinjective hθstar_pos hθstar_lt_pi hden hcosstar hphase hangle_pos hangle_lt
    hlabel
  intro i
  obtain ⟨r, slope, hNpos, hneg, hslope⟩ := hregionscolor i
  exact twoUser_regionscolor_bracket_nonpos_of_negativeSemidefinite_of_slope_pos
    hα hβ hsin hNpos hneg hslope

/--
Proposition `finitegenre`, first displayed angle-factor equation.  Under the
explicit shared-density and closed-cover hypotheses, the first FOC factor is
constant over all finite genre angles.
-/
theorem finiteGenre_firstAngleLabel_eq_of_shared_density_closed_cover
    {ι : Type*} [Fintype ι] [Nonempty ι] {a b β θstar : ℝ}
    (component : ι → Set ℝ) (angle : ι → ℝ)
    (hnonempty : ∀ i, (component i ∩ Set.Icc a b).Nonempty)
    (hclosed : ∀ i, IsClosed (component i ∩ Set.Icc a b))
    (hcover : ⋃ i, component i ∩ Set.Icc a b = Set.Icc a b)
    (density pref : ℝ → ℝ)
    (hpref : ∀ w, w ∈ Set.Icc a b → pref w ≠ 0)
    (hdensity : ∀ i w, w ∈ component i ∩ Set.Icc a b →
      density w = pref w * finiteGenreFirstAngleLabel β θstar (angle i))
    (i j : ι) :
    finiteGenreFirstAngleLabel β θstar (angle i) =
      finiteGenreFirstAngleLabel β θstar (angle j) :=
  finiteGenre_label_eq_of_shared_density_closed_cover
    component hnonempty hclosed hcover density pref
    (fun i => finiteGenreFirstAngleLabel β θstar (angle i)) hpref hdensity i j

