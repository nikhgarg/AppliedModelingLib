      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hcdf1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ)) z.1)
    (hcdf2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ)) z.2) :
    SourceNonzeroSupportGenres (SourceNorm.l2 2) μ =
      ({SourceNorm.normalizedContent (SourceNorm.l2 2)
        (canonicalTwoUserContentOfValues θ 1 1)} : Set (Content 2)) := by
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond θ)).aemeasurable
  apply canonicalTwoUser_nonzeroSupportGenres_eq_singleton_of_scaledNormRpowCostNash_of_phase_contDiffAt
    hP hα hβ hsin hcos hden hβlt hnash hscore_ac hinterior
  · intro z hz hne
    exact (AppliedModelingLib.Probability.iidMaximumCdf_contDiffAt_of_lowerCDFMass
      (n := P - 1) (hcdf1 z hz hne)).of_le (by norm_num)
  · intro z hz hne
    exact (AppliedModelingLib.Probability.iidMaximumCdf_contDiffAt_of_lowerCDFMass
      (n := P - 1) (hcdf2 z hz hne)).of_le (by norm_num)

/--
Every user has strictly positive score on the selected corrected singleton
genre of a source symmetric mixed Nash law.  This is not inferred from the
invalid printed span claim: a zero genre score would instead make that user's
entire score law an atom at zero.
-/
theorem sourceSymmetricMixedNash_genre_score_pos_of_singleton_nonzeroSupportGenres_of_nonzero_users
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} {genre : Content D}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hcont : PerturbationCostContinuous cost) :
    ∀ i : Fin N, 0 < score (users i) genre := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  obtain ⟨p0, hp0, hp0_nonzero⟩ :=
    sourceSymmetricMixedNash_exists_nonzero_support_of_nonzero_users
      hnash husers husers_nonzero hcont
  have hgenre_nonnegative : NonnegativeContent genre :=
    genre_nonnegative_of_singleton_nonzeroSupportGenres_of_exists
      hgenres ⟨p0, hp0, hp0_nonzero⟩ hnash.2.1
  intro i
  have hgenre_score_nonnegative : 0 ≤ score (users i) genre :=
    score_nonneg_of_nonnegative (husers i) hgenre_nonnegative
  apply lt_of_le_of_ne hgenre_score_nonnegative
  intro hgenre_score_zero
  have hscore_zero_ae : ∀ᵐ p ∂μ, score (users i) p = 0 := by
    filter_upwards [MeasureTheory.Measure.support_mem_ae] with p hp
    rw [score_eq_norm_mul_score_genre_of_mem_support_of_singleton_nonzeroSupportGenres
      (u := users i) hgenres hp, ← hgenre_score_zero, mul_zero]
  have hscore_level_one :
      μ {p : Content D | score (users i) p = 0} = 1 :=
    (MeasureTheory.mem_ae_iff_prob_eq_one
      (MeasurableSet.preimage measurableSet_eq
        (measurable_score_content (users i)))).mp hscore_zero_ae
  have hscore_level_zero :
      μ {p : Content D | score (users i) p = 0} = 0 :=
    sourceSymmetricMixedNash_score_level_measure_eq_zero
      (i0 := i) (j := Classical.choice (inferInstance : Nonempty (Fin P)))
      hnash husers (husers_nonzero i) hcont 0
  rw [hscore_level_one] at hscore_level_zero
  norm_num at hscore_level_zero

/--
End-to-end corrected single-genre identification for the paper's nonzero-user
model.  A source symmetric mixed Nash law with one corrected nonzero support
genre is the explicit inverse-transform ray law; nonzero support,
unit-normalization, positive genre scores, and atomlessness are all derived
from the stated Nash and perturbation assumptions.
-/
theorem sourceSymmetricMixedNash_eq_singleGenreContentLaw_of_compactSublevels_of_singleton_nonzeroSupportGenres_of_nonzero_users
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {μ : MixedContentStrategy D} {j : Fin P} {genre : Content D} {β : ℝ}
    (hnash : SourceSymmetricMixedNash (P := P) users (normRpowCost ν β) μ)
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i))
    (hperturb : SourceNormPerturbationContinuous ν)
    (hβ : 0 < β)
    (hcompact_sublevels : SourceNormCompactSublevels ν)
    (hcontinuous : Continuous ν.norm) :
    μ = singleGenreContentLaw N P β genre := by
  have hcost_cont : PerturbationCostContinuous (normRpowCost ν β) :=
    perturbationCostContinuous_normRpowCost ν hβ.le hperturb
  obtain ⟨p0, hp0, hp0_nonzero⟩ :=
    sourceSymmetricMixedNash_exists_nonzero_support_of_nonzero_users
      hnash husers husers_nonzero hcost_cont
  have hgenre_norm : ν.norm genre = 1 :=
    sourceNorm_genre_eq_one_of_singleton_nonzeroSupportGenres_of_exists
      hgenres ⟨p0, hp0, hp0_nonzero⟩
  have hgenre_score : ∀ i : Fin N, 0 < score (users i) genre :=
    sourceSymmetricMixedNash_genre_score_pos_of_singleton_nonzeroSupportGenres_of_nonzero_users
      hnash hgenres husers husers_nonzero hcost_cont
  have hno_atoms : MeasureTheory.NoAtoms μ :=
    noAtoms_of_sourceSymmetricMixedNash hnash hcost_cont husers
      (husers_nonzero (Classical.choice (inferInstance : Nonempty (Fin N))))
  exact
    sourceSymmetricMixedNash_eq_singleGenreContentLaw_of_compactSublevels_of_singleton_nonzeroSupportGenres
      (j := j) hnash hno_atoms hgenres hgenre_score (by fun_prop) husers hβ
      hcompact_sublevels hcontinuous hgenre_norm

/--
Corrected necessity direction of Theorem `singlegenre`: a source symmetric
mixed equilibrium with one corrected nonzero-support genre forces equality of
the coordinate-product suprema.  The proof first identifies the arbitrary
equilibrium with the explicit ray law, so no CDF or zero-support conclusion is
silently reused.
-/
theorem sourceSymmetricMixedNash_productSupCondition_of_compactSublevels_of_singleton_nonzeroSupportGenres_of_nonzero_users
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
