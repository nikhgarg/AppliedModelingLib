/-- The score law of an L2-normalized user is the positive linear rescaling
of the original user's score law. -/
theorem scoreLaw_twoUserNormalizedContent
    {D : ℕ} (u : Content D) (mu : Measure (Content D)) :
    Measure.map (fun q : Content D => score (twoUserNormalizedContent u) q) mu =
      Measure.map
        (fun x : ℝ => x * (AppliedModelingLib.FiniteDimensionalNorms.l2 u)⁻¹)
        (Measure.map (fun q : Content D => score u q) mu) := by
  symm
  calc
    Measure.map
        (fun x : ℝ => x * (AppliedModelingLib.FiniteDimensionalNorms.l2 u)⁻¹)
        (Measure.map (fun q : Content D => score u q) mu) =
        Measure.map
          ((fun x : ℝ => x * (AppliedModelingLib.FiniteDimensionalNorms.l2 u)⁻¹) ∘
            (fun q : Content D => score u q)) mu :=
      Measure.map_map (measurable_id.mul measurable_const)
        (measurable_score_content u)
    _ = Measure.map (fun q : Content D =>
        score (twoUserNormalizedContent u) q) mu := by
      apply Measure.map_congr
      filter_upwards [] with q
      simp [Function.comp_def, twoUserNormalizedContent, score_scaleUser]
      ring

/-- The no-extra-premise canonical uniqueness proof also exposes the diagonal
support conclusion used to transport genres back to the original users. -/
theorem canonicalTwoUser_valueSupport_diagonal_of_scaledNormRpowCostNash_belowPhase
    {P : ℕ} [Nonempty (Fin P)] {α β theta : ℝ} {mu : Measure (Content 2)}
    [IsProbabilityMeasure mu]
    (hP : 1 < P) (hα : 0 < α) (hβ : 1 ≤ β)
    (hsin : 0 < Real.sin theta) (hcos : 0 ≤ Real.cos theta)
    (hden : 0 < 1 - Real.cos theta)
    (hβlt : β < twoUserPhaseThreshold theta)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) mu)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta) q) mu ≪
        volume)
    (hcdf1 : ∀ x,
      x ∈ (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu).support →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu)) x)
    (hcdf2 : ∀ x,
      x ∈ (Measure.map (fun q : Content 2 =>
        score (canonicalTwoUserSecond theta) q) mu).support →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content 2 =>
            score (canonicalTwoUserSecond theta) q) mu)) x) :
    ∀ z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support,
      z.2 = z.1 := by
  have hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos theta < z.2 := by
    by_cases hcos_zero : Real.cos theta = 0
    · exact
        canonicalTwoUser_valueSupport_strictInterior_of_scaledNormRpowCostNash_of_phase_of_cos_zero
          hP hα hβ hsin hcos_zero hβlt hnash hscore_ac
    · exact
        canonicalTwoUser_valueSupport_strictInterior_of_scaledNormRpowCostNash_of_phase_of_cos_pos
          hP hα hβ hsin (lt_of_le_of_ne hcos (Ne.symm hcos_zero)) hden hβlt
          hnash hscore_ac hcdf1 hcdf2
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond theta)).aemeasurable
  obtain ⟨-, -, -, hdiag⟩ :=
    canonicalTwoUser_exists_diagonal_valueSupport_of_scaledNormRpowCostNash_of_phase_contDiffAt
      hP hα hβ hsin hcos hden hβlt hnash hscore_ac hinterior
      (fun z hz _ =>
        (AppliedModelingLib.Probability.iidMaximumCdf_contDiffAt_of_lowerCDFMass
          (n := P - 1)
          (hcdf1 z.1 (canonicalTwoUser_firstScore_mem_support_of_mem_valueSupport hz))).of_le
            (by norm_num))
      (fun z hz _ =>
        (AppliedModelingLib.Probability.iidMaximumCdf_contDiffAt_of_lowerCDFMass
          (n := P - 1)
          (hcdf2 z.2 (canonicalTwoUser_secondScore_mem_support_of_mem_valueSupport hz))).of_le
            (by norm_num))
  exact hdiag

/-- Arbitrary-dimensional original-user form of below-threshold uniqueness
for nonnegative Euclidean-unit users.  Canonicalization is used only on the
two score laws; exact support cost puts every original support action in the
nonnegative span of the users, so a diagonal score pair forces the original
bisector genre. -/
theorem twoUser_nonzeroSupportGenres_eq_singleton_of_scaledNormRpowCostNash_belowPhase_any_dim
    {D P : ℕ} [Nonempty (Fin P)] {α β theta : ℝ}
    {u v : Content D} {mu : Measure (Content D)} [IsProbabilityMeasure mu]
    (hP : 1 < P)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 1 ≤ β)
    (htheta_pos : 0 < theta) (htheta_le : theta ≤ Real.pi / 2)
    (hβlt : β < twoUserPhaseThreshold theta)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun p => α * normRpowCost (SourceNorm.l2 D) β p) mu)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) mu ≪ volume)
    (hcdf1 : ∀ x,
      x ∈ (Measure.map (fun q : Content D => score u q) mu).support →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content D => score u q) mu)) x)
    (hcdf2 : ∀ x,
      x ∈ (Measure.map (fun q : Content D => score v q) mu).support →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content D => score v q) mu)) x) :
    SourceNonzeroSupportGenres (SourceNorm.l2 D) mu =
      ({SourceNorm.normalizedContent (SourceNorm.l2 D) (u + v)} : Set (Content D)) := by
  have htheta_lt_pi : theta < Real.pi := by linarith [Real.pi_pos]
  have hsin : 0 < Real.sin theta :=
    Real.sin_pos_of_pos_of_lt_pi htheta_pos htheta_lt_pi
  have hcos : 0 ≤ Real.cos theta :=
    Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], htheta_le⟩
  have hsin_half : 0 < Real.sin (theta / 2) :=
    Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith [Real.pi_pos])
  have htrig : 1 - Real.cos theta = 2 * (Real.sin (theta / 2)) ^ 2 := by
    rw [Real.sin_sq_eq_half_sub]
    have hdouble : 2 * (theta / 2) = theta := by ring
    rw [hdouble]
    ring
  have hden : 0 < 1 - Real.cos theta := by
    rw [htrig]
    positivity
  have hβpos : 0 < β := lt_of_lt_of_le zero_lt_one hβ
  let nu : Measure (Content 2) := twoUserConeCanonicalizedMeasure theta u v mu
  have hnu_probability : IsProbabilityMeasure nu := by
    dsimp [nu, twoUserConeCanonicalizedMeasure]
    exact Measure.isProbabilityMeasure_map
      (twoUserConeCanonicalization_continuous theta u v).measurable.aemeasurable
  letI : IsProbabilityMeasure nu := hnu_probability
  have hnash_canonical : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 =>
        if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) nu := by
    simpa [nu] using
      sourceSymmetricMixedNash_twoUserConeCanonicalizedMeasure
        hu hv huv hu_nonnegative hv_nonnegative hα hβpos htheta_pos htheta_le
        hnash hscore_ac
  have hfirst_law :
      Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) nu =
        Measure.map (fun q : Content D => score u q) mu :=
    twoUserConeCanonicalizedMeasure_firstScoreLaw theta u v mu
  have hsecond_law :
      Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) nu =
        Measure.map (fun q : Content D => score v q) mu :=
    twoUserConeCanonicalizedMeasure_secondScoreLaw u v mu hsin.ne'
  have hscore_ac_canonical : ∀ i : Fin 2,
      Measure.map (fun q : Content 2 =>
        score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta) q) nu ≪
          volume := by
    intro i
    fin_cases i
    · simpa [hfirst_law] using hscore_ac 0
    · simpa [hsecond_law] using hscore_ac 1
  have hcdf1_canonical : ∀ x,
      x ∈ (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) nu).support →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) nu)) x := by
    intro x hx
    rw [hfirst_law] at hx ⊢
    exact hcdf1 x hx
  have hcdf2_canonical : ∀ x,
      x ∈ (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) nu).support →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) nu)) x := by
    intro x hx
    rw [hsecond_law] at hx ⊢
    exact hcdf2 x hx
  have hdiag : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap theta) nu).support,
      z.2 = z.1 :=
    canonicalTwoUser_valueSupport_diagonal_of_scaledNormRpowCostNash_belowPhase
      hP hα hβ hsin hcos hden hβlt hnash_canonical hscore_ac_canonical
      hcdf1_canonical hcdf2_canonical
  have hcompact : IsCompact mu.support :=
    sourceSymmetricMixedNash_isCompact_support_of_compactSublevels_of_scaledNormRpowCost
      (j := Classical.choice inferInstance) hnash hα hβpos
      (SourceNorm.l2_compactSublevels D)
  have hsupport : nu.support = twoUserConeCanonicalization theta u v '' mu.support := by
    exact twoUserConeCanonicalization_support_eq_image_of_isCompact hcompact
  have hu_nonzero : NonzeroContent u := by
    by_contra hzero
    have hu_zero : u = 0 := content_eq_zero_of_not_nonzeroContent hzero
    subst u
    simpa [score] using hu
  have hv_nonzero : NonzeroContent v := by
    by_contra hzero
    have hv_zero : v = 0 := content_eq_zero_of_not_nonzeroContent hzero
    subst v
    simpa [score] using hv
  let base : Content D := u + v
  have hbase_nonzero : NonzeroContent base := by
    obtain ⟨d, hud⟩ := hu_nonzero
    refine ⟨d, ne_of_gt ?_⟩
    dsimp [base]
    exact add_pos_of_pos_of_nonneg
      (lt_of_le_of_ne (hu_nonnegative d) (Ne.symm hud)) (hv_nonnegative d)
  let fixedGenre : Content D := SourceNorm.normalizedContent (SourceNorm.l2 D) base
  have hfixed_norm : (SourceNorm.l2 D).norm fixedGenre = 1 :=
    SourceNorm.norm_normalizedContent_eq_one (SourceNorm.l2 D) hbase_nonzero
  have hbase_recover :
      scaleContent ((SourceNorm.l2 D).norm base) fixedGenre = base :=
    SourceNorm.scale_norm_normalizedContent_eq_self (SourceNorm.l2 D) hbase_nonzero
  have hsubset : SourceNonzeroSupportGenres (SourceNorm.l2 D) mu ⊆
      ({fixedGenre} : Set (Content D)) := by
    intro _ hgenre
    rcases hgenre with ⟨p, hp, hp_nonzero, rfl⟩
    have hcanonical_support : twoUserConeCanonicalization theta u v p ∈ nu.support := by
      rw [hsupport]
      exact ⟨p, hp, rfl⟩
    have hvalue_support :
        canonicalTwoUserValueMap theta (twoUserConeCanonicalization theta u v p) ∈
          (Measure.map (canonicalTwoUserValueMap theta) nu).support :=
      AppliedModelingLib.Probability.mem_support_map_of_continuous
        (by unfold canonicalTwoUserValueMap score; fun_prop) hcanonical_support
    have hscores : score v p = score u p := by
      have h := hdiag _ hvalue_support
      simpa [canonicalTwoUserValueMap,
        score_canonicalFirst_twoUserConeCanonicalization,
        score_canonicalSecond_twoUserConeCanonicalization u v p hsin.ne'] using h
    obtain ⟨a, b, ha, hb, hpab⟩ :=
      exists_twoUser_nonnegative_conic_representation_of_scaledNormRpowCostNash_support_any_dim
        hu hv huv hu_nonnegative hv_nonnegative hα hβpos hsin.ne' hnash hscore_ac hp
    have hvu : score v u = Real.cos theta := by rw [score_comm]; exact huv
    have hab : a = b := by
      rw [hpab, score_add, score_add, score_scaleContent, score_scaleContent,
        score_scaleContent, score_scaleContent, hu, hv, huv, hvu] at hscores
      nlinarith [hden]
    have hp_scale : p = scaleContent a base := by
      rw [hpab, hab]
      ext d
      simp [base, scaleContent]
      ring
    have ha_ne : a ≠ 0 := by
      intro ha_zero
      have hp_zero : p = 0 := by
        rw [hp_scale, ha_zero]
        ext d
        simp [scaleContent]
      rcases hp_nonzero with ⟨d, hd⟩
      rw [hp_zero] at hd
      exact hd rfl
    have ha_pos : 0 < a := lt_of_le_of_ne ha (Ne.symm ha_ne)
    have hp_fixed : p =
        scaleContent (a * (SourceNorm.l2 D).norm base) fixedGenre := by
      calc
        p = scaleContent a base := hp_scale
        _ = scaleContent a
            (scaleContent ((SourceNorm.l2 D).norm base) fixedGenre) := by
          rw [hbase_recover]
        _ = scaleContent (a * (SourceNorm.l2 D).norm base) fixedGenre := by
          ext d
          simp [scaleContent]
          ring
    have hscalar_pos : 0 < a * (SourceNorm.l2 D).norm base :=
      mul_pos ha_pos ((SourceNorm.l2 D).pos_of_nonzero hbase_nonzero)
    rw [Set.mem_singleton_iff, hp_fixed]
    exact SourceNorm.normalizedContent_scale_of_norm_eq_one
      (SourceNorm.l2 D) hscalar_pos.le hscalar_pos.ne' hfixed_norm
  apply Set.Subset.antisymm
  · simpa [fixedGenre, base] using hsubset
  · letI : Nontrivial (Fin P) := Fin.nontrivial_iff_two_le.mpr (by omega)
    have hexists : ∃ p : Content D, p ∈ mu.support ∧ NonzeroContent p :=
      sourceSymmetricMixedNash_exists_nonzero_support_of_nonzero_users
        hnash
        (by intro i; fin_cases i <;> assumption)
        (by intro i; fin_cases i <;> assumption)
        (perturbationCostContinuous_scaled_l2_normRpowCost α
          (zero_le_one.trans hβ))
    intro genre hgenre
    rw [Set.mem_singleton_iff] at hgenre
    subst genre
    rcases hexists with ⟨p, hp, hp_nonzero⟩
    have hp_genre : SourceNorm.normalizedContent (SourceNorm.l2 D) p ∈
        SourceNonzeroSupportGenres (SourceNorm.l2 D) mu :=
      ⟨p, hp, hp_nonzero, rfl⟩
    have heq := Set.mem_singleton_iff.mp (hsubset hp_genre)
    change fixedGenre ∈ SourceNonzeroSupportGenres (SourceNorm.l2 D) mu
    rw [← heq]
    exact hp_genre

/-- Literal original-user normalization form of the source below-threshold
claim.  The two users may have arbitrary nonzero Euclidean magnitudes; the
unique genre is the normalized sum of their Euclidean-unit directions. -/
theorem twoUser_nonzeroSupportGenres_eq_singleton_of_scaledNormRpowCostNash_belowPhase_raw_users
    {D P : ℕ} [Nonempty (Fin P)] {α β theta : ℝ}
    {u v : Content D} {mu : Measure (Content D)} [IsProbabilityMeasure mu]
    (hP : 1 < P)
    (hu_nonzero : NonzeroContent u) (hv_nonzero : NonzeroContent v)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hangle : score u v /
      (AppliedModelingLib.FiniteDimensionalNorms.l2 u *
        AppliedModelingLib.FiniteDimensionalNorms.l2 v) = Real.cos theta)
    (hα : 0 < α) (hβ : 1 ≤ β)
    (htheta_pos : 0 < theta) (htheta_le : theta ≤ Real.pi / 2)
    (hβlt : β < twoUserPhaseThreshold theta)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun p => α * normRpowCost (SourceNorm.l2 D) β p) mu)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) mu ≪ volume)
    (hcdf1 : ∀ x,
      x ∈ (Measure.map (fun q : Content D => score u q) mu).support →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content D => score u q) mu)) x)
    (hcdf2 : ∀ x,
      x ∈ (Measure.map (fun q : Content D => score v q) mu).support →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content D => score v q) mu)) x) :
    SourceNonzeroSupportGenres (SourceNorm.l2 D) mu =
      ({SourceNorm.normalizedContent (SourceNorm.l2 D)
        (twoUserNormalizedContent u + twoUserNormalizedContent v)} : Set (Content D)) := by
  have hu_norm : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 u :=
    (SourceNorm.l2 D).pos_of_nonzero hu_nonzero
  have hv_norm : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 v :=
    (SourceNorm.l2 D).pos_of_nonzero hv_nonzero
  let users : Fin 2 → Content D := fun i => if i = 0 then u else v
  have husers_nonzero : ∀ i, NonzeroContent (users i) := by
    intro i
    fin_cases i
    · simpa [users] using hu_nonzero
    · simpa [users] using hv_nonzero
  have hnash_normalized : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 =>
        if i = 0 then twoUserNormalizedContent u else twoUserNormalizedContent v)
      (fun p => α * normRpowCost (SourceNorm.l2 D) β p) mu := by
    have h := (sourceSymmetricMixedNash_l2NormalizedUsers_iff
      (P := P) users husers_nonzero).2 (by simpa [users] using hnash)
    simpa [users, l2NormalizedUsers, SourceNorm.normalizedContent,
      twoUserNormalizedContent] using h
  have hfirst_law := scoreLaw_twoUserNormalizedContent u mu
  have hsecond_law := scoreLaw_twoUserNormalizedContent v mu
  have hscore_ac_normalized : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score
        (if i = 0 then twoUserNormalizedContent u else twoUserNormalizedContent v) q) mu ≪
          volume := by
    intro i
    fin_cases i
    · simpa [hfirst_law] using
        (AppliedModelingLib.Probability.map_mul_const_absolutelyContinuous (inv_ne_zero hu_norm.ne')
          (by simpa using hscore_ac 0))
    · simpa [hsecond_law] using
        (AppliedModelingLib.Probability.map_mul_const_absolutelyContinuous (inv_ne_zero hv_norm.ne')
          (by simpa using hscore_ac 1))
  have hcdf1_normalized : ∀ x,
      x ∈ (Measure.map (fun q : Content D =>
        score (twoUserNormalizedContent u) q) mu).support →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content D =>
            score (twoUserNormalizedContent u) q) mu)) x := by
    rw [hfirst_law]
    letI : IsProbabilityMeasure
        (Measure.map (fun q : Content D => score u q) mu) :=
      Measure.isProbabilityMeasure_map (measurable_score_content u).aemeasurable
    exact AppliedModelingLib.Probability.lowerCDFMass_map_mul_const_contDiffAt_on_support
      (inv_pos.mpr hu_norm) hcdf1
  have hcdf2_normalized : ∀ x,
      x ∈ (Measure.map (fun q : Content D =>
        score (twoUserNormalizedContent v) q) mu).support →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content D =>
            score (twoUserNormalizedContent v) q) mu)) x := by
    rw [hsecond_law]
    letI : IsProbabilityMeasure
        (Measure.map (fun q : Content D => score v q) mu) :=
      Measure.isProbabilityMeasure_map (measurable_score_content v).aemeasurable
    exact AppliedModelingLib.Probability.lowerCDFMass_map_mul_const_contDiffAt_on_support
      (inv_pos.mpr hv_norm) hcdf2
  exact twoUser_nonzeroSupportGenres_eq_singleton_of_scaledNormRpowCostNash_belowPhase_any_dim
    hP
    (score_twoUserNormalizedContent_self hu_norm)
    (score_twoUserNormalizedContent_self hv_norm)
    (score_twoUserNormalizedContent_pair_eq_cos hu_norm hv_norm hangle)
    (twoUserNormalizedContent_nonnegative hu_nonnegative)
    (twoUserNormalizedContent_nonnegative hv_nonnegative)
    hα hβ htheta_pos htheta_le hβlt hnash_normalized hscore_ac_normalized
    hcdf1_normalized hcdf2_normalized

/-- Literal equal-population form of the source below-threshold claim.  The
