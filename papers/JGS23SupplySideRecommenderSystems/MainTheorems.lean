          hsin.ne' hz)
    have hzcone_lower := (mem_canonicalTwoUserFeasibleValueSet_iff hsin).mp hzfeasible
    have hz2_nonneg : 0 ≤ z.2 :=
      le_trans (mul_nonneg hzcone_lower.1 hcos.le) hzcone_lower.2
    have hmax :=
      canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
        hsin hnash hscore_ac z hz
    have hzcone_upper : Real.cos θ * z.2 ≤ z.1 :=
      canonicalTwoUser_secondUserSlope_le_of_isMaxOn_of_mono_rewards
        hmax hzfeasible hα (lt_of_lt_of_le zero_lt_one hβ) hsin hcos.le
        (AppliedModelingLib.Probability.iidMaximumCdf_mono
          (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ))
    have hz1_pos : 0 < z.1 := by
      apply lt_of_le_of_ne hzcone_lower.1
      intro hz1
      have hz2_zero : z.2 = 0 := by
        have : z.2 ≤ 0 := by nlinarith
        exact le_antisymm this hz2_nonneg
      exact hne (Prod.ext hz1.symm hz2_zero)
    have hz2_pos : 0 < z.2 := by
      apply lt_of_le_of_ne hz2_nonneg
      intro hz2
      have hz1_zero : z.1 = 0 := by
        have : z.1 ≤ 0 := by nlinarith
        exact le_antisymm this hzcone_lower.1
      exact hne (Prod.ext hz1_zero hz2.symm)
