      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    {z : ℝ × ℝ}
    (hz : z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support) :
    AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) z.2 =
      AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) z.1 := by
  let ν : Measure (ℝ × ℝ) := Measure.map (canonicalTwoUserValueMap θ) μ
