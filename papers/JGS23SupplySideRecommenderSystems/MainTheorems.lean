      hgenres.le ⟨p0, hp0, hp0_nonzero⟩
  have hgenre_nonnegative : NonnegativeContent genre :=
    genre_nonnegative_of_singleton_nonzeroSupportGenres_of_exists
      hgenres.le ⟨p0, hp0, hp0_nonzero⟩ hnash.2.1
  have hscore : ∀ i : Fin N, 0 < score (users i) genre :=
    sourceSymmetricMixedNash_genre_score_pos_of_singleton_nonzeroSupportGenres_of_nonzero_users
      hnash hgenres.le husers_nonnegative husers_nonzero hcost_cont
  have heq : μ = singleGenreContentLaw N P β genre :=
    sourceSymmetricMixedNash_eq_singleGenreContentLaw_of_compactSublevels_of_singleton_nonzeroSupportGenres_of_nonzero_users
