/--
Original-coordinate strict boundary exclusion for a finite radial genre law.
If C1 has put every listed original polar genre in the closed cone between the
two actual users, then the finite-mixture CDF argument excludes both boundary
rays.  This is the source-faithful strict-angle bridge: it uses the original
nonnegative-content feasible deviations rather than rotating that cone to
canonical coordinates.
-/
theorem finiteGenre_angle_mem_Ioo_originalPolar_of_closedInterval_scaledNormRpowCostNash
    {G P : ℕ} [Nonempty (Fin P)]
    {alpha beta phi theta : ℝ} {mu : MixedContentStrategy 2}
    [IsProbabilityMeasure mu] {angle : Fin G → ℝ}
    {u v : Content 2}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (hu_polar : u = content2 (Real.cos phi) (Real.sin phi))
    (hv_polar : v = content2 (Real.cos (phi + theta)) (Real.sin (phi + theta)))
    (hP : 1 < P) (htheta : 0 < theta) (htheta_lt : theta < Real.pi / 2)
    (hsin : 0 < Real.sin theta)
    (hphi : 0 ≤ phi) (hphi_theta : phi + theta ≤ Real.pi / 2)
    (hangle_range : ∀ j, angle j ∈ Set.Icc phi (phi + theta))
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun j : Fin 2 => if j = 0 then u else v)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu)
    (hscore_ac : ∀ j : Fin 2,
      Measure.map (fun q : Content 2 => score (if j = 0 then u else v) q) mu ≪
        volume)
    (i : Fin G) : angle i ∈ Set.Ioo phi (phi + theta) := by
  have hsecond_scale : ∀ j, 0 < Real.cos ((phi + theta) - angle j) := by
    intro j
    apply Real.cos_pos_of_mem_Ioo
    constructor <;> linarith [Real.pi_pos, (hangle_range j).1, (hangle_range j).2]
  have hfirst_scale : ∀ j, 0 < Real.cos (phi - angle j) := by
    intro j
    apply Real.cos_pos_of_mem_Ioo
    constructor <;> linarith [Real.pi_pos, (hangle_range j).1, (hangle_range j).2]
  have hne_first : angle i ≠ phi :=
    finiteGenre_angle_ne_firstUserAngle_of_originalPolar_scaledNormRpowCostNash
      law hu hv huv hu_polar hv_polar hP htheta hsin hphi hphi_theta
      hsecond_scale hnash hscore_ac i
  have hne_second : angle i ≠ phi + theta :=
    finiteGenre_angle_ne_secondUserAngle_of_originalPolar_scaledNormRpowCostNash
      law hu hv huv hu_polar hv_polar hP htheta hsin hphi hphi_theta
      hfirst_scale hnash hscore_ac i
  constructor
  · exact lt_of_le_of_ne (hangle_range i).1 (Ne.symm hne_first)
  · exact lt_of_le_of_ne (hangle_range i).2 hne_second

/--
Original-coordinate C1 cone transport for finite polar genre laws.  At a
positive radial support point, the source Nash cone inequalities become two
sine inequalities.  The principal first-quadrant polar chart then places the
genre between the two actual user angles, without rotating the nonnegative
content cone.
-/
theorem finiteGenre_angle_mem_Icc_originalPolar_of_scaledNormRpowCostNash
    {G P : ℕ} [Nonempty (Fin P)]
    {alpha beta phi theta : ℝ} {mu : MixedContentStrategy 2}
    [IsProbabilityMeasure mu] {angle : Fin G → ℝ}
    {u v : Content 2}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hu_polar : u = content2 (Real.cos phi) (Real.sin phi))
    (hv_polar : v = content2 (Real.cos (phi + theta)) (Real.sin (phi + theta)))
    (halpha : 0 < alpha) (hbeta : 0 < beta) (htheta : 0 < theta)
    (hsin : 0 < Real.sin theta)
    (hphi : 0 ≤ phi) (hphi_theta : phi + theta ≤ Real.pi / 2)
    (hangle_chart : ∀ j, angle j ∈ Set.Icc 0 (Real.pi / 2))
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun j : Fin 2 => if j = 0 then u else v)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu)
    (hscore_ac : ∀ j : Fin 2,
      Measure.map (fun q : Content 2 => score (if j = 0 then u else v) q) mu ≪
        volume)
    (i : Fin G) : angle i ∈ Set.Icc phi (phi + theta) := by
  obtain ⟨r, hr_support, hr_pos⟩ := law.radial_has_positive_support i
  have hp : scaleContent r
      (content2 (Real.cos (angle i)) (Real.sin (angle i))) ∈ mu.support :=
    law.ray_mem_contentSupport hr_support
  have hcone := twoUserScore_closedUserCone_of_scaledNormRpowCostNash
    hu hv huv hu_nonnegative hv_nonnegative halpha hbeta hsin hnash hscore_ac hp
  have hscore_first : score u
      (scaleContent r (content2 (Real.cos (angle i)) (Real.sin (angle i)))) =
        r * Real.cos (phi - angle i) := by
    rw [score_scaleContent, hu_polar]
    simp [score_content2, Real.cos_sub]
  have hscore_second : score v
      (scaleContent r (content2 (Real.cos (angle i)) (Real.sin (angle i)))) =
        r * Real.cos ((phi + theta) - angle i) := by
    rw [score_scaleContent, hv_polar]
    simp [score_content2, Real.cos_sub]
  rw [hscore_first, hscore_second] at hcone
  have hright_cone : Real.cos theta * Real.cos ((phi + theta) - angle i) ≤
      Real.cos (phi - angle i) := by
    apply le_of_mul_le_mul_left _ hr_pos
    convert hcone.1 using 1 <;> ring
  have hleft_cone : Real.cos theta * Real.cos (phi - angle i) ≤
      Real.cos ((phi + theta) - angle i) := by
    apply le_of_mul_le_mul_left _ hr_pos
    convert hcone.2 using 1 <;> ring
  have htrig_right :
      Real.cos (phi - angle i) -
          Real.cos theta * Real.cos ((phi + theta) - angle i) =
        Real.sin theta * Real.sin ((phi + theta) - angle i) := by
    have harg : phi - angle i = (phi + theta - angle i) - theta := by ring
    rw [harg, Real.cos_sub]
    ring
  have hsin_right : 0 ≤ Real.sin ((phi + theta) - angle i) := by
    apply nonneg_of_mul_nonneg_left (by
      rw [mul_comm, ← htrig_right]
      linarith) hsin
  have htrig_left :
      Real.cos ((phi + theta) - angle i) -
          Real.cos theta * Real.cos (phi - angle i) =
        Real.sin theta * Real.sin (angle i - phi) := by
    have harg1 : (phi + theta) - angle i = theta - (angle i - phi) := by ring
    have harg2 : phi - angle i = -(angle i - phi) := by ring
    rw [harg1, harg2, Real.cos_sub, Real.cos_neg]
    ring
  have hsin_left : 0 ≤ Real.sin (angle i - phi) := by
    apply nonneg_of_mul_nonneg_left (by
      rw [mul_comm, ← htrig_left]
      linarith) hsin
  have hphi_le_half : phi ≤ Real.pi / 2 := by linarith
  have hleft : phi ≤ angle i := by
    by_contra hnot
    have hlt : angle i < phi := lt_of_not_ge hnot
    have hsin_neg : Real.sin (angle i - phi) < 0 :=
      Real.sin_neg_of_neg_of_neg_pi_lt (by linarith) (by
        linarith [Real.pi_pos, (hangle_chart i).1, hphi_le_half])
    linarith
  have hpsi_nonnegative : 0 ≤ phi + theta := by linarith
  have hright : angle i ≤ phi + theta := by
    by_contra hnot
    have hlt : phi + theta < angle i := lt_of_not_ge hnot
    have hsin_neg : Real.sin ((phi + theta) - angle i) < 0 :=
      Real.sin_neg_of_neg_of_neg_pi_lt (by linarith) (by
        linarith [Real.pi_pos, (hangle_chart i).2, hpsi_nonnegative])
    linarith
  exact ⟨hleft, hright⟩

/--
The finite-law original-coordinate strict angle bridge with no separate
closed-angle premise.  C1 supplies the closed cone and the finite CDF argument
excludes its two boundary rays.
-/
theorem finiteGenre_angle_mem_Ioo_originalPolar_of_scaledNormRpowCostNash
    {G P : ℕ} [Nonempty (Fin P)]
    {alpha beta phi theta : ℝ} {mu : MixedContentStrategy 2}
    [IsProbabilityMeasure mu] {angle : Fin G → ℝ}
    {u v : Content 2}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hu_polar : u = content2 (Real.cos phi) (Real.sin phi))
    (hv_polar : v = content2 (Real.cos (phi + theta)) (Real.sin (phi + theta)))
    (halpha : 0 < alpha) (hbeta : 0 < beta)
    (hP : 1 < P) (htheta : 0 < theta) (htheta_lt : theta < Real.pi / 2)
    (hsin : 0 < Real.sin theta)
    (hphi : 0 ≤ phi) (hphi_theta : phi + theta ≤ Real.pi / 2)
    (hangle_chart : ∀ j, angle j ∈ Set.Icc 0 (Real.pi / 2))
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun j : Fin 2 => if j = 0 then u else v)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu)
    (hscore_ac : ∀ j : Fin 2,
      Measure.map (fun q : Content 2 => score (if j = 0 then u else v) q) mu ≪
        volume)
    (i : Fin G) : angle i ∈ Set.Ioo phi (phi + theta) := by
  apply finiteGenre_angle_mem_Ioo_originalPolar_of_closedInterval_scaledNormRpowCostNash
    law hu hv huv hu_polar hv_polar hP htheta htheta_lt hsin hphi hphi_theta
  · intro j
    exact finiteGenre_angle_mem_Icc_originalPolar_of_scaledNormRpowCostNash
      law hu hv huv hu_nonnegative hv_nonnegative hu_polar hv_polar
      halpha hbeta htheta hsin hphi hphi_theta hangle_chart hnash hscore_ac j
  · exact hnash
  · exact hscore_ac

/-- The raw first-score law of a finite conditional radial mixture. -/
theorem finiteGenre_firstScoreLaw_eq
    {G : ℕ} {mu : MixedContentStrategy 2}
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle) :
    Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu =
      ∑ i, ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * Real.cos (angle i)) (law.radial i) := by
  have hscore : Measurable (fun p : Content 2 => score canonicalTwoUserFirst p) :=
    measurable_score_content canonicalTwoUserFirst
  have hray : ∀ i, Measurable
      (fun r : ℝ => scaleContent r
        (content2 (Real.cos (angle i)) (Real.sin (angle i)))) := by
    intro i
    rw [measurable_pi_iff]
    intro d
    exact measurable_id.mul measurable_const
  calc
    Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu =
        Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p)
          (∑ i, ENNReal.ofReal (law.weight i) •
            Measure.map (fun r : ℝ => scaleContent r
              (content2 (Real.cos (angle i)) (Real.sin (angle i))))
              (law.radial i)) := congrArg _ law.decomposition
    _ = ∑ i, ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * Real.cos (angle i)) (law.radial i) := by
      rw [Measure.map_finset_sum hscore.aemeasurable]
      simp_rw [Measure.map_smul]
      apply Finset.sum_congr rfl
      intro i _
      rw [Measure.map_map hscore (hray i)]
      apply congrArg (fun rho : Measure ℝ => ENNReal.ofReal (law.weight i) • rho)
      apply Measure.map_congr
      filter_upwards [] with r
      simp [Function.comp_apply, score_scaleContent, canonicalTwoUserFirst,
        score_content2]

/-- The first raw-score lower CDF is the finite mixture of radial lower CDFs. -/
theorem finiteGenre_firstLowerCDFMass_eq
    {G : ℕ} {mu : MixedContentStrategy 2} {z : ℝ}
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle)
    (hcos : ∀ i, 0 < Real.cos (angle i)) :
    AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) z =
      ∑ i, law.weight i * AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (z / Real.cos (angle i)) := by
  letI : ∀ i, IsProbabilityMeasure (law.radial i) := law.radial_probability
  letI : ∀ i, IsProbabilityMeasure
      (Measure.map (fun r : ℝ => r * Real.cos (angle i)) (law.radial i)) :=
    fun i => Measure.isProbabilityMeasure_map
      (measurable_id.mul measurable_const).aemeasurable
  letI : ∀ i, IsFiniteMeasure
      (ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * Real.cos (angle i)) (law.radial i)) :=
    fun i => Measure.smul_finite _ ENNReal.ofReal_ne_top
  calc
    AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) z =
        ∑ i, law.weight i * AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun r : ℝ => r * Real.cos (angle i)) (law.radial i)) z := by
      rw [finiteGenre_firstScoreLaw_eq law]
      unfold AppliedModelingLib.Probability.lowerCDFMass Measure.real
      rw [Measure.finset_sum_apply, ENNReal.toReal_sum]
      · simp_rw [Measure.smul_apply, smul_eq_mul, ENNReal.toReal_mul,
          ENNReal.toReal_ofReal (law.weight_pos _).le]
      · intro i _
        exact measure_ne_top _ _
    _ = ∑ i, law.weight i * AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (z / Real.cos (angle i)) := by
      apply Finset.sum_congr rfl
      intro i _
      rw [AppliedModelingLib.Probability.lowerCDFMass_map_mul_const (law.radial i) (hcos i)]

/-- The finite first-score CDF is `C¹` under the conditional `C¹` assumption. -/
theorem finiteGenre_firstLowerCDFMass_contDiff
    {G : ℕ} {mu : MixedContentStrategy 2}
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle)
    (hcos : ∀ i, 0 < Real.cos (angle i)) :
    ContDiff ℝ 1 (fun x => AppliedModelingLib.Probability.lowerCDFMass
      (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) x) := by
  have hfunction :
      (fun x => AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) x) =
        (fun x => ∑ i, law.weight i *
          AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
            (x / Real.cos (angle i))) := by
    funext x
    exact finiteGenre_firstLowerCDFMass_eq law hcos
  rw [hfunction]
  apply ContDiff.sum
  intro i _
  simpa only [Function.comp_apply, smul_eq_mul] using
    ((law.radial_cdf_c1 i).comp
      (contDiff_id.div_const (Real.cos (angle i)))).const_smul (law.weight i)

/-- The differentiated finite first-score CDF mixture. -/
theorem deriv_finiteGenre_firstLowerCDFMass_eq
    {G : ℕ} {mu : MixedContentStrategy 2} {z : ℝ}
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle)
    (hcos : ∀ i, 0 < Real.cos (angle i)) :
    deriv (fun x => AppliedModelingLib.Probability.lowerCDFMass
      (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) x) z =
      ∑ i, law.weight i *
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / Real.cos (angle i)) * (1 / Real.cos (angle i))) := by
  have hfunction :
      (fun x => AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) x) =
        (fun x => ∑ i, law.weight i *
          AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
            (x / Real.cos (angle i))) := by
    funext x
    exact finiteGenre_firstLowerCDFMass_eq law hcos
  have hterm : ∀ i, HasDerivAt
      (fun x => law.weight i * AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (x / Real.cos (angle i)))
      (law.weight i *
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / Real.cos (angle i)) * (1 / Real.cos (angle i)))) z := by
    intro i
    have hscale : HasDerivAt (fun x : ℝ => x / Real.cos (angle i))
        (1 / Real.cos (angle i)) z := by
      simpa only [id_eq] using ((hasDerivAt_id z).div_const (Real.cos (angle i)))
    have hrad : HasDerivAt (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / Real.cos (angle i))) (z / Real.cos (angle i)) :=
      ((law.radial_cdf_c1 i).differentiable (by norm_num)
        (z / Real.cos (angle i))).hasDerivAt
    have hcomp : HasDerivAt
        (fun x => AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
          (x / Real.cos (angle i)))
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / Real.cos (angle i)) * (1 / Real.cos (angle i))) z := by
      simpa only [Function.comp_apply] using hrad.comp z hscale
    exact hcomp.const_mul (law.weight i)
  have hsum : ∀ S : Finset (Fin G), HasDerivAt
      (fun x => ∑ i ∈ S, law.weight i *
        AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
          (x / Real.cos (angle i)))
      (∑ i ∈ S, law.weight i *
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / Real.cos (angle i)) * (1 / Real.cos (angle i)))) z := by
    intro S
    induction S using Finset.induction_on with
    | empty => simpa using (hasDerivAt_const z (0 : ℝ))
    | insert i S hi ih =>
      convert (hterm i).add ih using 1
      · funext x
        simp [Finset.sum_insert, hi]
      · rw [Finset.sum_insert hi]
  have hsum_univ := hsum Finset.univ
  rw [← hfunction] at hsum_univ
  exact hsum_univ.deriv

/--
The raw second-score law of a finite conditional radial mixture is the finite
weighted sum of its radial score laws.  This is the finite-family version of
the source's density decomposition, before differentiating it.
-/
theorem finiteGenre_secondScoreLaw_eq
    {G : ℕ} {mu : MixedContentStrategy 2} {theta : ℝ}
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle) :
    Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu =
      ∑ i, ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * Real.cos (theta - angle i)) (law.radial i) := by
  have hscore : Measurable
      (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) :=
    measurable_score_content (canonicalTwoUserSecond theta)
  have hray : ∀ i, Measurable
      (fun r : ℝ => scaleContent r
        (content2 (Real.cos (angle i)) (Real.sin (angle i)))) := by
    intro i
    rw [measurable_pi_iff]
    intro d
    exact measurable_id.mul measurable_const
  calc
    Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu =
        Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p)
          (∑ i, ENNReal.ofReal (law.weight i) •
            Measure.map (fun r : ℝ => scaleContent r
              (content2 (Real.cos (angle i)) (Real.sin (angle i))))
              (law.radial i)) := congrArg _ law.decomposition
    _ = ∑ i, ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * Real.cos (theta - angle i)) (law.radial i) := by
      rw [Measure.map_finset_sum hscore.aemeasurable]
      simp_rw [Measure.map_smul]
      apply Finset.sum_congr rfl
      intro i _
      rw [Measure.map_map hscore (hray i)]
      apply congrArg (fun rho : Measure ℝ => ENNReal.ofReal (law.weight i) • rho)
      apply Measure.map_congr
      filter_upwards [] with r
      simp [Function.comp_apply, score_scaleContent, canonicalTwoUserSecond,
        score_content2, Real.cos_sub]

/--
A positive-weight finite radial component whose score scale is zero forces a
positive point mass at score zero.  This is the degenerate-ray fact needed at
the orthogonal two-user boundary, where a positive-cosine CDF rescaling is
unavailable.
-/
private theorem finiteGenre_scoreLaw_singleton_zero_pos_of_zero_scale
    {G : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle)
    {f : Content 2 → ℝ} {scale : Fin G → ℝ}
    (hscorelaw : Measure.map f mu =
      ∑ j, ENNReal.ofReal (law.weight j) •
        Measure.map (fun r : ℝ => r * scale j) (law.radial j))
    (i : Fin G) (hscale : scale i = 0) :
    0 < (Measure.map f mu) ({0} : Set ℝ) := by
  letI : ∀ j, IsProbabilityMeasure (law.radial j) := law.radial_probability
  have hradial_singleton :
      Measure.map (fun r : ℝ => r * scale i) (law.radial i) ({0} : Set ℝ) = 1 := by
    have hmeas : Measurable (fun r : ℝ => r * scale i) :=
      measurable_id.mul measurable_const
    rw [Measure.map_apply hmeas
      (measurableSet_singleton (0 : ℝ))]
    have hpreimage : (fun r : ℝ => r * scale i) ⁻¹' ({0} : Set ℝ) = Set.univ := by
      ext r
      simp [hscale]
    rw [hpreimage]
    exact measure_univ
  have hcomponent_pos : 0 <
      (ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * scale i) (law.radial i)) ({0} : Set ℝ) := by
    rw [Measure.smul_apply, hradial_singleton]
    simpa using ENNReal.ofReal_pos.mpr (law.weight_pos i)
  rw [hscorelaw, Measure.finset_sum_apply]
  exact hcomponent_pos.trans_le
    (Finset.single_le_sum (fun j _ => show 0 ≤
      (ENNReal.ofReal (law.weight j) •
        Measure.map (fun r : ℝ => r * scale j) (law.radial j)) ({0} : Set ℝ) from bot_le)
      (Finset.mem_univ i))

/--
At the orthogonal angle, a finite genre on the first-user ray would collapse
the second score to a positive atom at zero, contradicting C2's score-law
absolute continuity.
-/
theorem finiteGenre_angle_ne_zero_of_secondScore_absContinuous_of_orthogonal
    {G : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta : ℝ} {angle : Fin G → ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (horthogonal : theta = Real.pi / 2)
    (hscore_ac : Measure.map
      (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu ≪ volume)
    (i : Fin G) : angle i ≠ 0 := by
  intro hi
  have hpositive := finiteGenre_scoreLaw_singleton_zero_pos_of_zero_scale
    (scale := fun j => Real.cos (theta - angle j)) law
    (finiteGenre_secondScoreLaw_eq law) i (by
      simp [hi, horthogonal])
  have hzero :
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu)
        ({0} : Set ℝ) = 0 :=
    hscore_ac Real.volume_singleton
  exact hpositive.ne' hzero

/--
At the orthogonal angle, a finite genre on the second-user ray would collapse
the first score to a positive atom at zero, contradicting C2's score-law
absolute continuity.
-/
theorem finiteGenre_angle_ne_theta_of_firstScore_absContinuous_of_orthogonal
    {G : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta : ℝ} {angle : Fin G → ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (horthogonal : theta = Real.pi / 2)
    (hscore_ac : Measure.map
      (fun q : Content 2 => score canonicalTwoUserFirst q) mu ≪ volume)
    (i : Fin G) : angle i ≠ theta := by
  intro hi
  have hpositive := finiteGenre_scoreLaw_singleton_zero_pos_of_zero_scale
    (scale := fun j => Real.cos (angle j)) law
    (finiteGenre_firstScoreLaw_eq law) i (by
      simp [hi, horthogonal])
  have hzero :
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu)
        ({0} : Set ℝ) = 0 :=
    hscore_ac Real.volume_singleton
  exact hpositive.ne' hzero

/--
The second raw-score lower CDF is the finite mixture of the radial lower CDFs,
with each argument rescaled by its ray's second-coordinate score.  Positive
cosines are exactly what make the change-of-variables orientation preserving.
-/
theorem finiteGenre_secondLowerCDFMass_eq
    {G : ℕ} {mu : MixedContentStrategy 2} {theta z : ℝ}
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle)
    (hcos : ∀ i, 0 < Real.cos (theta - angle i)) :
    AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) z =
      ∑ i, law.weight i * AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (z / Real.cos (theta - angle i)) := by
  letI : ∀ i, IsProbabilityMeasure (law.radial i) := law.radial_probability
  letI : ∀ i, IsProbabilityMeasure
      (Measure.map (fun r : ℝ => r * Real.cos (theta - angle i)) (law.radial i)) :=
    fun i => Measure.isProbabilityMeasure_map
      (measurable_id.mul measurable_const).aemeasurable
  letI : ∀ i, IsFiniteMeasure
      (ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * Real.cos (theta - angle i)) (law.radial i)) :=
    fun i => Measure.smul_finite _ ENNReal.ofReal_ne_top
  calc
    AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) z =
        ∑ i, law.weight i * AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun r : ℝ => r * Real.cos (theta - angle i)) (law.radial i)) z := by
      rw [finiteGenre_secondScoreLaw_eq law]
      unfold AppliedModelingLib.Probability.lowerCDFMass Measure.real
      rw [Measure.finset_sum_apply, ENNReal.toReal_sum]
      · simp_rw [Measure.smul_apply, smul_eq_mul, ENNReal.toReal_mul,
          ENNReal.toReal_ofReal (law.weight_pos _).le]
      · intro i _
        exact measure_ne_top _ _
    _ = ∑ i, law.weight i * AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (z / Real.cos (theta - angle i)) := by
      apply Finset.sum_congr rfl
      intro i _
      rw [AppliedModelingLib.Probability.lowerCDFMass_map_mul_const (law.radial i) (hcos i)]

/--
The finite second-score CDF is `C¹` under the paper's conditional `C¹` CDF
assumption.  This packages the regularity needed to differentiate the iid
maximum objective without adding a separate raw-score smoothness hypothesis.
-/
theorem finiteGenre_secondLowerCDFMass_contDiff
    {G : ℕ} {mu : MixedContentStrategy 2} {theta : ℝ}
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle)
    (hcos : ∀ i, 0 < Real.cos (theta - angle i)) :
    ContDiff ℝ 1 (fun x => AppliedModelingLib.Probability.lowerCDFMass
      (Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) x) := by
  have hfunction :
      (fun x => AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) x) =
        (fun x => ∑ i, law.weight i *
          AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
            (x / Real.cos (theta - angle i))) := by
    funext x
    exact finiteGenre_secondLowerCDFMass_eq law hcos
  rw [hfunction]
  apply ContDiff.sum
  intro i _
  simpa only [Function.comp_apply, smul_eq_mul] using
    ((law.radial_cdf_c1 i).comp
      (contDiff_id.div_const (Real.cos (theta - angle i)))).const_smul (law.weight i)

/--
Differentiating the finite second-score CDF mixture is legitimate under the
source's `C¹` conditional-CDF assumption.  The formula retains the positive
score-rescaling factors explicitly, which is important for sign arguments at
the boundary rays.
-/
theorem deriv_finiteGenre_secondLowerCDFMass_eq
    {G : ℕ} {mu : MixedContentStrategy 2} {theta z : ℝ}
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle)
    (hcos : ∀ i, 0 < Real.cos (theta - angle i)) :
    deriv (fun x => AppliedModelingLib.Probability.lowerCDFMass
      (Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) x) z =
      ∑ i, law.weight i *
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / Real.cos (theta - angle i)) *
          (1 / Real.cos (theta - angle i))) := by
  have hfunction :
      (fun x => AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) x) =
        (fun x => ∑ i, law.weight i *
          AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
            (x / Real.cos (theta - angle i))) := by
    funext x
    exact finiteGenre_secondLowerCDFMass_eq law hcos
  have hterm : ∀ i, HasDerivAt
      (fun x => law.weight i * AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (x / Real.cos (theta - angle i)))
      (law.weight i *
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / Real.cos (theta - angle i)) *
          (1 / Real.cos (theta - angle i)))) z := by
    intro i
    have hscale : HasDerivAt
        (fun x : ℝ => x / Real.cos (theta - angle i))
        (1 / Real.cos (theta - angle i)) z := by
      simpa only [id_eq] using
        ((hasDerivAt_id z).div_const (Real.cos (theta - angle i)))
    have hrad : HasDerivAt (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / Real.cos (theta - angle i)))
        (z / Real.cos (theta - angle i)) :=
      ((law.radial_cdf_c1 i).differentiable (by norm_num)
        (z / Real.cos (theta - angle i))).hasDerivAt
    have hcomp : HasDerivAt
        (fun x => AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
          (x / Real.cos (theta - angle i)))
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / Real.cos (theta - angle i)) *
          (1 / Real.cos (theta - angle i))) z := by
      simpa only [Function.comp_apply] using hrad.comp z hscale
    exact hcomp.const_mul (law.weight i)
  have hsum : ∀ S : Finset (Fin G), HasDerivAt
      (fun x => ∑ i ∈ S, law.weight i *
        AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
          (x / Real.cos (theta - angle i)))
      (∑ i ∈ S, law.weight i *
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / Real.cos (theta - angle i)) *
          (1 / Real.cos (theta - angle i)))) z := by
    intro S
    induction S using Finset.induction_on with
    | empty => simpa using (hasDerivAt_const z (0 : ℝ))
    | insert i S hi ih =>
      convert (hterm i).add ih using 1
      · funext x
        simp [Finset.sum_insert, hi]
      · rw [Finset.sum_insert hi]
  have hsum_univ := hsum Finset.univ
  rw [← hfunction] at hsum_univ
  exact hsum_univ.deriv

/--
Under the paper's finite conditional-law and C1 assumptions, a realized genre
cannot coincide with the first-user ray.  The proof uses the valid one-sided
FOC at that feasible boundary, rather than the unrestricted boundary gradient
identity used in the printed argument.
-/
theorem finiteGenre_angle_ne_zero_of_scaledNormRpowCostNash
    {G P : ℕ} [Nonempty (Fin P)] {alpha beta theta : ℝ}
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu] {angle : Fin G → ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (hP : 1 < P) (hsin : 0 < Real.sin theta)
    (hcos : ∀ i, 0 < Real.cos (theta - angle i))
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun j : Fin 2 => if j = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu)
    (hscore_ac : ∀ j : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if j = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta) q) mu ≪
        volume)
    (i : Fin G) : angle i ≠ 0 := by
  letI : ∀ j, IsProbabilityMeasure (law.radial j) := law.radial_probability
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) :=
    Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
  intro hi
  obtain ⟨r, hr_support, hr_pos, hr_cdf_pos, hr_deriv_pos⟩ :=
    AppliedModelingLib.Probability.exists_pos_mem_support_of_lowerCDFMass_pos_and_deriv_pos
      (law.radial i) (law.radial_has_positive_support i) (law.radial_cdf_c1 i)
  have hp_scale : scaleContent r
      (content2 (Real.cos (angle i)) (Real.sin (angle i))) ∈ mu.support :=
    law.ray_mem_contentSupport hr_support
  have hp : content2 (r * Real.cos (angle i)) (r * Real.sin (angle i)) ∈ mu.support := by
    convert hp_scale using 1
    ext d
    fin_cases d <;> simp [scaleContent, content2]
  have hz_support : (r, r * Real.cos theta) ∈
      (Measure.map (canonicalTwoUserValueMap theta) mu).support := by
    have hz := canonicalTwoUserValueMap_mem_support_of_mem_content_support (θ := theta) hp
    rw [canonicalTwoUserValueMap_content2_angleRadius theta (angle i) r, hi] at hz
    simpa using hz
  have hmax :=
    canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      hsin hnash hscore_ac (r, r * Real.cos theta) hz_support
  have hraw_c1 := finiteGenre_secondLowerCDFMass_contDiff law hcos
  have hraw_deriv : HasDerivAt
      (fun x => AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x)
      (deriv (fun x => AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x)
        (r * Real.cos theta))
      (r * Real.cos theta) :=
    (hraw_c1.differentiable (by norm_num) (r * Real.cos theta)).hasDerivAt
  have hmax_deriv :=
    AppliedModelingLib.Probability.hasDerivAt_iidMaximumCdf_of_hasDerivAt_lowerCDFMass
      (n := P - 1)
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu)
      hraw_deriv
  have hreward_deriv : HasDerivAt
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x)
      (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x)
        (r * Real.cos theta))
      (r * Real.cos theta) := by
    rw [hmax_deriv.deriv]
    exact hmax_deriv
  have hreward_nonneg : 0 ≤ deriv
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x)
      (r * Real.cos theta) :=
    (AppliedModelingLib.Probability.iidMaximumCdf_mono
      (n := P - 1)
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu)).deriv_nonneg
  have hreward_zero := deriv_secondReward_eq_zero_of_isMaxOn_of_lowerBoundary
    hmax hsin hr_pos hreward_deriv hreward_nonneg
  have hcos_i : 0 < Real.cos theta := by
    simpa [hi] using hcos i
  have hcos_i_ne : Real.cos theta ≠ 0 := hcos_i.ne'
  have hr_div : r * Real.cos theta / Real.cos (theta - angle i) = r := by
    rw [hi, sub_zero]
    exact mul_div_cancel_right₀ r hcos_i_ne
  have hterm_cdf_nonneg : ∀ j : Fin G, 0 ≤ law.weight j *
      AppliedModelingLib.Probability.lowerCDFMass (law.radial j)
        (r * Real.cos theta / Real.cos (theta - angle j)) := by
    intro j
    exact mul_nonneg (law.weight_pos j).le
      (AppliedModelingLib.Probability.lowerCDFMass_nonneg (law.radial j) _)
  have hterm_cdf_pos : 0 < law.weight i *
      AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (r * Real.cos theta / Real.cos (theta - angle i)) := by
    rw [hr_div]
    exact mul_pos (law.weight_pos i) hr_cdf_pos
  have hraw_cdf_pos : 0 < AppliedModelingLib.Probability.lowerCDFMass
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu)
      (r * Real.cos theta) := by
    rw [finiteGenre_secondLowerCDFMass_eq law hcos]
    exact lt_of_lt_of_le hterm_cdf_pos
      (Finset.single_le_sum (fun j _ => hterm_cdf_nonneg j) (Finset.mem_univ i))
  have hP_minus_one_pos : 0 < P - 1 := by omega
  have hP_minus_one_real_pos : 0 < ((P - 1 : ℕ) : ℝ) :=
    Nat.cast_pos.mpr hP_minus_one_pos
  have hscalar_pos : 0 < ((P - 1 : ℕ) : ℝ) *
      (AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu)
        (r * Real.cos theta)) ^ (P - 1 - 1) :=
    mul_pos hP_minus_one_real_pos (pow_pos hraw_cdf_pos _)
  have hraw_deriv_zero : deriv (fun x => AppliedModelingLib.Probability.lowerCDFMass
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x)
      (r * Real.cos theta) = 0 := by
    rw [AppliedModelingLib.Probability.deriv_iidMaximumCdf_eq_of_hasDerivAt_lowerCDFMass
      (n := P - 1)
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu)
      hraw_deriv] at hreward_zero
    exact (mul_eq_zero.mp hreward_zero).resolve_left hscalar_pos.ne'
  have hterm_deriv_nonneg : ∀ j : Fin G, 0 ≤ law.weight j *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial j))
        (r * Real.cos theta / Real.cos (theta - angle j)) *
        (1 / Real.cos (theta - angle j))) := by
    intro j
    refine mul_nonneg (law.weight_pos j).le (mul_nonneg ?_ ?_)
    · exact (AppliedModelingLib.Probability.lowerCDFMass_mono (law.radial j)).deriv_nonneg
    · exact one_div_nonneg.mpr (hcos j).le
  have hsum_deriv_zero : ∑ j, law.weight j *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial j))
        (r * Real.cos theta / Real.cos (theta - angle j)) *
        (1 / Real.cos (theta - angle j))) = 0 := by
    rw [← deriv_finiteGenre_secondLowerCDFMass_eq law hcos]
    exact hraw_deriv_zero
  have hterm_deriv_zero : law.weight i *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
        (r * Real.cos theta / Real.cos (theta - angle i)) *
        (1 / Real.cos (theta - angle i))) = 0 :=
    ((Finset.sum_eq_zero_iff_of_nonneg (fun j _ => hterm_deriv_nonneg j)).mp
      hsum_deriv_zero) i (Finset.mem_univ i)
  have hterm_deriv_pos : 0 < law.weight i *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
        (r * Real.cos theta / Real.cos (theta - angle i)) *
        (1 / Real.cos (theta - angle i))) := by
    rw [hr_div, hi, sub_zero]
    exact mul_pos (law.weight_pos i)
      (mul_pos hr_deriv_pos (one_div_pos.mpr hcos_i))
  exact hterm_deriv_pos.ne' hterm_deriv_zero

/--
The symmetric endpoint repair: a finite conditional genre cannot coincide
with the second-user ray.  This time the corresponding canonical value is a
strict interior point, so the ordinary first-coordinate C1 FOC is valid.
-/
theorem finiteGenre_angle_ne_theta_of_scaledNormRpowCostNash
    {G P : ℕ} [Nonempty (Fin P)] {alpha beta theta : ℝ}
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu] {angle : Fin G → ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (hP : 1 < P) (hsin : 0 < Real.sin theta)
    (hcos : ∀ i, 0 < Real.cos (angle i))
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun j : Fin 2 => if j = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu)
    (hscore_ac : ∀ j : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if j = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta) q) mu ≪
        volume)
    (i : Fin G) : angle i ≠ theta := by
  letI : ∀ j, IsProbabilityMeasure (law.radial j) := law.radial_probability
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) :=
    Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
  intro hi
  obtain ⟨r, hr_support, hr_pos, hr_cdf_pos, hr_deriv_pos⟩ :=
    AppliedModelingLib.Probability.exists_pos_mem_support_of_lowerCDFMass_pos_and_deriv_pos
      (law.radial i) (law.radial_has_positive_support i) (law.radial_cdf_c1 i)
  have hp_scale : scaleContent r
      (content2 (Real.cos (angle i)) (Real.sin (angle i))) ∈ mu.support :=
    law.ray_mem_contentSupport hr_support
  have hp : content2 (r * Real.cos (angle i)) (r * Real.sin (angle i)) ∈ mu.support := by
    convert hp_scale using 1
    ext d
    fin_cases d <;> simp [scaleContent, content2]
  have hcos_theta : 0 < Real.cos theta := by simpa [hi] using hcos i
  have hz_support : (r * Real.cos theta, r) ∈
      (Measure.map (canonicalTwoUserValueMap theta) mu).support := by
    have hz := canonicalTwoUserValueMap_mem_support_of_mem_content_support (θ := theta) hp
    rw [canonicalTwoUserValueMap_content2_angleRadius theta (angle i) r, hi] at hz
    simpa using hz
  have hmax :=
    canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      hsin hnash hscore_ac (r * Real.cos theta, r) hz_support
  have hraw_c1 := finiteGenre_firstLowerCDFMass_contDiff law hcos
  have hraw_deriv : HasDerivAt
      (fun x => AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x)
      (deriv (fun x => AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x)
        (r * Real.cos theta))
      (r * Real.cos theta) :=
    (hraw_c1.differentiable (by norm_num) (r * Real.cos theta)).hasDerivAt
  have hmax_deriv :=
    AppliedModelingLib.Probability.hasDerivAt_iidMaximumCdf_of_hasDerivAt_lowerCDFMass
      (n := P - 1)
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu)
      hraw_deriv
  have hreward_deriv : HasDerivAt
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x)
      (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x)
        (r * Real.cos theta))
      (r * Real.cos theta) := by
    rw [hmax_deriv.deriv]
    exact hmax_deriv
  have hz1_pos : 0 < r * Real.cos theta := mul_pos hr_pos hcos_theta
  have hcos_sq_lt_one : (Real.cos theta) ^ 2 < 1 := by
    nlinarith [Real.sin_sq_add_cos_sq theta, sq_pos_of_pos hsin]
  have hzslack : r * Real.cos theta * Real.cos theta < r := by
    nlinarith
  have hbase : twoUserInducedCostNumerator theta (r * Real.cos theta) r ≠ 0 :=
    twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero hsin.ne' (Or.inl hz1_pos.ne')
  have hreward_zero : deriv
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x)
      (r * Real.cos theta) = 0 := by
    have hfoc := twoUserInducedCostFirstPartial_eq_of_isMaxOn_of_feasibleInterior
      hmax hsin hz1_pos hzslack hreward_deriv (Or.inl hbase)
    convert hfoc.symm using 1 <;> ring
  have hcos_i_ne : Real.cos theta ≠ 0 := hcos_theta.ne'
  have hr_div : r * Real.cos theta / Real.cos (angle i) = r := by
    rw [hi]
    exact mul_div_cancel_right₀ r hcos_i_ne
  have hterm_cdf_nonneg : ∀ j : Fin G, 0 ≤ law.weight j *
      AppliedModelingLib.Probability.lowerCDFMass (law.radial j)
        (r * Real.cos theta / Real.cos (angle j)) := by
    intro j
    exact mul_nonneg (law.weight_pos j).le
      (AppliedModelingLib.Probability.lowerCDFMass_nonneg (law.radial j) _)
  have hterm_cdf_pos : 0 < law.weight i *
      AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (r * Real.cos theta / Real.cos (angle i)) := by
    rw [hr_div]
    exact mul_pos (law.weight_pos i) hr_cdf_pos
  have hraw_cdf_pos : 0 < AppliedModelingLib.Probability.lowerCDFMass
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu)
      (r * Real.cos theta) := by
    rw [finiteGenre_firstLowerCDFMass_eq law hcos]
    exact lt_of_lt_of_le hterm_cdf_pos
      (Finset.single_le_sum (fun j _ => hterm_cdf_nonneg j) (Finset.mem_univ i))
  have hP_minus_one_pos : 0 < P - 1 := by omega
  have hP_minus_one_real_pos : 0 < ((P - 1 : ℕ) : ℝ) :=
    Nat.cast_pos.mpr hP_minus_one_pos
  have hscalar_pos : 0 < ((P - 1 : ℕ) : ℝ) *
      (AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu)
        (r * Real.cos theta)) ^ (P - 1 - 1) :=
    mul_pos hP_minus_one_real_pos (pow_pos hraw_cdf_pos _)
  have hraw_deriv_zero : deriv (fun x => AppliedModelingLib.Probability.lowerCDFMass
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x)
      (r * Real.cos theta) = 0 := by
    rw [AppliedModelingLib.Probability.deriv_iidMaximumCdf_eq_of_hasDerivAt_lowerCDFMass
      (n := P - 1)
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu)
      hraw_deriv] at hreward_zero
    exact (mul_eq_zero.mp hreward_zero).resolve_left hscalar_pos.ne'
  have hterm_deriv_nonneg : ∀ j : Fin G, 0 ≤ law.weight j *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial j))
        (r * Real.cos theta / Real.cos (angle j)) *
        (1 / Real.cos (angle j))) := by
    intro j
    refine mul_nonneg (law.weight_pos j).le (mul_nonneg ?_ ?_)
    · exact (AppliedModelingLib.Probability.lowerCDFMass_mono (law.radial j)).deriv_nonneg
    · exact one_div_nonneg.mpr (hcos j).le
  have hsum_deriv_zero : ∑ j, law.weight j *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial j))
        (r * Real.cos theta / Real.cos (angle j)) *
        (1 / Real.cos (angle j))) = 0 := by
    rw [← deriv_finiteGenre_firstLowerCDFMass_eq law hcos]
    exact hraw_deriv_zero
  have hterm_deriv_zero : law.weight i *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
        (r * Real.cos theta / Real.cos (angle i)) *
        (1 / Real.cos (angle i))) = 0 :=
    ((Finset.sum_eq_zero_iff_of_nonneg (fun j _ => hterm_deriv_nonneg j)).mp
      hsum_deriv_zero) i (Finset.mem_univ i)
  have hterm_deriv_pos : 0 < law.weight i *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
        (r * Real.cos theta / Real.cos (angle i)) *
        (1 / Real.cos (angle i))) := by
    rw [hr_div, hi]
    exact mul_pos (law.weight_pos i)
      (mul_pos hr_deriv_pos (one_div_pos.mpr hcos_theta))
  exact hterm_deriv_pos.ne' hterm_deriv_zero

/--
Under the source's principal first-quadrant angle convention, C1's canonical
value-space cone restriction puts every finite genre in the closed interval
from the first user ray to the second user ray.

The convention is explicit because an unrestricted real-valued trigonometric
parameter would not determine a unique polar angle.
-/
theorem finiteGenre_angle_mem_Icc_zero_theta_of_scaledNormRpowCostNash_of_angle_mem_Icc_zero_pi_div_two
    {G P : ℕ} [Nonempty (Fin P)] {alpha beta theta : ℝ}
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu] {angle : Fin G → ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (hbeta : 0 < beta) (halpha : 0 < alpha)
    (htheta_pos : 0 < theta) (htheta_le : theta ≤ Real.pi / 2)
    (hangle_chart : ∀ i, angle i ∈ Set.Icc 0 (Real.pi / 2))
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun j : Fin 2 => if j = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu)
    (hscore_ac : ∀ j : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if j = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta) q) mu ≪
        volume)
    (i : Fin G) : angle i ∈ Set.Icc 0 theta := by
  have htheta_lt_pi : theta < Real.pi := by
    linarith [Real.pi_pos]
  have hsin : 0 < Real.sin theta :=
    Real.sin_pos_of_pos_of_lt_pi htheta_pos htheta_lt_pi
  have hcos_theta : 0 ≤ Real.cos theta :=
    Real.cos_nonneg_of_mem_Icc
      ⟨by linarith [Real.pi_pos], htheta_le⟩
  have hcos_angle : 0 ≤ Real.cos (angle i) :=
    Real.cos_nonneg_of_mem_Icc
      ⟨by linarith [Real.pi_pos, (hangle_chart i).1], (hangle_chart i).2⟩
  have hsin_angle : 0 ≤ Real.sin (angle i) :=
    Real.sin_nonneg_of_nonneg_of_le_pi (hangle_chart i).1
      (by linarith [(hangle_chart i).2])
  obtain ⟨r, hr_support, hr_pos⟩ := law.radial_has_positive_support i
  have hp_scale : scaleContent r
      (content2 (Real.cos (angle i)) (Real.sin (angle i))) ∈ mu.support :=
    law.ray_mem_contentSupport hr_support
  have hp : content2 (r * Real.cos (angle i)) (r * Real.sin (angle i)) ∈ mu.support := by
    convert hp_scale using 1
    ext d
    fin_cases d <;> simp [scaleContent, content2]
  have hz_support : (r * Real.cos (angle i), r * Real.cos (theta - angle i)) ∈
      (Measure.map (canonicalTwoUserValueMap theta) mu).support := by
    have hz := canonicalTwoUserValueMap_mem_support_of_mem_content_support (θ := theta) hp
    rw [canonicalTwoUserValueMap_content2_angleRadius theta (angle i) r] at hz
    exact hz
  have hz_feasible : (r * Real.cos (angle i), r * Real.cos (theta - angle i)) ∈
      canonicalTwoUserFeasibleValueSet theta := by
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
    constructor
    · exact mul_nonneg hr_pos.le hcos_angle
    · have hslack : 0 ≤ r * (Real.sin theta * Real.sin (angle i)) :=
        mul_nonneg hr_pos.le (mul_nonneg hsin.le hsin_angle)
      calc
        (r * Real.cos (angle i)) * Real.cos theta ≤
            r * Real.cos (angle i) * Real.cos theta +
              r * (Real.sin theta * Real.sin (angle i)) :=
          le_add_of_nonneg_right hslack
        _ = r * (Real.cos theta * Real.cos (angle i) +
              Real.sin theta * Real.sin (angle i)) := by ring
        _ = r * Real.cos (theta - angle i) := by rw [Real.cos_sub]
  have hmax :=
    canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      (α := alpha) (β := beta) (θ := theta) hsin hnash hscore_ac
      (r * Real.cos (angle i), r * Real.cos (theta - angle i)) hz_support
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) :=
    Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
  have hcone := canonicalTwoUser_secondUserSlope_le_of_isMaxOn_of_mono_rewards
    hmax hz_feasible halpha hbeta hsin hcos_theta
    (AppliedModelingLib.Probability.iidMaximumCdf_mono
      (n := P - 1)
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu))
  have hcone_scaled : r *
      (Real.cos theta * Real.cos (theta - angle i)) ≤ r * Real.cos (angle i) := by
    convert hcone using 1 <;> ring
  have hcone_angle : Real.cos theta * Real.cos (theta - angle i) ≤
      Real.cos (angle i) :=
    le_of_mul_le_mul_left hcone_scaled hr_pos
  have hsin_product : 0 ≤ Real.sin theta * Real.sin (theta - angle i) := by
    calc
      Real.sin theta * Real.sin (theta - angle i) =
          ((Real.sin theta) ^ 2 + (Real.cos theta) ^ 2) * Real.cos (angle i) -
            Real.cos theta * (Real.cos theta * Real.cos (angle i) +
              Real.sin theta * Real.sin (angle i)) := by
        rw [Real.sin_sub]
        ring
      _ = Real.cos (angle i) - Real.cos theta * Real.cos (theta - angle i) := by
        rw [Real.cos_sub, Real.sin_sq_add_cos_sq]
        ring
      _ ≥ 0 := sub_nonneg.mpr hcone_angle
  have hsin_difference : 0 ≤ Real.sin (theta - angle i) :=
    nonneg_of_mul_nonneg_right hsin_product hsin
  refine ⟨(hangle_chart i).1, ?_⟩
  by_contra hnot
  have hnegative : theta - angle i < 0 := by
    linarith [lt_of_not_ge hnot]
  have hneg_pi_lt : -Real.pi < theta - angle i := by
    linarith [Real.pi_pos, (hangle_chart i).2]
  exact (not_lt_of_ge hsin_difference)
    (Real.sin_neg_of_neg_of_neg_pi_lt hnegative hneg_pi_lt)

/-- A two-element finite conditional family is the concrete two-genre law. -/
noncomputable def FiniteGenreConditionalNormLaw.toTwoGenre
    {mu : MixedContentStrategy 2} {angle : Fin 2 → ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle) :
    TwoGenreConditionalNormLaw mu (angle 0) (angle 1) :=
  { weight1 := law.weight 0
    weight2 := law.weight 1
    radial1 := law.radial 0
    radial2 := law.radial 1
    weight1_pos := law.weight_pos 0
    weight2_pos := law.weight_pos 1
    weights_sum := by simpa [Fin.sum_univ_two] using law.weights_sum
    radial1_probability := law.radial_probability 0
    radial2_probability := law.radial_probability 1
    radial1_support_nonnegative := law.radial_support_nonnegative 0
    radial2_support_nonnegative := law.radial_support_nonnegative 1
    radial1_has_positive_support := law.radial_has_positive_support 0
    radial2_has_positive_support := law.radial_has_positive_support 1
    radial1_cdf_c1 := law.radial_cdf_c1 0
    radial2_cdf_c1 := law.radial_cdf_c1 1
    decomposition := by simpa [Fin.sum_univ_two] using law.decomposition }

/-- Reflect a two-genre conditional law by exchanging its two radial pieces. -/
noncomputable def TwoGenreConditionalNormLaw.swap
    {mu : MixedContentStrategy 2} {theta1 theta2 : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2) :
    TwoGenreConditionalNormLaw mu theta2 theta1 :=
  { weight1 := law.weight2
    weight2 := law.weight1
    radial1 := law.radial2
    radial2 := law.radial1
    weight1_pos := law.weight2_pos
    weight2_pos := law.weight1_pos
    weights_sum := by simpa [add_comm] using law.weights_sum
    radial1_probability := law.radial2_probability
    radial2_probability := law.radial1_probability
    radial1_support_nonnegative := law.radial2_support_nonnegative
    radial2_support_nonnegative := law.radial1_support_nonnegative
    radial1_has_positive_support := law.radial2_has_positive_support
    radial2_has_positive_support := law.radial1_has_positive_support
    radial1_cdf_c1 := law.radial2_cdf_c1
    radial2_cdf_c1 := law.radial1_cdf_c1
    decomposition := by simpa [add_comm] using law.decomposition }

/--
Compactness of the equilibrium content support transfers to the first
conditional radial support.  Positive genre mass makes the radial pushforward
absolutely continuous with respect to its mixture component, while continuity
of the ray map sends radial support points into that component's support.
-/
theorem TwoGenreConditionalNormLaw.radial1_support_isCompact
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta1 theta2 : ℝ} (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hcompact : IsCompact mu.support) :
    IsCompact law.radial1.support := by
  let ray1 : ℝ → Content 2 := fun r =>
    scaleContent r (content2 (Real.cos theta1) (Real.sin theta1))
  let component1 : Measure (Content 2) :=
    ENNReal.ofReal law.weight1 • Measure.map ray1 law.radial1
  let component2 : Measure (Content 2) :=
    ENNReal.ofReal law.weight2 •
      Measure.map
        (fun r : ℝ => scaleContent r
          (content2 (Real.cos theta2) (Real.sin theta2))) law.radial2
  have hdecomposition : mu = component1 + component2 := law.decomposition
  have hray1_cont : Continuous ray1 := by
    apply continuous_pi
    intro d
    exact continuous_id.mul continuous_const
  have hcomponent_support :
      component1.support ⊆ mu.support := by
    rw [hdecomposition, Measure.support_add]
    exact Set.subset_union_left
  have hmap_support :
      (Measure.map ray1 law.radial1).support ⊆ mu.support := by
    have hac : Measure.map ray1 law.radial1 ≪ component1 := by
      dsimp only [component1]
      exact Measure.absolutelyContinuous_smul
        (ENNReal.ofReal_pos.mpr law.weight1_pos).ne'
    exact hac.support_mono.trans hcomponent_support
  have hray_support : ∀ r ∈ law.radial1.support, ray1 r ∈ mu.support := by
    intro r hr
    exact hmap_support
      (AppliedModelingLib.Probability.mem_support_map_of_continuous hray1_cont hr)
  obtain ⟨pmax, hpmax, hmax⟩ := hcompact.exists_isMaxOn
    (Measure.nonempty_support (IsProbabilityMeasure.ne_zero mu))
    (SourceNorm.l2_continuous 2).continuousOn
  have hbounded : Bornology.IsBounded law.radial1.support := by
    rw [Metric.isBounded_iff_subset_closedBall 0]
    refine ⟨(SourceNorm.l2 2).norm pmax, ?_⟩
    intro r hr
    have hrnonneg : 0 ≤ r := law.radial1_support_nonnegative hr
    have hrle : r ≤ (SourceNorm.l2 2).norm pmax := by
      have hnormle := hmax (hray_support r hr)
      simpa [ray1, (SourceNorm.l2 2).scale_nonneg hrnonneg,
        l2_norm_content2_cos_sin] using hnormle
    rw [Metric.mem_closedBall, Real.dist_eq, sub_zero, abs_of_nonneg hrnonneg]
    exact hrle
  exact Metric.isCompact_iff_isClosed_bounded.mpr
    ⟨Measure.isClosed_support, hbounded⟩

/-- The second conditional radial support is compact by the symmetric argument. -/
theorem TwoGenreConditionalNormLaw.radial2_support_isCompact
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta1 theta2 : ℝ} (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hcompact : IsCompact mu.support) :
    IsCompact law.radial2.support := by
  let swapped : TwoGenreConditionalNormLaw mu theta2 theta1 :=
    { weight1 := law.weight2
      weight2 := law.weight1
      radial1 := law.radial2
      radial2 := law.radial1
      weight1_pos := law.weight2_pos
      weight2_pos := law.weight1_pos
      weights_sum := by simpa [add_comm] using law.weights_sum
      radial1_probability := law.radial2_probability
      radial2_probability := law.radial1_probability
      radial1_support_nonnegative := law.radial2_support_nonnegative
      radial2_support_nonnegative := law.radial1_support_nonnegative
      radial1_has_positive_support := law.radial2_has_positive_support
      radial2_has_positive_support := law.radial1_has_positive_support
      radial1_cdf_c1 := law.radial2_cdf_c1
      radial2_cdf_c1 := law.radial1_cdf_c1
      decomposition := by simpa [add_comm] using law.decomposition }
  exact swapped.radial1_support_isCompact hcompact

/--
The two actual conditional genres have positive maximum magnitudes, and their
radial supports lie in the corresponding closed intervals from zero to those
maxima.  These are the `r₁,r₂` support caps selected in the source proof; here
their existence follows from equilibrium compactness rather than being added
as an assumption.
-/
theorem TwoGenreConditionalNormLaw.exists_positive_support_caps
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta1 theta2 : ℝ} (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hcompact : IsCompact mu.support) :
    ∃ r1 r2 : ℝ,
      0 < r1 ∧ 0 < r2 ∧
      law.radial1.support ⊆ Set.Icc 0 r1 ∧
      law.radial2.support ⊆ Set.Icc 0 r2 ∧
      r1 ∈ law.radial1.support ∧ r2 ∈ law.radial2.support := by
  obtain ⟨r1, hr1, hmax1⟩ :=
    (law.radial1_support_isCompact hcompact).exists_isMaxOn
      ⟨law.radial1_has_positive_support.choose,
        law.radial1_has_positive_support.choose_spec.1⟩
      continuous_id.continuousOn
  obtain ⟨r2, hr2, hmax2⟩ :=
    (law.radial2_support_isCompact hcompact).exists_isMaxOn
      ⟨law.radial2_has_positive_support.choose,
        law.radial2_has_positive_support.choose_spec.1⟩
      continuous_id.continuousOn
  have hr1pos : 0 < r1 :=
    (law.radial1_has_positive_support.choose_spec.2.trans_le
      (hmax1 law.radial1_has_positive_support.choose_spec.1))
  have hr2pos : 0 < r2 :=
    (law.radial2_has_positive_support.choose_spec.2.trans_le
      (hmax2 law.radial2_has_positive_support.choose_spec.1))
  refine ⟨r1, r2, hr1pos, hr2pos, ?_, ?_, hr1, hr2⟩
  · intro r hr
    exact ⟨law.radial1_support_nonnegative hr, hmax1 hr⟩
  · intro r hr
    exact ⟨law.radial2_support_nonnegative hr, hmax2 hr⟩

/--
Under a two-genre conditional radial decomposition, the first user's raw-score
law is the weighted sum of the two radial laws scaled by their first-coordinate
cosines.
-/
theorem twoGenre_firstScoreLaw_eq
    {mu : MixedContentStrategy 2} {theta1 theta2 : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2) :
    Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu =
      ENNReal.ofReal law.weight1 •
          Measure.map (fun r : ℝ => r * Real.cos theta1) law.radial1 +
        ENNReal.ofReal law.weight2 •
          Measure.map (fun r : ℝ => r * Real.cos theta2) law.radial2 := by
  have hscore : Measurable (fun p : Content 2 => score canonicalTwoUserFirst p) :=
    measurable_score_content canonicalTwoUserFirst
  have hray1 : Measurable
      (fun r : ℝ => scaleContent r
        (content2 (Real.cos theta1) (Real.sin theta1))) := by
    rw [measurable_pi_iff]
    intro d
    exact measurable_id.mul measurable_const
  have hray2 : Measurable
      (fun r : ℝ => scaleContent r
        (content2 (Real.cos theta2) (Real.sin theta2))) := by
    rw [measurable_pi_iff]
    intro d
    exact measurable_id.mul measurable_const
  calc
    Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu =
        Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p)
          (ENNReal.ofReal law.weight1 •
              Measure.map
                (fun r : ℝ => scaleContent r
                  (content2 (Real.cos theta1) (Real.sin theta1)))
                law.radial1 +
            ENNReal.ofReal law.weight2 •
              Measure.map
                (fun r : ℝ => scaleContent r
                  (content2 (Real.cos theta2) (Real.sin theta2)))
                law.radial2) := congrArg _ law.decomposition
    _ = ENNReal.ofReal law.weight1 •
          Measure.map (fun r : ℝ => r * Real.cos theta1) law.radial1 +
        ENNReal.ofReal law.weight2 •
          Measure.map (fun r : ℝ => r * Real.cos theta2) law.radial2 := by
      rw [Measure.map_add _ _ hscore, Measure.map_smul, Measure.map_smul,
        Measure.map_map hscore hray1, Measure.map_map hscore hray2]
      congr 1
      · apply congrArg (fun rho : Measure ℝ => ENNReal.ofReal law.weight1 • rho)
        apply Measure.map_congr
        filter_upwards [] with r
        simp [Function.comp_apply, score_scaleContent, canonicalTwoUserFirst,
          score_content2]
      · apply congrArg (fun rho : Measure ℝ => ENNReal.ofReal law.weight2 • rho)
        apply Measure.map_congr
        filter_upwards [] with r
        simp [Function.comp_apply, score_scaleContent, canonicalTwoUserFirst,
          score_content2]

/--
The analogous raw-score-law decomposition for the second user.  The score of
a magnitude `r` on the ray at angle `thetaᵢ` is
`r * cos (theta - thetaᵢ)`.
-/
theorem twoGenre_secondScoreLaw_eq
    {mu : MixedContentStrategy 2} {theta theta1 theta2 : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2) :
    Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu =
      ENNReal.ofReal law.weight1 •
          Measure.map (fun r : ℝ => r * Real.cos (theta - theta1)) law.radial1 +
        ENNReal.ofReal law.weight2 •
          Measure.map (fun r : ℝ => r * Real.cos (theta - theta2)) law.radial2 := by
  have hscore : Measurable
      (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) :=
    measurable_score_content (canonicalTwoUserSecond theta)
  have hray1 : Measurable
      (fun r : ℝ => scaleContent r
        (content2 (Real.cos theta1) (Real.sin theta1))) := by
    rw [measurable_pi_iff]
    intro d
    exact measurable_id.mul measurable_const
  have hray2 : Measurable
      (fun r : ℝ => scaleContent r
        (content2 (Real.cos theta2) (Real.sin theta2))) := by
    rw [measurable_pi_iff]
    intro d
    exact measurable_id.mul measurable_const
  calc
    Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu =
        Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p)
          (ENNReal.ofReal law.weight1 •
              Measure.map
                (fun r : ℝ => scaleContent r
                  (content2 (Real.cos theta1) (Real.sin theta1)))
                law.radial1 +
            ENNReal.ofReal law.weight2 •
              Measure.map
                (fun r : ℝ => scaleContent r
                  (content2 (Real.cos theta2) (Real.sin theta2)))
                law.radial2) := congrArg _ law.decomposition
    _ = ENNReal.ofReal law.weight1 •
          Measure.map (fun r : ℝ => r * Real.cos (theta - theta1)) law.radial1 +
        ENNReal.ofReal law.weight2 •
          Measure.map (fun r : ℝ => r * Real.cos (theta - theta2)) law.radial2 := by
      rw [Measure.map_add _ _ hscore, Measure.map_smul, Measure.map_smul,
        Measure.map_map hscore hray1, Measure.map_map hscore hray2]
      congr 1
      · apply congrArg (fun rho : Measure ℝ => ENNReal.ofReal law.weight1 • rho)
        apply Measure.map_congr
        filter_upwards [] with r
        simp [Function.comp_apply, score_scaleContent, canonicalTwoUserSecond,
          score_content2, Real.cos_sub]
      · apply congrArg (fun rho : Measure ℝ => ENNReal.ofReal law.weight2 • rho)
        apply Measure.map_congr
        filter_upwards [] with r
        simp [Function.comp_apply, score_scaleContent, canonicalTwoUserSecond,
          score_content2, Real.cos_sub]

/--
The support of the first raw-score law is exactly the union of the two scaled
conditional radial supports.  Compactness rules out extra closure points in
the continuous pushforwards, and positive mixture weights leave support
unchanged.
-/
theorem twoGenre_firstScoreLaw_support_eq
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta1 theta2 : ℝ} (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hcompact : IsCompact mu.support) :
    (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu).support =
      (fun r : ℝ => r * Real.cos theta1) '' law.radial1.support ∪
        (fun r : ℝ => r * Real.cos theta2) '' law.radial2.support := by
  have hcompact1 := law.radial1_support_isCompact hcompact
  have hcompact2 := law.radial2_support_isCompact hcompact
  have hmap1 :
      (Measure.map (fun r : ℝ => r * Real.cos theta1) law.radial1).support =
        (fun r : ℝ => r * Real.cos theta1) '' law.radial1.support :=
    AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      hcompact1 (continuous_id.mul continuous_const)
  have hmap2 :
      (Measure.map (fun r : ℝ => r * Real.cos theta2) law.radial2).support =
        (fun r : ℝ => r * Real.cos theta2) '' law.radial2.support :=
    AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      hcompact2 (continuous_id.mul continuous_const)
  calc
    (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu).support =
        (Measure.map (fun r : ℝ => r * Real.cos theta1) law.radial1).support ∪
          (Measure.map (fun r : ℝ => r * Real.cos theta2) law.radial2).support := by
      rw [twoGenre_firstScoreLaw_eq law, Measure.support_add,
        AppliedModelingLib.Probability.support_smul_eq_of_ne_zero _
          (ENNReal.ofReal_pos.mpr law.weight1_pos).ne',
        AppliedModelingLib.Probability.support_smul_eq_of_ne_zero _
          (ENNReal.ofReal_pos.mpr law.weight2_pos).ne']
    _ = (fun r : ℝ => r * Real.cos theta1) '' law.radial1.support ∪
        (fun r : ℝ => r * Real.cos theta2) '' law.radial2.support := by
      rw [hmap1, hmap2]

/-- The analogous exact support union for the second user's raw scores. -/
theorem twoGenre_secondScoreLaw_support_eq
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta theta1 theta2 : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hcompact : IsCompact mu.support) :
    (Measure.map
        (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu).support =
      (fun r : ℝ => r * Real.cos (theta - theta1)) '' law.radial1.support ∪
        (fun r : ℝ => r * Real.cos (theta - theta2)) '' law.radial2.support := by
  have hcompact1 := law.radial1_support_isCompact hcompact
  have hcompact2 := law.radial2_support_isCompact hcompact
  have hmap1 :
      (Measure.map
        (fun r : ℝ => r * Real.cos (theta - theta1)) law.radial1).support =
        (fun r : ℝ => r * Real.cos (theta - theta1)) '' law.radial1.support :=
    AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      hcompact1 (continuous_id.mul continuous_const)
  have hmap2 :
      (Measure.map
        (fun r : ℝ => r * Real.cos (theta - theta2)) law.radial2).support =
        (fun r : ℝ => r * Real.cos (theta - theta2)) '' law.radial2.support :=
    AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      hcompact2 (continuous_id.mul continuous_const)
  calc
    (Measure.map
        (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu).support =
        (Measure.map
          (fun r : ℝ => r * Real.cos (theta - theta1)) law.radial1).support ∪
          (Measure.map
            (fun r : ℝ => r * Real.cos (theta - theta2)) law.radial2).support := by
      rw [twoGenre_secondScoreLaw_eq law, Measure.support_add,
        AppliedModelingLib.Probability.support_smul_eq_of_ne_zero _
          (ENNReal.ofReal_pos.mpr law.weight1_pos).ne',
        AppliedModelingLib.Probability.support_smul_eq_of_ne_zero _
          (ENNReal.ofReal_pos.mpr law.weight2_pos).ne']
    _ = (fun r : ℝ => r * Real.cos (theta - theta1)) '' law.radial1.support ∪
        (fun r : ℝ => r * Real.cos (theta - theta2)) '' law.radial2.support := by
      rw [hmap1, hmap2]

/--
If two nonnegative compact radial supports have respective maxima `r₁,r₂`,
then the upper endpoint of the union of their positively scaled images is
`max (r₁c₁) (r₂c₂)`.  This is the elementary support-endpoint calculation used
twice in the paper's definition of `i₁,i₂`.
-/
theorem upperEndpoint_eq_max_scaled_caps_of_support_union
    {s1 s2 : Set ℝ} {r1 r2 c1 c2 B : ℝ}
    (hr1 : 0 < r1) (hc1 : 0 < c1) (hc2 : 0 < c2)
    (hs1 : s1 ⊆ Set.Icc 0 r1) (hs2 : s2 ⊆ Set.Icc 0 r2)
    (hr1mem : r1 ∈ s1) (hr2mem : r2 ∈ s2)
    (hsupport :
      (fun r : ℝ => r * c1) '' s1 ∪ (fun r : ℝ => r * c2) '' s2 =
        Set.Icc 0 B) :
    B = max (r1 * c1) (r2 * c2) := by
  have hcap1 : r1 * c1 ∈ Set.Icc 0 B := by
    rw [← hsupport]
    exact Or.inl ⟨r1, hr1mem, rfl⟩
  have hcap2 : r2 * c2 ∈ Set.Icc 0 B := by
    rw [← hsupport]
    exact Or.inr ⟨r2, hr2mem, rfl⟩
  have hmax_le : max (r1 * c1) (r2 * c2) ≤ B :=
    max_le hcap1.2 hcap2.2
  have hBnonneg : 0 ≤ B :=
    (mul_pos hr1 hc1).le.trans hcap1.2
  have hBmem : B ∈ Set.Icc 0 B := ⟨hBnonneg, le_rfl⟩
  have hBunion : B ∈
      (fun r : ℝ => r * c1) '' s1 ∪ (fun r : ℝ => r * c2) '' s2 := by
    rw [hsupport]
    exact hBmem
  have hB_le : B ≤ max (r1 * c1) (r2 * c2) := by
    rcases hBunion with ⟨r, hr, hrB⟩ | ⟨r, hr, hrB⟩
    · rw [← hrB]
      exact (mul_le_mul_of_nonneg_right (hs1 hr).2 hc1.le).trans
        (le_max_left _ _)
    · rw [← hrB]
      exact (mul_le_mul_of_nonneg_right (hs2 hr).2 hc2.le).trans
        (le_max_right _ _)
  exact le_antisymm hB_le hmax_le

/--
Select the two positive radial caps and identify both marginal score-support
endpoints with the corresponding maxima over the two genres.  This packages
the source's `rᵢ^{max}`, `z₁^{max}`, and `z₂^{max}` definitions as consequences
of the conditional-law decomposition and the already-proved interval support
statements.
-/
theorem TwoGenreConditionalNormLaw.exists_caps_and_score_endpoints
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta theta1 theta2 B1 B2 : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hcompact : IsCompact mu.support)
    (hc1 : 0 < Real.cos theta1) (hc2 : 0 < Real.cos theta2)
    (hd1 : 0 < Real.cos (theta - theta1))
    (hd2 : 0 < Real.cos (theta - theta2))
    (hfirst_support :
      (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu).support =
        Set.Icc 0 B1)
    (hsecond_support :
      (Measure.map
        (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu).support =
        Set.Icc 0 B2) :
    ∃ r1 r2 : ℝ,
      0 < r1 ∧ 0 < r2 ∧
      law.radial1.support ⊆ Set.Icc 0 r1 ∧
      law.radial2.support ⊆ Set.Icc 0 r2 ∧
      r1 ∈ law.radial1.support ∧ r2 ∈ law.radial2.support ∧
      B1 = max (r1 * Real.cos theta1) (r2 * Real.cos theta2) ∧
      B2 = max (r1 * Real.cos (theta - theta1))
        (r2 * Real.cos (theta - theta2)) := by
  obtain ⟨r1, r2, hr1, hr2, hsupp1, hsupp2, hr1mem, hr2mem⟩ :=
    law.exists_positive_support_caps hcompact
  have hfirst_union :
      (fun r : ℝ => r * Real.cos theta1) '' law.radial1.support ∪
          (fun r : ℝ => r * Real.cos theta2) '' law.radial2.support =
        Set.Icc 0 B1 :=
    (twoGenre_firstScoreLaw_support_eq law hcompact).symm.trans hfirst_support
  have hsecond_union :
      (fun r : ℝ => r * Real.cos (theta - theta1)) '' law.radial1.support ∪
          (fun r : ℝ => r * Real.cos (theta - theta2)) '' law.radial2.support =
        Set.Icc 0 B2 :=
    (twoGenre_secondScoreLaw_support_eq law hcompact).symm.trans hsecond_support
  refine ⟨r1, r2, hr1, hr2, hsupp1, hsupp2, hr1mem, hr2mem, ?_, ?_⟩
  · exact upperEndpoint_eq_max_scaled_caps_of_support_union
      hr1 hc1 hc2 hsupp1 hsupp2 hr1mem hr2mem hfirst_union
  · exact upperEndpoint_eq_max_scaled_caps_of_support_union
      hr1 hd1 hd2 hsupp1 hsupp2 hr1mem hr2mem hsecond_union

/--
The first user's raw-score CDF is the weighted mixture of the two conditional
radial CDFs evaluated at the score-rescaled arguments.  This proves, from the
conditional-law decomposition, the first mixture identity used in the
`finitegenre` density equations.
-/
theorem twoGenre_firstLowerCDFMass_eq
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta1 theta2 z : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hcos1 : 0 < Real.cos theta1) (hcos2 : 0 < Real.cos theta2) :
    AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) z =
      law.weight1 * AppliedModelingLib.Probability.lowerCDFMass law.radial1
          (z / Real.cos theta1) +
        law.weight2 * AppliedModelingLib.Probability.lowerCDFMass law.radial2
          (z / Real.cos theta2) := by
  letI : IsProbabilityMeasure law.radial1 := law.radial1_probability
  letI : IsProbabilityMeasure law.radial2 := law.radial2_probability
  letI : IsProbabilityMeasure
      (Measure.map (fun r : ℝ => r * Real.cos theta1) law.radial1) :=
    Measure.isProbabilityMeasure_map (measurable_id.mul measurable_const).aemeasurable
  letI : IsProbabilityMeasure
      (Measure.map (fun r : ℝ => r * Real.cos theta2) law.radial2) :=
    Measure.isProbabilityMeasure_map (measurable_id.mul measurable_const).aemeasurable
  letI : IsFiniteMeasure
      (ENNReal.ofReal law.weight1 •
        Measure.map (fun r : ℝ => r * Real.cos theta1) law.radial1) :=
    Measure.smul_finite _ ENNReal.ofReal_ne_top
  letI : IsFiniteMeasure
      (ENNReal.ofReal law.weight2 •
        Measure.map (fun r : ℝ => r * Real.cos theta2) law.radial2) :=
    Measure.smul_finite _ ENNReal.ofReal_ne_top
  unfold AppliedModelingLib.Probability.lowerCDFMass
  rw [twoGenre_firstScoreLaw_eq law, measureReal_add_apply,
    measureReal_ennreal_smul_apply, measureReal_ennreal_smul_apply,
    ENNReal.toReal_ofReal law.weight1_pos.le,
    ENNReal.toReal_ofReal law.weight2_pos.le]
  change law.weight1 *
        AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun r : ℝ => r * Real.cos theta1) law.radial1) z +
      law.weight2 *
        AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun r : ℝ => r * Real.cos theta2) law.radial2) z = _
  rw [AppliedModelingLib.Probability.lowerCDFMass_map_mul_const law.radial1 hcos1,
    AppliedModelingLib.Probability.lowerCDFMass_map_mul_const law.radial2 hcos2]
  rfl

/--
The second user's counterpart of `twoGenre_firstLowerCDFMass_eq`, with the
two radial arguments rescaled by the corresponding angular score cosines.
-/
theorem twoGenre_secondLowerCDFMass_eq
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta theta1 theta2 z : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hcos1 : 0 < Real.cos (theta - theta1))
    (hcos2 : 0 < Real.cos (theta - theta2)) :
    AppliedModelingLib.Probability.lowerCDFMass
        (Measure.map (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) z =
      law.weight1 * AppliedModelingLib.Probability.lowerCDFMass law.radial1
          (z / Real.cos (theta - theta1)) +
        law.weight2 * AppliedModelingLib.Probability.lowerCDFMass law.radial2
          (z / Real.cos (theta - theta2)) := by
  letI : IsProbabilityMeasure law.radial1 := law.radial1_probability
  letI : IsProbabilityMeasure law.radial2 := law.radial2_probability
  letI : IsProbabilityMeasure
      (Measure.map (fun r : ℝ => r * Real.cos (theta - theta1)) law.radial1) :=
    Measure.isProbabilityMeasure_map (measurable_id.mul measurable_const).aemeasurable
  letI : IsProbabilityMeasure
      (Measure.map (fun r : ℝ => r * Real.cos (theta - theta2)) law.radial2) :=
    Measure.isProbabilityMeasure_map (measurable_id.mul measurable_const).aemeasurable
  letI : IsFiniteMeasure
      (ENNReal.ofReal law.weight1 •
        Measure.map (fun r : ℝ => r * Real.cos (theta - theta1)) law.radial1) :=
    Measure.smul_finite _ ENNReal.ofReal_ne_top
  letI : IsFiniteMeasure
      (ENNReal.ofReal law.weight2 •
        Measure.map (fun r : ℝ => r * Real.cos (theta - theta2)) law.radial2) :=
    Measure.smul_finite _ ENNReal.ofReal_ne_top
  unfold AppliedModelingLib.Probability.lowerCDFMass
  rw [twoGenre_secondScoreLaw_eq law, measureReal_add_apply,
    measureReal_ennreal_smul_apply, measureReal_ennreal_smul_apply,
    ENNReal.toReal_ofReal law.weight1_pos.le,
    ENNReal.toReal_ofReal law.weight2_pos.le]
  change law.weight1 *
        AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun r : ℝ => r * Real.cos (theta - theta1)) law.radial1) z +
      law.weight2 *
        AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun r : ℝ => r * Real.cos (theta - theta2)) law.radial2) z = _
  rw [AppliedModelingLib.Probability.lowerCDFMass_map_mul_const law.radial1 hcos1,
    AppliedModelingLib.Probability.lowerCDFMass_map_mul_const law.radial2 hcos2]
  rfl

/--
The first maximum-score CDF in `finitegenre` is the power law obtained by
integrating the common first-coordinate FOC.  Every positive score in the
closed marginal support is represented by a point on one of the finite rays,
so the common angle label supplies the same derivative everywhere.  The
atomless raw-score law gives continuity and the zero boundary value; no
endpoint derivative is assumed.
-/
theorem finiteGenre_firstReward_eq_const_mul_rpow_of_finiteGenres
    {P : ℕ} [Nonempty (Fin P)] {α β θ B : ℝ}
    {ν : SourceNorm 2} {μ : MixedContentStrategy 2} [IsProbabilityMeasure μ]
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ) (i0 : ι)
    (hP : 1 < P) (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hderiv1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) z.1) z.1)
    (hcos_first : ∀ i, 0 < Real.cos (angle i))
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))))
    (hfirst_support :
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support =
        Set.Icc 0 B)
    (hfirst_label : ∀ i,
      finiteGenreFirstAngleLabel β θ (angle i) =
        finiteGenreFirstAngleLabel β θ (angle i0)) :
    Set.EqOn
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x)
      (fun x =>
        (α / Real.sin θ * finiteGenreFirstAngleLabel β θ (angle i0)) * x ^ β)
      (Set.Icc 0 B) := by
  let μ1 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ
  let H1 : ℝ → ℝ :=
    fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 x
  let C1 : ℝ :=
    α / Real.sin θ * finiteGenreFirstAngleLabel β θ (angle i0)
  letI : IsProbabilityMeasure μ1 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  have hac1 : μ1 ≪ volume := by
    simpa [μ1] using hscore_ac (0 : Fin 2)
  letI : NoAtoms μ1 :=
    ⟨fun x => hac1 (by simpa using (volume_singleton x))⟩
  have hcdf : Continuous (AppliedModelingLib.Probability.lowerCDFMass μ1) := by
    have heq : AppliedModelingLib.Probability.lowerCDFMass μ1 = ProbabilityTheory.cdf μ1 := by
      funext x
      exact AppliedModelingLib.Probability.lowerCDFMass_eq_cdf μ1 x
    rw [heq]
    exact AppliedModelingLib.Probability.continuous_cdf_of_noAtoms μ1
  have hH1_cont : Continuous H1 := by
    have heq : H1 =
        fun x => (AppliedModelingLib.Probability.lowerCDFMass μ1 x) ^ (P - 1) := by
      funext x
      exact AppliedModelingLib.Probability.iidMaximumCdf_eq_lowerCDFMass_pow μ1 x
    rw [heq]
    exact hcdf.pow (P - 1)
  have hH1_zero : H1 0 = 0 := by
    apply AppliedModelingLib.Probability.iidMaximumCdf_eq_zero_of_forall_mem_support_le
      μ1 (Nat.sub_ne_zero_iff_lt.mpr hP)
    intro x hx
    rw [show μ1.support = Set.Icc 0 B by simpa [μ1] using hfirst_support] at hx
    exact hx.1
  have hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support :=
    canonicalTwoUser_isCompact_valueSupport_of_scaledNormRpowCostNash hnash hα hβ
  have hfst_image : Prod.fst ''
      (Measure.map (canonicalTwoUserValueMap θ) μ).support = Set.Icc 0 B := by
    calc
      Prod.fst '' (Measure.map (canonicalTwoUserValueMap θ) μ).support =
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support :=
        canonicalTwoUser_fst_image_valueSupport_eq_firstScoreSupport_of_isCompact hcompact
      _ = Set.Icc 0 B := hfirst_support
  have hray_cover : (Measure.map (canonicalTwoUserValueMap θ) μ).support ⊆
      ⋃ i, canonicalTwoUserGenreRay θ (angle i) := by
    apply canonicalTwoUser_valueSupport_subset_iUnion_canonicalGenreRay_of_nonzeroSupportGenres_subset_range
      (ν := ν) angle hsin.ne' hcos_first
    intro g hg
    rw [hgenres] at hg
    exact hg
  have hH1_deriv : ∀ x ∈ Set.Ioo 0 B,
      HasDerivAt H1 (β * C1 * x ^ (β - 1)) x := by
    intro x hx
    have hximage : x ∈ Prod.fst ''
        (Measure.map (canonicalTwoUserValueMap θ) μ).support := by
      rw [hfst_image]
      exact ⟨hx.1.le, hx.2.le⟩
    rcases hximage with ⟨z, hzsupport, hzx⟩
    rcases Set.mem_iUnion.mp (hray_cover hzsupport) with ⟨i, hzray⟩
    have hzne : z ≠ (0, 0) := by
      intro hzero
      have : x = 0 := by simpa [hzero] using hzx.symm
      exact (ne_of_gt hx.1) this
    have hmax : IsMaxOn
        (fun u : ℝ × ℝ =>
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) u.1 +
            AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) u.2 -
              twoUserInducedCost α β θ u.1 u.2)
        (canonicalTwoUserFeasibleValueSet θ) z :=
      canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
        hsin hnash hscore_ac z hzsupport
    have hformula :=
      deriv_firstReward_eq_scoreRpow_mul_finiteGenreFirstAngleLabel_of_isMaxOn_of_mem_canonicalGenreRay
        hmax hsin (by simpa [hzx] using hx.1) (hinterior z hzsupport hzne).2
        (hderiv1 z hzsupport hzne)
        (Or.inl (twoUserInducedCostNumerator_ne_zero_of_ne_zero hsin.ne' hzne))
        (hcos_first i) hzray
    have hderiv_raw := hderiv1 z hzsupport hzne
    change HasDerivAt H1 (β * C1 * x ^ (β - 1)) x
    rw [← hzx]
    convert hderiv_raw using 1
    rw [hformula, hfirst_label i]
    dsimp [C1]
    ring
  change Set.EqOn H1 (fun x => C1 * x ^ β) (Set.Icc 0 B)
  exact AppliedModelingLib.RealAnalysis.eqOn_const_mul_rpow_of_hasDerivAt
    hβ hH1_cont.continuousOn hH1_zero hH1_deriv

/--
The second maximum-score CDF satisfies the symmetric power law obtained from
the common second-coordinate FOC.  As above, the proof represents every
positive marginal score on an actual finite support ray and uses only
continuity at the zero endpoint.
-/
theorem finiteGenre_secondReward_eq_const_mul_rpow_of_finiteGenres
    {P : ℕ} [Nonempty (Fin P)] {α β θ B : ℝ}
    {ν : SourceNorm 2} {μ : MixedContentStrategy 2} [IsProbabilityMeasure μ]
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ) (i0 : ι)
    (hP : 1 < P) (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hderiv2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) x) z.2) z.2)
    (hcos_first : ∀ i, 0 < Real.cos (angle i))
    (hcos_second : ∀ i, 0 < Real.cos (θ - angle i))
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))))
    (hsecond_support :
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).support =
        Set.Icc 0 B)
    (hsecond_label : ∀ i,
      finiteGenreSecondAngleLabel β θ (angle i) =
        finiteGenreSecondAngleLabel β θ (angle i0)) :
    Set.EqOn
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) x)
      (fun x =>
        (α / Real.sin θ * finiteGenreSecondAngleLabel β θ (angle i0)) * x ^ β)
      (Set.Icc 0 B) := by
  let μ2 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ
  let H2 : ℝ → ℝ :=
    fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 x
  let C2 : ℝ :=
    α / Real.sin θ * finiteGenreSecondAngleLabel β θ (angle i0)
  letI : IsProbabilityMeasure μ2 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond θ)).aemeasurable
  have hac2 : μ2 ≪ volume := by
    simpa [μ2] using hscore_ac (1 : Fin 2)
  letI : NoAtoms μ2 :=
    ⟨fun x => hac2 (by simpa using (volume_singleton x))⟩
  have hcdf : Continuous (AppliedModelingLib.Probability.lowerCDFMass μ2) := by
    have heq : AppliedModelingLib.Probability.lowerCDFMass μ2 = ProbabilityTheory.cdf μ2 := by
      funext x
      exact AppliedModelingLib.Probability.lowerCDFMass_eq_cdf μ2 x
    rw [heq]
    exact AppliedModelingLib.Probability.continuous_cdf_of_noAtoms μ2
  have hH2_cont : Continuous H2 := by
    have heq : H2 =
        fun x => (AppliedModelingLib.Probability.lowerCDFMass μ2 x) ^ (P - 1) := by
      funext x
      exact AppliedModelingLib.Probability.iidMaximumCdf_eq_lowerCDFMass_pow μ2 x
    rw [heq]
    exact hcdf.pow (P - 1)
  have hH2_zero : H2 0 = 0 := by
    apply AppliedModelingLib.Probability.iidMaximumCdf_eq_zero_of_forall_mem_support_le
      μ2 (Nat.sub_ne_zero_iff_lt.mpr hP)
    intro x hx
    rw [show μ2.support = Set.Icc 0 B by simpa [μ2] using hsecond_support] at hx
    exact hx.1
  have hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support :=
    canonicalTwoUser_isCompact_valueSupport_of_scaledNormRpowCostNash hnash hα hβ
  have hsnd_image : Prod.snd ''
      (Measure.map (canonicalTwoUserValueMap θ) μ).support = Set.Icc 0 B := by
    calc
      Prod.snd '' (Measure.map (canonicalTwoUserValueMap θ) μ).support =
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).support :=
        canonicalTwoUser_snd_image_valueSupport_eq_secondScoreSupport_of_isCompact hcompact
      _ = Set.Icc 0 B := hsecond_support
  have hray_cover : (Measure.map (canonicalTwoUserValueMap θ) μ).support ⊆
      ⋃ i, canonicalTwoUserGenreRay θ (angle i) := by
    apply canonicalTwoUser_valueSupport_subset_iUnion_canonicalGenreRay_of_nonzeroSupportGenres_subset_range
      (ν := ν) angle hsin.ne' hcos_first
    intro g hg
    rw [hgenres] at hg
    exact hg
  have hH2_deriv : ∀ x ∈ Set.Ioo 0 B,
      HasDerivAt H2 (β * C2 * x ^ (β - 1)) x := by
    intro x hx
    have hximage : x ∈ Prod.snd ''
        (Measure.map (canonicalTwoUserValueMap θ) μ).support := by
      rw [hsnd_image]
      exact ⟨hx.1.le, hx.2.le⟩
    rcases hximage with ⟨z, hzsupport, hzx⟩
    rcases Set.mem_iUnion.mp (hray_cover hzsupport) with ⟨i, hzray⟩
    have hzne : z ≠ (0, 0) := by
      intro hzero
      have : x = 0 := by simpa [hzero] using hzx.symm
      exact (ne_of_gt hx.1) this
    have hmax : IsMaxOn
        (fun u : ℝ × ℝ =>
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) u.1 +
            AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) u.2 -
              twoUserInducedCost α β θ u.1 u.2)
        (canonicalTwoUserFeasibleValueSet θ) z :=
      canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
        hsin hnash hscore_ac z hzsupport
    have hformula :=
      deriv_secondReward_eq_scoreRpow_mul_finiteGenreSecondAngleLabel_of_isMaxOn_of_mem_canonicalGenreRay
        hmax hsin (hinterior z hzsupport hzne).1 (hinterior z hzsupport hzne).2
        (hderiv2 z hzsupport hzne)
        (Or.inl (twoUserInducedCostNumerator_ne_zero_of_ne_zero hsin.ne' hzne))
        (hcos_first i) (hcos_second i) hzray
    have hderiv_raw := hderiv2 z hzsupport hzne
    change HasDerivAt H2 (β * C2 * x ^ (β - 1)) x
    rw [← hzx]
    convert hderiv_raw using 1
    rw [hformula, hsecond_label i]
    dsimp [C2]
    ring
  change Set.EqOn H2 (fun x => C2 * x ^ β) (Set.Icc 0 B)
  exact AppliedModelingLib.RealAnalysis.eqOn_const_mul_rpow_of_hasDerivAt
    hβ hH2_cont.continuousOn hH2_zero hH2_deriv

/--
Take the `(P-1)`st root of the first user's maximum-score CDF power law and
rewrite the resulting raw-score CDF through the conditional two-genre radial
decomposition.  This is the first CDF-mixture power identity immediately
preceding the displayed density equations in `finitegenre`.
-/
theorem twoGenre_firstCdfMixture_eqOn_rpow_of_rewardPowerLaw
    {P : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta1 theta2 C β B : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hP : 1 < P) (hC : 0 ≤ C)
    (hcos1 : 0 < Real.cos theta1) (hcos2 : 0 < Real.cos theta2)
    (hreward : Set.EqOn
      (fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) z)
      (fun z => C * z ^ β) (Set.Icc 0 B)) :
    Set.EqOn
      (fun z =>
        law.weight1 * AppliedModelingLib.Probability.lowerCDFMass law.radial1
            (z / Real.cos theta1) +
          law.weight2 * AppliedModelingLib.Probability.lowerCDFMass law.radial2
            (z / Real.cos theta2))
      (fun z => C ^ (((P - 1 : ℕ) : ℝ)⁻¹) *
        z ^ (β / ((P - 1 : ℕ) : ℝ)))
      (Set.Icc 0 B) := by
  let mu1 : Measure ℝ :=
    Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu
  letI : IsProbabilityMeasure mu1 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  intro z hz
  change law.weight1 * AppliedModelingLib.Probability.lowerCDFMass law.radial1
          (z / Real.cos theta1) +
        law.weight2 * AppliedModelingLib.Probability.lowerCDFMass law.radial2
          (z / Real.cos theta2) =
      C ^ (((P - 1 : ℕ) : ℝ)⁻¹) * z ^ (β / ((P - 1 : ℕ) : ℝ))
  rw [← twoGenre_firstLowerCDFMass_eq law hcos1 hcos2]
  apply AppliedModelingLib.Probability.lowerCDFMass_eq_const_mul_rpow_of_iidMaximumCdf_eq
    (Nat.sub_ne_zero_iff_lt.mpr hP) hC hz.1
  simpa [mu1] using hreward hz

/--
The corresponding `(P-1)`st-root identity for the second user's raw-score
CDF.  Together with the preceding theorem it derives both mixture power laws
from the actual maximum-reward laws rather than assuming the paper's displayed
density equations.
-/
theorem twoGenre_secondCdfMixture_eqOn_rpow_of_rewardPowerLaw
    {P : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta theta1 theta2 C β B : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hP : 1 < P) (hC : 0 ≤ C)
    (hcos1 : 0 < Real.cos (theta - theta1))
    (hcos2 : 0 < Real.cos (theta - theta2))
    (hreward : Set.EqOn
      (fun z => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map
          (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) z)
      (fun z => C * z ^ β) (Set.Icc 0 B)) :
    Set.EqOn
      (fun z =>
        law.weight1 * AppliedModelingLib.Probability.lowerCDFMass law.radial1
            (z / Real.cos (theta - theta1)) +
          law.weight2 * AppliedModelingLib.Probability.lowerCDFMass law.radial2
            (z / Real.cos (theta - theta2)))
      (fun z => C ^ (((P - 1 : ℕ) : ℝ)⁻¹) *
        z ^ (β / ((P - 1 : ℕ) : ℝ)))
      (Set.Icc 0 B) := by
  let mu2 : Measure ℝ :=
    Measure.map
      (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu
  letI : IsProbabilityMeasure mu2 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond theta)).aemeasurable
  intro z hz
  change law.weight1 * AppliedModelingLib.Probability.lowerCDFMass law.radial1
          (z / Real.cos (theta - theta1)) +
        law.weight2 * AppliedModelingLib.Probability.lowerCDFMass law.radial2
          (z / Real.cos (theta - theta2)) =
      C ^ (((P - 1 : ℕ) : ℝ)⁻¹) * z ^ (β / ((P - 1 : ℕ) : ℝ))
  rw [← twoGenre_secondLowerCDFMass_eq law hcos1 hcos2]
  apply AppliedModelingLib.Probability.lowerCDFMass_eq_const_mul_rpow_of_iidMaximumCdf_eq
    (Nat.sub_ne_zero_iff_lt.mpr hP) hC hz.1
  simpa [mu2] using hreward hz

/--
Conditional two-genre CDF chain rule.  If the two genre-magnitude CDFs have
the displayed pointwise densities, rescaling their arguments by nonzero score
coefficients gives the density of their weighted mixture.  This is the left
side of the `density1` and `density2` displays in the finite-genre proof.
-/
theorem hasDerivAt_twoGenre_cdfMixture
    {F1 F2 f1 f2 : ℝ → ℝ} {α1 α2 c1 c2 z : ℝ}
    (hc1 : c1 ≠ 0) (hc2 : c2 ≠ 0)
    (hF1 : HasDerivAt F1 (f1 (z / c1)) (z / c1))
    (hF2 : HasDerivAt F2 (f2 (z / c2)) (z / c2)) :
    HasDerivAt (fun w => α1 * F1 (w / c1) + α2 * F2 (w / c2))
      (α1 / c1 * f1 (z / c1) + α2 / c2 * f2 (z / c2)) z := by
  have hdiv1 : HasDerivAt (fun w : ℝ => w / c1) (1 / c1) z := by
    simpa using (hasDerivAt_id z).div_const c1
  have hdiv2 : HasDerivAt (fun w : ℝ => w / c2) (1 / c2) z := by
    simpa using (hasDerivAt_id z).div_const c2
  have hcomp1 := hF1.comp z hdiv1
  have hcomp2 := hF2.comp z hdiv2
  have hsum := hcomp1.const_mul α1 |>.add (hcomp2.const_mul α2)
  convert hsum using 1
  field_simp [hc1, hc2]

/--
Conditional `density1`/`density2` differentiation step for `finitegenre`.
Near a positive score, an asserted two-genre CDF mixture identity with a power
right-hand side entails the corresponding density equality.  The local
identity and the two CDF differentiability facts are explicit: C1--C3 alone
do not supply them in the current source proof.
-/
theorem twoGenre_density_eq_of_eventuallyEq_rpow
    {F1 F2 f1 f2 : ℝ → ℝ} {α1 α2 c1 c2 C q z : ℝ}
    (hc1 : c1 ≠ 0) (hc2 : c2 ≠ 0) (hz : 0 < z)
    (hF1 : HasDerivAt F1 (f1 (z / c1)) (z / c1))
    (hF2 : HasDerivAt F2 (f2 (z / c2)) (z / c2))
    (heq : (fun w => α1 * F1 (w / c1) + α2 * F2 (w / c2)) =ᶠ[nhds z]
      fun w => C * w ^ q) :
    α1 / c1 * f1 (z / c1) + α2 / c2 * f2 (z / c2) =
      C * (q * z ^ (q - 1)) := by
  have hmixture := hasDerivAt_twoGenre_cdfMixture
    (α1 := α1) (α2 := α2) hc1 hc2 hF1 hF2
  have hpower : HasDerivAt (fun w : ℝ => C * w ^ q)
      (C * (q * z ^ (q - 1))) z :=
    (Real.hasDerivAt_rpow_const (x := z) (p := q) (Or.inl hz.ne')).const_mul C
  exact hmixture.unique (hpower.congr_of_eventuallyEq heq)

/--
Differentiate the first CDF-mixture power law derived from the actual
maximum-reward identity.  The two derivative hypotheses are discharged by the
paper's `C¹` conditional radial-CDF assumption, so the conclusion is precisely
the first displayed density equation rather than an additional premise.
-/
theorem twoGenre_firstDensity_eq_of_rewardPowerLaw
    {P : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta1 theta2 C β B z : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hP : 1 < P) (hC : 0 ≤ C)
    (hcos1 : 0 < Real.cos theta1) (hcos2 : 0 < Real.cos theta2)
    (hz : z ∈ Set.Ioo 0 B)
    (hreward : Set.EqOn
      (fun w => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun p : Content 2 => score canonicalTwoUserFirst p) mu) w)
      (fun w => C * w ^ β) (Set.Icc 0 B)) :
    law.weight1 / Real.cos theta1 *
          deriv (AppliedModelingLib.Probability.lowerCDFMass law.radial1)
            (z / Real.cos theta1) +
        law.weight2 / Real.cos theta2 *
          deriv (AppliedModelingLib.Probability.lowerCDFMass law.radial2)
            (z / Real.cos theta2) =
      C ^ (((P - 1 : ℕ) : ℝ)⁻¹) *
        (β / ((P - 1 : ℕ) : ℝ) *
          z ^ (β / ((P - 1 : ℕ) : ℝ) - 1)) := by
  let F1 := AppliedModelingLib.Probability.lowerCDFMass law.radial1
  let F2 := AppliedModelingLib.Probability.lowerCDFMass law.radial2
  have hF1 : HasDerivAt F1 (deriv F1 (z / Real.cos theta1))
      (z / Real.cos theta1) :=
    (law.radial1_cdf_c1.differentiable (by norm_num)).differentiableAt.hasDerivAt
  have hF2 : HasDerivAt F2 (deriv F2 (z / Real.cos theta2))
      (z / Real.cos theta2) :=
    (law.radial2_cdf_c1.differentiable (by norm_num)).differentiableAt.hasDerivAt
  have heqOn :=
    twoGenre_firstCdfMixture_eqOn_rpow_of_rewardPowerLaw
      law hP hC hcos1 hcos2 hreward
  have heq :
      (fun w => law.weight1 * F1 (w / Real.cos theta1) +
        law.weight2 * F2 (w / Real.cos theta2)) =ᶠ[nhds z]
      (fun w => C ^ (((P - 1 : ℕ) : ℝ)⁻¹) *
        w ^ (β / ((P - 1 : ℕ) : ℝ))) := by
    filter_upwards [isOpen_Ioo.mem_nhds hz] with w hw
    exact heqOn ⟨hw.1.le, hw.2.le⟩
  exact twoGenre_density_eq_of_eventuallyEq_rpow
    (F1 := F1) (F2 := F2) (f1 := deriv F1) (f2 := deriv F2)
    hcos1.ne' hcos2.ne' hz.1 hF1 hF2 heq

/--
The symmetric derivation of the second displayed density equation from the
second user's maximum-reward power law and the same two `C¹` conditional
radial CDFs.
-/
theorem twoGenre_secondDensity_eq_of_rewardPowerLaw
    {P : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {theta theta1 theta2 C β B z : ℝ}
    (law : TwoGenreConditionalNormLaw mu theta1 theta2)
    (hP : 1 < P) (hC : 0 ≤ C)
    (hcos1 : 0 < Real.cos (theta - theta1))
    (hcos2 : 0 < Real.cos (theta - theta2))
    (hz : z ∈ Set.Ioo 0 B)
    (hreward : Set.EqOn
      (fun w => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map
          (fun p : Content 2 => score (canonicalTwoUserSecond theta) p) mu) w)
      (fun w => C * w ^ β) (Set.Icc 0 B)) :
    law.weight1 / Real.cos (theta - theta1) *
          deriv (AppliedModelingLib.Probability.lowerCDFMass law.radial1)
            (z / Real.cos (theta - theta1)) +
        law.weight2 / Real.cos (theta - theta2) *
          deriv (AppliedModelingLib.Probability.lowerCDFMass law.radial2)
            (z / Real.cos (theta - theta2)) =
      C ^ (((P - 1 : ℕ) : ℝ)⁻¹) *
        (β / ((P - 1 : ℕ) : ℝ) *
          z ^ (β / ((P - 1 : ℕ) : ℝ) - 1)) := by
  let F1 := AppliedModelingLib.Probability.lowerCDFMass law.radial1
  let F2 := AppliedModelingLib.Probability.lowerCDFMass law.radial2
  have hF1 : HasDerivAt F1
      (deriv F1 (z / Real.cos (theta - theta1)))
      (z / Real.cos (theta - theta1)) :=
    (law.radial1_cdf_c1.differentiable (by norm_num)).differentiableAt.hasDerivAt
  have hF2 : HasDerivAt F2
      (deriv F2 (z / Real.cos (theta - theta2)))
      (z / Real.cos (theta - theta2)) :=
    (law.radial2_cdf_c1.differentiable (by norm_num)).differentiableAt.hasDerivAt
  have heqOn :=
    twoGenre_secondCdfMixture_eqOn_rpow_of_rewardPowerLaw
      law hP hC hcos1 hcos2 hreward
  have heq :
      (fun w => law.weight1 * F1 (w / Real.cos (theta - theta1)) +
        law.weight2 * F2 (w / Real.cos (theta - theta2))) =ᶠ[nhds z]
      (fun w => C ^ (((P - 1 : ℕ) : ℝ)⁻¹) *
        w ^ (β / ((P - 1 : ℕ) : ℝ))) := by
    filter_upwards [isOpen_Ioo.mem_nhds hz] with w hw
    exact heqOn ⟨hw.1.le, hw.2.le⟩
  exact twoGenre_density_eq_of_eventuallyEq_rpow
    (F1 := F1) (F2 := F2) (f1 := deriv F1) (f2 := deriv F2)
    hcos1.ne' hcos2.ne' hz.1 hF1 hF2 heq

/--
Rescaling the first conditional-density summand from the first user coordinate
to the second.  This is the exact power algebra used in Case 1 of the
finite-genre two-angle argument.
-/
theorem twoGenre_rescaled_density_term_eq
    {α c d C q z1 z2 : ℝ} {f : ℝ → ℝ}
    (hc : 0 < c) (hd : 0 < d) (hz2 : 0 < z2)
    (hzscale : z1 = z2 * (c / d))
    (hdensity : α / c * f (z1 / c) = C * q * z1 ^ (q - 1)) :
    α / d * f (z2 / d) =
      C * q * z2 ^ (q - 1) * (c / d) ^ q := by
  have hratio : 0 < c / d := div_pos hc hd
  have harg : z1 / c = z2 / d := by
    rw [hzscale]
    field_simp [hc.ne', hd.ne']
  calc
    α / d * f (z2 / d) = (c / d) * (α / c * f (z1 / c)) := by
      rw [harg]
      field_simp [hc.ne', hd.ne']
    _ = (c / d) * (C * q * z1 ^ (q - 1)) := by rw [hdensity]
    _ = (c / d) * (C * q * (z2 * (c / d)) ^ (q - 1)) := by rw [hzscale]
    _ = C * q * z2 ^ (q - 1) * (c / d) ^ q := by
      rw [Real.mul_rpow hz2.le hratio.le]
      have hpow : (c / d) ^ (q - 1) * (c / d) = (c / d) ^ q := by
        rw [← Real.rpow_add_one hratio.ne' (q - 1)]
        ring_nf
      calc
        (c / d) * (C * q * (z2 ^ (q - 1) * (c / d) ^ (q - 1))) =
            C * q * z2 ^ (q - 1) * ((c / d) ^ (q - 1) * (c / d)) := by ring
        _ = C * q * z2 ^ (q - 1) * (c / d) ^ q := by rw [hpow]

/-- The strict coefficient inequality that closes the first two-genre case. -/
theorem twoGenre_coefficient_lt_of_le_of_ratio_gt_one
    {C1 C2 r q : ℝ}
    (hC1 : 0 < C1) (hC : C2 ≤ C1) (hr : 1 < r) (hq : 0 < q) :
    C2 < C1 * r ^ q := by
  have hrpow : 1 < r ^ q := Real.one_lt_rpow hr hq
  have hC1_lt : C1 < C1 * r ^ q := by
    nlinarith [mul_pos hC1 (sub_pos.mpr hrpow)]
  exact hC.trans_lt hC1_lt

/--
Conditional algebraic contradiction for Case 1 in the source's two-genre
argument.  It makes explicit the selected score coordinates, zero outside the
other genre support, density nonnegativity, and coefficient comparison that
the prose uses.  Constructing those facts from C1--C3 remains separate.
-/
theorem twoGenre_caseOne_contradiction_of_density_equations
    {α1 α2 c1 c2 d1 d2 C1 C2 q z1 z2 : ℝ} {f1 f2 : ℝ → ℝ}
    (hc1 : 0 < c1) (hd1 : 0 < d1) (hz2 : 0 < z2)
    (hzscale : z1 = z2 * (c1 / d1))
    (hdensity1 :
      α1 / c1 * f1 (z1 / c1) + α2 / c2 * f2 (z1 / c2) =
        C1 * q * z1 ^ (q - 1))
    (hsecond_zero : f2 (z1 / c2) = 0)
    (hsecond_nonneg : 0 ≤ α2 / d2 * f2 (z2 / d2))
    (hdensity2 :
      α1 / d1 * f1 (z2 / d1) + α2 / d2 * f2 (z2 / d2) =
        C2 * q * z2 ^ (q - 1))
    (hq : 0 < q) (hC1 : 0 < C1) (hC : C2 ≤ C1) (hratio : 1 < c1 / d1) :
    False := by
  have hdensity1' : α1 / c1 * f1 (z1 / c1) = C1 * q * z1 ^ (q - 1) := by
    simpa [hsecond_zero] using hdensity1
  have hfirst : α1 / d1 * f1 (z2 / d1) =
      C1 * q * z2 ^ (q - 1) * (c1 / d1) ^ q :=
    twoGenre_rescaled_density_term_eq hc1 hd1 hz2 hzscale hdensity1'
  have hfirst_le :
      C1 * q * z2 ^ (q - 1) * (c1 / d1) ^ q ≤ C2 * q * z2 ^ (q - 1) := by
    calc
      C1 * q * z2 ^ (q - 1) * (c1 / d1) ^ q = α1 / d1 * f1 (z2 / d1) := hfirst.symm
      _ ≤ α1 / d1 * f1 (z2 / d1) + α2 / d2 * f2 (z2 / d2) :=
        le_add_of_nonneg_right hsecond_nonneg
      _ = C2 * q * z2 ^ (q - 1) := hdensity2
  have hcommon : 0 < q * z2 ^ (q - 1) :=
    mul_pos hq (Real.rpow_pos_of_pos hz2 _)
  have hfactor :
      (C1 * (c1 / d1) ^ q) * (q * z2 ^ (q - 1)) ≤
        C2 * (q * z2 ^ (q - 1)) := by
    convert hfirst_le using 1 <;> ring
  exact (not_lt_of_ge (le_of_mul_le_mul_right hfactor hcommon))
    (twoGenre_coefficient_lt_of_le_of_ratio_gt_one hC1 hC hratio hq)

/--
For a first genre angle strictly below the bisector, its first-user cosine
coefficient is strictly larger than its second-user cosine coefficient.  This
supplies the `c1 / d1 > 1` premise in the conditional Case-1 calculation.
-/
theorem cos_div_cos_sub_gt_one_of_lt_half
    {θ θstar : ℝ}
    (hθ_nonneg : 0 ≤ θ) (hθ_pos : 0 < θ)
    (hθ_lt : θ < θstar / 2) (hθstar_le : θstar ≤ Real.pi / 2) :
    1 < Real.cos θ / Real.cos (θstar - θ) := by
  have hdiff_pos : 0 < θstar - θ := by linarith
  have hdiff_le_pi : θstar - θ ≤ Real.pi := by
    nlinarith [Real.pi_pos]
  have hangle_lt : θ < θstar - θ := by linarith
  have hcos_lt : Real.cos (θstar - θ) < Real.cos θ :=
    Real.cos_lt_cos_of_nonneg_of_le_pi hθ_nonneg hdiff_le_pi hangle_lt
  have hdiff_lt_half_pi : θstar - θ < Real.pi / 2 := by
    linarith
  have hcos_pos : 0 < Real.cos (θstar - θ) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdiff_lt_half_pi⟩
  exact (one_lt_div₀ hcos_pos).2 hcos_lt

/--
Corrected Case-1 score selection.  A strict comparison of the scaled upper
caps yields a positive first-coordinate score below its own cap whose rescaled
second magnitude lies strictly above the other cap.  The final two conjuncts
record the corresponding first magnitude's strict interior location.
-/
theorem exists_twoGenre_caseOne_offCap_score
    {r1 r2 c1 c2 : ℝ}
    (hr2 : 0 ≤ r2) (hc1 : 0 < c1) (hc2 : 0 < c2)
    (hcap : r2 * c2 < r1 * c1) :
    ∃ z : ℝ,
      0 < z ∧ z < r1 * c1 ∧ r2 < z / c2 ∧
        0 < z / c1 ∧ z / c1 < r1 := by
  obtain ⟨z, hzlo, hzhi⟩ := exists_between hcap
  refine ⟨z, lt_of_le_of_lt (mul_nonneg hr2 hc2.le) hzlo, hzhi, ?_, ?_, ?_⟩
  · rw [lt_div_iff₀ hc2]
    simpa [mul_comm] using hzlo
  · exact div_pos (lt_of_le_of_lt (mul_nonneg hr2 hc2.le) hzlo) hc1
  · rw [div_lt_iff₀ hc1]
    simpa [mul_comm] using hzhi

/--
Case-1 paired score selection.  In addition to the off-second-cap first score,
the second strict scaled-cap inequality puts its rescaled counterpart strictly
inside the second range.  This is the complete scalar interval package needed
to evaluate the two displayed density equations at selected interior points.
-/
theorem exists_twoGenre_caseOne_score_pair
    {r1 r2 c1 c2 d1 d2 : ℝ}
    (hr2 : 0 ≤ r2) (hc1 : 0 < c1) (hc2 : 0 < c2)
    (hd1 : 0 < d1) (hd2 : 0 < d2)
    (hfirst_cap : r2 * c2 < r1 * c1)
    (hsecond_cap : r1 * d1 < r2 * d2) :
    ∃ z1 z2 : ℝ,
      0 < z1 ∧ z1 < r1 * c1 ∧ r2 < z1 / c2 ∧
        0 < z1 / c1 ∧ z1 / c1 < r1 ∧
        z2 = z1 * (d1 / c1) ∧ 0 < z2 ∧ z2 < r2 * d2 ∧
          0 < z2 / d2 ∧ z2 / d2 < r2 := by
  obtain ⟨z1, hz1_pos, hz1_cap, houtside, hz1_div_pos, hz1_div_cap⟩ :=
    exists_twoGenre_caseOne_offCap_score hr2 hc1 hc2 hfirst_cap
  let z2 : ℝ := z1 * (d1 / c1)
  have hratio_pos : 0 < d1 / c1 := div_pos hd1 hc1
  have hz2_pos : 0 < z2 := by
    exact mul_pos hz1_pos hratio_pos
  have hz2_cap : z2 < r2 * d2 := by
    calc
      z2 = z1 * (d1 / c1) := rfl
      _ < (r1 * c1) * (d1 / c1) :=
        mul_lt_mul_of_pos_right hz1_cap hratio_pos
      _ = r1 * d1 := by field_simp [hc1.ne']
      _ < r2 * d2 := hsecond_cap
  refine ⟨z1, z2, hz1_pos, hz1_cap, houtside, hz1_div_pos, hz1_div_cap,
    rfl, hz2_pos, hz2_cap, div_pos hz2_pos hd2, ?_⟩
  rw [div_lt_iff₀ hd2]
  simpa [mul_comm] using hz2_cap

/--
Conditional algebraic contradiction for Case 2 in the source's two-genre
argument.  A correct score-selection bridge must supply the rescaled first
coordinate and its pointwise density facts; the printed interval alone does
not do so.
-/
theorem twoGenre_caseTwo_contradiction_of_density_equations
    {α1 α2 c1 c2 d1 d2 C1 C2 q z1 z2 : ℝ} {f1 f2 : ℝ → ℝ}
    (hc2 : 0 < c2) (hd2 : 0 < d2) (hz1 : 0 < z1)
    (hzscale : z2 = z1 * (d2 / c2))
    (hdensity2 :
      α1 / d1 * f1 (z2 / d1) + α2 / d2 * f2 (z2 / d2) =
        C2 * q * z2 ^ (q - 1))
    (hfirst_zero : f1 (z2 / d1) = 0)
    (hfirst_nonneg : 0 ≤ α1 / c1 * f1 (z1 / c1))
    (hdensity1 :
      α1 / c1 * f1 (z1 / c1) + α2 / c2 * f2 (z1 / c2) =
        C1 * q * z1 ^ (q - 1))
    (hq : 0 < q) (hcoeff : C1 < C2 * (d2 / c2) ^ q) :
    False := by
  have hdensity2' : α2 / d2 * f2 (z2 / d2) = C2 * q * z2 ^ (q - 1) := by
    simpa [hfirst_zero] using hdensity2
  have hsecond : α2 / c2 * f2 (z1 / c2) =
      C2 * q * z1 ^ (q - 1) * (d2 / c2) ^ q :=
    twoGenre_rescaled_density_term_eq hd2 hc2 hz1 hzscale hdensity2'
  have hsecond_le :
      C2 * q * z1 ^ (q - 1) * (d2 / c2) ^ q ≤ C1 * q * z1 ^ (q - 1) := by
    calc
      C2 * q * z1 ^ (q - 1) * (d2 / c2) ^ q = α2 / c2 * f2 (z1 / c2) := hsecond.symm
      _ ≤ α1 / c1 * f1 (z1 / c1) + α2 / c2 * f2 (z1 / c2) := by linarith
      _ = C1 * q * z1 ^ (q - 1) := hdensity1
  have hcommon : 0 < q * z1 ^ (q - 1) :=
    mul_pos hq (Real.rpow_pos_of_pos hz1 _)
  have hfactor :
      (C2 * (d2 / c2) ^ q) * (q * z1 ^ (q - 1)) ≤
        C1 * (q * z1 ^ (q - 1)) := by
    convert hsecond_le using 1 <;> ring
  exact (not_lt_of_ge (le_of_mul_le_mul_right hfactor hcommon)) hcoeff

/--
The trigonometric strict inequality in the source's displayed `c1/c2`
calculation for Case 2.  It is valid on the explicit positive ordered-angle
domain and does not rely on the missing support selection.
-/
theorem twoGenre_source_coefficient_ratio_lt_cos_ratio_rpow
    {β θ θstar : ℝ}
    (hθ_pos : 0 < θ) (hdelta_pos : 0 < θstar - θ)
    (hdelta_lt : θstar - θ < θ) (hθ_lt_half_pi : θ < Real.pi / 2) :
    Real.sin (θstar - θ) / Real.sin θ *
        (Real.cos (θstar - θ)) ^ (β - 1) / (Real.cos θ) ^ (β - 1) <
      (Real.cos (θstar - θ) / Real.cos θ) ^ β := by
  have hdelta_lt_half_pi : θstar - θ < Real.pi / 2 :=
    hdelta_lt.trans hθ_lt_half_pi
  have hsin_theta_pos : 0 < Real.sin θ :=
    Real.sin_pos_of_pos_of_lt_pi hθ_pos (by linarith [Real.pi_pos])
  have hsin_delta_pos : 0 < Real.sin (θstar - θ) :=
    Real.sin_pos_of_pos_of_lt_pi hdelta_pos (by linarith [Real.pi_pos])
  have hcos_theta_pos : 0 < Real.cos θ :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ_lt_half_pi⟩
  have hcos_delta_pos : 0 < Real.cos (θstar - θ) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdelta_lt_half_pi⟩
  have htan_lt : Real.tan (θstar - θ) < Real.tan θ :=
    Real.tan_lt_tan_of_nonneg_of_lt_pi_div_two hdelta_pos.le hθ_lt_half_pi hdelta_lt
  have htan_ratio_lt_one : Real.tan (θstar - θ) / Real.tan θ < 1 := by
    rw [div_lt_iff₀ (Real.tan_pos_of_pos_of_lt_pi_div_two hθ_pos hθ_lt_half_pi)]
    simpa using htan_lt
  have hratio_pow_pos : 0 < (Real.cos (θstar - θ) / Real.cos θ) ^ β :=
    Real.rpow_pos_of_pos (div_pos hcos_delta_pos hcos_theta_pos) _
  have hmain := mul_lt_mul_of_pos_right htan_ratio_lt_one hratio_pow_pos
  have hid :
      Real.sin (θstar - θ) / Real.sin θ *
          (Real.cos (θstar - θ)) ^ (β - 1) / (Real.cos θ) ^ (β - 1) =
        (Real.tan (θstar - θ) / Real.tan θ) *
          (Real.cos (θstar - θ) / Real.cos θ) ^ β := by
    rw [Real.tan_eq_sin_div_cos, Real.tan_eq_sin_div_cos,
      Real.div_rpow hcos_delta_pos.le hcos_theta_pos.le β,
      Real.rpow_sub hcos_delta_pos β 1,
      Real.rpow_sub hcos_theta_pos β 1]
    field_simp [hsin_theta_pos.ne', hcos_theta_pos.ne', hcos_delta_pos.ne']
    simp only [Real.rpow_one]
    ring
  rw [hid]
  simpa using hmain

/-- Taking a positive power root preserves the source coefficient comparison. -/
theorem rpow_root_lt_of_div_lt_rpow
    {c1 c2 r β p : ℝ}
    (hc1 : 0 < c1) (hc2 : 0 < c2) (hr : 0 < r) (hp : 0 < p)
    (h : c1 / c2 < r ^ β) :
    c1 ^ (1 / p) < c2 ^ (1 / p) * r ^ (β / p) := by
  have hroot := Real.rpow_lt_rpow (div_nonneg hc1.le hc2.le) h (one_div_pos.mpr hp)
  have hc2root : 0 < c2 ^ (1 / p) := Real.rpow_pos_of_pos hc2 _
  have hroot' : c1 ^ (1 / p) / c2 ^ (1 / p) < r ^ (β / p) := by
    calc
      c1 ^ (1 / p) / c2 ^ (1 / p) = (c1 / c2) ^ (1 / p) :=
        (Real.div_rpow hc1.le hc2.le (1 / p)).symm
      _ < (r ^ β) ^ (1 / p) := hroot
      _ = r ^ (β / p) := by
        rw [← Real.rpow_mul hr.le]
        field_simp [hp.ne']
  rw [div_lt_iff₀ hc2root] at hroot'
  simpa [mul_comm] using hroot'

/--
The source's final Case-2 coefficient comparison, after taking the positive
`(P - 1)`-root used in its density equations.
-/
theorem twoGenre_caseTwo_root_coefficient_lt_of_source_formula
    {c1 c2 β p θ θstar : ℝ}
    (hc1 : 0 < c1) (hc2 : 0 < c2) (hp : 0 < p)
    (hθ_pos : 0 < θ) (hdelta_pos : 0 < θstar - θ)
    (hdelta_lt : θstar - θ < θ) (hθ_lt_half_pi : θ < Real.pi / 2)
    (hformula : c1 / c2 =
      Real.sin (θstar - θ) / Real.sin θ *
        (Real.cos (θstar - θ)) ^ (β - 1) / (Real.cos θ) ^ (β - 1)) :
    c1 ^ (1 / p) < c2 ^ (1 / p) *
      (Real.cos (θstar - θ) / Real.cos θ) ^ (β / p) := by
  have hratio_lt : c1 / c2 <
      (Real.cos (θstar - θ) / Real.cos θ) ^ β := by
    rw [hformula]
    exact twoGenre_source_coefficient_ratio_lt_cos_ratio_rpow
      hθ_pos hdelta_pos hdelta_lt hθ_lt_half_pi
  have hcos_theta_pos : 0 < Real.cos θ :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ_lt_half_pi⟩
  have hdelta_lt_half_pi : θstar - θ < Real.pi / 2 :=
    hdelta_lt.trans hθ_lt_half_pi
  have hcos_delta_pos : 0 < Real.cos (θstar - θ) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdelta_lt_half_pi⟩
  exact rpow_root_lt_of_div_lt_rpow hc1 hc2
    (div_pos hcos_delta_pos hcos_theta_pos) hp hratio_lt

/--
Corrected Case-2 score selection.  The source's printed interval supplies
only `a < b`; the additional explicit inequality `a < m * r` is what ensures
that a selected second-coordinate score rescales into the first support range.
-/
theorem exists_twoGenre_caseTwo_rescaled_score
    {a b m r : ℝ} (ha_nonneg : 0 ≤ a) (hr : 0 < r)
    (hab : a < b) (hamr : a < m * r) :
    ∃ z : ℝ, a < z ∧ z < b ∧ 0 < z / r ∧ z / r < m := by
  obtain ⟨z, haz, hzmin⟩ := exists_between (lt_min hab hamr)
  refine ⟨z, haz, hzmin.trans_le (min_le_left _ _), ?_, ?_⟩
  · exact div_pos (lt_of_le_of_lt ha_nonneg haz) hr
  · rw [div_lt_iff₀ hr]
    simpa [mul_comm] using hzmin.trans_le (min_le_right _ _)

/--
Case-2 paired score selection in radius-and-scale coordinates.  The selected
second score is strictly above the first radius cap after its `d1` rescaling,
but its `d2` rescaling is strictly inside the second range; the corresponding
first score is strictly inside the first range.
-/
theorem exists_twoGenre_caseTwo_score_pair
    {r1 r2 c1 c2 d1 d2 : ℝ}
    (hr1 : 0 ≤ r1) (hc1 : 0 < c1) (hc2 : 0 < c2)
    (hd1 : 0 < d1) (hd2 : 0 < d2)
    (hsecond_cap : r1 * d1 < r2 * d2)
    (hfirst_interior : r1 * d1 < (r1 * c1) * (d2 / c2)) :
    ∃ z1 z2 : ℝ,
      z2 = z1 * (d2 / c2) ∧
        0 < z1 ∧ 0 < z1 / c1 ∧ z1 / c1 < r1 ∧
          0 < z2 ∧ r1 < z2 / d1 ∧ 0 < z2 / d2 ∧ z2 / d2 < r2 := by
  have hratio : 0 < d2 / c2 := div_pos hd2 hc2
  obtain ⟨z2, hz2_lower, hz2_upper, hz1_pos, hz1_cap⟩ :=
    exists_twoGenre_caseTwo_rescaled_score
      (mul_nonneg hr1 hd1.le) hratio hsecond_cap hfirst_interior
  let z1 : ℝ := z2 / (d2 / c2)
  have hz2_pos : 0 < z2 :=
    lt_of_le_of_lt (mul_nonneg hr1 hd1.le) hz2_lower
  have hz1_div_cap : z1 / c1 < r1 := by
    rw [div_lt_iff₀ hc1]
    simpa [z1] using hz1_cap
  have hzscale : z2 = z1 * (d2 / c2) := by
    dsimp [z1]
    field_simp [hc2.ne', hd2.ne']
  refine ⟨z1, z2, hzscale, hz1_pos, div_pos hz1_pos hc1, hz1_div_cap,
    hz2_pos, ?_, div_pos hz2_pos hd2, ?_⟩
  · rw [lt_div_iff₀ hd1]
    exact hz2_lower
  · rw [div_lt_iff₀ hd2]
    exact hz2_upper

/-- The endpoint inequality needed by the corrected Case-2 score selection. -/
theorem twoGenre_caseTwo_lower_lt_first_cap_scaled
    {rmax d1 c1 d2 c2 : ℝ}
    (hrmax : 0 < rmax) (hc1 : 0 < c1)
    (hfirst : d1 / c1 < 1) (hsecond : 1 < d2 / c2) :
    rmax * d1 < (rmax * c1) * (d2 / c2) := by
  have hratio : d1 / c1 < d2 / c2 := hfirst.trans hsecond
  have hbase : d1 < c1 * (d2 / c2) := by
    rw [div_lt_iff₀ hc1] at hratio
    simpa [mul_comm] using hratio
  calc
    rmax * d1 < rmax * (c1 * (d2 / c2)) := mul_lt_mul_of_pos_left hbase hrmax
    _ = (rmax * c1) * (d2 / c2) := by ring

/-- The two cosine-ratio inequalities needed for corrected Case-2 selection. -/
theorem twoGenre_caseTwo_cos_ratio_bounds_of_angles
    {θ1 θ2 θstar : ℝ}
    (hθ1_pos : 0 < θ1) (hθ1_lt : θ1 < θstar / 2)
    (hθ2_lt_star : θ2 < θstar) (hhalf_lt_θ2 : θstar / 2 < θ2)
    (hθstar_le : θstar ≤ Real.pi / 2) :
    Real.cos (θstar - θ1) / Real.cos θ1 < 1 ∧
      1 < Real.cos (θstar - θ2) / Real.cos θ2 := by
  have hdelta1_lt : θ1 < θstar - θ1 := by linarith
  have hdelta1_le_pi : θstar - θ1 ≤ Real.pi := by
    nlinarith [Real.pi_pos]
  have hcosdelta1_lt : Real.cos (θstar - θ1) < Real.cos θ1 :=
    Real.cos_lt_cos_of_nonneg_of_le_pi hθ1_pos.le hdelta1_le_pi hdelta1_lt
  have hθ1_lt_half_pi : θ1 < Real.pi / 2 := by linarith
  have hcosθ1_pos : 0 < Real.cos θ1 :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ1_lt_half_pi⟩
  constructor
  · exact (div_lt_one₀ hcosθ1_pos).2 hcosdelta1_lt
  · have hdelta2_pos : 0 < θstar - θ2 := sub_pos.mpr hθ2_lt_star
    have htheta2_le_pi : θ2 ≤ Real.pi := by
      nlinarith [Real.pi_pos]
    have hdelta2_lt : θstar - θ2 < θ2 := by linarith
    have hcosθ2_lt : Real.cos θ2 < Real.cos (θstar - θ2) :=
      Real.cos_lt_cos_of_nonneg_of_le_pi hdelta2_pos.le htheta2_le_pi hdelta2_lt
    have hθ2_lt_half_pi : θ2 < Real.pi / 2 := by linarith
    have hcosθ2_pos : 0 < Real.cos θ2 :=
      Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ2_lt_half_pi⟩
    exact (one_lt_div₀ hcosθ2_pos).2 hcosθ2_lt

/--
Corrected Case-2 interval selection under the source's ordered interior-angle
configuration.  Given the strict endpoint relation, it selects a score in the
second range whose rescaling lies strictly in the first range.
-/
theorem exists_twoGenre_caseTwo_rescaled_angle_score
    {r1 b θ1 θ2 θstar : ℝ}
    (hr1 : 0 < r1) (hθ1_pos : 0 < θ1) (hθ1_lt : θ1 < θstar / 2)
    (hθ2_lt_star : θ2 < θstar) (hhalf_lt_θ2 : θstar / 2 < θ2)
    (hθstar_le : θstar ≤ Real.pi / 2)
    (hupper : r1 * Real.cos (θstar - θ1) < b) :
    ∃ z : ℝ,
      r1 * Real.cos (θstar - θ1) < z ∧ z < b ∧
        0 < z / (Real.cos (θstar - θ2) / Real.cos θ2) ∧
        z / (Real.cos (θstar - θ2) / Real.cos θ2) < r1 * Real.cos θ1 := by
  obtain ⟨hfirst, hsecond⟩ := twoGenre_caseTwo_cos_ratio_bounds_of_angles
    hθ1_pos hθ1_lt hθ2_lt_star hhalf_lt_θ2 hθstar_le
  have hθ1_lt_half_pi : θ1 < Real.pi / 2 := by linarith
  have hcosθ1_pos : 0 < Real.cos θ1 :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ1_lt_half_pi⟩
  have hdelta1_pos : 0 < θstar - θ1 := by linarith
  have hdelta1_lt_half_pi : θstar - θ1 < Real.pi / 2 := by linarith
  have hcosdelta1_pos : 0 < Real.cos (θstar - θ1) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdelta1_lt_half_pi⟩
  have hθ2_lt_half_pi : θ2 < Real.pi / 2 := by linarith
  have hcosθ2_pos : 0 < Real.cos θ2 :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ2_lt_half_pi⟩
  have hdelta2_pos : 0 < θstar - θ2 := sub_pos.mpr hθ2_lt_star
  have hdelta2_lt_half_pi : θstar - θ2 < Real.pi / 2 := by
    linarith
  have hcosdelta2_pos : 0 < Real.cos (θstar - θ2) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hdelta2_lt_half_pi⟩
  have hendpoint :
      r1 * Real.cos (θstar - θ1) <
        (r1 * Real.cos θ1) *
          (Real.cos (θstar - θ2) / Real.cos θ2) :=
    twoGenre_caseTwo_lower_lt_first_cap_scaled hr1 hcosθ1_pos hfirst hsecond
  exact exists_twoGenre_caseTwo_rescaled_score
    (mul_nonneg hr1.le hcosdelta1_pos.le)
    (div_pos hcosdelta2_pos hcosθ2_pos) hupper hendpoint

/--
Case-1 density contradiction with the zero-density fact obtained from a
locally constant conditional CDF rather than assumed directly.  The local CDF
constancy and pointwise derivative are retained as explicit premises.
-/
theorem twoGenre_caseOne_contradiction_of_density_equations_of_cdf_eventuallyEq_const
    {F2 f1 f2 : ℝ → ℝ} {α1 α2 c1 c2 d1 d2 C1 C2 q z1 z2 tail : ℝ}
    (hc1 : 0 < c1) (hd1 : 0 < d1) (hz2 : 0 < z2)
    (hzscale : z1 = z2 * (c1 / d1))
    (hdensity1 :
      α1 / c1 * f1 (z1 / c1) + α2 / c2 * f2 (z1 / c2) =
        C1 * q * z1 ^ (q - 1))
    (hF2 : HasDerivAt F2 (f2 (z1 / c2)) (z1 / c2))
    (hF2_const : F2 =ᶠ[nhds (z1 / c2)] fun _ => tail)
    (hsecond_nonneg : 0 ≤ α2 / d2 * f2 (z2 / d2))
    (hdensity2 :
      α1 / d1 * f1 (z2 / d1) + α2 / d2 * f2 (z2 / d2) =
        C2 * q * z2 ^ (q - 1))
    (hq : 0 < q) (hC1 : 0 < C1) (hC : C2 ≤ C1) (hratio : 1 < c1 / d1) :
    False := by
  apply twoGenre_caseOne_contradiction_of_density_equations hc1 hd1 hz2 hzscale
    hdensity1
  · exact AppliedModelingLib.RealAnalysis.hasDerivAt_eq_zero_of_eventuallyEq_const hF2 hF2_const
  · exact hsecond_nonneg
  · exact hdensity2
  · exact hq
  · exact hC1
  · exact hC
  · exact hratio

/--
Case-1 density contradiction when the selected second-coordinate CDF is the
lower CDF of a probability law with an explicit closed upper support bound.
The support bound gives local CDF constancy strictly above the cap; the
pointwise derivative of the chosen density representative remains explicit.
-/
theorem twoGenre_caseOne_contradiction_of_density_equations_of_cdf_support
    {F2 f1 f2 : ℝ → ℝ} {μ2 : MeasureTheory.Measure ℝ}
    [MeasureTheory.IsProbabilityMeasure μ2]
    {α1 α2 c1 c2 d1 d2 C1 C2 q z1 z2 r2 : ℝ}
    (hc1 : 0 < c1) (hd1 : 0 < d1) (hz2 : 0 < z2)
    (hzscale : z1 = z2 * (c1 / d1))
    (hdensity1 :
      α1 / c1 * f1 (z1 / c1) + α2 / c2 * f2 (z1 / c2) =
        C1 * q * z1 ^ (q - 1))
    (hF2 : F2 = AppliedModelingLib.Probability.lowerCDFMass μ2)
    (hsupp2 : μ2.support ⊆ Set.Iic r2)
    (houtside : r2 < z1 / c2)
    (hF2_deriv : HasDerivAt F2 (f2 (z1 / c2)) (z1 / c2))
    (hsecond_nonneg : 0 ≤ α2 / d2 * f2 (z2 / d2))
    (hdensity2 :
      α1 / d1 * f1 (z2 / d1) + α2 / d2 * f2 (z2 / d2) =
        C2 * q * z2 ^ (q - 1))
    (hq : 0 < q) (hC1 : 0 < C1) (hC : C2 ≤ C1) (hratio : 1 < c1 / d1) :
    False := by
  apply twoGenre_caseOne_contradiction_of_density_equations_of_cdf_eventuallyEq_const
    hc1 hd1 hz2 hzscale hdensity1 hF2_deriv
  · rw [hF2]
    exact AppliedModelingLib.Probability.lowerCDFMass_eventuallyEq_one_of_support_subset_Iic
      μ2 hsupp2 houtside
  · exact hsecond_nonneg
  · exact hdensity2
  · exact hq
  · exact hC1
  · exact hC
  · exact hratio

/--
Case-2 density contradiction when the selected first-coordinate CDF is the
lower CDF of a probability law with an explicit closed upper support bound.
As in Case 1, only local CDF constancy is derived from the support cap; the
pointwise derivative of the selected density representative is explicit.
-/
theorem twoGenre_caseTwo_contradiction_of_density_equations_of_cdf_support
    {F1 f1 f2 : ℝ → ℝ} {μ1 : MeasureTheory.Measure ℝ}
    [MeasureTheory.IsProbabilityMeasure μ1]
    {α1 α2 c1 c2 d1 d2 C1 C2 q z1 z2 r1 : ℝ}
    (hc2 : 0 < c2) (hd2 : 0 < d2) (hz1 : 0 < z1)
    (hzscale : z2 = z1 * (d2 / c2))
    (hdensity2 :
      α1 / d1 * f1 (z2 / d1) + α2 / d2 * f2 (z2 / d2) =
        C2 * q * z2 ^ (q - 1))
    (hF1 : F1 = AppliedModelingLib.Probability.lowerCDFMass μ1)
    (hsupp1 : μ1.support ⊆ Set.Iic r1)
    (houtside : r1 < z2 / d1)
    (hF1_deriv : HasDerivAt F1 (f1 (z2 / d1)) (z2 / d1))
    (hfirst_nonneg : 0 ≤ α1 / c1 * f1 (z1 / c1))
    (hdensity1 :
      α1 / c1 * f1 (z1 / c1) + α2 / c2 * f2 (z1 / c2) =
        C1 * q * z1 ^ (q - 1))
    (hq : 0 < q) (hcoeff : C1 < C2 * (d2 / c2) ^ q) :
    False := by
  apply twoGenre_caseTwo_contradiction_of_density_equations hc2 hd2 hz1 hzscale
    hdensity2
  · apply AppliedModelingLib.RealAnalysis.hasDerivAt_eq_zero_of_eventuallyEq_const hF1_deriv
    rw [hF1]
    exact AppliedModelingLib.Probability.lowerCDFMass_eventuallyEq_one_of_support_subset_Iic
      μ1 hsupp1 houtside
  · exact hfirst_nonneg
  · exact hdensity1
  · exact hq
  · exact hcoeff

/--
Case-1 support-cap contradiction using the canonical totalized CDF derivative
as the selected density representative.  The density equations are still
explicit hypotheses; only their off-cap zero term follows automatically from
local CDF constancy.
-/
theorem twoGenre_caseOne_contradiction_of_cdf_support_deriv
    {F2 f1 : ℝ → ℝ} {μ2 : MeasureTheory.Measure ℝ}
    [MeasureTheory.IsProbabilityMeasure μ2]
    {α1 α2 c1 c2 d1 d2 C1 C2 q z1 z2 r2 : ℝ}
    (hc1 : 0 < c1) (hd1 : 0 < d1) (hz2 : 0 < z2)
    (hzscale : z1 = z2 * (c1 / d1))
    (hdensity1 :
      α1 / c1 * f1 (z1 / c1) + α2 / c2 * deriv F2 (z1 / c2) =
        C1 * q * z1 ^ (q - 1))
    (hF2 : F2 = AppliedModelingLib.Probability.lowerCDFMass μ2)
    (hsupp2 : μ2.support ⊆ Set.Iic r2)
    (houtside : r2 < z1 / c2)
