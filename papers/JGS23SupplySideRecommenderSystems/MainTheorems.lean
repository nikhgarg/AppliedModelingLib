/--
Event that all sampled opposing producers draw the same content vector `p`.
The source proof of Proposition `atom` uses this event when `p` is an atom.
-/
def AllOpponentsDrawContent {D K : ℕ} (p : Content D) :
    Set (Fin K → Content D) :=
  Set.pi Set.univ (fun _ : Fin K => ({p} : Set (Content D)))

/--
Product-measure probability of the all-atom event: if each opposing producer
draws independently from `μ`, the probability that all `K` opponents draw `p`
is `μ({p})^K`.
-/
theorem measure_allOpponentsDrawContent_eq_pow
    {D K : ℕ} {μ : MixedContentStrategy D}
    [MeasureTheory.SigmaFinite μ] (p : Content D) :
    MeasureTheory.Measure.pi (fun _ : Fin K => μ)
        (AllOpponentsDrawContent (K := K) p) =
      μ ({p} : Set (Content D)) ^ K := by
  simp [AllOpponentsDrawContent, MeasureTheory.Measure.pi_pi]

/--
Real-valued version of the all-atom event probability for finite mixed
strategies.
-/
theorem measureReal_allOpponentsDrawContent_eq_pow
    {D K : ℕ} {μ : MixedContentStrategy D}
    [MeasureTheory.IsFiniteMeasure μ] (p : Content D) :
    (MeasureTheory.Measure.pi (fun _ : Fin K => μ)).real
        (AllOpponentsDrawContent (K := K) p) =
      (μ.real ({p} : Set (Content D))) ^ K := by
  rw [MeasureTheory.Measure.real,
    measure_allOpponentsDrawContent_eq_pow (K := K) (μ := μ) p]
  simp [MeasureTheory.Measure.real]

/-- Two content vectors have the same genre if one is a scalar multiple of the other. -/
def SameGenre {D : ℕ} (p q : Content D) : Prop :=
  ∃ scale : ℝ, 0 < scale ∧ p = fun d => scale * q d

theorem sameGenre_refl {D : ℕ} {p : Content D} :
    SameGenre p p := by
  refine ⟨1, by norm_num, ?_⟩
  ext d
  ring

/-- Pure-profile analogue of the source "single genre" condition. -/
def PureSingleGenre {D P : ℕ} (profile : Fin P → Content D) : Prop :=
  ∃ genre : Content D, ∀ j : Fin P, SameGenre (profile j) genre

/--
Raw interior formula from source Lemma `cdf`:
`(r^β / N)^(1/(P-1))`.
-/
noncomputable def singleGenreCdfRaw (N P : ℕ) (β r : ℝ) : ℝ :=
  ((r ^ β) / (N : ℝ)) ^ (((P : ℝ) - 1)⁻¹)

/--
Source Lemma `cdf` formula, clipped at one:
`F(r) = min(1, (r^β / N)^(1/(P-1)))`.
-/
noncomputable def singleGenreCdf (N P : ℕ) (β r : ℝ) : ℝ :=
  min 1 (singleGenreCdfRaw N P β r)

/--
The one-population quality law behind source Lemma `cdf`: uniform mass on the
unit interval, transformed by the inverse CDF power.  The general
single-genre construction scales this law by its support cap and along the
candidate genre direction.
-/
noncomputable def onePopulationSingleGenreQualityLaw (P : ℕ) (β : ℝ) :
    Measure ℝ :=
  AppliedModelingLib.Probability.unitIntervalPowerLaw (((P : ℝ) - 1) / β)

theorem onePopulationSingleGenreQualityLaw_isProbabilityMeasure
    (P : ℕ) (β : ℝ) :
    MeasureTheory.IsProbabilityMeasure (onePopulationSingleGenreQualityLaw P β) :=
  AppliedModelingLib.Probability.unitIntervalPowerLaw_isProbabilityMeasure _

/--
On its unit support, the one-population quality law has the power CDF in
Lemma `cdf`.  The exponent identity is recorded explicitly because it is the
measure-theoretic bridge from the inverse-transform sampler to the paper's
displayed formula.
-/
theorem onePopulationSingleGenreQualityLaw_cdf_on_unitInterval
    {P : ℕ} [Nontrivial (Fin P)] {β z : ℝ}
    (hβ : 0 < β) (hz : z ∈ Set.Icc (0 : ℝ) 1) :
    onePopulationSingleGenreQualityLaw P β (Set.Iic z) =
      ENNReal.ofReal (z ^ (β / ((P : ℝ) - 1))) := by
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    have hP_real : (1 : ℝ) < P := by exact_mod_cast hP_nat
    linarith
  have ha : 0 < ((P : ℝ) - 1) / β := div_pos hP_sub_pos hβ
  rw [onePopulationSingleGenreQualityLaw,
    AppliedModelingLib.Probability.unitIntervalPowerLaw_cdf_on_unitInterval ha hz]
  congr 2
  have hinv : (((P : ℝ) - 1) / β)⁻¹ = β / ((P : ℝ) - 1) := by
    field_simp [ne_of_gt hβ, ne_of_gt hP_sub_pos]
  rw [hinv]

/--
The concrete one-population quality law realizes the paper's clipped CDF on
the unit support.  This is the first source-to-measure bridge for the
single-genre construction.
-/
theorem onePopulationSingleGenreQualityLaw_cdf_eq_singleGenreCdf_on_unitInterval
    {P : ℕ} [Nontrivial (Fin P)] {β z : ℝ}
    (hβ : 0 < β) (hz : z ∈ Set.Icc (0 : ℝ) 1) :
    onePopulationSingleGenreQualityLaw P β (Set.Iic z) =
      ENNReal.ofReal (singleGenreCdf 1 P β z) := by
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    have hP_real : (1 : ℝ) < P := by exact_mod_cast hP_nat
    linarith
  have hinv_nonneg : 0 ≤ ((P : ℝ) - 1)⁻¹ :=
    inv_nonneg.mpr hP_sub_pos.le
  have hbase_nonneg : 0 ≤ z ^ β := Real.rpow_nonneg hz.1 β
  have hbase_le_one : z ^ β ≤ 1 :=
    Real.rpow_le_one hz.1 hz.2 hβ.le
  have hraw_le_one :
      (z ^ β / (1 : ℝ)) ^ (((P : ℝ) - 1)⁻¹) ≤ 1 := by
    simpa using Real.rpow_le_one hbase_nonneg hbase_le_one hinv_nonneg
  have hformula : singleGenreCdf 1 P β z = z ^ (β / ((P : ℝ) - 1)) := by
    unfold singleGenreCdf singleGenreCdfRaw
    norm_num at hraw_le_one ⊢
    rw [min_eq_right hraw_le_one]
    rw [← Real.rpow_mul hz.1]
    congr 1
  rw [onePopulationSingleGenreQualityLaw_cdf_on_unitInterval hβ hz, hformula]

/--
Inverse-transform sampler for the general Lemma `cdf` support cap
`N^(1 / beta)`.  It is separated from the content-direction transport so the
probability construction can be reused independently of the geometry.
-/
noncomputable def singleGenreQualitySample (N P : ℕ) (β : ℝ) (u : I) : ℝ :=
  (N : ℝ) ^ β⁻¹ *
    AppliedModelingLib.Probability.unitIntervalPowerSample (((P : ℝ) - 1) / β) u

/-- The concrete quality law on the source support interval. -/
noncomputable def singleGenreQualityLaw (N P : ℕ) (β : ℝ) : Measure ℝ :=
  Measure.map (singleGenreQualitySample N P β) (volume : Measure I)

theorem singleGenreQualitySample_measurable (N P : ℕ) (β : ℝ) :
    Measurable (singleGenreQualitySample N P β) := by
  unfold singleGenreQualitySample
  exact measurable_const.mul
    (AppliedModelingLib.Probability.unitIntervalPowerSample_measurable _)

theorem singleGenreQualityLaw_isProbabilityMeasure (N P : ℕ) (β : ℝ) :
    MeasureTheory.IsProbabilityMeasure (singleGenreQualityLaw N P β) := by
  unfold singleGenreQualityLaw
  exact MeasureTheory.Measure.isProbabilityMeasure_map
    (singleGenreQualitySample_measurable N P β).aemeasurable

theorem singleGenreQualitySample_nonnegative (N P : ℕ) (β : ℝ) (u : I) :
    0 ≤ singleGenreQualitySample N P β u := by
  unfold singleGenreQualitySample
  exact mul_nonneg (Real.rpow_nonneg (Nat.cast_nonneg N) _)
    (AppliedModelingLib.Probability.unitIntervalPowerSample_nonnegative _ u)

theorem singleGenreQualitySample_injOn
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)] {β : ℝ}
    (hβ : 0 < β) :
    Set.InjOn (singleGenreQualitySample N P β) Set.univ := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hcap_pos : 0 < (N : ℝ) ^ β⁻¹ :=
    Real.rpow_pos_of_pos hN_pos _
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    have hP_real : (1 : ℝ) < P := by exact_mod_cast hP_nat
    linarith
  have ha : 0 < ((P : ℝ) - 1) / β := div_pos hP_sub_pos hβ
  intro x _ y _ hxy
  apply AppliedModelingLib.Probability.unitIntervalPowerSample_injOn ha
    (Set.mem_univ _) (Set.mem_univ _)
  apply mul_left_cancel₀ (ne_of_gt hcap_pos)
  simpa [singleGenreQualitySample] using hxy

/-- The scalar single-genre quality law has no atoms under the source regime. -/
theorem singleGenreQualityLaw_noAtoms
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)] {β : ℝ}
    (hβ : 0 < β) :
    MeasureTheory.NoAtoms (singleGenreQualityLaw N P β) := by
  refine ⟨?_⟩
  intro z
  rw [singleGenreQualityLaw,
    Measure.map_apply (singleGenreQualitySample_measurable N P β)
      (measurableSet_singleton z)]
  have hsubsingleton :
      (singleGenreQualitySample N P β ⁻¹' ({z} : Set ℝ)).Subsingleton := by
    intro x hx y hy
    apply singleGenreQualitySample_injOn (N := N) (P := P)
      hβ (Set.mem_univ _) (Set.mem_univ _)
    exact (Set.mem_singleton_iff.mp hx).trans (Set.mem_singleton_iff.mp hy).symm
  exact hsubsingleton.measure_zero (volume : Measure I)

/-- Every sampled quality lies below the source support cap. -/
theorem singleGenreQualitySample_le_supportCap
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)] {β : ℝ}
    (hβ : 0 < β) (u : I) :
    singleGenreQualitySample N P β u ≤ (N : ℝ) ^ β⁻¹ := by
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    have hP_real : (1 : ℝ) < P := by exact_mod_cast hP_nat
    linarith
  have ha : 0 ≤ ((P : ℝ) - 1) / β := (div_pos hP_sub_pos hβ).le
  have hpower_le_one :
      AppliedModelingLib.Probability.unitIntervalPowerSample (((P : ℝ) - 1) / β) u ≤ 1 :=
    AppliedModelingLib.Probability.unitIntervalPowerSample_le_one ha u
  unfold singleGenreQualitySample
  calc
    (N : ℝ) ^ β⁻¹ *
        AppliedModelingLib.Probability.unitIntervalPowerSample (((P : ℝ) - 1) / β) u ≤
        (N : ℝ) ^ β⁻¹ * 1 :=
      mul_le_mul_of_nonneg_left hpower_le_one
        (Real.rpow_nonneg (Nat.cast_nonneg N) _)
    _ = (N : ℝ) ^ β⁻¹ := mul_one _

theorem singleGenreQualitySample_continuous
    {N P : ℕ} [Nontrivial (Fin P)] {β : ℝ}
    (hβ : 0 < β) :
    Continuous (singleGenreQualitySample N P β) := by
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    have hP_real : (1 : ℝ) < P := by exact_mod_cast hP_nat
    linarith
  have ha : 0 ≤ ((P : ℝ) - 1) / β :=
    (div_pos hP_sub_pos hβ).le
  unfold singleGenreQualitySample
  exact continuous_const.mul
    (AppliedModelingLib.Probability.unitIntervalPowerSample_continuous ha)

/--
Transport the scalar single-genre quality sampler along a candidate content
direction.  This is the paper's `q p^*` construction before imposing the
unit-norm and equilibrium-direction hypotheses on `genre`.
-/
noncomputable def singleGenreContentSample
    {D : ℕ} (N P : ℕ) (β : ℝ) (genre : Content D) (u : I) : Content D :=
  scaleContent (singleGenreQualitySample N P β u) genre

/-- The concrete content law induced by the single-genre inverse transform. -/
noncomputable def singleGenreContentLaw
    {D : ℕ} (N P : ℕ) (β : ℝ) (genre : Content D) : Measure (Content D) :=
  Measure.map (singleGenreContentSample N P β genre) (volume : Measure I)

theorem singleGenreContentSample_measurable
    {D : ℕ} (N P : ℕ) (β : ℝ) (genre : Content D) :
    Measurable (singleGenreContentSample N P β genre) := by
  rw [measurable_pi_iff]
  intro d
  change Measurable (fun u : I =>
    singleGenreQualitySample N P β u * genre d)
  exact (singleGenreQualitySample_measurable N P β).mul measurable_const

theorem singleGenreContentSample_continuous
    {D N P : ℕ} {β : ℝ} (genre : Content D)
    [Nontrivial (Fin P)] (hβ : 0 < β) :
    Continuous (singleGenreContentSample N P β genre) := by
  rw [continuous_pi_iff]
  intro d
  change Continuous (fun u : I =>
    singleGenreQualitySample N P β u * genre d)
  exact (singleGenreQualitySample_continuous hβ).mul continuous_const

theorem singleGenreContentLaw_isProbabilityMeasure
    {D : ℕ} (N P : ℕ) (β : ℝ) (genre : Content D) :
    MeasureTheory.IsProbabilityMeasure (singleGenreContentLaw N P β genre) := by
  unfold singleGenreContentLaw
  exact MeasureTheory.Measure.isProbabilityMeasure_map
    (singleGenreContentSample_measurable N P β genre).aemeasurable

/-- A nonnegative genre gives an almost-everywhere feasible source action law. -/
theorem singleGenreContentLaw_ae_nonnegative
    {D : ℕ} {N P : ℕ} {β : ℝ} {genre : Content D}
    (hgenre : NonnegativeContent genre) :
    ∀ᵐ p ∂singleGenreContentLaw N P β genre, NonnegativeContent p := by
  have hnonnegative_meas :
      MeasurableSet {p : Content D | NonnegativeContent p} := by
    have hset : {p : Content D | NonnegativeContent p} =
        ⋂ d : Fin D, {p : Content D | 0 ≤ p d} := by
      ext p
      simp only [Set.mem_setOf_eq, Set.mem_iInter, NonnegativeContent]
    rw [hset]
    exact MeasurableSet.iInter (fun d =>
      measurableSet_Ici.preimage (measurable_pi_apply d))
  unfold singleGenreContentLaw
  rw [ae_map_iff (singleGenreContentSample_measurable N P β genre).aemeasurable
    hnonnegative_meas]
  exact Filter.Eventually.of_forall (fun u =>
    scaleContent_nonnegative (singleGenreQualitySample_nonnegative N P β u) hgenre)

/-- The topological support of the concrete ray law lies in its sampler range. -/
theorem singleGenreContentLaw_support_subset_range
    {D N P : ℕ} [Nontrivial (Fin P)] {β : ℝ} (genre : Content D)
    (hβ : 0 < β) :
    (singleGenreContentLaw N P β genre).support ⊆
      Set.range (singleGenreContentSample N P β genre) := by
  have hclosed : IsClosed (Set.range (singleGenreContentSample N P β genre)) := by
    have hcompact : IsCompact (Set.range (singleGenreContentSample N P β genre)) := by
      simpa only [Set.image_univ] using
        (isCompact_univ.image (singleGenreContentSample_continuous genre hβ))
    exact hcompact.isClosed
  apply MeasureTheory.Measure.support_subset_of_isClosed hclosed
  unfold singleGenreContentLaw
  change ∀ᵐ p ∂Measure.map (singleGenreContentSample N P β genre)
    (volume : Measure I), p ∈ Set.range (singleGenreContentSample N P β genre)
  refine (ae_map_iff (μ := (volume : Measure I))
    (f := singleGenreContentSample N P β genre)
    (singleGenreContentSample_measurable N P β genre).aemeasurable
    hclosed.measurableSet).mpr ?_
  exact Filter.Eventually.of_forall (fun u => ⟨u, rfl⟩)

/-- Every sampler value lies in the topological support of the ray law. -/
theorem singleGenreContentSample_mem_support
    {D N P : ℕ} [Nontrivial (Fin P)] {β : ℝ} (genre : Content D)
    (hβ : 0 < β) (u : I) :
    singleGenreContentSample N P β genre u ∈
      (singleGenreContentLaw N P β genre).support := by
  rw [Measure.support_eq_forall_isOpen]
  intro U hu hUopen
  rw [singleGenreContentLaw,
    Measure.map_apply (singleGenreContentSample_measurable N P β genre)
      hUopen.measurableSet]
  apply (Measure.mem_support_iff_forall u).mp (unitInterval_volume_mem_support u)
  apply (singleGenreContentSample_continuous genre hβ).continuousAt
  exact hUopen.mem_nhds hu

/-- The concrete single-genre ray law has exactly the sampler range as support. -/
theorem singleGenreContentLaw_support_eq_range
    {D N P : ℕ} [Nontrivial (Fin P)] {β : ℝ} (genre : Content D)
    (hβ : 0 < β) :
    (singleGenreContentLaw N P β genre).support =
      Set.range (singleGenreContentSample N P β genre) := by
  apply Set.Subset.antisymm
  · exact singleGenreContentLaw_support_subset_range genre hβ
  · rintro p ⟨u, rfl⟩
    exact singleGenreContentSample_mem_support genre hβ u

/--
For a unit genre, taking a source norm of the concrete ray sampler recovers
its scalar quality sample.  The nonnegative scaling premise is supplied by
the inverse-transform quality sampler.
-/
theorem SourceNorm.norm_singleGenreContentSample_eq_qualitySample
    {D N P : ℕ} {β : ℝ} (ν : SourceNorm D) {genre : Content D}
    (hgenre_norm : ν.norm genre = 1) (u : I) :
    ν.norm (singleGenreContentSample N P β genre u) =
      singleGenreQualitySample N P β u := by
  rw [singleGenreContentSample,
    ν.scale_nonneg (singleGenreQualitySample_nonnegative N P β u),
    hgenre_norm, mul_one]

/--
The norm pushforward of a concrete unit-genre ray law is exactly its scalar
quality law.  Measurability of the norm is explicit rather than inferred from
the abstract source-norm API.
-/
theorem singleGenreContentLaw_sourceNorm_map_eq_qualityLaw
    {D N P : ℕ} {β : ℝ} (ν : SourceNorm D) {genre : Content D}
    (hnorm_meas : Measurable ν.norm) (hgenre_norm : ν.norm genre = 1) :
    Measure.map ν.norm (singleGenreContentLaw N P β genre) =
      singleGenreQualityLaw N P β := by
  unfold singleGenreContentLaw singleGenreQualityLaw
  rw [Measure.map_map hnorm_meas (singleGenreContentSample_measurable N P β genre)]
  congr 1
  ext u
  exact SourceNorm.norm_singleGenreContentSample_eq_qualitySample
    ν hgenre_norm u

/--
The concrete ray law is supported on the source segment from zero to its
quality support cap times the selected genre.  This is the support inclusion
asserted in Corollary `onepopulation`; no unsupported equality of support sets
is claimed here.
-/
theorem singleGenreContentLaw_support_subset_scaledGenre_segment
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)] {β : ℝ}
    (genre : Content D) (hβ : 0 < β) :
    (singleGenreContentLaw N P β genre).support ⊆
      {p : Content D | ∃ q : ℝ, q ∈ Set.Icc (0 : ℝ) ((N : ℝ) ^ β⁻¹) ∧
        p = scaleContent q genre} := by
  intro p hp
  rcases singleGenreContentLaw_support_subset_range genre hβ hp with ⟨u, rfl⟩
  refine ⟨singleGenreQualitySample N P β u, ?_, rfl⟩
  exact ⟨singleGenreQualitySample_nonnegative N P β u,
    singleGenreQualitySample_le_supportCap hβ u⟩

/--
The zero-quality content action is a topological-support point of the concrete
single-genre ray law.  This is the support fact used by Proposition
`zeroutilitysinglegenre`; it follows from the inverse-transform sampler rather
than from an informal CDF-at-zero assertion.
-/
theorem zero_mem_singleGenreContentLaw_support
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β : ℝ} (hβ : 0 < β) (genre : Content D) :
    (0 : Content D) ∈ (singleGenreContentLaw N P β genre).support := by
  let uZero : I := ⟨0, by norm_num⟩
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_real : (1 : ℝ) < (P : ℝ) := by exact_mod_cast hP_nat
  have hP_sub_pos : 0 < (P : ℝ) - 1 := sub_pos.mpr hP_real
  have hpower_pos : 0 < ((P : ℝ) - 1) / β := div_pos hP_sub_pos hβ
  have hquality_zero : singleGenreQualitySample N P β uZero = 0 := by
    simp [singleGenreQualitySample, uZero,
      AppliedModelingLib.Probability.unitIntervalPowerSample,
      Real.zero_rpow (ne_of_gt hpower_pos)]
  have hsample : singleGenreContentSample N P β genre uZero = 0 := by
    rw [singleGenreContentSample, hquality_zero]
    ext d
    simp [scaleContent]
  rw [← hsample]
  exact singleGenreContentSample_mem_support genre hβ uZero

/-- The topological support of a nonnegative single-genre law is source-feasible. -/
theorem singleGenreContentLaw_support_subset_nonnegative
    {D N P : ℕ} {β : ℝ} {genre : Content D}
    (hgenre : NonnegativeContent genre) :
    (singleGenreContentLaw N P β genre).support ⊆
      {p : Content D | NonnegativeContent p} :=
  MeasureTheory.Measure.support_subset_of_isClosed isClosed_nonnegativeContentSet
    (singleGenreContentLaw_ae_nonnegative hgenre)

/--
Corrected source genre set: normalize only nonzero support actions.  The
paper's literal `p / ||p||` display must exclude zero because its ray law has
zero in topological support.
-/
def SourceNonzeroSupportGenres {D : ℕ} (ν : SourceNorm D)
    (μ : MixedContentStrategy D) : Set (Content D) :=
  {genre | ∃ p : Content D, p ∈ μ.support ∧ NonzeroContent p ∧
    genre = SourceNorm.normalizedContent ν p}

/-- A common positive content scale preserves the normalized directions of all
nonzero topological-support actions. -/
theorem sourceNonzeroSupportGenres_scaleContent_map
    {D : ℕ} (ν : SourceNorm D) {μ : MixedContentStrategy D} {a : ℝ}
    (ha : 0 < a) :
    SourceNonzeroSupportGenres ν (Measure.map (scaleContent a) μ) =
      SourceNonzeroSupportGenres ν μ := by
  ext genre
  constructor
  · rintro ⟨p, hp, hp_nonzero, rfl⟩
    have ha_ne : a ≠ 0 := ha.ne'
    have hinverseMap :
        Measure.map (scaleContent a⁻¹) (Measure.map (scaleContent a) μ) = μ := by
      calc
        Measure.map (scaleContent a⁻¹) (Measure.map (scaleContent a) μ) =
            Measure.map ((scaleContent a⁻¹) ∘ (scaleContent a)) μ :=
          Measure.map_map (measurable_scaleContent a⁻¹) (measurable_scaleContent a)
        _ = Measure.map id μ := by
          apply Measure.map_congr
          filter_upwards [] with q
          simpa only [Function.comp_apply] using scaleContent_inv_scaleContent ha_ne q
        _ = μ := Measure.map_id
    have hp_back : scaleContent a⁻¹ p ∈ μ.support := by
      have hmap := AppliedModelingLib.Probability.mem_support_map_of_continuous
        (continuous_scaleContent a⁻¹) hp
      rwa [hinverseMap] at hmap
    have hp_back_nonzero : NonzeroContent (scaleContent a⁻¹ p) := by
      rcases hp_nonzero with ⟨d, hd⟩
      refine ⟨d, ?_⟩
      intro hzero
      apply hd
      rw [← scaleContent_scaleContent_inv ha_ne p]
      change a * (a⁻¹ * p d) = 0
      change a⁻¹ * p d = 0 at hzero
      rw [hzero, mul_zero]
    refine ⟨scaleContent a⁻¹ p, hp_back, hp_back_nonzero, ?_⟩
    calc
      SourceNorm.normalizedContent ν p =
          SourceNorm.normalizedContent ν (scaleContent a (scaleContent a⁻¹ p)) := by
        rw [scaleContent_scaleContent_inv ha_ne p]
      _ = SourceNorm.normalizedContent ν (scaleContent a⁻¹ p) :=
        SourceNorm.normalizedContent_scaleContent_pos ν ha hp_back_nonzero
  · rintro ⟨p, hp, hp_nonzero, rfl⟩
    refine ⟨scaleContent a p,
      AppliedModelingLib.Probability.mem_support_map_of_continuous
        (continuous_scaleContent a) hp, ?_, ?_⟩
    · rcases hp_nonzero with ⟨d, hd⟩
      refine ⟨d, ?_⟩
      change a * p d ≠ 0
      exact mul_ne_zero ha.ne' hd
    · exact (SourceNorm.normalizedContent_scaleContent_pos ν ha hp_nonzero).symm

/--
A corrected singleton nonzero-support-genre condition puts every support
action on the selected nonnegative source-norm ray, including the zero action.
This is the geometric bridge from the paper's genre notation to a scalar norm
law; it does not identify that scalar law with the paper's proposed CDF.
-/
theorem support_subset_scaledGenre_ray_of_singleton_nonzeroSupportGenres
    {D : ℕ} {ν : SourceNorm D} {μ : MixedContentStrategy D}
    {genre : Content D}
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D))) :
    μ.support ⊆ {p : Content D | ∃ r : ℝ, 0 ≤ r ∧
      p = scaleContent r genre} := by
  intro p hp
  by_cases hp_nonzero : NonzeroContent p
  · have hnormalized_mem : SourceNorm.normalizedContent ν p ∈
        SourceNonzeroSupportGenres ν μ :=
      ⟨p, hp, hp_nonzero, rfl⟩
    have hnormalized : SourceNorm.normalizedContent ν p = genre :=
      Set.mem_singleton_iff.mp (hgenres hnormalized_mem)
    refine ⟨ν.norm p, ν.nonneg p, ?_⟩
    calc
      p = scaleContent (ν.norm p) (SourceNorm.normalizedContent ν p) :=
        (SourceNorm.scale_norm_normalizedContent_eq_self ν hp_nonzero).symm
      _ = scaleContent (ν.norm p) genre := by rw [hnormalized]
  · have hp_zero : p = 0 := content_eq_zero_of_not_nonzeroContent hp_nonzero
    subst p
    refine ⟨0, le_rfl, ?_⟩
    ext d
    simp [scaleContent]

/--
If a corrected singleton genre is actually represented by a nonzero support
action, it has source norm one.  The existence premise is essential: a subset
condition alone permits an all-zero support law and says nothing about an
arbitrary nominated genre.
-/
theorem sourceNorm_genre_eq_one_of_singleton_nonzeroSupportGenres_of_exists
    {D : ℕ} {ν : SourceNorm D} {μ : MixedContentStrategy D}
    {genre : Content D}
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hexists : ∃ p : Content D, p ∈ μ.support ∧ NonzeroContent p) :
    ν.norm genre = 1 := by
  rcases hexists with ⟨p, hp, hp_nonzero⟩
  have hnormalized_mem : SourceNorm.normalizedContent ν p ∈
      SourceNonzeroSupportGenres ν μ :=
    ⟨p, hp, hp_nonzero, rfl⟩
  have hnormalized : SourceNorm.normalizedContent ν p = genre :=
    Set.mem_singleton_iff.mp (hgenres hnormalized_mem)
  rw [← hnormalized]
  exact SourceNorm.norm_normalizedContent_eq_one ν hp_nonzero

/--
If the support itself is source-feasible, a represented singleton genre is
nonnegative.  This keeps the action-space premise visible rather than treating
nonnegativity as a consequence of normalization alone.
-/
theorem genre_nonnegative_of_singleton_nonzeroSupportGenres_of_exists
    {D : ℕ} {ν : SourceNorm D} {μ : MixedContentStrategy D}
    {genre : Content D}
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hexists : ∃ p : Content D, p ∈ μ.support ∧ NonzeroContent p)
    (hsupport_nonnegative : μ.support ⊆
      {p : Content D | NonnegativeContent p}) :
    NonnegativeContent genre := by
  rcases hexists with ⟨p, hp, hp_nonzero⟩
  have hnormalized_mem : SourceNorm.normalizedContent ν p ∈
      SourceNonzeroSupportGenres ν μ :=
    ⟨p, hp, hp_nonzero, rfl⟩
  have hnormalized : SourceNorm.normalizedContent ν p = genre :=
    Set.mem_singleton_iff.mp (hgenres hnormalized_mem)
  rw [← hnormalized]
  exact SourceNorm.normalizedContent_nonnegative ν (hsupport_nonnegative hp)

/--
On a corrected singleton nonzero-support ray, content atomlessness transfers
to every fixed source-norm level. This is the scalar atomlessness bridge needed
before a CDF no-gap argument can use continuity of the norm law.
-/
theorem sourceNorm_level_measure_eq_zero_of_noAtoms_of_singleton_nonzeroSupportGenres
    {D : ℕ} {ν : SourceNorm D} {μ : MixedContentStrategy D}
    [MeasureTheory.NoAtoms μ] {genre : Content D}
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (r : ℝ) :
    μ {q : Content D | ν.norm q = r} = 0 := by
  let p0 : Content D := scaleContent r genre
  have hsingle : μ ({p0} : Set (Content D)) = 0 :=
    MeasureTheory.measure_singleton p0
  have hcomplement : μ μ.supportᶜ = 0 := by
    simpa using (MeasureTheory.Measure.measure_compl_support (μ := μ))
  refine MeasureTheory.measure_mono_null ?_
    (MeasureTheory.measure_union_null hsingle hcomplement)
  intro q hq
  by_cases hq_support : q ∈ μ.support
  · left
    rw [Set.mem_singleton_iff]
    change ν.norm q = r at hq
    by_cases hq_nonzero : NonzeroContent q
    · have hnormalized_mem : SourceNorm.normalizedContent ν q ∈
          SourceNonzeroSupportGenres ν μ :=
        ⟨q, hq_support, hq_nonzero, rfl⟩
      have hnormalized : SourceNorm.normalizedContent ν q = genre :=
        Set.mem_singleton_iff.mp (hgenres hnormalized_mem)
      calc
        q = scaleContent (ν.norm q) (SourceNorm.normalizedContent ν q) :=
          (SourceNorm.scale_norm_normalizedContent_eq_self ν hq_nonzero).symm
        _ = scaleContent (ν.norm q) genre := by rw [hnormalized]
        _ = p0 := by rw [hq]
    · have hq_zero : q = 0 := content_eq_zero_of_not_nonzeroContent hq_nonzero
      subst q
      have hr_zero : r = 0 := by simpa [SourceNorm.norm_zero] using hq.symm
      subst r
      ext d
      simp [p0, scaleContent]
  · right
    exact hq_support

/--
The measurable source-norm pushforward of an atomless corrected singleton-ray
law is atomless. This is a consequence of the ray geometry, not an automatic
property of arbitrary measurable images of atomless measures.
-/
theorem sourceNorm_map_noAtoms_of_singleton_nonzeroSupportGenres
    {D : ℕ} {ν : SourceNorm D} {μ : MixedContentStrategy D}
    [MeasureTheory.NoAtoms μ] {genre : Content D}
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hmeas_norm : Measurable ν.norm) :
    MeasureTheory.NoAtoms (Measure.map ν.norm μ) := by
  constructor
  intro r
  rw [Measure.map_apply hmeas_norm (measurableSet_singleton r)]
  exact sourceNorm_level_measure_eq_zero_of_noAtoms_of_singleton_nonzeroSupportGenres
    hgenres r

/--
For a support action in a corrected singleton-genre law, every user's score is
its source norm times that user's score against the selected genre.  The zero
support action is included explicitly rather than discarded during
normalization.
-/
theorem score_eq_norm_mul_score_genre_of_mem_support_of_singleton_nonzeroSupportGenres
    {D : ℕ} {ν : SourceNorm D} {μ : MixedContentStrategy D}
    {genre u p : Content D}
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hp : p ∈ μ.support) :
    score u p = ν.norm p * score u genre := by
  by_cases hp_nonzero : NonzeroContent p
  · have hnormalized_mem : SourceNorm.normalizedContent ν p ∈
        SourceNonzeroSupportGenres ν μ :=
      ⟨p, hp, hp_nonzero, rfl⟩
    have hnormalized : SourceNorm.normalizedContent ν p = genre :=
      Set.mem_singleton_iff.mp (hgenres hnormalized_mem)
    rw [SourceNorm.score_eq_norm_mul_score_normalizedContent ν u hp_nonzero,
      hnormalized]
  · have hp_zero : p = 0 := content_eq_zero_of_not_nonzeroContent hp_nonzero
    subst p
    simp [SourceNorm.norm_zero]

/--
The score pushforward of an arbitrary corrected singleton-genre law is the
source-norm pushforward followed by scalar multiplication by the genre score.
This is a measure identity, not an assumed CDF formula.
-/
theorem score_map_eq_scale_sourceNorm_map_of_singleton_nonzeroSupportGenres
    {D : ℕ} {ν : SourceNorm D} {μ : MixedContentStrategy D}
    {genre u : Content D}
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hmeas_norm : Measurable ν.norm) :
    Measure.map (fun p : Content D => score u p) μ =
      Measure.map (fun r : ℝ => r * score u genre) (Measure.map ν.norm μ) := by
  have hscale_meas : Measurable (fun r : ℝ => r * score u genre) :=
    measurable_id.mul measurable_const
  rw [Measure.map_map hscale_meas hmeas_norm]
  apply Measure.map_congr
  filter_upwards [Measure.support_mem_ae] with p hp
  exact score_eq_norm_mul_score_genre_of_mem_support_of_singleton_nonzeroSupportGenres
    hgenres hp

/--
For a positive genre score, the previous pushforward identity transfers every
score lower-CDF value to the source-norm lower-CDF at the rescaled threshold.
It makes no claim that the scalar norm CDF has the paper's closed form.
-/
theorem score_map_Iic_eq_sourceNorm_map_Iic_div_of_singleton_nonzeroSupportGenres
    {D : ℕ} {ν : SourceNorm D} {μ : MixedContentStrategy D}
    {genre u : Content D} {z : ℝ}
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hmeas_norm : Measurable ν.norm)
    (hscore_pos : 0 < score u genre) :
    Measure.map (fun p : Content D => score u p) μ (Set.Iic z) =
      Measure.map ν.norm μ (Set.Iic (z / score u genre)) := by
  rw [score_map_eq_scale_sourceNorm_map_of_singleton_nonzeroSupportGenres
    hgenres hmeas_norm]
  have hscale_meas : Measurable (fun r : ℝ => r * score u genre) :=
    measurable_id.mul measurable_const
  rw [Measure.map_apply hscale_meas measurableSet_Iic]
  congr 1
  ext r
  change r * score u genre ≤ z ↔ r ≤ z / score u genre
  exact (le_div_iff₀ hscore_pos).symm

/--
Under a corrected singleton nonzero-support-genre condition, a positive-score
user's score fibers contain at most one support action.  Thus content
atomlessness implies score-level nullness in this single-ray case.
-/
theorem score_level_measure_eq_zero_of_noAtoms_of_singleton_nonzeroSupportGenres
    {D : ℕ} {ν : SourceNorm D} {μ : MixedContentStrategy D}
    [MeasureTheory.NoAtoms μ] {genre u : Content D}
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hscore_pos : 0 < score u genre) (z : ℝ) :
    μ {q : Content D | score u q = z} = 0 := by
  let p0 : Content D := scaleContent (z / score u genre) genre
  have hsingle : μ ({p0} : Set (Content D)) = 0 :=
    MeasureTheory.measure_singleton p0
  have hcomplement : μ μ.supportᶜ = 0 := by
    simpa using (MeasureTheory.Measure.measure_compl_support (μ := μ))
  refine MeasureTheory.measure_mono_null ?_
    (MeasureTheory.measure_union_null hsingle hcomplement)
  intro q hq
  by_cases hq_support : q ∈ μ.support
  · left
    rw [Set.mem_singleton_iff]
    change score u q = z at hq
    by_cases hq_nonzero : NonzeroContent q
    · have hnormalized_mem : SourceNorm.normalizedContent ν q ∈
          SourceNonzeroSupportGenres ν μ :=
        ⟨q, hq_support, hq_nonzero, rfl⟩
      have hnormalized : SourceNorm.normalizedContent ν q = genre :=
        Set.mem_singleton_iff.mp (hgenres hnormalized_mem)
      have hscore_eq : score u q = ν.norm q * score u genre := by
        rw [SourceNorm.score_eq_norm_mul_score_normalizedContent ν u hq_nonzero,
          hnormalized]
      have hnorm : ν.norm q = z / score u genre := by
        apply (eq_div_iff (ne_of_gt hscore_pos)).2
        calc
          ν.norm q * score u genre = score u q := hscore_eq.symm
          _ = z := hq
      calc
        q = scaleContent (ν.norm q) (SourceNorm.normalizedContent ν q) :=
          (SourceNorm.scale_norm_normalizedContent_eq_self ν hq_nonzero).symm
        _ = scaleContent (ν.norm q) genre := by rw [hnormalized]
        _ = p0 := by rw [hnorm]
    · have hq_zero : q = 0 := content_eq_zero_of_not_nonzeroContent hq_nonzero
      subst q
      have hz : z = 0 := by
        simpa [score_zero_right] using hq.symm
      subst z
      ext d
      simp [p0, scaleContent]
  · right
    exact hq_support

/--
For a support action of a corrected singleton-genre law, the actual tie-aware
expected-user payoff reduces to the common source-norm lower-CDF mass.  The
atomlessness and positive-genre-score hypotheses are what justify this CDF
form; no closed formula for that scalar CDF is assumed.
-/
theorem expectedUsersWonAgainstSymmetricMixed_eq_sum_sourceNormLowerCdfMass_of_mem_support_of_singleton_nonzeroSupportGenres
    {D N P : ℕ} {users : Fin N → Content D} {j : Fin P}
    {ν : SourceNorm D} {μ : MixedContentStrategy D}
    {genre p : Content D}
    [MeasureTheory.IsProbabilityMeasure μ] [MeasureTheory.NoAtoms μ]
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆ ({genre} : Set (Content D)))
    (hmeas_norm : Measurable ν.norm)
    (hgenre_score : ∀ i : Fin N, 0 < score (users i) genre)
    (hp : p ∈ μ.support) :
    ExpectedUsersWonAgainstSymmetricMixed users j p μ =
      ∑ i : Fin N,
        ((Measure.map ν.norm μ).real (Set.Iic (ν.norm p))) ^ (P - 1) := by
  rw [expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
    (users := users) (j := j) (μ := μ) p
    (fun i => measurable_score_content (users i))
    (fun i z =>
      score_level_measure_eq_zero_of_noAtoms_of_singleton_nonzeroSupportGenres
        hgenres (hgenre_score i) z)]
  apply Finset.sum_congr rfl
  intro i _
  have hlevel_null : ∀ z : ℝ,
      μ {q : Content D | score (users i) q = z} = 0 :=
    fun z => score_level_measure_eq_zero_of_noAtoms_of_singleton_nonzeroSupportGenres
      hgenres (hgenre_score i) z
  have hstrict_eq_weak :
      μ {q : Content D | score (users i) q < score (users i) p} =
        μ {q : Content D | score (users i) q ≤ score (users i) p} :=
    score_lt_measure_eq_score_le_measure_of_score_level_null
      (measurable_score_content (users i)) hlevel_null _
  have hscore_p :
      score (users i) p = ν.norm p * score (users i) genre :=
    score_eq_norm_mul_score_genre_of_mem_support_of_singleton_nonzeroSupportGenres
      hgenres hp
  have hratio : score (users i) p / score (users i) genre = ν.norm p := by
    rw [hscore_p]
    field_simp [ne_of_gt (hgenre_score i)]
  have hcdf :
      Measure.map (fun q : Content D => score (users i) q) μ
          (Set.Iic (score (users i) p)) =
        Measure.map ν.norm μ
          (Set.Iic (ν.norm p)) := by
    rw [score_map_Iic_eq_sourceNorm_map_Iic_div_of_singleton_nonzeroSupportGenres
      hgenres hmeas_norm (hgenre_score i), hratio]
  change
    (μ {q : Content D | score (users i) q < score (users i) p}).toReal ^ (P - 1) =
      ((Measure.map ν.norm μ) (Set.Iic (ν.norm p))).toReal ^ (P - 1)
  rw [hstrict_eq_weak]
  congr 2
  calc
    μ {q : Content D | score (users i) q ≤ score (users i) p} =
        (Measure.map (fun q : Content D => score (users i) q) μ)
          (Set.Iic (score (users i) p)) := by
      rw [Measure.map_apply (measurable_score_content (users i)) measurableSet_Iic]
      rfl
    _ = (Measure.map ν.norm μ) (Set.Iic (ν.norm p)) := hcdf

/--
Every nonzero support action of the concrete ray law normalizes to its chosen
unit genre.  This is the source's singleton-genre conclusion with the required
zero-support correction made explicit.
-/
theorem singleGenreContentLaw_nonzeroSupportGenres_subset_singleton
    {D N P : ℕ} [Nontrivial (Fin P)] {β : ℝ} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β) (hgenre_norm : ν.norm genre = 1) :
    SourceNonzeroSupportGenres ν (singleGenreContentLaw N P β genre) ⊆
      ({genre} : Set (Content D)) := by
  rintro direction ⟨p, hp, hp_nonzero, rfl⟩
  rcases singleGenreContentLaw_support_subset_range genre hβ hp with ⟨u, rfl⟩
  have hquality_nonnegative : 0 ≤ singleGenreQualitySample N P β u :=
    singleGenreQualitySample_nonnegative N P β u
  have hquality_ne : singleGenreQualitySample N P β u ≠ 0 := by
    intro hquality_zero
    rcases hp_nonzero with ⟨d, hd⟩
    apply hd
    simp [singleGenreContentSample, scaleContent, hquality_zero]
  exact Set.mem_singleton_iff.mpr (by
    simpa [singleGenreContentSample] using
      (SourceNorm.normalizedContent_scale_of_norm_eq_one
        ν hquality_nonnegative hquality_ne hgenre_norm))

/--
With a nonempty user population, the corrected nonzero-support genre set of
the concrete ray law is exactly its chosen unit genre.
-/
theorem singleGenreContentLaw_nonzeroSupportGenres_eq_singleton
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β : ℝ} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β) (hgenre_norm : ν.norm genre = 1) :
    SourceNonzeroSupportGenres ν (singleGenreContentLaw N P β genre) =
      ({genre} : Set (Content D)) := by
  apply Set.Subset.antisymm
  · exact singleGenreContentLaw_nonzeroSupportGenres_subset_singleton
      ν hβ hgenre_norm
  · intro direction hdirection
    rw [Set.mem_singleton_iff] at hdirection
    subst direction
    let uOne : I := ⟨1, by norm_num⟩
    have hN_card : 0 < Fintype.card (Fin N) :=
      Fintype.card_pos_iff.mpr inferInstance
    have hN_nat : 0 < N := by simpa using hN_card
    have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
    have hquality_pos : 0 < singleGenreQualitySample N P β uOne := by
      have hcap_pos : 0 < (N : ℝ) ^ β⁻¹ :=
        Real.rpow_pos_of_pos hN_pos _
      simpa [uOne, singleGenreQualitySample,
        AppliedModelingLib.Probability.unitIntervalPowerSample] using hcap_pos
    have hgenre_nonzero : NonzeroContent genre := by
      by_contra hgenre_zero
      have hgenre_eq_zero : genre = 0 :=
        content_eq_zero_of_not_nonzeroContent hgenre_zero
      rw [hgenre_eq_zero, ν.norm_zero] at hgenre_norm
      norm_num at hgenre_norm
    have hsample_nonzero :
        NonzeroContent (singleGenreContentSample N P β genre uOne) := by
      rcases hgenre_nonzero with ⟨d, hd⟩
      refine ⟨d, ?_⟩
      simp only [singleGenreContentSample, scaleContent]
      exact mul_ne_zero (ne_of_gt hquality_pos) hd
    refine ⟨singleGenreContentSample N P β genre uOne,
      singleGenreContentSample_mem_support genre hβ uOne, hsample_nonzero, ?_⟩
    simpa [singleGenreContentSample] using
      (SourceNorm.normalizedContent_scale_of_norm_eq_one
        ν hquality_pos.le (ne_of_gt hquality_pos) hgenre_norm).symm

/--
Pushing the single-genre content law through a user's score is exactly the
quality law scaled by that user's score against the candidate genre.
-/
theorem singleGenreContentLaw_score_map_eq_scaledQualityLaw
    {D : ℕ} (N P : ℕ) (β : ℝ) (genre u : Content D) :
    Measure.map (fun p : Content D => score u p)
        (singleGenreContentLaw N P β genre) =
      Measure.map (fun q : ℝ => q * score u genre)
        (singleGenreQualityLaw N P β) := by
  have hscaled_meas : Measurable (fun q : ℝ => q * score u genre) :=
    measurable_id.mul measurable_const
  unfold singleGenreContentLaw singleGenreQualityLaw
  rw [Measure.map_map (measurable_score_content u)
    (singleGenreContentSample_measurable N P β genre)]
  rw [Measure.map_map hscaled_meas
    (singleGenreQualitySample_measurable N P β)]
  congr 1
  ext x
  exact score_scaleContent (singleGenreQualitySample N P β x) u genre

/--
The general quality sampler has the inverse-power CDF on its displayed support
interval.  The next bridge identifies this expression with the paper's
algebraic `singleGenreCdf` formula.
-/
theorem singleGenreQualityLaw_cdf_on_support
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)] {β z : ℝ}
    (hβ : 0 < β)
    (hz : z ∈ Set.Icc (0 : ℝ) ((N : ℝ) ^ β⁻¹)) :
    singleGenreQualityLaw N P β (Set.Iic z) =
      ENNReal.ofReal
        ((z / ((N : ℝ) ^ β⁻¹)) ^ (β / ((P : ℝ) - 1))) := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hcap_pos : 0 < (N : ℝ) ^ β⁻¹ :=
    Real.rpow_pos_of_pos hN_pos _
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    have hP_real : (1 : ℝ) < P := by exact_mod_cast hP_nat
    linarith
  have ha : 0 < ((P : ℝ) - 1) / β :=
    div_pos hP_sub_pos hβ
  have hratio : z / ((N : ℝ) ^ β⁻¹) ∈ Set.Icc (0 : ℝ) 1 := by
    constructor
    · exact div_nonneg hz.1 hcap_pos.le
    · rw [div_le_one hcap_pos]
      exact hz.2
  have hainv_pos : 0 < (((P : ℝ) - 1) / β)⁻¹ := inv_pos.mpr ha
  have hthreshold_nonneg :
      0 ≤ (z / ((N : ℝ) ^ β⁻¹)) ^ (((P : ℝ) - 1) / β)⁻¹ :=
    Real.rpow_nonneg hratio.1 _
  have hthreshold_le_one :
      (z / ((N : ℝ) ^ β⁻¹)) ^ (((P : ℝ) - 1) / β)⁻¹ ≤ 1 :=
    Real.rpow_le_one hratio.1 hratio.2 hainv_pos.le
  let threshold : I :=
    ⟨(z / ((N : ℝ) ^ β⁻¹)) ^ (((P : ℝ) - 1) / β)⁻¹,
      ⟨hthreshold_nonneg, hthreshold_le_one⟩⟩
  have hpreimage :
      {u : I | singleGenreQualitySample N P β u ≤ z} = Set.Iic threshold := by
    ext u
    change
      (N : ℝ) ^ β⁻¹ *
          AppliedModelingLib.Probability.unitIntervalPowerSample (((P : ℝ) - 1) / β) u ≤ z ↔
        (u : ℝ) ≤
          (z / ((N : ℝ) ^ β⁻¹)) ^ (((P : ℝ) - 1) / β)⁻¹
    calc
      (N : ℝ) ^ β⁻¹ *
          AppliedModelingLib.Probability.unitIntervalPowerSample (((P : ℝ) - 1) / β) u ≤ z ↔
          AppliedModelingLib.Probability.unitIntervalPowerSample (((P : ℝ) - 1) / β) u ≤
            z / ((N : ℝ) ^ β⁻¹) := by
        rw [le_div_iff₀ hcap_pos]
        simpa [mul_comm]
      _ ↔ (u : ℝ) ≤
          (z / ((N : ℝ) ^ β⁻¹)) ^ (((P : ℝ) - 1) / β)⁻¹ := by
        change (u : ℝ) ^ (((P : ℝ) - 1) / β) ≤
            z / ((N : ℝ) ^ β⁻¹) ↔ _
        calc
          (u : ℝ) ^ (((P : ℝ) - 1) / β) ≤
              z / ((N : ℝ) ^ β⁻¹) ↔
              ((u : ℝ) ^ (((P : ℝ) - 1) / β)) ^ (((P : ℝ) - 1) / β)⁻¹ ≤
                (z / ((N : ℝ) ^ β⁻¹)) ^ (((P : ℝ) - 1) / β)⁻¹ :=
            (Real.rpow_le_rpow_iff (Real.rpow_nonneg u.2.1 _) hratio.1 hainv_pos).symm
          _ ↔ (u : ℝ) ≤
              (z / ((N : ℝ) ^ β⁻¹)) ^ (((P : ℝ) - 1) / β)⁻¹ := by
            rw [← Real.rpow_mul u.2.1]
            have hmul : (((P : ℝ) - 1) / β) * (((P : ℝ) - 1) / β)⁻¹ = 1 := by
              field_simp [ne_of_gt ha]
            rw [hmul, Real.rpow_one]
  have hinv : (((P : ℝ) - 1) / β)⁻¹ = β / ((P : ℝ) - 1) := by
    field_simp [ne_of_gt hβ, ne_of_gt hP_sub_pos]
  rw [singleGenreQualityLaw,
    Measure.map_apply (singleGenreQualitySample_measurable N P β) measurableSet_Iic]
  change (volume : Measure I) {u : I | singleGenreQualitySample N P β u ≤ z} = _
  rw [hpreimage, unitInterval.volume_Iic]
  simp only [threshold]
  rw [hinv]

theorem singleGenreCdfRaw_nonneg {N P : ℕ} [Nonempty (Fin N)]
    {β r : ℝ} (hr : 0 ≤ r) :
    0 ≤ singleGenreCdfRaw N P β r := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  unfold singleGenreCdfRaw
  exact Real.rpow_nonneg (div_nonneg (Real.rpow_nonneg hr β) hN_pos.le) _

theorem singleGenreCdf_nonneg {N P : ℕ} [Nonempty (Fin N)]
    {β r : ℝ} (hr : 0 ≤ r) :
    0 ≤ singleGenreCdf N P β r := by
  unfold singleGenreCdf
  exact le_min zero_le_one (singleGenreCdfRaw_nonneg (N := N) (P := P) hr)

/-- The source single-genre CDF is strictly positive at every positive radius. -/
theorem singleGenreCdf_pos {N P : ℕ} [Nonempty (Fin N)]
    {β r : ℝ} (hr : 0 < r) :
    0 < singleGenreCdf N P β r := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  unfold singleGenreCdf singleGenreCdfRaw
  exact lt_min (by norm_num)
    (Real.rpow_pos_of_pos
      (div_pos (Real.rpow_pos_of_pos hr _) hN_pos) _)

theorem singleGenreCdf_le_one {N P : ℕ} {β r : ℝ} :
    singleGenreCdf N P β r ≤ 1 := by
  unfold singleGenreCdf
  exact min_le_left _ _

theorem singleGenreCdf_eq_raw_of_raw_le_one {N P : ℕ} {β r : ℝ}
    (hraw : singleGenreCdfRaw N P β r ≤ 1) :
    singleGenreCdf N P β r = singleGenreCdfRaw N P β r := by
  unfold singleGenreCdf
  exact min_eq_right hraw

theorem singleGenreCdf_eq_one_of_one_le_raw {N P : ℕ} {β r : ℝ}
    (hraw : 1 ≤ singleGenreCdfRaw N P β r) :
    singleGenreCdf N P β r = 1 := by
  unfold singleGenreCdf
  exact min_eq_left hraw

theorem singleGenreCdf_zero {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β : ℝ} (hβ : 0 < β) :
    singleGenreCdf N P β 0 = 0 := by
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_ne : ((P : ℝ) - 1)⁻¹ ≠ 0 := by
    have hP_real : (1 : ℝ) < (P : ℝ) := by exact_mod_cast hP_nat
    have hsub : (P : ℝ) - 1 ≠ 0 := by linarith
    exact inv_ne_zero hsub
  have hraw : singleGenreCdfRaw N P β 0 = 0 := by
    unfold singleGenreCdfRaw
    rw [Real.zero_rpow (ne_of_gt hβ), zero_div, Real.zero_rpow hP_ne]
  unfold singleGenreCdf
  rw [hraw]
  simp

/--
Lemma `cdf`'s scalar support consequence: any probability law with the printed
single-genre lower-CDF formula has zero in topological support.  This statement
is intentionally about the scalar law only; transporting it back to arbitrary
content support still requires an explicit radial-law bridge.
-/
theorem zero_mem_support_of_lowerCDFMass_eq_singleGenreCdf
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β : ℝ} {μ : MeasureTheory.Measure ℝ}
    [MeasureTheory.IsProbabilityMeasure μ]
    (hβ : 0 < β)
    (hcdf : ∀ r : ℝ, 0 ≤ r →
      AppliedModelingLib.Probability.lowerCDFMass μ r = singleGenreCdf N P β r) :
    (0 : ℝ) ∈ μ.support := by
  apply AppliedModelingLib.Probability.zero_mem_support_of_lowerCDFMass_zero_and_pos_right μ
  · rw [hcdf 0 (by norm_num), singleGenreCdf_zero hβ]
  · intro ε hε
    rw [hcdf ε hε.le]
    exact singleGenreCdf_pos hε

/--
Corrected content-level form of Lemma `cdf`'s zero-support consequence.  The
source formula governs the pushforward under the source norm, so the stated
norm/topology compatibility is essential when returning to content support.
-/
theorem zero_mem_support_of_sourceNormLaw_lowerCDFMass_eq_singleGenreCdf
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {ν : SourceNorm D} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure (MeasureTheory.Measure.map ν.norm μ)]
    {β : ℝ}
    (hmeas : Measurable ν.norm)
    (hzero_detect : SourceNormZeroReflectsNeighborhood ν)
    (hβ : 0 < β)
    (hcdf : ∀ r : ℝ, 0 ≤ r →
      AppliedModelingLib.Probability.lowerCDFMass (MeasureTheory.Measure.map ν.norm μ) r =
        singleGenreCdf N P β r) :
    (0 : Content D) ∈ μ.support := by
  apply zero_mem_support_of_zero_mem_support_sourceNormLaw ν hmeas hzero_detect
  exact zero_mem_support_of_lowerCDFMass_eq_singleGenreCdf hβ hcdf

/--
For the paper's finite-coordinate Euclidean norm, the exact scalar
single-genre CDF automatically transports to zero content support.
-/
theorem zero_mem_support_of_l2Law_lowerCDFMass_eq_singleGenreCdf
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure
      (MeasureTheory.Measure.map (SourceNorm.l2 D).norm μ)]
    {β : ℝ}
    (hβ : 0 < β)
    (hcdf : ∀ r : ℝ, 0 ≤ r →
      AppliedModelingLib.Probability.lowerCDFMass
        (MeasureTheory.Measure.map (SourceNorm.l2 D).norm μ) r =
        singleGenreCdf N P β r) :
    (0 : Content D) ∈ μ.support :=
  zero_mem_support_of_sourceNormLaw_lowerCDFMass_eq_singleGenreCdf
    (ν := SourceNorm.l2 D) (μ := μ) (SourceNorm.l2_measurable D)
    (SourceNorm.l2_zeroReflectsNeighborhood D) hβ hcdf

/--
For any positive finite-coordinate `Lq` norm, the exact scalar single-genre
CDF automatically transports to zero content support.
-/
theorem zero_mem_support_of_lpLaw_lowerCDFMass_eq_singleGenreCdf
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {q : ℝ} (hq : 0 < q) {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure
      (MeasureTheory.Measure.map (SourceNorm.lp D hq).norm μ)]
    {β : ℝ}
    (hβ : 0 < β)
    (hcdf : ∀ r : ℝ, 0 ≤ r →
      AppliedModelingLib.Probability.lowerCDFMass
        (MeasureTheory.Measure.map (SourceNorm.lp D hq).norm μ) r =
        singleGenreCdf N P β r) :
    (0 : Content D) ∈ μ.support :=
  zero_mem_support_of_sourceNormLaw_lowerCDFMass_eq_singleGenreCdf
    (ν := SourceNorm.lp D hq) (μ := μ) (SourceNorm.lp_measurable hq)
    (SourceNorm.lp_zeroReflectsNeighborhood hq) hβ hcdf

theorem singleGenreCdf_mono_on_nonnegative {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β r s : ℝ}
    (hβ : 0 ≤ β) (hr : 0 ≤ r) (hrs : r ≤ s) :
    singleGenreCdf N P β r ≤ singleGenreCdf N P β s := by
  have hs : 0 ≤ s := le_trans hr hrs
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    have hP_real : (1 : ℝ) < (P : ℝ) := by exact_mod_cast hP_nat
    linarith
  have hP_exp_nonneg : 0 ≤ ((P : ℝ) - 1)⁻¹ :=
    inv_nonneg.mpr hP_sub_pos.le
  have hpow_le : r ^ β ≤ s ^ β :=
    Real.rpow_le_rpow hr hrs hβ
  have hbase_r_nonneg : 0 ≤ (r ^ β) / (N : ℝ) :=
    div_nonneg (Real.rpow_nonneg hr β) hN_pos.le
  have hbase_le : (r ^ β) / (N : ℝ) ≤ (s ^ β) / (N : ℝ) :=
    div_le_div_of_nonneg_right hpow_le hN_pos.le
  have hraw_le : singleGenreCdfRaw N P β r ≤ singleGenreCdfRaw N P β s := by
    unfold singleGenreCdfRaw
    exact Real.rpow_le_rpow hbase_r_nonneg hbase_le hP_exp_nonneg
  unfold singleGenreCdf
  exact min_le_min le_rfl hraw_le

theorem singleGenreCdfRaw_at_support_cap {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β : ℝ}
    (hβ : 0 < β) :
    singleGenreCdfRaw N P β ((N : ℝ) ^ β⁻¹) = 1 := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hβ_ne : β ≠ 0 := ne_of_gt hβ
  have hbase : (((N : ℝ) ^ β⁻¹) ^ β) / (N : ℝ) = 1 := by
    have hp : ((N : ℝ) ^ β⁻¹) ^ β = (N : ℝ) := by
      rw [← Real.rpow_mul (le_of_lt hN_pos)]
      have hmul : β⁻¹ * β = 1 := by field_simp [hβ_ne]
      rw [hmul, Real.rpow_one]
    rw [hp]
    exact div_self (ne_of_gt hN_pos)
  unfold singleGenreCdfRaw
  rw [hbase]
  exact Real.one_rpow _

theorem singleGenreCdf_at_support_cap {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β : ℝ}
    (hβ : 0 < β) :
    singleGenreCdf N P β ((N : ℝ) ^ β⁻¹) = 1 := by
  rw [singleGenreCdf_eq_one_of_one_le_raw]
  rw [singleGenreCdfRaw_at_support_cap (N := N) (P := P) hβ]

theorem singleGenreCdf_eq_one_of_support_cap_le {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β r : ℝ}
    (hβ : 0 < β) (hcap : (N : ℝ) ^ β⁻¹ ≤ r) :
    singleGenreCdf N P β r = 1 := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hβ_ne : β ≠ 0 := ne_of_gt hβ
  have hcap_nonneg : 0 ≤ (N : ℝ) ^ β⁻¹ :=
    Real.rpow_nonneg hN_pos.le _
  have hcap_pow : ((N : ℝ) ^ β⁻¹) ^ β = (N : ℝ) := by
    rw [← Real.rpow_mul hN_pos.le]
    have hmul : β⁻¹ * β = 1 := by field_simp [hβ_ne]
    rw [hmul, Real.rpow_one]
  have hpow_le : (N : ℝ) ≤ r ^ β := by
    rw [← hcap_pow]
    exact Real.rpow_le_rpow hcap_nonneg hcap hβ.le
  have hbase_one : 1 ≤ (r ^ β) / (N : ℝ) := by
    rw [one_le_div₀ hN_pos]
    simpa using hpow_le
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_exp_nonneg : 0 ≤ ((P : ℝ) - 1)⁻¹ := by
    have hP_real : (1 : ℝ) < (P : ℝ) := by exact_mod_cast hP_nat
    have hsub_pos : 0 < (P : ℝ) - 1 := by linarith
    exact inv_nonneg.mpr hsub_pos.le
  have hraw : 1 ≤ singleGenreCdfRaw N P β r := by
    unfold singleGenreCdfRaw
    exact Real.one_le_rpow hbase_one hP_exp_nonneg
  exact singleGenreCdf_eq_one_of_one_le_raw hraw

theorem singleGenreCdf_eq_raw_of_le_support_cap {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β r : ℝ}
    (hβ : 0 < β) (hr : 0 ≤ r) (hle : r ≤ (N : ℝ) ^ β⁻¹) :
    singleGenreCdf N P β r = singleGenreCdfRaw N P β r := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hβ_ne : β ≠ 0 := ne_of_gt hβ
  have hcap_pow : ((N : ℝ) ^ β⁻¹) ^ β = (N : ℝ) := by
    rw [← Real.rpow_mul hN_pos.le]
    have hmul : β⁻¹ * β = 1 := by field_simp [hβ_ne]
    rw [hmul, Real.rpow_one]
  have hpow_le : r ^ β ≤ (N : ℝ) := by
    rw [← hcap_pow]
    exact Real.rpow_le_rpow hr hle hβ.le
  have hbase_le_one : (r ^ β) / (N : ℝ) ≤ 1 := by
    rw [div_le_one hN_pos]
    simpa using hpow_le
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_exp_nonneg : 0 ≤ ((P : ℝ) - 1)⁻¹ := by
    have hP_real : (1 : ℝ) < (P : ℝ) := by exact_mod_cast hP_nat
    have hsub_pos : 0 < (P : ℝ) - 1 := by linarith
    exact inv_nonneg.mpr hsub_pos.le
  have hbase_nonneg : 0 ≤ (r ^ β) / (N : ℝ) :=
    div_nonneg (Real.rpow_nonneg hr β) hN_pos.le
  have hraw : singleGenreCdfRaw N P β r ≤ 1 := by
    unfold singleGenreCdfRaw
    simpa using Real.rpow_le_one hbase_nonneg hbase_le_one hP_exp_nonneg
  exact singleGenreCdf_eq_raw_of_raw_le_one hraw

/--
The general inverse-transform quality law realizes the source Lemma `cdf`
formula on its support.  This connects the paper's displayed scalar CDF to a
concrete probability measure, before transporting the law to content space.
-/
theorem singleGenreQualityLaw_cdf_eq_singleGenreCdf_on_support
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)] {β z : ℝ}
    (hβ : 0 < β)
    (hz : z ∈ Set.Icc (0 : ℝ) ((N : ℝ) ^ β⁻¹)) :
    singleGenreQualityLaw N P β (Set.Iic z) =
      ENNReal.ofReal (singleGenreCdf N P β z) := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_sub_pos : 0 < (P : ℝ) - 1 := by
    have hP_real : (1 : ℝ) < P := by exact_mod_cast hP_nat
    linarith
  have hformula :
      (z / ((N : ℝ) ^ β⁻¹)) ^ (β / ((P : ℝ) - 1)) =
        singleGenreCdfRaw N P β z := by
    unfold singleGenreCdfRaw
    calc
      (z / ((N : ℝ) ^ β⁻¹)) ^ (β / ((P : ℝ) - 1)) =
          z ^ (β / ((P : ℝ) - 1)) /
            ((N : ℝ) ^ β⁻¹) ^ (β / ((P : ℝ) - 1)) := by
        rw [Real.div_rpow hz.1 (Real.rpow_nonneg hN_pos.le _) _]
      _ = z ^ (β * ((P : ℝ) - 1)⁻¹) /
            (N : ℝ) ^ (((P : ℝ) - 1)⁻¹) := by
        congr 1
        rw [← Real.rpow_mul hN_pos.le]
        congr 1
        field_simp [ne_of_gt hβ, ne_of_gt hP_sub_pos]
      _ = (z ^ β) ^ (((P : ℝ) - 1)⁻¹) /
            (N : ℝ) ^ (((P : ℝ) - 1)⁻¹) := by
        rw [← Real.rpow_mul hz.1]
      _ = ((z ^ β) / (N : ℝ)) ^ (((P : ℝ) - 1)⁻¹) := by
        rw [Real.div_rpow (Real.rpow_nonneg hz.1 β) hN_pos.le]
  rw [singleGenreQualityLaw_cdf_on_support hβ hz, hformula,
    singleGenreCdf_eq_raw_of_le_support_cap hβ hz.1 hz.2]

/--
For every nonnegative threshold, the concrete quality law has the source
clipped CDF.  Above the support cap the statement follows from the sampler's
range, rather than an assumed support description.
-/
theorem singleGenreQualityLaw_cdf_eq_singleGenreCdf_of_nonneg
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)] {β z : ℝ}
    (hβ : 0 < β) (hz : 0 ≤ z) :
    singleGenreQualityLaw N P β (Set.Iic z) =
      ENNReal.ofReal (singleGenreCdf N P β z) := by
  by_cases hle : z ≤ (N : ℝ) ^ β⁻¹
  · exact singleGenreQualityLaw_cdf_eq_singleGenreCdf_on_support hβ ⟨hz, hle⟩
  · have hcap : (N : ℝ) ^ β⁻¹ ≤ z := le_of_not_ge hle
    have hpreimage :
        {u : I | singleGenreQualitySample N P β u ≤ z} = Set.univ := by
      ext u
      simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
      exact le_trans (singleGenreQualitySample_le_supportCap hβ u) hcap
    calc
      singleGenreQualityLaw N P β (Set.Iic z) =
          (volume : Measure I)
            {u : I | singleGenreQualitySample N P β u ≤ z} := by
        rw [singleGenreQualityLaw,
          Measure.map_apply (singleGenreQualitySample_measurable N P β) measurableSet_Iic]
        rfl
      _ = (volume : Measure I) Set.univ := by rw [hpreimage]
      _ = 1 := MeasureTheory.IsProbabilityMeasure.measure_univ
      _ = ENNReal.ofReal (singleGenreCdf N P β z) := by
        rw [singleGenreCdf_eq_one_of_support_cap_le hβ hcap]
        norm_num

/--
Lemma `cdf`, concrete norm-law form: a measurable source norm of the concrete
unit-genre ray law has the paper's clipped scalar CDF at every nonnegative
threshold.
-/
theorem singleGenreContentLaw_sourceNorm_map_cdf_eq_singleGenreCdf_of_nonneg
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)] {β z : ℝ}
    (ν : SourceNorm D) {genre : Content D}
    (hnorm_meas : Measurable ν.norm) (hgenre_norm : ν.norm genre = 1)
    (hβ : 0 < β) (hz : 0 ≤ z) :
    Measure.map ν.norm (singleGenreContentLaw N P β genre) (Set.Iic z) =
      ENNReal.ofReal (singleGenreCdf N P β z) := by
  rw [singleGenreContentLaw_sourceNorm_map_eq_qualityLaw
    ν hnorm_meas hgenre_norm]
  exact singleGenreQualityLaw_cdf_eq_singleGenreCdf_of_nonneg hβ hz

/--
The content-space single-genre construction has the source CDF after scoring
against any user that has positive score against the candidate genre.
-/
theorem singleGenreContentLaw_score_map_cdf_on_support
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β z : ℝ} {genre u : Content D}
    (hβ : 0 < β) (hscore : 0 < score u genre)
    (hz : z ∈ Set.Icc (0 : ℝ)
      (score u genre * ((N : ℝ) ^ β⁻¹))) :
    Measure.map (fun p : Content D => score u p)
        (singleGenreContentLaw N P β genre) (Set.Iic z) =
      ENNReal.ofReal (singleGenreCdf N P β (z / score u genre)) := by
  have hratio : z / score u genre ∈ Set.Icc (0 : ℝ) ((N : ℝ) ^ β⁻¹) := by
    constructor
    · exact div_nonneg hz.1 hscore.le
    · rw [div_le_iff₀ hscore]
      simpa [mul_comm] using hz.2
  rw [singleGenreContentLaw_score_map_eq_scaledQualityLaw]
  have hscaled_meas : Measurable (fun q : ℝ => q * score u genre) :=
    measurable_id.mul measurable_const
  rw [Measure.map_apply hscaled_meas measurableSet_Iic]
  change singleGenreQualityLaw N P β
      {q : ℝ | q * score u genre ≤ z} = _
  have hpreimage :
      {q : ℝ | q * score u genre ≤ z} = Set.Iic (z / score u genre) := by
    ext q
    change q * score u genre ≤ z ↔ q ≤ z / score u genre
    rw [le_div_iff₀ hscore]
  rw [hpreimage, singleGenreQualityLaw_cdf_eq_singleGenreCdf_on_support hβ hratio]

/--
The scored content law has the clipped source CDF at every nonnegative score
threshold, including deviations above the quality support cap.
-/
theorem singleGenreContentLaw_score_map_cdf_eq_singleGenreCdf_of_nonneg
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β z : ℝ} {genre u : Content D}
    (hβ : 0 < β) (hscore : 0 < score u genre) (hz : 0 ≤ z) :
    Measure.map (fun p : Content D => score u p)
        (singleGenreContentLaw N P β genre) (Set.Iic z) =
      ENNReal.ofReal (singleGenreCdf N P β (z / score u genre)) := by
  rw [singleGenreContentLaw_score_map_eq_scaledQualityLaw]
  have hscaled_meas : Measurable (fun q : ℝ => q * score u genre) :=
    measurable_id.mul measurable_const
  rw [Measure.map_apply hscaled_meas measurableSet_Iic]
  change singleGenreQualityLaw N P β
      {q : ℝ | q * score u genre ≤ z} = _
  have hpreimage :
      {q : ℝ | q * score u genre ≤ z} = Set.Iic (z / score u genre) := by
    ext q
    change q * score u genre ≤ z ↔ q ≤ z / score u genre
    rw [le_div_iff₀ hscore]
  rw [hpreimage,
    singleGenreQualityLaw_cdf_eq_singleGenreCdf_of_nonneg hβ
      (div_nonneg hz hscore.le)]

/--
Every user with positive score against the genre has an atomless score law.
Consequently the concrete single-genre content law satisfies the score-level
nullness condition needed by the actual uniform-tie payoff semantics.
-/
theorem singleGenreContentLaw_score_map_noAtoms
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β : ℝ} {genre u : Content D}
    (hβ : 0 < β) (hscore : 0 < score u genre) :
    MeasureTheory.NoAtoms
      (Measure.map (fun p : Content D => score u p)
        (singleGenreContentLaw N P β genre)) := by
  rw [singleGenreContentLaw_score_map_eq_scaledQualityLaw]
  refine ⟨?_⟩
  intro z
  have hscaled_meas : Measurable (fun q : ℝ => q * score u genre) :=
    measurable_id.mul measurable_const
  rw [Measure.map_apply hscaled_meas (measurableSet_singleton z)]
  letI : MeasureTheory.NoAtoms (singleGenreQualityLaw N P β) :=
    singleGenreQualityLaw_noAtoms hβ
  have hsubsingleton :
      ((fun q : ℝ => q * score u genre) ⁻¹' ({z} : Set ℝ)).Subsingleton := by
    intro x hx y hy
    apply mul_right_cancel₀ (ne_of_gt hscore)
    exact (Set.mem_singleton_iff.mp hx).trans (Set.mem_singleton_iff.mp hy).symm
  exact hsubsingleton.measure_zero (singleGenreQualityLaw N P β)

/-- The content-level score fiber has zero probability in the positive-score regime. -/
theorem singleGenreContentLaw_score_level_measure_eq_zero
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β z : ℝ} {genre u : Content D}
    (hβ : 0 < β) (hscore : 0 < score u genre) :
    singleGenreContentLaw N P β genre
      {p : Content D | score u p = z} = 0 := by
  have hscore_meas : Measurable (fun p : Content D => score u p) :=
    measurable_score_content u
  change singleGenreContentLaw N P β genre
      ((fun p : Content D => score u p) ⁻¹' ({z} : Set ℝ)) = 0
  rw [← Measure.map_apply hscore_meas (measurableSet_singleton z)]
  exact (singleGenreContentLaw_score_map_noAtoms hβ hscore).measure_singleton z

/--
For the concrete single-genre law, actual uniform ties reduce to strict score
masses whenever every user scores the candidate genre positively.
-/
theorem expectedUsersWonAgainstSymmetricMixed_singleGenreContentLaw_eq_sum_strictScoreMass
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (hβ : 0 < β) (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (j : Fin P) (p : Content D) :
    ExpectedUsersWonAgainstSymmetricMixed users j
        p (singleGenreContentLaw N P β genre) =
      ∑ i : Fin N,
        ((singleGenreContentLaw N P β genre).real
          {q : Content D | score (users i) q < score (users i) p}) ^ (P - 1) := by
  letI : MeasureTheory.IsProbabilityMeasure
      (singleGenreContentLaw N P β genre) :=
    singleGenreContentLaw_isProbabilityMeasure N P β genre
  exact expectedUsersWonAgainstSymmetricMixed_eq_sum_strictScoreMass
    (users := users) (j := j) (μ := singleGenreContentLaw N P β genre) p
    (fun i => measurable_score_content (users i))
    (fun i z => singleGenreContentLaw_score_level_measure_eq_zero hβ (hscore i))

/--
The CDF-facing version of the preceding identity.  The equality of strict and
weak events is a theorem of the concrete law, so this remains an exact
uniform-tie payoff statement rather than a continuous-tie convention.
-/
theorem expectedUsersWonAgainstSymmetricMixed_singleGenreContentLaw_eq_sum_weakScoreMass
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (hβ : 0 < β) (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (j : Fin P) (p : Content D) :
    ExpectedUsersWonAgainstSymmetricMixed users j
        p (singleGenreContentLaw N P β genre) =
      ∑ i : Fin N,
        ((singleGenreContentLaw N P β genre).real
          {q : Content D | score (users i) q ≤ score (users i) p}) ^ (P - 1) := by
  rw [expectedUsersWonAgainstSymmetricMixed_singleGenreContentLaw_eq_sum_strictScoreMass
    hβ hscore]
  apply Finset.sum_congr rfl
  intro i _
  rw [show (singleGenreContentLaw N P β genre).real
        {q : Content D | score (users i) q < score (users i) p} =
      (singleGenreContentLaw N P β genre).real
        {q : Content D | score (users i) q ≤ score (users i) p} by
    exact congrArg ENNReal.toReal
      (score_lt_measure_eq_score_le_measure_of_score_level_null
        (measurable_score_content (users i))
        (fun z => singleGenreContentLaw_score_level_measure_eq_zero hβ (hscore i)) _)]

/--
The weak score mass of any feasible nonnegative deviation is the explicit
single-genre CDF evaluated at the deviation's score ratio.
-/
theorem singleGenreContentLaw_weakScoreMass_eq_singleGenreCdf
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β : ℝ} {genre u p : Content D}
    (hβ : 0 < β) (hu : NonnegativeContent u) (hp : NonnegativeContent p)
    (hscore : 0 < score u genre) :
    (singleGenreContentLaw N P β genre).real
      {q : Content D | score u q ≤ score u p} =
      singleGenreCdf N P β (score u p / score u genre) := by
  have hthreshold_nonneg : 0 ≤ score u p :=
    score_nonneg_of_nonnegative hu hp
  have hmeasure :
      singleGenreContentLaw N P β genre
        {q : Content D | score u q ≤ score u p} =
        ENNReal.ofReal (singleGenreCdf N P β (score u p / score u genre)) := by
    calc
      singleGenreContentLaw N P β genre
          {q : Content D | score u q ≤ score u p} =
          Measure.map (fun q : Content D => score u q)
            (singleGenreContentLaw N P β genre) (Set.Iic (score u p)) := by
        rw [Measure.map_apply (measurable_score_content u) measurableSet_Iic]
        rfl
      _ = ENNReal.ofReal (singleGenreCdf N P β (score u p / score u genre)) :=
        singleGenreContentLaw_score_map_cdf_eq_singleGenreCdf_of_nonneg
          hβ hscore hthreshold_nonneg
  rw [MeasureTheory.Measure.real, hmeasure,
    ENNReal.toReal_ofReal
      (singleGenreCdf_nonneg (div_nonneg hthreshold_nonneg hscore.le))]

/--
Actual uniform-tie payoff of every feasible nonnegative deviation against the
concrete single-genre law, written solely with the paper's CDF formula.
-/
theorem expectedUsersWonAgainstSymmetricMixed_singleGenreContentLaw_eq_cdfSum
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre p : Content D}
    (hβ : 0 < β) (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hp : NonnegativeContent p)
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (j : Fin P) :
    ExpectedUsersWonAgainstSymmetricMixed users j
        p (singleGenreContentLaw N P β genre) =
      ∑ i : Fin N,
        (singleGenreCdf N P β
          (score (users i) p / score (users i) genre)) ^ (P - 1) := by
  rw [expectedUsersWonAgainstSymmetricMixed_singleGenreContentLaw_eq_sum_weakScoreMass
    hβ hscore]
  apply Finset.sum_congr rfl
  intro i _
  rw [singleGenreContentLaw_weakScoreMass_eq_singleGenreCdf
    hβ (husers i) hp (hscore i)]

theorem singleGenreCdfRaw_power_eq_ratio {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β r : ℝ}
    (hr : 0 ≤ r) :
    (singleGenreCdfRaw N P β r) ^ ((P : ℝ) - 1) = (r ^ β) / (N : ℝ) := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hbase_nonneg : 0 ≤ (r ^ β) / (N : ℝ) :=
    div_nonneg (Real.rpow_nonneg hr β) hN_pos.le
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_ne : (P : ℝ) - 1 ≠ 0 := by
    have hP_real : (1 : ℝ) < (P : ℝ) := by exact_mod_cast hP_nat
    linarith
  unfold singleGenreCdfRaw
  exact Real.rpow_inv_rpow hbase_nonneg hP_ne

/--
The ordinary `(P-1)`-fold win probability of the clipped CDF is exactly the
clipped score-power ratio.  This aligns the finite-product payoff exponent
with the real-exponent algebra in Lemma `cdf`.
-/
theorem singleGenreCdf_natPow_eq_min_one_powerRatio
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)] {β r : ℝ}
    (hr : 0 ≤ r) :
    (singleGenreCdf N P β r) ^ (P - 1) =
      min 1 ((r ^ β) / (N : ℝ)) := by
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_sub_nonneg : 0 ≤ (P : ℝ) - 1 := by
    have hP_real : (1 : ℝ) < P := by exact_mod_cast hP_nat
    linarith
  have hP_cast : ((P - 1 : ℕ) : ℝ) = (P : ℝ) - 1 := by
    rw [Nat.cast_sub (R := ℝ) (le_of_lt hP_nat)]
    norm_num
  have hraw_nonneg : 0 ≤ singleGenreCdfRaw N P β r :=
    singleGenreCdfRaw_nonneg hr
  have hraw_pow :
      (singleGenreCdfRaw N P β r) ^ ((P : ℝ) - 1) = (r ^ β) / (N : ℝ) :=
    singleGenreCdfRaw_power_eq_ratio hr
  by_cases hraw : singleGenreCdfRaw N P β r ≤ 1
  · have hratio_le_one : (r ^ β) / (N : ℝ) ≤ 1 := by
      rw [← hraw_pow]
      exact Real.rpow_le_one hraw_nonneg hraw hP_sub_nonneg
    rw [singleGenreCdf_eq_raw_of_raw_le_one hraw,
      ← Real.rpow_natCast, hP_cast, hraw_pow, min_eq_right hratio_le_one]
  · have hone_le_raw : 1 ≤ singleGenreCdfRaw N P β r := le_of_not_ge hraw
    have hone_le_ratio : 1 ≤ (r ^ β) / (N : ℝ) := by
      rw [← hraw_pow]
      exact Real.one_le_rpow hone_le_raw hP_sub_nonneg
    rw [singleGenreCdf_eq_one_of_one_le_raw hone_le_raw,
      one_pow, min_eq_left hone_le_ratio]

theorem singleGenreCdf_power_eq_ratio_of_raw_le_one {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β r : ℝ}
    (hr : 0 ≤ r) (hraw : singleGenreCdfRaw N P β r ≤ 1) :
    (singleGenreCdf N P β r) ^ ((P : ℝ) - 1) = (r ^ β) / (N : ℝ) := by
  rw [singleGenreCdf_eq_raw_of_raw_le_one hraw]
  exact singleGenreCdfRaw_power_eq_ratio (N := N) (P := P) hr

theorem singleGenreCdf_power_eq_ratio_of_le_support_cap {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β r : ℝ}
    (hβ : 0 < β) (hr : 0 ≤ r) (hle : r ≤ (N : ℝ) ^ β⁻¹) :
    (singleGenreCdf N P β r) ^ ((P : ℝ) - 1) = (r ^ β) / (N : ℝ) := by
  rw [singleGenreCdf_eq_raw_of_le_support_cap hβ hr hle]
  exact singleGenreCdfRaw_power_eq_ratio (N := N) (P := P) hr

/--
Interior zero-profit identity behind Lemma `cdf`: while the raw CDF formula is
below one, the expected assigned-user term `N F(r)^(P-1)` exactly matches
production cost `r^β`.
-/
theorem singleGenreCdf_zero_profit_identity_of_raw_le_one {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β r : ℝ}
    (hr : 0 ≤ r) (hraw : singleGenreCdfRaw N P β r ≤ 1) :
    (N : ℝ) * (singleGenreCdf N P β r) ^ ((P : ℝ) - 1) - r ^ β = 0 := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hcdf_eq : singleGenreCdf N P β r = singleGenreCdfRaw N P β r :=
    singleGenreCdf_eq_raw_of_raw_le_one hraw
  have hpow :
      (singleGenreCdf N P β r) ^ ((P : ℝ) - 1) = (r ^ β) / (N : ℝ) := by
    rw [hcdf_eq]
    exact singleGenreCdfRaw_power_eq_ratio (N := N) (P := P) hr
  rw [hpow]
  field_simp [ne_of_gt hN_pos]
  ring

theorem singleGenreCdf_zero_profit_identity_of_le_support_cap {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β r : ℝ}
    (hβ : 0 < β) (hr : 0 ≤ r) (hle : r ≤ (N : ℝ) ^ β⁻¹) :
    (N : ℝ) * (singleGenreCdf N P β r) ^ ((P : ℝ) - 1) - r ^ β = 0 := by
  have hraw : singleGenreCdfRaw N P β r ≤ 1 := by
    rw [← singleGenreCdf_eq_raw_of_le_support_cap (N := N) (P := P) hβ hr hle]
    exact singleGenreCdf_le_one
  exact singleGenreCdf_zero_profit_identity_of_raw_le_one hr hraw

/--
Every topological-support action of the concrete single-genre content law earns
zero actual mixed payoff.  This combines the support-range argument, the exact
uniform-tie CDF payoff formula, and the source CDF zero-profit identity.
-/
theorem singleGenreContentLaw_support_action_sourceMixedPurePayoff_eq_zero
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre p : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (j : Fin P) (hp : p ∈ (singleGenreContentLaw N P β genre).support) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β) p
      (singleGenreContentLaw N P β genre) = 0 := by
  rcases singleGenreContentLaw_support_subset_range genre hβ hp with ⟨x, rfl⟩
  let q : ℝ := singleGenreQualitySample N P β x
  change SourceMixedPurePayoff
    (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β)
    (scaleContent q genre) (singleGenreContentLaw N P β genre) = 0
  have hq_nonneg : 0 ≤ q := by
    dsimp [q]
    exact singleGenreQualitySample_nonnegative N P β x
  have hq_cap : q ≤ (N : ℝ) ^ β⁻¹ := by
    dsimp [q]
    exact singleGenreQualitySample_le_supportCap hβ x
  have hcontent_nonnegative : NonnegativeContent (scaleContent q genre) :=
    scaleContent_nonnegative hq_nonneg hgenre_nonnegative
  have hratio : ∀ i : Fin N,
      score (users i) (scaleContent q genre) / score (users i) genre = q := by
    intro i
    rw [score_scaleContent]
    field_simp [ne_of_gt (hscore i)]
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_cast : ((P - 1 : ℕ) : ℝ) = (P : ℝ) - 1 := by
    rw [Nat.cast_sub (R := ℝ) (le_of_lt hP_nat)]
    norm_num
  have hpow_cast :
      (singleGenreCdf N P β q) ^ (P - 1) =
        (singleGenreCdf N P β q) ^ ((P : ℝ) - 1) := by
    rw [← Real.rpow_natCast, hP_cast]
  have hsum :
      (∑ i : Fin N,
        (singleGenreCdf N P β
          (score (users i) (scaleContent q genre) / score (users i) genre)) ^
          (P - 1)) =
        (N : ℝ) * (singleGenreCdf N P β q) ^ ((P : ℝ) - 1) := by
    simp_rw [hratio]
    rw [show (∑ _i : Fin N, (singleGenreCdf N P β q) ^ (P - 1)) =
        (N : ℝ) * (singleGenreCdf N P β q) ^ (P - 1) by
      simp [Finset.sum_const, nsmul_eq_mul]]
    rw [hpow_cast]
  have hcost : normRpowCost ν β (scaleContent q genre) = q ^ β := by
    unfold normRpowCost
    rw [ν.scale_nonneg hq_nonneg, hgenre_norm, mul_one]
  unfold SourceMixedPurePayoff
  rw [expectedUsersWonAgainstSymmetricMixed_singleGenreContentLaw_eq_cdfSum
    hβ husers hcontent_nonnegative hscore j, hsum, hcost]
  exact singleGenreCdf_zero_profit_identity_of_le_support_cap hβ hq_nonneg hq_cap

/--
Proposition `zeroutilitysinglegenre` for the constructed ray equilibrium: the
zero-quality support action has exactly zero actual uniform-tie mixed payoff.
This is a direct support/payoff conclusion, not an assumed scalar CDF formula.
-/
theorem singleGenreContentLaw_zero_sourceMixedPurePayoff_eq_zero
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D} {genre : Content D}
    (ν : SourceNorm D) (hβ : 0 < β)
    (hgenre_norm : ν.norm genre = 1)
    (hgenre_nonnegative : NonnegativeContent genre)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (hscore : ∀ i : Fin N, 0 < score (users i) genre)
    (j : Fin P) :
    SourceMixedPurePayoff
      (ExpectedUsersWonAgainstSymmetricMixed users j) (normRpowCost ν β)
      (0 : Content D) (singleGenreContentLaw N P β genre) = 0 :=
  singleGenreContentLaw_support_action_sourceMixedPurePayoff_eq_zero
    ν hβ hgenre_norm hgenre_nonnegative husers hscore j
    (zero_mem_singleGenreContentLaw_support hβ genre)

/--
Corollary `onepopulation`, quality-CDF formula surface: in the homogeneous-user
case, the one-dimensional quality distribution reaches one at the source support
cap `N^(1 / β)`, agrees with Lemma `cdf`'s raw power law below that cap, and is
clipped to one above it.
-/
theorem onePopulation_quality_cdf_formula_and_support_cap {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β : ℝ}
    (hβ : 0 < β) :
    singleGenreCdf N P β ((N : ℝ) ^ β⁻¹) = 1 ∧
      (∀ r : ℝ, 0 ≤ r → r ≤ (N : ℝ) ^ β⁻¹ →
        singleGenreCdf N P β r =
          ((r ^ β) / (N : ℝ)) ^ (((P : ℝ) - 1)⁻¹)) ∧
      (∀ r : ℝ, (N : ℝ) ^ β⁻¹ ≤ r →
        singleGenreCdf N P β r = 1) := by
  refine ⟨singleGenreCdf_at_support_cap hβ, ?_, ?_⟩
  · intro r hr hle
    simpa [singleGenreCdfRaw] using
      singleGenreCdf_eq_raw_of_le_support_cap (N := N) (P := P) hβ hr hle
  · intro r hcap
    exact singleGenreCdf_eq_one_of_support_cap_le hβ hcap

theorem min_one_mul_div_eq_min_inv {a t : ℝ} (ht : 0 < t) :
    min 1 (t * a) / t = min (1 / t) a := by
  by_cases h : 1 ≤ t * a
  · have hleft : min 1 (t * a) = 1 := min_eq_left h
    have hright_arg : 1 / t ≤ a := by
      rw [div_le_iff₀ ht]
      rwa [mul_comm]
    have hright : min (1 / t) a = 1 / t := min_eq_left hright_arg
    rw [hleft, hright]
  · have hle : t * a ≤ 1 := le_of_not_ge h
    have hleft : min 1 (t * a) = t * a := min_eq_right hle
    have hright_arg : a ≤ 1 / t := by
      rw [le_div_iff₀ ht]
      rwa [mul_comm]
    have hright : min (1 / t) a = a := min_eq_right hright_arg
    rw [hleft, hright]
    field_simp [ne_of_gt ht]

theorem min_one_mul_div_antitone {a t s : ℝ}
    (ht : 0 < t) (hts : t ≤ s) :
    min 1 (s * a) / s ≤ min 1 (t * a) / t := by
  have hs : 0 < s := lt_of_lt_of_le ht hts
  rw [min_one_mul_div_eq_min_inv hs, min_one_mul_div_eq_min_inv ht]
  exact min_le_min (one_div_le_one_div_of_le ht hts) le_rfl

theorem sum_min_one_mul_div_antitone {N : ℕ}
    (a : Fin N → ℝ) {t s : ℝ} (ht : 0 < t) (hts : t ≤ s) :
    (∑ i : Fin N, min 1 (s * a i) / s) ≤
      ∑ i : Fin N, min 1 (t * a i) / t := by
  exact Finset.sum_le_sum
    (fun i _hi => min_one_mul_div_antitone (a := a i) ht hts)

/-- Source optimization-program objective `∑ y'_i / y_i`. -/
noncomputable def ratioObjective {N : ℕ} (y y' : Fin N → ℝ) : ℝ :=
  ∑ i : Fin N, y' i / y i

/--
Radial objective from the proof of Lemma `optsingledirection` after changing
variables to `t = r^β`: `sum_i min(1, t a_i) / t - 1`.
-/
noncomputable def singleGenreRadialMinObjective {N : ℕ}
    (a : Fin N → ℝ) (t : ℝ) : ℝ :=
  (∑ i : Fin N, min 1 (t * a i) / t) - 1

theorem singleGenreRadialMinObjective_antitone {N : ℕ}
    (a : Fin N → ℝ) {t s : ℝ} (ht : 0 < t) (hts : t ≤ s) :
    singleGenreRadialMinObjective a s ≤ singleGenreRadialMinObjective a t := by
  unfold singleGenreRadialMinObjective
  exact sub_le_sub_right (sum_min_one_mul_div_antitone a ht hts) 1

theorem singleGenreRadialMinObjective_eq_sum_of_unclipped {N : ℕ}
    (a : Fin N → ℝ) {t : ℝ}
    (ht : t ≠ 0) (hclip : ∀ i, t * a i ≤ 1) :
    singleGenreRadialMinObjective a t = (∑ i : Fin N, a i) - 1 := by
  unfold singleGenreRadialMinObjective
  congr 1
  refine Finset.sum_congr rfl ?_
  intro i _hi
  rw [min_eq_right (hclip i)]
  field_simp [ht]

theorem exists_positive_unclipped_scale {N : ℕ} (a : Fin N → ℝ) :
    ∃ t : ℝ, 0 < t ∧ ∀ i : Fin N, t * a i ≤ 1 := by
  let B : ℝ := ∑ i : Fin N, |a i|
  have hB_nonneg : 0 ≤ B := by
    dsimp [B]
    exact Finset.sum_nonneg (fun i _hi => abs_nonneg (a i))
  refine ⟨(1 + B)⁻¹, ?_, ?_⟩
  · exact inv_pos.mpr (by linarith)
  · intro i
    have hai_le_B : a i ≤ B := by
      have h_abs_le_sum : |a i| ≤ B := by
        dsimp [B]
        exact Finset.single_le_sum (fun j _hj => abs_nonneg (a j))
          (Finset.mem_univ i)
      exact le_trans (le_abs_self (a i)) h_abs_le_sum
    have hmul_le : (1 + B)⁻¹ * a i ≤ (1 + B)⁻¹ * B :=
      mul_le_mul_of_nonneg_left hai_le_B (inv_nonneg.mpr (by linarith))
    have hB_le_one : (1 + B)⁻¹ * B ≤ 1 := by
      field_simp [show (1 + B) ≠ 0 by linarith]
      nlinarith [hB_nonneg]
    exact le_trans hmul_le hB_le_one

/--
Single-genre normalized deviation payoff from the proof of Lemma
`optsingledirection`: after substituting the CDF formula, a deviation row
`y'` has normalized payoff `ratioObjective y y' / N - 1`.
-/
noncomputable def singleGenreNormalizedDeviation {N : ℕ}
    (y y' : Fin N → ℝ) : ℝ :=
  ratioObjective y y' / (N : ℝ) - 1

/-- Lemma `optsingledirection` ratio-objective condition over a feasible row set. -/
def SingleGenreDirectionCondition {N : ℕ}
    (R : Set (Fin N → ℝ)) (y : Fin N → ℝ) : Prop :=
  ∀ y' ∈ R, ratioObjective y y' ≤ (N : ℝ)

/-- The ratio direction condition is preserved by convexifying its row set. -/
theorem singleGenreDirectionCondition_convexHull {N : ℕ}
    {S : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hcondition : SingleGenreDirectionCondition S y) :
    SingleGenreDirectionCondition (convexHull ℝ S) y := by
  have hconvex : Convex ℝ {z : Fin N → ℝ | ratioObjective y z ≤ (N : ℝ)} := by
    rw [convex_iff_add_mem]
    intro x hx z hz a b ha hb hab
    change ratioObjective y (a • x + b • z) ≤ (N : ℝ)
    have hlinear : ratioObjective y (a • x + b • z) =
        a * ratioObjective y x + b * ratioObjective y z := by
      unfold ratioObjective
      simp only [Pi.smul_apply, smul_eq_mul, Pi.add_apply, add_div, mul_div_assoc]
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    rw [hlinear]
    calc
      a * ratioObjective y x + b * ratioObjective y z ≤
          a * (N : ℝ) + b * (N : ℝ) :=
        add_le_add (mul_le_mul_of_nonneg_left hx ha)
          (mul_le_mul_of_nonneg_left hz hb)
      _ = (N : ℝ) := by rw [← add_mul, hab, one_mul]
  exact convexHull_min hcondition hconvex

/-- No positive normalized deviations against a feasible row set. -/
def NoPositiveSingleGenreNormalizedDeviation {N : ℕ}
    (R : Set (Fin N → ℝ)) (y : Fin N → ℝ) : Prop :=
  ∀ y' ∈ R, singleGenreNormalizedDeviation y y' ≤ 0

/--
Radial no-deviation condition from Lemma `optsingledirection`: after CDF
substitution, every feasible row and every positive radius-power `t=r^β` has
nonpositive radial payoff.
-/
def NoPositiveSingleGenreRadialDeviations {N : ℕ}
    (R : Set (Fin N → ℝ)) (y : Fin N → ℝ) : Prop :=
  ∀ y' ∈ R, ∀ t : ℝ, 0 < t →
    singleGenreRadialMinObjective (fun i => (y' i / y i) / (N : ℝ)) t ≤ 0

theorem singleGenreRadialMinObjective_eq_normalizedDeviation_of_unclipped {N : ℕ}
    [Nonempty (Fin N)] {y y' : Fin N → ℝ} {t : ℝ}
    (ht : t ≠ 0)
    (hclip : ∀ i, t * ((y' i / y i) / (N : ℝ)) ≤ 1) :
    singleGenreRadialMinObjective (fun i => (y' i / y i) / (N : ℝ)) t =
      singleGenreNormalizedDeviation y y' := by
  rw [singleGenreRadialMinObjective_eq_sum_of_unclipped
    (fun i => (y' i / y i) / (N : ℝ)) ht hclip]
  unfold singleGenreNormalizedDeviation ratioObjective
  rw [Finset.sum_div]

theorem singleGenreNormalizedDeviation_nonpos_iff_ratio_le_card {N : ℕ}
    [Nonempty (Fin N)] {y y' : Fin N → ℝ} :
    singleGenreNormalizedDeviation y y' ≤ 0 ↔
      ratioObjective y y' ≤ (N : ℝ) := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  unfold singleGenreNormalizedDeviation
  constructor
  · intro h
    rw [sub_le_iff_le_add] at h
    have hdiv : ratioObjective y y' / (N : ℝ) ≤ 1 := by simpa using h
    rw [div_le_one hN_pos] at hdiv
    simpa using hdiv
  · intro h
    rw [sub_le_iff_le_add]
    have hdiv : ratioObjective y y' / (N : ℝ) ≤ 1 := by
      rw [div_le_one hN_pos]
      exact h
    simpa using hdiv

theorem noPositiveSingleGenreNormalizedDeviation_iff_directionCondition {N : ℕ}
    [Nonempty (Fin N)] {R : Set (Fin N → ℝ)} {y : Fin N → ℝ} :
    NoPositiveSingleGenreNormalizedDeviation R y ↔
      SingleGenreDirectionCondition R y := by
  constructor
  · intro h y' hy'
    exact (singleGenreNormalizedDeviation_nonpos_iff_ratio_le_card
      (y := y) (y' := y')).mp (h y' hy')
  · intro h y' hy'
    exact (singleGenreNormalizedDeviation_nonpos_iff_ratio_le_card
      (y := y) (y' := y')).mpr (h y' hy')

theorem noPositiveSingleGenreRadialDeviations_iff_directionCondition {N : ℕ}
    [Nonempty (Fin N)] {R : Set (Fin N → ℝ)} {y : Fin N → ℝ} :
    NoPositiveSingleGenreRadialDeviations R y ↔
      SingleGenreDirectionCondition R y := by
  constructor
  · intro h y' hy'
    rcases exists_positive_unclipped_scale
        (fun i => (y' i / y i) / (N : ℝ)) with
      ⟨t, ht_pos, hclip⟩
    have hnorm : singleGenreNormalizedDeviation y y' ≤ 0 := by
      rw [← singleGenreRadialMinObjective_eq_normalizedDeviation_of_unclipped
        (y := y) (y' := y') (t := t) (ne_of_gt ht_pos) hclip]
      exact h y' hy' t ht_pos
    exact (singleGenreNormalizedDeviation_nonpos_iff_ratio_le_card
      (y := y) (y' := y')).mp hnorm
  · intro h y' hy' t ht_pos
    let a : Fin N → ℝ := fun i => (y' i / y i) / (N : ℝ)
    rcases exists_positive_unclipped_scale a with ⟨t0, ht0_pos, hclip0⟩
    have hnorm : singleGenreNormalizedDeviation y y' ≤ 0 :=
      (singleGenreNormalizedDeviation_nonpos_iff_ratio_le_card
        (y := y) (y' := y')).mpr (h y' hy')
    by_cases hle : t ≤ t0
    · have hclip_t : ∀ i, t * a i ≤ 1 := by
        intro i
        by_cases hai : 0 ≤ a i
        · exact le_trans (mul_le_mul_of_nonneg_right hle hai) (hclip0 i)
        · have hnonpos : t * a i ≤ 0 :=
            mul_nonpos_of_nonneg_of_nonpos ht_pos.le (le_of_not_ge hai)
          linarith
      rw [singleGenreRadialMinObjective_eq_normalizedDeviation_of_unclipped
        (y := y) (y' := y') (t := t) (ne_of_gt ht_pos) hclip_t]
      exact hnorm
    · have ht0_le : t0 ≤ t := le_of_not_ge hle
      have ht0_obj : singleGenreRadialMinObjective a t0 ≤ 0 := by
        rw [singleGenreRadialMinObjective_eq_normalizedDeviation_of_unclipped
          (y := y) (y' := y') (t := t0) (ne_of_gt ht0_pos) hclip0]
        exact hnorm
      exact le_trans (singleGenreRadialMinObjective_antitone a ht0_pos ht0_le) ht0_obj

/--
The direction condition bounds the clipped-CDF numerator at every positive
radial scale.  This is the algebraic payoff form used in the concrete
single-genre equilibrium construction.
-/
theorem sum_min_one_mul_le_radius_of_singleGenreDirectionCondition {N : ℕ}
    [Nonempty (Fin N)] {R : Set (Fin N → ℝ)} {y y' : Fin N → ℝ} {t : ℝ}
    (hcond : SingleGenreDirectionCondition R y) (hy' : y' ∈ R) (ht : 0 < t) :
    (∑ i : Fin N, min 1 (t * ((y' i / y i) / (N : ℝ)))) ≤ t := by
  have hradial :
      singleGenreRadialMinObjective
        (fun i => (y' i / y i) / (N : ℝ)) t ≤ 0 :=
    (noPositiveSingleGenreRadialDeviations_iff_directionCondition.mpr hcond)
      y' hy' t ht
  unfold singleGenreRadialMinObjective at hradial
  rw [← Finset.sum_div] at hradial
  have hdiv :
      (∑ i : Fin N, min 1 (t * ((y' i / y i) / (N : ℝ)))) / t ≤ 1 := by
    linarith
  simpa only [one_mul] using (div_le_iff₀ ht).mp hdiv

/-- Coordinate product `∏ᵢ yᵢ`, used in Theorem `singlegenre` and Lemma `supinf`. -/
noncomputable def coordinateProduct {N : ℕ} (y : Fin N → ℝ) : ℝ :=
  ∏ i : Fin N, y i

/-- Replicating each of two row coordinates `K` times raises its product to `K`. -/
theorem coordinateProduct_replicateTwoPopulationRowLinear
    (K : ℕ) (z : Fin 2 → ℝ) :
    coordinateProduct (replicateTwoPopulationRowLinear K z) =
      (coordinateProduct z) ^ K := by
  classical
  unfold coordinateProduct
  calc
    (∏ i : Fin (2 * K), z (finProdFinEquiv.symm i).1) =
        ∏ x : Fin 2 × Fin K, z x.1 := by
      rw [← Equiv.prod_comp (finProdFinEquiv (m := 2) (n := K))
        (fun i : Fin (2 * K) => z (finProdFinEquiv.symm i).1)]
      simp
    _ = ∏ x : Fin 2, ∏ _k : Fin K, z x := Fintype.prod_prod_type _
    _ = ∏ x : Fin 2, (z x) ^ K := by simp
    _ = (∏ x : Fin 2, z x) ^ K := by
      rw [Finset.prod_pow]

/-- Coordinate products commute with a fixed real power on nonnegative rows. -/
theorem coordinateProduct_rpow {N : ℕ} (y : Fin N → ℝ) (β : ℝ)
    (hy : ∀ i, 0 ≤ y i) :
    coordinateProduct (fun i => (y i) ^ β) = (coordinateProduct y) ^ β := by
  unfold coordinateProduct
  exact AppliedModelingLib.Optimization.finset_prod_coordinatewise_rpow
    Finset.univ y β (fun i _ => hy i)

/--
Finite unweighted AM--GM in coordinate-product form.  This is the product
bound used by Corollary `beta` before specializing the row entries to powered
user scores.
-/
theorem coordinateProduct_le_mean_rpow_card {N : ℕ} [Nonempty (Fin N)]
    {y : Fin N → ℝ} (hy_nonnegative : ∀ i, 0 ≤ y i) :
    coordinateProduct y ≤ ((∑ i : Fin N, y i) / (N : ℝ)) ^ (N : ℝ) := by
  classical
  have hNpos_nat : 0 < N := by
    simpa using (Fintype.card_pos_iff.mpr (inferInstance : Nonempty (Fin N)))
  have hNpos : 0 < (N : ℝ) := by
    exact_mod_cast hNpos_nat
  have hNne : (N : ℝ) ≠ 0 := ne_of_gt hNpos
  have hprod_nonnegative : 0 ≤ ∏ i : Fin N, y i :=
    Finset.prod_nonneg fun i _hi => hy_nonnegative i
  have hamgm := Real.geom_mean_le_arith_mean
    (Finset.univ : Finset (Fin N)) (fun _ : Fin N => (1 : ℝ)) y
    (fun _ _ => zero_le_one) (by simpa using hNpos)
    (fun i _ => hy_nonnegative i)
  have hgeom :
      (∏ i : Fin N, y i) ^ ((N : ℝ)⁻¹) ≤
        (∑ i : Fin N, y i) / (N : ℝ) := by
    simpa using hamgm
  have hraised := Real.rpow_le_rpow
    (Real.rpow_nonneg hprod_nonnegative _) hgeom hNpos.le
  have hleft : ((∏ i : Fin N, y i) ^ ((N : ℝ)⁻¹)) ^ (N : ℝ) =
      ∏ i : Fin N, y i := by
    rw [Real.rpow_inv_rpow hprod_nonnegative hNne]
  unfold coordinateProduct
  rw [← hleft]
  exact hraised

/--
Powered finite AM--GM bound.  If nonnegative row entries have total at most
`Z`, their coordinatewise `beta`-power row has product at most the `N*beta`
power of the mean bound.  This is the analytic source-side inequality in
Corollary `beta`.
-/
theorem coordinateProduct_rpow_le_meanBound_rpow_card_mul
    {N : ℕ} [Nonempty (Fin N)] {a : Fin N → ℝ} {β Z : ℝ}
    (ha_nonnegative : ∀ i, 0 ≤ a i) (hβ_nonnegative : 0 ≤ β)
    (hsum_le : (∑ i : Fin N, a i) ≤ Z) :
    coordinateProduct (fun i => (a i) ^ β) ≤
      (Z / (N : ℝ)) ^ ((N : ℝ) * β) := by
  classical
  have hNpos_nat : 0 < N := by
    simpa using (Fintype.card_pos_iff.mpr (inferInstance : Nonempty (Fin N)))
  have hNpos : 0 < (N : ℝ) := by
    exact_mod_cast hNpos_nat
  have hsum_nonnegative : 0 ≤ ∑ i : Fin N, a i :=
    Finset.sum_nonneg fun i _hi => ha_nonnegative i
  have hmean_nonnegative : 0 ≤ (∑ i : Fin N, a i) / (N : ℝ) :=
    div_nonneg hsum_nonnegative hNpos.le
  have hmean_le : (∑ i : Fin N, a i) / (N : ℝ) ≤ Z / (N : ℝ) :=
    (div_le_div_iff_of_pos_right hNpos).mpr hsum_le
  have hprod_nonnegative : 0 ≤ ∏ i : Fin N, a i :=
    Finset.prod_nonneg fun i _hi => ha_nonnegative i
  have hbase : coordinateProduct (fun i => (a i) ^ β) ≤
      (((∑ i : Fin N, a i) / (N : ℝ)) ^ (N : ℝ)) ^ β := by
    unfold coordinateProduct
    rw [Real.finset_prod_rpow (Finset.univ : Finset (Fin N)) a
      (fun i _hi => ha_nonnegative i) β]
    exact Real.rpow_le_rpow hprod_nonnegative
      (coordinateProduct_le_mean_rpow_card ha_nonnegative) hβ_nonnegative
  have hexponent_nonnegative : 0 ≤ (N : ℝ) * β :=
    mul_nonneg hNpos.le hβ_nonnegative
  calc
    coordinateProduct (fun i => (a i) ^ β) ≤
        (((∑ i : Fin N, a i) / (N : ℝ)) ^ (N : ℝ)) ^ β := hbase
    _ = ((∑ i : Fin N, a i) / (N : ℝ)) ^ ((N : ℝ) * β) := by
      rw [Real.rpow_mul hmean_nonnegative]
    _ ≤ (Z / (N : ℝ)) ^ ((N : ℝ) * β) :=
      Real.rpow_le_rpow hmean_nonnegative hmean_le hexponent_nonnegative

/-- Supremum of the coordinate-product objective over a source row set. -/
noncomputable def coordinateProductSup {N : ℕ} (S : Set (Fin N → ℝ)) : ℝ :=
  sSup (coordinateProduct '' S)

def SingleGenreProductSupCondition {N : ℕ} (S : Set (Fin N → ℝ)) : Prop :=
  coordinateProductSup S = coordinateProductSup (convexHull ℝ S)

/-- Log Nash-social-welfare objective `∑ᵢ log yᵢ` for positive user-value rows. -/
noncomputable def nashLogObjective {N : ℕ} (y : Fin N → ℝ) : ℝ :=
  ∑ i : Fin N, Real.log (y i)

/--
One-dimensional segment through two user-value rows, used to take the
directional derivative of the log Nash objective.
-/
noncomputable def nashLogSegmentObjective {N : ℕ}
    (y y' : Fin N → ℝ) (t : ℝ) : ℝ :=
  ∑ i : Fin N, Real.log (y i + t * (y' i - y i))

/--
First-order inequality from the source proof of Theorem `singlegenre`: for a
candidate row `y`, every feasible perturbation `y'` has nonpositive directional
derivative for the log Nash objective.
-/
def NashLogFirstOrderCondition {N : ℕ}
    (R : Set (Fin N → ℝ)) (y : Fin N → ℝ) : Prop :=
  ∀ y' ∈ R, (∑ i : Fin N, (y' i - y i) / y i) ≤ 0

@[simp] theorem nashLogSegmentObjective_zero {N : ℕ}
    (y y' : Fin N → ℝ) :
    nashLogSegmentObjective y y' 0 = nashLogObjective y := by
  simp [nashLogSegmentObjective, nashLogObjective]

theorem hasDerivAt_nashLogSegmentObjective_zero {N : ℕ}
    {y y' : Fin N → ℝ} (hy : ∀ i, y i ≠ 0) :
    HasDerivAt (fun t : ℝ => nashLogSegmentObjective y y' t)
      (∑ i : Fin N, (y' i - y i) / y i) 0 := by
  unfold nashLogSegmentObjective
  refine HasDerivAt.fun_sum ?_
  intro i _hi
  have hlin :
      HasDerivAt (fun t : ℝ => y i + t * (y' i - y i)) (y' i - y i) 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).mul_const (y' i - y i)).const_add (y i)
  have hnonzero : y i + 0 * (y' i - y i) ≠ 0 := by
    simpa using hy i
  simpa using hlin.log hnonzero

theorem derivative_nonpos_of_right_local_max
    {f : ℝ → ℝ} {derivativeValue : ℝ}
    (hderiv : HasDerivAt f derivativeValue 0)
    (hmax : ∀ ε : ℝ, 0 < ε → ε < 1 → f ε ≤ f 0) :
    derivativeValue ≤ 0 := by
  by_contra hnot
  have hpos : 0 < derivativeValue := lt_of_not_ge hnot
  rcases exists_pos_right_improvement_of_hasDerivAt_pos_lt
      (f := f) (x := 0) hderiv hpos zero_lt_one with
    ⟨ε, hε_pos, hε_lt, himprove⟩
  have hle : f ε ≤ f 0 := by
    simpa using hmax ε hε_pos hε_lt
  exact not_lt_of_ge hle (by simpa using himprove)

theorem nashLogFirstOrderCondition_of_segment_local_max {N : ℕ}
    {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hy : ∀ i, y i ≠ 0)
    (hseg :
      ∀ y' ∈ R, ∀ ε : ℝ, 0 < ε → ε < 1 →
        nashLogSegmentObjective y y' ε ≤ nashLogObjective y) :
    NashLogFirstOrderCondition R y := by
  intro y' hy'
  exact derivative_nonpos_of_right_local_max
    (hasDerivAt_nashLogSegmentObjective_zero (y := y) (y' := y') hy)
    (by
      intro ε hε_pos hε_lt
      simpa using hseg y' hy' ε hε_pos hε_lt)

theorem nashLogFirstOrderCondition_of_convex_nashLogMaximizer {N : ℕ}
    {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hconv : Convex ℝ R)
    (hmax : IsMaximizerOn (fun z => z ∈ R) nashLogObjective y)
    (hy : ∀ i, y i ≠ 0) :
    NashLogFirstOrderCondition R y := by
  refine nashLogFirstOrderCondition_of_segment_local_max hy ?_
  intro y' hy' ε hε_pos hε_lt
  have hε_nonneg : 0 ≤ ε := le_of_lt hε_pos
  have hone_minus_nonneg : 0 ≤ 1 - ε := sub_nonneg.mpr (le_of_lt hε_lt)
  have hsum : (1 - ε) + ε = (1 : ℝ) := by ring
  let z : Fin N → ℝ := fun i => y i + ε * (y' i - y i)
  have hz_mem : z ∈ R := by
    have hconv_mem :
        (1 - ε) • y + ε • y' ∈ R :=
      hconv hmax.1 hy' hone_minus_nonneg hε_nonneg hsum
    convert hconv_mem using 1
    ext i
    simp [z]
    ring
  have hle : nashLogObjective z ≤ nashLogObjective y :=
    hmax.2 z hz_mem
  simpa [nashLogSegmentObjective, z] using hle

theorem ratioObjective_self_of_pos {N : ℕ} {y : Fin N → ℝ}
    (hy : ∀ i, y i ≠ 0) :
    ratioObjective y y = (N : ℝ) := by
  unfold ratioObjective
  calc
    (∑ i : Fin N, y i / y i) = ∑ _i : Fin N, (1 : ℝ) := by
      refine Finset.sum_congr rfl ?_
      intro i _
      exact div_self (hy i)
    _ = (N : ℝ) := by
      simp

theorem singleGenreNormalizedDeviation_self_eq_zero {N : ℕ} [Nonempty (Fin N)]
    {y : Fin N → ℝ} (hy : ∀ i, y i ≠ 0) :
    singleGenreNormalizedDeviation y y = 0 := by
  unfold singleGenreNormalizedDeviation
  rw [ratioObjective_self_of_pos hy]
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_ne : (N : ℝ) ≠ 0 := by exact_mod_cast (ne_of_gt hN_nat)
  field_simp [hN_ne]
  ring

theorem nashLogFirstOrder_sum_eq_ratioObjective_sub_card {N : ℕ}
    {y y' : Fin N → ℝ} (hy : ∀ i, y i ≠ 0) :
    (∑ i : Fin N, (y' i - y i) / y i) =
      ratioObjective y y' - (N : ℝ) := by
  unfold ratioObjective
  calc
    (∑ i : Fin N, (y' i - y i) / y i)
        = ∑ i : Fin N, (y' i / y i - y i / y i) := by
          refine Finset.sum_congr rfl ?_
          intro i _hi
          field_simp [hy i]
    _ = (∑ i : Fin N, y' i / y i) -
          ∑ i : Fin N, y i / y i := by
          rw [Finset.sum_sub_distrib]
    _ = (∑ i : Fin N, y' i / y i) - (N : ℝ) := by
          congr 1
          calc
            (∑ i : Fin N, y i / y i) = ∑ _i : Fin N, (1 : ℝ) := by
              refine Finset.sum_congr rfl ?_
              intro i _hi
              exact div_self (hy i)
            _ = (N : ℝ) := by simp

/--
Source proof bridge for Theorem `singlegenre`: the first-order condition for
the log Nash objective is exactly the ratio-objective condition
`∑ᵢ y'_i / yᵢ ≤ N`.
-/
theorem nashLogFirstOrderCondition_iff_directionCondition {N : ℕ}
    {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hy : ∀ i, y i ≠ 0) :
    NashLogFirstOrderCondition R y ↔ SingleGenreDirectionCondition R y := by
  constructor
  · intro h y' hy'
    have hfo := h y' hy'
    rw [nashLogFirstOrder_sum_eq_ratioObjective_sub_card (y := y) (y' := y') hy] at hfo
    linarith
  · intro h y' hy'
    have hratio := h y' hy'
    rw [nashLogFirstOrder_sum_eq_ratioObjective_sub_card (y := y) (y' := y') hy]
    linarith

theorem singleGenreDirectionCondition_of_convex_nashLogMaximizer {N : ℕ}
    {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hconv : Convex ℝ R)
    (hmax : IsMaximizerOn (fun z => z ∈ R) nashLogObjective y)
    (hy : ∀ i, y i ≠ 0) :
    SingleGenreDirectionCondition R y :=
  (nashLogFirstOrderCondition_iff_directionCondition hy).mp
    (nashLogFirstOrderCondition_of_convex_nashLogMaximizer hconv hmax hy)

theorem noPositiveSingleGenreRadialDeviations_of_convex_nashLogMaximizer {N : ℕ}
    [Nonempty (Fin N)]
    {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hconv : Convex ℝ R)
    (hmax : IsMaximizerOn (fun z => z ∈ R) nashLogObjective y)
    (hy : ∀ i, y i ≠ 0) :
    NoPositiveSingleGenreRadialDeviations R y :=
  (noPositiveSingleGenreRadialDeviations_iff_directionCondition).mpr
    (singleGenreDirectionCondition_of_convex_nashLogMaximizer hconv hmax hy)

/-- On nonzero rows, the log Nash objective is the log of the coordinate product. -/
theorem nashLogObjective_eq_log_coordinateProduct {N : ℕ} {y : Fin N → ℝ}
    (hy : ∀ i, y i ≠ 0) :
    nashLogObjective y = Real.log (coordinateProduct y) := by
  unfold nashLogObjective coordinateProduct
  rw [Real.log_prod (fun i _hi => hy i)]

/--
Since `log` is monotone on positive reals, coordinate-product comparison
implies comparison of the log Nash-social-welfare objective.
-/
theorem nashLogObjective_le_of_coordinateProduct_le {N : ℕ} {y y' : Fin N → ℝ}
    (hy : ∀ i, 0 < y i) (hy' : ∀ i, 0 < y' i)
    (hprod : coordinateProduct y ≤ coordinateProduct y') :
    nashLogObjective y ≤ nashLogObjective y' := by
  have hprod_pos : 0 < coordinateProduct y := by
    unfold coordinateProduct
    exact Finset.prod_pos (fun i _hi => hy i)
  have hlog_le : Real.log (coordinateProduct y) ≤ Real.log (coordinateProduct y') :=
    Real.log_le_log hprod_pos hprod
  rw [nashLogObjective_eq_log_coordinateProduct (fun i => ne_of_gt (hy i)),
    nashLogObjective_eq_log_coordinateProduct (fun i => ne_of_gt (hy' i))]
  exact hlog_le

/--
AM-GM lower bound used in Lemma `supinf`: if `y'` has weakly larger coordinate
product than a positive row `y`, then the ratio objective is at least `N`.
-/
theorem ratioObjective_ge_card_of_coordinateProduct_le {N : ℕ} [Nonempty (Fin N)]
    {y y' : Fin N → ℝ}
    (hy : ∀ i, 0 < y i) (hy' : ∀ i, 0 < y' i)
    (hprod : coordinateProduct y ≤ coordinateProduct y') :
    (N : ℝ) ≤ ratioObjective y y' := by
  classical
  have hNpos_nat_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hNpos_nat : 0 < N := by
    simpa using hNpos_nat_card
  have hNpos : 0 < (N : ℝ) := by
    exact_mod_cast hNpos_nat
  let z : Fin N → ℝ := fun i => y' i / y i
  have hz_nonneg : ∀ i ∈ (Finset.univ : Finset (Fin N)), 0 ≤ z i := by
    intro i _hi
    exact le_of_lt (div_pos (hy' i) (hy i))
  have hamgm :=
    Real.geom_mean_le_arith_mean (Finset.univ : Finset (Fin N))
      (fun _ : Fin N => (1 : ℝ)) z (by intro i _hi; norm_num)
      (by simpa using hNpos) hz_nonneg
  have hprod_z_ge_one : (1 : ℝ) ≤ ∏ i : Fin N, z i := by
    dsimp [z]
    rw [Finset.prod_div_distrib]
    rw [one_le_div₀]
    · simpa [coordinateProduct] using hprod
    · exact Finset.prod_pos (fun i _hi => hy i)
  have hsum_weights_pos : 0 < ∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ) := by
    simpa using hNpos
  have hleft_ge_one :
      (1 : ℝ) ≤
        ((∏ i : Fin N, z i) ^
          ((∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ))⁻¹)) := by
    exact Real.one_le_rpow hprod_z_ge_one
      (inv_nonneg.mpr (le_of_lt hsum_weights_pos))
  have hmean_le :
      ((∏ i : Fin N, z i) ^
          ((∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ))⁻¹)) ≤
        (∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ) * z i) /
          (∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ)) := by
    simpa using hamgm
  have hone_le_mean : (1 : ℝ) ≤ (∑ i : Fin N, z i) / (N : ℝ) := by
    have := le_trans hleft_ge_one hmean_le
    simpa [z] using this
  have hN_le_sumz : (N : ℝ) ≤ ∑ i : Fin N, z i := by
    rw [le_div_iff₀ hNpos] at hone_le_mean
    simpa [mul_comm] using hone_le_mean
  simpa [ratioObjective, z]

theorem coordinateProduct_le_of_ratioObjective_le_card {N : ℕ} [Nonempty (Fin N)]
    {y y' : Fin N → ℝ}
    (hy : ∀ i, 0 < y i) (hy' : ∀ i, 0 < y' i)
    (hratio : ratioObjective y y' ≤ (N : ℝ)) :
    coordinateProduct y' ≤ coordinateProduct y := by
  classical
  have hNpos_nat_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hNpos_nat : 0 < N := by simpa using hNpos_nat_card
  have hNpos : 0 < (N : ℝ) := by exact_mod_cast hNpos_nat
  let z : Fin N → ℝ := fun i => y' i / y i
  have hz_nonneg : ∀ i ∈ (Finset.univ : Finset (Fin N)), 0 ≤ z i := by
    intro i _hi
    exact le_of_lt (div_pos (hy' i) (hy i))
  have hamgm :=
    Real.geom_mean_le_arith_mean (Finset.univ : Finset (Fin N))
      (fun _ : Fin N => (1 : ℝ)) z (by intro i _hi; norm_num)
      (by simpa using hNpos) hz_nonneg
  have hmean_le_one :
      (∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ) * z i) /
          (∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ)) ≤ 1 := by
    have hsum_le : ∑ i : Fin N, z i ≤ (N : ℝ) := by
      simpa [ratioObjective, z] using hratio
    have hden : (∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ)) = (N : ℝ) := by
      simp
    rw [hden]
    rw [div_le_one hNpos]
    simpa using hsum_le
  have hgeom_le_one :
      ((∏ i : Fin N, z i) ^
          ((∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ))⁻¹)) ≤ 1 := by
    have hgm :
        ((∏ i : Fin N, z i) ^
            ((∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ))⁻¹)) ≤
          (∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ) * z i) /
            (∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ)) := by
      simpa using hamgm
    exact le_trans hgm hmean_le_one
  have hprod_z_nonneg : 0 ≤ ∏ i : Fin N, z i :=
    Finset.prod_nonneg hz_nonneg
  have hsum_weights_pos :
      0 < ∑ i ∈ (Finset.univ : Finset (Fin N)), (1 : ℝ) := by
    simpa using hNpos
  have hprod_z_le_one : ∏ i : Fin N, z i ≤ 1 := by
    rw [← Real.rpow_le_rpow_iff hprod_z_nonneg zero_le_one
      (inv_pos.mpr hsum_weights_pos)]
    simpa using hgeom_le_one
  dsimp [z] at hprod_z_le_one
  rw [Finset.prod_div_distrib] at hprod_z_le_one
  have hden_pos : 0 < ∏ i : Fin N, y i :=
    Finset.prod_pos (fun i _hi => hy i)
  rw [div_le_one hden_pos] at hprod_z_le_one
  simpa [coordinateProduct] using hprod_z_le_one

/-- A row maximizes the coordinate product over a feasible set. -/
abbrev IsCoordinateProductMaximizer {N : ℕ}
    (R : Set (Fin N → ℝ)) (yStar : Fin N → ℝ) : Prop :=
  IsMaximizerOn (fun y => y ∈ R) coordinateProduct yStar

/-- An attained coordinate-product maximum realizes the corresponding supremum. -/
theorem coordinateProductSup_eq_of_isCoordinateProductMaximizer {N : ℕ}
    {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hmax : IsCoordinateProductMaximizer R y) :
    coordinateProductSup R = coordinateProduct y := by
  unfold coordinateProductSup
  apply le_antisymm
  · apply csSup_le
    · exact ⟨coordinateProduct y, ⟨y, hmax.1, rfl⟩⟩
    · rintro z ⟨z', hz', rfl⟩
      exact hmax.2 z' hz'
  · apply le_csSup
    · refine ⟨coordinateProduct y, ?_⟩
      rintro z ⟨z', hz', rfl⟩
      exact hmax.2 z' hz'
    · exact ⟨y, hmax.1, rfl⟩

theorem coordinateProductMaximizer_of_directionCondition {N : ℕ} [Nonempty (Fin N)]
    {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hcond : SingleGenreDirectionCondition R y)
    (hy_mem : y ∈ R)
    (hpos : ∀ z ∈ R, ∀ i, 0 < z i) :
    IsCoordinateProductMaximizer R y := by
  refine ⟨hy_mem, ?_⟩
  intro y' hy'
  exact coordinateProduct_le_of_ratioObjective_le_card
    (hpos y hy_mem) (hpos y' hy') (hcond y' hy')

/--
A positive row satisfying the ratio direction condition maximizes coordinate
product over a nonnegative feasible set.  Unlike the older positive-set form,
this correctly permits zero rows in the source norm ball.
-/
theorem coordinateProductMaximizer_of_directionCondition_nonnegative
    {N : ℕ} [Nonempty (Fin N)] {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hcond : SingleGenreDirectionCondition R y)
    (hy_mem : y ∈ R) (hy : ∀ i, 0 < y i)
    (hnonnegative : ∀ z ∈ R, ∀ i, 0 ≤ z i) :
    IsCoordinateProductMaximizer R y := by
  refine ⟨hy_mem, ?_⟩
  intro y' hy'
  by_cases hy'_zero : ∃ i, y' i = 0
  · rcases hy'_zero with ⟨i, hi⟩
    have hprod_zero : coordinateProduct y' = 0 := by
      unfold coordinateProduct
      exact Finset.prod_eq_zero (Finset.mem_univ i) hi
    rw [hprod_zero]
    unfold coordinateProduct
    exact Finset.prod_nonneg fun i _hi => (hy i).le
  · have hy'_positive : ∀ i, 0 < y' i := by
      intro i
      have hy'_nonnegative : 0 ≤ y' i := hnonnegative y' hy' i
      have hy'_ne : y' i ≠ 0 := by
        intro hi
        exact hy'_zero ⟨i, hi⟩
      exact lt_of_le_of_ne hy'_nonnegative (Ne.symm hy'_ne)
    exact coordinateProduct_le_of_ratioObjective_le_card
      hy hy'_positive (hcond y' hy')

/--
Finite attained-maximum form of source Lemma `supinf`: choosing a product
maximizer `yStar` gives ratio objective at least `N` against every positive
row in the feasible set.
-/
theorem ratioObjective_ge_card_of_coordinateProductMaximizer {N : ℕ} [Nonempty (Fin N)]
    {R : Set (Fin N → ℝ)} {y yStar : Fin N → ℝ}
    (hmax : IsCoordinateProductMaximizer R yStar)
    (hy_mem : y ∈ R)
    (hpos : ∀ z ∈ R, ∀ i, 0 < z i) :
    (N : ℝ) ≤ ratioObjective y yStar := by
  exact ratioObjective_ge_card_of_coordinateProduct_le
    (hpos y hy_mem) (hpos yStar hmax.1) (hmax.2 y hy_mem)

theorem ratioObjective_minimizer_at_coordinateProductMaximizer {N : ℕ}
    [Nonempty (Fin N)]
    {R : Set (Fin N → ℝ)} {yStar : Fin N → ℝ}
    (hmax : IsCoordinateProductMaximizer R yStar)
    (hpos : ∀ z ∈ R, ∀ i, 0 < z i) :
    IsMinimizerOn (fun y => y ∈ R) (fun y => ratioObjective y yStar) yStar := by
  refine ⟨hmax.1, ?_⟩
  intro y hy
  have hself : ratioObjective yStar yStar = (N : ℝ) :=
    ratioObjective_self_of_pos (fun i => ne_of_gt (hpos yStar hmax.1 i))
  change ratioObjective yStar yStar ≤ ratioObjective y yStar
  rw [hself]
  exact ratioObjective_ge_card_of_coordinateProductMaximizer hmax hy hpos

theorem ratioObjective_value_at_coordinateProductMaximizer {N : ℕ}
    [Nonempty (Fin N)]
    {R : Set (Fin N → ℝ)} {yStar : Fin N → ℝ}
    (hmax : IsCoordinateProductMaximizer R yStar)
    (hpos : ∀ z ∈ R, ∀ i, 0 < z i) :
    ratioObjective yStar yStar = (N : ℝ) :=
  ratioObjective_self_of_pos (fun i => ne_of_gt (hpos yStar hmax.1 i))

/--
Corollary `singlegenrestructure`, optimization core: over a positive feasible
set, any coordinate-product maximizer also maximizes the log Nash objective.
-/
theorem nashLogObjective_maximizer_of_coordinateProductMaximizer {N : ℕ}
    {R : Set (Fin N → ℝ)} {yStar : Fin N → ℝ}
    (hmax : IsCoordinateProductMaximizer R yStar)
    (hpos : ∀ z ∈ R, ∀ i, 0 < z i) :
    IsMaximizerOn (fun y => y ∈ R) nashLogObjective yStar := by
  refine ⟨hmax.1, ?_⟩
  intro y hy_mem
  exact nashLogObjective_le_of_coordinateProduct_le
    (hpos y hy_mem) (hpos yStar hmax.1) (hmax.2 y hy_mem)

theorem coordinateProductMaximizer_of_nashLogObjectiveMaximizer {N : ℕ}
    {R : Set (Fin N → ℝ)} {yStar : Fin N → ℝ}
    (hmax : IsMaximizerOn (fun y => y ∈ R) nashLogObjective yStar)
    (hpos : ∀ z ∈ R, ∀ i, 0 < z i) :
    IsCoordinateProductMaximizer R yStar := by
  refine ⟨hmax.1, ?_⟩
  intro y hy_mem
  have hlog : nashLogObjective y ≤ nashLogObjective yStar :=
    hmax.2 y hy_mem
  have hprod_y_pos : 0 < coordinateProduct y := by
    unfold coordinateProduct
    exact Finset.prod_pos (fun i _hi => hpos y hy_mem i)
  have hprod_star_pos : 0 < coordinateProduct yStar := by
    unfold coordinateProduct
    exact Finset.prod_pos (fun i _hi => hpos yStar hmax.1 i)
  rw [nashLogObjective_eq_log_coordinateProduct
      (fun i => ne_of_gt (hpos y hy_mem i)),
    nashLogObjective_eq_log_coordinateProduct
      (fun i => ne_of_gt (hpos yStar hmax.1 i))] at hlog
  exact (Real.log_le_log_iff hprod_y_pos hprod_star_pos).mp hlog

theorem nashLogObjective_maximizer_iff_coordinateProductMaximizer {N : ℕ}
    {R : Set (Fin N → ℝ)} {yStar : Fin N → ℝ}
    (hpos : ∀ z ∈ R, ∀ i, 0 < z i) :
    IsMaximizerOn (fun y => y ∈ R) nashLogObjective yStar ↔
      IsCoordinateProductMaximizer R yStar := by
  constructor
  · intro h
    exact coordinateProductMaximizer_of_nashLogObjectiveMaximizer h hpos
  · intro h
    exact nashLogObjective_maximizer_of_coordinateProductMaximizer h hpos

theorem noPositiveSingleGenreRadialDeviations_of_convex_coordinateProductMaximizer
    {N : ℕ} [Nonempty (Fin N)]
    {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hconv : Convex ℝ R)
    (hmax : IsCoordinateProductMaximizer R y)
    (hpos : ∀ z ∈ R, ∀ i, 0 < z i) :
    NoPositiveSingleGenreRadialDeviations R y :=
  noPositiveSingleGenreRadialDeviations_of_convex_nashLogMaximizer hconv
    (nashLogObjective_maximizer_of_coordinateProductMaximizer hmax hpos)
    (fun i => ne_of_gt (hpos y hmax.1 i))

theorem singleGenreDirectionCondition_of_convex_coordinateProductMaximizer
    {N : ℕ} [Nonempty (Fin N)]
    {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hconv : Convex ℝ R)
    (hmax : IsCoordinateProductMaximizer R y)
    (hpos : ∀ z ∈ R, ∀ i, 0 < z i) :
    SingleGenreDirectionCondition R y :=
  (noPositiveSingleGenreRadialDeviations_iff_directionCondition).mp
    (noPositiveSingleGenreRadialDeviations_of_convex_coordinateProductMaximizer
      hconv hmax hpos)

/--
Abstract source-facing existence predicate from Theorem `singlegenre`: there is
a feasible powered row whose ratio-objective deviations are all bounded by `N`.
-/
def ExistsSingleGenreDirectionCondition {N : ℕ} (S : Set (Fin N → ℝ)) : Prop :=
  ∃ y : Fin N → ℝ, y ∈ S ∧ SingleGenreDirectionCondition S y

theorem existsSingleGenreDirectionCondition_of_convex_coordinateProductMaximizer
    {N : ℕ} [Nonempty (Fin N)]
    {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hconv : Convex ℝ R)
    (hmax : IsCoordinateProductMaximizer R y)
    (hpos : ∀ z ∈ R, ∀ i, 0 < z i) :
    ExistsSingleGenreDirectionCondition R :=
  ⟨y, hmax.1,
    singleGenreDirectionCondition_of_convex_coordinateProductMaximizer
      hconv hmax hpos⟩

theorem existsSingleGenreDirectionCondition_of_convex_nashLogMaximizer
    {N : ℕ} {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hconv : Convex ℝ R)
    (hmax : IsMaximizerOn (fun z => z ∈ R) nashLogObjective y)
    (hy : ∀ i, y i ≠ 0) :
    ExistsSingleGenreDirectionCondition R :=
  ⟨y, hmax.1,
    singleGenreDirectionCondition_of_convex_nashLogMaximizer hconv hmax hy⟩

/--
First-order log-Nash condition at a positive product maximizer over a convex
set of nonnegative rows.  This permits the zero row that every source norm
ball contains while keeping the candidate row strictly positive.
-/
theorem nashLogFirstOrderCondition_of_convex_coordinateProductMaximizer_nonnegative
    {N : ℕ} {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hconv : Convex ℝ R)
    (hmax : IsCoordinateProductMaximizer R y)
    (hy : ∀ i, 0 < y i)
    (hnonnegative : ∀ z ∈ R, ∀ i, 0 ≤ z i) :
    NashLogFirstOrderCondition R y := by
  apply nashLogFirstOrderCondition_of_segment_local_max
    (fun i => ne_of_gt (hy i))
  intro y' hy' ε hε_pos hε_lt
  have hε_nonnegative : 0 ≤ ε := le_of_lt hε_pos
  have hone_sub_nonnegative : 0 ≤ 1 - ε := le_of_lt (sub_pos.mpr hε_lt)
  have hsum : (1 - ε) + ε = (1 : ℝ) := by ring
  let z : Fin N → ℝ := (1 - ε) • y + ε • y'
  have hz : z ∈ R := by
    exact hconv hmax.1 hy' hone_sub_nonnegative hε_nonnegative hsum
  have hz_pos : ∀ i, 0 < z i := by
    intro i
    change 0 < (1 - ε) * y i + ε * y' i
    exact add_pos_of_pos_of_nonneg
      (mul_pos (sub_pos.mpr hε_lt) (hy i))
      (mul_nonneg hε_nonnegative (hnonnegative y' hy' i))
  have hproduct : coordinateProduct z ≤ coordinateProduct y := hmax.2 z hz
  have hlog : nashLogObjective z ≤ nashLogObjective y :=
    nashLogObjective_le_of_coordinateProduct_le hz_pos hy hproduct
  have hz_eq : z = fun i => y i + ε * (y' i - y i) := by
    ext i
    simp [z]
    ring
  change nashLogObjective (fun i => y i + ε * (y' i - y i)) ≤
    nashLogObjective y
  rw [← hz_eq]
  exact hlog

/--
Positive coordinate-product maximizers over convex nonnegative row sets
satisfy the single-genre direction condition.
-/
theorem singleGenreDirectionCondition_of_convex_coordinateProductMaximizer_nonnegative
    {N : ℕ} [Nonempty (Fin N)] {R : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hconv : Convex ℝ R)
    (hmax : IsCoordinateProductMaximizer R y)
    (hy : ∀ i, 0 < y i)
    (hnonnegative : ∀ z ∈ R, ∀ i, 0 ≤ z i) :
    SingleGenreDirectionCondition R y :=
  (nashLogFirstOrderCondition_iff_directionCondition
    (fun i => ne_of_gt (hy i))).mp
  (nashLogFirstOrderCondition_of_convex_coordinateProductMaximizer_nonnegative
      hconv hmax hy hnonnegative)

/--
A positive direction-condition witness in a nonnegative row set attains the
same coordinate-product supremum before and after convexification.
-/
theorem singleGenreProductSupCondition_of_directionCondition_nonnegative
    {N : ℕ} [Nonempty (Fin N)] {S : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hcondition : SingleGenreDirectionCondition S y)
    (hyS : y ∈ S) (hy : ∀ i, 0 < y i)
    (hnonnegativeHull : ∀ z ∈ convexHull ℝ S, ∀ i, 0 ≤ z i) :
    SingleGenreProductSupCondition S := by
  have hnonnegativeS : ∀ z ∈ S, ∀ i, 0 ≤ z i := by
    intro z hz i
    exact hnonnegativeHull z (subset_convexHull ℝ S hz) i
  have hmaxS : IsCoordinateProductMaximizer S y :=
    coordinateProductMaximizer_of_directionCondition_nonnegative
      hcondition hyS hy hnonnegativeS
  have hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) y :=
    coordinateProductMaximizer_of_directionCondition_nonnegative
      (singleGenreDirectionCondition_convexHull hcondition)
      (subset_convexHull ℝ S hyS) hy hnonnegativeHull
  unfold SingleGenreProductSupCondition
  rw [coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxS,
    coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxHull]

/--
Theorem `singlegenre`, attained max-condition direction: if a coordinate-product
maximizer over the convex hull of the powered set is itself a row of the
original powered set, then the original powered set contains a row satisfying
the single-genre no-deviation condition.  This is the finite, source-facing
core of the implication from equality of the two product maxima to existence
of a single-genre direction.
-/
theorem existsSingleGenreDirectionCondition_of_hull_coordinateProductMaximizer_mem
    {N : ℕ} [Nonempty (Fin N)]
    {S : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) y)
    (hyS : y ∈ S)
    (hposHull : ∀ z ∈ convexHull ℝ S, ∀ i, 0 < z i) :
    ExistsSingleGenreDirectionCondition S := by
  have hcondHull :
      SingleGenreDirectionCondition (convexHull ℝ S) y :=
    singleGenreDirectionCondition_of_convex_coordinateProductMaximizer
      (convex_convexHull ℝ S) hmaxHull hposHull
  refine ⟨y, hyS, ?_⟩
  intro y' hy'
  exact hcondHull y' (subset_convexHull ℝ S hy')

/--
Corrected attained max-condition bridge for Theorem `singlegenre`.  A positive
maximizer over the convex hull only needs the hull rows to be nonnegative; the
source's feasible ball necessarily contains the zero row, so global strict
positivity would be an impossible premise.
-/
theorem existsSingleGenreDirectionCondition_of_hull_coordinateProductMaximizer_mem_nonnegative
    {N : ℕ} [Nonempty (Fin N)]
    {S : Set (Fin N → ℝ)} {y : Fin N → ℝ}
    (hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) y)
    (hyS : y ∈ S)
    (hy : ∀ i, 0 < y i)
    (hnonnegativeHull : ∀ z ∈ convexHull ℝ S, ∀ i, 0 ≤ z i) :
    ExistsSingleGenreDirectionCondition S := by
  have hcondHull :
      SingleGenreDirectionCondition (convexHull ℝ S) y :=
    singleGenreDirectionCondition_of_convex_coordinateProductMaximizer_nonnegative
      (convex_convexHull ℝ S) hmaxHull hy hnonnegativeHull
  refine ⟨y, hyS, ?_⟩
  intro y' hy'
  exact hcondHull y' (subset_convexHull ℝ S hy')

/--
Attained form of the product-max condition in Theorem `singlegenre`.  When the
source product supremum equals its convex-hull counterpart, an attained source
maximizer is itself a hull maximizer.  Together with the corrected
nonnegative-hull first-order bridge, it supplies a single-genre direction.
-/
theorem existsSingleGenreDirectionCondition_of_productSupCondition_of_attained_maximizers_nonnegative
    {N : ℕ} [Nonempty (Fin N)] {S : Set (Fin N → ℝ)}
    {x y : Fin N → ℝ}
    (hproduct : SingleGenreProductSupCondition S)
    (hmaxS : IsCoordinateProductMaximizer S x)
    (hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) y)
    (hx : ∀ i, 0 < x i)
    (hnonnegativeHull : ∀ z ∈ convexHull ℝ S, ∀ i, 0 ≤ z i) :
    ExistsSingleGenreDirectionCondition S := by
  have hvalue : coordinateProduct x = coordinateProduct y := by
    calc
      coordinateProduct x = coordinateProductSup S :=
        (coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxS).symm
      _ = coordinateProductSup (convexHull ℝ S) := hproduct
      _ = coordinateProduct y :=
        coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxHull
  have hxHull : x ∈ convexHull ℝ S := subset_convexHull ℝ S hmaxS.1
  have hmaxXHull : IsCoordinateProductMaximizer (convexHull ℝ S) x := by
    refine ⟨hxHull, ?_⟩
    intro z hz
    exact (hmaxHull.2 z hz).trans_eq hvalue.symm
  exact
    existsSingleGenreDirectionCondition_of_hull_coordinateProductMaximizer_mem_nonnegative
      hmaxXHull hmaxS.1 hx hnonnegativeHull

/--
If the source and convex-hull coordinate-product suprema agree, an attained
source maximizer is already a convex-hull maximizer whenever the hull product
objective is bounded above.  This avoids treating convex-hull *attainment* as
an extra premise: boundedness is the exact order-theoretic fact needed to
compare every hull row with its supremum.
-/
theorem isCoordinateProductMaximizer_convexHull_of_productSupCondition_of_bddAbove
    {N : ℕ} {S : Set (Fin N → ℝ)} {x : Fin N → ℝ}
    (hproduct : SingleGenreProductSupCondition S)
    (hmaxS : IsCoordinateProductMaximizer S x)
    (hbounded : BddAbove (coordinateProduct '' convexHull ℝ S)) :
    IsCoordinateProductMaximizer (convexHull ℝ S) x := by
  have hvalue : coordinateProductSup (convexHull ℝ S) = coordinateProduct x := by
    calc
      coordinateProductSup (convexHull ℝ S) = coordinateProductSup S := hproduct.symm
      _ = coordinateProduct x :=
        coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxS
  refine ⟨subset_convexHull ℝ S hmaxS.1, ?_⟩
  intro z hz
  calc
    coordinateProduct z ≤ coordinateProductSup (convexHull ℝ S) := by
      unfold coordinateProductSup
      exact le_csSup hbounded ⟨z, hz, rfl⟩
    _ = coordinateProduct x := hvalue

/--
Replicating each of two nonnegative coordinates the same positive number of
times preserves the single-genre product-supremum condition.  The replicated
coordinate product is the positive natural power of the original product, so
maximizers transport in both directions; linearity identifies the two convex
hulls exactly.

This is the finite-population bridge needed when a two-type market contains
`K` users of each type rather than one representative of each type.
-/
theorem singleGenreProductSupCondition_image_replicateTwoPopulationRowLinear_iff
    {K : ℕ} (hK : 0 < K) {S : Set (Fin 2 → ℝ)}
    (hnonnegativeHull :
      ∀ z ∈ convexHull ℝ S, ∀ i : Fin 2, 0 ≤ z i)
    {x : Fin 2 → ℝ} (hmaxS : IsCoordinateProductMaximizer S x)
    (hboundedS : BddAbove (coordinateProduct '' convexHull ℝ S))
    (hboundedReplicated : BddAbove
      (coordinateProduct '' convexHull ℝ
        (replicateTwoPopulationRowLinear K '' S))) :
    SingleGenreProductSupCondition
        (replicateTwoPopulationRowLinear K '' S) ↔
      SingleGenreProductSupCondition S := by
  let L := replicateTwoPopulationRowLinear K
  have hK_ne : K ≠ 0 := Nat.ne_of_gt hK
  have hnonnegativeS : ∀ z ∈ S, ∀ i : Fin 2, 0 ≤ z i := by
    intro z hz i
    exact hnonnegativeHull z (subset_convexHull ℝ S hz) i
  have hproduct_nonnegative_S : ∀ z ∈ S, 0 ≤ coordinateProduct z := by
    intro z hz
    unfold coordinateProduct
    exact Finset.prod_nonneg fun i _hi => hnonnegativeS z hz i
  have hproduct_nonnegative_hull :
      ∀ z ∈ convexHull ℝ S, 0 ≤ coordinateProduct z := by
    intro z hz
    unfold coordinateProduct
    exact Finset.prod_nonneg fun i _hi => hnonnegativeHull z hz i
  have hmaxReplicated :
      IsCoordinateProductMaximizer (L '' S) (L x) := by
    constructor
    · exact ⟨x, hmaxS.1, rfl⟩
    · rintro _ ⟨z, hz, rfl⟩
      rw [coordinateProduct_replicateTwoPopulationRowLinear,
        coordinateProduct_replicateTwoPopulationRowLinear]
      exact pow_le_pow_left₀
        (hproduct_nonnegative_S z hz) (hmaxS.2 z hz) K
  have htransport_to_replicated :
      ∀ (hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) x),
        IsCoordinateProductMaximizer (convexHull ℝ (L '' S)) (L x) := by
    intro hmaxHull
    constructor
    · rw [← L.image_convexHull S]
      exact ⟨x, hmaxHull.1, rfl⟩
    · intro z hz
      rw [← L.image_convexHull S] at hz
      rcases hz with ⟨y, hy, rfl⟩
      rw [coordinateProduct_replicateTwoPopulationRowLinear,
        coordinateProduct_replicateTwoPopulationRowLinear]
      exact pow_le_pow_left₀
        (hproduct_nonnegative_hull y hy) (hmaxHull.2 y hy) K
  have htransport_from_replicated :
      ∀ (hmaxHull :
          IsCoordinateProductMaximizer (convexHull ℝ (L '' S)) (L x)),
        IsCoordinateProductMaximizer (convexHull ℝ S) x := by
    intro hmaxHull
    constructor
    · exact subset_convexHull ℝ S hmaxS.1
    · intro y hy
      have hLy : L y ∈ convexHull ℝ (L '' S) := by
        rw [← L.image_convexHull S]
        exact ⟨y, hy, rfl⟩
      have hpower : (coordinateProduct y) ^ K ≤
          (coordinateProduct x) ^ K := by
        simpa [L, coordinateProduct_replicateTwoPopulationRowLinear] using
          hmaxHull.2 (L y) hLy
      exact (pow_le_pow_iff_left₀
        (hproduct_nonnegative_hull y hy)
        (hproduct_nonnegative_S x hmaxS.1) hK_ne).mp hpower
  constructor
  · intro hproductReplicated
    have hmaxHullReplicated :
        IsCoordinateProductMaximizer
          (convexHull ℝ (L '' S)) (L x) := by
      apply
        isCoordinateProductMaximizer_convexHull_of_productSupCondition_of_bddAbove
          hproductReplicated hmaxReplicated
      simpa [L] using hboundedReplicated
    have hmaxHullS := htransport_from_replicated hmaxHullReplicated
    unfold SingleGenreProductSupCondition
    rw [coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxS,
      coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxHullS]
  · intro hproductS
    have hmaxHullS : IsCoordinateProductMaximizer (convexHull ℝ S) x :=
      isCoordinateProductMaximizer_convexHull_of_productSupCondition_of_bddAbove
        hproductS hmaxS hboundedS
    have hmaxHullReplicated := htransport_to_replicated hmaxHullS
    unfold SingleGenreProductSupCondition
    rw [coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxReplicated,
      coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxHullReplicated]

/-- Source set `S = {U p | ||p|| <= 1, p >= 0}` as a predicate over user-value rows. -/
def InUnitImage {D N : ℕ}
    (users : Fin N → Content D) (unitFeasible : Content D → Prop) (y : Fin N → ℝ) :
    Prop :=
  ∃ p : Content D, unitFeasible p ∧ y = fun i => score (users i) p

/--
The source user-value image is compact whenever its feasible content domain is
compact.  This provides the attained product maximizers used by the corrected
single-genre optimization endpoints.
-/
theorem isCompact_inUnitImage_of_isCompact {D N : ℕ}
    (users : Fin N → Content D) (unitFeasible : Content D → Prop)
    (hcompact : IsCompact {p : Content D | unitFeasible p}) :
    IsCompact {y : Fin N → ℝ | InUnitImage users unitFeasible y} := by
  let f : Content D → Fin N → ℝ := fun p i => score (users i) p
  have hf : Continuous f := by
    apply continuous_pi
    intro i
    unfold f score
    exact continuous_finset_sum Finset.univ fun d _hd =>
      continuous_const.mul (continuous_apply d)
  have hset : {y : Fin N → ℝ | InUnitImage users unitFeasible y} =
      f '' {p : Content D | unitFeasible p} := by
    ext y
    constructor
    · rintro ⟨p, hp, hy⟩
      exact ⟨p, hp, hy.symm⟩
    · rintro ⟨p, hp, hy⟩
      exact ⟨p, hp, hy.symm⟩
  rw [hset]
  exact hcompact.image hf

theorem convex_inUnitImage_of_convex_unitFeasible {D N : ℕ}
    {users : Fin N → Content D} {unitFeasible : Content D → Prop}
    (hconv : Convex ℝ {p : Content D | unitFeasible p}) :
    Convex ℝ {y : Fin N → ℝ | InUnitImage users unitFeasible y} := by
  intro y1 hy1 y2 hy2 a b ha hb hsum
  rcases hy1 with ⟨p1, hp1, hy1_eq⟩
  rcases hy2 with ⟨p2, hp2, hy2_eq⟩
  refine ⟨a • p1 + b • p2, hconv hp1 hp2 ha hb hsum, ?_⟩
  ext i
  rw [hy1_eq, hy2_eq]
  change a * score (users i) p1 + b * score (users i) p2 =
    score (users i) (a • p1 + b • p2)
  rw [score_add, score_smul, score_smul]

/-- Source set `S^β`, represented by coordinatewise powers of rows from `S`. -/
noncomputable def InPoweredUnitImage {D N : ℕ}
    (users : Fin N → Content D) (unitFeasible : Content D → Prop)
    (β : ℝ) (y : Fin N → ℝ) : Prop :=
  ∃ base : Fin N → ℝ,
    InUnitImage users unitFeasible base ∧
      y = fun i => (base i) ^ β

/--
Repeating each of two user types commutes exactly with forming the powered
user-value image.  The feasible content action is unchanged; only its two
score coordinates are copied `K` times.
-/
theorem inPoweredUnitImage_twoPopulationUsers_iff
    {D K : ℕ} {users : Fin 2 → Content D}
    {unitFeasible : Content D → Prop} {β : ℝ} {z : Fin (2 * K) → ℝ} :
    InPoweredUnitImage (twoPopulationUsers K users) unitFeasible β z ↔
      ∃ y : Fin 2 → ℝ,
        InPoweredUnitImage users unitFeasible β y ∧
          z = replicateTwoPopulationRowLinear K y := by
  constructor
  · rintro ⟨base, ⟨p, hp, hbase⟩, hz⟩
    refine ⟨fun i => (score (users i) p) ^ β, ?_, ?_⟩
    · exact ⟨fun i => score (users i) p, ⟨p, hp, rfl⟩, rfl⟩
    · rw [hz, hbase]
      rfl
  · rintro ⟨y, ⟨base, ⟨p, hp, hbase⟩, hy⟩, hz⟩
    refine ⟨fun i => score (twoPopulationUsers K users i) p,
      ⟨p, hp, rfl⟩, ?_⟩
    rw [hz, hy, hbase]
    rfl

/-- Set form of `inPoweredUnitImage_twoPopulationUsers_iff`. -/
theorem poweredUnitImage_twoPopulationUsers_eq_image_replicateTwoPopulationRowLinear
    {D K : ℕ} {users : Fin 2 → Content D}
    {unitFeasible : Content D → Prop} {β : ℝ} :
    {z : Fin (2 * K) → ℝ |
        InPoweredUnitImage (twoPopulationUsers K users) unitFeasible β z} =
      replicateTwoPopulationRowLinear K ''
        {y : Fin 2 → ℝ | InPoweredUnitImage users unitFeasible β y} := by
  ext z
  constructor
  · intro hz
    rcases inPoweredUnitImage_twoPopulationUsers_iff.mp hz with
      ⟨y, hy, hzy⟩
    exact ⟨y, hy, hzy.symm⟩
  · rintro ⟨y, hy, hyz⟩
    exact inPoweredUnitImage_twoPopulationUsers_iff.mpr
      ⟨y, hy, hyz.symm⟩

/--
Corollary `betaone` algebra: at exponent `β = 1`, the powered source set
`S^β` is exactly the original unit image `S`.
-/
theorem inPoweredUnitImage_one_iff {D N : ℕ}
    {users : Fin N → Content D} {unitFeasible : Content D → Prop}
    {y : Fin N → ℝ} :
    InPoweredUnitImage users unitFeasible (1 : ℝ) y ↔
      InUnitImage users unitFeasible y := by
  constructor
  · rintro ⟨base, hbase, hy⟩
    rcases hbase with ⟨p, hp, hbase_eq⟩
    refine ⟨p, hp, ?_⟩
    ext i
    rw [hy, hbase_eq]
    simp
  · intro hy
    refine ⟨y, hy, ?_⟩
    ext i
    simp

theorem convex_inPoweredUnitImage_one_of_convex_unitFeasible {D N : ℕ}
    {users : Fin N → Content D} {unitFeasible : Content D → Prop}
    (hconv : Convex ℝ {p : Content D | unitFeasible p}) :
    Convex ℝ
      {y : Fin N → ℝ | InPoweredUnitImage users unitFeasible (1 : ℝ) y} := by
  rw [show {y : Fin N → ℝ | InPoweredUnitImage users unitFeasible (1 : ℝ) y} =
      {y : Fin N → ℝ | InUnitImage users unitFeasible y} by
    ext y
    exact inPoweredUnitImage_one_iff]
  exact convex_inUnitImage_of_convex_unitFeasible hconv

theorem convexHull_inPoweredUnitImage_one_eq_of_convex_unitFeasible {D N : ℕ}
    {users : Fin N → Content D} {unitFeasible : Content D → Prop}
    (hconv : Convex ℝ {p : Content D | unitFeasible p}) :
    convexHull ℝ
        {y : Fin N → ℝ | InPoweredUnitImage users unitFeasible (1 : ℝ) y} =
      {y : Fin N → ℝ | InPoweredUnitImage users unitFeasible (1 : ℝ) y} :=
  (convex_inPoweredUnitImage_one_of_convex_unitFeasible hconv).convexHull_eq

theorem singleGenreProductSupCondition_of_convexHull_eq {N : ℕ}
    {S : Set (Fin N → ℝ)} (hull_eq : convexHull ℝ S = S) :
    SingleGenreProductSupCondition S := by
  unfold SingleGenreProductSupCondition coordinateProductSup
  rw [hull_eq]

theorem singleGenreProductSupCondition_of_convex {N : ℕ}
    {S : Set (Fin N → ℝ)} (hconv : Convex ℝ S) :
    SingleGenreProductSupCondition S :=
  singleGenreProductSupCondition_of_convexHull_eq hconv.convexHull_eq

theorem singleGenreProductSupCondition_poweredUnitImage_one_of_convex_unitFeasible
    {D N : ℕ} {users : Fin N → Content D} {unitFeasible : Content D → Prop}
    (hconv : Convex ℝ {p : Content D | unitFeasible p}) :
    SingleGenreProductSupCondition
      {y : Fin N → ℝ | InPoweredUnitImage users unitFeasible (1 : ℝ) y} :=
  singleGenreProductSupCondition_of_convexHull_eq
    (convexHull_inPoweredUnitImage_one_eq_of_convex_unitFeasible hconv)

theorem existsSingleGenreDirectionCondition_poweredUnitImage_one_of_product_maximizer
    {D N : ℕ} [Nonempty (Fin N)]
    {users : Fin N → Content D} {unitFeasible : Content D → Prop}
    {y : Fin N → ℝ}
    (hconv : Convex ℝ {p : Content D | unitFeasible p})
    (hmax :
      IsCoordinateProductMaximizer
        {z : Fin N → ℝ | InPoweredUnitImage users unitFeasible (1 : ℝ) z} y)
    (hpos :
      ∀ z ∈ {z : Fin N → ℝ | InPoweredUnitImage users unitFeasible (1 : ℝ) z},
        ∀ i, 0 < z i) :
    ExistsSingleGenreDirectionCondition
      {z : Fin N → ℝ | InPoweredUnitImage users unitFeasible (1 : ℝ) z} :=
  existsSingleGenreDirectionCondition_of_convex_coordinateProductMaximizer
    (convex_inPoweredUnitImage_one_of_convex_unitFeasible hconv) hmax hpos

/--
Source single-genre optimization equality from Lemma `optimization` /
Theorem `singlegenre`, stated abstractly using supplied inf-sup and sup-inf
values.  Later proof work should instantiate these values from an optimization
library rather than treating them as a theorem premise.
-/
def SingleGenreOptimizationEquality (left right : ℝ) : Prop :=
  left = right

/-! ## Profit section wrappers -/

/--
Source profit formula for the single-genre CDF at radius `r`:
assigned-user mass `N F(r)^(P-1)` minus production cost `r^β`.
-/
noncomputable def SingleGenreProfitFormula (N P : ℕ) (β r : ℝ) : ℝ :=
  (N : ℝ) * (singleGenreCdf N P β r) ^ ((P : ℝ) - 1) - r ^ β

/--
Proposition `zeroutilitysinglegenre`, CDF-formula core: at the zero-quality
support point supplied by Lemma `cdf`, the single-genre profit formula is zero.
-/
theorem singleGenreProfitFormula_zero_eq_zero {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β : ℝ} (hβ : 0 < β) :
    SingleGenreProfitFormula N P β 0 = 0 := by
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_ne : ((P : ℝ) - 1)⁻¹ ≠ 0 := by
    have hP_real : (1 : ℝ) < (P : ℝ) := by exact_mod_cast hP_nat
    have hsub : (P : ℝ) - 1 ≠ 0 := by linarith
    exact inv_ne_zero hsub
  have hraw : singleGenreCdfRaw N P β 0 = 0 := by
    unfold singleGenreCdfRaw
    rw [Real.zero_rpow (ne_of_gt hβ), zero_div, Real.zero_rpow hP_ne]
  unfold SingleGenreProfitFormula
  exact singleGenreCdf_zero_profit_identity_of_raw_le_one
    (N := N) (P := P) (β := β) (r := 0) (by norm_num)
    (by rw [hraw]; norm_num)

/--
Proposition `zeroutilitysinglegenre`, payoff wrapper: if the equilibrium payoff
is the source single-genre payoff at the zero-quality support point, then the
equilibrium payoff is zero.
-/
theorem equilibriumPayoff_eq_zero_of_singleGenre_zero_support_payoff {N P : ℕ}
    [Nonempty (Fin N)] [Nontrivial (Fin P)] {β equilibriumPayoff : ℝ}
    (hβ : 0 < β)
    (hpayoff : equilibriumPayoff = SingleGenreProfitFormula N P β 0) :
    equilibriumPayoff = 0 := by
  rw [hpayoff, singleGenreProfitFormula_zero_eq_zero hβ]

/--
Source gap from Proposition `utility`: the paper's clustering argument aims to
construct a pure deviation whose payoff is at least this quantity.
-/
noncomputable def PositiveProfitGeometryGap (N P : ℕ) (β Q R : ℝ) : ℝ :=
  (1 / (N : ℝ)) ^ ((P : ℝ) - 1) - (Q * R) ^ β

/--
Proposition `utility`, scalar plug-in after the source support-radius bound:
if the support radius satisfies `R^β <= N` and the geometry constant satisfies
the strict post-substitution inequality `Q^β N < (1/N)^(P-1)`, then the
deviation-profit gap in the source proof is positive.
-/
theorem positiveProfitGeometryGap_pos_of_source_scalar_bound
    {N P : ℕ} {β Q R : ℝ}
    (hQ_nonneg : 0 ≤ Q) (hR_nonneg : 0 ≤ R)
    (hR : R ^ β ≤ (N : ℝ))
    (hQ : Q ^ β * (N : ℝ) < (1 / (N : ℝ)) ^ ((P : ℝ) - 1)) :
    0 < PositiveProfitGeometryGap N P β Q R := by
  unfold PositiveProfitGeometryGap
  have hQR_le : (Q * R) ^ β ≤ Q ^ β * (N : ℝ) := by
    rw [Real.mul_rpow hQ_nonneg hR_nonneg]
    exact mul_le_mul_of_nonneg_left hR (Real.rpow_nonneg hQ_nonneg β)
  linarith

/--
Proposition `utility`, exponent algebra for the source condition:
`Q < (1/N)^(P/β)` implies the post-substitution scalar inequality
`Q^β N < (1/N)^(P-1)`.
-/
theorem source_scalar_bound_of_positive_profit_condition
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β Q : ℝ}
    (hβ : 0 < β) (hQ_nonneg : 0 ≤ Q)
    (hQ : Q < (1 / (N : ℝ)) ^ ((P : ℝ) / β)) :
    Q ^ β * (N : ℝ) < (1 / (N : ℝ)) ^ ((P : ℝ) - 1) := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  set a : ℝ := 1 / (N : ℝ)
  have ha_pos : 0 < a := by
    simpa [a] using one_div_pos.mpr hN_pos
  have hQ_pow_lt : Q ^ β < a ^ (P : ℝ) := by
    have hQ' : Q < a ^ ((P : ℝ) / β) := by
      simpa [a] using hQ
    have hpow :=
      Real.rpow_lt_rpow hQ_nonneg hQ' hβ
    have htarget :
        (a ^ ((P : ℝ) / β)) ^ β = a ^ (P : ℝ) := by
      rw [← Real.rpow_mul ha_pos.le]
      have hmul : (P : ℝ) / β * β = (P : ℝ) := by
        field_simp [ne_of_gt hβ]
      rw [hmul]
    simpa [htarget] using hpow
  have hmul_lt : Q ^ β * (N : ℝ) < a ^ (P : ℝ) * (N : ℝ) :=
    mul_lt_mul_of_pos_right hQ_pow_lt hN_pos
  have hrewrite : a ^ (P : ℝ) * (N : ℝ) = a ^ ((P : ℝ) - 1) := by
    have ha_mul : a * (N : ℝ) = 1 := by
      simpa [a] using div_mul_cancel₀ (1 : ℝ) (ne_of_gt hN_pos)
    have hpow_succ : a ^ (P : ℝ) = a ^ ((P : ℝ) - 1) * a := by
      calc
        a ^ (P : ℝ) = a ^ (((P : ℝ) - 1) + 1) := by
          congr 1
          ring
        _ = a ^ ((P : ℝ) - 1) * a ^ (1 : ℝ) := by
          rw [Real.rpow_add ha_pos ((P : ℝ) - 1) 1]
        _ = a ^ ((P : ℝ) - 1) * a := by
          rw [Real.rpow_one]
    rw [hpow_succ, mul_assoc, ha_mul, mul_one]
  rw [hrewrite] at hmul_lt
  simpa [a] using hmul_lt

/--
Proposition `utility`, source-shaped scalar endpoint: the printed geometry
condition together with the source support-radius bound implies a positive
deviation-profit gap.
-/
theorem positiveProfitGeometryGap_pos_of_positive_profit_condition_and_support_bound
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β Q R : ℝ}
    (hβ : 0 < β) (hQ_nonneg : 0 ≤ Q) (hR_nonneg : 0 ≤ R)
    (hR : R ^ β ≤ (N : ℝ))
    (hQ : Q < (1 / (N : ℝ)) ^ ((P : ℝ) / β)) :
    0 < PositiveProfitGeometryGap N P β Q R :=
  positiveProfitGeometryGap_pos_of_source_scalar_bound hQ_nonneg hR_nonneg hR
    (source_scalar_bound_of_positive_profit_condition hβ hQ_nonneg hQ)

/--
Mixed-equilibrium outside-option step used in Proposition `utility`: if some
pure content vector has nonnegative payoff and no pure deviation beats the
common equilibrium payoff, then the common payoff is nonnegative.
-/
theorem equilibriumPayoff_nonneg_of_nonnegative_pure_deviation
    {D : ℕ} {equilibriumPayoff : ℝ}
    {payoff : Content D → MixedContentStrategy D → ℝ}
    {μ : MixedContentStrategy D} {p : Content D}
    (hno : SymmetricMixedNoProfitablePureDeviation payoff μ equilibriumPayoff)
    (hp : 0 ≤ payoff p μ) :
    0 ≤ equilibriumPayoff :=
  le_trans hp (hno p)

/--
Proposition `utility`, support-radius algebra: if the equilibrium payoff is
nonnegative and a support-radius action has payoff at most `N - R^β`, then
`R^β <= N`.
-/
theorem support_radius_rpow_le_card_of_nonnegative_payoff_upper_bound
    {N : ℕ} {β R equilibriumPayoff : ℝ}
    (hpayoff_nonneg : 0 ≤ equilibriumPayoff)
    (hpayoff_upper : equilibriumPayoff ≤ (N : ℝ) - R ^ β) :
    R ^ β ≤ (N : ℝ) := by
  linarith

/--
Proposition `utility`, source-shaped support-radius step: a nonnegative pure
outside option plus the paper's payoff upper bound for a support-radius action
imply `R^β <= N`.
-/
theorem support_radius_rpow_le_card_of_deviation_upper_bound
    {D N : ℕ} {β R equilibriumPayoff : ℝ}
    {payoff : Content D → MixedContentStrategy D → ℝ}
    {μ : MixedContentStrategy D} {outside : Content D}
    (hno : SymmetricMixedNoProfitablePureDeviation payoff μ equilibriumPayoff)
    (houtside : 0 ≤ payoff outside μ)
    (hpayoff_upper : equilibriumPayoff ≤ (N : ℝ) - R ^ β) :
    R ^ β ≤ (N : ℝ) :=
  support_radius_rpow_le_card_of_nonnegative_payoff_upper_bound
    (equilibriumPayoff_nonneg_of_nonnegative_pure_deviation hno houtside)
    hpayoff_upper

/--
Proposition `utility`, assembled source-proof endpoint before the
probabilistic geometry construction: once the source proof has supplied the
support-action upper bound and a pure deviation with payoff at least the
resulting gap, the printed condition forces strictly positive equilibrium
profit.
-/
theorem equilibriumPayoff_pos_of_positive_profit_condition_support_upper_and_deviation
    {D N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {β Q R equilibriumPayoff : ℝ}
    {payoff : Content D → MixedContentStrategy D → ℝ}
    {μ : MixedContentStrategy D} {outside : Content D}
    (hβ : 0 < β) (hQ_nonneg : 0 ≤ Q) (hR_nonneg : 0 ≤ R)
    (hno : SymmetricMixedNoProfitablePureDeviation payoff μ equilibriumPayoff)
    (houtside : 0 ≤ payoff outside μ)
    (hpayoff_upper : equilibriumPayoff ≤ (N : ℝ) - R ^ β)
    (hQ : Q < (1 / (N : ℝ)) ^ ((P : ℝ) / β))
    (hdev :
      ∃ p : Content D, PositiveProfitGeometryGap N P β Q R ≤ payoff p μ) :
    0 < equilibriumPayoff := by
  have hR : R ^ β ≤ (N : ℝ) :=
    support_radius_rpow_le_card_of_deviation_upper_bound hno houtside hpayoff_upper
  have hgap :
      0 < PositiveProfitGeometryGap N P β Q R :=
    positiveProfitGeometryGap_pos_of_positive_profit_condition_and_support_bound
      hβ hQ_nonneg hR_nonneg hR hQ
  rcases hdev with ⟨p, hp⟩
  exact lt_of_lt_of_le (lt_of_lt_of_le hgap hp) (hno p)

/--
Proposition `utility`, clustering pigeonhole step: if the probabilities of the
`N` source direction groups are nonnegative and sum to one, some group has mass
at least `1/N`.
-/
theorem exists_group_mass_ge_one_div_card
    {N : ℕ} [Nonempty (Fin N)] {w : Fin N → ℝ}
    (hw_nonneg : ∀ i, 0 ≤ w i)
    (hsum : (∑ i : Fin N, w i) = 1) :
    ∃ i : Fin N, (1 / (N : ℝ)) ≤ w i := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  by_contra hnone
  have hall_lt : ∀ i : Fin N, w i < 1 / (N : ℝ) := by
    intro i
    exact lt_of_not_ge (not_exists.mp hnone i)
  have hsum_lt :
      (∑ i : Fin N, w i) < ∑ _i : Fin N, (1 / (N : ℝ)) := by
    have huniv_nonempty : (Finset.univ : Finset (Fin N)).Nonempty := by
      exact ⟨Classical.arbitrary (Fin N), Finset.mem_univ _⟩
    exact Finset.sum_lt_sum_of_nonempty
      huniv_nonempty
      (fun i _hi => hall_lt i)
  have hconst : (∑ _i : Fin N, (1 / (N : ℝ))) = 1 := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin]
    simp [hN_pos.ne']
  rw [hsum, hconst] at hsum_lt
  exact (lt_irrefl (1 : ℝ)) hsum_lt

/--
Pigeonhole variant for overlapping measurable covers: if nonnegative masses
sum to at least one, one mass is at least `1/N`.
-/
theorem exists_group_mass_ge_one_div_card_of_one_le_sum
    {N : ℕ} [Nonempty (Fin N)] {w : Fin N → ℝ}
    (hw_nonneg : ∀ i, 0 ≤ w i)
    (hsum : 1 ≤ ∑ i : Fin N, w i) :
    ∃ i : Fin N, (1 / (N : ℝ)) ≤ w i := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  by_contra hnone
  have hall_lt : ∀ i : Fin N, w i < 1 / (N : ℝ) := by
    intro i
    exact lt_of_not_ge (not_exists.mp hnone i)
  have hsum_lt :
      (∑ i : Fin N, w i) < ∑ _i : Fin N, (1 / (N : ℝ)) := by
    have huniv_nonempty : (Finset.univ : Finset (Fin N)).Nonempty := by
      exact ⟨Classical.arbitrary (Fin N), Finset.mem_univ _⟩
    exact Finset.sum_lt_sum_of_nonempty
      huniv_nonempty
      (fun i _hi => hall_lt i)
  have hconst : (∑ _i : Fin N, (1 / (N : ℝ))) = 1 := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin]
    simp [hN_pos.ne']
  rw [hconst] at hsum_lt
  exact not_lt_of_ge hsum hsum_lt

/--
Proposition `utility`, event-probability step: if the selected group has mass
at least `1/N`, then the event that the other `P-1` producers all land in that
group has probability at least `(1/N)^(P-1)` in the independent-product model.
-/
theorem group_event_probability_lower_bound
    {N P : ℕ} [Nonempty (Fin N)] [Nontrivial (Fin P)]
    {mass : ℝ} (hmass_nonneg : 0 ≤ mass)
    (hmass : (1 / (N : ℝ)) ≤ mass) :
    (1 / (N : ℝ)) ^ ((P : ℝ) - 1) ≤ mass ^ ((P : ℝ) - 1) := by
  have hN_card : 0 < Fintype.card (Fin N) :=
    Fintype.card_pos_iff.mpr inferInstance
  have hN_nat : 0 < N := by simpa using hN_card
  have hN_pos : 0 < (N : ℝ) := by exact_mod_cast hN_nat
  have hbase_nonneg : 0 ≤ 1 / (N : ℝ) :=
    (one_div_pos.mpr hN_pos).le
  have hP_card : 1 < Fintype.card (Fin P) :=
    Fintype.one_lt_card_iff_nontrivial.mpr inferInstance
  have hP_nat : 1 < P := by simpa using hP_card
  have hP_exp_nonneg : 0 ≤ (P : ℝ) - 1 := by
    have hP_one : (1 : ℝ) ≤ (P : ℝ) := by
      exact_mod_cast (le_of_lt hP_nat)
    linarith
  exact Real.rpow_le_rpow hbase_nonneg hmass hP_exp_nonneg

/--
Scalar epsilon step used in Proposition `utility`: if `x^β` is strictly below
`B`, then one can increase `x` slightly while keeping the `β`-power below `B`.
-/
theorem exists_scale_gt_with_rpow_lt
    {β x B : ℝ} (hβ : 0 < β) (hx : 0 ≤ x) (hxb : x ^ β < B) :
    ∃ a : ℝ, x < a ∧ a ^ β < B := by
  have hxpow_nonneg : 0 ≤ x ^ β := Real.rpow_nonneg hx β
  rcases exists_between hxb with ⟨s, hs_left, hs_right⟩
  have hs_nonneg : 0 ≤ s := le_of_lt (lt_of_le_of_lt hxpow_nonneg hs_left)
  refine ⟨s ^ β⁻¹, ?_, ?_⟩
  · exact (Real.lt_rpow_inv_iff_of_pos hx hs_nonneg hβ).mpr hs_left
  · rw [Real.rpow_inv_rpow hs_nonneg (ne_of_gt hβ)]
    exact hs_right

/--
Proposition `utility`, scaled-direction epsilon step: along a unit direction
whose selected-user score is one, if the threshold cost `(Q R)^β` is below the
event probability, then some scaled content beats the score threshold while its
norm-power cost remains below the event probability.
-/
theorem exists_scaled_unit_direction_score_gt_cost_lt
    {D : ℕ} (ν : SourceNorm D) {β threshold eventMass : ℝ}
    {u direction : Content D}
    (hβ : 0 < β) (hthreshold : 0 ≤ threshold)
    (hgap : threshold ^ β < eventMass)
    (hscore_unit : score u direction = 1)
    (hnorm_unit : ν.norm direction = 1) :
    ∃ p : Content D,
      threshold < score u p ∧ normRpowCost ν β p < eventMass := by
  rcases exists_scale_gt_with_rpow_lt hβ hthreshold hgap with ⟨a, ha_gt, ha_cost⟩
  have ha_nonneg : 0 ≤ a := le_trans hthreshold ha_gt.le
  refine ⟨scaleContent a direction, ?_, ?_⟩
  · rw [score_scaleContent, hscore_unit, mul_one]
    exact ha_gt
  · unfold normRpowCost
    rw [ν.scale_nonneg ha_nonneg, hnorm_unit, mul_one]
    exact ha_cost

/--
Source event for Proposition `utility`: all producers other than `j` lie in a
selected direction group and inside the support-radius bound `R`.
-/
def AllOtherProducersInBoundedDirectionGroup {D N P : ℕ}
    (j : Fin P) (group : Content D → Fin N) (i : Fin N)
    (ν : SourceNorm D) (R : ℝ) : Set (Fin P → Content D) :=
  {profile | ∀ k : Fin P, k ≠ j →
    group (profile k) = i ∧ ν.norm (profile k) ≤ R}

/-- The source support-radius ball used in Proposition `utility`. -/
def SourceSupportBall {D : ℕ} (ν : SourceNorm D) (R : ℝ) : Set (Content D) :=
  {v | ν.norm v ≤ R}

/-- The one-producer selected set whose product event is
`AllOtherProducersInBoundedDirectionGroup`. -/
def BoundedDirectionGroupSet {D N : ℕ}
    (group : Content D → Fin N) (i : Fin N)
    (ν : SourceNorm D) (R : ℝ) : Set (Content D) :=
  {v | group v = i ∧ ν.norm v ≤ R}

/--
One-producer selected set using the overlapping source min-direction sets:
producer content is within the support-radius bound and user `i` is one of the
minimum-score users for its normalized direction.
-/
def BoundedSourceMinDirectionSet {D N : ℕ}
    (users : Fin N → Content D) (ν : SourceNorm D) (i : Fin N)
    (R : ℝ) : Set (Content D) :=
  {v | v ∈ SourceMinDirectionSet users ν i ∧ ν.norm v ≤ R}

/--
Source event for Proposition `utility` using overlapping min-direction sets:
all opponent producers lie in the same bounded min-direction set.
-/
def AllOtherProducersInBoundedSourceMinDirectionSet {D N P : ℕ}
    (j : Fin P) (users : Fin N → Content D) (i : Fin N)
    (ν : SourceNorm D) (R : ℝ) : Set (Fin P → Content D) :=
  AllOtherProducersInSet j (BoundedSourceMinDirectionSet users ν i R)

theorem measurableSet_boundedSourceMinDirectionSet_of_measurable_norm
    {D N : ℕ} {users : Fin N → Content D}
    {ν : SourceNorm D} {R : ℝ} (i : Fin N)
    (hnorm_meas : Measurable ν.norm) :
    MeasurableSet (BoundedSourceMinDirectionSet users ν i R) := by
  have hEq :
      BoundedSourceMinDirectionSet users ν i R =
        SourceMinDirectionSet users ν i ∩ SourceSupportBall ν R := by
    ext v
    simp [BoundedSourceMinDirectionSet, SourceSupportBall]
  rw [hEq]
  exact
    (measurableSet_sourceMinDirectionSet_of_measurable_norm hnorm_meas i).inter
      (by
        simpa [SourceSupportBall] using
          measurableSet_le hnorm_meas measurable_const)

theorem measurableSet_allOtherProducersInBoundedSourceMinDirectionSet
    {D N P : ℕ} {users : Fin N → Content D} {i : Fin N}
    {ν : SourceNorm D} {R : ℝ}
    (hset : MeasurableSet (BoundedSourceMinDirectionSet users ν i R))
    (j : Fin P) :
    MeasurableSet
      (AllOtherProducersInBoundedSourceMinDirectionSet j users i ν R) :=
  measurableSet_allOtherProducersInSet hset j

theorem measureReal_allOtherProducersInBoundedSourceMinDirectionSet_eq_rpow
    {D N P : ℕ} [Nontrivial (Fin P)]
    {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ]
    (j : Fin P) (users : Fin N → Content D) (i : Fin N)
    (ν : SourceNorm D) (R : ℝ) :
    (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
        (AllOtherProducersInBoundedSourceMinDirectionSet j users i ν R) =
      (μ.real (BoundedSourceMinDirectionSet users ν i R)) ^ ((P : ℝ) - 1) :=
  measureReal_allOtherProducersInSet_eq_rpow (μ := μ) j
    (BoundedSourceMinDirectionSet users ν i R)

theorem measurableSet_sourceSupportBall_of_measurable_norm
    {D : ℕ} {ν : SourceNorm D} {R : ℝ}
    (hnorm_meas : Measurable ν.norm) :
    MeasurableSet (SourceSupportBall ν R) := by
  simpa [SourceSupportBall] using
    measurableSet_le hnorm_meas measurable_const

theorem measurableSet_boundedDirectionGroupSet_of_fiber_and_ball
    {D N : ℕ} {group : Content D → Fin N} {i : Fin N}
    {ν : SourceNorm D} {R : ℝ}
    (hfiber : MeasurableSet {v : Content D | group v = i})
    (hball : MeasurableSet (SourceSupportBall ν R)) :
    MeasurableSet (BoundedDirectionGroupSet group i ν R) := by
  have hEq :
      BoundedDirectionGroupSet group i ν R =
        ({v : Content D | group v = i} ∩ SourceSupportBall ν R) := by
    ext v
    simp [BoundedDirectionGroupSet, SourceSupportBall]
  rw [hEq]
  exact hfiber.inter hball

theorem measurableSet_boundedDirectionGroupSet_of_fiber_and_measurable_norm
    {D N : ℕ} {group : Content D → Fin N} {i : Fin N}
    {ν : SourceNorm D} {R : ℝ}
    (hfiber : MeasurableSet {v : Content D | group v = i})
    (hnorm_meas : Measurable ν.norm) :
    MeasurableSet (BoundedDirectionGroupSet group i ν R) :=
  measurableSet_boundedDirectionGroupSet_of_fiber_and_ball hfiber
    (measurableSet_sourceSupportBall_of_measurable_norm hnorm_meas)

theorem measurableSet_boundedDirectionGroupSet_all_of_fibers_and_measurable_norm
    {D N : ℕ} {group : Content D → Fin N}
    {ν : SourceNorm D} {R : ℝ}
    (hfiber : ∀ i : Fin N, MeasurableSet {v : Content D | group v = i})
    (hnorm_meas : Measurable ν.norm) :
    ∀ i : Fin N, MeasurableSet (BoundedDirectionGroupSet group i ν R) :=
  fun i => measurableSet_boundedDirectionGroupSet_of_fiber_and_measurable_norm
    (hfiber i) hnorm_meas

theorem measureReal_sourceSupportBall_eq_one_of_ae_norm_le
    {D : ℕ} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ]
    {ν : SourceNorm D} {R : ℝ}
    (hae : ∀ᵐ p ∂μ, ν.norm p ≤ R) :
    μ.real (SourceSupportBall ν R) = 1 := by
  have hEq :
      (SourceSupportBall ν R : Set (Content D)) =ᵐ[μ] Set.univ := by
    filter_upwards [hae] with p hp
    apply propext
    constructor
    · intro _h
      trivial
    · intro _h
      exact hp
  have hmeasure :
      μ (SourceSupportBall ν R) = μ (Set.univ : Set (Content D)) :=
    MeasureTheory.measure_congr hEq
  rw [MeasureTheory.Measure.real, hmeasure]
  exact MeasureTheory.probReal_univ

theorem iUnion_boundedDirectionGroupSet_eq_sourceSupportBall
    {D N : ℕ} (group : Content D → Fin N)
    (ν : SourceNorm D) (R : ℝ) :
    (⋃ i : Fin N, BoundedDirectionGroupSet group i ν R) =
      SourceSupportBall ν R := by
  ext v
  constructor
  · intro hv
    rcases Set.mem_iUnion.mp hv with ⟨i, hi⟩
    exact hi.2
  · intro hv
    exact Set.mem_iUnion.mpr
      ⟨group v, by simpa [BoundedDirectionGroupSet, SourceSupportBall] using hv⟩

theorem pairwiseDisjoint_boundedDirectionGroupSet
    {D N : ℕ} (group : Content D → Fin N)
    (ν : SourceNorm D) (R : ℝ) :
    Set.PairwiseDisjoint (Set.univ : Set (Fin N))
      (fun i : Fin N => BoundedDirectionGroupSet group i ν R) := by
  intro i _hi j _hj hij
  change Disjoint
    (BoundedDirectionGroupSet group i ν R)
    (BoundedDirectionGroupSet group j ν R)
  rw [Set.disjoint_left]
  intro v hvi hvj
  have hij' : i = j := by
    rw [← hvi.1, ← hvj.1]
  exact hij hij'

theorem sum_measureReal_boundedDirectionGroupSet_eq_sourceSupportBall
    {D N : ℕ} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsFiniteMeasure μ]
    (group : Content D → Fin N) (ν : SourceNorm D) (R : ℝ)
    (hmeas : ∀ i : Fin N, MeasurableSet (BoundedDirectionGroupSet group i ν R)) :
    (∑ i : Fin N, μ.real (BoundedDirectionGroupSet group i ν R)) =
      μ.real (SourceSupportBall ν R) := by
  classical
  have hmeasure :=
    MeasureTheory.measureReal_biUnion_finset
      (μ := μ) (s := (Finset.univ : Finset (Fin N)))
      (f := fun i : Fin N => BoundedDirectionGroupSet group i ν R)
      (by
        simpa using
          pairwiseDisjoint_boundedDirectionGroupSet group ν R)
      (fun i _hi => hmeas i)
  have hcover :
      (⋃ b ∈ (Finset.univ : Finset (Fin N)),
          BoundedDirectionGroupSet group b ν R) =
        SourceSupportBall ν R := by
    ext v
    simp [iUnion_boundedDirectionGroupSet_eq_sourceSupportBall]
  rw [hcover] at hmeasure
  simpa using hmeasure.symm

theorem exists_bounded_direction_group_mass_ge_one_div_card
    {D N : ℕ} [Nonempty (Fin N)]
    {μ : MeasureTheory.Measure (Content D)} [MeasureTheory.IsFiniteMeasure μ]
    (group : Content D → Fin N) (ν : SourceNorm D) (R : ℝ)
    (hmeas : ∀ i : Fin N, MeasurableSet (BoundedDirectionGroupSet group i ν R))
    (hsupport : μ.real (SourceSupportBall ν R) = 1) :
    ∃ i : Fin N, (1 / (N : ℝ)) ≤
      μ.real (BoundedDirectionGroupSet group i ν R) := by
  have hsum :
      (∑ i : Fin N, μ.real (BoundedDirectionGroupSet group i ν R)) = 1 := by
    rw [sum_measureReal_boundedDirectionGroupSet_eq_sourceSupportBall
      group ν R hmeas, hsupport]
  exact exists_group_mass_ge_one_div_card
    (fun i => MeasureTheory.measureReal_nonneg) hsum

theorem allOtherProducersInBoundedDirectionGroup_eq_inSet
    {D N P : ℕ} (j : Fin P) (group : Content D → Fin N) (i : Fin N)
    (ν : SourceNorm D) (R : ℝ) :
    AllOtherProducersInBoundedDirectionGroup j group i ν R =
      AllOtherProducersInSet j (BoundedDirectionGroupSet group i ν R) := by
  rfl

theorem measurableSet_allOtherProducersInBoundedDirectionGroup
    {D N P : ℕ} {group : Content D → Fin N} {i : Fin N}
    {ν : SourceNorm D} {R : ℝ}
    (hgroup_meas : MeasurableSet (BoundedDirectionGroupSet group i ν R))
    (j : Fin P) :
    MeasurableSet (AllOtherProducersInBoundedDirectionGroup j group i ν R) := by
  rw [allOtherProducersInBoundedDirectionGroup_eq_inSet]
  exact measurableSet_allOtherProducersInSet hgroup_meas j

theorem measureReal_allOtherProducersInBoundedDirectionGroup_eq_pow
    {D N P : ℕ} {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ]
    (j : Fin P) (group : Content D → Fin N) (i : Fin N)
    (ν : SourceNorm D) (R : ℝ) :
    (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
        (AllOtherProducersInBoundedDirectionGroup j group i ν R) =
      (μ.real (BoundedDirectionGroupSet group i ν R)) ^ (P - 1) := by
  rw [allOtherProducersInBoundedDirectionGroup_eq_inSet]
  exact measureReal_allOtherProducersInSet_eq_pow (μ := μ) j
    (BoundedDirectionGroupSet group i ν R)

theorem measureReal_allOtherProducersInBoundedDirectionGroup_eq_rpow
    {D N P : ℕ} [Nontrivial (Fin P)]
    {μ : MeasureTheory.Measure (Content D)}
    [MeasureTheory.IsProbabilityMeasure μ]
    (j : Fin P) (group : Content D → Fin N) (i : Fin N)
    (ν : SourceNorm D) (R : ℝ) :
    (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
        (AllOtherProducersInBoundedDirectionGroup j group i ν R) =
      (μ.real (BoundedDirectionGroupSet group i ν R)) ^ ((P : ℝ) - 1) := by
  rw [allOtherProducersInBoundedDirectionGroup_eq_inSet]
  exact measureReal_allOtherProducersInSet_eq_rpow (μ := μ) j
    (BoundedDirectionGroupSet group i ν R)

/--
Proposition `utility`, pointwise geometry step: on the bounded selected-group
event, any deviation whose selected-user score is strictly above `Q R` wins
that user outright.
-/
theorem usersWon_ge_one_on_bounded_direction_group_deviation
    {D N P : ℕ} {users : Fin N → Content D} {ν : SourceNorm D}
    {group : Content D → Fin N} {i : Fin N} {j : Fin P}
    {profile : Fin P → Content D} {p : Content D} {Q R : ℝ}
    (hprofile :
      profile ∈ AllOtherProducersInBoundedDirectionGroup j group i ν R)
    (hgroup :
      ∀ v : Content D, group v = i →
        score (users i) v ≤ Q * ν.norm v)
    (hQ_nonneg : 0 ≤ Q)
    (hdev_score : Q * R < score (users i) p) :
    1 ≤ usersWon users (deviateProfile profile j p) j := by
  classical
  have hstrict :
      StrictWinner (users i) (deviateProfile profile j p) j := by
    intro k hk
    rcases hprofile k hk with ⟨hgroup_k, hnorm_k⟩
    have hscore_le_norm :
        score (users i) (profile k) ≤ Q * ν.norm (profile k) :=
      hgroup (profile k) hgroup_k
    have hnorm_le_R : Q * ν.norm (profile k) ≤ Q * R :=
      mul_le_mul_of_nonneg_left hnorm_k hQ_nonneg
    have hscore_lt : score (users i) (profile k) < score (users i) p :=
      lt_of_le_of_lt (le_trans hscore_le_norm hnorm_le_R) hdev_score
    rw [deviateProfile_of_ne profile p hk, deviateProfile_self]
    exact hscore_lt
  have hshare :
      tieShare (users i) (deviateProfile profile j p) j = 1 :=
    tieShare_eq_one_of_strictWinner hstrict
  have hsingle :
      (1 : ℝ) ≤
        ∑ i' : Fin N,
          tieShare (users i') (deviateProfile profile j p) j := by
    simpa [hshare] using
      (Finset.single_le_sum
        (fun i' _hi' =>
          tieShare_nonneg (users i') (deviateProfile profile j p) j)
        (Finset.mem_univ i))
  simpa [usersWon] using hsingle

/--
Proposition `utility`, pointwise geometry step for the overlapping
min-direction sets: on the bounded selected min-direction event, any deviation
whose selected-user score is strictly above `Q R` wins that user outright.
-/
theorem usersWon_ge_one_on_bounded_source_min_direction_deviation
    {D N P : ℕ} [Nonempty (Fin N)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {i : Fin N} {j : Fin P}
    {profile : Fin P → Content D} {p : Content D} {Q R : ℝ}
    (hprofile :
      profile ∈ AllOtherProducersInBoundedSourceMinDirectionSet j users i ν R)
    (hQupper : SourceUnitDirectionQUpperBound users ν Q)
    (hQ_nonneg : 0 ≤ Q)
    (hdev_score : Q * R < score (users i) p) :
    1 ≤ usersWon users (deviateProfile profile j p) j := by
  classical
  have hstrict :
      StrictWinner (users i) (deviateProfile profile j p) j := by
    intro k hk
    have hprofile_k :
        profile k ∈ BoundedSourceMinDirectionSet users ν i R :=
      hprofile k hk
    have hscore_le_norm :
        score (users i) (profile k) ≤ Q * ν.norm (profile k) :=
      sourceMinDirectionSet_bound_of_QUpper hQ_nonneg hQupper
        i (profile k) hprofile_k.1
    have hnorm_le_R : Q * ν.norm (profile k) ≤ Q * R :=
      mul_le_mul_of_nonneg_left hprofile_k.2 hQ_nonneg
    have hscore_lt : score (users i) (profile k) < score (users i) p :=
      lt_of_le_of_lt (le_trans hscore_le_norm hnorm_le_R) hdev_score
    rw [deviateProfile_of_ne profile p hk, deviateProfile_self]
    exact hscore_lt
  have hshare :
      tieShare (users i) (deviateProfile profile j p) j = 1 :=
    tieShare_eq_one_of_strictWinner hstrict
  have hsingle :
      (1 : ℝ) ≤
        ∑ i' : Fin N,
          tieShare (users i') (deviateProfile profile j p) j := by
    simpa [hshare] using
      (Finset.single_le_sum
        (fun i' _hi' =>
          tieShare_nonneg (users i') (deviateProfile profile j p) j)
        (Finset.mem_univ i))
  simpa [usersWon] using hsingle

/--
Generic event lower bound: if an integrable random payoff is nonnegative and
is at least `c` on a measurable event `E`, then its expectation is at least
`c * μ.real E`.
-/
theorem integral_lower_bound_of_pointwise_event
    {Ω : Type*} [MeasurableSpace Ω]
    {μ : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure μ]
    {f : Ω → ℝ} {E : Set Ω} {c : ℝ}
    (hE : MeasurableSet E)
    (hf : MeasureTheory.Integrable f μ)
    (hnonneg : 0 ≤ᵐ[μ] f)
    (hevent : ∀ᵐ ω ∂μ, ω ∈ E → c ≤ f ω)
    (hc : 0 ≤ c) :
    c * μ.real E ≤ ∫ ω, f ω ∂μ := by
  have hzero_int : MeasureTheory.Integrable (fun _ω : Ω => (0 : ℝ)) μ :=
    MeasureTheory.integrable_const 0
  have hevent' :
      ∀ᵐ ω ∂μ, ω ∈ E → c ≤ f ω - (fun _ω : Ω => (0 : ℝ)) ω := by
    filter_upwards [hevent] with ω hω hωE
    simpa using hω hωE
  have h :=
    integral_gain_lower_bound_of_pointwise_event
      (μ := μ) (f := fun _ω : Ω => (0 : ℝ)) (g := f)
      (E := E) (c := c) hE hzero_int hf hnonneg hevent' hc
  simpa using h

/--
Proposition `utility`, expected-user event bridge: if on a measurable event the
deviating producer wins at least `c` users, then the source expected-users term
is at least `c` times the event probability.
-/
theorem expectedUsersWonAgainstSymmetricMixed_lower_bound_of_event
    {D N P : ℕ} {users : Fin N → Content D}
    {μ : MixedContentStrategy D} [MeasureTheory.IsFiniteMeasure μ]
    {p : Content D} {j : Fin P} {E : Set (Fin P → Content D)} {c : ℝ}
    (hE : MeasurableSet E)
    (hint :
      MeasureTheory.Integrable
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j p) j)
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)))
    (hevent :
      ∀ᵐ profile ∂MeasureTheory.Measure.pi (fun _ : Fin P => μ),
        profile ∈ E → c ≤ usersWon users (deviateProfile profile j p) j)
    (hc : 0 ≤ c) :
    c * (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real E ≤
      ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  let productMeasure : MeasureTheory.Measure (Fin P → Content D) :=
    MeasureTheory.Measure.pi (fun _ : Fin P => μ)
  have hnonneg :
      0 ≤ᵐ[productMeasure]
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j p) j) :=
    Filter.Eventually.of_forall fun profile =>
      usersWon_nonneg users (deviateProfile profile j p) j
  have h :=
    integral_lower_bound_of_pointwise_event
      (μ := productMeasure)
      (f := fun profile : Fin P → Content D =>
        usersWon users (deviateProfile profile j p) j)
      (E := E) (c := c) hE (by simpa [productMeasure] using hint)
      hnonneg (by simpa [productMeasure] using hevent) hc
  simpa [ExpectedUsersWonAgainstSymmetricMixed, productMeasure] using h

/--
Proposition `utility`, direct event-to-equilibrium endpoint: if a measurable
event guarantees the deviating producer at least `c` users, and the deviation
cost is strictly below `c` times that event's probability, then no-profitable
deviation forces positive equilibrium payoff.
-/
theorem equilibriumPayoff_pos_of_event_win_lower_bound_and_cost_lt
    {D N P : ℕ} {users : Fin N → Content D}
    {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} [MeasureTheory.IsFiniteMeasure μ]
    {equilibriumPayoff : ℝ} {p : Content D} {j : Fin P}
    {E : Set (Fin P → Content D)} {c : ℝ}
    (hno :
      SymmetricMixedNoProfitablePureDeviation
        (SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost)
        μ equilibriumPayoff)
    (hE : MeasurableSet E)
    (hint :
      MeasureTheory.Integrable
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j p) j)
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)))
    (hevent :
      ∀ᵐ profile ∂MeasureTheory.Measure.pi (fun _ : Fin P => μ),
        profile ∈ E → c ≤ usersWon users (deviateProfile profile j p) j)
    (hc : 0 ≤ c)
    (hcost : cost p <
      c * (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real E) :
    0 < equilibriumPayoff := by
  have hexpected :
      c * (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real E ≤
        ExpectedUsersWonAgainstSymmetricMixed users j p μ :=
    expectedUsersWonAgainstSymmetricMixed_lower_bound_of_event
      hE hint hevent hc
  have hpayoff_pos :
      0 <
        SourceMixedPurePayoff
          (ExpectedUsersWonAgainstSymmetricMixed users j) cost p μ := by
    unfold SourceMixedPurePayoff
    linarith
  exact lt_of_lt_of_le hpayoff_pos (hno p)

/--
Proposition `utility`, expected-users lower bound for the bounded selected
direction-group event.
-/
theorem expectedUsersWonAgainstSymmetricMixed_lower_bound_of_bounded_direction_group_event
    {D N P : ℕ} {users : Fin N → Content D} {ν : SourceNorm D}
    {group : Content D → Fin N} {i : Fin N} {j : Fin P}
    {μ : MixedContentStrategy D} [MeasureTheory.IsFiniteMeasure μ]
    {p : Content D} {Q R : ℝ}
    (hE :
      MeasurableSet
        (AllOtherProducersInBoundedDirectionGroup j group i ν R))
    (hint :
      MeasureTheory.Integrable
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j p) j)
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)))
    (hgroup :
      ∀ v : Content D, group v = i →
        score (users i) v ≤ Q * ν.norm v)
    (hQ_nonneg : 0 ≤ Q)
    (hdev_score : Q * R < score (users i) p) :
    (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
        (AllOtherProducersInBoundedDirectionGroup j group i ν R) ≤
      ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  let E := AllOtherProducersInBoundedDirectionGroup j group i ν R
  have hevent :
      ∀ᵐ profile ∂MeasureTheory.Measure.pi (fun _ : Fin P => μ),
        profile ∈ E →
          (1 : ℝ) ≤ usersWon users (deviateProfile profile j p) j :=
    Filter.Eventually.of_forall fun profile hprofile =>
      usersWon_ge_one_on_bounded_direction_group_deviation
        hprofile hgroup hQ_nonneg hdev_score
  have h :=
    expectedUsersWonAgainstSymmetricMixed_lower_bound_of_event
      (users := users) (μ := μ) (p := p) (j := j)
      (E := E) (c := 1) hE hint hevent (by norm_num)
  simpa [E] using h

/--
Proposition `utility`, expected-users lower bound for the selected
source-min-direction event.  This is the source-min analogue of the preceding
selected-direction-group bound: on the event, the deviator strictly beats the
score of every other producer for the selected user.
-/
theorem expectedUsersWonAgainstSymmetricMixed_lower_bound_of_bounded_source_min_direction_event
    {D N P : ℕ} [Nonempty (Fin N)]
    {users : Fin N → Content D} {ν : SourceNorm D}
    {i : Fin N} {j : Fin P}
    {μ : MixedContentStrategy D} [MeasureTheory.IsFiniteMeasure μ]
    {p : Content D} {Q R : ℝ}
    (hE :
      MeasurableSet
        (AllOtherProducersInBoundedSourceMinDirectionSet j users i ν R))
    (hint :
      MeasureTheory.Integrable
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j p) j)
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)))
    (hQupper : SourceUnitDirectionQUpperBound users ν Q)
    (hQ_nonneg : 0 ≤ Q)
    (hdev_score : Q * R < score (users i) p) :
    (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real
        (AllOtherProducersInBoundedSourceMinDirectionSet j users i ν R) ≤
      ExpectedUsersWonAgainstSymmetricMixed users j p μ := by
  let E := AllOtherProducersInBoundedSourceMinDirectionSet j users i ν R
  have hevent :
      ∀ᵐ profile ∂MeasureTheory.Measure.pi (fun _ : Fin P => μ),
        profile ∈ E →
          (1 : ℝ) ≤ usersWon users (deviateProfile profile j p) j :=
    Filter.Eventually.of_forall fun profile hprofile =>
      usersWon_ge_one_on_bounded_source_min_direction_deviation
        hprofile hQupper hQ_nonneg hdev_score
  have h :=
    expectedUsersWonAgainstSymmetricMixed_lower_bound_of_event
      (users := users) (μ := μ) (p := p) (j := j)
      (E := E) (c := 1) hE hint hevent (by norm_num)
  simpa [E] using h

/--
Proposition `utility`, bounded-group event endpoint: if the source selected
group event is measurable, the deviation beats the `Q R` score threshold on
that event, and its cost is below the event probability, then the symmetric
equilibrium payoff is strictly positive.
-/
theorem equilibriumPayoff_pos_of_bounded_direction_group_event_cost_lt
    {D N P : ℕ} {users : Fin N → Content D} {ν : SourceNorm D}
    {group : Content D → Fin N} {i : Fin N} {j : Fin P}
    {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} [MeasureTheory.IsFiniteMeasure μ]
    {equilibriumPayoff : ℝ} {p : Content D} {Q R : ℝ}
    (hno :
      SymmetricMixedNoProfitablePureDeviation
        (SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost)
        μ equilibriumPayoff)
    (hE :
      MeasurableSet
        (AllOtherProducersInBoundedDirectionGroup j group i ν R))
    (hint :
      MeasureTheory.Integrable
        (fun profile : Fin P → Content D =>
          usersWon users (deviateProfile profile j p) j)
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)))
    (hgroup :
      ∀ v : Content D, group v = i →
