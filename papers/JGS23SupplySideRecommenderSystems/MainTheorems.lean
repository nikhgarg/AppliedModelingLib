/--
The support-radius ball is covered by the overlapping bounded source-min
direction sets.
-/
theorem sourceSupportBall_subset_iUnion_boundedSourceMinDirectionSet
    {D N : ℕ} [Nonempty (Fin N)]
    (users : Fin N → Content D) (ν : SourceNorm D) (R : ℝ) :
    SourceSupportBall ν R ⊆
      ⋃ i : Fin N, BoundedSourceMinDirectionSet users ν i R := by
  intro p hp
  refine Set.mem_iUnion.mpr ?_
  refine ⟨sourceMinScoreUser users ν p, ?_⟩
  exact ⟨fun k => sourceMinScoreUser_min users ν p k, hp⟩

theorem exists_bounded_source_min_direction_set_mass_ge_one_div_card
    {D N : ℕ} [Nonempty (Fin N)]
    {μ : MeasureTheory.Measure (Content D)} [MeasureTheory.IsFiniteMeasure μ]
    (users : Fin N → Content D) (ν : SourceNorm D) (R : ℝ)
    (hsupport : μ.real (SourceSupportBall ν R) = 1) :
    ∃ i : Fin N, (1 / (N : ℝ)) ≤
      μ.real (BoundedSourceMinDirectionSet users ν i R) := by
  have hsupport_le_union :
      μ.real (SourceSupportBall ν R) ≤
        μ.real (⋃ i : Fin N, BoundedSourceMinDirectionSet users ν i R) :=
    MeasureTheory.measureReal_mono
      (μ := μ)
      (sourceSupportBall_subset_iUnion_boundedSourceMinDirectionSet users ν R)
  have hunion_le_sum :
      μ.real (⋃ i : Fin N, BoundedSourceMinDirectionSet users ν i R) ≤
        ∑ i : Fin N, μ.real (BoundedSourceMinDirectionSet users ν i R) := by
    simpa using
      (MeasureTheory.measureReal_biUnion_finset_le
        (μ := μ) (s := (Finset.univ : Finset (Fin N)))
        (f := fun i : Fin N => BoundedSourceMinDirectionSet users ν i R))
  have hsum_ge :
      1 ≤ ∑ i : Fin N, μ.real (BoundedSourceMinDirectionSet users ν i R) := by
    rw [← hsupport]
    exact le_trans hsupport_le_union hunion_le_sum
  exact exists_group_mass_ge_one_div_card_of_one_le_sum
    (fun _i => MeasureTheory.measureReal_nonneg) hsum_ge

