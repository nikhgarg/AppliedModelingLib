        (hcdf1 z.1 (canonicalTwoUser_firstScore_mem_support_of_mem_valueSupport hz))
    exact (AppliedModelingLib.Probability.iidMaximumCdf_contDiffAt_of_lowerCDFMass
      (n := P - 1) hraw).of_le (by norm_num)
  have hcontDiff2 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support,
      z ≠ (0, 0) → ContDiffAt ℝ 1 H2 z.2 := by
    intro z hz _
    have hraw : ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass μ2) z.2 := by
      simpa [μ2] using
        (hcdf2 z.2 (canonicalTwoUser_secondScore_mem_support_of_mem_valueSupport hz))
    exact (AppliedModelingLib.Probability.iidMaximumCdf_contDiffAt_of_lowerCDFMass
      (n := P - 1) hraw).of_le (by norm_num)
  have hderiv1 : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support,
      z ≠ (0, 0) → HasDerivAt H1 (deriv H1 z.1) z.1 := by
    intro z hz hne
