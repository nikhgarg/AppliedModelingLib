theorem twoUser_no_l2Ball_contentSupport_of_sourceSymmetricMixedNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ ε : ℝ}
    {μ : Measure (Content 2)} {p0 : Content 2} [IsProbabilityMeasure μ]
