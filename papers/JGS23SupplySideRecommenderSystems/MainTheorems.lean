/--
Proposition `finitegenre`, overlap-graph propagation: once each overlap edge
equates a genre label and the overlap graph is preconnected, all genre labels
are equal.  This isolates the source's path-chaining argument; constructing
the overlap graph and proving its preconnectedness from support/CDF facts are
separate obligations.
-/
theorem finiteGenre_overlapLabel_eq_of_preconnected
    {V W : Type*} {G : SimpleGraph V} (hpreconnected : G.Preconnected)
    (label : V → W)
    (hlabel : ∀ ⦃i j : V⦄, G.Adj i j → label i = label j)
    (i j : V) : label i = label j :=
  AppliedModelingLib.Math.Graph.eq_of_adj_eq_of_preconnected
    hpreconnected label hlabel i j

/--
Proposition `finitegenre`, support-topology step: the source's proposed
finite partition of a connected score-support interval by disjoint closed
components must have only one nonempty component.  This theorem verifies that
topological inference with all cover and relative-closedness premises shown.
-/
theorem finiteGenre_closedPartition_subsingleton
    {ι : Type*} [Finite ι] {a b : ℝ} (component : ι → Set ℝ)
    (hnonempty : ∀ i, (component i ∩ Set.Icc a b).Nonempty)
    (hdisjoint : Pairwise fun i j =>
      Disjoint (component i ∩ Set.Icc a b) (component j ∩ Set.Icc a b))
    (hclosed : ∀ i, IsClosed (component i ∩ Set.Icc a b))
    (hcover : ⋃ i, component i ∩ Set.Icc a b = Set.Icc a b) :
    Subsingleton ι :=
  AppliedModelingLib.subsingleton_of_pairwiseDisjoint_closed_cover_of_isPreconnected
    isPreconnected_Icc component hnonempty hdisjoint hclosed hcover

/--
Proposition `finitegenre`, combined overlap step: if the finite genre-overlap
components form the source's nonempty closed cover of the score-support
interval, then equality on overlap edges equates the label at every pair of
genres.  The source-to-component construction remains explicit.
-/
theorem finiteGenre_overlapLabel_eq_of_closed_cover
    {ι W : Type*} [Fintype ι] [Nonempty ι] {a b : ℝ}
    (component : ι → Set ℝ)
    (hnonempty : ∀ i, (component i ∩ Set.Icc a b).Nonempty)
    (hclosed : ∀ i, IsClosed (component i ∩ Set.Icc a b))
    (hcover : ⋃ i, component i ∩ Set.Icc a b = Set.Icc a b)
    (label : ι → W)
    (hedge : ∀ ⦃i j : ι⦄,
      (AppliedModelingLib.setFamilyOverlapGraph (Set.Icc a b) component).Adj i j →
        label i = label j)
    (i j : ι) : label i = label j := by
  exact AppliedModelingLib.Math.Graph.eq_of_adj_eq_of_connected
    (AppliedModelingLib.setFamilyOverlapGraph_connected_of_isPreconnected
      isPreconnected_Icc component hnonempty hclosed hcover)
    label hedge i j

/--
Proposition `finitegenre`, local FOC cancellation: two genres present at the
same score coordinate have the same displayed angle-label factor whenever the
common density prefactor is nonzero.
-/
theorem finiteGenre_label_eq_of_shared_density
    {density pref label_i label_j : ℝ} (hpref : pref ≠ 0)
    (hi : density = pref * label_i) (hj : density = pref * label_j) :
    label_i = label_j := by
  apply (mul_left_cancel₀ hpref)
  rw [← hi, hj]

/--
Proposition `finitegenre`, combined FOC-and-overlap step.  If each genre's
score component obeys a common nonzero-prefactor density formula, its label is
equal on overlap edges; the finite closed-cover overlap argument then makes
that label constant across all genres.
-/
theorem finiteGenre_label_eq_of_shared_density_closed_cover
    {ι : Type*} [Fintype ι] [Nonempty ι] {a b : ℝ}
    (component : ι → Set ℝ)
    (hnonempty : ∀ i, (component i ∩ Set.Icc a b).Nonempty)
    (hclosed : ∀ i, IsClosed (component i ∩ Set.Icc a b))
    (hcover : ⋃ i, component i ∩ Set.Icc a b = Set.Icc a b)
    (density pref : ℝ → ℝ) (label : ι → ℝ)
    (hpref : ∀ w, w ∈ Set.Icc a b → pref w ≠ 0)
    (hdensity : ∀ i w, w ∈ component i ∩ Set.Icc a b →
      density w = pref w * label i)
    (i j : ι) : label i = label j := by
  apply finiteGenre_overlapLabel_eq_of_closed_cover
    component hnonempty hclosed hcover label
  intro k l hedge
  change k ≠ l ∧
    (((component k ∩ Set.Icc a b) ∩ (component l ∩ Set.Icc a b)).Nonempty ∨
      ((component l ∩ Set.Icc a b) ∩ (component k ∩ Set.Icc a b)).Nonempty) at hedge
  rcases hedge.2 with hinter | hinter
  · rcases hinter with ⟨w, hwk, hwl⟩
    exact finiteGenre_label_eq_of_shared_density
      (hpref w hwk.2) (hdensity k w hwk) (hdensity l w hwl)
  · rcases hinter with ⟨w, hwl, hwk⟩
    exact finiteGenre_label_eq_of_shared_density
      (hpref w hwk.2) (hdensity k w hwk) (hdensity l w hwl)

/--
Finite-genre source-to-topology bridge.  If compact joint value support is
covered by finitely many closed genre pieces, then the first-score images of
those pieces are closed and cover the complete first-score interval.  Hence a
common nonzero-prefactor density formula propagates its label equality across
all genre pieces by the overlap argument.
-/
theorem finiteGenre_label_eq_of_shared_density_of_compact_closed_piece_cover
    {ι : Type*} [Fintype ι] [Nonempty ι] {a b : ℝ}
    {S : Set (ℝ × ℝ)} (piece : ι → Set (ℝ × ℝ))
    (hcompact : IsCompact S) (hpiece_closed : ∀ i, IsClosed (piece i))
    (hpiece_cover : S ⊆ ⋃ i, piece i)
    (hfst_image : Prod.fst '' S = Set.Icc a b)
    (hnonempty : ∀ i,
      ((Prod.fst '' (S ∩ piece i)) ∩ Set.Icc a b).Nonempty)
    (density pref : ℝ → ℝ) (label : ι → ℝ)
    (hpref : ∀ w, w ∈ Set.Icc a b → pref w ≠ 0)
    (hdensity : ∀ i w, w ∈ (Prod.fst '' (S ∩ piece i)) ∩ Set.Icc a b →
      density w = pref w * label i)
    (i j : ι) : label i = label j := by
  apply finiteGenre_label_eq_of_shared_density_closed_cover
    (component := fun k => Prod.fst '' (S ∩ piece k)) hnonempty
  · intro k
    exact ((hcompact.inter_right (hpiece_closed k)).image continuous_fst).isClosed
      |>.inter isClosed_Icc
  · ext w
    constructor
    · rintro hw
      rcases Set.mem_iUnion.mp hw with ⟨k, hwk⟩
      exact hwk.2
    · intro hw
      have hw_image : w ∈ Prod.fst '' S := by
        rw [hfst_image]
        exact hw
      rcases hw_image with ⟨z, hzS, hzw⟩
      rcases Set.mem_iUnion.mp (hpiece_cover hzS) with ⟨k, hzk⟩
      apply Set.mem_iUnion.mpr
      exact ⟨k, ⟨⟨z, ⟨hzS, hzk⟩, hzw⟩, hw⟩⟩
  · exact hpref
  · exact hdensity

/--
The canonical value-space ray for a source genre angle.  When the first
cosine is positive it is exactly the nonnegative-radius image of
`r ↦ (r cos(theta), r cos(thetaStar - theta))`; the slope presentation keeps
the piece closed without imposing an artificial radius cap.
-/
def canonicalTwoUserGenreRay (θstar θ : ℝ) : Set (ℝ × ℝ) :=
  {z | 0 ≤ z.1 ∧
    z.2 = z.1 * (Real.cos (θstar - θ) / Real.cos θ)}

/-- Every canonical genre ray is a closed value-space piece. -/
theorem isClosed_canonicalTwoUserGenreRay (θstar θ : ℝ) :
    IsClosed (canonicalTwoUserGenreRay θstar θ) := by
  unfold canonicalTwoUserGenreRay
  exact (isClosed_le continuous_const continuous_fst).and
    (isClosed_eq continuous_snd (continuous_fst.mul continuous_const))

/--
A continuous graph over a positive score interval cannot switch between a
finite collection of canonical genre rays.  The quotient `g x / x` is
continuous away from the origin, takes values in a finite slope set, and
therefore has singleton connected image.  This is a topological bridge, not a
second-order `regionscolor` argument.
-/
theorem canonicalTwoUser_continuous_graph_mem_single_canonicalGenreRay_of_finite_cover
    {ι : Type*} [Fintype ι] [Nonempty ι] {a b θstar : ℝ} {g : ℝ → ℝ}
    (angle : ι → ℝ) (ha : 0 < a) (hab : a ≤ b)
    (hcont : ContinuousOn g (Set.Icc a b))
    (hcover : ∀ x, x ∈ Set.Icc a b →
      (x, g x) ∈ ⋃ i, canonicalTwoUserGenreRay θstar (angle i)) :
    ∃ i, ∀ x, x ∈ Set.Icc a b →
      (x, g x) ∈ canonicalTwoUserGenreRay θstar (angle i) := by
  let slope : ι → ℝ := fun i =>
    Real.cos (θstar - angle i) / Real.cos (angle i)
  let quotient : ℝ → ℝ := fun x => g x / x
  have hquotient_cont : ContinuousOn quotient (Set.Icc a b) := by
    exact hcont.div continuousOn_id (fun x hx =>
      ne_of_gt (ha.trans_le hx.1))
  have hquotient_range : quotient '' Set.Icc a b ⊆ Set.range slope := by
    rintro y ⟨x, hx, rfl⟩
    rcases Set.mem_iUnion.mp (hcover x hx) with ⟨i, hi⟩
    refine ⟨i, ?_⟩
    have hxne : x ≠ 0 := ne_of_gt (ha.trans_le hx.1)
    change slope i = g x / x
    rw [show g x = x * slope i by
      simpa only [canonicalTwoUserGenreRay] using hi.2]
    field_simp
  have hquotient_finite : (quotient '' Set.Icc a b).Finite :=
    (Set.finite_range slope).subset hquotient_range
  have hquotient_preconnected : IsPreconnected (quotient '' Set.Icc a b) :=
    isPreconnected_Icc.image quotient hquotient_cont
  have hquotient_subsingleton : (quotient '' Set.Icc a b).Subsingleton := by
    rcases Set.subsingleton_or_nontrivial (quotient '' Set.Icc a b) with h | h
    · exact h
    · exact (hquotient_finite.not_infinite
        (hquotient_preconnected.infinite_of_nontrivial h)).elim
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcover a ⟨le_rfl, hab⟩)
  refine ⟨i, ?_⟩
  intro x hx
  have hquotient_eq : quotient x = quotient a :=
    hquotient_subsingleton ⟨x, hx, rfl⟩ ⟨a, ⟨le_rfl, hab⟩, rfl⟩
  have ha_ne : a ≠ 0 := ne_of_gt ha
  have ha_slope : quotient a = slope i := by
    change g a / a = slope i
    rw [show g a = a * slope i by
      simpa only [canonicalTwoUserGenreRay] using hi.2]
    field_simp
  have hx_ne : x ≠ 0 := ne_of_gt (ha.trans_le hx.1)
  unfold canonicalTwoUserGenreRay
  refine ⟨(ha.trans_le hx.1).le, ?_⟩
  change g x = x * slope i
  calc
    g x = x * quotient x := by
      dsimp [quotient]
      field_simp
    _ = x * quotient a := by rw [hquotient_eq]
    _ = x * slope i := by rw [ha_slope]

/--
Two canonical genre rays meeting at a point with positive first score have the
same angle on the principal tangent interval.  The finite-genre argument uses
this only after the continuous-graph lemma has ruled out ray switching away
from the origin.
-/
theorem canonicalTwoUser_angle_eq_of_mem_canonicalGenreRay_of_fst_pos
    {θstar φ ψ : ℝ} {z : ℝ × ℝ}
    (hsin : Real.sin θstar ≠ 0)
    (hφ : φ ∈ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2))
    (hψ : ψ ∈ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2))
    (hz : 0 < z.1)
    (hzφ : z ∈ canonicalTwoUserGenreRay θstar φ)
    (hzψ : z ∈ canonicalTwoUserGenreRay θstar ψ) :
    φ = ψ := by
  have hφcos : Real.cos φ ≠ 0 := ne_of_gt (Real.cos_pos_of_mem_Ioo hφ)
  have hψcos : Real.cos ψ ≠ 0 := ne_of_gt (Real.cos_pos_of_mem_Ioo hψ)
  have hz_ne : z.1 ≠ 0 := ne_of_gt hz
  have hslope :
      Real.cos (θstar - φ) / Real.cos φ =
        Real.cos (θstar - ψ) / Real.cos ψ := by
    unfold canonicalTwoUserGenreRay at hzφ hzψ
    apply mul_left_cancel₀ hz_ne
    linarith [hzφ.2, hzψ.2]
  have hφformula :
      Real.cos (θstar - φ) / Real.cos φ =
        Real.cos θstar + Real.sin θstar * Real.tan φ := by
    rw [Real.cos_sub, Real.tan_eq_sin_div_cos]
    field_simp
  have hψformula :
      Real.cos (θstar - ψ) / Real.cos ψ =
        Real.cos θstar + Real.sin θstar * Real.tan ψ := by
    rw [Real.cos_sub, Real.tan_eq_sin_div_cos]
    field_simp
  have htan : Real.tan φ = Real.tan ψ := by
    apply mul_left_cancel₀ hsin
    rw [hφformula, hψformula] at hslope
    linarith
  exact Real.tan_inj_of_lt_of_lt_pi_div_two hφ.1 hφ.2 hψ.1 hψ.2 htan

/--
Finite canonical genre rays represented in a continuous positive-score support
graph collapse to one direction.  This is stronger than the source's claimed
two-genre conclusion, but its graph and positive-ray-representation premises
are explicit rather than inferred from C1--C3.
-/
theorem finiteGenre_card_le_one_of_continuous_graph_and_positive_ray_representation
    {ι : Type*} [Fintype ι] [Nonempty ι]
    {a b θstar : ℝ} {S : Set (ℝ × ℝ)} {g : ℝ → ℝ}
    (angle : ι → ℝ) (hinjective : Function.Injective angle)
    (ha : 0 < a) (hab : a ≤ b)
    (hcont : ContinuousOn g (Set.Icc a b))
    (hgraph_mem : ∀ x, x ∈ Set.Icc a b → (x, g x) ∈ S)
    (hgraph : ∀ z, z ∈ S → z.2 = g z.1)
    (hcover : S ⊆ ⋃ i, canonicalTwoUserGenreRay θstar (angle i))
    (hrepresented : ∀ i, ∃ z ∈ S,
      z ∈ canonicalTwoUserGenreRay θstar (angle i) ∧
        z.1 ∈ Set.Icc a b ∧ 0 < z.1)
    (hsin : Real.sin θstar ≠ 0)
    (hangle : ∀ i, angle i ∈ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2)) :
    Fintype.card ι ≤ 1 := by
  classical
  obtain ⟨i0, hsingle⟩ :=
    canonicalTwoUser_continuous_graph_mem_single_canonicalGenreRay_of_finite_cover
      angle ha hab hcont (fun x hx => hcover (hgraph_mem x hx))
  have hindex_eq : ∀ i, i = i0 := by
    intro i
    obtain ⟨z, hzS, hzray, hzfirst, hzpos⟩ := hrepresented i
    have hzgraph : z.2 = g z.1 := hgraph z hzS
    have hzray0 : z ∈ canonicalTwoUserGenreRay θstar (angle i0) := by
      have hpoint := hsingle z.1 hzfirst
      have hzeq : z = (z.1, g z.1) := by
        apply Prod.ext
        · rfl
        · exact hzgraph
      rw [hzeq]
      exact hpoint
    apply hinjective
    exact canonicalTwoUser_angle_eq_of_mem_canonicalGenreRay_of_fst_pos
      hsin (hangle i) (hangle i0) hzpos hzray hzray0
  have huniv : (Finset.univ : Finset ι) ⊆ {i0} := by
    intro i _
    exact Finset.mem_singleton.mpr (hindex_eq i)
  calc
    Fintype.card ι = (Finset.univ : Finset ι).card := rfl
    _ ≤ ({i0} : Finset ι).card := Finset.card_le_card huniv
    _ = 1 := by simp


/--
With positive first-user cosine, membership in the closed canonical genre ray
is equivalent to the source's nonnegative-radius parametrization.
-/
theorem mem_canonicalTwoUserGenreRay_iff_exists_nonneg_radius
    {θstar θ : ℝ} {z : ℝ × ℝ} (hcos : 0 < Real.cos θ) :
    z ∈ canonicalTwoUserGenreRay θstar θ ↔
      ∃ r : ℝ, 0 ≤ r ∧
        z = (r * Real.cos θ, r * Real.cos (θstar - θ)) := by
  constructor
  · rintro ⟨hz1, hz2⟩
    refine ⟨z.1 / Real.cos θ, div_nonneg hz1 hcos.le, ?_⟩
    apply Prod.ext
    · field_simp [hcos.ne']
    · rw [hz2]
      field_simp [hcos.ne']
  · rintro ⟨r, hr, rfl⟩
    constructor
    · exact mul_nonneg hr hcos.le
    · field_simp [hcos.ne']

/--
Source-shaped compact finite-genre overlap bridge.  A compact value support
covered by finitely many canonical genre rays has the closed score-component
cover required to propagate a common density label across every genre angle.
-/
theorem finiteGenre_label_eq_of_shared_density_of_compact_canonicalRay_cover
    {ι : Type*} [Fintype ι] [Nonempty ι] {a b θstar : ℝ}
    {S : Set (ℝ × ℝ)} (angle : ι → ℝ)
    (hcompact : IsCompact S)
    (hray_cover : S ⊆ ⋃ i, canonicalTwoUserGenreRay θstar (angle i))
    (hfst_image : Prod.fst '' S = Set.Icc a b)
    (hnonempty : ∀ i,
      ((Prod.fst '' (S ∩ canonicalTwoUserGenreRay θstar (angle i))) ∩
        Set.Icc a b).Nonempty)
    (density pref : ℝ → ℝ) (label : ι → ℝ)
    (hpref : ∀ w, w ∈ Set.Icc a b → pref w ≠ 0)
    (hdensity : ∀ i w,
      w ∈ (Prod.fst '' (S ∩ canonicalTwoUserGenreRay θstar (angle i))) ∩
        Set.Icc a b → density w = pref w * label i)
    (i j : ι) : label i = label j := by
  exact finiteGenre_label_eq_of_shared_density_of_compact_closed_piece_cover
    (piece := fun k => canonicalTwoUserGenreRay θstar (angle k))
    hcompact (fun k => isClosed_canonicalTwoUserGenreRay _ _)
    hray_cover hfst_image hnonempty density pref label hpref hdensity i j

/--
A finite source-genre cover by normalized angle directions puts every content
support action on one of the corresponding nonnegative-radius angle rays.
The zero action is included through the radius-zero point of an arbitrary
listed angle ray.
-/
theorem contentSupport_subset_angleRays_of_nonzeroSupportGenres_subset_range
    {ν : SourceNorm 2} {μ : MixedContentStrategy 2}
    {ι : Type*} [Nonempty ι] (angle : ι → ℝ)
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i)))) :
    μ.support ⊆ {p : Content 2 | ∃ i : ι, ∃ r : ℝ, 0 ≤ r ∧
      p = content2 (r * Real.cos (angle i)) (r * Real.sin (angle i))} := by
  intro p hp
  by_cases hp_nonzero : NonzeroContent p
  · have hnormalized_mem : SourceNorm.normalizedContent ν p ∈
        SourceNonzeroSupportGenres ν μ :=
      ⟨p, hp, hp_nonzero, rfl⟩
    rcases hgenres hnormalized_mem with ⟨i, hi⟩
    refine ⟨i, ν.norm p, ν.nonneg p, ?_⟩
    calc
      p = scaleContent (ν.norm p) (SourceNorm.normalizedContent ν p) :=
        (SourceNorm.scale_norm_normalizedContent_eq_self ν hp_nonzero).symm
      _ = scaleContent (ν.norm p)
          (content2 (Real.cos (angle i)) (Real.sin (angle i))) := by rw [← hi]
      _ = content2 (ν.norm p * Real.cos (angle i))
          (ν.norm p * Real.sin (angle i)) := by
        ext d
        fin_cases d <;> simp [scaleContent, content2]
  · have hp_zero : p = 0 := content_eq_zero_of_not_nonzeroContent hp_nonzero
    subst p
    refine ⟨Classical.choice inferInstance, 0, le_rfl, ?_⟩
    ext d
    fin_cases d <;> simp [content2]

/--
The canonical two-user value of a nonnegative-radius angle action lies on the
matching canonical genre ray.  This is the exact source coordinate conversion
used by the finite-genre argument.
-/
theorem canonicalTwoUserValueMap_content2_angleRadius
    (θstar θ r : ℝ) :
    canonicalTwoUserValueMap θstar
      (content2 (r * Real.cos θ) (r * Real.sin θ)) =
        (r * Real.cos θ, r * Real.cos (θstar - θ)) := by
  ext
  · simp [canonicalTwoUserValueMap, canonicalTwoUserFirst, score_content2]
  · simp [canonicalTwoUserValueMap, canonicalTwoUserSecond, score_content2]
    rw [Real.cos_sub]
    ring

/--
The finite source-genre cover transports from content support to the actual
canonical value-support cover by the corresponding closed genre rays.
-/
theorem canonicalTwoUser_valueSupport_subset_iUnion_canonicalGenreRay_of_contentSupport_angleRays
    {θstar : ℝ} {μ : MixedContentStrategy 2} {ι : Type*}
    [Nonempty ι] (angle : ι → ℝ)
    (hsin : Real.sin θstar ≠ 0)
    (hcos : ∀ i, 0 < Real.cos (angle i))
    (hsupport : μ.support ⊆ {p : Content 2 | ∃ i : ι, ∃ r : ℝ, 0 ≤ r ∧
      p = content2 (r * Real.cos (angle i)) (r * Real.sin (angle i))}) :
    (Measure.map (canonicalTwoUserValueMap θstar) μ).support ⊆
      ⋃ i, canonicalTwoUserGenreRay θstar (angle i) := by
  intro z hz
  have hp : canonicalTwoUserContentOfValues θstar z.1 z.2 ∈ μ.support :=
    canonicalTwoUserContentOfValues_mem_support_of_mem_valueMap_support hsin hz
  rcases hsupport hp with ⟨i, r, hr, hpangle⟩
  have hz_angle : z =
      (r * Real.cos (angle i), r * Real.cos (θstar - angle i)) := by
    calc
      z = canonicalTwoUserValueMap θstar
          (canonicalTwoUserContentOfValues θstar z.1 z.2) :=
        (canonicalTwoUserValueMap_contentOfValues hsin).symm
      _ = canonicalTwoUserValueMap θstar
          (content2 (r * Real.cos (angle i)) (r * Real.sin (angle i))) := by
        rw [hpangle]
      _ = (r * Real.cos (angle i), r * Real.cos (θstar - angle i)) :=
        canonicalTwoUserValueMap_content2_angleRadius θstar (angle i) r
  apply Set.mem_iUnion.mpr
  refine ⟨i, ?_⟩
  rw [hz_angle]
  exact (mem_canonicalTwoUserGenreRay_iff_exists_nonneg_radius (hcos i)).mpr
    ⟨r, hr, rfl⟩

/--
The source's corrected finite nonzero-support genre condition directly yields
the canonical value-support ray cover once every listed genre is represented
by its angle direction.
-/
theorem canonicalTwoUser_valueSupport_subset_iUnion_canonicalGenreRay_of_nonzeroSupportGenres_subset_range
    {ν : SourceNorm 2} {θstar : ℝ} {μ : MixedContentStrategy 2}
    {ι : Type*} [Nonempty ι] (angle : ι → ℝ)
    (hsin : Real.sin θstar ≠ 0)
    (hcos : ∀ i, 0 < Real.cos (angle i))
    (hgenres : SourceNonzeroSupportGenres ν μ ⊆
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i)))) :
    (Measure.map (canonicalTwoUserValueMap θstar) μ).support ⊆
      ⋃ i, canonicalTwoUserGenreRay θstar (angle i) := by
  apply canonicalTwoUser_valueSupport_subset_iUnion_canonicalGenreRay_of_contentSupport_angleRays
    angle hsin hcos
  exact contentSupport_subset_angleRays_of_nonzeroSupportGenres_subset_range
    angle hgenres

/--
A nonzero canonical support value whose source genre is one of finitely many
strictly interior angles is itself strictly interior to the canonical
nonnegative-content cone.  This transports the source's positive-angle genre
condition to the exact feasibility premise needed for the local FOC, without
adding a separate global support-interiority assumption.
-/
theorem canonicalTwoUser_valueSupport_strictInterior_of_nonzeroSupportGenres_eq_angleRange
    {ν : SourceNorm 2} {θstar : ℝ} {μ : MixedContentStrategy 2}
    {ι : Type*} [Nonempty ι] (angle : ι → ℝ)
    (hθstar_pos : 0 < θstar) (hθstar_le : θstar ≤ Real.pi / 2)
    (hangle_pos : ∀ i, 0 < angle i) (hangle_lt : ∀ i, angle i < θstar)
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i)))) :
    ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θstar) μ).support,
      z ≠ (0, 0) → 0 < z.1 ∧ z.1 * Real.cos θstar < z.2 := by
  have hθstar_lt_pi : θstar < Real.pi := by
    linarith [Real.pi_pos]
  have hsin : 0 < Real.sin θstar :=
    Real.sin_pos_of_pos_of_lt_pi hθstar_pos hθstar_lt_pi
  have hgenre_subset : SourceNonzeroSupportGenres ν μ ⊆
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))) := by
    rw [hgenres]
  have hsupport := contentSupport_subset_angleRays_of_nonzeroSupportGenres_subset_range
    (ν := ν) angle hgenre_subset
  intro z hz hzne
  have hp : canonicalTwoUserContentOfValues θstar z.1 z.2 ∈ μ.support :=
    canonicalTwoUserContentOfValues_mem_support_of_mem_valueMap_support hsin.ne' hz
  have hp_nonzero : NonzeroContent (canonicalTwoUserContentOfValues θstar z.1 z.2) := by
    by_contra hp_not_nonzero
    have hp_zero : canonicalTwoUserContentOfValues θstar z.1 z.2 = 0 :=
      content_eq_zero_of_not_nonzeroContent hp_not_nonzero
    apply hzne
    calc
      z = canonicalTwoUserValueMap θstar
          (canonicalTwoUserContentOfValues θstar z.1 z.2) :=
        (canonicalTwoUserValueMap_contentOfValues hsin.ne').symm
      _ = canonicalTwoUserValueMap θstar 0 := by rw [hp_zero]
      _ = (0, 0) := by
        ext <;> simp [canonicalTwoUserValueMap, canonicalTwoUserFirst,
          canonicalTwoUserSecond, score]
  rcases hsupport hp with ⟨i, r, hr_nonneg, hp_angle⟩
  have hr_ne_zero : r ≠ 0 := by
    intro hr_zero
    have hp_zero : canonicalTwoUserContentOfValues θstar z.1 z.2 = 0 := by
      rw [hp_angle, hr_zero]
      ext d
      fin_cases d <;> simp [content2]
    rcases hp_nonzero with ⟨d, hd⟩
    simpa [hp_zero] using hd
  have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne_zero)
  have hangle_lt_pi : angle i < Real.pi := by
    have hhalf_lt_pi : Real.pi / 2 < Real.pi := by
      nlinarith [Real.pi_pos]
    exact lt_of_lt_of_le (hangle_lt i) (lt_of_le_of_lt hθstar_le hhalf_lt_pi).le
  have hcos_angle : 0 < Real.cos (angle i) :=
    Real.cos_pos_of_mem_Ioo
      ⟨by linarith [Real.pi_pos, hangle_pos i],
        lt_of_lt_of_le (hangle_lt i) hθstar_le⟩
  have hsin_angle : 0 < Real.sin (angle i) :=
    Real.sin_pos_of_pos_of_lt_pi (hangle_pos i) hangle_lt_pi
  have hz_angle : z =
      (r * Real.cos (angle i), r * Real.cos (θstar - angle i)) := by
    calc
      z = canonicalTwoUserValueMap θstar
          (canonicalTwoUserContentOfValues θstar z.1 z.2) :=
        (canonicalTwoUserValueMap_contentOfValues hsin.ne').symm
      _ = canonicalTwoUserValueMap θstar
          (content2 (r * Real.cos (angle i)) (r * Real.sin (angle i))) := by
        rw [hp_angle]
      _ = (r * Real.cos (angle i), r * Real.cos (θstar - angle i)) :=
        canonicalTwoUserValueMap_content2_angleRadius θstar (angle i) r
  constructor
  · rw [hz_angle]
    exact mul_pos hr_pos hcos_angle
  · rw [hz_angle, Real.cos_sub]
    have hslack : 0 < r * (Real.sin θstar * Real.sin (angle i)) :=
      mul_pos hr_pos (mul_pos hsin hsin_angle)
    nlinarith

/--
Every listed source genre that is realized by a nonzero content support action
has a realized canonical value on its corresponding canonical genre ray.
-/
theorem canonicalTwoUser_exists_valueSupport_mem_canonicalGenreRay_of_mem_nonzeroSupportGenre
    {ν : SourceNorm 2} {θstar θ : ℝ} {μ : MixedContentStrategy 2}
    (hsin : Real.sin θstar ≠ 0) (hcos : 0 < Real.cos θ)
    (hgenre : content2 (Real.cos θ) (Real.sin θ) ∈
      SourceNonzeroSupportGenres ν μ) :
    ∃ z ∈ (Measure.map (canonicalTwoUserValueMap θstar) μ).support,
      z ∈ canonicalTwoUserGenreRay θstar θ := by
  rcases hgenre with ⟨p, hp, hp_nonzero, hnormalized⟩
  have hpangle : p = content2 (ν.norm p * Real.cos θ)
      (ν.norm p * Real.sin θ) := by
    calc
      p = scaleContent (ν.norm p) (SourceNorm.normalizedContent ν p) :=
        (SourceNorm.scale_norm_normalizedContent_eq_self ν hp_nonzero).symm
      _ = scaleContent (ν.norm p) (content2 (Real.cos θ) (Real.sin θ)) := by
        rw [← hnormalized]
      _ = content2 (ν.norm p * Real.cos θ) (ν.norm p * Real.sin θ) := by
        ext d
        fin_cases d <;> simp [scaleContent, content2]
  refine ⟨canonicalTwoUserValueMap θstar p,
    canonicalTwoUserValueMap_mem_support_of_mem_content_support hp, ?_⟩
  rw [hpangle, canonicalTwoUserValueMap_content2_angleRadius]
  exact (mem_canonicalTwoUserGenreRay_iff_exists_nonneg_radius hcos).mpr
    ⟨ν.norm p, ν.nonneg p, rfl⟩

/--
A realized nonzero source genre has a canonical support value on its ray with
strictly positive first score.  The strictness is what permits a single
positive score cutoff to retain every member of a finite genre family.
-/
theorem canonicalTwoUser_exists_valueSupport_mem_canonicalGenreRay_fst_pos_of_mem_nonzeroSupportGenre
    {ν : SourceNorm 2} {θstar θ : ℝ} {μ : MixedContentStrategy 2}
    (hsin : Real.sin θstar ≠ 0) (hcos : 0 < Real.cos θ)
    (hgenre : content2 (Real.cos θ) (Real.sin θ) ∈
      SourceNonzeroSupportGenres ν μ) :
    ∃ z ∈ (Measure.map (canonicalTwoUserValueMap θstar) μ).support,
      z ∈ canonicalTwoUserGenreRay θstar θ ∧ 0 < z.1 := by
  rcases hgenre with ⟨p, hp, hp_nonzero, hnormalized⟩
  have hpangle : p = content2 (ν.norm p * Real.cos θ)
      (ν.norm p * Real.sin θ) := by
    calc
      p = scaleContent (ν.norm p) (SourceNorm.normalizedContent ν p) :=
        (SourceNorm.scale_norm_normalizedContent_eq_self ν hp_nonzero).symm
      _ = scaleContent (ν.norm p) (content2 (Real.cos θ) (Real.sin θ)) := by
        rw [← hnormalized]
      _ = content2 (ν.norm p * Real.cos θ) (ν.norm p * Real.sin θ) := by
        ext d
        fin_cases d <;> simp [scaleContent, content2]
  refine ⟨canonicalTwoUserValueMap θstar p,
    canonicalTwoUserValueMap_mem_support_of_mem_content_support hp, ?_, ?_⟩
  · rw [hpangle, canonicalTwoUserValueMap_content2_angleRadius]
    exact (mem_canonicalTwoUserGenreRay_iff_exists_nonneg_radius hcos).mpr
      ⟨ν.norm p, ν.nonneg p, rfl⟩
  · rw [hpangle, canonicalTwoUserValueMap_content2_angleRadius]
    simpa using mul_pos (ν.pos_of_nonzero hp_nonzero) hcos

/--
A finite family of realized nonzero genres admits one common strictly positive
first-score cutoff at which every canonical ray still has a support point.
This is the finite choice argument needed to use the FOC prefactor away from
the shared zero endpoint.
-/
theorem canonicalTwoUser_exists_positive_cutoff_of_finite_nonzeroSupportGenres_eq_range
    {ν : SourceNorm 2} {θstar B : ℝ} {μ : MixedContentStrategy 2}
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hsin : Real.sin θstar ≠ 0) (hcos : ∀ i, 0 < Real.cos (angle i))
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))))
    (hfst_image : Prod.fst ''
      (Measure.map (canonicalTwoUserValueMap θstar) μ).support = Set.Icc 0 B) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ i,
      ((Prod.fst ''
        (((Measure.map (canonicalTwoUserValueMap θstar) μ).support ∩
          Prod.fst ⁻¹' Set.Icc ε B) ∩
          canonicalTwoUserGenreRay θstar (angle i))) ∩ Set.Icc ε B).Nonempty := by
  classical
  choose z hzS hzray hzpos using fun i =>
    canonicalTwoUser_exists_valueSupport_mem_canonicalGenreRay_fst_pos_of_mem_nonzeroSupportGenre
      (ν := ν) hsin (hcos i) (by rw [hgenres]; exact ⟨i, rfl⟩)
  obtain ⟨ε, hε, hεlt⟩ := Pi.exists_forall_pos_add_lt
    (x := fun _ : ι => (0 : ℝ)) (y := fun i => (z i).1) (by
      intro i
      simpa using hzpos i)
  refine ⟨ε, hε, ?_⟩
  intro i
  have hupper : (z i).1 ≤ B := by
    have hmem : (z i).1 ∈ Prod.fst ''
        (Measure.map (canonicalTwoUserValueMap θstar) μ).support :=
      ⟨z i, hzS i, rfl⟩
    rw [hfst_image] at hmem
    exact hmem.2
  have hscore : (z i).1 ∈ Set.Icc ε B := by
    constructor
    · simpa only [zero_add] using (hεlt i).le
    · exact hupper
  refine ⟨(z i).1, ⟨?_, hscore⟩⟩
  refine ⟨z i, ⟨?_, hzray i⟩, rfl⟩
  exact ⟨hzS i, hscore⟩

/--
For a compact canonical value support, projecting its support onto the first
coordinate is exactly the support of the first raw-score law.  This isolates
the support-pushforward bookkeeping needed to reuse the actual C1 interval
theorem in finite-genre arguments.
-/
theorem canonicalTwoUser_fst_image_valueSupport_eq_firstScoreSupport_of_isCompact
    {θ : ℝ} {μ : Measure (Content 2)}
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support) :
    Prod.fst '' (Measure.map (canonicalTwoUserValueMap θ) μ).support =
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support := by
  let ν : Measure (ℝ × ℝ) := Measure.map (canonicalTwoUserValueMap θ) μ
  have hraw_map :
      Measure.map Prod.fst ν =
        Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_fst (canonicalTwoUserValueMap_continuous θ).measurable]
    rfl
  have hraw_support :
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support =
        Prod.fst '' ν.support := by
    rw [← hraw_map]
    exact AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      hcompact continuous_fst
  simpa only [ν] using hraw_support.symm

/--
Source-genre realization supplies the positive ray representatives required by
the preceding connected-graph lemma.  Thus, under an explicitly supplied
continuous canonical value-support graph over the complete first-score
interval, a finite principal-angle genre family has at most one direction.
This is a strengthened conditional theorem; it does not attribute the graph
regularity, or this stronger conclusion, to the printed C1--C3 statement.
-/
theorem finiteGenre_card_le_one_of_continuous_valueSupport_graph_and_nonzeroSupportGenres_eq_range
    {ν : SourceNorm 2} {θstar B : ℝ} {μ : MixedContentStrategy 2}
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hinjective : Function.Injective angle)
    (hsin : Real.sin θstar ≠ 0) (hcos : ∀ i, 0 < Real.cos (angle i))
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))))
    (hB : 0 ≤ B)
    (hfirst_support :
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support =
        Set.Icc 0 B)
    {g : ℝ → ℝ}
    (hcont : ContinuousOn g (Set.Icc 0 B))
    (hgraph_mem : ∀ x, x ∈ Set.Icc 0 B →
      (x, g x) ∈ (Measure.map (canonicalTwoUserValueMap θstar) μ).support)
    (hgraph : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θstar) μ).support,
      z.2 = g z.1)
    (hangle : ∀ i, angle i ∈ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2)) :
    Fintype.card ι ≤ 1 := by
  have hfst_image : Prod.fst ''
      (Measure.map (canonicalTwoUserValueMap θstar) μ).support = Set.Icc 0 B := by
    have hraw_map :
        Measure.map Prod.fst (Measure.map (canonicalTwoUserValueMap θstar) μ) =
          Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ := by
      rw [Measure.map_map measurable_fst
        (canonicalTwoUserValueMap_continuous θstar).measurable]
      rfl
    apply Set.Subset.antisymm
    · rintro x ⟨z, hz, rfl⟩
      have hzfst : z.1 ∈
          (Measure.map Prod.fst
            (Measure.map (canonicalTwoUserValueMap θstar) μ)).support := by
        rw [Measure.support_eq_forall_isOpen]
        intro U hzU hUopen
        rw [Measure.map_apply measurable_fst hUopen.measurableSet]
        apply (Measure.mem_support_iff_forall z).mp hz
        exact continuous_fst.continuousAt (hUopen.mem_nhds hzU)
      rw [hraw_map, hfirst_support] at hzfst
      exact hzfst
    · intro x hx
      exact ⟨(x, g x), hgraph_mem x hx, rfl⟩
  obtain ⟨ε, hε, hrepresented⟩ :=
    canonicalTwoUser_exists_positive_cutoff_of_finite_nonzeroSupportGenres_eq_range
      (ν := ν) angle hsin hcos hgenres hfst_image
  have hεB : ε ≤ B := by
    let i : ι := Classical.choice inferInstance
    rcases hrepresented i with ⟨w, _hw, hwI⟩
    exact hwI.1.trans hwI.2
  have hcontε : ContinuousOn g (Set.Icc ε B) := hcont.mono (by
    intro x hx
    exact ⟨hε.le.trans hx.1, hx.2⟩)
  apply finiteGenre_card_le_one_of_continuous_graph_and_positive_ray_representation
    (S := (Measure.map (canonicalTwoUserValueMap θstar) μ).support)
    (g := g) angle hinjective hε hεB hcontε
  · intro x hx
    apply hgraph_mem x
    exact ⟨hε.le.trans hx.1, hx.2⟩
  · intro z hz
    exact hgraph z hz
  · exact canonicalTwoUser_valueSupport_subset_iUnion_canonicalGenreRay_of_nonzeroSupportGenres_subset_range
      (ν := ν) angle hsin hcos hgenres.le
  · intro i
    rcases hrepresented i with ⟨w, hw, hwI⟩
    rcases hw with ⟨z, ⟨⟨hzS, hzI⟩, hzray⟩, rfl⟩
    exact ⟨z, hzS, hzray, hzI, hε.trans_le hzI.1⟩
  · exact hsin
  · exact hangle

/--
Actual-Nash specialization of the finite-ray continuous-graph result.  The
pointwise boundary-safe C1 package yields both projection injections and the
compact ordered graph; finite realized principal-angle genres then have at
most one direction.  This stronger result is not the paper's literal
two-genre Step-1 assertion, whose weaker C1--C3 presentation does not supply
this everywhere-on-support graph package.
-/
theorem finiteGenre_card_le_one_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {ν : SourceNorm 2} {α β θ : ℝ}
    {μ : MixedContentStrategy 2} {ι : Type*} [Fintype ι] [Nonempty ι]
    (angle : ι → ℝ) (hinjective : Function.Injective angle)
    (hP : 1 < P) (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hderiv1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) z.1) z.1)
    (hderiv2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) x)
