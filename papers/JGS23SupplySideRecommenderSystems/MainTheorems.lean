    (hB_angle : B = Real.cos (theta - phi)) :
    infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta
      (r * B) (r * A) = 0 := by
  have hsum :
      infiniteGenreCandidateCrossReward a C1 C2 beta A B (r * A) +
          infiniteGenreCandidateCrossReward a C1 C2 beta A B (r * B) = r ^ beta :=
    infiniteGenreCandidateCrossReward_sum_eq_rpow_on_support_ray
      ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio hr hra
  have hfirst_cost :
      twoUserInducedCost 1 beta theta (r * A) (r * B) = r ^ beta := by
    rw [hA_angle, hB_angle]
    simpa using
      (twoUserInducedCost_param_eq_alpha_mul_rpow (α := 1) (β := beta)
        (θ := theta) (φ := phi) hr hsin)
  have hnumerator :
      twoUserInducedCostNumerator theta (r * B) (r * A) =
        twoUserInducedCostNumerator theta (r * A) (r * B) := by
    unfold twoUserInducedCostNumerator
    ring
  have hcost_symm :
      twoUserInducedCost 1 beta theta (r * B) (r * A) =
        twoUserInducedCost 1 beta theta (r * A) (r * B) := by
    unfold twoUserInducedCost
    rw [hnumerator]
  have hsecond_cost :
      twoUserInducedCost 1 beta theta (r * B) (r * A) = r ^ beta :=
    hcost_symm.trans hfirst_cost
  unfold infiniteGenreCandidateCrossObjective
  calc
    infiniteGenreCandidateCrossReward a C1 C2 beta A B (r * B) +
          infiniteGenreCandidateCrossReward a C1 C2 beta A B (r * A) -
          twoUserInducedCost 1 beta theta (r * B) (r * A) =
        infiniteGenreCandidateCrossReward a C1 C2 beta A B (r * A) +
          infiniteGenreCandidateCrossReward a C1 C2 beta A B (r * B) -
          twoUserInducedCost 1 beta theta (r * B) (r * A) := by ring
    _ = 0 := by rw [hsum, hsecond_cost]; ring

/--
