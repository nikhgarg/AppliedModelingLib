-/
theorem finiteGenre_exists_firstScoreInterval_and_label_eq_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {ν : SourceNorm 2}
    {μ : MixedContentStrategy 2} [IsProbabilityMeasure μ]
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hP : 1 < P) (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hderiv1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) z.1) z.1)
    (hderiv2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 =>
            score (canonicalTwoUserSecond θ) q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 =>
            score (canonicalTwoUserSecond θ) q) μ) x) z.2) z.2)
    (hangle_cos : ∀ i, 0 < Real.cos (angle i))
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i)))) :
    ∃ B : ℝ, 0 ≤ B ∧
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support =
        Set.Icc 0 B ∧
      ∃ ε : ℝ, 0 < ε ∧ ∀ (density pref : ℝ → ℝ) (label : ι → ℝ),
        (∀ w, w ∈ Set.Icc ε B → pref w ≠ 0) →
        (∀ i w,
          w ∈ (Prod.fst ''
            (((Measure.map (canonicalTwoUserValueMap θ) μ).support ∩
              Prod.fst ⁻¹' Set.Icc ε B) ∩
              canonicalTwoUserGenreRay θ (angle i))) ∩ Set.Icc ε B →
            density w = pref w * label i) →
        ∀ i j, label i = label j := by
  obtain ⟨B, hB, hfirst⟩ :=
    canonicalTwoUser_firstScoreSupport_eq_Icc_of_scaledNormRpowCostNash_awayOrigin
      hP hα hβ hsin hcos hnash hscore_ac hbase hcross hinterior hderiv1 hderiv2
  have hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support :=
    canonicalTwoUser_isCompact_valueSupport_of_scaledNormRpowCostNash hnash hα hβ
  have hfst_image : Prod.fst ''
      (Measure.map (canonicalTwoUserValueMap θ) μ).support = Set.Icc 0 B := by
    calc
      Prod.fst '' (Measure.map (canonicalTwoUserValueMap θ) μ).support =
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support :=
        canonicalTwoUser_fst_image_valueSupport_eq_firstScoreSupport_of_isCompact hcompact
      _ = Set.Icc 0 B := hfirst
  obtain ⟨ε, hε, hlabels⟩ :=
    finiteGenre_exists_positive_cutoff_and_label_eq_of_compact_nonzeroSupportGenres_eq_range
      (ν := ν) angle hsin.ne' hangle_cos hgenres hcompact hfst_image
  exact ⟨B, hB, hfirst, ε, hε, hlabels⟩

/--
The first angle factor displayed in the finite-genre FOC at
`arxiv-update.tex:1546-1550`.
-/
noncomputable def finiteGenreFirstAngleLabel (β θstar θ : ℝ) : ℝ :=
  Real.sin (θstar - θ) / (Real.cos θ) ^ (β - 1)

/--
The first induced-cost partial on a positive canonical genre ray is the
paper's common positive score-power prefactor times its first angle label.
This is the direct algebraic C1 bridge behind equation `conditions`.
-/
theorem twoUserInducedCostFirstPartial_param_eq_scoreRpow_mul_finiteGenreFirstAngleLabel
    {α β θstar θ r : ℝ}
    (hr : 0 < r) (hsin : 0 < Real.sin θstar)
    (hcos : 0 < Real.cos θ) :
    β * α * (Real.sin θstar) ^ (-β) *
        (twoUserInducedCostNumerator θstar
          (r * Real.cos θ) (r * Real.cos (θstar - θ))) ^ (β / 2 - 1) *
          (r * Real.cos θ -
            (r * Real.cos (θstar - θ)) * Real.cos θstar) =
      (β * α / Real.sin θstar) * (r * Real.cos θ) ^ (β - 1) *
        finiteGenreFirstAngleLabel β θstar θ := by
  have hnum := twoUserInducedCostNumerator_param θstar θ r
  have hlinear := twoUserParam_z1_sub_z2_cos θstar θ r
  have hrpow : (r ^ 2) ^ (β / 2 - 1) = r ^ (β - 2) := by
    rw [← Real.rpow_natCast r 2, ← Real.rpow_mul hr.le]
    congr 1
    ring
  have hsinpow : ((Real.sin θstar) ^ 2) ^ (β / 2 - 1) =
      (Real.sin θstar) ^ (β - 2) := by
    rw [← Real.rpow_natCast (Real.sin θstar) 2,
      ← Real.rpow_mul hsin.le]
    congr 1
    ring
  have hprod_pow : (r * Real.cos θ) ^ (β - 1) =
      r ^ (β - 1) * (Real.cos θ) ^ (β - 1) :=
    Real.mul_rpow hr.le hcos.le
  have hrmerge : r ^ (β - 2) * r = r ^ (β - 1) := by
    calc
      r ^ (β - 2) * r = r ^ ((β - 2) + 1) :=
        (Real.rpow_add_one hr.ne' (β - 2)).symm
      _ = r ^ (β - 1) := by congr 1 <;> ring
  have hsinmerge : (Real.sin θstar) ^ (-β) *
      (Real.sin θstar) ^ (β - 2) * Real.sin θstar =
        (Real.sin θstar)⁻¹ := by
    calc
      (Real.sin θstar) ^ (-β) *
          (Real.sin θstar) ^ (β - 2) * Real.sin θstar =
        (Real.sin θstar) ^ ((-β) + (β - 2)) * Real.sin θstar := by
          rw [Real.rpow_add hsin]
      _ = (Real.sin θstar) ^ ((-β) + (β - 2) + 1) :=
        (Real.rpow_add_one hsin.ne' ((-β) + (β - 2))).symm
      _ = (Real.sin θstar)⁻¹ := by
        convert Real.rpow_neg_one (Real.sin θstar) using 1 <;> ring
  have hcos_pow_ne : (Real.cos θ) ^ (β - 1) ≠ 0 :=
    ne_of_gt (Real.rpow_pos_of_pos hcos _)
  rw [hnum, Real.mul_rpow (sq_nonneg r) (sq_nonneg (Real.sin θstar)),
    hrpow, hsinpow, hlinear, hprod_pow]
  unfold finiteGenreFirstAngleLabel
  calc
    β * α * (Real.sin θstar) ^ (-β) *
          (r ^ (β - 2) * (Real.sin θstar) ^ (β - 2)) *
          (r * Real.sin θstar * Real.sin (θstar - θ)) =
        β * α * ((Real.sin θstar) ^ (-β) *
          (Real.sin θstar) ^ (β - 2) * Real.sin θstar) *
          (r ^ (β - 2) * r) * Real.sin (θstar - θ) := by ring
    _ = β * α * (Real.sin θstar)⁻¹ * r ^ (β - 1) *
          Real.sin (θstar - θ) := by rw [hsinmerge, hrmerge]
    _ = β * α / Real.sin θstar *
          (r ^ (β - 1) * (Real.cos θ) ^ (β - 1)) *
          (Real.sin (θstar - θ) / (Real.cos θ) ^ (β - 1)) := by
      field_simp [hsin.ne', hcos_pow_ne]

/--
C1 turns the first marginal derivative at a positive, strictly interior point
of a canonical genre ray into the common score-power prefactor times the
finite-genre first angle label.  The differentiability and interiority needed
for Fermat's theorem are explicit rather than inferred from absolute
continuity.
-/
theorem deriv_firstReward_eq_scoreRpow_mul_finiteGenreFirstAngleLabel_of_isMaxOn_of_mem_canonicalGenreRay
    {H1 H2 : ℝ → ℝ} {α β θstar θ : ℝ} {z : ℝ × ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θstar w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θstar) z)
    (hsin : 0 < Real.sin θstar)
    (hz1 : 0 < z.1) (hzslack : z.1 * Real.cos θstar < z.2)
    (hderiv : HasDerivAt H1 (deriv H1 z.1) z.1)
    (hbase : twoUserInducedCostNumerator θstar z.1 z.2 ≠ 0 ∨
      1 ≤ β / 2 - 1)
    (hcos : 0 < Real.cos θ)
    (hzray : z ∈ canonicalTwoUserGenreRay θstar θ) :
    deriv H1 z.1 =
      (β * α / Real.sin θstar) * z.1 ^ (β - 1) *
        finiteGenreFirstAngleLabel β θstar θ := by
  rcases (mem_canonicalTwoUserGenreRay_iff_exists_nonneg_radius hcos).mp hzray with
    ⟨r, hr_nonneg, hrz⟩
  have hr_pos : 0 < r := by
    have hprod : 0 < r * Real.cos θ := by
      simpa only [hrz] using hz1
    have hr_ne : r ≠ 0 := by
      intro hr_zero
      rw [hr_zero, zero_mul] at hprod
      exact (lt_irrefl 0 hprod).elim
    exact lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
  have hpartial := twoUserInducedCostFirstPartial_eq_of_isMaxOn_of_feasibleInterior
    hmax hsin hz1 hzslack hderiv hbase
  rw [hrz] at hpartial ⊢
  rw [twoUserInducedCostFirstPartial_param_eq_scoreRpow_mul_finiteGenreFirstAngleLabel
    hr_pos hsin hcos] at hpartial
  exact hpartial.symm

/--
For an actual scaled norm-power Nash law, the C1 first-order calculation
supplies the pointwise first-angle density identity on every positive-score
canonical genre ray.  Combined with the finite nonzero-genre cutoff bridge,
this gives the first displayed `conditions` equality without treating the
density formula as an additional black-box premise.  Pointwise
differentiability and strict interiority remain explicit source regularity
requirements.
-/
theorem finiteGenre_exists_positive_cutoff_and_firstAngleLabel_eq_of_compact_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {ν : SourceNorm 2}
    {μ : MixedContentStrategy 2} [IsProbabilityMeasure μ]
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ) {B : ℝ}
    (hα : 0 < α) (hβ : 0 < β) (hsin : 0 < Real.sin θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hderiv1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) z.1) z.1)
    (hangle_cos : ∀ i, 0 < Real.cos (angle i))
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))))
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support)
    (hfst_image : Prod.fst ''
      (Measure.map (canonicalTwoUserValueMap θ) μ).support = Set.Icc 0 B) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ i j,
      finiteGenreFirstAngleLabel β θ (angle i) =
        finiteGenreFirstAngleLabel β θ (angle j) := by
  obtain ⟨ε, hε, hlabels⟩ :=
    finiteGenre_exists_positive_cutoff_and_label_eq_of_compact_nonzeroSupportGenres_eq_range
      (ν := ν) angle hsin.ne' hangle_cos hgenres hcompact hfst_image
  refine ⟨ε, hε, ?_⟩
  intro i j
  apply hlabels
    (fun w => deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) w)
    (fun w => (β * α / Real.sin θ) * w ^ (β - 1))
    (fun i => finiteGenreFirstAngleLabel β θ (angle i))
  · intro w hw
    apply mul_ne_zero
    · exact div_ne_zero (mul_ne_zero hβ.ne' hα.ne') hsin.ne'
    · exact (Real.rpow_pos_of_pos (hε.trans_le hw.1) _).ne'
  · intro k w hw
    rcases hw.1 with ⟨z, hz, hzw⟩
    subst w
    have hzsupport : z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support :=
      hz.1.1
    have hzscore : z.1 ∈ Set.Icc ε B := hz.1.2
    have hz1 : 0 < z.1 := hε.trans_le hzscore.1
    have hzne : z ≠ (0, 0) := by
      intro hzero
      rw [hzero] at hz1
      exact (lt_irrefl 0 hz1).elim
    have hmax : IsMaxOn
        (fun u : ℝ × ℝ =>
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) u.1 +
            AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) u.2 -
              twoUserInducedCost α β θ u.1 u.2)
        (canonicalTwoUserFeasibleValueSet θ) z :=
      canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
        hsin hnash hscore_ac z hzsupport
    exact deriv_firstReward_eq_scoreRpow_mul_finiteGenreFirstAngleLabel_of_isMaxOn_of_mem_canonicalGenreRay
      hmax hsin hz1 (hinterior z hzsupport hzne).2 (hderiv1 z hzsupport hzne)
      (Or.inl (twoUserInducedCostNumerator_ne_zero_of_ne_zero hsin.ne' hzne))
      (hangle_cos k) hz.2

/--
Actual-Nash finite-genre endpoint for the first literal FOC label in
`finitegenre`.  The first raw-score interval and compact value support are
derived from the C1 Nash bridge, while the pointwise density identity is
derived from the first-order condition at each positive interior ray point.
The symmetric second-label equation and the source's global graph argument
are separate obligations.
-/
theorem finiteGenre_exists_firstScoreInterval_and_firstAngleLabel_eq_of_scaledNormRpowCostNash
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {ν : SourceNorm 2}
    {μ : MixedContentStrategy 2} [IsProbabilityMeasure μ]
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hP : 1 < P) (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
