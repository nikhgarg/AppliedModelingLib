    (hclosed : ∀ i, IsClosed (component i ∩ Set.Icc a b))
    (hcover : ⋃ i, component i ∩ Set.Icc a b = Set.Icc a b)
    (density pref : ℝ → ℝ)
    (hpref : ∀ w, w ∈ Set.Icc a b → pref w ≠ 0)
    (hdensity : ∀ i w, w ∈ component i ∩ Set.Icc a b →
      density w = pref w * finiteGenreSecondAngleLabel β θstar (angle i))
    (i j : ι) :
    finiteGenreSecondAngleLabel β θstar (angle i) =
      finiteGenreSecondAngleLabel β θstar (angle j) :=
  finiteGenre_label_eq_of_shared_density_closed_cover
    component hnonempty hclosed hcover density pref
