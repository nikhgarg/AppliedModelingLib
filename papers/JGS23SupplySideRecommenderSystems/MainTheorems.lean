        canonicalTwoUser_fst_image_valueSupport_eq_firstScoreSupport_of_isCompact hcompact
      _ = Set.Icc 0 B := hfirst
  obtain ⟨ε, hε, hlabels⟩ :=
    finiteGenre_exists_positive_cutoff_and_firstAngleLabel_eq_of_compact_scaledNormRpowCostNash
      (ν := ν) angle hα hβ hsin hnash hscore_ac hinterior hderiv1
      hangle_cos hgenres hcompact hfst_image
  exact ⟨B, hB, hfirst, ε, hε, hlabels⟩

/--
The second, user-swapped angle factor displayed in equation (conditions) of
the finite-genre proof.
-/
noncomputable def finiteGenreSecondAngleLabel (β θstar θ : ℝ) : ℝ :=
  Real.sin θ / (Real.cos (θstar - θ)) ^ (β - 1)

/--
The user-swapped induced-cost partial on a positive canonical genre ray is the
same common score-power prefactor times the second angle label displayed in
`finitegenre`.
-/
theorem twoUserInducedCostSecondPartial_param_eq_scoreRpow_mul_finiteGenreSecondAngleLabel
    {α β θstar θ r : ℝ}
    (hr : 0 < r) (hsin : 0 < Real.sin θstar)
    (hcos : 0 < Real.cos (θstar - θ)) :
    β * α * (Real.sin θstar) ^ (-β) *
        (twoUserInducedCostNumerator θstar
          (r * Real.cos θ) (r * Real.cos (θstar - θ))) ^ (β / 2 - 1) *
          (r * Real.cos (θstar - θ) -
            (r * Real.cos θ) * Real.cos θstar) =
      (β * α / Real.sin θstar) * (r * Real.cos (θstar - θ)) ^ (β - 1) *
        finiteGenreSecondAngleLabel β θstar θ := by
  have hnum := twoUserInducedCostNumerator_param θstar θ r
  have hlinear := twoUserParam_z2_sub_z1_cos θstar θ r
  have hrpow : (r ^ 2) ^ (β / 2 - 1) = r ^ (β - 2) := by
    rw [← Real.rpow_natCast r 2, ← Real.rpow_mul hr.le]
    congr 1
    ring
  have hsinpow : ((Real.sin θstar) ^ 2) ^ (β / 2 - 1) =
      (Real.sin θstar) ^ (β - 2) := by
    rw [← Real.rpow_natCast (Real.sin θstar) 2,
      ← Real.rpow_mul hsin.le]
    congr 1
    ring
  have hprod_pow : (r * Real.cos (θstar - θ)) ^ (β - 1) =
      r ^ (β - 1) * (Real.cos (θstar - θ)) ^ (β - 1) :=
    Real.mul_rpow hr.le hcos.le
  have hrmerge : r ^ (β - 2) * r = r ^ (β - 1) := by
    calc
      r ^ (β - 2) * r = r ^ ((β - 2) + 1) :=
        (Real.rpow_add_one hr.ne' (β - 2)).symm
      _ = r ^ (β - 1) := by congr 1 <;> ring
  have hsinmerge : (Real.sin θstar) ^ (-β) *
      (Real.sin θstar) ^ (β - 2) * Real.sin θstar =
        (Real.sin θstar)⁻¹ := by
    calc
      (Real.sin θstar) ^ (-β) *
          (Real.sin θstar) ^ (β - 2) * Real.sin θstar =
        (Real.sin θstar) ^ ((-β) + (β - 2)) * Real.sin θstar := by
          rw [Real.rpow_add hsin]
      _ = (Real.sin θstar) ^ ((-β) + (β - 2) + 1) :=
        (Real.rpow_add_one hsin.ne' ((-β) + (β - 2))).symm
      _ = (Real.sin θstar)⁻¹ := by
        convert Real.rpow_neg_one (Real.sin θstar) using 1 <;> ring
  have hcos_pow_ne : (Real.cos (θstar - θ)) ^ (β - 1) ≠ 0 :=
    ne_of_gt (Real.rpow_pos_of_pos hcos _)
  rw [hnum, Real.mul_rpow (sq_nonneg r) (sq_nonneg (Real.sin θstar)),
    hrpow, hsinpow, hlinear, hprod_pow]
  unfold finiteGenreSecondAngleLabel
  calc
    β * α * (Real.sin θstar) ^ (-β) *
          (r ^ (β - 2) * (Real.sin θstar) ^ (β - 2)) *
          (r * Real.sin θstar * Real.sin θ) =
        β * α * ((Real.sin θstar) ^ (-β) *
          (Real.sin θstar) ^ (β - 2) * Real.sin θstar) *
          (r ^ (β - 2) * r) * Real.sin θ := by ring
    _ = β * α * (Real.sin θstar)⁻¹ * r ^ (β - 1) * Real.sin θ := by
      rw [hsinmerge, hrmerge]
    _ = β * α / Real.sin θstar *
          (r ^ (β - 1) * (Real.cos (θstar - θ)) ^ (β - 1)) *
          (Real.sin θ / (Real.cos (θstar - θ)) ^ (β - 1)) := by
      field_simp [hsin.ne', hcos_pow_ne]

/--
C1 turns the second marginal derivative at a positive, strictly interior
canonical genre-ray point into the common score-power prefactor times the
user-swapped finite-genre angle label.  This is the local second-coordinate
counterpart of the first-label bridge; it does not itself provide a connected
second-score support interval for propagation across rays.
-/
theorem deriv_secondReward_eq_scoreRpow_mul_finiteGenreSecondAngleLabel_of_isMaxOn_of_mem_canonicalGenreRay
    {H1 H2 : ℝ → ℝ} {α β θstar θ : ℝ} {z : ℝ × ℝ}
    (hmax : IsMaxOn
      (fun w : ℝ × ℝ => H1 w.1 + H2 w.2 -
        twoUserInducedCost α β θstar w.1 w.2)
      (canonicalTwoUserFeasibleValueSet θstar) z)
    (hsin : 0 < Real.sin θstar)
    (hz1 : 0 < z.1) (hzslack : z.1 * Real.cos θstar < z.2)
    (hderiv : HasDerivAt H2 (deriv H2 z.2) z.2)
    (hbase : twoUserInducedCostNumerator θstar z.1 z.2 ≠ 0 ∨
      1 ≤ β / 2 - 1)
    (hcos_first : 0 < Real.cos θ)
    (hcos_second : 0 < Real.cos (θstar - θ))
    (hzray : z ∈ canonicalTwoUserGenreRay θstar θ) :
    deriv H2 z.2 =
      (β * α / Real.sin θstar) * z.2 ^ (β - 1) *
        finiteGenreSecondAngleLabel β θstar θ := by
  rcases (mem_canonicalTwoUserGenreRay_iff_exists_nonneg_radius hcos_first).mp hzray with
    ⟨r, hr_nonneg, hrz⟩
  have hr_pos : 0 < r := by
    have hprod : 0 < r * Real.cos θ := by
      simpa only [hrz] using hz1
    have hr_ne : r ≠ 0 := by
      intro hr_zero
      rw [hr_zero, zero_mul] at hprod
      exact (lt_irrefl 0 hprod).elim
    exact lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
  have hpartial := twoUserInducedCostSecondPartial_eq_of_isMaxOn_of_feasibleInterior
    hmax hsin hz1 hzslack hderiv hbase
  rw [hrz] at hpartial ⊢
  rw [twoUserInducedCostSecondPartial_param_eq_scoreRpow_mul_finiteGenreSecondAngleLabel
    hr_pos hsin hcos_second] at hpartial
  exact hpartial.symm

/--
The source's analogous second-score interval follows from the same
boundary-safe C1 Nash hypotheses as the first interval.  Rather than applying
an unproved symmetry of canonical coordinates, the proof obtains the compact
continuous value-support graph over the first interval and transports its
second projection.  The C1 lower-endpoint argument supplies the represented
origin, so the second interval also begins at zero.
-/
theorem canonicalTwoUser_secondScoreSupport_eq_Icc_of_scaledNormRpowCostNash_awayOrigin
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {μ : Measure (Content 2)}
    [IsProbabilityMeasure μ]
    (hP : 1 < P) (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hbase : ∀ z1 z2 : ℝ,
      twoUserInducedCostNumerator θ z1 z2 ≠ 0 ∨ 1 ≤ β / 2 - 1)
    (hcross : ∀ z1 z2 : ℝ,
      twoUserInducedCostCrossPartial α β θ z1 z2 < 0)
    (hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos θ < z.2)
    (hderiv1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) z.1) z.1)
    (hderiv2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) x) z.2) z.2) :
    ∃ B : ℝ, 0 ≤ B ∧
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).support =
        Set.Icc 0 B := by
  obtain ⟨B, hB, hfirst_support⟩ :=
    canonicalTwoUser_firstScoreSupport_eq_Icc_of_scaledNormRpowCostNash_awayOrigin
      hP hα hβ hsin hcos hnash hscore_ac hbase hcross hinterior hderiv1 hderiv2
  have hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support :=
    canonicalTwoUser_isCompact_valueSupport_of_scaledNormRpowCostNash hnash hα hβ
  have hfeasible : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z ∈ canonicalTwoUserFeasibleValueSet θ := by
    intro z hz
    change NonnegativeContent (canonicalTwoUserContentOfValues θ z.1 z.2)
    exact hnash.2.1
      (canonicalTwoUserContentOfValues_mem_support_of_mem_valueMap_support hsin.ne' hz)
  have hmax : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      IsMaxOn
        (fun w : ℝ × ℝ =>
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) w.1 +
            AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
              (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ) w.2 -
                twoUserInducedCost α β θ w.1 w.2)
        (canonicalTwoUserFeasibleValueSet θ) z := by
    intro z hz
    exact canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      hsin hnash hscore_ac z hz
  have hinjfst : (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.fst := by
    apply twoUser_support_injOn_fst_of_common_firstPartial_of_crossPartial_neg_awayOrigin
      hbase hcross
    · intro z hz hz1
      by_contra hne
      have hpos := (hinterior z hz hne).1
      rw [hz1] at hpos
      linarith
    · intro z hz hne
      exact twoUserInducedCostFirstPartial_eq_of_isMaxOn_of_feasibleInterior
        (hmax z hz) hsin (hinterior z hz hne).1 (hinterior z hz hne).2
        (hderiv1 z hz hne) (hbase z.1 z.2)
  have hinjsnd : (Measure.map (canonicalTwoUserValueMap θ) μ).support.InjOn Prod.snd := by
    apply twoUser_support_injOn_snd_of_common_secondPartial_of_crossPartial_neg_awayOrigin
      hbase hcross
    · intro z hz hz2
      by_contra hne
      have hinterior_z := hinterior z hz hne
      have hprod_nonneg : 0 ≤ z.1 * Real.cos θ :=
        mul_nonneg hinterior_z.1.le hcos
      rw [hz2] at hinterior_z
      linarith
    · intro z hz hne
      exact twoUserInducedCostSecondPartial_eq_of_isMaxOn_of_feasibleInterior
        (hmax z hz) hsin (hinterior z hz hne).1 (hinterior z hz hne).2
        (hderiv2 z hz hne) (hbase z.1 z.2)
  have hordered : ∀ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      ∀ q ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
        p.1 < q.1 → p.2 ≤ q.2 :=
    canonicalTwoUser_valueSupport_ordered_of_scaledNormRpowCostNash
      hsin hcos hnash hscore_ac hbase hcross
  have hstrict : ∀ p ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      ∀ q ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
        p.1 < q.1 → p.2 < q.2 :=
    AppliedModelingLib.strict_snd_order_of_ordered_snd_of_injOn_snd hordered hinjsnd
  have hvalue_zero : (0, 0) ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support :=
    canonicalTwoUser_zero_mem_valueSupport_of_compact_strict_ordered_iidC1
      hP hcompact hinjfst hstrict hmax hscore_ac hfeasible hα hβ hsin hcos
  obtain ⟨g, hg, hgraph_mem, hgraph⟩ :=
    canonicalTwoUser_exists_continuous_valueSupport_graph_of_compact_of_injOn_fst_of_firstScoreSupport_eq_Icc
      hB hcompact hinjfst hfirst_support
  let ν : Measure (ℝ × ℝ) := Measure.map (canonicalTwoUserValueMap θ) μ
  have hfst_image : Prod.fst '' ν.support = Set.Icc 0 B := by
    calc
      Prod.fst '' ν.support =
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support :=
        canonicalTwoUser_fst_image_valueSupport_eq_firstScoreSupport_of_isCompact hcompact
      _ = Set.Icc 0 B := hfirst_support
  have hsnd_map :
      Measure.map Prod.snd ν =
        Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_snd (canonicalTwoUserValueMap_continuous θ).measurable]
    rfl
  have hsnd_support :
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).support =
        Prod.snd '' ν.support := by
    rw [← hsnd_map]
    exact AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      hcompact continuous_snd
  have hsnd_image : Prod.snd '' ν.support = g '' Set.Icc 0 B := by
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩
      refine ⟨z.1, ?_, ?_⟩
      · rw [← hfst_image]
        exact ⟨z, by simpa only [ν] using hz, rfl⟩
      · exact (hgraph z (by simpa only [ν] using hz)).symm
    · rintro ⟨x, hx, rfl⟩
      exact ⟨(x, g x), by simpa only [ν] using hgraph_mem x hx, rfl⟩
  have hsecond_compact : IsCompact
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).support := by
    rw [hsnd_support]
    exact hcompact.image continuous_snd
  have hsecond_connected : Set.OrdConnected
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).support := by
    rw [hsnd_support, hsnd_image]
    exact (isPreconnected_Icc.image g hg.continuousOn).ordConnected
  have hsecond_zero : 0 ∈
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).support := by
    rw [hsnd_support]
    exact ⟨(0, 0), by simpa only [ν] using hvalue_zero, rfl⟩
  have hsecond_nonneg : ∀ x ∈
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).support, 0 ≤ x := by
    intro x hx
    rw [hsnd_support] at hx
    rcases hx with ⟨z, hz, rfl⟩
    have hzfeasible := hfeasible z (by simpa only [ν] using hz)
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hzfeasible
    exact (mul_nonneg hzfeasible.1 hcos).trans hzfeasible.2
  exact AppliedModelingLib.exists_eq_Icc_of_isCompact_of_ordConnected_of_zero_mem_of_nonneg
    hsecond_compact hsecond_connected hsecond_zero hsecond_nonneg

/--
A realized nonzero source genre has a canonical support value on its ray with
strictly positive second score whenever both canonical ray coordinates are
positive.  This is the second-coordinate counterpart of the finite-cutoff
witness used for the first score.
-/
theorem canonicalTwoUser_exists_valueSupport_mem_canonicalGenreRay_snd_pos_of_mem_nonzeroSupportGenre
    {ν : SourceNorm 2} {θstar θ : ℝ} {μ : MixedContentStrategy 2}
    (hsin : Real.sin θstar ≠ 0) (hcos_first : 0 < Real.cos θ)
    (hcos_second : 0 < Real.cos (θstar - θ))
    (hgenre : content2 (Real.cos θ) (Real.sin θ) ∈
      SourceNonzeroSupportGenres ν μ) :
    ∃ z ∈ (Measure.map (canonicalTwoUserValueMap θstar) μ).support,
      z ∈ canonicalTwoUserGenreRay θstar θ ∧ 0 < z.2 := by
  rcases hgenre with ⟨p, hp, hp_nonzero, hnormalized⟩
  have hpangle : p = content2 (ν.norm p * Real.cos θ)
      (ν.norm p * Real.sin θ) := by
    calc
      p = scaleContent (ν.norm p) (SourceNorm.normalizedContent ν p) :=
        (SourceNorm.scale_norm_normalizedContent_eq_self ν hp_nonzero).symm
      _ = scaleContent (ν.norm p) (content2 (Real.cos θ) (Real.sin θ)) := by
        rw [← hnormalized]
      _ = content2 (ν.norm p * Real.cos θ) (ν.norm p * Real.sin θ) := by
        ext d
        fin_cases d <;> simp [scaleContent, content2]
  refine ⟨canonicalTwoUserValueMap θstar p,
    canonicalTwoUserValueMap_mem_support_of_mem_content_support hp, ?_, ?_⟩
  · rw [hpangle, canonicalTwoUserValueMap_content2_angleRadius]
    exact (mem_canonicalTwoUserGenreRay_iff_exists_nonneg_radius hcos_first).mpr
      ⟨ν.norm p, ν.nonneg p, rfl⟩
  · rw [hpangle, canonicalTwoUserValueMap_content2_angleRadius]
    simpa using mul_pos (ν.pos_of_nonzero hp_nonzero) hcos_second

/--
A finite family of realized nonzero genres admits one common strictly positive
second-score cutoff.  It uses the second raw-score interval and positive
second ray cosines, not an implicit symmetry assertion.
-/
theorem canonicalTwoUser_exists_positive_second_cutoff_of_finite_nonzeroSupportGenres_eq_range
    {ν : SourceNorm 2} {θstar B : ℝ} {μ : MixedContentStrategy 2}
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hsin : Real.sin θstar ≠ 0)
    (hcos_first : ∀ i, 0 < Real.cos (angle i))
    (hcos_second : ∀ i, 0 < Real.cos (θstar - angle i))
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))))
    (hsnd_image : Prod.snd ''
      (Measure.map (canonicalTwoUserValueMap θstar) μ).support = Set.Icc 0 B) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ i,
      ((Prod.snd ''
        (((Measure.map (canonicalTwoUserValueMap θstar) μ).support ∩
          Prod.snd ⁻¹' Set.Icc ε B) ∩
          canonicalTwoUserGenreRay θstar (angle i))) ∩ Set.Icc ε B).Nonempty := by
  classical
  choose z hzS hzray hzpos using fun i =>
    canonicalTwoUser_exists_valueSupport_mem_canonicalGenreRay_snd_pos_of_mem_nonzeroSupportGenre
      (ν := ν) hsin (hcos_first i) (hcos_second i) (by
        rw [hgenres]
        exact ⟨i, rfl⟩)
  obtain ⟨ε, hε, hεlt⟩ := Pi.exists_forall_pos_add_lt
    (x := fun _ : ι => (0 : ℝ)) (y := fun i => (z i).2) (by
      intro i
      simpa using hzpos i)
  refine ⟨ε, hε, ?_⟩
  intro i
  have hupper : (z i).2 ≤ B := by
    have hmem : (z i).2 ∈ Prod.snd ''
        (Measure.map (canonicalTwoUserValueMap θstar) μ).support :=
      ⟨z i, hzS i, rfl⟩
    rw [hsnd_image] at hmem
    exact hmem.2
  have hscore : (z i).2 ∈ Set.Icc ε B := by
    constructor
    · simpa only [zero_add] using (hεlt i).le
    · exact hupper
  refine ⟨(z i).2, ⟨?_, hscore⟩⟩
  refine ⟨z i, ⟨?_, hzray i⟩, rfl⟩
  exact ⟨hzS i, hscore⟩

/--
Second-coordinate version of the compact finite closed-piece overlap bridge.
It is the same topological cancellation argument as for first scores, stated
separately so a source proof cannot silently interchange the two coordinates.
-/
theorem finiteGenre_label_eq_of_shared_density_of_compact_closed_piece_cover_snd
    {ι : Type*} [Fintype ι] [Nonempty ι] {a b : ℝ}
    {S : Set (ℝ × ℝ)} (piece : ι → Set (ℝ × ℝ))
    (hcompact : IsCompact S) (hpiece_closed : ∀ i, IsClosed (piece i))
    (hpiece_cover : S ⊆ ⋃ i, piece i)
    (hsnd_image : Prod.snd '' S = Set.Icc a b)
    (hnonempty : ∀ i,
      ((Prod.snd '' (S ∩ piece i)) ∩ Set.Icc a b).Nonempty)
    (density pref : ℝ → ℝ) (label : ι → ℝ)
    (hpref : ∀ w, w ∈ Set.Icc a b → pref w ≠ 0)
    (hdensity : ∀ i w, w ∈ (Prod.snd '' (S ∩ piece i)) ∩ Set.Icc a b →
      density w = pref w * label i)
    (i j : ι) : label i = label j := by
  apply finiteGenre_label_eq_of_shared_density_closed_cover
    (component := fun k => Prod.snd '' (S ∩ piece k)) hnonempty
  · intro k
    exact ((hcompact.inter_right (hpiece_closed k)).image continuous_snd).isClosed
      |>.inter isClosed_Icc
  · ext w
    constructor
    · rintro hw
      rcases Set.mem_iUnion.mp hw with ⟨k, hwk⟩
      exact hwk.2
    · intro hw
      have hw_image : w ∈ Prod.snd '' S := by
        rw [hsnd_image]
        exact hw
      rcases hw_image with ⟨z, hzS, hzw⟩
      rcases Set.mem_iUnion.mp (hpiece_cover hzS) with ⟨k, hzk⟩
      apply Set.mem_iUnion.mpr
      exact ⟨k, ⟨⟨z, ⟨hzS, hzk⟩, hzw⟩, hw⟩⟩
  · exact hpref
  · exact hdensity

/--
Positive-second-score overlap bridge for finite source genres.  The cutoff
keeps the user-swapped score-power prefactor nonzero while the ray cover and
compactness make the finite overlap graph connected.
-/
theorem finiteGenre_label_eq_of_shared_density_of_compact_nonzeroSupportGenres_eq_range_on_positive_second_cutoff
    {ν : SourceNorm 2} {θstar ε B : ℝ} {μ : MixedContentStrategy 2}
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hsin : Real.sin θstar ≠ 0) (hcos_first : ∀ i, 0 < Real.cos (angle i))
    (hε : 0 < ε)
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))))
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θstar) μ).support)
    (hsnd_image : Prod.snd ''
      (Measure.map (canonicalTwoUserValueMap θstar) μ).support = Set.Icc 0 B)
    (hnonempty : ∀ i,
      ((Prod.snd ''
        (((Measure.map (canonicalTwoUserValueMap θstar) μ).support ∩
          Prod.snd ⁻¹' Set.Icc ε B) ∩
          canonicalTwoUserGenreRay θstar (angle i))) ∩ Set.Icc ε B).Nonempty)
    (density pref : ℝ → ℝ) (label : ι → ℝ)
    (hpref : ∀ w, w ∈ Set.Icc ε B → pref w ≠ 0)
    (hdensity : ∀ i w,
      w ∈ (Prod.snd ''
        (((Measure.map (canonicalTwoUserValueMap θstar) μ).support ∩
          Prod.snd ⁻¹' Set.Icc ε B) ∩
          canonicalTwoUserGenreRay θstar (angle i))) ∩ Set.Icc ε B →
        density w = pref w * label i)
    (i j : ι) : label i = label j := by
  let Sε : Set (ℝ × ℝ) :=
    (Measure.map (canonicalTwoUserValueMap θstar) μ).support ∩
      Prod.snd ⁻¹' Set.Icc ε B
  have hcompactε : IsCompact Sε := by
    dsimp [Sε]
    exact hcompact.inter_right (isClosed_Icc.preimage continuous_snd)
  have hcoverε : Sε ⊆ ⋃ i, canonicalTwoUserGenreRay θstar (angle i) := by
    intro z hz
    exact canonicalTwoUser_valueSupport_subset_iUnion_canonicalGenreRay_of_nonzeroSupportGenres_subset_range
      (ν := ν) angle hsin hcos_first hgenres.le hz.1
  have hsndε : Prod.snd '' Sε = Set.Icc ε B := by
    ext w
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact hz.2
    · intro hw
      have hwS : w ∈ Prod.snd ''
          (Measure.map (canonicalTwoUserValueMap θstar) μ).support := by
        rw [hsnd_image]
        exact ⟨hε.le.trans hw.1, hw.2⟩
      rcases hwS with ⟨z, hzS, hzw⟩
      refine ⟨z, ⟨hzS, ?_⟩, hzw⟩
      simpa [hzw] using hw
  have hcomponent : ∀ i,
      ((Prod.snd '' (Sε ∩ canonicalTwoUserGenreRay θstar (angle i))) ∩
        Set.Icc ε B).Nonempty := by
    intro i
    simpa only [Sε, Set.inter_assoc] using hnonempty i
  apply finiteGenre_label_eq_of_shared_density_of_compact_closed_piece_cover_snd
    (piece := fun k => canonicalTwoUserGenreRay θstar (angle k))
    hcompactε (fun k => isClosed_canonicalTwoUserGenreRay _ _) hcoverε hsndε hcomponent
    density pref label hpref
  intro i w hw
  exact hdensity i w (by simpa only [Sε, Set.inter_assoc] using hw)

/--
Finite realized nonzero genres supply the uniform positive second-score cutoff
needed for the user-swapped FOC cancellation argument.
-/
theorem finiteGenre_exists_positive_second_cutoff_and_label_eq_of_compact_nonzeroSupportGenres_eq_range
    {ν : SourceNorm 2} {θstar B : ℝ} {μ : MixedContentStrategy 2}
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hsin : Real.sin θstar ≠ 0)
    (hcos_first : ∀ i, 0 < Real.cos (angle i))
    (hcos_second : ∀ i, 0 < Real.cos (θstar - angle i))
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))))
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θstar) μ).support)
    (hsnd_image : Prod.snd ''
      (Measure.map (canonicalTwoUserValueMap θstar) μ).support = Set.Icc 0 B) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ (density pref : ℝ → ℝ) (label : ι → ℝ),
      (∀ w, w ∈ Set.Icc ε B → pref w ≠ 0) →
      (∀ i w,
        w ∈ (Prod.snd ''
          (((Measure.map (canonicalTwoUserValueMap θstar) μ).support ∩
            Prod.snd ⁻¹' Set.Icc ε B) ∩
            canonicalTwoUserGenreRay θstar (angle i))) ∩ Set.Icc ε B →
          density w = pref w * label i) →
      ∀ i j, label i = label j := by
  obtain ⟨ε, hε, hnonempty⟩ :=
    canonicalTwoUser_exists_positive_second_cutoff_of_finite_nonzeroSupportGenres_eq_range
      (ν := ν) angle hsin hcos_first hcos_second hgenres hsnd_image
  refine ⟨ε, hε, ?_⟩
  intro density pref label hpref hdensity i j
  exact
    finiteGenre_label_eq_of_shared_density_of_compact_nonzeroSupportGenres_eq_range_on_positive_second_cutoff
      (ν := ν) angle hsin hcos_first hε hgenres hcompact hsnd_image hnonempty
      density pref label hpref hdensity i j

/--
For compact canonical value support, the second projection is exactly the
support of the second raw-score law.  This is the projection bookkeeping
needed to apply the user-swapped finite-genre interval theorem.
-/
theorem canonicalTwoUser_snd_image_valueSupport_eq_secondScoreSupport_of_isCompact
    {θ : ℝ} {μ : Measure (Content 2)}
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support) :
    Prod.snd '' (Measure.map (canonicalTwoUserValueMap θ) μ).support =
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).support := by
  let ν : Measure (ℝ × ℝ) := Measure.map (canonicalTwoUserValueMap θ) μ
  have hraw_map :
      Measure.map Prod.snd ν =
        Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ := by
    dsimp [ν]
    rw [Measure.map_map measurable_snd (canonicalTwoUserValueMap_continuous θ).measurable]
    rfl
  have hraw_support :
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ).support =
        Prod.snd '' ν.support := by
    rw [← hraw_map]
    exact AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
      hcompact continuous_snd
  simpa only [ν] using hraw_support.symm

theorem canonicalTwoUser_not_isMaxOn_of_firstScore_gap_and_cost_deriv_pos
    {P : ℕ} {μ1 μ2 : Measure ℝ} [IsProbabilityMeasure μ1] [NoAtoms μ1]
    {α β θ a b d cost' : ℝ}
    (hmax : IsMaxOn
      (fun z : ℝ × ℝ =>
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 z.1 +
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 z.2 -
            twoUserInducedCost α β θ z.1 z.2)
      (canonicalTwoUserFeasibleValueSet θ) (b, d))
    (hbd : (b, d) ∈ canonicalTwoUserFeasibleValueSet θ)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (ha : 0 ≤ a) (hab : a < b)
    (hgap : Set.Ioo a b ⊆ μ1.supportᶜ)
    (hcost : HasDerivAt (fun x => twoUserInducedCost α β θ x d) cost' b)
    (hcost_pos : 0 < cost') : False := by
  obtain ⟨x, hx, hcost_lt⟩ :=
    AppliedModelingLib.RealAnalysis.exists_left_value_lt_of_hasDerivAt_pos
      hcost hcost_pos hab
  have hreward :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 x =
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 b := by
    apply AppliedModelingLib.Probability.iidMaximumCdf_eq_of_Ioo_subset_compl_support_of_noAtoms
      μ1 hx.2.le
    intro y hy
    exact hgap ⟨hx.1.trans hy.1, hy.2⟩
  have hfeasible : (x, d) ∈ canonicalTwoUserFeasibleValueSet θ := by
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin] at hbd ⊢
    constructor
    · linarith [ha, hx.1]
    · have hxb : x ≤ b := hx.2.le
      have hmul : x * Real.cos θ ≤ b * Real.cos θ :=
        mul_le_mul_of_nonneg_right hxb hcos
      exact hmul.trans hbd.2
  have hle :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 x +
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 d -
            twoUserInducedCost α β θ x d ≤
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 b +
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 d -
            twoUserInducedCost α β θ b d :=
    hmax hfeasible
  rw [hreward] at hle
  linarith

theorem canonicalTwoUser_firstScoreSupport_ordConnected_of_finiteGenres
    {P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ} {ν : SourceNorm 2}
    {μ : MixedContentStrategy 2} [IsProbabilityMeasure μ]
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hα : 0 < α) (hβ : 0 < β)
    (hsin : 0 < Real.sin θ) (hcosstar : 0 ≤ Real.cos θ)
    (hθltpi : θ < Real.pi)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun p => α * normRpowCost (SourceNorm.l2 2) β p) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) μ ≪
        volume)
    (hangle_pos : ∀ i, 0 < angle i)
    (hangle_lt : ∀ i, angle i < θ)
    (hangle_cos_first : ∀ i, 0 < Real.cos (angle i))
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i)))) :
    Set.OrdConnected
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ).support := by
  let μ1 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ
  let μ2 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) μ
  letI : IsProbabilityMeasure μ1 :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  have hac1 : μ1 ≪ volume := by
    simpa [μ1] using hscore_ac (0 : Fin 2)
  letI : NoAtoms μ1 := ⟨fun x => hac1 (by simpa using (volume_singleton x))⟩
  have hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θ) μ).support :=
    canonicalTwoUser_isCompact_valueSupport_of_scaledNormRpowCostNash hnash hα hβ
  have hray_cover : (Measure.map (canonicalTwoUserValueMap θ) μ).support ⊆
      ⋃ i, canonicalTwoUserGenreRay θ (angle i) := by
    apply canonicalTwoUser_valueSupport_subset_iUnion_canonicalGenreRay_of_nonzeroSupportGenres_subset_range
      (ν := ν) angle hsin.ne' hangle_cos_first
    intro g hg
    rw [hgenres] at hg
    exact hg
  by_contra hnot
  obtain ⟨a, b, d, hab, hgap, hleft, hbd⟩ :=
    canonicalTwoUser_exists_firstScore_gap_data_of_compact_not_ordConnected_valueSupport
      hcompact hnot
  have ha_nonneg : 0 ≤ a := by
    rcases hleft with ⟨p, hp, hpa⟩
    rcases Set.mem_iUnion.mp (hray_cover hp) with ⟨j, hpj⟩
    exact hpj.1.trans hpa
  have hb_pos : 0 < b := lt_of_le_of_lt ha_nonneg hab
  rcases Set.mem_iUnion.mp (hray_cover hbd) with ⟨i, hbi⟩
  rcases (mem_canonicalTwoUserGenreRay_iff_exists_nonneg_radius
      (hangle_cos_first i)).mp hbi with ⟨r, hr, hrz⟩
  have hb_eq : b = r * Real.cos (angle i) := by
    simpa using congrArg Prod.fst hrz
  have hd_eq : d = r * Real.cos (θ - angle i) := by
    simpa using congrArg Prod.snd hrz
  have hr_pos : 0 < r := by
    have hr_ne : r ≠ 0 := by
      intro hrzero
      rw [hrzero, zero_mul] at hb_eq
      linarith
    exact lt_of_le_of_ne hr (Ne.symm hr_ne)
  have hcost : HasDerivAt
      (fun x => twoUserInducedCost α β θ x d)
      ((β * α / Real.sin θ) * b ^ (β - 1) *
        finiteGenreFirstAngleLabel β θ (angle i)) b := by
    have hraw := hasDerivAt_twoUserInducedCost_z1
      (α := α) (β := β) (θ := θ) (z1 := b) (z2 := d)
      (Or.inl (twoUserInducedCostNumerator_ne_zero_of_pair_ne_zero
        hsin.ne' (Or.inl hb_pos.ne')))
    convert hraw using 1
    rw [hb_eq, hd_eq]
    exact (twoUserInducedCostFirstPartial_param_eq_scoreRpow_mul_finiteGenreFirstAngleLabel
      hr_pos hsin (hangle_cos_first i)).symm
  have hlabel_pos : 0 < finiteGenreFirstAngleLabel β θ (angle i) := by
    unfold finiteGenreFirstAngleLabel
    exact div_pos
      (Real.sin_pos_of_pos_of_lt_pi (by linarith [hangle_lt i])
        (by linarith [hangle_pos i, hθltpi]))
      (Real.rpow_pos_of_pos (hangle_cos_first i) _)
  have hcost_pos : 0 <
      (β * α / Real.sin θ) * b ^ (β - 1) *
        finiteGenreFirstAngleLabel β θ (angle i) :=
    mul_pos (mul_pos (div_pos (mul_pos hβ hα) hsin)
      (Real.rpow_pos_of_pos hb_pos _)) hlabel_pos
  have hbd_feasible : (b, d) ∈ canonicalTwoUserFeasibleValueSet θ := by
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
    constructor
    · exact hb_pos.le
    · rw [hb_eq, hd_eq]
      have hlinear := twoUserParam_z2_sub_z1_cos θ (angle i) r
      have hsin_angle : 0 < Real.sin (angle i) :=
        Real.sin_pos_of_pos_of_lt_pi (hangle_pos i)
          ((hangle_lt i).trans hθltpi)
      have hrhs : 0 < r * Real.sin θ * Real.sin (angle i) :=
        mul_pos (mul_pos hr_pos hsin) hsin_angle
      linarith
  have hmax :=
    canonicalTwoUser_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      hsin hnash hscore_ac (b, d) hbd
  exact canonicalTwoUser_not_isMaxOn_of_firstScore_gap_and_cost_deriv_pos
    (μ1 := μ1) (μ2 := μ2) (α := α) (β := β) (θ := θ)
    (a := a) (b := b) (d := d)
    (by simpa [μ1, μ2] using hmax) hbd_feasible hsin hcosstar ha_nonneg hab
    (by simpa [μ1] using hgap) hcost hcost_pos

theorem canonicalTwoUser_not_isMaxOn_of_secondScore_gap_and_cost_deriv_pos
    {P : ℕ} {μ1 μ2 : Measure ℝ} [IsProbabilityMeasure μ2] [NoAtoms μ2]
    {α β θ a b c cost' : ℝ}
    (hmax : IsMaxOn
      (fun z : ℝ × ℝ =>
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ1 z.1 +
          AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 z.2 -
            twoUserInducedCost α β θ z.1 z.2)
      (canonicalTwoUserFeasibleValueSet θ) (c, b))
    (hsin : 0 < Real.sin θ)
    (hc : 0 ≤ c) (hab : a < b) (hslack : c * Real.cos θ < b)
    (hgap : Set.Ioo a b ⊆ μ2.supportᶜ)
    (hcost : HasDerivAt (fun y => twoUserInducedCost α β θ c y) cost' b)
    (hcost_pos : 0 < cost') : False := by
  have hlower_lt : max a (c * Real.cos θ) < b := max_lt hab hslack
  obtain ⟨y, hy, hcost_lt⟩ :=
    AppliedModelingLib.RealAnalysis.exists_left_value_lt_of_hasDerivAt_pos
      hcost hcost_pos hlower_lt
  have hreward :
      AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 y =
        AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1) μ2 b := by
    apply AppliedModelingLib.Probability.iidMaximumCdf_eq_of_Ioo_subset_compl_support_of_noAtoms
      μ2 hy.2.le
    intro x hx
    exact hgap ⟨(le_max_left _ _).trans_lt (hy.1.trans hx.1), hx.2⟩
  have hfeasible : (c, y) ∈ canonicalTwoUserFeasibleValueSet θ := by
    rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
