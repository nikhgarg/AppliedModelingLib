  · exact canonicalTwoUser_valueSupport_strictInterior_of_scaledNormRpowCostNash_of_phase_of_cos_pos
      hP hα hβ hsin hcos hden hβlt hnash hscore_ac hcdf1 hcdf2
  · exact hcdf1
  · exact hcdf2

