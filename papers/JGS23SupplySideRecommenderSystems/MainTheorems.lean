      deriv (fun x : ℝ => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ) x) z.1 := by
  let μ1 : Measure ℝ :=
    Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) μ
