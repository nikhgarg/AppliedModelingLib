  rintro ⟨μ, genre, hnash, hgenres⟩
  obtain ⟨hβ_pos, _⟩ :=
    generalThreshold_scalar_strict_gap_of_lt_log_bound hZ_one_lt hZ_lt_card hβ_bound
  have hcost_cont : PerturbationCostContinuous (normRpowCost ν β) :=
    perturbationCostContinuous_normRpowCost ν hβ_pos.le hperturb
  obtain ⟨p0, hp0, hp0_nonzero⟩ :=
    sourceSymmetricMixedNash_exists_nonzero_support_of_nonzero_users
      hnash husers_nonnegative husers_nonzero hcost_cont
  have hgenre_norm : ν.norm genre = 1 :=
    sourceNorm_genre_eq_one_of_singleton_nonzeroSupportGenres_of_exists
      hgenres.le ⟨p0, hp0, hp0_nonzero⟩
  have hgenre_nonnegative : NonnegativeContent genre :=
    genre_nonnegative_of_singleton_nonzeroSupportGenres_of_exists
      hgenres.le ⟨p0, hp0, hp0_nonzero⟩ hnash.2.1
  have hscore : ∀ i : Fin N, 0 < score (users i) genre :=
    sourceSymmetricMixedNash_genre_score_pos_of_singleton_nonzeroSupportGenres_of_nonzero_users
      hnash hgenres.le husers_nonnegative husers_nonzero hcost_cont
  have heq : μ = singleGenreContentLaw N P β genre :=
    sourceSymmetricMixedNash_eq_singleGenreContentLaw_of_compactSublevels_of_singleton_nonzeroSupportGenres_of_nonzero_users
      (j := Classical.choice (inferInstance : Nonempty (Fin P))) hnash hgenres.le
      husers_nonnegative husers_nonzero hperturb hβ_pos hcompact_sublevels hcontinuous
  rw [heq] at hnash
  exact
    not_singleGenreContentLaw_sourceSymmetricMixedNash_of_lt_general_threshold
      ν husers_nonnegative haggregate_bound hdual_witness hZ_one_lt hZ_lt_card hβ_bound
      hgenre_norm hgenre_nonnegative hscore hnash

/--
Corrected arbitrary-equilibrium exclusion at the normalized `Z = 1` boundary
of Corollary `beta`.  As above, compact single-genre identification upgrades
the strict product-gap exclusion from the explicit ray law to arbitrary
corrected singleton-genre source equilibria.
-/
theorem not_exists_sourceSymmetricMixedNash_singleton_nonzeroSupportGenre_of_Z_eq_one
    {D N P : ℕ} [Nontrivial (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {β : ℝ} {users : Fin N → Content D}
    (ν : SourceNorm D)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (husers_nonzero : ∀ i, NonzeroContent (users i))
