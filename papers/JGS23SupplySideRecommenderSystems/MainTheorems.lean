      (fun z : ℝ × ℝ =>
        infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta z.1 z.2)
      (Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ))
      (r * B, r * A) := by
  have hrange : r ∈ Set.Icc 0 a :=
    infiniteGenreCandidateMeasure_support_subset_cutoff
      a C1 C2 beta ha hC2 hC2_one hbeta hC1 hr
  have hzero :
      infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta
        (r * B) (r * A) = 0 :=
    infiniteGenreCandidateCrossObjective_eq_zero_on_swapped_support_ray
      ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio
      hrange.1 hrange.2 hsin hA_angle hB_angle
  refine ⟨?_, ?_⟩
  · exact ⟨mul_nonneg hrange.1 hB.le, mul_nonneg hrange.1 hA.le⟩
  · rintro ⟨z1, z2⟩ hz
    change infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta z1 z2 ≤
      infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta (r * B) (r * A)
    rw [hzero]
    exact infiniteGenreCandidateCrossObjective_nonpos_of_nonnegative_scores
      ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio hsin hz.1 hz.2 hglobal

/--
Every support point on the first candidate ray is C1-optimal when the selected
angle maximizes the power sum on its corrected compact half-domain.  The
positive-score-wedge extension supplies the full deviation comparison.
-/
theorem infiniteGenreCandidateCrossObjective_isMaxOn_nonnegative_scores_of_mem_support_of_leftHalf_angle_max
    {a C1 C2 beta A B theta phi r : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
    (hC1 : C1 = a ^ beta) (hbalance : C1 = 1 + C2 ^ beta)
    (hA : 0 < A) (hB : 0 < B) (hratio : C2 = B / A)
    (hsin : 0 < Real.sin theta) (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) (hbeta_one : 1 ≤ beta)
    (hA_angle : A = Real.cos phi)
    (hB_angle : B = Real.cos (theta - phi))
    (hmax : IsMaxOn (twoUserCosPowerSum beta theta)
      (Set.Icc 0 (theta / 2)) phi)
    (hr : r ∈ (infiniteGenreCandidateMeasure
      a C1 C2 beta ha hC2 hC2_one hbeta hC1).support) :
    (r * A, r * B) ∈ Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ) ∧
      IsMaxOn
      (fun z : ℝ × ℝ =>
        infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta z.1 z.2)
      (Set.Ici (0 : ℝ) ×ˢ Set.Ici (0 : ℝ))
      (r * A, r * B) := by
  have hrange : r ∈ Set.Icc 0 a :=
    infiniteGenreCandidateMeasure_support_subset_cutoff
      a C1 C2 beta ha hC2 hC2_one hbeta hC1 hr
  have hzero :
      infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta
        (r * A) (r * B) = 0 :=
    infiniteGenreCandidateCrossObjective_eq_zero_on_support_ray
      ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio
      hrange.1 hrange.2 hsin hA_angle hB_angle
  refine ⟨?_, ?_⟩
  · exact ⟨mul_nonneg hrange.1 hA.le, mul_nonneg hrange.1 hB.le⟩
  · rintro ⟨z1, z2⟩ hz
    change infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta z1 z2 ≤
      infiniteGenreCandidateCrossObjective a C1 C2 beta A B theta (r * A) (r * B)
    rw [hzero]
    exact infiniteGenreCandidateCrossObjective_nonpos_of_nonnegative_scores_of_leftHalf_angle_max
      ha hC2 hC2_one hbeta hC1 hbalance hA hB hratio hsin htheta_pos
      htheta_le_half_pi hbeta_one hA_angle hB_angle hmax hz.1 hz.2

/--
The swapped candidate ray has the same C1 guarantee under the compact
left-half angular maximization condition.
-/
theorem infiniteGenreCandidateCrossObjective_isMaxOn_nonnegative_scores_of_mem_support_swapped_of_leftHalf_angle_max
    {a C1 C2 beta A B theta phi r : ℝ}
    (ha : 0 < a) (hC2 : 0 < C2) (hC2_one : C2 < 1) (hbeta : 0 < beta)
