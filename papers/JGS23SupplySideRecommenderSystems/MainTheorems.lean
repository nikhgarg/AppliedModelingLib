        profile ∈ E →
          (1 : ℝ) ≤ usersWon users (deviateProfile profile j p) j :=
    Filter.Eventually.of_forall fun profile hprofile =>
      usersWon_ge_one_on_bounded_direction_group_deviation
        hprofile hgroup hQ_nonneg hdev_score
  have hcost' :
      cost p <
        (1 : ℝ) *
          (MeasureTheory.Measure.pi (fun _ : Fin P => μ)).real E := by
    simpa [E] using hcost
  exact equilibriumPayoff_pos_of_event_win_lower_bound_and_cost_lt
    (users := users) (cost := cost) (μ := μ) (p := p) (j := j)
    (E := E) (c := 1) hno hE hint hevent (by norm_num) hcost'

