theorem finiteGenre_label_eq_of_shared_density_of_compact_nonzeroSupportGenres_eq_range
    {ν : SourceNorm 2} {θstar a b : ℝ} {μ : MixedContentStrategy 2}
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hsin : Real.sin θstar ≠ 0) (hcos : ∀ i, 0 < Real.cos (angle i))
