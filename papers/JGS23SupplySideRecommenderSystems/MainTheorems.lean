  obtain ⟨B, hB, hfirst, -, -, -⟩ :=
    finiteGenre_exists_firstScoreInterval_and_label_eq_of_scaledNormRpowCostNash
      (ν := ν) angle hP hα hβ hsin hcos hnash hscore_ac hbase hcross hinterior
