/--
Positive-score version of the finite-genre overlap bridge.  The literal C1
prefactor in the paper is generally zero at score zero, so cancellation cannot
be justified solely by the common origin of the genre rays.  Restricting the
compact value support to a positive score interval gives the correct setting
for the nonzero-prefactor argument.
-/
theorem finiteGenre_label_eq_of_shared_density_of_compact_nonzeroSupportGenres_eq_range_on_positive_cutoff
    {ν : SourceNorm 2} {θstar ε B : ℝ} {μ : MixedContentStrategy 2}
    {ι : Type*} [Fintype ι] [Nonempty ι] (angle : ι → ℝ)
    (hsin : Real.sin θstar ≠ 0) (hcos : ∀ i, 0 < Real.cos (angle i))
    (hε : 0 < ε)
    (hgenres : SourceNonzeroSupportGenres ν μ =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))))
    (hcompact : IsCompact (Measure.map (canonicalTwoUserValueMap θstar) μ).support)
    (hfst_image : Prod.fst ''
      (Measure.map (canonicalTwoUserValueMap θstar) μ).support = Set.Icc 0 B)
    (hnonempty : ∀ i,
      ((Prod.fst ''
        (((Measure.map (canonicalTwoUserValueMap θstar) μ).support ∩
          Prod.fst ⁻¹' Set.Icc ε B) ∩
          canonicalTwoUserGenreRay θstar (angle i))) ∩ Set.Icc ε B).Nonempty)
    (density pref : ℝ → ℝ) (label : ι → ℝ)
    (hpref : ∀ w, w ∈ Set.Icc ε B → pref w ≠ 0)
    (hdensity : ∀ i w,
      w ∈ (Prod.fst ''
        (((Measure.map (canonicalTwoUserValueMap θstar) μ).support ∩
          Prod.fst ⁻¹' Set.Icc ε B) ∩
          canonicalTwoUserGenreRay θstar (angle i))) ∩ Set.Icc ε B →
        density w = pref w * label i)
    (i j : ι) : label i = label j := by
  let Sε : Set (ℝ × ℝ) :=
    (Measure.map (canonicalTwoUserValueMap θstar) μ).support ∩
      Prod.fst ⁻¹' Set.Icc ε B
  have hcompactε : IsCompact Sε := by
    dsimp [Sε]
    exact hcompact.inter_right (isClosed_Icc.preimage continuous_fst)
  have hcoverε : Sε ⊆ ⋃ i, canonicalTwoUserGenreRay θstar (angle i) := by
    intro z hz
    exact canonicalTwoUser_valueSupport_subset_iUnion_canonicalGenreRay_of_nonzeroSupportGenres_subset_range
      (ν := ν) angle hsin hcos hgenres.le hz.1
  have hfstε : Prod.fst '' Sε = Set.Icc ε B := by
    ext w
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact hz.2
    · intro hw
      have hwS : w ∈ Prod.fst ''
          (Measure.map (canonicalTwoUserValueMap θstar) μ).support := by
        rw [hfst_image]
        exact ⟨hε.le.trans hw.1, hw.2⟩
      rcases hwS with ⟨z, hzS, hzw⟩
      refine ⟨z, ⟨hzS, ?_⟩, hzw⟩
      simpa only [Set.mem_preimage, hzw] using hw
  have hnonemptyε : ∀ i,
      ((Prod.fst '' (Sε ∩ canonicalTwoUserGenreRay θstar (angle i))) ∩
        Set.Icc ε B).Nonempty := by
    intro i
    simpa only [Sε] using hnonempty i
  have hdensityε : ∀ i w,
      w ∈ (Prod.fst '' (Sε ∩ canonicalTwoUserGenreRay θstar (angle i))) ∩
        Set.Icc ε B → density w = pref w * label i := by
    intro i w hw
    apply hdensity i w
    simpa only [Sε] using hw
  exact finiteGenre_label_eq_of_shared_density_of_compact_canonicalRay_cover
    angle hcompactε hcoverε hfstε hnonemptyε density pref label hpref hdensityε i j

/--
Finite realized nonzero genres supply the uniform positive cutoff required by
