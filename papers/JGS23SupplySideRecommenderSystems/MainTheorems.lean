/--
Corrected full below-q existence form of Corollary `betap`.  For finite Lq
costs, the barycenter argument proves the product-supremum condition at q;
the checked decreasing-exponent theorem then supplies it at every positive
beta at most q.  The compact single-genre iff constructs the corresponding
source equilibrium with a singleton nonzero-support genre.
-/
theorem exists_sourceSymmetricMixedNash_singleton_nonzeroSupportGenre_lp_of_pos_le_exponent
    {D N P : ℕ} [Nonempty (Fin N)] [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {q β : ℝ} {users : Fin N → Content D}
    (hq : 1 ≤ q) (hβ : 0 < β) (hβ_le_q : β ≤ q)
    (husers : ∀ i : Fin N, NonnegativeContent (users i))
    (husers_nonzero : ∀ i : Fin N, NonzeroContent (users i)) :
    ∃ (μ : MixedContentStrategy D) (genre : Content D),
      SourceSymmetricMixedNash (P := P) users
        (normRpowCost (SourceNorm.lp D (lt_of_lt_of_le zero_lt_one hq)) β) μ ∧
      SourceNonzeroSupportGenres (SourceNorm.lp D (lt_of_lt_of_le zero_lt_one hq)) μ =
        ({genre} : Set (Content D)) := by
  let qpos : 0 < q := lt_of_lt_of_le zero_lt_one hq
  let ν : SourceNorm D := SourceNorm.lp D qpos
  have hproduct_q : SingleGenreProductSupCondition
      {y : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) q y} := by
    simpa [ν, SourceNorm.lp] using
      singleGenreProductSupCondition_inPoweredUnitImage_lp_at_exponent hq husers
  have hcompact : SourceNormCompactSublevels ν := by
    simpa [ν] using SourceNorm.lp_compactSublevels qpos
  have hproduct_beta : SingleGenreProductSupCondition
      {y : Fin N → ℝ | InPoweredUnitImage users
        (fun p => NonnegativeContent p ∧ ν.norm p ≤ 1) β y} :=
    singleGenreProductSupCondition_inPoweredUnitImage_of_le_exponent_of_compactSublevels
      hβ hβ_le_q husers hcompact hproduct_q
  have hresult :=
    (exists_sourceSymmetricMixedNash_singleton_nonzeroSupportGenre_iff_productSupCondition_of_compactSublevels
      (P := P) ν hβ husers husers_nonzero
      (by simpa [ν] using SourceNorm.lp_perturbationContinuous qpos)
      hcompact
      (by simpa [ν] using SourceNorm.lp_continuous qpos)).mpr hproduct_beta
  simpa [ν] using hresult

/--
Every angle between two nonnegative acute unit users is realized by a
nonnegative Euclidean-unit content vector.  The sine-interpolation formula is
the source-faithful substitute for rotating the content orthant: both
coefficients are nonnegative on the central angle interval.
-/
theorem exists_twoUser_nonnegative_unit_content_of_angle_mem_Icc
    {D : ℕ} {u v : Content D} {theta phi : ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2)
    (hphi : phi ∈ Set.Icc 0 theta) :
    ∃ p : Content D,
      NonnegativeContent p ∧
      AppliedModelingLib.FiniteDimensionalNorms.l2 p = 1 ∧
      score u p = Real.cos phi ∧
      score v p = Real.cos (theta - phi) := by
  have hsin_theta : 0 < Real.sin theta :=
    Real.sin_pos_of_pos_of_lt_pi htheta_pos (by
      linarith [Real.pi_pos])
  have hdelta_nonnegative : 0 ≤ theta - phi := sub_nonneg.mpr hphi.2
  have hhalf_pi_le_pi : Real.pi / 2 ≤ Real.pi := by
    linarith [Real.pi_pos]
  have hdelta_le_pi : theta - phi ≤ Real.pi :=
    (sub_le_self theta hphi.1).trans
      (htheta_le_half_pi.trans hhalf_pi_le_pi)
  have hphi_le_pi : phi ≤ Real.pi :=
    hphi.2.trans (htheta_le_half_pi.trans hhalf_pi_le_pi)
  let a : ℝ := Real.sin (theta - phi) / Real.sin theta
  let b : ℝ := Real.sin phi / Real.sin theta
  have ha_nonnegative : 0 ≤ a := by
    dsimp [a]
    exact div_nonneg
      (Real.sin_nonneg_of_nonneg_of_le_pi hdelta_nonnegative hdelta_le_pi)
      hsin_theta.le
  have hb_nonnegative : 0 ≤ b := by
    dsimp [b]
    exact div_nonneg
      (Real.sin_nonneg_of_nonneg_of_le_pi hphi.1 hphi_le_pi)
      hsin_theta.le
  let p : Content D := scaleContent a u + scaleContent b v
  have hp_nonnegative : NonnegativeContent p := by
    intro d
    exact add_nonneg
      (scaleContent_nonnegative ha_nonnegative hu_nonnegative d)
      (scaleContent_nonnegative hb_nonnegative hv_nonnegative d)
  have hscore_u : score u p = Real.cos phi := by
    dsimp [p]
    rw [score_add, score_scaleContent, score_scaleContent, hu, huv]
    dsimp [a, b]
    rw [Real.sin_sub]
    field_simp [hsin_theta.ne']
    ring
  have hvu : score v u = Real.cos theta := by
    rw [score_comm]
    exact huv
  have hscore_v : score v p = Real.cos (theta - phi) := by
    dsimp [p]
    rw [score_add, score_scaleContent, score_scaleContent, hvu, hv]
    dsimp [a, b]
    rw [Real.sin_sub, Real.cos_sub]
    field_simp [hsin_theta.ne']
    linear_combination -(Real.sin phi) * (Real.sin_sq_add_cos_sq theta)
  have hunit_combination :
      a * Real.cos phi + b * Real.cos (theta - phi) = 1 := by
    have hnumerator :
        Real.sin (theta - phi) * Real.cos phi +
            Real.sin phi * Real.cos (theta - phi) = Real.sin theta := by
      rw [show Real.sin phi * Real.cos (theta - phi) =
        Real.cos (theta - phi) * Real.sin phi by ring, ← Real.sin_add]
      congr 2
      ring
    dsimp [a, b]
    rw [div_mul_eq_mul_div, div_mul_eq_mul_div, ← add_div, hnumerator]
    exact div_self hsin_theta.ne'
  have hp_self : score p p = 1 := by
    rw [show p = scaleContent a u + scaleContent b v by rfl,
      score_add_left, score_scaleUser, score_scaleUser, hscore_u, hscore_v,
      hunit_combination]
  have hp_norm_sq : AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ 2 = 1 := by
    rw [← score_self_eq_l2_sq, hp_self]
  have hp_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 p = 1 := by
    nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p]
  exact ⟨p, hp_nonnegative, hp_norm, hscore_u, hscore_v⟩

/-- Lift a corrected two-score equilibrium to arbitrary-dimensional
nonnegative unit users by choosing the two sine-interpolated genre rays. -/
noncomputable def correctedInfiniteTwoGenreGeneralContentEquilibrium_of_scoreEquilibrium
    {D : ℕ} {F : ℝ → ℝ} {beta A B theta phi : ℝ}
    {u v : Content D}
    (scoreEquilibrium : CorrectedInfiniteTwoGenreScoreEquilibrium F beta A B theta)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (hbeta : 0 ≤ beta) (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2)
    (hphi : phi ∈ Set.Icc 0 (theta / 2))
    (hA : A = Real.cos phi) (hB : B = Real.cos (theta - phi)) :
    CorrectedInfiniteTwoGenreGeneralContentEquilibrium F beta u v := by
  classical
  have hsin : 0 < Real.sin theta :=
    Real.sin_pos_of_pos_of_lt_pi htheta_pos (by linarith [Real.pi_pos])
  have hphi_full : phi ∈ Set.Icc 0 theta := by
    constructor
    · exact hphi.1
    · linarith [hphi.2, htheta_pos]
  have hother : theta - phi ∈ Set.Icc 0 theta := by
    constructor <;> linarith [hphi.1, hphi.2, htheta_pos]
  let hfirst_exists := exists_twoUser_nonnegative_unit_content_of_angle_mem_Icc
    hu_nonnegative hv_nonnegative hu hv huv htheta_pos htheta_le_half_pi hphi_full
  let d1 : Content D := Classical.choose hfirst_exists
  have hd1_spec := Classical.choose_spec hfirst_exists
  rcases hd1_spec with ⟨hd1_nonnegative, hd1_norm, hud1, hvd1⟩
  let hsecond_exists := exists_twoUser_nonnegative_unit_content_of_angle_mem_Icc
    hu_nonnegative hv_nonnegative hu hv huv htheta_pos htheta_le_half_pi hother
  let d2 : Content D := Classical.choose hsecond_exists
  have hd2_spec := Classical.choose_spec hsecond_exists
  rcases hd2_spec with ⟨hd2_nonnegative, hd2_norm, hud2, hvd2⟩
  have hangle : theta - (theta - phi) = phi := by ring
  have h11 : score u d1 = A := hud1.trans hA.symm
  have h12 : score u d2 = B := hud2.trans hB.symm
  have h21 : score v d1 = B := hvd1.trans hB.symm
  have h22 : score v d2 = A := by
    have hvd2' : score v d2 = Real.cos phi := by
      dsimp [d2]
      simpa only [hangle] using hvd2
    exact hvd2'.trans hA.symm
  exact correctedInfiniteTwoGenreGeneralContentEquilibrium_of_scoreEquilibrium_of_genres
    scoreEquilibrium hu_nonnegative hv_nonnegative hu hv huv hbeta hsin
    hd1_nonnegative hd2_nonnegative hd1_norm hd2_norm h11 h12 h21 h22 hA hB

/-- In the repaired strict-acute high-phase regime, the geometric-shell
candidate is an equilibrium for any two nonnegative unit users with the given
angle, in any finite ambient dimension. -/
theorem exists_correctedInfiniteTwoGenreGeneralContentEquilibrium_of_phaseThreshold_lt
    {D : ℕ} {beta theta : ℝ} {u v : Content D}
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (htheta_pos : 0 < theta) (htheta_lt_half_pi : theta < Real.pi / 2)
    (hphase : twoUserPhaseThreshold theta < beta) :
    ∃ a C1 C2 A B phi : ℝ,
      ∃ _ : CorrectedInfiniteTwoGenreGeneralContentEquilibrium
        (infiniteGenreCandidateCdf a C1 C2 beta) beta u v,
      phi ∈ Set.Icc 0 (theta / 2) ∧
      IsMaxOn (twoUserCosPowerSum beta theta) (Set.Icc 0 (theta / 2)) phi ∧
      0 < a ∧ 0 < C2 ∧ C2 < 1 ∧
      C1 = a ^ beta ∧ C1 = 1 + C2 ^ beta ∧
      A = Real.cos phi ∧ B = Real.cos (theta - phi) ∧ C2 = B / A := by
  have htheta_lt_pi : theta < Real.pi := by
    linarith [Real.pi_pos]
  have hsin : 0 < Real.sin theta :=
    Real.sin_pos_of_pos_of_lt_pi htheta_pos htheta_lt_pi
  have hcos : 0 < Real.cos theta :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], htheta_lt_half_pi⟩
  have htrig : 1 - Real.cos theta = 2 * (Real.sin (theta / 2)) ^ 2 := by
    rw [Real.sin_sq_eq_half_sub]
    have hdouble : 2 * (theta / 2) = theta := by ring
    rw [hdouble]
    ring
  have hden : 0 < 1 - Real.cos theta := by
    rw [htrig]
    have hhalf : 0 < Real.sin (theta / 2) :=
      Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith [Real.pi_pos])
    positivity
  have hbeta_two : 2 < beta :=
    twoUser_two_lt_beta_of_phaseThreshold_lt_beta hden hcos hphase
  have hbeta_pos : 0 < beta := by linarith
  have hbeta_one : 1 ≤ beta := by linarith
  obtain ⟨a, C1, C2, A, B, phi, _hcanonical, _hfirst, _hsecond, _hdistinct,
    hphi, hmax, ha, hC2, hC2_one, hC1, hbalance, hA, hB, hratio⟩ :=
    exists_correctedInfiniteTwoGenreContentEquilibrium_of_phaseThreshold_lt
      htheta_pos htheta_lt_half_pi hphase
  have hA_pos : 0 < A := by
    rw [hA]
    exact Real.cos_pos_of_mem_Ioo
      ⟨by linarith [hphi.1, Real.pi_pos],
        by linarith [hphi.2, htheta_lt_half_pi]⟩
  have hB_pos : 0 < B := by
    rw [hB]
    exact Real.cos_pos_of_mem_Ioo
      ⟨by linarith [hphi.2, htheta_pos, Real.pi_pos],
        by linarith [hphi.1, htheta_lt_half_pi]⟩
  refine ⟨a, C1, C2, A, B, phi, ?_, hphi, hmax, ha, hC2, hC2_one,
    hC1, hbalance, hA, hB, hratio⟩
  exact correctedInfiniteTwoGenreGeneralContentEquilibrium_of_scoreEquilibrium
    (infiniteGenreCandidate_correctedInfiniteTwoGenreScoreEquilibrium_of_leftHalf_angle_max
      ha hC2 hC2_one hbeta_pos hC1 hbalance
      hA_pos hB_pos
      hratio hsin htheta_pos htheta_lt_half_pi.le hbeta_one hA hB hmax)
    hu_nonnegative hv_nonnegative hu hv huv hbeta_pos.le htheta_pos
    htheta_lt_half_pi.le hphi hA hB

/-- Source-facing arbitrary-user form of the repaired infinite-genre theorem.
The nonzero vectors are normalized only inside the proof; score-ratio C1
payoffs are invariant under that normalization, so the resulting equilibrium
is for the original nonnegative users. -/
theorem exists_correctedInfiniteTwoGenreGeneralContentEquilibrium_of_phaseThreshold_lt_for_raw_users
    {D : ℕ} {beta theta : ℝ} {u v : Content D}
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hu_nonzero : u ≠ 0) (hv_nonzero : v ≠ 0)
    (hangle : score u v /
      (AppliedModelingLib.FiniteDimensionalNorms.l2 u *
        AppliedModelingLib.FiniteDimensionalNorms.l2 v) = Real.cos theta)
    (htheta_pos : 0 < theta) (htheta_lt_half_pi : theta < Real.pi / 2)
    (hphase : twoUserPhaseThreshold theta < beta) :
    ∃ a C1 C2 A B phi : ℝ,
      ∃ _ : CorrectedInfiniteTwoGenreGeneralContentEquilibrium
        (infiniteGenreCandidateCdf a C1 C2 beta) beta u v,
      phi ∈ Set.Icc 0 (theta / 2) ∧
      IsMaxOn (twoUserCosPowerSum beta theta) (Set.Icc 0 (theta / 2)) phi ∧
      0 < a ∧ 0 < C2 ∧ C2 < 1 ∧
      C1 = a ^ beta ∧ C1 = 1 + C2 ^ beta ∧
      A = Real.cos phi ∧ B = Real.cos (theta - phi) ∧ C2 = B / A := by
  have hu_exists : ∃ i, u i ≠ 0 := by
    by_contra h
    push_neg at h
    apply hu_nonzero
    ext i
    exact h i
  have hv_exists : ∃ i, v i ≠ 0 := by
    by_contra h
    push_neg at h
    apply hv_nonzero
    ext i
    exact h i
  have hu_norm : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 u :=
    AppliedModelingLib.FiniteDimensionalNorms.normL2_pos_of_exists_ne_zero hu_exists
  have hv_norm : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 v :=
    AppliedModelingLib.FiniteDimensionalNorms.normL2_pos_of_exists_ne_zero hv_exists
  obtain ⟨a, C1, C2, A, B, phi, hequilibrium, hphi, hmax, ha, hC2,
    hC2_one, hC1, hbalance, hA, hB, hratio⟩ :=
    exists_correctedInfiniteTwoGenreGeneralContentEquilibrium_of_phaseThreshold_lt
      (u := twoUserNormalizedContent u) (v := twoUserNormalizedContent v)
      (twoUserNormalizedContent_nonnegative hu_nonnegative)
      (twoUserNormalizedContent_nonnegative hv_nonnegative)
      (score_twoUserNormalizedContent_self hu_norm)
      (score_twoUserNormalizedContent_self hv_norm)
      (score_twoUserNormalizedContent_pair_eq_cos hu_norm hv_norm hangle)
      htheta_pos htheta_lt_half_pi hphase
  refine ⟨a, C1, C2, A, B, phi, ?_, hphi, hmax, ha, hC2, hC2_one,
    hC1, hbalance, hA, hB, hratio⟩
  have hscaled := correctedInfiniteTwoGenreGeneralContentEquilibrium_scale_users
    hequilibrium hu_norm.ne' hv_norm.ne'
  rw [scale_l2_twoUserNormalizedContent hu_norm,
    scale_l2_twoUserNormalizedContent hv_norm] at hscaled
  exact hscaled

/--
The normalized sum of two nonnegative Euclidean-unit users realizes the
bisector score pair.  This supplies the actual diagonal row required by the
product-supremum argument, rather than postulating that row abstractly.
-/
theorem exists_twoUser_nonnegative_unit_bisector_content
    {D : ℕ} {u v : Content D} {theta : ℝ}
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (htheta_nonnegative : 0 ≤ theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) :
    ∃ p : Content D,
      NonnegativeContent p ∧
      AppliedModelingLib.FiniteDimensionalNorms.l2 p = 1 ∧
      score u p = Real.cos (theta / 2) ∧
      score v p = Real.cos (theta / 2) := by
  let c : ℝ := Real.cos (theta / 2)
  have hhalf_mem : theta / 2 ∈ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2) := by
    constructor <;> linarith [Real.pi_pos]
  have hc_positive : 0 < c := by
    dsimp [c]
    exact Real.cos_pos_of_mem_Ioo hhalf_mem
  have hdouble : Real.cos theta = 2 * c ^ 2 - 1 := by
    have hcos := Real.cos_two_mul (theta / 2)
    rw [show 2 * (theta / 2) = theta by ring] at hcos
    simpa [c, pow_two] using hcos
  let p : Content D := scaleContent (2 * c)⁻¹ (u + v)
  have hp_nonnegative : NonnegativeContent p := by
    dsimp [p]
    apply scaleContent_nonnegative (inv_nonneg.mpr (mul_nonneg (by norm_num) hc_positive.le))
    intro d
    exact add_nonneg (hu_nonnegative d) (hv_nonnegative d)
  have hscore_u : score u p = c := by
    dsimp [p]
    rw [score_scaleContent, score_add, hu, huv, hdouble]
    field_simp [hc_positive.ne']
    ring
  have hvu : score v u = Real.cos theta := by
    rw [score_comm]
    exact huv
  have hscore_v : score v p = c := by
    dsimp [p]
    rw [score_scaleContent, score_add, hvu, hv, hdouble]
    field_simp [hc_positive.ne']
    ring
  have hp_self : score p p = 1 := by
    rw [show p = scaleContent (2 * c)⁻¹ (u + v) by rfl,
      score_scaleUser, score_add_left, hscore_u, hscore_v]
    field_simp [hc_positive.ne']
    ring
  have hp_norm_sq : AppliedModelingLib.FiniteDimensionalNorms.l2 p ^ 2 = 1 := by
    rw [← score_self_eq_l2_sq, hp_self]
  have hp_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 p = 1 := by
    nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p]
  exact ⟨p, hp_nonnegative, hp_norm, by simpa [c] using hscore_u,
    by simpa [c] using hscore_v⟩

/--
Every nonnegative score pair generated by the Euclidean unit ball obeys the
corrected bisector bound under the source phase inequality.  The proof first
places the pair in the Gram ellipse, then uses the full positive-score polar
cone and its radial factor.  Thus it does not assume that rotating the users
preserves the nonnegative content orthant.
-/
theorem twoUser_score_rpow_sum_le_bisector_of_unit_score_pair
    {D : ℕ} {u v p : Content D} {beta theta : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (hsin : Real.sin theta ≠ 0)
    (hbeta_one : 1 ≤ beta)
    (hphase : beta * (1 - Real.cos theta) ≤ 2)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2)
    (hup : 0 ≤ score u p) (hvp : 0 ≤ score v p)
    (hpp : score p p ≤ 1) :
    (score u p) ^ beta + (score v p) ^ beta ≤
      2 * (Real.cos (theta / 2)) ^ beta := by
  have hquadratic :
      twoUserInducedCostQuadratic theta (score u p) (score v p) ≤ 1 :=
    (twoUserInducedCostQuadratic_le_score_self_of_unit_score_pair
      hu hv huv hsin).trans hpp
  obtain ⟨r, phi, hr, hphi, hscore_first, hscore_second⟩ :=
    exists_twoUser_polar_of_nonnegative_pair_of_inducedCostQuadratic_le_one
      htheta_pos.le htheta_le_half_pi hsin hup hvp hquadratic
  have hminus_half_pi_nonpos : -(Real.pi / 2) ≤ 0 := by
    linarith [Real.pi_pos]
  have htheta_shift_lower : -(Real.pi / 2) ≤ theta - Real.pi / 2 := by
    linarith
  have hphi_lower : -(Real.pi / 2) ≤ phi :=
    htheta_shift_lower.trans hphi.1
  have hcos_first : 0 ≤ Real.cos phi :=
    Real.cos_nonneg_of_mem_Icc ⟨hphi_lower, hphi.2⟩
  have hother_lower : -(Real.pi / 2) ≤ theta - phi :=
    htheta_shift_lower.trans (sub_le_sub_left hphi.2 theta)
  have hother_upper : theta - phi ≤ Real.pi / 2 := by
    linarith [hphi.1]
  have hcos_second : 0 ≤ Real.cos (theta - phi) :=
    Real.cos_nonneg_of_mem_Icc ⟨hother_lower, hother_upper⟩
  have hrpow_le_one : r ^ beta ≤ 1 :=
    Real.rpow_le_one hr.1 hr.2 (by linarith)
  have hangular :=
    twoUserCosPowerSum_le_bisector_of_source_phase_of_angle_mem_positiveScoreCone
      hbeta_one hphase htheta_pos htheta_le_half_pi hphi.1 hphi.2
  have hangular_nonnegative : 0 ≤ twoUserCosPowerSum beta theta phi := by
    unfold twoUserCosPowerSum
    exact add_nonneg (Real.rpow_nonneg hcos_first _)
      (Real.rpow_nonneg hcos_second _)
  rw [hscore_first, hscore_second,
    Real.mul_rpow hr.1 hcos_first, Real.mul_rpow hr.1 hcos_second]
  calc
    r ^ beta * Real.cos phi ^ beta +
        r ^ beta * Real.cos (theta - phi) ^ beta =
        r ^ beta * twoUserCosPowerSum beta theta phi := by
      unfold twoUserCosPowerSum
      ring
    _ ≤ 1 * twoUserCosPowerSum beta theta phi :=
      mul_le_mul_of_nonneg_right hrpow_le_one hangular_nonnegative
    _ ≤ twoUserCosPowerSum beta theta (theta / 2) := by
      simpa using hangular
    _ = 2 * (Real.cos (theta / 2)) ^ beta := by
      unfold twoUserCosPowerSum
      have hhalf : theta - theta / 2 = theta / 2 := by ring
      rw [hhalf]
      ring

/-- The Euclidean-unit two-user score product is maximized at the bisector. -/
theorem twoUser_score_product_le_bisector_of_unit_score_pair
    {D : ℕ} {u v p : Content D} {theta : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (hsin : Real.sin theta ≠ 0)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2)
    (hup : 0 ≤ score u p) (hvp : 0 ≤ score v p)
    (hpp : score p p ≤ 1) :
    score u p * score v p ≤ (Real.cos (theta / 2)) ^ 2 := by
  have hquadratic :
      twoUserInducedCostQuadratic theta (score u p) (score v p) ≤ 1 :=
    (twoUserInducedCostQuadratic_le_score_self_of_unit_score_pair
      hu hv huv hsin).trans hpp
  obtain ⟨r, phi, hr, hphi, hscore_first, hscore_second⟩ :=
    exists_twoUser_polar_of_nonnegative_pair_of_inducedCostQuadratic_le_one
      htheta_pos.le htheta_le_half_pi hsin hup hvp hquadratic
  have hminus_half_pi_nonpos : -(Real.pi / 2) ≤ 0 := by
    linarith [Real.pi_pos]
  have htheta_shift_lower : -(Real.pi / 2) ≤ theta - Real.pi / 2 := by
    linarith
  have hphi_lower : -(Real.pi / 2) ≤ phi :=
    htheta_shift_lower.trans hphi.1
  have hcos_first : 0 ≤ Real.cos phi :=
    Real.cos_nonneg_of_mem_Icc ⟨hphi_lower, hphi.2⟩
  have hother_lower : -(Real.pi / 2) ≤ theta - phi :=
    htheta_shift_lower.trans (sub_le_sub_left hphi.2 theta)
  have hother_upper : theta - phi ≤ Real.pi / 2 := by
    linarith [hphi.1]
  have hcos_second : 0 ≤ Real.cos (theta - phi) :=
    Real.cos_nonneg_of_mem_Icc ⟨hother_lower, hother_upper⟩
  have hr_sq_le_one : r ^ 2 ≤ 1 := by
    simpa only [one_pow] using pow_le_pow_left₀ hr.1 hr.2 2
  have hangular_nonnegative :
      0 ≤ Real.cos phi * Real.cos (theta - phi) :=
    mul_nonneg hcos_first hcos_second
  have hangular :
      Real.cos phi * Real.cos (theta - phi) ≤
        Real.cos (theta / 2) * Real.cos (theta - theta / 2) :=
    (twoUser_cos_product_isMaxOn_bisector theta)
      (show phi ∈ Set.univ by simp)
  rw [hscore_first, hscore_second]
  calc
    (r * Real.cos phi) * (r * Real.cos (theta - phi)) =
        r ^ 2 * (Real.cos phi * Real.cos (theta - phi)) := by ring
    _ ≤ 1 * (Real.cos phi * Real.cos (theta - phi)) :=
      mul_le_mul_of_nonneg_right hr_sq_le_one hangular_nonnegative
    _ ≤ Real.cos (theta / 2) * Real.cos (theta - theta / 2) := by
      simpa using hangular
    _ = (Real.cos (theta / 2)) ^ 2 :=
      twoUser_cos_product_at_bisector theta

/-- The same bisector product maximum after a positive source power. -/
theorem twoUser_score_rpow_product_le_bisector_of_unit_score_pair
    {D : ℕ} {u v p : Content D} {beta theta : ℝ}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (hsin : Real.sin theta ≠ 0)
    (hbeta : 0 < beta)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2)
    (hup : 0 ≤ score u p) (hvp : 0 ≤ score v p)
    (hpp : score p p ≤ 1) :
    (score u p) ^ beta * (score v p) ^ beta ≤
      (Real.cos (theta / 2)) ^ beta *
        (Real.cos (theta / 2)) ^ beta := by
  have hraw := twoUser_score_product_le_bisector_of_unit_score_pair
    hu hv huv hsin htheta_pos htheta_le_half_pi hup hvp hpp
  have hraw_nonnegative : 0 ≤ score u p * score v p := mul_nonneg hup hvp
  have hhalf_mem : theta / 2 ∈ Set.Icc (-(Real.pi / 2)) (Real.pi / 2) := by
    constructor <;> linarith [Real.pi_pos]
  have hcos_half : 0 ≤ Real.cos (theta / 2) :=
    Real.cos_nonneg_of_mem_Icc hhalf_mem
  calc
    (score u p) ^ beta * (score v p) ^ beta =
        (score u p * score v p) ^ beta :=
      (Real.mul_rpow hup hvp).symm
    _ ≤ ((Real.cos (theta / 2)) ^ 2) ^ beta :=
      Real.rpow_le_rpow hraw_nonnegative hraw hbeta.le
    _ = (Real.cos (theta / 2) * Real.cos (theta / 2)) ^ beta := by
      rw [pow_two]
    _ = (Real.cos (theta / 2)) ^ beta *
        (Real.cos (theta / 2)) ^ beta :=
      Real.mul_rpow hcos_half hcos_half

/--
Two-coordinate product bound used to connect the corrected two-user angular
calculation to the single-genre product-supremum condition.  A nonnegative
row whose coordinate sum is at most that of a diagonal row has product at
most the diagonal product; the same remains true after convexification.

This is deliberately stated for an arbitrary two-coordinate row set, so the
source-specific polar parametrization can be supplied separately rather than
silently conflating it with the full nonnegative content ball.
-/
theorem singleGenreProductSupCondition_finTwo_of_diagonal_mem_of_nonnegative_of_sum_le
    {S : Set (Fin 2 → ℝ)} {b : ℝ}
    (hdiag_mem : (fun _ : Fin 2 => b) ∈ S)
    (hnonnegative : ∀ z ∈ S, ∀ i, 0 ≤ z i)
    (hsum : ∀ z ∈ S, z 0 + z 1 ≤ 2 * b) :
    SingleGenreProductSupCondition S := by
  let diagonal : Fin 2 → ℝ := fun _ => b
  have hdiagonal_product : coordinateProduct diagonal = b * b := by
    simp [coordinateProduct, diagonal, pow_two]
  have hdiag_nonnegative : 0 ≤ b := by
    simpa [diagonal] using hnonnegative diagonal (by simpa [diagonal] using hdiag_mem) 0
  have hproduct_le_diagonal : ∀ z ∈ S, coordinateProduct z ≤ coordinateProduct diagonal := by
    intro z hz
    have hz0 : 0 ≤ z 0 := hnonnegative z hz 0
    have hz1 : 0 ≤ z 1 := hnonnegative z hz 1
    have hzsum : z 0 + z 1 ≤ 2 * b := hsum z hz
    have hsq : 0 ≤ (z 0 - z 1) ^ 2 := sq_nonneg (z 0 - z 1)
    rw [show coordinateProduct z = z 0 * z 1 by simp [coordinateProduct], hdiagonal_product]
    nlinarith
  have hsum_hull : ∀ z ∈ convexHull ℝ S, z 0 + z 1 ≤ 2 * b := by
    have hhalfspace_convex : Convex ℝ {z : Fin 2 → ℝ | z 0 + z 1 ≤ 2 * b} := by
      exact convex_halfSpace_le (f := fun z : Fin 2 → ℝ => z 0 + z 1)
        (IsLinearMap.mk (by
          intro x y
          simp only [Pi.add_apply]
          ring) (by
          intro c x
          simp [mul_add])) (2 * b)
    have hsubset : S ⊆ {z : Fin 2 → ℝ | z 0 + z 1 ≤ 2 * b} := by
      intro z hz
      exact hsum z hz
    exact fun z hz => (hhalfspace_convex.convexHull_subset_iff.mpr hsubset) hz
  have hnonnegative_hull : ∀ z ∈ convexHull ℝ S, ∀ i, 0 ≤ z i := by
    have hsubset : convexHull ℝ S ⊆ {z : Fin 2 → ℝ | NonnegativeContent z} :=
      convexHull_min hnonnegative (convex_nonnegativeContentSet (D := 2))
    exact fun z hz i => hsubset hz i
  have hproduct_hull_le_diagonal :
      ∀ z ∈ convexHull ℝ S, coordinateProduct z ≤ coordinateProduct diagonal := by
    intro z hz
    have hz0 : 0 ≤ z 0 := hnonnegative_hull z hz 0
    have hz1 : 0 ≤ z 1 := hnonnegative_hull z hz 1
    have hzsum : z 0 + z 1 ≤ 2 * b := hsum_hull z hz
    have hsq : 0 ≤ (z 0 - z 1) ^ 2 := sq_nonneg (z 0 - z 1)
    rw [show coordinateProduct z = z 0 * z 1 by simp [coordinateProduct], hdiagonal_product]
    nlinarith
  have hmaxS : IsCoordinateProductMaximizer S diagonal := by
    exact ⟨by simpa [diagonal] using hdiag_mem, hproduct_le_diagonal⟩
  have hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) diagonal := by
    exact ⟨subset_convexHull ℝ S (by simpa [diagonal] using hdiag_mem),
      hproduct_hull_le_diagonal⟩
  unfold SingleGenreProductSupCondition
  rw [coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxS,
    coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxHull]

/--
The powered bisector row is an actual coordinate-product maximizer of the
two-user Euclidean source image for every positive exponent.  The phase
threshold affects convexification, not this source-set product maximum.
-/
theorem isCoordinateProductMaximizer_inPoweredUnitImage_twoUsers_l2_bisector
    {D : ℕ} {users : Fin 2 → Content D} {beta theta : ℝ}
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hfirst_unit : score (users 0) (users 0) = 1)
    (hsecond_unit : score (users 1) (users 1) = 1)
    (hcross : score (users 0) (users 1) = Real.cos theta)
    (hbeta : 0 < beta)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) :
    IsCoordinateProductMaximizer
      {z : Fin 2 → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
          beta z}
      (fun _ => (Real.cos (theta / 2)) ^ beta) := by
  have hsin : Real.sin theta ≠ 0 := by
    apply ne_of_gt
    exact Real.sin_pos_of_pos_of_lt_pi htheta_pos (by
      linarith [Real.pi_pos])
  constructor
  · obtain ⟨p, hp_nonnegative, hp_norm, hscore_first, hscore_second⟩ :=
      exists_twoUser_nonnegative_unit_bisector_content
        (husers_nonnegative 0) (husers_nonnegative 1)
        hfirst_unit hsecond_unit hcross htheta_pos.le htheta_le_half_pi
    refine ⟨fun i => score (users i) p, ⟨p, ?_, rfl⟩, ?_⟩
    · exact ⟨hp_nonnegative, by simpa [SourceNorm.l2] using hp_norm.le⟩
    · funext i
      fin_cases i
      · simp [hscore_first]
      · simp [hscore_second]
  · intro z hz
    rcases hz with ⟨base, ⟨p, hp, hbase⟩, hz⟩
    rw [hz, hbase]
    have hp_l2 : AppliedModelingLib.FiniteDimensionalNorms.l2 p ≤ 1 := by
      simpa [SourceNorm.l2] using hp.2
    simpa [coordinateProduct, pow_two] using
      (twoUser_score_rpow_product_le_bisector_of_unit_score_pair
        hfirst_unit hsecond_unit hcross hsin hbeta htheta_pos
        htheta_le_half_pi
        (score_nonneg_of_nonnegative (husers_nonnegative 0) hp.1)
        (score_nonneg_of_nonnegative (husers_nonnegative 1) hp.1)
        (score_self_le_one_of_l2_norm_le_one hp_l2))

/--
Source-level two-user product-supremum condition for the actual nonnegative
Euclidean unit ball.  This is the missing optimization bridge in Corollary
`2users`: the powered source image, not merely an abstract angular row set,
has the same coordinate-product supremum as its convex hull in the low-phase
regime.
-/
theorem singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_of_source_phase
    {D : ℕ} {users : Fin 2 → Content D} {beta theta : ℝ}
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hfirst_unit : score (users 0) (users 0) = 1)
    (hsecond_unit : score (users 1) (users 1) = 1)
    (hcross : score (users 0) (users 1) = Real.cos theta)
    (hbeta_one : 1 ≤ beta)
    (hphase : beta * (1 - Real.cos theta) ≤ 2)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) :
    SingleGenreProductSupCondition
      {z : Fin 2 → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
          beta z} := by
  let b : ℝ := (Real.cos (theta / 2)) ^ beta
  apply singleGenreProductSupCondition_finTwo_of_diagonal_mem_of_nonnegative_of_sum_le
    (b := b)
  · obtain ⟨p, hp_nonnegative, hp_norm, hscore_first, hscore_second⟩ :=
      exists_twoUser_nonnegative_unit_bisector_content
        (husers_nonnegative 0) (husers_nonnegative 1)
        hfirst_unit hsecond_unit hcross htheta_pos.le htheta_le_half_pi
    refine ⟨fun i => score (users i) p, ⟨p, ?_, rfl⟩, ?_⟩
    · exact ⟨hp_nonnegative, by simpa [SourceNorm.l2] using hp_norm.le⟩
    · funext i
      fin_cases i
      · simp [b, hscore_first]
      · simp [b, hscore_second]
  · intro z hz i
    rcases hz with ⟨base, ⟨p, hp, hbase⟩, hz⟩
    rw [hz, hbase]
    exact Real.rpow_nonneg
      (score_nonneg_of_nonnegative (husers_nonnegative i) hp.1) beta
  · intro z hz
    rcases hz with ⟨base, ⟨p, hp, hbase⟩, hz⟩
    rw [hz, hbase]
    have hsin : Real.sin theta ≠ 0 := by
      apply ne_of_gt
      exact Real.sin_pos_of_pos_of_lt_pi htheta_pos (by
        linarith [Real.pi_pos])
    have hp_l2 : AppliedModelingLib.FiniteDimensionalNorms.l2 p ≤ 1 := by
      simpa [SourceNorm.l2] using hp.2
    simpa [b] using
      (twoUser_score_rpow_sum_le_bisector_of_unit_score_pair
        hfirst_unit hsecond_unit hcross hsin hbeta_one hphase
        htheta_pos htheta_le_half_pi
        (score_nonneg_of_nonnegative (husers_nonnegative 0) hp.1)
        (score_nonneg_of_nonnegative (husers_nonnegative 1) hp.1)
        (score_self_le_one_of_l2_norm_le_one hp_l2))

/-- Threshold-form wrapper for the source-level two-user product condition. -/
theorem singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_of_le_phaseThreshold
    {D : ℕ} {users : Fin 2 → Content D} {beta theta : ℝ}
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hfirst_unit : score (users 0) (users 0) = 1)
    (hsecond_unit : score (users 1) (users 1) = 1)
    (hcross : score (users 0) (users 1) = Real.cos theta)
    (hbeta_one : 1 ≤ beta)
    (hbeta_le : beta ≤ twoUserPhaseThreshold theta)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) :
    SingleGenreProductSupCondition
      {z : Fin 2 → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
          beta z} := by
  have hsin_half : 0 < Real.sin (theta / 2) :=
    Real.sin_pos_of_pos_of_lt_pi (by linarith) (by
      linarith [Real.pi_pos])
  have htrig : 1 - Real.cos theta = 2 * (Real.sin (theta / 2)) ^ 2 := by
    rw [Real.sin_sq_eq_half_sub]
    have hdouble : 2 * (theta / 2) = theta := by ring
    rw [hdouble]
    ring
  have hden : 0 < 1 - Real.cos theta := by
    rw [htrig]
    positivity
  apply singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_of_source_phase
    husers_nonnegative hfirst_unit hsecond_unit hcross hbeta_one
  · exact (twoUser_phase_inequality_iff_le_phaseThreshold hden).2 hbeta_le
  · exact htheta_pos
  · exact htheta_le_half_pi

/--
Above the corrected phase boundary, two reflected feasible angular rows have
a diagonal midpoint whose coordinate product strictly exceeds the maximum
product of every source row.  Hence convexification strictly improves the
product objective and the single-genre product-supremum condition fails.
-/
theorem not_singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_of_phase_lt
    {D : ℕ} {users : Fin 2 → Content D} {beta theta : ℝ}
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hfirst_unit : score (users 0) (users 0) = 1)
    (hsecond_unit : score (users 1) (users 1) = 1)
    (hcross : score (users 0) (users 1) = Real.cos theta)
    (hbeta_one : 1 ≤ beta)
    (hphase_lt : 2 < beta * (1 - Real.cos theta))
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) :
    ¬ SingleGenreProductSupCondition
      {z : Fin 2 → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
          beta z} := by
  let S : Set (Fin 2 → ℝ) :=
    {z | InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
      beta z}
  have hnot_angular_max :
      ¬ (∀ phi, 0 ≤ phi → phi ≤ theta →
        twoUserCosPowerSum beta theta phi ≤
          twoUserCosPowerSum beta theta (theta / 2)) := by
    intro hmax
    have hphase :=
      (twoUserCosPowerSum_bisector_max_iff_source_phase
        hbeta_one htheta_pos htheta_le_half_pi).1 hmax
    linarith
  push Not at hnot_angular_max
  obtain ⟨phi, hphi_nonnegative, hphi_le, hangular_gt⟩ := hnot_angular_max
  have hphi : phi ∈ Set.Icc 0 theta := ⟨hphi_nonnegative, hphi_le⟩
  have hreflected : theta - phi ∈ Set.Icc 0 theta := by
    constructor <;> linarith
  obtain ⟨p1, hp1_nonnegative, hp1_norm, hp1_first, hp1_second⟩ :=
    exists_twoUser_nonnegative_unit_content_of_angle_mem_Icc
      (husers_nonnegative 0) (husers_nonnegative 1)
      hfirst_unit hsecond_unit hcross htheta_pos htheta_le_half_pi hphi
  obtain ⟨p2, hp2_nonnegative, hp2_norm, hp2_first, hp2_second⟩ :=
    exists_twoUser_nonnegative_unit_content_of_angle_mem_Icc
      (husers_nonnegative 0) (husers_nonnegative 1)
      hfirst_unit hsecond_unit hcross htheta_pos htheta_le_half_pi hreflected
  have hback : theta - (theta - phi) = phi := by ring
  have hp2_second' : score (users 1) p2 = Real.cos phi := by
    simpa [hback] using hp2_second
  let row1 : Fin 2 → ℝ := fun i => (score (users i) p1) ^ beta
  let row2 : Fin 2 → ℝ := fun i => (score (users i) p2) ^ beta
  have hrow1 : row1 ∈ S := by
    refine ⟨fun i => score (users i) p1, ⟨p1, ?_, rfl⟩, rfl⟩
    exact ⟨hp1_nonnegative, by simpa [SourceNorm.l2] using hp1_norm.le⟩
  have hrow2 : row2 ∈ S := by
    refine ⟨fun i => score (users i) p2, ⟨p2, ?_, rfl⟩, rfl⟩
    exact ⟨hp2_nonnegative, by simpa [SourceNorm.l2] using hp2_norm.le⟩
  let a : ℝ := (Real.cos phi) ^ beta
  let d : ℝ := (Real.cos (theta - phi)) ^ beta
  let midpoint : Fin 2 → ℝ := fun _ => (a + d) / 2
  have hmidpoint_combo :
      midpoint = (1 / 2 : ℝ) • row1 + (1 / 2 : ℝ) • row2 := by
    funext i
    fin_cases i
    · simp [midpoint, row1, row2, a, d, hp1_first, hp2_first]
      <;> ring
    · simp [midpoint, row1, row2, a, d, hp1_second, hp2_second']
      <;> ring
  have hmidpoint_mem : midpoint ∈ convexHull ℝ S := by
    rw [hmidpoint_combo]
    exact (convex_convexHull ℝ S)
      (subset_convexHull ℝ S hrow1) (subset_convexHull ℝ S hrow2)
      (by norm_num) (by norm_num) (by norm_num)
  have hhalf : theta - theta / 2 = theta / 2 := by ring
  have hsum_gt : 2 * (Real.cos (theta / 2)) ^ beta < a + d := by
    simpa [twoUserCosPowerSum, a, d, hhalf, two_mul] using hangular_gt
  have hcos_phi : 0 ≤ Real.cos phi := by
    apply Real.cos_nonneg_of_mem_Icc
    constructor <;> linarith [Real.pi_pos]
  have hcos_reflected : 0 ≤ Real.cos (theta - phi) := by
    apply Real.cos_nonneg_of_mem_Icc
    constructor <;> linarith [Real.pi_pos]
  have ha_nonnegative : 0 ≤ a := Real.rpow_nonneg hcos_phi _
  have hd_nonnegative : 0 ≤ d := Real.rpow_nonneg hcos_reflected _
  have hcos_half : 0 ≤ Real.cos (theta / 2) := by
    apply Real.cos_nonneg_of_mem_Icc
    constructor <;> linarith [Real.pi_pos]
  have hbisector_nonnegative : 0 ≤ (Real.cos (theta / 2)) ^ beta :=
    Real.rpow_nonneg hcos_half _
  let diagonal : Fin 2 → ℝ :=
    fun _ => (Real.cos (theta / 2)) ^ beta
  have hmidpoint_product_gt :
      coordinateProduct diagonal < coordinateProduct midpoint := by
    have hmean_gt : (Real.cos (theta / 2)) ^ beta < (a + d) / 2 := by
      linarith
    simp [coordinateProduct, diagonal, midpoint]
    nlinarith
  have hmaxS : IsCoordinateProductMaximizer S diagonal := by
    simpa [S, diagonal] using
      (isCoordinateProductMaximizer_inPoweredUnitImage_twoUsers_l2_bisector
        husers_nonnegative hfirst_unit hsecond_unit hcross
        (lt_of_lt_of_le zero_lt_one hbeta_one) htheta_pos htheta_le_half_pi)
  have hbounded : BddAbove (coordinateProduct '' convexHull ℝ S) := by
    simpa [S] using
      (bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := SourceNorm.l2 D) husers_nonnegative
        (SourceNorm.l2_compactSublevels D) (zero_le_one.trans hbeta_one))
  intro hproduct
  have hmidpoint_le_sup :
      coordinateProduct midpoint ≤ coordinateProductSup (convexHull ℝ S) := by
    unfold coordinateProductSup
    exact le_csSup hbounded ⟨midpoint, hmidpoint_mem, rfl⟩
  have hsource_sup : coordinateProductSup S = coordinateProduct diagonal :=
    coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxS
  have hmidpoint_le : coordinateProduct midpoint ≤ coordinateProduct diagonal := by
    calc
      coordinateProduct midpoint ≤ coordinateProductSup (convexHull ℝ S) :=
        hmidpoint_le_sup
      _ = coordinateProductSup S := by
        simpa [SingleGenreProductSupCondition, S] using hproduct.symm
      _ = coordinateProduct diagonal := hsource_sup
  exact (not_lt_of_ge hmidpoint_le) hmidpoint_product_gt

/-- Exact product-supremum characterization at the corrected beta-star. -/
theorem singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_iff_le_phaseThreshold
    {D : ℕ} {users : Fin 2 → Content D} {beta theta : ℝ}
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hfirst_unit : score (users 0) (users 0) = 1)
    (hsecond_unit : score (users 1) (users 1) = 1)
    (hcross : score (users 0) (users 1) = Real.cos theta)
    (hbeta_one : 1 ≤ beta)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) :
    SingleGenreProductSupCondition
      {z : Fin 2 → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
          beta z} ↔
      beta ≤ twoUserPhaseThreshold theta := by
  have hsin_half : 0 < Real.sin (theta / 2) :=
    Real.sin_pos_of_pos_of_lt_pi (by linarith) (by
      linarith [Real.pi_pos])
  have htrig : 1 - Real.cos theta = 2 * (Real.sin (theta / 2)) ^ 2 := by
    rw [Real.sin_sq_eq_half_sub]
    have hdouble : 2 * (theta / 2) = theta := by ring
    rw [hdouble]
    ring
  have hden : 0 < 1 - Real.cos theta := by
    rw [htrig]
    positivity
  constructor
  · intro hproduct
    by_contra hnot
    have hthreshold_lt : twoUserPhaseThreshold theta < beta := lt_of_not_ge hnot
    have hnot_phase : ¬ beta * (1 - Real.cos theta) ≤ 2 := by
      intro hphase
      exact (not_lt_of_ge
        ((twoUser_phase_inequality_iff_le_phaseThreshold hden).1 hphase))
        hthreshold_lt
    exact
      (not_singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_of_phase_lt
        husers_nonnegative hfirst_unit hsecond_unit hcross hbeta_one
        (lt_of_not_ge hnot_phase) htheta_pos htheta_le_half_pi) hproduct
  · intro hbeta_le
    exact
      singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_of_le_phaseThreshold
        husers_nonnegative hfirst_unit hsecond_unit hcross hbeta_one
        hbeta_le htheta_pos htheta_le_half_pi

/--
For a nonempty market with `K` copies of each of two user types, the source
product-supremum condition is exactly the corresponding two-representative
condition.  This is the literal equal-population bridge: powered score rows
are linearly replicated, and their coordinate products are raised to the
same positive natural power.
-/
theorem singleGenreProductSupCondition_inPoweredUnitImage_twoPopulationUsers_l2_iff_twoUsers
    {D K : ℕ} {users : Fin 2 → Content D} {beta theta : ℝ}
    (hK : 0 < K)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hfirst_unit : score (users 0) (users 0) = 1)
    (hsecond_unit : score (users 1) (users 1) = 1)
    (hcross : score (users 0) (users 1) = Real.cos theta)
    (hbeta_one : 1 ≤ beta)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) :
    SingleGenreProductSupCondition
        {z : Fin (2 * K) → ℝ |
          InPoweredUnitImage (twoPopulationUsers K users)
            (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
            beta z} ↔
      SingleGenreProductSupCondition
        {z : Fin 2 → ℝ |
          InPoweredUnitImage users
            (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
            beta z} := by
  let S : Set (Fin 2 → ℝ) :=
    {z | InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1) beta z}
  let T : Set (Fin (2 * K) → ℝ) :=
    {z | InPoweredUnitImage (twoPopulationUsers K users)
      (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1) beta z}
  have hset : T = replicateTwoPopulationRowLinear K '' S := by
    simpa [S, T] using
      (poweredUnitImage_twoPopulationUsers_eq_image_replicateTwoPopulationRowLinear
        (D := D) (K := K) (users := users)
        (unitFeasible := fun p =>
          NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
        (β := beta))
  have hbeta_nonnegative : 0 ≤ beta := zero_le_one.trans hbeta_one
  have hrepusers_nonnegative :
      ∀ i, NonnegativeContent (twoPopulationUsers K users i) := by
    intro i
    exact husers_nonnegative (finProdFinEquiv.symm i).1
  have hnonnegativeHull :
      ∀ z ∈ convexHull ℝ S, ∀ i : Fin 2, 0 ≤ z i := by
    simpa [S] using
      (nonnegative_coordinate_convexHull_inPoweredUnitImage_of_nonnegative
        (ν := SourceNorm.l2 D) husers_nonnegative hbeta_nonnegative)
  have hmaxS : IsCoordinateProductMaximizer S
      (fun _ => (Real.cos (theta / 2)) ^ beta) := by
    simpa [S] using
      (isCoordinateProductMaximizer_inPoweredUnitImage_twoUsers_l2_bisector
        husers_nonnegative hfirst_unit hsecond_unit hcross
        (lt_of_lt_of_le zero_lt_one hbeta_one) htheta_pos htheta_le_half_pi)
  have hboundedS : BddAbove (coordinateProduct '' convexHull ℝ S) := by
    simpa [S] using
      (bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := SourceNorm.l2 D) husers_nonnegative
        (SourceNorm.l2_compactSublevels D) hbeta_nonnegative)
  have hboundedT : BddAbove (coordinateProduct '' convexHull ℝ T) := by
    simpa [T] using
      (bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := SourceNorm.l2 D) hrepusers_nonnegative
        (SourceNorm.l2_compactSublevels D) hbeta_nonnegative)
  have hboundedReplicated : BddAbove
      (coordinateProduct '' convexHull ℝ
        (replicateTwoPopulationRowLinear K '' S)) := by
    rw [← hset]
    exact hboundedT
  change SingleGenreProductSupCondition T ↔ SingleGenreProductSupCondition S
  rw [hset]
  exact singleGenreProductSupCondition_image_replicateTwoPopulationRowLinear_iff
    hK hnonnegativeHull hmaxS hboundedS hboundedReplicated

/--
Literal equal-population form of the corrected two-user phase threshold.
The only population-side clarification is `K > 0`, excluding the empty
market in which copying neither type would erase the two-user geometry.
-/
theorem singleGenreProductSupCondition_inPoweredUnitImage_twoPopulationUsers_l2_iff_le_phaseThreshold
    {D K : ℕ} {users : Fin 2 → Content D} {beta theta : ℝ}
    (hK : 0 < K)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hfirst_unit : score (users 0) (users 0) = 1)
    (hsecond_unit : score (users 1) (users 1) = 1)
    (hcross : score (users 0) (users 1) = Real.cos theta)
    (hbeta_one : 1 ≤ beta)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) :
    SingleGenreProductSupCondition
        {z : Fin (2 * K) → ℝ |
          InPoweredUnitImage (twoPopulationUsers K users)
            (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
            beta z} ↔
      beta ≤ twoUserPhaseThreshold theta := by
  calc
    SingleGenreProductSupCondition
        {z : Fin (2 * K) → ℝ |
          InPoweredUnitImage (twoPopulationUsers K users)
            (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
            beta z} ↔
        SingleGenreProductSupCondition
          {z : Fin 2 → ℝ |
            InPoweredUnitImage users
              (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
              beta z} :=
      singleGenreProductSupCondition_inPoweredUnitImage_twoPopulationUsers_l2_iff_twoUsers
        hK husers_nonnegative hfirst_unit hsecond_unit hcross hbeta_one
        htheta_pos htheta_le_half_pi
    _ ↔ beta ≤ twoUserPhaseThreshold theta :=
      singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_iff_le_phaseThreshold
        husers_nonnegative hfirst_unit hsecond_unit hcross hbeta_one
        htheta_pos htheta_le_half_pi

/-- Positive coordinate rescaling of a two-user powered score row. -/
noncomputable def scaleFinTwoRows (a b : ℝ) :
    (Fin 2 → ℝ) →ₗ[ℝ] (Fin 2 → ℝ) where
  toFun z := fun i => if i = 0 then a * z 0 else b * z 1
  map_add' := by
    intro x y
    ext i
    fin_cases i <;> simp <;> ring
  map_smul' := by
    intro c x
    ext i
    fin_cases i <;> simp [mul_left_comm]

theorem coordinateProduct_scaleFinTwoRows
    (a b : ℝ) (z : Fin 2 → ℝ) :
    coordinateProduct (scaleFinTwoRows a b z) =
      (a * b) * coordinateProduct z := by
  simp [coordinateProduct, scaleFinTwoRows]
  ring

/-- A positive diagonal rescaling transports an attained coordinate-product
maximizer to its image. -/
theorem isCoordinateProductMaximizer_image_scaleFinTwoRows
    {S : Set (Fin 2 → ℝ)} {a b : ℝ}
    (ha : 0 < a) (hb : 0 < b)
    {x : Fin 2 → ℝ} (hmaxS : IsCoordinateProductMaximizer S x) :
    IsCoordinateProductMaximizer (scaleFinTwoRows a b '' S)
      (scaleFinTwoRows a b x) := by
  constructor
  · exact ⟨x, hmaxS.1, rfl⟩
  · rintro _ ⟨z, hz, rfl⟩
    rw [coordinateProduct_scaleFinTwoRows,
      coordinateProduct_scaleFinTwoRows]
    exact mul_le_mul_of_nonneg_left (hmaxS.2 z hz) (mul_pos ha hb).le

/-- Positive coordinate rescaling preserves equality of the coordinate-product
suprema of a two-user row set and its convex hull. -/
theorem singleGenreProductSupCondition_image_scaleFinTwoRows_iff
    {S : Set (Fin 2 → ℝ)} {a b : ℝ}
    (ha : 0 < a) (hb : 0 < b)
    {x : Fin 2 → ℝ} (hmaxS : IsCoordinateProductMaximizer S x)
    (hboundedS : BddAbove (coordinateProduct '' convexHull ℝ S))
    (hboundedScaled : BddAbove
      (coordinateProduct '' convexHull ℝ (scaleFinTwoRows a b '' S))) :
    SingleGenreProductSupCondition (scaleFinTwoRows a b '' S) ↔
      SingleGenreProductSupCondition S := by
  let L := scaleFinTwoRows a b
  have hab : 0 < a * b := mul_pos ha hb
  have hmaxScaled : IsCoordinateProductMaximizer (L '' S) (L x) := by
    constructor
    · exact ⟨x, hmaxS.1, rfl⟩
    · rintro _ ⟨z, hz, rfl⟩
      rw [coordinateProduct_scaleFinTwoRows,
        coordinateProduct_scaleFinTwoRows]
      exact mul_le_mul_of_nonneg_left (hmaxS.2 z hz) hab.le
  have htransport_to :
      ∀ (hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ S) x),
        IsCoordinateProductMaximizer (convexHull ℝ (L '' S)) (L x) := by
    intro hmaxHull
    constructor
    · rw [← L.image_convexHull S]
      exact ⟨x, hmaxHull.1, rfl⟩
    · intro z hz
      rw [← L.image_convexHull S] at hz
      rcases hz with ⟨y, hy, rfl⟩
      rw [coordinateProduct_scaleFinTwoRows,
        coordinateProduct_scaleFinTwoRows]
      exact mul_le_mul_of_nonneg_left (hmaxHull.2 y hy) hab.le
  have htransport_from :
      ∀ (hmaxHull : IsCoordinateProductMaximizer (convexHull ℝ (L '' S)) (L x)),
        IsCoordinateProductMaximizer (convexHull ℝ S) x := by
    intro hmaxHull
    constructor
    · exact subset_convexHull ℝ S hmaxS.1
    · intro y hy
      have hLy : L y ∈ convexHull ℝ (L '' S) := by
        rw [← L.image_convexHull S]
        exact ⟨y, hy, rfl⟩
      have hscaled : (a * b) * coordinateProduct y ≤
          (a * b) * coordinateProduct x := by
        simpa [L, coordinateProduct_scaleFinTwoRows] using
          hmaxHull.2 (L y) hLy
      exact le_of_mul_le_mul_left hscaled hab
  constructor
  · intro hproductScaled
    have hmaxHullScaled :
        IsCoordinateProductMaximizer (convexHull ℝ (L '' S)) (L x) := by
      apply isCoordinateProductMaximizer_convexHull_of_productSupCondition_of_bddAbove
        hproductScaled hmaxScaled
      simpa [L] using hboundedScaled
    have hmaxHullS := htransport_from hmaxHullScaled
    unfold SingleGenreProductSupCondition
    rw [coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxS,
      coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxHullS]
  · intro hproductS
    have hmaxHullS : IsCoordinateProductMaximizer (convexHull ℝ S) x :=
      isCoordinateProductMaximizer_convexHull_of_productSupCondition_of_bddAbove
        hproductS hmaxS hboundedS
    have hmaxHullScaled := htransport_to hmaxHullS
    unfold SingleGenreProductSupCondition
    rw [coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxScaled,
      coordinateProductSup_eq_of_isCoordinateProductMaximizer hmaxHullScaled]

/-- Normalizing two nonzero users scales their powered score image by a
positive coordinatewise linear map. -/
theorem poweredUnitImage_twoUsers_eq_image_scaleFinTwoRows_normalized
    {D : ℕ} {users : Fin 2 → Content D} {unitFeasible : Content D → Prop}
    {beta : ℝ}
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hfeasible_nonnegative : ∀ ⦃p : Content D⦄,
      unitFeasible p → NonnegativeContent p)
    (hfirst_norm : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 (users 0))
    (hsecond_norm : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 (users 1)) :
    {z : Fin 2 → ℝ | InPoweredUnitImage users unitFeasible beta z} =
      scaleFinTwoRows
        ((AppliedModelingLib.FiniteDimensionalNorms.l2 (users 0)) ^ beta)
        ((AppliedModelingLib.FiniteDimensionalNorms.l2 (users 1)) ^ beta) ''
        {z : Fin 2 → ℝ |
          InPoweredUnitImage (fun i => twoUserNormalizedContent (users i))
            unitFeasible beta z} := by
  let normalizedUsers : Fin 2 → Content D :=
    fun i => twoUserNormalizedContent (users i)
  let a : ℝ := (AppliedModelingLib.FiniteDimensionalNorms.l2 (users 0)) ^ beta
  let b : ℝ := (AppliedModelingLib.FiniteDimensionalNorms.l2 (users 1)) ^ beta
  let L := scaleFinTwoRows a b
  have hnorm : ∀ i, 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 (users i) := by
    intro i
    fin_cases i
    · exact hfirst_norm
    · exact hsecond_norm
  have hnormalized_nonnegative : ∀ i, NonnegativeContent (normalizedUsers i) := by
    intro i
    exact twoUserNormalizedContent_nonnegative (husers_nonnegative i)
  have hscore_scale : ∀ (i : Fin 2) (p : Content D),
      score (users i) p =
        AppliedModelingLib.FiniteDimensionalNorms.l2 (users i) *
          score (normalizedUsers i) p := by
    intro i p
    calc
      score (users i) p = score
          (scaleContent (AppliedModelingLib.FiniteDimensionalNorms.l2 (users i))
            (twoUserNormalizedContent (users i))) p :=
        congrArg (fun q => score q p)
          (scale_l2_twoUserNormalizedContent (hnorm i)).symm
      _ = AppliedModelingLib.FiniteDimensionalNorms.l2 (users i) *
          score (normalizedUsers i) p := by
        simp only [normalizedUsers, score_scaleUser]
  have hpower_scale : ∀ (i : Fin 2) (p : Content D),
      NonnegativeContent p →
      (score (users i) p) ^ beta =
        (AppliedModelingLib.FiniteDimensionalNorms.l2 (users i)) ^ beta *
          (score (normalizedUsers i) p) ^ beta := by
    intro i p hp
    rw [hscore_scale i p]
    exact Real.mul_rpow (hnorm i).le
      (score_nonneg_of_nonnegative (hnormalized_nonnegative i) hp)
  change {z : Fin 2 → ℝ | InPoweredUnitImage users unitFeasible beta z} =
    L '' {z : Fin 2 → ℝ | InPoweredUnitImage normalizedUsers unitFeasible beta z}
  ext z
  constructor
  · rintro ⟨base, ⟨p, hp, hbase⟩, hz⟩
    refine ⟨fun i => (score (normalizedUsers i) p) ^ beta, ?_, ?_⟩
    · exact ⟨fun i => score (normalizedUsers i) p, ⟨p, hp, rfl⟩, rfl⟩
    · rw [hz, hbase]
      ext i
      fin_cases i
      · simpa [L, a, b] using (hpower_scale 0 p (hfeasible_nonnegative hp)).symm
      · simpa [L, a, b] using (hpower_scale 1 p (hfeasible_nonnegative hp)).symm
  · rintro ⟨y, ⟨base, ⟨p, hp, hbase⟩, hy⟩, hzy⟩
    refine ⟨fun i => score (users i) p, ⟨p, hp, rfl⟩, ?_⟩
    rw [← hzy, hy, hbase]
    ext i
    fin_cases i
    · simpa [L, a, b] using (hpower_scale 0 p (hfeasible_nonnegative hp)).symm
    · simpa [L, a, b] using (hpower_scale 1 p (hfeasible_nonnegative hp)).symm

/-- Corrected two-user phase threshold for the actual nonnegative Euclidean
source image with arbitrary nonzero user magnitudes. -/
theorem singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_raw_iff_le_phaseThreshold
    {D : ℕ} {users : Fin 2 → Content D} {beta theta : ℝ}
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hfirst_norm : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 (users 0))
    (hsecond_norm : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 (users 1))
    (hangle : score (users 0) (users 1) /
      (AppliedModelingLib.FiniteDimensionalNorms.l2 (users 0) *
        AppliedModelingLib.FiniteDimensionalNorms.l2 (users 1)) = Real.cos theta)
    (hbeta_one : 1 ≤ beta)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) :
    SingleGenreProductSupCondition
      {z : Fin 2 → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
          beta z} ↔
      beta ≤ twoUserPhaseThreshold theta := by
  let normalizedUsers : Fin 2 → Content D :=
    fun i => twoUserNormalizedContent (users i)
  let a : ℝ := (AppliedModelingLib.FiniteDimensionalNorms.l2 (users 0)) ^ beta
  let b : ℝ := (AppliedModelingLib.FiniteDimensionalNorms.l2 (users 1)) ^ beta
  let L := scaleFinTwoRows a b
  let S : Set (Fin 2 → ℝ) :=
    {z | InPoweredUnitImage normalizedUsers
      (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1) beta z}
  let T : Set (Fin 2 → ℝ) :=
    {z | InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1) beta z}
  have hnormalized_nonnegative : ∀ i, NonnegativeContent (normalizedUsers i) := by
    intro i
    exact twoUserNormalizedContent_nonnegative (husers_nonnegative i)
  have hfirst_unit : score (normalizedUsers 0) (normalizedUsers 0) = 1 := by
    simpa [normalizedUsers] using score_twoUserNormalizedContent_self hfirst_norm
  have hsecond_unit : score (normalizedUsers 1) (normalizedUsers 1) = 1 := by
    simpa [normalizedUsers] using score_twoUserNormalizedContent_self hsecond_norm
  have hcross : score (normalizedUsers 0) (normalizedUsers 1) = Real.cos theta := by
    simpa [normalizedUsers] using
      score_twoUserNormalizedContent_pair_eq_cos hfirst_norm hsecond_norm hangle
  have hbeta_pos : 0 < beta := lt_of_lt_of_le zero_lt_one hbeta_one
  have ha : 0 < a := Real.rpow_pos_of_pos hfirst_norm beta
  have hb : 0 < b := Real.rpow_pos_of_pos hsecond_norm beta
  have hset : T = L '' S := by
    simpa [T, S, L, a, b, normalizedUsers] using
      (poweredUnitImage_twoUsers_eq_image_scaleFinTwoRows_normalized
        husers_nonnegative (fun _ hp => hp.1) hfirst_norm hsecond_norm)
  have hmaxS : IsCoordinateProductMaximizer S
      (fun _ => (Real.cos (theta / 2)) ^ beta) := by
    simpa [S] using
      (isCoordinateProductMaximizer_inPoweredUnitImage_twoUsers_l2_bisector
        hnormalized_nonnegative hfirst_unit hsecond_unit hcross hbeta_pos
        htheta_pos htheta_le_half_pi)
  have hbeta_nonnegative : 0 ≤ beta := zero_le_one.trans hbeta_one
  have hboundedS : BddAbove (coordinateProduct '' convexHull ℝ S) := by
    simpa [S] using
      (bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := SourceNorm.l2 D) hnormalized_nonnegative
        (SourceNorm.l2_compactSublevels D) hbeta_nonnegative)
  have hboundedT : BddAbove (coordinateProduct '' convexHull ℝ T) := by
    simpa [T] using
      (bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := SourceNorm.l2 D) husers_nonnegative
        (SourceNorm.l2_compactSublevels D) hbeta_nonnegative)
  calc
    SingleGenreProductSupCondition T ↔ SingleGenreProductSupCondition (L '' S) := by rw [hset]
    _ ↔ SingleGenreProductSupCondition S :=
      singleGenreProductSupCondition_image_scaleFinTwoRows_iff
        ha hb hmaxS hboundedS (by simpa [hset] using hboundedT)
    _ ↔ beta ≤ twoUserPhaseThreshold theta := by
      simpa [S] using
        (singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_iff_le_phaseThreshold
          hnormalized_nonnegative hfirst_unit hsecond_unit hcross hbeta_one
          htheta_pos htheta_le_half_pi)

/-- Corrected two-population phase threshold for the original arbitrary
nonzero user vectors. -/
theorem singleGenreProductSupCondition_inPoweredUnitImage_twoPopulationUsers_l2_raw_iff_le_phaseThreshold
    {D K : ℕ} {users : Fin 2 → Content D} {beta theta : ℝ}
    (hK : 0 < K)
    (husers_nonnegative : ∀ i, NonnegativeContent (users i))
    (hfirst_norm : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 (users 0))
    (hsecond_norm : 0 < AppliedModelingLib.FiniteDimensionalNorms.l2 (users 1))
    (hangle : score (users 0) (users 1) /
      (AppliedModelingLib.FiniteDimensionalNorms.l2 (users 0) *
        AppliedModelingLib.FiniteDimensionalNorms.l2 (users 1)) = Real.cos theta)
    (hbeta_one : 1 ≤ beta)
    (htheta_pos : 0 < theta)
    (htheta_le_half_pi : theta ≤ Real.pi / 2) :
    SingleGenreProductSupCondition
      {z : Fin (2 * K) → ℝ |
        InPoweredUnitImage (twoPopulationUsers K users)
          (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
          beta z} ↔
      beta ≤ twoUserPhaseThreshold theta := by
  let normalizedUsers : Fin 2 → Content D :=
    fun i => twoUserNormalizedContent (users i)
  let a : ℝ := (AppliedModelingLib.FiniteDimensionalNorms.l2 (users 0)) ^ beta
  let b : ℝ := (AppliedModelingLib.FiniteDimensionalNorms.l2 (users 1)) ^ beta
  let L := scaleFinTwoRows a b
  let S : Set (Fin 2 → ℝ) :=
    {z | InPoweredUnitImage normalizedUsers
      (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1) beta z}
  let T : Set (Fin 2 → ℝ) :=
    {z | InPoweredUnitImage users
      (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1) beta z}
  let R : Set (Fin (2 * K) → ℝ) :=
    {z | InPoweredUnitImage (twoPopulationUsers K users)
      (fun p => NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1) beta z}
  have hnormalized_nonnegative : ∀ i, NonnegativeContent (normalizedUsers i) := by
    intro i
    exact twoUserNormalizedContent_nonnegative (husers_nonnegative i)
  have hfirst_unit : score (normalizedUsers 0) (normalizedUsers 0) = 1 := by
    simpa [normalizedUsers] using score_twoUserNormalizedContent_self hfirst_norm
  have hsecond_unit : score (normalizedUsers 1) (normalizedUsers 1) = 1 := by
    simpa [normalizedUsers] using score_twoUserNormalizedContent_self hsecond_norm
  have hcross : score (normalizedUsers 0) (normalizedUsers 1) = Real.cos theta := by
    simpa [normalizedUsers] using
      score_twoUserNormalizedContent_pair_eq_cos hfirst_norm hsecond_norm hangle
  have hbeta_pos : 0 < beta := lt_of_lt_of_le zero_lt_one hbeta_one
  have ha : 0 < a := Real.rpow_pos_of_pos hfirst_norm beta
  have hb : 0 < b := Real.rpow_pos_of_pos hsecond_norm beta
  have hset : T = L '' S := by
    simpa [T, S, L, a, b, normalizedUsers] using
      (poweredUnitImage_twoUsers_eq_image_scaleFinTwoRows_normalized
        husers_nonnegative (fun _ hp => hp.1) hfirst_norm hsecond_norm)
  have hrep_set : R = replicateTwoPopulationRowLinear K '' T := by
    simpa [R, T] using
      (poweredUnitImage_twoPopulationUsers_eq_image_replicateTwoPopulationRowLinear
        (D := D) (K := K) (users := users)
        (unitFeasible := fun p =>
          NonnegativeContent p ∧ (SourceNorm.l2 D).norm p ≤ 1)
        (β := beta))
  have hmaxS : IsCoordinateProductMaximizer S
      (fun _ => (Real.cos (theta / 2)) ^ beta) := by
    simpa [S] using
      (isCoordinateProductMaximizer_inPoweredUnitImage_twoUsers_l2_bisector
        hnormalized_nonnegative hfirst_unit hsecond_unit hcross hbeta_pos
        htheta_pos htheta_le_half_pi)
  have hmaxT : IsCoordinateProductMaximizer T
      (L (fun _ => (Real.cos (theta / 2)) ^ beta)) := by
    rw [hset]
    exact isCoordinateProductMaximizer_image_scaleFinTwoRows ha hb hmaxS
  have hbeta_nonnegative : 0 ≤ beta := zero_le_one.trans hbeta_one
  have hnonnegativeHull : ∀ z ∈ convexHull ℝ T, ∀ i : Fin 2, 0 ≤ z i := by
    simpa [T] using
      (nonnegative_coordinate_convexHull_inPoweredUnitImage_of_nonnegative
        (ν := SourceNorm.l2 D) husers_nonnegative hbeta_nonnegative)
  have hboundedT : BddAbove (coordinateProduct '' convexHull ℝ T) := by
    simpa [T] using
      (bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := SourceNorm.l2 D) husers_nonnegative
        (SourceNorm.l2_compactSublevels D) hbeta_nonnegative)
  have hrepusers_nonnegative :
      ∀ i, NonnegativeContent (twoPopulationUsers K users i) := by
    intro i
    exact husers_nonnegative (finProdFinEquiv.symm i).1
  have hboundedR : BddAbove (coordinateProduct '' convexHull ℝ R) := by
    simpa [R] using
      (bddAbove_coordinateProduct_image_convexHull_inPoweredUnitImage_of_compactSublevels
        (ν := SourceNorm.l2 D) hrepusers_nonnegative
        (SourceNorm.l2_compactSublevels D) hbeta_nonnegative)
  calc
    SingleGenreProductSupCondition R ↔
        SingleGenreProductSupCondition (replicateTwoPopulationRowLinear K '' T) := by
      rw [hrep_set]
    _ ↔ SingleGenreProductSupCondition T :=
      singleGenreProductSupCondition_image_replicateTwoPopulationRowLinear_iff
        hK hnonnegativeHull hmaxT hboundedT (by simpa [hrep_set] using hboundedR)
    _ ↔ beta ≤ twoUserPhaseThreshold theta := by
      simpa [T] using
        singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_raw_iff_le_phaseThreshold
          husers_nonnegative hfirst_norm hsecond_norm hangle hbeta_one
          htheta_pos htheta_le_half_pi

/--
The two normalized angular powered-score coordinates used in the repaired
two-user calculation.  This is a row model for the polar cone calculation,
not an identification of that cone with every source content direction.
-/
noncomputable def twoUserAngularPoweredRow (β θstar θ : ℝ) : Fin 2 → ℝ :=
  fun i => if i = 0 then (Real.cos θ) ^ β else (Real.cos (θstar - θ)) ^ β

/-- The corrected two-user angular powered-score rows on the visible cone. -/
noncomputable def twoUserAngularPoweredRows (β θstar : ℝ) : Set (Fin 2 → ℝ) :=
  {z | ∃ θ, θ ∈ Set.Icc 0 θstar ∧ z = twoUserAngularPoweredRow β θstar θ}

/--
The corrected two-user angular powered-score rows on the complete primary
positive-score cone.  Unlike the source's visible central interval, this
includes every polar direction for which both two-user scores are
nonnegative.
-/
noncomputable def twoUserPositiveScoreConeAngularPoweredRows
    (β θstar : ℝ) : Set (Fin 2 → ℝ) :=
  {z | ∃ θ, θ ∈ Set.Icc (θstar - Real.pi / 2) (Real.pi / 2) ∧
    z = twoUserAngularPoweredRow β θstar θ}

@[simp] theorem twoUserAngularPoweredRow_zero (β θstar θ : ℝ) :
    twoUserAngularPoweredRow β θstar θ 0 = (Real.cos θ) ^ β := by
  simp [twoUserAngularPoweredRow]

@[simp] theorem twoUserAngularPoweredRow_one (β θstar θ : ℝ) :
    twoUserAngularPoweredRow β θstar θ 1 = (Real.cos (θstar - θ)) ^ β := by
  simp [twoUserAngularPoweredRow]

/--
Product-supremum bridge for the corrected two-user angular calculation.  On
the source's positive angular domain, the formally checked phase inequality
makes the bisector row maximize coordinate product both before and after
convexification.  This supplies the optimization-side bridge that the printed
Corollary `2users` proof leaves implicit; connecting this angular row model to
the full source content image still requires a separate cone-parametrization
theorem.
-/
theorem singleGenreProductSupCondition_twoUserAngularPoweredRows_of_source_phase
    {β θstar : ℝ}
    (hβ_one : 1 ≤ β)
    (hphase : β * (1 - Real.cos θstar) ≤ 2)
    (hθstar_pos : 0 < θstar)
    (hθstar_le_half_pi : θstar ≤ Real.pi / 2) :
    SingleGenreProductSupCondition (twoUserAngularPoweredRows β θstar) := by
  let b : ℝ := (Real.cos (θstar / 2)) ^ β
  apply singleGenreProductSupCondition_finTwo_of_diagonal_mem_of_nonnegative_of_sum_le
    (S := twoUserAngularPoweredRows β θstar) (b := b)
  · refine ⟨θstar / 2, ?_, ?_⟩
    · constructor <;> linarith
    · funext i
      fin_cases i
      · simp [b, twoUserAngularPoweredRow]
      · have hhalf : θstar - θstar / 2 = θstar / 2 := by ring
        simp [b, twoUserAngularPoweredRow, hhalf]
  · intro z hz i
    rcases hz with ⟨θ, hθ, rfl⟩
    have hθ_nonnegative : 0 ≤ θ := hθ.1
    have hθ_le : θ ≤ θstar := hθ.2
    have hcos : 0 ≤ Real.cos θ := by
      apply Real.cos_nonneg_of_mem_Icc
      constructor <;> linarith
    have hcos_other : 0 ≤ Real.cos (θstar - θ) := by
      apply Real.cos_nonneg_of_mem_Icc
      constructor <;> linarith
    fin_cases i
    · simp [twoUserAngularPoweredRow, Real.rpow_nonneg hcos]
    · simp [twoUserAngularPoweredRow, Real.rpow_nonneg hcos_other]
  · intro z hz
    rcases hz with ⟨θ, hθ, rfl⟩
    have hhalf : θstar - θstar / 2 = θstar / 2 := by ring
    simpa [twoUserAngularPoweredRow, twoUserCosPowerSum, b, hhalf, two_mul] using
      twoUserCosPowerSum_le_bisector_of_source_phase hβ_one hphase
        hθstar_pos hθstar_le_half_pi hθ.1 hθ.2

/--
The product-supremum bridge on the whole primary positive-score cone.  The
extension is needed for score pairs obtained by projecting an original content
vector: positivity of both scores does not generally force its polar angle
into the source's smaller interval `[0, theta_star]`.
-/
theorem singleGenreProductSupCondition_twoUserPositiveScoreConeAngularPoweredRows_of_source_phase
    {β θstar : ℝ}
    (hβ_one : 1 ≤ β)
    (hphase : β * (1 - Real.cos θstar) ≤ 2)
    (hθstar_pos : 0 < θstar)
    (hθstar_le_half_pi : θstar ≤ Real.pi / 2) :
    SingleGenreProductSupCondition
      (twoUserPositiveScoreConeAngularPoweredRows β θstar) := by
  let b : ℝ := (Real.cos (θstar / 2)) ^ β
  apply singleGenreProductSupCondition_finTwo_of_diagonal_mem_of_nonnegative_of_sum_le
    (S := twoUserPositiveScoreConeAngularPoweredRows β θstar) (b := b)
  · refine ⟨θstar / 2, ?_, ?_⟩
    · constructor <;> linarith [Real.pi_pos]
    · funext i
      fin_cases i
      · simp [b, twoUserAngularPoweredRow]
      · have hhalf : θstar - θstar / 2 = θstar / 2 := by ring
        simp [b, twoUserAngularPoweredRow, hhalf]
  · intro z hz i
    rcases hz with ⟨θ, hθ, rfl⟩
    have hθ_lower : -(Real.pi / 2) ≤ θ := by
      calc
        -(Real.pi / 2) ≤ θstar - Real.pi / 2 := by linarith
        _ ≤ θ := hθ.1
    have hθ_upper : θ ≤ Real.pi / 2 := hθ.2
    have hcos : 0 ≤ Real.cos θ :=
      Real.cos_nonneg_of_mem_Icc ⟨hθ_lower, hθ_upper⟩
    have hother_lower : -(Real.pi / 2) ≤ θstar - θ := by linarith
    have hother_upper : θstar - θ ≤ Real.pi / 2 := by linarith [hθ.1]
    have hcos_other : 0 ≤ Real.cos (θstar - θ) :=
      Real.cos_nonneg_of_mem_Icc ⟨hother_lower, hother_upper⟩
    fin_cases i
    · simp [twoUserAngularPoweredRow, Real.rpow_nonneg hcos]
    · simp [twoUserAngularPoweredRow, Real.rpow_nonneg hcos_other]
  · intro z hz
    rcases hz with ⟨θ, hθ, rfl⟩
    have hhalf : θstar - θstar / 2 = θstar / 2 := by ring
    simpa [twoUserAngularPoweredRow, twoUserCosPowerSum, b, hhalf, two_mul] using
      twoUserCosPowerSum_le_bisector_of_source_phase_of_angle_mem_positiveScoreCone
        hβ_one hphase hθstar_pos hθstar_le_half_pi hθ.1 hθ.2

/-- In the orthogonal two-user geometry and above the phase exponent, the first
finite-genre FOC label is strictly increasing between any two admissible
angles.  This supplies the endpoint case of the source's root-count argument,
where the acute-angle cardinality lemma is unavailable because `cos θ = 0`. -/
theorem finiteGenreFirstAngleLabel_ne_of_lt_orthogonal
    {beta a b : ℝ} (hbeta : 2 < beta)
    (ha : 0 < a) (hab : a < b) (hb : b < Real.pi / 2) :
    finiteGenreFirstAngleLabel beta (Real.pi / 2) a ≠
      finiteGenreFirstAngleLabel beta (Real.pi / 2) b := by
  have hbeta_pos : 0 < beta := by linarith
  have hstrict : StrictMonoOn
      (finiteGenreFirstAngleLabel beta (Real.pi / 2)) (Set.Icc a b) := by
    apply finiteGenreFirstAngleLabel_strictMonoOn_of_signBracket_pos hbeta_pos
    · intro x hx
      rcases hx with ⟨hax, hxb⟩
      exact Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith⟩
    · intro x hx
      rcases hx with ⟨hax, hxb⟩
      unfold twoUserSecondDerivSignBracket
      rw [Real.cos_pi_div_two, sub_zero, Real.cos_pi_div_two_sub]
      exact mul_pos (div_pos (by linarith) hbeta_pos)
        (Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith))
  exact ne_of_lt (hstrict ⟨le_rfl, hab.le⟩ ⟨hab.le, le_rfl⟩ hab)

/-- The singleton branch of Proposition `finitegenre`.  A one-ray Nash law
would imply the source's product-sup condition on powered unit-score vectors,
whereas the strict above-phase inequality rules that condition out.  The proof
covers both acute and orthogonal user angles. -/
theorem no_singletonGenre_normRpowCostNash_abovePhase
    {P : ℕ} [Nonempty (Fin P)] {beta theta : ℝ}
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    (hP : 1 < P) (htheta_pos : 0 < theta)
    (htheta_le : theta ≤ Real.pi / 2)
    (hbeta : 0 < beta) (hbeta_one : 1 ≤ beta)
    (hphase_mul : 2 < beta * (1 - Real.cos theta))
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (normRpowCost (SourceNorm.l2 2) beta) mu)
    {genre : Content 2}
    (hgenres : SourceNonzeroSupportGenres (SourceNorm.l2 2) mu ⊆
      ({genre} : Set (Content 2))) :
    False := by
  let users : Fin 2 → Content 2 :=
    fun i => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta
  have htheta_lt_pi : theta < Real.pi := by linarith [Real.pi_pos]
  have hsin : 0 < Real.sin theta :=
    Real.sin_pos_of_pos_of_lt_pi htheta_pos htheta_lt_pi
  have hcos_nonneg : 0 ≤ Real.cos theta :=
    Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], htheta_le⟩
  have husers_nonnegative : ∀ i, NonnegativeContent (users i) := by
    intro i d
    fin_cases i <;> fin_cases d <;>
      simp [users, canonicalTwoUserFirst, canonicalTwoUserSecond, content2,
        hcos_nonneg, hsin.le]
  have husers_nonzero : ∀ i, NonzeroContent (users i) := by
    intro i
    fin_cases i
    · exact ⟨0, by simp [users, canonicalTwoUserFirst, content2]⟩
    · exact ⟨1, by
        simp [users, canonicalTwoUserSecond, content2, hsin.ne']⟩
  letI : Nontrivial (Fin P) := Fin.nontrivial_iff_two_le.mpr (by omega)
  have hproduct : SingleGenreProductSupCondition
      {z : Fin 2 → ℝ |
        InPoweredUnitImage users
          (fun p => NonnegativeContent p ∧ (SourceNorm.l2 2).norm p ≤ 1)
          beta z} := by
    simpa [users] using
      (sourceSymmetricMixedNash_productSupCondition_of_compactSublevels_of_singleton_nonzeroSupportGenres_of_nonzero_users
        (j := Classical.choice (inferInstance : Nonempty (Fin P))) hnash hgenres
        husers_nonnegative husers_nonzero SourceNorm.l2_perturbationContinuous
        hbeta (SourceNorm.l2_compactSublevels 2) (SourceNorm.l2_continuous 2))
  have hfirst_unit : score (users 0) (users 0) = 1 := by
    simp [users, canonicalTwoUserFirst, score_content2]
  have hsecond_unit : score (users 1) (users 1) = 1 := by
    simp [users, canonicalTwoUserSecond, score_content2]
    nlinarith [Real.cos_sq_add_sin_sq theta]
  have hcross : score (users 0) (users 1) = Real.cos theta := by
    simp [users, canonicalTwoUserFirst, canonicalTwoUserSecond, score_content2]
  exact (not_singleGenreProductSupCondition_inPoweredUnitImage_twoUsers_l2_of_phase_lt
    (users := users) (beta := beta) (theta := theta)
    husers_nonnegative hfirst_unit hsecond_unit hcross hbeta_one
    hphase_mul htheta_pos htheta_le) hproduct

/-- Positive homogeneous cost multipliers can be removed by a common content
rescaling.  The game preserves all ordinal winning events, while
`a ^ beta = alpha` sends the multiplied norm-power cost back to unit scale. -/
theorem no_singletonGenre_scaledNormRpowCostNash_abovePhase
    {P : ℕ} [Nonempty (Fin P)] {alpha beta theta : ℝ}
    {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    (hP : 1 < P) (htheta_pos : 0 < theta)
    (htheta_le : theta ≤ Real.pi / 2)
    (halpha : 0 < alpha) (hbeta : 0 < beta) (hbeta_one : 1 ≤ beta)
    (hphase_mul : 2 < beta * (1 - Real.cos theta))
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu)
    {genre : Content 2}
    (hgenres : SourceNonzeroSupportGenres (SourceNorm.l2 2) mu ⊆
      ({genre} : Set (Content 2))) :
    False := by
  let a : ℝ := alpha ^ beta⁻¹
  have ha : 0 < a := Real.rpow_pos_of_pos halpha _
  have hscale_cost : a ^ beta = alpha := by
    dsimp [a]
    exact Real.rpow_inv_rpow halpha.le hbeta.ne'
  let nu : MixedContentStrategy 2 := Measure.map (scaleContent a) mu
  letI : IsProbabilityMeasure nu :=
    Measure.isProbabilityMeasure_map (measurable_scaleContent a).aemeasurable
  have hnash_unit : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (normRpowCost (SourceNorm.l2 2) beta) nu := by
    simpa [nu] using
      sourceSymmetricMixedNash_scaleContent_map_of_rpow_eq ha hscale_cost hnash
  have hgenres_unit : SourceNonzeroSupportGenres (SourceNorm.l2 2) nu ⊆
      ({genre} : Set (Content 2)) := by
    rw [show nu = Measure.map (scaleContent a) mu by rfl,
      sourceNonzeroSupportGenres_scaleContent_map (SourceNorm.l2 2) ha]
    exact hgenres
  exact no_singletonGenre_normRpowCostNash_abovePhase
    hP htheta_pos htheta_le hbeta hbeta_one hphase_mul hnash_unit hgenres_unit

/-- Proposition `finitegenre` in the canonical two-user model.  Above the
source phase threshold, no Nash law satisfying the finite conditional radial
decomposition can have finitely many distinct nonzero support genres.

The proof derives the two score-support intervals and common FOC labels from
the Nash condition, treats the orthogonal endpoint separately, reduces the
acute case to at most two genres, and closes the singleton and both ordered
two-genre branches by their respective analytic contradictions. -/
theorem no_finiteGenreConditionalNormLaw_of_scaledNormRpowCostNash_abovePhase
    {P G : ℕ} [Nonempty (Fin P)] [Nonempty (Fin G)]
    {alpha beta theta : ℝ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    (angle : Fin G → ℝ) (law : FiniteGenreConditionalNormLaw mu angle)
    (hangle_injective : Function.Injective angle)
    (hP : 1 < P) (htheta_pos : 0 < theta)
    (htheta_le : theta ≤ Real.pi / 2)
    (halpha : 0 < alpha)
    (hphase : twoUserPhaseThreshold theta < beta)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map
        (fun q : Content 2 =>
          score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta) q) mu ≪
        volume)
    (hcdf1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support → z ≠ (0, 0) →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu)) z.1)
    (hcdf2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support → z ≠ (0, 0) →
      ContDiffAt ℝ 2
        (AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu)) z.2)
    (hangle_pos : ∀ i, 0 < angle i)
    (hangle_lt : ∀ i, angle i < theta)
    (hgenres : SourceNonzeroSupportGenres (SourceNorm.l2 2) mu =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i)))) :
    False := by
  have htheta_lt_pi : theta < Real.pi := by linarith [Real.pi_pos]
  have hsin : 0 < Real.sin theta :=
    Real.sin_pos_of_pos_of_lt_pi htheta_pos htheta_lt_pi
  have hcos_nonneg : 0 ≤ Real.cos theta :=
    Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], htheta_le⟩
  have hinterior : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support → z ≠ (0, 0) →
        0 < z.1 ∧ z.1 * Real.cos theta < z.2 :=
    canonicalTwoUser_valueSupport_strictInterior_of_nonzeroSupportGenres_eq_angleRange
      (ν := SourceNorm.l2 2) angle htheta_pos htheta_le hangle_pos hangle_lt hgenres
  have hsin_half : 0 < Real.sin (theta / 2) :=
    Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith [Real.pi_pos])
  have htrig : 1 - Real.cos theta = 2 * (Real.sin (theta / 2)) ^ 2 := by
    rw [Real.sin_sq_eq_half_sub]
    have hdouble : 2 * (theta / 2) = theta := by ring
    rw [hdouble]
    ring
  have hden : 0 < 1 - Real.cos theta := by rw [htrig]; positivity
  have hphase_mul : 2 < beta * (1 - Real.cos theta) := by
    by_contra hnot
    have hle : beta * (1 - Real.cos theta) ≤ 2 := le_of_not_gt hnot
    have hbeta_le : beta ≤ twoUserPhaseThreshold theta :=
      (twoUser_phase_inequality_iff_le_phaseThreshold hden).1 hle
    exact (not_lt_of_ge hbeta_le) hphase
  have hbeta_pos : 0 < beta := by
    rcases (mul_pos_iff.mp (lt_trans zero_lt_two hphase_mul)) with h | h
    · exact h.1
    · linarith
  have hden_le_one : 1 - Real.cos theta ≤ 1 := by linarith
  have hbeta_two : 2 < beta :=
    hphase_mul.trans_le (by
      simpa using mul_le_mul_of_nonneg_left hden_le_one hbeta_pos.le)
  have hcos_first : ∀ i, 0 < Real.cos (angle i) := by
    intro i
    exact Real.cos_pos_of_mem_Ioo
      ⟨by linarith [Real.pi_pos, hangle_pos i], by linarith [hangle_lt i, htheta_le]⟩
  have hcos_second : ∀ i, 0 < Real.cos (theta - angle i) := by
    intro i
    exact Real.cos_pos_of_mem_Ioo
      ⟨by linarith [Real.pi_pos, hangle_lt i], by linarith [hangle_pos i, htheta_le]⟩
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content canonicalTwoUserFirst).aemeasurable
  letI : IsProbabilityMeasure
      (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) :=
    Measure.isProbabilityMeasure_map
      (measurable_score_content (canonicalTwoUserSecond theta)).aemeasurable
  have hderiv1 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) mu) x) z.1) z.1 := by
    intro z hz hne
    exact ((AppliedModelingLib.Probability.iidMaximumCdf_contDiffAt_of_lowerCDFMass
      (n := P - 1) (hcdf1 z hz hne)).differentiableAt
        (by norm_num)).hasDerivAt
  have hderiv2 : ∀ z : ℝ × ℝ,
      z ∈ (Measure.map (canonicalTwoUserValueMap theta) mu).support → z ≠ (0, 0) →
      HasDerivAt
        (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x)
        (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
          (Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond theta) q) mu) x) z.2) z.2 := by
    intro z hz hne
    exact ((AppliedModelingLib.Probability.iidMaximumCdf_contDiffAt_of_lowerCDFMass
      (n := P - 1) (hcdf2 z hz hne)).differentiableAt
        (by norm_num)).hasDerivAt
  have hnash_scaled : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond theta)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu := hnash
  obtain ⟨B1, B2, epsilon1, epsilon2, hB1, hB2, hepsilon1, hepsilon2,
      hfirst_support, hsecond_support, hlabels⟩ :=
    finiteGenre_exists_scoreIntervals_and_angleLabel_eq_of_finiteGenres
      (ν := SourceNorm.l2 2) angle halpha hbeta_pos hsin hcos_nonneg
      htheta_lt_pi hnash_scaled hscore_ac hinterior hderiv1 hderiv2
      hangle_pos hangle_lt hcos_first hcos_second hgenres
  have singleton_contradiction (hcard_one : Fintype.card (Fin G) ≤ 1) : False := by
    let i0 : Fin G := Classical.choice (inferInstance : Nonempty (Fin G))
    letI : Subsingleton (Fin G) :=
      Fintype.card_le_one_iff_subsingleton.mp hcard_one
    have hgenres_single : SourceNonzeroSupportGenres (SourceNorm.l2 2) mu ⊆
        ({content2 (Real.cos (angle i0)) (Real.sin (angle i0))} : Set (Content 2)) := by
      rw [hgenres]
      rintro g ⟨i, rfl⟩
      simp only [Set.mem_singleton_iff]
      rw [Subsingleton.elim i i0]
    exact no_singletonGenre_scaledNormRpowCostNash_abovePhase
      hP htheta_pos htheta_le halpha hbeta_pos (by linarith) hphase_mul
        hnash hgenres_single
  by_cases horth : theta = Real.pi / 2
  · have hcard_one : Fintype.card (Fin G) ≤ 1 := by
      apply Fintype.card_le_one_iff_subsingleton.mpr
      constructor
      intro i j
      apply hangle_injective
      by_contra hne
      rcases lt_or_gt_of_ne hne with hij | hji
      · exact (finiteGenreFirstAngleLabel_ne_of_lt_orthogonal
          hbeta_two (hangle_pos i) hij (by simpa [horth] using hangle_lt j))
          (by simpa [horth] using (hlabels i j).1)
      · exact (finiteGenreFirstAngleLabel_ne_of_lt_orthogonal
          hbeta_two (hangle_pos j) hji (by simpa [horth] using hangle_lt i))
          (by simpa [horth] using (hlabels j i).1)
    exact singleton_contradiction hcard_one
  · have hcosstar : 0 < Real.cos theta :=
      Real.cos_pos_of_mem_Ioo
        ⟨by linarith [Real.pi_pos], lt_of_le_of_ne htheta_le horth⟩
    have hcard_two : Fintype.card (Fin G) ≤ 2 :=
      finiteGenre_card_le_two_of_common_angleLabels_of_phaseThreshold_lt_beta
        angle hangle_injective htheta_pos htheta_lt_pi htheta_le hden hcosstar
        hphase hangle_pos hangle_lt hlabels
    by_cases hcard_one : Fintype.card (Fin G) ≤ 1
    · exact singleton_contradiction hcard_one
    · have hG : G = 2 := by
        simp only [Fintype.card_fin] at hcard_two hcard_one
        omega
      subst G
      have hangle_ne : angle (0 : Fin 2) ≠ angle (1 : Fin 2) := by
        intro h
        have : (0 : Fin 2) = 1 := hangle_injective h
        norm_num at this
      rcases lt_or_gt_of_ne hangle_ne with h01 | h10
      · have hstraddle :=
          finiteGenre_common_angleLabels_straddle_bisector_of_phaseThreshold_lt_beta
            htheta_pos htheta_lt_pi htheta_le hden hcosstar hphase
            (hangle_pos 0) h01 (hangle_lt 1) (hlabels 0 1).1 (hlabels 0 1).2
        have hgenres_two : SourceNonzeroSupportGenres (SourceNorm.l2 2) mu =
            Set.range (fun i : Fin 2 =>
              if i = 0 then content2 (Real.cos (angle 0)) (Real.sin (angle 0))
              else content2 (Real.cos (angle 1)) (Real.sin (angle 1))) := by
          rw [hgenres]
          congr 1
          funext i
          fin_cases i <;> simp
        exact no_twoGenreConditionalNormLaw_of_scaledNormRpowCostNash
          law.toTwoGenre hP halpha hbeta_pos (hangle_pos 0) hstraddle.1
          hstraddle.2 (hangle_lt 1) htheta_le hnash_scaled hscore_ac
          hinterior hderiv1 hderiv2 hgenres_two
      · have hstraddle :=
          finiteGenre_common_angleLabels_straddle_bisector_of_phaseThreshold_lt_beta
            htheta_pos htheta_lt_pi htheta_le hden hcosstar hphase
            (hangle_pos 1) h10 (hangle_lt 0) (hlabels 1 0).1 (hlabels 1 0).2
        have hgenres_two : SourceNonzeroSupportGenres (SourceNorm.l2 2) mu =
            Set.range (fun i : Fin 2 =>
              if i = 0 then content2 (Real.cos (angle 1)) (Real.sin (angle 1))
              else content2 (Real.cos (angle 0)) (Real.sin (angle 0))) := by
          rw [hgenres]
          ext g
          constructor
          · rintro ⟨i, rfl⟩
            fin_cases i
            · exact ⟨1, by simp⟩
            · exact ⟨0, by simp⟩
          · rintro ⟨i, rfl⟩
            fin_cases i
            · exact ⟨1, by simp⟩
            · exact ⟨0, by simp⟩
        exact no_twoGenreConditionalNormLaw_of_scaledNormRpowCostNash
          law.toTwoGenre.swap hP halpha hbeta_pos (hangle_pos 1) hstraddle.1
          hstraddle.2 (hangle_lt 0) htheta_le hnash_scaled hscore_ac
          hinterior hderiv1 hderiv2 hgenres_two

