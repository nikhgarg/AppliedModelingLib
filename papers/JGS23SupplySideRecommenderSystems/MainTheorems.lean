/--
Finite-cardinality consequence needed at the unsupported Step 1 of
`finitegenre`: if an injective angle indexing is contained in two designated
angle values, then there are at most two genres.
-/
theorem finiteGenre_card_le_two_of_injective_angle_of_forall_eq_or_eq
    {ι : Type*} [Fintype ι] {angle : ι → ℝ}
    (hinjective : Function.Injective angle) (i0 i1 : ι)
    (hangle : ∀ i, angle i = angle i0 ∨ angle i = angle i1) :
    Fintype.card ι ≤ 2 := by
  classical
  have huniv : (Finset.univ : Finset ι) ⊆ {i0, i1} := by
    intro i _
    rcases hangle i with hi | hi
    · exact Finset.mem_insert.mpr (Or.inl (hinjective hi))
    · exact Finset.mem_insert.mpr
        (Or.inr (Finset.mem_singleton.mpr (hinjective hi)))
  calc
    Fintype.card ι = (Finset.univ : Finset ι).card := rfl
    _ ≤ ({i0, i1} : Finset ι).card := Finset.card_le_card huniv
    _ ≤ 2 := Finset.card_le_two

/--
Conditional formal replacement for the source's unsupported invocation of
`secondderiv` and `regionscolor`.  Once an analytic classification says that
every simultaneous fiber of the two angle labels consists of two designated
angle values, the already propagated common label equations imply at most two
distinct finite genres.
-/
theorem finiteGenre_card_le_two_of_common_label_pair_fiber
    {ι : Type*} [Fintype ι] {β θstar : ℝ} (angle : ι → ℝ)
    (hinjective : Function.Injective angle) (i0 i1 : ι)
    (hfirst : ∀ i,
      finiteGenreFirstAngleLabel β θstar (angle i) =
        finiteGenreFirstAngleLabel β θstar (angle i0))
    (hsecond : ∀ i,
      finiteGenreSecondAngleLabel β θstar (angle i) =
        finiteGenreSecondAngleLabel β θstar (angle i0))
    (hfiber : ∀ θ,
      finiteGenreFirstAngleLabel β θstar θ =
          finiteGenreFirstAngleLabel β θstar (angle i0) →
        finiteGenreSecondAngleLabel β θstar θ =
          finiteGenreSecondAngleLabel β θstar (angle i0) →
        θ = angle i0 ∨ θ = angle i1) :
    Fintype.card ι ≤ 2 := by
  apply finiteGenre_card_le_two_of_injective_angle_of_forall_eq_or_eq
    hinjective i0 i1
  intro i
  exact hfiber (angle i) (hfirst i) (hsecond i)

/--
The measure-theoretic content of the source's phrase “the conditional
distribution of the norm along each genre is continuously differentiable” in
the two-genre case.  Each positive genre mass is separated from its
probability-normalized radial law, the two masses sum to one, and pushing the
radial laws along the two rays reconstructs the content strategy.  The `C¹`
fields are exactly the printed regularity assumption on the two conditional
radial CDFs.
-/
structure TwoGenreConditionalNormLaw
    (mu : MixedContentStrategy 2) (theta1 theta2 : ℝ) where
  weight1 : ℝ
  weight2 : ℝ
  radial1 : Measure ℝ
  radial2 : Measure ℝ
  weight1_pos : 0 < weight1
  weight2_pos : 0 < weight2
  weights_sum : weight1 + weight2 = 1
  radial1_probability : IsProbabilityMeasure radial1
  radial2_probability : IsProbabilityMeasure radial2
  radial1_support_nonnegative : radial1.support ⊆ Set.Ici 0
  radial2_support_nonnegative : radial2.support ⊆ Set.Ici 0
  radial1_has_positive_support : ∃ r ∈ radial1.support, 0 < r
  radial2_has_positive_support : ∃ r ∈ radial2.support, 0 < r
  radial1_cdf_c1 : ContDiff ℝ 1 (AppliedModelingLib.Probability.lowerCDFMass radial1)
  radial2_cdf_c1 : ContDiff ℝ 1 (AppliedModelingLib.Probability.lowerCDFMass radial2)
  decomposition : mu =
    ENNReal.ofReal weight1 •
        Measure.map
          (fun r : ℝ => scaleContent r
            (content2 (Real.cos theta1) (Real.sin theta1)))
          radial1 +
      ENNReal.ofReal weight2 •
        Measure.map
          (fun r : ℝ => scaleContent r
            (content2 (Real.cos theta2) (Real.sin theta2)))
          radial2

/--
The literal finite-family form of the source assumption that, conditional on
each realized genre, the content norm has a continuously differentiable CDF.
Every genre has positive mass and a probability-normalized radial law; the
finite weighted ray mixture reconstructs the content strategy itself.
-/
structure FiniteGenreConditionalNormLawAnyDim
    {D G : ℕ} (mu : MixedContentStrategy D) (direction : Fin G → Content D) where
  weight : Fin G → ℝ
  radial : Fin G → Measure ℝ
  direction_nonnegative : ∀ i, NonnegativeContent (direction i)
  direction_l2_norm : ∀ i, AppliedModelingLib.FiniteDimensionalNorms.l2 (direction i) = 1
  weight_pos : ∀ i, 0 < weight i
  weights_sum : ∑ i, weight i = 1
  radial_probability : ∀ i, IsProbabilityMeasure (radial i)
  radial_support_nonnegative : ∀ i, (radial i).support ⊆ Set.Ici 0
  radial_has_positive_support : ∀ i, ∃ r ∈ (radial i).support, 0 < r
  radial_cdf_c1 : ∀ i,
    ContDiff ℝ 1 (AppliedModelingLib.Probability.lowerCDFMass (radial i))
  decomposition : mu = ∑ i,
    ENNReal.ofReal (weight i) •
      Measure.map (fun r : ℝ => scaleContent r (direction i)) (radial i)

/-- Every represented radial support point is an actual content support point
of the arbitrary-dimensional finite ray mixture. -/
theorem FiniteGenreConditionalNormLawAnyDim.ray_mem_contentSupport
    {D G : ℕ} {mu : MixedContentStrategy D} [IsProbabilityMeasure mu]
    {direction : Fin G → Content D}
    (law : FiniteGenreConditionalNormLawAnyDim mu direction)
    {i : Fin G} {r : ℝ} (hr : r ∈ (law.radial i).support) :
    scaleContent r (direction i) ∈ mu.support := by
  let ray : ℝ → Content D := fun t => scaleContent t (direction i)
  let component : Measure (Content D) :=
    ENNReal.ofReal (law.weight i) • Measure.map ray (law.radial i)
  have hcomponent_le : component ≤ mu := by
    rw [law.decomposition]
    dsimp only [component, ray]
    exact Finset.single_le_sum (fun j _ => Measure.zero_le _) (Finset.mem_univ i)
  have hcomponent_support : component.support ⊆ mu.support :=
    (Measure.absolutelyContinuous_of_le hcomponent_le).support_mono
  have hmap_support : (Measure.map ray (law.radial i)).support ⊆ mu.support := by
    have hac : Measure.map ray (law.radial i) ≪ component := by
      dsimp only [component]
      exact Measure.absolutelyContinuous_smul
        (ENNReal.ofReal_pos.mpr (law.weight_pos i)).ne'
    exact hac.support_mono.trans hcomponent_support
  have hray_cont : Continuous ray := by
    apply continuous_pi
    intro d
    exact continuous_id.mul continuous_const
  exact hmap_support
    (AppliedModelingLib.Probability.mem_support_map_of_continuous hray_cont hr)

/--
Every listed unit genre direction of an arbitrary-dimensional finite radial
Nash law has the canonical two-user score form for an angle between the two
original user rays.  The angle is derived from support C1 and the exact
support-cost identity; it is not supplied as an additional chart premise.
-/
theorem FiniteGenreConditionalNormLawAnyDim.exists_twoUser_polar_angle
    {D G P : ℕ} [Nonempty (Fin G)] [Nonempty (Fin P)]
    {mu : MixedContentStrategy D} [IsProbabilityMeasure mu]
    {direction : Fin G → Content D} {u v : Content D} {α β θ : ℝ}
    (law : FiniteGenreConditionalNormLawAnyDim mu direction)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β)
    (hθ_pos : 0 < θ) (hθ_le : θ ≤ Real.pi / 2)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 D) β q) mu)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) mu ≪ volume) :
    ∃ angle : Fin G → ℝ, ∀ i,
      angle i ∈ Set.Icc 0 θ ∧
      score u (direction i) = Real.cos (angle i) ∧
      score v (direction i) = Real.cos (θ - angle i) := by
  classical
  have hθ_lt_pi : θ < Real.pi := by linarith [Real.pi_pos]
  have hsin : 0 < Real.sin θ :=
    Real.sin_pos_of_pos_of_lt_pi hθ_pos hθ_lt_pi
  have hexists : ∀ i : Fin G, ∃ φ : ℝ,
      φ ∈ Set.Icc 0 θ ∧
      score u (direction i) = Real.cos φ ∧
      score v (direction i) = Real.cos (θ - φ) := by
    intro i
    obtain ⟨r, hr_support, hr_pos⟩ := law.radial_has_positive_support i
    have hp_support : scaleContent r (direction i) ∈ mu.support :=
      law.ray_mem_contentSupport hr_support
    have hcone_scaled :=
      twoUserScore_closedUserCone_of_scaledNormRpowCostNash_any_dim
        hu hv huv hu_nonnegative hv_nonnegative hα hβ hnash hscore_ac hp_support
    simp only [score_scaleContent] at hcone_scaled
    have hcone : Real.cos θ * score v (direction i) ≤ score u (direction i) ∧
        Real.cos θ * score u (direction i) ≤ score v (direction i) := by
      constructor <;> nlinarith
    have hdir_self : score (direction i) (direction i) = 1 := by
      rw [score_self_eq_l2_sq, law.direction_l2_norm]
      norm_num
    have hp_self :
        score (scaleContent r (direction i)) (scaleContent r (direction i)) = r ^ 2 := by
      simp [score_scaleContent, score_scaleUser, hdir_self]
      ring
    have hquadratic_scaled :=
      twoUserInducedCostQuadratic_eq_score_self_of_scaledNormRpowCostNash_support_any_dim
        hu hv huv hu_nonnegative hv_nonnegative hα hβ hsin.ne' hnash hscore_ac hp_support
    rw [score_scaleContent, score_scaleContent,
      twoUserInducedCostQuadratic_scale_pair, hp_self] at hquadratic_scaled
    have hquadratic : twoUserInducedCostQuadratic θ
        (score u (direction i)) (score v (direction i)) = 1 := by
      have hr_sq_pos : 0 < r ^ 2 := sq_pos_of_ne_zero hr_pos.ne'
      nlinarith
    have hscore_u_nonnegative : 0 ≤ score u (direction i) :=
      score_nonneg_of_nonnegative hu_nonnegative (law.direction_nonnegative i)
    have hscore_v_nonnegative : 0 ≤ score v (direction i) :=
      score_nonneg_of_nonnegative hv_nonnegative (law.direction_nonnegative i)
    obtain ⟨ρ, φ, hρ, hφ_chart, hscore_u, hscore_v⟩ :=
      exists_twoUser_polar_of_nonnegative_pair_of_inducedCostQuadratic_le_one
        hθ_pos.le hθ_le hsin.ne' hscore_u_nonnegative hscore_v_nonnegative
        hquadratic.le
    have hρ_sq : ρ ^ 2 = 1 := by
      calc
        ρ ^ 2 = twoUserInducedCostQuadratic θ
            (ρ * Real.cos φ) (ρ * Real.cos (θ - φ)) :=
          (twoUserInducedCostQuadratic_cos_pair_scale_eq_sq hsin).symm
        _ = twoUserInducedCostQuadratic θ
            (score u (direction i)) (score v (direction i)) := by
          rw [hscore_u, hscore_v]
        _ = 1 := hquadratic
    have hρ_eq : ρ = 1 := by nlinarith [hρ.1]
    have hscore_u_angle : score u (direction i) = Real.cos φ := by
      simpa [hρ_eq] using hscore_u
    have hscore_v_angle : score v (direction i) = Real.cos (θ - φ) := by
      simpa [hρ_eq] using hscore_v
    rw [hscore_u_angle, hscore_v_angle] at hcone
    have hsin_φ_nonnegative : 0 ≤ Real.sin φ := by
      have hidentity : Real.cos (θ - φ) - Real.cos θ * Real.cos φ =
          Real.sin θ * Real.sin φ := by
        rw [Real.cos_sub]
        ring
      nlinarith [hcone.2, hidentity]
    have hsin_θ_sub_φ_nonnegative : 0 ≤ Real.sin (θ - φ) := by
      have hidentity : Real.cos φ - Real.cos θ * Real.cos (θ - φ) =
          Real.sin θ * Real.sin (θ - φ) := by
        rw [Real.cos_sub, Real.sin_sub]
        nlinarith [Real.sin_sq_add_cos_sq θ]
      nlinarith [hcone.1, hidentity]
    have hφ_nonnegative : 0 ≤ φ := by
      by_contra hnot
      have hφ_neg : φ < 0 := lt_of_not_ge hnot
      have hneg_pi_lt : -Real.pi < φ := by
        linarith [hφ_chart.1, Real.pi_pos]
      have := Real.sin_neg_of_neg_of_neg_pi_lt hφ_neg hneg_pi_lt
      linarith
    have hφ_le : φ ≤ θ := by
      by_contra hnot
      have hdelta_neg : θ - φ < 0 := sub_neg.mpr (lt_of_not_ge hnot)
      have hneg_pi_lt : -Real.pi < θ - φ := by
        linarith [hφ_chart.2, hθ_pos.le, Real.pi_pos]
      have := Real.sin_neg_of_neg_of_neg_pi_lt hdelta_neg hneg_pi_lt
      linarith
    exact ⟨φ, ⟨hφ_nonnegative, hφ_le⟩, hscore_u_angle, hscore_v_angle⟩
  choose angle hangle using hexists
  exact ⟨angle, hangle⟩

/-- The two scores uniquely determine coefficients in the span of two unit
users with nonsingular Gram matrix. -/
theorem twoUser_conic_coefficients_eq_of_scores_eq
    {D : ℕ} {θ a b c d : ℝ} {u v : Content D}
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ) (hsin : Real.sin θ ≠ 0)
    (hscore_u : score u (scaleContent a u + scaleContent b v) =
      score u (scaleContent c u + scaleContent d v))
    (hscore_v : score v (scaleContent a u + scaleContent b v) =
      score v (scaleContent c u + scaleContent d v)) :
    a = c ∧ b = d := by
  have hvu : score v u = Real.cos θ := by
    rw [score_comm]
    exact huv
  simp only [score_add, score_scaleContent, hu, hv, huv, hvu] at hscore_u hscore_v
  have hdet_pos : 0 < 1 - (Real.cos θ) ^ 2 := by
    nlinarith [Real.sin_sq_add_cos_sq θ, sq_pos_of_ne_zero hsin]
  have ha_sub_c : (1 - (Real.cos θ) ^ 2) * (a - c) = 0 := by
    linear_combination hscore_u - Real.cos θ * hscore_v
  have hac : a = c := by
    have : a - c = 0 :=
      (mul_eq_zero.mp ha_sub_c).resolve_left hdet_pos.ne'
    exact sub_eq_zero.mp this
  have hbd : b = d := by
    rw [hac] at hscore_u
    nlinarith
  exact ⟨hac, hbd⟩

/-- Every listed direction of an arbitrary-dimensional finite radial Nash law
lies in the nonnegative conic hull of the two original users. -/
theorem FiniteGenreConditionalNormLawAnyDim.exists_direction_nonnegative_conic_representation
    {D G P : ℕ} [Nonempty (Fin G)] [Nonempty (Fin P)]
    {mu : MixedContentStrategy D} [IsProbabilityMeasure mu]
    {direction : Fin G → Content D} {u v : Content D} {α β θ : ℝ}
    (law : FiniteGenreConditionalNormLawAnyDim mu direction)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β) (hsin : Real.sin θ ≠ 0)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 D) β q) mu)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) mu ≪ volume)
    (i : Fin G) :
    ∃ a b : ℝ, 0 ≤ a ∧ 0 ≤ b ∧
      direction i = scaleContent a u + scaleContent b v := by
  obtain ⟨r, hr_support, hr_pos⟩ := law.radial_has_positive_support i
  have hp_support : scaleContent r (direction i) ∈ mu.support :=
    law.ray_mem_contentSupport hr_support
  obtain ⟨a, b, ha, hb, hab⟩ :=
    exists_twoUser_nonnegative_conic_representation_of_scaledNormRpowCostNash_support_any_dim
      hu hv huv hu_nonnegative hv_nonnegative hα hβ hsin hnash hscore_ac hp_support
  refine ⟨a / r, b / r, div_nonneg ha hr_pos.le, div_nonneg hb hr_pos.le, ?_⟩
  ext k
  have hk := congrFun hab k
  simp [scaleContent] at hk ⊢
  field_simp [hr_pos.ne']
  nlinarith

/-- Distinct original support directions yield distinct derived canonical
angles; no score-identification assumption is added. -/
theorem FiniteGenreConditionalNormLawAnyDim.polar_angle_injective
    {D G P : ℕ} [Nonempty (Fin G)] [Nonempty (Fin P)]
    {mu : MixedContentStrategy D} [IsProbabilityMeasure mu]
    {direction : Fin G → Content D} {angle : Fin G → ℝ}
    {u v : Content D} {α β θ : ℝ}
    (law : FiniteGenreConditionalNormLawAnyDim mu direction)
    (hdirection_injective : Function.Injective direction)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β) (hsin : Real.sin θ ≠ 0)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 D) β q) mu)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) mu ≪ volume)
    (hu_angle : ∀ i, score u (direction i) = Real.cos (angle i))
    (hv_angle : ∀ i, score v (direction i) = Real.cos (θ - angle i)) :
    Function.Injective angle := by
  intro i j hij
  obtain ⟨a, b, ha, hb, hi⟩ :=
    law.exists_direction_nonnegative_conic_representation hu hv huv
      hu_nonnegative hv_nonnegative hα hβ hsin hnash hscore_ac i
  obtain ⟨c, d, hc, hd, hj⟩ :=
    law.exists_direction_nonnegative_conic_representation hu hv huv
      hu_nonnegative hv_nonnegative hα hβ hsin hnash hscore_ac j
  have hscore_u_eq : score u (direction i) = score u (direction j) := by
    rw [hu_angle i, hu_angle j, hij]
  have hscore_v_eq : score v (direction i) = score v (direction j) := by
    rw [hv_angle i, hv_angle j, hij]
  have hcombo_u : score u (scaleContent a u + scaleContent b v) =
      score u (scaleContent c u + scaleContent d v) := by
    calc
      score u (scaleContent a u + scaleContent b v) = score u (direction i) :=
        congrArg (fun p => score u p) hi.symm
      _ = score u (direction j) := hscore_u_eq
      _ = score u (scaleContent c u + scaleContent d v) :=
        congrArg (fun p => score u p) hj
  have hcombo_v : score v (scaleContent a u + scaleContent b v) =
      score v (scaleContent c u + scaleContent d v) := by
    calc
      score v (scaleContent a u + scaleContent b v) = score v (direction i) :=
        congrArg (fun p => score v p) hi.symm
      _ = score v (direction j) := hscore_v_eq
      _ = score v (scaleContent c u + scaleContent d v) :=
        congrArg (fun p => score v p) hj
  obtain ⟨hac, hbd⟩ := twoUser_conic_coefficients_eq_of_scores_eq
    hu hv huv hsin hcombo_u hcombo_v
  apply hdirection_injective
  calc
    direction i = scaleContent a u + scaleContent b v := hi
    _ = scaleContent c u + scaleContent d v := by rw [hac, hbd]
    _ = direction j := hj.symm

/-- The cone-preserving canonical content associated with the two original
user scores of an arbitrary-dimensional action. -/
noncomputable def twoUserConeCanonicalization {D : ℕ}
    (θ : ℝ) (u v : Content D) (p : Content D) : Content 2 :=
  canonicalTwoUserContentOfValues θ (score u p) (score v p)

theorem twoUserConeCanonicalization_continuous {D : ℕ}
    (θ : ℝ) (u v : Content D) :
    Continuous (twoUserConeCanonicalization θ u v) := by
  unfold twoUserConeCanonicalization
  exact (canonicalTwoUserContentOfValues_continuous θ).comp
    ((continuous_score_right u).prodMk (continuous_score_right v))

theorem score_canonicalFirst_twoUserConeCanonicalization
    {D : ℕ} (θ : ℝ) (u v : Content D) (p : Content D) :
    score canonicalTwoUserFirst (twoUserConeCanonicalization θ u v p) = score u p := by
  exact score_canonicalTwoUserFirst_contentOfValues θ (score u p) (score v p)

theorem score_canonicalSecond_twoUserConeCanonicalization
    {D : ℕ} {θ : ℝ} (u v : Content D) (p : Content D)
    (hsin : Real.sin θ ≠ 0) :
    score (canonicalTwoUserSecond θ) (twoUserConeCanonicalization θ u v p) =
      score v p := by
  exact score_canonicalTwoUserSecond_contentOfValues hsin

/-- A nonnegative original action whose scores lie between the user rays maps
to a nonnegative canonical content action. -/
theorem twoUserConeCanonicalization_nonnegative_of_closedCone
    {D : ℕ} {θ : ℝ} {u v p : Content D}
    (hsin : 0 < Real.sin θ)
    (hu_nonnegative : NonnegativeContent u)
    (hp_nonnegative : NonnegativeContent p)
    (hcone : Real.cos θ * score v p ≤ score u p ∧
      Real.cos θ * score u p ≤ score v p) :
    NonnegativeContent (twoUserConeCanonicalization θ u v p) := by
  change (score u p, score v p) ∈ canonicalTwoUserFeasibleValueSet θ
  rw [mem_canonicalTwoUserFeasibleValueSet_iff hsin]
  exact ⟨score_nonneg_of_nonnegative hu_nonnegative hp_nonnegative,
    by simpa [mul_comm] using hcone.2⟩

/-- The canonicalized action has exactly the two-user Gram quadratic as its
squared Euclidean norm. -/
theorem score_twoUserConeCanonicalization_self_eq_inducedCostQuadratic
    {D : ℕ} {θ : ℝ} {u v p : Content D} (hsin : Real.sin θ ≠ 0) :
    score (twoUserConeCanonicalization θ u v p)
        (twoUserConeCanonicalization θ u v p) =
      twoUserInducedCostQuadratic θ (score u p) (score v p) := by
  unfold twoUserConeCanonicalization
  rw [show canonicalTwoUserContentOfValues θ (score u p) (score v p) =
    content2 (score u p)
      ((score v p - score u p * Real.cos θ) / Real.sin θ) by rfl,
    score_content2]
  convert twoUserCanonicalNormSq_eq_inducedCostQuadratic
    (z1 := score u p) (z2 := score v p) hsin using 1 <;> ring

/-- In the canonical two-coordinate model, every content action attains its
two-score Gram quadratic exactly. -/
theorem canonicalTwoUser_inducedCostQuadratic_eq_score_self
    {θ : ℝ} (hsin : Real.sin θ ≠ 0) (p : Content 2) :
    twoUserInducedCostQuadratic θ
        (score canonicalTwoUserFirst p) (score (canonicalTwoUserSecond θ) p) =
      score p p := by
  have hfirst_unit : score canonicalTwoUserFirst canonicalTwoUserFirst = 1 := by
    simp [canonicalTwoUserFirst, score_content2]
  have hsecond_unit :
      score (canonicalTwoUserSecond θ) (canonicalTwoUserSecond θ) = 1 := by
    rw [show canonicalTwoUserSecond θ =
      content2 (Real.cos θ) (Real.sin θ) by rfl, score_content2]
    nlinarith [Real.sin_sq_add_cos_sq θ]
  have hcross :
      score canonicalTwoUserFirst (canonicalTwoUserSecond θ) = Real.cos θ := by
    simp [canonicalTwoUserFirst, canonicalTwoUserSecond, score_content2]
  exact twoUserInducedCostQuadratic_eq_score_self_of_unit_score_pair_dim_two
    hfirst_unit hsecond_unit hcross hsin

/-- Every nonnegative canonical deviation is weakly dominated, score by score
and in Euclidean norm, by a nonnegative deviation in the original ambient
space.  Inside the user cone this is the inverse-Gram representative; above
the second-user ray it is the projection onto that ray. -/
theorem exists_original_deviation_dominating_canonical
    {D : ℕ} {θ : ℝ} {u v : Content D} (d : Content 2)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u)
    (hv_nonnegative : NonnegativeContent v)
    (hsin : 0 < Real.sin θ) (hcos : 0 ≤ Real.cos θ)
    (hd_nonnegative : NonnegativeContent d) :
    ∃ q : Content D,
      NonnegativeContent q ∧
      score canonicalTwoUserFirst d ≤ score u q ∧
      score (canonicalTwoUserSecond θ) d ≤ score v q ∧
      AppliedModelingLib.FiniteDimensionalNorms.l2 q ≤
        AppliedModelingLib.FiniteDimensionalNorms.l2 d := by
  let z1 : ℝ := score canonicalTwoUserFirst d
  let z2 : ℝ := score (canonicalTwoUserSecond θ) d
  have hzfeasible : (z1, z2) ∈ canonicalTwoUserFeasibleValueSet θ := by
    change NonnegativeContent (canonicalTwoUserContentOfValues θ z1 z2)
    rw [show canonicalTwoUserContentOfValues θ z1 z2 = d by
      exact canonicalTwoUserContentOfValues_valueMap hsin.ne' d]
    exact hd_nonnegative
  have hz := (mem_canonicalTwoUserFeasibleValueSet_iff hsin).mp hzfeasible
  have hz2_nonnegative : 0 ≤ z2 :=
    le_trans (mul_nonneg hz.1 hcos) hz.2
  by_cases hupper : Real.cos θ * z2 ≤ z1
  · obtain ⟨q, hq_nonnegative, hscore_uq, hscore_vq, hscore_qq⟩ :=
      exists_twoUserClosedUserCone_nonnegative_representative_any_dim
        hu_nonnegative hv_nonnegative hu hv huv hsin.ne'
        (z := (z1, z2)) (by
          exact ⟨hupper, by simpa [mul_comm] using hz.2⟩)
    have hscore_dd : score d d = twoUserInducedCostQuadratic θ z1 z2 := by
      symm
      exact canonicalTwoUser_inducedCostQuadratic_eq_score_self hsin.ne' d
    have hnorm_le : AppliedModelingLib.FiniteDimensionalNorms.l2 q ≤
        AppliedModelingLib.FiniteDimensionalNorms.l2 d := by
      rw [score_self_eq_l2_sq] at hscore_qq hscore_dd
      nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg q,
        AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg d]
    exact ⟨q, hq_nonnegative, by simpa [z1] using hscore_uq.symm.le,
      by simpa [z2] using hscore_vq.symm.le, hnorm_le⟩
  · let q : Content D := scaleContent z2 v
    have hq_nonnegative : NonnegativeContent q :=
      scaleContent_nonnegative hz2_nonnegative hv_nonnegative
    have hscore_uq : score u q = Real.cos θ * z2 := by
      dsimp [q]
      rw [score_scaleContent, huv]
      ring
    have hscore_vq : score v q = z2 := by
      dsimp [q]
      rw [score_scaleContent, hv]
      ring
    have hv_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 v = 1 := by
      rw [score_self_eq_l2_sq] at hv
      nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg v]
    have hq_norm : AppliedModelingLib.FiniteDimensionalNorms.l2 q = z2 := by
      dsimp [q]
      have hscale := AppliedModelingLib.FiniteDimensionalNorms.normL2_smul z2 v
      simpa [scaleContent, abs_of_nonneg hz2_nonnegative, hv_norm] using hscale
    have hcanonical_second_unit :
        score (canonicalTwoUserSecond θ) (canonicalTwoUserSecond θ) = 1 := by
      rw [show canonicalTwoUserSecond θ =
        content2 (Real.cos θ) (Real.sin θ) by rfl, score_content2]
      nlinarith [Real.sin_sq_add_cos_sq θ]
    have hscore_dv : score d (canonicalTwoUserSecond θ) = z2 := by
      rw [score_comm]
    have hresidual_nonnegative :=
      score_self_nonnegative (d - scaleContent z2 (canonicalTwoUserSecond θ))
    have hz2_sq_le : z2 ^ 2 ≤ score d d := by
      simp_rw [score_sub_left, score_sub, score_scaleContent, score_scaleUser]
        at hresidual_nonnegative
      rw [hscore_dv, hcanonical_second_unit] at hresidual_nonnegative
      nlinarith
    have hnorm_le : AppliedModelingLib.FiniteDimensionalNorms.l2 q ≤
        AppliedModelingLib.FiniteDimensionalNorms.l2 d := by
      rw [hq_norm]
      rw [score_self_eq_l2_sq] at hz2_sq_le
      nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg d]
    have hscore_first_le : z1 ≤ score u q := by
      rw [hscore_uq]
      exact (lt_of_not_ge hupper).le
    exact ⟨q, hq_nonnegative, by simpa [z1] using hscore_first_le,
      by simpa [z2] using hscore_vq.symm.le, hnorm_le⟩

/-- Canonicalization sends a radial original direction with polar two-user
scores to the matching canonical polar ray, with the radius unchanged. -/
theorem twoUserConeCanonicalization_scale_eq_polar
    {D : ℕ} {θ φ r : ℝ} {u v d : Content D}
    (hsin : Real.sin θ ≠ 0)
    (hu_score : score u d = Real.cos φ)
    (hv_score : score v d = Real.cos (θ - φ)) :
    twoUserConeCanonicalization θ u v (scaleContent r d) =
      scaleContent r (content2 (Real.cos φ) (Real.sin φ)) := by
  ext k
  fin_cases k
  · simp [twoUserConeCanonicalization, canonicalTwoUserContentOfValues,
      content2, score_scaleContent, hu_score, scaleContent]
  · simp [twoUserConeCanonicalization, canonicalTwoUserContentOfValues,
      content2, score_scaleContent, hu_score, hv_score, scaleContent]
    rw [Real.cos_sub]
    field_simp [hsin]
    ring

/-- Compact source support makes canonicalized support exactly the image of
the original support, avoiding any unsupported choice of a map preimage. -/
theorem twoUserConeCanonicalization_support_eq_image_of_isCompact
    {D : ℕ} {θ : ℝ} {u v : Content D} {μ : Measure (Content D)}
    (hcompact : IsCompact μ.support) :
    (Measure.map (twoUserConeCanonicalization θ u v) μ).support =
      twoUserConeCanonicalization θ u v '' μ.support := by
  exact AppliedModelingLib.Probability.map_support_eq_image_support_of_isCompact
    hcompact (twoUserConeCanonicalization_continuous θ u v)

/-- The content law obtained by cone-preserving two-score canonicalization. -/
noncomputable def twoUserConeCanonicalizedMeasure {D : ℕ}
    (θ : ℝ) (u v : Content D) (μ : Measure (Content D)) : Measure (Content 2) :=
  Measure.map (twoUserConeCanonicalization θ u v) μ

theorem twoUserConeCanonicalizedMeasure_firstScoreLaw
    {D : ℕ} (θ : ℝ) (u v : Content D) (μ : Measure (Content D)) :
    Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q)
        (twoUserConeCanonicalizedMeasure θ u v μ) =
      Measure.map (fun p : Content D => score u p) μ := by
  unfold twoUserConeCanonicalizedMeasure
  rw [Measure.map_map (measurable_score_content canonicalTwoUserFirst)
    (twoUserConeCanonicalization_continuous θ u v).measurable]
  apply Measure.map_congr
  filter_upwards [] with p
  exact score_canonicalFirst_twoUserConeCanonicalization θ u v p

theorem twoUserConeCanonicalizedMeasure_secondScoreLaw
    {D : ℕ} {θ : ℝ} (u v : Content D) (μ : Measure (Content D))
    (hsin : Real.sin θ ≠ 0) :
    Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q)
        (twoUserConeCanonicalizedMeasure θ u v μ) =
      Measure.map (fun p : Content D => score v p) μ := by
  unfold twoUserConeCanonicalizedMeasure
  rw [Measure.map_map (measurable_score_content (canonicalTwoUserSecond θ))
    (twoUserConeCanonicalization_continuous θ u v).measurable]
  apply Measure.map_congr
  filter_upwards [] with p
  exact score_canonicalSecond_twoUserConeCanonicalization u v p hsin

structure FiniteGenreConditionalNormLaw
    {G : ℕ} (mu : MixedContentStrategy 2) (angle : Fin G → ℝ) where
  weight : Fin G → ℝ
  radial : Fin G → Measure ℝ
  weight_pos : ∀ i, 0 < weight i
  weights_sum : ∑ i, weight i = 1
  radial_probability : ∀ i, IsProbabilityMeasure (radial i)
  radial_support_nonnegative : ∀ i, (radial i).support ⊆ Set.Ici 0
  radial_has_positive_support : ∀ i, ∃ r ∈ (radial i).support, 0 < r
  radial_cdf_c1 : ∀ i,
    ContDiff ℝ 1 (AppliedModelingLib.Probability.lowerCDFMass (radial i))
  decomposition : mu = ∑ i,
    ENNReal.ofReal (weight i) •
      Measure.map
        (fun r : ℝ => scaleContent r
          (content2 (Real.cos (angle i)) (Real.sin (angle i))))
        (radial i)

/-- A finite arbitrary-dimensional radial law transports to the canonical
polar radial law with the same weights and conditional radius measures. -/
noncomputable def FiniteGenreConditionalNormLawAnyDim.toCanonical
    {D G : ℕ} {mu : MixedContentStrategy D}
    {direction : Fin G → Content D} {θ : ℝ}
    (law : FiniteGenreConditionalNormLawAnyDim mu direction)
    (angle : Fin G → ℝ) {u v : Content D}
    (hsin : Real.sin θ ≠ 0)
    (hu_score : ∀ i, score u (direction i) = Real.cos (angle i))
    (hv_score : ∀ i, score v (direction i) = Real.cos (θ - angle i)) :
    FiniteGenreConditionalNormLaw
      (twoUserConeCanonicalizedMeasure θ u v mu) angle where
  weight := law.weight
  radial := law.radial
  weight_pos := law.weight_pos
  weights_sum := law.weights_sum
  radial_probability := law.radial_probability
  radial_support_nonnegative := law.radial_support_nonnegative
  radial_has_positive_support := law.radial_has_positive_support
  radial_cdf_c1 := law.radial_cdf_c1
  decomposition := by
    unfold twoUserConeCanonicalizedMeasure
    calc
      Measure.map (twoUserConeCanonicalization θ u v) mu =
          Measure.map (twoUserConeCanonicalization θ u v) (∑ i,
            ENNReal.ofReal (law.weight i) •
              Measure.map (fun r : ℝ => scaleContent r (direction i))
                (law.radial i)) := congrArg _ law.decomposition
      _ = ∑ i, ENNReal.ofReal (law.weight i) •
          Measure.map (fun r : ℝ => scaleContent r
            (content2 (Real.cos (angle i)) (Real.sin (angle i))))
            (law.radial i) := by
        rw [Measure.map_finset_sum
          (twoUserConeCanonicalization_continuous θ u v).measurable.aemeasurable]
        simp_rw [Measure.map_smul]
        apply Finset.sum_congr rfl
        intro i _
        rw [Measure.map_map (twoUserConeCanonicalization_continuous θ u v).measurable
          (by
            apply measurable_pi_iff.mpr
            intro d
            exact measurable_id.mul measurable_const)]
        apply congrArg
          (fun ρ : Measure (Content 2) => ENNReal.ofReal (law.weight i) • ρ)
        apply Measure.map_congr
        filter_upwards [] with r
        exact twoUserConeCanonicalization_scale_eq_polar hsin
          (hu_score i) (hv_score i)

/-- Cone-preserving canonicalization transports an arbitrary-dimensional
two-user source Nash law to a genuine canonical two-coordinate source Nash
law.  Canonical deviations are implemented or weakly dominated in the
original nonnegative action space, so this theorem does not assume that an
orthogonal rotation preserves the content cone. -/
theorem sourceSymmetricMixedNash_twoUserConeCanonicalizedMeasure
    {D P : ℕ} [Nonempty (Fin P)] {α β θ : ℝ}
    {u v : Content D} {μ : Measure (Content D)} [IsProbabilityMeasure μ]
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos θ)
    (hu_nonnegative : NonnegativeContent u) (hv_nonnegative : NonnegativeContent v)
    (hα : 0 < α) (hβ : 0 < β)
    (hθ_pos : 0 < θ) (hθ_le : θ ≤ Real.pi / 2)
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 => if i = 0 then u else v)
      (fun q => α * normRpowCost (SourceNorm.l2 D) β q) μ)
    (hscore_ac : ∀ i : Fin 2,
      Measure.map (fun q : Content D => score (if i = 0 then u else v) q) μ ≪ volume) :
    SourceSymmetricMixedNash (P := P)
      (fun i : Fin 2 =>
        if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      (fun q => α * normRpowCost (SourceNorm.l2 2) β q)
      (twoUserConeCanonicalizedMeasure θ u v μ) := by
  let ν : Measure (Content 2) := twoUserConeCanonicalizedMeasure θ u v μ
  have hθ_lt_pi : θ < Real.pi := by linarith [Real.pi_pos]
  have hsin : 0 < Real.sin θ :=
    Real.sin_pos_of_pos_of_lt_pi hθ_pos hθ_lt_pi
  have hcos : 0 ≤ Real.cos θ :=
    Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], hθ_le⟩
  have hν_probability : IsProbabilityMeasure ν := by
    dsimp [ν, twoUserConeCanonicalizedMeasure]
    exact Measure.isProbabilityMeasure_map
      (twoUserConeCanonicalization_continuous θ u v).measurable.aemeasurable
  letI : IsProbabilityMeasure ν := hν_probability
  have hfirst_law :
      Measure.map (fun q : Content 2 => score canonicalTwoUserFirst q) ν =
        Measure.map (fun p : Content D => score u p) μ := by
    exact twoUserConeCanonicalizedMeasure_firstScoreLaw θ u v μ
  have hsecond_law :
      Measure.map (fun q : Content 2 => score (canonicalTwoUserSecond θ) q) ν =
        Measure.map (fun p : Content D => score v p) μ := by
    exact twoUserConeCanonicalizedMeasure_secondScoreLaw u v μ hsin.ne'
  have hscore_ac_canonical : ∀ i : Fin 2,
      Measure.map (fun q : Content 2 =>
        score (if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ) q) ν ≪
          volume := by
    intro i
    fin_cases i
    · simpa [hfirst_law] using hscore_ac 0
    · simpa [hsecond_law] using hscore_ac 1
  have hcompact : IsCompact μ.support :=
    sourceSymmetricMixedNash_isCompact_support_of_compactSublevels_of_scaledNormRpowCost
      (j := Classical.choice inferInstance) hnash hα hβ
      (SourceNorm.l2_compactSublevels D)
  have hsupport : ν.support =
      twoUserConeCanonicalization θ u v '' μ.support := by
    exact twoUserConeCanonicalization_support_eq_image_of_isCompact hcompact
  refine ⟨hν_probability, ?_, ?_⟩
  · rw [hsupport]
    rintro q ⟨p, hp, rfl⟩
    have hp_nonnegative := hnash.2.1 hp
    have hcone := twoUserScore_closedUserCone_of_scaledNormRpowCostNash_any_dim
      hu hv huv hu_nonnegative hv_nonnegative hα hβ hnash hscore_ac hp
    exact twoUserConeCanonicalization_nonnegative_of_closedCone
      hsin hu_nonnegative hp_nonnegative hcone
  · intro j pc hpc d hd_nonnegative
    rw [hsupport] at hpc
    obtain ⟨p, hp, rfl⟩ := hpc
    obtain ⟨q, hq_nonnegative, hscore_first_le, hscore_second_le, hnorm_le⟩ :=
      exists_original_deviation_dominating_canonical d hu hv huv
        hu_nonnegative hv_nonnegative hsin hcos hd_nonnegative
    have hmax := hnash.2.2 j p hp q hq_nonnegative
    rw [twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
      (users := fun i : Fin 2 => if i = 0 then u else v)
      q (fun _ => measurable_score_content _) hscore_ac,
      twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
        (users := fun i : Fin 2 => if i = 0 then u else v)
        p (fun _ => measurable_score_content _) hscore_ac] at hmax
    rw [twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
      (users := fun i : Fin 2 =>
        if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
      d (fun _ => measurable_score_content _) hscore_ac_canonical,
      twoUser_sourceMixedPurePayoff_eq_iidMaximumCdfSum_of_scoreLaw_absolutelyContinuous
        (users := fun i : Fin 2 =>
          if i = 0 then canonicalTwoUserFirst else canonicalTwoUserSecond θ)
        (twoUserConeCanonicalization θ u v p)
        (fun _ => measurable_score_content _) hscore_ac_canonical]
    simp at hmax ⊢
    rw [hfirst_law, hsecond_law,
      score_canonicalFirst_twoUserConeCanonicalization,
      score_canonicalSecond_twoUserConeCanonicalization u v p hsin.ne']
    have hcanonical_self :
        score (twoUserConeCanonicalization θ u v p)
            (twoUserConeCanonicalization θ u v p) = score p p := by
      rw [score_twoUserConeCanonicalization_self_eq_inducedCostQuadratic hsin.ne']
      exact
        twoUserInducedCostQuadratic_eq_score_self_of_scaledNormRpowCostNash_support_any_dim
          hu hv huv hu_nonnegative hv_nonnegative hα hβ hsin.ne'
          hnash hscore_ac hp
    have hcanonical_norm :
        AppliedModelingLib.FiniteDimensionalNorms.l2 (twoUserConeCanonicalization θ u v p) =
          AppliedModelingLib.FiniteDimensionalNorms.l2 p := by
      rw [score_self_eq_l2_sq, score_self_eq_l2_sq] at hcanonical_self
      nlinarith [AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg
          (twoUserConeCanonicalization θ u v p),
        AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg p]
    have hcanonical_cost :
        α * normRpowCost (SourceNorm.l2 2) β
            (twoUserConeCanonicalization θ u v p) =
          α * normRpowCost (SourceNorm.l2 D) β p := by
      simp [normRpowCost, SourceNorm.l2, hcanonical_norm]
    rw [hcanonical_cost]
    letI : IsProbabilityMeasure
        (Measure.map (fun r : Content D => score u r) μ) :=
      Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
    letI : IsProbabilityMeasure
        (Measure.map (fun r : Content D => score v r) μ) :=
      Measure.isProbabilityMeasure_map (measurable_score_content _).aemeasurable
    have hreward_first_le :=
      AppliedModelingLib.Probability.iidMaximumCdf_mono
        (n := P - 1) (Measure.map (fun r : Content D => score u r) μ)
        hscore_first_le
    have hreward_second_le :=
      AppliedModelingLib.Probability.iidMaximumCdf_mono
        (n := P - 1) (Measure.map (fun r : Content D => score v r) μ)
        hscore_second_le
    have hcost_le :
        α * normRpowCost (SourceNorm.l2 D) β q ≤
          α * normRpowCost (SourceNorm.l2 2) β d := by
      have hpow_le :
          AppliedModelingLib.FiniteDimensionalNorms.l2 q ^ β ≤
            AppliedModelingLib.FiniteDimensionalNorms.l2 d ^ β :=
        Real.rpow_le_rpow (AppliedModelingLib.FiniteDimensionalNorms.normL2_nonneg q)
          hnorm_le hβ.le
      simpa [normRpowCost, SourceNorm.l2] using
        mul_le_mul_of_nonneg_left hpow_le hα.le
    linarith

/--
Every radial support point of a positive-mass genre is an actual content
support point of the finite ray mixture.  This is the support-level bridge
needed when a first-order condition is applied to a conditional radial law.
-/
theorem FiniteGenreConditionalNormLaw.ray_mem_contentSupport
    {G : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle)
    {i : Fin G} {r : ℝ} (hr : r ∈ (law.radial i).support) :
    scaleContent r
      (content2 (Real.cos (angle i)) (Real.sin (angle i))) ∈ mu.support := by
  let ray : ℝ → Content 2 := fun t =>
    scaleContent t (content2 (Real.cos (angle i)) (Real.sin (angle i)))
  let component : Measure (Content 2) :=
    ENNReal.ofReal (law.weight i) • Measure.map ray (law.radial i)
  have hcomponent_le : component ≤ mu := by
    rw [law.decomposition]
    dsimp only [component]
    exact Finset.single_le_sum (fun j _ => Measure.zero_le _) (Finset.mem_univ i)
  have hcomponent_support : component.support ⊆ mu.support :=
    (Measure.absolutelyContinuous_of_le hcomponent_le).support_mono
  have hmap_support : (Measure.map ray (law.radial i)).support ⊆ mu.support := by
    have hac : Measure.map ray (law.radial i) ≪ component := by
      dsimp only [component]
      exact Measure.absolutelyContinuous_smul
        (ENNReal.ofReal_pos.mpr (law.weight_pos i)).ne'
    exact hac.support_mono.trans hcomponent_support
  have hray_cont : Continuous ray := by
    apply continuous_pi
    intro d
    exact continuous_id.mul continuous_const
  exact hmap_support
    (AppliedModelingLib.Probability.mem_support_map_of_continuous hray_cont hr)

/-- The nonnegative content ray attached to one polar angle. -/
def finiteGenreNonnegativeRay (angle : ℝ) : Set (Content 2) :=
  (fun r : ℝ => scaleContent r
    (content2 (Real.cos angle) (Real.sin angle))) '' Set.Ici 0

/-- A nonnegative ray through a unit polar direction is a closed content set. -/
theorem isClosed_finiteGenreNonnegativeRay (angle : ℝ) :
    IsClosed (finiteGenreNonnegativeRay angle) := by
  unfold finiteGenreNonnegativeRay
  have hdirection : content2 (Real.cos angle) (Real.sin angle) ≠ 0 := by
    intro hzero
    have hnorm := l2_norm_content2_cos_sin angle
    rw [hzero, SourceNorm.norm_zero] at hnorm
    norm_num at hnorm
  have hclosed := (isClosedEmbedding_smul_left (𝕜 := ℝ) hdirection).isClosedMap
    (Set.Ici 0) isClosed_Ici
  simpa only [scaleContent, Pi.smul_apply] using hclosed

/-- A radial component is supported on its associated closed nonnegative ray. -/
theorem finiteGenre_componentSupport_subset_nonnegativeRay
    {G : ℕ} {mu : MixedContentStrategy 2} {angle : Fin G → ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle) (i : Fin G) :
    (Measure.map (fun r : ℝ => scaleContent r
      (content2 (Real.cos (angle i)) (Real.sin (angle i))))
      (law.radial i)).support ⊆ finiteGenreNonnegativeRay (angle i) := by
  apply Measure.support_subset_of_isClosed
    (isClosed_finiteGenreNonnegativeRay (angle i))
  apply (ae_map_iff (by
    exact (measurable_pi_iff.mpr fun d => measurable_id.mul measurable_const).aemeasurable)
      (isClosed_finiteGenreNonnegativeRay (angle i)).measurableSet).mpr
  filter_upwards [Measure.support_mem_ae] with r hr
  exact ⟨r, law.radial_support_nonnegative i hr, rfl⟩

/-- A finite conditional radial decomposition puts all content support on the
union of its listed nonnegative rays. -/
theorem FiniteGenreConditionalNormLaw.contentSupport_subset_nonnegativeAngleRays
    {G : ℕ} {mu : MixedContentStrategy 2} {angle : Fin G → ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle) :
    mu.support ⊆ ⋃ i, finiteGenreNonnegativeRay (angle i) := by
  classical
  let ray : Fin G → ℝ → Content 2 := fun i r =>
    scaleContent r (content2 (Real.cos (angle i)) (Real.sin (angle i)))
  let component : Fin G → Measure (Content 2) := fun i =>
    ENNReal.ofReal (law.weight i) • Measure.map (ray i) (law.radial i)
  have hcomponent_support : ∀ i,
      (component i).support = (Measure.map (ray i) (law.radial i)).support := by
    intro i
    dsimp only [component]
    exact AppliedModelingLib.Probability.support_smul_eq_of_ne_zero _
      (ENNReal.ofReal_pos.mpr (law.weight_pos i)).ne'
  have hsum_support : ∀ s : Finset (Fin G), ∀ p,
      p ∈ (∑ i ∈ s, component i).support →
        ∃ i : Fin G, i ∈ s ∧ p ∈ (component i).support := by
    intro s
    induction s using Finset.induction_on with
    | empty => simp
    | insert i s hi ih =>
      rw [Finset.sum_insert hi, Measure.support_add]
      intro p hp
      rcases hp with hp | hp
      · exact ⟨i, Finset.mem_insert_self i s, hp⟩
      · rcases ih p hp with ⟨j, hj, hpj⟩
        exact ⟨j, Finset.mem_insert_of_mem hj, hpj⟩
  intro p hp
  rw [law.decomposition] at hp
  rcases hsum_support Finset.univ p hp with ⟨i, -, hcomponent⟩
  apply Set.mem_iUnion.mpr
  refine ⟨i, ?_⟩
  rw [hcomponent_support i] at hcomponent
  exact finiteGenre_componentSupport_subset_nonnegativeRay law i hcomponent

/-- Every nonzero support genre of a finite conditional radial law is one of
the law's listed unit polar directions. -/
theorem FiniteGenreConditionalNormLaw.nonzeroSupportGenres_subset_angleRange
    {G : ℕ} {mu : MixedContentStrategy 2} {angle : Fin G → ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle) :
    SourceNonzeroSupportGenres (SourceNorm.l2 2) mu ⊆
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))) := by
  rintro genre ⟨p, hp, hp_nonzero, rfl⟩
  obtain ⟨i, hp_ray⟩ := Set.mem_iUnion.mp
    (law.contentSupport_subset_nonnegativeAngleRays hp)
  change ∃ r ∈ Set.Ici 0, scaleContent r
    (content2 (Real.cos (angle i)) (Real.sin (angle i))) = p at hp_ray
  rcases hp_ray with ⟨r, hr, hp_eq⟩
  refine ⟨i, ?_⟩
  rw [← hp_eq]
  symm
  apply SourceNorm.normalizedContent_scale_of_norm_eq_one (SourceNorm.l2 2) hr
  · intro hr_zero
    rcases hp_nonzero with ⟨d, hd⟩
    apply hd
    rw [← hp_eq, hr_zero]
    simp [scaleContent]
  · exact l2_norm_content2_cos_sin (angle i)

/-- Every listed polar direction has a positive-radius support point, so it is
an actual nonzero support genre of the finite conditional radial law. -/
theorem FiniteGenreConditionalNormLaw.angleRange_subset_nonzeroSupportGenres
    {G : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle) :
    Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))) ⊆
      SourceNonzeroSupportGenres (SourceNorm.l2 2) mu := by
  rintro genre ⟨i, rfl⟩
  obtain ⟨r, hr, hr_pos⟩ := law.radial_has_positive_support i
  let direction : Content 2 := content2 (Real.cos (angle i)) (Real.sin (angle i))
  have hr_ne : r ≠ 0 := ne_of_gt hr_pos
  have hp_nonzero : NonzeroContent (scaleContent r direction) := by
    by_contra hp_not_nonzero
    have hp_zero : scaleContent r direction = 0 :=
      content_eq_zero_of_not_nonzeroContent hp_not_nonzero
    have hnorm : (SourceNorm.l2 2).norm (scaleContent r direction) = r := by
      rw [(SourceNorm.l2 2).scale_nonneg hr_pos.le,
        show (SourceNorm.l2 2).norm direction = 1 by
          exact l2_norm_content2_cos_sin (angle i)]
      ring
    rw [hp_zero, SourceNorm.norm_zero] at hnorm
    exact hr_ne hnorm.symm
  refine ⟨scaleContent r direction, law.ray_mem_contentSupport hr, hp_nonzero, ?_⟩
  dsimp [direction]
  exact (SourceNorm.normalizedContent_scale_of_norm_eq_one (SourceNorm.l2 2)
    hr_pos.le hr_ne (l2_norm_content2_cos_sin (angle i))).symm

/-- The finite conditional radial law itself realizes exactly its listed
nonzero support genres; no separate genre-equality premise is needed. -/
theorem FiniteGenreConditionalNormLaw.nonzeroSupportGenres_eq_angleRange
    {G : ℕ} {mu : MixedContentStrategy 2} [IsProbabilityMeasure mu]
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle) :
    SourceNonzeroSupportGenres (SourceNorm.l2 2) mu =
      Set.range (fun i => content2 (Real.cos (angle i)) (Real.sin (angle i))) := by
  exact Set.Subset.antisymm law.nonzeroSupportGenres_subset_angleRange
    law.angleRange_subset_nonzeroSupportGenres

/--
The raw score law of a finite conditional radial mixture against any polar
unit user.  Unlike the canonical first/second specializations, this keeps the
user's original first-quadrant angle explicit, so it can be used without
rotating the nonnegative content cone.
-/
theorem finiteGenre_scoreLaw_eq_of_polarUser
    {G : ℕ} {mu : MixedContentStrategy 2} {phi : ℝ}
    {angle : Fin G → ℝ} (law : FiniteGenreConditionalNormLaw mu angle) :
    Measure.map
        (fun p : Content 2 =>
          score (content2 (Real.cos phi) (Real.sin phi)) p) mu =
      ∑ i, ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * Real.cos (phi - angle i)) (law.radial i) := by
  let user : Content 2 := content2 (Real.cos phi) (Real.sin phi)
  have hscore : Measurable (fun p : Content 2 => score user p) :=
    measurable_score_content user
  have hray : ∀ i, Measurable
      (fun r : ℝ => scaleContent r
        (content2 (Real.cos (angle i)) (Real.sin (angle i)))) := by
    intro i
    rw [measurable_pi_iff]
    intro d
    exact measurable_id.mul measurable_const
  calc
    Measure.map (fun p : Content 2 => score user p) mu =
        Measure.map (fun p : Content 2 => score user p)
          (∑ i, ENNReal.ofReal (law.weight i) •
            Measure.map (fun r : ℝ => scaleContent r
              (content2 (Real.cos (angle i)) (Real.sin (angle i))))
              (law.radial i)) := congrArg _ law.decomposition
    _ = ∑ i, ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * Real.cos (phi - angle i)) (law.radial i) := by
      rw [Measure.map_finset_sum hscore.aemeasurable]
      simp_rw [Measure.map_smul]
      apply Finset.sum_congr rfl
      intro i _
      rw [Measure.map_map hscore (hray i)]
      apply congrArg (fun rho : Measure ℝ => ENNReal.ofReal (law.weight i) • rho)
      apply Measure.map_congr
      filter_upwards [] with r
      simp [user, Function.comp_apply, score_scaleContent, score_content2,
        Real.cos_sub]

/--
Generic finite-mixture CDF transport.  A score law represented as positive
weighted radial laws with positive scales has a lower CDF equal to the same
finite weighted sum of rescaled radial lower CDFs.
-/
theorem finiteGenre_lowerCDFMass_eq_of_scoreLaw
    {G : ℕ} {mu : MixedContentStrategy 2} {f : Content 2 → ℝ}
    {angle : Fin G → ℝ} {scale : Fin G → ℝ} {z : ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (hscorelaw : Measure.map f mu =
      ∑ i, ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * scale i) (law.radial i))
    (hscale : ∀ i, 0 < scale i) :
    AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu) z =
      ∑ i, law.weight i * AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (z / scale i) := by
  letI : ∀ i, IsProbabilityMeasure (law.radial i) := law.radial_probability
  letI : ∀ i, IsProbabilityMeasure
      (Measure.map (fun r : ℝ => r * scale i) (law.radial i)) :=
    fun i => Measure.isProbabilityMeasure_map
      (measurable_id.mul measurable_const).aemeasurable
  letI : ∀ i, IsFiniteMeasure
      (ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * scale i) (law.radial i)) :=
    fun i => Measure.smul_finite _ ENNReal.ofReal_ne_top
  calc
    AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu) z =
        ∑ i, law.weight i * AppliedModelingLib.Probability.lowerCDFMass
          (Measure.map (fun r : ℝ => r * scale i) (law.radial i)) z := by
      rw [hscorelaw]
      unfold AppliedModelingLib.Probability.lowerCDFMass Measure.real
      rw [Measure.finset_sum_apply, ENNReal.toReal_sum]
      · simp_rw [Measure.smul_apply, smul_eq_mul, ENNReal.toReal_mul,
          ENNReal.toReal_ofReal (law.weight_pos _).le]
      · intro i _
        exact measure_ne_top _ _
    _ = ∑ i, law.weight i * AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (z / scale i) := by
      apply Finset.sum_congr rfl
      intro i _
      rw [AppliedModelingLib.Probability.lowerCDFMass_map_mul_const (law.radial i) (hscale i)]

/--
The finite-mixture score CDF is `C¹` whenever its radial CDFs are `C¹` and
all score scales are positive.
-/
theorem finiteGenre_lowerCDFMass_contDiff_of_scoreLaw
    {G : ℕ} {mu : MixedContentStrategy 2} {f : Content 2 → ℝ}
    {angle : Fin G → ℝ} {scale : Fin G → ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (hscorelaw : Measure.map f mu =
      ∑ i, ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * scale i) (law.radial i))
    (hscale : ∀ i, 0 < scale i) :
    ContDiff ℝ 1 (fun x =>
      AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu) x) := by
  have hfunction :
      (fun x => AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu) x) =
        (fun x => ∑ i, law.weight i *
          AppliedModelingLib.Probability.lowerCDFMass (law.radial i) (x / scale i)) := by
    funext x
    exact finiteGenre_lowerCDFMass_eq_of_scoreLaw law hscorelaw hscale
  rw [hfunction]
  apply ContDiff.sum
  intro i _
  simpa only [Function.comp_apply, smul_eq_mul] using
    ((law.radial_cdf_c1 i).comp
      (contDiff_id.div_const (scale i))).const_smul (law.weight i)

/--
Derivative formula for a finite mixture of positive radial score scales.
Keeping this independent of the coordinate chart makes the sign computation
available to the original-coordinate boundary repair.
-/
theorem deriv_finiteGenre_lowerCDFMass_eq_of_scoreLaw
    {G : ℕ} {mu : MixedContentStrategy 2} {f : Content 2 → ℝ}
    {angle : Fin G → ℝ} {scale : Fin G → ℝ} {z : ℝ}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (hscorelaw : Measure.map f mu =
      ∑ i, ENNReal.ofReal (law.weight i) •
        Measure.map (fun r : ℝ => r * scale i) (law.radial i))
    (hscale : ∀ i, 0 < scale i) :
    deriv (fun x => AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu) x) z =
      ∑ i, law.weight i *
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / scale i) * (1 / scale i)) := by
  have hfunction :
      (fun x => AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu) x) =
        (fun x => ∑ i, law.weight i *
          AppliedModelingLib.Probability.lowerCDFMass (law.radial i) (x / scale i)) := by
    funext x
    exact finiteGenre_lowerCDFMass_eq_of_scoreLaw law hscorelaw hscale
  have hterm : ∀ i, HasDerivAt
      (fun x => law.weight i * AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (x / scale i))
      (law.weight i *
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / scale i) * (1 / scale i))) z := by
    intro i
    have hscaled : HasDerivAt (fun x : ℝ => x / scale i)
        (1 / scale i) z := by
      simpa only [id_eq] using ((hasDerivAt_id z).div_const (scale i))
    have hrad : HasDerivAt (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / scale i)) (z / scale i) :=
      ((law.radial_cdf_c1 i).differentiable (by norm_num)
        (z / scale i)).hasDerivAt
    have hcomp : HasDerivAt
        (fun x => AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
          (x / scale i))
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / scale i) * (1 / scale i)) z := by
      simpa only [Function.comp_apply] using hrad.comp z hscaled
    exact hcomp.const_mul (law.weight i)
  have hsum : ∀ S : Finset (Fin G), HasDerivAt
      (fun x => ∑ i ∈ S, law.weight i *
        AppliedModelingLib.Probability.lowerCDFMass (law.radial i) (x / scale i))
      (∑ i ∈ S, law.weight i *
        (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
          (z / scale i) * (1 / scale i))) z := by
    intro S
    induction S using Finset.induction_on with
    | empty => simpa using (hasDerivAt_const z (0 : ℝ))
    | insert i S hi ih =>
      convert (hterm i).add ih using 1
      · funext x
        simp [Finset.sum_insert, hi]
      · rw [Finset.sum_insert hi]
  have hsum_univ := hsum Finset.univ
  rw [← hfunction] at hsum_univ
  exact hsum_univ.deriv

/--
Original-coordinate finite-genre boundary exclusion for the first user ray.
The source's positive conditional radial density supplies a strictly positive
term in the second score-CDF derivative.  Original-cone one-sided optimality
at that ray forces the whole derivative to vanish, which is impossible.  No
rotation of the source nonnegative-content cone is used.
-/
theorem finiteGenre_angle_ne_firstUserAngle_of_originalPolar_scaledNormRpowCostNash
    {G P : ℕ} [Nonempty (Fin P)]
    {alpha beta phi theta : ℝ} {mu : MixedContentStrategy 2}
    [IsProbabilityMeasure mu] {angle : Fin G → ℝ}
    {u v : Content 2}
    (law : FiniteGenreConditionalNormLaw mu angle)
    (hu : score u u = 1) (hv : score v v = 1)
    (huv : score u v = Real.cos theta)
    (hu_polar : u = content2 (Real.cos phi) (Real.sin phi))
    (hv_polar : v = content2 (Real.cos (phi + theta)) (Real.sin (phi + theta)))
    (hP : 1 < P) (htheta : 0 < theta) (hsin : 0 < Real.sin theta)
    (hphi : 0 ≤ phi) (hphi_theta : phi + theta ≤ Real.pi / 2)
    (hscale : ∀ j, 0 < Real.cos ((phi + theta) - angle j))
    (hnash : SourceSymmetricMixedNash (P := P)
      (fun j : Fin 2 => if j = 0 then u else v)
      (fun p => alpha * normRpowCost (SourceNorm.l2 2) beta p) mu)
    (hscore_ac : ∀ j : Fin 2,
      Measure.map (fun q : Content 2 => score (if j = 0 then u else v) q) mu ≪
        volume)
    (i : Fin G) : angle i ≠ phi := by
  let f : Content 2 → ℝ := fun q => score v q
  let scale : Fin G → ℝ := fun j => Real.cos ((phi + theta) - angle j)
  have hscorelaw : Measure.map f mu =
      ∑ j, ENNReal.ofReal (law.weight j) •
        Measure.map (fun r : ℝ => r * scale j) (law.radial j) := by
    simpa only [f, scale, hv_polar] using
      (finiteGenre_scoreLaw_eq_of_polarUser (phi := phi + theta) law)
  have hscale_pos : ∀ j, 0 < scale j := by
    intro j
    exact hscale j
  letI : ∀ j, IsProbabilityMeasure (law.radial j) := law.radial_probability
  letI : IsProbabilityMeasure (Measure.map f mu) :=
    Measure.isProbabilityMeasure_map (measurable_score_content v).aemeasurable
  intro hi
  obtain ⟨r, hr_support, hr_pos, hr_cdf_pos, hr_deriv_pos⟩ :=
    AppliedModelingLib.Probability.exists_pos_mem_support_of_lowerCDFMass_pos_and_deriv_pos
      (law.radial i) (law.radial_has_positive_support i) (law.radial_cdf_c1 i)
  have hp : scaleContent r
      (content2 (Real.cos (angle i)) (Real.sin (angle i))) ∈ mu.support :=
    law.ray_mem_contentSupport hr_support
  have hp_eq : scaleContent r
      (content2 (Real.cos (angle i)) (Real.sin (angle i))) = scaleContent r u := by
    rw [hi, hu_polar]
  have hp_score : twoUserScoreMap u v
      (scaleContent r (content2 (Real.cos (angle i)) (Real.sin (angle i)))) =
        (r, r * Real.cos theta) := by
    rw [hp_eq]
    simp only [twoUserScoreMap]
    rw [score_scaleContent, score_scaleContent, hu, score_comm, huv]
    norm_num
  have hmax :=
    twoUserScoreMap_isMaxOn_iidMaximumCdfObjective_of_scaledNormRpowCostNash
      hu hv huv hsin hnash hscore_ac hp
  rw [hp_score] at hmax
  have hphi_lt : phi < Real.pi / 2 := by linarith
  have hcos_phi : 0 < Real.cos phi :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hphi_lt⟩
  have hdelta : 0 < r * Real.cos phi := mul_pos hr_pos hcos_phi
  have hraw_c1 : ContDiff ℝ 1 (fun x =>
      AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu) x) :=
    finiteGenre_lowerCDFMass_contDiff_of_scoreLaw law hscorelaw hscale_pos
  have hraw_deriv : HasDerivAt
      (fun x => AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu) x)
      (deriv (fun x => AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu) x)
        (r * Real.cos theta)) (r * Real.cos theta) :=
    (hraw_c1.differentiable (by norm_num) (r * Real.cos theta)).hasDerivAt
  have hmax_deriv :=
    AppliedModelingLib.Probability.hasDerivAt_iidMaximumCdf_of_hasDerivAt_lowerCDFMass
      (n := P - 1) (Measure.map f mu) hraw_deriv
  have hreward_deriv : HasDerivAt
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map f mu) x)
      (deriv (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map f mu) x) (r * Real.cos theta)) (r * Real.cos theta) := by
    rw [hmax_deriv.deriv]
    exact hmax_deriv
  have hreward_nonneg : 0 ≤ deriv
      (fun x => AppliedModelingLib.Probability.iidMaximumCdf (n := P - 1)
        (Measure.map f mu) x) (r * Real.cos theta) :=
    (AppliedModelingLib.Probability.iidMaximumCdf_mono
      (n := P - 1) (Measure.map f mu)).deriv_nonneg
  have hreward_zero :=
    deriv_secondReward_eq_zero_of_isMaxOn_of_originalLowerBoundary
      hmax hsin hr_pos hdelta
      (fun ε hε_pos hε_lt =>
        twoUserScore_originalLowerBoundary_inward_feasible_of_polarUsers
          hu_polar hv_polar hphi htheta.le hphi_theta hr_pos hε_pos.le hε_lt)
      hreward_deriv hreward_nonneg
  have hscale_i : scale i = Real.cos theta := by
    simp [scale, hi]
  have hscale_i_pos : 0 < Real.cos theta := by
    rw [← hscale_i]
    exact hscale_pos i
  have hr_div : r * Real.cos theta / scale i = r := by
    rw [hscale_i]
    exact mul_div_cancel_right₀ r hscale_i_pos.ne'
  have hterm_cdf_nonneg : ∀ j : Fin G, 0 ≤ law.weight j *
      AppliedModelingLib.Probability.lowerCDFMass (law.radial j)
        (r * Real.cos theta / scale j) := by
    intro j
    exact mul_nonneg (law.weight_pos j).le
      (AppliedModelingLib.Probability.lowerCDFMass_nonneg (law.radial j) _)
  have hterm_cdf_pos : 0 < law.weight i *
      AppliedModelingLib.Probability.lowerCDFMass (law.radial i)
        (r * Real.cos theta / scale i) := by
    rw [hr_div]
    exact mul_pos (law.weight_pos i) hr_cdf_pos
  have hraw_cdf_pos : 0 < AppliedModelingLib.Probability.lowerCDFMass
      (Measure.map f mu) (r * Real.cos theta) := by
    rw [finiteGenre_lowerCDFMass_eq_of_scoreLaw law hscorelaw hscale_pos]
    exact lt_of_lt_of_le hterm_cdf_pos
      (Finset.single_le_sum (fun j _ => hterm_cdf_nonneg j) (Finset.mem_univ i))
  have hP_minus_one_pos : 0 < P - 1 := by omega
  have hP_minus_one_real_pos : 0 < ((P - 1 : ℕ) : ℝ) :=
    Nat.cast_pos.mpr hP_minus_one_pos
  have hscalar_pos : 0 < ((P - 1 : ℕ) : ℝ) *
      (AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu)
        (r * Real.cos theta)) ^ (P - 1 - 1) :=
    mul_pos hP_minus_one_real_pos (pow_pos hraw_cdf_pos _)
  have hraw_deriv_zero : deriv
      (fun x => AppliedModelingLib.Probability.lowerCDFMass (Measure.map f mu) x)
      (r * Real.cos theta) = 0 := by
    rw [AppliedModelingLib.Probability.deriv_iidMaximumCdf_eq_of_hasDerivAt_lowerCDFMass
      (n := P - 1) (Measure.map f mu) hraw_deriv] at hreward_zero
    exact (mul_eq_zero.mp hreward_zero).resolve_left hscalar_pos.ne'
  have hterm_deriv_nonneg : ∀ j : Fin G, 0 ≤ law.weight j *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial j))
        (r * Real.cos theta / scale j) * (1 / scale j)) := by
    intro j
    refine mul_nonneg (law.weight_pos j).le (mul_nonneg ?_ ?_)
    · exact (AppliedModelingLib.Probability.lowerCDFMass_mono (law.radial j)).deriv_nonneg
    · exact one_div_nonneg.mpr (hscale_pos j).le
  have hsum_deriv_zero : ∑ j, law.weight j *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial j))
        (r * Real.cos theta / scale j) * (1 / scale j)) = 0 := by
    rw [← deriv_finiteGenre_lowerCDFMass_eq_of_scoreLaw law hscorelaw hscale_pos]
    exact hraw_deriv_zero
  have hterm_deriv_zero : law.weight i *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
        (r * Real.cos theta / scale i) * (1 / scale i)) = 0 :=
    ((Finset.sum_eq_zero_iff_of_nonneg (fun j _ => hterm_deriv_nonneg j)).mp
      hsum_deriv_zero) i (Finset.mem_univ i)
  have hterm_deriv_pos : 0 < law.weight i *
      (deriv (AppliedModelingLib.Probability.lowerCDFMass (law.radial i))
        (r * Real.cos theta / scale i) * (1 / scale i)) := by
    rw [hr_div]
    exact mul_pos (law.weight_pos i)
      (mul_pos hr_deriv_pos (one_div_pos.mpr (hscale_pos i)))
  exact hterm_deriv_pos.ne' hterm_deriv_zero

/--
Original-coordinate finite-genre boundary exclusion for the second user ray.
This is the coordinate-swapped companion to
`finiteGenre_angle_ne_firstUserAngle_of_originalPolar_scaledNormRpowCostNash`:
the first score-CDF has a strictly positive finite-genre density contribution,
whereas one-sided optimality along the original content cone would force its
