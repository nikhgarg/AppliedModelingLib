    (hcos : 0 ≤ Real.cos phi) (hcos_other : 0 ≤ Real.cos (theta - phi))
    (hphi_lower : theta - Real.pi / 2 ≤ phi) (hphi_upper : phi ≤ Real.pi / 2)
