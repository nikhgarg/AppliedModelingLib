theorem mixedContentStrategyAtomless_of_sourceSymmetricMixedNash_integral_semantics
    {D N P : ℕ} [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} {i0 : Fin N}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (hcont : PerturbationCostContinuous cost)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0))
    (hmeas_base :
      ∀ (j : Fin P) (p : Content D),
        MeasureTheory.AEStronglyMeasurable
          (fun profile : Fin P → Content D =>
            usersWon users (deviateProfile profile j p) j)
          (MeasureTheory.Measure.pi (fun _ : Fin P => μ)))
    (hmeas_perturb :
      ∀ (j : Fin P) (p : Content D) {ε : ℝ}, 0 < ε →
        MeasureTheory.AEStronglyMeasurable
          (fun profile : Fin P → Content D =>
            usersWon users
              (deviateProfile profile j
                (fun d => p d + ε * users i0 d)) j)
          (MeasureTheory.Measure.pi (fun _ : Fin P => μ))) :
    MixedContentStrategyAtomless μ := by
  letI : MeasureTheory.IsProbabilityMeasure μ := hnash.1
  intro p hp
  have hp_support : p ∈ μ.support := hasContentPointMass_mem_support hp
  have hp_nonnegative : NonnegativeContent p := hnash.2.1 hp_support
  let j : Fin P := Classical.choice (inferInstance : Nonempty (Fin P))
  have hgain_expected :
      ∀ {ε : ℝ}, 0 < ε →
        AtomEventExpectedUsersWonGainLowerBound (D := D) (P := P)
          (ExpectedUsersWonAgainstSymmetricMixed users j) μ p (users i0) j ε := by
    intro ε hε
    exact atomEventExpectedUsersWonGainLowerBound_of_integral_semantics
      (D := D) (N := N) (P := P)
      husers_nonneg hzero hε
      (measurableSet_allOtherProducersDrawContent j p)
      (integrable_usersWon_of_aestronglyMeasurable
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ)) (hmeas_base j p))
      (integrable_usersWon_of_aestronglyMeasurable
        (MeasureTheory.Measure.pi (fun _ : Fin P => μ))
        (hmeas_perturb j p hε))
  have hgain_payoff :
      ∀ {ε : ℝ}, 0 < ε →
        AtomEventPayoffGainLowerBound (D := D) (P := P)
          (SourceMixedPurePayoff (ExpectedUsersWonAgainstSymmetricMixed users j) cost)
          cost μ p (users i0) j ε := by
    intro ε hε
    exact atomEventPayoffGainLowerBound_of_expectedUsersWonGainLowerBound
      (D := D) (P := P) (cost := cost) (hgain_expected hε)
  rcases exists_nonnegative_profitable_atom_perturbation_of_event_gain_lower_bound
      (P := P) hcont hp hp_nonnegative (husers_nonneg i0) hzero rfl hgain_payoff
    with ⟨q, hq_nonnegative, hpq⟩
  exact (not_lt_of_ge (hnash.2.2 j p hp_support q hq_nonnegative)) hpq

/--
The same corrected Proposition `atom` endpoint with the finite uniform-tie
measurability obligations discharged by the model itself.
-/
theorem mixedContentStrategyAtomless_of_sourceSymmetricMixedNash
    {D N P : ℕ} [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} {i0 : Fin N}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (hcont : PerturbationCostContinuous cost)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0)) :
    MixedContentStrategyAtomless μ :=
  mixedContentStrategyAtomless_of_sourceSymmetricMixedNash_integral_semantics
    hnash hcont husers_nonneg hzero
    (fun j p => (measurable_usersWon_deviateProfile_const users j p).aestronglyMeasurable)
    (fun j p {ε} _hε =>
      (measurable_usersWon_deviateProfile_const users j
        (fun d => p d + ε * users i0 d)).aestronglyMeasurable)

/-- Corrected Proposition `atom` in mathlib's `NoAtoms` form. -/
theorem noAtoms_of_sourceSymmetricMixedNash
    {D N P : ℕ} [Nonempty (Fin P)] [Nontrivial (Fin P)]
    {users : Fin N → Content D} {cost : Content D → ℝ}
    {μ : MixedContentStrategy D} {i0 : Fin N}
    (hnash : SourceSymmetricMixedNash (P := P) users cost μ)
    (hcont : PerturbationCostContinuous cost)
    (husers_nonneg : ∀ i : Fin N, NonnegativeContent (users i))
    (hzero : NonzeroContent (users i0)) :
    MeasureTheory.NoAtoms μ := by
  refine ⟨?_⟩
  intro p
  by_contra hp
  exact mixedContentStrategyAtomless_of_sourceSymmetricMixedNash
    hnash hcont husers_nonneg hzero p hp

/--
Corrected end-to-end zero-utility route: the source mixed-Nash atom argument
discharges content atomlessness, while the explicit singleton-genre, CDF, and
