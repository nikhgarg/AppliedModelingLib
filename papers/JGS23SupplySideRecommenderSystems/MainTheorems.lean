/-- A diagonal canonical value reconstructs as a nonnegative scalar multiple
of the fixed diagonal-value direction. -/
theorem canonicalTwoUserContentOfValues_diagonal_eq_scaleContent
    {θ z : ℝ} (hsin : Real.sin θ ≠ 0) :
    canonicalTwoUserContentOfValues θ z z =
      scaleContent z (canonicalTwoUserContentOfValues θ 1 1) := by
  ext d
  fin_cases d
  · simp [canonicalTwoUserContentOfValues, content2, scaleContent]
  · simp [canonicalTwoUserContentOfValues, content2, scaleContent]
    field_simp [hsin]

/-- Public inverse-coordinate identity for the canonical two-user value map. -/
theorem canonicalTwoUserContentOfValues_valueMap_eq
    {θ : ℝ} (hsin : Real.sin θ ≠ 0) (p : Content 2) :
    canonicalTwoUserContentOfValues θ
      (canonicalTwoUserValueMap θ p).1
      (canonicalTwoUserValueMap θ p).2 = p :=
  canonicalTwoUserContentOfValues_valueMap hsin p

/--
If all canonical support values are diagonal, every nonzero support action has
one common normalized genre: the normalized content vector representing value
`(1,1)`.  The support nonnegativity premise selects a positive rather than a
negative multiple of that direction.
-/
theorem canonicalTwoUser_nonzeroSupportGenres_subset_singleton_of_valueSupport_diagonal
    {ν : SourceNorm 2} {θ : ℝ} {μ : MixedContentStrategy 2}
    (hsin : Real.sin θ ≠ 0)
    (hsupport_nonnegative : μ.support ⊆
      {p : Content 2 | NonnegativeContent p})
    (hdiag : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z.2 = z.1) :
    SourceNonzeroSupportGenres ν μ ⊆
      ({SourceNorm.normalizedContent ν
        (canonicalTwoUserContentOfValues θ 1 1)} : Set (Content 2)) := by
  intro _ hgenre
  rcases hgenre with ⟨p, hp, hp_nonzero, rfl⟩
  let z : ℝ := (canonicalTwoUserValueMap θ p).1
  have hvalue_mem : canonicalTwoUserValueMap θ p ∈
      (Measure.map (canonicalTwoUserValueMap θ) μ).support :=
    canonicalTwoUserValueMap_mem_support_of_mem_content_support hp
  have hdiag_p : (canonicalTwoUserValueMap θ p).2 =
      (canonicalTwoUserValueMap θ p).1 := hdiag _ hvalue_mem
  have hp_scale : p =
      scaleContent z (canonicalTwoUserContentOfValues θ 1 1) := by
    calc
      p = canonicalTwoUserContentOfValues θ
          (canonicalTwoUserValueMap θ p).1
          (canonicalTwoUserValueMap θ p).2 :=
        (canonicalTwoUserContentOfValues_valueMap_eq hsin p).symm
      _ = canonicalTwoUserContentOfValues θ z z := by
        dsimp [z]
        rw [hdiag_p]
      _ = scaleContent z (canonicalTwoUserContentOfValues θ 1 1) :=
        canonicalTwoUserContentOfValues_diagonal_eq_scaleContent hsin
  have hz_nonneg : 0 ≤ z := by
    have hp_nonnegative := hsupport_nonnegative hp
    have hfirst_nonnegative : NonnegativeContent canonicalTwoUserFirst := by
      intro d
      fin_cases d <;> simp [canonicalTwoUserFirst, content2]
    simpa [z, canonicalTwoUserValueMap] using
      (score_nonneg_of_nonnegative hfirst_nonnegative hp_nonnegative)
  have hz_ne : z ≠ 0 := by
    intro hz
    have hp_zero : p = 0 := by
      rw [hp_scale, hz]
      ext d
      simp [scaleContent]
    rcases hp_nonzero with ⟨d, hd⟩
    rw [hp_zero] at hd
    simpa using hd
  let base : Content 2 := canonicalTwoUserContentOfValues θ 1 1
  let fixedGenre : Content 2 := SourceNorm.normalizedContent ν base
  have hbase_nonzero : NonzeroContent base := by
    refine ⟨0, ?_⟩
    simp [base, canonicalTwoUserContentOfValues, content2]
  have hfixed_norm : ν.norm fixedGenre = 1 := by
    exact SourceNorm.norm_normalizedContent_eq_one ν hbase_nonzero
  have hbase_recover : scaleContent (ν.norm base) fixedGenre = base :=
    SourceNorm.scale_norm_normalizedContent_eq_self ν hbase_nonzero
  have hp_fixed : p = scaleContent (z * ν.norm base) fixedGenre := by
    calc
      p = scaleContent z base := by simpa [base] using hp_scale
      _ = scaleContent z (scaleContent (ν.norm base) fixedGenre) := by
        rw [hbase_recover]
      _ = scaleContent (z * ν.norm base) fixedGenre := by
        ext d
        simp [scaleContent]
        ring
  have hscalar_pos : 0 < z * ν.norm base :=
    mul_pos (lt_of_le_of_ne hz_nonneg (Ne.symm hz_ne))
      (ν.pos_of_nonzero hbase_nonzero)
  rw [Set.mem_singleton_iff, hp_fixed]
  simpa [fixedGenre, base] using
    (SourceNorm.normalizedContent_scale_of_norm_eq_one ν hscalar_pos.le
      hscalar_pos.ne' hfixed_norm)

/-- A represented nonzero support action upgrades the preceding singleton
containment to exact singleton genre equality. -/
theorem canonicalTwoUser_nonzeroSupportGenres_eq_singleton_of_valueSupport_diagonal
    {ν : SourceNorm 2} {θ : ℝ} {μ : MixedContentStrategy 2}
    (hsin : Real.sin θ ≠ 0)
    (hsupport_nonnegative : μ.support ⊆
      {p : Content 2 | NonnegativeContent p})
    (hdiag : ∀ z ∈ (Measure.map (canonicalTwoUserValueMap θ) μ).support,
      z.2 = z.1)
    (hexists : ∃ p : Content 2, p ∈ μ.support ∧ NonzeroContent p) :
    SourceNonzeroSupportGenres ν μ =
      ({SourceNorm.normalizedContent ν
        (canonicalTwoUserContentOfValues θ 1 1)} : Set (Content 2)) := by
