      "memo_anchor": "propositions-42-and-43-exact-under-clarified-weakstrict-interpretation",
      "report_home": 10,
      "source_reading": "Section 4 comparisons are weak generally and strict exactly with positive disadvantaged effort; derivative signs are asserted only where derivatives exist."
    },
    "convention/LBG22-HARD-BUDGET-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Proposition B.2",
      "memo_anchor": "proposition-b2",
      "report_home": 4,
      "source_reading": "Applicants choose nonnegative eM,eU with eM+eU=B and utility reward-p(eM); the printed unused-budget term is not an enforcement device."
    },
