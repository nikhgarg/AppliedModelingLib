  "items": {
    "defect/LBG22-C1": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Proposition 3.1",
      "memo_anchor": "proposition-31",
      "report_home": 4,
      "source_reading": "Two-level applicant welfare is unconditionally non-increasing in the cutoff."
    },
    "defect/LBG22-P1": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Proposition 3.1",
      "memo_anchor": "proposition-31",
      "report_home": 7,
      "source_reading": "The proof uses unweighted conditional band means and asserts unique attainment at the c=0 boundary."
    },
    "defect/LBG22-P2": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Associated normalization and access corrections",
      "memo_anchor": "associated-normalization-and-access-corrections",
      "report_home": 7,
      "source_reading": "The proof drops the rho factor and assumes admitted scores all equal the threshold via g(0)=0."
    },
    "defect/LBG22-P3": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Associated normalization and access corrections",
      "memo_anchor": "associated-normalization-and-access-corrections",
      "report_home": 7,
      "source_reading": "The witness assumes g(p^{-1}(x))=x, incompatible with strict convex cost and concave production, and overclaims every three-level policy."
    },
    "defect/LBG22-P4": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Associated normalization and access corrections",
      "memo_anchor": "associated-normalization-and-access-corrections",
      "report_home": 7,
      "source_reading": "The proof gives rho<5/9 and infers global optimality from one endpoint derivative."
    },
    "defect/LBG22-P5": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Associated normalization and access corrections",
      "memo_anchor": "associated-normalization-and-access-corrections",
      "report_home": 7,
      "source_reading": "The mixture-rank inverse notation and proof presume a globally invertible mixture CDF."
    },
    "defect/LBG22-C3": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Propositions 4.2 and 4.3: exact under clarified weak/strict interpretation",
      "memo_anchor": "propositions-42-and-43-exact-under-clarified-weakstrict-interpretation",
      "report_home": 4,
      "source_reading": "The high-region welfare gap has a strictly positive classical derivative at every feasible cutoff."
    },
    "defect/LBG22-P6": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Associated normalization and access corrections",
      "memo_anchor": "associated-normalization-and-access-corrections",
      "report_home": 7,
      "source_reading": "The access proof sets pure access to zero, reverses theta_B(c)>=c, and ignores exhausted support."
    },
    "defect/LBG22-P7": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Appendix effort comparative statics and Proposition B.1",
      "memo_anchor": "appendix-effort-comparative-statics-and-proposition-b1",
      "report_home": 7,
      "source_reading": "The proof changes the corollary's i<k range to i<k-1 and suppresses baseline clipping."
    },
    "defect/LBG22-C4": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Appendix effort comparative statics and Proposition B.1",
      "memo_anchor": "appendix-effort-comparative-statics-and-proposition-b1",
      "report_home": 4,
      "source_reading": "Strict reward ordering is equivalent to strict ordering of maximum weighted-skill indices."
    },
    "defect/LBG22-P8": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Proposition B.2",
      "memo_anchor": "proposition-b2",
      "report_home": 4,
      "source_reading": "The displayed penalty is said to implement eU=B-eM."
    },
    "defect/LBG22-P9": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Proposition B.2",
      "memo_anchor": "proposition-b2",
      "report_home": 7,
      "source_reading": "The proof omits conditional normalization, uses E[theta_U] instead of E[f_U(theta_U)], and turns stationarity into global optimality."
    },
    "defect/LBG22-C5": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Proposition B.2",
      "memo_anchor": "proposition-b2",
      "report_home": 4,
      "source_reading": "Every interior cutoff is globally supportable by a positive private-utility weight under all source-admissible primitives."
    },
    "convention/LBG22-KNOWN-PRIORITY-ORDER-BOUNDARY-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Stated model: known priorities and continuum best response",
      "memo_anchor": "stated-model-known-priorities-and-continuum-best-response",
      "report_home": 3,
      "source_reading": "A publicly known fixed injective priority breaks actual score-boundary ties and is held fixed with the score law across every deviation; strict-percentile equilibrium is used only through proved all-deviation equivalence."
    },
    "convention/LBG22-CONTINUUM-AE-BEST-RESPONSE-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "50d66b922e288b6d5fa602e3bc1344fb9abe751602dfc98c0b9b3198d54c2692",
      "memo_heading": "Stated model: known priorities and continuum best response",
      "memo_anchor": "stated-model-known-priorities-and-continuum-best-response",
      "report_home": 3,
      "source_reading": "One full-measure applicant set best responds against every feasible deviation; uniqueness is equality almost everywhere."
    },
    "convention/LBG22-WEAK-STRICT-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
