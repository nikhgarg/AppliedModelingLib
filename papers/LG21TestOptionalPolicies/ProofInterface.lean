    (e : LG21ResamplingExperiment ΩBase ΩTest Estimate) (base : ΩBase) :
    lg21ResamplingEstimateKernel e base =
      (e.signalGivenBase base).map (fun test => e.estimate base test) := paper_definition6_resampling_estimate_kernel_eq_map e base

