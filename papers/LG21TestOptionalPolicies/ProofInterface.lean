        0 ≤ baseMeanVariance ∧
        baseLaw.map baseMean =
          gaussianReal M.priorMean baseMeanVariance.toNNReal ∧
        (letI : IsProbabilityMeasure baseLaw := hbaseLaw
         (∀ (mandatory : LG21MandatoryGivenAccessLiteralSourceEquilibrium M)
             (mandatoryReportedPayoff :
