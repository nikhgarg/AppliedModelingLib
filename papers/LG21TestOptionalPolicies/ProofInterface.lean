/--
Theorem 3.2 source mixture helper: the binary reporter/no-reporter PMF has the
paper's pointwise mixture masses.
-/
theorem paper_interface_theorem3_2_binary_mixture_pmf_apply_toReal
    {Estimate : Type*} (p : NNReal) (hp : p ≤ 1)
    (reporterPMF noReporterPMF : PMF Estimate) (estimate : Estimate) :
    (lg21BinaryMixturePMF p hp reporterPMF noReporterPMF estimate).toReal =
      p.toReal * (reporterPMF estimate).toReal +
        (1 - p.toReal) * (noReporterPMF estimate).toReal := lg21BinaryMixturePMF_apply_toReal p hp reporterPMF noReporterPMF estimate

