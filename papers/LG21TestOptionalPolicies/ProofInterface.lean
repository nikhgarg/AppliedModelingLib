    (cutoff : ℝ)
    (hthreshold :
      ∀ actor : ℝ, W.reports base actor ↔ cutoff ≤ actor)
    (hwitness_reports_to_decision :
      ∀ actor : ℝ, W.reports base actor → reportDecision e base actor = true)
    (hfair : lg21SourceLatentSkillFair S ∨ lg21SourceObservablyFair S)
    (hweight : 0 < signalWeight e base)
    (hdenom : 0 < denom e base) :
    actorMean e base ≤ cutoff :=
  paper_theorem3_2_optional_reporting_threshold_witness_cutoff_ge_mean_of_fair
    skillGivenBase hObsAccess hObsNoAccess takeDecision reportDecision
    estimationConsistent referenceSkill baseTerm signalWeight denom actorMean
    hEq e base hlambda reporterPMF noReporterPMF hNoAccess hAccessMixture W
    cutoff hthreshold hwitness_reports_to_decision hfair hweight hdenom

