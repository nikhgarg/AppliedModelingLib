  (∀ᵐ ω ∂P, ∀ i, Measurable (fun t => backlogged ω t i)) ∧
    physicalTaggedInitialWorkVectorClasswiseRemainingWorkBalanceAE
      P tag capacity weight backlogged remainingWork ∧
    physicalTaggedInitialWorkVectorBacklogEqualsPositiveRemainingWorkAE
