/-- A positive log-tail and finite nonnegative delay force positive slack. -/
theorem finiteSLA_requires_positive_slack
    {slack delay logTail : ℝ}
    (hdelay : 0 ≤ delay) (hlogTail : 0 < logTail)
    (hsla : multiplicativeSLAConstraint slack delay logTail) :
    0 < slack := by
  by_contra h
  have hslack : slack ≤ 0 := le_of_not_gt h
  have hproduct : slack * delay ≤ 0 :=
    mul_nonpos_of_nonpos_of_nonneg hslack hdelay
  unfold multiplicativeSLAConstraint at hsla
  linarith

