    (hbalance :
      physicalTaggedInitialWorkVectorClasswiseCumulativeServiceBalanceAllTimesAE
        P tag capacity weight backlogged remainingWork cumulativeService) :
    physicalTaggedInitialWorkVectorChronologicalServiceProcessAllTimesAE
      P tag capacity weight backlogged remainingWork cumulativeService := by
  filter_upwards [hbalance] with ω hω
  refine ⟨?_, ?_, ?_⟩
  · intro i
    simpa using
      (hω i (postTagFalseMarkBusyUntil (ω.2 0).1 ω)).1
  · intro i t
    calc
      remainingWork ω t i =
          physicalTaggedInitialWorkVector tag capacity weight ω i -
            (cumulativeService ω i t -
              cumulativeService ω i
                (postTagFalseMarkBusyUntil (ω.2 0).1 ω)) :=
        (hω i t).1
      _ =
          remainingWork ω (postTagFalseMarkBusyUntil (ω.2 0).1 ω) i -
            (cumulativeService ω i t -
              cumulativeService ω i
                (postTagFalseMarkBusyUntil (ω.2 0).1 ω)) := by
        rw [
          (show
