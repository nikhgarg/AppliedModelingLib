/--
Under the selected-Palm false-mark source, every entry of the tagged-class work
sequence is nonnegative.  Job zero has the physical tagged work; later entries
are zero by definition of `postTagFalseMarkTaggedServiceWork`.
-/
theorem physicalSelectedPalmTaggedGPSAllArrivalsTaggedServiceWorkNonnegativeAE
    {arrivalRate capacity : ℝ}
    {ι : Type*} [Fintype ι] [DecidableEq ι] (tag : ι)
    (weight : ι → ℝ)
    (harrival_pos : 0 < arrivalRate)
    (hstable : arrivalRate < capacity * weight tag) :
    let arrivalRateNN : ℝ≥0 := ⟨arrivalRate, harrival_pos.le⟩
    let serviceRateNN : ℝ≥0 :=
      ⟨capacity * weight tag, (lt_trans harrival_pos hstable).le⟩
    ∀ᵐ ω ∂
      (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
        (by exact_mod_cast harrival_pos)
        (by exact_mod_cast hstable)).Ptag,
      ∀ n,
        0 ≤ postTagFalseMarkTaggedServiceWork (capacity * weight tag)
          (ω.2 0).1 ω n := by
  dsimp
  let arrivalRateNN : ℝ≥0 := ⟨arrivalRate, harrival_pos.le⟩
  let serviceRateNN : ℝ≥0 :=
    ⟨capacity * weight tag, (lt_trans harrival_pos hstable).le⟩
  have hbusy_le_response : ∀ᵐ ω ∂
      (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
        (by exact_mod_cast harrival_pos)
        (by exact_mod_cast hstable)).Ptag,
      postTagFalseMarkBusyUntil (ω.2 0).1 ω ≤
        postTagFalseMarkResponseFromState ω := by
    simpa [arrivalRateNN, serviceRateNN, PhysicalMM1ForwardReverseTag,
      ForwardReverseTag, PhysicalMM1ClockRate, PhysicalMM1Rho] using
      (geoNNPMF_uniformized_forwardReverseMarkedSelectedTag_ae_postTagFalseMarkBusyUntil_le_response_of_rates
        (arrivalRate := arrivalRateNN) (serviceRate := serviceRateNN)
        (by exact_mod_cast harrival_pos)
        (by exact_mod_cast hstable))
  filter_upwards [hbusy_le_response] with ω hbusy_le n
  exact
    postTagFalseMarkTaggedServiceWork_nonneg
      (show 0 ≤ capacity * weight tag from
        (lt_trans harrival_pos hstable).le)
      (by simpa [postTagFalseMarkResponseFromState] using hbusy_le) n

/--
Selected-Palm all-arrivals source model for the source-defined chronological
finite-class GPS recurrence.  It records measurable backlog indicators,
and the invariant that unfinished tagged-class work is backlogged on every
guaranteed service window.  Nonnegative tagged-class work is derived from the
false-mark source.
-/
def physicalSelectedPalmTaggedGPSAllArrivalsSourceModelAE
    {arrivalRate capacity : ℝ}
    {ι : Type*} [Fintype ι] [DecidableEq ι] (tag : ι)
    (weight : ι → ℝ)
    (harrival_pos : 0 < arrivalRate)
