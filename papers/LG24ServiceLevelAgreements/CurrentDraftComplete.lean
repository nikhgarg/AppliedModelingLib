/--
All-times chronological service equations and the all-times physical backlog
definition imply the all-times remaining-work fixed point used by the GPS
source-model stack.
-/
theorem physicalTaggedInitialWorkVectorRemainingWorkDynamicsAllTimesAE_of_chronologicalServiceProcessAllTimes
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : Measure ((ℤ → ℝ) × (ℤ → (ℕ × Bool))))
    (tag : ι) (capacity : ℝ) (weight : ι → ℝ)
    (backlogged : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℝ → ι → Bool)
    (remainingWork :
      ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℝ → ι → ℝ)
    (cumulativeService :
      ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ι → ℝ → ℝ)
    (hprocess :
      physicalTaggedInitialWorkVectorChronologicalServiceProcessAllTimesAE
        P tag capacity weight backlogged remainingWork cumulativeService)
    (hall :
      physicalTaggedInitialWorkVectorBacklogEqualsPositiveRemainingWorkAllTimesAE
        P tag capacity weight backlogged remainingWork) :
    physicalTaggedInitialWorkVectorRemainingWorkDynamicsAllTimesAE
      P tag capacity weight remainingWork := by
  filter_upwards [hprocess, hall] with ω hω_process hω_backlog
  rcases hω_process with ⟨hinit, hevolution, hservice⟩
  intro i t
  have hbacklogged_eq :
      backlogged ω =
        TaggedJobGPSOpenBacklogIntegralSourcePath.gpsBackloggedFromRemainingWork
          (remainingWork ω) := by
    funext t i
    simpa [TaggedJobGPSOpenBacklogIntegralSourcePath.gpsBackloggedFromRemainingWork]
      using hω_backlog i t
  calc
    remainingWork ω t i =
        remainingWork ω (postTagFalseMarkBusyUntil (ω.2 0).1 ω) i -
          (cumulativeService ω i t -
            cumulativeService ω i
              (postTagFalseMarkBusyUntil (ω.2 0).1 ω)) := hevolution i t
    _ =
        physicalTaggedInitialWorkVector tag capacity weight ω i -
          ∫ u in (postTagFalseMarkBusyUntil (ω.2 0).1 ω)..t,
            gpsBackloggedClassRate ι i capacity weight (backlogged ω) u := by
      rw [hinit i, hservice i t]
    _ =
        TaggedJobGPSOpenBacklogIntegralSourcePath.gpsRemainingWorkVectorFrom
          (ι := ι)
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
          (physicalTaggedInitialWorkVector tag capacity weight ω)
          capacity weight
          (TaggedJobGPSOpenBacklogIntegralSourcePath.gpsBackloggedFromRemainingWork
            (remainingWork ω)) t i := by
      simp [TaggedJobGPSOpenBacklogIntegralSourcePath.gpsRemainingWorkVectorFrom,
        hbacklogged_eq]

