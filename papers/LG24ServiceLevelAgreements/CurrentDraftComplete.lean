/--
Exact isolated-FCFS specialization of the canonical renewal-service bridge.
The normalized-GPS path certificate is constructed internally from the FCFS
comparator on the a.e. event where all exponential service gaps are positive.

This closes the tag-only product-renewal comparator; it does not construct the
full multiclass physical GPS queue or the stationary/Palm arrival law.
-/
theorem gpsResponseTail_le_of_independentCanonicalRenewalFCFSExactAENormalizedGPS
    {Ω : Type*} [MeasurableSpace Ω]
    (tagged : AppliedModelingLib.Probability.Queueing.TaggedArrivalAtZero Ω)
    (arrivalRate : ℝ) (harrivalRate : 0 < arrivalRate)
    (serviceRate : ℝ) (hserviceRate : 0 < serviceRate)
    (hstable : arrivalRate < serviceRate)
    (queueLength : Ω → ℕ) (hqueueLength : Measurable queueLength)
    (hqueueTail : ∀ k : ℕ,
      tagged.Ptag.real {ω | k ≤ queueLength ω} = (arrivalRate / serviceRate) ^ k)
    (delay : ℝ) (hdelay : 0 ≤ delay) :
    (tagged.withCanonicalRenewalService serviceRate hserviceRate).Ptag.real
        {ω | delay ≤
          AppliedModelingLib.Probability.Queueing.responseTime
            AppliedModelingLib.Probability.Queueing.tagOnlyArrival
            ((AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
              (fun x : Ω × (ℕ → ℝ) => AppliedModelingLib.Probability.Queueing.preTagBusyUntil
                (queueLength x.1) x.2)
              (fun _ => AppliedModelingLib.Probability.Queueing.tagOnlyArrival)
              (fun x : Ω × (ℕ → ℝ) => AppliedModelingLib.Probability.Queueing.taggedServiceWork serviceRate
                (queueLength x.1) x.2)
              serviceRate) ω) 0} ≤
      gpsExponentialTailUpperBound (serviceRate - arrivalRate) delay := by
  let H :=
    AppliedModelingLib.Probability.Queueing.TaggedArrivalAtZero.withIndependentCanonicalRenewalResponseCountCertificate
      tagged arrivalRate harrivalRate serviceRate hserviceRate hstable
      queueLength hqueueLength hqueueTail
  let initialBusyUntil : Ω × (ℕ → ℝ) → ℝ :=
    fun x => AppliedModelingLib.Probability.Queueing.preTagBusyUntil (queueLength x.1) x.2
  let arrival : Ω × (ℕ → ℝ) → ℕ → ℝ :=
    fun _ => AppliedModelingLib.Probability.Queueing.tagOnlyArrival
  let work : Ω × (ℕ → ℝ) → ℕ → ℝ :=
    fun x => AppliedModelingLib.Probability.Queueing.taggedServiceWork serviceRate
      (queueLength x.1) x.2
  let departure : Ω × (ℕ → ℝ) → ℕ → ℝ :=
    AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
      initialBusyUntil arrival work serviceRate
  have hServiceRate : serviceRate = serviceRate * 1 := by ring
  have hwork_nonneg : ∀ᵐ x ∂H.Ptag,
      ∀ n : ℕ, 0 ≤ AppliedModelingLib.Probability.Queueing.taggedServiceWork serviceRate
        (queueLength x.1) x.2 n := by
    letI : MeasureTheory.IsProbabilityMeasure tagged.Ptag := tagged.isProbability
    letI : MeasureTheory.IsProbabilityMeasure
        (AppliedModelingLib.Probability.PoissonProcess.exponentialInterarrivalMeasure serviceRate) :=
      AppliedModelingLib.Probability.PoissonProcess.isProbabilityMeasure_exponentialInterarrivalMeasure
        hserviceRate
    change ∀ᵐ x ∂tagged.Ptag.prod
        (AppliedModelingLib.Probability.PoissonProcess.exponentialInterarrivalMeasure serviceRate),
      ∀ n : ℕ, 0 ≤ AppliedModelingLib.Probability.Queueing.taggedServiceWork serviceRate
        (queueLength x.1) x.2 n
    have hpos_prod : ∀ᵐ x ∂tagged.Ptag.prod
        (AppliedModelingLib.Probability.PoissonProcess.exponentialInterarrivalMeasure serviceRate),
        ∀ i : ℕ, 0 < AppliedModelingLib.Probability.PoissonProcess.interarrival i x.2 := by
      refine ae_of_ae_map
        (μ := tagged.Ptag.prod
          (AppliedModelingLib.Probability.PoissonProcess.exponentialInterarrivalMeasure serviceRate))
        (f := Prod.snd)
        (p := fun g : ℕ → ℝ =>
          ∀ i : ℕ, 0 < AppliedModelingLib.Probability.PoissonProcess.interarrival i g)
        measurable_snd.aemeasurable ?_
      rw [Measure.map_snd_prod, measure_univ, one_smul]
      exact AppliedModelingLib.Probability.PoissonProcess.ae_all_interarrival_positive hserviceRate
    filter_upwards [hpos_prod] with x hx n
    by_cases hn : n = 0
    · subst n
      simp [AppliedModelingLib.Probability.Queueing.taggedServiceWork,
        mul_nonneg hserviceRate.le
          (hx (queueLength x.1)).le]
    · simp [AppliedModelingLib.Probability.Queueing.taggedServiceWork, hn]
  have hfluid : ∀ᵐ x ∂H.Ptag,
      Nonempty (AppliedModelingLib.Probability.Queueing.CoupledAENormalizedIdealFluidGPSPath
        (initialBusyUntil x) (arrival x) (work x) (departure x) serviceRate 1) := by
    filter_upwards [hwork_nonneg] with x hx
    refine ⟨?_⟩
