/--
Bridge the geometric stationary-base-law premise of the Palm/PASTA wrapper
from the existing uniformized embedded M/M/1 trajectory.  The caller still
supplies the real-time shift-invariant base law, the Palm/PASTA certificate,
and the identifications of that base law and queue-state coordinate with the
one-sided trajectory.  Thus this theorem does not construct a Palm law or
infer PASTA from the arrival rate.
-/
theorem stationaryTrajectoryBase_queueLength_hasLaw_mm1Geometric
    {Ωtag : Type*} [MeasurableSpace Ωtag]
    {base : AppliedModelingLib.Probability.Palm.ShiftInvariantProbabilityLaw (ℕ → ℕ)}
    {tagged : AppliedModelingLib.Probability.Queueing.TaggedArrivalAtZero Ωtag}
    (HP : AppliedModelingLib.Probability.Palm.PalmPASTAQueueLengthCertificate
      (ℕ → ℕ) Ωtag base tagged)
    (arrivalRate : ℝ) (harrivalRate : 0 < arrivalRate)
    (service : AppliedModelingLib.Probability.PoissonProcess.ForwardHomogeneousPoissonCountingProcessByLaw
      Ωtag tagged.Ptag)
    (hstable : arrivalRate < service.rate)
    (rho : NNReal) (hrho : rho < 1)
    (hrho_eq : (rho : ℝ) = arrivalRate / service.rate) (n : ℕ)
    (hbase : base.Pbase = AppliedModelingLib.Probability.Queueing.stationaryTrajMeasure
      (AppliedModelingLib.Probability.Queueing.geoNNPMF rho hrho).toMeasure
      (AppliedModelingLib.Probability.Queueing.countablePMFKernel
        (AppliedModelingLib.Probability.Queueing.reflectedBirthDeathKernel
          (AppliedModelingLib.Probability.Queueing.uniformizedBirthProbability rho)
          (AppliedModelingLib.Probability.Queueing.uniformizedBirthProbability_le_one rho))))
    (hqueue : HP.stationaryQueueLength = fun x : ℕ → ℕ => x n) :
    ProbabilityTheory.HasLaw HP.stationaryQueueLength
      (ProbabilityTheory.geometricMeasure (p := 1 - arrivalRate / service.rate)
        (sub_pos.mpr (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_lt_one
          hstable service.rate_pos))
        (sub_le_self 1 (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_nonneg
          (le_of_lt harrivalRate) service.rate_pos))) base.Pbase := by
  have hgeo : ProbabilityTheory.HasLaw HP.stationaryQueueLength
      (ProbabilityTheory.geometricMeasure (p := 1 - (rho : ℝ))
        (sub_pos.mpr (by exact_mod_cast hrho))
        (sub_le_self 1 (by positivity : 0 ≤ (rho : ℝ)))) base.Pbase := by
    refine ⟨?_, ?_⟩
    · rw [hqueue]
      exact (measurable_pi_apply n).aemeasurable
    · rw [hqueue, hbase]
      calc
        _ = (AppliedModelingLib.Probability.Queueing.geoNNPMF rho hrho).toMeasure :=
          AppliedModelingLib.Probability.Queueing.geoNNPMF_uniformized_stationaryTraj_marginal
            rho hrho n
        _ = ProbabilityTheory.geometricMeasure (p := 1 - (rho : ℝ))
            (sub_pos.mpr (by exact_mod_cast hrho))
            (sub_le_self 1 (by positivity : 0 ≤ (rho : ℝ))) :=
          AppliedModelingLib.Probability.Queueing.geoNNPMF_toMeasure_eq_geometricMeasure rho hrho
  simpa only [hrho_eq] using hgeo

