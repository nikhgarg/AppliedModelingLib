/--
The concrete tagged-initial-work backlog self-consistency condition gives the
open-backlog implication actually used by the response comparison: positive
tagged remaining work on the guaranteed service window implies tagged backlog.
-/
theorem physicalTaggedInitialWorkVectorBacklogSelfConsistentOnGuaranteedWindow_backlogged_of_positive_remainingWork
    {ι : Type*} [Fintype ι] [DecidableEq ι] (tag : ι)
    (capacity : ℝ) (weight : ι → ℝ)
    (ω : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))))
    (backlogged : ℝ → ι → Bool)
    (hself :
      physicalTaggedInitialWorkVectorBacklogSelfConsistentOnGuaranteedWindow
        tag capacity weight ω backlogged) :
    ∀ t,
      t ∈ Set.Ioo
        (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
        (postTagFalseMarkBusyUntil (ω.2 0).1 ω +
          postTagFalseMarkTaggedServiceWork (capacity * weight tag)
            (ω.2 0).1 ω 0 /
            (capacity * weight tag)) →
      0 <
        TaggedJobGPSOpenBacklogIntegralSourcePath.gpsRemainingWorkVectorFrom
          (ι := ι)
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
          (physicalTaggedInitialWorkVector tag capacity weight ω)
          capacity weight backlogged t tag →
      backlogged t tag = true := by
  intro t ht hpositive
  rw [hself t ht]
  simp [hpositive]

