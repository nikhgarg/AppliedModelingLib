tagged initial-work vector.  Remaining work starts from the concrete
selected-Palm initial work, evolves by subtracting cumulative class service,
and the cumulative-service increments are the backlog-induced GPS rate
integrals.
-/
def physicalTaggedInitialWorkVectorChronologicalServiceProcessOnGuaranteedWindow
    {ι : Type*} [Fintype ι] [DecidableEq ι] (tag : ι)
    (capacity : ℝ) (weight : ι → ℝ)
    (ω : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))))
    (backlogged : ℝ → ι → Bool) (remainingWork : ℝ → ι → ℝ)
    (cumulativeService : ι → ℝ → ℝ) : Prop :=
  (∀ i,
    remainingWork (postTagFalseMarkBusyUntil (ω.2 0).1 ω) i =
      physicalTaggedInitialWorkVector tag capacity weight ω i) ∧
  (∀ i t,
    t ∈ Set.Ioo
      (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
      (postTagFalseMarkBusyUntil (ω.2 0).1 ω +
        postTagFalseMarkTaggedServiceWork (capacity * weight tag)
          (ω.2 0).1 ω 0 /
          (capacity * weight tag)) →
    remainingWork t i =
      remainingWork (postTagFalseMarkBusyUntil (ω.2 0).1 ω) i -
        (cumulativeService i t -
          cumulativeService i (postTagFalseMarkBusyUntil (ω.2 0).1 ω))) ∧
  (∀ i t,
    t ∈ Set.Ioo
      (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
      (postTagFalseMarkBusyUntil (ω.2 0).1 ω +
        postTagFalseMarkTaggedServiceWork (capacity * weight tag)
          (ω.2 0).1 ω 0 /
          (capacity * weight tag)) →
    cumulativeService i t -
        cumulativeService i (postTagFalseMarkBusyUntil (ω.2 0).1 ω) =
      ∫ u in (postTagFalseMarkBusyUntil (ω.2 0).1 ω)..t,
        gpsBackloggedClassRate ι i capacity weight backlogged u)

