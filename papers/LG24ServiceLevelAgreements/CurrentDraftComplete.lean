  simp [multiplicativeSLAConstraint, not_le, hlogTail]

/-- A zero-day SLA is infeasible when the log-tail parameter is positive. -/
theorem zeroDelay_infeasible
    {slack logTail : ℝ} (hlogTail : 0 < logTail) :
    ¬ multiplicativeSLAConstraint slack 0 logTail := by
  simp [multiplicativeSLAConstraint, not_le, hlogTail]

/-! ## Original and reformulated finite-dimensional constraints -/

/-- Binding delay associated with positive slack `x`. -/
def bindingSLADelay (logTail x : ℝ) : ℝ :=
  logTail / x

/-- The binding delay satisfies the original multiplicative SLA exactly. -/
theorem bindingSLADelay_mul_slack
    {logTail x : ℝ} (hx : x ≠ 0) :
    x * bindingSLADelay logTail x = logTail := by
  unfold bindingSLADelay
  field_simp [hx]

/-- For positive slack, original SLA feasibility is a reciprocal lower bound. -/
theorem multiplicativeSLAConstraint_iff_delay_ge_binding
    {slack delay logTail : ℝ} (hslack : 0 < slack) :
    multiplicativeSLAConstraint slack delay logTail ↔
      bindingSLADelay logTail slack ≤ delay := by
  unfold multiplicativeSLAConstraint bindingSLADelay
  constructor
  · intro h
    exact (div_le_iff₀ hslack).2 (by simpa [mul_comm] using h)
  · intro h
    have := (div_le_iff₀ hslack).1 h
    simpa [mul_comm] using this

/-- A feasible delay can always be tightened to the binding reciprocal delay. -/
theorem bindingSLADelay_le_of_feasible
    {slack delay logTail : ℝ} (hslack : 0 < slack)
    (hsla : multiplicativeSLAConstraint slack delay logTail) :
    bindingSLADelay logTail slack ≤ delay :=
  (multiplicativeSLAConstraint_iff_delay_ge_binding hslack).1 hsla

/-- Any coordinatewise nondecreasing scalar loss weakly improves after tightening. -/
theorem monotoneLoss_allows_binding_tightening
    {loss : ℝ → ℝ} (hloss : Monotone loss)
    {slack delay logTail : ℝ} (hslack : 0 < slack)
    (hsla : multiplicativeSLAConstraint slack delay logTail) :
    loss (bindingSLADelay logTail slack) ≤ loss delay :=
  hloss (bindingSLADelay_le_of_feasible hslack hsla)

/--
A flat nondecreasing objective has a feasible nonbinding point, so monotonicity
alone does not imply that every optimum binds.
-/
theorem flatLoss_nonbinding_optimum_counterexample :
    Monotone (fun _ : ℝ ↦ 0) ∧
      multiplicativeSLAConstraint 1 2 1 ∧
      bindingSLADelay 1 1 = 1 ∧
      (2 : ℝ) ≠ bindingSLADelay 1 1 := by
  constructor
  · intro _ _ _
    rfl
  · norm_num [multiplicativeSLAConstraint, bindingSLADelay]

/-- Reconstructed GPS weights for a finite family of active classes. -/
def reconstructedWeight {I : Type*}
    (x arrivalRate : I → ℝ) (capacity : ℝ) (i : I) : ℝ :=
  (x i + arrivalRate i) / capacity

/-- Reconstructing a weight recovers every slack coordinate. -/
theorem reconstructedWeight_recovers_slack
    {I : Type*} {x arrivalRate : I → ℝ} {capacity : ℝ}
    (hcapacity : capacity ≠ 0) (i : I) :
    gpsSlack capacity (reconstructedWeight x arrivalRate capacity i)
      (arrivalRate i) = x i := by
  unfold reconstructedWeight
  exact proposition2_1_recoveredGPSWeight_slack_eq hcapacity

/-- The reconstructed weights' finite sum has the expected numerator. -/
theorem sum_reconstructedWeight_eq
    {I : Type*} (indices : Finset I) (x arrivalRate : I → ℝ)
    (capacity : ℝ) :
    ∑ i ∈ indices, reconstructedWeight x arrivalRate capacity i =
      ((∑ i ∈ indices, x i) + ∑ i ∈ indices, arrivalRate i) /
        capacity := by
  unfold reconstructedWeight
  rw [← Finset.sum_div]
  congr 1
  rw [Finset.sum_add_distrib]

/--
For positive Borough capacity, the original GPS weight-sum constraint for the
reconstructed weights is equivalent to the reformulated slack constraint.
-/
theorem reconstructedWeight_sum_le_one_iff
    {I : Type*} (indices : Finset I) (x arrivalRate : I → ℝ)
    {capacity : ℝ} (hcapacity : 0 < capacity) :
    (∑ i ∈ indices, reconstructedWeight x arrivalRate capacity i) ≤ 1 ↔
      (∑ i ∈ indices, x i) ≤
        capacity - ∑ i ∈ indices, arrivalRate i := by
  rw [sum_reconstructedWeight_eq indices x arrivalRate capacity]
  rw [div_le_iff₀ hcapacity]
  constructor <;> intro h <;> linarith

/--
The current manuscript's source-literal minus-sign reconstruction is not the
inverse of the slack substitution; the corrected finite-dimensional map is the
one above.  This is a second symbolic statement, complementing the numerical
counterexample in `CurrentDraftAlgebra`.
-/
theorem printedMinusWeight_induces_shifted_slack
    {x arrivalRate capacity : ℝ} (hcapacity : capacity ≠ 0) :
    gpsSlack capacity (printedMinusGPSWeight x arrivalRate capacity) arrivalRate =
      x - 2 * arrivalRate := by
  unfold gpsSlack printedMinusGPSWeight
  field_simp [hcapacity]
  ring

/-! ## Current cost, efficiency, and equity definitions -/

/-- Current-paper risk-weighted Borough cost. -/
def currentBoroughCost {K : Type*} (categories : Finset K)
    (arrivalRate risk delay : K → ℝ) : ℝ :=
  ∑ k ∈ categories, arrivalRate k * risk k * delay k

/-- Current-paper efficiency loss, the sum of Borough costs. -/
def currentEfficiencyLoss {B : Type*} (boroughs : Finset B)
    (cost : B → ℝ) : ℝ :=
  ∑ b ∈ boroughs, cost b

/-- Current-paper equity loss, the largest Borough cost in a nonempty family. -/
def currentEquityLoss {B : Type*} (boroughs : Finset B)
    (hne : boroughs.Nonempty) (cost : B → ℝ) : ℝ :=
  boroughs.sup' hne cost

/-- Current convex-combination objective. -/
def currentCombinedLoss (gamma efficiency equity : ℝ) : ℝ :=
  gamma * efficiency + (1 - gamma) * equity

/-- The one-cell Borough cost uses the coefficient `lambda * r`. -/
theorem currentBoroughCost_singleton
    {K : Type*} [DecidableEq K] (k : K)
    (arrivalRate risk delay : K → ℝ) :
    currentBoroughCost {k} arrivalRate risk delay =
      arrivalRate k * risk k * delay k := by
  simp [currentBoroughCost]

/-- Dropping `lambda` in the endpoint proof changes the coefficient in general. -/
theorem printedExtremeEfficiency_droppedArrival_counterexample :
    (2 : ℝ) * 3 ≠ 3 := by norm_num

/-- Equal corrected reciprocal burdens give equal Borough costs after binding. -/
theorem correctedReciprocalParity_implies_costParity
    {arrivalOne riskOne xOne arrivalTwo riskTwo xTwo logTail : ℝ}
    (hparity : arrivalOne * riskOne / xOne =
      arrivalTwo * riskTwo / xTwo) :
    arrivalOne * riskOne * bindingSLADelay logTail xOne =
      arrivalTwo * riskTwo * bindingSLADelay logTail xTwo := by
  unfold bindingSLADelay at *
  calc
    arrivalOne * riskOne * (logTail / xOne) =
        logTail * (arrivalOne * riskOne / xOne) := by ring
    _ = logTail * (arrivalTwo * riskTwo / xTwo) := by rw [hparity]
    _ = arrivalTwo * riskTwo * (logTail / xTwo) := by ring

/-! ## Two-cell endpoint optimality -/

/-- Reciprocal efficiency objective for two positive slack cells. -/
def twoCellReciprocalCost (u v x y : ℝ) : ℝ :=
  u ^ 2 / x + v ^ 2 / y

/-- Exact square-gap identity behind the two-cell efficiency endpoint. -/
theorem twoCellReciprocalCost_gap_identity
    {u v x y : ℝ} (hx : x ≠ 0) (hy : y ≠ 0)
    (hsum : x + y ≠ 0) :
    twoCellReciprocalCost u v x y - (u + v) ^ 2 / (x + y) =
      (u * y - v * x) ^ 2 / (x * y * (x + y)) := by
  unfold twoCellReciprocalCost
  field_simp [hx, hy, hsum]
  ring

/-- The efficiency endpoint gives the global lower bound for two positive cells. -/
theorem twoCellReciprocalCost_lower_bound
    {u v x y : ℝ} (hx : 0 < x) (hy : 0 < y) :
    (u + v) ^ 2 / (x + y) ≤ twoCellReciprocalCost u v x y := by
  have hsum : 0 < x + y := add_pos hx hy
  rw [← sub_nonneg]
  rw [twoCellReciprocalCost_gap_identity hx.ne' hy.ne' hsum.ne']
  positivity

/-- Square-root-proportional slack assigned to the first cell. -/
def efficientSlackOne (slack u v : ℝ) : ℝ :=
  slack * u / (u + v)

/-- Square-root-proportional slack assigned to the second cell. -/
def efficientSlackTwo (slack u v : ℝ) : ℝ :=
  slack * v / (u + v)

/-- The two efficient slacks exhaust the available slack. -/
theorem efficientSlacks_sum
    {slack u v : ℝ} (hsum : u + v ≠ 0) :
    efficientSlackOne slack u v + efficientSlackTwo slack u v = slack := by
  unfold efficientSlackOne efficientSlackTwo
  field_simp [hsum]

/-- The proposed efficient slacks are positive for positive primitives. -/
theorem efficientSlacks_positive
    {slack u v : ℝ} (hslack : 0 < slack) (hu : 0 < u) (hv : 0 < v) :
    0 < efficientSlackOne slack u v ∧
      0 < efficientSlackTwo slack u v := by
  constructor
  · unfold efficientSlackOne
    positivity
  · unfold efficientSlackTwo
    positivity

/-- The square-root-proportional allocation attains the lower bound. -/
theorem efficientSlacks_attain_lower_bound
    {slack u v : ℝ} (hslack : slack ≠ 0)
    (hsum : u + v ≠ 0) :
    twoCellReciprocalCost u v
        (efficientSlackOne slack u v) (efficientSlackTwo slack u v) =
      (u + v) ^ 2 / slack := by
  unfold twoCellReciprocalCost efficientSlackOne efficientSlackTwo
  field_simp [hslack, hsum]

/-- Largest of the two reciprocal Borough costs. -/
def twoCellEquityObjective (u v x y : ℝ) : ℝ :=
  max (u ^ 2 / x) (v ^ 2 / y)

/-- Equal-cost slack for the first Borough. -/
def equitableSlackOne (slack u v : ℝ) : ℝ :=
  slack * u ^ 2 / (u ^ 2 + v ^ 2)

/-- Equal-cost slack for the second Borough. -/
def equitableSlackTwo (slack u v : ℝ) : ℝ :=
  slack * v ^ 2 / (u ^ 2 + v ^ 2)

/-- The equal-cost slacks exhaust the available slack. -/
theorem equitableSlacks_sum
    {slack u v : ℝ} (hdenom : u ^ 2 + v ^ 2 ≠ 0) :
    equitableSlackOne slack u v + equitableSlackTwo slack u v = slack := by
  unfold equitableSlackOne equitableSlackTwo
  field_simp [hdenom]

/-- Any positive two-cell allocation has max cost at least `(u²+v²)/slack`. -/
theorem twoCellEquityObjective_lower_bound
    {u v x y slack : ℝ} (hx : 0 < x) (hy : 0 < y)
    (hslack : 0 < slack) (hsum : x + y = slack) :
    (u ^ 2 + v ^ 2) / slack ≤ twoCellEquityObjective u v x y := by
  let M := twoCellEquityObjective u v x y
  have h1 : u ^ 2 / x ≤ M := le_max_left _ _
  have h2 : v ^ 2 / y ≤ M := le_max_right _ _
  have h1' := mul_le_mul_of_nonneg_left h1 hx.le
  have h2' := mul_le_mul_of_nonneg_left h2 hy.le
  have hxid : x * (u ^ 2 / x) = u ^ 2 := by field_simp
  have hyid : y * (v ^ 2 / y) = v ^ 2 := by field_simp
  rw [hxid] at h1'
  rw [hyid] at h2'
  rw [div_le_iff₀ hslack]
  dsimp [M] at *
  nlinarith

/-- The equal-cost allocation gives identical Borough reciprocal costs. -/
theorem equitableSlacks_equal_costs
    {slack u v : ℝ} (hslack : slack ≠ 0)
    (hu : u ≠ 0) (hv : v ≠ 0)
    (hdenom : u ^ 2 + v ^ 2 ≠ 0) :
    u ^ 2 / equitableSlackOne slack u v =
        (u ^ 2 + v ^ 2) / slack ∧
      v ^ 2 / equitableSlackTwo slack u v =
        (u ^ 2 + v ^ 2) / slack := by
  constructor
  · unfold equitableSlackOne
    field_simp [hslack, hu, hdenom]
  · unfold equitableSlackTwo
    field_simp [hslack, hv, hdenom]

/-- Thus the equal-cost allocation attains the two-cell equity lower bound. -/
theorem equitableSlacks_attain_lower_bound
    {slack u v : ℝ} (hslack : slack ≠ 0)
    (hu : u ≠ 0) (hv : v ≠ 0)
    (hdenom : u ^ 2 + v ^ 2 ≠ 0) :
    twoCellEquityObjective u v
        (equitableSlackOne slack u v) (equitableSlackTwo slack u v) =
      (u ^ 2 + v ^ 2) / slack := by
  rcases equitableSlacks_equal_costs hslack hu hv hdenom with ⟨h1, h2⟩
  unfold twoCellEquityObjective
  rw [h1, h2, max_self]

/-! ## Corrected centralization strictness and singleton boundary -/

/-- One-category city-pooled endpoint, written in square-root coordinates. -/
def oneCategoryCitySLA (logTail slack : ℝ) : ℝ :=
  logTail / slack

/-- Borough 1's one-category efficiency endpoint. -/
def oneCategoryBoroughOneSLA
    (logTail slack u v : ℝ) : ℝ :=
  logTail / slack * (u + v) / u

/-- Borough 2's one-category efficiency endpoint. -/
def oneCategoryBoroughTwoSLA
    (logTail slack u v : ℝ) : ℝ :=
  logTail / slack * (u + v) / v

/-- Strict square-root subadditivity for two strictly positive pooled loads. -/
theorem sqrt_add_lt_add_sqrt_of_pos
    {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    Real.sqrt (a + b) < Real.sqrt a + Real.sqrt b := by
  have hab : 0 ≤ a + b := (add_pos ha hb).le
  have hsa : 0 < Real.sqrt a := Real.sqrt_pos.2 ha
  have hsb : 0 < Real.sqrt b := Real.sqrt_pos.2 hb
  have hsab : 0 ≤ Real.sqrt (a + b) := Real.sqrt_nonneg _
  have ha_sq : (Real.sqrt a) ^ 2 = a := Real.sq_sqrt ha.le
  have hb_sq : (Real.sqrt b) ^ 2 = b := Real.sq_sqrt hb.le
  have hab_sq : (Real.sqrt (a + b)) ^ 2 = a + b := Real.sq_sqrt hab
  nlinarith [mul_pos hsa hsb]

/--
Abstract algebraic core of corrected Proposition 2.6.  It exposes exactly the
strict pooled-numerator hypothesis and the weak denominator comparison needed
for a strict endpoint improvement.
-/
theorem abstractCentralizedEndpoint_strictly_better
    {logTail slack cityNumerator boroughNumerator
      cityDenominator boroughDenominator : ℝ}
    (hlogTail : 0 < logTail) (hslack : 0 < slack)
    (hcityNumerator : 0 ≤ cityNumerator)
    (hnumerators : cityNumerator < boroughNumerator)
    (hboroughDenominator : 0 < boroughDenominator)
    (hdenominators : boroughDenominator ≤ cityDenominator) :
    logTail / slack * cityNumerator / cityDenominator <
      logTail / slack * boroughNumerator / boroughDenominator := by
  have hcityDenominator : 0 < cityDenominator :=
    lt_of_lt_of_le hboroughDenominator hdenominators
  have hboroughNumerator : 0 < boroughNumerator :=
    lt_of_le_of_lt hcityNumerator hnumerators
  have hcross1 : cityNumerator * boroughDenominator <
      boroughNumerator * boroughDenominator :=
    mul_lt_mul_of_pos_right hnumerators hboroughDenominator
  have hcross2 : boroughNumerator * boroughDenominator ≤
      boroughNumerator * cityDenominator :=
    mul_le_mul_of_nonneg_left hdenominators hboroughNumerator.le
  have hratio : cityNumerator / cityDenominator <
      boroughNumerator / boroughDenominator := by
    rw [div_lt_div_iff₀ hcityDenominator hboroughDenominator]
    exact hcross1.trans_le hcross2
  have hscale : 0 < logTail / slack := div_pos hlogTail hslack
  have := mul_lt_mul_of_pos_left hratio hscale
  simpa [div_eq_mul_inv, mul_assoc] using this

/-- With two strictly positive risk-weighted loads, pooling strictly helps Borough 1. -/
theorem oneCategoryCitySLA_lt_boroughOne
    {logTail slack u v : ℝ}
    (hlogTail : 0 < logTail) (hslack : 0 < slack)
    (hu : 0 < u) (hv : 0 < v) :
    oneCategoryCitySLA logTail slack <
      oneCategoryBoroughOneSLA logTail slack u v := by
  unfold oneCategoryCitySLA oneCategoryBoroughOneSLA
  have hscale : 0 < logTail / slack := div_pos hlogTail hslack
  have hratio : 1 < (u + v) / u := by
    rw [lt_div_iff₀ hu]
    linarith
  calc
    logTail / slack = (logTail / slack) * 1 := by ring
    _ < (logTail / slack) * ((u + v) / u) :=
      mul_lt_mul_of_pos_left hratio hscale
    _ = logTail / slack * (u + v) / u := by ring

/-- With two strictly positive risk-weighted loads, pooling strictly helps Borough 2. -/
theorem oneCategoryCitySLA_lt_boroughTwo
    {logTail slack u v : ℝ}
    (hlogTail : 0 < logTail) (hslack : 0 < slack)
    (hu : 0 < u) (hv : 0 < v) :
    oneCategoryCitySLA logTail slack <
      oneCategoryBoroughTwoSLA logTail slack u v := by
  unfold oneCategoryCitySLA oneCategoryBoroughTwoSLA
  have hscale : 0 < logTail / slack := div_pos hlogTail hslack
  have hratio : 1 < (u + v) / v := by
    rw [lt_div_iff₀ hv]
    linarith
  calc
    logTail / slack = (logTail / slack) * 1 := by ring
    _ < (logTail / slack) * ((u + v) / v) :=
      mul_lt_mul_of_pos_left hratio hscale
    _ = logTail / slack * (u + v) / v := by ring

/-- With a merely nonnegative second load, pooling gives only a weak comparison. -/
theorem oneCategoryCitySLA_le_boroughOne
    {logTail slack u v : ℝ}
    (hlogTail : 0 ≤ logTail) (hslack : 0 < slack)
    (hu : 0 < u) (hv : 0 ≤ v) :
    oneCategoryCitySLA logTail slack ≤
      oneCategoryBoroughOneSLA logTail slack u v := by
  unfold oneCategoryCitySLA oneCategoryBoroughOneSLA
  have hscale : 0 ≤ logTail / slack := div_nonneg hlogTail hslack.le
  have hratio : 1 ≤ (u + v) / u := by
    rw [le_div_iff₀ hu]
    linarith
  calc
    logTail / slack = (logTail / slack) * 1 := by ring
    _ ≤ (logTail / slack) * ((u + v) / u) :=
      mul_le_mul_of_nonneg_left hratio hscale
    _ = logTail / slack * (u + v) / u := by ring

/--
Singleton counterexample to the draft's unqualified strict Proposition 2.6:
with no second Borough load, pooled and Borough-specific endpoints coincide.
-/
theorem proposition2_6_singleton_counterexample
    {logTail slack u : ℝ} (hu : u ≠ 0) :
    oneCategoryCitySLA logTail slack =
      oneCategoryBoroughOneSLA logTail slack u 0 := by
  simp [oneCategoryCitySLA, oneCategoryBoroughOneSLA, hu]

/-! ## Methods-section domain and indexing repairs -/

/-- A conditional SLA endpoint is active only for a positive admitted rate. -/
def conditionalSLAActive (admittedRate : ℝ) : Prop :=
  0 < admittedRate

/-- A zero-admission cell is outside the active conditional-SLA domain. -/
theorem zeroAdmission_not_conditionalSLAActive :
    ¬ conditionalSLAActive 0 := by
  simp [conditionalSLAActive]

/--
The written conditional SLA constraint itself contains no admission fraction;
setting that fraction to zero therefore cannot imply a zero-day SLA.
-/
theorem zeroAdmission_positiveSLA_constraint_example :
    multiplicativeSLAConstraint 1 1 1 ∧ (0 : ℝ) = 0 := by
  norm_num [multiplicativeSLAConstraint]

/-- Correctly indexed empirical all-request cell cost. -/
def empiricalAllRequestCellCost
    (requestCount risk inspectedFraction inspectedDelay dropPenalty : ℝ) : ℝ :=
  requestCount * risk *
    (inspectedFraction * inspectedDelay +
      dropPenalty * (1 - inspectedFraction))

/-- At zero inspection, all requests incur the noninspection burden. -/
theorem empiricalAllRequestCellCost_zero_inspection
    (requestCount risk inspectedDelay dropPenalty : ℝ) :
    empiricalAllRequestCellCost requestCount risk 0 inspectedDelay dropPenalty =
      requestCount * risk * dropPenalty := by
  unfold empiricalAllRequestCellCost
  ring

/-- Source-literal empirical cell term, missing `N` on noninspection burden. -/
def printedEmpiricalCellCost
    (requestCount risk inspectedFraction inspectedDelay dropPenalty : ℝ) : ℝ :=
  requestCount * inspectedFraction * risk * inspectedDelay +
    dropPenalty * risk * (1 - inspectedFraction)

/-- Exact discrepancy caused by the missing request-count factor. -/
theorem correctedEmpiricalCost_sub_printed
    (requestCount risk inspectedFraction inspectedDelay dropPenalty : ℝ) :
    empiricalAllRequestCellCost requestCount risk inspectedFraction
        inspectedDelay dropPenalty -
      printedEmpiricalCellCost requestCount risk inspectedFraction
        inspectedDelay dropPenalty =
      (requestCount - 1) * risk * dropPenalty * (1 - inspectedFraction) := by
  unfold empiricalAllRequestCellCost printedEmpiricalCellCost
  ring

/-- Numerical witness that the printed and corrected empirical costs differ. -/
theorem printedEmpiricalCost_missingCount_counterexample :
    printedEmpiricalCellCost 10 2 0 7 100 = 200 ∧
      empiricalAllRequestCellCost 10 2 0 7 100 = 2000 := by
  norm_num [printedEmpiricalCellCost, empiricalAllRequestCellCost]

/-- Correct category-scoped empirical Borough cost. -/
def empiricalBoroughCost {K : Type*} (categories : Finset K)
    (requestCount risk inspectedFraction inspectedDelay dropPenalty : K → ℝ) : ℝ :=
  ∑ k ∈ categories, empiricalAllRequestCellCost
    (requestCount k) (risk k) (inspectedFraction k)
    (inspectedDelay k) (dropPenalty k)

/-- The singleton Borough formula binds every category-dependent parameter. -/
theorem empiricalBoroughCost_singleton
    {K : Type*} [DecidableEq K] (k : K)
    (requestCount risk inspectedFraction inspectedDelay dropPenalty : K → ℝ) :
    empiricalBoroughCost {k} requestCount risk inspectedFraction
        inspectedDelay dropPenalty =
      empiricalAllRequestCellCost (requestCount k) (risk k)
        (inspectedFraction k) (inspectedDelay k) (dropPenalty k) := by
  simp [empiricalBoroughCost]

/-- The appendix's `C₂-λ₁` typo differs from the local `C₂-λ₂`. -/
theorem boroughTwo_remainingCapacity_index_counterexample :
    (10 : ℝ) - 3 ≠ 10 - 4 := by norm_num

