theorem physicalTaggedInitialWorkVectorChronologicalServiceProcessAllTimesAE_of_cumulativeServiceBalanceAllTimes
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : Measure ((ℤ → ℝ) × (ℤ → (ℕ × Bool))))
    (tag : ι) (capacity : ℝ) (weight : ι → ℝ)
