/--
Almost-sure tagged-job source path for the source-defined GPS departure
recurrence, constructed from finite-class remaining-work dynamics initialized
by the concrete selected-Palm tagged initial-work vector.
-/
theorem physicalTaggedInitialWorkVectorCanonicalBacklogStateSourcePathAE_of_remainingWorkDynamics
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : Measure ((ℤ → ℝ) × (ℤ → (ℕ × Bool))))
    (tag : ι) (capacity : ℝ) (weight : ι → ℝ)
    (hcapacity : 0 ≤ capacity)
    (hweight_nonneg : ∀ i, 0 ≤ weight i)
    (htotal_weight_le_one : Finset.univ.sum weight ≤ 1)
    (htagged_guaranteed_rate_pos : 0 < capacity * weight tag)
    (remainingWork :
      ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℝ → ι → ℝ)
    (hremaining_meas : ∀ᵐ ω ∂P, ∀ i,
      Measurable (fun t => remainingWork ω t i))
    (hbusy_nonneg : ∀ᵐ ω ∂P,
      0 ≤ postTagFalseMarkBusyUntil (ω.2 0).1 ω)
    (hwork_nonneg : ∀ᵐ ω ∂P,
      0 ≤ postTagFalseMarkTaggedServiceWork (capacity * weight tag)
        (ω.2 0).1 ω 0)
    (hdynamics :
      physicalTaggedInitialWorkVectorRemainingWorkDynamicsAE
        P tag capacity weight remainingWork) :
    ∀ᵐ ω ∂P,
      Nonempty
        (TaggedJobGPSOpenBacklogIntegralSourcePath.TaggedJobGPSCanonicalBacklogStateSourcePath
          ι tag
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
          tagOnlyArrival
          (postTagFalseMarkTaggedServiceWork (capacity * weight tag)
            (ω.2 0).1 ω)
          (TaggedJobGPSOpenBacklogIntegralSourcePath.gpsBackloggedDepartureFrom
            (ι := ι) (tag := tag)
            (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
            tagOnlyArrival
            (postTagFalseMarkTaggedServiceWork (capacity * weight tag)
              (ω.2 0).1 ω)
            capacity weight
            (TaggedJobGPSOpenBacklogIntegralSourcePath.gpsBackloggedFromRemainingWork
              (remainingWork ω)))
          capacity weight) := by
  filter_upwards [hremaining_meas, hbusy_nonneg, hwork_nonneg, hdynamics] with
    ω hmeas hbusy hwork hdyn
  refine ⟨
    TaggedJobGPSOpenBacklogIntegralSourcePath.TaggedJobGPSCanonicalBacklogStateSourcePath.ofSourceGPSDepartureFromRemainingWorkVector
      (ι := ι) (tag := tag)
      (initialBusyUntil := postTagFalseMarkBusyUntil (ω.2 0).1 ω)
      (arrival := tagOnlyArrival)
      (work := postTagFalseMarkTaggedServiceWork (capacity * weight tag)
        (ω.2 0).1 ω)
      (capacity := capacity) (weight := weight)
      hcapacity hweight_nonneg htotal_weight_le_one
      htagged_guaranteed_rate_pos
      (physicalTaggedInitialWorkVector tag capacity weight ω)
      (remainingWork ω) hmeas hwork
      (physicalTaggedInitialWorkVector_tag tag capacity weight ω) ?_⟩
  intro t ht
  have hmax :
      max (tagOnlyArrival 0) (postTagFalseMarkBusyUntil (ω.2 0).1 ω) =
        postTagFalseMarkBusyUntil (ω.2 0).1 ω := by
    simp [tagOnlyArrival, max_eq_right hbusy]
  have ht_busy : t ∈ Set.Ioo
      (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
      (postTagFalseMarkBusyUntil (ω.2 0).1 ω +
        postTagFalseMarkTaggedServiceWork (capacity * weight tag)
          (ω.2 0).1 ω 0 /
          (capacity * weight tag)) := by
    simpa [hmax] using ht
  calc
    remainingWork ω t tag =
        TaggedJobGPSOpenBacklogIntegralSourcePath.gpsRemainingWorkVectorFrom
          (ι := ι)
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
          (physicalTaggedInitialWorkVector tag capacity weight ω)
          capacity weight
          (TaggedJobGPSOpenBacklogIntegralSourcePath.gpsBackloggedFromRemainingWork
            (remainingWork ω)) t tag := hdyn tag t ht_busy
    _ =
        TaggedJobGPSOpenBacklogIntegralSourcePath.gpsRemainingWorkVectorFrom
          (ι := ι)
          (max (tagOnlyArrival 0) (postTagFalseMarkBusyUntil (ω.2 0).1 ω))
          (physicalTaggedInitialWorkVector tag capacity weight ω)
          capacity weight
          (TaggedJobGPSOpenBacklogIntegralSourcePath.gpsBackloggedFromRemainingWork
            (remainingWork ω)) t tag := by rw [hmax]

