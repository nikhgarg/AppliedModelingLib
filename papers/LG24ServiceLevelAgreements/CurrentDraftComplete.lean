/-! ## GPS normalized allocation and its guaranteed share -/

/-- Capacity received by a backlogged class under the normalized GPS rule. -/
def gpsNormalizedAllocation
    (capacity weight activeWeightSum : ℝ) : ℝ :=
  capacity * weight / activeWeightSum

/-- If the active weights sum to one, normalized GPS allocates `C * phi`. -/
theorem gpsNormalizedAllocation_eq_guaranteed_of_sum_eq_one
    (capacity weight : ℝ) :
    gpsNormalizedAllocation capacity weight 1 = capacity * weight := by
  simp [gpsNormalizedAllocation]

/--
When active weights have positive sum at most one, normalized GPS gives a
nonnegative class at least its guaranteed unnormalized share `C * phi`.
-/
theorem gpsNormalizedAllocation_ge_guaranteed
    {capacity weight activeWeightSum : ℝ}
    (hcapacity : 0 ≤ capacity) (hweight : 0 ≤ weight)
    (hsum_pos : 0 < activeWeightSum) (hsum_le : activeWeightSum ≤ 1) :
    capacity * weight ≤
      gpsNormalizedAllocation capacity weight activeWeightSum := by
  rw [gpsNormalizedAllocation, le_div_iff₀ hsum_pos]
  have hproduct : 0 ≤ capacity * weight := mul_nonneg hcapacity hweight
  nlinarith

/--
For a nonnegative job, the normalized GPS allocation gives no larger
instantaneous processing time than the class's guaranteed share `C * phi`.

This is the pointwise service-rate step behind the later FCFS comparator.  It
does not by itself establish a stochastic response-time tail: that also needs
an arrival process, a stationary/Palm tagged arrival, and a queueing coupling.
-/
theorem gpsProcessingTime_le_guaranteedShare
    {work capacity weight activeWeightSum : ℝ}
    (hwork : 0 ≤ work) (hcapacity : 0 < capacity) (hweight : 0 < weight)
    (hsum_pos : 0 < activeWeightSum) (hsum_le : activeWeightSum ≤ 1) :
    work / gpsNormalizedAllocation capacity weight activeWeightSum ≤
      work / (capacity * weight) := by
  apply AppliedModelingLib.Probability.Queueing.processingTime_le_of_rate_floor
    hwork (mul_pos hcapacity hweight)
  exact gpsNormalizedAllocation_ge_guaranteed
    (le_of_lt hcapacity) (le_of_lt hweight) hsum_pos hsum_le

/-- Service start times of the constant-rate FCFS comparator with an initial workload. -/
def fcfsComparatorStartFrom
    (initialBusyUntil : ℝ) (arrival work : ℕ → ℝ) (rate : ℝ) : ℕ → ℝ
  | 0 => max (arrival 0) initialBusyUntil
  | n + 1 => max (arrival (n + 1))
      (AppliedModelingLib.Probability.Queueing.fcfsDepartureFrom
        initialBusyUntil arrival work rate n)

/--
An exact constant-rate FCFS comparator path is a valid ideal-GPS path
certificate for the isolated tagged class when the guaranteed GPS share is the
same constant rate. This closes the deterministic service-dynamics side of the
one-class stochastic bridge; it makes no Palm, Poisson, or multiclass GPS
claim.
-/
def coupledAENormalizedIdealFluidGPSPath_of_fcfsComparatorFrom
    (initialBusyUntil : ℝ) (arrival work : ℕ → ℝ)
    {capacity weight : ℝ}
    (hcapacity : 0 ≤ capacity) (hweight : 0 ≤ weight)
    (hrate : 0 < capacity * weight)
    (hwork_nonneg : ∀ n : ℕ, 0 ≤ work n) :
    AppliedModelingLib.Probability.Queueing.CoupledAENormalizedIdealFluidGPSPath
      initialBusyUntil arrival work
      (AppliedModelingLib.Probability.Queueing.fcfsDepartureFrom
        initialBusyUntil arrival work (capacity * weight))
      capacity weight where
  capacity_nonneg := hcapacity
  weight_nonneg := hweight
  guaranteed_rate_pos := hrate
  actualServiceStart :=
    fcfsComparatorStartFrom initialBusyUntil arrival work (capacity * weight)
  arrival_le_actualServiceStart := by
    intro n
    cases n with
    | zero =>
        simp [fcfsComparatorStartFrom]
    | succ n =>
        simp [fcfsComparatorStartFrom]
  departure_after_actualServiceStart := by
    intro n
    cases n with
    | zero =>
        have hdiv_nonneg : 0 ≤ work 0 / (capacity * weight) :=
          div_nonneg (hwork_nonneg 0) hrate.le
        simp [fcfsComparatorStartFrom, AppliedModelingLib.Probability.Queueing.fcfsDepartureFrom]
        exact hdiv_nonneg
    | succ n =>
        have hdiv_nonneg : 0 ≤ work (n + 1) / (capacity * weight) :=
          div_nonneg (hwork_nonneg (n + 1)) hrate.le
        simp [fcfsComparatorStartFrom, AppliedModelingLib.Probability.Queueing.fcfsDepartureFrom]
        exact hdiv_nonneg
  actualStart_zero_le_comparatorStart := by
    simp [fcfsComparatorStartFrom]
  actualStart_succ_le_comparatorStart := by
    intro n
    simp [fcfsComparatorStartFrom]
  activeWeightSum := fun _ => 1
  instantaneousClassRate := fun _ => capacity * weight
  service := fun t => (capacity * weight) * t
  rate_intervalIntegrable := by
    intro n
    exact intervalIntegrable_const
  ae_gps_allocation_on_actual_job := by
    intro n
    simp [AppliedModelingLib.Probability.Queueing.idealGPSClassRate]
  ae_activeWeightSum_pos_on_actual_job := by
    intro n
    simp
  ae_activeWeightSum_le_one_on_actual_job := by
    intro n
    simp
  service_increment_eq_integral := by
    intro n
    rw [intervalIntegral.integral_const]
    simp [smul_eq_mul, sub_eq_add_neg]
    ring
  completed_work_eq_service := by
    intro n
    cases n with
    | zero =>
        simp [fcfsComparatorStartFrom, AppliedModelingLib.Probability.Queueing.fcfsDepartureFrom]
        have hcap_ne : capacity ≠ 0 := by
          intro hzero
          have : (0 : ℝ) < 0 := by simpa [hzero] using hrate
          exact (lt_irrefl (0 : ℝ)) this
        have hweight_ne : weight ≠ 0 := by
          intro hzero
          have : (0 : ℝ) < 0 := by simpa [hzero] using hrate
          exact (lt_irrefl (0 : ℝ)) this
        field_simp [hcap_ne, hweight_ne]
        ring_nf
    | succ n =>
        simp [fcfsComparatorStartFrom, AppliedModelingLib.Probability.Queueing.fcfsDepartureFrom]
        have hcap_ne : capacity ≠ 0 := by
          intro hzero
          have : (0 : ℝ) < 0 := by simpa [hzero] using hrate
          exact (lt_irrefl (0 : ℝ)) this
        have hweight_ne : weight ≠ 0 := by
          intro hzero
          have : (0 : ℝ) < 0 := by simpa [hzero] using hrate
          exact (lt_irrefl (0 : ℝ)) this
        field_simp [hcap_ne, hweight_ne]
        ring_nf

/-! ## Queueing input boundary and SLA algebra -/

/-- The exponential upper bound used by the paper after the GPS queue analysis. -/
def gpsExponentialTailUpperBound (slack delay : ℝ) : ℝ :=
  Real.exp (-slack * delay)

/--
Conditional GPS response-tail reduction under a supplied tagged measure.

Lean assumes only that `Ptag` is finite.  To instantiate this with the paper's
claim, a future stochastic model must prove that `Ptag` is the stationary Palm
probability law of a reindexed tagged arrival (normally at time zero), that
`initialBusyUntil` is the coupled pre-arrival workload, and that the displayed
comparator-tail premise follows from stable Poisson/exponential `M/M/1`
semantics.  The service-floor recurrence must likewise be derived from fluid
GPS dynamics.  None of these semantic facts is silently supplied by this
reduction.
-/
theorem gpsResponseTail_le_of_fcfsComparatorUnderTaggedMeasure
    {Ω : Type*} [MeasurableSpace Ω] (Ptag : MeasureTheory.Measure Ω)
    [MeasureTheory.IsFiniteMeasure Ptag]
    (initialBusyUntil : Ω → ℝ)
    (arrival work departure : Ω → ℕ → ℝ)
    (capacity weight arrivalRate delay : ℝ) (tag : ℕ)
    (hServiceFloorRecurrence : ∀ ω : Ω,
      AppliedModelingLib.Probability.Queueing.FCFSServiceFloorUpperBoundFromInitial
        (initialBusyUntil ω) (arrival ω) (work ω) (departure ω)
        (capacity * weight))
    (hComparatorTailUnderPtag :
      Ptag.real {ω | delay ≤
        AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
          (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
            initialBusyUntil arrival work (capacity * weight) ω) tag} ≤
        gpsExponentialTailUpperBound (capacity * weight - arrivalRate) delay) :
    Ptag.real {ω | delay ≤
      AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) tag} ≤
      gpsExponentialTailUpperBound (capacity * weight - arrivalRate) delay :=
  AppliedModelingLib.Probability.Queueing.taggedResponseTailReal_le_of_fcfsComparatorTailFromInitial
    Ptag initialBusyUntil arrival work departure (capacity * weight) delay
    (gpsExponentialTailUpperBound (capacity * weight - arrivalRate) delay) tag
    hServiceFloorRecurrence hComparatorTailUnderPtag

/--
GPS response-tail bound from an explicit stationary/Palm tagged-arrival M/M/1
comparator certificate.

The tag is fixed at job index zero and is reindexed at time zero in the
certificate.  The certificate packages the exact stationary-Palm/PASTA facts
used by the analytic M/M/1 tail calculation; it is not a claim that Lean has
already constructed the Palm measure from the GPS path.  The remaining GPS
proof obligation is `hServiceFloorRecurrence`, while
`hComparatorResponse` must identify the certificate's tagged comparator
response with the FCFS comparison path, including its coupled pre-tag workload.
-/
theorem gpsResponseTail_le_of_stationaryPalmMM1Comparator
    {Ω : Type*} [MeasurableSpace Ω]
    (H : AppliedModelingLib.Probability.Queueing.TaggedPASTAMM1CountCertificate Ω)
    (initialBusyUntil : Ω → ℝ)
    (arrival work departure : Ω → ℕ → ℝ)
    (capacity weight delay : ℝ) (hdelay : 0 ≤ delay)
    (hServiceFloorRecurrence : ∀ ω : Ω,
      AppliedModelingLib.Probability.Queueing.FCFSServiceFloorUpperBoundFromInitial
        (initialBusyUntil ω) (arrival ω) (work ω) (departure ω)
        (capacity * weight))
    (hServiceRate : H.serviceRate = capacity * weight)
    (hComparatorResponse : ∀ ω : Ω,
      H.response ω = AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) :
    H.Ptag.real {ω | delay ≤
      AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) 0} ≤
      gpsExponentialTailUpperBound
        (capacity * weight - H.arrivalRate) delay := by
  letI : MeasureTheory.IsProbabilityMeasure H.Ptag := H.isProbability
  have hComparatorEvent :
      {ω | delay ≤ AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0} =
        {ω | delay ≤ H.response ω} := by
    ext ω
    simp [hComparatorResponse ω]
  have hComparatorTail :
      H.Ptag.real {ω | delay ≤
        AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
          (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
            initialBusyUntil arrival work (capacity * weight) ω) 0} =
        gpsExponentialTailUpperBound
          (capacity * weight - H.arrivalRate) delay := by
    rw [hComparatorEvent]
    calc
      H.Ptag.real {ω | delay ≤ H.response ω} =
          Real.exp (-((H.serviceRate - H.arrivalRate) * delay)) :=
        AppliedModelingLib.Probability.Queueing.TaggedPASTAMM1CountCertificate.weak_responseTail_eq
          H delay hdelay
      _ = gpsExponentialTailUpperBound
          (capacity * weight - H.arrivalRate) delay := by
        unfold gpsExponentialTailUpperBound
        rw [hServiceRate]
        congr 1
        ring
  calc
    H.Ptag.real {ω | delay ≤
        AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) 0} ≤
        H.Ptag.real {ω | delay ≤
          AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
            (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
              initialBusyUntil arrival work (capacity * weight) ω) 0} :=
      AppliedModelingLib.Probability.Queueing.taggedResponseTailReal_le_fcfsComparatorFromInitial
        H.Ptag initialBusyUntil arrival work departure (capacity * weight) delay 0
        hServiceFloorRecurrence
    _ = gpsExponentialTailUpperBound
        (capacity * weight - H.arrivalRate) delay := hComparatorTail

/--
Stationary/Palm M/M/1 comparator reduction whose no-atom bridge is derived
from the strict count-tail identity on all nonnegative horizons.  Compared to
`gpsResponseTail_le_of_stationaryPalmMM1Comparator`, a queue-path
formalization need not separately provide response-time atomlessness at the
paper delay.

The tagged law and its geometric pre-arrival queue tail remain explicit, so
this theorem still cannot be instantiated by an arbitrary transient queue.
-/
theorem gpsResponseTail_le_of_stationaryPalmMM1Comparator_autoAtom
    {Ω : Type*} [MeasurableSpace Ω]
    (Ptag : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure Ptag]
    (queueLength : Ω → ℕ) (completionCount : ℝ → Ω → ℕ) (response : Ω → ℝ)
    (hqueue_meas : Measurable queueLength)
    (hcompletion_meas : ∀ z : ℝ, Measurable (completionCount z))
    (hresponse_meas : Measurable response)
    (h_indep : ∀ z : ℝ, 0 ≤ z →
      ProbabilityTheory.IndepFun queueLength (completionCount z) Ptag)
    (arrivalRate serviceRate : ℝ) (hserviceRate_pos : 0 < serviceRate)
    (hqueue_tail : ∀ k : ℕ,
      Ptag.real {ω | k ≤ queueLength ω} = (arrivalRate / serviceRate) ^ k)
    (hcompletion_law : ∀ z : ℝ, 0 ≤ z → ∀ k : ℕ,
      Ptag.real {ω | completionCount z ω = k} =
        countLikelihood 1 (serviceRate * z) k)
    (hstrict : ∀ z : ℝ, 0 ≤ z →
      {ω | z < response ω} =ᵐ[Ptag]
        {ω | completionCount z ω ≤ queueLength ω})
    (initialBusyUntil : Ω → ℝ)
    (arrival work departure : Ω → ℕ → ℝ)
    (capacity weight delay : ℝ) (hdelay : 0 ≤ delay)
    (hServiceFloorRecurrence : ∀ ω : Ω,
      FCFSServiceFloorUpperBoundFromInitial
        (initialBusyUntil ω) (arrival ω) (work ω) (departure ω)
        (capacity * weight))
    (hServiceRate : serviceRate = capacity * weight)
    (hComparatorResponse : ∀ ω : Ω,
      response ω = responseTime (arrival ω)
        (fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) :
    Ptag.real {ω | delay ≤
      responseTime (arrival ω) (departure ω) 0} ≤
      gpsExponentialTailUpperBound
        (capacity * weight - arrivalRate) delay := by
  apply gpsResponseTail_le_of_fcfsComparatorUnderTaggedMeasure
    Ptag initialBusyUntil arrival work departure capacity weight arrivalRate delay 0
    hServiceFloorRecurrence
  have hComparatorEvent :
      {ω | delay ≤ responseTime (arrival ω)
        (fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0} =
        {ω | delay ≤ response ω} := by
    ext ω
    simp [hComparatorResponse ω]
  rw [hComparatorEvent]
  calc
    Ptag.real {ω | delay ≤ response ω} =
        Real.exp (-((serviceRate - arrivalRate) * delay)) :=
      responseTail_weak_eq_of_stationaryPalmCountCoupling_autoAtom
        Ptag queueLength completionCount response hqueue_meas hcompletion_meas
        hresponse_meas h_indep arrivalRate serviceRate hserviceRate_pos.ne'
        hqueue_tail hcompletion_law hstrict delay hdelay
    _ = gpsExponentialTailUpperBound
        (capacity * weight - arrivalRate) delay := by
      unfold gpsExponentialTailUpperBound
      rw [← hServiceRate]
      congr 1
      ring
    _ ≤ gpsExponentialTailUpperBound
        (capacity * weight - arrivalRate) delay := le_rfl

/--
Auto-no-atom M/M/1 count-coupling reduction with a.e. path obligations.  This
is the version suited to physical marked-clock constructions where exceptional
boundary paths are null under the tagged Palm law.
-/
theorem gpsResponseTail_le_of_stationaryPalmMM1Comparator_autoAtom_aeServiceFloor_aeComparatorResponse
    {Ω : Type*} [MeasurableSpace Ω]
    (Ptag : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure Ptag]
    (queueLength : Ω → ℕ) (completionCount : ℝ → Ω → ℕ) (response : Ω → ℝ)
    (hqueue_meas : Measurable queueLength)
    (hcompletion_meas : ∀ z : ℝ, Measurable (completionCount z))
    (hresponse_meas : Measurable response)
    (h_indep : ∀ z : ℝ, 0 ≤ z →
      ProbabilityTheory.IndepFun queueLength (completionCount z) Ptag)
    (arrivalRate serviceRate : ℝ) (hserviceRate_pos : 0 < serviceRate)
    (hqueue_tail : ∀ k : ℕ,
      Ptag.real {ω | k ≤ queueLength ω} = (arrivalRate / serviceRate) ^ k)
    (hcompletion_law : ∀ z : ℝ, 0 ≤ z → ∀ k : ℕ,
      Ptag.real {ω | completionCount z ω = k} =
        countLikelihood 1 (serviceRate * z) k)
    (hstrict : ∀ z : ℝ, 0 ≤ z →
      {ω | z < response ω} =ᵐ[Ptag]
        {ω | completionCount z ω ≤ queueLength ω})
    (initialBusyUntil : Ω → ℝ)
    (arrival work departure : Ω → ℕ → ℝ)
    (capacity weight delay : ℝ) (hdelay : 0 ≤ delay)
    (hServiceFloorRecurrence : ∀ᵐ ω ∂Ptag,
      FCFSServiceFloorUpperBoundFromInitial
        (initialBusyUntil ω) (arrival ω) (work ω) (departure ω)
        (capacity * weight))
    (hServiceRate : serviceRate = capacity * weight)
    (hComparatorResponse : ∀ᵐ ω ∂Ptag,
      response ω = responseTime (arrival ω)
        (fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) :
    Ptag.real {ω | delay ≤
      responseTime (arrival ω) (departure ω) 0} ≤
      gpsExponentialTailUpperBound
        (capacity * weight - arrivalRate) delay := by
  apply AppliedModelingLib.Probability.Queueing.taggedResponseTailReal_le_of_fcfsComparatorTailFromInitial_ae
    Ptag initialBusyUntil arrival work departure (capacity * weight) delay
    (gpsExponentialTailUpperBound (capacity * weight - arrivalRate) delay) 0
    hServiceFloorRecurrence
  have hComparatorEvent :
      {ω | delay ≤ responseTime (arrival ω)
        (fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0} =ᵐ[Ptag]
        {ω | delay ≤ response ω} := by
    filter_upwards [hComparatorResponse] with ω hω
    change (delay ≤
      responseTime (arrival ω)
        (fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) =
      (delay ≤ response ω)
    rw [← hω]
  have hComparatorEventReal :=
    congrArg ENNReal.toReal (MeasureTheory.measure_congr hComparatorEvent)
  change ENNReal.toReal (Ptag {ω | delay ≤
    responseTime (arrival ω)
      (fcfsComparatorDepartureFrom
        initialBusyUntil arrival work (capacity * weight) ω) 0}) ≤ _
  rw [hComparatorEventReal]
  calc
    Ptag.real {ω | delay ≤ response ω} =
        Real.exp (-((serviceRate - arrivalRate) * delay)) :=
      responseTail_weak_eq_of_stationaryPalmCountCoupling_autoAtom
        Ptag queueLength completionCount response hqueue_meas hcompletion_meas
        hresponse_meas h_indep arrivalRate serviceRate hserviceRate_pos.ne'
        hqueue_tail hcompletion_law hstrict delay hdelay
    _ = gpsExponentialTailUpperBound
        (capacity * weight - arrivalRate) delay := by
      unfold gpsExponentialTailUpperBound
      rw [← hServiceRate]
      congr 1
      ring
    _ ≤ gpsExponentialTailUpperBound
        (capacity * weight - arrivalRate) delay := le_rfl

/--
Almost-everywhere comparator-response variant of
`gpsResponseTail_le_of_stationaryPalmMM1Comparator`.  This is the appropriate
form for stochastic path constructions: exceptional arrival-boundary paths
need not be assigned a pointwise response identity when they are null under
the tagged law.
-/
theorem gpsResponseTail_le_of_stationaryPalmMM1Comparator_aeComparatorResponse
    {Ω : Type*} [MeasurableSpace Ω]
    (H : AppliedModelingLib.Probability.Queueing.TaggedPASTAMM1CountCertificate Ω)
    (initialBusyUntil : Ω → ℝ)
    (arrival work departure : Ω → ℕ → ℝ)
    (capacity weight delay : ℝ) (hdelay : 0 ≤ delay)
    (hServiceFloorRecurrence : ∀ ω : Ω,
      AppliedModelingLib.Probability.Queueing.FCFSServiceFloorUpperBoundFromInitial
        (initialBusyUntil ω) (arrival ω) (work ω) (departure ω)
        (capacity * weight))
    (hServiceRate : H.serviceRate = capacity * weight)
    (hComparatorResponse : ∀ᵐ ω ∂H.Ptag,
      H.response ω = AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) :
    H.Ptag.real {ω | delay ≤
      AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) 0} ≤
      gpsExponentialTailUpperBound
        (capacity * weight - H.arrivalRate) delay := by
  letI : MeasureTheory.IsProbabilityMeasure H.Ptag := H.isProbability
  have hComparatorEvent :
      {ω | delay ≤ AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0} =ᵐ[H.Ptag]
        {ω | delay ≤ H.response ω} := by
    filter_upwards [hComparatorResponse] with ω hω
    change (delay ≤
      AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) =
      (delay ≤ H.response ω)
    rw [← hω]
  have hComparatorTail :
      H.Ptag.real {ω | delay ≤
        AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
          (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
            initialBusyUntil arrival work (capacity * weight) ω) 0} =
        gpsExponentialTailUpperBound
          (capacity * weight - H.arrivalRate) delay := by
    have hComparatorEventReal :=
      congrArg ENNReal.toReal (MeasureTheory.measure_congr hComparatorEvent)
    change ENNReal.toReal (H.Ptag {ω | delay ≤
      AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0}) = _
    rw [hComparatorEventReal]
    calc
      H.Ptag.real {ω | delay ≤ H.response ω} =
          Real.exp (-((H.serviceRate - H.arrivalRate) * delay)) :=
        AppliedModelingLib.Probability.Queueing.TaggedPASTAMM1CountCertificate.weak_responseTail_eq
          H delay hdelay
      _ = gpsExponentialTailUpperBound
          (capacity * weight - H.arrivalRate) delay := by
        unfold gpsExponentialTailUpperBound
        rw [hServiceRate]
        congr 1
        ring
  calc
    H.Ptag.real {ω | delay ≤
        AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) 0} ≤
        H.Ptag.real {ω | delay ≤
          AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
            (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
              initialBusyUntil arrival work (capacity * weight) ω) 0} :=
      AppliedModelingLib.Probability.Queueing.taggedResponseTailReal_le_fcfsComparatorFromInitial
        H.Ptag initialBusyUntil arrival work departure (capacity * weight) delay 0
        hServiceFloorRecurrence
    _ = gpsExponentialTailUpperBound
