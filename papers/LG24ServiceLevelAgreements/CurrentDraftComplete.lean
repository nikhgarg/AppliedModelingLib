/--
Primitive queue-state facts plus measurable remaining-work coordinates recover
the remaining-work dynamics formulation with backlog generated by positive
remaining work.
-/
theorem physicalTaggedInitialWorkVectorRemainingWorkDynamicsAE_of_queueStateSourceModel
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (P : Measure ((ℤ → ℝ) × (ℤ → (ℕ × Bool))))
    (tag : ι) (capacity : ℝ) (weight : ι → ℝ)
    (backlogged : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℝ → ι → Bool)
    (remainingWork :
      ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℝ → ι → ℝ)
    (hsource :
      physicalTaggedInitialWorkVectorQueueStateSourceModelAE
        P tag capacity weight backlogged remainingWork) :
    physicalTaggedInitialWorkVectorRemainingWorkDynamicsAE
      P tag capacity weight remainingWork := by
  filter_upwards [hsource.2.1, hsource.2.2] with
    ω hbalance hpositive
  intro i t ht
  calc
    remainingWork ω t i =
        TaggedJobGPSOpenBacklogIntegralSourcePath.gpsRemainingWorkVectorFrom
          (ι := ι)
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
          (physicalTaggedInitialWorkVector tag capacity weight ω)
          capacity weight (backlogged ω) t i := hbalance i t ht
    _ =
        TaggedJobGPSOpenBacklogIntegralSourcePath.gpsRemainingWorkVectorFrom
          (ι := ι)
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
          (physicalTaggedInitialWorkVector tag capacity weight ω)
          capacity weight
          (TaggedJobGPSOpenBacklogIntegralSourcePath.gpsBackloggedFromRemainingWork
            (remainingWork ω)) t i := by
      unfold TaggedJobGPSOpenBacklogIntegralSourcePath.gpsRemainingWorkVectorFrom
      congr 1
      refine intervalIntegral.integral_congr_ae ?_
      filter_upwards with u hu
      have hstart_le_t :
          postTagFalseMarkBusyUntil (ω.2 0).1 ω ≤ t := ht.1.le
      have huIoc : u ∈ Set.Ioc
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω) t := by
        simpa [Set.uIoc_of_le hstart_le_t] using hu
      have hu_window : u ∈ Set.Ioo
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω +
            postTagFalseMarkTaggedServiceWork (capacity * weight tag)
              (ω.2 0).1 ω 0 /
              (capacity * weight tag)) := by
        exact ⟨huIoc.1, lt_of_le_of_lt huIoc.2 ht.2⟩
      exact
        gpsBackloggedClassRate_congr_at
          i capacity weight
          (backlogged₁ := backlogged ω)
          (backlogged₂ :=
            TaggedJobGPSOpenBacklogIntegralSourcePath.gpsBackloggedFromRemainingWork
              (remainingWork ω))
          (t := u)
          (fun j => by
            calc
              backlogged ω u j = decide (0 < remainingWork ω u j) :=
                hpositive j u hu_window
              _ =
                  TaggedJobGPSOpenBacklogIntegralSourcePath.gpsBackloggedFromRemainingWork
                    (remainingWork ω) u j := rfl)

