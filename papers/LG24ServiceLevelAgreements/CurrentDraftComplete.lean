/-- Hessian coordinate for the corrected reciprocal map `a / x`. -/
def reciprocalLogTailHessian (logTail x : ℝ) : ℝ :=
  2 * logTail / x ^ 3

/-- The corrected reciprocal map has a positive Hessian on the active domain. -/
theorem reciprocalLogTailHessian_pos
    {logTail x : ℝ} (hlogTail : 0 < logTail) (hx : 0 < x) :
    0 < reciprocalLogTailHessian logTail x := by
  unfold reciprocalLogTailHessian
  positivity

/-- The displayed constraint `-xz + a ≤ 0` is exactly `a ≤ xz`. -/
theorem printedSLAConstraint_iff_multiplicative
    (slack delay logTail : ℝ) :
    -slack * delay + logTail ≤ 0 ↔
      multiplicativeSLAConstraint slack delay logTail := by
  unfold multiplicativeSLAConstraint
  constructor <;> intro h <;> nlinarith

/--
For a positive violation probability, the log form of the SLA constraint is
equivalent to comparing the exponential tail upper bound with that probability.
-/
theorem exponentialSLA_iff_logSLA
    {slack delay violationProbability : ℝ}
    (hprob : 0 < violationProbability) :
    gpsExponentialTailUpperBound slack delay ≤ violationProbability ↔
      -slack * delay ≤ Real.log violationProbability := by
  exact (Real.le_log_iff_exp_le hprob).symm

/--
Conditional bridge from a GPS response-tail bound to the SLA.  Some callers
prove this tail internally from the selected-Palm false-mark model; others use
it as an abstract queueing input for a source-model boundary.
-/
theorem gpsTailInput_implies_SLA
    {tailProbability slack delay violationProbability : ℝ}
    (hqueueingInput : tailProbability ≤
      gpsExponentialTailUpperBound slack delay)
    (hprob : 0 < violationProbability)
    (hlogSLA : -slack * delay ≤ Real.log violationProbability) :
    tailProbability ≤ violationProbability := by
  exact hqueueingInput.trans
    ((exponentialSLA_iff_logSLA hprob).2 hlogSLA)

