    {base : AppliedModelingLib.Probability.Palm.ShiftInvariantProbabilityLaw Ωbase}
    {tagged : AppliedModelingLib.Probability.Queueing.TaggedArrivalAtZero Ωtag}
    (H : AppliedModelingLib.Probability.Palm.StationaryPalmPASTAQueueLengthCertificate
      base tagged)
    (arrivalRate : ℝ) (harrivalRate : 0 < arrivalRate)
    (hPalmRate : H.toCampbellPalmTaggedArrivalCertificate.arrivalRate = arrivalRate)
    (service : AppliedModelingLib.Probability.PoissonProcess.ForwardHomogeneousPoissonCountingProcessByLaw
      Ωtag tagged.Ptag)
    (hstable : arrivalRate < service.rate)
    (response : Ωtag → ℝ)
    (hresponse_measurable : Measurable response)
    (hstationary : ProbabilityTheory.HasLaw H.to_pasta.stationaryQueueLength
      (ProbabilityTheory.geometricMeasure (p := 1 - arrivalRate / service.rate)
        (sub_pos.mpr (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_lt_one
          hstable service.rate_pos))
        (sub_le_self 1 (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_nonneg
          (le_of_lt harrivalRate) service.rate_pos))) base.Pbase)
    (hpreArrivalQueueLength_indep_service : ∀ z : ℝ, 0 ≤ z →
      ProbabilityTheory.IndepFun H.to_pasta.preArrivalQueueLength
        (service.count z.toNNReal) tagged.Ptag)
    (hstrict_response_event : ∀ z : ℝ, 0 ≤ z →
      {ω | z < response ω} =ᵐ[tagged.Ptag]
        {ω | service.count z.toNNReal ω ≤ H.to_pasta.preArrivalQueueLength ω})
    (hresponse_atom_zero : ∀ z : ℝ,
      tagged.Ptag.real {ω | response ω = z} = 0)
    (initialBusyUntil : Ωtag → ℝ)
    (arrival work departure : Ωtag → ℕ → ℝ)
    (capacity weight delay : ℝ) (hdelay : 0 ≤ delay)
    (hfluid : ∀ᵐ ω ∂tagged.Ptag,
      Nonempty (AppliedModelingLib.Probability.Queueing.CoupledAENormalizedIdealFluidGPSPath
        (initialBusyUntil ω) (arrival ω) (work ω) (departure ω) capacity weight))
    (hServiceRate : service.rate = capacity * weight)
    (hComparatorResponse : ∀ᵐ ω ∂tagged.Ptag,
      response ω = AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) :
    tagged.Ptag.real {ω | delay ≤
      AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) 0} ≤
      gpsExponentialTailUpperBound (capacity * weight - arrivalRate) delay := by
  have hstationary_queue_tail : ∀ k : ℕ,
      base.Pbase.real {ω | k ≤ H.to_pasta.stationaryQueueLength ω} =
        (arrivalRate / service.rate) ^ k := by
    intro k
    exact H.to_pasta.real_stationaryQueueLength_tail_of_geometric_hasLaw
      (arrivalRate / service.rate)
      (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_nonneg
        (le_of_lt harrivalRate) service.rate_pos)
      (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_lt_one hstable service.rate_pos)
      hstationary k
  have hstablePalm : H.toCampbellPalmTaggedArrivalCertificate.arrivalRate < service.rate := by
    simpa only [hPalmRate] using hstable
  have htailPalm : ∀ k : ℕ,
      base.Pbase.real {ω | k ≤ H.to_pasta.stationaryQueueLength ω} =
        (H.toCampbellPalmTaggedArrivalCertificate.arrivalRate / service.rate) ^ k := by
    simpa only [hPalmRate] using hstationary_queue_tail
  have htail := gpsResponseTail_le_of_stationaryBasePalmPASTAAENormalizedGPS_aeResponseEvent
    H.to_pasta H.toCampbellPalmTaggedArrivalCertificate.arrivalRate
    H.toCampbellPalmTaggedArrivalCertificate.arrivalRate_pos service hstablePalm
    response hresponse_measurable htailPalm hpreArrivalQueueLength_indep_service
    hstrict_response_event hresponse_atom_zero initialBusyUntil arrival work departure
    capacity weight delay hdelay hfluid hServiceRate hComparatorResponse
  simpa only [hPalmRate] using htail

/--
Synthetic independent-product specialization of the stationary-base/PASTA GPS
response-tail reduction.

The tagged space pairs the stationary base state independently with a two-sided
exponential-gap arrival path, and
`Palm.independentProductPalmPASTAQueueLengthCertificate` supplies the
queue-state PASTA certificate.

It does **not** prove that this product tagged law is the Palm transform of the
base law, nor that its tagged arrivals are dynamically coupled to the base
state.  The service process, stability, base geometric-tail law, post-tag
queue/service independence, response-event identity, no-atom property, and
fluid-GPS/comparator dynamics consequently remain explicit assumptions.  This
is a paper-facing conditional reduction, not a construction of the paper's
stationary queueing model.
-/
theorem gpsResponseTail_le_of_independentProductPalmPASTAFluidGPS
    {Ωbase : Type*} [MeasurableSpace Ωbase]
    {base : AppliedModelingLib.Probability.Palm.ShiftInvariantProbabilityLaw Ωbase}
    (stationaryQueueLength : Ωbase → ℕ)
    (hstationaryQueueLength : Measurable stationaryQueueLength)
    (arrivalRate : ℝ) (harrivalRate : 0 < arrivalRate)
    (service : AppliedModelingLib.Probability.PoissonProcess.ForwardHomogeneousPoissonCountingProcessByLaw
      (Ωbase × (ℤ → ℝ))
      (base.Pbase.prod
        (AppliedModelingLib.Probability.PoissonProcess.twoSidedInterarrivalMeasure arrivalRate)))
    (hstable : arrivalRate < service.rate)
    (response : Ωbase × (ℤ → ℝ) → ℝ)
    (hresponse_measurable : Measurable response)
    (hstationary_queue_tail : ∀ k : ℕ,
      base.Pbase.real {ω | k ≤ stationaryQueueLength ω} =
        (arrivalRate / service.rate) ^ k)
    (hpreArrivalQueueLength_indep_service : ∀ z : ℝ, 0 ≤ z →
      ProbabilityTheory.IndepFun (fun x : Ωbase × (ℤ → ℝ) => stationaryQueueLength x.1)
        (service.count z.toNNReal)
        (base.Pbase.prod
          (AppliedModelingLib.Probability.PoissonProcess.twoSidedInterarrivalMeasure arrivalRate)))
    (hstrict_response_event : ∀ z : ℝ, 0 ≤ z →
      {ω | z < response ω} =
        {ω | service.count z.toNNReal ω ≤ stationaryQueueLength ω.1})
    (hresponse_atom_zero : ∀ z : ℝ,
      (base.Pbase.prod
        (AppliedModelingLib.Probability.PoissonProcess.twoSidedInterarrivalMeasure arrivalRate)).real
          {ω | response ω = z} = 0)
    (initialBusyUntil : Ωbase × (ℤ → ℝ) → ℝ)
    (arrival work departure : Ωbase × (ℤ → ℝ) → ℕ → ℝ)
    (capacity weight delay : ℝ) (hdelay : 0 ≤ delay)
    (hfluid : ∀ ω,
      AppliedModelingLib.Probability.Queueing.CoupledIntegratedIdealFluidGPSPath
        (initialBusyUntil ω) (arrival ω) (work ω) (departure ω) capacity weight)
    (hServiceRate : service.rate = capacity * weight)
    (hComparatorResponse : ∀ ω : Ωbase × (ℤ → ℝ),
      response ω = AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) :
    (base.Pbase.prod
      (AppliedModelingLib.Probability.PoissonProcess.twoSidedInterarrivalMeasure arrivalRate)).real
        {ω | delay ≤
          AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) 0} ≤
      gpsExponentialTailUpperBound (capacity * weight - arrivalRate) delay := by
  letI : MeasureTheory.IsProbabilityMeasure base.Pbase := base.isProbability
  let tagged :=
    AppliedModelingLib.Probability.PoissonProcess.independentProductTaggedArrivalAtZero
      base.Pbase arrivalRate harrivalRate
  let HP := AppliedModelingLib.Probability.Palm.independentProductPalmPASTAQueueLengthCertificate
    base stationaryQueueLength hstationaryQueueLength arrivalRate harrivalRate
  have htail := gpsResponseTail_le_of_stationaryBasePalmPASTAFluidGPS
    (base := base) (tagged := tagged) HP arrivalRate harrivalRate service hstable
    response hresponse_measurable hstationary_queue_tail
    hpreArrivalQueueLength_indep_service hstrict_response_event hresponse_atom_zero
    initialBusyUntil arrival work departure capacity weight delay hdelay hfluid
    hServiceRate hComparatorResponse
  simpa [tagged, HP] using htail

