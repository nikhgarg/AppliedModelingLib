/--
The strongest current product-space specialization: an identified uniformized
stationary M/M/1 trajectory supplies the geometric state law, the independent
tagged product supplies the queue-state PASTA certificate, and an a.e.
normalized GPS path supplies the deterministic FCFS comparison.

This remains deliberately conditional on the real-time stationary-base
identification, the future-service process and its independence from the
pre-arrival state, the response-event/no-atom facts, and the GPS coupling. In
particular, the independent product is not asserted to be a Campbell/Palm
transform or a dynamically coupled queueing model.
-/
theorem gpsResponseTail_le_of_uniformizedTrajectoryIndependentProductPalmPASTAAENormalizedGPS
    {base : AppliedModelingLib.Probability.Palm.ShiftInvariantProbabilityLaw (ℕ → ℕ)}
    (arrivalRate : ℝ) (harrivalRate : 0 < arrivalRate)
    (service : AppliedModelingLib.Probability.PoissonProcess.ForwardHomogeneousPoissonCountingProcessByLaw
      ((ℕ → ℕ) × (ℤ → ℝ))
      (base.Pbase.prod
        (AppliedModelingLib.Probability.PoissonProcess.twoSidedInterarrivalMeasure arrivalRate)))
    (hstable : arrivalRate < service.rate)
    (rho : NNReal) (hrho : rho < 1)
    (hrho_eq : (rho : ℝ) = arrivalRate / service.rate) (n : ℕ)
    (hbase : base.Pbase = AppliedModelingLib.Probability.Queueing.stationaryTrajMeasure
      (AppliedModelingLib.Probability.Queueing.geoNNPMF rho hrho).toMeasure
      (AppliedModelingLib.Probability.Queueing.countablePMFKernel
        (AppliedModelingLib.Probability.Queueing.reflectedBirthDeathKernel
          (AppliedModelingLib.Probability.Queueing.uniformizedBirthProbability rho)
          (AppliedModelingLib.Probability.Queueing.uniformizedBirthProbability_le_one rho))))
    (response : (ℕ → ℕ) × (ℤ → ℝ) → ℝ)
    (hresponse_measurable : Measurable response)
    (hpreArrivalQueueLength_indep_service : ∀ z : ℝ, 0 ≤ z →
      ProbabilityTheory.IndepFun (fun x : (ℕ → ℕ) × (ℤ → ℝ) => x.1 n)
        (service.count z.toNNReal)
        (base.Pbase.prod
          (AppliedModelingLib.Probability.PoissonProcess.twoSidedInterarrivalMeasure arrivalRate)))
    (hstrict_response_event : ∀ z : ℝ, 0 ≤ z →
      {ω | z < response ω} =
        {ω | service.count z.toNNReal ω ≤ ω.1 n})
    (hresponse_atom_zero : ∀ z : ℝ,
      (base.Pbase.prod
        (AppliedModelingLib.Probability.PoissonProcess.twoSidedInterarrivalMeasure arrivalRate)).real
          {ω | response ω = z} = 0)
    (initialBusyUntil : (ℕ → ℕ) × (ℤ → ℝ) → ℝ)
    (arrival work departure : (ℕ → ℕ) × (ℤ → ℝ) → ℕ → ℝ)
    (capacity weight delay : ℝ) (hdelay : 0 ≤ delay)
    (hfluid : ∀ ω,
      AppliedModelingLib.Probability.Queueing.CoupledAENormalizedIdealFluidGPSPath
        (initialBusyUntil ω) (arrival ω) (work ω) (departure ω) capacity weight)
    (hServiceRate : service.rate = capacity * weight)
    (hComparatorResponse : ∀ ω : (ℕ → ℕ) × (ℤ → ℝ),
      response ω = AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) :
    (base.Pbase.prod
      (AppliedModelingLib.Probability.PoissonProcess.twoSidedInterarrivalMeasure arrivalRate)).real
        {ω | delay ≤
          AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) 0} ≤
      gpsExponentialTailUpperBound (capacity * weight - arrivalRate) delay := by
  letI : MeasureTheory.IsProbabilityMeasure base.Pbase := base.isProbability
  let tagged :=
    AppliedModelingLib.Probability.PoissonProcess.independentProductTaggedArrivalAtZero
      base.Pbase arrivalRate harrivalRate
  let HP := AppliedModelingLib.Probability.Palm.independentProductPalmPASTAQueueLengthCertificate
    base (fun x : ℕ → ℕ => x n) (measurable_pi_apply n) arrivalRate harrivalRate
  have hqueue : HP.stationaryQueueLength = fun x : ℕ → ℕ => x n := by
    rfl
  have hgeo : ProbabilityTheory.HasLaw HP.stationaryQueueLength
      (ProbabilityTheory.geometricMeasure (p := 1 - (rho : ℝ))
        (sub_pos.mpr (by exact_mod_cast hrho))
        (sub_le_self 1 (by positivity : 0 ≤ (rho : ℝ)))) base.Pbase := by
    refine ⟨?_, ?_⟩
    · rw [hqueue]
      exact (measurable_pi_apply n).aemeasurable
    · rw [hqueue, hbase]
      calc
        _ = (AppliedModelingLib.Probability.Queueing.geoNNPMF rho hrho).toMeasure :=
          AppliedModelingLib.Probability.Queueing.geoNNPMF_uniformized_stationaryTraj_marginal
            rho hrho n
        _ = ProbabilityTheory.geometricMeasure (p := 1 - (rho : ℝ))
            (sub_pos.mpr (by exact_mod_cast hrho))
            (sub_le_self 1 (by positivity : 0 ≤ (rho : ℝ))) :=
          AppliedModelingLib.Probability.Queueing.geoNNPMF_toMeasure_eq_geometricMeasure rho hrho
  have hstationary : ProbabilityTheory.HasLaw HP.stationaryQueueLength
      (ProbabilityTheory.geometricMeasure (p := 1 - arrivalRate / service.rate)
        (sub_pos.mpr (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_lt_one
          hstable service.rate_pos))
        (sub_le_self 1 (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_nonneg
          (le_of_lt harrivalRate) service.rate_pos))) base.Pbase := by
    simpa only [hrho_eq] using hgeo
  let H := HP.toTaggedPASTAMM1CountCertificateOfGeometricStateLaw
    arrivalRate harrivalRate service hstable response hresponse_measurable hstationary
    hpreArrivalQueueLength_indep_service hstrict_response_event hresponse_atom_zero
  have htail := gpsResponseTail_le_of_coupledAENormalizedIdealFluidGPS H
    initialBusyUntil arrival work departure capacity weight delay hdelay hfluid
    hServiceRate hComparatorResponse
  simpa [tagged, HP, H] using htail

/-- The manuscript's multiplicative SLA constraint with positive log-tail `a`. -/
def multiplicativeSLAConstraint (slack delay logTail : ℝ) : Prop :=
  logTail ≤ slack * delay

/-- Positive log-tail parameter associated with a violation probability. -/
def logTailOfViolation (violationProbability : ℝ) : ℝ :=
  -Real.log violationProbability

/-- A probability strictly between zero and one has a positive log-tail. -/
theorem logTailOfViolation_pos
    {violationProbability : ℝ}
    (hpos : 0 < violationProbability) (hlt : violationProbability < 1) :
    0 < logTailOfViolation violationProbability := by
  unfold logTailOfViolation
  exact neg_pos.mpr (Real.log_neg hpos hlt)

