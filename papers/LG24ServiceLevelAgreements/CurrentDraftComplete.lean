/--
Paper-form SLA violation-probability consequence of the real-rate first-hit
source bridge.  Once the actual multiclass GPS queue supplies the busy-until
first-hit facts, the checked exponential tail and the log-SLA inequality give
the paper's probability bound directly.
-/
theorem gpsSLA_le_of_physicalBusyUntilFirstHitOpenBacklogTaggedJobGPS_realRates
    {arrivalRate capacity : ℝ}
    {ι : Type*} [Fintype ι] [DecidableEq ι] (tag : ι)
    (weight : ι → ℝ)
    (harrival_pos : 0 < arrivalRate)
    (hstable : arrivalRate < capacity * weight tag)
    (hcapacity : 0 ≤ capacity)
    (hweight_nonneg : ∀ i, 0 ≤ weight i)
    (htotal_weight_le_one : Finset.univ.sum weight ≤ 1)
    (departure : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℕ → ℝ)
    (delay violationProbability : ℝ)
    (hdelay : 0 ≤ delay) (hprob : 0 < violationProbability)
    (hlogSLA :
      -(capacity * weight tag - arrivalRate) * delay ≤
        Real.log violationProbability)
    (backlogged : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℝ → ι → Bool) :
    let arrivalRateNN : ℝ≥0 := ⟨arrivalRate, harrival_pos.le⟩
    let serviceRateNN : ℝ≥0 :=
      ⟨capacity * weight tag, (lt_trans harrival_pos hstable).le⟩
    (∀ᵐ ω ∂
      (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
        (by exact_mod_cast harrival_pos)
        (by exact_mod_cast hstable)).Ptag,
      postTagFalseMarkBusyUntil (ω.2 0).1 ω ≤ departure ω 0) →
    (∀ᵐ ω ∂
      (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
        (by exact_mod_cast harrival_pos)
        (by exact_mod_cast hstable)).Ptag,
      IntervalIntegrable
        (gpsBackloggedClassRate ι tag capacity weight (backlogged ω))
        MeasureTheory.volume
        (postTagFalseMarkBusyUntil (ω.2 0).1 ω)
        (departure ω 0)) →
    (∀ᵐ ω ∂
      (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
        (by exact_mod_cast harrival_pos)
        (by exact_mod_cast hstable)).Ptag,
      ∀ t,
        t ∈ Set.Ioo
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω) (departure ω 0) →
        (∫ u in (postTagFalseMarkBusyUntil (ω.2 0).1 ω)..t,
          gpsBackloggedClassRate ι tag capacity weight (backlogged ω) u) <
          postTagFalseMarkTaggedServiceWork (capacity * weight tag) (ω.2 0).1 ω 0 →
        backlogged ω t tag = true) →
    (∀ᵐ ω ∂
      (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
        (by exact_mod_cast harrival_pos)
        (by exact_mod_cast hstable)).Ptag,
      ∀ t,
        t ∈ Set.Ioo
          (postTagFalseMarkBusyUntil (ω.2 0).1 ω) (departure ω 0) →
        (∫ u in (postTagFalseMarkBusyUntil (ω.2 0).1 ω)..t,
          gpsBackloggedClassRate ι tag capacity weight (backlogged ω) u) <
          postTagFalseMarkTaggedServiceWork (capacity * weight tag) (ω.2 0).1 ω 0) →
    (∀ᵐ ω ∂
      (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
        (by exact_mod_cast harrival_pos)
        (by exact_mod_cast hstable)).Ptag,
      (∫ u in (postTagFalseMarkBusyUntil (ω.2 0).1 ω)..departure ω 0,
        gpsBackloggedClassRate ι tag capacity weight (backlogged ω) u) =
        postTagFalseMarkTaggedServiceWork (capacity * weight tag) (ω.2 0).1 ω 0) →
    (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
        (by exact_mod_cast harrival_pos)
        (by exact_mod_cast hstable)).Ptag.real
      {ω | delay ≤ responseTime tagOnlyArrival (departure ω) 0} ≤
      violationProbability := by
  dsimp
  intro hbusy_le_departure hrate_integrable hbacklogged_of_unfinished
    hcumulative_before_departure_lt_work hcumulative_at_departure_eq_work
  let arrivalRateNN : ℝ≥0 := ⟨arrivalRate, harrival_pos.le⟩
  let serviceRateNN : ℝ≥0 :=
    ⟨capacity * weight tag, (lt_trans harrival_pos hstable).le⟩
  have htail :
      (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
          (by exact_mod_cast harrival_pos)
          (by exact_mod_cast hstable)).Ptag.real
        {ω | delay ≤ responseTime tagOnlyArrival (departure ω) 0} ≤
        gpsExponentialTailUpperBound (capacity * weight tag - arrivalRate) delay := by
    simpa [arrivalRateNN, serviceRateNN] using
      gpsResponseTail_le_of_physicalBusyUntilFirstHitOpenBacklogTaggedJobGPS_realRates
        tag weight harrival_pos hstable hcapacity hweight_nonneg
        htotal_weight_le_one departure delay hdelay backlogged
        hbusy_le_departure hrate_integrable hbacklogged_of_unfinished
        hcumulative_before_departure_lt_work hcumulative_at_departure_eq_work
  have hexp :
      gpsExponentialTailUpperBound (capacity * weight tag - arrivalRate) delay ≤
        violationProbability := by
    unfold gpsExponentialTailUpperBound
    exact (Real.le_log_iff_exp_le hprob).1 hlogSLA
  exact htail.trans hexp

/--
The physical selected-Palm false-mark FCFS comparator itself can be packaged as
a singleton open-backlog tagged-job GPS source path.  This is a closed
selected-path source instantiation for the isolated comparator, not a claim
that the full multiclass GPS queue has already been constructed.
-/
theorem gpsResponseTail_le_of_physicalForwardReverseMarkedMM1PalmPASTAFalseMarkOpenBacklogTaggedJobGPS
    {arrivalRate serviceRate : ℝ≥0}
    (harrival_pos : 0 < arrivalRate) (hstableNN : arrivalRate < serviceRate)
    (delay : ℝ) (hdelay : 0 ≤ delay) :
    (PhysicalMM1ForwardReverseTag arrivalRate serviceRate harrival_pos hstableNN).Ptag.real
      {ω | delay ≤ responseTime tagOnlyArrival
        ((fcfsComparatorDepartureFrom
          (fun x : (ℤ → ℝ) × (ℤ → (ℕ × Bool)) =>
            postTagFalseMarkBusyUntil (x.2 0).1 x)
          (fun _ => tagOnlyArrival)
          (fun x : (ℤ → ℝ) × (ℤ → (ℕ × Bool)) =>
            postTagFalseMarkTaggedServiceWork (serviceRate : ℝ) (x.2 0).1 x)
          (serviceRate : ℝ)) ω) 0} ≤
      gpsExponentialTailUpperBound ((serviceRate : ℝ) - (arrivalRate : ℝ)) delay := by
  let Ptag :=
    (PhysicalMM1ForwardReverseTag arrivalRate serviceRate harrival_pos hstableNN).Ptag
  let initialBusyUntil : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℝ :=
    fun x => postTagFalseMarkBusyUntil (x.2 0).1 x
  let arrival : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℕ → ℝ :=
    fun _ => tagOnlyArrival
  let work : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℕ → ℝ :=
    fun x => postTagFalseMarkTaggedServiceWork (serviceRate : ℝ) (x.2 0).1 x
  let departure : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))) → ℕ → ℝ :=
    fcfsComparatorDepartureFrom initialBusyUntil arrival work (serviceRate : ℝ)
  have hserviceRate_pos : 0 < (serviceRate : ℝ) := by
    exact_mod_cast (lt_trans harrival_pos hstableNN)
  have hServiceRate : (serviceRate : ℝ) =
      (serviceRate : ℝ) * (fun _ : Unit => (1 : ℝ)) () := by
    ring
  have hbusy_nonneg : ∀ᵐ ω ∂Ptag,
      0 ≤ initialBusyUntil ω := by
    simpa [Ptag, initialBusyUntil, PhysicalMM1ForwardReverseTag,
      ForwardReverseTag, PhysicalMM1ClockRate, PhysicalMM1Rho] using
      (geoNNPMF_uniformized_forwardReverseMarkedSelectedTag_ae_postTagFalseMarkBusyUntil_nonneg_of_rates
        harrival_pos hstableNN)
  have hbusy_le_response : ∀ᵐ ω ∂Ptag,
      initialBusyUntil ω ≤ postTagFalseMarkResponseFromState ω := by
    simpa [Ptag, initialBusyUntil, PhysicalMM1ForwardReverseTag,
      ForwardReverseTag, PhysicalMM1ClockRate, PhysicalMM1Rho] using
      (geoNNPMF_uniformized_forwardReverseMarkedSelectedTag_ae_postTagFalseMarkBusyUntil_le_response_of_rates
        harrival_pos hstableNN)
  have hsource : ∀ᵐ ω ∂Ptag,
      Nonempty (TaggedJobGPSOpenBacklogIntegralSourcePath Unit ()
        (initialBusyUntil ω) (arrival ω) (work ω)
        (departure ω) (serviceRate : ℝ) (fun _ : Unit => (1 : ℝ))) := by
    filter_upwards [hbusy_nonneg, hbusy_le_response] with ω hbusy hbusy_le
    have hwork_nonneg : ∀ n : ℕ, 0 ≤ work ω n :=
      postTagFalseMarkTaggedServiceWork_nonneg
        (show 0 ≤ (serviceRate : ℝ) from NNReal.coe_nonneg serviceRate)
        (by simpa [initialBusyUntil, work, postTagFalseMarkResponseFromState] using hbusy_le)
    have hdep_zero : departure ω 0 =
        initialBusyUntil ω + work ω 0 / (serviceRate : ℝ) := by
      change max (arrival ω 0) (initialBusyUntil ω) +
          work ω 0 / (serviceRate : ℝ) =
        initialBusyUntil ω + work ω 0 / (serviceRate : ℝ)
      rw [max_eq_right]
      simpa [arrival, tagOnlyArrival] using hbusy
    have hrate_fun :
        gpsBackloggedClassRate Unit () (serviceRate : ℝ)
          (fun _ : Unit => (1 : ℝ)) (fun _ _ => true) =
            fun _ : ℝ => (serviceRate : ℝ) := by
      funext t
      simp [gpsBackloggedClassRate, gpsBackloggedWeightSum,
        gpsBackloggedClasses, idealGPSClassRate]
    refine ⟨{
      capacity_nonneg := NNReal.coe_nonneg serviceRate
      weight_nonneg := by intro i; simp
      total_weight_le_one := by simp
      tagged_guaranteed_rate_pos := by simpa using hserviceRate_pos
      actualServiceStart := initialBusyUntil ω
      arrival_le_actualServiceStart := by
        simpa [arrival, tagOnlyArrival] using hbusy
      departure_after_actualServiceStart := by
        rw [hdep_zero]
        exact le_add_of_nonneg_right
          (div_nonneg (hwork_nonneg 0) hserviceRate_pos.le)
      actualStart_le_comparatorStart := by
        simp [arrival, tagOnlyArrival, max_eq_right hbusy]
      backlogged := fun _ _ => true
      rate_intervalIntegrable := by
        rw [hrate_fun]
        exact intervalIntegrable_const
      tag_backlogged_on_open_actual_job := by
        intro t ht
        simp
      service_integral_eq_work := by
        rw [hdep_zero]
        have hserviceRate_ne : (serviceRate : ℝ) ≠ 0 := hserviceRate_pos.ne'
        rw [hrate_fun]
        rw [intervalIntegral.integral_const]
        simp [smul_eq_mul, sub_eq_add_neg]
        field_simp [hserviceRate_ne]
    }⟩
  have htail :=
    gpsResponseTail_le_of_physicalForwardReverseMarkedMM1PalmPASTAIntegralOpenBacklogTaggedJobGPS
      (tag := ()) harrival_pos hstableNN (serviceRate : ℝ)
      (fun _ : Unit => (1 : ℝ)) departure delay hdelay hServiceRate
      (by simpa [Ptag, initialBusyUntil, arrival, work] using hsource)
  simpa [Ptag, initialBusyUntil, arrival, work, departure] using htail

/--
Real-rate paper-form version of the physical selected-Palm false-mark
comparator tail.  The source condition `lambda < C * phi` supplies both the
nonnegative rates needed to construct the physical M/M/1 carrier and the
paper-form exponent `exp(-((C * phi - lambda) z))`.
-/
theorem gpsResponseTail_le_of_physicalFalseMarkOpenBacklogTaggedJobGPS_realRates
    {arrivalRate capacity weight : ℝ}
    (harrival_pos : 0 < arrivalRate)
    (hstable : arrivalRate < capacity * weight)
    (delay : ℝ) (hdelay : 0 ≤ delay) :
    let arrivalRateNN : ℝ≥0 := ⟨arrivalRate, harrival_pos.le⟩
    let serviceRateNN : ℝ≥0 :=
      ⟨capacity * weight, (lt_trans harrival_pos hstable).le⟩
    (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
        (by exact_mod_cast harrival_pos)
        (by exact_mod_cast hstable)).Ptag.real
      {ω | delay ≤ responseTime tagOnlyArrival
        ((fcfsComparatorDepartureFrom
          (fun x : (ℤ → ℝ) × (ℤ → (ℕ × Bool)) =>
            postTagFalseMarkBusyUntil (x.2 0).1 x)
          (fun _ => tagOnlyArrival)
          (fun x : (ℤ → ℝ) × (ℤ → (ℕ × Bool)) =>
            postTagFalseMarkTaggedServiceWork
              (capacity * weight) (x.2 0).1 x)
          (capacity * weight)) ω) 0} ≤
      gpsExponentialTailUpperBound (capacity * weight - arrivalRate) delay := by
  let arrivalRateNN : ℝ≥0 := ⟨arrivalRate, harrival_pos.le⟩
  let serviceRateNN : ℝ≥0 :=
    ⟨capacity * weight, (lt_trans harrival_pos hstable).le⟩
  have harrivalNN_pos : 0 < arrivalRateNN := by
    exact_mod_cast harrival_pos
  have hstableNN : arrivalRateNN < serviceRateNN := by
    exact_mod_cast hstable
  have htail :=
    gpsResponseTail_le_of_physicalForwardReverseMarkedMM1PalmPASTAFalseMarkOpenBacklogTaggedJobGPS
      (arrivalRate := (⟨arrivalRate, harrival_pos.le⟩ : ℝ≥0))
      (serviceRate :=
      (⟨capacity * weight, (lt_trans harrival_pos hstable).le⟩ : ℝ≥0))
      harrivalNN_pos hstableNN
      delay hdelay
  simpa [arrivalRateNN, serviceRateNN] using htail

/--
Paper-facing GPS response-tail reduction that retains verified Campbell/Palm
provenance while taking the stationary M/M/1 queue law as an actual geometric
distribution.  The geometric law supplies the base queue tail, and the
separate PASTA field of `H` transfers that tail to the tagged pre-arrival
state.

This theorem requires the Campbell identity in `H`, so it cannot be
instantiated by a synthetic tagged law without also establishing genuine
stationary/Palm provenance.
-/
theorem gpsResponseTail_le_of_verifiedStationaryPalmGeometricPASTAFluidGPS
    {Ωbase Ωtag : Type*} [MeasurableSpace Ωbase] [MeasurableSpace Ωtag]
    {base : AppliedModelingLib.Probability.Palm.ShiftInvariantProbabilityLaw Ωbase}
    {tagged : AppliedModelingLib.Probability.Queueing.TaggedArrivalAtZero Ωtag}
    (H : AppliedModelingLib.Probability.Palm.StationaryPalmPASTAQueueLengthCertificate
      base tagged)
    (arrivalRate : ℝ) (harrivalRate : 0 < arrivalRate)
    (hPalmRate : H.toCampbellPalmTaggedArrivalCertificate.arrivalRate = arrivalRate)
    (service : AppliedModelingLib.Probability.PoissonProcess.ForwardHomogeneousPoissonCountingProcessByLaw
      Ωtag tagged.Ptag)
    (hstable : arrivalRate < service.rate)
    (response : Ωtag → ℝ)
    (hresponse_measurable : Measurable response)
    (hstationary : ProbabilityTheory.HasLaw H.to_pasta.stationaryQueueLength
      (ProbabilityTheory.geometricMeasure (p := 1 - arrivalRate / service.rate)
        (sub_pos.mpr (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_lt_one
          hstable service.rate_pos))
        (sub_le_self 1 (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_nonneg
          (le_of_lt harrivalRate) service.rate_pos))) base.Pbase)
    (hpreArrivalQueueLength_indep_service : ∀ z : ℝ, 0 ≤ z →
      ProbabilityTheory.IndepFun H.to_pasta.preArrivalQueueLength
        (service.count z.toNNReal) tagged.Ptag)
    (hstrict_response_event : ∀ z : ℝ, 0 ≤ z →
      {ω | z < response ω} =
        {ω | service.count z.toNNReal ω ≤ H.to_pasta.preArrivalQueueLength ω})
    (hresponse_atom_zero : ∀ z : ℝ,
      tagged.Ptag.real {ω | response ω = z} = 0)
    (initialBusyUntil : Ωtag → ℝ)
    (arrival work departure : Ωtag → ℕ → ℝ)
    (capacity weight delay : ℝ) (hdelay : 0 ≤ delay)
    (hfluid : ∀ ω,
      AppliedModelingLib.Probability.Queueing.CoupledIntegratedIdealFluidGPSPath
        (initialBusyUntil ω) (arrival ω) (work ω) (departure ω) capacity weight)
    (hServiceRate : service.rate = capacity * weight)
    (hComparatorResponse : ∀ ω : Ωtag,
      response ω = AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) :
    tagged.Ptag.real {ω | delay ≤
      AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) 0} ≤
      gpsExponentialTailUpperBound (capacity * weight - arrivalRate) delay := by
  have hstationary_queue_tail : ∀ k : ℕ,
      base.Pbase.real {ω | k ≤ H.to_pasta.stationaryQueueLength ω} =
        (arrivalRate / service.rate) ^ k := by
    intro k
    exact H.to_pasta.real_stationaryQueueLength_tail_of_geometric_hasLaw
      (arrivalRate / service.rate)
      (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_nonneg
        (le_of_lt harrivalRate) service.rate_pos)
      (AppliedModelingLib.Probability.Queueing.mm1TrafficIntensity_lt_one hstable service.rate_pos)
      hstationary k
  exact gpsResponseTail_le_of_verifiedStationaryPalmPASTAFluidGPS H arrivalRate hPalmRate
    service hstable response hresponse_measurable hstationary_queue_tail
    hpreArrivalQueueLength_indep_service hstrict_response_event hresponse_atom_zero
    initialBusyUntil arrival work departure capacity weight delay hdelay hfluid
    hServiceRate hComparatorResponse

