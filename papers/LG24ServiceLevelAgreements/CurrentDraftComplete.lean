/--
Stationary/Palm M/M/1 comparator reduction with both stochastic boundary
identifications stated almost everywhere.  This is the correct interface for
pathwise constructions driven by continuous exponential clocks: null boundary
paths need not satisfy the service-floor certificate or comparator-response
identity pointwise.
-/
theorem gpsResponseTail_le_of_stationaryPalmMM1Comparator_aeServiceFloor_aeComparatorResponse
    {Ω : Type*} [MeasurableSpace Ω]
    (H : AppliedModelingLib.Probability.Queueing.TaggedPASTAMM1CountCertificate Ω)
    (initialBusyUntil : Ω → ℝ)
    (arrival work departure : Ω → ℕ → ℝ)
    (capacity weight delay : ℝ) (hdelay : 0 ≤ delay)
    (hServiceFloorRecurrence : ∀ᵐ ω ∂H.Ptag,
      AppliedModelingLib.Probability.Queueing.FCFSServiceFloorUpperBoundFromInitial
        (initialBusyUntil ω) (arrival ω) (work ω) (departure ω)
        (capacity * weight))
    (hServiceRate : H.serviceRate = capacity * weight)
    (hComparatorResponse : ∀ᵐ ω ∂H.Ptag,
      H.response ω = AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) :
    H.Ptag.real {ω | delay ≤
      AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) 0} ≤
      gpsExponentialTailUpperBound
        (capacity * weight - H.arrivalRate) delay := by
  letI : MeasureTheory.IsProbabilityMeasure H.Ptag := H.isProbability
  have hComparatorEvent :
      {ω | delay ≤ AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0} =ᵐ[H.Ptag]
        {ω | delay ≤ H.response ω} := by
    filter_upwards [hComparatorResponse] with ω hω
    change (delay ≤
      AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0) =
      (delay ≤ H.response ω)
    rw [← hω]
  have hComparatorTail :
      H.Ptag.real {ω | delay ≤
        AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
          (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
            initialBusyUntil arrival work (capacity * weight) ω) 0} =
        gpsExponentialTailUpperBound
          (capacity * weight - H.arrivalRate) delay := by
    have hComparatorEventReal :=
      congrArg ENNReal.toReal (MeasureTheory.measure_congr hComparatorEvent)
    change ENNReal.toReal (H.Ptag {ω | delay ≤
      AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
        (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
          initialBusyUntil arrival work (capacity * weight) ω) 0}) = _
    rw [hComparatorEventReal]
    calc
      H.Ptag.real {ω | delay ≤ H.response ω} =
          Real.exp (-((H.serviceRate - H.arrivalRate) * delay)) :=
        AppliedModelingLib.Probability.Queueing.TaggedPASTAMM1CountCertificate.weak_responseTail_eq
          H delay hdelay
      _ = gpsExponentialTailUpperBound
          (capacity * weight - H.arrivalRate) delay := by
        unfold gpsExponentialTailUpperBound
        rw [hServiceRate]
        congr 1
        ring
  calc
    H.Ptag.real {ω | delay ≤
        AppliedModelingLib.Probability.Queueing.responseTime (arrival ω) (departure ω) 0} ≤
        H.Ptag.real {ω | delay ≤
          AppliedModelingLib.Probability.Queueing.responseTime (arrival ω)
            (AppliedModelingLib.Probability.Queueing.fcfsComparatorDepartureFrom
              initialBusyUntil arrival work (capacity * weight) ω) 0} :=
      AppliedModelingLib.Probability.Queueing.taggedResponseTailReal_le_fcfsComparatorFromInitial_ae
        H.Ptag initialBusyUntil arrival work departure (capacity * weight) delay 0
        hServiceFloorRecurrence
    _ = gpsExponentialTailUpperBound
        (capacity * weight - H.arrivalRate) delay := hComparatorTail

