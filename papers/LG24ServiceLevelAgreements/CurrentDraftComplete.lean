  let Ptag :=
    (PhysicalMM1ForwardReverseTag arrivalRateNN serviceRateNN
      (by exact_mod_cast harrival_pos)
      (by exact_mod_cast hstable)).Ptag
  (∀ᵐ ω ∂Ptag, ∀ i, Measurable (fun t => backlogged ω t i)) ∧
    (∀ᵐ ω ∂Ptag, ∀ n t,
      t ∈ Set.Ioo
        (physicalSelectedPalmTaggedGPSComparatorStart tag capacity weight
          backlogged ω n)
        (physicalSelectedPalmTaggedGPSComparatorStart tag capacity weight
          backlogged ω n +
          postTagFalseMarkTaggedServiceWork (capacity * weight tag)
