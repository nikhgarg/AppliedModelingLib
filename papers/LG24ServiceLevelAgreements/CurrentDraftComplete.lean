theorem physicalTaggedInitialWorkVectorClasswiseCumulativeServiceBalanceOnGuaranteedWindow_of_chronologicalServiceProcess
    {ι : Type*} [Fintype ι] [DecidableEq ι] (tag : ι)
    (capacity : ℝ) (weight : ι → ℝ)
    (ω : ((ℤ → ℝ) × (ℤ → (ℕ × Bool))))
    (backlogged : ℝ → ι → Bool) (remainingWork : ℝ → ι → ℝ)
    (cumulativeService : ι → ℝ → ℝ)
    (hprocess :
      physicalTaggedInitialWorkVectorChronologicalServiceProcessOnGuaranteedWindow
        tag capacity weight ω backlogged remainingWork cumulativeService) :
    physicalTaggedInitialWorkVectorClasswiseCumulativeServiceBalanceOnGuaranteedWindow
      tag capacity weight ω backlogged remainingWork cumulativeService := by
  rcases hprocess with ⟨hinit, hevolution, hservice⟩
  intro i t ht
  constructor
  · calc
      remainingWork t i =
          remainingWork (postTagFalseMarkBusyUntil (ω.2 0).1 ω) i -
            (cumulativeService i t -
              cumulativeService i (postTagFalseMarkBusyUntil (ω.2 0).1 ω)) :=
        hevolution i t ht
      _ =
          physicalTaggedInitialWorkVector tag capacity weight ω i -
            (cumulativeService i t -
              cumulativeService i (postTagFalseMarkBusyUntil (ω.2 0).1 ω)) := by
        rw [hinit i]
  · exact hservice i t ht

