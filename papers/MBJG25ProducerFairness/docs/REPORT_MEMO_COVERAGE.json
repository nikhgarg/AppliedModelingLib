  "items": {
    "defect/MBJG25-THEOREM3-1-STRICT-ENDPOINT-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "07542d8438ab71d05653a9e82b694eb756dcf647ad7b8538440a28db9d4ab00a",
      "source_reading": "Theorem 3.1 says posterior-rating variance is strictly decreasing in prior strength for every source-model quality 0 <= q_v <= 1, but the displayed variance is identically zero at q_v=0 and q_v=1.",
      "memo_heading": "Theorem 3.1: variance at Bernoulli endpoints",
      "memo_anchor": "theorem-31-variance-at-bernoulli-endpoints",
      "report_home": 4
    },
    "defect/MBJG25-EQ20-BETA-SHAPE-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "07542d8438ab71d05653a9e82b694eb756dcf647ad7b8538440a28db9d4ab00a",
      "source_reading": "The source says Equation 20 is a prior-weighted binary posterior with baseline prior distribution Beta(C,1), but Beta(C,1) has mean C/(C+1) and does not produce the displayed denominator n+m.",
      "memo_heading": "Appendix D, Equation (20): Beta prior shape",
      "memo_anchor": "appendix-d-equation-20-beta-prior-shape",
      "report_home": 4
    },
    "defect/MBJG25-EQ21-PRIOR-OMISSION-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "07542d8438ab71d05653a9e82b694eb756dcf647ad7b8538440a28db9d4ab00a",
      "source_reading": "The source introduces Dirichlet prior pseudo-counts alphaHat and prior strength eta, but printed Equation 21 sums only observed counts, making the displayed estimate independent of every prior parameter.",
      "memo_heading": "Appendix E, Equation (21): Dirichlet posterior average",
      "memo_anchor": "appendix-e-equation-21-dirichlet-posterior-average",
      "report_home": 4
    },
    "convention/MBJG25-DISCRETE-NONDEGENERATE-OBSERVATION-01": {
      "disposition": "not_material",
      "reason": "The source fixed binary model has a positive discrete review count; using natural time does not change its domain."
    },
