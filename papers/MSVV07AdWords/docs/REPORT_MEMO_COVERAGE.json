      "memo_sha256": "b3d25551331eccf3f809f617aad1feda91a2a97236ed07d4b3fdd4e64846d56a",
      "report_home": 4,
      "source_reading": "Theorem 8 takes a finite discretization/small-bids parameter to infinity but does not state a typed sequence-of-instances and error-convergence regime."
    },
