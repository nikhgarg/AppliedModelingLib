  "items": {
    "defect/MSVV07-APPENDIX-KAPPA-WITNESS-03": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "the-kappa-witness-family",
      "memo_heading": "The `kappa` witness family",
      "memo_sha256": "b3d25551331eccf3f809f617aad1feda91a2a97236ed07d4b3fdd4e64846d56a",
      "report_home": 4,
      "source_reading": "For every kappa greater than one, the Appendix asserts an unspecified discrete {0,a,kappa a} counterexample family and gives its limiting factors."
    },
    "defect/MSVV07-APPENDIX-PHASE3-RESIDUAL-02": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "appendix-counterexample-three-phase-revenue",
      "memo_heading": "Appendix counterexample: three-phase revenue",
      "memo_sha256": "b3d25551331eccf3f809f617aad1feda91a2a97236ed07d4b3fdd4e64846d56a",
      "report_home": 4,
      "source_reading": "The source says bidders 0.5N+1 through N have spent all their money after phase 2, so every phase-3 query is discarded, and uses that execution to claim algorithm revenue 0.62N."
    },
    "defect/MSVV07-APPENDIX-REVENUE-ARITHMETIC-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "appendix-counterexample-three-phase-revenue",
      "memo_heading": "Appendix counterexample: three-phase revenue",
      "memo_sha256": "b3d25551331eccf3f809f617aad1feda91a2a97236ed07d4b3fdd4e64846d56a",
      "report_home": 4,
      "source_reading": "After 0.4N rounds with m bids of a, 0.1N rounds with m bids of 2a, and a third phase whose queries are all discarded, the source says the algorithm makes 0.62N."
    },
    "defect/MSVV07-FINITE-CONVENTIONS-05": {
      "disposition": "not_material",
      "reason": "Nonnegative bids are part of the source economic bid model, and 0 ≤ ε ≤ 1 is the finite small-fraction regime, automatically eventual when nonnegative bid fractions tend to zero; neither adds the unresolved relative-error bridge."
    },
    "defect/MSVV07-S4-EXTERNAL-TIGHTNESS-WITNESS-06": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "section-4-tightness",
      "memo_heading": "Section 4 tightness",
      "memo_sha256": "b3d25551331eccf3f809f617aad1feda91a2a97236ed07d4b3fdd4e64846d56a",
      "report_home": 4,
      "source_reading": "Section 4 states that a cited KP00 construction gives a BALANCE instance of exact factor 1-1/e, but does not print the finite instance or its equality proof."
    },
    "defect/MSVV07-S6-NEXTPRICE-EFFECTIVE-SMALL-BIDS-07": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "section-6-variants",
      "memo_heading": "Section 6 variants",
      "memo_sha256": "b3d25551331eccf3f809f617aad1feda91a2a97236ed07d4b3fdd4e64846d56a",
      "report_home": 4,
      "source_reading": "Section 6 says the next-highest-bid modifications achieve factor 1-1/e but does not state the finite effective-charge small-bids condition required when budgets differ."
    },
    "defect/MSVV07-T8-TRADEOFF-EXPONENT-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "theorem-8-finite-suffix-index",
      "memo_heading": "Theorem 8: finite suffix index",
      "memo_sha256": "b3d25551331eccf3f809f617aad1feda91a2a97236ed07d4b3fdd4e64846d56a",
      "report_home": 4,
      "source_reading": "The source defines psi_k(i) as the suffix sum of y_j* from j=i through k-1 and prints the closed form 1-(1-1/k)^(k-i+1). The simple proof repeats the same shift by calling (k-i+1)/k precisely the unspent fraction of a type-i bidder whose exact spent fraction is i/k."
    },
    "defect/MSVV07-T8-TYPED-LIMIT-REGIME-04": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "finite-and-limiting-theorem-8-readings",
