    "defect/MW90-APPROVED-INTERIOR-FULL-SUPPORT-01": {
      "disposition": "not_material",
      "reason": "This umbrella record adds no independent domain condition: selected-class positivity for Theorem 1 and all-class positivity for the strict Theorems 2--4 conclusions are already carried by their theorem-specific conventions and corrected targets."
    },
    "convention/MW90-THEOREM1-POSITIVE-FLOW-INTERIOR-01": {
      "disposition": "memo",
      "source_reading": "Theorem 1's displayed ordinary first-order equality is applied to a class whose welfare-maximizing arrival rate is positive. The feasible flow domain is nonnegative, so a zero-flow coordinate instead has a one-sided optimality condition.",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "56487507dae312302d2b75c7d83dbc85211b724164cdb53d8f8f64ad1de4a5cd",
      "memo_heading": "Positive-flow and interior reading",
      "memo_anchor": "positive-flow-and-interior-reading",
      "report_home": 4
    },
    "convention/MW90-STRICT-SELF-SELECTION-POSITIVE-FLOW-02": {
      "disposition": "memo",
      "source_reading": "The strict self-selection and strict cheating-penalty comparisons in Theorems 2--4 are the positive-flow interior statements. Each adjacent strict gap contains the neighboring equilibrium arrival rate as a factor; if that rate is zero, the corresponding comparison can be weak instead of strict.",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_sha256": "56487507dae312302d2b75c7d83dbc85211b724164cdb53d8f8f64ad1de4a5cd",
      "memo_heading": "Effect on the theorem conclusions",
      "memo_anchor": "effect-on-the-theorem-conclusions",
      "report_home": 4
    },
