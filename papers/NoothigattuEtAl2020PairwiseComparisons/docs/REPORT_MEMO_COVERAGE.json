    "convention/NOOTHIGATTU-FIXED-REFERENCE-NORMALIZATION-01": {
      "disposition": "not_material",
      "reason": "Fixing one reference score to zero is equivalent to the source shift-invariant score representation because every likelihood and conclusion depends only on score differences."
    },
    "convention/NOOTHIGATTU-LEMMA23-DISTINCT-PAIRS-01": {
      "disposition": "memo",
      "source_reading": "The positive-count premise in Lemma 2.3 ranges over distinct alternatives. Diagonal counts are definitionally zero in the source pairwise-comparison model, and the proof groups unordered distinct pairs, so a literal diagonal-inclusive reading would make the premise inconsistent.",
