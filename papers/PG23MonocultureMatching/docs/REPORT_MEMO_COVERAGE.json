      "report_home": 4,
      "source_reading": "The appendix derives endpoint CDF identities from connected support and states positive mass for an unqualified interval meeting the support interior."
    },
    "defect/PG23-NASH-EXANTE-SEMANTICS-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
