      "memo_sha256": "acb4b060c82f693425eb1f2e51c469fa40ba48cb33690b7fb4b6794f097846e5",
      "report_home": 4,
      "source_reading": "The model assumes connected support, but later exact-cutoff, strict-tail, strict-comparison, and welfare conclusions use atomlessness, score-level nullity, nondegeneracy, or integrability not implied by connected support alone."
    },
    "defect/PG23-ENDPOINT-AND-INTERVAL-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "cutoff-probabilities-and-support-arguments",
