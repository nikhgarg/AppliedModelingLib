  "items": {
    "convention/PKG25-FINITE-MEASURABLE-PARTITION-01": {
      "disposition": "not_material",
      "reason": "The source counterexamples themselves use finite measurable cells; making that finite witness partition explicit changes neither their domain nor any named conclusion."
    },
    "convention/PKG25-MEASURABILITY-AND-EXPECTATION-01": {
      "disposition": "not_material",
      "reason": "Measurable predictions and integrable correctness supply the source probability/expectation definitions; finite witnesses satisfy them automatically."
    },
    "convention/PKG25-NONEMPTY-AGENT-DOMAIN-01": {
      "disposition": "not_material",
      "reason": "The source minimum and existential deferral agent already require a nonempty agent set."
    },
    "convention/PKG25-RAW-JOINT-LAW-01": {
      "disposition": "not_material",
      "reason": "The joint-law calibration identity is the measurable-event form of source calibration and adds no population restriction."
    },
    "defect/PKG25-ACCURACY-LOSS-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "loss-correctness-and-calibration",
      "memo_heading": "Loss, correctness, and calibration",
      "memo_sha256": "c0e5223ca197ac0271f5ceebeee00c3ec7e63360f02226893c424da7684e5a50",
      "report_home": 10,
      "source_reading": "The source labels E[|Yhat(X)-Y|] as 0-1 accuracy, although this expectation is 0-1 loss; the later agent formula and proof use expected correctness."
    },
    "defect/PKG25-CALIBRATION-NULL-FIBERS-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "mixtures-and-finite-partitions",
      "memo_heading": "Mixtures and finite partitions",
      "memo_sha256": "c0e5223ca197ac0271f5ceebeee00c3ec7e63360f02226893c424da7684e5a50",
      "report_home": 10,
      "source_reading": "Calibration is written as a point-conditioned equality for every p in Image(P), without defining a conditional probability on a zero-probability prediction fiber."
    },
    "defect/PKG25-CORRECTNESS-TIE-01": {
      "disposition": "not_material",
      "reason": "The printed Lemma 8 already assumes an interior prediction profile and excludes the selected agent's half tie; the selected Spec has those same premises and conclusion. The generic proof-helper strictness observation is not a change to this named result."
    },
    "defect/PKG25-IFF-BOUNDARY-01": {
      "disposition": "not_material",
      "reason": "The selected Theorem 1 is exactly the source's forward implication. The separate proof-restatement converse observation changes neither that named result nor its checked proof and is omitted from reader prose at the maintainer's request; its technical evidence remains retained."
    },
    "defect/PKG25-P6-MIXTURE-INDEX-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "mixtures-and-finite-partitions",
      "memo_heading": "Mixtures and finite partitions",
      "memo_sha256": "c0e5223ca197ac0271f5ceebeee00c3ec7e63360f02226893c424da7684e5a50",
      "report_home": 10,
      "source_reading": "After defining the component law with lambda_m in the displayed equation, the prose says to sample component m with probability lambda_ell."
    },
    "defect/PKG25-P9-S1-EPSILON-DOMAIN-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "proposition-9s-two-settings",
      "memo_heading": "Proposition 9's two settings",
      "memo_sha256": "c0e5223ca197ac0271f5ceebeee00c3ec7e63360f02226893c424da7684e5a50",
      "report_home": 7,
      "source_reading": "The first Proposition 9 setting says only epsilon < 1/2 while using epsilon and 1-epsilon as conditional probabilities and asserting that both induced profiles lie in (0,1)^n."
    },
    "defect/PKG25-P9-S2-DENOMINATOR-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "proposition-9s-two-settings",
      "memo_heading": "Proposition 9's two settings",
      "memo_sha256": "c0e5223ca197ac0271f5ceebeee00c3ec7e63360f02226893c424da7684e5a50",
      "report_home": 7,
      "source_reading": "The displayed S2 mass denominator writes a sum over j of p_j/(1-p_j) followed by a free-index term (1-q_j)/q_j, so as printed it does not define one normalized distribution."
    },
    "defect/PKG25-PARTITION-MEASURABLE-FINITE-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS.md",
      "memo_anchor": "mixtures-and-finite-partitions",
      "memo_heading": "Mixtures and finite partitions",
      "memo_sha256": "c0e5223ca197ac0271f5ceebeee00c3ec7e63360f02226893c424da7684e5a50",
      "report_home": 10,
      "source_reading": "The source says that an arbitrary partition induces a calibrated predictor by assigning every cell its conditional label-one probability, without measurability, null-cell, or finiteness conditions."
    },
    "report/proposition9-explicit-mixture-weights": {
      "disposition": "not_material",
      "reason": "The explicit 7/8 and 1/8 witness is a proof choice for a reported finite construction, not a source ambiguity beyond the Proposition 9 domain and normalizer corrections."
    },
    "report/theorem1-forward-implication": {
      "disposition": "not_material",
      "reason": "The selected result exactly matches the advertised forward theorem; no source difference needs a reader note."
    }
  },
