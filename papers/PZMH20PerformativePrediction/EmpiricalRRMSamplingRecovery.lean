import PZMH20PerformativePrediction.EmpiricalRRMRecovery

/-!
# Adaptive-sampling recovery for empirical repeated risk minimization

The raw Euclidean empirical-`W₁` failure event is placed on the canonical
conditionally IID trace generated by a measurable performative sampling
kernel.  Its existing inverse-square union bound and the deterministic
empirical-RRM recurrence imply that, with probability at least `1 - p`, every
iterate after the logarithmic entry time remains in the target ball.

Event measurability, the roundwise concentration budget, and the numerical
`W₁` threshold remain explicit.  They are precisely the analytic obligations
discharged by a concrete Fournier--Guillin schedule.
-/

namespace PZMH20PerformativePrediction.EmpiricalRRMSamplingRecovery

open AppliedModelingLib MeasureTheory ProbabilityTheory
open scoped InnerProductSpace ENNReal

/-- The direct empirical-`W₁` sampling-kernel wrapper for the source's RERM
two-phase recurrence. -/
theorem one_sub_le_measureReal_pOneFournierGuillinAdaptiveEuclideanRERMState_le_radius_after_of_samplingKernel
    {Parameter : Type*} [MeasurableSpace Parameter]
    [NormedAddCommGroup Parameter] [InnerProductSpace ℝ Parameter]
    [CompleteSpace Parameter]
    (dimension cutoff : ℕ) (alpha gamma momentBound deviation : ℝ)
    (model : MeasurePerformativeModel Parameter (EuclideanSpace ℝ (Fin dimension)))
    (sampling : MeasurePerformativeSamplingKernel model)
    (gradient : EuclideanSpace ℝ (Fin dimension) → Parameter → Parameter)
    (domain : Set Parameter) (hconvex : Convex ℝ domain) (smoothness : NNReal)
    (hgradient : ∀ datum parameter, parameter ∈ domain →
      HasGradientWithinAt (model.loss datum) (gradient datum parameter) domain parameter)
    (hdata : ∀ first second parameter, parameter ∈ domain →
      ‖gradient first parameter - gradient second parameter‖ ≤
        (smoothness : ℝ) * dist first second)
    {modulus : ℝ} (hmodulus : 0 < modulus)
    (hstrong : EmpiricalMinimizerPerturbation.IsPointwiseGradientStronglyConvexOn
      model.loss gradient domain modulus)
    (confidence : ℕ → ℝ) (countSchedule : ℕ → ℕ)
    (hcountPositive : ∀ iteration, 0 < countSchedule iteration)
    (deployedOfHistory : ∀ iteration,
      HeterogeneousBatchTrace (fun round => Fin (countSchedule round))
        (EuclideanSpace ℝ (Fin dimension)) iteration → Parameter)
    (hmeasurableDeployed : ∀ iteration, Measurable (deployedOfHistory iteration))
    (hempirical : IsHeterogeneousMeasureRepeatedEmpiricalRiskMinimizationTrajectoryOn
      model domain countSchedule hcountPositive deployedOfHistory)
    (populationUpdate : Parameter → Parameter)
    (hpopulation : IsMeasureRepeatedRiskMinimizationOn model domain populationUpdate)
    (stable : Parameter) (hstable : IsMeasurePerformativelyStableOn model domain stable)
    {sensitivity radius p : ℝ} (hsensitivityNonneg : 0 ≤ sensitivity)
    (hsmoothnessPos : 0 < (smoothness : ℝ))
    (hsensitivitySmall : sensitivity < modulus / (2 * (smoothness : ℝ)))
    (hsensitive : IsMeasureWassersteinSensitiveOn model domain sensitivity)
    (hradius : 0 < radius)
    (hinitial : ∀ history : HeterogeneousBatchTrace
      (fun round => Fin (countSchedule round)) (EuclideanSpace ℝ (Fin dimension)) 0,
      deployedOfHistory 0 history ∈ domain)
    (hempiricalIntegrable : ∀ iteration
      (batch : Fin (countSchedule iteration) → EuclideanSpace ℝ (Fin dimension))
      candidate, candidate ∈ domain →
      Integrable (fun datum => model.loss datum candidate)
        (empiricalSampleProbabilityMeasureOfPos
          (hcountPositive iteration) batch : Measure (EuclideanSpace ℝ (Fin dimension))))
    (entryIteration : ℕ)
    (hentry : ∀ trace : (i : ℕ) → HeterogeneousBatchTraceCoordinate
      (fun round => Fin (countSchedule round)) (EuclideanSpace ℝ (Fin dimension)) i,
      Real.log
          (dist (deployedOfHistory 0
            (heterogeneousBatchTraceOfInfiniteTrace 0 trace)) stable / radius) /
        (1 - 2 * (sensitivity * (smoothness : ℝ) / modulus)) ≤
          (entryIteration : ℝ))
    (pnonneg : 0 ≤ p)
    (hevent : ∀ iteration, MeasurableSet
      (heterogeneousBatchTraceBadEventPair (fun round => Fin (countSchedule round))
        (pOneFournierGuillinAdaptiveEuclideanWassersteinOneBadEvent
          dimension cutoff alpha gamma momentBound deviation confidence countSchedule
          hcountPositive
          (measurePerformativeDeployedLaw model (fun round => Fin (countSchedule round))
            deployedOfHistory)) iteration))
    (hfiniteIID : ∀ iteration history,
      (Probability.finiteIIDSampleLaw
        (measurePerformativeDeployedLaw model (fun round => Fin (countSchedule round))
          deployedOfHistory iteration history :
            Measure (EuclideanSpace ℝ (Fin dimension)))
        (countSchedule iteration)).real
        {batch |
          pOneFournierGuillinAdaptiveEuclideanWassersteinOneBadEvent
            dimension cutoff alpha gamma momentBound deviation confidence countSchedule
            hcountPositive
            (measurePerformativeDeployedLaw model (fun round => Fin (countSchedule round))
              deployedOfHistory) iteration history batch} ≤ theorem310FailureBudget p iteration)
    (hthreshold : ∀ iteration history,
      pOneFournierGuillinAdaptiveEuclideanWassersteinOneThreshold
        dimension cutoff alpha gamma momentBound deviation confidence countSchedule
        (measurePerformativeDeployedLaw model (fun round => Fin (countSchedule round))
          deployedOfHistory) iteration history ≤ ENNReal.ofReal (sensitivity * radius)) :
    (measurePerformativeHeterogeneousBatchTraceInfiniteLaw model sampling countSchedule
      deployedOfHistory hmeasurableDeployed).real
      {trace | ∀ iteration, entryIteration ≤ iteration →
        dist (deployedOfHistory iteration
          (heterogeneousBatchTraceOfInfiniteTrace iteration trace)) stable ≤ radius} ≥
        1 - p := by
  let law := measurePerformativeDeployedLaw model
    (fun round => Fin (countSchedule round)) deployedOfHistory
  let oneKernel : (iteration : ℕ) →
      Kernel
        ((i : Finset.Iic iteration) →
          HeterogeneousBatchTraceCoordinate (fun round => Fin (countSchedule round))
            (EuclideanSpace ℝ (Fin dimension)) i.1)
        (EuclideanSpace ℝ (Fin dimension)) :=
    fun iteration => heterogeneousBatchTraceOneObservationKernel
      (fun round => Fin (countSchedule round)) sampling.kernel deployedOfHistory iteration
      (hmeasurableDeployed iteration)
  have oneKernelMarkov : ∀ iteration, IsMarkovKernel (oneKernel iteration) := by
    intro iteration
    dsimp only [oneKernel]
    letI : IsMarkovKernel sampling.kernel := sampling.isMarkov
    exact heterogeneousBatchTraceOneObservationKernel_isMarkov
      (fun round => Fin (countSchedule round)) sampling.kernel deployedOfHistory iteration
      (hmeasurableDeployed iteration)
  let batchKernel : (iteration : ℕ) →
      Kernel
        ((i : Finset.Iic iteration) →
          HeterogeneousBatchTraceCoordinate (fun round => Fin (countSchedule round))
            (EuclideanSpace ℝ (Fin dimension)) i.1)
        (HeterogeneousBatchTraceCoordinate (fun round => Fin (countSchedule round))
          (EuclideanSpace ℝ (Fin dimension)) (iteration + 1)) :=
    fun iteration => Probability.finiteIIDBatchKernel (countSchedule iteration)
      (oneKernel iteration)
  have batchKernelMarkov : ∀ iteration, IsMarkovKernel (batchKernel iteration) := by
    intro iteration
    dsimp only [batchKernel]
    letI : IsMarkovKernel (oneKernel iteration) := oneKernelMarkov iteration
    exact Probability.finiteIIDBatchKernel_isMarkov (countSchedule iteration)
      (oneKernel iteration)
  letI : ∀ iteration, IsMarkovKernel (batchKernel iteration) := batchKernelMarkov
  let bad := pOneFournierGuillinAdaptiveEuclideanWassersteinOneBadEvent
    dimension cutoff alpha gamma momentBound deviation confidence countSchedule
      hcountPositive law
  have hgoodWasserstein : ∀ iteration history batch, ¬ bad iteration history batch →
      ProbabilityCoupling.wassersteinOne
          (empiricalSampleProbabilityMeasureOfPos (hcountPositive iteration) batch)
          (model.dataLaw (deployedOfHistory iteration history)) ≤
        ENNReal.ofReal (sensitivity * radius) := by
    intro iteration history batch hgood
    simpa only [bad, law, measurePerformativeDeployedLaw] using
      (empiricalWassersteinOne_le_of_not_pOneFournierGuillinAdaptiveEuclideanBadEvent
        dimension cutoff alpha gamma momentBound deviation confidence countSchedule
        hcountPositive law iteration history batch (hthreshold iteration history) hgood)
  change 1 - p ≤
    (heterogeneousBatchTraceInfiniteLaw
      (fun round => Fin (countSchedule round)) batchKernel).real
      {trace | ∀ iteration, entryIteration ≤ iteration →
        dist (deployedOfHistory iteration
          (heterogeneousBatchTraceOfInfiniteTrace iteration trace)) stable ≤ radius}
  refine one_sub_le_measureReal_heterogeneousBatchTraceInfinite_safe_of_iUnionBad_le
    (fun round => Fin (countSchedule round)) batchKernel bad p hevent ?_
    {trace | ∀ iteration, entryIteration ≤ iteration →
      dist (deployedOfHistory iteration
        (heterogeneousBatchTraceOfInfiniteTrace iteration trace)) stable ≤ radius} ?_
  · simpa only [batchKernel, bad, law] using
      (measureReal_iUnion_pOneFournierGuillinAdaptiveEuclideanWassersteinOneBadEvent_le_theorem310Budget_of_oneKernel
        dimension cutoff alpha gamma momentBound deviation confidence countSchedule
        hcountPositive p pnonneg oneKernel oneKernelMarkov law
        (fun iteration historyPrefix => by
          dsimp only [oneKernel, law, measurePerformativeDeployedLaw]
          rw [heterogeneousBatchTraceOneObservationKernel_apply]
          exact sampling.apply_eq_dataLaw _)
        hevent hfiniteIID)
  · intro trace hgoodTrace
    change ∀ iteration, entryIteration ≤ iteration →
      dist (deployedOfHistory iteration
        (heterogeneousBatchTraceOfInfiniteTrace iteration trace)) stable ≤ radius
    exact EmpiricalRRMRecovery.dist_heterogeneousMeasureRERMState_le_radius_after_of_wassersteinOne_goodTrace
        model gradient domain hconvex smoothness hgradient hdata hmodulus hstrong
        countSchedule hcountPositive deployedOfHistory hempirical populationUpdate hpopulation
        stable hstable hsensitivityNonneg hsmoothnessPos hsensitivitySmall hsensitive hradius
        hinitial hempiricalIntegrable bad hgoodWasserstein trace hgoodTrace entryIteration
        (hentry trace)

end PZMH20PerformativePrediction.EmpiricalRRMSamplingRecovery
