    "convention/ROTH82-ORDINAL-SCORE-ENCODING-01": {
      "disposition": "not_material",
      "reason": "Finite strict rankings can be encoded injectively by real scores; only the order enters the matching results."
    },
    "convention/ROTH82-COMPLETE-MARRIAGE-OUTSIDE-OPTION-01": {
      "disposition": "not_material",
      "reason": "Putting every partner above the unmatched option encodes the source complete marriage domain and does not exclude any source ranking."
    },
    "convention/ROTH82-GENERIC-ASSIGNMENT-CARRIER-01": {
      "disposition": "not_material",
      "reason": "The general partial-assignment carrier is restricted to finite balanced complete source outcomes at the theorem endpoints; its extra representational capacity is not an economic premise."
    },
    "convention/ROTH82-NONEMPTY-PARTICIPANT-SIDES-01": {
      "disposition": "not_material",
      "reason": "The named-agent and first-choice statements already require participants; nonemptiness makes those source quantifiers explicit."
    }
