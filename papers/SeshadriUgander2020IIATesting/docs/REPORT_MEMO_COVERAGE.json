{
  "all_selected_semantic_review_sha256": "d626841160ff2b316ef31c760821e43b58efac3d3638d7f857017a922a96dffd",
  "items": {
    "defect/SU20-ALL-EVEN-ENDPOINT-04": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "all-even-subsets-endpoint",
      "memo_heading": "All-even-subsets endpoint",
      "memo_sha256": "4a56689283ec413f731126fbcf6ef54113e8d84e1f28f2d0d429d9575d0b5629",
      "report_home": 4,
      "source_reading": "The all-even-subsets corollary claims n >= 2, but the n = 2 comparison-incidence graph is not Eulerian."
    },
    "defect/SU20-CYCLE-BOUND-DOMAINS-03": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "appendix-comparison-incidence-bound",
      "memo_heading": "Appendix comparison-incidence bound",
      "memo_sha256": "4a56689283ec413f731126fbcf6ef54113e8d84e1f28f2d0d429d9575d0b5629",
      "report_home": 4,
      "source_reading": "The printed rational mean branch omits positivity of d - 4n + 8 log_2(n), and the final real-log dispersion simplification is used without stating its n >= 4 range."
    },
    "defect/SU20-LEMMA2-MIXTURE-NONCONVEX-05": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "lemma-2-mixture-reduction",
      "memo_heading": "Lemma 2 mixture reduction",
      "memo_sha256": "4a56689283ec413f731126fbcf6ef54113e8d84e1f28f2d0d429d9575d0b5629",
      "report_home": 7,
      "source_reading": "The printed proof says that a mixture of component alternatives remains in the delta-separated class once every component is in that class."
    },
    "defect/SU20-THEOREM1-LECAM-COEFFICIENT-02": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_anchor": "le-cam-coefficient-in-the-proof-of-theorem-1",
      "memo_heading": "Le Cam coefficient in the proof of Theorem 1",
      "memo_sha256": "4a56689283ec413f731126fbcf6ef54113e8d84e1f28f2d0d429d9575d0b5629",
      "report_home": 7,
      "source_reading": "The first displayed proof line uses coefficient 1/4 before total variation although the preceding Le Cam inequality uses 1/2; the next chi-square line and theorem endpoint correspond to the standard route."
    },
    "defect/SU20-THEOREM1-PERTURBATION-RANGE-01": {
      "disposition": "memo",
      "memo": "docs/SOURCE_CLARIFICATIONS_AND_CORRECTIONS.md",
      "memo_sha256": "4a56689283ec413f731126fbcf6ef54113e8d84e1f28f2d0d429d9575d0b5629",
      "memo_heading": "Theorem 1 perturbation range",
      "memo_anchor": "theorem-1-perturbation-range",
      "source_reading": "The source perturbation is defined for epsilon in [0,1], so the proof substitution epsilon = 2 mu(sigma) delta requires 2 mu(sigma) delta <= 1.",
      "report_home": 4
    },
